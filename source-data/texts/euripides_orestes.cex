#!ctsdata
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1.1.text#Οὐκ ἔστιν οὐδὲν δεινὸν ὧδ' εἰπεῖν ἔπος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:2.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:2.1.text#οὐδὲ πάθος οὐδὲ ξυμφορὰ θεήλατος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:3.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:3.1.text#ἧς οὐκ ἂν ἄραιτ' ἄχθος ἀνθρώπου φύσις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:4.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:4.1.text#ὁ γὰρ μακάριος — κοὐκ ὀνειδίζω τύχας —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:5.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:5.1.text#Διὸς πεφυκώς, ὡς λέγουσι, Τάνταλος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:6.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:6.1.text#κορυφῆς ὑπερτέλλοντα δειμαίνων πέτρον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:7.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:7.1.text#ἀέρι ποτᾶται· καὶ τίνει ταύτην δίκην,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:8.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:8.1.text#ὡς μὲν λέγουσιν, ὅτι θεοῖς ἄνθρωπος ὢν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:9.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:9.1.text#κοινῆς τραπέζης ἀξίωμ' ἔχων ἴσον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:10.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:10.1.text#ἀκόλαστον ἔσχε γλῶσσαν, αἰσχίστην νόσον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:11.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:11.1.text#οὗτος φυτεύει Πέλοπα, τοῦ δ' Ἀτρεὺς ἔφυ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:12.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:12.1.text#ᾧ στέμματα ξήνασ' ἐπέκλωσεν θεὰ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:13.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:13.1.text#ἔριν, Θυέστῃ πόλεμον ὄντι συγγόνῳ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:14.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:14.1.text#θέσθαι. τί τἄρρητ' ἀναμετρήσασθαί με δεῖ;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:15.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:15.1.text#ἔδαισε δ' οὖν νιν τέκν' ἀποκτείνας Ἀτρεύς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:16.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:16.1.text#Ἀτρέως δέ· τὰς γὰρ ἐν μέσῳ σιγῶ τύχας·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:17.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:17.1.text#ὁ κλεινός, εἰ δὴ κλεινός, Ἀγαμέμνων ἔφυ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:18.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:18.1.text#Μενέλεώς τε Κρήσσης μητρὸς Ἀερόπης ἄπο.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:19.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:19.1.text#γαμεῖ δ' ὃ μὲν δὴ τὴν θεοῖς στυγουμένην
urn:cts:greekLit:tlg0006.tlg016.fu.sp:20.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:20.1.text#Μενέλαος Ἑλένην, ὃ δὲ Κλυταιμήστρας λέχος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:21.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:21.1.text#ἐπίσημον εἰς Ἕλληνας Ἀγαμέμνων ἄναξ·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:22.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:22.1.text#ᾧ παρθένοι μὲν τρεῖς ἔφυμεν ἐκ μιᾶς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:23.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:23.1.text#Χρυσόθεμις Ἰφιγένειά τ' Ἠλέκτρα τ' ἐγώ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:24.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:24.1.text#ἄρσην δ' Ὀρέστης, μητρὸς ἀνοσιωτάτης,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:25.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:25.1.text#ἣ πόσιν ἀπείρῳ περιβαλοῦσ' ὑφάσματι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:26.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:26.1.text#ἔκτεινεν· ὧν δ' ἕκατι, παρθένῳ λέγειν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:27.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:27.1.text#οὐ καλόν· ἐῶ τοῦτ' ἀσαφὲς ἐν κοινῷ σκοπεῖν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:28.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:28.1.text#Φοίβου δ' ἀδικίαν μὲν τί δεῖ κατηγορεῖν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:29.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:29.1.text#πείθει δ' Ὀρέστην μητέρ' ἥ σφ' ἐγείνατο
urn:cts:greekLit:tlg0006.tlg016.fu.sp:30.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:30.1.text#κτεῖναι, πρὸς οὐχ ἅπαντας εὔκλειαν φέρον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:31.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:31.1.text#ὅμως δ' ἀπέκτειν' οὐκ ἀπειθήσας θεῷ·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:32.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:32.1.text#κἀγὼ μετέσχον, οἷα δὴ γυνή, φόνου.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:33.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:33.1.text#[ Πυλάδης θ', ὃς ἡμῖν συγκατείργασται τάδε. ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:34.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:34.1.text#ἐντεῦθεν ἀγρίᾳ συντακεὶς νόσῳ [ νοσεῖ ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:35.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:35.1.text#τλήμων Ὀρέστης ὅδε πεσὼν ἐν δεμνίοις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:36.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:36.1.text#κεῖται, τὸ μητρὸς δ' αἷμά νιν τροχηλατεῖ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:37.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:37.1.text#μανίαισιν· ὀνομάζειν γὰρ αἰδοῦμαι θεὰς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:38.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:38.1.text#εὐμενίδας, αἳ τόνδ' ἐξαμιλλῶνται φόβῳ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:39.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:39.1.text#ἕκτον δὲ δὴ τόδ' ἦμαρ ἐξ ὅτου σφαγαῖς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:40.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:40.1.text#θανοῦσα μήτηρ πυρὶ καθήγνισται δέμας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:41.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:41.1.text#ὧν οὔτε σῖτα διὰ δέρης ἐδέξατο,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:42.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:42.1.text#οὐ λούτρ' ἔδωκε χρωτί· χλανιδίων δ' ἔσω
urn:cts:greekLit:tlg0006.tlg016.fu.sp:43.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:43.1.text#κρυφθείς, ὅταν μὲν σῶμα κουφισθῇ νόσου,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:44.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:44.1.text#ἔμφρων δακρύει, ποτὲ δὲ δεμνίων ἄπο
urn:cts:greekLit:tlg0006.tlg016.fu.sp:45.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:45.1.text#πηδᾷ δρομαῖος, πῶλος ὣς ὑπὸ ζυγοῦ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:46.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:46.1.text#ἔδοξε δ' Ἄργει τῷδε μήθ' ἡμᾶς στέγαις,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:47.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:47.1.text#μὴ πυρὶ δέχεσθαι, μήτε προσφωνεῖν τινα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:48.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:48.1.text#μητροκτονοῦντας· κυρία δ' ἥδ' ἡμέρα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:49.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:49.1.text#ἐν ᾗ διοίσει ψῆφον Ἀργείων πόλις,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:50.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:50.1.text#εἰ χρὴ θανεῖν νὼ λευσίμῳ πετρώματι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:51.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:51.1.text#[ ἢ φάσγανον θήξαντ' ἐπ' αὐχένος βαλεῖν. ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:52.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:52.1.text#ἐλπίδα δὲ δή τιν' ἔχομεν ὥστε μὴ θανεῖν·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:53.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:53.1.text#ἥκει γὰρ ἐς γῆν Μενέλεως Τροίας ἄπο,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:54.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:54.1.text#λιμένα δὲ Ναυπλίειον ἐκπληρῶν πλάτῃ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:55.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:55.1.text#ἀκταῖσιν ὁρμεῖ, δαρὸν ἐκ Τροίας χρόνον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:56.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:56.1.text#ἄλαισι πλαγχθείς· τὴν δὲ δὴ πολύστονον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:57.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:57.1.text#Ἑλένην, φυλάξας νύκτα, μή τις εἰσιδὼν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:58.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:58.1.text#μεθ' ἡμέραν στείχουσαν, ὧν ὑπ' Ἰλίῳ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:59.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:59.1.text#παῖδες τεθνᾶσιν, ἐς πέτρων ἔλθῃ βολάς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:60.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:60.1.text#προύπεμψεν ἐς δῶμ' ἡμέτερον· ἔστιν δ' ἔσω
urn:cts:greekLit:tlg0006.tlg016.fu.sp:61.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:61.1.text#κλαίουσ' ἀδελφὴν συμφοράν τε δωμάτων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:62.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:62.1.text#ἔχει δὲ δή τιν' ἀλγέων παραψυχήν·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:63.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:63.1.text#ἣν γὰρ κατ' οἴκους ἔλιφ', ὅτ' ἐς Τροίαν ἔπλει,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:64.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:64.1.text#παρθένον ἐμῇ τε μητρὶ παρέδωκεν τρέφειν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:65.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:65.1.text#Μενέλαος ἀγαγὼν Ἑρμιόνην Σπάρτης ἄπο,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:66.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:66.1.text#ταύτῃ γέγηθε κἀπιλήθεται κακῶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:67.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:67.1.text#βλέπω δὲ πᾶσαν εἰς ὁδόν, πότ' ὄψομαι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:68.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:68.1.text#Μενέλαον ἥκονθ'· ὡς τά γ' ἄλλ' ἐπ' ἀσθενοῦς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:69.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:69.1.text#ῥώμης ὀχούμεθ', ἤν τι μὴ κείνου πάρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:70.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:70.1.text#σωθῶμεν. ἄπορον χρῆμα δυστυχῶν δόμος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:71.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:71.1.text#ὦ παῖ Κλυταιμήστρας τε καὶ Ἀγαμέμνονος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:72.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:72.1.text#παρθένε μακρὸν δὴ μῆκος Ἠλέκτρα χρόνου,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:73.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:73.1.text#πῶς, ὦ τάλαινα, σύ τε κασίγνητός τε σὸς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:74.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:74.1.text#τλήμων Ὀρέστης μητρὸς ὅδε φονεὺς ἔχει;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:75.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:75.1.text#προσφθέγμασιν γὰρ οὐ μιαίνομαι σέθεν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:76.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:76.1.text#ἐς Φοῖβον ἀναφέρουσα τὴν ἁμαρτίαν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:77.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:77.1.text#καίτοι στένω γε τὸν Κλυταιμήστρας μόρον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:78.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:78.1.text#ἐμῆς ἀδελφῆς, ἥν, ἐπεὶ πρὸς Ἴλιον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:79.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:79.1.text#ἔπλευσ' ὅπως ἔπλευσα θεομανεῖ πότμῳ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:80.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:80.1.text#οὐκ εἶδον, ἀπολειφθεῖσα δ' αἰάζω τύχας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:81.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:81.1.text#Ἑλένη, τί σοι λέγοιμ' ἂν ἅ γε παροῦσ' ὁρᾷς;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:82.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:82.1.text#[ ἐν συμφοραῖσι τὸν Ἀγαμέμνονος δόμον ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:83.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:83.1.text#ἐγὼ μὲν ἄυπνος πάρεδρος ἀθλίῳ νεκρῷ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:84.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:84.1.text#— νεκρὸς γὰρ οὗτος οὕνεκα σμικρᾶς πνοῆς —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:85.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:85.1.text#θάσσω· τὰ τούτου δ' οὐκ ὀνειδίζω κακά.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:86.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:86.1.text#σὺ δ' εἶ μακαρία μακάριός θ' ὁ σὸς πόσις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:87.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:87.1.text#[ ἥκετον ἐφ' ἡμᾶς ἀθλίως πεπραγότας ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:88.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:88.1.text#πόσον χρόνον δ' ἐν δεμνίοις πέπτωχ' ὅδε;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:89.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:89.1.text#ἐξ οὗπερ αἷμα γενέθλιον κατήνυσεν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:90.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:90.1.text#ὢ μέλεος· ἡ τεκοῦσά θ', ὡς διώλετο.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:91.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:91.1.text#οὕτως ἔχει τάδ', ὥστ' ἀπείρηκεν κακοῖς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:92.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:92.1.text#πρὸς θεῶν, πίθοι' ἂν δῆτά μοί τι, παρθένε;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:93.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:93.1.text#ὡς ἄσχολός γε συγγόνου προσεδρίᾳ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:94.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:94.1.text#βούλῃ τάφον μοι πρὸς κασιγνήτης μολεῖν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:95.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:95.1.text#μητρὸς κελεύεις τῆς ἐμῆς; τίνος χάριν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:96.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:96.1.text#κόμης ἀπαρχὰς καὶ χοὰς φέρουσ' ἐμάς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:97.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:97.1.text#σοὶ δ' οὐχὶ θεμιτὸν πρὸς φίλων στείχειν τάφον;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:98.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:98.1.text#δεῖξαι γὰρ Ἀργείοισι σῶμ' αἰσχύνομαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:99.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:99.1.text#ὀψέ γε φρονεῖς εὖ, τότε λιποῦσ' αἰσχρῶς δόμους.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:100.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:100.1.text#ὀρθῶς ἔλεξας, οὐ φίλως δ' ἐμοὶ λέγεις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:101.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:101.1.text#αἰδὼς δὲ δὴ τίς σ' ἐς Μυκηναίους ἔχει;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:102.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:102.1.text#δέδοικα πατέρας τῶν ὑπ' Ἰλίῳ νεκρῶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:103.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:103.1.text#δεινὸν γάρ· Ἄργει τ' ἀναβοᾷ διὰ στόμα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:104.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:104.1.text#σύ νυν χάριν μοι τὸν φόβον λύσασα δός.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:105.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:105.1.text#οὐκ ἂν δυναίμην μητρὸς ἐσβλέψαι τάφον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:106.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:106.1.text#αἰσχρόν γε μέντοι προσπόλους φέρειν τάδε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:107.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:107.1.text#τί δ' οὐχὶ θυγατρὸς Ἑρμιόνης πέμπεις δέμας;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:108.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:108.1.text#ἐς ὄχλον ἕρπειν παρθένοισιν οὐ καλόν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:109.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:109.1.text#καὶ μὴν τίνοι γ' ἂν τῇ τεθνηκυίᾳ τροφάς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:110.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:110.1.text#ὀρθῶς ἔλεξας, πείθομαί τέ σοι, κόρη.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:111.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:111.1.text#[ καὶ πέμψομέν γε θυγατέρ'· εὖ γάρ τοι λέγεις. ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:112.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:112.1.text#ὦ τέκνον, ἔξελθ', Ἑρμιόνη, δόμων πάρος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:113.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:113.1.text#καὶ λαβὲ χοὰς τάσδ' ἐν χεροῖν κόμας τ' ἐμάς·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:114.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:114.1.text#ἐλθοῦσα δ' ἀμφὶ τὸν Κλυταιμήστρας τάφον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:115.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:115.1.text#μελίκρατ' ἄφες γάλακτος οἰνωπόν τ' ἄχνην,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:116.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:116.1.text#καὶ στᾶσ' ἐπ' ἄκρου χώματος λέξον τάδε·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:117.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:117.1.text#Ἑλένη σ' ἀδελφὴ ταῖσδε δωρεῖται χοαῖς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:118.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:118.1.text#φόβῳ προσελθεῖν μνῆμα σόν, ταρβοῦσά τε
urn:cts:greekLit:tlg0006.tlg016.fu.sp:119.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:119.1.text#Ἀργεῖον ὄχλον. πρευμενῆ δ' ἄνωγέ νιν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:120.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:120.1.text#ἐμοί τε καὶ σοὶ καὶ πόσει γνώμην ἔχειν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:121.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:121.1.text#τοῖν τ' ἀθλίοιν τοῖνδ', οὓς ἀπώλεσεν θεός.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:122.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:122.1.text#ἃ δ' εἰς ἀδελφὴν καιρὸς ἐκπονεῖν ἐμέ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:123.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:123.1.text#ἅπανθ' ὑπισχνοῦ νερτέρων δωρήματα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:124.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:124.1.text#ἴθ', ὦ τέκνον μοι, σπεῦδε καὶ χοὰς τάφῳ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:125.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:125.1.text#δοῦσ' ὡς τάχιστα τῆς πάλιν μέμνησ' ὁδοῦ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:126.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:126.1.text#ὦ φύσις, ἐν ἀνθρώποισιν ὡς μέγ' εἶ κακόν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:127.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:127.1.text#σωτήριόν τε τοῖς καλῶς κεκτημένοις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:128.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:128.1.text#εἴδετε παρ' ἄκρας ὡς ἀπέθρισεν τρίχας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:129.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:129.1.text#σῴζουσα κάλλος; ἔστι δ' ἡ πάλαι γυνή.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:130.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:130.1.text#θεοί σε μισήσειαν, ὥς μ' ἀπώλεσας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:131.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:131.1.text#καὶ τόνδε πᾶσάν θ' Ἑλλάδα. ὦ τάλαιν' ἐγώ·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:132.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:132.1.text#αἵδ' αὖ πάρεισι τοῖς ἐμοῖς θρηνήμασι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:133.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:133.1.text#φίλαι ξυνῳδοί· τάχα μεταστήσουσ' ὕπνου
urn:cts:greekLit:tlg0006.tlg016.fu.sp:134.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:134.1.text#τόνδ' ἡσυχάζοντ', ὄμμα δ' ἐκτήξουσ' ἐμὸν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:135.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:135.1.text#δακρύοις, ἀδελφὸν ὅταν ὁρῶ μεμηνότα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:136.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:136.1.text#[ ὦ φίλταται γυναῖκες, ἡσύχῳ ποδὶ ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:137.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:137.1.text#[ χωρεῖτε, μὴ ψοφεῖτε, μηδ' ἔστω κτύπος. ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:138.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:138.1.text#[ φιλία γὰρ ἡ σὴ πρευμενὴς μέν, ἀλλ' ἐμοὶ ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:139.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:139.1.text#[ τόνδ' ἐξεγεῖραι συμφορὰ γενήσεται. ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:140.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:140.1.text#σῖγα σῖγα, λεπτὸν ἴχνος ἀρβύλης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:141.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:141.1.text#τίθετε, μὴ κτυπεῖτ'.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:142.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:142.1.text#ἀποπρὸ βᾶτ' ἐκεῖσ', ἀποπρό μοι κοίτας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:143.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:143.1.text#ἰδού, πείθομαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:145.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:145.1.text#ἆ ἆ σύριγγος ὅπως πνοὰ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:146.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:146.1.text#λεπτοῦ δόνακος, ὦ φίλα, φώνει μοι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:147.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:147.1.text#ἴδ', ἀτρεμαῖον ὡς ὑπόροφον φέρω
urn:cts:greekLit:tlg0006.tlg016.fu.sp:148.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:148.1.text#βοάν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:148.2.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:148.2.text#ναί, οὕτως·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:149.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:149.1.text#κάταγε κάταγε, πρόσιθ' ἀτρέμας, ἀτρέμας ἴθι·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:150.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:150.1.text#λόγον ἀπόδος ἐφ' ὅ τι χρέος ἐμόλετέ ποτε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:151.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:151.1.text#χρόνια γὰρ πεσὼν ὅδ' εὐνάζεται.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:153.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:153.1.text#πῶς ἔχει; λόγου μετάδος, ὦ φίλα·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:154.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:154.1.text#τίνα τύχαν εἴπω; τίνα δὲ συμφοράν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:155.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:155.1.text#ἔτι μὲν ἐμπνέει, βραχὺ δ' ἀναστένει.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:156.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:156.1.text#τί φῄς; ὦ τάλας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:158.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:158.1.text#ὀλεῖς, εἰ βλέφαρα κινήσεις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:159.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:159.1.text#ὕπνου γλυκυτάταν φερομένῳ χάριν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:160.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:160.1.text#μέλεος ἐχθίστων θεόθεν ἐργμάτων,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:161.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:161.1.text#τάλας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:162.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:162.1.text#φεῦ μόχθων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:163.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:163.1.text#ἄδικος ἄδικα τότ' ἄρ' ἔλακεν ἔλακεν, ἀπόφονον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:164.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:164.1.text#ὅτ' ἐπὶ τρίποδι Θέμιδος ἄρ' ἐδίκασε
urn:cts:greekLit:tlg0006.tlg016.fu.sp:165.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:165.1.text#φόνον ὁ Λοξίας ἐμᾶς ματέρος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:166.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:166.1.text#ὁρᾷς; ἐν πέπλοισι κινεῖ δέμας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:167.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:167.1.text#σὺ γάρ νιν, ὦ τάλαινα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:168.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:168.1.text#θωΰξασ' ἔβαλες ἐξ ὕπνου.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:169.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:169.1.text#εὕδειν μὲν οὖν ἔδοξα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:170.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:170.1.text#οὐκ ἀφ' ἡμῶν, οὐκ ἀπ' οἴκων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:171.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:171.1.text#πάλιν ἀνὰ πόδα σὸν εἱλίξεις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:172.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:172.1.text#μεθεμένα κτύπου;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:173.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:173.1.text#ὑπνώσσει.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:173.2.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:173.2.text#λέγεις εὖ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:174.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:174.1.text#πότνια, πότνια νύξ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:175.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:175.1.text#ὑπνοδότειρα τῶν πολυπόνων βροτῶν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:178.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:178.1.text#ἐρεβόθεν ἴθι, μόλε μόλε κατάπτερος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:179.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:179.1.text#τὸν Ἀγαμεμνόνιον ἐπὶ δόμον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:180.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:180.1.text#ὑπὸ γὰρ ἀλγέων ὑπό τε συμφορᾶς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:181.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:181.1.text#διοιχόμεθ', οἰχόμεθα. κτύπον ἠγάγετ'· οὐχὶ σῖγα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:182.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:182.1.text#σῖγα φυλασσομένα στόματος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:185.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:185.1.text#ἄνα κέλαδον ἀπὸ λέχεος ἥσυχον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:186.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:186.1.text#ὕπνου χάριν παρέξεις, φίλα;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:187.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:187.1.text#θρόει τίς κακῶν τελευτὰ μένει.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:188.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:188.1.text#θανεῖν { θανεῖν }, τί δ' ἄλλο;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:189.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:189.1.text#οὐδὲ γὰρ πόθον ἔχει βορᾶς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:190.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:190.1.text#πρόδηλος ἆρ' ὁ πότμος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:191.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:191.1.text#ἐξέθυσ' ὁ Φοῖβος ἡμᾶς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:192.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:192.1.text#μέλεον ἀπόφονον αἷμα δοὺς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:193.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:193.1.text#πατροφόνου ματρός.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:194.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:194.1.text#δίκᾳ μέν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:194.2.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:194.2.text#καλῶς δ' οὔ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:195.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:195.1.text#ἔκανες ἔθανες, ὦ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:196.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:196.1.text#τεκομένα με μᾶτερ, ἀπὸ δ' ὤλεσας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:197.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:197.1.text#πατέρα τέκνα τε τάδε σέθεν ἀφ' αἵματος·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:200.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:200.1.text#ὀλόμεθ' ἰσονέκυες, ὀλόμεθα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:201.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:201.1.text#σύ τε γὰρ ἐν νεκροῖς, τό τ' ἐμὸν οἴχεται
urn:cts:greekLit:tlg0006.tlg016.fu.sp:204.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:204.1.text#βίου τὸ πλέον μέρος ἐν στοναχαῖσί τε καὶ γόοισι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:205.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:205.1.text#δάκρυσί τ' ἐννυχίοις, ἄγαμος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:206.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:206.1.text#[ ἐπὶ δ' ] ἄτεκνος ἅτε βίοτον ἁ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:207.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:207.1.text#μέλεος ἐς τὸν αἰὲν ἕλκω χρόνον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:208.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:208.1.text#ὅρα παροῦσα, παρθέν' Ἠλέκτρα, πέλας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:209.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:209.1.text#μὴ κατθανών σε σύγγονος λέληθ' ὅδε·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:210.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:210.1.text#οὐ γάρ μ' ἀρέσκει τῷ λίαν παρειμένῳ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:211.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:211.1.text#ὦ φίλον ὕπνου θέλγητρον, ἐπίκουρον νόσου,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:212.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:212.1.text#ὡς ἡδύ μοι προσῆλθες — ἐν δέοντί γε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:213.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:213.1.text#ὦ πότνια Λήθη τῶν κακῶν, ὡς εἶ σοφὴ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:214.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:214.1.text#καὶ τοῖσι δυστυχοῦσιν εὐκταία θεός.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:215.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:215.1.text#πόθεν ποτ' ἦλθον δεῦρο; πῶς δ' ἀφικόμην;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:216.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:216.1.text#ἀμνημονῶ γάρ, τῶν πρὶν ἀπολειφθεὶς φρενῶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:217.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:217.1.text#ὦ φίλταθ', ὥς μ' ηὔφρανας εἰς ὕπνον πεσών.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:218.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:218.1.text#βούλῃ θίγω σου κἀνακουφίσω δέμας;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:219.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:219.1.text#λαβοῦ λαβοῦ δῆτ', ἐκ δ' ὄμορξον ἀθλίου
urn:cts:greekLit:tlg0006.tlg016.fu.sp:220.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:220.1.text#στόματος ἀφρώδη πέλανον ὀμμάτων τ' ἐμῶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:221.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:221.1.text#ἰδού· τὸ δούλευμ' ἡδύ, κοὐκ ἀναίνομαι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:222.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:222.1.text#ἀδέλφ' ἀδελφῇ χειρὶ θεραπεύειν μέλη.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:223.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:223.1.text#ὑπόβαλε πλευροῖς πλευρά, καὐχμώδη κόμην
urn:cts:greekLit:tlg0006.tlg016.fu.sp:224.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:224.1.text#ἄφελε προσώπου· λεπτὰ γὰρ λεύσσω κόραις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:225.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:225.1.text#ὦ βοστρύχων πινῶδες ἄθλιον κάρα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:226.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:226.1.text#ὡς ἠγρίωσαι διὰ μακρᾶς ἀλουσίας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:227.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:227.1.text#κλῖνόν μ' ἐς εὐνὴν αὖθις· ὅταν ἀνῇ νόσος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:228.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:228.1.text#μανίας, ἄναρθρός εἰμι κἀσθενῶ μέλη.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:229.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:229.1.text#ἰδού. φίλον τοι τῷ νοσοῦντι δέμνιον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:230.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:230.1.text#ἀνιαρὸν ὂν τὸ κτῆμ', ἀναγκαῖον δ' ὅμως.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:231.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:231.1.text#αὖθίς μ' ἐς ὀρθὸν στῆσον, ἀνακύκλει δέμας·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:232.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:232.1.text#δυσάρεστον οἱ νοσοῦντες ἀπορίας ὕπο.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:233.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:233.1.text#ἦ κἀπὶ γαίας ἁρμόσαι πόδας θέλεις,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:234.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:234.1.text#χρόνιον ἴχνος θείς; μεταβολὴ πάντων γλυκύ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:235.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:235.1.text#μάλιστα· δόξαν γὰρ τόδ' ὑγιείας ἔχει.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:236.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:236.1.text#κρεῖσσον δὲ τὸ δοκεῖν, κἂν ἀληθείας ἀπῇ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:237.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:237.1.text#ἄκουε δὴ νῦν, ὦ κασίγνητον κάρα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:238.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:238.1.text#ἕως ἐῶσιν εὖ φρονεῖν Ἐρινύες.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:239.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:239.1.text#λέξεις τι καινόν· κεἰ μὲν εὖ, χάριν φέρεις·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:240.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:240.1.text#εἰ δ' ἐς βλάβην τιν', ἅλις ἔχω τὸ δυστυχεῖν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:241.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:241.1.text#Μενέλαος ἥκει, σοῦ κασίγνητος πατρός,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:242.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:242.1.text#ἐν Ναυπλίᾳ δὲ σέλμαθ' ὥρμισται νεῶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:243.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:243.1.text#πῶς εἶπας; ἥκει φῶς ἐμοῖς καὶ σοῖς κακοῖς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:244.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:244.1.text#ἀνὴρ ὁμογενὴς καὶ χάριτας ἔχων πατρός;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:245.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:245.1.text#ἥκει — τὸ πιστὸν τόδε λόγων ἐμῶν δέχου —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:246.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:246.1.text#Ἑλένην ἀγόμενος Τρωικῶν ἐκ τειχέων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:247.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:247.1.text#εἰ μόνος ἐσώθη, μᾶλλον ἂν ζηλωτὸς ἦν·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:248.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:248.1.text#εἰ δ' ἄλοχον ἄγεται, κακὸν ἔχων ἥκει μέγα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:249.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:249.1.text#ἐπίσημον ἔτεκε Τυνδάρεως ἐς τὸν ψόγον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:250.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:250.1.text#γένος θυγατέρων δυσκλεές τ' ἀν' Ἑλλάδα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:251.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:251.1.text#σύ νυν διάφερε τῶν κακῶν· ἔξεστι γάρ·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:252.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:252.1.text#καὶ μὴ μόνον λέγ', ἀλλὰ καὶ φρόνει τάδε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:253.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:253.1.text#οἴμοι, κασίγνητ', ὄμμα σὸν ταράσσεται,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:254.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:254.1.text#ταχὺς δὲ μετέθου λύσσαν, ἄρτι σωφρονῶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:255.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:255.1.text#ὦ μῆτερ, ἱκετεύω σε, μὴ 'πίσειέ μοι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:256.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:256.1.text#τὰς αἱματωποὺς καὶ δρακοντώδεις κόρας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:257.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:257.1.text#αὗται γὰρ αὗται πλησίον θρῴσκουσί μου.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:258.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:258.1.text#μέν', ὦ ταλαίπωρ', ἀτρέμα σοῖς ἐν δεμνίοις·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:259.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:259.1.text#ὁρᾷς γὰρ οὐδὲν ὧν δοκεῖς σάφ' εἰδέναι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:260.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:260.1.text#ὦ Φοῖβ', ἀποκτενοῦσί μ' αἱ κυνώπιδες
urn:cts:greekLit:tlg0006.tlg016.fu.sp:261.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:261.1.text#γοργῶπες, ἐνέρων ἱέρεαι, δειναὶ θεαί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:262.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:262.1.text#οὔτοι μεθήσω· χεῖρα δ' ἐμπλέξασ' ἐμὴν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:263.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:263.1.text#σχήσω σε πηδᾶν δυστυχῆ πηδήματα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:264.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:264.1.text#μέθες· μί' οὖσα τῶν ἐμῶν Ἐρινύων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:265.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:265.1.text#μέσον μ' ὀχμάζεις, ὡς βάλῃς ἐς Τάρταρον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:266.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:266.1.text#οἲ 'γὼ τάλαινα, τίν' ἐπικουρίαν λάβω,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:267.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:267.1.text#ἐπεὶ τὸ θεῖον δυσμενὲς κεκτήμεθα;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:268.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:268.1.text#δὸς τόξα μοι κερουλκά, δῶρα Λοξίου,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:269.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:269.1.text#οἷς μ' εἶπ' Ἀπόλλων ἐξαμύνασθαι θεάς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:270.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:270.1.text#εἴ μ' ἐκφοβοῖεν μανιάσιν λυσσήμασιν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:271.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:271.1.text#βεβλήσεταί τις θεῶν βροτησίᾳ χερί,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:272.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:272.1.text#εἰ μὴ 'ξαμείψει χωρὶς ὀμμάτων ἐμῶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:273.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:273.1.text#οὐκ εἰσακούετ'; οὐχ ὁρᾶθ' ἑκηβόλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:274.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:274.1.text#τόξων πτερωτὰς γλυφίδας ἐξορμωμένας;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:274.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:274.2.text#ἆ ἆ·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:275.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:275.1.text#τί δῆτα μέλλετ'; ἐξακρίζετ' αἰθέρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:276.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:276.1.text#πτεροῖς· τὰ Φοίβου δ' αἰτιᾶσθε θέσφατα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:276.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:276.2.text#ἔα·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:277.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:277.1.text#τί χρῆμ' ἀλύω, πνεῦμ' ἀνεὶς ἐκ πλευμόνων;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:278.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:278.1.text#ποῖ ποῖ ποθ' ἡλάμεσθα δεμνίων ἄπο;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:279.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:279.1.text#ἐκ κυμάτων γὰρ αὖθις αὖ γαλήν' ὁρῶ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:280.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:280.1.text#σύγγονε, τί κλαίεις κρᾶτα θεῖσ' ἔσω πέπλων;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:281.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:281.1.text#αἰσχύνομαί σε, μεταδιδοὺς πόνων ἐμῶν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:282.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:282.1.text#ὄχλον τε παρέχων παρθένῳ νόσοις ἐμαῖς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:283.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:283.1.text#μὴ τῶν ἐμῶν ἕκατι συντήκου κακῶν·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:284.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:284.1.text#σὺ μὲν γὰρ ἐπένευσας τάδ', εἴργασται δ' ἐμοὶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:285.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:285.1.text#μητρῷον αἷμα· Λοξίᾳ δὲ μέμφομαι,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:286.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:286.1.text#ὅστις μ' ἐπάρας ἔργον ἀνοσιώτατον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:287.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:287.1.text#τοῖς μὲν λόγοις ηὔφρανε, τοῖς δ' ἔργοισιν οὔ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:288.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:288.1.text#οἶμαι δὲ πατέρα τὸν ἐμόν, εἰ κατ' ὄμματα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:289.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:289.1.text#ἐξιστόρουν νιν, μητέρ' εἰ κτεῖναι χρεών,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:290.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:290.1.text#πολλὰς γενείου τοῦδ' ἂν ἐκτεῖναι λιτὰς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:291.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:291.1.text#μήποτε τεκούσης ἐς σφαγὰς ὦσαι ξίφος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:292.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:292.1.text#εἰ μήτ' ἐκεῖνος ἀναλαβεῖν ἔμελλε φῶς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:293.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:293.1.text#ἐγώ θ' ὁ τλήμων τοιάδ' ἐκπλήσειν κακά.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:294.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:294.1.text#καὶ νῦν ἀνακάλυπτ', ὦ κασιγνήτη, κάρα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:295.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:295.1.text#ἐκ δακρύων τ' ἄπελθε, κεἰ μάλ' ἀθλίως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:296.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:296.1.text#ἔχομεν. ὅταν δὲ τἄμ' ἀθυμήσαντ' ἴδῃς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:297.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:297.1.text#σύ μου τὸ δεινὸν καὶ διαφθαρὲν φρενῶν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:298.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:298.1.text#ἴσχναινε παραμυθοῦ θ'· ὅταν δὲ σὺ στένῃς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:299.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:299.1.text#ἡμᾶς παρόντας χρή σε νουθετεῖν φίλα·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:300.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:300.1.text#ἐπικουρίαι γὰρ αἵδε τοῖς φίλοις καλαί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:301.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:301.1.text#ἀλλ', ὦ τάλαινα, βᾶσα δωμάτων ἔσω
urn:cts:greekLit:tlg0006.tlg016.fu.sp:302.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:302.1.text#ὕπνῳ τ' ἄυπνον βλέφαρον ἐκταθεῖσα δός,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:303.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:303.1.text#σίτων τ' ὄρεξαι λουτρά τ' ἐπιβαλοῦ χροΐ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:304.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:304.1.text#εἰ γὰρ προλείψεις ἢ προσεδρείᾳ νόσον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:305.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:305.1.text#κτήσῃ τιν', οἰχόμεσθα· σὲ γὰρ ἔχω μόνην
urn:cts:greekLit:tlg0006.tlg016.fu.sp:306.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:306.1.text#ἐπίκουρον, ἄλλων, ὡς ὁρᾷς, ἔρημος ὤν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:307.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:307.1.text#οὐκ ἔστι· σὺν σοὶ καὶ θανεῖν αἱρήσομαι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:308.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:308.1.text#καὶ ζῆν· ἔχει γὰρ ταὐτόν· ἢν σὺ κατθάνῃς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:309.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:309.1.text#γυνὴ τί δράσω; πῶς μόνη σωθήσομαι,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:310.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:310.1.text#ἀνάδελφος ἀπάτωρ ἄφιλος; εἰ δὲ σοὶ δοκεῖ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:311.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:311.1.text#δρᾶν χρὴ τάδ'. ἀλλὰ κλῖνον εἰς εὐνὴν δέμας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:312.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:312.1.text#καὶ μὴ τὸ ταρβοῦν κἀκφοβοῦν σ' ἐκ δεμνίων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:313.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:313.1.text#ἄγαν ἀποδέχου, μένε δ' ἐπὶ στρωτοῦ λέχους.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:314.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:314.1.text#κἂν μὴ νοσῇς γάρ, ἀλλὰ δοξάζῃς νοσεῖν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:315.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:315.1.text#κάματος βροτοῖσιν ἀπορία τε γίγνεται.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:316.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:316.1.text#αἰαῖ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:317.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:317.1.text#δρομάδες ὦ πτεροφόροι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:318.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:318.1.text#ποτνιάδες θεαί,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:319.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:319.1.text#ἀβάκχευτον αἳ θίασον ἐλάχετ' ἐν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:320.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:320.1.text#δάκρυσι καὶ γόοις,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:321.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:321.1.text#μελάγχρωτες εὐμενίδες, αἵτε τὸν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:322.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:322.1.text#ταναὸν αἰθέρ' ἀμπάλλεσθ', αἵματος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:323.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:323.1.text#τινύμεναι δίκαν, τινύμεναι φόνον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:324.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:324.1.text#καθικετεύομαι καθικετεύομαι,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:325.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:325.1.text#τὸν Ἀγαμέμνονος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:326.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:326.1.text#γόνον ἐάσατ' ἐκλαθέσθαι λύσσας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:327.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:327.1.text#μανιάδος φοιταλέου. φεῦ μόχθων,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:328.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:328.1.text#οἵων, ὦ τάλας, ὀρεχθεὶς ἔρρεις,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:329.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:329.1.text#τρίποδος ἄπο φάτιν, ἃν ὁ Φοῖβος ἔλακε, δεξάμενος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:330.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:330.1.text#ἀνὰ δάπεδον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:331.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:331.1.text#ἵνα μεσόμφαλοι λέγονται μυχοί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:332.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:332.1.text#ἰὼ Ζεῦ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:333.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:333.1.text#τίς ἔλεος, τίς ὅδ' ἀγὼν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:334.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:334.1.text#φόνιος ἔρχεται,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:335.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:335.1.text#θοάζων σε τὸν μέλεον, ᾧ δάκρυα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:336.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:336.1.text#δάκρυσι συμβάλλει
urn:cts:greekLit:tlg0006.tlg016.fu.sp:337.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:337.1.text#πορεύων τις ἐς δόμον ἀλαστόρων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:338.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:338.1.text#ματέρος αἷμα σᾶς, ὅ σ' ἀναβακχεύει;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:340.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:340.1.text#ὁ μέγας ὄλβος οὐ μόνιμος ἐν βροτοῖς·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:339.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:339.1.text#κατολοφύρομαι κατολοφύρομαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:341.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:341.1.text#ἀνὰ δὲ λαῖφος ὥς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:342.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:342.1.text#τις ἀκάτου θοᾶς τινάξας δαίμων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:343.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:343.1.text#κατέκλυσεν δεινῶν πόνων ὡς πόντου
urn:cts:greekLit:tlg0006.tlg016.fu.sp:344.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:344.1.text#λάβροις ὀλεθρίοισιν ἐν κύμασιν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:345.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:345.1.text#τίνα γὰρ ἔτι πάρος οἶκον ἕτερον ἢ τὸν ἀπὸ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:346.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:346.1.text#θεογόνων γάμων,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:347.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:347.1.text#τὸν ἀπὸ Ταντάλου, σέβεσθαί με χρή;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:348.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:348.1.text#καὶ μὴν βασιλεὺς ὅδε δὴ στείχει,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:349.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:349.1.text#Μενέλαος ἄναξ, πολλῇ ἁβροσύνῃ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:350.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:350.1.text#δῆλος ὁρᾶσθαι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:351.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:351.1.text#τῶν Τανταλιδῶν ἐξ αἵματος ὤν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:352.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:352.1.text#ὦ χιλιόναυν στρατὸν ὁρμήσας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:353.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:353.1.text#ἐς γῆν Ἀσίαν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:354.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:354.1.text#χαῖρ', εὐτυχίᾳ δ' αὐτὸς ὁμιλεῖς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:355.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:355.1.text#θεόθεν πράξας ἅπερ ηὔχου.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:356.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:356.1.text#ὦ δῶμα, τῇ μέν σ' ἡδέως προσδέρκομαι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:357.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:357.1.text#Τροίαθεν ἐλθών, τῇ δ' ἰδὼν καταστένω·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:358.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:358.1.text#κύκλῳ γὰρ εἱλιχθεῖσαν ἀθλίως κακοῖς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:359.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:359.1.text#οὐπώποτ' ἄλλην μᾶλλον εἶδον ἑστίαν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:360.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:360.1.text#Ἀγαμέμνονος μὲν γὰρ τύχας ἠπιστάμην
urn:cts:greekLit:tlg0006.tlg016.fu.sp:361.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:361.1.text#καὶ θάνατον, οἵῳ πρὸς δάμαρτος ὤλετο,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:362.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:362.1.text#Μαλέᾳ προσίσχων πρῷραν· ἐκ δὲ κυμάτων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:363.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:363.1.text#ὁ ναυτίλοισι μάντις ἐξήγγειλέ μοι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:364.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:364.1.text#Νηρέως προφήτης Γλαῦκος, ἀψευδὴς θεός,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:365.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:365.1.text#ὅς μοι τόδ' εἶπεν ἐμφανῶς κατασταθείς·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:366.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:366.1.text#Μενέλαε, κεῖται σὸς κασίγνητος θανών,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:367.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:367.1.text#λουτροῖσιν ἀλόχου περιπεσὼν πανυστάτοις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:368.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:368.1.text#δακρύων δ' ἔπλησεν ἐμέ τε καὶ ναύτας ἐμοὺς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:369.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:369.1.text#πολλῶν. ἐπεὶ δὲ Ναυπλίας ψαύω χθονός,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:370.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:370.1.text#ἤδη δάμαρτος ἐνθάδ' ἐξορμωμένης,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:371.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:371.1.text#δοκῶν Ὀρέστην παῖδα τὸν Ἀγαμέμνονος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:372.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:372.1.text#φίλαισι χερσὶ περιβαλεῖν καὶ μητέρα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:373.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:373.1.text#ὡς εὐτυχοῦντας, ἔκλυον ἁλιτύπων τινὸς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:374.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:374.1.text#τῆς Τυνδαρείας παιδὸς ἀνόσιον φόνον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:375.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:375.1.text#καὶ νῦν ὅπου 'στὶν εἴπατ', ὦ νεάνιδες,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:376.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:376.1.text#Ἀγαμέμνονος παῖς, ὃς τὰ δείν' ἔτλη κακά.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:377.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:377.1.text#βρέφος γὰρ ἦν τότ' ἐν Κλυταιμήστρας χεροῖν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:378.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:378.1.text#ὅτ' ἐξέλειπον μέλαθρον ἐς Τροίαν ἰών,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:379.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:379.1.text#ὥστ' οὐκ ἂν αὐτὸν γνωρίσαιμ' ἂν εἰσιδών.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:380.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:380.1.text#ὅδ' εἴμ' Ὀρέστης, Μενέλεως, ὃν ἱστορεῖς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:381.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:381.1.text#ἑκὼν ἐγώ σοι τἀμὰ μηνύσω κακά.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:382.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:382.1.text#τῶν σῶν δὲ γονάτων πρωτόλεια θιγγάνω
urn:cts:greekLit:tlg0006.tlg016.fu.sp:383.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:383.1.text#ἱκέτης, ἀφύλλου στόματος ἐξάπτων λιτάς·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:384.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:384.1.text#σῷσόν μ'· ἀφῖξαι δ' αὐτὸς ἐς καιρὸν κακῶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:385.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:385.1.text#ὦ θεοί, τί λεύσσω; τίνα δέδορκα νερτέρων;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:386.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:386.1.text#εὖ γ' εἶπας· οὐ γὰρ ζῶ κακοῖς, φάος δ' ὁρῶ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:387.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:387.1.text#ὡς ἠγρίωσαι πλόκαμον αὐχμηρόν, τάλας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:388.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:388.1.text#οὐχ ἡ πρόσοψίς μ', ἀλλὰ τἄργ' αἰκίζεται.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:389.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:389.1.text#δεινὸν δὲ λεύσσεις ὀμμάτων ξηραῖς κόραις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:390.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:390.1.text#τὸ σῶμα φροῦδον· τὸ δ' ὄνομ' οὐ λέλοιπέ μοι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:391.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:391.1.text#ὦ παρὰ λόγον μοι σὴ φανεῖσ' ἀμορφία.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:392.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:392.1.text#ὅδ' εἰμὶ μητρὸς τῆς ταλαιπώρου φονεύς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:393.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:393.1.text#ἤκουσα, φείδου δ'· ὀλιγάκις λέγειν κακά.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:394.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:394.1.text#φειδόμεθ'· ὁ δαίμων δ' ἐς ἐμὲ πλούσιος κακῶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:395.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:395.1.text#τί χρῆμα πάσχεις; τίς σ' ἀπόλλυσιν νόσος;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:396.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:396.1.text#ἡ σύνεσις, ὅτι σύνοιδα δείν' εἰργασμένος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:397.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:397.1.text#πῶς φῄς; σοφόν τοι τὸ σαφές, οὐ τὸ μὴ σαφές.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:398.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:398.1.text#λύπη μάλιστά γ' ἡ διαφθείρουσά με —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:399.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:399.1.text#δεινὴ γὰρ ἡ θεός, ἀλλ' ὅμως ἰάσιμος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:400.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:400.1.text#μανίαι τε, μητρὸς αἵματος τιμωρίαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:401.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:401.1.text#ἤρξω δὲ λύσσης πότε; τίς ἡμέρα τότ' ἦν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:402.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:402.1.text#ἐν ᾗ τάλαιναν μητέρ' ἐξώγκουν τάφῳ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:403.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:403.1.text#πότερα κατ' οἴκους ἢ προσεδρεύων πυρᾷ;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:404.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:404.1.text#νυκτὸς φυλάσσων ὀστέων ἀναίρεσιν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:405.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:405.1.text#παρῆν τις ἄλλος, ὃς σὸν ὤρθευεν δέμας;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:406.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:406.1.text#Πυλάδης, ὁ συνδρῶν αἷμα καὶ μητρὸς φόνον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:407.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:407.1.text#ἐκ φασμάτων δὲ τάδε νοσεῖς· ποίων ὕπο;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:408.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:408.1.text#ἔδοξ' ἰδεῖν τρεῖς νυκτὶ προσφερεῖς κόρας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:409.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:409.1.text#οἶδ' ἃς ἔλεξας, ὀνομάσαι δ' οὐ βούλομαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:410.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:410.1.text#σεμναὶ γάρ· εὐπαίδευτα δ' ἀπετρέπου λέγειν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:411.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:411.1.text#αὗταί σε βακχεύουσι συγγενῆ φόνον;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:412.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:412.1.text#οἴμοι διωγμῶν, οἷς ἐλαύνομαι τάλας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:413.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:413.1.text#οὐ δεινὰ πάσχειν δεινὰ τοὺς εἰργασμένους.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:414.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:414.1.text#ἀλλ' ἔστιν ἡμῖν ἀναφορὰ τῆς συμφορᾶς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:415.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:415.1.text#μὴ θάνατον εἴπῃς· τοῦτο μὲν γὰρ οὐ σοφόν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:416.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:416.1.text#Φοῖβος, κελεύσας μητρὸς ἐκπρᾶξαι φόνον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:417.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:417.1.text#ἀμαθέστερός γ' ὢν τοῦ καλοῦ καὶ τῆς δίκης.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:418.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:418.1.text#δουλεύομεν θεοῖς, ὅ τι ποτ' εἰσὶν οἱ θεοί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:419.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:419.1.text#κᾆτ' οὐκ ἀμύνει Λοξίας τοῖς σοῖς κακοῖς;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:420.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:420.1.text#μέλλει· τὸ θεῖον δ' ἐστὶ τοιοῦτον φύσει.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:421.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:421.1.text#πόσον χρόνον δὲ μητρὸς οἴχονται πνοαί;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:422.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:422.1.text#ἕκτον τόδ' ἦμαρ· ἔτι πυρὰ θερμὴ τάφου.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:423.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:423.1.text#ὡς ταχὺ μετῆλθόν σ' αἷμα μητέρος θεαί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:424.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:424.1.text#οὐ σοφός, ἀληθὴς δ' ἐς φίλους { ἔφυν φίλος. }
urn:cts:greekLit:tlg0006.tlg016.fu.sp:425.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:425.1.text#πατρὸς δὲ δή τι σ' ὠφελεῖ τιμωρία;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:426.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:426.1.text#οὔπω· τὸ μέλλον δ' ἴσον ἀπραξίᾳ λέγω.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:427.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:427.1.text#τὰ πρὸς πόλιν δὲ πῶς ἔχεις δράσας τάδε;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:428.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:428.1.text#μισούμεθ' οὕτως ὥστε μὴ προσεννέπειν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:429.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:429.1.text#οὐδ' ἥγνισαι σὸν αἷμα κατὰ νόμον χεροῖν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:430.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:430.1.text#ἐκκλῄομαι γὰρ δωμάτων ὅποι μόλω.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:431.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:431.1.text#τίνες πολιτῶν ἐξαμιλλῶνταί σε γῆς;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:432.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:432.1.text#Οἴαξ, τὸ Τροίας μῖσος ἀναφέρων πατρί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:433.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:433.1.text#συνῆκα· Παλαμήδους σε τιμωρεῖ φόνου.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:434.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:434.1.text#οὗ γ' οὐ μετῆν μοι· διὰ τριῶν δ' ἀπόλλυμαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:435.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:435.1.text#τίς δ' ἄλλος; ἦ που τῶν ἀπ' Αἰγίσθου φίλων;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:436.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:436.1.text#οὗτοί μ' ὑβρίζουσ', ὧν πόλις τὰ νῦν κλύει.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:437.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:437.1.text#Ἀγαμέμνονος δὲ σκῆπτρ' ἐᾷ σ' ἔχειν πόλις;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:438.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:438.1.text#πῶς, οἵτινες ζῆν οὐκ ἐῶσ' ἡμᾶς ἔτι;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:439.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:439.1.text#τί δρῶντες ὅ τι καὶ σαφὲς ἔχεις εἰπεῖν ἐμοί;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:440.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:440.1.text#ψῆφος καθ' ἡμῶν οἴσεται τῇδ' ἡμέρᾳ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:441.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:441.1.text#φεύγειν πόλιν τήνδ'; ἢ θανεῖν ἢ μὴ θανεῖν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:442.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:442.1.text#θανεῖν ὑπ' ἀστῶν λευσίμῳ πετρώματι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:443.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:443.1.text#κᾆτ' οὐχὶ φεύγεις γῆς ὑπερβαλὼν ὅρους;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:444.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:444.1.text#κύκλῳ γὰρ εἱλισσόμεθα παγχάλκοις ὅπλοις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:445.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:445.1.text#ἰδίᾳ πρὸς ἐχθρῶν ἢ πρὸς Ἀργείας χερός;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:446.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:446.1.text#πάντων πρὸς ἀστῶν, ὡς θάνω· βραχὺς λόγος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:447.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:447.1.text#ὦ μέλεος, ἥκεις συμφορᾶς ἐς τοὔσχατον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:448.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:448.1.text#ἐς σὲ ἐλπὶς ἡμὴ καταφυγὰς ἔχει κακῶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:449.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:449.1.text#ἀλλ' ἀθλίως πράσσουσιν εὐτυχὴς μολὼν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:450.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:450.1.text#μετάδος φίλοισι σοῖσι σῆς εὐπραξίας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:451.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:451.1.text#καὶ μὴ μόνος τὸ χρηστὸν ἀπολαβὼν ἔχε,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:452.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:452.1.text#ἀλλ' ἀντιλάζου καὶ πόνων ἐν τῷ μέρει,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:453.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:453.1.text#χάριτας πατρῴας ἐκτίνων ἐς οὕς σε δεῖ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:454.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:454.1.text#ὄνομα γάρ, ἔργον δ' οὐκ ἔχουσιν οἱ φίλοι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:455.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:455.1.text#οἱ μὴ 'πὶ ταῖσι συμφοραῖς ὄντες φίλοι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:456.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:456.1.text#καὶ μὴν γέροντι δεῦρ' ἁμιλλᾶται ποδὶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:457.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:457.1.text#ὁ Σπαρτιάτης Τυνδάρεως, μελάμπεπλος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:458.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:458.1.text#κουρᾷ τε θυγατρὸς πενθίμῳ κεκαρμένος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:459.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:459.1.text#ἀπωλόμην, Μενέλαε· Τυνδάρεως ὅδε
urn:cts:greekLit:tlg0006.tlg016.fu.sp:460.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:460.1.text#στείχει πρὸς ἡμᾶς, οὗ μάλιστ' αἰδώς μ' ἔχει
urn:cts:greekLit:tlg0006.tlg016.fu.sp:461.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:461.1.text#ἐς ὄμματ' ἐλθεῖν τοῖσιν ἐξειργασμένοις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:462.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:462.1.text#καὶ γάρ μ' ἔθρεψε σμικρὸν ὄντα, πολλὰ δὲ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:463.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:463.1.text#φιλήματ' ἐξέπλησε, τὸν Ἀγαμέμνονος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:464.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:464.1.text#παῖδ' ἀγκάλαισι περιφέρων, Λήδα θ' ἅμα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:465.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:465.1.text#τιμῶντέ μ' οὐδὲν ἧσσον ἢ Διοσκόρω·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:466.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:466.1.text#οἷς, ὦ τάλαινα καρδία ψυχή τ' ἐμή,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:467.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:467.1.text#ἀπέδωκ' ἀμοιβὰς οὐ καλάς. τίνα σκότον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:468.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:468.1.text#λάβω προσώπῳ; ποῖον ἐπίπροσθεν νέφος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:469.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:469.1.text#θῶμαι, γέροντος ὀμμάτων φεύγων κόρας;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:470.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:470.1.text#ποῦ ποῦ θυγατρὸς τῆς ἐμῆς ἴδω πόσιν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:471.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:471.1.text#Μενέλαον; ἐπὶ γὰρ τῷ Κλυταιμήστρας τάφῳ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:472.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:472.1.text#χοὰς χεόμενος ἔκλυον ὡς ἐς Ναυπλίαν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:473.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:473.1.text#ἥκοι σὺν ἀλόχῳ πολυετὴς σεσῳσμένος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:474.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:474.1.text#ἄγετέ με· πρὸς γὰρ δεξιὰν αὐτοῦ θέλω
urn:cts:greekLit:tlg0006.tlg016.fu.sp:475.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:475.1.text#στὰς ἀσπάσασθαι, χρόνιος εἰσιδὼν φίλον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:476.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:476.1.text#ὦ πρέσβυ, χαῖρε, Ζηνὸς ὁμόλεκτρον κάρα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:477.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:477.1.text#ὦ χαῖρε καὶ σύ, Μενέλεως, κήδευμ' ἐμόν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:478.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:478.1.text#ἔα· τὸ μέλλον ὡς κακὸν τὸ μὴ εἰδέναι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:479.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:479.1.text#ὁ μητροφόντης ὅδε πρὸ δωμάτων δράκων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:480.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:480.1.text#στίλβει νοσώδεις ἀστραπάς, στύγημ' ἐμόν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:481.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:481.1.text#Μενέλαε, προσφθέγγῃ νιν, ἀνόσιον κάρα;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:482.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:482.1.text#τί γάρ; φίλου μοι πατρός ἐστιν ἔκγονος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:483.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:483.1.text#κείνου γὰρ ὅδε πέφυκε, τοιοῦτος γεγώς;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:484.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:484.1.text#πέφυκεν· εἰ δὲ δυστυχεῖ, τιμητέος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:485.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:485.1.text#βεβαρβάρωσαι, χρόνιος ὢν ἐν βαρβάροις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:486.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:486.1.text#Ἑλληνικόν τοι τὸν ὁμόθεν τιμᾶν ἀεί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:487.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:487.1.text#καὶ τῶν νόμων γε μὴ πρότερον εἶναι θέλειν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:488.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:488.1.text#πᾶν τοὐξ ἀνάγκης δοῦλόν ἐστ' ἐν τοῖς σοφοῖς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:489.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:489.1.text#κέκτησό νυν σὺ τοῦτ', ἐγὼ δ' οὐ κτήσομαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:490.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:490.1.text#ὀργὴ γὰρ ἅμα σου καὶ τὸ γῆρας οὐ σοφόν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:491.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:491.1.text#πρὸς τόνδ' ἀγὼν τίς ἀσοφίας ἥκει πέρι;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:492.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:492.1.text#εἰ τὰ καλὰ πᾶσι φανερὰ καὶ τὰ μὴ καλά,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:493.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:493.1.text#τούτου τίς ἀνδρῶν ἐγένετ' ἀσυνετώτερος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:494.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:494.1.text#ὅστις τὸ μὲν δίκαιον οὐκ ἐσκέψατο
urn:cts:greekLit:tlg0006.tlg016.fu.sp:495.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:495.1.text#οὐδ' ἦλθεν ἐπὶ τὸν κοινὸν Ἑλλήνων νόμον;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:496.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:496.1.text#ἐπεὶ γὰρ ἐξέπνευσεν Ἀγαμέμνων βίον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:497.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:497.1.text#{ πληγεὶς θυγατρὸς τῆς ἐμῆς ὑπὲρ κάρα },
urn:cts:greekLit:tlg0006.tlg016.fu.sp:499.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:499.1.text#αἴσχιστον ἔργον — οὐ γὰρ αἰνέσω ποτέ —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:500.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:500.1.text#χρῆν αὐτὸν ἐπιθεῖναι μὲν αἵματος δίκην,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:501.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:501.1.text#ὁσίαν διώκοντ', ἐκβαλεῖν τε δωμάτων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:502.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:502.1.text#μητέρα· τὸ σῶφρόν τ' ἔλαβεν ἀντὶ συμφορᾶς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:503.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:503.1.text#καὶ τοῦ νόμου τ' ἂν εἴχετ' εὐσεβής τ' ἂν ἦν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:504.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:504.1.text#νῦν δ' ἐς τὸν αὐτὸν δαίμον' ἦλθε μητέρι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:505.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:505.1.text#κακὴν γὰρ αὐτὴν ἐνδίκως ἡγούμενος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:506.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:506.1.text#αὐτὸς κακίων μητέρ' ἐγένετο κτανών.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:507.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:507.1.text#ἐρήσομαι δέ, Μενέλεως, τοσόνδε σε·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:508.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:508.1.text#εἰ τόνδ' ἀποκτείνειεν ὁμόλεκτρος γυνή,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:509.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:509.1.text#χὡ τοῦδε παῖς αὖ μητέρ' ἀνταποκτενεῖ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:510.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:510.1.text#κἄπειθ' ὁ κείνου γενόμενος φόνῳ φόνον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:511.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:511.1.text#λύσει, πέρας δὴ ποῖ κακῶν προβήσεται;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:512.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:512.1.text#καλῶς ἔθεντο ταῦτα πατέρες οἱ πάλαι·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:513.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:513.1.text#ἐς ὀμμάτων μὲν ὄψιν οὐκ εἴων περᾶν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:514.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:514.1.text#οὐδ' εἰς ἀπάντημ', ὅστις αἷμ' ἔχων κυροῖ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:515.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:515.1.text#φυγαῖσι δ' ὁσιοῦν, ἀνταποκτείνειν δὲ μή.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:516.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:516.1.text#αἰεὶ γὰρ εἷς ἔμελλ' ἐνέξεσθαι φόνῳ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:517.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:517.1.text#τὸ λοίσθιον μίασμα λαμβάνων χεροῖν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:518.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:518.1.text#ἐγὼ δὲ μισῶ μὲν γυναῖκας ἀνοσίους,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:519.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:519.1.text#πρώτην δὲ θυγατέρ', ἣ πόσιν κατέκτανεν·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:520.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:520.1.text#Ἑλένην τε, τὴν σὴν ἄλοχον, οὔποτ' αἰνέσω
urn:cts:greekLit:tlg0006.tlg016.fu.sp:521.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:521.1.text#οὐδ' ἂν προσείποιμ'· οὐδὲ σὲ ζηλῶ, κακῆς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:522.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:522.1.text#γυναικὸς ἐλθόνθ' οὕνεκ' ἐς Τροίας πέδον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:523.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:523.1.text#ἀμυνῶ δ', ὅσονπερ δυνατός εἰμι, τῷ νόμῳ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:524.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:524.1.text#τὸ θηριῶδες τοῦτο καὶ μιαιφόνον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:525.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:525.1.text#παύων, ὃ καὶ γῆν καὶ πόλεις ὄλλυσ' ἀεί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:526.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:526.1.text#ἐπεὶ τίν' εἶχες, ὦ τάλας, ψυχὴν τότε,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:527.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:527.1.text#ὅτ' ἐξέβαλλε μαστὸν ἱκετεύουσά σε
urn:cts:greekLit:tlg0006.tlg016.fu.sp:528.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:528.1.text#μήτηρ; ἐγὼ μὲν οὐκ ἰδὼν τἀκεῖ κακά,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:529.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:529.1.text#δακρύοις γέροντ' ὀφθαλμὸν ἐκτήκω τάλας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:530.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:530.1.text#ἓν { δ' } οὖν λόγοισι τοῖς ἐμοῖς ὁμορροθεῖ·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:531.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:531.1.text#μισῇ γε πρὸς θεῶν καὶ τίνεις μητρὸς δίκας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:532.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:532.1.text#μανίαις ἀλαίνων καὶ φόβοις. τί μαρτύρων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:533.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:533.1.text#ἄλλων ἀκούειν δεῖ μ', ἅ γ' εἰσορᾶν πάρα;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:534.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:534.1.text#ὡς οὖν ἂν εἰδῇς, Μενέλεως, τοῖσιν θεοῖς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:535.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:535.1.text#μὴ πρᾶσσ' ἐναντί', ὠφελεῖν τοῦτον θέλων,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:536.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:536.1.text#ἔα δ' ὑπ' ἀστῶν καταφονευθῆναι πέτροις,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:537.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:537.1.text#ἢ μὴ 'πίβαινε Σπαρτιάτιδος χθονός.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:538.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:538.1.text#θυγάτηρ δ' ἐμὴ θανοῦσ' ἔπραξεν ἔνδικα·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:539.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:539.1.text#ἀλλ' οὐχὶ πρὸς τοῦτ' εἰκὸς ἦν αὐτὴν θανεῖν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:540.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:540.1.text#ἐγὼ δὲ τἄλλα μακάριος πέφυκ' ἀνήρ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:541.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:541.1.text#πλὴν ἐς θυγατέρας· τοῦτο δ' οὐκ εὐδαιμονῶ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:542.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:542.1.text#ζηλωτὸς ὅστις εὐτύχησεν ἐς τέκνα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:543.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:543.1.text#καὶ μὴ 'πισήμους συμφορὰς ἐκτήσατο.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:544.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:544.1.text#ὦ γέρον, ἐγώ τοι πρὸς σὲ δειμαίνω λέγειν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:545.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:545.1.text#ὅπου σὲ μέλλω σήν τε λυπήσειν φρένα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:546.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:546.1.text#ἐγᾦδ', ἀνόσιός εἰμι μητέρα κτανών,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:547.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:547.1.text#ὅσιος δέ γ' ἕτερον ὄνομα, τιμωρῶν πατρί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:548.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:548.1.text#ἀπελθέτω δὴ τοῖς λόγοισιν ἐκποδὼν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:549.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:549.1.text#τὸ γῆρας ἡμῖν τὸ σόν, ὅ μ' ἐκπλήσσει λόγου,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:550.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:550.1.text#καὶ καθ' ὁδὸν εἶμι· νῦν δὲ σὴν ταρβῶ τρίχα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:551.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:551.1.text#τί χρῆν με δρᾶσαι; δύο γὰρ ἀντίθες δυοῖν·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:552.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:552.1.text#πατὴρ μὲν ἐφύτευσέν με, σὴ δ' ἔτικτε παῖς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:553.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:553.1.text#τὸ σπέρμ' ἄρουρα παραλαβοῦσ' ἄλλου πάρα·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:554.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:554.1.text#ἄνευ δὲ πατρὸς τέκνον οὐκ εἴη ποτ' ἄν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:555.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:555.1.text#ἐλογισάμην οὖν τῷ γένους ἀρχηγέτῃ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:556.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:556.1.text#μᾶλλόν με φῦναι τῆς ὑποστάσης τροφάς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:557.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:557.1.text#ἡ σὴ δὲ θυγάτηρ — μητέρ' αἰδοῦμαι λέγειν —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:558.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:558.1.text#ἰδίοισιν ὑμεναίοισι κοὐχὶ σώφροσιν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:559.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:559.1.text#ἐς ἀνδρὸς ᾔει λέκτρ'· ἐμαυτόν, ἢν λέγω
urn:cts:greekLit:tlg0006.tlg016.fu.sp:560.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:560.1.text#κακῶς ἐκείνην, ἐξερῶ· λέξω δ' ὅμως.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:561.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:561.1.text#Αἴγισθος ἦν ὁ κρυπτὸς ἐν δόμοις πόσις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:562.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:562.1.text#τοῦτον κατέκτειν', ἐπὶ δ' ἔθυσα μητέρα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:563.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:563.1.text#ἀνόσια μὲν δρῶν, ἀλλὰ τιμωρῶν πατρί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:564.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:564.1.text#ἐφ' οἷς δ' ἀπειλεῖς ὡς πετρωθῆναί με χρή,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:565.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:565.1.text#ἄκουσον ὡς ἅπασαν Ἑλλάδ' ὠφελῶ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:566.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:566.1.text#εἰ γὰρ γυναῖκες ἐς τόδ' ἥξουσιν θράσους,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:567.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:567.1.text#ἄνδρας φονεύειν, καταφυγὰς ποιούμεναι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:568.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:568.1.text#ἐς τέκνα, μαστοῖς τὸν ἔλεον θηρώμεναι,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:569.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:569.1.text#παρ' οὐδὲν αὐταῖς ἦν ἂν ὀλλύναι πόσεις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:570.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:570.1.text#ἐπίκλημ' ἐχούσαις ὅ τι τύχοι. δράσας δ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:571.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:571.1.text#δείν', ὡς σὺ κομπεῖς, τόνδ' ἔπαυσα τὸν νόμον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:572.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:572.1.text#μισῶν δὲ μητέρ' ἐνδίκως ἀπώλεσα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:573.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:573.1.text#ἥτις μεθ' ὅπλων ἄνδρ' ἀπόντ' ἐκ δωμάτων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:574.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:574.1.text#πάσης ὑπὲρ γῆς Ἑλλάδος στρατηλάτην
urn:cts:greekLit:tlg0006.tlg016.fu.sp:575.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:575.1.text#προύδωκε κοὐκ ἔσῳσ' ἀκήρατον λέχος·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:576.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:576.1.text#ἐπεὶ δ' ἁμαρτοῦσ' ᾔσθετ', οὐχ αὑτῇ δίκην
urn:cts:greekLit:tlg0006.tlg016.fu.sp:577.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:577.1.text#ἐπέθηκεν, ἀλλ', ὡς μὴ δίκην δοίη πόσει,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:578.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:578.1.text#ἐζημίωσε πατέρα κἀπέκτειν' ἐμόν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:579.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:579.1.text#πρὸς θεῶν — ἐν οὐ καλῷ μὲν ἐμνήσθην θεῶν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:580.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:580.1.text#φόνον δικάζων· εἰ δὲ δὴ τὰ μητέρος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:581.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:581.1.text#σιγῶν ἐπῄνουν, τί μ' ἂν ἔδρασ' ὁ κατθανών;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:582.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:582.1.text#οὐκ ἄν με μισῶν ἀνεχόρευ' Ἐρινύσιν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:583.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:583.1.text#ἢ μητρὶ μὲν πάρεισι σύμμαχοι θεαί,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:584.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:584.1.text#τῷ δ' οὐ πάρεισι, μᾶλλον ἠδικημένῳ;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:585.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:585.1.text#σύ τοι φυτεύσας θυγατέρ', ὦ γέρον, κακὴν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:586.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:586.1.text#ἀπώλεσάς με· διὰ τὸ γὰρ κείνης θράσος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:587.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:587.1.text#πατρὸς στερηθεὶς ἐγενόμην μητροκτόνος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:588.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:588.1.text#ὁρᾷς, Ὀδυσσέως ἄλοχον οὐ κατέκτανε
urn:cts:greekLit:tlg0006.tlg016.fu.sp:589.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:589.1.text#Τηλέμαχος· οὐ γὰρ ἐπεγάμει πόσει πόσιν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:590.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:590.1.text#μένει δ' ἐν οἴκοις ὑγιὲς εὐνατήριον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:591.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:591.1.text#ὁρᾷς δ' Ἀπόλλων', ὃς μεσομφάλους ἕδρας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:592.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:592.1.text#ναίων βροτοῖσι στόμα νέμει σαφέστατον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:593.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:593.1.text#ᾧ πειθόμεσθα πάνθ' ὅσ' ἂν κεῖνος λέγῃ·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:594.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:594.1.text#τούτῳ πιθόμενος τὴν τεκοῦσαν ἔκτανον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:595.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:595.1.text#ἐκεῖνον ἡγεῖσθ' ἀνόσιον καὶ κτείνετε·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:596.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:596.1.text#ἐκεῖνος ἥμαρτ', οὐκ ἐγώ. τί χρῆν με δρᾶν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:597.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:597.1.text#ἢ οὐκ ἀξιόχρεως ὁ θεὸς ἀναφέροντί μοι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:598.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:598.1.text#μίασμα λῦσαι; ποῖ τις οὖν ἔτ' ἂν φύγοι,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:599.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:599.1.text#εἰ μὴ ὁ κελεύσας ῥύσεταί με μὴ θανεῖν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:600.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:600.1.text#ἀλλ' ὡς μὲν οὐκ εὖ μὴ λέγ' εἴργασται τάδε,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:601.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:601.1.text#ἡμῖν δὲ τοῖς δράσασιν οὐκ εὐδαιμόνως.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:602.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:602.1.text#γάμοι δ' ὅσοις μὲν εὖ καθεστᾶσιν βροτῶν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:603.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:603.1.text#μακάριος αἰών· οἷς δὲ μὴ πίπτουσιν εὖ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:604.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:604.1.text#τά τ' ἔνδον εἰσὶ τά τε θύραζε δυστυχεῖς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:605.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:605.1.text#αἰεὶ γυναῖκες ἐμποδὼν ταῖς συμφοραῖς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:606.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:606.1.text#ἔφυσαν ἀνδρῶν πρὸς τὸ δυστυχέστερον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:607.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:607.1.text#ἐπεὶ θρασύνῃ κοὐχ ὑποστέλλῃ λόγῳ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:608.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:608.1.text#οὕτω δ' ἀμείβῃ μ' ὥστε μ' ἀλγῆσαι φρένα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:609.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:609.1.text#μᾶλλόν μ' ἀνάξεις ἐπὶ σὸν ἐξελθεῖν φόνον·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:610.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:610.1.text#καλὸν πάρεργον δ' αὐτὸ θήσομαι πόνων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:611.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:611.1.text#ὧν εἵνεκ' ἦλθον θυγατρὶ κοσμήσων τάφον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:612.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:612.1.text#μολὼν γὰρ εἰς ἔκκλητον Ἀργείων ὄχλον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:613.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:613.1.text#ἑκοῦσαν οὐχ ἑκοῦσαν ἐπισείσω πόλιν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:614.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:614.1.text#σοὶ σῇ τ' ἀδελφῇ, λεύσιμον δοῦναι δίκην.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:615.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:615.1.text#μᾶλλον δ' ἐκείνη σοῦ θανεῖν ἐστ' ἀξία,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:616.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:616.1.text#ἣ τῇ τεκούσῃ σ' ἠγρίωσ', ἐς οὖς ἀεὶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:617.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:617.1.text#πέμπουσα μύθους ἐπὶ τὸ δυσμενέστερον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:618.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:618.1.text#ὀνείρατ' ἀγγέλλουσα τὰ Ἀγαμέμνονος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:619.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:619.1.text#καὶ τοῦθ' — ὃ μισήσειαν — Αἰγίσθου λέχος —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:620.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:620.1.text#οἱ νέρτεροι θεοί· καὶ γὰρ ἐνθάδ' ἦν πικρόν·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:621.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:621.1.text#ἕως ὑφῆψε δῶμ' ἀνηφαίστῳ πυρί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:622.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:622.1.text#Μενέλαε, σοὶ δὲ τάδε λέγω δράσω τε πρός·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:623.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:623.1.text#εἰ τοὐμὸν ἔχθος ἐναριθμῇ κῆδός τ' ἐμόν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:624.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:624.1.text#μὴ τῷδ' ἀμύνειν φόνον ἐναντίον θεοῖς·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:625.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:625.1.text#ἔα δ' ὑπ' ἀστῶν καταφονευθῆναι πέτροις,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:626.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:626.1.text#ἢ μὴ 'πίβαινε Σπαρτιάτιδος χθονός.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:627.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:627.1.text#τοσαῦτ' ἀκούσας ἴσθι, μηδὲ δυσσεβεῖς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:628.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:628.1.text#ἕλῃ, παρώσας εὐσεβεστέρους φίλους·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:629.1.speaker#Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:629.1.text#ἡμᾶς δ' ἀπ' οἴκων ἄγετε τῶνδε, πρόσπολοι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:630.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:630.1.text#στεῖχ', ὡς ἀθορύβως οὑπιὼν ἡμῖν λόγος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:631.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:631.1.text#πρὸς τόνδ' ἵκηται, γῆρας ἀποφυγὼν τὸ σόν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:632.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:632.1.text#Μενέλαε, ποῖ σὸν πόδ' ἐπὶ συννοίᾳ κυκλεῖς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:633.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:633.1.text#διπλῆς μερίμνης διπτύχους ἰὼν ὁδούς;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:634.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:634.1.text#ἔασον· ἐν ἐμαυτῷ τι συννοούμενος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:635.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:635.1.text#ὅποι τράπωμαι τῆς τύχης ἀμηχανῶ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:636.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:636.1.text#μή νυν πέραινε τὴν δόκησιν, ἀλλ' ἐμοὺς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:637.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:637.1.text#λόγους ἀκούσας πρόσθε, βουλεύου τότε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:638.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:638.1.text#λέγ'· εὖ γὰρ εἶπας· ἔστι δ' οὗ σιγὴ λόγου
urn:cts:greekLit:tlg0006.tlg016.fu.sp:639.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:639.1.text#κρείσσων γένοιτ' ἄν. ἔστι δ' οὗ σιγῆς λόγος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:640.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:640.1.text#λέγοιμ' ἂν ἤδη. τὰ μακρὰ τῶν σμικρῶν λόγων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:641.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:641.1.text#ἐπίπροσθέν ἐστι καὶ σαφῆ μᾶλλον κλύειν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:642.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:642.1.text#ἐμοὶ σὺ τῶν σῶν, Μενέλεως, μηδὲν δίδου,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:643.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:643.1.text#ἃ δ' ἔλαβες ἀπόδος πατρὸς ἐμοῦ λαβὼν πάρα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:644.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:644.1.text#— οὐ χρήματ' εἶπον· χρήματ', ἢν ψυχὴν ἐμὴν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:645.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:645.1.text#σῴσῃς, ἅπερ μοι φίλτατ' ἐστὶ τῶν ἐμῶν. —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:646.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:646.1.text#ἀδικῶ· λαβεῖν χρή μ' ἀντὶ τοῦδε τοῦ κακοῦ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:647.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:647.1.text#ἄδικόν τι παρὰ σοῦ· καὶ γὰρ Ἀγαμέμνων πατὴρ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:648.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:648.1.text#ἀδίκως ἀθροίσας Ἑλλάδ' ἦλθ' ὑπ' Ἴλιον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:649.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:649.1.text#οὐκ ἐξαμαρτὼν αὐτός, ἀλλ' ἁμαρτίαν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:650.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:650.1.text#τῆς σῆς γυναικὸς ἀδικίαν τ' ἰώμενος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:651.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:651.1.text#ἓν μὲν τόδ' ἡμῖν ἀνθ' ἑνὸς δοῦναί σε χρή.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:652.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:652.1.text#ἀπέδοτο δ', ὡς χρὴ τοῖς φίλοισι τοὺς φίλους,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:653.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:653.1.text#τὸ σῶμ' ἀληθῶς, σοὶ παρ' ἀσπίδ' ἐκπονῶν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:654.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:654.1.text#ὅπως σὺ τὴν σὴν ἀπολάβοις ξυνάορον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:655.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:655.1.text#ἀπότεισον οὖν μοι ταὐτὸ τοῦτ' ἐκεῖ λαβών,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:656.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:656.1.text#μίαν πονήσας ἡμέραν, ἡμῶν ὕπερ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:657.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:657.1.text#σωτήριος στάς, μὴ δέκ' ἐκπλήσας ἔτη.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:658.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:658.1.text#ἃ δ' Αὐλὶς ἔλαβε σφάγι' ἐμῆς ὁμοσπόρου,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:659.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:659.1.text#ἐῶ σ' ἔχειν ταῦθ'· Ἑρμιόνην μὴ κτεῖνε σύ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:660.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:660.1.text#δεῖ γὰρ σ' ἐμοῦ πράσσοντος ὡς πράσσω τὰ νῦν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:661.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:661.1.text#πλέον φέρεσθαι, κἀμὲ συγγνώμην ἔχειν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:662.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:662.1.text#ψυχὴν δ' ἐμὴν δὸς τῷ ταλαιπώρῳ πατρὶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:663.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:663.1.text#κἀμῆς ἀδελφῆς, παρθένου μακρὸν χρόνον·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:664.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:664.1.text#θανὼν γὰρ οἶκον ὀρφανὸν λείψω πατρός.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:665.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:665.1.text#ἐρεῖς· ἀδύνατον. αὐτὸ τοῦτο· τοὺς φίλους
urn:cts:greekLit:tlg0006.tlg016.fu.sp:666.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:666.1.text#ἐν τοῖς κακοῖς χρὴ τοῖς φίλοισιν ὠφελεῖν·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:667.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:667.1.text#ὅταν δ' ὁ δαίμων εὖ διδῷ, τί δεῖ φίλων;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:668.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:668.1.text#ἀρκεῖ γὰρ αὐτὸς ὁ θεὸς ὠφελεῖν θέλων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:669.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:669.1.text#φιλεῖν δάμαρτα πᾶσιν Ἕλλησιν δοκεῖς·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:670.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:670.1.text#κοὐχ ὑποτρέχων σε τοῦτο θωπείᾳ λέγω·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:671.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:671.1.text#ταύτης ἱκνοῦμαί σ' — ὦ μέλεος ἐμῶν κακῶν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:672.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:672.1.text#ἐς οἷον ἥκω. τί δέ; ταλαιπωρεῖν με δεῖ·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:673.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:673.1.text#ὑπὲρ γὰρ οἴκου παντὸς ἱκετεύω τάδε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:674.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:674.1.text#ὦ πατρὸς ὅμαιμε θεῖε, τὸν κατὰ χθονὸς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:675.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:675.1.text#θανόντ' ἀκούειν τάδε δόκει, ποτωμένην
urn:cts:greekLit:tlg0006.tlg016.fu.sp:676.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:676.1.text#ψυχὴν ὑπὲρ σοῦ, καὶ λέγειν ἃ ἐγὼ λέγω,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:677.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:677.1.text#ταὔτ' ἔς τε δάκρυα καὶ γόους καὶ συμφοράς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:678.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:678.1.text#εἴρηκα κἀπῄτηκα τὴν σωτηρίαν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:679.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:679.1.text#θηρῶν ὃ πάντες κοὐκ ἐγὼ ζητῶ μόνος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:680.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:680.1.text#κἀγώ σ' ἱκνοῦμαι καὶ γυνή περ οὖσ' ὅμως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:681.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:681.1.text#τοῖς δεομένοισιν ὠφελεῖν· οἷός τε δ' εἶ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:682.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:682.1.text#Ὀρέστ', ἐγώ τοι σὸν καταιδοῦμαι κάρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:683.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:683.1.text#καὶ ξυμπονῆσαι σοῖς κακοῖσι βούλομαι·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:684.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:684.1.text#καὶ χρὴ γὰρ οὕτω τῶν ὁμαιμόνων κακὰ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:685.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:685.1.text#ξυνεκκομίζειν, δύναμιν ἢν διδῷ θεός,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:686.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:686.1.text#θνῄσκοντα καὶ κτείνοντα τοὺς ἐναντίους·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:687.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:687.1.text#τὸ δ' αὖ δύνασθαι πρὸς θεῶν χρῄζω τυχεῖν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:688.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:688.1.text#ἥκω γὰρ ἀνδρῶν συμμάχων κενὸν δόρυ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:689.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:689.1.text#ἔχων, πόνοισι μυρίοις ἀλώμενος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:690.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:690.1.text#σμικρᾷ σὺν ἀλκῇ τῶν λελειμμένων φίλων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:691.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:691.1.text#μάχῃ μὲν οὖν ἂν οὐχ ὑπερβαλοίμεθα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:692.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:692.1.text#Πελασγὸν Ἄργος· εἰ δὲ μαλθακοῖς λόγοις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:693.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:693.1.text#δυναίμεθ', ἐνταῦθ' ἐλπίδος προσήκομεν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:694.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:694.1.text#σμικροῖσι μὲν γὰρ μεγάλα πῶς ἕλοι τις ἄν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:695.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:695.1.text#[ πόνοισιν; ἀμαθὲς καὶ τὸ βούλεσθαι τάδε. ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:696.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:696.1.text#ὅταν γὰρ ἡβᾷ δῆμος εἰς ὀργὴν πεσών,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:697.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:697.1.text#ὅμοιον ὥστε πῦρ κατασβέσαι λάβρον·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:698.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:698.1.text#εἰ δ' ἡσύχως τις αὑτὸν ἐντείνοντι μὲν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:699.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:699.1.text#χαλῶν ὑπείκοι καιρὸν εὐλαβούμενος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:700.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:700.1.text#ἴσως ἂν ἐκπνεύσειεν· ἢν δ' ἀνῇ πνοάς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:701.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:701.1.text#τύχοις ἂν αὐτοῦ ῥᾳδίως ὅσον θέλεις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:702.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:702.1.text#ἔνεστι δ' οἶκτος, ἔνι δὲ καὶ θυμὸς μέγας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:703.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:703.1.text#καραδοκοῦντι κτῆμα τιμιώτατον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:704.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:704.1.text#ἐλθὼν δὲ Τυνδάρεών τέ σοι πειράσομαι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:705.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:705.1.text#πόλιν τε πεῖσαι τῷ λίαν χρῆσθαι καλῶς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:706.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:706.1.text#καὶ ναῦς γὰρ ἐνταθεῖσα πρὸς βίαν ποδὶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:707.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:707.1.text#ἔβαψεν, ἔστη δ' αὖθις, ἢν χαλᾷ πόδα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:708.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:708.1.text#μισεῖ γὰρ ὁ θεὸς τὰς ἄγαν προθυμίας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:709.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:709.1.text#μισοῦσι δ' ἀστοί· δεῖ δέ μ' — οὐκ ἄλλως λέγω —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:710.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:710.1.text#σῴζειν σε σοφίᾳ, μὴ βίᾳ τῶν κρεισσόνων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:711.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:711.1.text#ἀλκῇ δέ σ' οὐκ ἄν, ᾗ σὺ δοξάζεις ἴσως,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:712.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:712.1.text#σῴσαιμ' ἄν· οὐ γὰρ ῥᾴδιον λόγχῃ μιᾷ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:713.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:713.1.text#στῆσαι τροπαῖα τῶν κακῶν ἅ σοι πάρα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:714.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:714.1.text#οὐ γάρ ποτ' Ἄργους γαῖαν ἐς τὸ μαλθακὸν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:715.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:715.1.text#προσηγόμεσθα· νῦν δ' ἀναγκαίως ἔχει.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:716.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:716.1.text#[ δούλοισιν εἶναι τοῖς σοφοῖσι τῆς τύχης ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:717.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:717.1.text#ὦ πλὴν γυναικὸς οὕνεκα στρατηλατεῖν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:718.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:718.1.text#τἄλλ' οὐδέν, ὦ κάκιστε τιμωρεῖν φίλοις,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:720.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:720.1.text#φεύγεις ἀποστραφείς με, τὰ δ' Ἀγαμέμνονος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:721.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:721.1.text#φροῦδ'; ἄφιλος ἦσθ' ἄρ', ὦ πάτερ, πράσσων κακῶς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:722.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:722.1.text#οἴμοι, προδέδομαι, κοὐκέτ' εἰσὶν ἐλπίδες,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:723.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:723.1.text#ὅποι τραπόμενος θάνατον Ἀργείων φύγω·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:724.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:724.1.text#οὗτος γὰρ ἦν μοι καταφυγὴ σωτηρίας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:725.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:725.1.text#ἀλλ' εἰσορῶ γὰρ τόνδε φίλτατον βροτῶν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:726.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:726.1.text#Πυλάδην δρόμῳ στείχοντα Φωκέων ἄπο,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:727.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:727.1.text#ἡδεῖαν ὄψιν· πιστὸς ἐν κακοῖς ἀνὴρ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:728.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:728.1.text#κρείσσων γαλήνης ναυτίλοισιν εἰσορᾶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:729.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:729.1.text#θᾶσσον ᾗ με χρῆν προβαίνων ἱκόμην δι' ἄστεως,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:730.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:730.1.text#σύλλογον πόλεως ἀκούσας, τὸν δ' ἰδὼν αὐτὸς σαφῶς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:731.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:731.1.text#ἐπὶ σὲ σύγγονόν τε τὴν σήν, ὡς κτενοῦντας αὐτίκα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:732.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:732.1.text#τί τάδε; πῶς ἔχεις; τί πράσσεις, φίλταθ' ἡλίκων ἐμοὶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:733.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:733.1.text#καὶ φίλων καὶ συγγενείας; πάντα γὰρ τάδ' εἶ σύ μοι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:734.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:734.1.text#οἰχόμεσθ', ὡς ἐν βραχεῖ σοι τἀμὰ δηλώσω κακά.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:735.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:735.1.text#συγκατασκάπτοις ἂν ἡμᾶς· κοινὰ γὰρ τὰ τῶν φίλων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:736.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:736.1.text#Μενέλεως κάκιστος ἐς ἐμὲ καὶ κασιγνήτην ἐμήν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:737.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:737.1.text#εἰκότως, κακῆς γυναικὸς ἄνδρα γίγνεσθαι κακόν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:738.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:738.1.text#ὥσπερ οὐκ ἐλθὼν ἔμοιγε ταὐτὸν ἀπέδωκεν μολών.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:739.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:739.1.text#ἦ γάρ ἐστιν ὡς ἀληθῶς τήνδ' ἀφιγμένος χθόνα;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:740.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:740.1.text#χρόνιος· ἀλλ' ὅμως τάχιστα κακὸς ἐφωράθη φίλοις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:741.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:741.1.text#καὶ δάμαρτα τὴν κακίστην ναυστολῶν ἐλήλυθεν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:742.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:742.1.text#οὐκ ἐκεῖνος, ἀλλ' ἐκείνη κεῖνον ἐνθάδ' ἤγαγεν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:743.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:743.1.text#ποῦ 'στιν ἣ πλείστους Ἀχαιῶν ὤλεσεν γυνὴ μία;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:744.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:744.1.text#ἐν δόμοις ἐμοῖσιν, εἰ δὴ τούσδ' ἐμοὺς καλεῖν χρεών.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:745.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:745.1.text#σὺ δὲ τίνας λόγους ἔλεξας σοῦ κασιγνήτῳ πατρός;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:746.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:746.1.text#μή μ' ἰδεῖν θανόνθ' ὑπ' ἀστῶν καὶ κασιγνήτην ἐμήν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:747.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:747.1.text#πρὸς θεῶν, τί πρὸς τάδ' εἶπε; τόδε γὰρ εἰδέναι θέλω.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:748.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:748.1.text#εὐλαβεῖθ', ὃ τοῖς φίλοισι δρῶσιν οἱ κακοὶ φίλοι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:749.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:749.1.text#σκῆψιν ἐς ποίαν προβαίνων; τοῦτο πάντ' ἔχω μαθών.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:750.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:750.1.text#οὗτος ἦλθ', ὁ τὰς ἀρίστας θυγατέρας σπείρας πατήρ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:751.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:751.1.text#Τυνδάρεων λέγεις· ἴσως σοι θυγατέρος θυμούμενος;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:752.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:752.1.text#αἰσθάνῃ. τὸ τοῦδε κῆδος μᾶλλον εἵλετ' ἢ πατρός.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:753.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:753.1.text#κοὐκ ἐτόλμησεν πόνων σῶν ἀντιλάζυσθαι παρών;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:754.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:754.1.text#οὐ γὰρ αἰχμητὴς πέφυκεν, ἐν γυναιξὶ δ' ἄλκιμος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:755.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:755.1.text#ἐν κακοῖς ἄρ' εἶ μεγίστοις· καί σ' ἀναγκαῖον θανεῖν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:756.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:756.1.text#ψῆφον ἀμφ' ἡμῶν πολίτας ἐπὶ φόνῳ θέσθαι χρεών.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:757.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:757.1.text#ἣ κρινεῖ τί χρῆμα; λέξον· διὰ φόβου γὰρ ἔρχομαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:758.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:758.1.text#ἢ θανεῖν ἢ ζῆν· ὁ μῦθος οὐ μακρὸς μακρῶν πέρι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:759.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:759.1.text#φεῦγέ νυν λιπὼν μέλαθρα σὺν κασιγνήτῃ σέθεν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:760.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:760.1.text#οὐχ ὁρᾷς; φυλασσόμεσθα φρουρίοισι πανταχῇ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:761.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:761.1.text#εἶδον ἄστεως ἀγυιὰς τεύχεσιν πεφραγμένας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:762.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:762.1.text#ὡσπερεὶ πόλις πρὸς ἐχθρῶν σῶμα πυργηρούμεθα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:763.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:763.1.text#κἀμὲ νῦν ἐροῦ τί πάσχω· καὶ γὰρ αὐτὸς οἴχομαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:764.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:764.1.text#πρὸς τίνος; τοῦτ' ἂν προσείη τοῖς ἐμοῖς κακοῖς κακόν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:765.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:765.1.text#Στρόφιος ἤλασέν μ' ἀπ' οἴκων φυγάδα θυμωθεὶς πατήρ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:766.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:766.1.text#ἴδιον ἢ κοινὸν πολίταις ἐπιφέρων ἔγκλημά τι;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:767.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:767.1.text#ὅτι συνηράμην φόνον σοι μητρός, ἀνόσιον λέγων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:768.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:768.1.text#ὦ τάλας, ἔοικε καὶ σὲ τἀμὰ λυπήσειν κακά.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:769.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:769.1.text#οὐχὶ Μενέλεω τρόποισι χρώμεθ'· οἰστέον τάδε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:770.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:770.1.text#οὐ φοβῇ μή σ' Ἄργος ὥσπερ κἄμ' ἀποκτεῖναι θέλῃ;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:771.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:771.1.text#οὐ προσήκομεν κολάζειν τοῖσδε, Φωκέων δὲ γῇ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:772.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:772.1.text#δεινὸν οἱ πολλοί, κακούργους ὅταν ἔχωσι προστάτας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:773.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:773.1.text#ἀλλ' ὅταν χρηστοὺς λάβωσι, χρηστὰ βουλεύουσ' ἀεί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:774.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:774.1.text#εἶἑν. ἐς κοινὸν λέγειν χρή.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:774.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:774.2.text#τίνος ἀναγκαίου πέρι;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:775.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:775.1.text#εἰ λέγοιμ' ἀστοῖσιν ἐλθὼν —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:775.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:775.2.text#ὡς ἔδρασας ἔνδικα;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:776.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:776.1.text#πατρὶ τιμωρῶν ἐμαυτοῦ;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:776.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:776.2.text#μὴ λάβωσί σ' ἄσμενοι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:777.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:777.1.text#ἀλλ' ὑποπτήξας σιωπῇ κατθάνω;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:777.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:777.2.text#δειλὸν τόδε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:778.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:778.1.text#πῶς ἂν οὖν δρῴην;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:778.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:778.2.text#ἔχεις τιν', ἢν μένῃς, σωτηρίαν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:779.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:779.1.text#οὐκ ἔχω.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:779.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:779.2.text#μολόντι δ' ἐλπίς ἐστι σωθῆναι κακῶν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:780.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:780.1.text#εἰ τύχοι, γένοιτ' ἄν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:780.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:780.2.text#οὐκοῦν τοῦτο κρεῖσσον ἢ μένειν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:781.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:781.1.text#ἀλλὰ δῆτ' ἔλθω.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:781.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:781.2.text#θανὼν γοῦν ὧδε κάλλιον θανῇ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:783.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:783.1.text#εὖ λέγεις· φεύγω τὸ δειλὸν τῇδε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:783.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:783.2.text#μᾶλλον ἢ μένων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:782.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:782.1.text#καὶ τὸ πρᾶγμά γ' ἔνδικόν μοι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:782.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:782.2.text#τῷ Δοκεῖν εὔχου μόνον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:784.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:784.1.text#καί τις ἄν γέ μ' οἰκτίσειε [ … ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:784.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:784.2.text#μέγα γὰρ ἡ εὐγένειά σου.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:785.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:785.1.text#θάνατον ἀσχάλλων πατρῷον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:785.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:785.2.text#πάντα ταῦτ' ἐν ὄμμασιν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:786.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:786.1.text#ἰτέον, ὡς ἄνανδρον ἀκλεῶς κατθανεῖν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:786.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:786.2.text#αἰνῶ τάδε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:787.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:787.1.text#ἦ λέγωμεν οὖν ἀδελφῇ ταῦτ' ἐμῇ;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:787.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:787.2.text#μὴ πρὸς θεῶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:788.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:788.1.text#δάκρυα γοῦν γένοιτ' ἄν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:788.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:788.2.text#οὐκοῦν οὗτος οἰωνὸς μέγας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:789.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:789.1.text#δηλαδὴ σιγᾶν ἄμεινον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:789.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:789.2.text#τῷ χρόνῳ δὲ κερδανεῖς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:790.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:790.1.text#κεῖνό μοι μόνον πρόσαντες.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:790.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:790.2.text#τί τόδε καινὸν αὖ λέγεις;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:791.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:791.1.text#μὴ θεαί μ' οἴστρῳ κατάσχωσι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:791.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:791.2.text#ἀλλὰ κηδεύσω σ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:792.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:792.1.text#δυσχερὲς ψαύειν νοσοῦντος ἀνδρός.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:792.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:792.2.text#οὐκ ἔμοιγε σοῦ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:793.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:793.1.text#εὐλαβοῦ λύσσης μετασχεῖν τῆς ἐμῆς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:793.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:793.2.text#τόδ' οὖν ἴτω.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:794.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:794.1.text#οὐκ ἄρ' ὀκνήσεις;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:794.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:794.2.text#ὄκνος γὰρ τοῖς φίλοις κακὸν μέγα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:795.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:795.1.text#ἕρπε νυν οἴαξ ποδός μοι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:795.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:795.2.text#φίλα γ' ἔχων κηδεύματα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:796.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:796.1.text#καί με πρὸς τύμβον πόρευσον πατρός.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:796.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:796.2.text#ὡς τί δὴ τόδε;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:797.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:797.1.text#ὥς νιν ἱκετεύσω με σῶσαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:797.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:797.2.text#τό γε δίκαιον ὧδ' ἔχει.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:798.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:798.1.text#μητέρος δὲ μηδ' ἴδοιμι μνῆμα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:798.2.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:798.2.text#πολεμία γὰρ ἦν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:799.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:799.1.text#ἀλλ' ἔπειγ', ὡς μή σε πρόσθε ψῆφος Ἀργείων ἕλῃ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:800.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:800.1.text#περιβαλὼν πλευροῖς ἐμοῖσι πλευρὰ νωχελῆ νόσῳ·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:801.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:801.1.text#ὡς ἐγὼ δι' ἄστεώς σε, σμικρὰ φροντίζων ὄχλου,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:802.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:802.1.text#οὐδὲν αἰσχυνθεὶς ὀχήσω. ποῦ γὰρ ὢν δείξω φίλος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:803.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:803.1.text#εἴ σε μὴ 'ν δειναῖσιν ὄντα συμφοραῖς ἐπαρκέσω;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:804.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:804.1.text#τοῦτ' ἐκεῖνο, "κτᾶσθ' ἑταίρους, μὴ τὸ συγγενὲς μόνον"·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:805.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:805.1.text#ὡς ἀνὴρ ὅστις τρόποισι συντακῇ, θυραῖος ὢν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:806.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:806.1.text#μυρίων κρείσσων ὁμαίμων ἀνδρὶ κεκτῆσθαι φίλος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:807.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:807.1.text#ὁ μέγας ὄλβος ἅ τ' ἀρετὰ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:808.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:808.1.text#μέγα φρονοῦσ' ἀν' Ἑλλάδα καὶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:809.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:809.1.text#παρὰ Σιμουντίοις ὀχετοῖς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:810.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:810.1.text#πάλιν ἀνῆλθ' ἐξ εὐτυχίας Ἀτρείδαις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:811.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:811.1.text#πάλαι παλαιᾶς ἀπὸ συμφορᾶς δόμων,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:812.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:812.1.text#ὁπότε χρυσείας ἔρις ἀρνὸς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:813.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:813.1.text#ἤλυθε Τανταλίδαις,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:814.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:814.1.text#οἰκτρότατα θοινάματα καὶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:815.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:815.1.text#σφάγια γενναίων τεκέων·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:816.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:816.1.text#ὅθεν φόνῳ φόνος ἐξαμείβων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:817.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:817.1.text#δι' αἵματος οὐ προλείπει
urn:cts:greekLit:tlg0006.tlg016.fu.sp:818.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:818.1.text#δισσοῖσιν Ἀτρείδαις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:819.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:819.1.text#τὸ καλὸν οὐ καλόν, τοκέων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:820.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:820.1.text#πυριγενεῖ τεμεῖν παλάμᾳ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:821.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:821.1.text#χρόα μελάνδετον δὲ φόνῳ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:822.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:822.1.text#ξίφος ἐς αὐγὰς ἀελίοιο δεῖξαι·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:823.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:823.1.text#τὸ δ' εὖ κακουργεῖν ἀσέβεια ποικίλα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:824.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:824.1.text#κακοφρόνων τ' ἀνδρῶν παράνοια.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:825.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:825.1.text#θανάτου γὰρ ἀμφὶ φόβῳ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:826.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:826.1.text#Τυνδαρὶς ἰάχησε τάλαινα·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:827.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:827.1.text#Τέκνον, οὐ τολμᾷς ὅσια
urn:cts:greekLit:tlg0006.tlg016.fu.sp:828.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:828.1.text#κτείνων σὰν ματέρα· μὴ πατρῴαν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:829.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:829.1.text#τιμῶν χάριν ἐξανάψῃ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:830.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:830.1.text#δύσκλειαν ἐς αἰεί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:831.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:831.1.text#τίς νόσος ἢ τίνα δάκρυα καὶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:832.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:832.1.text#τίς ἔλεος μείζων κατὰ γᾶν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:833.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:833.1.text#ἢ ματροκτόνον αἷμα χειρὶ θέσθαι;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:834.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:834.1.text#οἷον ἔργον τελέσας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:835.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:835.1.text#βεβάκχευται μανίαις,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:836.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:836.1.text#Εὐμενίσι θήραμα, φόνον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:837.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:837.1.text#δρομάσι δινεύων βλεφάροις,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:838.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:838.1.text#Ἀγαμεμνόνιος παῖς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:839.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:839.1.text#ὦ μέλεος, ματρὸς ὅτε
urn:cts:greekLit:tlg0006.tlg016.fu.sp:840.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:840.1.text#χρυσεοπηνήτων φαρέων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:841.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:841.1.text#μαστὸν ὑπερτέλλοντ' ἐσιδὼν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:842.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:842.1.text#σφάγιον ἔθετο ματέρα, πατρῴων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:843.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:843.1.text#παθέων ἀμοιβάν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:844.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:844.1.text#γυναῖκες, ἦ που τῶνδ' ἀφώρμηται δόμων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:845.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:845.1.text#τλήμων Ὀρέστης θεομανεῖ λύσσῃ δαμείς;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:846.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:846.1.text#ἥκιστα· πρὸς δ' Ἀργεῖον οἴχεται λεών,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:847.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:847.1.text#ψυχῆς ἀγῶνα τὸν προκείμενον πέρι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:848.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:848.1.text#δώσων, ἐν ᾧ ζῆν ἢ θανεῖν ὑμᾶς χρεών.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:849.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:849.1.text#οἴμοι· τί χρῆμ' ἔδρασε; τίς δ' ἔπεισέ νιν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:850.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:850.1.text#Πυλάδης· ἔοικε δ' οὐ μακρὰν ὅδ' ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:851.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:851.1.text#λέξειν τὰ κεῖθεν σοῦ κασιγνήτου πέρι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:852.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:852.1.text#ὦ τλῆμον, ὦ δύστηνε τοῦ στρατηλάτου
urn:cts:greekLit:tlg0006.tlg016.fu.sp:853.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:853.1.text#Ἀγαμέμνονος παῖ, πότνι' Ἠλέκτρα, λόγους
urn:cts:greekLit:tlg0006.tlg016.fu.sp:854.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:854.1.text#ἄκουσον οὕς σοι δυστυχεῖς ἥκω φέρων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:855.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:855.1.text#αἰαῖ, διοιχόμεσθα· δῆλος εἶ λόγῳ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:856.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:856.1.text#κακῶν γὰρ ἥκεις, ὡς ἔοικεν, ἄγγελος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:857.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:857.1.text#ψήφῳ Πελασγῶν σὸν κασίγνητον θανεῖν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:858.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:858.1.text#καὶ σέ, ὦ τάλαιν', ἔδοξε τῇδ' ἐν ἡμέρᾳ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:859.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:859.1.text#οἴμοι· προσῆλθεν ἐλπίς, ἣν φοβουμένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:860.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:860.1.text#πάλαι τὸ μέλλον ἐξετηκόμην γόοις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:861.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:861.1.text#ἀτὰρ τίς ἁγών, τίνες ἐν Ἀργείοις λόγοι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:862.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:862.1.text#καθεῖλον ἡμᾶς κἀπεκύρωσαν θανεῖν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:863.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:863.1.text#λέγ', ὦ γεραιέ· πότερα λευσίμῳ χερὶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:864.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:864.1.text#ἢ διὰ σιδήρου πνεῦμ' ἀπορρῆξαί με δεῖ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:865.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:865.1.text#κοινὰς ἀδελφῷ συμφορὰς κεκτημένην;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:866.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:866.1.text#ἐτύγχανον μὲν ἀγρόθεν πυλῶν ἔσω
urn:cts:greekLit:tlg0006.tlg016.fu.sp:867.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:867.1.text#βαίνων, πυθέσθαι δεόμενος τά τ' ἀμφὶ σοῦ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:868.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:868.1.text#τά τ' ἀμφ' Ὀρέστου· σῷ γὰρ εὔνοιαν πατρὶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:869.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:869.1.text#ἀεί ποτ' εἶχον, καί μ' ἔφερβε σὸς δόμος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:870.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:870.1.text#πένητα μέν, χρῆσθαι δὲ γενναῖον φίλοις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:871.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:871.1.text#ὁρῶ δ' ὄχλον στείχοντα καὶ θάσσοντ' ἄκραν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:872.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:872.1.text#οὗ φασι πρῶτον Δαναὸν Αἰγύπτῳ δίκας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:873.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:873.1.text#διδόντ' ἀθροῖσαι λαὸν ἐς κοινὰς ἕδρας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:874.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:874.1.text#ἀστῶν δὲ δή τιν' ἠρόμην ἄθροισμ' ἰδών·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:875.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:875.1.text#Τί καινὸν Ἄργει; μῶν τι πολεμίων πάρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:876.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:876.1.text#ἄγγελμ' ἀνεπτέρωκε Δαναϊδῶν πόλιν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:877.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:877.1.text#ὃ δ' εἶπ'· Ὀρέστην κεῖνον οὐχ ὁρᾷς πέλας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:878.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:878.1.text#στείχοντ', ἀγῶνα θανάσιμον δραμούμενον;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:879.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:879.1.text#ὁρῶ δ' ἄελπτον φάσμ', ὃ μήποτ' ὤφελον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:880.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:880.1.text#Πυλάδην τε καὶ σὸν σύγγονον στείχονθ' ὁμοῦ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:881.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:881.1.text#τὸν μὲν κατηφῆ καὶ παρειμένον νόσῳ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:882.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:882.1.text#τὸν δ' ὥστ' ἀδελφὸν ἴσα φίλῳ λυπούμενον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:883.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:883.1.text#νόσημα κηδεύοντα παιδαγωγίᾳ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:884.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:884.1.text#ἐπεὶ δὲ πλήρης ἐγένετ' Ἀργείων ὄχλος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:885.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:885.1.text#κῆρυξ ἀναστὰς εἶπε· Τίς χρῄζει λέγειν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:886.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:886.1.text#πότερον Ὀρέστην κατθανεῖν ἢ μὴ χρεών,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:887.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:887.1.text#μητροκτονοῦντα; κἀπὶ τῷδ' ἀνίσταται
urn:cts:greekLit:tlg0006.tlg016.fu.sp:888.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:888.1.text#Ταλθύβιος, ὃς σῷ πατρὶ συνεπόρθει Φρύγας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:889.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:889.1.text#ἔλεξε δ', ὑπὸ τοῖς δυναμένοισιν ὢν ἀεί,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:890.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:890.1.text#διχόμυθα, πατέρα μὲν σὸν ἐκπαγλούμενος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:891.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:891.1.text#σὸν δ' οὐκ ἐπαινῶν σύγγονον, καλοὺς κακοὺς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:892.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:892.1.text#λόγους ἑλίσσων, ὅτι καθισταίη νόμους
urn:cts:greekLit:tlg0006.tlg016.fu.sp:893.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:893.1.text#ἐς τοὺς τεκόντας οὐ καλούς· τὸ δ' ὄμμ' ἀεὶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:894.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:894.1.text#φαιδρωπὸν ἐδίδου τοῖσιν Αἰγίσθου φίλοις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:895.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:895.1.text#τὸ γὰρ γένος τοιοῦτον· ἐπὶ τὸν εὐτυχῆ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:896.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:896.1.text#πηδῶσ' ἀεὶ κήρυκες· ὅδε δ' αὐτοῖς φίλος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:897.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:897.1.text#ὃς ἂν δύνηται πόλεος ἔν τ' ἀρχαῖσιν ᾖ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:898.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:898.1.text#ἐπὶ τῷδε δ' ἠγόρευε Διομήδης ἄναξ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:899.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:899.1.text#οὗτος κτανεῖν μὲν οὔτε σὲ οὔτε σύγγονον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:900.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:900.1.text#εἴα, φυγῇ δὲ ζημιοῦντας εὐσεβεῖν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:901.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:901.1.text#ἐπερρόθησαν δ' οἳ μὲν ὡς καλῶς λέγοι,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:902.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:902.1.text#οἳ δ' οὐκ ἐπῄνουν. κἀπὶ τῷδ' ἀνίσταται
urn:cts:greekLit:tlg0006.tlg016.fu.sp:903.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:903.1.text#ἀνήρ τις ἀθυρόγλωσσος, ἰσχύων θράσει,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:904.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:904.1.text#Ἀργεῖος οὐκ Ἀργεῖος, ἠναγκασμένος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:905.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:905.1.text#θορύβῳ τε πίσυνος κἀμαθεῖ παρρησίᾳ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:906.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:906.1.text#πιθανὸς ἔτ' αὐτοὺς περιβαλεῖν κακῷ τινι·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:907.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:907.1.text#[ ὅταν γὰρ ἡδύς τις λόγοις φρονῶν κακῶς ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:908.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:908.1.text#[ πείθῃ τὸ πλῆθος, τῇ πόλει κακὸν μέγα· ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:909.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:909.1.text#[ ὅσοι δὲ σὺν νῷ χρηστὰ βουλεύουσ' ἀεί, ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:910.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:910.1.text#[ κἂν μὴ παραυτίκ', αὖθίς εἰσι χρήσιμοι ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:911.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:911.1.text#[ πόλει. θεᾶσθαι δ' ὧδε χρὴ τὸν προστάτην ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:912.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:912.1.text#[ ἰδόνθ'· ὅμοιον γὰρ τὸ χρῆμα γίγνεται ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:913.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:913.1.text#[ τῷ τοὺς λόγους λέγοντι καὶ τιμωμένῳ. ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:914.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:914.1.text#ὃς εἶπ' Ὀρέστην καὶ σὲ ἀποκτεῖναι πέτροις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:915.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:915.1.text#βάλλοντας· ὑπὸ δ' ἔτεινε Τυνδάρεως λόγους
urn:cts:greekLit:tlg0006.tlg016.fu.sp:916.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:916.1.text#τῷ σφὼ κατακτείνοντι τοιούτους λέγειν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:917.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:917.1.text#ἄλλος δ' ἀναστὰς ἔλεγε τῷδ' ἐναντία,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:918.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:918.1.text#μορφῇ μὲν οὐκ εὐωπός, ἀνδρεῖος δ' ἀνήρ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:919.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:919.1.text#ὀλιγάκις ἄστυ κἀγορᾶς χραίνων κύκλον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:920.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:920.1.text#αὐτουργός — οἵπερ καὶ μόνοι σῴζουσι γῆν —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:921.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:921.1.text#ξυνετὸς δέ, χωρεῖν ὁμόσε τοῖς λόγοις θέλων,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:922.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:922.1.text#ἀκέραιος, ἀνεπίπληκτον ἠσκηκὼς βίον·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:923.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:923.1.text#ὃς εἶπ' Ὀρέστην παῖδα τὸν Ἀγαμέμνονος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:924.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:924.1.text#στεφανοῦν, ὃς ἠθέλησε τιμωρεῖν πατρί,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:925.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:925.1.text#κακὴν γυναῖκα κἄθεον κατακτανών,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:926.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:926.1.text#ἣ κεῖν' ἀφῄρει, μήθ' ὁπλίζεσθαι χέρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:927.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:927.1.text#μήτε στρατεύειν ἐκλιπόντα δώματα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:928.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:928.1.text#εἰ τἄνδον οἰκουρήμαθ' οἱ λελειμμένοι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:929.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:929.1.text#φθείρουσιν, ἀνδρῶν εὔνιδας λωβώμενοι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:930.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:930.1.text#καὶ τοῖς γε χρηστοῖς εὖ λέγειν ἐφαίνετο.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:931.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:931.1.text#κοὐδεὶς ἔτ' εἶπε. σὸς δ' ἐπῆλθε σύγγονος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:932.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:932.1.text#ἔλεξε δ'· ὦ γῆν Ἰνάχου κεκτημένοι,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:933.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:933.1.text#[ πάλαι Πελασγοί, Δαναΐδαι δεύτερον, ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:934.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:934.1.text#ὑμῖν ἀμύνων οὐδὲν ἧσσον ἢ πατρὶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:935.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:935.1.text#ἔκτεινα μητέρ'. εἰ γὰρ ἀρσένων φόνος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:936.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:936.1.text#ἔσται γυναιξὶν ὅσιος, οὐ φθάνοιτ' ἔτ' ἂν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:937.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:937.1.text#θνῄσκοντες, ἢ γυναιξὶ δουλεύειν χρεών·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:938.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:938.1.text#τοὐναντίον δὲ δράσετ' ἢ δρᾶσαι χρεών.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:939.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:939.1.text#νῦν μὲν γὰρ ἡ προδοῦσα λέκτρ' ἐμοῦ πατρὸς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:940.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:940.1.text#τέθνηκεν· εἰ δὲ δὴ κατακτενεῖτ' ἐμέ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:941.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:941.1.text#ὁ νόμος ἀνεῖται, κοὐ φθάνοι θνῄσκων τις ἄν·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:942.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:942.1.text#ὡς τῆς γε τόλμης οὐ σπάνις γενήσεται.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:943.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:943.1.text#ἀλλ' οὐκ ἔπειθ' ὅμιλον, εὖ δοκῶν λέγειν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:944.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:944.1.text#νικᾷ δ' ἐκεῖνος ὁ κακὸς ἐν πλήθει λέγων,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:945.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:945.1.text#ὃς ἠγόρευσε σύγγονον σέ τε κτανεῖν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:946.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:946.1.text#μόλις δ' ἔπεισε μὴ πετρουμένους θανεῖν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:947.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:947.1.text#τλήμων Ὀρέστης· αὐτόχειρι δὲ σφαγῇ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:948.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:948.1.text#ὑπέσχετ' ἐν τῇδ' ἡμέρᾳ λείψειν βίον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:949.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:949.1.text#σὺν σοί. πορεύει δ' αὐτὸν ἐκκλήτων ἄπο
urn:cts:greekLit:tlg0006.tlg016.fu.sp:950.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:950.1.text#Πυλάδης δακρύων· σὺν δ' ὁμαρτοῦσιν φίλοι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:951.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:951.1.text#κλαίοντες, οἰκτίροντες· ἔρχεται δέ σοι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:952.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:952.1.text#πικρὸν θέαμα καὶ πρόσοψις ἀθλία.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:953.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:953.1.text#ἀλλ' εὐτρέπιζε φάσγαν' ἢ βρόχον δέρῃ·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:954.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:954.1.text#ὡς δεῖ λιπεῖν σε φέγγος· ἡ εὐγένεια δὲ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:955.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:955.1.text#οὐδέν σ' ἐπωφέλησεν, οὐδ' ὁ Πύθιος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:956.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:956.1.text#τρίποδα καθίζων Φοῖβος, ἀλλ' ἀπώλεσεν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:957.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:957.1.text#ὦ δυστάλαινα παρθέν', ὡς ξυνηρεφὲς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:958.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:958.1.text#πρόσωπον εἰς γῆν σὸν βαλοῦσ' ἄφθογγος εἶ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:959.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:959.1.text#ὡς εἰς στεναγμοὺς καὶ γόους δραμουμένη.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:960.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:960.1.text#κατάρχομαι στεναγμόν, ὦ Πελασγία,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:961.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:961.1.text#τιθεῖσα λευκὸν ὄνυχα διὰ παρηίδων,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:962.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:962.1.text#αἱματηρὸν ἄταν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:963.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:963.1.text#κτύπον τε κρατός, ὃν ἔλαχ' ἁ κατὰ χθονὸς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:964.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:964.1.text#νερτέρων Περσέφασσα καλλίπαις θεά.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:965.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:965.1.text#ἰαχείτω δὲ γᾶ Κυκλωπία,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:966.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:966.1.text#σίδαρον ἐπὶ κάρα τιθεῖσα κούριμον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:967.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:967.1.text#πήματ' οἴκων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:968.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:968.1.text#ἔλεος ἔλεος ὅδ' ἔρχεται
urn:cts:greekLit:tlg0006.tlg016.fu.sp:969.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:969.1.text#τῶν θανουμένων ὕπερ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:970.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:970.1.text#στρατηλατᾶν Ἑλλάδος ποτ' ὄντων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:971.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:971.1.text#βέβακε γὰρ βέβακεν, οἴχεται τέκνων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:972.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:972.1.text#πρόπασα γέννα Πέλοπος ὅ τ' ἐπὶ μακαρίοις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:973.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:973.1.text#ζῆλος ὤν ποτ' οἴκοις·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:974.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:974.1.text#φθόνος νιν εἷλε θεόθεν, ἅ τε δυσμενὴς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:975.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:975.1.text#φοινία ψῆφος ἐν πολίταις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:976.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:976.1.text#ἰὼ ἰώ, πανδάκρυτ' ἐφαμέρων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:977.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:977.1.text#ἔθνη πολύπονα, λεύσσεθ', ὡς παρ' ἐλπίδας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:978.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:978.1.text#μοῖρα βαίνει.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:979.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:979.1.text#ἕτερα δ' ἕτερος ἀμείβεται
urn:cts:greekLit:tlg0006.tlg016.fu.sp:980.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:980.1.text#πήματ' ἐν χρόνῳ μακρῷ·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:981.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:981.1.text#βροτῶν δ' ὁ πᾶς ἀστάθμητος αἰών.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:982.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:982.1.text#μόλοιμι τὰν οὐρανοῦ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:983.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:983.1.text#μέσον χθονός { τε } τεταμέναν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:983.2.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:983.2.text#αἰωρήμασι πέτραν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:983.2.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:983.2.text#ἁλύσεσιν χρυσέαισι φερομέναν δίναισι,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:983.3.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:983.3.text#βῶλον ἐξ Ὀλύμπου,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:984.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:984.1.text#ἵν' ἐν θρήνοισιν ἀναβοάσω
urn:cts:greekLit:tlg0006.tlg016.fu.sp:985.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:985.1.text#γέροντι πατρὶ Ταντάλῳ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:986.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:986.1.text#ὃς ἔτεκεν ἔτεκε γενέτορας ἐμέθεν δόμων,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:987.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:987.1.text#οἳ κατεῖδον ἄτας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:988.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:988.1.text#ποτανὸν μὲν δίωγμα πώλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:989.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:989.1.text#τεθριπποβάμονι στόλῳ Πέλοψ ὅτε
urn:cts:greekLit:tlg0006.tlg016.fu.sp:990.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:990.1.text#πελάγεσι διεδίφρευσε, Μυρτίλου φόνον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:991.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:991.1.text#δικὼν ἐς οἶδμα πόντου,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:992.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:992.1.text#λευκοκύμοσιν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:993.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:993.1.text#πρὸς Γεραιστίαις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:994.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:994.1.text#ποντίων σάλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:994.2.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:994.2.text#ᾐόσιν ἁρματεύσας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:995.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:995.1.text#ὅθεν δόμοισι τοῖς ἐμοῖς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:996.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:996.1.text#ἦλθ' ἀρὰ πολύστονος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:997.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:997.1.text#λόχευμα ποιμνίοισι Μαιάδος τόκου,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:998.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:998.1.text#τὸ χρυσόμαλλον ἀρνὸς ὁπότ'
urn:cts:greekLit:tlg0006.tlg016.fu.sp:999.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:999.1.text#ἐγένετο τέρας ὀλοὸν ὀλοὸν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1000.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1000.1.text#Ἀτρέος ἱπποβώτα·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1001.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1001.1.text#ὅθεν Ἔρις τό τε πτερωτὸν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1002.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1002.1.text#ἁλίου μετέβαλεν ἅρμα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1003.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1003.1.text#τὰν πρὸς ἑσπέραν κέλευθον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1004.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1004.1.text#οὐρανοῦ προσαρμόσασα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1004.2.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1004.2.text#μονόπωλον ἐς Ἀῶ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1005.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1005.1.text#ἑπταπόρου τε δράμημα Πελειάδος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1006.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1006.1.text#εἰς ὁδὸν ἄλλαν Ζεὺς μεταβάλλει,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1007.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1007.1.text#τῶνδέ τ' ἀμείβει [ … ] θανάτους θανάτων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1008.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1008.1.text#τά τ' ἐπώνυμα δεῖπνα Θυέστου
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1009.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1009.1.text#λέκτρα τε Κρήσσας Ἀερόπας δολίας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1010.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1010.1.text#δολίοισι γάμοις· τὰ πανύστατα δ'
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1011.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1011.1.text#εἰς ἐμὲ καὶ γενέταν ἐμὸν ἤλυθε
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1012.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1012.1.text#δόμων πολυπόνοις ἀνάγκαις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1013.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1013.1.text#καὶ μὴν ὅδε σὸς σύγγονος ἕρπει
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1014.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1014.1.text#ψήφῳ θανάτου κατακυρωθείς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1014.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1014.2.text#ὅ τε πιστότατος πάντων Πυλάδης,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1015.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1015.1.text#ἰσάδελφος ἀνήρ, ἰθύνων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1016.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1016.1.text#νοσερὸν κῶλον [ Ὀρέστου ],
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1017.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1017.1.text#ποδὶ κηδοσύνῳ παράσειρος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1018.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1018.1.text#οἲ ἐγώ· πρὸ τύμβου γάρ σ' ὁρῶσ' ἀναστένω,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1019.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1019.1.text#ἀδελφέ, καὶ πάροιθε νερτέρου πυρᾶς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1020.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1020.1.text#οἲ ἐγὼ μάλ' αὖθις· ὥς σ' ἰδοῦσ' ἐν ὄμμασιν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1021.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1021.1.text#πανυστάτην πρόσοψιν ἐξέστην φρενῶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1022.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1022.1.text#οὐ σῖγ' ἀφεῖσα τοὺς γυναικείους γόους
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1023.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1023.1.text#στέρξεις τὰ κρανθέντ'; οἰκτρὰ μὲν τάδ', ἀλλ' ὅμως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1024.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1024.1.text#[ φέρειν σ' ἀνάγκη τὰς παρεστώσας τύχας ].
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1025.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1025.1.text#καὶ πῶς σιωπῶ; φέγγος εἰσορᾶν θεοῦ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1026.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1026.1.text#τόδ' οὐκέθ' ἡμῖν τοῖς ταλαιπώροις μέτα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1027.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1027.1.text#σὺ μή μ' ἀπόκτειν'· ἅλις ὑπ' Ἀργείας χερὸς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1028.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1028.1.text#τέθνηχ' ὁ τλήμων· τὰ δὲ παρόντ' ἔα κακά.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1029.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1029.1.text#ὦ μέλεος ἥβης σῆς, Ὀρέστα, καὶ πότμου
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1030.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1030.1.text#θανάτου τ' ἀώρου. ζῆν ἐχρῆν σ', ὅτ' οὐκέτ' εἶ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1031.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1031.1.text#μὴ πρὸς θεῶν μοι περιβάλῃς ἀνανδρίαν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1032.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1032.1.text#ἐς δάκρυα πορθμεύουσ' ὑπομνήσει κακῶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1033.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1033.1.text#θανούμεθ'· οὐχ οἷόν τε μὴ στένειν κακά.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1034.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1034.1.text#πᾶσιν γὰρ οἰκτρὸν ἡ φίλη ψυχὴ βροτοῖς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1035.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1035.1.text#τόδ' ἦμαρ ἡμῖν κύριον· δεῖ δ' ἢ βρόχους
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1036.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1036.1.text#ἅπτειν κρεμαστοὺς ἢ ξίφος θήγειν χερί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1037.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1037.1.text#σύ νύν μ', ἀδελφέ, μή τις Ἀργείων κτάνῃ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1038.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1038.1.text#ὕβρισμα θέμενος τὸν Ἀγαμέμνονος γόνον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1039.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1039.1.text#ἅλις τὸ μητρὸς αἷμ' ἔχω· σὲ δ' οὐ κτενῶ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1040.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1040.1.text#ἀλλ' αὐτόχειρι θνῇσχ' ὅτῳ βούλῃ τρόπῳ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1041.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1041.1.text#ἔσται τάδ'· οὐδὲν σοῦ ξίφους λελείψομαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1042.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1042.1.text#ἀλλ' ἀμφιθεῖναι σῇ δέρῃ θέλω χέρας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1043.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1043.1.text#τέρπου κενὴν ὄνησιν, εἰ τερπνὸν τόδε
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1044.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1044.1.text#θανάτου πέλας βεβῶσι, περιβαλεῖν χέρας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1045.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1045.1.text#ὦ φίλτατ', ὦ ποθεινὸν ἥδιστόν τ' ἔχων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1046.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1046.1.text#τῆς σῆς ἀδελφῆς ὄνομα καὶ ψυχὴν μίαν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1047.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1047.1.text#ἔκ τοί με τήξεις· καί σ' ἀμείψασθαι θέλω
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1048.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1048.1.text#φιλότητι χειρῶν. τί γὰρ ἔτ' αἰδοῦμαι τάλας;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1049.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1049.1.text#ὦ στέρν' ἀδελφῆς, ὦ φίλον πρόσπτυγμ' ἐμόν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1050.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1050.1.text#τάδ' ἀντὶ παίδων καὶ γαμηλίου λέχους —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1051.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1051.1.text#[ προσφθέγματ' ἀμφοῖν τοῖς ταλαιπώροις πάρα ].
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1052.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1052.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1052.2.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1052.2.text#πῶς ἂν ξίφος νὼ ταὐτόν, εἰ θέμις, κτάνοι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1053.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1053.1.text#καὶ μνῆμα δέξαιθ' ἕν, κέδρου τεχνάσματα;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1054.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1054.1.text#ἥδιστ' ἂν εἴη ταῦθ'· ὁρᾷς δὲ δὴ φίλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1055.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1055.1.text#ὡς ἐσπανίσμεθ', ὥστε κοινωνεῖν τάφου.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1056.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1056.1.text#οὐδ' εἶφ' ὑπὲρ σοῦ, μὴ θανεῖν σπουδὴν ἔχων,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1057.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1057.1.text#Μενέλαος ὁ κακός, ὁ προδότης τοὐμοῦ πατρός;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1058.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1058.1.text#οὐδ' ὄμμ' ἔδειξεν, ἀλλ' ἐπὶ σκήπτροις ἔχων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1059.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1059.1.text#τὴν ἐλπίδ', εὐλαβεῖτο μὴ σῴζειν φίλους.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1060.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1060.1.text#ἀλλ' εἶ' ὅπως γενναῖα καὶ Ἀγαμέμνονος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1061.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1061.1.text#δράσαντε κατθανούμεθ' ἀξιώτατα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1062.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1062.1.text#κἀγὼ μὲν εὐγένειαν ἀποδείξω πόλει,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1063.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1063.1.text#παίσας πρὸς ἧπαρ φασγάνῳ· σὲ δ' αὖ χρεὼν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1064.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1064.1.text#ὅμοια πράσσειν τοῖς ἐμοῖς τολμήμασιν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1065.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1065.1.text#Πυλάδη, σὺ δ' ἡμῖν τοῦ φόνου γενοῦ βραβεύς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1066.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1066.1.text#καὶ κατθανόντοιν εὖ περίστειλον δέμας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1067.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1067.1.text#θάψον τε κοινῇ πρὸς πατρὸς τύμβον φέρων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1068.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1068.1.text#καὶ χαῖρ'· ἐπ' ἔργον δ', ὡς ὁρᾷς, πορεύομαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1069.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1069.1.text#ἐπίσχες. ἓν μὲν πρῶτά σοι μομφὴν ἔχω,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1070.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1070.1.text#εἰ ζῆν με χρῄζειν σοῦ θανόντος ἤλπισας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1071.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1071.1.text#τί γὰρ προσήκει κατθανεῖν σ' ἐμοῦ μέτα;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1072.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1072.1.text#ἤρου; τί δὲ ζῆν σῆς ἑταιρίας ἄτερ;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1073.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1073.1.text#οὐκ ἔκτανες σὴν μητέρ', ὡς ἐγὼ τάλας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1074.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1074.1.text#σὺν σοί γε κοινῇ· ταὐτὰ καὶ πάσχειν με δεῖ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1075.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1075.1.text#ἀπόδος τὸ σῶμα πατρί, μὴ σύνθνῃσκέ μοι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1076.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1076.1.text#σοὶ μὲν γὰρ ἔστι πόλις, ἐμοὶ δ' οὐκ ἔστι δή,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1077.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1077.1.text#καὶ δῶμα πατρὸς καὶ μέγας πλούτου λιμήν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1078.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1078.1.text#γάμων δὲ τῆς μὲν δυσπότμου τῆσδ' ἐσφάλης,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1079.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1079.1.text#ἥν σοι κατηγγύησ' ἑταιρίαν σέβων·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1080.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1080.1.text#σὺ δ' ἄλλο λέκτρον παιδοποίησαι λαβών,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1081.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1081.1.text#κῆδος δὲ τοὐμὸν καὶ σὸν οὐκέτ' ἔστι δή.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1082.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1082.1.text#ἀλλ', ὦ ποθεινὸν ὄμμ' ὁμιλίας ἐμῆς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1083.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1083.1.text#χαῖρ'· οὐ γὰρ ἡμῖν ἔστι τοῦτο, σοί γε μήν·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1084.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1084.1.text#οἱ γὰρ θανόντες χαρμάτων τητώμεθα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1085.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1085.1.text#ἦ πολὺ λέλειψαι τῶν ἐμῶν βουλευμάτων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1086.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1086.1.text#μήθ' αἷμά μου δέξαιτο κάρπιμον πέδον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1087.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1087.1.text#μὴ λαμπρὸς αἰθήρ, εἴ σ' ἐγὼ προδούς ποτε
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1088.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1088.1.text#ἐλευθερώσας τοὐμὸν ἀπολίποιμι σέ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1089.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1089.1.text#καὶ συγκατέκτανον γάρ, οὐκ ἀρνήσομαι,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1090.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1090.1.text#καὶ πάντ' ἐβούλευσ' ὧν σὺ νῦν τίνεις δίκας·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1091.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1091.1.text#καὶ ξυνθανεῖν οὖν δεῖ με σοὶ καὶ τῇδ' ὁμοῦ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1092.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1092.1.text#ἐμὴν γὰρ αὐτήν, ἧς { γε } λέχος ἐπῄνεσα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1093.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1093.1.text#κρίνω δάμαρτα· τί γὰρ ἐρῶ κἀγώ ποτε
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1094.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1094.1.text#γῆν Δελφίδ' ἐλθὼν Φωκέων ἀκρόπτολιν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1095.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1095.1.text#ὃς πρὶν μὲν ὑμᾶς δυστυχεῖν φίλος παρῆ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1096.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1096.1.text#νῦν δ' οὐκέτ' εἰμὶ δυστυχοῦντί σοι φίλος;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1097.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1097.1.text#οὐκ ἔστιν. ἀλλὰ ταῦτα μὲν κἀμοὶ μέλει·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1098.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1098.1.text#ἐπεὶ δὲ κατθανούμεθ', ἐς κοινοὺς λόγους
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1099.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1099.1.text#ἔλθωμεν, ὡς ἂν Μενέλεως συνδυστυχῇ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1100.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1100.1.text#ὦ φίλτατ', εἰ γὰρ τοῦτο κατθάνοιμ' ἰδών.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1101.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1101.1.text#πιθοῦ νυν, ἄμμεινόν τε φασγάνου τομάς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1102.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1102.1.text#μενῶ, τὸν ἐχθρὸν εἴ τι τιμωρήσομαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1103.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1103.1.text#σίγα νυν· ὡς γυναιξὶ πιστεύω βραχύ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1104.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1104.1.text#μηδὲν τρέσῃς τάσδ'· ὡς πάρεισ' ἡμῖν φίλαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1105.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1105.1.text#Ἑλένην κτάνωμεν, Μενέλεῳ λύπην πικράν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1106.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1106.1.text#πῶς; τὸ γὰρ ἕτοιμον ἔστιν, εἴ γ' ἔσται καλῶς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1107.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1107.1.text#σφάξαντες. ἐν δόμοις δὲ κρύπτεται σέθεν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1108.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1108.1.text#μάλιστα· καὶ δὴ πάντ' ἀποσφραγίζεται.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1109.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1109.1.text#ἀλλ' οὐκέθ', Ἅιδην νυμφίον κεκτημένη.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1110.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1110.1.text#καὶ πῶς; ἔχει γὰρ βαρβάρους ὀπάονας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1111.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1111.1.text#τίνας; Φρυγῶν γὰρ οὐδέν' ἂν τρέσαιμ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1112.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1112.1.text#οἵους ἐνόπτρων καὶ μύρων ἐπιστάτας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1113.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1113.1.text#τρυφὰς γὰρ ἥκει δεῦρ' ἔχουσα Τρωικάς;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1114.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1114.1.text#ὥσθ' Ἑλλὰς αὐτῇ σμικρὸν οἰκητήριον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1115.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1115.1.text#οὐδὲν τὸ δοῦλον πρὸς τὸ μὴ δοῦλον γένος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1116.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1116.1.text#καὶ μὴν τόδ' ἔρξας δὶς θανεῖν οὐχ ἅζομαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1117.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1117.1.text#ἀλλ' οὐδ' ἐγὼ μήν, σοί γε τιμωρούμενος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1118.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1118.1.text#τὸ πρᾶγμα δήλου καὶ πέραιν', ὅπως λέγεις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1119.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1119.1.text#ἔσιμεν ἐς οἴκους δῆθεν ὡς θανούμενοι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1120.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1120.1.text#ἔχω τοσοῦτον, τἀπίλοιπα δ' οὐκ ἔχω.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1121.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1121.1.text#γόους πρὸς αὐτὴν θησόμεσθ' ἃ πάσχομεν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1122.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1122.1.text#ὥστ' ἐκδακρῦσαί γ' ἔνδοθεν κεχαρμένην.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1123.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1123.1.text#καὶ νῷν παρέσται ταῦθ' ἅπερ κείνῃ τότε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1124.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1124.1.text#ἔπειτ' ἀγῶνα πῶς ἀγωνιούμεθα;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1125.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1125.1.text#κρύπτ' ἐν πέπλοισι τοισίδ' ἕξομεν ξίφη.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1126.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1126.1.text#πρόσθεν δ' ὀπαδῶν τίς ὄλεθρος γενήσεται;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1127.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1127.1.text#ἐκκλῄσομεν σφᾶς ἄλλον ἄλλοσε στέγης.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1128.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1128.1.text#καὶ τόν γε μὴ σιγῶντ' ἀποκτείνειν χρεών.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1129.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1129.1.text#εἶτ' αὐτὸ δηλοῖ τοὔργον οἷ τείνειν χρεών.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1130.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1130.1.text#Ἑλένην φονεύειν· μανθάνω τὸ σύμβολον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1131.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1131.1.text#ἔγνως· ἄκουσον δ' ὡς καλῶς βουλεύομαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1132.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1132.1.text#εἰ μὲν γὰρ ἐς γυναῖκα σωφρονεστέραν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1133.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1133.1.text#ξίφος μεθεῖμεν, δυσκλεὴς ἂν ἦν φόνος·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1134.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1134.1.text#νῦν δ' ὑπὲρ ἁπάσης Ἑλλάδος δώσει δίκην,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1135.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1135.1.text#ὧν πατέρας ἔκτειν', ὧν δ' ἀπώλεσεν τέκνα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1136.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1136.1.text#νύμφας τ' ἔθηκεν ὀρφανὰς ξυναόρων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1137.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1137.1.text#ὀλολυγμὸς ἔσται, πῦρ τ' ἀνάψουσιν θεοῖς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1138.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1138.1.text#σοὶ πολλὰ κἀμοὶ κέδν' ἀρώμενοι τυχεῖν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1139.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1139.1.text#κακῆς γυναικὸς οὕνεχ' αἷμ' ἐπράξαμεν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1140.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1140.1.text#ὁ μητροφόντης δ' οὐ καλῇ ταύτην κτανών,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1141.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1141.1.text#ἀλλ' ἀπολιπὼν τοῦτ' ἐπὶ τὸ βέλτιον πεσῇ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1142.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1142.1.text#Ἑλένης λεγόμενος τῆς πολυκτόνου φονεύς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1143.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1143.1.text#οὐ δεῖ ποτ', οὐ δεῖ, Μενέλεων μὲν εὐτυχεῖν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1144.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1144.1.text#τὸν σὸν δὲ πατέρα καὶ σὲ κἀδελφὴν θανεῖν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1145.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1145.1.text#μητέρα τε — ἐῶ τοῦτ'· οὐ γὰρ εὐπρεπὲς λέγειν —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1146.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1146.1.text#δόμους δ' ἔχειν σοὺς δι' Ἀγαμέμνονος δόρυ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1147.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1147.1.text#λαβόντα νύμφην· μὴ γὰρ οὖν ζῴην ἔτι,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1148.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1148.1.text#ἢν μὴ 'π' ἐκείνῃ φάσγανον σπασώμεθα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1149.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1149.1.text#ἢν δ' οὖν τὸν Ἑλένης μὴ κατάσχωμεν φόνον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1150.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1150.1.text#πρήσαντες οἴκους τούσδε κατθανούμεθα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1151.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1151.1.text#ἑνὸς γὰρ οὐ σφαλέντες ἕξομεν κλέος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1152.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1152.1.text#καλῶς θανόντες ἢ καλῶς σεσῳσμένοι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1153.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1153.1.text#πάσαις γυναιξὶν ἀξία στυγεῖν ἔφυ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1154.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1154.1.text#ἡ Τυνδαρὶς παῖς, ἣ κατῄσχυνεν γένος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1155.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1155.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1156.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1156.1.text#οὐκ ἔστιν οὐδὲν κρεῖσσον ἢ φίλος σαφής,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1157.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1157.1.text#οὐ πλοῦτος, οὐ τυραννίς· ἀλόγιστον δέ τι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1158.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1158.1.text#τὸ πλῆθος ἀντάλλαγμα γενναίου φίλου.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1159.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1159.1.text#σὺ γὰρ τά τ' εἰς Αἴγισθον ἐξηῦρες κακὰ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1159.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1159.2.text#καὶ πλησίον παρῆσθα κινδύνων ἐμοί,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1160.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1160.1.text#νῦν τ' αὖ δίδως μοι πολεμίων τιμωρίαν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1161.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1161.1.text#κοὐκ ἐκποδὼν εἶ — παύσομαί σ' αἰνῶν, ἐπεὶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1162.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1162.1.text#βάρος τι κἀν τῷδ' ἐστίν, αἰνεῖσθαι λίαν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1163.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1163.1.text#ἐγὼ δὲ πάντως ἐκπνέων ψυχὴν ἐμὴν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1164.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1164.1.text#δράσας τι χρῄζω τοὺς ἐμοὺς ἐχθροὺς θανεῖν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1165.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1165.1.text#ἵν' ἀνταναλώσω μὲν οἵ με προύδοσαν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1166.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1166.1.text#στένωσι δ' οἵπερ κἄμ' ἔθηκαν ἄθλιον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1167.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1167.1.text#Ἀγαμέμνονός τοι παῖς πέφυχ', ὃς Ἑλλάδος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1168.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1168.1.text#ἦρξ' ἀξιωθείς, οὐ τύραννος, ἀλλ' ὅμως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1169.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1169.1.text#ῥώμην θεοῦ τιν' ἔσχε· ὃν οὐ καταισχυνῶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1170.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1170.1.text#δοῦλον παρασχὼν θάνατον, ἀλλ' ἐλευθέρως
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1171.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1171.1.text#ψυχὴν ἀφήσω, Μενέλεων δὲ τείσομαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1172.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1172.1.text#ἑνὸς γὰρ εἰ λαβοίμεθ', εὐτυχοῖμεν ἄν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1173.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1173.1.text#εἴ ποθεν ἄελπτος παραπέσοι σωτηρία
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1174.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1174.1.text#κτανοῦσι μὴ θανοῦσιν· εὔχομαι τάδε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1175.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1175.1.text#ὃ βούλομαι γάρ, ἡδὺ καὶ διὰ στόμα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1176.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1176.1.text#πτηνοῖσι μύθοις ἀδαπάνως τέρψαι φρένα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1177.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1177.1.text#ἐγώ, κασίγνητ', αὐτὸ τοῦτ' ἔχειν δοκῶ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1178.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1178.1.text#σωτηρίαν σοὶ τῷδέ τ' ἐκ τρίτων τ' ἐμοί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1179.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1179.1.text#θεοῦ λέγεις πρόνοιαν. ἀλλὰ ποῦ τόδε;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1180.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1180.1.text#ἐπεὶ τὸ συνετόν γ' οἶδα σῇ ψυχῇ παρόν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1181.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1181.1.text#ἄκουε δή νυν· καὶ σὺ δεῦρο νοῦν ἔχε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1182.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1182.1.text#λέγ'· ὡς τὸ μέλλειν ἀγάθ' ἔχει τιν' ἡδονήν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1183.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1183.1.text#Ἑλένης κάτοισθα θυγατέρ'; εἰδότ' ἠρόμην.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1184.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1184.1.text#οἶδ', ἣν ἔθρεψεν Ἑρμιόνην μήτηρ ἐμή.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1185.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1185.1.text#αὕτη βέβηκε πρὸς Κλυταιμήστρας τάφον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1186.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1186.1.text#τί χρῆμα δράσουσ'; ὑποτίθης τίν' ἐλπίδα;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1187.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1187.1.text#χοὰς κατασπείσουσ' ὑπὲρ μητρὸς τάφῳ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1188.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1188.1.text#καὶ δὴ τί μοι τοῦτ' εἶπας ἐς σωτηρίαν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1189.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1189.1.text#ξυλλάβεθ' ὅμηρον τήνδ', ὅταν στείχῃ πάλιν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1190.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1190.1.text#τίνος τόδ' εἶπας φάρμακον τρισσοῖς φίλοις;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1191.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1191.1.text#Ἑλένης θανούσης, ἤν τι Μενέλεώς σε δρᾷ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1192.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1192.1.text#ἢ τόνδε κἀμέ — πᾶν γὰρ ἓν φίλον τόδε —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1193.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1193.1.text#λέγ' ὡς φονεύσεις Ἑρμιόνην· ξίφος δὲ χρὴ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1194.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1194.1.text#δέρῃ πρὸς αὐτῇ παρθένου σπάσαντ' ἔχειν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1195.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1195.1.text#κἂν μέν σε σῴζῃ μὴ θανεῖν χρῄζων κόρην
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1196.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1196.1.text#Ἑλένης Μενέλεως πτῶμ' ἰδὼν ἐν αἵματι,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1197.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1197.1.text#μέθες πεπᾶσθαι πατρὶ παρθένου δέμας·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1198.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1198.1.text#ἢν δ' ὀξυθύμου μὴ κρατῶν φρονήματος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1199.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1199.1.text#κτείνῃ σε, καὶ σὺ σφάζε παρθένου δέρην.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1200.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1200.1.text#καί νιν δοκῶ, τὸ πρῶτον ἢν πολὺς παρῇ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1201.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1201.1.text#χρόνῳ μαλάξειν σπλάγχνον· οὔτε γὰρ θρασὺς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1202.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1202.1.text#οὔτ' ἄλκιμος πέφυκε. τήνδ' ἡμῖν ἔχω
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1203.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1203.1.text#σωτηρίας ἔπαλξιν. εἴρηται λόγος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1204.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1204.1.text#ὦ τὰς φρένας μὲν ἄρσενας κεκτημένη,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1205.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1205.1.text#τὸ σῶμα δ' ἐν γυναιξὶ θηλείαις πρέπον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1206.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1206.1.text#ὡς ἀξία ζῆν μᾶλλον ἢ θανεῖν ἔφυς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1207.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1207.1.text#Πυλάδη, τοιαύτης ἆρ' ἁμαρτήσῃ τάλας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1208.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1208.1.text#γυναικὸς ἢ ζῶν μακάριον κτήσῃ λέχος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1209.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1209.1.text#εἰ γὰρ γένοιτο, Φωκέων δ' ἔλθοι πόλιν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1210.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1210.1.text#καλοῖσιν ὑμεναίοισιν ἀξιουμένη.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1211.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1211.1.text#ἥξει δ' ἐς οἴκους Ἑρμιόνη τίνος χρόνου;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1212.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1212.1.text#ὡς τἄλλα γ' εἶπας, εἴπερ εὐτυχήσομεν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1213.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1213.1.text#κάλλισθ', ἑλόντες σκύμνον ἀνοσίου πατρός.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1214.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1214.1.text#καὶ δὴ πέλας νιν δωμάτων εἶναι δοκῶ·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1215.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1215.1.text#τοῦ γὰρ χρόνου τὸ μῆκος αὐτὸ συντρέχει.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1216.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1216.1.text#καλῶς· σὺ μέν νυν, σύγγον' Ἠλέκτρα, δόμων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1217.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1217.1.text#πάρος μένουσα παρθένου δέχου πόδα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1218.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1218.1.text#φύλασσε δ' ἤν τις, πρὶν τελευτηθῇ φόνος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1219.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1219.1.text#ἢ ξύμμαχός τις ἢ κασίγνητος πατρός,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1220.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1220.1.text#ἐλθὼν ἐς οἴκους φθῇ, γέγωνέ τ' ἐς δόμους,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1221.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1221.1.text#ἢ σανίδα παίσασ' ἢ λόγους πέμψασ' ἔσω·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1222.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1222.1.text#ἡμεῖς δ' ἔσω στείχοντες ἐπὶ τὸν ἔσχατον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1223.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1223.1.text#ἀγῶν' ὁπλιζώμεσθα φασγάνῳ χέρας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1224.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1224.1.text#[ Πυλάδη· σὺ γὰρ δὴ συμπονεῖς ἐμοὶ πόνους. ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1225.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1225.1.text#ὦ δῶμα ναίων νυκτὸς ὀρφναίας πάτερ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1226.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1226.1.text#καλεῖ σ' Ὀρέστης παῖς σὸς ἐπίκουρον μολεῖν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1227.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1227.1.text#τοῖς δεομένοισι. διὰ σὲ γὰρ πάσχω τάλας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1228.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1228.1.text#ἀδίκως· προδέδομαι δ' ὑπὸ κασιγνήτου σέθεν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1229.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1229.1.text#δίκαια πράξας· οὗ θέλω δάμαρθ' ἑλὼν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1230.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1230.1.text#κτεῖναι· σὺ δ' ἡμῖν τοῦδε συλλήπτωρ γενοῦ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1231.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1231.1.text#ὦ πάτερ, ἱκοῦ δῆτ', εἰ κλύεις ἔσω χθονὸς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1232.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1232.1.text#τέκνων καλούντων, οἳ σέθεν θνῄσκουσ' ὕπερ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1233.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1233.1.text#ὦ συγγένεια πατρὸς ἐμοῦ, κἀμὰς λιτάς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1234.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1234.1.text#Ἀγάμεμνον, εἰσάκουσον· ἔκσῳσον τέκνα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1235.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1235.1.text#ἔκτεινα μητέρα —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1235.2.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1235.2.text#ἡψάμην δ' ἐγὼ ξίφους —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1236.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1236.1.text#ἐγὼ δ' { ἐπεβούλευσα } κἀπέλυσ' ὄκνου —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1237.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1237.1.text#σοί, πάτερ, ἀρήγων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1237.2.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1237.2.text#οὐδ' ἐγὼ προύδωκά σε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1238.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1238.1.text#οὔκουν ὀνείδη τάδε κλύων ῥύσῃ τέκνα;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1239.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1239.1.text#δακρύοις κατασπένδω σε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1239.2.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1239.2.text#ἐγὼ δ' οἴκτοισί γε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1240.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1240.1.text#παύσασθε, καὶ πρὸς ἔργον ἐξορμώμεθα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1241.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1241.1.text#εἴπερ γὰρ εἴσω γῆς ἀκοντίζουσ' ἀραί,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1242.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1242.1.text#κλύει. σὺ δ', ὦ Ζεῦ πρόγονε καὶ Δίκης σέβας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1243.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1243.1.text#δότ' εὐτυχῆσαι τῷδ' ἐμοί τε τῇδέ τε·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1244.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1244.1.text#τρισσοῖς φίλοις γὰρ εἷς ἀγών, δίκη μία,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1245.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1245.1.text#ἢ ζῆν ἅπασιν ἢ — θανεῖν ὀφείλεται.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1246.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1246.1.text#Μυκηνίδες ὦ φίλαι,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1247.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1247.1.text#τὰ πρῶτα κατὰ Πελασγὸν ἕδος Ἀργείων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1248.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1248.1.text#τίνα θροεῖς αὐδάν, πότνια; παραμένει
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1250.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1250.1.text#γὰρ ἔτι σοι τόδ' ἐν Δαναϊδῶν πόλει.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1251.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1251.1.text#στῆθ' αἳ μὲν ὑμῶν τόνδ' ἁμαξήρη τρίβον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1252.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1252.1.text#αἳ δ' ἐνθάδ' ἄλλον οἶμον ἐς φρουρὰν δόμων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1253.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1253.1.text#τί δέ με τόδε χρέος ἀπύεις;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1254.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1254.1.text#ἔνεπέ μοι, φίλα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1255.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1255.1.text#φόβος ἔχει με μή τις ἐπὶ δώμασι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1256.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1256.1.text#σταθεὶς ἐπὶ φοίνιον αἷμα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1257.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1257.1.text#πήματα πήμασιν ἐξεύρῃ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1258.1.speaker#Ἡμίχορος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1258.1.text#χωρεῖτ', ἐπειγώμεσθ'· ἐγὼ μὲν οὖν τρίβον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1259.1.speaker#Ἡμίχορος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1259.1.text#τόνδ' ἐκφυλάξω, τὸν πρὸς ἡλίου βολάς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1260.1.speaker#Ἡμίχορος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1260.1.text#καὶ μὴν ἐγὼ τόνδ', ὃς πρὸς ἑσπέραν φέρει.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1261.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1261.1.text#δόχμιά νυν κόρας διάφερ' ὀμμάτων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1262.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1262.1.text#ἐκεῖθεν ἐνθάδ', εἶτα παλινσκοπιὰν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1265.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1265.1.text#ἔχομεν, ὡς θροεῖς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1266.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1266.1.text#ἑλίσσετέ νυν βλέφαρα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1267.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1267.1.text#κόραισι δίδοτε πάντα διὰ βοστρύχων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1268.1.speaker#Ἡμίχορος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1268.1.text#ὅδε τις ἐν τρίβῳ [ προσέρχεται ]. τίς ὅδ' ἄρ' ἀμφὶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1270.1.speaker#Ἡμίχορος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1270.1.text#μέλαθρον πολεῖ σὸν ἀγρότας ἀνήρ;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1271.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1271.1.text#ἀπωλόμεσθ' ἄρ', ὦ φίλαι· κεκρυμμένους
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1272.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1272.1.text#θῆρας ξιφήρεις αὐτίκ' ἐχθροῖσιν φανεῖ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1273.1.speaker#Ἡμίχορος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1273.1.text#ἄφοβος ἔχε· κενός, ὦ φίλα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1274.1.speaker#Ἡμίχορος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1274.1.text#στίβος ὃν οὐ δοκεῖς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1275.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1275.1.text#τί δέ; τὸ σὸν βέβαιον ἔτι μοι μένει;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1276.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1276.1.text#δὸς ἀγγελίαν ἀγαθάν τιν',
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1277.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1277.1.text#εἰ τάδ' ἔρημα τὰ πρόσθ' αὐλᾶς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1278.1.speaker#Ἡμίχορος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1278.1.text#καλῶς τά γ' ἐνθένδ'. ἀλλὰ τἀπὶ σοῦ σκόπει·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1279.1.speaker#Ἡμίχορος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1279.1.text#ὡς οὔτις ἡμῖν Δαναϊδῶν πελάζεται.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1280.1.speaker#Ἡμίχορος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1280.1.text#ἐς ταὐτὸν ἥκεις· καὶ γὰρ οὐδὲ τῇδ' ὄχλος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1281.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1281.1.text#φέρε νυν ἐν πύλαισιν ἀκοὰν βάλω.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1284.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1284.1.text#τί μέλλεθ' οἱ κατ' οἶκον ἐν ἡσυχίᾳ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1285.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1285.1.text#σφάγια φοινίσσειν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1286.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1286.1.text#οὐκ εἰσακούουσ'· ὦ τάλαιν' ἐγὼ κακῶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1287.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1287.1.text#ἆρ' ἐς τὸ κάλλος ἐκκεκώφηται ξίφη;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1288.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1288.1.text#τάχα τις Ἀργείων ἔνοπλος ὁρμήσας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1290.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1290.1.text#ποδὶ βοηδρόμῳ μέλαθρα προσμείξει.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1291.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1291.1.text#σκέψασθέ νυν ἄμεινον· οὐχ ἕδρας ἀγών·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1292.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1292.1.text#ἀλλ' αἳ μὲν ἐνθάδ', αἳ δ' ἐκεῖσ' ἑλίσσετε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1295.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1295.1.text#ἀμείβω κέλευθον σκοποῦσα πάντῃ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1296.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1296.1.text#ἰὼ Πελασγὸν Ἄργος, ὄλλυμαι κακῶς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1297.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1297.1.text#— ἠκούσαθ'; ἅνδρες χεῖρ' ἔχουσιν ἐν φόνῳ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1298.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1298.1.text#— Ἑλένης τὸ κώκυμ' ἐστίν, ὡς ἀπεικάσαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1299.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1299.1.text#ὦ Διός, ὦ Διὸς ἀέναον κράτος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1300.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1300.1.text#ἔλθ' ἐπίκουρος ἐμοῖς φίλοισι πάντως.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1301.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1301.1.text#Μενέλαε, θνῄσκω· σὺ δὲ παρών μ' οὐκ ὠφελεῖς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1302.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1302.1.text#φονεύετε, καίνετε,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1303.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1303.1.text#ὄλλυτε, δίπτυχα δίστομα φάσγανα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1304.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1304.1.text#ἐκ χερὸς ἱέμενοι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1305.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1305.1.text#τὰν λιποπάτορα λιπόγαμον, ἃ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1306.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1306.1.text#πλείστους ἔκανεν Ἑλλάνων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1307.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1307.1.text#δορὶ παρὰ ποταμὸν ὀλομένους,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1308.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1308.1.text#ὅθι δάκρυα δάκρυσιν ἔπεσεν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1309.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1309.1.text#σιδαρέοισι βέλεσιν ἀμφὶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1310.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1310.1.text#τὰς Σκαμάνδρου δίνας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1311.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1311.1.text#σιγᾶτε σιγᾶτ'· ᾐσθόμην κτύπου τινὸς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1312.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1312.1.text#κέλευθον ἐσπεσόντος ἀμφὶ δώματα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1313.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1313.1.text#ὦ φίλταται γυναῖκες, ἐς μέσον φόνον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1314.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1314.1.text#ἥδ' Ἑρμιόνη πάρεστι· παύσωμεν βοήν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1315.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1315.1.text#στείχει γὰρ ἐσπεσοῦσα δικτύων βρόχους.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1316.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1316.1.text#καλὸν τὸ θήραμ', ἢν ἁλῷ, γενήσεται.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1317.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1317.1.text#πάλιν κατάστηθ' ἡσύχῳ μὲν ὄμματι,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1318.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1318.1.text#χρόᾳ δ' ἀδήλῳ τῶν δεδραμένων πέρι·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1319.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1319.1.text#κἀγὼ σκυθρωποὺς ὀμμάτων ἕξω κόρας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1320.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1320.1.text#ὡς δῆθεν οὐκ εἰδυῖα τἀξειργασμένα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1321.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1321.1.text#ὦ παρθέν', ἥκεις τὸν Κλυταιμήστρας τάφον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1322.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1322.1.text#στέψασα καὶ σπείσασα νερτέροις χοάς;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1323.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1323.1.text#ἥκω, λαβοῦσα πρευμένειαν. ἀλλά μοι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1324.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1324.1.text#φόβος τις εἰσελήλυθ', ἥντιν' ἐν δόμοις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1325.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1325.1.text#τηλουρὸς οὖσα δωμάτων κλύω βοήν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1326.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1326.1.text#τί δ'; ἄξι' ἡμῖν τυγχάνει στεναγμάτων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1327.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1327.1.text#εὔφημος ἴσθι· τί δὲ νεώτερον λέγεις;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1328.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1328.1.text#θανεῖν Ὀρέστην κἄμ' ἔδοξε τῇδε γῇ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1329.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1329.1.text#μὴ δῆτ', ἐμοῦ γε συγγενεῖς πεφυκότας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1330.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1330.1.text#ἄραρ'· ἀνάγκης δ' ἐς ζυγὸν καθέσταμεν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1331.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1331.1.text#ἦ τοῦδ' ἕκατι καὶ βοὴ κατὰ στέγας;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1332.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1332.1.text#ἱκέτης γὰρ Ἑλένης γόνασι προσπεσὼν βοᾷ —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1333.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1333.1.text#τίς; οὐδὲν οἶδα μᾶλλον, ἢν σὺ μὴ λέγῃς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1334.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1334.1.text#τλήμων Ὀρέστης· μὴ θανεῖν, ἐμοῦ θ' ὕπερ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1335.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1335.1.text#ἐπ' ἀξίοισί τἄρ' ἀνευφημεῖ δόμος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1336.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1336.1.text#περὶ τοῦ γὰρ ἄλλου μᾶλλον ἂν φθέγξαιτό τις;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1337.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1337.1.text#ἀλλ' ἐλθὲ καὶ μετάσχες ἱκεσίας φίλοις,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1338.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1338.1.text#σῇ μητρὶ προσπεσοῦσα τῇ μέγ' ὀλβίᾳ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1339.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1339.1.text#Μενέλαον ἡμᾶς μὴ θανόντας εἰσιδεῖν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1340.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1340.1.text#ἀλλ', ὦ τραφεῖσα μητρὸς ἐν χεροῖν ἐμῆς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1341.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1341.1.text#οἴκτιρον ἡμᾶς κἀπικούφισον κακῶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1342.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1342.1.text#ἴθ' εἰς ἀγῶνα δεῦρ', ἐγὼ δ' ἡγήσομαι·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1343.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1343.1.text#σωτηρίας γὰρ τέρμ' ἔχεις ἡμῖν μόνη.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1344.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1344.1.text#ἰδού, διώκω τὸν ἐμὸν ἐς δόμους πόδα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1345.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1345.1.text#σώθηθ' ὅσον γε τοὐπ' ἐμέ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1345.2.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1345.2.text#ὦ κατὰ στέγας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1346.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1346.1.text#φίλοι ξιφήρεις, οὐχὶ συλλήψεσθ' ἄγραν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1347.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1347.1.text#οἲ ἐγώ· τίνας τούσδ' εἰσορῶ;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1347.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1347.2.text#σιγᾶν χρεών·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1348.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1348.1.text#ἡμῖν γὰρ ἥκεις, οὐχὶ σοί, σωτηρία.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1349.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1349.1.text#ἔχεσθ' ἔχεσθε· φάσγανον δὲ πρὸς δέρῃ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1350.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1350.1.text#βάλλοντες ἡσυχάζεθ', ὡς εἰδῇ τόδε
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1351.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1351.1.text#Μενέλαος, οὕνεκ' ἄνδρας, οὐ Φρύγας κακούς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1352.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1352.1.text#εὑρὼν ἔπραξεν οἷα χρὴ πράσσειν κακούς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1353.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1353.1.text#— ἰὼ ἰὼ φίλαι,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1353.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1353.2.text#κτύπον ἐγείρετε, κτύπον καὶ βοὰν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1354.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1354.1.text#πρὸ μελάθρων, ὅπως ὁ πραχθεὶς φόνος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1355.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1355.1.text#μὴ δεινὸν Ἀργείοισιν ἐμβάλῃ φόβον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1356.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1356.1.text#βοηδρομῆσαι πρὸς δόμους τυραννικούς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1357.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1357.1.text#πρὶν ἐτύμως ἴδω τὸν Ἑλένας φόνον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1358.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1358.1.text#καθαιμακτὸν ἐν δόμοις κείμενον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1359.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1359.1.text#ἢ καὶ λόγον του προσπόλων πυθώμεθα·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1360.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1360.1.text#τὰ μὲν γὰρ οἶδα συμφορᾶς, τὰ δ' οὐ σαφῶς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1361.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1361.1.text#— διὰ δίκας ἔβα θεῶν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1362.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1362.1.text#νέμεσις ἐς Ἑλέναν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1363.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1363.1.text#δακρύοισι γὰρ Ἑλλάδ' ἅπασαν ἔπλησε,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1364.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1364.1.text#διὰ τὸν ὀλόμενον ὀλόμενον Ἰδαῖον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1365.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1365.1.text#Πάριν, ὃς ἄγαγ' Ἑλλάδ' εἰς Ἴλιον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1366.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1366.1.text#[ ἀλλὰ κτυπεῖ γὰρ κλῇθρα βασιλείων δόμων, ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1367.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1367.1.text#[ σιγήσατ'· ἔξω γάρ τις ἐκβαίνει Φρυγῶν, ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1368.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1368.1.text#[ οὗ πευσόμεσθα τἀν δόμοις ὅπως ἔχει. ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1369.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1369.1.text#Ἀργέϊον ξίφος ἐκ θανάτου πέφευγα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1370.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1370.1.text#βαρβάροις ἐν εὐμάρισιν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1371.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1371.1.text#κεδρωτὰ παστάδων ὑπὲρ τέραμνα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1372.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1372.1.text#Δωρικάς τε τριγλύφους,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1373.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1373.1.text#φροῦδα φροῦδα, γᾶ γᾶ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1374.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1374.1.text#βαρβάροισι δρασμοῖς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1375.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1375.1.text#αἰαῖ·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1376.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1376.1.text#πᾷ φύγω, ξέναι, πολιὸν αἰθέρ' ἀμπτάμενος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1377.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1377.1.text#ἢ πόντον, Ὠκεανὸς ὃν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1378.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1378.1.text#ταυρόκρανος ἀγκάλαις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1379.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1379.1.text#ἑλίσσων κυκλοῖ χθόνα;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1380.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1380.1.text#τί δ' ἔστιν, Ἑλένης πρόσπολ'. Ἰδαῖον κάρα;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1381.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1381.1.text#Ἴλιον Ἴλιον, ὤμοι μοι,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1382.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1382.1.text#Φρύγιον ἄστυ καὶ καλλίβωλον Ἴδας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1383.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1383.1.text#ὄρος ἱερόν, ὥς σ' ὀλόμενον στένω
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1384.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1384.1.text#[ ἁρμάτειον ἁρμάτειον μέλος ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1385.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1385.1.text#βαρβάρῳ βοᾷ δι' ὀρνιθόγονον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1386.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1386.1.text#ὄμμα κυκνοπτέρου καλλοσύνας, Λήδας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1387.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1387.1.text#σκύμνου, δυσελένας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1388.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1388.1.text#δυσελένας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1389.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1389.1.text#ξεστῶν περγάμων Ἀπολλωνίων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1389.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1389.2.text#ἐρινύν· ὀττοτοῖ·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1390.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1390.1.text#ἰαλέμων ἰαλέμων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1391.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1391.1.text#Δαρδανία τλᾶμον Γανυμήδεος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1392.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1392.1.text#ἱπποσύνᾳ, Διὸς εὐνέτα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1393.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1393.1.text#σαφῶς λέγ' ἡμῖν αὔθ' ἕκαστα τἀν δόμοις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1394.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1394.1.text#[ τὰ γὰρ πρὶν οὐκ εὔγνωστα συμβαλοῦσ' ἔχω. ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1395.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1395.1.text#αἴλινον αἴλινον ἀρχὰν θανάτου
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1396.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1396.1.text#βάρβαροι λέγουσιν, αἰαῖ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1397.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1397.1.text#Ἀσιάδι φωνᾷ, βασιλέων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1398.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1398.1.text#ὅταν αἷμα χυθῇ κατὰ γᾶν ξίφεσιν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1399.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1399.1.text#σιδαρέοισιν Ἅιδα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1400.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1400.1.text#ἦλθον ἐς δόμους, ἵν' αὔθ' ἕκαστά
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1400.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1400.2.text#σοι λέγω, λέοντες
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1401.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1401.1.text#Ἕλλανες δύο διδύμω·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1402.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1402.1.text#τῷ μὲν ὁ στρατηλάτας πατὴρ ἐκλῄζεθ',
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1403.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1403.1.text#ὃ δὲ παῖς Στροφίου, κακόμητις ἀνήρ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1404.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1404.1.text#οἷος Ὀδυσσεύς, σιγᾷ δόλιος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1405.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1405.1.text#πιστὸς δὲ φίλοις, θρασὺς εἰς ἀλκάν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1406.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1406.1.text#ξυνετὸς πολέμου, φόνιός τε δράκων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1407.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1407.1.text#ἔρροι τᾶς ἡσύχου
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1408.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1408.1.text#προνοίας κακοῦργος ὤν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1409.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1409.1.text#οἳ δὲ πρὸς θρόνους ἔσω
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1409.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1409.2.text#μολόντες ἇς ἔγημ' ὁ τοξότας Πάρις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1410.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1410.1.text#γυναικός, ὄμμα δακρύοις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1411.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1411.1.text#πεφυρμένοι, ταπεινοὶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1412.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1412.1.text#ἕζονθ', ὃ μὲν τὸ κεῖθεν, ὃ δὲ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1413.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1413.1.text#τὸ κεῖθεν, ἄλλος ἄλλοθεν πεφραγμένοι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1414.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1414.1.text#περὶ δὲ γόνυ χέρας ἱκεσίους ἔβαλον ἔβαλον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1415.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1415.1.text#Ἑλένας ἄμφω.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1416.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1416.1.text#ἀνὰ δὲ δρομάδες ἔθορον ἔθορον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1417.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1417.1.text#ἀμφίπολοι Φρύγες·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1418.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1418.1.text#προσεῖπε δ' ἄλλος ἄλλον ἐν φόβῳ πεσών,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1419.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1419.1.text#μή τις εἴη δόλος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1420.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1420.1.text#κἀδόκει τοῖς μὲν οὔ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1421.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1421.1.text#τοῖς δ' ἐς ἀρκυστάταν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1422.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1422.1.text#μηχανὰν ἐμπλέκειν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1423.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1423.1.text#παῖδα τὰν Τυνδαρίδ' ὁ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1424.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1424.1.text#μητροφόντας δράκων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1425.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1425.1.text#σὺ δ' ἦσθα ποῦ τότ'; ἢ πάλαι φεύγεις φόβῳ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1426.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1426.1.text#Φρυγίοις ἔτυχον Φρυγίοισι νόμοις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1427.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1427.1.text#παρὰ βόστρυχον αὔραν αὔραν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1428.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1428.1.text#Ἑλένας Ἑλένας εὐπαγεῖ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1429.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1429.1.text#κύκλῳ πτερίνῳ πρὸ παρηίδος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1430.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1430.1.text#ἀίσσων βαρβάροις νόμοισιν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1431.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1431.1.text#ἃ δὲ λίνον ἠλακάτᾳ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1432.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1432.1.text#δακτύλοις ἕλισσεν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1433.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1433.1.text#νῆμα δ' ἵετο πέδῳ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1434.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1434.1.text#σκύλων Φρυγίων ἐπὶ τύμβον ἀγάλματα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1435.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1435.1.text#συστολίσαι χρῄζουσα λίνῳ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1436.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1436.1.text#φάρεα πορφύρεα, δῶρα Κλυταιμήστρᾳ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1437.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1437.1.text#προσεῖπεν δ' Ὀρέστας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1438.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1438.1.text#Λάκαιναν κόραν· ὦ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1439.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1439.1.text#Διὸς παῖ, θὲς ἴχνος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1440.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1440.1.text#πέδῳ δεῦρ' ἀποστᾶσα κλισμοῦ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1441.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1441.1.text#Πέλοπος ἐπὶ προπάτορος ἕδραν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1442.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1442.1.text#παλαιᾶς ἑστίας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1443.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1443.1.text#ἵν' εἰδῇς λόγους ἐμούς. —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1444.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1444.1.text#ἄγει δ' ἄγει νιν· ἃ δ' ἐφείπετ',
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1445.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1445.1.text#οὐ πρόμαντις ὧν ἔμελλεν·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1446.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1446.1.text#ὁ δὲ συνεργὸς ἄλλ' ἔπρασσ'
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1446.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1446.2.text#ἰὼν κακὸς Φωκεύς·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1447.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1447.1.text#οὐκ ἐκποδὼν ἴτ'; ἀλλ' ἀεὶ κακοὶ Φρύγες.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1448.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1448.1.text#ἔκλῃσε δ' ἄλλον ἄλλοσ' ἐν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1449.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1449.1.text#στέγαισι· τοὺς μὲν ἐν σταθμοῖσιν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1449.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1449.2.text#ἱππικοῖσι, τοὺς δ' ἐν ἐξέδραισι,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1450.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1450.1.text#τοὺς δ' ἐκεῖσ' ἐκεῖθεν [ ἄλλον ἄλ- ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1451.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1451.1.text#[ λοσε ] διαρμόσας ἀποπρὸ δεσποίνας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1452.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1452.1.text#τί τοὐπὶ τῷδε συμφορᾶς ἐγίγνετο;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1453.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1453.1.text#Ἰδαία μᾶτερ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1454.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1454.1.text#μᾶτερ ὀβρίμα ὀβρίμα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1455.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1455.1.text#αἰαὶ φονίων παθέων ἀνόμων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1456.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1456.1.text#τε κακῶν ἅπερ ἔδρακον ἔδρακον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1456.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1456.2.text#ἐν δόμοις τυράννων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1457.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1457.1.text#ἀμφιπορφυρέων πέπλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1458.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1458.1.text#ὑπὸ σκότου ξίφη σπάσαντες
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1458.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1458.2.text#ἄλλος ἄλλοσ' ἐν χεροῖν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1459.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1459.1.text#δίνασεν ὄμμα, μή τις παρὼν τύχοι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1459.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1459.2.text#ὡς κάπροι δ' ὀρέστεροι γυναικὸς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1460.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1460.1.text#ἀντίοι σταθέντες
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1461.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1461.1.text#ἐννέπουσι· Κατθανῇ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1461.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1461.2.text#κατθανῇ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1462.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1462.1.text#κακός σ' ἀποκτείνει πόσις,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1463.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1463.1.text#κασιγνήτου προδοὺς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1464.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1464.1.text#ἐν Ἄργει θανεῖν γόνον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1465.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1465.1.text#ἃ δ' ἀνίαχεν ἴαχεν·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1465.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1465.2.text#Ὤμοι μοι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1466.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1466.1.text#λευκὸν δ' ἐμβαλοῦσα πῆχυν στέρνοις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1467.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1467.1.text#κτύπησε κρᾶτα μέλεον πλαγᾷ·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1468.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1468.1.text#φυγᾷ δὲ ποδὶ τὸ χρυσεοσάνδαλον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1469.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1469.1.text#ἴχνος ἔφερεν ἔφερεν· ἐς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1469.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1469.2.text#κόμας δὲ δακτύλους δικὼν Ὀρέστας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1470.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1470.1.text#Μυκηνίδ' ἀρβύλαν προβάς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1471.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1471.1.text#ὤμοις ἀριστεροῖσιν ἀνακλάσας δέρην,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1472.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1472.1.text#παίειν λαιμῶν ἔμελλεν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1472.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1472.2.text#εἴσω μέλαν ξίφος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1473.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1473.1.text#ποῦ δ' ἦτ' ἀμύνειν οἱ κατὰ στέγας Φρύγες;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1474.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1474.1.text#ἰαχᾷ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1474.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1474.2.text#δόμων θύρετρα καὶ σταθμοὺς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1474.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1474.2.text#μοχλοῖσιν ἐκβαλόντες, ἔνθ' ἐμίμνομεν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1475.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1475.1.text#βοηδρομοῦμεν ἄλλος ἄλλοθεν στέγης,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1476.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1476.1.text#ὃ μὲν πέτρους, ὃ δ' ἀγκύλας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1477.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1477.1.text#ὃ δὲ ξίφος πρόκωπον ἐν χεροῖν ἔχων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1478.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1478.1.text#ἔναντα δ' ἦλθε Πυλάδης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1479.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1479.1.text#ἀλίαστος, οἷος οἷος Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1480.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1480.1.text#ὁ Φρύγιος ἢ τρικόρυθος Αἴας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1481.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1481.1.text#ὃν εἶδον εἶδον ἐν πύλαις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1482.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1482.1.text#Πριαμίσι· φασγάνων δ' ἀκμὰς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1482.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1482.2.text#συνήψαμεν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1483.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1483.1.text#δὴ τότε διαπρεπεῖς τότ' ἐγένοντο Φρύγες,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1484.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1484.1.text#ὅσον Ἄρεως ἀλκὰν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1485.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1485.1.text#ἥσσονες Ἑλλάδος ἐγενόμεθ' αἰχμᾶς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1486.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1486.1.text#ὃ μὲν οἰχόμενος φυγάς, ὃ δὲ νέκυς ὤν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1487.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1487.1.text#ὃ δὲ τραῦμα φέρων, ὃ δὲ λισσόμενος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1488.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1488.1.text#θανάτου προβολάν·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1488.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1488.2.text#ὑπὸ σκότον δ' ἐφεύγομεν·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1489.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1489.1.text#νεκροὶ δ' ἔπιπτον, οἳ δ' ἔμελλον, οἳ δ' ἔκειντ'.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1490.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1490.1.text#ἔμολε δ' ἁ τάλαιν' Ἑρμιόνα δόμους
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1490.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1490.2.text#ἐπὶ φόνῳ χαμαιπετεῖ ματρός, ἅ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1491.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1491.1.text#νιν ἔτεκεν τλάμων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1491.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1491.2.text#ἄθυρσοι δ'
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1492.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1492.1.text#οἷά νιν δραμόντε Βάκχαι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1492.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1492.2.text#σκύμνον ἐν χεροῖν ὀρείαν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1493.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1493.1.text#ξυνήρπασαν· πάλιν δὲ τὰν Διὸς κόραν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1493.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1493.2.text#ἐπὶ σφαγὰν ἔτεινον· ἃ δ'
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1494.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1494.1.text#ἐκ θαλάμων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1495.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1495.1.text#ἐγένετο διαπρὸ δωμάτων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1496.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1496.1.text#ἄφαντος, ὦ Ζεῦ καὶ γᾶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1497.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1497.1.text#καὶ φῶς καὶ νύξ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1497.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1497.2.text#ἤτοι φαρμάκοισιν ἢ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1498.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1498.1.text#μάγων τέχναις ἢ θεῶν κλοπαῖς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1499.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1499.1.text#τὰ δ' ὕστερ' οὐκέτ' οἶδα· δραπέτην
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1499.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1499.2.text#γὰρ ἐξέκλεπτον ἐκ δόμων πόδα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1500.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1500.1.text#πολύπονα δὲ πολύπονα πάθεα
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1501.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1501.1.text#Μενέλεως ἀνασχόμενος ἀνόνητον ἀπὸ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1502.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1502.1.text#Τροίας ἔλαβε τὸν Ἑλένας γάμον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1503.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1503.1.text#καὶ μὴν ἀμείβει καινὸν ἐκ καινῶν τόδε·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1504.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1504.1.text#ξιφηφόρον γὰρ εἰσορῶ πρὸ δωμάτων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1505.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1505.1.text#βαίνοντ' Ὀρέστην ἐπτοημένῳ ποδί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1506.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1506.1.text#ποῦ 'στιν οὗτος ὃς πέφευγεν ἐκ δόμων τοὐμὸν ξίφος;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1507.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1507.1.text#προσκυνῶ σ', ἄναξ, νόμοισι βαρβάροισι προσπίτνων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1508.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1508.1.text#οὐκ ἐν Ἰλίῳ τάδ' ἐστίν, ἀλλ' ἐν Ἀργείᾳ χθονί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1509.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1509.1.text#πανταχοῦ ζῆν ἡδὺ μᾶλλον ἢ θανεῖν τοῖς σώφροσιν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1510.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1510.1.text#οὔτι που κραυγὴν ἔθηκας Μενέλεῳ βοηδρομεῖν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1511.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1511.1.text#σοὶ μὲν οὖν ἔγωγ' ἀμύνειν· ἀξιώτερος γὰρ εἶ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1512.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1512.1.text#ἐνδίκως ἡ Τυνδάρειος ἆρα παῖς διώλετο;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1513.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1513.1.text#ἐνδικώτατ', εἴ γε λαιμοὺς εἶχε τριπτύχους θανεῖν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1514.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1514.1.text#δειλίᾳ γλώσσῃ χαρίζῃ, τἄνδον οὐχ οὕτω φρονῶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1515.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1515.1.text#οὐ γάρ, ἥτις Ἑλλάδ' αὐτοῖς Φρυξὶ διελυμήνατο;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1516.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1516.1.text#ὄμοσον — εἰ δὲ μή, κτενῶ σε — μὴ λέγειν ἐμὴν χάριν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1517.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1517.1.text#τὴν ἐμὴν ψυχὴν κατώμοσ', ἣν ἂν εὐορκοῖμ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1518.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1518.1.text#ὧδε κἀν Τροίᾳ σίδηρος πᾶσι Φρυξὶν ἦν φόβος;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1519.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1519.1.text#ἄπεχε φάσγανον· πέλας γὰρ δεινὸν ἀνταυγεῖ φόνον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1520.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1520.1.text#μὴ πέτρος γένῃ δέδοικας ὥστε Γοργόν' εἰσιδών;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1521.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1521.1.text#μὴ μὲν οὖν νεκρός· τὸ Γοργοῦς δ' οὐ κάτοιδ' ἐγὼ κάρα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1522.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1522.1.text#δοῦλος ὢν φοβῇ τὸν Ἅιδην, ὅς σ' ἀπαλλάξει κακῶν;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1523.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1523.1.text#πᾶς ἀνήρ, κἂν δοῦλος ᾖ τις, ἥδεται τὸ φῶς ὁρῶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1524.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1524.1.text#εὖ λέγεις· σῴζει σε σύνεσις. ἀλλὰ βαῖν' ἔσω δόμων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1525.1.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1525.1.text#οὐκ ἄρα κτενεῖς με;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1525.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1525.2.text#ἀφεῖσαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1525.3.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1525.3.text#καλὸν ἔπος λέγεις τόδε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1526.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1526.1.text#ἀλλὰ μεταβουλευσόμεσθα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1526.2.speaker#Φρύξ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1526.2.text#τοῦτο δ' οὐ καλῶς λέγεις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1527.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1527.1.text#μῶρος, εἰ δοκεῖς με τλῆναι σὴν καθαιμάξαι δέρην·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1528.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1528.1.text#οὔτε γὰρ γυνὴ πέφυκας — οὔτ' ἐν ἀνδράσιν σύ γ' εἶ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1529.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1529.1.text#τοῦ δὲ μὴ στῆσαί σε κραυγὴν οὕνεκ' ἐξῆλθον δόμων·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1530.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1530.1.text#ὀξὺ γὰρ βοῆς ἀκοῦσαν Ἄργος ἐξεγείρεται.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1531.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1531.1.text#Μενέλεων δ' οὐ τάρβος ἡμῖν ἀναλαβεῖν ἔσω ξίφους·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1532.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1532.1.text#ἀλλ' ἴτω ξανθοῖς ἐπ' ὤμων βοστρύχοις γαυρούμενος·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1533.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1533.1.text#εἰ γὰρ Ἀργείους ἐπάξει τοῖσδε δώμασιν λαβών,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1534.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1534.1.text#τὸν Ἑλένης φόνον διώκων, κἀμὲ μὴ σῴζειν θέλει
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1535.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1535.1.text#σύγγονόν τ' ἐμὴν Πυλάδην τε τὸν τάδε ξυνδρῶντά μοι,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1536.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1536.1.text#παρθένον τε καὶ δάμαρτα δύο νεκρὼ κατόψεται.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1537.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1537.1.text#— ἰὼ ἰὼ τύχα,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1537.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1537.2.text#ἕτερον εἰς ἀγῶν', ἕτερον αὖ δόμος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1538.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1538.1.text#φοβερὸν ἀμφὶ τοὺς Ἀτρείδας πίτνει.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1539.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1539.1.text#— τί δρῶμεν; ἀγγέλλωμεν ἐς πόλιν τάδε;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1540.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1540.1.text#ἢ σῖγ' ἔχωμεν; ἀσφαλέστερον, φίλαι.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1541.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1541.1.text#— ἴδε πρὸ δωμάτων ἴδε προκηρύσσει
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1542.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1542.1.text#θοάζων ὅδ' αἰθέρος ἄνω καπνός.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1543.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1543.1.text#— ἅπτουσι πεύκας, ὡς πυρώσοντες δόμους
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1544.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1544.1.text#τοὺς Τανταλείους, οὐδ' ἀφίστανται φόνου.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1545.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1545.1.text#— τέλος ἔχει δαίμων βροτοῖς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1545.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1545.2.text#τέλος ὅπᾳ θέλῃ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1546.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1546.1.text#— μεγάλα δέ τις ἁ δύναμις { δι' ἀλαστόρων }
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1547.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1547.1.text#{ ἔπεσ' ἔπεσε μέλαθρα τάδε δι' αἱμάτων }
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1548.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1548.1.text#διὰ τὸ Μυρτίλου πέσημ' ἐκ δίφρου.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1549.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1549.1.text#ἀλλὰ μὴν καὶ τόνδε λεύσσω Μενέλεων δόμων πέλας
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1550.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1550.1.text#ὀξύπουν, ᾐσθημένον που τὴν τύχην ἣ νῦν πάρα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1551.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1551.1.text#οὐκέτ' ἂν φθάνοιτε κλῇθρα συμπεραίνοντες μοχλοῖς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1552.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1552.1.text#ὦ κατὰ στέγας Ἀτρεῖδαι. δεινὸν εὐτυχῶν ἀνὴρ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1553.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1553.1.text#πρὸς κακῶς πράσσοντας, ὡς σὺ νῦν, Ὀρέστα, δυστυχεῖς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1554.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1554.1.text#ἥκω κλύων τὰ δεινὰ καὶ δραστήρια
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1555.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1555.1.text#δισσοῖν λεόντοιν· οὐ γὰρ ἄνδρ' αὐτὼ καλῶ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1556.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1556.1.text#ἤκουσα γὰρ δὴ τὴν ἐμὴν ξυνάορον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1557.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1557.1.text#ὡς οὐ τέθνηκεν, ἀλλ' ἄφαντος οἴχεται —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1558.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1558.1.text#κενὴν ἀκούσας βάξιν, ἣν φόβῳ σφαλεὶς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1559.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1559.1.text#ἤγγειλέ μοί τις. ἀλλὰ τοῦ μητροκτόνου
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1560.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1560.1.text#τεχνάσματ' ἐστὶ ταῦτα καὶ πολὺς γέλως.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1561.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1561.1.text#ἀνοιγέτω τις δῶμα· προσπόλοις λέγω
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1562.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1562.1.text#ὠθεῖν πύλας τάσδ', ὡς ἂν ἀλλὰ παῖδ' ἐμὴν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1563.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1563.1.text#ῥυσώμεθ' ἀνδρῶν ἐκ χερῶν μιαιφόνων,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1564.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1564.1.text#καὶ τὴν τάλαιναν ἀθλίαν δάμαρτ' ἐμὴν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1565.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1565.1.text#λάβωμεν, ᾗ δεῖ ξυνθανεῖν ἐμῇ χερὶ
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1566.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1566.1.text#τοὺς διολέσαντας τὴν ἐμὴν ξυνάορον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1567.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1567.1.text#οὗτος σύ, κλῄθρων τῶνδε μὴ ψαύσῃς χερί·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1568.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1568.1.text#Μενέλαον εἶπον, ὃς πεπύργωσαι θράσει·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1569.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1569.1.text#ἢ τῷδε θριγκῷ κρᾶτα συνθραύσω σέθεν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1570.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1570.1.text#ῥήξας παλαιὰ γεῖσα, τεκτόνων πόνον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1571.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1571.1.text#μοχλοῖς δ' ἄραρε κλῇθρα, σῆς βοηδρόμου
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1572.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1572.1.text#σπουδῆς ἅ σ' εἴρξει, μὴ δόμων ἔσω περᾶν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1573.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1573.1.text#ἔα, τί χρῆμα; λαμπάδων ὁρῶ σέλας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1574.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1574.1.text#δόμων δ' ἐπ' ἄκρων τούσδε πυργηρουμένους,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1575.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1575.1.text#ξίφος δ' ἐμῆς θυγατρὸς ἐπίφρουρον δέρῃ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1576.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1576.1.text#πότερον ἐρωτᾶν ἢ κλύειν ἐμοῦ θέλεις;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1577.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1577.1.text#οὐδέτερ'· ἀνάγκη δ', ὡς ἔοικε, σου κλύειν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1578.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1578.1.text#μέλλω κτενεῖν σου θυγατέρ', εἰ βούλῃ μαθεῖν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1579.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1579.1.text#Ἑλένην φονεύσας ἐπὶ φόνῳ πράσσεις φόνον;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1580.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1580.1.text#εἰ γὰρ κατέσχον μὴ θεῶν κλεφθεὶς ὕπο.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1581.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1581.1.text#ἀρνῇ κατακτὰς κἀφ' ὕβρει λέγεις τάδε;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1582.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1582.1.text#λυπράν γε τὴν ἄρνησιν· εἰ γὰρ ὤφελον —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1583.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1583.1.text#τί χρῆμα δρᾶσαι; παρακαλεῖς γὰρ ἐς φόβον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1584.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1584.1.text#τὴν Ἑλλάδος μιάστορ' εἰς Ἅιδου βαλεῖν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1585.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1585.1.text#ἀπόδος δάμαρτος νέκυν, ὅπως χώσω τάφῳ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1586.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1586.1.text#θεοὺς ἀπαίτει. παῖδα δὲ κτενῶ σέθεν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1587.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1587.1.text#ὁ μητροφόντης ἐπὶ φόνῳ πράσσει φόνον;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1588.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1588.1.text#ὁ πατρὸς ἀμύντωρ, ὃν σὺ προύδωκας θανεῖν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1589.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1589.1.text#οὐκ ἤρκεσέν σοι τὸ παρὸν αἷμα μητέρος;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1590.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1590.1.text#οὐκ ἂν κάμοιμι τὰς κακὰς κτείνων ἀεί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1591.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1591.1.text#ἦ καὶ σύ, Πυλάδη, τοῦδε κοινωνεῖς φόνου;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1592.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1592.1.text#φησὶν σιωπῶν· ἀρκέσω δ' ἐγὼ λέγων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1593.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1593.1.text#ἀλλ' οὔτι χαίρων, ἤν γε μὴ φύγῃς πτεροῖς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1594.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1594.1.text#οὐ φευξόμεσθα· πυρὶ δ' ἀνάψομεν δόμους.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1595.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1595.1.text#ἦ γὰρ πατρῷον δῶμα πορθήσεις τόδε;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1596.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1596.1.text#ὡς μή γ' ἔχῃς σύ, τήνδ' ἐπισφάξας πυρί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1597.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1597.1.text#κτεῖν'· ὡς κτανών γε τῶνδέ μοι δώσεις δίκην.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1598.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1598.1.text#ἔσται τάδε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1598.2.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1598.2.text#ἆ ἆ, μηδαμῶς δράσῃς τάδε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1599.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1599.1.text#σίγα νυν, ἀνέχου δ' ἐνδίκως πράσσων κακῶς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1600.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1600.1.text#ἦ γὰρ δίκαιον ζῆν σε;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1600.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1600.2.text#καὶ κρατεῖν γε γῆς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1601.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1601.1.text#ποίας;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1601.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1601.2.text#ἐν Ἄργει τῷδε τῷ Πελασγικῷ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1602.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1602.1.text#εὖ γοῦν θίγοις ἂν χερνίβων —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1602.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1602.2.text#τί δὴ γὰρ οὔ;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1603.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1603.1.text#καὶ σφάγια πρὸ δορὸς καταβάλοις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1603.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1603.2.text#σὺ δ' ἂν καλῶς;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1604.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1604.1.text#ἁγνὸς γάρ εἰμι χεῖρας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1604.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1604.2.text#ἀλλ' οὐ τὰς φρένας.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1605.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1605.1.text#τίς δ' ἂν προσείποι σέ;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1605.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1605.2.text#ὅστις ἐστὶ φιλοπάτωρ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1606.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1606.1.text#ὅστις δὲ τιμᾷ μητέρα;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1606.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1606.2.text#εὐδαίμων ἔφυ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1607.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1607.1.text#οὔκουν σύ γε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1607.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1607.2.text#οὐ γὰρ ἁνδάνουσιν αἱ κακαί.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1608.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1608.1.text#ἄπαιρε θυγατρὸς φάσγανον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1608.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1608.2.text#ψευδὴς ἔφυς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1609.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1609.1.text#ἀλλὰ κτενεῖς μου θυγατέρα;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1609.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1609.2.text#οὐ ψευδὴς ἔτ' εἶ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1610.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1610.1.text#οἴμοι, τί δράσω;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1610.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1610.2.text#πεῖθ' ἐς Ἀργείους μολὼν —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1611.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1611.1.text#πειθὼ τίνα;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1611.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1611.2.text#ἡμᾶς μὴ θανεῖν· αἰτοῦ πόλιν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1612.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1612.1.text#ἢ παῖδά μου φονεύσετε;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1612.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1612.2.text#ὧδ' ἔχει τάδε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1613.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1613.1.text#ὦ τλῆμον Ἑλένη —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1613.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1613.2.text#τἀμὰ δ' οὐχὶ τλήμονα;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1614.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1614.1.text#σὲ σφάγιον ἐκόμισ' ἐκ Φρυγῶν —
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1614.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1614.2.text#εἰ γὰρ τόδ' ἦν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1615.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1615.1.text#πόνους πονήσας μυρίους.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1615.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1615.2.text#πλήν γ' εἰς ἐμέ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1616.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1616.1.text#πέπονθα δεινά.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1616.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1616.2.text#τότε γὰρ ἦσθ' ἀνωφελής.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1617.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1617.1.text#ἔχεις με.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1617.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1617.2.text#σαυτὸν σύ γ' ἔλαβες κακὸς γεγώς.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1618.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1618.1.text#ἀλλ' εἶ', ὕφαπτε δώματ', Ἠλέκτρα, τάδε·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1619.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1619.1.text#σύ τ', ὦ φίλων μοι τῶν ἐμῶν σαφέστατε,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1620.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1620.1.text#Πυλάδη, κάταιθε γεῖσα τειχέων τάδε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1621.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1621.1.text#ὦ γαῖα Δαναῶν ἱππίου τ' Ἄργους κτίται,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1622.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1622.1.text#οὐκ εἶ' ἐνόπλῳ ποδὶ βοηδρομήσετε;
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1623.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1623.1.text#πᾶσαν γὰρ ὑμῶν ὅδε βιάζεται πόλιν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1624.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1624.1.text#ζῆν, αἷμα μητρὸς μυσαρὸν ἐξειργασμένος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1625.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1625.1.text#Μενέλαε, παῦσαι λῆμ' ἔχων τεθηγμένον·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1626.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1626.1.text#Φοῖβός σ' ὁ Λητοῦς παῖς ὅδ' ἐγγὺς ὢν καλῶ·
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1627.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1627.1.text#σύ θ' ὃς ξιφήρης τῇδ' ἐφεδρεύεις κόρῃ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1628.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1628.1.text#Ὀρέσθ', ἵν' εἰδῇς οὓς φέρων ἥκω λόγους.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1629.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1629.1.text#Ἑλένην μὲν ἣν σὺ διολέσαι πρόθυμος ὢν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1630.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1630.1.text#ἥμαρτες, ὀργὴν Μενέλεῳ ποιούμενος,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1631.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1631.1.text#[ ἥδ' ἐστίν, ἣν ὁρᾶτ' ἐν αἰθέρος πτυχαῖς, ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1632.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1632.1.text#[ σεσῳσμένη τε κοὐ θανοῦσα πρὸς σέθεν. ]
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1633.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1633.1.text#ἐγώ νιν ἐξέσῳσα κἀπὸ φασγάνου
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1634.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1634.1.text#τοῦ σοῦ κελευσθεὶς ἥρπασ' ἐκ Διὸς πατρός.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1635.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1635.1.text#Ζηνὸς γὰρ οὖσαν ζῆν νιν ἄφθιτον χρεών,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1636.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1636.1.text#Κάστορί τε Πολυδεύκει τ' ἐν αἰθέρος πτυχαῖς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1637.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1637.1.text#σύνθακος ἔσται, ναυτίλοις σωτήριος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1638.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1638.1.text#ἄλλην δὲ νύμφην ἐς δόμους κτῆσαι λαβών,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1639.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1639.1.text#ἐπεὶ θεοὶ τῷ τῆσδε καλλιστεύματι
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1640.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1640.1.text#Ἕλληνας εἰς ἓν καὶ Φρύγας συνήγαγον,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1641.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1641.1.text#θανάτους τ' ἔθηκαν, ὡς ἀπαντλοῖεν χθονὸς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1642.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1642.1.text#ὕβρισμα θνητῶν ἀφθόνου πληρώματος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1643.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1643.1.text#τὰ μὲν καθ' Ἑλένην ὧδ' ἔχει· σὲ δ' αὖ χρεών,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1644.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1644.1.text#Ὀρέστα, γαίας τῆσδ' ὑπερβαλόνθ' ὅρους
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1645.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1645.1.text#Παρράσιον οἰκεῖν δάπεδον ἐνιαυτοῦ κύκλον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1646.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1646.1.text#κεκλήσεται δὲ σῆς φυγῆς ἐπώνυμον
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1647.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1647.1.text#Ἀζᾶσιν Ἀρκάσιν τ' Ὀρέστειον καλεῖν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1648.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1648.1.text#ἐνθένδε δ' ἐλθὼν τὴν Ἀθηναίων πόλιν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1649.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1649.1.text#δίκην ὑπόσχες αἵματος μητροκτόνου
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1650.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1650.1.text#Εὐμενίσι τρισσαῖς· θεοὶ δέ σοι δίκης βραβῆς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1651.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1651.1.text#πάγοισιν ἐν Ἀρείοισιν εὐσεβεστάτην
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1652.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1652.1.text#ψῆφον διοίσουσ', ἔνθα νικῆσαί σε χρή.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1653.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1653.1.text#ἐφ' ἧς δ' ἔχεις, Ὀρέστα, φάσγανον δέρῃ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1654.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1654.1.text#γῆμαι πέπρωταί σ' Ἑρμιόνην· ὃς δ' οἴεται
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1655.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1655.1.text#Νεοπτόλεμος γαμεῖν νιν, οὐ γαμεῖ ποτε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1656.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1656.1.text#θανεῖν γὰρ αὐτῷ μοῖρα Δελφικῷ ξίφει,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1657.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1657.1.text#δίκας Ἀχιλλέως πατρὸς ἐξαιτοῦντά με.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1658.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1658.1.text#Πυλάδῃ δ' ἀδελφῆς λέκτρον, ὥς ποτ' ᾔνεσας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1659.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1659.1.text#δός· ὁ δ' ἐπιών νιν βίοτος εὐδαίμων μένει.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1660.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1660.1.text#Ἄργους δ' Ὀρέστην, Μενέλεως, ἔα κρατεῖν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1661.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1661.1.text#ἐλθὼν δ' ἄνασσε Σπαρτιάτιδος χθονός,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1662.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1662.1.text#φερνὰς ἔχων δάμαρτος, ἥ σε μυρίοις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1663.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1663.1.text#πόνοις διδοῦσα δεῦρ' ἀεὶ διήνυσεν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1664.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1664.1.text#τὰ πρὸς πόλιν δὲ τῷδ' ἐγὼ θήσω καλῶς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1665.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1665.1.text#ὅς νιν φονεῦσαι μητέρ' ἐξηνάγκασα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1666.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1666.1.text#ὦ Λοξία μαντεῖε, σῶν θεσπισμάτων.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1667.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1667.1.text#οὐ ψευδόμαντις ἦσθ' ἄρ', ἀλλ' ἐτήτυμος.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1668.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1668.1.text#καίτοι μ' ἐσῄει δεῖμα, μή τινος κλύων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1669.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1669.1.text#ἀλαστόρων δόξαιμι σὴν κλύειν ὄπα.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1670.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1670.1.text#ἀλλ' εὖ τελεῖται, πείσομαι δὲ σοῖς λόγοις.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1671.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1671.1.text#ἰδού, μεθίημ' Ἑρμιόνην ἀπὸ σφαγῆς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1672.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1672.1.text#καὶ λέκτρ' ἐπῄνεσ', ἡνίκ' ἂν διδῷ πατήρ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1673.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1673.1.text#ὦ Ζηνὸς Ἑλένη χαῖρε παῖ· ζηλῶ δέ σε
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1674.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1674.1.text#θεῶν κατοικήσασαν ὄλβιον δόμον.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1675.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1675.1.text#Ὀρέστα, σοὶ δὲ παῖδ' ἐγὼ κατεγγυῶ,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1676.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1676.1.text#Φοίβου λέγοντος· εὐγενὴς δ' ἀπ' εὐγενοῦς
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1677.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1677.1.text#γήμας ὄναιο καὶ σὺ χὡ διδοὺς ἐγώ.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1678.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1678.1.text#χωρεῖτέ νυν ἕκαστος οἷ προστάσσομεν,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1679.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1679.1.text#νείκας τε διαλύεσθε.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1679.2.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1679.2.text#πείθεσθαι χρεών.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1680.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1680.1.text#κἀγὼ τοιοῦτος· σπένδομαι δὲ συμφοραῖς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1681.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1681.1.text#Μενέλαε, καὶ σοῖς, Λοξία, θεσπίσμασιν.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1682.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1682.1.text#ἴτε νυν καθ' ὁδόν, τὴν καλλίστην
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1683.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1683.1.text#θεῶν Εἰρήνην τιμῶντες· ἐγὼ δ'
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1684.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1684.1.text#Ἑλένην Δίοις μελάθροις πελάσω,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1685.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1685.1.text#λαμπρῶν ἄστρων πόλον ἐξανύσας,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1686.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1686.1.text#ἔνθα παρ' Ἥρᾳ τῇ θ' Ἡρακλέους
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1687.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1687.1.text#Ἥβῃ πάρεδρος θεὸς ἀνθρώποις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1688.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1688.1.text#ἔσται σπονδαῖς ἔντιμος ἀεί,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1689.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1689.1.text#σὺν Τυνδαρίδαις, τοῖς Διὸς υἱοῖς,
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1690.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1690.1.text#ναύταις μεδέουσα θαλάσσης.
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1691.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1691.1.text#ὦ μέγα σεμνὴ Νίκη, τὸν ἐμὸν
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1692.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1692.1.text#βίοτον κατέχοις
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1693.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg016.fu.sp:1693.1.text#καὶ μὴ λήγοις στεφανοῦσα.
