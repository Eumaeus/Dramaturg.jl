#!ctsdata
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1.1.text#Πάλαι ποτ' ἐστὶ τοῦτ' ἐμοὶ δεδογμένον·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:2.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:2.1.text#ὁ μὲν δίκαιος τοῖς πέλας πέφυκ' ἀνήρ,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:3.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:3.1.text#ὃ δ' ἐς τὸ κέρδος λῆμ' ἔχων ἀνειμένον
urn:cts:greekLit:tlg0006.tlg004.fu.sp:4.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:4.1.text#πόλει τ' ἄχρηστος καὶ συναλλάσσειν βαρύς,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:5.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:5.1.text#αὑτῷ δ' ἄριστος· οἶδα δ' οὐ λόγῳ μαθών.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:6.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:6.1.text#ἐγὼ γὰρ αἰδοῖ καὶ τὸ συγγενὲς σέβων,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:7.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:7.1.text#ἐξὸν κατ' Ἄργος ἡσύχως ναίειν, πόνων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:8.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:8.1.text#πλείστων μετέσχον εἷς ἀνὴρ Ἡρακλέει,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:9.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:9.1.text#ὅτ' ἦν μεθ' ἡμῶν· νῦν δ', ἐπεὶ κατ' οὐρανὸν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:10.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:10.1.text#ναίει, τὰ κείνου τέκν' ἔχων ὑπὸ πτεροῖς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:11.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:11.1.text#σῴζω τάδ' αὐτὸς δεόμενος σωτηρίας.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:12.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:12.1.text#ἐπεὶ γὰρ αὐτῶν γῆς ἀπηλλάχθη πατήρ,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:13.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:13.1.text#πρῶτον μὲν ἡμᾶς ἤθελ' Εὐρυσθεὺς κτανεῖν·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:14.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:14.1.text#ἀλλ' ἐξέδραμεν· καὶ πόλις μὲν οἴχεται,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:15.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:15.1.text#ψυχὴ δ' ἐσώθη. φεύγομεν δ' ἀλώμενοι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:16.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:16.1.text#ἄλλην ἀπ' ἄλλης ἐξορίζοντες πόλιν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:17.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:17.1.text#πρὸς τοῖς γὰρ ἄλλοις καὶ τόδ' Εὐρυσθεὺς κακοῖς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:18.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:18.1.text#ὕβρισμ' ἐς ἡμᾶς ἠξίωσεν ὑβρίσαι·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:19.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:19.1.text#πέμπων ὅπου γῆς πυνθάνοιθ' ἱδρυμένους
urn:cts:greekLit:tlg0006.tlg004.fu.sp:20.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:20.1.text#κήρυκας ἐξαιτεῖ τε κἀξείργει χθονός,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:21.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:21.1.text#πόλιν προτείνων Ἄργος οὐ σμικρὸν φίλην
urn:cts:greekLit:tlg0006.tlg004.fu.sp:22.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:22.1.text#ἐχθράν τε θέσθαι, χαὑτὸν εὐτυχοῦνθ' ἅμα.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:23.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:23.1.text#οἳ δ' ἀσθενῆ μὲν τἀπ' ἐμοῦ δεδορκότες,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:24.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:24.1.text#σμικροὺς δὲ τούσδε καὶ πατρὸς τητωμένους,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:25.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:25.1.text#τοὺς κρείσσονας σέβοντες ἐξείργουσι γῆς.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:26.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:26.1.text#ἐγὼ δὲ σὺν φεύγουσι συμφεύγω τέκνοις
urn:cts:greekLit:tlg0006.tlg004.fu.sp:27.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:27.1.text#καὶ σὺν κακῶς πράσσουσι συμπράσσω κακῶς,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:28.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:28.1.text#ὀκνῶν προδοῦναι, μή τις ὧδ' εἴπῃ βροτῶν·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:29.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:29.1.text#Ἴδεσθ', ἐπειδὴ παισὶν οὐκ ἔστιν πατήρ,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:30.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:30.1.text#Ἰόλαος οὐκ ἤμυνε συγγενὴς γεγώς.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:31.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:31.1.text#πάσης δὲ χώρας Ἑλλάδος τητώμενοι,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:32.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:32.1.text#Μαραθῶνα καὶ σύγκληρον ἐλθόντες χθόνα
urn:cts:greekLit:tlg0006.tlg004.fu.sp:33.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:33.1.text#ἱκέται καθεζόμεσθα βώμιοι θεῶν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:34.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:34.1.text#προσωφελῆσαι· πεδία γὰρ τῆσδε χθονὸς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:35.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:35.1.text#δισσοὺς κατοικεῖν Θησέως παῖδας λόγος,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:36.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:36.1.text#κλήρῳ λαχόντας ἐκ γένους Πανδίονος,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:37.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:37.1.text#τοῖσδ' ἐγγὺς ὄντας· ὧν ἕκατι τέρμονας
urn:cts:greekLit:tlg0006.tlg004.fu.sp:38.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:38.1.text#κλεινῶν Ἀθηνῶν τόνδ' ἀφικόμεσθ' ὅρον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:39.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:39.1.text#δυοῖν γερόντοιν δὲ στρατηγεῖται φυγή·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:40.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:40.1.text#ἐγὼ μὲν ἀμφὶ τοῖσδε καλχαίνων τέκνοις,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:41.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:41.1.text#ἣ δ' αὖ τὸ θῆλυ παιδὸς Ἀλκμήνη γένος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:42.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:42.1.text#ἔσωθε ναοῦ τοῦδ' ὑπηγκαλισμένη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:43.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:43.1.text#σῴζει· νέας γὰρ παρθένους αἰδούμεθα
urn:cts:greekLit:tlg0006.tlg004.fu.sp:44.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:44.1.text#ὄχλῳ πελάζειν κἀπιβωμιοστατεῖν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:45.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:45.1.text#Ὕλλος δ' ἀδελφοί θ' οἷσι πρεσβεύει γένος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:46.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:46.1.text#ζητοῦσ' ὅπου γῆς πύργον οἰκιούμεθα,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:47.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:47.1.text#ἢν τῆσδ' ἀπωθώμεσθα πρὸς βίαν χθονός.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:48.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:48.1.text#ὦ τέκνα τέκνα, δεῦρο, λαμβάνεσθ' ἐμῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:49.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:49.1.text#πέπλων· ὁρῶ κήρυκα τόνδ' Εὐρυσθέως
urn:cts:greekLit:tlg0006.tlg004.fu.sp:50.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:50.1.text#στείχοντ' ἐφ' ἡμᾶς, οὗ διωκόμεσθ' ὕπο
urn:cts:greekLit:tlg0006.tlg004.fu.sp:51.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:51.1.text#πάσης ἀλῆται γῆς ἀπεστερημένοι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:52.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:52.1.text#ὦ μῖσος, εἴθ' ὄλοιο χὡ πέμψας { σ' } ἀνήρ·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:53.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:53.1.text#ὡς πολλὰ δὴ καὶ τῶνδε γενναίῳ πατρὶ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:54.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:54.1.text#ἐκ τοῦδε ταὐτοῦ στόματος ἤγγειλας κακά.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:55.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:55.1.text#ἦ που καθῆσθαι τήνδ' ἕδραν καλὴν δοκεῖς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:56.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:56.1.text#πόλιν τ' ἀφῖχθαι σύμμαχον, κακῶς φρονῶν·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:57.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:57.1.text#οὐ γάρ τις ἔστιν ὃς πάροιθ' αἱρήσεται
urn:cts:greekLit:tlg0006.tlg004.fu.sp:58.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:58.1.text#τὴν σὴν ἀχρεῖον δύναμιν ἀντ' Εὐρυσθέως.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:59.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:59.1.text#χώρει· τί μοχθεῖς ταῦτ'; ἀνίστασθαί σε χρὴ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:60.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:60.1.text#ἐς Ἄργος, οὗ σε λεύσιμος μένει δίκη.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:61.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:61.1.text#οὐ δῆτ', ἐπεί μοι βωμὸς ἀρκέσει θεοῦ,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:62.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:62.1.text#ἐλευθέρα τε γαῖ' ἐν ᾗ βεβήκαμεν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:63.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:63.1.text#βούλῃ πόνον μοι τῇδε προσθεῖναι χερί;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:64.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:64.1.text#οὔτοι βίᾳ γέ μ' οὐδὲ τούσδ' ἄξεις λαβών.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:65.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:65.1.text#γνώσῃ σύ· μάντις δ' ἦσθ' ἄρ' οὐ καλὸς τάδε.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:66.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:66.1.text#οὐκ ἂν γένοιτο τοῦτ' ἐμοῦ ζῶντός ποτε.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:67.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:67.1.text#ἄπαιρ'· ἐγὼ δὲ τούσδε, κἂν σὺ μὴ θέλῃς,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:68.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:68.1.text#ἄξω νομίζων, οὗπέρ εἰσ', Εὐρυσθέως.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:69.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:69.1.text#ὦ τὰς Ἀθήνας δαρὸν οἰκοῦντες χρόνον,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:70.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:70.1.text#ἀμύνεθ'· ἱκέται δ' ὄντες ἀγοραίου Διὸς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:71.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:71.1.text#βιαζόμεσθα καὶ στέφη μιαίνεται —
urn:cts:greekLit:tlg0006.tlg004.fu.sp:72.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:72.1.text#πόλει τ' ὄνειδος καὶ θεῶν ἀτιμία.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:73.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:73.1.text# — ἔα ἔα· τίς ἡ βοὴ βωμοῦ πέλας
urn:cts:greekLit:tlg0006.tlg004.fu.sp:74.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:74.1.text#ἕστηκε; ποίαν συμφορὰν δείξει τάχα;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:75.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:75.1.text# — ἴδετε τὸν γέροντ' ἀμαλὸν ἐπὶ πέδῳ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:76.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:76.1.text#χύμενον· ὦ τάλας.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:76a.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:76a.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:77.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:77.1.text# — πρὸς τοῦ ποτ' ἐν γῇ πτῶμα δύστηνον πίτνεις;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:78.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:78.1.text#ὅδ', ὦ ξένοι, με σοὺς ἀτιμάζων θεοὺς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:79.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:79.1.text#ἕλκει βιαίως Ζηνὸς ἐκ προβωμίων.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:80.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:80.1.text#σὺ δ' ἐκ τίνος γῆς, ὦ γέρον, τετράπτολιν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:81.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:81.1.text#ξύνοικον ἦλθες λαόν; ἢ πέραθεν 
urn:cts:greekLit:tlg0006.tlg004.fu.sp:82.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:82.1.text#ἁλίῳ πλάτᾳ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:83.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:83.1.text#κατέχετ' ἐκλιπόντες Εὐβοῖδ' ἀκτάν;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:84.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:84.1.text#οὐ νησιώτην, ὦ ξένοι, τρίβω βίον,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:85.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:85.1.text#ἀλλ' ἐκ Μυκηνῶν σὴν ἀφίγμεθα χθόνα.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:86.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:86.1.text#ὄνομα τί σε, γέρον,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:87.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:87.1.text#Μυκηναῖος ὠνόμαζεν λεώς;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:88.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:88.1.text#τὸν Ἡράκλειον ἴστε που παραστάτην
urn:cts:greekLit:tlg0006.tlg004.fu.sp:89.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:89.1.text#Ἰόλαον· οὐ γὰρ σῶμ' ἀκήρυκτον τόδε.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:90.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:90.1.text#οἶδ' εἰσακούσας καὶ πρίν· ἀλλὰ τοῦ ποτὲ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:91.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:91.1.text#ἐν χερὶ σᾷ κομίζεις κόρους
urn:cts:greekLit:tlg0006.tlg004.fu.sp:92.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:92.1.text#νεοτρεφεῖς; φράσον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:93.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:93.1.text#Ἡρακλέους οἵδ' εἰσὶ παῖδες, ὦ ξένοι,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:94.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:94.1.text#ἱκέται σέθεν τε καὶ πόλεως ἀφιγμένοι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:95.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:95.1.text#τί χρέος; ἢ λόγων πόλεος, ἔνεπέ μοι,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:96.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:96.1.text#μελόμενοι τυχεῖν;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:97.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:97.1.text#μήτ' ἐκδοθῆναι μήτε πρὸς βίαν θεῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:98.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:98.1.text#τῶν σῶν ἀποσπασθέντες εἰς  Ἄργος μολεῖν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:99.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:99.1.text#ἀλλ' οὔτι τοῖς σοῖς δεσπόταις τάδ' ἀρκέσει,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:100.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:100.1.text#οἳ σοῦ κρατοῦντες ἐνθάδ' εὑρίσκουσί σε.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:101.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:101.1.text#εἰκὸς θεῶν ἱκτῆρας αἰδεῖσθαι, ξένε,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:102.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:102.1.text#καὶ μὴ βιαίῳ χερὶ δαιμόνων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:103.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:103.1.text#ἀπολείπειν [ σ' ] ἕδη·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:104.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:104.1.text#πότνια γὰρ Δίκα τάδ' οὐ πείσεται.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:105.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:105.1.text#ἔκπεμπέ νυν γῆς τούσδε τοὺς Εὐρυσθέως,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:106.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:106.1.text#κοὐδὲν βιαίῳ τῇδε χρήσομαι χερί.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:107.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:107.1.text#ἄθεον ἱκεσίαν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:108.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:108.1.text#μεθεῖναι πόλει ξένων προστροπάν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:109.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:109.1.text#καλὸν δέ γ' ἔξω πραγμάτων ἔχειν πόδα,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:110.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:110.1.text#εὐβουλίας τυχόντα τῆς ἀμείνονος.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:110a.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:110a.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:111.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:111.1.text#οὐκοῦν τυράννῳ τῆσδε γῆς φράσαντά σε
urn:cts:greekLit:tlg0006.tlg004.fu.sp:112.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:112.1.text#χρῆν ταῦτα τολμᾶν, ἀλλὰ μὴ βίᾳ ξένους
urn:cts:greekLit:tlg0006.tlg004.fu.sp:113.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:113.1.text#θεῶν ἀφέλκειν, γῆν σέβοντ' ἐλευθέραν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:114.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:114.1.text#τίς δ' ἐστὶ χώρας τῆσδε καὶ πόλεως ἄναξ;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:115.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:115.1.text#ἐσθλοῦ πατρὸς παῖς Δημοφῶν ὁ Θησέως.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:116.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:116.1.text#πρὸς τοῦτον ἁγὼν ἆρα τοῦδε τοῦ λόγου
urn:cts:greekLit:tlg0006.tlg004.fu.sp:117.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:117.1.text#μάλιστ' ἂν εἴη· τἄλλα δ' εἴρηται μάτην.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:118.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:118.1.text#καὶ μὴν ὅδ' αὐτὸς ἔρχεται σπουδὴν ἔχων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:119.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:119.1.text#Ἀκάμας τ' ἀδελφός, τῶνδ' ἐπήκοοι λόγων.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:120.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:120.1.text#ἐπείπερ ἔφθης πρέσβυς ὢν νεωτέρους
urn:cts:greekLit:tlg0006.tlg004.fu.sp:121.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:121.1.text#βοηδρομήσας τήνδ' ἐπ' ἐσχάραν Διός,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:122.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:122.1.text#λέξον, τίς ὄχλον τόνδ' ἀθροίζεται τύχη;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:123.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:123.1.text#ἱκέται κάθηνται παῖδες οἵδ' Ἡρακλέους
urn:cts:greekLit:tlg0006.tlg004.fu.sp:124.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:124.1.text#βωμὸν καταστέψαντες, ὡς ὁρᾷς, ἄναξ,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:125.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:125.1.text#πατρός τε πιστὸς Ἰόλεως παραστάτης.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:126.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:126.1.text#τί δῆτ' ἰυγμῶν ἥδ' ἐδεῖτο συμφορά;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:127.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:127.1.text#βίᾳ νιν οὗτος τῆσδ' ἀπ' ἐσχάρας ἄγειν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:128.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:128.1.text#ζητῶν βοὴν ἔστησε κἄσφηλεν γόνυ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:129.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:129.1.text#γέροντος, ὥστε μ' ἐκβαλεῖν οἴκτῳ δάκρυ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:130.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:130.1.text#καὶ μὴν στολήν γ' Ἕλληνα καὶ ῥυθμὸν πέπλων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:131.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:131.1.text#ἔχει, τὰ δ' ἔργα βαρβάρου χερὸς τάδε.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:132.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:132.1.text#σὸν δὴ τὸ φράζειν ἐστί, μὴ μέλλειν τ', ἐμοὶ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:133.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:133.1.text#ποίας ἀφῖξαι δεῦρο γῆς ὅρους λιπών;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:134.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:134.1.text#Ἀργεῖός εἰμι· τοῦτο γὰρ θέλεις μαθεῖν·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:135.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:135.1.text#ἐφ' οἷσι δ' ἥκω καὶ παρ' οὗ λέγειν θέλω.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:136.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:136.1.text#πέμπει Μυκηνῶν δεῦρό μ' Εὐρυσθεὺς ἄναξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:137.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:137.1.text#ἄξοντα τούσδε· πολλὰ δ' ἦλθον, ὦ ξένε,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:138.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:138.1.text#δίκαι' ὁμαρτῇ δρᾶν τε καὶ λέγειν ἔχων.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:139.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:139.1.text#Ἀργεῖος ὢν γὰρ αὐτὸς Ἀργείους ἄγω
urn:cts:greekLit:tlg0006.tlg004.fu.sp:140.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:140.1.text#ἐκ τῆς ἐμαυτοῦ τούσδε δραπέτας ἔχων,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:141.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:141.1.text#νόμοισι τοῖς ἐκεῖθεν ἐψηφισμένους
urn:cts:greekLit:tlg0006.tlg004.fu.sp:142.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:142.1.text#θανεῖν· δίκαιοι δ' ἐσμὲν οἰκοῦντες πόλιν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:143.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:143.1.text#αὐτοὶ καθ' αὑτῶν κυρίους κραίνειν δίκας.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:144.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:144.1.text#πολλῶν δὲ κἄλλων ἑστίας ἀφιγμένοι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:145.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:145.1.text#ἐν τοῖσιν αὐτοῖς τοισίδ' ἕσταμεν λόγοις,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:146.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:146.1.text#κοὐδεὶς ἐτόλμησ' ἴδια προσθέσθαι κακά.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:147.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:147.1.text#ἀλλ' ἤ τιν' ἐς σὲ μωρίαν ἐσκεμμένοι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:148.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:148.1.text#δεῦρ' ἦλθον ἢ κίνδυνον ἐξ ἀμηχάνων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:149.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:149.1.text#ῥίπτοντες, εἴτ' οὖν εἴτε μὴ γενήσεται·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:150.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:150.1.text#οὐ γὰρ φρενήρη γ' ὄντα σ' ἐλπίζουσί που
urn:cts:greekLit:tlg0006.tlg004.fu.sp:151.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:151.1.text#μόνον τοσαύτης ἣν ἐπῆλθον Ἑλλάδος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:152.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:152.1.text#τὰς τῶνδ' ἀβούλους συμφορὰς κατοικτιεῖν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:153.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:153.1.text#φέρ' ἀντίθες γάρ· τούσδε τ' ἐς γαῖαν παρεὶς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:154.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:154.1.text#ἡμᾶς τ' ἐάσας ἐξάγειν, τί κερδανεῖς;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:155.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:155.1.text#τὰ μὲν παρ' ἡμῶν τοιάδ' ἔστι σοι λαβεῖν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:156.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:156.1.text#Ἄργους τοσήνδε χεῖρα τήν τ' Εὐρυσθέως
urn:cts:greekLit:tlg0006.tlg004.fu.sp:157.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:157.1.text#ἰσχὺν ἅπασαν τῇδε προσθέσθαι πόλει.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:158.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:158.1.text#ἢν δ' ἐς λόγους τε καὶ τὰ τῶνδ' οἰκτίσματα
urn:cts:greekLit:tlg0006.tlg004.fu.sp:159.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:159.1.text#βλέψας πεπανθῇς, ἐς πάλην καθίσταται
urn:cts:greekLit:tlg0006.tlg004.fu.sp:160.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:160.1.text#δορὸς τὸ πρᾶγμα· μὴ γὰρ ὡς μεθήσομεν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:161.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:161.1.text#δόξῃς ἀγῶνα τόνδ' ἄτερ χαλυβδικοῦ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:162.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:162.1.text#τί δῆτα φήσεις, ποῖα πεδί' ἀφαιρεθείς,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:163.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:163.1.text#τί ῥυσιασθείς, πόλεμον Ἀργείοις ἔχειν;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:164.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:164.1.text#ποίοις δ' ἀμύνων συμμάχοις, τίνος δ' ὕπερ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:165.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:165.1.text#θάψεις νεκροὺς πεσόντας; ἦ κακὸν λόγον
urn:cts:greekLit:tlg0006.tlg004.fu.sp:166.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:166.1.text#κτήσῃ πρὸς ἀστῶν, εἰ γέροντος οὕνεκα,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:167.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:167.1.text#τύμβου, τὸ μηδὲν ὄντος, ὡς εἰπεῖν ἔπος,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:168.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:168.1.text#παίδων { τε } τῶνδ', ἐς ἄντλον ἐμβήσῃ πόδα.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:169.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:169.1.text#ἐρεῖς τὸ λῷστον ἐλπίδ' εὑρήσειν μόνον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:170.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:170.1.text#καὶ τοῦτο πολλῷ τοῦ παρόντος ἐνδεές·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:171.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:171.1.text#κακῶς γὰρ Ἀργείοισιν οἵδ' ὡπλισμένοις
urn:cts:greekLit:tlg0006.tlg004.fu.sp:172.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:172.1.text#μάχοιντ' ἂν ἡβήσαντες, εἴ { τι } τοῦτό σε
urn:cts:greekLit:tlg0006.tlg004.fu.sp:173.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:173.1.text#ψυχὴν ἐπαίρει· χοὑν μέσῳ πολὺς χρόνος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:174.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:174.1.text#ἐν ᾧ διεργασθεῖτ' ἄν. ἀλλ' ἐμοὶ πιθοῦ·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:175.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:175.1.text#δοὺς μηδέν, ἀλλὰ τἄμ' ἐῶν ἄγειν ἐμὲ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:176.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:176.1.text#κτῆσαι Μυκήνας, μηδ' ὅπερ φιλεῖτε δρᾶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:177.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:177.1.text#πάθῃς σὺ τοῦτο, τοὺς ἀμείνονας παρὸν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:178.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:178.1.text#φίλους ἑλέσθαι, τοὺς κακίονας λάβῃς.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:179.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:179.1.text#τίς ἂν δίκην κρίνειεν ἢ γνοίη λόγον,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:180.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:180.1.text#πρὶν ἂν παρ' ἀμφοῖν μῦθον ἐκμάθῃ σαφῶς;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:181.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:181.1.text#ἄναξ — ὑπάρχει μὲν τόδ' ἐν τῇ σῇ χθονί —
urn:cts:greekLit:tlg0006.tlg004.fu.sp:182.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:182.1.text#εἰπεῖν ἀκοῦσαί τ' ἐν μέρει πάρεστί μοι,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:183.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:183.1.text#κοὐδείς μ' ἀπώσει πρόσθεν, ὥσπερ ἄλλοθεν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:184.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:184.1.text#ἡμῖν δὲ καὶ τῷδ' οὐδέν ἐστιν ἐν μέρει·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:185.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:185.1.text#ἐπεὶ γὰρ Ἄργους οὐ μέτεσθ' ἡμῖν ἔτι,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:186.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:186.1.text#ψήφῳ δοκῆσαν, ἀλλὰ φεύγομεν πάτραν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:187.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:187.1.text#πῶς ἂν δικαίως ὡς Μυκηναίους ἄγοι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:188.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:188.1.text#ὧδ' ὄντας ἡμᾶς, οὓς ἀπήλασαν χθονός;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:189.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:189.1.text#ξένοι γάρ ἐσμεν. ἢ τὸν Ἑλλήνων ὅρον
urn:cts:greekLit:tlg0006.tlg004.fu.sp:190.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:190.1.text#φεύγειν δικαιοῦθ' ὅστις ἂν τἄργος φύγῃ;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:191.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:191.1.text#οὔκουν Ἀθήνας γ'· οὐ γὰρ Ἀργείων φόβῳ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:192.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:192.1.text#τοὺς Ἡρακλείους παῖδας ἐξελῶσι γῆς.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:193.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:193.1.text#οὐ γάρ τι Τραχίς ἐστιν οὐδ' Ἀχαιικὸν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:194.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:194.1.text#πόλισμ', ὅθεν σὺ τούσδε, τῇ δίκῃ μὲν οὔ,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:195.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:195.1.text#τὸ δ' Ἄργος ὀγκῶν, οἷάπερ καὶ νῦν λέγεις,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:196.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:196.1.text#ἤλαυνες ἱκέτας βωμίους καθημένους.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:197.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:197.1.text#εἰ γὰρ τόδ' ἔσται καὶ λόγους κρινοῦσι σούς,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:198.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:198.1.text#οὐκ οἶδ' Ἀθήνας τάσδ' ἐλευθέρας ἔτι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:199.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:199.1.text#ἀλλ' οἶδ' ἐγὼ τὸ τῶνδε λῆμα καὶ φύσιν·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:200.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:200.1.text#θνῄσκειν θελήσουσ'· ἡ γὰρ αἰσχύνη { πάρος }
urn:cts:greekLit:tlg0006.tlg004.fu.sp:201.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:201.1.text#τοῦ ζῆν παρ' ἐσθλοῖς ἀνδράσιν νομίζεται.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:202.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:202.1.text#πόλιν μὲν ἀρκεῖ· καὶ γὰρ οὖν ἐπίφθονον
urn:cts:greekLit:tlg0006.tlg004.fu.sp:203.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:203.1.text#λίαν ἐπαινεῖν ἐστι, πολλάκις δὲ δὴ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:204.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:204.1.text#καὐτὸς βαρυνθεὶς οἶδ' ἄγαν αἰνούμενος.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:205.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:205.1.text#σοὶ δ' ὡς ἀνάγκη τούσδε βούλομαι φράσαι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:206.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:206.1.text#σῴζειν, ἐπείπερ τῆσδε προστατεῖς χθονός.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:207.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:207.1.text#Πιτθεὺς μέν ἐστι Πέλοπος, ἐκ δὲ Πιτθέως
urn:cts:greekLit:tlg0006.tlg004.fu.sp:208.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:208.1.text#Αἴθρα, πατὴρ δ' ἐκ τῆσδε γεννᾶται σέθεν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:209.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:209.1.text#Θησεύς. πάλιν δὲ τῶνδ' ἄνειμί σοι γένος.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:210.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:210.1.text#Ἡρακλέης ἦν Ζηνὸς Ἀλκμήνης τε παῖς,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:211.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:211.1.text#κείνη δὲ Πέλοπος θυγατρός. αὐτανεψίων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:212.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:212.1.text#πατὴρ ἂν εἴη σός τε χὡ τούτων γεγώς.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:213.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:213.1.text#γένους μὲν ἥκεις ὧδε τοῖσδε, Δημοφῶν·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:214.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:214.1.text#ἃ δ' ἐκτὸς ἤδη τοῦ προσήκοντός σε δεῖ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:215.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:215.1.text#τεῖσαι λέγω σοι παισί· φημὶ γάρ ποτε
urn:cts:greekLit:tlg0006.tlg004.fu.sp:216.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:216.1.text#σύμπλους γενέσθαι τῶνδ' ὑπασπίζων πατρὶ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:217.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:217.1.text#ζωστῆρα Θησεῖ τὸν πολυκτόνον μέτα·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:218.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:218.1.text#Ἅιδου τ' ἐρυμνῶν ἐξανήγαγεν μυχῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:219.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:219.1.text#πατέρα σόν· Ἑλλὰς πᾶσα τοῦτο μαρτυρεῖ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:220.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:220.1.text#ὧν ἀντιδοῦναί σ' οἵδ' ἀπαιτοῦσιν χάριν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:221.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:221.1.text#μήτ' ἐκδοθῆναι μήτε πρὸς βίαν θεῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:222.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:222.1.text#τῶν σῶν ἀποσπασθέντες ἐκπεσεῖν χθονός.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:223.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:223.1.text#σοὶ γὰρ τόδ' αἰσχρὸν { χωρίς, ἔν τε πόλει κακόν, }
urn:cts:greekLit:tlg0006.tlg004.fu.sp:224.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:224.1.text#ἱκέτας ἀλήτας συγγενεῖς, οἴμοι,  κακῶς —
urn:cts:greekLit:tlg0006.tlg004.fu.sp:225.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:225.1.text#βλέψον πρὸς αὐτοὺς βλέψον· — ἕλκεσθαι βίᾳ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:226.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:226.1.text#ἀλλ' ἄντομαί σε καὶ καταστέφω χεροῖν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:227.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:227.1.text#καὶ [ … ] πρὸς γενείου, μηδαμῶς ἀτιμάσῃς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:228.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:228.1.text#τοὺς Ἡρακλείους παῖδας ἐς χέρας λαβών·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:229.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:229.1.text#γενοῦ δὲ τοῖσδε συγγενής, γενοῦ φίλος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:230.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:230.1.text#πατὴρ ἀδελφὸς δεσπότης· ἅπαντα γὰρ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:231.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:231.1.text#ταῦτ' ἐστὶ κρείσσω πλὴν ὑπ' Ἀργείοις πεσεῖν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:232.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:232.1.text#ᾤκτιρ' ἀκούσας τούσδε συμφορᾶς, ἄναξ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:233.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:233.1.text#τὴν δ' εὐγένειαν τῆς τύχης νικωμένην
urn:cts:greekLit:tlg0006.tlg004.fu.sp:234.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:234.1.text#νῦν δὴ μάλιστ' ἐσεῖδον· οἵδε γὰρ πατρὸς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:235.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:235.1.text#ἐσθλοῦ γεγῶτες δυστυχοῦσ' ἀναξίως.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:236.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:236.1.text#τρισσαί μ' ἀναγκάζουσι συμφορᾶς ὁδοί,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:237.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:237.1.text#Ἰόλαε, τοὺς σοὺς μὴ παρώσασθαι ξένους·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:238.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:238.1.text#τὸ μὲν μέγιστον Ζεὺς ἐφ' οὗ σὺ βώμιος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:239.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:239.1.text#θακεῖς νεοσσῶν τήνδ' ἔχων πανήγυριν·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:240.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:240.1.text#τὸ συγγενές τε καὶ τὸ προυφείλειν καλῶς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:241.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:241.1.text#πράσσειν παρ' ἡμῶν τούσδε πατρῴαν χάριν·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:242.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:242.1.text#τό τ' αἰσχρόν, οὗπερ δεῖ μάλιστα φροντίσαι·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:243.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:243.1.text#εἰ γὰρ παρήσω τόνδε συλᾶσθαι βίᾳ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:244.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:244.1.text#ξένου πρὸς ἀνδρὸς βωμόν, οὐκ ἐλευθέραν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:245.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:245.1.text#οἰκεῖν δοκήσω γαῖαν, Ἀργείων δ' ὄκνῳ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:246.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:246.1.text#ἱκέτας προδοῦναι· καὶ τάδ' ἀγχόνης πέλας.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:247.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:247.1.text#ἀλλ' ὤφελες μὲν εὐτυχέστερος μολεῖν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:248.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:248.1.text#ὅμως δὲ καὶ νῦν μὴ τρέσῃς ὅπως σέ τις
urn:cts:greekLit:tlg0006.tlg004.fu.sp:249.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:249.1.text#σὺν παισὶ βωμοῦ τοῦδ' ἀποσπάσει βίᾳ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:250.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:250.1.text#σὺ δ' Ἄργος ἐλθὼν ταῦτά τ' Εὐρυσθεῖ φράσον,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:251.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:251.1.text#πρὸς τοῖσδέ τ', εἴ τι τοισίδ' ἐγκαλεῖ ξένοις,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:252.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:252.1.text#δίκης κυρήσειν· τούσδε δ' οὐκ ἄξεις ποτέ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:253.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:253.1.text#οὐκ ἢν δίκαιον ᾖ τι καὶ νικῶ λόγῳ;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:254.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:254.1.text#καὶ πῶς δίκαιον τὸν ἱκέτην ἄγειν βίᾳ;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:255.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:255.1.text#οὐκ οὖν ἐμοὶ τόδ' αἰσχρόν, ἀλλ' { οὐ } σοὶ βλάβος;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:256.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:256.1.text#ἐμοί γ', ἐάν σοι τούσδ' ἐφέλκεσθαι μεθῶ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:257.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:257.1.text#σὺ δ' ἐξόριζε, κᾆτ' ἐκεῖθεν ἄξομεν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:258.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:258.1.text#σκαιὸς πέφυκας τοῦ θεοῦ πλείω φρονῶν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:259.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:259.1.text#δεῦρ', ὡς ἔοικε, τοῖς κακοῖσι φευκτέον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:260.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:260.1.text#ἅπασι κοινὸν ῥῦμα δαιμόνων ἕδρα.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:261.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:261.1.text#ταῦτ' οὐ δοκήσει τοῖς Μυκηναίοις ἴσως.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:262.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:262.1.text#οὐκ οὖν ἐγὼ τῶν ἐνθάδ' εἰμὶ κύριος;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:263.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:263.1.text#βλάπτων { γ' } ἐκείνους μηδέν, ἢν σὺ σωφρονῇς.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:264.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:264.1.text#βλάπτεσθ', ἐμοῦ γε μὴ μιαίνοντος θεούς.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:265.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:265.1.text#οὐ βούλομαί σε πόλεμον Ἀργείοις ἔχειν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:266.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:266.1.text#κἀγὼ τοιοῦτος· τῶνδε δ' οὐ μεθήσομαι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:267.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:267.1.text#ἄξω γε μέντοι τοὺς ἐμοὺς ἐγὼ λαβών.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:268.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:268.1.text#οὐκ ἆρ' ἐς Ἄργος ῥᾳδίως ἄπει πάλιν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:269.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:269.1.text#πειρώμενος δὴ τοῦτό γ' αὐτίκ' εἴσομαι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:270.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:270.1.text#κλαίων ἄρ' ἅψῃ τῶνδε κοὐκ ἐς ἀμβολάς.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:271.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:271.1.text#μὴ πρὸς θεῶν κήρυκα τολμήσῃς θενεῖν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:272.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:272.1.text#εἰ μή γ' ὁ κῆρυξ σωφρονεῖν μαθήσεται.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:273.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:273.1.text#ἄπελθε· καὶ σὺ τοῦδε μὴ θίγῃς, ἄναξ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:274.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:274.1.text#στείχω· μιᾶς γὰρ χειρὸς ἀσθενὴς μάχη.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:275.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:275.1.text#ἥξω δὲ πολλὴν Ἄρεος Ἀργείου λαβὼν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:276.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:276.1.text#πάγχαλκον αἰχμὴν δεῦρο. μυρίοι δέ με
urn:cts:greekLit:tlg0006.tlg004.fu.sp:277.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:277.1.text#μένουσιν ἀσπιστῆρες Εὐρυσθεύς τ' ἄναξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:278.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:278.1.text#αὐτὸς στρατηγῶν· Ἀλκάθου δ' ἐπ' ἐσχάτοις
urn:cts:greekLit:tlg0006.tlg004.fu.sp:279.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:279.1.text#καραδοκῶν τἀνθένδε τέρμασιν μένει.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:280.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:280.1.text#λαμπρὸς δ' ἀκούσας σὴν ὕβριν φανήσεται
urn:cts:greekLit:tlg0006.tlg004.fu.sp:281.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:281.1.text#σοὶ καὶ πολίταις γῇ τε τῇδε καὶ φυτοῖς·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:282.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:282.1.text#μάτην γὰρ ἥβην ὧδέ γ' ἂν κεκτῄμεθα
urn:cts:greekLit:tlg0006.tlg004.fu.sp:283.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:283.1.text#πολλὴν ἐν Ἄργει, μή σε τιμωρούμενοι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:284.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:284.1.text#φθείρου· τὸ σὸν γὰρ Ἄργος οὐ δέδοικ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:285.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:285.1.text#ἐνθένδε δ' οὐκ ἔμελλες αἰσχύνας ἐμὲ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:286.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:286.1.text#ἄξειν βίᾳ τούσδ'· οὐ γὰρ Ἀργείων πόλει
urn:cts:greekLit:tlg0006.tlg004.fu.sp:287.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:287.1.text#ὑπήκοον τήνδ' ἀλλ' ἐλευθέραν ἔχω.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:288.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:288.1.text#ὥρα προνοεῖν, πρὶν ὅροις πελάσαι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:289.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:289.1.text#στρατὸν Ἀργείων·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:290.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:290.1.text#μάλα δ' ὀξὺς Ἄρης ὁ Μυκηναίων,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:291.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:291.1.text#ἐπὶ τοῖσι δὲ δὴ μᾶλλον ἔτ' ἢ πρίν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:292.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:292.1.text#πᾶσι γὰρ οὗτος κήρυξι νόμος,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:293.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:293.1.text#δὶς τόσα πυργοῦν τῶν γιγνομένων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:294.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:294.1.text#πόσα νιν λέξειν βασιλεῦσι δοκεῖς,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:295.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:295.1.text#ὡς δείν' ἔπαθεν καὶ παρὰ μικρὸν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:296.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:296.1.text#ψυχὴν ἦλθεν διακναῖσαι;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:297.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:297.1.text#οὐκ ἔστι τοῦδε παισὶ κάλλιον γέρας,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:298.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:298.1.text#ἢ πατρὸς ἐσθλοῦ κἀγαθοῦ πεφυκέναι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:299.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:299.1.text#[ γαμεῖν τ' ἀπ' ἐσθλῶν· ὃς δὲ νικηθεὶς πόθῳ ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:300.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:300.1.text#[ κακοῖς ἐκοινώνησεν, οὐκ ἐπαινέσω, ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:301.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:301.1.text#[ τέκνοις ὄνειδος οὕνεχ' ἡδονῆς λιπεῖν. ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:302.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:302.1.text#τὸ δυστυχὲς γὰρ ηὑγένει' ἀμύνεται
urn:cts:greekLit:tlg0006.tlg004.fu.sp:303.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:303.1.text#τῆς δυσγενείας μᾶλλον· ἡμεῖς γὰρ κακῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:304.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:304.1.text#ἐς τοὔσχατον πεσόντες ηὕρομεν φίλους
urn:cts:greekLit:tlg0006.tlg004.fu.sp:305.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:305.1.text#καὶ ξυγγενεῖς τούσδ', οἳ τοσῆσδ' οἰκουμένης
urn:cts:greekLit:tlg0006.tlg004.fu.sp:306.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:306.1.text#Ἑλληνίδος γῆς τῶνδε προύστησαν μόνοι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:307.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:307.1.text#δότ', ὦ τέκν', αὐτοῖς χεῖρα δεξιάν, δότε·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:308.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:308.1.text#ὑμεῖς τε παισί, καὶ πέλας προσέλθετε.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:309.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:309.1.text#ὦ παῖδες, ἐς μὲν πεῖραν ἤλθομεν φίλων·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:310.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:310.1.text#ἢν δ' οὖν ποθ' ὑμῖν νόστος ἐς πάτραν φανῇ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:311.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:311.1.text#καὶ δώματ' οἰκήσητε καὶ τιμὰς πατρός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:311a.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:311a.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:312.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:312.1.text#σωτῆρας αἰεὶ καὶ φίλους νομίζετε,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:313.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:313.1.text#καὶ μήποτ' ἐς γῆν ἐχθρὸν αἴρεσθαι δόρυ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:314.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:314.1.text#μέμνησθέ μοι τήνδ', ἀλλὰ φιλτάτην πόλιν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:315.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:315.1.text#πασῶν νομίζετ'. ἄξιοι δ' ὑμῖν σέβειν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:316.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:316.1.text#οἳ γῆν τοσήνδε καὶ Πελασγικὸν λεὼν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:317.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:317.1.text#ἡμῶν ἀπηλλάξαντο πολεμίους ἔχειν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:318.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:318.1.text#πτωχοὺς ἀλήτας εἰσορῶντες· ἀλλ' ὅμως
urn:cts:greekLit:tlg0006.tlg004.fu.sp:319.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:319.1.text#οὐκ ἐξέδωκαν οὐδ' ἀπήλασαν χθονός.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:320.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:320.1.text#ἐγὼ δὲ καὶ ζῶν καὶ θανών, ὅταν θάνω,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:321.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:321.1.text#πολλῷ σ' ἐπαίνῳ Θησέως, ὦ τᾶν, πέλας
urn:cts:greekLit:tlg0006.tlg004.fu.sp:322.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:322.1.text#ὑψηλὸν ἀρῶ καὶ λέγων τάδ' εὐφρανῶ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:323.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:323.1.text#ὡς εὖ τ' ἐδέξω καὶ τέκνοισιν ἤρκεσας
urn:cts:greekLit:tlg0006.tlg004.fu.sp:324.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:324.1.text#τοῖς Ἡρακλείοις, εὐγενὴς δ' ἀν' Ἑλλάδα
urn:cts:greekLit:tlg0006.tlg004.fu.sp:325.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:325.1.text#σῴζεις πατρῴαν δόξαν, ἐξ ἐσθλῶν δὲ φὺς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:326.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:326.1.text#οὐδὲν κακίων τυγχάνεις γεγὼς πατρός,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:327.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:327.1.text#παύρων μετ' ἄλλων· ἕνα γὰρ ἐν πολλοῖς ἴσως
urn:cts:greekLit:tlg0006.tlg004.fu.sp:328.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:328.1.text#εὕροις ἂν ὅστις ἐστὶ μὴ χείρων πατρός.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:329.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:329.1.text#ἀεί ποθ' ἥδε γαῖα τοῖς ἀμηχάνοις
urn:cts:greekLit:tlg0006.tlg004.fu.sp:330.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:330.1.text#σὺν τῷ δικαίῳ βούλεται προσωφελεῖν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:331.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:331.1.text#τοιγὰρ πόνους δὴ μυρίους ὑπὲρ φίλων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:332.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:332.1.text#ἤνεγκε, καὶ νῦν τόνδ' ἀγῶν' ὁρῶ πέλας.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:333.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:333.1.text#σοί τ' εὖ λέλεκται, καὶ τὰ τῶνδ' αὐχῶ, γέρον,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:334.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:334.1.text#τοιαῦτ' ἔσεσθαι· μνημονεύσεται χάρις.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:335.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:335.1.text#κἀγὼ μὲν ἀστῶν σύλλογον ποήσομαι,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:336.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:336.1.text#τάξω δ', ὅπως ἂν τὸν Μυκηναίων στρατὸν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:337.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:337.1.text#πολλῇ δέχωμαι χειρί· πρῶτα μὲν σκοποὺς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:338.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:338.1.text#πέμψω πρὸς αὐτόν, μὴ λάθῃ με προσπεσών·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:339.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:339.1.text#ταχὺς γὰρ Ἄργει πᾶς ἀνὴρ βοηδρόμος·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:340.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:340.1.text#μάντεις δ' ἀθροίσας θύσομαι. σὺ δ' ἐς  δόμους
urn:cts:greekLit:tlg0006.tlg004.fu.sp:341.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:341.1.text#σὺν παισὶ χώρει, Ζηνὸς ἐσχάραν λιπών.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:342.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:342.1.text#εἰσὶν γὰρ οἵ σου, κἂν ἐγὼ θυραῖος ὦ,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:343.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:343.1.text#μέριμναν ἕξουσ'. ἀλλ' ἴθ' ἐς δόμους, γέρον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:344.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:344.1.text#οὐκ ἂν λίποιμι βωμόν· ἑζώμεσθα δὴ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:345.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:345.1.text#ἱκέται μένοντες ἐνθάδ' εὖ πρᾶξαι πόλιν·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:346.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:346.1.text#ὅταν δ' ἀγῶνος τοῦδ' ἀπαλλαχθῇς καλῶς,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:347.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:347.1.text#ἴμεν πρὸς οἴκους. θεοῖσι δ' οὐ κακίοσιν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:348.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:348.1.text#χρώμεσθα συμμάχοισιν Ἀργείων, ἄναξ·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:349.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:349.1.text#τῶν μὲν γὰρ Ἥρα προστατεῖ, Διὸς δάμαρ,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:350.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:350.1.text#ἡμῶν δ' Ἀθηνᾶ. φημὶ δ' εἰς εὐπραξίαν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:351.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:351.1.text#καὶ τοῦθ' ὑπάρχειν, θεῶν ἀμεινόνων τυχεῖν·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:352.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:352.1.text#νικωμένη γὰρ Παλλὰς οὐκ ἀνέξεται.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:353.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:353.1.text#Εἰ σὺ μέγ' αὐχεῖς, ἕτεροι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:354.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:354.1.text#σοῦ πλέον οὐ μέλονται,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:355.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:355.1.text#{ ὦ } ξεῖν' Ἀργόθεν ἐλθών,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:356.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:356.1.text#μεγαληγορίαισι δ' ἐμὰς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:357.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:357.1.text#φρένας οὐ φοβήσεις.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:358.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:358.1.text#μήπω ταῖς μεγάλαισιν οὕτω 
urn:cts:greekLit:tlg0006.tlg004.fu.sp:359.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:359.1.text#καὶ καλλιχόροις Ἀθήναις 
urn:cts:greekLit:tlg0006.tlg004.fu.sp:360.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:360.1.text#εἴη· σὺ δ' ἄφρων, ὅ τ' Ἄργει 
urn:cts:greekLit:tlg0006.tlg004.fu.sp:361.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:361.1.text#Σθενέλου τύραννος.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:362.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:362.1.text#ὃς πόλιν ἐλθὼν ἑτέραν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:363.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:363.1.text#οὐδὲν ἐλάσσον'  Ἄργους,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:364.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:364.1.text#θεῶν ἱκτῆρας ἀλάτας
urn:cts:greekLit:tlg0006.tlg004.fu.sp:365.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:365.1.text#καὶ ἐμᾶς χθονὸς ἀντομένους
urn:cts:greekLit:tlg0006.tlg004.fu.sp:366.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:366.1.text#ξένος ὢν βιαίως
urn:cts:greekLit:tlg0006.tlg004.fu.sp:367.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:367.1.text#ἕλκεις, οὐ βασιλεῦσιν εἴξας,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:368.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:368.1.text# οὐκ ἄλλο δίκαιον εἰπών·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:369.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:369.1.text# ποῦ ταῦτα καλῶς ἂν εἴη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:370.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:370.1.text# παρά γ' εὖ φρονοῦσιν;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:371.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:371.1.text#Εἰρήνα μὲν ἐμοί γ' ἀρέσκει·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:372.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:372.1.text# σὺ δ', ὦ κακόφρων ἄναξ,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:373.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:373.1.text#λέγω, εἰ πόλιν ἥξεις,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:374.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:374.1.text#οὐχ οὕτως ἃ δοκεῖς κυρήσεις·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:375.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:375.1.text# οὐ σοὶ μόνῳ ἔγχος οὐδ'
urn:cts:greekLit:tlg0006.tlg004.fu.sp:376.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:376.1.text#ἰτέα κατάχαλκός [ ἐστιν. ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:377.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:377.1.text#ἀλλ' οὐ, πολέμων ἐραστάς,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:378.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:378.1.text#μή μοι δορὶ συνταράξεις
urn:cts:greekLit:tlg0006.tlg004.fu.sp:379.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:379.1.text#τὰν εὖ χαρίτων ἔχουσαν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:380.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:380.1.text#πόλιν, ἀλλ' ἀνάσχου. [ … ][ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:381.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:381.1.text#ὦ παῖ, τί μοι σύννοιαν ὄμμασιν φέρων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:382.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:382.1.text#ἥκεις; νέον τι πολεμίων λέξεις πέρι;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:383.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:383.1.text#μέλλουσιν ἢ πάρεισιν ἢ τί πυνθάνῃ;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:384.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:384.1.text#οὐ γάρ τι μὴ ψεύσῃς γε κήρυκος λόγους·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:385.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:385.1.text#ὁ γὰρ στρατηγὸς εὐτυχὴς τὰ πρὸς θεῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:386.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:386.1.text#εἶσιν, σάφ' οἶδα, καὶ μάλ' οὐ σμικρὸν φρονῶν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:387.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:387.1.text#ἐς τὰς Ἀθήνας. ἀλλὰ τῶν φρονημάτων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:388.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:388.1.text#ὁ Ζεὺς κολαστὴς τῶν ἄγαν ὑπερφρόνων.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:389.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:389.1.text#ἥκει στράτευμ' Ἀργεῖον Εὐρυσθεύς τ' ἄναξ·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:390.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:390.1.text#ἐγώ νιν αὐτὸς εἶδον. ἄνδρα γὰρ χρεών,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:391.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:391.1.text#ὅστις στρατηγεῖν φησ' ἐπίστασθαι καλῶς,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:392.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:392.1.text#οὐκ ἀγγέλοισι τοὺς ἐναντίους ὁρᾶν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:393.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:393.1.text#πεδία μὲν οὖν γῆς ἐς τάδ' οὐκ ἐφῆκέ πω
urn:cts:greekLit:tlg0006.tlg004.fu.sp:394.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:394.1.text#στρατόν, λεπαίαν δ' ὀφρύην καθήμενος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:395.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:395.1.text#σκοπεῖ — δόκησιν δὴ τόδ' ἂν λέγοιμί σοι —
urn:cts:greekLit:tlg0006.tlg004.fu.sp:396.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:396.1.text#{ ποίᾳ προσάξει στρατόπεδον τὰ νῦν δορὸς }
urn:cts:greekLit:tlg0006.tlg004.fu.sp:397.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:397.1.text#{ ἐν ἀσφαλεῖ τε τῆσδ' ἱδρύσεται χθονός. }
urn:cts:greekLit:tlg0006.tlg004.fu.sp:398.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:398.1.text#καὶ τἀμὰ μέντοι πάντ' ἄραρ' ἤδη καλῶς·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:399.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:399.1.text#πόλις τ' ἐν ὅπλοις, σφάγιά θ' ἡτοιμασμένα
urn:cts:greekLit:tlg0006.tlg004.fu.sp:400.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:400.1.text#ἕστηκεν οἷς χρὴ ταῦτα τέμνεσθαι θεῶν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:402.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:402.1.text#τροπαῖά τ' ἐχθρῶν καὶ πόλει σωτήρια,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:401.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:401.1.text#θυηπολεῖται δ' ἄστυ μάντεων ὕπο.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:403.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:403.1.text#χρησμῶν δ' ἀοιδοὺς πάντας εἰς ἓν ἁλίσας
urn:cts:greekLit:tlg0006.tlg004.fu.sp:404.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:404.1.text#ἤλεγξα καὶ βέβηλα καὶ κεκρυμμένα
urn:cts:greekLit:tlg0006.tlg004.fu.sp:405.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:405.1.text#λόγια παλαιά, τῇδε γῇ σωτήρια.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:406.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:406.1.text#καὶ τῶν μὲν ἄλλων διάφορ' ἐστὶ θεσφάτοις
urn:cts:greekLit:tlg0006.tlg004.fu.sp:407.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:407.1.text#πόλλ'· ἓν δὲ πᾶσι γνῶμα ταὐτὸν ἐμπρέπει·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:408.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:408.1.text#σφάξαι κελεύουσίν με παρθένον Κόρῃ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:409.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:409.1.text#Δήμητρος, ἥτις ἐστὶ πατρὸς εὐγενοῦς.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:410.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:410.1.text#ἐγὼ δ' ἔχω μέν, ὡς ὁρᾷς, προθυμίαν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:411.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:411.1.text#τοσήνδ' ἐς ὑμᾶς· παῖδα δ' οὔτ' ἐμὴν κτενῶ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:412.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:412.1.text#οὔτ' ἄλλον ἀστῶν τῶν ἐμῶν ἀναγκάσω
urn:cts:greekLit:tlg0006.tlg004.fu.sp:413.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:413.1.text#ἄκονθ'· ἑκὼν δὲ τίς κακῶς οὕτω φρονεῖ,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:414.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:414.1.text#ὅστις τὰ φίλτατ' ἐκ χερῶν δώσει τέκνα;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:415.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:415.1.text#καὶ νῦν πικρὰς ἂν συστάσεις ἂν εἰσίδοις,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:416.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:416.1.text#τῶν μὲν λεγόντων ὡς δίκαιον ἦν ξένοις
urn:cts:greekLit:tlg0006.tlg004.fu.sp:417.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:417.1.text#ἱκέταις ἀρήγειν, τῶν δὲ μωρίαν ἐμὴν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:418.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:418.1.text#κατηγορούντων· εἰ δὲ δὴ δράσω τόδε,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:419.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:419.1.text#οἰκεῖος ἤδη πόλεμος ἐξαρτύεται.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:420.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:420.1.text#ταῦτ' οὖν ὅρα σὺ καὶ συνεξεύρισχ' ὅπως
urn:cts:greekLit:tlg0006.tlg004.fu.sp:421.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:421.1.text#αὐτοί τε σωθήσεσθε καὶ πέδον τόδε,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:422.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:422.1.text#κἀγὼ πολίταις μὴ διαβληθήσομαι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:423.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:423.1.text#οὐ γὰρ τυραννίδ' ὥστε βαρβάρων ἔχω·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:424.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:424.1.text#ἀλλ', ἢν δίκαια δρῶ, δίκαια πείσομαι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:425.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:425.1.text#ἀλλ' ἦ πρόθυμον οὖσαν οὐκ ἐᾷ θεὸς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:426.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:426.1.text#ξένοις ἀρήγειν τήνδε χρῄζουσιν πόλιν;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:427.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:427.1.text#ὦ τέκν', ἔοιγμεν ναυτίλοισιν, οἵτινες
urn:cts:greekLit:tlg0006.tlg004.fu.sp:428.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:428.1.text#χειμῶνος ἐκφυγόντες ἄγριον μένος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:429.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:429.1.text#ἐς χεῖρα γῇ συνῆψαν, εἶτα χερσόθεν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:430.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:430.1.text#πνοιαῖσιν ἠλάθησαν ἐς πόντον πάλιν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:431.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:431.1.text#οὕτω δὲ χἡμεῖς τῆσδ' ἀπωθούμεσθα γῆς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:432.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:432.1.text#ἤδη πρὸς ἀκταῖς ὄντες ὡς σεσῳσμένοι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:433.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:433.1.text#οἴμοι· τί δῆτ' ἔτερψας ὦ τάλαινά με
urn:cts:greekLit:tlg0006.tlg004.fu.sp:434.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:434.1.text#ἐλπὶς τότ', οὐ μέλλουσα διατελεῖν χάριν;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:435.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:435.1.text#συγγνωστὰ γάρ τοι καὶ τὰ τοῦδ', εἰ μὴ θέλει
urn:cts:greekLit:tlg0006.tlg004.fu.sp:436.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:436.1.text#κτείνειν πολιτῶν παῖδας· αἰνέσαι δ' ἔχω
urn:cts:greekLit:tlg0006.tlg004.fu.sp:437.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:437.1.text#καὶ τἀνθάδ'· εἰ θεοῖσι δὴ δοκεῖ τάδε
urn:cts:greekLit:tlg0006.tlg004.fu.sp:438.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:438.1.text#πράσσειν ἔμ', οὔτοι σή γ' ἀπόλλυται χάρις.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:439.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:439.1.text#ὦ παῖδες, ὑμῖν δ' οὐκ ἔχω τί χρήσομαι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:440.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:440.1.text#ποῖ τρεψόμεσθα; τίς γὰρ ἄστεπτος θεῶν;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:441.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:441.1.text#ποῖον δὲ γαίας ἕρκος οὐκ ἀφίγμεθα;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:442.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:442.1.text#ὀλούμεθ', ὦ τέκν'· ἐκδοθησόμεσθα δή.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:443.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:443.1.text#κἀμοῦ μὲν οὐδὲν εἴ με χρὴ θανεῖν μέλει,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:444.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:444.1.text#πλὴν εἴ τι τέρψω τοὺς ἐμοὺς ἐχθροὺς θανών·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:445.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:445.1.text#ὑμᾶς δὲ κλαίω καὶ κατοικτίρω, τέκνα,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:446.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:446.1.text#καὶ τὴν γεραιὰν μητέρ' Ἀλκμήνην πατρός.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:447.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:447.1.text#ὦ δυστάλαινα τοῦ μακροῦ βίου σέθεν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:448.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:448.1.text#τλήμων δὲ κἀγὼ πολλὰ μοχθήσας μάτην.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:449.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:449.1.text#χρῆν χρῆν ἄρ' ἡμᾶς ἀνδρὸς εἰς ἐχθροῦ χέρας
urn:cts:greekLit:tlg0006.tlg004.fu.sp:450.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:450.1.text#πεσόντας αἰσχρῶς καὶ κακῶς λιπεῖν βίον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:451.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:451.1.text#ἀλλ' οἶσθ' ὅ μοι σύμπραξον; οὐχ ἅπασα γὰρ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:452.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:452.1.text#πέφευγεν ἐλπὶς τῶνδέ μοι σωτηρίας·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:453.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:453.1.text#ἔμ' ἔκδος Ἀργείοισιν ἀντὶ τῶνδ', ἄναξ,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:454.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:454.1.text#καὶ μήτε κινδύνευε, σωθήτω τέ μοι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:455.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:455.1.text#τέκν'· οὐ φιλεῖν δεῖ τὴν ἐμὴν ψυχήν· ἴτω.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:456.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:456.1.text#μάλιστα δ' Εὐρυσθεύς με βούλοιτ' ἂν λαβὼν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:457.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:457.1.text#τὸν Ἡράκλειον σύμμαχον καθυβρίσαι·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:458.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:458.1.text#σκαιὸς γὰρ ἁνήρ. τοῖς σοφοῖς δ' εὐκτὸν σοφῷ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:459.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:459.1.text#ἔχθραν συνάπτειν, μὴ ἀμαθεῖ φρονήματι·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:460.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:460.1.text#πολλῆς γὰρ αἰδοῦς καὶ δίκης τις ἂν τύχοι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:461.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:461.1.text#ὦ πρέσβυ, μή νυν τήνδ' ἐπαιτιῶ πόλιν·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:462.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:462.1.text#τάχ' ἂν γὰρ ἡμῖν ψευδὲς ἀλλ' ὅμως κακὸν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:463.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:463.1.text#γένοιτ' ὄνειδος ὡς ξένους προυδώκαμεν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:464.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:464.1.text#γενναῖα μὲν τάδ' εἶπας, ἀλλ' ἀμήχανα.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:465.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:465.1.text#οὐ σοῦ χατίζων δεῦρ' ἄναξ στρατηλατεῖ·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:466.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:466.1.text#τί γὰρ γέροντος ἀνδρὸς Εὐρυσθεῖ πλέον
urn:cts:greekLit:tlg0006.tlg004.fu.sp:467.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:467.1.text#θανόντος; ἀλλὰ τούσδε βούλεται κτανεῖν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:468.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:468.1.text#δεινὸν γὰρ ἐχθροῖς βλαστάνοντες εὐγενεῖς,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:469.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:469.1.text#νεανίαι τε καὶ πατρὸς μεμνημένοι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:470.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:470.1.text#λύμας· ἃ κεῖνον πάντα προσκοπεῖν χρεών.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:471.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:471.1.text#ἀλλ', εἴ τιν' ἄλλην οἶσθα καιριωτέραν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:472.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:472.1.text#βουλήν, ἑτοίμαζ', ὡς ἔγωγ' ἀμήχανος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:473.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:473.1.text#χρησμῶν ἀκούσας εἰμὶ καὶ φόβου πλέως.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:474.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:474.1.text#ξένοι, θράσος μοι μηδὲν ἐξόδοις ἐμαῖς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:475.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:475.1.text#προσθῆτε· πρῶτον γὰρ τόδ' ἐξαιτήσομαι·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:476.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:476.1.text#γυναικὶ γὰρ σιγή τε καὶ τὸ σωφρονεῖν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:477.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:477.1.text#κάλλιστον, εἴσω θ' ἥσυχον μένειν δόμων.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:478.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:478.1.text#τῶν σῶν δ' ἀκούσασ', Ἰόλεως, στεναγμάτων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:479.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:479.1.text#ἐξῆλθον, οὐ ταχθεῖσα πρεσβεύειν γένους.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:480.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:480.1.text#ἀλλ', εἰμὶ γάρ πως πρόσφορος, μέλει δέ μοι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:481.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:481.1.text#μάλιστ' ἀδελφῶν, τῶνδε κἀμαυτῆς πέρι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:482.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:482.1.text#θέλω πυθέσθαι, μὴ 'πὶ τοῖς πάλαι κακοῖς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:483.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:483.1.text#προσκείμενόν τι πῆμα σὴν δάκνει φρένα.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:484.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:484.1.text#ὦ παῖ, μάλιστα σ' οὐ νεωστὶ δὴ τέκνων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:485.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:485.1.text#τῶν Ἡρακλείων ἐνδίκως αἰνεῖν ἔχω.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:486.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:486.1.text#ἡμῖν δὲ δόξας εὖ προχωρῆσαι δρόμος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:487.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:487.1.text#πάλιν μεθέστηκ' αὖθις ἐς τἀμήχανον·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:488.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:488.1.text#χρησμῶν γὰρ ᾠδούς φησι σημαίνειν ὅδε,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:489.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:489.1.text#οὐ ταῦρον οὐδὲ μόσχον, ἀλλὰ παρθένον
urn:cts:greekLit:tlg0006.tlg004.fu.sp:490.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:490.1.text#σφάξαι Κόρῃ Δήμητρος ἥτις εὐγενής,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:491.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:491.1.text#εἰ χρὴ μὲν ἡμᾶς, χρὴ δὲ τήνδ' εἶναι πόλιν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:492.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:492.1.text#ταῦτ' οὖν ἀμηχανοῦμεν· οὔτε γὰρ τέκνα
urn:cts:greekLit:tlg0006.tlg004.fu.sp:493.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:493.1.text#σφάξειν ὅδ' αὑτοῦ φησιν οὔτ' ἄλλου τινός.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:494.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:494.1.text#κἀμοὶ λέγει μὲν οὐ σαφῶς, λέγει δέ πως,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:495.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:495.1.text#εἰ μή τι τούτων ἐξαμηχανήσομεν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:496.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:496.1.text#ἡμᾶς μὲν ἄλλην γαῖαν εὑρίσκειν τινά,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:497.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:497.1.text#αὐτὸς δὲ σῶσαι τήνδε βούλεται χθόνα.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:498.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:498.1.text#ἐν τῷδε κἀχόμεσθα σωθῆναι λόγῳ;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:499.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:499.1.text#ἐν τῷδε, τἄλλα γ' εὐτυχῶς πεπραγότες.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:500.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:500.1.text#μή νυν τρέσῃς ἔτ' ἐχθρὸν Ἀργεῖον δόρυ·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:501.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:501.1.text#ἐγὼ γὰρ αὐτὴ πρὶν κελευσθῆναι, γέρον,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:502.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:502.1.text#θνῄσκειν ἑτοίμη καὶ παρίστασθαι σφαγῇ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:503.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:503.1.text#τί φήσομεν γάρ, εἰ πόλις μὲν ἀξιοῖ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:504.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:504.1.text#κίνδυνον ἡμῶν οὕνεκ' αἴρεσθαι μέγαν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:505.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:505.1.text#αὐτοὶ δὲ προστιθέντες ἄλλοισιν πόνους,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:506.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:506.1.text#παρόν σφε σῷσαι, φευξόμεσθα μὴ θανεῖν;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:507.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:507.1.text#οὐ δῆτ', ἐπεί τοι καὶ γέλωτος ἄξια,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:508.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:508.1.text#στένειν μὲν ἱκέτας δαιμόνων καθημένους,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:509.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:509.1.text#πατρὸς δ' ἐκείνου φύντας οὗ πεφύκαμεν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:510.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:510.1.text#κακοὺς ὁρᾶσθαι· ποῦ τάδ' ἐν χρηστοῖς πρέπει;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:511.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:511.1.text#κάλλιον, οἶμαι, τῆσδ' — ἃ μὴ τύχοι ποτέ —
urn:cts:greekLit:tlg0006.tlg004.fu.sp:512.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:512.1.text#πόλεως ἁλούσης, χεῖρας εἰς ἐχθρῶν πεσεῖν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:513.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:513.1.text#{ κἄπειτα τινὰ } πατρὸς οὖσαν εὐγενοῦς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:514.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:514.1.text#παθοῦσαν Ἅιδην μηδὲν ἧσσον εἰσιδεῖν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:515.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:515.1.text#ἀλλ' ἐκπεσοῦσα τῆσδ' ἀλητεύσω χθονός;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:516.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:516.1.text#κοὐκ αἰσχυνοῦμαι δῆτ', ἐὰν δή τις λέγῃ·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:517.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:517.1.text#Τί δεῦρ' ἀφίκεσθ' ἱκεσίοισι σὺν κλάδοις
urn:cts:greekLit:tlg0006.tlg004.fu.sp:518.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:518.1.text#αὐτοὶ φιλοψυχοῦντες; ἔξιτε χθονός·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:519.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:519.1.text#κακοὺς γὰρ ἡμεῖς οὐ προσωφελήσομεν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:520.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:520.1.text#ἀλλ' οὐδὲ μέντοι, τῶνδε μὲν τεθνηκότων,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:521.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:521.1.text#αὐτὴ δὲ σωθεῖσ', ἐλπίδ' εὖ πράξειν ἔχω·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:522.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:522.1.text#— πολλοὶ γὰρ ἤδη τῇδε προύδοσαν φίλους. —
urn:cts:greekLit:tlg0006.tlg004.fu.sp:523.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:523.1.text#τίς γὰρ κόρην ἔρημον ἢ δάμαρτ' ἔχειν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:524.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:524.1.text#ἢ παιδοποιεῖν ἐξ ἐμοῦ βουλήσεται;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:525.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:525.1.text#οὐκ οὖν θανεῖν ἄμεινον ἢ τούτων τυχεῖν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:526.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:526.1.text#ἀναξίαν; ἄλλῃ δὲ κἂν πρέποι τινὶ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:527.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:527.1.text#μᾶλλον τάδ', ἥτις μὴ 'πίσημος ὡς ἐγώ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:528.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:528.1.text#ἡγεῖσθ' ὅπου δεῖ σῶμα κατθανεῖν τόδε
urn:cts:greekLit:tlg0006.tlg004.fu.sp:529.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:529.1.text#καὶ στεμματοῦτε καὶ κατάρχεσθ', εἰ δοκεῖ·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:530.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:530.1.text#νικᾶτε δ' ἐχθρούς· ἥδε γὰρ ψυχὴ πάρα
urn:cts:greekLit:tlg0006.tlg004.fu.sp:531.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:531.1.text#ἑκοῦσα κοὐκ ἄκουσα· κἀξαγγέλλομαι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:532.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:532.1.text#θνῄσκειν ἀδελφῶν τῶνδε κἀμαυτῆς ὕπερ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:533.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:533.1.text#εὕρημα γάρ τοι μὴ φιλοψυχοῦσ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:534.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:534.1.text#κάλλιστον ηὕρηκ', εὐκλεῶς λιπεῖν βίον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:535.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:535.1.text#φεῦ φεῦ, τί λέξω παρθένου μέγαν λόγον
urn:cts:greekLit:tlg0006.tlg004.fu.sp:536.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:536.1.text#κλύων, ἀδελφῶν ἣ πάρος θέλει θανεῖν;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:537.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:537.1.text#τούτων τίς ἂν λέξειε γενναίους λόγους
urn:cts:greekLit:tlg0006.tlg004.fu.sp:538.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:538.1.text#μᾶλλον, τίς ἂν δράσειεν ἀνθρώπων ἔτι;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:539.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:539.1.text#ὦ τέκνον, οὐκ ἔστ' ἄλλοθεν τὸ σὸν κάρα,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:540.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:540.1.text#ἀλλ' ἐξ ἐκείνου σπέρμα τῆς θείας φρενὸς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:541.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:541.1.text#πέφυκας Ἡράκλειος· οὐδ' αἰσχύνομαι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:542.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:542.1.text#τοῖς σοῖς λόγοισι, τῇ τύχῃ δ' ἀλγύνομαι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:543.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:543.1.text#ἀλλ' ᾗ γένοιτ' ἂν ἐνδικωτέρως φράσω·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:544.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:544.1.text#πάσας ἀδελφὰς τῆσδε δεῦρο χρὴ καλεῖν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:545.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:545.1.text#κᾆθ' ἡ λαχοῦσα θνῃσκέτω γένους ὕπερ·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:546.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:546.1.text#σὲ δ' οὐ δίκαιον κατθανεῖν ἄνευ πάλου.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:547.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:547.1.text#οὐκ ἂν θάνοιμι τῇ τύχῃ λαχοῦσ' ἐγώ·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:548.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:548.1.text#χάρις γὰρ οὐ πρόσεστι· μὴ λέξῃς, γέρον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:549.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:549.1.text#ἀλλ', εἰ μὲν ἐνδέχεσθε καὶ βούλεσθέ μοι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:550.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:550.1.text#χρῆσθαι προθύμως, τὴν ἐμὴν ψυχὴν ἐγὼ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:551.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:551.1.text#δίδωμ' ἑκοῦσα τοῖσδ', ἀναγκασθεῖσα δ' οὔ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:552.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:552.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:553.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:553.1.text#ὅδ' αὖ λόγος σοι τοῦ πρὶν εὐγενέστερος·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:554.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:554.1.text#κἀκεῖνος ἦν ἄριστος· ἀλλ' ὑπερφέρεις
urn:cts:greekLit:tlg0006.tlg004.fu.sp:555.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:555.1.text#τόλμῃ τε τόλμαν καὶ λόγῳ χρηστῷ λόγον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:556.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:556.1.text#οὐ μὴν κελεύω γ' οὐδ' ἀπεννέπω, τέκνον,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:557.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:557.1.text#θνῄσκειν σ'· ἀδελφοὺς δ' ὠφελεῖς θανοῦσα σούς.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:558.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:558.1.text#σοφῶς κελεύεις· μὴ τρέσῃς μιάσματος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:559.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:559.1.text#τοὐμοῦ μετασχεῖν, ἀλλ' ἐλευθέρως θάνω.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:560.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:560.1.text#ἕπου δέ, πρέσβυ· σῇ γὰρ ἐνθανεῖν χερὶ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:561.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:561.1.text#θέλω· πέπλοις δὲ σῶμ' ἐμὸν κρύψον παρών·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:562.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:562.1.text#ἐπεὶ σφαγῆς γε πρὸς τὸ δεινὸν εἶμ' ἐγώ,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:563.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:563.1.text#εἴπερ πέφυκα πατρὸς οὗπερ εὔχομαι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:564.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:564.1.text#οὐκ ἂν δυναίμην σῷ παρεστάναι μόρῳ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:565.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:565.1.text#σὺ δ' ἀλλὰ τοῦδε χρῇζε, μή μ' ἐν ἀρσένων,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:566.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:566.1.text#ἀλλ' ἐν γυναικῶν, χερσὶν ἐκπνεῦσαι βίον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:567.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:567.1.text#ἔσται τάδ', ὦ τάλαινα παρθένων, ἐπεὶ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:568.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:568.1.text#κἀμοὶ τόδ' αἰσχρόν, μή σε κοσμεῖσθαι καλῶς,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:569.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:569.1.text#πολλῶν ἕκατι, τῆς τε σῆς εὐψυχίας
urn:cts:greekLit:tlg0006.tlg004.fu.sp:570.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:570.1.text#καὶ τοῦ δικαίου· τλημονεστάτην δὲ σὲ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:571.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:571.1.text#πασῶν γυναικῶν εἶδον ὀφθαλμοῖς ἐγώ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:572.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:572.1.text#ἀλλ', εἴ τι βούλῃ, τούσδε τὸν γέροντά τε
urn:cts:greekLit:tlg0006.tlg004.fu.sp:573.1.speaker#Δημοφῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:573.1.text#χώρει προσειποῦσ' ὑστάτοις προσφθέγμασιν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:574.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:574.1.text#ὦ χαῖρε, πρέσβυ, χαῖρε καὶ δίδασκέ μοι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:575.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:575.1.text#τοιούσδε τούσδε παῖδας, ἐς τὸ πᾶν σοφούς,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:576.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:576.1.text#ὥσπερ σύ, μηδὲν μᾶλλον· ἀρκέσουσι γάρ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:577.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:577.1.text#πειρῶ δὲ σῶσαι μὴ θανεῖν, πρόθυμος ὤν·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:578.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:578.1.text#σοὶ παῖδές ἐσμεν, σαῖν χεροῖν τεθράμμεθα.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:579.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:579.1.text#ὁρᾷς δὲ κἀμὲ τὴν ἐμὴν ὥραν γάμου
urn:cts:greekLit:tlg0006.tlg004.fu.sp:580.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:580.1.text#διδοῦσαν ἀντὶ τῶνδε κατθανουμένην.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:581.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:581.1.text#ὑμεῖς τ', ἀδελφῶν ἡ παροῦσ' ὁμιλία,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:582.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:582.1.text#εὐδαιμονοῖτε, καὶ γένοιθ' ὑμῖν ὅσων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:583.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:583.1.text#ἡμὴ πάροιθε καρδία σφαγήσεται.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:584.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:584.1.text#καὶ τὸν γέροντα τήν τ' ἔσω γραῖαν δόμων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:585.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:585.1.text#τιμᾶτε πατρὸς μητέρ' Ἀλκμήνην ἐμοῦ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:586.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:586.1.text#ξένους τε τούσδε. κἂν ἀπαλλαγὴ πόνων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:587.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:587.1.text#καὶ νόστος ὑμῖν εὑρεθῇ ποτ' ἐκ θεῶν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:588.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:588.1.text#μέμνησθε τὴν σώτειραν ὡς θάψαι χρεών.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:589.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:589.1.text#κάλλιστά τοι δίκαιον· οὐ γὰρ ἐνδεὴς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:590.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:590.1.text#ὑμῖν παρέστην, ἀλλὰ προύθανον γένους.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:591.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:591.1.text#τάδ' ἀντὶ παίδων ἐστί μοι κειμήλια
urn:cts:greekLit:tlg0006.tlg004.fu.sp:592.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:592.1.text#καὶ παρθενείας, εἴ τι δὴ κάτω χθονός·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:593.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:593.1.text#εἴη γε μέντοι μηδέν. εἰ γὰρ ἕξομεν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:594.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:594.1.text#κἀκεῖ μερίμνας οἱ θανούμενοι βροτῶν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:595.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:595.1.text#οὐκ οἶδ' ὅποι τις τρέψεται· τὸ γὰρ θανεῖν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:596.1.speaker#Μακαρία
urn:cts:greekLit:tlg0006.tlg004.fu.sp:596.1.text#κακῶν μέγιστον φάρμακον νομίζεται.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:597.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:597.1.text#ἀλλ', ὦ μέγιστον ἐκπρέπουσ' εὐψυχίᾳ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:598.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:598.1.text#πασῶν γυναικῶν, ἴσθι, τιμιωτάτη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:599.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:599.1.text#καὶ ζῶσ' ὑφ' ἡμῶν καὶ θανοῦσ' ἔσῃ πολύ·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:600.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:600.1.text#καὶ χαῖρε· δυσφημεῖν γὰρ ἅζομαι θεάν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:601.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:601.1.text#ᾗ σὸν κατῆρκται σῶμα, Δήμητρος κόρην.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:602.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:602.1.text#ὦ παῖδες, οἰχόμεσθα· λύεται μέλη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:603.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:603.1.text#λύπῃ· λάβεσθε κεἰς ἕδραν μ' ἐρείσατε
urn:cts:greekLit:tlg0006.tlg004.fu.sp:604.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:604.1.text#αὐτοῦ πέπλοισι τοῖσδε κρύψαντες, τέκνα.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:605.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:605.1.text#ὡς οὔτε τούτοις ἥδόμαι πεπραγμένοις,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:606.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:606.1.text#χρησμοῦ τε μὴ κρανθέντος οὐ βιώσιμον·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:607.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:607.1.text#μείζων γὰρ ἄτη· συμφορὰ δὲ καὶ τάδε. [ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:608.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:608.1.text#οὔτινά φημι θεῶν ἄτερ ὄλβιον, οὐ βαρύποτμον,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:609.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:609.1.text#ἄνδρα γενέσθαι·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:610.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:610.1.text#οὐδὲ τὸν αὐτὸν ἀεὶ βεβάναι δόμον
urn:cts:greekLit:tlg0006.tlg004.fu.sp:611.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:611.1.text#εὐτυχίᾳ· παρὰ δ' ἄλλαν ἄλλα
urn:cts:greekLit:tlg0006.tlg004.fu.sp:612.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:612.1.text#μοῖρα διώκει.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:613.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:613.1.text#τὸν μὲν ἀφ' ὑψηλῶν βραχὺν ᾤκισε,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:614.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:614.1.text#τὸν δ' ἀλέταν εὐδαίμονα τεύχει.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:615.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:615.1.text#μόρσιμα δ' οὔτι φυγεῖν θέμις, οὐ σοφίᾳ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:616.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:616.1.text# τις ἀπώσεται, ἀλλὰ μάταν ὁ πρόθυμος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:617.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:617.1.text# ἀεὶ πόνον ἕξει.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:618.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:618.1.text#ἀλλὰ σὺ μὴ προπίτνων τὰ θεῶν φέρε, μηδ' ὑπεράλγει
urn:cts:greekLit:tlg0006.tlg004.fu.sp:620.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:620.1.text#φροντίδα λύπᾳ·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:621.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:621.1.text#εὐδόκιμον γὰρ ἔχει θανάτου μέρος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:622.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:622.1.text#ἁ μελέα πρό τ' ἀδελφῶν καὶ γᾶς·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:623.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:623.1.text#οὐδ' ἀκλεής νιν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:624.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:624.1.text#δόξα πρὸς ἀνθρώπων ὑποδέξεται·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:625.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:625.1.text#ἁ δ' ἀρετὰ βαίνει διὰ μόχθων.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:626.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:626.1.text#ἄξια μὲν πατρός, ἄξια δ' εὐγενίας
urn:cts:greekLit:tlg0006.tlg004.fu.sp:627.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:627.1.text# τάδε γίγνεται· εἰ δὲ σέβεις θανάτους
urn:cts:greekLit:tlg0006.tlg004.fu.sp:628.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:628.1.text# ἀγαθῶν, μετέχω σοι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:629.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:629.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:629a.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:629a.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:629b.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:629b.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:629c.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:629c.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:630.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:630.1.text#ὦ τέκνα, χαίρετ'· Ἰόλεως δὲ ποῦ γέρων;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:631.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:631.1.text#μήτηρ τε πατρὸς τῆσδ' ἕδρας ἀποστατεῖ;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:632.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:632.1.text#πάρεσμεν, οἵα δή γ' ἐμοῦ παρουσία.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:633.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:633.1.text#τί χρῆμα κεῖσαι καὶ κατηφὲς ὄμμ' ἔχεις;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:634.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:634.1.text#φροντίς τις ἦλθ' οἰκεῖος, ᾗ συνειχόμην.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:635.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:635.1.text#ἔπαιρέ νυν σεαυτόν, ὄρθωσον κάρα.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:636.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:636.1.text#γέροντές ἐσμεν κοὐδαμῶς ἐρρώμεθα.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:637.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:637.1.text#ἥκω γε μέντοι χάρμα σοι φέρων μέγα.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:638.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:638.1.text#τίς δ' εἶ σύ; ποῦ σοι συντυχὼν ἀμνημονῶ;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:639.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:639.1.text#Ὕλλου πενέστης· οὔ με γιγνώσκεις ὁρῶν;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:640.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:640.1.text#ὦ φίλταθ', ἥκεις ἆρα σωτὴρ νῷν βλάβης;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:641.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:641.1.text#μάλιστα· καὶ πρός γ' εὐτυχεῖς τὰ νῦν τάδε.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:642.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:642.1.text#ὦ μῆτερ ἐσθλοῦ παιδός, Ἀλκμήνην λέγω,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:643.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:643.1.text#ἔξελθ', ἄκουσον τοῦδε φιλτάτους λόγους.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:644.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:644.1.text#πάλαι γὰρ ὠδίνουσα τῶν ἀφιγμένων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:645.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:645.1.text#ψυχὴν ἐτήκου νόστος εἰ γενήσεται.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:646.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:646.1.text#τί χρῆμ' ἀϋτῆς πᾶν τόδ' ἐπλήσθη στέγος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:647.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:647.1.text#Ἰόλαε; μῶν τίς σ' αὖ βιάζεται παρὼν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:648.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:648.1.text#κῆρυξ ἀπ' Ἄργους; ἀσθενὴς μὲν ἥ γ' ἐμὴ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:649.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:649.1.text#ῥώμη, τοσόνδε δ' εἰδέναι σ' ἐχρῆν, ξένε,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:650.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:650.1.text#οὐκ ἔστ' ἄγειν σε τούσδ' ἐμοῦ ζώσης ποτέ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:651.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:651.1.text#ἦ τἄρ' ἐκείνου μὴ νομιζοίμην ἐγὼ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:652.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:652.1.text#μήτηρ ἔτ'· εἰ δὲ τῶνδε προσθίξῃ χερί,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:653.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:653.1.text#δυοῖν γερόντοιν οὐ καλῶς ἀγωνιῇ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:654.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:654.1.text#θάρσει, γεραιά, μὴ τρέσῃς· οὐκ Ἀργόθεν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:655.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:655.1.text#κῆρυξ ἀφῖκται πολεμίους λόγους ἔχων.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:656.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:656.1.text#τί γὰρ βοὴν ἔστησας ἄγγελον φόβου;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:657.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:657.1.text#σέ, πρόσθε ναοῦ τοῦδ' ὅπως βαίης πέλας.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:658.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:658.1.text#οὐκ ἴσμεν ἡμεῖς ταῦτα· τίς γάρ ἐσθ' ὅδε;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:659.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:659.1.text#ἥκοντα παῖδα παιδὸς ἀγγέλλει σέθεν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:660.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:660.1.text#ὦ χαῖρε καὶ σὺ τοῖσδε τοῖς ἀγγέλμασιν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:661.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:661.1.text#ἀτὰρ τί χώρᾳ τῇδε προσβαλὼν πόδα
urn:cts:greekLit:tlg0006.tlg004.fu.sp:662.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:662.1.text#ποῦ νῦν ἄπεστι; τίς νιν εἶργε συμφορὰ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:663.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:663.1.text#σὺν σοὶ φανέντα δεῦρ' ἐμὴν τέρψαι φρένα;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:664.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:664.1.text#στρατὸν καθίζει τάσσεταί θ' ὃν ἦλθ' ἔχων.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:665.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:665.1.text#τοῦδ' οὐκέθ' ἡμῖν τοῦ λόγου μέτεστι δή.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:666.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:666.1.text#μέτεστιν· ἡμῶν δ' ἔργον ἱστορεῖν τάδε.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:667.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:667.1.text#τί δῆτα βούλῃ τῶν πεπραγμένων μαθεῖν;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:668.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:668.1.text#πόσον τι πλῆθος συμμάχων πάρεστ' ἔχων;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:669.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:669.1.text#πολλούς· ἀριθμὸν δ' ἄλλον οὐκ ἔχω φράσαι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:670.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:670.1.text#ἴσασιν, οἶμαι, ταῦτ'· Ἀθηναίων πρόμοι;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:671.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:671.1.text#ἴσασι· καὶ δὴ λαιὸν ἕστηκεν κέρας.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:672.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:672.1.text#ἤδη γὰρ ὡς ἐς ἔργον ὥπλισται στρατός;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:673.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:673.1.text#καὶ δὴ παρῆκται σφάγια τάξεων ἑκάς.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:674.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:674.1.text#πόσον τι δ' ἔστ' ἄπωθεν Ἀργεῖον δόρυ;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:675.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:675.1.text#ὥστ' ἐξορᾶσθαι τὸν στρατηγὸν ἐμφανῶς.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:676.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:676.1.text#τί δρῶντα; μῶν τάσσοντα πολεμίων στίχας;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:677.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:677.1.text#ᾐκάζομεν ταῦτ'· οὐ γὰρ ἐξηκούομεν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:678.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:678.1.text#ἀλλ' εἶμ'· ἐρήμους δεσπότας τοὐμὸν μέρος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:679.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:679.1.text#οὐκ ἂν θέλοιμι πολεμίοισι συμβαλεῖν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:680.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:680.1.text#κἄγωγε σὺν σοί· ταὐτὰ γὰρ φροντίζομεν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:681.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:681.1.text#φίλοις παρόντες, ὡς ἔοιγμεν, ὠφελεῖν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:682.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:682.1.text#ἥκιστα πρὸς σοῦ μῶρον ἦν εἰπεῖν ἔπος.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:683.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:683.1.text#καὶ μὴ μετασχεῖν γ' ἀλκίμου μάχης φίλοις.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:684.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:684.1.text#οὐκ ἔστ' ἐν ὄψει τραῦμα μὴ δρώσης χερός.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:685.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:685.1.text#τί δ'; οὐ σθένοιμι κἂν ἐγὼ δι' ἀσπίδος;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:686.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:686.1.text#σθένοις ἄν, ἀλλὰ πρόσθεν αὐτὸς ἂν πέσοις.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:687.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:687.1.text#οὐδεὶς ἔμ' ἐχθρῶν προσβλέπων ἀνέξεται.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:688.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:688.1.text#οὐκ ἔστιν, ὦ τᾶν, ἥ ποτ' ἦν ῥώμη σέθεν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:689.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:689.1.text#ἀλλ' οὖν μαχοῦνται γ' ἀριθμὸν οὐκ ἐλάσσοσι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:690.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:690.1.text#σμικρὸν τὸ σὸν σήκωμα προστίθης φίλοις.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:691.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:691.1.text#μή τοί μ' ἔρυκε δρᾶν παρεσκευασμένον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:692.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:692.1.text#δρᾶν μὲν σύ γ' οὐχ οἷός τε, βούλεσθαι δ' ἴσως.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:693.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:693.1.text#ὡς μὴ μενοῦντα τἄλλα σοι λέγειν πάρα.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:694.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:694.1.text#πῶς οὖν ὁπλίταις τευχέων ἄτερ φανῇ;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:695.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:695.1.text#ἔστ' ἐν δόμοισιν ἔνδον αἰχμάλωθ' ὅπλα,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:696.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:696.1.text#τοῖς δ' οὖσι χρησόμεσθα· κἀποδώσομεν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:697.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:697.1.text#ζῶντες, θανόντας δ' οὐκ ἀπαιτήσει θεός.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:698.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:698.1.text#ἀλλ' εἴσιθ' εἴσω κἀπὸ πασσάλων ἑλὼν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:699.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:699.1.text#ἔνεγχ' ὁπλίτην κόσμον ὡς τάχιστά μοι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:700.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:700.1.text#αἰσχρὸν γὰρ οἰκούρημα γίγνεται τόδε,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:701.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:701.1.text#τοὺς μὲν μάχεσθαι, τοὺς δὲ δειλίᾳ μένειν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:702.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:702.1.text#λῆμα μὲν οὔπω στόρνυσι χρόνος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:703.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:703.1.text#τὸ σόν, ἀλλ' ἡβᾷ, σῶμα δὲ φροῦδον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:704.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:704.1.text#τί πονεῖς ἄλλως ἃ σὲ μὲν βλάψει,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:705.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:705.1.text#σμικρὰ δ' ὀνήσει πόλιν ἡμετέραν;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:706.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:706.1.text#χρὴ γνωσιμαχεῖν τὴν ἡλικίαν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:707.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:707.1.text#τὰ δ' ἀμήχαν' ἐᾶν· οὐκ ἔστιν ὅπως
urn:cts:greekLit:tlg0006.tlg004.fu.sp:708.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:708.1.text#ἥβην κτήσῃ πάλιν αὖθις.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:709.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:709.1.text#τί χρῆμα μέλλεις σῶν φρενῶν οὐκ ἔνδον ὢν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:710.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:710.1.text#λιπεῖν μ' ἔρημον σὺν τέκνοις ἐμοῖς; [ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:711.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:711.1.text#ἀνδρῶν γὰρ ἀλκή· σοὶ δὲ χρῆν τούτων μέλειν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:712.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:712.1.text#τί δ'; ἢν θάνῃς σύ, πῶς ἐγὼ σωθήσομαι;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:713.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:713.1.text#παιδὸς μελήσει παισὶ τοῖς λελειμμένοις.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:714.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:714.1.text#ἢν δ' οὖν, ὃ μὴ γένοιτο, χρήσωνται τύχῃ;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:715.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:715.1.text#οἵδ' οὐ προδώσουσίν σε, μὴ τρέσῃς, ξένοι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:716.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:716.1.text#τοσόνδε γάρ τοι θάρσος, οὐδὲν ἄλλ' ἔχω.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:717.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:717.1.text#καὶ Ζηνὶ τῶν σῶν, οἶδ' ἐγώ, μέλει πόνων.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:718.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:718.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:718a.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:718a.1.text#Ζεὺς ἐξ ἐμοῦ μὲν οὐκ ἀκούσεται κακῶς·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:719.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:719.1.text#εἰ δ' ἐστὶν ὅσιος αὐτὸς οἶδεν εἰς ἐμέ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:720.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:720.1.text#ὅπλων μὲν ἤδη τήνδ' ὁρᾷς παντευχίαν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:721.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:721.1.text#φθάνοις δ' ἂν οὐκ ἂν τοῖσδε συγκρύπτων δέμας·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:722.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:722.1.text#ὡς ἐγγὺς ἁγών, καὶ μάλιστ' Ἄρης στυγεῖ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:723.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:723.1.text#μέλλοντας· εἰ δὲ τευχέων φοβῇ βάρος,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:724.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:724.1.text#νῦν μὲν πορεύου γυμνός, ἐν δὲ τάξεσιν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:725.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:725.1.text#κόσμῳ πυκάζου τῷδ'· ἐγὼ δ' οἴσω τέως.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:726.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:726.1.text#καλῶς ἔλεξας· ἀλλ' ἐμοὶ πρόχειρ' ἔχων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:727.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:727.1.text#τεύχη κόμιζε, χειρὶ δ' ἔνθες ὀξύην,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:728.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:728.1.text#λαιόν τ' ἔπαιρε πῆχυν, εὐθύνων πόδα.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:729.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:729.1.text#ἦ παιδαγωγεῖν γὰρ τὸν ὁπλίτην χρεών;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:730.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:730.1.text#ὄρνιθος οὕνεκ' ἀσφαλῶς πορευτέον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:731.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:731.1.text#εἴθ' ἦσθα δυνατὸς δρᾶν ὅσον πρόθυμος εἶ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:732.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:732.1.text#ἔπειγε· λειφθεὶς δεινὰ πείσομαι μάχης.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:733.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:733.1.text#σύ τοι βραδύνεις, οὐκ ἐγὼ δοκῶ τι δρᾶν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:734.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:734.1.text#οὔκουν ὁρᾷς μου κῶλον ὡς ἐπείγεται;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:735.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:735.1.text#ὁρῶ δοκοῦντα μᾶλλον ἢ σπεύδοντά σε.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:736.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:736.1.text#οὐ ταῦτα λέξεις, ἡνίκ' ἂν λεύσσῃς μ' ἐκεῖ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:737.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:737.1.text#τί δρῶντα; βουλοίμην δ' ἂν εὐτυχοῦντά γε.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:738.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:738.1.text#δι' ἀσπίδος θείνοντα πολεμίων τινά.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:739.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:739.1.text#εἰ δή ποθ' ἥξομέν γε· τοῦτο γὰρ φόβος.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:740.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:740.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:740a.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:740a.1.text#εἴθ', ὦ βραχίων, οἷον ἡβήσαντά σε
urn:cts:greekLit:tlg0006.tlg004.fu.sp:741.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:741.1.text#μεμνήμεθ' ἡμεῖς, ἡνίκα ξὺν Ἡρακλεῖ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:742.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:742.1.text#Σπάρτην ἐπόρθεις, σύμμαχος γένοιό μοι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:743.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:743.1.text#τοιοῦτος· οἵαν ἂν τροπὴν Εὐρυσθέως
urn:cts:greekLit:tlg0006.tlg004.fu.sp:744.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:744.1.text#θείμην· ἐπεί τοι καὶ κακὸς μένειν δόρυ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:745.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:745.1.text#ἔστιν δ' ἐν ὄλβῳ καὶ τόδ' οὐκ ὀρθῶς ἔχον,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:746.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:746.1.text#εὐψυχίας δόκησις· οἰόμεσθα γὰρ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:747.1.speaker#Ἰόλαος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:747.1.text#τὸν εὐτυχοῦντα πάντ' ἐπίστασθαι καλῶς.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:748.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:748.1.text#Γᾶ καὶ παννύχιος σελάνα
urn:cts:greekLit:tlg0006.tlg004.fu.sp:749.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:749.1.text# καὶ λαμπρόταται θεοῦ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:750.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:750.1.text#φαεσίμβροτοι αὐγαί,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:751.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:751.1.text#ἀγγελίαν μοι ἐνέγκαιτ'·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:752.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:752.1.text#ἰαχήσατε δ' οὐρανῷ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:753.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:753.1.text#καὶ παρὰ θρόνον ἀρχέταν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:754.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:754.1.text#γλαυκᾶς ἐν Ἀθάνας.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:755.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:755.1.text#μέλλω τᾶς πατριώτιδος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:756.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:756.1.text#γᾶς, μέλλω καὶ ὑπὲρ δόμων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:757.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:757.1.text#ἱκέτας ὑποδεχθεὶς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:758.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:758.1.text#κίνδυνον πολιῷ τεμεῖν σιδάρῳ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:759.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:759.1.text#δεινὸν μὲν πόλιν ὡς Μυκήνας
urn:cts:greekLit:tlg0006.tlg004.fu.sp:760.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:760.1.text# εὐδαίμονα καὶ δορὸς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:761.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:761.1.text#πολυαίνετον ἀλκᾷ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:762.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:762.1.text#μῆνιν ἐμᾷ χθονὶ κεύθειν·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:763.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:763.1.text#κακὸν δ', ὦ πόλις, εἰ ξένους
urn:cts:greekLit:tlg0006.tlg004.fu.sp:764.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:764.1.text#ἱκτῆρας παραδώσομεν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:765.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:765.1.text#κελεύμασιν Ἄργους.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:766.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:766.1.text#Ζεύς μοι σύμμαχος, οὐ φοβοῦμαι,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:767.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:767.1.text# Ζεύς μοι χάριν ἐνδίκως
urn:cts:greekLit:tlg0006.tlg004.fu.sp:768.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:768.1.text#ἔχει· οὔποτε θνατῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:769.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:769.1.text#ἥσσους { δαίμονες } ἔκ γ' ἐμοῦ φανοῦνται.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:770.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:770.1.text#ἀλλ', ὦ πότνια — σὸν γὰρ οὖδας
urn:cts:greekLit:tlg0006.tlg004.fu.sp:771.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:771.1.text# [ γᾶς ], σὸν καὶ πόλις, ἇς σὺ μάτηρ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:772.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:772.1.text# δέσποινά τε καὶ φύλαξ —
urn:cts:greekLit:tlg0006.tlg004.fu.sp:773.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:773.1.text#πόρευσον ἄλλᾳ τὸν οὐ δικαίως
urn:cts:greekLit:tlg0006.tlg004.fu.sp:774.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:774.1.text#τᾷδ' ἐπάγοντα δορυσσοῦν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:775.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:775.1.text#στρατὸν Ἀργόθεν· οὐ γὰρ ἐμᾷ γ' ἀρετᾷ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:776.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:776.1.text#δίκαιός εἰμ' ἐκπεσεῖν μελάθρων.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:777.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:777.1.text#ἐπεί σοι πολύθυτος ἀεὶ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:778.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:778.1.text#τιμὰ κραίνεται, οὐδὲ λάθει
urn:cts:greekLit:tlg0006.tlg004.fu.sp:779.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:779.1.text# μηνῶν φθινὰς ἁμέρα,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:780.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:780.1.text#νέων τ' ἀοιδαὶ χορῶν τε μολπαί.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:781.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:781.1.text#ἀνεμόεντι δ' ἐπ' ὄχθῳ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:782.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:782.1.text#ὀλολύγματα παννυχίοις ὑπὸ παρθένων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:783.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:783.1.text# ἰαχεῖ ποδῶν κρότοισιν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:784.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:784.1.text#δέσποινα, μύθους σοί τε συντομωτάτους
urn:cts:greekLit:tlg0006.tlg004.fu.sp:785.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:785.1.text#{ κλύειν ἐμοί τε τῷδε καλλίστους φέρω. }
urn:cts:greekLit:tlg0006.tlg004.fu.sp:786.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:786.1.text#νικῶμεν ἐχθροὺς καὶ τροπαῖ' ἱδρύεται
urn:cts:greekLit:tlg0006.tlg004.fu.sp:787.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:787.1.text#παντευχίαν ἔχοντα πολεμίων σέθεν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:788.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:788.1.text#ὦ φίλταθ', ἥδε σ' ἡμέρα διήλασεν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:789.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:789.1.text#ἐλευθερῶσαι τοῖσδε τοῖς ἀγγέλμασιν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:790.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:790.1.text#μιᾶς δ' ἔμ' οὔπω συμφορᾶς ἐλευθεροῖς·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:791.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:791.1.text#φόβος γὰρ εἴ μοι ζῶσιν οὓς ἐγὼ θέλω.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:792.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:792.1.text#ζῶσιν μέγιστόν γ' εὐκλεεῖς κατὰ στρατόν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:793.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:793.1.text#ὁ μὲν γέρων οὐκ ἔστιν Ἰόλεως ὅδε;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:794.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:794.1.text#μάλιστα, πράξας δ' ἐκ θεῶν κάλλιστα δή.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:795.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:795.1.text#τί δ' ἔστι; μῶν τι κεδνὸν ἠγωνίζετο;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:796.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:796.1.text#νέος μεθέστηκ' ἐκ γέροντος αὖθις αὖ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:797.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:797.1.text#θαυμάστ' ἔλεξας· ἀλλά σ' εὐτυχῆ φίλων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:798.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:798.1.text#μάχης ἀγῶνα πρῶτον ἀγγεῖλαι θέλω.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:799.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:799.1.text#εἷς μου λόγος σοι πάντα σημανεῖ τάδε.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:800.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:800.1.text#ἐπεὶ γὰρ ἀλλήλοισιν ὁπλίτην στρατὸν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:801.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:801.1.text#κατὰ στόμ' ἐκτείνοντες ἀντετάξαμεν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:802.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:802.1.text#ἐκβὰς τεθρίππων Ὕλλος ἁρμάτων πόδα
urn:cts:greekLit:tlg0006.tlg004.fu.sp:803.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:803.1.text#ἔστη μέσοισιν ἐν μεταιχμίοις δορός.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:804.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:804.1.text#κἄπειτ' ἔλεξεν· Ὦ στρατήγ' ὃς Ἀργόθεν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:805.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:805.1.text#ἥκεις, τί τήνδε γαῖαν οὐκ εἰάσαμεν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:805a.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:805a.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:805b.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:805b.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:806.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:806.1.text#καὶ τὰς Μυκήνας οὐδὲν ἐργάσῃ κακὸν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:807.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:807.1.text#ἀνδρὸς στερήσας· ἀλλ' ἐμοὶ μόνος μόνῳ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:808.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:808.1.text#μάχην συνάψας, ἢ κτανὼν ἄγου λαβὼν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:809.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:809.1.text#τοὺς Ἡρακλείους παῖδας ἢ θανὼν ἐμοὶ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:810.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:810.1.text#τιμὰς πατρῴους καὶ δόμους ἔχειν ἄφες.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:811.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:811.1.text#στρατὸς δ' ἐπῄνεσ', ἔς τ' ἀπαλλαγὰς πόνων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:812.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:812.1.text#καλῶς λελέχθαι μῦθον ἔς τ' εὐψυχίαν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:813.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:813.1.text#ὃ δ' οὔτε τοὺς κλύοντας αἰδεσθεὶς λόγων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:814.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:814.1.text#οὔτ' αὐτὸς αὑτοῦ δειλίαν στρατηγὸς ὢν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:815.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:815.1.text#ἐλθεῖν ἐτόλμησ' ἐγγὺς ἀλκίμου δορός,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:816.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:816.1.text#ἀλλ' ἦν κάκιστος· εἶτα τοιοῦτος γεγὼς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:817.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:817.1.text#τοὺς Ἡρακλείους ἦλθε δουλώσων γόνους.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:818.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:818.1.text#Ὕλλος μὲν οὖν ἀπῴχετ' ἐς τάξιν πάλιν·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:819.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:819.1.text#μάντεις δ', ἐπειδὴ μονομάχου δι' ἀσπίδος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:820.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:820.1.text#διαλλαγὰς ἔγνωσαν οὐ τελουμένας,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:821.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:821.1.text#ἔσφαζον, οὐκ ἔμελλον, ἀλλ' ἀφίεσαν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:822.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:822.1.text#λαιμῶν { βροτείων } εὐθὺς οὔριον φόνον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:823.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:823.1.text#οἳ δ' ἅρματ' εἰσέβαινον, οἳ δ' ὑπ' ἀσπίδων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:824.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:824.1.text#πλευροῖς ἔκρυπτον πλεύρ'· Ἀθηναίων δ' ἄναξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:825.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:825.1.text#στρατῷ παρήγγελλ' οἷα χρὴ τὸν εὐγενῆ·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:826.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:826.1.text#Ὦ ξυμπολῖται, τῇ τε βοσκούσῃ χθονὶ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:827.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:827.1.text#καὶ τῇ τεκούσῃ νῦν τιν' ἀρκέσαι χρεών.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:828.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:828.1.text#ὃ δ' αὖ τό τ' Ἄργος μὴ καταισχῦναι θέλειν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:829.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:829.1.text#καὶ τὰς Μυκήνας συμμάχους ἐλίσσετο.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:830.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:830.1.text#ἐπεὶ δ' ἐσήμην' ὄρθιον Τυρσηνικῇ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:831.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:831.1.text#σάλπιγγι καὶ συνῆψαν ἀλλήλοις μάχην,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:832.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:832.1.text#πόσον τιν' αὐχεῖς πάταγον ἀσπίδων βρέμειν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:833.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:833.1.text#πόσον τινὰ στεναγμὸν οἰμωγήν θ' ὁμοῦ;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:834.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:834.1.text#τὰ πρῶτα μέν νυν πίτυλος Ἀργείου δορὸς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:835.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:835.1.text#ἐρρήξαθ' ἡμᾶς· εἶτ' ἐχώρησαν πάλιν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:836.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:836.1.text#τὸ δεύτερον δὲ ποὺς ἐπαλλαχθεὶς ποδί,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:837.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:837.1.text#ἀνὴρ δ' ἐπ' ἀνδρὶ στάς, ἐκαρτέρει μάχη·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:838.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:838.1.text#πολλοὶ δ' ἔπιπτον. ἦν δὲ τοῦ κελεύματος·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:839.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:839.1.text#Ὦ τὰς Ἀθήνας — Ὦ τὸν Ἀργείων γύην
urn:cts:greekLit:tlg0006.tlg004.fu.sp:840.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:840.1.text#σπείροντες — οὐκ ἀρήξετ' αἰσχύνην πόλει;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:841.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:841.1.text#μόλις δὲ πάντα δρῶντες οὐκ ἄτερ πόνων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:842.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:842.1.text#ἐτρεψάμεσθ' Ἀργεῖον ἐς φυγὴν δόρυ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:843.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:843.1.text#κἀνταῦθ' ὁ πρέσβυς Ὕλλον ἐξορμώμενον
urn:cts:greekLit:tlg0006.tlg004.fu.sp:844.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:844.1.text#ἰδών, ὀρέξας ἱκέτευσε δεξιὰν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:845.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:845.1.text#Ἰόλαος ἐμβῆσαί νιν ἵππειον δίφρον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:846.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:846.1.text#λαβὼν δὲ χερσὶν ἡνίας Εὐρυσθέως
urn:cts:greekLit:tlg0006.tlg004.fu.sp:847.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:847.1.text#πώλοις ἐπεῖχε. τἀπὸ τοῦδ' ἤδη κλύων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:848.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:848.1.text#λέγοιμ' ἂν ἄλλων, δεῦρο δ' αὐτὸς εἰσιδών.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:849.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:849.1.text#Παλληνίδος γὰρ σεμνὸν ἐκπερῶν πάγον
urn:cts:greekLit:tlg0006.tlg004.fu.sp:850.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:850.1.text#δίας Ἀθάνας, ἅρμ' ἰδὼν Εὐρυσθέως,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:851.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:851.1.text#ἠράσαθ' Ἥβῃ Ζηνί θ', ἡμέραν μίαν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:852.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:852.1.text#νέος γενέσθαι κἀποτείσασθαι δίκην
urn:cts:greekLit:tlg0006.tlg004.fu.sp:853.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:853.1.text#ἐχθρούς. κλύειν δὴ θαύματος πάρεστί σοι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:854.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:854.1.text#δισσὼ γὰρ ἀστέρ' ἱππικοῖς ἐπὶ ζυγοῖς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:855.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:855.1.text#σταθέντ' ἔκρυψαν ἅρμα λυγαίῳ νέφει·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:856.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:856.1.text#σὸν δὴ λέγουσι παῖδά γ' οἱ σοφώτεροι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:857.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:857.1.text#Ἥβην θ'· ὃ δ' ὄρφνης ἐκ δυσαιθρίου νέων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:858.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:858.1.text#βραχιόνων ἔδειξεν ἡβητὴν τύπον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:859.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:859.1.text#αἱρεῖ δ' ὁ κλεινὸς  Ἰόλεως Εὐρυσθέως
urn:cts:greekLit:tlg0006.tlg004.fu.sp:860.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:860.1.text#τέτρωρον ἅρμα πρὸς πέτραις Σκιρωνίσιν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:861.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:861.1.text#δεσμοῖς τε δήσας χεῖρας ἀκροθίνιον
urn:cts:greekLit:tlg0006.tlg004.fu.sp:862.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:862.1.text#κάλλιστον ἥκει τὸν στρατηλάτην ἄγων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:863.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:863.1.text#τὸν ὄλβιον πάροιθε. τῇ δὲ νῦν τύχῃ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:864.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:864.1.text#βροτοῖς ἅπασι λαμπρὰ κηρύσσει μαθεῖν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:865.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:865.1.text#τὸν εὐτυχεῖν δοκοῦντα μὴ ζηλοῦν, πρὶν ἂν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:866.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:866.1.text#θανόντ' ἴδῃ τις· ὡς ἐφήμεροι τύχαι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:867.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:867.1.text#ὦ Ζεῦ τροπαῖε, νῦν ἐμοὶ δεινοῦ φόβου
urn:cts:greekLit:tlg0006.tlg004.fu.sp:868.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:868.1.text#ἐλεύθερον πάρεστιν ἦμαρ εἰσιδεῖν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:869.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:869.1.text#ὦ Ζεῦ, χρόνῳ μὲν τἄμ' ἐπεσκέψω κακά,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:870.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:870.1.text#χάριν δ' ὅμως σοι τῶν πεπραγμένων ἔχω·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:871.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:871.1.text#καὶ παῖδα τὸν ἐμὸν πρόσθεν οὐ δοκοῦσ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:872.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:872.1.text#θεοῖς ὁμιλεῖν νῦν ἐπίσταμαι σαφῶς.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:873.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:873.1.text#ὦ τέκνα, νῦν δὴ νῦν ἐλεύθεροι πόνων,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:874.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:874.1.text#ἐλεύθεροι δὲ τοῦ κακῶς ὀλουμένου
urn:cts:greekLit:tlg0006.tlg004.fu.sp:875.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:875.1.text#Εὐρυσθέως ἔσεσθε καὶ πόλιν πατρὸς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:876.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:876.1.text#ὄψεσθε, κλήρους δ' ἐμβατεύσετε χθονὸς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:877.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:877.1.text#καὶ θεοῖς πατρῴοις θύσεθ', ὧν ἀπειργμένοι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:878.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:878.1.text#ξένοι πλανήτην εἴχετ' ἄθλιον βίον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:879.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:879.1.text#ἀτὰρ τί κεύθων Ἰόλεως σοφόν ποτε
urn:cts:greekLit:tlg0006.tlg004.fu.sp:880.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:880.1.text#Εὐρυσθέως ἐφείσαθ' ὥστε μὴ κτανεῖν;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:881.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:881.1.text#λέξον· παρ' ἡμῖν μὲν γὰρ οὐ σοφὸν τόδε,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:882.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:882.1.text#ἐχθροὺς λαβόντα μὴ ἀποτείσασθαι δίκην.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:883.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:883.1.text#τὸ σὸν προτιμῶν, ὥς νιν ὀφθαλμοῖς ἴδοις
urn:cts:greekLit:tlg0006.tlg004.fu.sp:884.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:884.1.text#{ κρατοῦντα } καὶ σῇ δεσποτούμενον χερί.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:885.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:885.1.text#οὐ μὴν ἑκόντα γ' αὐτόν, ἀλλὰ πρὸς βίαν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:886.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:886.1.text#ἔζευξ' ἀνάγκῃ· καὶ γὰρ οὐκ ἐβούλετο
urn:cts:greekLit:tlg0006.tlg004.fu.sp:887.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:887.1.text#ζῶν ἐς σὸν ἐλθεῖν ὄμμα καὶ δοῦναι δίκην.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:888.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:888.1.text#ἀλλ', ὦ γεραιά, χαῖρε καὶ μέμνησό μοι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:889.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:889.1.text#ὃ πρῶτον εἶπας, ἡνίκ' ἠρχόμην λόγου,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:890.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:890.1.text#ἐλευθερώσειν μ'· ἐν δὲ τοῖς τοιοῖσδε χρὴ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:891.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:891.1.text#ἀψευδὲς εἶναι τοῖσι γενναίοις στόμα.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:892.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:892.1.text#Ἐμοὶ χορὸς μὲν ἡδύς, εἰ λίγεια λωτοῦ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:893.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:893.1.text# χάρις { ενι δαι }·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:894.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:894.1.text#εἴη δ' εὔχαρις Ἀφροδίτα·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:895.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:895.1.text# τερπνὸν δέ τι καὶ φίλων ἆρ'
urn:cts:greekLit:tlg0006.tlg004.fu.sp:896.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:896.1.text#εὐτυχίαν ἰδέσθαι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:897.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:897.1.text#τῶν πάρος οὐ δοκούντων.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:898.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:898.1.text#πολλὰ γὰρ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:899.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:899.1.text#τίκτει Μοῖρα τελεσσιδώτειρ'
urn:cts:greekLit:tlg0006.tlg004.fu.sp:900.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:900.1.text# Αἰών τε Χρόνου παῖς.[ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:901.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:901.1.text#ἔχεις ὁδόν τιν', ὦ πόλις, δίκαιον — οὐ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:902.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:902.1.text#χρή ποτε τοῦδ' ἀφέσθαι, —
urn:cts:greekLit:tlg0006.tlg004.fu.sp:903.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:903.1.text#τιμᾶν θεούς· ὁ { δὲ } μή σε φάσκων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:904.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:904.1.text# ἐγγὺς μανιῶν ἐλαύνει,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:905.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:905.1.text#δεικνυμένων ἐλέγχων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:906.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:906.1.text#τῶνδ'· ἐπίσημα γάρ τοι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:907.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:907.1.text#θεὸς παραγγέλλει,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:908.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:908.1.text# τῶν ἀδίκων παραιρῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:909.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:909.1.text# φρονήματος αἰεί.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:910.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:910.1.text#ἔστιν ἐν οὐρανῷ βεβακὼς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:911.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:911.1.text# τεὸς γόνος, ὦ γεραιά·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:912.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:912.1.text# φεύγει λόγον ὡς τὸν Ἅιδα
urn:cts:greekLit:tlg0006.tlg004.fu.sp:913.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:913.1.text# δόμον κατέβα, πυρὸς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:914.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:914.1.text#δεινᾷ φλογὶ σῶμα δαισθείς·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:915.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:915.1.text#Ἥβας τ' ἐρατὸν χροΐζει
urn:cts:greekLit:tlg0006.tlg004.fu.sp:916.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:916.1.text#λέχος χρυσέαν κατ' αὐλάν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:917.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:917.1.text#ὦ Ὑμέναιε, δισσοὺς παῖδας
urn:cts:greekLit:tlg0006.tlg004.fu.sp:918.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:918.1.text# Διὸς ἠξίωσας. [ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:919.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:919.1.text#συμφέρεται τὰ πολλὰ πολλοῖς·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:920.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:920.1.text# καὶ γὰρ πατρὶ τῶνδ' Ἀθάναν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:921.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:921.1.text# λέγουσ' ἐπίκουρον εἶναι,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:922.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:922.1.text# καὶ τούσδε θεᾶς πόλις
urn:cts:greekLit:tlg0006.tlg004.fu.sp:923.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:923.1.text#καὶ λαὸς ἔσωσε κείνας·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:924.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:924.1.text#ἔσχεν δ' ὕβριν ἀνδρὸς ᾧ θυμὸς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:925.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:925.1.text# ἦν πρὸ δίκας βίαιος.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:926.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:926.1.text#μήποτ' ἐμοὶ φρόνημα ψυχά
urn:cts:greekLit:tlg0006.tlg004.fu.sp:927.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:927.1.text# τ' ἀκόρεστος εἴη.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:928.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:928.1.text#δέσποιν', ὁρᾷς μέν, ἀλλ' ὅμως εἰρήσεται,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:929.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:929.1.text#Εὐρυσθέα σοι τόνδ' ἄγοντες ἥκομεν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:930.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:930.1.text#ἄελπτον ὄψιν, τῷδέ τ' οὐχ ἧσσον τύχην·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:931.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:931.1.text#οὐ γάρ ποτ' ηὔχει χεῖρας ἵξεσθαι σέθεν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:932.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:932.1.text#ὅτ' ἐκ Μυκηνῶν πολυπόνῳ σὺν ἀσπίδι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:933.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:933.1.text#ἔστειχε μείζω τῆς δίκης φρονῶν, πόλιν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:934.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:934.1.text#πέρσων Ἀθηνᾶς. ἀλλὰ τὴν ἐναντίαν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:935.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:935.1.text#δαίμων ἔθηκε, καὶ μετέστησεν τύχην.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:936.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:936.1.text#Ὕλλος μὲν οὖν ὅ τ' ἐσθλὸς Ἰόλεως βρέτας
urn:cts:greekLit:tlg0006.tlg004.fu.sp:937.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:937.1.text#Διὸς τροπαίου καλλίνικον ἵστασαν·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:938.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:938.1.text#ἐμοὶ δὲ πρὸς σὲ τόνδ' ἐπιστέλλουσ' ἄγειν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:939.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:939.1.text#τέρψαι θέλοντες σὴν φρέν'· ἐκ γὰρ εὐτυχοῦς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:940.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:940.1.text#ἥδιστον ἐχθρὸν ἄνδρα δυστυχοῦνθ' ὁρᾶν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:941.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:941.1.text#ὦ μῖσος, ἥκεις; εἷλέ σ' ἡ Δίκη χρόνῳ;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:942.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:942.1.text#πρῶτον μὲν οὖν μοι δεῦρ' ἐπίστρεψον κάρα
urn:cts:greekLit:tlg0006.tlg004.fu.sp:943.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:943.1.text#καὶ τλῆθι τοὺς σοὺς προσβλέπειν ἐναντίον
urn:cts:greekLit:tlg0006.tlg004.fu.sp:944.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:944.1.text#ἐχθρούς· κρατῇ γὰρ νῦν γε κοὐ κρατεῖς ἔτι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:945.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:945.1.text#ἐκεῖνος εἶ σύ — βούλομαι γὰρ εἰδέναι —
urn:cts:greekLit:tlg0006.tlg004.fu.sp:946.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:946.1.text#ὃς πολλὰ μὲν τὸν ὄνθ' ὅπου 'στὶ νῦν ἐμὸν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:947.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:947.1.text#παῖδ' ἠξίωσας, ὦ πανοῦργ', ἐφυβρίσαι;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:948.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:948.1.text#τί γὰρ σὺ κεῖνον οὐκ ἔτλης καθυβρίσαι;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:949.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:949.1.text#ὃς καὶ παρ' Ἅιδην ζῶντά νιν κατήγαγες,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:950.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:950.1.text#ὕδρας λέοντάς τ' ἐξαπολλύναι λέγων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:951.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:951.1.text#ἔπεμπες. ἄλλα δ' οἷ' ἐμηχανῶ κακὰ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:952.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:952.1.text#σιγῶ· μακρὸς γὰρ μῦθος ἂν γένοιτό μοι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:953.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:953.1.text#κοὐκ ἤρκεσέν σοι ταῦτα τολμῆσαι μόνον,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:954.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:954.1.text#ἀλλ' ἐξ ἁπάσης κἀμὲ καὶ τέκν' Ἑλλάδος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:955.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:955.1.text#ἤλαυνες ἱκέτας δαιμόνων καθημένους,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:956.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:956.1.text#τοὺς μὲν γέροντας, τοὺς δὲ νηπίους ἔτι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:957.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:957.1.text#ἀλλ' ηὗρες ἄνδρας καὶ πόλισμ' ἐλεύθερον,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:958.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:958.1.text#οἵ σ' οὐκ ἔδεισαν. δεῖ σε κατθανεῖν κακῶς,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:959.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:959.1.text#καὶ κερδανεῖς ἅπαντα· χρῆν γὰρ οὐχ ἅπαξ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:960.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:960.1.text#θνῄσκειν σὲ πολλὰ πήματ' ἐξειργασμένον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:961.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:961.1.text#οὐκ ἔστ' ἀνυστὸν τόνδε σοι κατακτανεῖν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:962.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:962.1.text#ἄλλως ἄρ' αὐτὸν αἰχμάλωτον εἵλομεν;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:963.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:963.1.text#εἴργει δὲ δὴ τίς τόνδε μὴ θνῄσκειν νόμος;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:964.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:964.1.text#τοῖς τῆσδε χώρας προστάταισιν οὐ δοκεῖ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:965.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:965.1.text#τί δὴ τόδ'; ἐχθροὺς τοισίδ' οὐ καλὸν κτανεῖν;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:966.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:966.1.text#οὐχ ὅντιν' ἄν γε ζῶνθ' ἕλωσιν ἐν μάχῃ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:967.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:967.1.text#καὶ ταῦτα δόξανθ'  Ὕλλος ἐξηνέσχετο;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:968.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:968.1.text#χρῆν δ' αὐτόν, οἶμαι, τῇδ' ἀπιστῆσαι χθονί;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:969.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:969.1.text#χρῆν τόνδε μὴ ζῆν μηδ' ὁρᾶν { φάος ἔτι. }
urn:cts:greekLit:tlg0006.tlg004.fu.sp:970.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:970.1.text#τότ' ἠδικήθη πρῶτον οὐ θανὼν ὅδε.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:971.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:971.1.text#οὐκ οὖν ἔτ' ἐστὶν ἐν καλῷ δοῦναι δίκην;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:972.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:972.1.text#οὐκ ἔστι τοῦτον ὅστις ἂν κατακτάνοι.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:973.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:973.1.text#ἔγωγε· καίτοι φημὶ κἄμ' εἶναί τινα.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:974.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:974.1.text#πολλὴν ἄρ' ἕξεις μέμψιν, εἰ δράσεις τόδε.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:975.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:975.1.text#φιλῶ πόλιν τήνδ'· οὐδὲν ἀντιλεκτέον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:976.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:976.1.text#τοῦτον δ', ἐπείπερ χεῖρας ἦλθεν εἰς ἐμάς,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:977.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:977.1.text#οὐκ ἔστι θνητῶν ὅστις ἐξαιρήσεται.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:978.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:978.1.text#πρὸς ταῦτα τὴν θρασεῖαν ὅστις ἂν θέλῃ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:979.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:979.1.text#καὶ τὴν φρονοῦσαν μεῖζον ἢ γυναῖκα χρὴ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:980.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:980.1.text#λέξει· τὸ δ' ἔργον τοῦτ' ἐμοὶ πεπράξεται.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:981.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:981.1.text#δεινόν τι καὶ συγγνωστόν, ὦ γύναι, σ' ἔχει
urn:cts:greekLit:tlg0006.tlg004.fu.sp:982.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:982.1.text#νεῖκος πρὸς ἄνδρα τόνδε, γιγνώσκω καλῶς.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:983.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:983.1.text#γύναι, σάφ' ἴσθι μή με θωπεύσοντά σε,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:984.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:984.1.text#μηδ' ἄλλο μηδὲν τῆς ἐμῆς  ψυχῆς πέρι
urn:cts:greekLit:tlg0006.tlg004.fu.sp:985.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:985.1.text#λέξονθ' ὅθεν χρὴ δειλίαν ὀφλεῖν τινα.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:986.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:986.1.text#ἐγὼ δὲ νεῖκος οὐχ ἑκὼν τόδ' ἠράμην·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:987.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:987.1.text#ᾔδη γε σοὶ μὲν αὐτανέψιος γεγώς,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:988.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:988.1.text#τῷ σῷ δὲ παιδὶ συγγενὴς Ἡρακλέει.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:989.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:989.1.text#ἀλλ' εἴτ' ἔχρῃζον εἴτε μή — θεὸς γὰρ ἦν —
urn:cts:greekLit:tlg0006.tlg004.fu.sp:990.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:990.1.text#Ἥρα με κάμνειν τήνδ' ἔθηκε τὴν νόσον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:991.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:991.1.text#ἐπεὶ δ' ἐκείνῳ δυσμένειαν ἠράμην
urn:cts:greekLit:tlg0006.tlg004.fu.sp:992.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:992.1.text#κἄγνων ἀγῶνα τόνδ' ἀγωνιούμενος,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:993.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:993.1.text#πολλῶν σοφιστὴς πημάτων ἐγιγνόμην
urn:cts:greekLit:tlg0006.tlg004.fu.sp:994.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:994.1.text#καὶ πόλλ' ἔτικτον νυκτὶ συνθακῶν ἀεί,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:995.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:995.1.text#ὅπως διώσας καὶ κατακτείνας ἐμοὺς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:996.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:996.1.text#ἐχθροὺς τὸ λοιπὸν μὴ συνοικοίην φόβῳ,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:997.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:997.1.text#εἰδὼς μὲν οὐκ ἀριθμὸν ἀλλ' ἐτητύμως
urn:cts:greekLit:tlg0006.tlg004.fu.sp:998.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:998.1.text#ἄνδρ' ὄντα τὸν σὸν παῖδα· καὶ γὰρ ἐχθρὸς ὢν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:999.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:999.1.text#ἀκούσεται { 'μοί } γ' ἐσθλὰ χρηστὸς ὢν ἀνήρ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1000.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1000.1.text#κείνου δ' ἀπαλλαχθέντος οὐκ ἐχρῆν μ' ἄρα
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1001.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1001.1.text#μισούμενον πρὸς τῶνδε καὶ ξυνειδότα
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1002.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1002.1.text#ἔχθραν πατρῴαν, πάντα κινῆσαι πέτρον,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1003.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1003.1.text#κτείνοντα κἀκβάλλοντα καὶ τεχνώμενον;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1004.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1004.1.text#τοιαῦτα δρῶντι τἄμ' ἐγίγνετ' ἀσφαλῆ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1005.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1005.1.text#οὔκουν σύ γ' ἀναλαβοῦσα τὰς ἐμὰς τύχας
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1006.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1006.1.text#ἐχθροῦ λέοντος δυσγενῆ βλαστήματα
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1007.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1007.1.text#ἤλαυνες ἂν κακοῖσιν, ἀλλὰ σωφρόνως
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1008.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1008.1.text#εἴασας οἰκεῖν Ἄργος;  οὔτιν' ἂν πίθοις.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1009.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1009.1.text#νῦν οὖν ἐπειδή μ' οὐ διώλεσαν τότε
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1010.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1010.1.text#πρόθυμον ὄντα, τοῖσιν Ἑλλήνων νόμοις
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1011.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1011.1.text#οὐχ ἁγνός εἰμι τῷ κτανόντι κατθανών·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1012.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1012.1.text#πόλις τ' ἀφῆκε σωφρονοῦσα, τὸν θεὸν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1013.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1013.1.text#μεῖζον τίουσα τῆς ἐμῆς ἔχθρας πολύ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1014.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1014.1.text#προσεῖπας, ἀντήκουσας· ἐντεῦθεν δὲ χρὴ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1015.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1015.1.text#τὸν προστρόπαιον τόν τε γενναῖον καλεῖν.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1016.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1016.1.text#οὕτω γε μέντοι τἄμ' ἔχεις· θανεῖν μὲν οὐ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1017.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1017.1.text#χρῄζω, λιπὼν δ' ἂν οὐδὲν ἀχθοίμην βίον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1017a.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1017a.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1017b.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1017b.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1017c.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1017c.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1018.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1018.1.text#παραινέσαι σοι σμικρόν, Ἀλκμήνη, θέλω,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1019.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1019.1.text#τὸν ἄνδρ' ἀφεῖναι τόνδ', ἐπεὶ δοκεῖ πόλει.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1020.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1020.1.text#τί δ', ἢν θάνῃ τε καὶ πόλει πιθώμεθα;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1021.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1021.1.text#τὰ λῷστ' ἂν εἴη· πῶς τάδ' οὖν γενήσεται;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1022.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1022.1.text#ἐγὼ διδάξω ῥᾳδίως· κτανοῦσα γὰρ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1023.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1023.1.text#τόνδ' εἶτα νεκρὸν τοῖς μετελθοῦσιν φίλων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1024.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1024.1.text#δώσω· τὸ γὰρ σῶμ' οὐκ ἀπιστήσω χθονί,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1025.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1025.1.text#οὗτος δὲ δώσει τὴν δίκην θανὼν ἐμοί.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1026.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1026.1.text#κτεῖν', οὐ παραιτοῦμαί σε· τήνδε δὲ πτόλιν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1027.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1027.1.text#ἐπεί μ' ἀφῆκε καὶ κατῃδέσθη κτανεῖν,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1028.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1028.1.text#χρησμῷ παλαιῷ Λοξίου δωρήσομαι,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1029.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1029.1.text#ὃς ὠφελήσει μείζον' ἢ δοκεῖν χρόνῳ.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1030.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1030.1.text#θανόντα γάρ με θάψεθ' οὗ τὸ μόρσιμον,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1031.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1031.1.text#δίας πάροιθε παρθένου Παλληνίδος·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1032.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1032.1.text#καὶ σοὶ μὲν εὔνους καὶ πόλει σωτήριος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1033.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1033.1.text#μέτοικος αἰεὶ κείσομαι κατὰ χθονός,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1034.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1034.1.text#τοῖς τῶνδε δ' ἐκγόνοισι πολεμιώτατος,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1035.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1035.1.text#ὅταν μόλωσι δεῦρο σὺν πολλῇ χερὶ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1036.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1036.1.text#χάριν προδόντες τήνδε. τοιούτων ξένων
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1037.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1037.1.text#προύστητε. πῶς οὖν ταῦτ' ἐγὼ πεπυσμένος
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1038.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1038.1.text#δεῦρ' ἦλθον, ἀλλ' οὐ χρησμὸν ἠρόμην θεοῦ;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1039.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1039.1.text#Ἥραν νομίζων θεσφάτων κρείσσω πολὺ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1040.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1040.1.text#κοὐκ ἂν προδοῦναί μ'. ἀλλὰ μήτε μοι χοὰς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1041.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1041.1.text#μήθ' αἷμ' ἐάσῃς εἰς ἐμὸν στάξαι τόπον.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1042.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1042.1.text#κακὸν γὰρ αὐτοῖς νόστον ἀντὶ τῶνδ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1043.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1043.1.text#δώσω· διπλοῦν δὲ κέρδος ἕξετ' ἐξ ἐμοῦ,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1044.1.speaker#Ἐυρυσθεύς
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1044.1.text#ὑμᾶς τ' ὀνήσω τούσδε τε βλάψω θανών.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1045.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1045.1.text#τί δῆτα μέλλετ', εἰ πόλει σωτηρίαν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1046.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1046.1.text#κατεργάσασθαι τοῖσί τ' ἐξ ἡμῶν χρεών,
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1047.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1047.1.text#κτείνειν τὸν ἄνδρα τόνδ', ἀκούοντες τάδε;
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1048.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1048.1.text#δείκνυσι γὰρ κέλευθον ἀσφαλεστάτην·
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1049.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1049.1.text#ἐχθρὸς μὲν ἁνήρ, ὠφελεῖ δὲ κατθανών.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1050.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1050.1.text#κομίζετ' αὐτόν, δμῶες· εἶτα χρὴ κυσὶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1051.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1051.1.text#δοῦναι κτανόντας· μὴ γὰρ ἐλπίσῃς ὅπως
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1052.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1052.1.text#αὖθις πατρῴας ζῶν ἔμ' ἐκβαλεῖς χθονός.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1052a.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1052a.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1052b.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1052b.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1052c.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1052c.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1052d.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1052d.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1052e.1.speaker#Ἀλκμήνη
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1052e.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1053.1.speaker#Ἡμιχόριον
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1053.1.text#ταὐτὰ δοκεῖ μοι. στείχετ', ὀπαδοί.
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1054.1.speaker#Ἡμιχόριον
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1054.1.text#τὰ γὰρ ἐξ ἡμῶν
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1055.1.speaker#Ἡμιχόριον
urn:cts:greekLit:tlg0006.tlg004.fu.sp:1055.1.text#καθαρῶς ἔσται βασιλεῦσιν.
