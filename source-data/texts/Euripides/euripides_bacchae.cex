#!ctsdata
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1.1.text#ἥκω Διὸς παῖς τήνδε Θηβαίων χθόνα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:2.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:2.1.text#Διόνυσος, ὃν τίκτει ποθ' ἡ Κάδμου κόρη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:3.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:3.1.text#Σεμέλη λοχευθεῖσ' ἀστραπηφόρῳ πυρί·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:4.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:4.1.text#μορφὴν δ' ἀμείψας ἐκ θεοῦ βροτησίαν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:5.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:5.1.text#πάρειμι Δίρκης νάματ' Ἰσμηνοῦ θ' ὕδωρ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:6.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:6.1.text#ὁρῶ δὲ μητρὸς μνῆμα τῆς κεραυνίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:7.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:7.1.text#τόδ' ἐγγὺς οἴκων καὶ δόμων ἐρείπια
urn:cts:greekLit:tlg0006.tlg017.fu.sp:8.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:8.1.text#τυφόμενα Δίου πυρὸς ἔτι ζῶσαν φλόγα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:9.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:9.1.text#ἀθάνατον Ἥρας μητέρ' εἰς ἐμὴν ὕβριν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:10.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:10.1.text#αἰνῶ δὲ Κάδμον, ἄβατον ὃς πέδον τόδε
urn:cts:greekLit:tlg0006.tlg017.fu.sp:11.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:11.1.text#τίθησι, θυγατρὸς σηκόν· ἀμπέλου δέ νιν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:12.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:12.1.text#πέριξ ἐγὼ 'κάλυψα βοτρυώδει χλόῃ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:13.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:13.1.text#λιπὼν δὲ Λυδῶν τοὺς πολυχρύσους γύας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:14.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:14.1.text#Φρυγῶν τε, Περσῶν θ' ἡλιοβλήτους πλάκας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:15.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:15.1.text#Βάκτριά τε τείχη τήν τε δύσχιμον χθόνα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:16.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:16.1.text#Μήδων ἐπελθὼν Ἀραβίαν τ' εὐδαίμονα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:17.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:17.1.text#Ἀσίαν τε πᾶσαν, ἣ παρ' ἁλμυρὰν ἅλα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:18.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:18.1.text#κεῖται μιγάσιν Ἕλλησι βαρβάροις θ' ὁμοῦ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:19.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:19.1.text#πλήρεις ἔχουσα καλλιπυργώτους πόλεις,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:20.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:20.1.text#ἐς τήνδε πρῶτον ἦλθον Ἑλλήνων πόλιν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:21.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:21.1.text#τἀκεῖ χορεύσας καὶ καταστήσας ἐμὰς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:22.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:22.1.text#τελετάς, ἵν' εἴην ἐμφανὴς δαίμων βροτοῖς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:23.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:23.1.text#πρώτας δὲ Θήβας τῆσδε γῆς Ἑλληνίδος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:24.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:24.1.text#ἀνωλόλυξα, νεβρίδ' ἐξάψας χροὸς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:25.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:25.1.text#θύρσον τε δοὺς ἐς χεῖρα, κίσσινον βέλος·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:26.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:26.1.text#ἐπεί μ' ἀδελφαὶ μητρός, ἃς ἥκιστα χρῆν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:27.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:27.1.text#Διόνυσον οὐκ ἔφασκον ἐκφῦναι Διός,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:28.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:28.1.text#Σεμέλην δὲ νυμφευθεῖσαν ἐκ θνητοῦ τινος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:29.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:29.1.text#ἐς Ζῆν' ἀναφέρειν τὴν ἁμαρτίαν λέχους,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:30.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:30.1.text#Κάδμου σοφίσμαθ', ὧν νιν οὕνεκα κτανεῖν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:31.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:31.1.text#Ζῆν' ἐξεκαυχῶνθ', ὅτι γάμους ἐψεύσατο.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:32.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:32.1.text#τοιγάρ νιν αὐτὰς ἐκ δόμων ᾤστρησ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:33.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:33.1.text#μανίαις, ὄρος δ' οἰκοῦσι παράκοποι φρενῶν·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:34.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:34.1.text#σκευήν τ' ἔχειν ἠνάγκασ' ὀργίων ἐμῶν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:35.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:35.1.text#καὶ πᾶν τὸ θῆλυ σπέρμα Καδμείων, ὅσαι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:36.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:36.1.text#γυναῖκες ἦσαν, ἐξέμηνα δωμάτων·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:37.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:37.1.text#ὁμοῦ δὲ Κάδμου παισὶν ἀναμεμειγμέναι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:38.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:38.1.text#χλωραῖς ὑπ' ἐλάταις ἀνορόφοις ἧνται πέτραις.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:39.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:39.1.text#δεῖ γὰρ πόλιν τήνδ' ἐκμαθεῖν, κεἰ μὴ θέλει,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:40.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:40.1.text#ἀτέλεστον οὖσαν τῶν ἐμῶν βακχευμάτων,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:41.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:41.1.text#Σεμέλης τε μητρὸς ἀπολογήσασθαί μ' ὕπερ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:42.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:42.1.text#φανέντα θνητοῖς δαίμον' ὃν τίκτει Διί.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:43.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:43.1.text#Κάδμος μὲν οὖν γέρας τε καὶ τυραννίδα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:44.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:44.1.text#Πενθεῖ δίδωσι θυγατρὸς ἐκπεφυκότι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:45.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:45.1.text#ὃς θεομαχεῖ τὰ κατ' ἐμὲ καὶ σπονδῶν ἄπο
urn:cts:greekLit:tlg0006.tlg017.fu.sp:46.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:46.1.text#ὠθεῖ μ', ἐν εὐχαῖς τ' οὐδαμοῦ μνείαν ἔχει.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:47.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:47.1.text#ὧν οὕνεκ' αὐτῷ θεὸς γεγὼς ἐνδείξομαι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:48.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:48.1.text#πᾶσίν τε Θηβαίοισιν. ἐς δ' ἄλλην χθόνα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:49.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:49.1.text#τἀνθένδε θέμενος εὖ, μεταστήσω πόδα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:50.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:50.1.text#δεικνὺς ἐμαυτόν· ἢν δὲ Θηβαίων πόλις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:51.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:51.1.text#ὀργῇ σὺν ὅπλοις ἐξ ὄρους βάκχας ἄγειν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:52.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:52.1.text#ζητῇ, ξυνάψω μαινάσι στρατηλατῶν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:53.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:53.1.text#ὧν οὕνεκ' εἶδος θνητὸν ἀλλάξας ἔχω
urn:cts:greekLit:tlg0006.tlg017.fu.sp:54.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:54.1.text#μορφήν τ' ἐμὴν μετέβαλον εἰς ἀνδρὸς φύσιν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:55.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:55.1.text#ἀλλ', ὦ λιποῦσαι Τμῶλον ἔρυμα Λυδίας,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:56.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:56.1.text#θίασος ἐμός, γυναῖκες, ἃς ἐκ βαρβάρων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:57.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:57.1.text#ἐκόμισα παρέδρους καὶ ξυνεμπόρους ἐμοί,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:58.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:58.1.text#αἴρεσθε τἀπιχώρι' ἐν πόλει Φρυγῶν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:59.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:59.1.text#τύμπανα, Ῥέας τε μητρὸς ἐμά θ' εὑρήματα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:60.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:60.1.text#βασίλειά τ' ἀμφὶ δώματ' ἐλθοῦσαι τάδε
urn:cts:greekLit:tlg0006.tlg017.fu.sp:61.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:61.1.text#κτυπεῖτε Πενθέως, ὡς ὁρᾷ Κάδμου πόλις.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:62.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:62.1.text#ἐγὼ δὲ βάκχαις, ἐς Κιθαιρῶνος πτυχὰς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:63.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:63.1.text#ἐλθὼν ἵν' εἰσί, συμμετασχήσω χορῶν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:64.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:64.1.text#Ἀσίας ἀπὸ γᾶς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:65.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:65.1.text#ἱερὸν Τμῶλον ἀμείψασα θοάζω
urn:cts:greekLit:tlg0006.tlg017.fu.sp:66.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:66.1.text#Βρομίῳ πόνον ἡδὺν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:66.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:66.2.text#κάματόν τ' εὐκάματον, Βάκχιον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:67.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:67.1.text#εὐαζομένα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:68.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:68.1.text#τίς ὁδῷ τίς ὁδῷ; τίς;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:69.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:69.1.text#μελάθροις ἔκτοπος ἔστω, στόμα τ' εὔφημον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:70.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:70.1.text#ἅπας ἐξοσιούσθω·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:71.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:71.1.text#τὰ νομισθέντα γὰρ αἰεὶ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:72.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:72.1.text#Διόνυσον ὑμνήσω.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:73.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:73.1.text#ὦ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:73.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:73.2.text#μάκαρ, ὅστις εὐδαίμων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:74.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:74.1.text#τελετὰς θεῶν εἰδὼς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:74.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:74.2.text#βιοτὰν ἁγιστεύει καὶ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:75.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:75.1.text#θιασεύεται ψυχὰν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:76.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:76.1.text#ἐν ὄρεσσι βακχεύων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:77.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:77.1.text#ὁσίοις καθαρμοῖσιν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:78.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:78.1.text#τά τε ματρὸς μεγάλας ὄργια
urn:cts:greekLit:tlg0006.tlg017.fu.sp:79.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:79.1.text#Κυβέλας θεμιτεύων,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:80.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:80.1.text#ἀνὰ θύρσον τε τινάσσων,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:81.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:81.1.text#κισσῷ τε στεφανωθεὶς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:82.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:82.1.text#Διόνυσον θεραπεύει.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:83.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:83.1.text#ἴτε βάκχαι, ἴτε βάκχαι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:84.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:84.1.text#Βρόμιον παῖδα θεὸν θεοῦ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:85.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:85.1.text#Διόνυσον κατάγουσαι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:86.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:86.1.text#Φρυγίων ἐξ ὀρέων Ἑλλάδος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:87.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:87.1.text#εἰς εὐρυχόρους ἀγυιάς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:87.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:87.2.text#τὸν Βρόμιον·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:88.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:88.1.text#ὅν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:88.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:88.2.text#ποτ' ἔχουσ' ἐν ὠδίνων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:89.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:89.1.text#λοχίαις ἀνάγκαισι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:90.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:90.1.text#πταμένας Διὸς βροντᾶς νηδύος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:91.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:91.1.text#ἔκβολον μάτηρ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:92.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:92.1.text#ἔτεκεν, λιποῦσ' αἰῶνα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:93.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:93.1.text#κεραυνίῳ πληγᾷ·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:94.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:94.1.text#λοχίοις δ' αὐτίκα νιν δέξατο
urn:cts:greekLit:tlg0006.tlg017.fu.sp:95.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:95.1.text#θαλάμαις Κρονίδας Ζεύς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:96.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:96.1.text#κατὰ μηρῷ δὲ καλύψας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:97.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:97.1.text#χρυσέαισιν συνερείδει
urn:cts:greekLit:tlg0006.tlg017.fu.sp:98.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:98.1.text#περόναις κρυπτὸν ἀφ' Ἥρας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:99.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:99.1.text#ἔτεκεν δ', ἁνίκα Μοῖραι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:100.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:100.1.text#τέλεσαν, ταυρόκερων θεὸν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:101.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:101.1.text#στεφάνωσέν τε δρακόντων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:102.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:102.1.text#στεφάνοις, ἔνθεν ἄγραν θηροτρόφον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:103.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:103.1.text#μαινάδες ἀμφιβάλλονται
urn:cts:greekLit:tlg0006.tlg017.fu.sp:104.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:104.1.text#πλοκάμοις.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:105.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:105.1.text#ὦ Σεμέλας τροφοὶ Θῆβαι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:106.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:106.1.text#στεφανοῦσθε κισσῷ·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:107.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:107.1.text#βρύετε βρύετε χλοήρει
urn:cts:greekLit:tlg0006.tlg017.fu.sp:108.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:108.1.text#μίλακι καλλικάρπῳ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:109.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:109.1.text#καὶ καταβακχιοῦσθε δρυὸς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:110.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:110.1.text#ἢ ἐλάτας κλάδοισι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:111.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:111.1.text#στικτῶν τ' ἐνδυτὰ νεβρίδων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:112.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:112.1.text#στέφετε λευκοτρίχων πλοκάμων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:113.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:113.1.text#μαλλοῖς· ἀμφὶ δὲ νάρθηκας ὑβριστὰς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:114.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:114.1.text#ὁσιοῦσθ'· αὐτίκα γᾶ πᾶσα χορεύσει—
urn:cts:greekLit:tlg0006.tlg017.fu.sp:115.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:115.1.text#Βρόμιος ὅστις ἄγῃ θιάσουσ—
urn:cts:greekLit:tlg0006.tlg017.fu.sp:116.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:116.1.text#εἰς ὄρος εἰς ὄρος, ἔνθα μένει
urn:cts:greekLit:tlg0006.tlg017.fu.sp:117.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:117.1.text#θηλυγενὴς ὄχλος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:118.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:118.1.text#ἀφ' ἱστῶν παρὰ κερκίδων τ'
urn:cts:greekLit:tlg0006.tlg017.fu.sp:119.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:119.1.text#οἰστρηθεὶς Διονύσῳ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:120.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:120.1.text#ὦ θαλάμευμα Κουρήτων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:121.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:121.1.text#ζάθεοί τε Κρήτας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:122.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:122.1.text#Διογενέτορες ἔναυλοι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:123.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:123.1.text#ἔνθα τρικόρυθες ἄντροις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:124.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:124.1.text#βυρσότονον κύκλωμα τόδε
urn:cts:greekLit:tlg0006.tlg017.fu.sp:125.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:125.1.text#μοι Κορύβαντες ηὗρον·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:126.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:126.1.text#βακχείᾳ δ' ἀνὰ συντόνῳ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:127.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:127.1.text#κέρασαν ἁδυβόᾳ Φρυγίων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:128.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:128.1.text#αὐλῶν πνεύματι ματρός τε Ῥέας ἐς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:129.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:129.1.text#χέρα θῆκαν, κτύπον εὐάσμασι Βακχᾶν·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:130.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:130.1.text#παρὰ δὲ μαινόμενοι Σάτυροι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:131.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:131.1.text#ματέρος ἐξανύσαντο θεᾶς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:132.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:132.1.text#ἐς δὲ χορεύματα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:133.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:133.1.text#συνῆψαν τριετηρίδων,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:134.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:134.1.text#αἷς χαίρει Διόνυσος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:135.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:135.1.text#ἡδὺς ἐν ὄρεσιν, ὅταν ἐκ θιάσων δρομαίων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:136.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:136.1.text#πέσῃ πεδόσε, νεβρίδος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:138.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:138.1.text#ἔχων ἱερὸν ἐνδυτόν, ἀγρεύων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:139.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:139.1.text#αἷμα τραγοκτόνον, ὠμοφάγον χάριν, ἱέμενος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:140.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:140.1.text#ἐς ὄρεα Φρύγια, Λύδι', ὁ δ' ἔξαρχος Βρόμιος,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:141.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:141.1.text#εὐοἷ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:142.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:142.1.text#ῥεῖ δὲ γάλακτι πέδον, ῥεῖ δ' οἴνῳ, ῥεῖ δὲ μελισσᾶν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:143.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:143.1.text#νέκταρι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:144.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:144.1.text#Συρίας δ' ὡς λιβάνου καπνὸν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:145.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:145.1.text#ὁ Βακχεὺς ἀνέχων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:145.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:145.2.text#πυρσώδη φλόγα πεύκας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:146.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:146.1.text#ἐκ νάρθηκος ἀίσσει
urn:cts:greekLit:tlg0006.tlg017.fu.sp:147.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:147.1.text#δρόμῳ καὶ χοροῖσιν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:148.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:148.1.text#πλανάτας ἐρεθίζων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:149.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:149.1.text#ἰαχαῖς τ' ἀναπάλλων,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:150.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:150.1.text#τρυφερόν { τε } πλόκαμον εἰς αἰθέρα ῥίπτων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:151.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:151.1.text#ἅμα δ' εὐάσμασι τοιάδ' ἐπιβρέμει·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:152.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:152.1.text#Ὦ ἴτε βάκχαι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:153.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:153.1.text#[ ὦ ] ἴτε βάκχαι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:154.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:154.1.text#Τμώλου χρυσορόου χλιδᾷ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:155.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:155.1.text#μέλπετε τὸν Διόνυσον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:157.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:157.1.text#βαρυβρόμων ὑπὸ τυμπάνων,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:158.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:158.1.text#εὔια τὸν εὔιον ἀγαλλόμεναι θεὸν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:159.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:159.1.text#ἐν Φρυγίαισι βοαῖς ἐνοπαῖσί τε,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:160.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:160.1.text#λωτὸς ὅταν εὐκέλαδος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:164.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:164.1.text#ἱερὸς ἱερὰ παίγματα βρέμῃ, σύνοχα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:165.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:165.1.text#φοιτάσιν εἰς ὄρος εἰς ὄρος· ἡδομένα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:166.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:166.1.text#δ' ἄρα, πῶλος ὅπως ἅμα ματέρι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:169.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:169.1.text#φορβάδι, κῶλον ἄγει ταχύπουν σκιρτήμασι βάκχα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:170.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:170.1.text#τίς ἐν πύλαισι; Κάδμον ἐκκάλει δόμων,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:171.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:171.1.text#Ἀγήνορος παῖδ', ὃς πόλιν Σιδωνίαν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:172.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:172.1.text#λιπὼν ἐπύργωσ' ἄστυ Θηβαίων τόδε.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:173.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:173.1.text#ἴτω τις, εἰσάγγελλε Τειρεσίας ὅτι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:174.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:174.1.text#ζητεῖ νιν· οἶδε δ' αὐτὸς ὧν ἥκω πέρι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:175.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:175.1.text#ἅ τε ξυνεθέμην πρέσβυς ὢν γεραιτέρῳ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:176.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:176.1.text#θύρσους ἀνάπτειν καὶ νεβρῶν δορὰς ἔχειν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:177.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:177.1.text#στεφανοῦν τε κρᾶτα κισσίνοις βλαστήμασιν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:178.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:178.1.text#ὦ φίλταθ', ὡς σὴν γῆρυν ᾐσθόμην κλύων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:179.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:179.1.text#σοφὴν σοφοῦ παρ' ἀνδρός, ἐν δόμοισιν ὤν·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:180.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:180.1.text#ἥκω δ' ἕτοιμος τήνδ' ἔχων σκευὴν θεοῦ·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:181.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:181.1.text#δεῖ γάρ νιν ὄντα παῖδα θυγατρὸς ἐξ ἐμῆς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:182.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:182.1.text#[ Διόνυσον ὃς πέφηνεν ἀνθρώποις θεὸς ]
urn:cts:greekLit:tlg0006.tlg017.fu.sp:183.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:183.1.text#ὅσον καθ' ἡμᾶς δυνατὸν αὔξεσθαι μέγαν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:184.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:184.1.text#ποῖ δεῖ χορεύειν, ποῖ καθιστάναι πόδα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:185.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:185.1.text#καὶ κρᾶτα σεῖσαι πολιόν; ἐξηγοῦ σύ μοι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:186.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:186.1.text#γέρων γέροντι, Τειρεσία· σὺ γὰρ σοφός.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:187.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:187.1.text#ὡς οὐ κάμοιμ' ἂν οὔτε νύκτ' οὔθ' ἡμέραν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:188.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:188.1.text#θύρσῳ κροτῶν γῆν· ἐπιλελήσμεθ' ἡδέως
urn:cts:greekLit:tlg0006.tlg017.fu.sp:189.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:189.1.text#γέροντες ὄντες.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:189.2.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:189.2.text#ταὔτ' ἐμοὶ πάσχεις ἄρα·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:190.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:190.1.text#κἀγὼ γὰρ ἡβῶ κἀπιχειρήσω χοροῖς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:191.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:191.1.text#οὐκοῦν ὄχοισιν εἰς ὄρος περάσομεν;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:192.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:192.1.text#ἀλλ' οὐχ ὁμοίως ἂν ὁ θεὸς τιμὴν ἔχοι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:193.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:193.1.text#γέρων γέροντα παιδαγωγήσω σ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:194.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:194.1.text#ὁ θεὸς ἀμοχθὶ κεῖσε νῷν ἡγήσεται.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:195.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:195.1.text#μόνοι δὲ πόλεως Βακχίῳ χορεύσομεν;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:196.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:196.1.text#μόνοι γὰρ εὖ φρονοῦμεν, οἱ δ' ἄλλοι κακῶς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:197.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:197.1.text#μακρὸν τὸ μέλλειν· ἀλλ' ἐμῆς ἔχου χερός.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:198.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:198.1.text#ἰδού, ξύναπτε καὶ ξυνωρίζου χέρα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:199.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:199.1.text#οὐ καταφρονῶ 'γὼ τῶν θεῶν θνητὸς γεγώς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:200.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:200.1.text#οὐδὲν σοφιζόμεσθα τοῖσι δαίμοσιν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:201.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:201.1.text#πατρίους παραδοχάς, ἅς θ' ὁμήλικας χρόνῳ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:202.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:202.1.text#κεκτήμεθ', οὐδεὶς αὐτὰ καταβαλεῖ λόγος,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:203.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:203.1.text#οὐδ' εἰ δι' ἄκρων τὸ σοφὸν ηὕρηται φρενῶν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:204.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:204.1.text#ἐρεῖ τις ὡς τὸ γῆρας οὐκ αἰσχύνομαι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:205.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:205.1.text#μέλλων χορεύειν κρᾶτα κισσώσας ἐμόν;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:206.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:206.1.text#οὐ γὰρ διῄρηχ' ὁ θεός, οὔτε τὸν νέον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:207.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:207.1.text#εἰ χρὴ χορεύειν οὔτε τὸν γεραίτερον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:208.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:208.1.text#ἀλλ' ἐξ ἁπάντων βούλεται τιμὰς ἔχειν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:209.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:209.1.text#κοινάς, διαριθμῶν δ' οὐδέν' αὔξεσθαι θέλει.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:210.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:210.1.text#ἐπεὶ σὺ φέγγος, Τειρεσία, τόδ' οὐχ ὁρᾷς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:211.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:211.1.text#ἐγὼ προφήτης σοι λόγων γενήσομαι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:212.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:212.1.text#Πενθεὺς πρὸς οἴκους ὅδε διὰ σπουδῆς περᾷ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:213.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:213.1.text#Ἐχίονος παῖς, ᾧ κράτος δίδωμι γῆς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:214.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:214.1.text#ὡς ἐπτόηται· τί ποτ' ἐρεῖ νεώτερον;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:215.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:215.1.text#ἔκδημος ὢν μὲν τῆσδ' ἐτύγχανον χθονός,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:216.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:216.1.text#κλύω δὲ νεοχμὰ τήνδ' ἀνὰ πτόλιν κακά,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:217.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:217.1.text#γυναῖκας ἡμῖν δώματ' ἐκλελοιπέναι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:218.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:218.1.text#πλασταῖσι βακχείαισιν, ἐν δὲ δασκίοις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:219.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:219.1.text#ὄρεσι θοάζειν, τὸν νεωστὶ δαίμονα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:220.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:220.1.text#Διόνυσον, ὅστις ἔστι, τιμώσας χοροῖς·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:221.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:221.1.text#πλήρεις δὲ θιάσοις ἐν μέσοισιν ἑστάναι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:222.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:222.1.text#κρατῆρας, ἄλλην δ' ἄλλοσ' εἰς ἐρημίαν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:223.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:223.1.text#πτώσσουσαν εὐναῖς ἀρσένων ὑπηρετεῖν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:224.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:224.1.text#πρόφασιν μὲν ὡς δὴ μαινάδας θυοσκόους,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:225.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:225.1.text#τὴν δ' Ἀφροδίτην πρόσθ' ἄγειν τοῦ Βακχίου.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:226.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:226.1.text#ὅσας μὲν οὖν εἴληφα, δεσμίους χέρας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:227.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:227.1.text#σῴζουσι πανδήμοισι πρόσπολοι στέγαις·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:228.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:228.1.text#ὅσαι δ' ἄπεισιν, ἐξ ὄρους θηράσομαι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:229.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:229.1.text#[ Ἰνώ τ' Ἀγαύην θ', ἥ μ' ἔτικτ' Ἐχίονι, ]
urn:cts:greekLit:tlg0006.tlg017.fu.sp:230.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:230.1.text#[ Ἀκταίονός τε μητέρ', Αὐτονόην λέγω. ]
urn:cts:greekLit:tlg0006.tlg017.fu.sp:231.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:231.1.text#καὶ σφᾶς σιδηραῖς ἁρμόσας ἐν ἄρκυσιν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:232.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:232.1.text#παύσω κακούργου τῆσδε βακχείας τάχα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:233.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:233.1.text#λέγουσι δ' ὥς τις εἰσελήλυθε ξένος,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:234.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:234.1.text#γόης ἐπῳδὸς Λυδίας ἀπὸ χθονός,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:235.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:235.1.text#ξανθοῖσι βοστρύχοισιν εὐοσμῶν κόμην,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:236.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:236.1.text#οἰνῶπας ὄσσοις χάριτας Ἀφροδίτης ἔχων,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:237.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:237.1.text#ὃς ἡμέρας τε κεὐφρόνας συγγίγνεται
urn:cts:greekLit:tlg0006.tlg017.fu.sp:238.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:238.1.text#τελετὰς προτείνων εὐίους νεάνισιν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:239.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:239.1.text#εἰ δ' αὐτὸν εἴσω τῆσδε λήψομαι στέγης,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:240.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:240.1.text#παύσω κτυποῦντα θύρσον ἀνασείοντά τε
urn:cts:greekLit:tlg0006.tlg017.fu.sp:241.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:241.1.text#κόμας, τράχηλον σώματος χωρὶς τεμών.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:242.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:242.1.text#ἐκεῖνος εἶναί φησι Διόνυσον θεόν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:243.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:243.1.text#ἐκεῖνος ἐν μηρῷ ποτ' ἐρράφθαι Διός,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:244.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:244.1.text#ὃς ἐκπυροῦται λαμπάσιν κεραυνίαις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:245.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:245.1.text#σὺν μητρί, Δίους ὅτι γάμους ἐψεύσατο.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:246.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:246.1.text#ταῦτ' οὐχὶ δεινῆς ἀγχόνης ἔστ' ἄξια,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:247.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:247.1.text#ὕβρεις ὑβρίζειν, ὅστις ἔστιν ὁ ξένος;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:248.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:248.1.text#ἀτὰρ τόδ' ἄλλο θαῦμα, τὸν τερασκόπον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:249.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:249.1.text#ἐν ποικίλαισι νεβρίσι Τειρεσίαν ὁρῶ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:250.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:250.1.text#πατέρα τε μητρὸς τῆς ἐμῆσ—πολὺν γέλων—
urn:cts:greekLit:tlg0006.tlg017.fu.sp:251.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:251.1.text#νάρθηκι βακχεύοντ'· ἀναίνομαι, πάτερ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:252.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:252.1.text#τὸ γῆρας ὑμῶν εἰσορῶν νοῦν οὐκ ἔχον.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:253.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:253.1.text#οὐκ ἀποτινάξεις κισσόν; οὐκ ἐλευθέραν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:254.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:254.1.text#θύρσου μεθήσεις χεῖρ', ἐμῆς μητρὸς πάτερ;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:255.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:255.1.text#σὺ ταῦτ' ἔπεισας, Τειρεσία· τόνδ' αὖ θέλεις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:256.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:256.1.text#τὸν δαίμον' ἀνθρώποισιν ἐσφέρων νέον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:257.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:257.1.text#σκοπεῖν πτερωτοὺς κἀμπύρων μισθοὺς φέρειν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:258.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:258.1.text#εἰ μή σε γῆρας πολιὸν ἐξερρύετο,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:259.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:259.1.text#καθῆσ' ἂν ἐν βάκχαισι δέσμιος μέσαις,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:260.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:260.1.text#τελετὰς πονηρὰς εἰσάγων· γυναιξὶ γὰρ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:261.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:261.1.text#ὅπου βότρυος ἐν δαιτὶ γίγνεται γάνος,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:262.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:262.1.text#οὐχ ὑγιὲς οὐδὲν ἔτι λέγω τῶν ὀργίων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:263.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:263.1.text#τῆς δυσσεβείας. ὦ ξέν', οὐκ αἰδῇ θεοὺς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:264.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:264.1.text#Κάδμον τε τὸν σπείραντα γηγενῆ στάχυν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:265.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:265.1.text#Ἐχίονος δ' ὢν παῖς καταισχύνεις γένος;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:266.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:266.1.text#ὅταν λάβῃ τις τῶν λόγων ἀνὴρ σοφὸς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:267.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:267.1.text#καλὰς ἀφορμάς, οὐ μέγ' ἔργον εὖ λέγειν·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:268.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:268.1.text#σὺ δ' εὔτροχον μὲν γλῶσσαν ὡς φρονῶν ἔχεις,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:269.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:269.1.text#ἐν τοῖς λόγοισι δ' οὐκ ἔνεισί σοι φρένες.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:270.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:270.1.text#θράσει δὲ δυνατὸς καὶ λέγειν οἷός τ' ἀνὴρ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:271.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:271.1.text#κακὸς πολίτης γίγνεται νοῦν οὐκ ἔχων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:272.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:272.1.text#οὗτος δ' ὁ δαίμων ὁ νέος, ὃν σὺ διαγελᾷς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:273.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:273.1.text#οὐκ ἂν δυναίμην μέγεθος ἐξειπεῖν ὅσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:274.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:274.1.text#καθ' Ἑλλάδ' ἔσται. δύο γάρ, ὦ νεανία,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:275.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:275.1.text#τὰ πρῶτ' ἐν ἀνθρώποισι· Δημήτηρ θεά—
urn:cts:greekLit:tlg0006.tlg017.fu.sp:276.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:276.1.text#γῆ δ' ἐστίν, ὄνομα δ' ὁπότερον βούλῃ κάλει·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:277.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:277.1.text#αὕτη μὲν ἐν ξηροῖσιν ἐκτρέφει βροτούς·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:278.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:278.1.text#ὃς δ' ἦλθ' ἔπειτ', ἀντίπαλον ὁ Σεμέλης γόνος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:279.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:279.1.text#βότρυος ὑγρὸν πῶμ' ηὗρε κεἰσηνέγκατο
urn:cts:greekLit:tlg0006.tlg017.fu.sp:280.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:280.1.text#θνητοῖς, ὃ παύει τοὺς ταλαιπώρους βροτοὺς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:281.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:281.1.text#λύπης, ὅταν πλησθῶσιν ἀμπέλου ῥοῆς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:282.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:282.1.text#ὕπνον τε λήθην τῶν καθ' ἡμέραν κακῶν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:283.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:283.1.text#δίδωσιν, οὐδ' ἔστ' ἄλλο φάρμακον πόνων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:284.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:284.1.text#οὗτος θεοῖσι σπένδεται θεὸς γεγώς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:285.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:285.1.text#ὥστε διὰ τοῦτον τἀγάθ' ἀνθρώπους ἔχειν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:286.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:286.1.text#καὶ καταγελᾷς νιν, ὡς ἐνερράφη Διὸς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:287.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:287.1.text#μηρῷ; διδάξω σ' ὡς καλῶς ἔχει τόδε.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:288.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:288.1.text#ἐπεί νιν ἥρπασ' ἐκ πυρὸς κεραυνίου
urn:cts:greekLit:tlg0006.tlg017.fu.sp:289.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:289.1.text#Ζεύς, ἐς δ' Ὄλυμπον βρέφος ἀνήγαγεν θεόν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:290.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:290.1.text#Ἥρα νιν ἤθελ' ἐκβαλεῖν ἀπ' οὐρανοῦ·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:291.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:291.1.text#Ζεὺς δ' ἀντεμηχανήσαθ' οἷα δὴ θεός.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:292.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:292.1.text#ῥήξας μέρος τι τοῦ χθόν' ἐγκυκλουμένου
urn:cts:greekLit:tlg0006.tlg017.fu.sp:293.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:293.1.text#αἰθέρος, ἔθηκε τόνδ' ὅμηρον ἐκδιδούς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:294.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:294.1.text#Διόνυσον Ἥρας νεικέων· χρόνῳ δέ νιν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:295.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:295.1.text#βροτοὶ ῥαφῆναί φασιν ἐν μηρῷ Διός,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:296.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:296.1.text#ὄνομα μεταστήσαντες, ὅτι θεᾷ θεὸς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:297.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:297.1.text#Ἥρᾳ ποθ' ὡμήρευσε, συνθέντες λόγον.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:298.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:298.1.text#μάντις δ' ὁ δαίμων ὅδε· τὸ γὰρ βακχεύσιμον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:299.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:299.1.text#καὶ τὸ μανιῶδες μαντικὴν πολλὴν ἔχει·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:300.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:300.1.text#ὅταν γὰρ ὁ θεὸς ἐς τὸ σῶμ' ἔλθῃ πολύς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:301.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:301.1.text#λέγειν τὸ μέλλον τοὺς μεμηνότας ποιεῖ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:302.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:302.1.text#Ἄρεώς τε μοῖραν μεταλαβὼν ἔχει τινά·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:303.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:303.1.text#στρατὸν γὰρ ἐν ὅπλοις ὄντα κἀπὶ τάξεσιν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:304.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:304.1.text#φόβος διεπτόησε πρὶν λόγχης θιγεῖν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:305.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:305.1.text#μανία δὲ καὶ τοῦτ' ἐστὶ Διονύσου πάρα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:306.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:306.1.text#ἔτ' αὐτὸν ὄψῃ κἀπὶ Δελφίσιν πέτραις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:307.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:307.1.text#πηδῶντα σὺν πεύκαισι δικόρυφον πλάκα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:308.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:308.1.text#πάλλοντα καὶ σείοντα βακχεῖον κλάδον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:309.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:309.1.text#μέγαν τ' ἀν' Ἑλλάδα. ἀλλ' ἐμοί, Πενθεῦ, πιθοῦ·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:310.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:310.1.text#μὴ τὸ κράτος αὔχει δύναμιν ἀνθρώποις ἔχειν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:311.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:311.1.text#μηδ', ἢν δοκῇς μέν, ἡ δὲ δόξα σου νοσῇ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:312.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:312.1.text#φρονεῖν δόκει τι· τὸν θεὸν δ' ἐς γῆν δέχου
urn:cts:greekLit:tlg0006.tlg017.fu.sp:313.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:313.1.text#καὶ σπένδε καὶ βάκχευε καὶ στέφου κάρα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:314.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:314.1.text#οὐχ ὁ Διόνυσος σωφρονεῖν ἀναγκάσει
urn:cts:greekLit:tlg0006.tlg017.fu.sp:315.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:315.1.text#γυναῖκας ἐς τὴν Κύπριν, ἀλλ' ἐν τῇ φύσει
urn:cts:greekLit:tlg0006.tlg017.fu.sp:316.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:316.1.text#[ τὸ σωφρονεῖν ἔνεστιν εἰς τὰ πάντ' ἀεί ]
urn:cts:greekLit:tlg0006.tlg017.fu.sp:317.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:317.1.text#τοῦτο σκοπεῖν χρή· καὶ γὰρ ἐν βακχεύμασιν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:318.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:318.1.text#οὖσ' ἥ γε σώφρων οὐ διαφθαρήσεται.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:319.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:319.1.text#ὁρᾷς, σὺ χαίρεις, ὅταν ἐφεστῶσιν πύλαις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:320.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:320.1.text#πολλοί, τὸ Πενθέως δ' ὄνομα μεγαλύνῃ πόλις·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:321.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:321.1.text#κἀκεῖνος, οἶμαι, τέρπεται τιμώμενος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:322.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:322.1.text#ἐγὼ μὲν οὖν καὶ Κάδμος, ὃν σὺ διαγελᾷς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:323.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:323.1.text#κισσῷ τ' ἐρεψόμεσθα καὶ χορεύσομεν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:324.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:324.1.text#πολιὰ ξυνωρίς, ἀλλ' ὅμως χορευτέον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:325.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:325.1.text#κοὐ θεομαχήσω σῶν λόγων πεισθεὶς ὕπο.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:326.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:326.1.text#μαίνῃ γὰρ ὡς ἄλγιστα, κοὔτε φαρμάκοις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:327.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:327.1.text#ἄκη λάβοις ἂν οὔτ' ἄνευ τούτων νοσεῖς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:328.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:328.1.text#ὦ πρέσβυ, Φοῖβόν τ' οὐ καταισχύνεις λόγοις,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:329.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:329.1.text#τιμῶν τε Βρόμιον σωφρονεῖς, μέγαν θεόν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:330.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:330.1.text#ὦ παῖ, καλῶς σοι Τειρεσίας παρῄνεσεν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:331.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:331.1.text#οἴκει μεθ' ἡμῶν, μὴ θύραζε τῶν νόμων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:332.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:332.1.text#νῦν γὰρ πέτῃ τε καὶ φρονῶν οὐδὲν φρονεῖς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:333.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:333.1.text#κεἰ μὴ γὰρ ἔστιν ὁ θεὸς οὗτος, ὡς σὺ φῄς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:334.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:334.1.text#παρὰ σοὶ λεγέσθω· καὶ καταψεύδου καλῶς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:335.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:335.1.text#ὡς ἔστι, Σεμέλη θ' ἵνα δοκῇ θεὸν τεκεῖν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:336.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:336.1.text#ἡμῖν τε τιμὴ παντὶ τῷ γένει προσῇ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:337.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:337.1.text#ὁρᾷς τὸν Ἀκτέωνος ἄθλιον μόρον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:338.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:338.1.text#ὃν ὠμόσιτοι σκύλακες ἃς ἐθρέψατο
urn:cts:greekLit:tlg0006.tlg017.fu.sp:339.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:339.1.text#διεσπάσαντο, κρείσσον' ἐν κυναγίαις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:340.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:340.1.text#Ἀρτέμιδος εἶναι κομπάσαντ', ἐν ὀργάσιν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:341.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:341.1.text#ὃ μὴ πάθῃς σύ· δεῦρό σου στέψω κάρα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:342.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:342.1.text#κισσῷ· μεθ' ἡμῶν τῷ θεῷ τιμὴν δίδου.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:343.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:343.1.text#οὐ μὴ προσοίσεις χεῖρα, βακχεύσεις δ' ἰών,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:344.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:344.1.text#μηδ' ἐξομόρξῃ μωρίαν τὴν σὴν ἐμοί;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:345.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:345.1.text#τῆς σῆς { δ' } ἀνοίας τόνδε τὸν διδάσκαλον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:346.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:346.1.text#δίκην μέτειμι. στειχέτω τις ὡς τάχος,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:347.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:347.1.text#ἐλθὼν δὲ θάκους τοῦδ' ἵν' οἰωνοσκοπεῖ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:348.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:348.1.text#μοχλοῖς τριαίνου κἀνάτρεψον ἔμπαλιν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:349.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:349.1.text#ἄνω κάτω τὰ πάντα συγχέας ὁμοῦ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:350.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:350.1.text#καὶ στέμματ' ἀνέμοις καὶ θυέλλαισιν μέθες.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:351.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:351.1.text#μάλιστα γάρ νιν δήξομαι δράσας τάδε.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:352.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:352.1.text#οἳ δ' ἀνὰ πόλιν στείχοντες ἐξιχνεύσατε
urn:cts:greekLit:tlg0006.tlg017.fu.sp:353.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:353.1.text#τὸν θηλύμορφον ξένον, ὃς ἐσφέρει νόσον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:354.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:354.1.text#καινὴν γυναιξὶ καὶ λέχη λυμαίνεται.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:355.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:355.1.text#κἄνπερ λάβητε, δέσμιον πορεύσατε
urn:cts:greekLit:tlg0006.tlg017.fu.sp:356.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:356.1.text#δεῦρ' αὐτόν, ὡς ἂν λευσίμου δίκης τυχὼν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:357.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:357.1.text#θάνῃ, πικρὰν βάκχευσιν ἐν Θήβαις ἰδών.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:358.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:358.1.text#ὦ σχέτλι', ὡς οὐκ οἶσθα ποῦ ποτ' εἶ λόγων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:359.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:359.1.text#μέμηνας ἤδη· καὶ πρὶν ἐξέστης φρενῶν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:360.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:360.1.text#στείχωμεν ἡμεῖς, Κάδμε, κἀξαιτώμεθα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:361.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:361.1.text#ὑπέρ τε τούτου καίπερ ὄντος ἀγρίου
urn:cts:greekLit:tlg0006.tlg017.fu.sp:362.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:362.1.text#ὑπέρ τε πόλεως τὸν θεὸν μηδὲν νέον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:363.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:363.1.text#δρᾶν. ἀλλ' ἕπου μοι κισσίνου βάκτρου μέτα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:364.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:364.1.text#πειρῶ δ' ἀνορθοῦν σῶμ' ἐμόν, κἀγὼ τὸ σόν·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:365.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:365.1.text#γέροντε δ' αἰσχρὸν δύο πεσεῖν· ἴτω δ' ὅμως,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:366.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:366.1.text#τῷ Βακχίῳ γὰρ τῷ Διὸς δουλευτέον.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:367.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:367.1.text#Πενθεὺς δ' ὅπως μὴ πένθος εἰσοίσει δόμοις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:368.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:368.1.text#τοῖς σοῖσι, Κάδμε· μαντικῇ μὲν οὐ λέγω,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:369.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:369.1.text#τοῖς πράγμασιν δέ· μῶρα γὰρ μῶρος λέγει.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:370.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:370.1.text#Ὁσία πότνα θεῶν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:371.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:371.1.text#Ὁσία δ' ἃ κατὰ γᾶν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:372.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:372.1.text#χρυσέαν πτέρυγα φέρεις,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:373.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:373.1.text#τάδε Πενθέως ἀίεις;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:374.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:374.1.text#ἀίεις οὐχ ὁσίαν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:375.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:375.1.text#ὕβριν ἐς τὸν Βρόμιον, τὸν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:376.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:376.1.text#Σεμέλας, τὸν παρὰ καλλιστεφάνοις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:377.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:377.1.text#εὐφροσύναις δαίμονα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:378.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:378.1.text#πρῶτον μακάρων; ὃς τάδ' ἔχει,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:379.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:379.1.text#θιασεύειν τε χοροῖς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:380.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:380.1.text#μετά τ' αὐλοῦ γελάσαι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:381.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:381.1.text#ἀποπαῦσαί τε μερίμνας,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:382.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:382.1.text#ὁπόταν βότρυος ἔλθῃ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:383.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:383.1.text#γάνος ἐν δαιτὶ θεῶν, κισσοφόροις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:384.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:384.1.text#δ' ἐν θαλίαις ἀνδράσι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:385.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:385.1.text# κρατὴρ ὕπνον ἀμφιβάλλῃ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:386.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:386.1.text#ἀχαλίνων στομάτων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:387.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:387.1.text#ἀνόμου τ' ἀφροσύνας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:388.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:388.1.text#τὸ τέλος δυστυχία·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:389.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:389.1.text#ὁ δὲ τᾶς ἡσυχίας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:390.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:390.1.text#βίοτος καὶ τὸ φρονεῖν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:391.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:391.1.text#ἀσάλευτόν τε μένει καὶ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:392.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:392.1.text#συνέχει δώματα· πόρσω
urn:cts:greekLit:tlg0006.tlg017.fu.sp:393.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:393.1.text#γὰρ ὅμως αἰθέρα ναίοντες
urn:cts:greekLit:tlg0006.tlg017.fu.sp:394.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:394.1.text#ὁρῶσιν τὰ βροτῶν οὐρανίδαι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:395.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:395.1.text#τὸ σοφὸν δ' οὐ σοφία
urn:cts:greekLit:tlg0006.tlg017.fu.sp:396.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:396.1.text#τό τε μὴ θνητὰ φρονεῖν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:397.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:397.1.text#βραχὺς αἰών· ἐπὶ τούτῳ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:398.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:398.1.text#δέ τις ἂν μεγάλα διώκων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:399.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:399.1.text#τὰ παρόντ' οὐχὶ φέροι. μαινομένων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:400.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:400.1.text#οἵδε τρόποι καὶ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:401.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:401.1.text#κακοβούλων παρ' ἔμοιγε φωτῶν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:402.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:402.1.text#ἱκοίμαν ποτὶ Κύπρον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:403.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:403.1.text#νᾶσον τᾶς Ἀφροδίτας,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:404.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:404.1.text#ἵν' οἱ θελξίφρονες νέμονται
urn:cts:greekLit:tlg0006.tlg017.fu.sp:405.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:405.1.text#θνατοῖσιν Ἔρωτες,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:406.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:406.1.text#Πάφον θ' ἃν ἑκατόστομοι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:407.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:407.1.text#βαρβάρου ποταμοῦ ῥοαὶ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:408.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:408.1.text#καρπίζουσιν ἄνομβροι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:409.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:409.1.text#οὗ δ' ἁ καλλιστευομένα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:410.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:410.1.text#Πιερία μούσειος ἕδρα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:411.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:411.1.text#σεμνὰ κλιτὺς Ὀλύμπου,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:412.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:412.1.text#ἐκεῖσ' ἄγε με, Βρόμιε Βρόμιε,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:413.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:413.1.text#πρόβακχ' εὔιε δαῖμον.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:414.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:414.1.text#ἐκεῖ Χάριτες,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:415.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:415.1.text#ἐκεῖ δὲ Πόθος· ἐκεῖ δὲ βάκχαις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:416.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:416.1.text#θέμις ὀργιάζειν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:417.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:417.1.text#ὁ δαίμων ὁ Διὸς παῖς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:418.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:418.1.text#χαίρει μὲν θαλίαισιν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:419.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:419.1.text#φιλεῖ δ' ὀλβοδότειραν Εἰρήναν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:420.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:420.1.text#κουροτρόφον θεάν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:421.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:421.1.text#ἴσαν δ' ἔς τε τὸν ὄλβιον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:422.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:422.1.text#τόν τε χείρονα δῶκ' ἔχειν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:423.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:423.1.text#οἴνου τέρψιν ἄλυπον·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:424.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:424.1.text#μισεῖ δ' ᾧ μὴ ταῦτα μέλει,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:425.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:425.1.text#κατὰ φάος νύκτας τε φίλας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:426.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:426.1.text#εὐαίωνα διαζῆν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:427.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:427.1.text#σοφὰν δ' ἀπέχειν πραπίδα φρένα τε
urn:cts:greekLit:tlg0006.tlg017.fu.sp:428.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:428.1.text#περισσῶν παρὰ φωτῶν·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:430.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:430.1.text#τὸ πλῆθος ὅ τι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:431.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:431.1.text#τὸ φαυλότερον ἐνόμισε χρῆταί
urn:cts:greekLit:tlg0006.tlg017.fu.sp:432.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:432.1.text#τε, τόδ' ἂν δεχοίμαν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:434.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:434.1.text#Πενθεῦ, πάρεσμεν τήνδ' ἄγραν ἠγρευκότες
urn:cts:greekLit:tlg0006.tlg017.fu.sp:435.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:435.1.text#ἐφ' ἣν ἔπεμψας, οὐδ' ἄκρανθ' ὡρμήσαμεν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:436.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:436.1.text#ὁ θὴρ δ' ὅδ' ἡμῖν πρᾶος οὐδ' ὑπέσπασεν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:437.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:437.1.text#φυγῇ πόδ', ἀλλ' ἔδωκεν οὐκ ἄκων χέρας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:438.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:438.1.text#οὐδ' ὠχρός, οὐδ' ἤλλαξεν οἰνωπὸν γένυν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:439.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:439.1.text#γελῶν δὲ καὶ δεῖν κἀπάγειν ἐφίετο
urn:cts:greekLit:tlg0006.tlg017.fu.sp:440.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:440.1.text#ἔμενέ τε, τοὐμὸν εὐτρεπὲς ποιούμενος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:441.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:441.1.text#κἀγὼ δι' αἰδοῦς εἶπον· Ὦ ξέν', οὐχ ἑκὼν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:442.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:442.1.text#ἄγω σε, Πενθέως δ' ὅς μ' ἔπεμψ' ἐπιστολαῖς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:443.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:443.1.text#ἃς δ' αὖ σὺ βάκχας εἷρξας, ἃς συνήρπασας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:444.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:444.1.text#κἄδησας ἐν δεσμοῖσι πανδήμου στέγης,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:445.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:445.1.text#φροῦδαί γ' ἐκεῖναι λελυμέναι πρὸς ὀργάδας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:446.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:446.1.text#σκιρτῶσι Βρόμιον ἀνακαλούμεναι θεόν·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:447.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:447.1.text#αὐτόματα δ' αὐταῖς δεσμὰ διελύθη ποδῶν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:448.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:448.1.text#κλῇδές τ' ἀνῆκαν θύρετρ' ἄνευ θνητῆς χερός.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:449.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:449.1.text#πολλῶν δ' ὅδ' ἁνὴρ θαυμάτων ἥκει πλέως
urn:cts:greekLit:tlg0006.tlg017.fu.sp:450.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:450.1.text#ἐς τάσδε Θήβας. σοὶ δὲ τἄλλα χρὴ μέλειν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:451.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:451.1.text#μέθεσθε χειρῶν τοῦδ'· ἐν ἄρκυσιν γὰρ ὢν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:452.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:452.1.text#οὐκ ἔστιν οὕτως ὠκὺς ὥστε μ' ἐκφυγεῖν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:453.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:453.1.text#ἀτὰρ τὸ μὲν σῶμ' οὐκ ἄμορφος εἶ, ξένε,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:454.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:454.1.text#ὡς ἐς γυναῖκας, ἐφ' ὅπερ ἐς Θήβας πάρει·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:455.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:455.1.text#πλόκαμός τε γάρ σου ταναός, οὐ πάλης ὕπο,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:456.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:456.1.text#γένυν παρ' αὐτὴν κεχυμένος, πόθου πλέως·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:457.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:457.1.text#λευκὴν δὲ χροιὰν ἐκ παρασκευῆς ἔχεις,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:458.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:458.1.text#οὐχ ἡλίου βολαῖσιν, ἀλλ' ὑπὸ σκιᾶς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:459.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:459.1.text#τὴν Ἀφροδίτην καλλονῇ θηρώμενος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:460.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:460.1.text#πρῶτον μὲν οὖν μοι λέξον ὅστις εἶ γένος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:461.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:461.1.text#οὐ κόμπος οὐδείς· ῥᾴδιον δ' εἰπεῖν τόδε.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:462.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:462.1.text#τὸν ἀνθεμώδη Τμῶλον οἶσθά που κλύων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:463.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:463.1.text#οἶδ', ὃς τὸ Σάρδεων ἄστυ περιβάλλει κύκλῳ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:464.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:464.1.text#ἐντεῦθέν εἰμι, Λυδία δέ μοι πατρίς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:465.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:465.1.text#πόθεν δὲ τελετὰς τάσδ' ἄγεις ἐς Ἑλλάδα;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:466.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:466.1.text#Διόνυσος ἡμᾶς εἰσέβησ', ὁ τοῦ Διός.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:467.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:467.1.text#Ζεὺς δ' ἔστ' ἐκεῖ τις, ὃς νέους τίκτει θεούς;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:468.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:468.1.text#οὔκ, ἀλλ' ὁ Σεμέλην ἐνθάδε ζεύξας γάμοις.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:469.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:469.1.text#πότερα δὲ νύκτωρ σ' ἢ κατ' ὄμμ' ἠνάγκασεν;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:470.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:470.1.text#ὁρῶν ὁρῶντα, καὶ δίδωσιν ὄργια.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:471.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:471.1.text#τὰ δ' ὄργι' ἐστὶ τίν' ἰδέαν ἔχοντά σοι;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:472.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:472.1.text#ἄρρητ' ἀβακχεύτοισιν εἰδέναι βροτῶν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:473.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:473.1.text#ἔχει δ' ὄνησιν τοῖσι θύουσιν τίνα;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:474.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:474.1.text#οὐ θέμις ἀκοῦσαί σ', ἔστι δ' ἄξι' εἰδέναι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:475.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:475.1.text#εὖ τοῦτ' ἐκιβδήλευσας, ἵν' ἀκοῦσαι θέλω.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:476.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:476.1.text#ἀσέβειαν ἀσκοῦντ' ὄργι' ἐχθαίρει θεοῦ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:477.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:477.1.text#τὸν θεὸν ὁρᾶν γὰρ φῂς σαφῶς, ποῖός τις ἦν;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:478.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:478.1.text#ὁποῖος ἤθελ'· οὐκ ἐγὼ 'τασσον τόδε.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:479.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:479.1.text#τοῦτ' αὖ παρωχέτευσας εὖ κοὐδὲν λέγων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:480.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:480.1.text#δόξει τις ἀμαθεῖ σοφὰ λέγων οὐκ εὖ φρονεῖν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:481.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:481.1.text#ἦλθες δὲ πρῶτα δεῦρ' ἄγων τὸν δαίμονα;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:482.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:482.1.text#πᾶς ἀναχορεύει βαρβάρων τάδ' ὄργια.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:483.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:483.1.text#φρονοῦσι γὰρ κάκιον Ἑλλήνων πολύ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:484.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:484.1.text#τάδ' εὖ γε μᾶλλον· οἱ νόμοι δὲ διάφοροι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:485.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:485.1.text#τὰ δ' ἱερὰ νύκτωρ ἢ μεθ' ἡμέραν τελεῖς;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:486.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:486.1.text#νύκτωρ τὰ πολλά· σεμνότητ' ἔχει σκότος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:487.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:487.1.text#τοῦτ' ἐς γυναῖκας δόλιόν ἐστι καὶ σαθρόν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:488.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:488.1.text#κἀν ἡμέρᾳ τό γ' αἰσχρὸν ἐξεύροι τις ἄν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:489.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:489.1.text#δίκην σε δοῦναι δεῖ σοφισμάτων κακῶν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:490.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:490.1.text#σὲ δ' ἀμαθίας γε κἀσεβοῦντ' ἐς τὸν θεόν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:491.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:491.1.text#ὡς θρασὺς ὁ βάκχος κοὐκ ἀγύμναστος λόγων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:492.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:492.1.text#εἴφ' ὅ τι παθεῖν δεῖ· τί με τὸ δεινὸν ἐργάσῃ;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:493.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:493.1.text#πρῶτον μὲν ἁβρὸν βόστρυχον τεμῶ σέθεν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:494.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:494.1.text#ἱερὸς ὁ πλόκαμος· τῷ θεῷ δ' αὐτὸν τρέφω.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:495.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:495.1.text#ἔπειτα θύρσον τόνδε παράδος ἐκ χεροῖν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:496.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:496.1.text#αὐτός μ' ἀφαιροῦ· τόνδε Διονύσου φορῶ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:497.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:497.1.text#εἱρκταῖσί τ' ἔνδον σῶμα σὸν φυλάξομεν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:498.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:498.1.text#λύσει μ' ὁ δαίμων αὐτός, ὅταν ἐγὼ θέλω.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:499.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:499.1.text#ὅταν γε καλέσῃς αὐτὸν ἐν βάκχαις σταθείς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:500.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:500.1.text#καὶ νῦν ἃ πάσχω πλησίον παρὼν ὁρᾷ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:501.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:501.1.text#καὶ ποῦ 'στιν; οὐ γὰρ φανερὸς ὄμμασίν γ' ἐμοῖς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:502.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:502.1.text#παρ' ἐμοί· σὺ δ' ἀσεβὴς αὐτὸς ὢν οὐκ εἰσορᾷς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:503.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:503.1.text#λάζυσθε· καταφρονεῖ με καὶ Θήβας ὅδε.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:504.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:504.1.text#αὐδῶ με μὴ δεῖν σωφρονῶν οὐ σώφροσιν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:505.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:505.1.text#ἐγὼ δὲ δεῖν γε, κυριώτερος σέθεν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:506.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:506.1.text#οὐκ οἶσθ' ὅ τι ζῇς, οὐδ' ὃ δρᾷς, οὐδ' ὅστις εἶ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:507.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:507.1.text#Πενθεύς, Ἀγαύης παῖς, πατρὸς δ' Ἐχίονος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:508.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:508.1.text#ἐνδυστυχῆσαι τοὔνομ' ἐπιτήδειος εἶ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:509.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:509.1.text#χώρει· καθείρξατ' αὐτὸν ἱππικαῖς πέλας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:510.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:510.1.text#φάτναισιν, ὡς ἂν σκότιον εἰσορᾷ κνέφας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:511.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:511.1.text#ἐκεῖ χόρευε· τάσδε δ' ἃς ἄγων πάρει
urn:cts:greekLit:tlg0006.tlg017.fu.sp:512.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:512.1.text#κακῶν συνεργοὺς ἢ διεμπολήσομεν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:513.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:513.1.text#ἢ χεῖρα δούπου τοῦδε καὶ βύρσης κτύπου
urn:cts:greekLit:tlg0006.tlg017.fu.sp:514.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:514.1.text#παύσας, ἐφ' ἱστοῖς δμωίδας κεκτήσομαι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:515.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:515.1.text#στείχοιμ' ἄν· ὅ τι γὰρ μὴ χρεών, οὔτοι χρεὼν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:516.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:516.1.text#παθεῖν. ἀτάρ τοι τῶνδ' ἄποιν' ὑβρισμάτων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:517.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:517.1.text#μέτεισι Διόνυσός σ', ὃν οὐκ εἶναι λέγεις·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:518.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:518.1.text#ἡμᾶς γὰρ ἀδικῶν κεῖνον εἰς δεσμοὺς ἄγεις.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:519.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:519.1.text#Ἀχελῴου θύγατερ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:520.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:520.1.text#πότνι' εὐπάρθενε Δίρκα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:521.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:521.1.text#σὺ γὰρ ἐν σαῖς ποτε παγαῖς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:522.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:522.1.text#τὸ Διὸς βρέφος ἔλαβες,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:523.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:523.1.text#ὅτε μηρῷ πυρὸς ἐξ ἀθανάτου
urn:cts:greekLit:tlg0006.tlg017.fu.sp:524.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:524.1.text#Ζεὺς ὁ τεκὼν ἥρπασέ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:525.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:525.1.text#νιν, τάδ' ἀναβοάσας·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:526.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:526.1.text#Ἴθι, Διθύραμβ', ἐμὰν ἄρσενα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:527.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:527.1.text#τάνδε βᾶθι νηδύν·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:528.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:528.1.text#ἀναφαίνω σε τόδ', ὦ Βάκχιε,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:529.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:529.1.text#Θήβαις ὀνομάζειν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:530.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:530.1.text#σὺ δέ μ', ὦ μάκαιρα Δίρκα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:531.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:531.1.text#στεφανηφόρους ἀπωθῇ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:532.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:532.1.text#θιάσους ἔχουσαν ἐν σοί.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:533.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:533.1.text#τί μ' ἀναίνῃ; τί με φεύγεις;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:534.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:534.1.text#ἔτι ναὶ τὰν βοτρυώδη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:535.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:535.1.text#Διονύσου χάριν οἴνας,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:536.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:536.1.text#ἔτι σοι τοῦ Βρομίου μελήσει.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:537.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:537.1.text#οἵαν οἵαν ὀργὰν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:538.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:538.1.text#ἀναφαίνει χθόνιον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:539.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:539.1.text#γένος ἐκφύς τε δράκοντός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:540.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:540.1.text#ποτε Πενθεύς, ὃν Ἐχίων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:541.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:541.1.text#ἐφύτευσε χθόνιος,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:542.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:542.1.text#ἀγριωπὸν τέρας, οὐ φῶτα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:543.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:543.1.text#βρότειον, φόνιον δ' ὥστε
urn:cts:greekLit:tlg0006.tlg017.fu.sp:544.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:544.1.text#γίγαντ' ἀντίπαλον θεοῖς·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:545.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:545.1.text#ὃς ἔμ' ἐν βρόχοισι τὰν τοῦ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:546.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:546.1.text#Βρομίου τάχα ξυνάψει,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:547.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:547.1.text#τὸν ἐμὸν δ' ἐντὸς ἔχει δώματος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:548.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:548.1.text#ἤδη θιασώταν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:549.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:549.1.text#σκοτίαις κρυπτὸν ἐν εἱρκταῖς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:550.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:550.1.text#ἐσορᾷς τάδ', ὦ Διὸς παῖ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:551.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:551.1.text#Διόνυσε, σοὺς προφήτας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:552.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:552.1.text#ἐν ἁμίλλαισιν ἀνάγκας;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:553.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:553.1.text#μόλε, χρυσῶπα τινάσσων,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:554.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:554.1.text#ἄνα, θύρσον κατ' Ὄλυμπον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:555.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:555.1.text#φονίου δ' ἀνδρὸς ὕβριν κατάσχες.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:556.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:556.1.text#πόθι Νύσας ἄρα τᾶς θηροτρόφου
urn:cts:greekLit:tlg0006.tlg017.fu.sp:557.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:557.1.text#θυρσοφορεῖς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:558.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:558.1.text#θιάσους, ὦ Διόνυσ', ἢ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:559.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:559.1.text#κορυφαῖς Κωρυκίαις;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:560.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:560.1.text#τάχα δ' ἐν ταῖς πολυδένδρεσσιν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:561.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:561.1.text#Ὀλύμπου θαλάμαις, ἔνθα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:562.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:562.1.text#ποτ' Ὀρφεὺς κιθαρίζων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:563.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:563.1.text#σύναγεν δένδρεα μούσαις,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:564.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:564.1.text#σύναγεν θῆρας ἀγρώτας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:565.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:565.1.text#μάκαρ ὦ Πιερία,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:566.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:566.1.text#σέβεταί σ' Εὔιος, ἥξει
urn:cts:greekLit:tlg0006.tlg017.fu.sp:567.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:567.1.text#τε χορεύσων ἅμα βακχεύμασι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:568.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:568.1.text#τόν τ' ὠκυρόαν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:569.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:569.1.text#διαβὰς Ἀξιὸν εἱλισσομένας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:570.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:570.1.text#Μαινάδας ἄξει,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:571.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:571.1.text#Λυδίαν πατέρα τε, τὸν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:572.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:572.1.text#τᾶς εὐδαιμονίας βροτοῖς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:573.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:573.1.text#ὀλβοδόταν, τὸν ἔκλυον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:574.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:574.1.text#εὔιππον χώραν ὕδασιν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:575.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:575.1.text#καλλίστοισι λιπαίνειν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:576.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:576.1.text#ἰώ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:576.2.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:576.2.text#κλύετ' ἐμᾶς κλύετ' αὐδᾶς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:577.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:577.1.text#ἰὼ βάκχαι, ἰὼ βάκχαι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:578.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:578.1.text#τίς ὅδε, τίς { ὅδε } πόθεν ὁ κέλαδος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:579.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:579.1.text#ἀνά μ' ἐκάλεσεν Εὐίου;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:580.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:580.1.text#ἰὼ ἰώ, πάλιν αὐδῶ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:581.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:581.1.text#ὁ Σεμέλας, ὁ Διὸς παῖς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:582.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:582.1.text#ἰὼ ἰὼ δέσποτα δέσποτα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:583.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:583.1.text#μόλε νυν ἡμέτερον ἐς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:584.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:584.1.text#θίασον, ὦ Βρόμιε Βρόμιε.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:585.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:585.1.text#{ σεῖε } πέδον χθονὸς Ἔννοσι πότνια.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:586.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:586.1.text#ἆ ἆ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:587.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:587.1.text#τάχα τὰ Πενθέως μέλαθρα διατινάξεται
urn:cts:greekLit:tlg0006.tlg017.fu.sp:588.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:588.1.text#πεσήμασιν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:589.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:589.1.text#— ὁ Διόνυσος ἀνὰ μέλαθρα·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:590.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:590.1.text#σέβετέ νιν. — σέβομεν ὤ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:591.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:591.1.text#— εἴδετε λάινα κίοσιν ἔμβολα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:592.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:592.1.text#διάδρομα τάδε; Βρόμιος { ὅδ' } ἀλαλάζεται
urn:cts:greekLit:tlg0006.tlg017.fu.sp:593.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:593.1.text#στέγας ἔσω.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:594.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:594.1.text#ἅπτε κεραύνιον αἴθοπα λαμπάδα·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:595.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:595.1.text#σύμφλεγε σύμφλεγε δώματα Πενθέος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:596.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:596.1.text#ἆ ἆ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:596.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:596.2.text#πῦρ οὐ λεύσσεις, οὐδ' αὐγάζῃ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:597.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:597.1.text#Σεμέλας ἱερὸν ἀμφὶ τάφον, ἅν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:598.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:598.1.text#ποτε κεραυνόβολος ἔλιπε φλόγα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:599.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:599.1.text#Δίου βροντᾶς;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:600.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:600.1.text#δίκετε πεδόσε τρομερὰ σώματα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:601.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:601.1.text#δίκετε, Μαινάδες· ὁ γὰρ ἄναξ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:602.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:602.1.text#ἄνω κάτω τιθεὶς ἔπεισι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:603.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:603.1.text#μέλαθρα τάδε Διὸς γόνος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:604.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:604.1.text#βάρβαροι γυναῖκες, οὕτως ἐκπεπληγμέναι φόβῳ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:605.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:605.1.text#πρὸς πέδῳ πεπτώκατ'; ᾔσθησθ', ὡς ἔοικε, Βακχίου
urn:cts:greekLit:tlg0006.tlg017.fu.sp:606.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:606.1.text#διατινάξαντος { δῶμα Πενθέως· ἀλλ' ἐξανίστατε }
urn:cts:greekLit:tlg0006.tlg017.fu.sp:607.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:607.1.text#σῶμα καὶ θαρσεῖτε σαρκὸς ἐξαμείψασαι τρόμον.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:608.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:608.1.text#ὦ φάος μέγιστον ἡμῖν εὐίου βακχεύματος,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:609.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:609.1.text#ὡς ἐσεῖδον ἀσμένη σε, μονάδ' ἔχουσ' ἐρημίαν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:610.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:610.1.text#εἰς ἀθυμίαν ἀφίκεσθ', ἡνίκ' εἰσεπεμπόμην,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:611.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:611.1.text#Πενθέως ὡς ἐς σκοτεινὰς ὁρκάνας πεσούμενος;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:612.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:612.1.text#πῶς γὰρ οὔ; τίς μοι φύλαξ ἦν, εἰ σὺ συμφορᾶς τύχοις;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:613.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:613.1.text#ἀλλὰ πῶς ἠλευθερώθης ἀνδρὸς ἀνοσίου τυχών;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:614.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:614.1.text#αὐτὸς ἐξέσῳσ' ἐμαυτὸν ῥᾳδίως ἄνευ πόνου.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:615.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:615.1.text#οὐδέ σου συνῆψε χεῖρε δεσμίοισιν ἐν βρόχοις;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:616.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:616.1.text#ταῦτα καὶ καθύβρισ' αὐτόν, ὅτι με δεσμεύειν δοκῶν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:617.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:617.1.text#οὔτ' ἔθιγεν οὔθ' ἥψαθ' ἡμῶν, ἐλπίσιν δ' ἐβόσκετο.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:618.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:618.1.text#πρὸς φάτναις δὲ ταῦρον εὑρών, οὗ καθεῖρξ' ἡμᾶς ἄγων,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:619.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:619.1.text#τῷδε περὶ βρόχους ἔβαλλε γόνασι καὶ χηλαῖς ποδῶν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:620.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:620.1.text#θυμὸν ἐκπνέων, ἱδρῶτα σώματος στάζων ἄπο,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:621.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:621.1.text#χείλεσιν διδοὺς ὀδόντας· πλησίον δ' ἐγὼ παρὼν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:622.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:622.1.text#ἥσυχος θάσσων ἔλευσσον. ἐν δὲ τῷδε τῷ χρόνῳ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:623.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:623.1.text#ἀνετίναξ' ἐλθὼν ὁ Βάκχος δῶμα καὶ μητρὸς τάφῳ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:624.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:624.1.text#πῦρ ἀνῆψ'· ὃ δ' ὡς ἐσεῖδε, δώματ' αἴθεσθαι δοκῶν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:625.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:625.1.text#ᾖσσ' ἐκεῖσε κᾆτ' ἐκεῖσε, δμωσὶν Ἀχελῷον φέρειν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:626.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:626.1.text#ἐννέπων, ἅπας δ' ἐν ἔργῳ δοῦλος ἦν, μάτην πονῶν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:627.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:627.1.text#διαμεθεὶς δὲ τόνδε μόχθον, ὡς ἐμοῦ πεφευγότος,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:628.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:628.1.text#ἵεται ξίφος κελαινὸν ἁρπάσας δόμων ἔσω.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:629.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:629.1.text#κᾆθ' ὁ Βρόμιος, ὡς ἔμοιγε φαίνεται, δόξαν λέγω,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:630.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:630.1.text#φάσμ' ἐποίησεν κατ' αὐλήν· ὃ δ' ἐπὶ τοῦθ' ὡρμημένος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:631.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:631.1.text#ᾖσσε κἀκέντει φαεννὸν { αἰθέρ' }, ὡς σφάζων ἐμέ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:632.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:632.1.text#πρὸς δὲ τοῖσδ' αὐτῷ τάδ' ἄλλα Βάκχιος λυμαίνεται·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:633.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:633.1.text#δώματ' ἔρρηξεν χαμᾶζε· συντεθράνωται δ' ἅπαν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:634.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:634.1.text#πικροτάτους ἰδόντι δεσμοὺς τοὺς ἐμούς· κόπου δ' ὕπο
urn:cts:greekLit:tlg0006.tlg017.fu.sp:635.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:635.1.text#διαμεθεὶς ξίφος παρεῖται· πρὸς θεὸν γὰρ ὢν ἀνὴρ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:636.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:636.1.text#ἐς μάχην ἐλθεῖν ἐτόλμησε. ἥσυχος δ' ἐκβὰς ἐγὼ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:637.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:637.1.text#δωμάτων ἥκω πρὸς ὑμᾶς, Πενθέως οὐ φροντίσας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:638.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:638.1.text#ὡς δέ μοι δοκεῖ — ψοφεῖ γοῦν ἀρβύλη δόμων ἔσω —
urn:cts:greekLit:tlg0006.tlg017.fu.sp:639.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:639.1.text#ἐς προνώπι' αὐτίχ' ἥξει. τί ποτ' ἄρ' ἐκ τούτων ἐρεῖ;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:640.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:640.1.text#ῥᾳδίως γὰρ αὐτὸν οἴσω, κἂν πνέων ἔλθῃ μέγα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:641.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:641.1.text#πρὸς σοφοῦ γὰρ ἀνδρὸς ἀσκεῖν σώφρον' εὐοργησίαν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:642.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:642.1.text#πέπονθα δεινά· διαπέφευγέ μ' ὁ ξένος,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:643.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:643.1.text#ὃς ἄρτι δεσμοῖς ἦν κατηναγκασμένος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:644.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:644.1.text#ἔα ἔα·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:645.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:645.1.text#ὅδ' ἐστὶν ἁνήρ· τί τάδε; πῶς προνώπιος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:646.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:646.1.text#φαίνῃ πρὸς οἴκοις τοῖς ἐμοῖς, ἔξω βεβώς;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:647.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:647.1.text#στῆσον πόδ', ὀργῇ δ' ὑπόθες ἥσυχον πόδα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:648.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:648.1.text#πόθεν σὺ δεσμὰ διαφυγὼν ἔξω περᾷς;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:649.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:649.1.text#οὐκ εἶπον—ἢ οὐκ ἤκουσασ—ὅτι λύσει μέ τις;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:650.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:650.1.text#τίς; τοὺς λόγους γὰρ ἐσφέρεις καινοὺς ἀεί.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:651.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:651.1.text#ὃς τὴν πολύβοτρυν ἄμπελον φύει βροτοῖς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:651.2.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:651.2.text#[ … ]
urn:cts:greekLit:tlg0006.tlg017.fu.sp:652.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:652.1.text#ὠνείδισας δὴ τοῦτο Διονύσῳ καλόν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:653.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:653.1.text#κλῄειν κελεύω πάντα πύργον ἐν κύκλῳ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:654.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:654.1.text#τί δ'; οὐχ ὑπερβαίνουσι καὶ τείχη θεοί;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:655.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:655.1.text#σοφὸς σοφὸς σύ, πλὴν ἃ δεῖ σ' εἶναι σοφόν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:656.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:656.1.text#ἃ δεῖ μάλιστα, ταῦτ' ἔγωγ' ἔφυν σοφός.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:657.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:657.1.text#κείνου δ' ἀκούσας πρῶτα τοὺς λόγους μάθε,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:658.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:658.1.text#ὃς ἐξ ὄρους πάρεστιν ἀγγελῶν τί σοι·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:659.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:659.1.text#ἡμεῖς δέ σοι μενοῦμεν, οὐ φευξούμεθα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:660.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:660.1.text#Πενθεῦ κρατύνων τῆσδε Θηβαίας χθονός,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:661.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:661.1.text#ἥκω Κιθαιρῶν' ἐκλιπών, ἵν' οὔποτε
urn:cts:greekLit:tlg0006.tlg017.fu.sp:662.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:662.1.text#λευκῆς χιόνος ἀνεῖσαν εὐαγεῖς βολαί.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:663.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:663.1.text#ἥκεις δὲ ποίαν προστιθεὶς σπουδὴν λόγου;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:664.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:664.1.text#βάκχας ποτνιάδας εἰσιδών, αἳ τῆσδε γῆς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:665.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:665.1.text#οἴστροισι λευκὸν κῶλον ἐξηκόντισαν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:666.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:666.1.text#ἥκω φράσαι σοὶ καὶ πόλει χρῄζων, ἄναξ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:667.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:667.1.text#ὡς δεινὰ δρῶσι θαυμάτων τε κρείσσονα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:668.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:668.1.text#θέλω δ' ἀκοῦσαι, πότερά σοι παρρησίᾳ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:669.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:669.1.text#φράσω τὰ κεῖθεν ἢ λόγον στειλώμεθα·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:670.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:670.1.text#τὸ γὰρ τάχος σου τῶν φρενῶν δέδοικ', ἄναξ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:671.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:671.1.text#καὶ τοὐξύθυμον καὶ τὸ βασιλικὸν λίαν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:672.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:672.1.text#λέγ', ὡς ἀθῷος ἐξ ἐμοῦ πάντως ἔσῃ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:673.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:673.1.text#τοῖς γὰρ δικαίοις οὐχὶ θυμοῦσθαι χρεών.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:674.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:674.1.text#ὅσῳ δ' ἂν εἴπῃς δεινότερα βακχῶν πέρι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:675.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:675.1.text#τοσῷδε μᾶλλον τὸν ὑποθέντα τὰς τέχνας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:676.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:676.1.text#γυναιξὶ τόνδε τῇ δίκῃ προσθήσομεν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:677.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:677.1.text#ἀγελαῖα μὲν βοσκήματ' ἄρτι πρὸς λέπας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:678.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:678.1.text#μόσχων ὑπεξήκριζον, ἡνίχ' ἥλιος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:679.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:679.1.text#ἀκτῖνας ἐξίησι θερμαίνων χθόνα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:680.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:680.1.text#ὁρῶ δὲ θιάσους τρεῖς γυναικείων χορῶν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:681.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:681.1.text#ὧν ἦρχ' ἑνὸς μὲν Αὐτονόη, τοῦ δευτέρου
urn:cts:greekLit:tlg0006.tlg017.fu.sp:682.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:682.1.text#μήτηρ Ἀγαύη σή, τρίτου δ' Ἰνὼ χοροῦ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:683.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:683.1.text#ηὗδον δὲ πᾶσαι σώμασιν παρειμέναι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:684.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:684.1.text#αἳ μὲν πρὸς ἐλάτης νῶτ' ἐρείσασαι φόβην,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:685.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:685.1.text#αἳ δ' ἐν δρυὸς φύλλοισι πρὸς πέδῳ κάρα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:686.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:686.1.text#εἰκῇ βαλοῦσαι σωφρόνως, οὐχ ὡς σὺ φῂς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:687.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:687.1.text#ᾠνωμένας κρατῆρι καὶ λωτοῦ ψόφῳ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:688.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:688.1.text#θηρᾶν καθ' ὕλην Κύπριν ἠρημωμένας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:689.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:689.1.text#ἡ σὴ δὲ μήτηρ ὠλόλυξεν ἐν μέσαις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:690.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:690.1.text#σταθεῖσα βάκχαις, ἐξ ὕπνου κινεῖν δέμας,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:691.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:691.1.text#μυκήμαθ' ὡς ἤκουσε κεροφόρων βοῶν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:692.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:692.1.text#αἳ δ' ἀποβαλοῦσαι θαλερὸν ὀμμάτων ὕπνον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:693.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:693.1.text#ἀνῇξαν ὀρθαί, θαῦμ' ἰδεῖν εὐκοσμίας,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:694.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:694.1.text#νέαι παλαιαὶ παρθένοι τ' ἔτ' ἄζυγες.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:695.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:695.1.text#καὶ πρῶτα μὲν καθεῖσαν εἰς ὤμους κόμας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:696.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:696.1.text#νεβρίδας τ' ἀνεστείλανθ' ὅσαισιν ἁμμάτων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:697.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:697.1.text#σύνδεσμ' ἐλέλυτο, καὶ καταστίκτους δορὰς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:698.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:698.1.text#ὄφεσι κατεζώσαντο λιχμῶσιν γένυν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:699.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:699.1.text#αἳ δ' ἀγκάλαισι δορκάδ' ἢ σκύμνους λύκων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:700.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:700.1.text#ἀγρίους ἔχουσαι λευκὸν ἐδίδοσαν γάλα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:701.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:701.1.text#ὅσαις νεοτόκοις μαστὸς ἦν σπαργῶν ἔτι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:702.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:702.1.text#βρέφη λιπούσαις· ἐπὶ δ' ἔθεντο κισσίνους
urn:cts:greekLit:tlg0006.tlg017.fu.sp:703.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:703.1.text#στεφάνους δρυός τε μίλακός τ' ἀνθεσφόρου.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:704.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:704.1.text#θύρσον δέ τις λαβοῦσ' ἔπαισεν ἐς πέτραν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:705.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:705.1.text#ὅθεν δροσώδης ὕδατος ἐκπηδᾷ νοτίς·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:706.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:706.1.text#ἄλλη δὲ νάρθηκ' ἐς πέδον καθῆκε γῆς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:707.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:707.1.text#καὶ τῇδε κρήνην ἐξανῆκ' οἴνου θεός·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:708.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:708.1.text#ὅσαις δὲ λευκοῦ πώματος πόθος παρῆν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:709.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:709.1.text#ἄκροισι δακτύλοισι διαμῶσαι χθόνα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:710.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:710.1.text#γάλακτος ἑσμοὺς εἶχον· ἐκ δὲ κισσίνων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:711.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:711.1.text#θύρσων γλυκεῖαι μέλιτος ἔσταζον ῥοαί.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:712.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:712.1.text#ὥστ', εἰ παρῆσθα, τὸν θεὸν τὸν νῦν ψέγεις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:713.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:713.1.text#εὐχαῖσιν ἂν μετῆλθες εἰσιδὼν τάδε.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:714.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:714.1.text#ξυνήλθομεν δὲ βουκόλοι καὶ ποιμένες,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:715.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:715.1.text#κοινῶν λόγων δώσοντες ἀλλήλοις ἔριν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:716.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:716.1.text#ὡς δεινὰ δρῶσι θαυμάτων τ' ἐπάξια·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:717.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:717.1.text#καί τις πλάνης κατ' ἄστυ καὶ τρίβων λόγων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:718.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:718.1.text#ἔλεξεν εἰς ἅπαντας· Ὦ σεμνὰς πλάκας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:719.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:719.1.text#ναίοντες ὀρέων, θέλετε θηρασώμεθα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:720.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:720.1.text#Πενθέως Ἀγαύην μητέρ' ἐκ βακχευμάτων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:721.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:721.1.text#χάριν τ' ἄνακτι θώμεθα; εὖ δ' ἡμῖν λέγειν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:722.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:722.1.text#ἔδοξε, θάμνων δ' ἐλλοχίζομεν φόβαις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:723.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:723.1.text#κρύψαντες αὑτούς· αἳ δὲ τὴν τεταγμένην
urn:cts:greekLit:tlg0006.tlg017.fu.sp:724.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:724.1.text#ὥραν ἐκίνουν θύρσον ἐς βακχεύματα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:725.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:725.1.text#Ἴακχον ἀθρόῳ στόματι τὸν Διὸς γόνον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:726.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:726.1.text#Βρόμιον καλοῦσαι· πᾶν δὲ συνεβάκχευ' ὄρος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:727.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:727.1.text#καὶ θῆρες, οὐδὲν δ' ἦν ἀκίνητον δρόμῳ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:728.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:728.1.text#κυρεῖ δ' Ἀγαύη πλησίον θρῴσκουσά μου·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:729.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:729.1.text#κἀγὼ 'ξεπήδησ' ὡς συναρπάσαι θέλων,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:730.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:730.1.text#λόχμην κενώσας ἔνθ' ἐκρυπτόμην δέμας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:731.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:731.1.text#ἣ δ' ἀνεβόησεν· Ὦ δρομάδες ἐμαὶ κύνες,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:732.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:732.1.text#θηρώμεθ' ἀνδρῶν τῶνδ' ὕπ'· ἀλλ' ἕπεσθέ μοι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:733.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:733.1.text#ἕπεσθε θύρσοις διὰ χερῶν ὡπλισμέναι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:734.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:734.1.text#ἡμεῖς μὲν οὖν φεύγοντες ἐξηλύξαμεν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:735.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:735.1.text#βακχῶν σπαραγμόν, αἳ δὲ νεμομέναις χλόην
urn:cts:greekLit:tlg0006.tlg017.fu.sp:736.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:736.1.text#μόσχοις ἐπῆλθον χειρὸς ἀσιδήρου μέτα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:737.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:737.1.text#καὶ τὴν μὲν ἂν προσεῖδες εὔθηλον πόριν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:738.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:738.1.text#μυκωμένην ἔχουσαν ἐν χεροῖν δίχα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:739.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:739.1.text#ἄλλαι δὲ δαμάλας διεφόρουν σπαράγμασιν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:740.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:740.1.text#εἶδες δ' ἂν ἢ πλεύρ' ἢ δίχηλον ἔμβασιν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:741.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:741.1.text#ῥιπτόμεν' ἄνω τε καὶ κάτω· κρεμαστὰ δὲ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:742.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:742.1.text#ἔσταζ' ὑπ' ἐλάταις ἀναπεφυρμέν' αἵματι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:743.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:743.1.text#ταῦροι δ' ὑβρισταὶ κἀς κέρας θυμούμενοι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:744.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:744.1.text#τὸ πρόσθεν ἐσφάλλοντο πρὸς γαῖαν δέμας,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:745.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:745.1.text#μυριάσι χειρῶν ἀγόμενοι νεανίδων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:746.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:746.1.text#θᾶσσον δὲ διεφοροῦντο σαρκὸς ἐνδυτὰ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:747.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:747.1.text#ἢ σὲ ξυνάψαι βλέφαρα βασιλείοις κόραις.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:748.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:748.1.text#χωροῦσι δ' ὥστ' ὄρνιθες ἀρθεῖσαι δρόμῳ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:749.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:749.1.text#πεδίων ὑποτάσεις, αἳ παρ' Ἀσωποῦ ῥοαῖς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:750.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:750.1.text#εὔκαρπον ἐκβάλλουσι Θηβαίων στάχυν·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:751.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:751.1.text#Ὑσιάς τ' Ἐρυθράς θ', αἳ Κιθαιρῶνος λέπας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:752.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:752.1.text#νέρθεν κατῳκήκασιν, ὥστε πολέμιοι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:753.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:753.1.text#ἐπεσπεσοῦσαι πάντ' ἄνω τε καὶ κάτω
urn:cts:greekLit:tlg0006.tlg017.fu.sp:754.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:754.1.text#διέφερον· ἥρπαζον μὲν ἐκ δόμων τέκνα·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:755.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:755.1.text#ὁπόσα δ' ἐπ' ὤμοις ἔθεσαν, οὐ δεσμῶν ὕπο
urn:cts:greekLit:tlg0006.tlg017.fu.sp:756.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:756.1.text#προσείχετ' οὐδ' ἔπιπτεν ἐς μέλαν πέδον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:757.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:757.1.text#οὐ χαλκός, οὐ σίδηρος· ἐπὶ δὲ βοστρύχοις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:758.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:758.1.text#πῦρ ἔφερον, οὐδ' ἔκαιεν. οἳ δ' ὀργῆς ὕπο
urn:cts:greekLit:tlg0006.tlg017.fu.sp:759.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:759.1.text#ἐς ὅπλ' ἐχώρουν φερόμενοι βακχῶν ὕπο·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:760.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:760.1.text#οὗπερ τὸ δεινὸν ἦν θέαμ' ἰδεῖν, ἄναξ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:761.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:761.1.text#τοῖς μὲν γὰρ οὐχ ᾕμασσε λογχωτὸν βέλος,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:762.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:762.1.text#κεῖναι δὲ θύρσους ἐξανιεῖσαι χερῶν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:763.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:763.1.text#ἐτραυμάτιζον κἀπενώτιζον φυγῇ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:764.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:764.1.text#γυναῖκες ἄνδρας, οὐκ ἄνευ θεῶν τινος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:765.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:765.1.text#πάλιν δ' ἐχώρουν ὅθεν ἐκίνησαν πόδα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:766.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:766.1.text#κρήνας ἐπ' αὐτὰς ἃς ἀνῆκ' αὐταῖς θεός.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:767.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:767.1.text#νίψαντο δ' αἷμα, σταγόνα δ' ἐκ παρηίδων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:768.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:768.1.text#γλώσσῃ δράκοντες ἐξεφαίδρυνον χροός.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:769.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:769.1.text#τὸν δαίμον' οὖν τόνδ' ὅστις ἔστ', ὦ δέσποτα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:770.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:770.1.text#δέχου πόλει τῇδ'· ὡς τά τ' ἄλλ' ἐστὶν μέγας,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:771.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:771.1.text#κἀκεῖνό φασιν αὐτόν, ὡς ἐγὼ κλύω,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:772.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:772.1.text#τὴν παυσίλυπον ἄμπελον δοῦναι βροτοῖς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:773.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:773.1.text#οἴνου δὲ μηκέτ' ὄντος οὐκ ἔστιν Κύπρις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:774.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:774.1.text#οὐδ' ἄλλο τερπνὸν οὐδὲν ἀνθρώποις ἔτι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:775.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:775.1.text#ταρβῶ μὲν εἰπεῖν τοὺς λόγους ἐλευθέρους
urn:cts:greekLit:tlg0006.tlg017.fu.sp:776.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:776.1.text#πρὸς τὸν τύραννον, ἀλλ' ὅμως εἰρήσεται·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:777.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:777.1.text#Διόνυσος ἥσσων οὐδενὸς θεῶν ἔφυ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:778.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:778.1.text#ἤδη τόδ' ἐγγὺς ὥστε πῦρ ὑφάπτεται
urn:cts:greekLit:tlg0006.tlg017.fu.sp:779.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:779.1.text#ὕβρισμα βακχῶν, ψόγος ἐς Ἕλληνας μέγας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:780.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:780.1.text#ἀλλ' οὐκ ὀκνεῖν δεῖ· στεῖχ' ἐπ' Ἠλέκτρας ἰὼν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:781.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:781.1.text#πύλας· κέλευε πάντας ἀσπιδηφόρους
urn:cts:greekLit:tlg0006.tlg017.fu.sp:782.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:782.1.text#ἵππων τ' ἀπαντᾶν ταχυπόδων ἐπεμβάτας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:783.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:783.1.text#πέλτας θ' ὅσοι πάλλουσι καὶ τόξων χερὶ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:784.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:784.1.text#ψάλλουσι νευράς, ὡς ἐπιστρατεύσομεν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:785.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:785.1.text#βάκχαισιν· οὐ γὰρ ἀλλ' ὑπερβάλλει τάδε,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:786.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:786.1.text#εἰ πρὸς γυναικῶν πεισόμεσθ' ἃ πάσχομεν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:787.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:787.1.text#πείθῃ μὲν οὐδέν, τῶν ἐμῶν λόγων κλύων,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:788.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:788.1.text#Πενθεῦ· κακῶς δὲ πρὸς σέθεν πάσχων ὅμως
urn:cts:greekLit:tlg0006.tlg017.fu.sp:789.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:789.1.text#οὔ φημι χρῆναί σ' ὅπλ' ἐπαίρεσθαι θεῷ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:790.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:790.1.text#ἀλλ' ἡσυχάζειν· Βρόμιος οὐκ ἀνέξεται
urn:cts:greekLit:tlg0006.tlg017.fu.sp:791.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:791.1.text#κινοῦντα βάκχας { σ' } εὐίων ὀρῶν ἄπο.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:792.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:792.1.text#οὐ μὴ φρενώσεις μ', ἀλλὰ δέσμιος φυγὼν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:793.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:793.1.text#σῴσῃ τόδ'; ἢ σοὶ πάλιν ἀναστρέψω δίκην;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:794.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:794.1.text#θύοιμ' ἂν αὐτῷ μᾶλλον ἢ θυμούμενος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:795.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:795.1.text#πρὸς κέντρα λακτίζοιμι θνητὸς ὢν θεῷ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:796.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:796.1.text#θύσω, φόνον γε θῆλυν, ὥσπερ ἄξιαι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:797.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:797.1.text#πολὺν ταράξας ἐν Κιθαιρῶνος πτυχαῖς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:798.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:798.1.text#φεύξεσθε πάντες· καὶ τόδ' αἰσχρόν, ἀσπίδας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:799.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:799.1.text#θύρσοισι βακχῶν ἐκτρέπειν χαλκηλάτους
urn:cts:greekLit:tlg0006.tlg017.fu.sp:800.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:800.1.text#ἀπόρῳ γε τῷδε συμπεπλέγμεθα ξένῳ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:801.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:801.1.text#ὃς οὔτε πάσχων οὔτε δρῶν σιγήσεται.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:802.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:802.1.text#ὦ τᾶν, ἔτ' ἔστιν εὖ καταστῆσαι τάδε.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:803.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:803.1.text#τί δρῶντα; δουλεύοντα δουλείαις ἐμαῖς;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:804.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:804.1.text#ἐγὼ γυναῖκας δεῦρ' ὅπλων ἄξω δίχα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:805.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:805.1.text#οἴμοι· τόδ' ἤδη δόλιον ἔς με μηχανᾷ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:806.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:806.1.text#ποῖόν τι, σῷσαί σ' εἰ θέλω τέχναις ἐμαῖς;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:807.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:807.1.text#ξυνέθεσθε κοινῇ τάδ', ἵνα βακχεύητ' ἀεί.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:808.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:808.1.text#καὶ μὴν ξυνεθέμην—τοῦτό γ' ἔστι—τῷ θεῷ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:809.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:809.1.text#ἐκφέρετέ μοι δεῦρ' ὅπλα, σὺ δὲ παῦσαι λέγων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:810.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:810.1.text#ἆ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:811.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:811.1.text#βούλῃ σφ' ἐν ὄρεσι συγκαθημένας ἰδεῖν;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:812.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:812.1.text#μάλιστα, μυρίον γε δοὺς χρυσοῦ σταθμόν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:813.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:813.1.text#τί δ' εἰς ἔρωτα τοῦδε πέπτωκας μέγαν;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:814.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:814.1.text#λυπρῶς νιν εἰσίδοιμ' ἂν ἐξῳνωμένας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:815.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:815.1.text#ὅμως δ' ἴδοις ἂν ἡδέως ἅ σοι πικρά;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:816.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:816.1.text#σάφ' ἴσθι, σιγῇ γ' ὑπ' ἐλάταις καθήμενος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:817.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:817.1.text#ἀλλ' ἐξιχνεύσουσίν σε, κἂν ἔλθῃς λάθρᾳ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:818.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:818.1.text#ἀλλ' ἐμφανῶς· καλῶς γὰρ ἐξεῖπας τάδε.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:819.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:819.1.text#ἄγωμεν οὖν σε κἀπιχειρήσεις ὁδῷ;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:820.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:820.1.text#ἄγ' ὡς τάχιστα, τοῦ χρόνου δέ σοι φθονῶ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:821.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:821.1.text#στεῖλαί νυν ἀμφὶ χρωτὶ βυσσίνους πέπλους.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:822.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:822.1.text#τί δὴ τόδ'; ἐς γυναῖκας ἐξ ἀνδρὸς τελῶ;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:823.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:823.1.text#μή σε κτάνωσιν, ἢν ἀνὴρ ὀφθῇς ἐκεῖ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:824.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:824.1.text#εὖ γ' εἶπας αὖ τόδ'· ὥς τις εἶ πάλαι σοφός.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:825.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:825.1.text#Διόνυσος ἡμᾶς ἐξεμούσωσεν τάδε.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:826.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:826.1.text#πῶς οὖν γένοιτ' ἂν ἃ σύ με νουθετεῖς καλῶς;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:827.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:827.1.text#ἐγὼ στελῶ σε δωμάτων ἔσω μολών.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:828.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:828.1.text#τίνα στολήν; ἦ θῆλυν; ἀλλ' αἰδώς μ' ἔχει.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:829.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:829.1.text#οὐκέτι θεατὴς μαινάδων πρόθυμος εἶ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:830.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:830.1.text#στολὴν δὲ τίνα φῂς ἀμφὶ χρῶτ' ἐμὸν βαλεῖν;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:831.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:831.1.text#κόμην μὲν ἐπὶ σῷ κρατὶ ταναὸν ἐκτενῶ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:832.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:832.1.text#τὸ δεύτερον δὲ σχῆμα τοῦ κόσμου τί μοι;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:833.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:833.1.text#πέπλοι ποδήρεις· ἐπὶ κάρᾳ δ' ἔσται μίτρα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:834.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:834.1.text#ἦ καί τι πρὸς τοῖσδ' ἄλλο προσθήσεις ἐμοί;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:835.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:835.1.text#θύρσον γε χειρὶ καὶ νεβροῦ στικτὸν δέρας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:836.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:836.1.text#οὐκ ἂν δυναίμην θῆλυν ἐνδῦναι στολήν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:837.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:837.1.text#ἀλλ' αἷμα θήσεις συμβαλὼν βάκχαις μάχην.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:838.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:838.1.text#ὀρθῶς· μολεῖν χρὴ πρῶτον εἰς κατασκοπήν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:839.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:839.1.text#σοφώτερον γοῦν ἢ κακοῖς θηρᾶν κακά.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:840.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:840.1.text#καὶ πῶς δι' ἄστεως εἶμι Καδμείους λαθών;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:841.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:841.1.text#ὁδοὺς ἐρήμους ἴμεν· ἐγὼ δ' ἡγήσομαι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:842.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:842.1.text#πᾶν κρεῖσσον ὥστε μὴ 'γγελᾶν βάκχας ἐμοί.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:843.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:843.1.text#ἐλθόντ' ἐς οἴκους  [ … ] ἃν δοκῇ βουλεύσομαι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:844.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:844.1.text#ἔξεστι· πάντῃ τό γ' ἐμὸν εὐτρεπὲς πάρα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:845.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:845.1.text#στείχοιμ' ἄν· ἢ γὰρ ὅπλ' ἔχων πορεύσομαι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:846.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:846.1.text#ἢ τοῖσι σοῖσι πείσομαι βουλεύμασιν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:848.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:848.1.text#γυναῖκες, ἁνὴρ ἐς βόλον καθίσταται,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:847.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:847.1.text#ἥξει δὲ βάκχας, οὗ θανὼν δώσει δίκην.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:849.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:849.1.text#Διόνυσε, νῦν σὸν ἔργον· οὐ γὰρ εἶ πρόσω·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:850.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:850.1.text#τεισώμεθ' αὐτόν. πρῶτα δ' ἔκστησον φρενῶν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:851.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:851.1.text#ἐνεὶς ἐλαφρὰν λύσσαν· ὡς φρονῶν μὲν εὖ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:852.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:852.1.text#οὐ μὴ θελήσῃ θῆλυν ἐνδῦναι στολήν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:853.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:853.1.text#ἔξω δ' ἐλαύνων τοῦ φρονεῖν ἐνδύσεται.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:854.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:854.1.text#χρῄζω δέ νιν γέλωτα Θηβαίοις ὀφλεῖν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:855.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:855.1.text#γυναικόμορφον ἀγόμενον δι' ἄστεως
urn:cts:greekLit:tlg0006.tlg017.fu.sp:856.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:856.1.text#ἐκ τῶν ἀπειλῶν τῶν πρίν, αἷσι δεινὸς ἦν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:857.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:857.1.text#ἀλλ' εἶμι κόσμον ὅνπερ εἰς Ἅιδου λαβὼν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:858.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:858.1.text#ἄπεισι μητρὸς ἐκ χεροῖν κατασφαγείς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:859.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:859.1.text#Πενθεῖ προσάψων· γνώσεται δὲ τὸν Διὸς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:860.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:860.1.text#Διόνυσον, ὃς πέφυκεν ἐν τέλει θεός,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:861.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:861.1.text#δεινότατος, ἀνθρώποισι δ' ἠπιώτατος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:862.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:862.1.text#ἆρ' ἐν παννυχίοις χοροῖς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:863.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:863.1.text#θήσω ποτὲ λευκὸν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:864.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:864.1.text#πόδ' ἀναβακχεύουσα, δέραν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:865.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:865.1.text#εἰς αἰθέρα δροσερὸν ῥίπτουσ',
urn:cts:greekLit:tlg0006.tlg017.fu.sp:866.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:866.1.text#ὡς νεβρὸς χλοεραῖς ἐμπαίζουσα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:867.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:867.1.text#λείμακος ἡδοναῖς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:868.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:868.1.text#ἡνίκ' ἂν φοβερὰν φύγῃ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:869.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:869.1.text#θήραν ἔξω φυλακᾶς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:870.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:870.1.text#εὐπλέκτων ὑπὲρ ἀρκύων,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:871.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:871.1.text#θωΰσσων δὲ κυναγέτας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:872.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:872.1.text#συντείνῃ δράμημα κυνῶν·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:873.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:873.1.text#μόχθοις τ' ὠκυδρόμοις τ' ἀέλλαις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:873.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:873.2.text#θρῴσκει πεδίον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:874.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:874.1.text#παραποτάμιον, ἡδομένα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:875.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:875.1.text#βροτῶν ἐρημίαις σκιαροκόμοιό
urn:cts:greekLit:tlg0006.tlg017.fu.sp:876.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:876.1.text#τ' ἔρνεσιν ὕλας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:877.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:877.1.text#τί τὸ σοφόν; ἢ τί τὸ κάλλιον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:878.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:878.1.text#παρὰ θεῶν γέρας ἐν βροτοῖς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:879.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:879.1.text#ἢ χεῖρ' ὑπὲρ κορυφᾶς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:880.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:880.1.text#τῶν ἐχθρῶν κρείσσω κατέχειν;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:881.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:881.1.text#ὅ τι καλὸν φίλον ἀεί.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:882.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:882.1.text#ὁρμᾶται μόλις, ἀλλ' ὅμως
urn:cts:greekLit:tlg0006.tlg017.fu.sp:883.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:883.1.text#πιστόν { τι } τὸ θεῖον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:884.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:884.1.text#σθένος· ἀπευθύνει δὲ βροτῶν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:885.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:885.1.text#τούς τ' ἀγνωμοσύναν τιμῶντας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:886.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:886.1.text# καὶ μὴ τὰ θεῶν αὔξοντας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:887.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:887.1.text# σὺν μαινομένᾳ δόξᾳ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:888.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:888.1.text#κρυπτεύουσι δὲ ποικίλως
urn:cts:greekLit:tlg0006.tlg017.fu.sp:889.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:889.1.text#δαρὸν χρόνου πόδα καὶ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:890.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:890.1.text#θηρῶσιν τὸν ἄσεπτον. οὐ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:891.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:891.1.text#γὰρ κρεῖσσόν ποτε τῶν νόμων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:892.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:892.1.text#γιγνώσκειν χρὴ καὶ μελετᾶν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:893.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:893.1.text#κούφα γὰρ δαπάνα νομίζειν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:893.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:893.2.text#ἰσχὺν τόδ' ἔχειν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:894.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:894.1.text#ὅ τι ποτ' ἄρα τὸ δαιμόνιον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:895.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:895.1.text#τό τ' ἐν χρόνῳ μακρῷ νόμιμον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:896.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:896.1.text#ἀεὶ φύσει τε πεφυκός.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:897.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:897.1.text#τί τὸ σοφόν; ἢ τί τὸ κάλλιον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:898.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:898.1.text#παρὰ θεῶν γέρας ἐν βροτοῖς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:899.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:899.1.text#ἢ χεῖρ' ὑπὲρ κορυφᾶς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:900.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:900.1.text#τῶν ἐχθρῶν κρείσσω κατέχειν;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:901.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:901.1.text#ὅ τι καλὸν φίλον ἀεί.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:902.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:902.1.text#εὐδαίμων μὲν ὃς ἐκ θαλάσσας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:903.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:903.1.text#ἔφυγε χεῖμα, λιμένα δ' ἔκιχεν·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:904.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:904.1.text#εὐδαίμων δ' ὃς ὕπερθε μόχθων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:905.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:905.1.text#ἐγένεθ'· ἑτέρᾳ δ' ἕτερος ἕτερον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:906.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:906.1.text#ὄλβῳ καὶ δυνάμει παρῆλθεν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:907.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:907.1.text#μυρίαι δ' ἔτι μυρίοις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:908.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:908.1.text#εἰσὶν ἐλπίδες· αἳ μὲν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:908.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:908.2.text#τελευτῶσιν ἐν ὄλβῳ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:909.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:909.1.text#βροτοῖς, αἳ δ' ἀπέβησαν·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:910.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:910.1.text#τὸ δὲ κατ' ἦμαρ ὅτῳ βίοτος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:911.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:911.1.text#εὐδαίμων, μακαρίζω.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:912.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:912.1.text#σὲ τὸν πρόθυμον ὄνθ' ἃ μὴ χρεὼν ὁρᾶν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:913.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:913.1.text#σπεύδοντά τ' ἀσπούδαστα, Πενθέα λέγω,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:914.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:914.1.text#ἔξιθι πάροιθε δωμάτων, ὄφθητί μοι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:915.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:915.1.text#σκευὴν γυναικὸς μαινάδος βάκχης ἔχων,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:916.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:916.1.text#μητρός τε τῆς σῆς καὶ λόχου κατάσκοπος·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:917.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:917.1.text#πρέπεις δὲ Κάδμου θυγατέρων μορφὴν μιᾷ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:918.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:918.1.text#καὶ μὴν ὁρᾶν μοι δύο μὲν ἡλίους δοκῶ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:919.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:919.1.text#δισσὰς δὲ Θήβας καὶ πόλισμ' ἑπτάστομον·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:920.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:920.1.text#καὶ ταῦρος ἡμῖν πρόσθεν ἡγεῖσθαι δοκεῖς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:921.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:921.1.text#καὶ σῷ κέρατα κρατὶ προσπεφυκέναι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:922.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:922.1.text#ἀλλ' ἦ ποτ' ἦσθα θήρ; τεταύρωσαι γὰρ οὖν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:923.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:923.1.text#ὁ θεὸς ὁμαρτεῖ, πρόσθεν ὢν οὐκ εὐμενής,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:924.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:924.1.text#ἔνσπονδος ἡμῖν· νῦν δ' ὁρᾷς ἃ χρή σ' ὁρᾶν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:925.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:925.1.text#τί φαίνομαι δῆτ'; οὐχὶ τὴν Ἰνοῦς στάσιν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:926.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:926.1.text#ἢ τὴν Ἀγαύης ἑστάναι, μητρός γ' ἐμῆς;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:927.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:927.1.text#αὐτὰς ἐκείνας εἰσορᾶν δοκῶ σ' ὁρῶν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:928.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:928.1.text#ἀλλ' ἐξ ἕδρας σοι πλόκαμος ἐξέστηχ' ὅδε,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:929.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:929.1.text#οὐχ ὡς ἐγώ νιν ὑπὸ μίτρᾳ καθήρμοσα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:930.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:930.1.text#ἔνδον προσείων αὐτὸν ἀνασείων τ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:931.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:931.1.text#καὶ βακχιάζων ἐξ ἕδρας μεθώρμισα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:932.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:932.1.text#ἀλλ' αὐτὸν ἡμεῖς, οἷς σε θεραπεύειν μέλει,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:933.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:933.1.text#πάλιν καταστελοῦμεν· ἀλλ' ὄρθου κάρα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:934.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:934.1.text#ἰδού, σὺ κόσμει· σοὶ γὰρ ἀνακείμεσθα δή.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:935.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:935.1.text#ζῶναί τέ σοι χαλῶσι κοὐχ ἑξῆς πέπλων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:936.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:936.1.text#στολίδες ὑπὸ σφυροῖσι τείνουσιν σέθεν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:937.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:937.1.text#κἀμοὶ δοκοῦσι παρά γε δεξιὸν πόδα·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:938.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:938.1.text#τἀνθένδε δ' ὀρθῶς παρὰ τένοντ' ἔχει πέπλος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:939.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:939.1.text#ἦ πού με τῶν σῶν πρῶτον ἡγήσῃ φίλων,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:940.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:940.1.text#ὅταν παρὰ λόγον σώφρονας βάκχας ἴδῃς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:941.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:941.1.text#πότερα δὲ θύρσον δεξιᾷ λαβὼν χερὶ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:942.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:942.1.text#ἢ τῇδε, βάκχῃ μᾶλλον εἰκασθήσομαι;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:943.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:943.1.text#ἐν δεξιᾷ χρὴ χἅμα δεξιῷ ποδὶ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:944.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:944.1.text#αἴρειν νιν· αἰνῶ δ' ὅτι μεθέστηκας φρενῶν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:945.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:945.1.text#ἆρ' ἂν δυναίμην τὰς Κιθαιρῶνος πτυχὰς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:946.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:946.1.text#αὐταῖσι βάκχαις τοῖς ἐμοῖς ὤμοις φέρειν;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:947.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:947.1.text#δύναι' ἄν, εἰ βούλοιο· τὰς δὲ πρὶν φρένας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:948.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:948.1.text#οὐκ εἶχες ὑγιεῖς, νῦν δ' ἔχεις οἵας σε δεῖ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:949.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:949.1.text#μοχλοὺς φέρωμεν; ἢ χεροῖν ἀνασπάσω
urn:cts:greekLit:tlg0006.tlg017.fu.sp:950.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:950.1.text#κορυφαῖς ὑποβαλὼν ὦμον ἢ βραχίονα;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:951.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:951.1.text#μὴ σύ γε τὰ Νυμφῶν διολέσῃς ἱδρύματα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:952.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:952.1.text#καὶ Πανὸς ἕδρας ἔνθ' ἔχει συρίγματα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:953.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:953.1.text#καλῶς ἔλεξας· οὐ σθένει νικητέον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:954.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:954.1.text#γυναῖκας· ἐλάταισιν δ' ἐμὸν κρύψω δέμας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:955.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:955.1.text#κρύψῃ σὺ κρύψιν ἥν σε κρυφθῆναι χρεών,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:956.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:956.1.text#ἐλθόντα δόλιον μαινάδων κατάσκοπον.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:957.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:957.1.text#καὶ μὴν δοκῶ σφᾶς ἐν λόχμαις ὄρνιθας ὣς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:958.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:958.1.text#λέκτρων ἔχεσθαι φιλτάτοις ἐν ἕρκεσιν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:959.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:959.1.text#οὐκοῦν ἐπ' αὐτὸ τοῦτ' ἀποστέλλῃ φύλαξ·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:960.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:960.1.text#λήψῃ δ' ἴσως σφᾶς, ἢν σὺ μὴ ληφθῇς πάρος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:961.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:961.1.text#κόμιζε διὰ μέσης με Θηβαίας χθονός·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:962.1.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:962.1.text#μόνος γὰρ αὐτῶν εἰμ' ἀνὴρ τολμῶν τόδε.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:963.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:963.1.text#μόνος σὺ πόλεως τῆσδ' ὑπερκάμνεις, μόνος·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:964.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:964.1.text#τοιγάρ σ' ἀγῶνες ἀναμένουσιν οὓς ἐχρῆν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:965.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:965.1.text#ἕπου δέ· πομπὸς [ δ' ] εἶμ' ἐγὼ σωτήριος,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:966.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:966.1.text#κεῖθεν δ' ἀπάξει σ' ἄλλος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:966.2.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:966.2.text#ἡ τεκοῦσά γε.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:967.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:967.1.text#ἐπίσημον ὄντα πᾶσιν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:967.2.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:967.2.text#ἐπὶ τόδ' ἔρχομαι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:968.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:968.1.text#φερόμενος ἥξεις  [ … ]
urn:cts:greekLit:tlg0006.tlg017.fu.sp:968.2.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:968.2.text#ἁβρότητ' ἐμὴν λέγεις.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:969.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:969.1.text#ἐν χερσὶ μητρός.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:969.2.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:969.2.text#καὶ τρυφᾶν μ' ἀναγκάσεις.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:970.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:970.1.text#τρυφάς γε τοιάσδε.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:970.2.speaker#Πενθεύς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:970.2.text#ἀξίων μὲν ἅπτομαι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:971.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:971.1.text#δεινὸς σὺ δεινὸς κἀπὶ δείν' ἔρχῃ πάθη,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:972.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:972.1.text#ὥστ' οὐρανῷ στηρίζον εὑρήσεις κλέος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:973.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:973.1.text#ἔκτειν', Ἀγαύη, χεῖρας αἵ θ' ὁμόσποροι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:974.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:974.1.text#Κάδμου θυγατέρες· τὸν νεανίαν ἄγω
urn:cts:greekLit:tlg0006.tlg017.fu.sp:975.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:975.1.text#τόνδ' εἰς ἀγῶνα μέγαν, ὁ νικήσων δ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:976.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:976.1.text#καὶ Βρόμιος ἔσται. τἄλλα δ' αὐτὸ σημανεῖ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:977.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:977.1.text#ἴτε θοαὶ Λύσσας κύνες ἴτ' εἰς ὄρος,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:978.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:978.1.text#θίασον ἔνθ' ἔχουσι Κάδμου κόραι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:979.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:979.1.text#ἀνοιστρήσατέ νιν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:980.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:980.1.text#ἐπὶ τὸν ἐν γυναικομίμῳ στολᾷ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:981.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:981.1.text#λυσσώδη κατάσκοπον μαινάδων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:982.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:982.1.text#μάτηρ πρῶτά νιν λευρᾶς ἀπὸ πέτρας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:983.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:983.1.text#ἢ σκόλοπος ὄψεται
urn:cts:greekLit:tlg0006.tlg017.fu.sp:984.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:984.1.text#δοκεύοντα, μαινάσιν δ' ἀπύσει·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:985.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:985.1.text#Τίς ὅδ' ὀρειδρόμων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:986.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:986.1.text#μαστὴρ Καδμείων ἐς ὄρος ἐς ὄρος ἔμολ'
urn:cts:greekLit:tlg0006.tlg017.fu.sp:987.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:987.1.text#ἔμολεν, ὦ βάκχαι; τίς ἄρα νιν ἔτεκεν;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:988.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:988.1.text#οὐ γὰρ ἐξ αἵματος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:989.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:989.1.text#γυναικῶν ἔφυ, λεαίνας δέ τινος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:990.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:990.1.text#ὅδ' ἢ Γοργόνων Λιβυσσᾶν γένος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:992.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:992.1.text#ἴτω δίκα φανερός, ἴτω ξιφηφόρος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:993.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:993.1.text#φονεύουσα λαιμῶν διαμπὰξ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:995.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:995.1.text#τὸν ἄθεον ἄνομον ἄδικον Ἐχίονος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:996.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:996.1.text#γόνον γηγενῆ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:997.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:997.1.text#ὃς ἀδίκῳ γνώμᾳ παρανόμῳ τ' ὀργᾷ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:998.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:998.1.text#περὶ { σὰ } Βάκχι', ὄργια ματρός τε σᾶς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:999.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:999.1.text#μανείσᾳ πραπίδι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1000.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1000.1.text#παρακόπῳ τε λήματι στέλλεται,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1001.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1001.1.text#τἀνίκατον ὡς κρατήσων βίᾳ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1002.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1002.1.text#γνωμᾶν σωφρόνα θάνατος ἀπροφάσιστος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1003.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1003.1.text#ἐς τὰ θεῶν ἔφυ·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1004.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1004.1.text#βροτείως τ' ἔχειν ἄλυπος βίος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1005.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1005.1.text#τὸ σοφὸν οὐ φθονῶ·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1006.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1006.1.text#χαίρω θηρεύουσα· τὰ δ' ἕτερα μεγάλα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1007.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1007.1.text#φανερά τ'· ὤ, νάει{ ν } ἐπὶ τὰ καλὰ βίον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1008.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1008.1.text#ἦμαρ ἐς νύκτα τ' εὐαγοῦντ'
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1009.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1009.1.text#εὐσεβεῖν, τὰ δ' ἔξω νόμιμα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1010.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1010.1.text#δίκας ἐκβαλόντα τιμᾶν θεούς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1013.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1013.1.text#ἴτω δίκα φανερός, ἴτω ξιφηφόρος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1014.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1014.1.text#φονεύουσα λαιμῶν διαμπὰξ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1015.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1015.1.text#τὸν ἄθεον ἄνομον ἄδικον Ἐχίονος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1016.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1016.1.text#τόκον γηγενῆ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1018.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1018.1.text#φάνηθι ταῦρος ἢ πολύκρανος ἰδεῖν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1019.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1019.1.text#δράκων ἢ πυριφλέγων ὁρᾶσθαι λέων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1020.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1020.1.text#ἴθ', ὦ Βάκχε, θηραγρευτᾷ βακχᾶν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1021.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1021.1.text#γελῶντι προσώπῳ περίβαλε βρόχον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1022.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1022.1.text#θανάσιμον ὑπ' ἀγέλαν πεσόντι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1023.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1023.1.text#τὰν μαινάδων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1024.1.speaker#Ἄγγελος Β
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1024.1.text#ὦ δῶμ' ὃ πρίν ποτ' εὐτύχεις ἀν' Ἑλλάδα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1025.1.speaker#Ἄγγελος Β
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1025.1.text#Σιδωνίου γέροντος, ὃς τὸ γηγενὲς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1026.1.speaker#Ἄγγελος Β
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1026.1.text#δράκοντος ἔσπειρ' Ὄφεος ἐν γαίᾳ θέρος,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1027.1.speaker#Ἄγγελος Β
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1027.1.text#ὥς σε στενάζω, δοῦλος ὢν μέν, ἀλλ' ὅμως
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1028.1.speaker#Ἄγγελος Β
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1028.1.text#[ χρηστοῖσι δούλοις συμφορὰ τὰ δεσποτῶν ].
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1029.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1029.1.text#τί δ' ἔστιν; ἐκ βακχῶν τι μηνύεις νέον;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1030.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1030.1.text#Πενθεὺς ὄλωλεν, παῖς Ἐχίονος πατρός.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1031.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1031.1.text#ὦναξ Βρόμιε, θεὸς φαίνῃ μέγας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1032.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1032.1.text#πῶς φῄς; τί τοῦτ' ἔλεξας; ἦ 'πὶ τοῖς ἐμοῖς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1033.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1033.1.text#χαίρεις κακῶς πράσσουσι δεσπόταις, γύναι;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1034.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1034.1.text#εὐάζω ξένα μέλεσι βαρβάροις·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1035.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1035.1.text#οὐκέτι γὰρ δεσμῶν ὑπὸ φόβῳ πτήσσω.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1036.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1036.1.text#Θήβας δ' ἀνάνδρους ὧδ' ἄγεις  [ … ]
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1037.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1037.1.text#ὁ Διόνυσος ὁ Διόνυσος, οὐ Θῆβαι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1038.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1038.1.text#κράτος ἔχουσ' ἐμόν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1039.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1039.1.text#συγγνωστὰ μέν σοι, πλὴν ἐπ' ἐξειργασμένοις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1040.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1040.1.text#κακοῖσι χαίρειν, ὦ γυναῖκες, οὐ καλόν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1041.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1041.1.text#ἔννεπέ μοι, φράσον, τίνι μόρῳ θνῄσκει
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1042.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1042.1.text#ἄδικος ἄδικά τ' ἐκπορίζων ἀνήρ;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1043.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1043.1.text#ἐπεὶ θεράπνας τῆσδε Θηβαίας χθονὸς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1044.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1044.1.text#λιπόντες ἐξέβημεν Ἀσωποῦ ῥοάς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1045.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1045.1.text#λέπας Κιθαιρώνειον εἰσεβάλλομεν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1046.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1046.1.text#Πενθεύς τε κἀγώ—δεσπότῃ γὰρ εἱπόμην—
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1047.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1047.1.text#ξένος θ' ὃς ἡμῖν πομπὸς ἦν θεωρίας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1048.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1048.1.text#πρῶτον μὲν οὖν ποιηρὸν ἵζομεν νάπος,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1049.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1049.1.text#τά τ' ἐκ ποδῶν σιγηλὰ καὶ γλώσσης ἄπο
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1050.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1050.1.text#σῴζοντες, ὡς ὁρῷμεν οὐχ ὁρώμενοι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1051.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1051.1.text#ἦν δ' ἄγκος ἀμφίκρημνον, ὕδασι διάβροχον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1052.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1052.1.text#πεύκαισι συσκιάζον, ἔνθα μαινάδες
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1053.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1053.1.text#καθῆντ' ἔχουσαι χεῖρας ἐν τερπνοῖς πόνοις.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1054.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1054.1.text#αἳ μὲν γὰρ αὐτῶν θύρσον ἐκλελοιπότα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1055.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1055.1.text#κισσῷ κομήτην αὖθις ἐξανέστεφον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1056.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1056.1.text#αἳ δ', ἐκλιποῦσαι ποικίλ' ὡς πῶλοι ζυγά,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1057.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1057.1.text#βακχεῖον ἀντέκλαζον ἀλλήλαις μέλος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1058.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1058.1.text#Πενθεὺς δ' ὁ τλήμων θῆλυν οὐχ ὁρῶν ὄχλον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1059.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1059.1.text#ἔλεξε τοιάδ'· Ὦ ξέν', οὗ μὲν ἕσταμεν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1060.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1060.1.text#οὐκ ἐξικνοῦμαι μαινάδων ὄσσοις νόθων·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1061.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1061.1.text#ὄχθων δ' ἔπ', ἀμβὰς ἐς ἐλάτην ὑψαύχενα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1062.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1062.1.text#ἴδοιμ' ἂν ὀρθῶς μαινάδων αἰσχρουργίαν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1063.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1063.1.text#τοὐντεῦθεν ἤδη τοῦ ξένου { τὸ } θαῦμ' ὁρῶ·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1064.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1064.1.text#λαβὼν γὰρ ἐλάτης οὐράνιον ἄκρον κλάδον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1065.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1065.1.text#κατῆγεν, ἦγεν, ἦγεν ἐς μέλαν πέδον·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1066.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1066.1.text#κυκλοῦτο δ' ὥστε τόξον ἢ κυρτὸς τροχὸς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1067.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1067.1.text#τόρνῳ γραφόμενος περιφορὰν ἕλκει δρόμον·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1068.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1068.1.text#ὣς κλῶν' ὄρειον ὁ ξένος χεροῖν ἄγων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1069.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1069.1.text#ἔκαμπτεν ἐς γῆν, ἔργματ' οὐχὶ θνητὰ δρῶν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1070.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1070.1.text#Πενθέα δ' ἱδρύσας ἐλατίνων ὄζων ἔπι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1071.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1071.1.text#ὀρθὸν μεθίει διὰ χερῶν βλάστημ' ἄνω
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1072.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1072.1.text#ἀτρέμα, φυλάσσων μὴ ἀναχαιτίσειέ νιν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1073.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1073.1.text#ὀρθὴ δ' ἐς ὀρθὸν αἰθέρ' ἐστηρίζετο,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1074.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1074.1.text#ἔχουσα νώτοις δεσπότην ἐφήμενον·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1075.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1075.1.text#ὤφθη δὲ μᾶλλον ἢ κατεῖδε μαινάδας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1076.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1076.1.text#ὅσον γὰρ οὔπω δῆλος ἦν θάσσων ἄνω,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1077.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1077.1.text#καὶ τὸν ξένον μὲν οὐκέτ' εἰσορᾶν παρῆν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1078.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1078.1.text#ἐκ δ' αἰθέρος φωνή τις, ὡς μὲν εἰκάσαι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1079.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1079.1.text#Διόνυσος, ἀνεβόησεν· Ὦ νεάνιδες,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1080.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1080.1.text#ἄγω τὸν ὑμᾶς κἀμὲ τἀμά τ' ὄργια
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1081.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1081.1.text#γέλων τιθέμενον· ἀλλὰ τιμωρεῖσθέ νιν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1082.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1082.1.text#καὶ ταῦθ' ἅμ' ἠγόρευε καὶ πρὸς οὐρανὸν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1083.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1083.1.text#καὶ γαῖαν ἐστήριξε φῶς σεμνοῦ πυρός.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1084.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1084.1.text#σίγησε δ' αἰθήρ, σῖγα δ' ὕλιμος νάπη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1085.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1085.1.text#φύλλ' εἶχε, θηρῶν δ' οὐκ ἂν ἤκουσας βοήν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1086.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1086.1.text#αἳ δ' ὠσὶν ἠχὴν οὐ σαφῶς δεδεγμέναι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1087.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1087.1.text#ἔστησαν ὀρθαὶ καὶ διήνεγκαν κόρας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1088.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1088.1.text#ὃ δ' αὖθις ἐπεκέλευσεν· ὡς δ' ἐγνώρισαν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1089.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1089.1.text#σαφῆ κελευσμὸν Βακχίου Κάδμου κόραι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1090.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1090.1.text#ᾖξαν πελείας ὠκύτητ' οὐχ ἥσσονες
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1091.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1091.1.text#ποδῶν τρέχουσαι συντόνοις δραμήμασι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1092.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1092.1.text#μήτηρ Ἀγαύη σύγγονοί θ' ὁμόσποροι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1093.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1093.1.text#πᾶσαί τε βάκχαι· διὰ δὲ χειμάρρου νάπης
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1094.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1094.1.text#ἀγμῶν τ' ἐπήδων θεοῦ πνοαῖσιν ἐμμανεῖς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1095.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1095.1.text#ὡς δ' εἶδον ἐλάτῃ δεσπότην ἐφήμενον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1096.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1096.1.text#πρῶτον μὲν αὐτοῦ χερμάδας κραταιβόλους
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1097.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1097.1.text#ἔρριπτον, ἀντίπυργον ἐπιβᾶσαι πέτραν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1098.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1098.1.text#ὄζοισί τ' ἐλατίνοισιν ἠκοντίζετο.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1099.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1099.1.text#ἄλλαι δὲ θύρσους ἵεσαν δι' αἰθέρος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1100.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1100.1.text#Πενθέως, στόχον δύστηνον· ἀλλ' οὐκ ἤνυτον.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1101.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1101.1.text#κρεῖσσον γὰρ ὕψος τῆς προθυμίας ἔχων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1102.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1102.1.text#καθῆσθ' ὁ τλήμων, ἀπορίᾳ λελημμένος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1103.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1103.1.text#τέλος δὲ δρυΐνους συγκεραυνοῦσαι κλάδους
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1104.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1104.1.text#ῥίζας ἀνεσπάρασσον ἀσιδήροις μοχλοῖς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1105.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1105.1.text#ἐπεὶ δὲ μόχθων τέρματ' οὐκ ἐξήνυτον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1106.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1106.1.text#ἔλεξ' Ἀγαύη· Φέρε, περιστᾶσαι κύκλῳ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1107.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1107.1.text#πτόρθου λάβεσθε, μαινάδες, τὸν ἀμβάτην
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1108.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1108.1.text#θῆρ' ὡς ἕλωμεν, μηδ' ἀπαγγείλῃ θεοῦ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1109.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1109.1.text#χοροὺς κρυφαίους. αἳ δὲ μυρίαν χέρα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1110.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1110.1.text#προσέθεσαν ἐλάτῃ κἀξανέσπασαν χθονός·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1111.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1111.1.text#ὑψοῦ δὲ θάσσων ὑψόθεν χαμαιριφὴς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1112.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1112.1.text#πίπτει πρὸς οὖδας μυρίοις οἰμώγμασιν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1113.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1113.1.text#Πενθεύς· κακοῦ γὰρ ἐγγὺς ὢν ἐμάνθανεν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1114.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1114.1.text#πρώτη δὲ μήτηρ ἦρξεν ἱερέα φόνου
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1115.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1115.1.text#καὶ προσπίτνει νιν· ὃ δὲ μίτραν κόμης ἄπο
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1116.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1116.1.text#ἔρριψεν, ὥς νιν γνωρίσασα μὴ κτάνοι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1117.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1117.1.text#τλήμων Ἀγαύη, καὶ λέγει, παρηίδος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1118.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1118.1.text#ψαύων· Ἐγώ τοι, μῆτερ, εἰμί, παῖς σέθεν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1119.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1119.1.text#Πενθεύς, ὃν ἔτεκες ἐν δόμοις Ἐχίονος·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1120.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1120.1.text#οἴκτιρε δ' ὦ μῆτέρ με, μηδὲ ταῖς ἐμαῖς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1121.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1121.1.text#ἁμαρτίαισι παῖδα σὸν κατακτάνῃς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1122.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1122.1.text#ἣ δ' ἀφρὸν ἐξιεῖσα καὶ διαστρόφους
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1123.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1123.1.text#κόρας ἑλίσσουσ', οὐ φρονοῦσ' ἃ χρὴ φρονεῖν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1124.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1124.1.text#ἐκ Βακχίου κατείχετ', οὐδ' ἔπειθέ νιν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1125.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1125.1.text#λαβοῦσα δ' ὠλένης ἀριστερὰν χέρα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1126.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1126.1.text#πλευραῖσιν ἀντιβᾶσα τοῦ δυσδαίμονος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1127.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1127.1.text#ἀπεσπάραξεν ὦμον, οὐχ ὑπὸ σθένους,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1128.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1128.1.text#ἀλλ' ὁ θεὸς εὐμάρειαν ἐπεδίδου χεροῖν·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1129.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1129.1.text#Ἰνὼ δὲ τἀπὶ θάτερ' ἐξειργάζετο,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1130.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1130.1.text#ῥηγνῦσα σάρκας, Αὐτονόη τ' ὄχλος τε πᾶς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1131.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1131.1.text#ἐπεῖχε βακχῶν· ἦν δὲ πᾶσ' ὁμοῦ βοή,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1132.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1132.1.text#ὃ μὲν στενάζων ὅσον ἐτύγχαν' ἐμπνέων,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1133.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1133.1.text#αἳ δ' ἠλάλαζον. ἔφερε δ' ἣ μὲν ὠλένην,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1134.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1134.1.text#ἣ δ' ἴχνος αὐταῖς ἀρβύλαις· γυμνοῦντο δὲ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1135.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1135.1.text#πλευραὶ σπαραγμοῖς· πᾶσα δ' ᾑματωμένη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1136.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1136.1.text#χεῖρας διεσφαίριζε σάρκα Πενθέως.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1137.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1137.1.text#κεῖται δὲ χωρὶς σῶμα, τὸ μὲν ὑπὸ στύφλοις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1138.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1138.1.text#πέτραις, τὸ δ' ὕλης ἐν βαθυξύλῳ φόβῃ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1139.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1139.1.text#οὐ ῥᾴδιον ζήτημα· κρᾶτα δ' ἄθλιον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1140.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1140.1.text#ὅπερ λαβοῦσα τυγχάνει μήτηρ χεροῖν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1141.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1141.1.text#πήξασ' ἐπ' ἄκρον θύρσον ὡς ὀρεστέρου
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1142.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1142.1.text#φέρει λέοντος διὰ Κιθαιρῶνος μέσου,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1143.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1143.1.text#λιποῦσ' ἀδελφὰς ἐν χοροῖσι μαινάδων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1144.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1144.1.text#χωρεῖ δὲ θήρᾳ δυσπότμῳ γαυρουμένη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1145.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1145.1.text#τειχέων ἔσω τῶνδ', ἀνακαλοῦσα Βάκχιον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1146.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1146.1.text#τὸν ξυγκύναγον, τὸν ξυνεργάτην ἄγρας,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1147.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1147.1.text#τὸν καλλίνικον, ᾧ δάκρυα νικηφορεῖ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1148.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1148.1.text#ἐγὼ μὲν οὖν { τῇδ' } ἐκποδὼν τῇ ξυμφορᾷ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1149.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1149.1.text#ἄπειμ', Ἀγαύην πρὶν μολεῖν πρὸς δώματα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1150.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1150.1.text#τὸ σωφρονεῖν δὲ καὶ σέβειν τὰ τῶν θεῶν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1151.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1151.1.text#κάλλιστον· οἶμαι δ' αὐτὸ καὶ σοφώτατον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1152.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1152.1.text#θνητοῖσιν εἶναι κτῆμα τοῖσι χρωμένοις.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1153.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1153.1.text#ἀναχορεύσωμεν Βάκχιον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1154.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1154.1.text#ἀναβοάσωμεν ξυμφορὰν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1155.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1155.1.text#τὰν τοῦ δράκοντος Πενθέος ἐκγενέτα·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1156.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1156.1.text#ὃς τὰν θηλυγενῆ στολὰν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1157.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1157.1.text#νάρθηκά τε, πιστὸν Ἅιδαν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1158.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1158.1.text#ἔλαβεν εὔθυρσον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1159.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1159.1.text#ταῦρον προηγητῆρα συμφορᾶς ἔχων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1160.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1160.1.text#βάκχαι Καδμεῖαι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1161.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1161.1.text#τὸν καλλίνικον κλεινὸν ἐξεπράξατε
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1162.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1162.1.text#ἐς στόνον, ἐς δάκρυα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1163.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1163.1.text#καλὸς ἀγών, χέρ' αἵματι στάζουσαν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1164.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1164.1.text#περιβαλεῖν τέκνου.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1165.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1165.1.text#ἀλλ', εἰσορῶ γὰρ ἐς δόμους ὁρμωμένην
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1166.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1166.1.text#Πενθέως Ἀγαύην μητέρ' ἐν διαστρόφοις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1167.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1167.1.text#ὄσσοις, δέχεσθε κῶμον εὐίου θεοῦ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1168.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1168.1.text#Ἀσιάδες βάκχαι —
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1168.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1168.2.text#τί μ' ὀροθύνεις, ὤ;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1169.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1169.1.text#φέρομεν ἐξ ὀρέων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1170.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1170.1.text#ἕλικα νεότομον ἐπὶ μέλαθρα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1171.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1171.1.text#μακάριον θήραν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1172.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1172.1.text#ὁρῶ καί σε δέξομαι σύγκωμον.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1173.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1173.1.text#ἔμαρψα τόνδ' ἄνευ βρόχων
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1174.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1174.1.text#{ λέοντος ἀγροτέρου } νέον ἶνιν·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1175.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1175.1.text#ὡς ὁρᾶν πάρα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1176.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1176.1.text#πόθεν ἐρημίας;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1177.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1177.1.text#Κιθαιρὼν  [ … ]
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1177.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1177.2.text#Κιθαιρών;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1178.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1178.1.text#κατεφόνευσέ νιν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1179.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1179.1.text#τίς ἁ βαλοῦσα;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1179.2.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1179.2.text#πρῶτον ἐμὸν τὸ γέρας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1180.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1180.1.text#μάκαιρ' Ἀγαύη κλῃζόμεθ' ἐν θιάσοις.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1181.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1181.1.text#τίς ἄλλα;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1181.2.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1181.2.text#τὰ Κάδμου  [ … ]
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1182.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1182.1.text#τί Κάδμου;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1182.2.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1182.2.text#γένεθλα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1182.2.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1182.2.text#μετ' ἐμὲ μετ' ἐμὲ τοῦδ'
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1183.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1183.1.text#ἔθιγε θηρός· εὐτυχής γ' ἅδ' ἄγρα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1183.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1183.2.text#[ … ]
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1184.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1184.1.text#μέτεχέ νυν θοίνας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1184.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1184.2.text#τί; μετέχω, τλᾶμον;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1185.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1185.1.text#νέος ὁ μόσχος ἄρτι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1186.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1186.1.text#γένυν ὑπὸ κόρυθ' ἁπαλότριχα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1187.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1187.1.text#κατάκομον θάλλει.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1188.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1188.1.text#πρέπει γ' ὥστε θὴρ ἄγραυλος φόβῃ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1189.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1189.1.text#ὁ Βάκχιος κυναγέτας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1190.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1190.1.text#σοφὸς σοφῶς ἀνέπηλ' ἐπὶ θῆρα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1191.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1191.1.text#τόνδε μαινάδας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1192.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1192.1.text#ὁ γὰρ ἄναξ ἀγρεύς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1193.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1193.1.text#ἐπαινεῖς;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1193.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1193.2.text#ἐπαινῶ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1194.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1194.1.text#τάχα δὲ Καδμεῖοι  [ … ]
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1195.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1195.1.text#καὶ παῖς γε Πενθεὺς  [ … ]
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1195.2.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1195.2.text#ματέρ' ἐπαινέσεται,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1196.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1196.1.text#λαβοῦσαν ἄγραν τάνδε λεοντοφυῆ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1197.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1197.1.text#περισσάν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1197.2.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1197.2.text#περισσῶς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1198.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1198.1.text#ἀγάλλῃ;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1198b.2.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1198b.2.text#γέγηθα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1198.3.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1198.3.text#μεγάλα μεγάλα καὶ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1199.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1199.1.text#φανερὰ τᾷδ' ἄγρᾳ κατειργασμένα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1200.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1200.1.text#δεῖξόν νυν, ὦ τάλαινα, σὴν νικηφόρον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1201.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1201.1.text#ἀστοῖσιν ἄγραν ἣν φέρουσ' ἐλήλυθας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1202.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1202.1.text#ὦ καλλίπυργον ἄστυ Θηβαίας χθονὸς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1203.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1203.1.text#ναίοντες, ἔλθεθ' ὡς ἴδητε τήνδ' ἄγραν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1204.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1204.1.text#Κάδμου θυγατέρες θηρὸς ἣν ἠγρεύσαμεν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1205.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1205.1.text#οὐκ ἀγκυλητοῖς Θεσσαλῶν στοχάσμασιν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1206.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1206.1.text#οὐ δικτύοισιν, ἀλλὰ λευκοπήχεσι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1207.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1207.1.text#χειρῶν ἀκμαῖσιν. κᾆτα κομπάζειν χρεὼν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1208.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1208.1.text#καὶ λογχοποιῶν ὄργανα κτᾶσθαι μάτην;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1209.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1209.1.text#ἡμεῖς δέ γ' αὐτῇ χειρὶ τόνδε θ' εἵλομεν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1210.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1210.1.text#χωρίς τε θηρὸς ἄρθρα διεφορήσαμεν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1211.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1211.1.text#ποῦ μοι πατὴρ ὁ πρέσβυς; ἐλθέτω πέλας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1212.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1212.1.text#Πενθεύς τ' ἐμὸς παῖς ποῦ 'στιν; αἰρέσθω λαβὼν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1213.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1213.1.text#πηκτῶν πρὸς οἴκους κλιμάκων προσαμβάσεις,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1214.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1214.1.text#ὡς πασσαλεύσῃ κρᾶτα τριγλύφοις τόδε
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1215.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1215.1.text#λέοντος ὃν πάρειμι θηράσασ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1216.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1216.1.text#ἕπεσθέ μοι φέροντες ἄθλιον βάρος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1217.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1217.1.text#Πενθέως, ἕπεσθε, πρόσπολοι, δόμων πάρος,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1218.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1218.1.text#οὗ σῶμα μοχθῶν μυρίοις ζητήμασιν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1219.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1219.1.text#φέρω τόδ', εὑρὼν ἐν Κιθαιρῶνος πτυχαῖς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1220.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1220.1.text#διασπαρακτόν, κοὐδὲν ἐν ταὐτῷ πέδῳ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1221.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1221.1.text#λαβών, ἐν ὕλῃ κείμενον δυσευρέτῳ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1222.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1222.1.text#ἤκουσα γάρ του θυγατέρων τολμήματα,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1223.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1223.1.text#ἤδη κατ' ἄστυ τειχέων ἔσω βεβὼς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1224.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1224.1.text#σὺν τῷ γέροντι Τειρεσίᾳ Βακχῶν πάρα·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1225.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1225.1.text#πάλιν δὲ κάμψας εἰς ὄρος κομίζομαι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1226.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1226.1.text#τὸν κατθανόντα παῖδα Μαινάδων ὕπο.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1227.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1227.1.text#καὶ τὴν μὲν Ἀκτέων' Ἀρισταίῳ ποτὲ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1228.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1228.1.text#τεκοῦσαν εἶδον Αὐτονόην Ἰνώ θ' ἅμα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1229.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1229.1.text#ἔτ' ἀμφὶ δρυμοὺς οἰστροπλῆγας ἀθλίας,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1230.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1230.1.text#τὴν δ' εἶπέ τίς μοι δεῦρο βακχείῳ ποδὶ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1231.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1231.1.text#στείχειν Ἀγαύην, οὐδ' ἄκραντ' ἠκούσαμεν·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1232.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1232.1.text#λεύσσω γὰρ αὐτήν, ὄψιν οὐκ εὐδαίμονα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1233.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1233.1.text#πάτερ, μέγιστον κομπάσαι πάρεστί σοι,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1234.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1234.1.text#πάντων ἀρίστας θυγατέρας σπεῖραι μακρῷ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1235.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1235.1.text#θνητῶν· ἁπάσας εἶπον, ἐξόχως δ' ἐμέ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1236.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1236.1.text#ἣ τὰς παρ' ἱστοῖς ἐκλιποῦσα κερκίδας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1237.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1237.1.text#ἐς μείζον' ἥκω, θῆρας ἀγρεύειν χεροῖν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1238.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1238.1.text#φέρω δ' ἐν ὠλέναισιν, ὡς ὁρᾷς, τάδε
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1239.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1239.1.text#λαβοῦσα τἀριστεῖα, σοῖσι πρὸς δόμοις
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1240.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1240.1.text#ὡς ἀγκρεμασθῇ· σὺ δέ, πάτερ, δέξαι χεροῖν·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1241.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1241.1.text#γαυρούμενος δὲ τοῖς ἐμοῖς ἀγρεύμασιν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1242.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1242.1.text#κάλει φίλους ἐς δαῖτα· μακάριος γὰρ εἶ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1243.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1243.1.text#μακάριος, ἡμῶν τοιάδ' ἐξειργασμένων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1244.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1244.1.text#ὦ πένθος οὐ μετρητὸν οὐδ' οἷόν τ' ἰδεῖν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1245.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1245.1.text#φόνον ταλαίναις χερσὶν ἐξειργασμένων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1246.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1246.1.text#καλὸν τὸ θῦμα καταβαλοῦσα δαίμοσιν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1247.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1247.1.text#ἐπὶ δαῖτα Θήβας τάσδε κἀμὲ παρακαλεῖς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1248.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1248.1.text#οἴμοι κακῶν μὲν πρῶτα σῶν, ἔπειτ' ἐμῶν·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1249.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1249.1.text#ὡς ὁ θεὸς ἡμᾶς ἐνδίκως μέν, ἀλλ' ἄγαν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1250.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1250.1.text#Βρόμιος ἄναξ ἀπώλεσ' οἰκεῖος γεγώς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1251.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1251.1.text#ὡς δύσκολον τὸ γῆρας ἀνθρώποις ἔφυ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1252.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1252.1.text#ἔν τ' ὄμμασι σκυθρωπόν. εἴθε παῖς ἐμὸς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1253.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1253.1.text#εὔθηρος εἴη, μητρὸς εἰκασθεὶς τρόποις,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1254.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1254.1.text#ὅτ' ἐν νεανίαισι Θηβαίοις ἅμα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1255.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1255.1.text#θηρῶν ὀριγνῷτ'· ἀλλὰ θεομαχεῖν μόνον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1256.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1256.1.text#οἷός τ' ἐκεῖνος. νουθετητέος, πάτερ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1257.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1257.1.text#σοὐστίν. τίς αὐτὸν δεῦρ' ἂν ὄψιν εἰς ἐμὴν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1258.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1258.1.text#καλέσειεν, ὡς ἴδῃ με τὴν εὐδαίμονα;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1259.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1259.1.text#φεῦ φεῦ· φρονήσασαι μὲν οἷ' ἐδράσατε
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1260.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1260.1.text#ἀλγήσετ' ἄλγος δεινόν· εἰ δὲ διὰ τέλους
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1261.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1261.1.text#ἐν τῷδ' ἀεὶ μενεῖτ' ἐν ᾧ καθέστατε,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1262.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1262.1.text#οὐκ εὐτυχοῦσαι δόξετ' οὐχὶ δυστυχεῖν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1263.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1263.1.text#τί δ' οὐ καλῶς τῶνδ' ἢ τί λυπηρῶς ἔχει;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1264.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1264.1.text#πρῶτον μὲν ἐς τόνδ' αἰθέρ' ὄμμα σὸν μέθες.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1265.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1265.1.text#ἰδού· τί μοι τόνδ' ἐξυπεῖπας εἰσορᾶν;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1266.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1266.1.text#ἔθ' αὑτὸς ἤ σοι μεταβολὰς ἔχειν δοκεῖ;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1267.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1267.1.text#λαμπρότερος ἢ πρὶν καὶ διειπετέστερος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1268.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1268.1.text#τὸ δὲ πτοηθὲν τόδ' ἔτι σῇ ψυχῇ πάρα;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1269.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1269.1.text#οὐκ οἶδα τοὔπος τοῦτο. γίγνομαι δέ πως
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1270.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1270.1.text#ἔννους, μετασταθεῖσα τῶν πάρος φρενῶν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1271.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1271.1.text#κλύοις ἂν οὖν τι κἀποκρίναι' ἂν σαφῶς;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1272.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1272.1.text#ὡς ἐκλέλησμαί γ' ἃ πάρος εἴπομεν, πάτερ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1273.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1273.1.text#ἐς ποῖον ἦλθες οἶκον ὑμεναίων μέτα;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1274.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1274.1.text#Σπαρτῷ μ' ἔδωκας, ὡς λέγουσ', Ἐχίονι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1275.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1275.1.text#τίς οὖν ἐν οἴκοις παῖς ἐγένετο σῷ πόσει;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1276.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1276.1.text#Πενθεύς, ἐμῇ τε καὶ πατρὸς κοινωνίᾳ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1277.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1277.1.text#τίνος πρόσωπον δῆτ' ἐν ἀγκάλαις ἔχεις;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1278.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1278.1.text#λέοντος, ὥς γ' ἔφασκον αἱ θηρώμεναι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1279.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1279.1.text#σκέψαι νυν ὀρθῶς· βραχὺς ὁ μόχθος εἰσιδεῖν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1280.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1280.1.text#ἔα, τί λεύσσω; τί φέρομαι τόδ' ἐν χεροῖν;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1281.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1281.1.text#ἄθρησον αὐτὸ καὶ σαφέστερον μάθε.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1282.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1282.1.text#ὁρῶ μέγιστον ἄλγος ἡ τάλαιν' ἐγώ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1283.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1283.1.text#μῶν σοι λέοντι φαίνεται προσεικέναι;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1284.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1284.1.text#οὔκ, ἀλλὰ Πενθέως ἡ τάλαιν' ἔχω κάρα.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1285.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1285.1.text#ᾠμωγμένον γε πρόσθεν ἢ σὲ γνωρίσαι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1286.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1286.1.text#τίς ἔκτανέν νιν;—πῶς ἐμὰς ἦλθεν χέρας;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1287.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1287.1.text#δύστην' ἀλήθει', ὡς ἐν οὐ καιρῷ πάρει.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1288.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1288.1.text#λέγ', ὡς τὸ μέλλον καρδία πήδημ' ἔχει.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1289.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1289.1.text#σύ νιν κατέκτας καὶ κασίγνηται σέθεν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1290.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1290.1.text#ποῦ δ' ὤλετ'; ἦ κατ' οἶκον; ἢ ποίοις τόποις;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1291.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1291.1.text#οὗπερ πρὶν Ἀκτέωνα διέλαχον κύνες.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1292.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1292.1.text#τί δ' ἐς Κιθαιρῶν' ἦλθε δυσδαίμων ὅδε;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1293.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1293.1.text#ἐκερτόμει θεὸν σάς τε βακχείας μολών.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1294.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1294.1.text#ἡμεῖς δ' ἐκεῖσε τίνι τρόπῳ κατήραμεν;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1295.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1295.1.text#ἐμάνητε, πᾶσά τ' ἐξεβακχεύθη πόλις.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1296.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1296.1.text#Διόνυσος ἡμᾶς ὤλεσ', ἄρτι μανθάνω.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1297.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1297.1.text#ὕβριν { γ' } ὑβρισθείς· θεὸν γὰρ οὐχ ἡγεῖσθέ νιν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1298.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1298.1.text#τὸ φίλτατον δὲ σῶμα ποῦ παιδός, πάτερ;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1299.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1299.1.text#ἐγὼ μόλις τόδ' ἐξερευνήσας φέρω.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1300.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1300.1.text#ἦ πᾶν ἐν ἄρθροις συγκεκλῃμένον καλῶς;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1300.2.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1300.2.text#[ … ]
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1301.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1301.1.text#Πενθεῖ δὲ τί μέρος ἀφροσύνης προσῆκ' ἐμῆς;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1302.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1302.1.text#ὑμῖν ἐγένεθ' ὅμοιος, οὐ σέβων θεόν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1303.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1303.1.text#τοιγὰρ συνῆψε πάντας ἐς μίαν βλάβην,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1304.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1304.1.text#ὑμᾶς τε τόνδε θ', ὥστε διολέσαι δόμους
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1305.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1305.1.text#κἄμ', ὅστις ἄτεκνος ἀρσένων παίδων γεγὼς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1306.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1306.1.text#τῆς σῆς τόδ' ἔρνος, ὦ τάλαινα, νηδύος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1307.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1307.1.text#αἴσχιστα καὶ κάκιστα κατθανόνθ' ὁρῶ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1308.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1308.1.text#ᾧ δῶμ' ἀνέβλεφ'—ὃς συνεῖχες, ὦ τέκνον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1309.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1309.1.text#τοὐμὸν μέλαθρον, παιδὸς ἐξ ἐμῆς γεγώς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1310.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1310.1.text#πόλει τε τάρβος ἦσθα· τὸν γέροντα δὲ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1311.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1311.1.text#οὐδεὶς ὑβρίζειν ἤθελ' εἰσορῶν τὸ σὸν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1312.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1312.1.text#κάρα· δίκην γὰρ ἀξίαν ἐλάμβανες.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1313.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1313.1.text#νῦν δ' ἐκ δόμων ἄτιμος ἐκβεβλήσομαι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1314.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1314.1.text#ὁ Κάδμος ὁ μέγας, ὃς τὸ Θηβαίων γένος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1315.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1315.1.text#ἔσπειρα κἀξήμησα κάλλιστον θέρος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1316.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1316.1.text#ὦ φίλτατ' ἀνδρῶν—καὶ γὰρ οὐκέτ' ὢν ὅμως
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1317.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1317.1.text#τῶν φιλτάτων ἔμοιγ' ἀριθμήσῃ, τέκνον—
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1318.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1318.1.text#οὐκέτι γενείου τοῦδε θιγγάνων χερί,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1319.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1319.1.text#τὸν { μητρὸς } αὐδῶν { πατέρα } προσπτύξῃ, τέκνον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1320.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1320.1.text#λέγων· Τίς ἀδικεῖ, τίς σ' ἀτιμάζει, γέρον;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1321.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1321.1.text#τίς σὴν ταράσσει καρδίαν λυπηρὸς ὤν;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1322.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1322.1.text#λέγ', ὡς κολάζω τὸν ἀδικοῦντά σ', ὦ πάτερ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1323.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1323.1.text#νῦν δ' ἄθλιος μέν εἰμ' ἐγώ, τλήμων δὲ σύ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1324.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1324.1.text#οἰκτρὰ δὲ μήτηρ, τλήμονες δὲ σύγγονοι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1325.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1325.1.text#εἰ δ' ἔστιν ὅστις δαιμόνων ὑπερφρονεῖ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1326.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1326.1.text#ἐς τοῦδ' ἀθρήσας θάνατον ἡγείσθω θεούς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1327.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1327.1.text#τὸ μὲν σὸν ἀλγῶ, Κάδμε· σὸς δ' ἔχει δίκην
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1328.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1328.1.text#παῖς παιδὸς ἀξίαν μέν, ἀλγεινὴν δὲ σοί.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1329.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1329.1.text#ὦ πάτερ, ὁρᾷς γὰρ τἄμ' ὅσῳ μετεστράφη  [ … ]
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1330.1.speaker#Διονυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1330.1.text#δράκων γενήσῃ μεταβαλών, δάμαρ τε σὴ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1331.1.speaker#Διονυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1331.1.text#ἐκθηριωθεῖσ' ὄφεος ἀλλάξει τύπον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1332.1.speaker#Διονυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1332.1.text#ἣν Ἄρεος ἔσχες Ἁρμονίαν θνητὸς γεγώς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1333.1.speaker#Διονυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1333.1.text#ὄχον δὲ μόσχων, χρησμὸς ὡς λέγει Διός,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1334.1.speaker#Διονυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1334.1.text#ἐλᾷς μετ' ἀλόχου, βαρβάρων ἡγούμενος.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1335.1.speaker#Διονυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1335.1.text#πολλὰς δὲ πέρσεις ἀναρίθμῳ στρατεύματι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1336.1.speaker#Διονυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1336.1.text#πόλεις· ὅταν δὲ Λοξίου χρηστήριον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1337.1.speaker#Διονυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1337.1.text#διαρπάσωσι, νόστον ἄθλιον πάλιν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1338.1.speaker#Διονυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1338.1.text#σχήσουσι· σὲ δ' Ἄρης Ἁρμονίαν τε ῥύσεται
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1339.1.speaker#Διονυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1339.1.text#μακάρων τ' ἐς αἶαν σὸν καθιδρύσει βίον.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1340.1.speaker#Διονυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1340.1.text#ταῦτ' οὐχὶ θνητοῦ πατρὸς ἐκγεγὼς λέγω
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1341.1.speaker#Διονυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1341.1.text#Διόνυσος, ἀλλὰ Ζηνός· εἰ δὲ σωφρονεῖν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1342.1.speaker#Διονυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1342.1.text#ἔγνωθ', ὅτ' οὐκ ἠθέλετε, τὸν Διὸς γόνον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1343.1.speaker#Διονυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1343.1.text#εὐδαιμονεῖτ' ἂν σύμμαχον κεκτημένοι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1344.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1344.1.text#Διόνυσε, λισσόμεσθά σ', ἠδικήκαμεν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1345.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1345.1.text#ὄψ' ἐμάθεθ' ἡμᾶς, ὅτε δὲ χρῆν, οὐκ ᾔδετε.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1346.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1346.1.text#ἐγνώκαμεν ταῦτ'· ἀλλ' ἐπεξέρχῃ λίαν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1347.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1347.1.text#καὶ γὰρ πρὸς ὑμῶν θεὸς γεγὼς ὑβριζόμην.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1348.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1348.1.text#ὀργὰς πρέπει θεοὺς οὐχ ὁμοιοῦσθαι βροτοῖς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1349.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1349.1.text#πάλαι τάδε Ζεὺς οὑμὸς ἐπένευσεν πατήρ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1350.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1350.1.text#αἰαῖ, δέδοκται, πρέσβυ, τλήμονες φυγαί.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1351.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1351.1.text#τί δῆτα μέλλεθ' ἅπερ ἀναγκαίως ἔχει;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1352.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1352.1.text#ὦ τέκνον, ὡς ἐς δεινὸν ἤλθομεν κακὸν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1353.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1353.1.text#{ πάντες, } σύ θ' ἡ τάλαινα σύγγονοί τε σαί,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1354.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1354.1.text#ἐγώ θ' ὁ τλήμων· βαρβάρους ἀφίξομαι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1355.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1355.1.text#γέρων μέτοικος· ἔτι δέ μοι τὸ θέσφατον
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1356.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1356.1.text#ἐς Ἑλλάδ' ἀγαγεῖν μιγάδα βάρβαρον στρατόν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1357.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1357.1.text#καὶ τὴν Ἄρεως παῖδ' Ἁρμονίαν, δάμαρτ' ἐμήν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1358.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1358.1.text#δράκων δρακαίνης { φύσιν } ἔχουσαν ἀγρίαν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1359.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1359.1.text#ἄξω 'πὶ βωμοὺς καὶ τάφους Ἑλληνικούς,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1360.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1360.1.text#ἡγούμενος λόγχαισιν· οὐδὲ παύσομαι
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1361.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1361.1.text#κακῶν ὁ τλήμων, οὐδὲ τὸν καταιβάτην
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1362.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1362.1.text#Ἀχέροντα πλεύσας ἥσυχος γενήσομαι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1363.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1363.1.text#ὦ πάτερ, ἐγὼ δὲ σοῦ στερεῖσα φεύξομαι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1364.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1364.1.text#τί μ' ἀμφιβάλλεις χερσίν, ὦ τάλαινα παῖ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1365.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1365.1.text#ὄρνις ὅπως κηφῆνα πολιόχρων κύκνος;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1366.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1366.1.text#ποῖ γὰρ τράπωμαι πατρίδος ἐκβεβλημένη;
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1367.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1367.1.text#οὐκ οἶδα, τέκνον· μικρὸς ἐπίκουρος πατήρ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1368.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1368.1.text#χαῖρ', ὦ μέλαθρον, χαῖρ', ὦ πατρία
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1369.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1369.1.text#πόλις· ἐκλείπω σ' ἐπὶ δυστυχίᾳ
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1370.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1370.1.text#φυγὰς ἐκ θαλάμων.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1371.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1371.1.text#στεῖχέ νυν, ὦ παῖ, τὸν Ἀρισταίου  [ … ]
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1372.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1372.1.text#στένομαί σε, πάτερ.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1372.2.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1372.2.text#κἀγὼ { σέ }, τέκνον,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1373.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1373.1.text#καὶ σὰς ἐδάκρυσα κασιγνήτας.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1374.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1374.1.text#δεινῶς γὰρ τάνδ' αἰκείαν
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1375.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1375.1.text#Διόνυσος ἄναξ τοὺς σοὺς εἰς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1376.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1376.1.text#οἴκους ἔφερεν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1377.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1377.1.text#καὶ γὰρ ἔπασχον δεινὰ πρὸς ὑμῶν,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1378.1.speaker#Διόνυσος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1378.1.text#ἀγέραστον ἔχων ὄνομ' ἐν Θήβαις.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1379.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1379.1.text#χαῖρε, πάτερ, μοι.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1379.2.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1379.2.text#χαῖρ', ὦ μελέα
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1380.1.speaker#Κάδμος
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1380.1.text#θύγατερ. χαλεπῶς { δ' } ἐς τόδ' ἂν ἥκοις.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1381.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1381.1.text#ἄγετ', ὦ πομποί, με κασιγνήτας
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1382.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1382.1.text#ἵνα συμφυγάδας ληψόμεθ' οἰκτράς.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1383.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1383.1.text#ἔλθοιμι δ' ὅπου
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1384.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1384.1.text#μήτε Κιθαιρὼν { ἔμ' ἴδοι } μιαρὸς
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1385.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1385.1.text#μήτε Κιθαιρῶν' ὄσσοισιν ἐγώ,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1386.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1386.1.text#μήθ' ὅθι θύρσου μνῆμ' ἀνάκειται·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1387.1.speaker#Ἀγαύη
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1387.1.text#Βάκχαις δ' ἄλλαισι μέλοιεν.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1388.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1388.1.text#πολλαὶ μορφαὶ τῶν δαιμονίων,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1389.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1389.1.text#πολλὰ δ' ἀέλπτως κραίνουσι θεοί·
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1390.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1390.1.text#καὶ τὰ δοκηθέντ' οὐκ ἐτελέσθη,
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1391.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1391.1.text#τῶν δ' ἀδοκήτων πόρον ηὗρε θεός.
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1392.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg017.fu.sp:1392.1.text#τοιόνδ' ἀπέβη τόδε πρᾶγμα.
