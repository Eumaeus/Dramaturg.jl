#!ctsdata
urn:cts:greekLit:tlg0006.tlg019.fu.sp:1.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:1.1.text#— Βᾶθι πρὸς εὐνὰς τὰς Ἑκτορέους.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:2.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:2.1.text#τίς ὑπασπιστῶν ἄγρυπνος βασιλέως,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:3.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:3.1.text#ἢ τευχοφόρων;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:4.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:4.1.text#— δέξαιτο νέων κληδόνα μύθων,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:5.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:5.1.text#οἳ τετράμοιρον νυκτὸς φυλακὴν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:6.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:6.1.text#πάσης στρατιᾶς προκάθηνται.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:7.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:7.1.text#— ὄρθου κεφαλὴν πῆχυν ἐρείσας,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:8.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:8.1.text#λῦσον βλεφάρων γοργωπὸν ἕδραν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:9.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:9.1.text#λεῖπε χαμεύνας φυλλοστρώτους,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:10.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:10.1.text#Ἕκτορ· καιρὸς γὰρ ἀκοῦσαι.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:11.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:11.1.text#τίς ὅδ'; ἦ φίλιος φθόγγος· τίς ἀνήρ;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:12.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:12.1.text#τί τὸ σῆμα; θρόει·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:13.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:13.1.text#τίνες ἐκ νυκτῶν τὰς ἡμετέρας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:14.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:14.1.text#κοίτας πλάθουσ'; ἐνέπειν χρή.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:15.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:15.1.text#φύλακες στρατιᾶς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:15.2.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:15.2.text#τί φέρῃ θορύβῳ;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:16.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:16.1.text#θάρσει.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:16.2.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:16.2.text#θαρσῶ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:17.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:17.1.text#μῶν τις λόχος ἐκ νυκτῶν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:17.2.speaker#[ Χορός ]
urn:cts:greekLit:tlg0006.tlg019.fu.sp:17.2.text#[ οὐκ ἔστι. ]
urn:cts:greekLit:tlg0006.tlg019.fu.sp:17.3.speaker#[ Ἕκτωρ ]
urn:cts:greekLit:tlg0006.tlg019.fu.sp:17.3.text#τί σὺ γὰρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:18.1.speaker#[ Ἕκτωρ ]
urn:cts:greekLit:tlg0006.tlg019.fu.sp:18.1.text#φυλακὰς προλιπὼν κινεῖς στρατιάν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:19.1.speaker#[ Ἕκτωρ ]
urn:cts:greekLit:tlg0006.tlg019.fu.sp:19.1.text#εἰ μή τιν' ἔχων νυκτηγορίαν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:20.1.speaker#[ Ἕκτωρ ]
urn:cts:greekLit:tlg0006.tlg019.fu.sp:20.1.text#οὐκ οἶσθα δορὸς πέλας Ἀργείου
urn:cts:greekLit:tlg0006.tlg019.fu.sp:21.1.speaker#[ Ἕκτωρ ]
urn:cts:greekLit:tlg0006.tlg019.fu.sp:21.1.text#νυχίαν ἡμᾶς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:22.1.speaker#[ Ἕκτωρ ]
urn:cts:greekLit:tlg0006.tlg019.fu.sp:22.1.text#κοίταν πανόπλους κατέχοντας;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:23.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:23.1.text#— ὁπλίζου χέρα· συμμάχων,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:24.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:24.1.text#Ἕκτορ, βᾶθι πρὸς εὐνάς,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:25.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:25.1.text#ὄτρυνον ἔγχος αἴρειν, ἀφύπνισον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:26.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:26.1.text#— πέμπε φίλους ἰέναι ποτὶ σὸν λόχον,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:27.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:27.1.text#ἁρμόσατε ψαλίοις ἵππους.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:28.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:28.1.text#— τίς εἶσ' ἐπὶ Πανθοΐδαν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:29.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:29.1.text#ἢ τὸν Εὐρώπας, Λυκίων ἀγὸν ἀνδρῶν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:30.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:30.1.text#— ποῦ σφαγίων ἔφοροι;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:31.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:31.1.text#— ποῦ δὲ γυμνήτων μόναρχοι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:32.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:32.1.text#τοξοφόροι τε Φρυγῶν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:33.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:33.1.text#— ζεύγνυτε κερόδετα τόξα νευραῖς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:34.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:34.1.text#τὰ μὲν ἀγγέλλεις δείματ' ἀκούειν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:35.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:35.1.text#τὰ δὲ θαρσύνεις, κοὐδὲν καθαρῶς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:36.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:36.1.text#ἀλλ' ἦ Κρονίου Πανὸς τρομερᾷ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:37.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:37.1.text#μάστιγι φοβῇ; [ φυλακὰς δὲ λιπὼν ]
urn:cts:greekLit:tlg0006.tlg019.fu.sp:38.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:38.1.text#[ κινεῖς στρατιάν. ] τί θροεῖς; τί σε φῶ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:39.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:39.1.text#νέον ἀγγέλλειν; πολλὰ γὰρ εἰπὼν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:40.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:40.1.text#οὐδὲν τρανῶς ἀπέδειξας.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:41.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:41.1.text#— πύρ' αἴθει στρατὸς Ἀργόλας,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:42.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:42.1.text#Ἕκτορ, πᾶσαν ἀν' ὄρφναν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:43.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:43.1.text#διειπετῆ δὲ ναῶν πυρσοῖς σταθμά.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:44.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:44.1.text#πᾶς δ' Ἀγαμεμνονίαν προσέβα στρατὸς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:45.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:45.1.text#ἐννύχιος θορύβῳ σκηνάν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:46.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:46.1.text#νέαν τιν' ἐφιέμενοι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:47.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:47.1.text#βάξιν. οὐ γάρ πω πάρος ὧδ' ἐφοβήθη
urn:cts:greekLit:tlg0006.tlg019.fu.sp:48.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:48.1.text#ναυσιπόρος στρατιά.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:49.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:49.1.text#σοὶ δ', ὑποπτεύων τὸ μέλλον,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:50.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:50.1.text#ἤλυθον ἄγγελος, ὡς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:51.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:51.1.text#μήποτ' ἐς ἐμέ τινα μέμψιν εἴπῃς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:52.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:52.1.text#ἐς καιρὸν ἥκεις, καίπερ ἀγγέλλων φόβον·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:53.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:53.1.text#ἅνδρες γὰρ ἐκ γῆς τῆσδε νυκτέρῳ πλάτῃ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:54.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:54.1.text#λαθόντες ὄμμα τοὐμὸν ἀρεῖσθαι φυγὴν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:55.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:55.1.text#μέλλουσι· σαίνει μ' ἔννυχος φρυκτωρία.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:56.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:56.1.text#ὦ δαῖμον, ὅστις μ' εὐτυχοῦντ' ἐνόσφισας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:57.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:57.1.text#θοίνης λέοντα, πρὶν τὸν Ἀργείων στρατὸν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:58.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:58.1.text#σύρδην ἅπαντα τῷδ' ἀναλῶσαι δορί.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:59.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:59.1.text#εἰ γὰρ φαεννοὶ μὴ ξυνέσχον ἡλίου
urn:cts:greekLit:tlg0006.tlg019.fu.sp:60.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:60.1.text#λαμπτῆρες, οὔτἂν ἔσχον εὐτυχοῦν δόρυ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:61.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:61.1.text#πρὶν ναῦς πυρῶσαι καὶ διὰ σκηνῶν μολεῖν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:62.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:62.1.text#κτείνων Ἀχαιοὺς τῇδε πολυφόνῳ χερί.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:63.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:63.1.text#κἀγὼ μὲν ἦ πρόθυμος ἱέναι δόρυ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:64.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:64.1.text#ἐν νυκτὶ χρῆσθαί τ' εὐτυχεῖ ῥύμῃ θεοῦ·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:65.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:65.1.text#ἀλλ' οἱ σοφοί με καὶ τὸ θεῖον εἰδότες
urn:cts:greekLit:tlg0006.tlg019.fu.sp:66.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:66.1.text#μάντεις ἔπεισαν ἡμέρας μεῖναι φάος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:67.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:67.1.text#κἄπειτ' Ἀχαιῶν μηδέν' ἐν χέρσῳ λιπεῖν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:68.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:68.1.text#οἳ δ' οὐ μένουσι τῶν ἐμῶν θυοσκόων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:69.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:69.1.text#βουλάς· ἐν ὄρφνῃ δραπέτης μέγα σθένει.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:70.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:70.1.text#ἀλλ' ὡς τάχιστα χρὴ παραγγέλλειν στρατῷ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:71.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:71.1.text#τεύχη πρόχειρα λαμβάνειν λῆξαί θ' ὕπνου,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:72.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:72.1.text#ὡς ἄν τις αὐτῶν καὶ νεὼς θρῴσκων ἔπι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:73.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:73.1.text#νῶτον χαραχθεὶς κλίμακας ῥάνῃ φόνῳ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:74.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:74.1.text#οἳ δ' ἐν βρόχοισι δέσμιοι λελημμένοι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:75.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:75.1.text#Φρυγῶν ἀρούρας ἐκμάθωσι γαπονεῖν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:76.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:76.1.text#Ἕκτορ, ταχύνεις πρὶν μαθεῖν τὸ δρώμενον·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:77.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:77.1.text#ἅνδρες γὰρ εἰ φεύγουσιν οὐκ ἴσμεν τορῶς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:78.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:78.1.text#τίς γὰρ πύρ' αἴθειν πρόφασις Ἀργείων στρατόν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:79.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:79.1.text#οὐκ οἶδ'· ὕποπτον δ' ἐστὶ κάρτ' ἐμῇ φρενί.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:80.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:80.1.text#πάντ' ἂν φοβηθεὶς ἴσθι, δειμαίνων τόδε.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:81.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:81.1.text#οὔπω πρὶν ἧψαν πολέμιοι τοσόνδε φῶς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:82.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:82.1.text#οὐδ' ὧδέ γ' αἰσχρῶς ἔπεσον ἐν τροπῇ δορός.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:83.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:83.1.text#σὺ ταῦτ' ἔπραξας· καὶ τὰ λοιπὰ νῦν σκόπει.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:84.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:84.1.text#ἁπλοῦς ἐπ' ἐχθροῖς μῦθος ὁπλίζειν χέρα.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:85.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:85.1.text#καὶ μὴν ὅδ' Αἰνέας καὶ μάλα σπουδῇ ποδὸς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:86.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:86.1.text#στείχει, νέον τι πρᾶγμ' ἔχων φίλοις φράσαι.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:87.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:87.1.text#Ἕκτορ, τί χρῆμα νύκτεροι κατὰ στρατὸν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:88.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:88.1.text#τὰς σὰς πρὸς εὐνὰς φύλακες ἐλθόντες φόβῳ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:89.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:89.1.text#νυκτηγοροῦσι καὶ κεκίνηται· στρατός;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:90.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:90.1.text#Αἰνέα, πύκαζε τεύχεσιν δέμας σέθεν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:91.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:91.1.text#τί δ' ἔστι; μῶν τις πολεμίων ἀγγέλλεται
urn:cts:greekLit:tlg0006.tlg019.fu.sp:92.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:92.1.text#δόλος κρυφαῖος ἑστάναι κατ' εὐφρόνην;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:93.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:93.1.text#φεύγουσιν ἅνδρες κἀπιβαίνουσιν νεῶν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:94.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:94.1.text#τί τοῦδ' ἂν εἴποις ἀσφαλὲς τεκμήριον;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:95.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:95.1.text#αἴθουσι πᾶσαν νύκτα λαμπάδας πυρός·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:96.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:96.1.text#καί μοι δοκοῦσιν οὐ μενεῖν ἐς αὔριον,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:97.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:97.1.text#ἀλλ' ἐκκέαντες πύρσ' ἐπ' εὐσέλμων νεῶν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:98.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:98.1.text#φυγῇ πρὸς οἴκους τῆσδ' ἀφορμήσειν χθονός.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:99.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:99.1.text#σὺ δ' ὡς τί δράσων πρὸς τάδ' ὁπλίζῃ χέρας;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:100.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:100.1.text#φεύγοντας αὐτοὺς κἀπιθρῴσκοντας νεῶν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:101.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:101.1.text#λόγχῃ καθέξω κἀπικείσομαι βαρύς·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:102.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:102.1.text#αἰσχρὸν γὰρ ἡμῖν, καὶ πρὸς αἰσχύνῃ κακόν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:103.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:103.1.text#θεοῦ διδόντος πολεμίους ἄνευ μάχης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:104.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:104.1.text#φεύγειν ἐᾶσαι πολλὰ δράσαντας κακά.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:105.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:105.1.text#εἴθ' ἦσθ' ἀνὴρ εὔβουλος ὡς δρᾶσαι χερί.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:106.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:106.1.text#ἀλλ' οὐ γὰρ αὑτὸς πάντ' ἐπίστασθαι βροτῶν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:107.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:107.1.text#πέφυκεν· ἄλλῳ δ' ἄλλο πρόσκειται γέρας,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:108.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:108.1.text#σὲ μὲν μάχεσθαι, τοὺς δὲ βουλεύειν καλῶς·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:109.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:109.1.text#ὅστις πυρὸς λαμπτῆρας ἐξήρθης κλύων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:110.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:110.1.text#φλέγειν Ἀχαιούς, καὶ στρατὸν μέλλεις ἄγειν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:111.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:111.1.text#τάφρους ὑπερβὰς νυκτὸς ἐν καταστάσει.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:112.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:112.1.text#καίτοι περάσας κοῖλον αὐλώνων βάθος,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:113.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:113.1.text#εἰ μὴ κυρήσεις πολεμίους ἀπὸ χθονὸς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:114.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:114.1.text#φεύγοντας, ἀλλὰ σὸν βλέποντας ἐς δόρυ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:115.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:115.1.text#νικώμενος μὲν οὔτι μὴ μόλῃς πάλιν·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:116.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:116.1.text#πῶς γὰρ περάσει σκόλοπας ἐν τροπῇ στρατός;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:117.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:117.1.text#πῶς δ' αὖ γεφύρας διαβαλοῦσ' ἱππηλάται,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:118.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:118.1.text#ἢν ἆρα μὴ θραύσαντες ἀντύγων χνόας;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:119.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:119.1.text#νικῶν δ' ἔφεδρον παῖδ' ἔχεις τὸν Πηλέως,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:120.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:120.1.text#ὅς σ' οὐκ ἐάσει ναυσὶν ἐμβαλεῖν φλόγα,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:121.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:121.1.text#οὐδ' ὧδ' Ἀχαιούς, ὡς δοκεῖς, ἀναρπάσαι.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:122.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:122.1.text#αἴθων γὰρ ἁνὴρ καὶ πεπύργωται χερί.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:123.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:123.1.text#ἀλλὰ στρατὸν μὲν ἥσυχον παρ' ἀσπίδας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:124.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:124.1.text#εὕδειν ἐῶμεν ἐκ κόπων ἀρειφάτων,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:125.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:125.1.text#κατάσκοπον δὲ πολεμίων, ὃς ἂν θέλῃ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:126.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:126.1.text#πέμπειν δοκεῖ μοι· κἂν μὲν αἴρωνται φυγήν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:127.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:127.1.text#στείχοντες ἐμπέσωμεν Ἀργείων στρατῷ·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:128.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:128.1.text#εἰ δ' ἐς δόλον τιν' ἥδ' ἄγει φρυκτωρία,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:129.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:129.1.text#μαθόντες ἐχθρῶν μηχανὰς κατασκόπου
urn:cts:greekLit:tlg0006.tlg019.fu.sp:130.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:130.1.text#βουλευσόμεσθα· τήνδ' ἔχω γνώμην, ἄναξ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:131.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:131.1.text#τάδε δοκεῖ, τάδε μεταθέμενος νόει.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:132.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:132.1.text#σφαλερὰ δ' οὐ φιλῶ στρατηγῶν κράτη.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:133.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:133.1.text#τί γὰρ ἄμεινον ἢ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:134.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:134.1.text#ταχυβάταν νεῶν κατόπταν μολεῖν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:135.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:135.1.text#πέλας ὅ τί ποτ' ἄρα δαΐοις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:136.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:136.1.text#πυρὰ κατ' ἀντίπρῳρα ναυστάθμων δαίεται;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:137.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:137.1.text#νικᾶτ', ἐπειδὴ πᾶσιν ἁνδάνει τάδε.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:138.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:138.1.text#στείχων δὲ κοίμα συμμάχους· τάχ' ἂν στρατὸς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:139.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:139.1.text#κινοῖτ' ἀκούσας νυκτέρους ἐκκλησίας.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:140.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:140.1.text#ἐγὼ δὲ πέμψω πολεμίων κατάσκοπον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:141.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:141.1.text#κἂν μέν τιν' ἐχθρῶν μηχανὴν πυθώμεθα,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:142.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:142.1.text#σὺ πάντ' ἀκούσῃ καὶ παρὼν εἴσῃ λόγον·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:143.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:143.1.text#ἐὰν δ' ἀπαίρωσ' ἐς φυγὴν ὁρμώμενοι,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:144.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:144.1.text#σάλπιγγος αὐδὴν προσδοκῶν καραδόκει,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:145.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:145.1.text#ὡς οὐ μενοῦντά μ'· ἀλλὰ προσμείξω νεῶν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:146.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:146.1.text#ὁλκοῖσι νυκτὸς τῆσδ' ἐπ' Ἀργείων στρατῷ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:147.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:147.1.text#πέμφ' ὡς τάχιστα· νῦν γὰρ ἀσφαλῶς φρονεῖς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:148.1.speaker#Αἰνείας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:148.1.text#σὺν σοὶ δ' ἔμ' ὄψῃ καρτεροῦνθ', ὅταν δέῃ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:149.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:149.1.text#τίς δῆτα Τρώων οἳ πάρεισιν ἐν λόγῳ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:150.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:150.1.text#θέλει κατόπτης ναῦς ἐπ' Ἀργείων μολεῖν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:151.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:151.1.text#τίς ἂν γένοιτο τῆσδε γῆς εὐεργέτης;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:152.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:152.1.text#τίς φησιν; οὔτοι πάντ' ἐγὼ δυνήσομαι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:153.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:153.1.text#πόλει πατρῴᾳ συμμάχοις θ' ὑπηρετεῖν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:154.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:154.1.text#ἐγὼ πρὸ γαίας τόνδε κίνδυνον θέλω
urn:cts:greekLit:tlg0006.tlg019.fu.sp:155.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:155.1.text#ῥίψας κατόπτης ναῦς ἐπ' Ἀργείων μολεῖν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:156.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:156.1.text#καὶ πάντ' Ἀχαιῶν ἐκμαθὼν βουλεύματα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:157.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:157.1.text#ἥξω· ἐπὶ τούτοις τόνδ' ὑφίσταμαι πόνον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:158.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:158.1.text#ἐπώνυμος μὲν κάρτα καὶ φιλόπτολις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:159.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:159.1.text#Δόλων· πατρὸς δὲ καὶ πρὶν εὐκλεᾶ δόμον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:160.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:160.1.text#νῦν δὶς τόσως ἔθηκας εὐκλεέστερον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:161.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:161.1.text#οὐκοῦν πονεῖν μὲν χρή, πονοῦντα δ' ἄξιον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:162.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:162.1.text#μισθὸν φέρεσθαι. παντὶ γὰρ προσκείμενον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:163.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:163.1.text#κέρδος πρὸς ἔργῳ τὴν χάριν τίκτει διπλῆν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:164.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:164.1.text#ναί, καὶ δίκαια ταῦτα κοὐκ ἄλλως λέγω.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:165.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:165.1.text#τάξαι δὲ μισθόν, πλὴν ἐμῆς τυραννίδος.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:166.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:166.1.text#οὐ σῆς ἐρῶμεν πολιόχου τυραννίδος.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:167.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:167.1.text#σὺ δ' ἀλλὰ γήμας Πριαμιδῶν γαμβρὸς γενοῦ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:168.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:168.1.text#οὐδ' ἐξ ἐμαυτοῦ μειζόνων γαμεῖν θέλω.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:169.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:169.1.text#χρυσὸς πάρεστιν, εἰ τόδ' αἰτήσεις γέρας.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:170.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:170.1.text#ἀλλ' ἔστ' ἐν οἴκοις· οὐ βίου σπανίζομεν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:171.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:171.1.text#τί δῆτα χρῄζεις ὧν κέκευθεν Ἴλιος;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:172.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:172.1.text#ἑλὼν Ἀχαιοὺς δῶρά μοι ξυναίνεσον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:173.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:173.1.text#δώσω· σὺ δ' αἴτει πλὴν στρατηλάτας νεῶν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:174.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:174.1.text#κτεῖν', οὔ σ' ἀπαιτῶ Μενέλεω σχέσθαι χέρα.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:175.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:175.1.text#οὐ μὴν τὸν Ἰλέως παῖδά μ' ἐξαιτῇ λαβεῖν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:176.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:176.1.text#κακαὶ γεωργεῖν χεῖρες εὖ τεθραμμέναι.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:177.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:177.1.text#τίν' οὖν Ἀχαιῶν ζῶντ' ἀποινᾶσθαι θέλεις;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:178.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:178.1.text#καὶ πρόσθεν εἶπον· ἔστι χρυσὸς ἐν δόμοις.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:179.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:179.1.text#καὶ μὴν λαφύρων γ' αὐτὸς αἱρήσῃ παρών.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:180.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:180.1.text#θεοῖσιν αὐτὰ πασσάλευε πρὸς δόμοις.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:181.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:181.1.text#τί δῆτα μεῖζον τῶνδέ μ' αἰτήσεις γέρας;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:182.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:182.1.text#ἵππους Ἀχιλλέως· χρὴ δ' ἐπ' ἀξίοις πονεῖν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:183.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:183.1.text#ψυχὴν προβάλλοντ' ἐν κύβοισι δαίμονος.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:184.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:184.1.text#καὶ μὴν ἐρῶντί γ' ἀντερᾷς ἵππων ἐμοί·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:185.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:185.1.text#ἐξ ἀφθίτων γὰρ ἄφθιτοι πεφυκότες
urn:cts:greekLit:tlg0006.tlg019.fu.sp:186.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:186.1.text#τὸν Πηλέως φέρουσι θούριον γόνον·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:187.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:187.1.text#δίδωσι δ' αὐτοὺς πωλοδαμνήσας ἄναξ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:188.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:188.1.text#Πηλεῖ Ποσειδῶν, ὡς λέγουσι, πόντιος.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:189.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:189.1.text#ἀλλ' οὔ σ' ἐπάρας ψεύσομαι· δώσω δέ σοι,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:190.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:190.1.text#κάλλιστον οἴκοις κτῆμ', Ἀχιλλέως ὄχον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:191.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:191.1.text#αἰνῶ· λαβὼν δ' ἄν φημι κάλλιστον Φρυγῶν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:192.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:192.1.text#δῶρον δέχεσθαι τῆς ἐμῆς εὐσπλαγχνίας.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:193.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:193.1.text#σὲ δ' οὐ φθονεῖν χρή· μυρί' ἔστιν ἄλλα σοι,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:194.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:194.1.text#ἐφ' οἷσι τέρψῃ τῆσδ' ἀριστεύων χθονός.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:195.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:195.1.text#μέγας ἀγών, μεγάλα δ' ἐπινοεῖς ἑλεῖν·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:196.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:196.1.text#μακάριός γε μὴν κυρήσας ἔσῃ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:197.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:197.1.text#πόνος ὅδ' εὐκλεής·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:198.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:198.1.text#μέγα δὲ κοιράνοισι γαμβρὸν πέλειν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:199.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:199.1.text#τὰ θεόθεν ἐπιδέτω Δίκα,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:200.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:200.1.text#τὰ δὲ παρ' ἀνδράσιν τέλειά σοι φαίνεται.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:201.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:201.1.text#στείχοιμ' ἄν· ἐλθὼν { δ' } ἐς δόμους ἐφέστιος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:202.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:202.1.text#σκευῇ πρεπόντως σῶμ' ἐμὸν καθάψομαι,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:203.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:203.1.text#κἀκεῖθεν ἥσω ναῦς ἐπ' Ἀργείων πόδα.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:204.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:204.1.text#ἐπεὶ τίν' ἄλλην ἀντὶ τῆσδ' ἕξεις στολήν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:205.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:205.1.text#πρέπουσαν ἔργῳ κλωπικοῖς τε βήμασι.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:206.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:206.1.text#σοφοῦ παρ' ἀνδρὸς χρὴ σοφόν τι μανθάνειν·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:207.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:207.1.text#λέξον, τίς ἔσται τοῦδε σώματος σαγή;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:208.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:208.1.text#λύκειον ἀμφὶ νῶτ' ἐνάψομαι δορὰν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:209.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:209.1.text#καὶ χάσμα θηρὸς ἀμφ' ἐμῷ θήσω κάρᾳ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:210.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:210.1.text#βάσιν τε χερσὶ προσθίαν καθαρμόσας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:211.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:211.1.text#καὶ κῶλα κώλοις, τετράπουν μιμήσομαι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:212.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:212.1.text#λύκου κέλευθον πολεμίοις δυσεύρετον,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:213.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:213.1.text#τάφροις πελάζων καὶ νεῶν προβλήμασιν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:214.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:214.1.text#ὅταν δ' ἔρημον χῶρον ἐμβαίνω ποδί,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:215.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:215.1.text#δίβαμος εἶμι· τῇδε σύγκειται δόλος.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:216.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:216.1.text#ἀλλ' εὖ σ' ὁ Μαίας παῖς ἐκεῖσε καὶ πάλιν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:217.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:217.1.text#πέμψειεν Ἑρμῆς, ὅς γε φηλητῶν ἄναξ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:218.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:218.1.text#ἔχεις δὲ τοὔργον· εὐτυχεῖν μόνον σε δεῖ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:219.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:219.1.text#σωθήσομαί γε καὶ κτανὼν Ὀδυσσέως
urn:cts:greekLit:tlg0006.tlg019.fu.sp:220.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:220.1.text#οἴσω κάρα σοι — σύμβολον δ' ἔχων σαφὲς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:221.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:221.1.text#φήσεις Δόλωνα ναῦς ἐπ' Ἀργείων μολεῖν —
urn:cts:greekLit:tlg0006.tlg019.fu.sp:222.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:222.1.text#ἢ παῖδα Τυδέως· οὐδ' ἀναιμάκτῳ χερὶ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:223.1.speaker#Δόλων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:223.1.text#ἥξω πρὸς οἴκους πρὶν φάος μολεῖν χθόνα.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:224.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:224.1.text#Θυμβραῖε καὶ Δάλιε καὶ Λυκίας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:225.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:225.1.text#ναὸν ἐμβατεύων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:226.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:226.1.text#Ἄπολλον, ὦ δία κεφαλά, μόλε τοξήρης,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:227.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:227.1.text#ἱκοῦ ἐννύχιος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:229.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:229.1.text#καὶ γενοῦ σωτήριος ἀνέρι πομπᾶς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:230.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:230.1.text#ἁγεμὼν καὶ ξύλλαβε Δαρδανίδαις,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:231.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:231.1.text#ὦ παγκρατές, ὦ Τροΐας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:232.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:232.1.text#τείχη παλαιὰ δείμας.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:233.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:233.1.text#μόλοι δὲ ναυκλήρια, καὶ στρατιᾶς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:234.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:234.1.text#Ἑλλάδος διόπτας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:235.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:235.1.text#ἵκοιτο, καὶ κάμψειε πάλιν θυμέλας οἴκων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:236.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:236.1.text#πατρὸς Ἰλιάδας.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:237.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:237.1.text#Φθιάδων δ' ἵππων ποτ' ἐπ' ἄντυγα βαίη,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:238.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:238.1.text#δεσπότου πέρσαντος Ἀχαιὸν Ἄρη,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:240.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:240.1.text#τὰς πόντιος Αἰακίδᾳ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:241.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:241.1.text#Πηλεῖ δίδωσι δαίμων.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:243.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:243.1.text#ἐπεὶ πρό τ' οἴκων πρό τε γᾶς ἔτλα μόνος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:244.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:244.1.text#ναύσταθμα βὰς κατιδεῖν· ἄγαμαι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:245.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:245.1.text#λήματος· ἦ σπανία { τις }
urn:cts:greekLit:tlg0006.tlg019.fu.sp:246.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:246.1.text#τῶν ἀγαθῶν, ὅταν ᾖ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:247.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:247.1.text#δυσάλιος ἐν πελάγει
urn:cts:greekLit:tlg0006.tlg019.fu.sp:248.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:248.1.text#καὶ σαλεύῃ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:250.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:250.1.text#πόλις. ἔστι Φρυγῶν τις ἔστιν ἄλκιμος·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:251.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:251.1.text#ἔνι δὲ θράσος ἐν αἰχμᾷ·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:252.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:252.1.text#πόθι Μυσῶν ὃς ἐμὰν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:253.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:253.1.text#συμμαχίαν ἀτίζει;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:254.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:254.1.text#τίν' ἄνδρ' Ἀχαιῶν ὁ πεδοστιβὴς σφαγεὺς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:255.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:255.1.text#οὐτάσει ἐν κλισίαις, τετράπουν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:256.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:256.1.text#μῖμον ἔχων ἐπιγαίου
urn:cts:greekLit:tlg0006.tlg019.fu.sp:257.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:257.1.text#θηρός; ἕλοι Μενέλαν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:258.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:258.1.text#κτανὼν δ' Ἀγαμεμνόνιον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:259.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:259.1.text#κρᾶτ' ἐνέγκοι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:260.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:260.1.text#Ἑλένᾳ κακόγαμβρον ἐς χέρας γόον,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:261.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:261.1.text#ὃς ἐπὶ πόλιν, ὃς ἐπὶ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:262.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:262.1.text#γᾶν Τροΐαν χιλιόναυν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:263.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:263.1.text#ἤλυθ' ἔχων στρατείαν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:264.1.speaker#Ἄγγελος Ποιμήν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:264.1.text#ἄναξ, τοιούτων δεσπόταισιν ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:265.1.speaker#Ἄγγελος Ποιμήν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:265.1.text#εἴην τὸ λοιπὸν οἷά σοι φέρω μαθεῖν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:266.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:266.1.text#ἦ πόλλ' ἀγρώταις σκαιὰ πρόσκειται φρενί·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:267.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:267.1.text#καὶ γὰρ σὺ ποίμνας δεσπόταις τευχεσφόροις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:268.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:268.1.text#ἥκειν ἔοικας ἀγγελῶν ἵν' οὐ πρέπει.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:269.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:269.1.text#οὐκ οἶσθα δῶμα τοὐμὸν ἢ θρόνους πατρός,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:270.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:270.1.text#οἷ χρῆν γεγωνεῖν σ' εὐτυχοῦντα ποίμνια;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:271.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:271.1.text#σκαιοὶ βοτῆρές ἐσμεν· οὐκ ἄλλως λέγω.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:272.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:272.1.text#ἀλλ' οὐδὲν ἧσσον σοι φέρω κεδνοὺς λόγους.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:273.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:273.1.text#παῦσαι λέγων μοι τὰς προσαυλείους τύχας·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:274.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:274.1.text#μάχας πρὸ χειρῶν καὶ δόρη βαστάζομεν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:275.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:275.1.text#τοιαῦτα κἀγὼ σημανῶν ἐλήλυθα·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:276.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:276.1.text#ἀνὴρ γὰρ ἀλκῆς μυρίας στρατηλατῶν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:277.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:277.1.text#στείχει φίλος σοὶ σύμμαχός τε τῇδε γῇ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:278.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:278.1.text#ποίας πατρῴας γῆς ἐρημώσας πέδον;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:279.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:279.1.text#Θρῄκης· πατρὸς δὲ Στρυμόνος κικλήσκεται.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:280.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:280.1.text#Ῥῆσον τιθέντ' ἔλεξας ἐν Τροίᾳ πόδα;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:281.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:281.1.text#ἔγνως· λόγου δὲ δὶς τόσου μ' ἐκούφισας.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:282.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:282.1.text#καὶ πῶς πρὸς Ἴδης ὀργάδας πορεύεται,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:283.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:283.1.text#πλαγχθεὶς πλατείας πεδιάδος θ' ἁμαξιτοῦ;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:284.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:284.1.text#οὐκ οἶδ' ἀκριβῶς· εἰκάσαι γε μὴν πάρα.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:285.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:285.1.text#νυκτὸς γὰρ οὔτι φαῦλον ἐμβαλεῖν στρατόν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:286.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:286.1.text#κλύοντα πλήρη πεδία πολεμίας χερός.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:287.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:287.1.text#φόβον δ' ἀγρώσταις, οἳ κατ' Ἰδαῖον λέπας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:288.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:288.1.text#οἰκοῦμεν αὐτόρριζον ἑστίαν χθονός,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:289.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:289.1.text#παρέσχε δρυμὸν νυκτὸς ἔνθηρον μολών.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:290.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:290.1.text#πολλῇ γὰρ ἠχῇ Θρῄκιος ῥέων στρατὸς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:291.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:291.1.text#ἔστειχε· θάμβει δ' ἐκπλαγέντες ἵεμεν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:292.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:292.1.text#ποίμνας πρὸς ἄκρας, μή τις Ἀργείων μόλῃ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:293.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:293.1.text#λεηλατήσων καὶ σὰ πορθήσων σταθμά,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:294.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:294.1.text#πρὶν δὴ δι' ὤτων γῆρυν οὐχ Ἑλληνικὴν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:295.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:295.1.text#ἐδεξάμεσθα καὶ μετέστημεν φόβου.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:296.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:296.1.text#στείχων δ' ἄνακτος προυξερευνητὰς ὁδοῦ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:297.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:297.1.text#ἀνιστόρησα Θρῃκίοις προσφθέγμασι,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:298.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:298.1.text#Τίς ὁ στρατηγὸς καὶ τίνος κεκλημένος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:299.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:299.1.text#στείχει πρὸς ἄστυ Πριαμίδαισι σύμμαχος;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:300.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:300.1.text#καὶ πάντ' ἀκούσας ὧν ἐφιέμην μαθεῖν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:301.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:301.1.text#ἔστην· ὁρῶ δὲ Ῥῆσον ὥστε δαίμονα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:302.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:302.1.text#ἑστῶτ' ἐν ἵπποις Θρῃκίοις τ' ὀχήμασι.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:303.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:303.1.text#χρυσῆ δὲ πλάστιγξ αὐχένα ζυγηφόρον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:304.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:304.1.text#πώλων ἔκλῃε χιόνος ἐξαυγεστέρων.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:305.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:305.1.text#πέλτη δ' ἐπ' ὤμων χρυσοκολλήτοις τύποις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:306.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:306.1.text#ἔλαμπε· Γοργὼν δ' ὡς ἐπ' αἰγίδος θεᾶς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:307.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:307.1.text#χαλκῆ μετώποις ἱππικοῖσι πρόσδετος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:308.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:308.1.text#πολλοῖσι σὺν κώδωσιν ἐκτύπει φόβον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:309.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:309.1.text#στρατοῦ δὲ πλῆθος οὐδ' ἂν ἐν ψήφου λόγῳ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:310.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:310.1.text#θέσθαι δυναίμην, ὡς ἄπλατον ἦν ἰδεῖν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:311.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:311.1.text#πολλοὶ μὲν ἱππῆς, πολλὰ πελταστῶν τέλη,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:312.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:312.1.text#πολλοὶ δ' ἀτράκτων τοξόται, πολὺς δ' ὄχλος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:313.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:313.1.text#γυμνὴς ὁμαρτῇ, Θρῃκίαν ἔχων στολήν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:314.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:314.1.text#τοιόσδε Τροίᾳ σύμμαχος πάρεστ' ἀνήρ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:315.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:315.1.text#ὃν οὔτε φεύγων οὔθ' ὑποσταθεὶς δορὶ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:316.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:316.1.text#ὁ Πηλέως παῖς ἐκφυγεῖν δυνήσεται.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:317.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:317.1.text#ὅταν πολίταις εὐσταθῶσι δαίμονες,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:318.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:318.1.text#ἕρπει κατάντης ξυμφορὰ πρὸς τἀγαθά.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:319.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:319.1.text#πολλούς, ἐπειδὴ τοὐμὸν εὐτυχεῖ δόρυ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:320.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:320.1.text#καὶ Ζεὺς πρὸς ἡμῶν ἐστιν, εὑρήσω φίλους.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:321.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:321.1.text#ἀλλ' οὐδὲν αὐτῶν δεόμεθ', οἵτινες πάλαι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:322.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:322.1.text#μὴ ξυμπονοῦσιν, ἡνίκ' ἐξώστης Ἄρης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:323.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:323.1.text#ἔθραυε λαίφη τῆσδε γῆς μέγας πνέων.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:324.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:324.1.text#Ῥῆσος δ' ἔδειξεν οἷος ἦν Τροίᾳ φίλος·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:325.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:325.1.text#ἥκει γὰρ ἐς δαῖτ', οὐ παρὼν κυνηγέταις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:326.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:326.1.text#αἱροῦσι λείαν οὐδὲ συγκαμὼν δορί.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:327.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:327.1.text#ὀρθῶς ἀτίζεις κἀπίμομφος εἶ φίλοις·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:328.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:328.1.text#δέχου δὲ τοὺς θέλοντας ὠφελεῖν πόλιν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:329.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:329.1.text#ἀρκοῦμεν οἱ σῴζοντες Ἴλιον πάλαι.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:330.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:330.1.text#πέποιθας ἤδη πολεμίους ᾑρηκέναι;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:331.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:331.1.text#πέποιθα· δείξει τοὐπιὸν σέλας θεοῦ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:332.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:332.1.text#ὅρα τὸ μέλλον· πόλλ' ἀναστρέφει θεός.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:333.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:333.1.text#μισῶ φίλοισιν ὕστερον βοηδρομεῖν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:336.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:336.1.text#ὃ δ' οὖν, ἐπείπερ ἦλθε, σύμμαχος μὲν οὔ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:337.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:337.1.text#ξένος δὲ πρὸς τράπεζαν ἡκέτω ξένων·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:338.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:338.1.text#χάρις γὰρ αὐτῷ Πριαμιδῶν διώλετο.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:334.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:334.1.text#ἄναξ, ἀπωθεῖν συμμάχους ἐπίφθονον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:335.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:335.1.text#φόβος γένοιτ' ἂν πολεμίοις ὀφθεὶς μόνον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:339.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:339.1.text#σύ τ' εὖ παραινεῖς καὶ σὺ καιρίως σκοπεῖς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:340.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:340.1.text#ὁ χρυσοτευχὴς δ' οὕνεκ' ἀγγέλου λόγων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:341.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:341.1.text#Ῥῆσος παρέστω τῇδε σύμμαχος χθονί.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:342.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:342.1.text#Ἀδράστεια μὲν ἁ Διὸς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:343.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:343.1.text#παῖς εἴργοι στομάτων φθόνον·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:344.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:344.1.text#φράσω γὰρ δὴ ὅσον μοι ψυχᾷ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:345.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:345.1.text#προσφιλές ἐστιν εἰπεῖν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:346.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:346.1.text#ἥκεις, ὦ ποταμοῦ παῖ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:347.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:347.1.text#ἥκεις, ἐπλάθης Φιλίου πρὸς αὐλὰν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:348.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:348.1.text#ἀσπαστός, ἐπεί σε χρόνῳ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:349.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:349.1.text#Πιερὶς μάτηρ ὅ τε καλλιγέφυρος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:350.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:350.1.text#ποταμὸς πορεύει
urn:cts:greekLit:tlg0006.tlg019.fu.sp:351.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:351.1.text#Στρυμών, ὅς ποτε τᾶς μελῳδοῦ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:352.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:352.1.text#Μούσας δι' ἀκηράτων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:353.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:353.1.text#δινηθεὶς ὑδροειδὴς κόλπων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:354.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:354.1.text#σὰν ἐφύτευσεν ἥβαν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:355.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:355.1.text#σύ μοι Ζεὺς ὁ φαναῖος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:356.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:356.1.text#ἥκεις διφρεύων βαλιαῖσι πώλοις.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:357.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:357.1.text#νῦν, ὦ πατρὶς ὦ Φρυγία,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:358.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:358.1.text#ξὺν θεῷ νῦν σοι τὸν ἐλευθέριον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:359.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:359.1.text#Ζῆνα πάρεστιν εἰπεῖν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:360.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:360.1.text#ἆρά ποτ' αὖθις ἁ παλαιὰ Τροΐα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:361.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:361.1.text#τοὺς προπότας παναμερεύσει
urn:cts:greekLit:tlg0006.tlg019.fu.sp:362.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:362.1.text#θιάσους ἐρώτων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:363.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:363.1.text#ψαλμοῖσι καὶ κυλίκων οἰνοπλανήτοις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:364.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:364.1.text#ὑποδεξίαις ἁμίλλαις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:365.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:365.1.text#κατὰ πόντον Ἀτρειδᾶν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:366.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:366.1.text#Σπάρταν οἰχομένων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:366.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:366.2.text#Ἰλιάδος παρ' ἀκτᾶς;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:367.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:367.1.text#ὦ φίλος, εἴθε μοι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:368.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:368.1.text#σᾷ χερὶ καὶ σῷ δορὶ πράξας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:369.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:369.1.text#τάδ' ἐς οἶκον ἔλθοις.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:370.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:370.1.text#ἐλθέ, φάνηθι, τὰν ζάχρυσον προβαλοῦ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:371.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:371.1.text#Πηλεΐδα κατ' ὄμμα πέλταν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:372.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:372.1.text#δοχμίαν πεδαίρων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:373.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:373.1.text#σχιστὰν παρ' ἄντυγα, πώλους ἐρεθίζων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:374.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:374.1.text#δίβολόν τ' ἄκοντα πάλλων.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:375.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:375.1.text#σὲ γὰρ οὔτις ὑποστὰς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:376.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:376.1.text#Ἀργείας ποτ' ἐν Ἥρας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:377.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:377.1.text#δαπέδοις χορεύσει·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:378.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:378.1.text#ἀλλά νιν ἅδε γᾶ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:378.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:378.2.text#καπφθίμενον Θρῃκὶ μόρῳ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:379.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:379.1.text#φίλτατον ἄχθος οἴσει.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:380.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:380.1.text#— ἰὼ ἰώ, μέγας ὦ βασιλεῦ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:380.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:380.2.text#καλόν, ὦ Θρῄκη,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:381.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:381.1.text#σκύμνον ἔθρεψας πολίαρχον ἰδεῖν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:382.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:382.1.text#ἴδε χρυσόδετον σώματος ἀλκήν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:383.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:383.1.text#κλύε καὶ κόμπους κωδωνοκρότους
urn:cts:greekLit:tlg0006.tlg019.fu.sp:384.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:384.1.text#παρὰ πορπάκων κελαδοῦντας.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:385.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:385.1.text#θεός, ὦ Τροία, θεός, αὐτὸς Ἄρης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:386.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:386.1.text#ὁ Στρυμόνιος πῶλος ἀοιδοῦ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:387.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:387.1.text#Μούσης ἥκων καταπνεῖ σε.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:388.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:388.1.text#χαῖρ', ἐσθλὸς ἐσθλοῦ παῖς, τύραννε τῆσδε γῆς,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:389.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:389.1.text#Ἕκτορ· παλαιᾷ σ' ἡμέρᾳ προσεννέπω.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:390.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:390.1.text#χαίρω δέ σ' εὐτυχοῦντα καὶ προσήμενον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:391.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:391.1.text#πύργοισιν ἐχθρῶν· συγκατασκάψων δ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:392.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:392.1.text#τείχη πάρειμι καὶ νεῶν πρήσων σκάφη.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:393.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:393.1.text#παῖ τῆς μελῳδοῦ μητέρος Μουσῶν μιᾶς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:394.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:394.1.text#Θρῃκός τε ποταμοῦ Στρυμόνος, φιλῶ λέγειν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:395.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:395.1.text#τἀληθὲς αἰεὶ κοὐ διπλοῦς πέφυκ' ἀνήρ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:396.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:396.1.text#πάλαι πάλαι χρῆν τῇδε συγκάμνειν χθονὶ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:397.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:397.1.text#ἐλθόντα, καὶ μὴ τοὐπί σ' Ἀργείων ὕπο
urn:cts:greekLit:tlg0006.tlg019.fu.sp:398.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:398.1.text#Τροίαν ἐᾶσαι πολεμίῳ πεσεῖν δορί.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:399.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:399.1.text#οὐ γάρ τι λέξεις ὡς ἄκλητος ὢν φίλοις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:400.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:400.1.text#οὐκ ἦλθες οὐδ' ἤμυνας οὐδ' ἐπεστράφης.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:401.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:401.1.text#τίς γάρ σε κῆρυξ ἢ γερουσία Φρυγῶν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:402.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:402.1.text#ἐλθοῦσ' ἀμύνειν οὐκ ἐπέσκηψεν πόλει;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:403.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:403.1.text#ποῖον δὲ δώρων κόσμον οὐκ ἐπέμψαμεν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:404.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:404.1.text#σὺ δ' ἐγγενὴς ὢν βάρβαρός τε βαρβάρους
urn:cts:greekLit:tlg0006.tlg019.fu.sp:405.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:405.1.text#Ἕλλησιν ἡμᾶς προύπιες τὸ σὸν μέρος.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:406.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:406.1.text#καίτοι σε μικρᾶς ἐκ τυραννίδος μέγαν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:407.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:407.1.text#Θρῃκῶν ἄνακτα τῇδ' ἔθηκ' ἐγὼ χερί,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:408.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:408.1.text#ὅτ' ἀμφὶ Πάγγαιόν τε Παιόνων τε γῆν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:409.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:409.1.text#Θρῃκῶν ἀρίστοις ἐμπεσὼν κατὰ στόμα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:410.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:410.1.text#ἔρρηξα πέλτην, σοὶ δὲ δουλώσας λεὼν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:411.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:411.1.text#παρέσχον· ὧν σὺ λακτίσας πολλὴν χάριν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:412.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:412.1.text#φίλων νοσούντων ὕστερος βοηδρομεῖς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:413.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:413.1.text#οἱ δ' οὐδὲν ἡμῖν ἐν γένει πεφυκότες,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:414.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:414.1.text#πάλαι παρόντες, οἳ μὲν ἐν χωστοῖς τάφοις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:415.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:415.1.text#κεῖνται πεσόντες, πίστις οὐ σμικρὰ πόλει,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:416.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:416.1.text#οἳ δ' ἔν θ' ὅπλοισι καὶ παρ' ἱππείοις ὄχοις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:417.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:417.1.text#ψυχρὰν ἄησιν δίψιόν τε πῦρ θεοῦ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:418.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:418.1.text#μένουσι καρτεροῦντες, οὐκ ἐν δεμνίοις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:419.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:419.1.text#πυκνὴν ἄμυστιν ὡς σὺ δεξιούμενοι.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:420.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:420.1.text#ταῦθ', ὡς ἂν εἰδῇς Ἕκτορ' ὄντ' ἐλεύθερον,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:421.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:421.1.text#καὶ μέμφομαί σοι καὶ λέγω κατ' ὄμμα σόν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:422.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:422.1.text#τοιοῦτός εἰμι καὐτός, εὐθεῖαν λόγων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:423.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:423.1.text#τέμνων κέλευθον, κοὐ διπλοῦς πέφυκ' ἀνήρ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:424.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:424.1.text#ἐγὼ δὲ μεῖζον ἢ σὺ τῆσδ' ἀπὼν χθονὸς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:425.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:425.1.text#λύπῃ πρὸς ἧπαρ δυσφορῶν ἐτειρόμην·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:426.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:426.1.text#ἀλλ' ἀγχιτέρμων γαῖά μοι, Σκύθης λεώς,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:427.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:427.1.text#μέλλοντι νόστον τὸν πρὸς Ἴλιον περᾶν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:428.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:428.1.text#ξυνῆψε πόλεμον· Εὐξένου δ' ἀφικόμην
urn:cts:greekLit:tlg0006.tlg019.fu.sp:429.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:429.1.text#πόντου πρὸς ἀκτάς, Θρῇκα πορθμεύσων στρατόν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:430.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:430.1.text#ἔνθ' αἱματηρὸς πέλανος ἐς γαῖαν Σκύθης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:431.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:431.1.text#ἠντλεῖτο λόγχῃ Θρῄξ τε συμμιγὴς φόνος.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:432.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:432.1.text#τοιάδε τοί μ' ἀπεῖργε συμφορὰ πέδον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:433.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:433.1.text#Τροίας ἱκέσθαι σύμμαχόν τέ σοι μολεῖν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:434.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:434.1.text#ἐπεὶ δ' ἔπερσα, τῶνδ' ὁμηρεύσας τέκνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:435.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:435.1.text#τάξας { τ' } ἔτειον δασμὸν ἐς δόμους φέρειν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:436.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:436.1.text#ἥκω περάσας ναυσὶ πόντιον στόμα,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:437.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:437.1.text#τὰ δ' ἄλλα πεζὸς γῆς περῶν ὁρίσματα —
urn:cts:greekLit:tlg0006.tlg019.fu.sp:438.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:438.1.text#οὐχ ὡς σὺ κομπεῖς τὰς ἐμὰς ἀμύστιδας,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:439.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:439.1.text#οὐδ' ἐν ζαχρύσοις δώμασιν κοιμώμενος,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:440.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:440.1.text#ἀλλ' οἷα πόντον Θρῄκιον φυσήματα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:441.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:441.1.text#κρυσταλλόπηκτα Παιόνας τ' ἐπεζάρει,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:442.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:442.1.text#ξὺν τοῖσδ' ἄυπνος οἶδα τλὰς πορπάμασιν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:443.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:443.1.text#ἀλλ' ὕστερος μὲν ἦλθον, ἐν καιρῷ δ' ὅμως·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:444.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:444.1.text#σὺ μὲν γὰρ ἤδη δέκατον αἰχμάζεις ἔτος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:445.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:445.1.text#κοὐδὲν περαίνεις, ἡμέραν δ' ἐξ ἡμέρας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:446.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:446.1.text#πίπτεις κυβεύων τὸν πρὸς Ἀργείους Ἄρη·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:447.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:447.1.text#ἐμοὶ δὲ φῶς ἓν ἡλίου καταρκέσει
urn:cts:greekLit:tlg0006.tlg019.fu.sp:448.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:448.1.text#πέρσαντι πύργους ναυστάθμοις ἐπεσπεσεῖν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:449.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:449.1.text#κτεῖναί τ' Ἀχαιούς· θατέρᾳ δ' ἀπ' Ἰλίου
urn:cts:greekLit:tlg0006.tlg019.fu.sp:450.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:450.1.text#πρὸς οἶκον εἶμι, συντεμὼν τοὺς σοὺς πόνους,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:451.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:451.1.text#ὑμῶν δὲ μή τις ἀσπίδ' ἄρηται χερί·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:452.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:452.1.text#ἐγὼ γὰρ ἕξω τοὺς μέγ' αὐχοῦντας δορὶ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:453.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:453.1.text#πέρσας Ἀχαιούς, καίπερ ὕστερος μολών.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:454.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:454.1.text#ἰὼ ἰώ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:455.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:455.1.text#φίλα θροεῖς, φίλος Διόθεν εἶ· μόνον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:456.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:456.1.text#φθόνον ἄμαχον ὕπατος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:457.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:457.1.text#Ζεὺς θέλοι ἀμφὶ σοῖς λόγοισιν εἴργειν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:459.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:459.1.text#τὸ δὲ νάιον Ἀργόθεν δόρυ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:460.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:460.1.text#οὔτε πρίν τιν' οὔτε νῦν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:461.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:461.1.text#ἀνδρῶν ἐπόρευσε σέθεν κρείσσω. πῶς μοι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:462.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:462.1.text#Ἀχιλεὺς τὸ σὸν ἔγχος ἂν δύναιτο,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:463.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:463.1.text#πῶς δ' Αἴας ὑπομεῖναι;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:464.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:464.1.text#εἰ γὰρ ἐγὼ τόδ' ἦμαρ εἰσίδοιμ', ἄναξ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:465.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:465.1.text#ὅτῳ πολυφόνου
urn:cts:greekLit:tlg0006.tlg019.fu.sp:466.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:466.1.text#χειρὸς { ἀποινάσαιο } λόγχᾳ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:467.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:467.1.text#τοιαῦτα μέν σοι τῆς μακρᾶς ἀπουσίας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:468.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:468.1.text#πρᾶξαι παρέξω — σὺν δ' Ἀδραστείᾳ λέγω —
urn:cts:greekLit:tlg0006.tlg019.fu.sp:469.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:469.1.text#ἐπειδἂν ἐχθρῶν τήνδ' ἐλευθέραν πόλιν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:470.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:470.1.text#θῶμεν θεοῖσί τ' ἀκροθίνι' ἐξέλῃς,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:471.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:471.1.text#ξὺν σοὶ στρατεύειν γῆν ἐπ' Ἀργείων θέλω
urn:cts:greekLit:tlg0006.tlg019.fu.sp:472.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:472.1.text#καὶ πᾶσαν ἐλθὼν Ἑλλάδ' ἐκπέρσαι δορί,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:473.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:473.1.text#ὡς ἂν μάθωσιν ἐν μέρει πάσχειν κακῶς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:474.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:474.1.text#εἰ τοῦ παρόντος τοῦδ' ἀπαλλαχθεὶς κακοῦ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:475.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:475.1.text#πόλιν νεμοίμην ὡς τὸ πρίν ποτ' ἀσφαλῆ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:476.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:476.1.text#ἦ κάρτα πολλὴν θεοῖς ἂν εἰδείην χάριν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:477.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:477.1.text#τὰ δ' ἀμφί τ' Ἄργος καὶ νομὸν τὸν Ἑλλάδος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:478.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:478.1.text#οὐχ ὧδε πορθεῖν ῥᾴδι', ὡς λέγεις, δορί.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:479.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:479.1.text#οὐ τούσδ' ἀριστέας φασὶν Ἑλλήνων μολεῖν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:480.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:480.1.text#κοὐ μεμφόμεσθά γ', ἀλλ' ἄδην ἐλαύνομεν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:481.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:481.1.text#οὐκ οὖν κτανόντες τούσδε πᾶν εἰργάσμεθα;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:482.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:482.1.text#μή νυν τὰ πόρρω τἀγγύθεν μεθεὶς σκόπει.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:483.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:483.1.text#ἀρκεῖν ἔοικέ σοι παθεῖν, δρᾶσαι δὲ μή.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:484.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:484.1.text#πολλῆς γὰρ ἄρχω κἀνθάδ' ὢν τυραννίδος.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:485.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:485.1.text#ἀλλ' εἴτε λαιὸν εἴτε δεξιὸν κέρας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:486.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:486.1.text#εἴτ' ἐν μέσοισι συμμάχοις πάρεστί σοι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:487.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:487.1.text#πέλτην ἐρεῖσαι καὶ καταστῆσαι στρατόν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:488.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:488.1.text#μόνος μάχεσθαι πολεμίοις, Ἕκτορ, θέλω.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:489.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:489.1.text#εἰ δ' αἰσχρὸν ἡγῇ μὴ συνεμπρῆσαι νεῶν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:490.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:490.1.text#πρύμνας, πονήσας τὸν πάρος πολὺν χρόνον,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:491.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:491.1.text#τάξον μ' Ἀχιλλέως καὶ στρατοῦ κατὰ στόμα.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:492.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:492.1.text#οὐκ ἔστ' ἐκείνῳ θοῦρον ἐντάξαι δόρυ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:493.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:493.1.text#καὶ μὴν λόγος γ' ἦν ὡς ἔπλευσ' ἐπ' Ἴλιον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:494.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:494.1.text#ἔπλευσε καὶ πάρεστιν· ἀλλὰ μηνίων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:495.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:495.1.text#στρατηλάταισιν οὐ συναίρεται δόρυ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:496.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:496.1.text#τίς δὴ μετ' αὐτὸν ἄλλος εὐδοξεῖ στρατοῦ;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:497.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:497.1.text#Αἴας ἐμοὶ μὲν οὐδὲν ἡσσᾶσθαι δοκεῖ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:498.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:498.1.text#χὡ Τυδέως παῖς· ἔστι δ' αἱμυλώτατον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:499.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:499.1.text#κρότημ' Ὀδυσσεύς, λῆμά τ' ἀρκούντως θρασὺς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:500.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:500.1.text#καὶ πλεῖστα χώραν τήνδ' ἀνὴρ καθυβρίσας·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:501.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:501.1.text#ὃς εἰς Ἀθάνας σηκὸν ἔννυχος μολὼν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:502.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:502.1.text#κλέψας ἄγαλμα ναῦς ἐπ' Ἀργείων φέρει.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:503.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:503.1.text#ἤδη δ' ἀγύρτης πτωχικὴν ἔχων στολὴν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:504.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:504.1.text#ἐσῆλθε πύργους, πολλὰ δ' Ἀργείοις κακὰ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:505.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:505.1.text#ἠρᾶτο, πεμφθεὶς Ἰλίου κατάσκοπος·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:506.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:506.1.text#κτανὼν δὲ φρουροὺς καὶ παραστάτας πυλῶν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:507.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:507.1.text#ἐξῆλθεν· αἰεὶ δ' ἐν λόχοις εὑρίσκεται
urn:cts:greekLit:tlg0006.tlg019.fu.sp:508.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:508.1.text#Θυμβραῖον ἀμφὶ βωμὸν ἄστεως πέλας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:509.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:509.1.text#θάσσων· κακῷ δὲ μερμέρῳ παλαίομεν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:510.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:510.1.text#οὐδεὶς ἀνὴρ εὔψυχος ἀξιοῖ λάθρᾳ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:511.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:511.1.text#κτεῖναι τὸν ἐχθρόν, ἀλλ' ἰὼν κατὰ στόμα.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:512.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:512.1.text#τοῦτον δ' ὃν ἵζειν φὴς σὺ κλωπικὰς ἕδρας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:513.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:513.1.text#καὶ μηχανᾶσθαι, ζῶντα συλλαβὼν ἐγὼ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:514.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:514.1.text#πυλῶν ἐπ' ἐξόδοισιν ἀμπείρας ῥάχιν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:515.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:515.1.text#στήσω πετεινοῖς γυψὶ θοινατήριον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:516.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:516.1.text#λῃστὴν γὰρ ὄντα καὶ θεῶν ἀνάκτορα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:517.1.speaker#Ῥῆσος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:517.1.text#συλῶντα δεῖ νιν τῷδε κατθανεῖν μόρῳ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:518.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:518.1.text#νῦν μὲν καταυλίσθητε· καὶ γὰρ εὐφρόνη.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:519.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:519.1.text#δείξω δ' ἐγώ σοι χῶρον, ἔνθα χρὴ στρατὸν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:520.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:520.1.text#τὸν σὸν νυχεῦσαι τοῦ τεταγμένου δίχα.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:521.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:521.1.text#ξύνθημα δ' ἡμῖν Φοῖβος, ἤν τι καὶ δέῃ·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:522.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:522.1.text#μέμνησ' ἀκούσας, Θρῃκί τ' ἄγγειλον στρατῷ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:523.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:523.1.text#ὑμᾶς δὲ βάντας χρὴ προταινὶ τάξεων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:524.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:524.1.text#φρουρεῖν ἐγερτὶ καὶ νεῶν κατάσκοπον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:525.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:525.1.text#δέχθαι Δόλωνα· καὶ γάρ, εἴπερ ἐστὶ σῶς,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:526.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:526.1.text#ἤδη πελάζει στρατοπέδοισι Τρωικοῖς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:527.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:527.1.text#— τίνος ἁ φυλακά; τίς ἀμείβει
urn:cts:greekLit:tlg0006.tlg019.fu.sp:528.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:528.1.text#τὰν ἐμάν; πρῶτα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:529.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:529.1.text#δύεται σημεῖα καὶ ἑπτάποροι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:530.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:530.1.text#Πλειάδες αἰθέριαι· μέσα δ' αἰετὸς οὐρανοῦ ποτᾶται.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:532.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:532.1.text#— ἔγρεσθε, τί μέλλετε; κοιτᾶν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:533.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:533.1.text#ἔγρεσθε πρὸς φυλακάν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:534.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:534.1.text#οὐ λεύσσετε μηνάδος αἴγλαν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:535.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:535.1.text#— ἀὼς δὴ πέλας, ἀὼς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:536.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:536.1.text#γίγνεται, καί τις προδρόμων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:537.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:537.1.text#ὅδε γ' ἐστὶν ἀστήρ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:538.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:538.1.text#— τίς ἐκηρύχθη πρώτην φυλακήν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:539.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:539.1.text#— Μυγδόνος υἱόν φασι Κόροιβον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:540.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:540.1.text#— τίς γὰρ ἐπ' αὐτῷ; — Κίλικας Παίων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:541.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:541.1.text#στρατὸς ἤγειρεν, Μυσοὶ δ' ἡμᾶς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:543.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:543.1.text#— οὐκ οὖν Λυκίους πέμπτην φυλακὴν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:544.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:544.1.text#βάντας ἐγείρειν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:545.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:545.1.text#καιρὸς κλήρου κατὰ μοῖραν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:547.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:547.1.text#— καὶ μὴν ἀΐω· Σιμόεντος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:548.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:548.1.text#ἡμένα κοίτας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:549.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:549.1.text#φοινίας ὑμνεῖ πολυχορδοτάτᾳ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:550.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:550.1.text#γήρυϊ παιδολέτωρ μελοποιὸν ἀηδονὶς μέριμναν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:551.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:551.1.text#— ἤδη δὲ νέμουσι κατ' Ἴδαν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:552.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:552.1.text#ποίμνια· νυκτιβρόμου
urn:cts:greekLit:tlg0006.tlg019.fu.sp:553.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:553.1.text#σύριγγος ἰὰν κατακούω.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:554.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:554.1.text#— θέλγει δ' ὄμματος ἕδραν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:555.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:555.1.text#ὕπνος· ἅδιστος γὰρ ἔβα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:556.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:556.1.text#βλεφάροις πρὸς ἀοῦς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:557.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:557.1.text#— τί ποτ' οὐ πλάθει σκοπός, ὃν ναῶν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:558.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:558.1.text#Ἕκτωρ ὤτρυνε κατόπταν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:559.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:559.1.text#— ταρβῶ· χρόνιος γὰρ ἄπεστιν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:560.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:560.1.text#— ἀλλ' ἦ κρυπτὸν λόχον ἐσπαίσας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:561.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:561.1.text#διόλωλε; — τάχ' ἄν. φοβερόν μοι.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:562.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:562.1.text#— αὐδῶ Λυκίους πέμπτην φυλακὴν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:563.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:563.1.text#βάντας ἐγείρειν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:564.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:564.1.text#ἡμᾶς κλήρου κατὰ μοῖραν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:565.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:565.1.text#Διόμηδες, οὐκ ἤκουσας — ἢ κενὸς ψόφος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:566.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:566.1.text#στάζει δι' ὤτων; — τευχέων τινὰ κτύπον;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:567.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:567.1.text#οὔκ, ἀλλὰ δεσμὰ πωλικῶν ἐξ ἀντύγων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:568.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:568.1.text#κλάζει σιδήρου· κἀμέ τοι, πρὶν ᾐσθόμην
urn:cts:greekLit:tlg0006.tlg019.fu.sp:569.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:569.1.text#δεσμῶν ἀραγμὸν ἱππικῶν, ἔδυ φόβος.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:570.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:570.1.text#ὅρα κατ' ὄρφνην μὴ φύλαξιν ἐντύχῃς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:571.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:571.1.text#φυλάξομαί τοι κἀν σκότῳ τιθεὶς πόδα.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:572.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:572.1.text#ἢν δ' οὖν ἐγείρῃς, οἶσθα σύνθημα στρατοῦ;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:573.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:573.1.text#{ Φοῖβον } Δόλωνος οἶδα σύμβολον κλύων.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:574.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:574.1.text#ἔα·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:574.2.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:574.2.text#εὐνὰς ἐρήμους τάσδε πολεμίων ὁρῶ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:575.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:575.1.text#καὶ μὴν Δόλων γε τάσδ' ἔφραζεν Ἕκτορος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:576.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:576.1.text#κοίτας, ἐφ' ᾧπερ ἔγχος εἵλκυσται τόδε.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:577.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:577.1.text#τί δῆτ' ἂν εἴη; μῶν λόχος βέβηκέ ποι;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:578.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:578.1.text#ἴσως ἐφ' ἡμῖν μηχανὴν στήσων τινά.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:579.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:579.1.text#θρασὺς γὰρ Ἕκτωρ νῦν, ἐπεὶ κρατεῖ, θρασύς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:580.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:580.1.text#τί δῆτ', Ὀδυσσεῦ, δρῶμεν; οὐ γὰρ ηὕρομεν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:581.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:581.1.text#τὸν ἄνδρ' ἐν εὐναῖς, ἐλπίδων δ' ἡμάρτομεν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:582.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:582.1.text#στείχωμεν ὡς τάχιστα ναυστάθμων πέλας.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:583.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:583.1.text#σῴζει γὰρ αὐτὸν ὅστις εὐτυχῆ θεῶν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:584.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:584.1.text#τίθησιν· ἡμῖν δ' οὐ βιαστέον τύχην.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:585.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:585.1.text#οὐκ οὖν ἐπ' Αἰνέαν ἢ τὸν ἔχθιστον Φρυγῶν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:586.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:586.1.text#Πάριν μολόντε χρὴ καρατομεῖν ξίφει;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:587.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:587.1.text#πῶς οὖν ἐν ὄρφνῃ πολεμίων ἀνὰ στρατὸν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:588.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:588.1.text#ζητῶν δυνήσῃ τούσδ' ἀκινδύνως κτανεῖν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:589.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:589.1.text#αἰσχρόν γε μέντοι ναῦς ἐπ' Ἀργείων μολεῖν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:590.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:590.1.text#δράσαντε μηδὲν πολεμίους νεώτερον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:591.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:591.1.text#πῶς δ' οὐ δέδρακας; οὐ κτανόντε ναυστάθμων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:592.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:592.1.text#κατάσκοπον Δόλωνα σῴζομεν τάδε
urn:cts:greekLit:tlg0006.tlg019.fu.sp:593.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:593.1.text#σκυλεύματ'; ἢ πᾶν στρατόπεδον πέρσειν δοκεῖς;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:594.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:594.1.text#πείθεις, πάλιν στείχωμεν· εὖ δ' εἴη τυχεῖν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:595.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:595.1.text#ποῖ δὴ λιπόντες Τρωικῶν ἐκ τάξεων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:596.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:596.1.text#χωρεῖτε, λύπῃ καρδίαν δεδηγμένοι,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:597.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:597.1.text#εἰ μὴ κτανεῖν σφῷν Ἕκτορ' ἢ Πάριν θεὸς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:598.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:598.1.text#δίδωσιν; ἄνδρα δ' οὐ πέπυσθε σύμμαχον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:599.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:599.1.text#Τροίᾳ μολόντα Ῥῆσον οὐ φαύλῳ τρόπῳ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:600.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:600.1.text#ὃς εἰ διοίσει νύκτα τήνδ' ἐς αὔριον,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:601.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:601.1.text#οὔτε σφ' Ἀχιλλεὺς οὔτ' ἂν Αἴαντος δόρυ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:602.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:602.1.text#μὴ πάντα πέρσαι ναύσταθμ' Ἀργείων σχέθοι,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:603.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:603.1.text#τείχη κατασκάψαντα καὶ πυλῶν ἔσω
urn:cts:greekLit:tlg0006.tlg019.fu.sp:604.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:604.1.text#λόγχῃ πλατεῖαν ἐσδρομὴν ποιούμενον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:605.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:605.1.text#τοῦτον κατακτὰς πάντ' ἔχεις. τὰς δ' Ἕκτορος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:606.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:606.1.text#εὐνὰς ἔασον καὶ καρατόμους σφαγάς·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:607.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:607.1.text#ἔσται γὰρ αὐτῷ θάνατος ἐξ ἄλλης χερός.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:608.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:608.1.text#δέσποιν' Ἀθάνα, φθέγματος γὰρ ᾐσθόμην
urn:cts:greekLit:tlg0006.tlg019.fu.sp:609.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:609.1.text#τοῦ σοῦ συνήθη γῆρυν· ἐν πόνοισι γὰρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:610.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:610.1.text#παροῦσ' ἀμύνεις τοῖς ἐμοῖς ἀεί ποτε·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:611.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:611.1.text#τὸν ἄνδρα δ' ἡμῖν, ποῦ κατηύνασται, φράσον·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:612.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:612.1.text#πόθεν τέτακται βαρβάρου στρατεύματος;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:613.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:613.1.text#ὅδ' ἐγγὺς ἧσται κοὐ συνήθροισται στρατῷ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:614.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:614.1.text#ἀλλ' ἐκτὸς αὐτὸν τάξεων κατηύνασεν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:615.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:615.1.text#Ἕκτωρ, ἕως ἂν νὺξ ἀμείψηται φάος.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:616.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:616.1.text#πέλας δὲ πῶλοι Θρῃκίων ἐξ ἁρμάτων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:617.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:617.1.text#λευκαὶ δέδενται, διαπρεπεῖς ἐν εὐφρόνῃ·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:618.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:618.1.text#στίλβουσι δ' ὥστε ποταμίου κύκνου πτερόν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:619.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:619.1.text#ταύτας, κτανόντες δεσπότην, κομίζετε,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:620.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:620.1.text#κάλλιστον οἴκοις σκῦλον· οὐ γὰρ ἔσθ' ὅπου
urn:cts:greekLit:tlg0006.tlg019.fu.sp:621.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:621.1.text#τοιόνδ' ὄχημα χθὼν κέκευθε πωλικόν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:622.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:622.1.text#Διόμηδες, ἢ σὺ κτεῖνε Θρῄκιον λεών,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:623.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:623.1.text#ἢ 'μοὶ πάρες γε, σοὶ δὲ χρὴ πώλους μέλειν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:624.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:624.1.text#ἐγὼ φονεύσω, πωλοδαμνήσεις δὲ σύ·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:625.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:625.1.text#τρίβων γὰρ εἶ τὰ κομψὰ καὶ νοεῖν σοφός.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:626.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:626.1.text#χρὴ δ' ἄνδρα τάσσειν οὗ μάλιστ' ἂν ὠφελοῖ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:627.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:627.1.text#καὶ μὴν καθ' ἡμᾶς τόνδ' Ἀλέξανδρον βλέπω
urn:cts:greekLit:tlg0006.tlg019.fu.sp:628.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:628.1.text#στείχοντα, φυλάκων ἔκ τινος πεπυσμένον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:629.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:629.1.text#δόξας ἀσήμους πολεμίων μεμβλωκότων.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:630.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:630.1.text#πότερα σὺν ἄλλοις ἢ μόνος πορεύεται;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:631.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:631.1.text#μόνος· πρὸς εὐνὰς δ', ὡς ἔοικεν, Ἕκτορος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:632.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:632.1.text#χωρεῖ, κατόπτας σημανῶν ἥκειν στρατοῦ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:633.1.speaker#Διομήδης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:633.1.text#οὐκ οὖν ὑπάρχειν τόνδε κατθανόντα χρή;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:634.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:634.1.text#οὐκ ἂν δύναιο τοῦ πεπρωμένου πλέον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:635.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:635.1.text#τοῦτον δὲ πρὸς σῆς χειρὸς οὐ θέμις θανεῖν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:636.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:636.1.text#ἀλλ' ᾧπερ ἥκεις μορσίμους φέρων σφαγάς,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:637.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:637.1.text#τάχυν'· ἐγὼ δέ, τῷδε σύμμαχος Κύπρις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:638.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:638.1.text#δοκοῦσ' ἀρωγὸς ἐν πόνοις παραστατεῖν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:639.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:639.1.text#σαθροῖς λόγοισιν ἐχθρὸν ἄνδρ' ἀμείψομαι.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:640.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:640.1.text#καὶ ταῦτ' ἐγὼ μὲν εἶπον· ὃν δὲ χρὴ παθεῖν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:641.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:641.1.text#οὐκ οἶδεν οὐδ' ἤκουσεν ἐγγὺς ὢν λόγου.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:642.1.speaker#Ἀλέξανδρος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:642.1.text#σὲ τὸν στρατηγὸν καὶ κασίγνητον λέγω,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:643.1.speaker#Ἀλέξανδρος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:643.1.text#Ἕκτορ, καθεύδεις; οὐκ ἐγείρεσθαί σε χρῆν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:644.1.speaker#Ἀλέξανδρος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:644.1.text#ἐχθρῶν τις ἡμῖν χρίμπτεται στρατεύματι,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:645.1.speaker#Ἀλέξανδρος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:645.1.text#ἢ κλῶπες ἄνδρες ἢ κατάσκοποί τινες.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:646.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:646.1.text#θάρσει· φυλάσσει σ' ἥδε πρευμενὴς Κύπρις.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:647.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:647.1.text#μέλει δ' ὁ σός μοι πόλεμος, οὐδ' ἀμνημονῶ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:648.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:648.1.text#τιμῆς, ἐπαινῶ δ' εὖ παθοῦσα πρὸς σέθεν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:649.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:649.1.text#καὶ νῦν ἐπ' εὐτυχοῦντι Τρωικῷ στρατῷ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:650.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:650.1.text#ἥκω πορεύουσ' ἄνδρα σοι μέγαν φίλον,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:651.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:651.1.text#τῆς ὑμνοποιοῦ παῖδα Θρῄκιον θεᾶς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:652.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:652.1.text#Μούσης· πατρὸς δὲ Στρυμόνος κικλήσκεται.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:653.1.speaker#Ἀλέξανδρος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:653.1.text#αἰεί ποτ' εὖ φρονοῦσα τυγχάνεις πόλει
urn:cts:greekLit:tlg0006.tlg019.fu.sp:654.1.speaker#Ἀλέξανδρος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:654.1.text#κἀμοί, μέγιστον δ' ἐν βίῳ κειμήλιον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:655.1.speaker#Ἀλέξανδρος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:655.1.text#κρίνας σέ φημι τῇδε προσθέσθαι πόλει.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:656.1.speaker#Ἀλέξανδρος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:656.1.text#ἥκω δ' ἀκούσας οὐ τορῶς — φήμη δέ τις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:657.1.speaker#Ἀλέξανδρος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:657.1.text#φύλαξιν ἐμπέπτωκεν — ὡς κατάσκοποι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:658.1.speaker#Ἀλέξανδρος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:658.1.text#ἥκουσ' Ἀχαιῶν. χὣ μὲν οὐκ ἰδὼν λέγει,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:659.1.speaker#Ἀλέξανδρος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:659.1.text#ὃ δ' εἰσιδὼν μολόντας οὐκ ἔχει φράσαι·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:660.1.speaker#Ἀλέξανδρος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:660.1.text#ὧν οὕνεκ' εὐνὰς ἤλυθον πρὸς Ἕκτορος.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:661.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:661.1.text#μηδὲν φοβηθῇς· οὐδὲν ἐν στρατῷ νέον·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:662.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:662.1.text#Ἕκτωρ δὲ φροῦδος Θρῇκα κοιμήσων στρατόν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:663.1.speaker#Ἀλέξανδρος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:663.1.text#σύ τοί με πείθεις, σοῖς δὲ πιστεύων λόγοις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:664.1.speaker#Ἀλέξανδρος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:664.1.text#τάξιν φυλάξων εἶμ' ἐλεύθερος φόβου.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:665.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:665.1.text#χώρει· μέλειν γὰρ πάντ' ἐμοὶ δόκει τὰ σά,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:666.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:666.1.text#ὥστ' εὐτυχοῦντας συμμάχους ἐμοὺς ὁρᾶν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:667.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:667.1.text#γνώσῃ δὲ καὶ σὺ τὴν ἐμὴν προθυμίαν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:668.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:668.1.text#ὑμᾶς δ' ἀυτῶ τοὺς ἄγαν ἐρρωμένους,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:669.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:669.1.text#Λαερτίου παῖ, θηκτὰ κοιμίσαι ξίφη.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:670.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:670.1.text#κεῖται γὰρ ἡμῖν Θρῄκιος στρατηλάτης,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:671.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:671.1.text#ἵπποι τ' ἔχονται, πολέμιοι δ' ᾐσθημένοι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:672.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:672.1.text#χωροῦσ' ἐφ' ὑμᾶς· ἀλλ' ὅσον τάχιστα χρὴ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:673.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:673.1.text#φεύγειν πρὸς ὁλκοὺς ναυστάθμων. τί μέλλετε
urn:cts:greekLit:tlg0006.tlg019.fu.sp:674.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:674.1.text#σκηπτοῦ 'πιόντος πολεμίων σῷσαι βίον;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:675.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:675.1.text#— ἔα ἔα·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:676.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:676.1.text#βάλε βάλε βάλε βάλε.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:677.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:677.1.text#θένε θένε.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:678.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:678.1.text#— τίς ἁνήρ; λεύσσετε· τοῦτον αὐδῶ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:679.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:679.1.text#— κλῶπες οἵτινες κατ' ὄρφνην τόνδε κινοῦσι στρατόν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:680.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:680.1.text#— δεῦρο δεῦρο πᾶς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:681.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:681.1.text#— τούσδ' ἔχω, τούσδ' ἔμαρψα.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:682.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:682.1.text#— τίς ὁ λόχος; πόθεν ἔβας; ποδαπὸς εἶ;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:683.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:683.1.text#οὔ σε χρὴ εἰδέναι· θανῇ γὰρ σήμερον δράσας κακῶς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:684.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:684.1.text#οὐκ ἐρεῖς ξύνθημα, λόγχην πρὶν διὰ στέρνων μολεῖν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:685.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:685.1.text#ἵστω. θάρσει.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:685.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:685.2.text#πέλας ἴθι. παῖε πᾶς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:686.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:686.1.text#ἦ σὺ δὴ Ῥῆσον κατέκτας;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:686.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:686.2.text#ἀλλὰ τὸν κτενοῦντα σὲ [ … ]
urn:cts:greekLit:tlg0006.tlg019.fu.sp:687.1.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:687.1.text#ἴσχε πᾶς τις.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:687.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:687.2.text#οὐ μὲν οὖν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:687.3.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:687.3.text#ἆ· φίλιον ἄνδρα μὴ θένῃς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:688.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:688.1.text#καὶ τί δὴ τὸ σῆμα;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:688.2.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:688.2.text#Φοῖβος.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:688.3.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:688.3.text#ἔμαθον· ἴσχε πᾶς δόρυ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:689.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:689.1.text#οἶσθ' ὅποι βεβᾶσιν ἅνδρες;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:689.2.speaker#Ὀδυσσεύς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:689.2.text#τῇδέ πῃ κατείδομεν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:690.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:690.1.text#ἕρπω πᾶς κατ' ἴχνος αὐτῶν. ἢ βοὴν ἐγερτέον;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:691.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:691.1.text#ἀλλὰ συμμάχους ταράσσειν δεινὸν ἐκ νυκτῶν φόβῳ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:692.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:692.1.text#—τίς ἀνδρῶν ὁ βάς;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:693.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:693.1.text#τίς ὁ μέγα θρασὺς ἐπεύξεται
urn:cts:greekLit:tlg0006.tlg019.fu.sp:694.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:694.1.text#χέρα φυγὼν ἐμάν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:695.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:695.1.text#πόθεν νιν κυρήσω;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:696.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:696.1.text#τίνι προσεικάσω,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:697.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:697.1.text#ὅστις δι' ὄρφνης ἦλθ' ἀδειμάντῳ ποδὶ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:698.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:698.1.text#διά τε τάξεων καὶ φυλάκων ἕδρας;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:699.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:699.1.text#Θεσσαλὸς ἢ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:700.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:700.1.text#παραλίαν Λοκρῶν νεμόμενος πόλιν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:701.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:701.1.text#ἢ νησιώτην σποράδα κέκτηται βίον;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:702.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:702.1.text#τίς ἦν; πόθεν; ποίας πάτρας;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:703.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:703.1.text#ποῖον δ' εὔχεται τὸν ὕπατον θεῶν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:704.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:704.1.text#— ἆρ' ἔστ' Ὀδυσσέως τοὔργον ἢ τίνος τόδε;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:705.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:705.1.text#εἰ τοῖς πάροιθε χρὴ τεκμαίρεσθαι· τί μήν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:706.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:706.1.text#— δοκεῖς γάρ; — τί μὴν οὔ;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:707.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:707.1.text#— θρασὺς γοῦν ἐς ἡμᾶς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:708.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:708.1.text#— τίν' ἀλκήν; τίν' αἰνεῖς; — Ὀδυσσῆ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:709.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:709.1.text#— μὴ κλωπὸς αἴνει φωτὸς αἱμύλον δόρυ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:710.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:710.1.text#ἔβα καὶ πάρος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:711.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:711.1.text#κατὰ πόλιν, ὕπαφρον ὄμμ' ἔχων,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:712.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:712.1.text#ῥακοδύτῳ στολᾷ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:713.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:713.1.text#πυκασθείς, ξιφήρης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:714.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:714.1.text#κρύφιος ἐν πέπλοις.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:715.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:715.1.text#βίον δ' ἐπαιτῶν εἷρπ' ἀγύρτης τις λάτρις,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:716.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:716.1.text#ψαφαρόχρουν κάρα πολυπινές τ' ἔχων·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:717.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:717.1.text#πολλὰ δὲ τὰν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:718.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:718.1.text#βασιλίδ' ἑστίαν Ἀτρειδᾶν κακῶς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:719.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:719.1.text#ἔβαζε δῆθεν ἐχθρὸς ὢν στρατηλάταις.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:720.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:720.1.text#ὄλοιτ' ὄλοιτο πανδίκως,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:721.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:721.1.text#πρὶν ἐπὶ γᾶν Φρυγῶν ποδὸς ἴχνος βαλεῖν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:722.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:722.1.text#— εἴτ' οὖν Ὀδυσσέως εἴτε μή, φόβος μ' ἔχει·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:723.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:723.1.text#Ἕκτωρ γὰρ ἡμῖν τοῖς φύλαξι μέμψεται.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:724.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:724.1.text#— τί λάσκων; — δυσοίζων.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:725.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:725.1.text#— τί δρᾶσαι; τί ταρβεῖς;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:726.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:726.1.text#— καθ' ἡμᾶς περᾶσαι [ … ] — τίν' ἀνδρῶν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:727.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:727.1.text#— οἳ τῆσδε νυκτὸς ἦλθον ἐς Φρυγῶν στρατόν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:728.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:728.1.text#ἰὼ, ἰώ, δαίμονος τύχα βαρεῖα. φεῦ φεῦ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:729.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:729.1.text#ἔα, ἔα·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:730.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:730.1.text#σῖγα πᾶς ὕφιζ'· ἴσως γὰρ ἐς βόλον τις ἔρχεται.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:731.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:731.1.text#ἰὼ ἰώ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:732.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:732.1.text#συμφορὰ βαρεῖα Θρῃκῶν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:732.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:732.2.text#συμμάχων τις ὁ στένων.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:733.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:733.1.text#ἰὼ ἰώ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:733.2.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:733.2.text#δύστηνος ἐγώ· σύ τ', ἄναξ Θρῃκῶν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:734.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:734.1.text#ὦ στυγνοτάτην Τροίαν ἐσιδών,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:735.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:735.1.text#οἷόν σε βίου τέλος εἷλεν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:736.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:736.1.text#τίς εἶ ποτ' ἀνδρῶν συμμάχων; κατ' εὐφρόνην
urn:cts:greekLit:tlg0006.tlg019.fu.sp:737.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:737.1.text#ἀμβλῶπες αὐγαὶ κοὔ σε γιγνώσκω τορῶς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:738.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:738.1.text#ποῦ τιν' ἀνάκτων Τρωικῶν εὕρω;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:739.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:739.1.text#ποῦ δῆθ' Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:740.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:740.1.text#τὸν ὑπασπίδιον κοῖτον ἰαύει;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:741.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:741.1.text#τίνι σημήνω διόπων στρατιᾶς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:742.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:742.1.text#οἷα πεπόνθαμεν, οἷά τις ἡμᾶς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:743.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:743.1.text#δράσας ἀφανῆ φροῦδος, φανερὸν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:744.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:744.1.text#Θρῃξὶν πένθος τολυπεύσας;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:745.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:745.1.text#κακὸν κυρεῖν τι Θρῃκίῳ στρατεύματι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:746.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:746.1.text#ἔοικεν, οἷα τοῦδε γιγνώσκω κλύων.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:747.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:747.1.text#ἔρρει στρατιά, πέπτωκεν ἄναξ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:748.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:748.1.text#δολίῳ πληγῇ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:749.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:749.1.text#ἆ ἆ ἆ ἆ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:750.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:750.1.text#οἵα μ' ὀδύνη τείρει φονίου
urn:cts:greekLit:tlg0006.tlg019.fu.sp:751.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:751.1.text#τραύματος εἴσω. πῶς ἂν ὀλοίμην;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:752.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:752.1.text#χρῆν γάρ μ' ἀκλεῶς Ῥῆσόν τε θανεῖν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:753.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:753.1.text#Τροίᾳ κέλσαντ' ἐπίκουρον;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:754.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:754.1.text#τάδ' οὐκ ἐν αἰνιγμοῖσι σημαίνει κακά·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:755.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:755.1.text#σαφῶς γὰρ αὐδᾷ συμμάχους ὀλωλότας.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:756.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:756.1.text#κακῶς πέπρακται κἀπὶ τοῖς κακοῖσι πρὸς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:757.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:757.1.text#αἴσχιστα· καίτοι δὶς τόσον κακὸν τόδε·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:758.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:758.1.text#θανεῖν γὰρ εὐκλεῶς μέν, εἰ θανεῖν χρεών,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:759.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:759.1.text#λυπρὸν μὲν οἶμαι τῷ θανόντι — πῶς γὰρ οὔ; —
urn:cts:greekLit:tlg0006.tlg019.fu.sp:760.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:760.1.text#τοῖς ζῶσι δ' ὄγκος καὶ δόμων εὐδοξία.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:761.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:761.1.text#ἡμεῖς δ' ἀβούλως κἀκλεῶς ὀλώλαμεν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:762.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:762.1.text#ἐπεὶ γὰρ ἡμᾶς ηὔνασ' Ἑκτόρεια χείρ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:763.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:763.1.text#ξύνθημα λέξας, ηὕδομεν πεδοστιβεῖ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:764.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:764.1.text#κόπῳ δαμέντες, οὐδ' ἐφρουρεῖτο στρατὸς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:765.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:765.1.text#φυλακαῖσι νυκτέροισιν, οὐδ' ἐν τάξεσιν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:766.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:766.1.text#ἔκειτο τεύχη, πλῆκτρά τ' οὐκ ἐπὶ ζυγοῖς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:767.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:767.1.text#ἵππων καθήρμοσθ', ὡς ἄναξ ἐπεύθετο
urn:cts:greekLit:tlg0006.tlg019.fu.sp:768.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:768.1.text#κρατοῦντας ὑμᾶς κἀφεδρεύοντας νεῶν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:769.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:769.1.text#πρύμναισι· φαύλως δ' ηὕδομεν πεπτωκότες.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:770.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:770.1.text#κἀγὼ μελούσῃ καρδίᾳ λήξας ὕπνου
urn:cts:greekLit:tlg0006.tlg019.fu.sp:771.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:771.1.text#πώλοισι χόρτον, προσδοκῶν ἑωθινὴν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:772.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:772.1.text#ζεύξειν ἐς ἀλκήν, ἀφθόνῳ μετρῶ χερί.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:773.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:773.1.text#λεύσσω δὲ φῶτε περιπολοῦνθ' ἡμῶν στρατὸν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:774.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:774.1.text#πυκνῆς δι' ὄρφνης· ὡς δ' ἐκινήθην ἐγώ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:775.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:775.1.text#ἐπτηξάτην τε κἀνεχωρείτην πάλιν·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:776.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:776.1.text#ἤπυσα δ' αὐτοῖς μὴ πελάζεσθαι στρατῷ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:777.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:777.1.text#κλῶπας δοκήσας συμμάχων πλάθειν τινάς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:778.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:778.1.text#οἳ δ' οὐδέν· οὐ μὴν οὐδ' ἐγὼ τὰ πλείονα.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:779.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:779.1.text#ηὗδον δ' ἀπελθὼν αὖθις ἐς κοίτην πάλιν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:780.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:780.1.text#καί μοι καθ' ὕπνον δόξα τις παρίσταται·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:781.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:781.1.text#ἵππους γὰρ ἃς ἔθρεψα κἀδιφρηλάτουν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:782.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:782.1.text#Ῥήσῳ παρεστώς, εἶδον, ὡς ὄναρ δοκῶν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:783.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:783.1.text#λύκους ἐπεμβεβῶτας ἑδραίαν ῥάχιν·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:784.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:784.1.text#θείνοντε δ' οὐρᾷ πωλικῆς ῥινοῦ τρίχα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:785.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:785.1.text#ἤλαυνον, αἳ δ' ἔρρεγκον ἐξ ἀντηρίδων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:786.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:786.1.text#θυμὸν πνέουσαι κἀνεχαίτιζον φόβῳ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:787.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:787.1.text#ἐγὼ δ' ἀμύνων θῆρας ἐξεγείρομαι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:788.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:788.1.text#πώλοισιν· ἔννυχος γὰρ ἐξώρμα φόβος.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:789.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:789.1.text#κλύω δ' ἐπάρας κρᾶτα μυχθισμὸν νεκρῶν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:790.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:790.1.text#θερμὸς δὲ κρουνὸς δεσπότου πάρα σφαγαῖς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:791.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:791.1.text#βάλλει με δυσθνῄσκοντος αἵματος νέου.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:792.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:792.1.text#ὀρθὸς δ' ἀνᾴσσω χειρὶ σὺν κενῇ δορός.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:793.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:793.1.text#καί μ' ἔγχος αὐγάζοντα καὶ θηρώμενον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:794.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:794.1.text#παίει παραστὰς νεῖραν ἐς πλευρὰν ξίφει
urn:cts:greekLit:tlg0006.tlg019.fu.sp:795.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:795.1.text#ἀνὴρ ἀκμάζων· φασγάνου γὰρ ᾐσθόμην
urn:cts:greekLit:tlg0006.tlg019.fu.sp:796.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:796.1.text#πληγῆς, βαθεῖαν ἄλοκα τραύματος λαβών.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:797.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:797.1.text#πίπτω δὲ πρηνής· οἳ δ' ὄχημα πωλικὸν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:798.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:798.1.text#λαβόντες ἵππων ἵεσαν φυγῇ πόδα.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:798.2.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:798.2.text#ἆ ἆ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:799.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:799.1.text#ὀδύνη με τείρει, κοὐκέτ' ὀρθοῦμαι τάλας.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:800.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:800.1.text#καὶ ξυμφορὰν μὲν οἶδ' ὁρῶν, τρόπῳ δ' ὅτῳ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:801.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:801.1.text#τεθνᾶσιν οἱ θανόντες οὐκ ἔχω φράσαι,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:802.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:802.1.text#οὐδ' ἐξ ὁποίας χειρός. εἰκάσαι δέ μοι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:803.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:803.1.text#πάρεστι λυπρὰ πρὸς φίλων πεπονθέναι.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:804.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:804.1.text#ἡνίοχε Θρῃκὸς τοῦ κακῶς πεπραγότος,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:805.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:805.1.text#μηδὲν δυσοίζου· πολέμιοι ῎δρασαν τάδε.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:806.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:806.1.text#Ἕκτωρ δὲ καὐτὸς συμφορᾶς πεπυσμένος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:807.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:807.1.text#χωρεῖ· συναλγεῖ δ', ὡς ἔοικε, σοῖς κακοῖς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:808.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:808.1.text#πῶς, ὦ μέγιστα πήματ' ἐξειργασμένοι,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:809.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:809.1.text#μολόντες ὑμᾶς πολεμίων κατάσκοποι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:810.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:810.1.text#λήθουσιν αἰσχρῶς, καὶ κατεσφάγη στρατός,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:811.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:811.1.text#κοὔτ' εἰσιόντας στρατόπεδ' ἐξαπώσατε
urn:cts:greekLit:tlg0006.tlg019.fu.sp:812.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:812.1.text#οὔτ' ἐξιόντας; τῶνδε τίς τείσει δίκην
urn:cts:greekLit:tlg0006.tlg019.fu.sp:813.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:813.1.text#πλὴν σοῦ; σὲ γὰρ δὴ φύλακά φημ' εἶναι στρατοῦ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:814.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:814.1.text#φροῦδοι δ' ἄπληκτοι, τῇ Φρυγῶν κακανδρίᾳ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:815.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:815.1.text#πόλλ' ἐγγελῶντες τῷ στρατηλάτῃ τ' ἐμοί.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:816.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:816.1.text#εὖ νυν τόδ' ἴστε — Ζεὺς ὀμώμοται πατήρ —
urn:cts:greekLit:tlg0006.tlg019.fu.sp:817.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:817.1.text#ἤτοι μάραγνά γ' ἢ καρανιστὴς μόρος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:818.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:818.1.text#μένει σε δρῶντα τοιάδ', ἢ τὸν Ἕκτορα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:819.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:819.1.text#τὸ μηδὲν εἶναι καὶ κακὸν νομίζετε.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:820.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:820.1.text#ἰὼ ἰώ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:821.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:821.1.text#μετὰ σέ, ναί, μετὰ σέ, ὦ πολίοχον κράτος,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:822.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:822.1.text#τότ' ἄρ' ἔμολον, ὅτε σοι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:824.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:824.1.text#ἄγγελος ἦλθον ἀμφὶ ναῦς πύρ' αἴθειν·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:825.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:825.1.text#ἐπεὶ ἄγρυπνον ὄμμ' ἐν εὐφρόνῃ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:826.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:826.1.text#οὔτ' ἐκοίμισ' οὔτ' ἔβριξ',
urn:cts:greekLit:tlg0006.tlg019.fu.sp:827.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:827.1.text#οὐ τὰς Σιμοεντιάδας πηγάς· μή μοι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:828.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:828.1.text#κότον, ὦ ἄνα, θῇς· ἀναίτιος γὰρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:829.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:829.1.text#[ … ] ἔγωγε πάντων.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:830.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:830.1.text#εἰ δὲ χρόνῳ παράκαιρον ἔργον ἢ λόγον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:831.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:831.1.text#πύθῃ, κατά με γᾶς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:832.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:832.1.text#ζῶντα πόρευσον· οὐ παραιτοῦμαι.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:833.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:833.1.text#τί τοῖσδ' ἀπειλεῖς βάρβαρός τε βαρβάρου
urn:cts:greekLit:tlg0006.tlg019.fu.sp:834.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:834.1.text#γνώμην ὑφαιρῇ τὴν ἐμήν, πλέκων λόγους;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:835.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:835.1.text#σὺ ταῦτ' ἔδρασας· οὐδέν' ἂν δεξαίμεθα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:836.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:836.1.text#οὔθ' οἱ θανόντες οὔτ' ἂν οἱ τετρωμένοι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:837.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:837.1.text#ἄλλον· μακροῦ γε δεῖ σε καὶ σοφοῦ λόγου,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:838.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:838.1.text#ὅτῳ με πείσεις μὴ φίλους κατακτανεῖν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:839.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:839.1.text#ἵππων ἐρασθείς, ὧν ἕκατι συμμάχους
urn:cts:greekLit:tlg0006.tlg019.fu.sp:840.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:840.1.text#τοὺς σοὺς φονεύεις, πόλλ' ἐπισκήπτων μολεῖν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:841.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:841.1.text#ἦλθον, τεθνᾶσιν· εὐπρεπέστερον Πάρις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:842.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:842.1.text#ξενίαν κατῄσχυν' ἢ σὺ συμμάχους κτανών.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:843.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:843.1.text#μὴ γάρ τι λέξῃς ὥς τις Ἀργείων μολὼν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:844.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:844.1.text#διώλεσ' ἡμᾶς· τίς δ' ὑπερβαλὼν λόχους
urn:cts:greekLit:tlg0006.tlg019.fu.sp:845.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:845.1.text#Τρώων ἐφ' ἡμᾶς ἦλθεν, ὥστε καὶ λαθεῖν;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:846.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:846.1.text#σὺ πρόσθεν ἡμῶν ἧσο καὶ Φρυγῶν στρατός.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:847.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:847.1.text#τίς οὖν τέτρωται, τίς τέθνηκε συμμάχων
urn:cts:greekLit:tlg0006.tlg019.fu.sp:848.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:848.1.text#τῶν σῶν, μολόντων ὧν σὺ πολεμίων λέγεις;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:849.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:849.1.text#ἡμεῖς δ' ἑκὰς τετρώμεθ', οἳ δὲ μειζόνως
urn:cts:greekLit:tlg0006.tlg019.fu.sp:850.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:850.1.text#παθόντες οὐχ ὁρῶσιν ἡλίου φάος.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:851.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:851.1.text#ἁπλῶς δ' Ἀχαιῶν οὐδέν' αἰτιώμεθα.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:852.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:852.1.text#τίς δ' ἂν χαμεύνας πολεμίων κατ' εὐφρόνην
urn:cts:greekLit:tlg0006.tlg019.fu.sp:853.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:853.1.text#Ῥήσου μολὼν ἐξηῦρεν, εἰ μή τις θεῶν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:854.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:854.1.text#ἔφραζε τοῖς κτανοῦσιν; οὐδ' ἀφιγμένον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:855.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:855.1.text#τὸ πάμπαν ᾖσαν· ἀλλὰ μηχανᾷ τάδε.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:856.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:856.1.text#χρόνον μὲν ἤδη συμμάχοισι χρώμεθα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:857.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:857.1.text#ὅσονπερ ἐν γῇ τῇδ' Ἀχαιικὸς λεώς,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:858.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:858.1.text#κοὐδὲν πρὸς αὐτῶν οἶδα πλημμελὲς κλύων·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:859.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:859.1.text#ἐν σοὶ δ' ἂν ἀρχοίμεσθα. μή μ' ἔρως ἕλοι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:860.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:860.1.text#τοιοῦτος ἵππων ὥστ' ἀποκτείνειν φίλους.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:861.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:861.1.text#καὶ ταῦτ' Ὀδυσσεύς· τίς γὰρ ἄλλος ἄν ποτε
urn:cts:greekLit:tlg0006.tlg019.fu.sp:862.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:862.1.text#ἔδρασεν ἢ 'βούλευσεν Ἀργείων ἀνήρ;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:863.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:863.1.text#δέδοικα δ' αὐτὸν καί τί μου θράσσει φρένας,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:864.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:864.1.text#μὴ καὶ Δόλωνα συντυχὼν κατακτάνῃ·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:865.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:865.1.text#χρόνον γὰρ ἤδη φροῦδος ὢν οὐ φαίνεται.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:866.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:866.1.text#οὐκ οἶδα τοὺς σοὺς οὓς λέγεις Ὀδυσσέας·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:867.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:867.1.text#ἡμεῖς δ' ὑπ' ἐχθρῶν οὐδενὸς πεπλήγμεθα.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:868.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:868.1.text#σὺ δ' οὖν νόμιζε ταῦτ', ἐπείπερ σοι δοκεῖ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:869.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:869.1.text#ὦ γαῖα πατρίς, πῶς ἂν ἐνθάνοιμί σοι;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:870.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:870.1.text#μὴ θνῇσχ'· ἅλις γὰρ τῶν τεθνηκότων ὄχλος.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:871.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:871.1.text#ποῖ δὴ τράπωμαι δεσποτῶν μονούμενος;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:872.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:872.1.text#οἶκός σε κεύθων οὑμὸς ἐξιάσεται.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:873.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:873.1.text#καὶ πῶς με κηδεύσουσιν αὐθεντῶν χέρες;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:874.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:874.1.text#ὅδ' αὖ τὸν αὐτὸν μῦθον οὐ λήξει λέγων.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:875.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:875.1.text#ὄλοιθ' ὁ δράσας. οὐ γὰρ ἐς σὲ τείνεται
urn:cts:greekLit:tlg0006.tlg019.fu.sp:876.1.speaker#Ἡνίοχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:876.1.text#γλῶσσ', ὡς σὺ κομπεῖς· ἡ Δίκη δ' ἐπίσταται.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:877.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:877.1.text#λάζυσθ'· ἄγοντες { δ' } αὐτὸν ἐς δόμους ἐμούς,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:878.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:878.1.text#οὕτως ὅπως ἂν μὴ 'γκαλῇ πορσύνετε·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:879.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:879.1.text#ὑμᾶς δ' ἰόντας τοῖσιν ἐν τείχει χρεὼν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:880.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:880.1.text#Πριάμῳ τε καὶ γέρουσι σημῆναι νεκροὺς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:881.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:881.1.text#θάπτειν κελεύθου λεωφόρου πρὸς ἐκτροπάς.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:882.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:882.1.text#τί ποτ' εὐτυχίας ἐκ τῆς μεγάλης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:883.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:883.1.text#Τροίαν ἀνάγει πάλιν ἐς πένθη
urn:cts:greekLit:tlg0006.tlg019.fu.sp:884.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:884.1.text#δαίμων ἄλλος, τί φυτεύων;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:885.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:885.1.text#ἔα ἔα. [ ὦ ὦ. ]
urn:cts:greekLit:tlg0006.tlg019.fu.sp:886.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:886.1.text#τίς ὑπὲρ κεφαλῆς θεός, ὦ βασιλεῦ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:887.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:887.1.text#τὸν νεόκμητον νεκρὸν ἐν χειροῖν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:888.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:888.1.text#φοράδην πέμπει;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:889.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:889.1.text#ταρβῶ, λεύσσων τόδε, πῆμα.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:890.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:890.1.text#ὁρᾶν πάρεστι, Τρῶες· ἡ γὰρ ἐν σοφοῖς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:891.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:891.1.text#τιμὰς ἔχουσα Μοῦσα συγγόνων μία
urn:cts:greekLit:tlg0006.tlg019.fu.sp:892.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:892.1.text#πάρειμι, παῖδα τόνδ' ὁρῶσ' οἰκτρῶς φίλον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:893.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:893.1.text#θανόνθ' ὑπ' ἐχθρῶν· ὅν ποθ' ὁ κτείνας χρόνῳ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:894.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:894.1.text#δόλιος Ὀδυσσεὺς ἀξίαν τείσει δίκην.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:895.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:895.1.text#ἰαλέμῳ αὐθιγενεῖ,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:896.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:896.1.text#τέκνον, σ' ὀλοφύρομαι, ὦ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:897.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:897.1.text#ματρὸς ἄλγος, οἵαν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:898.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:898.1.text#ἔκελσας ὁδὸν ποτὶ Τροίαν·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:899.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:899.1.text#ἦ δυσδαίμονα καὶ μελέαν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:900.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:900.1.text#ἀπομεμφομένας ἐμοῦ πορευθείς,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:901.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:901.1.text#ἀπὸ δ' ἀντομένου πατρὸς βιαίως.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:902.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:902.1.text#ὤμοι ἐγὼ σέθεν, ὦ φιλία
urn:cts:greekLit:tlg0006.tlg019.fu.sp:903.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:903.1.text#φιλία κεφαλά, τέκνον, ὤμοι.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:904.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:904.1.text#ὅσον προσήκει μὴ γένους κοινωνίαν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:905.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:905.1.text#ἔχοντι λύπῃ τὸν σὸν οἰκτίρω γόνον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:906.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:906.1.text#ὄλοιτο μὲν Οἰνεΐδας,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:907.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:907.1.text#ὄλοιτο δὲ Λαρτιάδας,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:908.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:908.1.text#ὅς μ' ἄπαιδα γέννας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:909.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:909.1.text#ἔθηκεν ἀριστοτόκοιο·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:910.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:910.1.text#ἅ θ' Ἕλλανα λιποῦσα δόμον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:911.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:911.1.text#Φρυγίων λεχέων ἔπλευσε πλαθεῖσ'
urn:cts:greekLit:tlg0006.tlg019.fu.sp:912.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:912.1.text#{ ὑπ' Ἰλίῳ } ὤλεσε μὲν σ' ἕκατι Τροίας,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:913.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:913.1.text#φίλτατε, μυριάδας τε πόλεις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:914.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:914.1.text#ἀνδρῶν ἀγαθῶν ἐκένωσεν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:915.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:915.1.text#ἦ πολλὰ μὲν ζῶν, πολλὰ δ' εἰς Ἅιδου μολών,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:916.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:916.1.text#Φιλάμμονος παῖ, τῆς ἐμῆς ἥψω φρενός·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:917.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:917.1.text#ὕβρις γάρ, ἥ σ' ἔσφηλε, καὶ Μουσῶν ἔρις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:918.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:918.1.text#τεκεῖν μ' ἔθηκε τόνδε δύστηνον γόνον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:919.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:919.1.text#περῶσα γὰρ δὴ ποταμίους διὰ ῥοὰς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:920.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:920.1.text#λέκτροις ἐπλάθην Στρυμόνος φυταλμίοις,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:921.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:921.1.text#ὅτ' ἤλθομεν γῆς χρυσόβωλον ἐς λέπας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:922.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:922.1.text#Πάγγαιον ὀργάνοισιν ἐξησκημέναι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:923.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:923.1.text#Μοῦσαι μεγίστην εἰς ἔριν μελῳδίας
urn:cts:greekLit:tlg0006.tlg019.fu.sp:924.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:924.1.text#κείνῳ σοφιστῇ Θρῃκί, κἀκτυφλώσαμεν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:925.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:925.1.text#Θάμυριν, ὃς ἡμῶν πόλλ' ἐδέννασεν τέχνην.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:926.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:926.1.text#κἀπεὶ σὲ τίκτω, συγγόνους αἰδουμένη
urn:cts:greekLit:tlg0006.tlg019.fu.sp:927.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:927.1.text#καὶ παρθενείαν, ἧκ' ἐς εὐύδρου πατρὸς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:928.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:928.1.text#δίνας· τρέφειν δέ σ' οὐ βρότειον ἐς χέρα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:929.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:929.1.text#Στρυμὼν δίδωσιν, ἀλλὰ πηγαίαις κόραις.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:930.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:930.1.text#ἔνθ' ἐκτραφεὶς κάλλιστα Παρθένων ὕπο,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:931.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:931.1.text#Θρῄκης ἀνάσσων πρῶτος ἦσθ' ἀνδρῶν, τέκνον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:932.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:932.1.text#καί σ' ἀμφὶ γῆν μὲν πατρίαν φιλαιμάτους
urn:cts:greekLit:tlg0006.tlg019.fu.sp:933.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:933.1.text#ἀλκὰς κορύσσοντ' οὐκ ἐδείμαινον θανεῖν·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:934.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:934.1.text#Τροίας δ' ἀπηύδων ἄστυ μὴ κέλσαι ποτε,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:935.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:935.1.text#εἰδυῖα τὸν σὸν πότμον· ἀλλά σ' Ἕκτορος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:936.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:936.1.text#πρεσβεύμαθ' αἵ τε μυρίαι γερουσίαι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:937.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:937.1.text#ἔπεισαν ἐλθεῖν κἀπικουρῆσαι φίλοις.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:938.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:938.1.text#καὶ τοῦδ', Ἀθάνα, παντὸς αἰτία μόρου,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:939.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:939.1.text#— οὐδὲν δ' Ὀδυσσεὺς οὐδ' ὁ Τυδέως τόκος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:940.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:940.1.text#ἔδρασε δράσας — μὴ δόκει λεληθέναι.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:941.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:941.1.text#καίτοι πόλιν σὴν σύγγονοι πρεσβεύομεν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:942.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:942.1.text#Μοῦσαι μάλιστα κἀπιχρώμεθα χθονί,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:943.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:943.1.text#μυστηρίων τε τῶν ἀπορρήτων φανὰς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:944.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:944.1.text#ἔδειξεν Ὀρφεύς, αὐτανέψιος νεκροῦ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:945.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:945.1.text#τοῦδ' ὃν κατακτείνεις σύ· Μουσαῖόν τε, σὸν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:946.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:946.1.text#σεμνὸν πολίτην κἀπὶ πλεῖστον ἄνδρ' ἕνα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:947.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:947.1.text#ἐλθόντα, Φοῖβος σύγγονοί τ' ἠσκήσαμεν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:948.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:948.1.text#καὶ τῶνδε μισθὸν παῖδ' ἔχουσ' ἐν ἀγκάλαις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:949.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:949.1.text#θρηνῶ· σοφιστὴν δ' ἄλλον οὐκ ἐπάξομαι.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:950.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:950.1.text#μάτην ἄρ' ἡμᾶς Θρῄκιος τροχηλάτης
urn:cts:greekLit:tlg0006.tlg019.fu.sp:951.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:951.1.text#ἐδέννασ', Ἕκτορ, τῷδε βουλεῦσαι φόνον.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:952.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:952.1.text#ᾔδη τάδ'· οὐδὲν μάντεων ἔδει φράσαι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:953.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:953.1.text#Ὀδυσσέως τέχναισι τόνδ' ὀλωλότα.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:954.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:954.1.text#ἐγὼ δὲ γῆς ἔφεδρον Ἑλλήνων στρατὸν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:955.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:955.1.text#λεύσσων, τί μὴν ἔμελλον οὐ πέμψειν φίλοις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:956.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:956.1.text#κήρυκας, ἐλθεῖν κἀπικουρῆσαι χθονί;
urn:cts:greekLit:tlg0006.tlg019.fu.sp:957.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:957.1.text#ἔπεμψ'· ὀφείλων δ' ἦλθε συμπονεῖν ἐμοί.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:958.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:958.1.text#οὐ μὴν θανόντι γ' οὐδαμῶς συνήδομαι.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:959.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:959.1.text#καὶ νῦν ἕτοιμος τῷδε καὶ τεῦξαι τάφον
urn:cts:greekLit:tlg0006.tlg019.fu.sp:960.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:960.1.text#καὶ ξυμπυρῶσαι μυρίων πέπλων χλιδήν·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:961.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:961.1.text#φίλος γὰρ ἐλθὼν δυστυχῶς ἀπέρχεται.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:962.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:962.1.text#οὐκ εἶσι γαίας ἐς μελάγχιμον πέδον·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:963.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:963.1.text#τοσόνδε Νύμφην τὴν ἔνερθ' αἰτήσομαι,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:964.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:964.1.text#τῆς καρποποιοῦ παῖδα Δήμητρος θεᾶς,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:965.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:965.1.text#ψυχὴν ἀνεῖναι τοῦδ'· ὀφειλέτις δέ μοι
urn:cts:greekLit:tlg0006.tlg019.fu.sp:966.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:966.1.text#τοὺς Ὀρφέως τιμῶσα φαίνεσθαι φίλους.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:967.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:967.1.text#κἀμοὶ μὲν ὡς θανών τε κοὐ λεύσσων φάος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:968.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:968.1.text#ἔσται τὸ λοιπόν· οὐ γὰρ ἐς ταὐτόν ποτε
urn:cts:greekLit:tlg0006.tlg019.fu.sp:969.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:969.1.text#οὔτ' εἶσιν οὔτε μητρὸς ὄψεται δέμας·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:970.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:970.1.text#κρυπτὸς δ' ἐν ἄντροις τῆς ὑπαργύρου χθονὸς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:971.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:971.1.text#ἀνθρωποδαίμων κείσεται βλέπων φάος,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:972.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:972.1.text#Βάκχου προφήτης ὥστε Παγγαίου πέτραν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:973.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:973.1.text#ᾤκησε, σεμνὸς τοῖσιν εἰδόσιν θεός.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:974.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:974.1.text#ῥᾷον δὲ πένθος τῆς θαλασσίας θεοῦ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:975.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:975.1.text#οἴσω· θανεῖν γὰρ καὶ τὸν ἐκ κείνης χρεών.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:976.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:976.1.text#θρήνοις δ' ἀδελφαὶ πρῶτα μὲν σὲ ὑμνήσομεν,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:977.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:977.1.text#ἔπειτ' Ἀχιλλέα Θέτιδος ἐν πένθει ποτέ.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:978.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:978.1.text#οὐ ῥύσεταί νιν Παλλάς, ἥ σ' ἀπέκτανεν·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:979.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:979.1.text#τοῖον φαρέτρα Λοξίου σῴζει βέλος.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:980.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:980.1.text#ὦ παιδοποιοὶ συμφοραί, πόνοι βροτῶν·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:981.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:981.1.text#ὡς ὅστις ὑμᾶς μὴ κακῶς λογίζεται,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:982.1.speaker#Μοῦσα
urn:cts:greekLit:tlg0006.tlg019.fu.sp:982.1.text#ἄπαις διοίσει κοὐ τεκὼν θάψει τέκνα.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:983.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:983.1.text#οὗτος μὲν ἤδη μητρὶ κηδεύειν μέλει·
urn:cts:greekLit:tlg0006.tlg019.fu.sp:984.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:984.1.text#σὺ δ' εἴ τι πράσσειν τῶν προκειμένων θέλεις,
urn:cts:greekLit:tlg0006.tlg019.fu.sp:985.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:985.1.text#Ἕκτορ, πάρεστι· φῶς γὰρ ἡμέρας τόδε.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:986.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:986.1.text#χωρεῖτε, συμμάχους δ' ὁπλίζεσθαι τάχος
urn:cts:greekLit:tlg0006.tlg019.fu.sp:987.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:987.1.text#ἄνωχθε πληροῦν τ' αὐχένας ξυνωρίδων.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:988.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:988.1.text#πανοὺς δ' ἔχοντας χρὴ μένειν Τυρσηνικῆς
urn:cts:greekLit:tlg0006.tlg019.fu.sp:989.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:989.1.text#σάλπιγγος αὐδήν· ὡς ὑπερβαλὼν στρατὸν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:990.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:990.1.text#τείχη τ' Ἀχαιῶν ναυσὶν αἶθον ἐμβαλεῖν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:991.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:991.1.text#πέποιθα Τρωσί θ' ἡμέραν ἐλευθέραν
urn:cts:greekLit:tlg0006.tlg019.fu.sp:992.1.speaker#Ἕκτωρ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:992.1.text#ἀκτῖνα τὴν στείχουσαν ἡλίου φέρειν.
urn:cts:greekLit:tlg0006.tlg019.fu.sp:993.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:993.1.text#πείθου βασιλεῖ· στείχωμεν ὅπλοις
urn:cts:greekLit:tlg0006.tlg019.fu.sp:994.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:994.1.text#κοσμησάμενοι καὶ ξυμμαχίᾳ
urn:cts:greekLit:tlg0006.tlg019.fu.sp:995.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:995.1.text#τάδε φράζωμεν· τάχα δ' ἂν νίκην
urn:cts:greekLit:tlg0006.tlg019.fu.sp:996.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg019.fu.sp:996.1.text#δοίη δαίμων ὁ μεθ' ἡμῶν.
