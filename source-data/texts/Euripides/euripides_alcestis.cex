#!ctsdata
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1.1.text#Ὦ δώματ' Ἀδμήτει', ἐν οἷς ἔτλην ἐγὼ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:2.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:2.1.text#θῆσσαν τράπεζαν αἰνέσαι θεός περ ὤν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:3.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:3.1.text#Ζεὺς γὰρ κατακτὰς παῖδα τὸν ἐμὸν αἴτιος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:4.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:4.1.text#Ἀσκληπιόν, στέρνοισιν ἐμβαλὼν φλόγα·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:5.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:5.1.text#οὗ δὴ χολωθεὶς τέκτονας Δίου πυρὸς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:6.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:6.1.text#κτείνω Κύκλωπας· καί με θητεύειν πατὴρ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:7.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:7.1.text#θνητῷ παρ' ἀνδρὶ τῶνδ' ἄποιν' ἠνάγκασεν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:8.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:8.1.text#ἐλθὼν δὲ γαῖαν τήνδ' ἐβουφόρβουν ξένῳ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:9.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:9.1.text#καὶ τόνδ' ἔσῳζον οἶκον ἐς τόδ' ἡμέρας.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:10.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:10.1.text#ὁσίου γὰρ ἀνδρὸς ὅσιος ὢν ἐτύγχανον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:11.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:11.1.text#παιδὸς Φέρητος, ὃν θανεῖν ἐρρυσάμην,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:12.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:12.1.text#Μοίρας δολώσας· ᾔνεσαν δέ μοι θεαὶ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:13.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:13.1.text#Ἄδμητον ᾅδην τὸν παραυτίκ' ἐκφυγεῖν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:14.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:14.1.text#ἄλλον διαλλάξαντα τοῖς κάτω νεκρόν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:15.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:15.1.text#πάντας δ' ἐλέγξας καὶ διεξελθὼν φίλους,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:16.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:16.1.text#πατέρα γεραιάν θ' ἥ σφ' ἔτικτε μητέρα,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:17.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:17.1.text#οὐχ ηὗρε πλὴν γυναικὸς ὅστις ἤθελε
urn:cts:greekLit:tlg0006.tlg002.fu.sp:18.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:18.1.text#θανὼν πρὸ κείνου μηκέτ' εἰσορᾶν φάος·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:19.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:19.1.text#ἣ νῦν κατ' οἴκους ἐν χεροῖν βαστάζεται
urn:cts:greekLit:tlg0006.tlg002.fu.sp:20.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:20.1.text#ψυχορραγοῦσα· τῇδε γάρ σφ' ἐν ἡμέρᾳ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:21.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:21.1.text#θανεῖν πέπρωται καὶ μεταστῆναι βίου.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:22.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:22.1.text#ἐγὼ δέ, μὴ μίασμά μ' ἐν δόμοις κίχῃ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:23.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:23.1.text#λείπω μελάθρων τῶνδε φιλτάτην στέγην.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:24.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:24.1.text#ἤδη δὲ τόνδε Θάνατον εἰσορῶ πέλας,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:25.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:25.1.text#ἱερῆ θανόντων, ὅς νιν εἰς Ἅιδου δόμους
urn:cts:greekLit:tlg0006.tlg002.fu.sp:26.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:26.1.text#μέλλει κατάξειν· συμμέτρως δ' ἀφίκετο,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:27.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:27.1.text#φρουρῶν τόδ' ἦμαρ ᾧ θανεῖν αὐτὴν χρεών.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:28.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:28.1.text#ἆ ἆ·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:29.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:29.1.text#τί σὺ πρὸς μελάθροις; τί σὺ τῇδε πολεῖς,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:30.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:30.1.text#Φοῖβ'; ἀδικεῖς αὖ τιμὰς ἐνέρων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:31.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:31.1.text#ἀφοριζόμενος καὶ καταπαύων;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:32.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:32.1.text#οὐκ ἤρκεσέ σοι μόρον Ἀδμήτου
urn:cts:greekLit:tlg0006.tlg002.fu.sp:33.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:33.1.text#διακωλῦσαι, Μοίρας δολίῳ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:34.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:34.1.text#σφήλαντι τέχνῃ; νῦν δ' ἐπὶ τῇδ' αὖ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:35.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:35.1.text#χέρα τοξήρη φρουρεῖς ὁπλίσας,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:36.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:36.1.text#ἣ τόδ' ὑπέστη πόσιν ἐκλύσασ'
urn:cts:greekLit:tlg0006.tlg002.fu.sp:37.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:37.1.text#αὐτὴ προθανεῖν Πελίου παῖς.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:38.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:38.1.text#θάρσει· δίκην τοι καὶ λόγους κεδνοὺς ἔχω.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:39.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:39.1.text#τί δῆτα τόξων ἔργον, εἰ δίκην ἔχεις;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:40.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:40.1.text#σύνηθες αἰεὶ ταῦτα βαστάζειν ἐμοί.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:41.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:41.1.text#καὶ τοῖσδέ γ' οἴκοις ἐκδίκως προσωφελεῖν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:42.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:42.1.text#φίλου γὰρ ἀνδρὸς συμφοραῖς βαρύνομαι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:43.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:43.1.text#καὶ νοσφιεῖς με τοῦδε δευτέρου νεκροῦ;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:44.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:44.1.text#ἀλλ' οὐδ' ἐκεῖνον πρὸς βίαν σ' ἀφειλόμην.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:45.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:45.1.text#πῶς οὖν ὑπὲρ γῆς ἐστι κοὐ κάτω χθονός;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:46.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:46.1.text#δάμαρτ' ἀμείψας, ἣν σὺ νῦν ἥκεις μέτα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:47.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:47.1.text#κἀπάξομαί γε νερτέρων ὑπὸ χθόνα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:48.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:48.1.text#λαβὼν ἴθ'· οὐ γὰρ οἶδ' ἂν εἰ πείσαιμί σε.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:49.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:49.1.text#κτείνειν γ' ὃν ἂν χρῇ; τοῦτο γὰρ τετάγμεθα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:50.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:50.1.text#οὔκ, ἀλλὰ τοῖς μέλλουσι θάνατον ἐμβαλεῖν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:51.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:51.1.text#ἔχω λόγον δὴ καὶ προθυμίαν σέθεν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:52.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:52.1.text#ἔστ' οὖν ὅπως Ἄλκηστις ἐς γῆρας μόλοι;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:53.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:53.1.text#οὐκ ἔστι· τιμαῖς κἀμὲ τέρπεσθαι δόκει.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:54.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:54.1.text#οὔτοι πλέον γ' ἂν ἢ μίαν ψυχὴν λάβοις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:55.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:55.1.text#νέων φθινόντων μεῖζον ἄρνυμαι γέρας.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:56.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:56.1.text#κἂν γραῦς ὄληται, πλουσίως ταφήσεται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:57.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:57.1.text#πρὸς τῶν ἐχόντων, Φοῖβε, τὸν νόμον τίθης.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:58.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:58.1.text#πῶς εἶπας; ἀλλ' ἦ καὶ σοφὸς λέληθας ὤν;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:59.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:59.1.text#ὠνοῖντ' ἂν οἷς πάρεστι γηραιοὺς θανεῖν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:60.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:60.1.text#οὔκουν δοκεῖ σοι τήνδε μοι δοῦναι χάριν;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:61.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:61.1.text#οὐ δῆτ'· ἐπίστασαι δὲ τοὺς ἐμοὺς τρόπους.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:62.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:62.1.text#ἐχθρούς γε θνητοῖς καὶ θεοῖς στυγουμένους.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:63.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:63.1.text#οὐκ ἂν δύναιο πάντ' ἔχειν ἃ μή σε δεῖ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:64.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:64.1.text#ἦ μὴν σὺ παύσῃ καίπερ ὠμὸς ὢν ἄγαν·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:65.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:65.1.text#τοῖος Φέρητος εἶσι πρὸς δόμους ἀνήρ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:66.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:66.1.text#Εὐρυσθέως πέμψαντος ἵππειον μέτα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:67.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:67.1.text#ὄχημα Θρῄκης ἐκ τόπων δυσχειμέρων,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:68.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:68.1.text#ὃς δὴ ξενωθεὶς τοῖσδ' ἐν Ἀδμήτου δόμοις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:69.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:69.1.text#βίᾳ γυναῖκα τήνδε σ' ἐξαιρήσεται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:70.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:70.1.text#κοὔθ' ἡ παρ' ἡμῶν σοι γενήσεται χάρις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:71.1.speaker#Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:71.1.text#δράσεις θ' ὁμοίως ταῦτ', ἀπεχθήσῃ τ' ἐμοί.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:72.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:72.1.text#πόλλ' ἂν σὺ λέξας οὐδὲν ἂν πλέον λάβοις·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:73.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:73.1.text#ἡ δ' οὖν γυνὴ κάτεισιν εἰς Ἅιδου δόμους.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:74.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:74.1.text#στείχω δ' ἐπ' αὐτήν, ὡς κατάρξωμαι ξίφει·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:75.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:75.1.text#ἱερὸς γὰρ οὗτος τῶν κατὰ χθονὸς θεῶν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:76.1.speaker#Θάνατος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:76.1.text#ὅτου τόδ' ἔγχος κρατὸς ἁγνίσῃ τρίχα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:77.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:77.1.text#—τί ποθ' ἡσυχία πρόσθεν μελάθρων;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:78.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:78.1.text#—τί σεσίγηται δόμος Ἀδμήτου;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:79.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:79.1.text#—ἀλλ' οὐδὲ φίλων πέλας οὐδείς,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:80.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:80.1.text#ὅστις ἂν εἴποι πότερον φθιμένην
urn:cts:greekLit:tlg0006.tlg002.fu.sp:81.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:81.1.text#βασίλεαν πενθεῖν χρή { μ' }, ἢ ζῶσ' ἔτι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:82.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:82.1.text#φῶς τόδε λεύσσει Πελίου παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:83.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:83.1.text#Ἄλκηστις, ἐμοὶ πᾶσί τ' ἀρίστη
urn:cts:greekLit:tlg0006.tlg002.fu.sp:84.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:84.1.text#δόξασα γυνὴ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:85.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:85.1.text#πόσιν εἰς αὑτῆς γεγενῆσθαι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:86.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:86.1.text#—κλύει τις ἢ στεναγμὸν ἢ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:87.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:87.1.text#χειρῶν κτύπον κατὰ στέγας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:88.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:88.1.text#ἢ γόον ὡς πεπραγμένων;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:89.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:89.1.text#—οὐ μὰν οὐδέ τις ἀμφιπόλων στατίζεται
urn:cts:greekLit:tlg0006.tlg002.fu.sp:90.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:90.1.text# ἀμφὶ πύλας. εἰ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:91.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:91.1.text#γὰρ μετακύμιος ἄτας,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:92.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:92.1.text#ὦ Παιάν, φανείης.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:93.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:93.1.text#—οὔ τἂν φθιμένης γ' ἐσιώπων.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:94.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:94.1.text#—νέκυς ἤδη.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:94a.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:94a.text#—οὐ δὴ φροῦδός γ' ἐξ οἴκων.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:95.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:95.1.text#—πόθεν; οὐκ αὐχῶ. τί σε θαρσύνει;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:96.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:96.1.text#—πῶς ἂν ἔρημον τάφον Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:96a.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:96a.text#[ … ]
urn:cts:greekLit:tlg0006.tlg002.fu.sp:97.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:97.1.text#κεδνῆς ἂν ἔπραξε γυναικός;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:98.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:98.1.text#—πυλῶν πάροιθε δ' οὐχ ὁρῶ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:99.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:99.1.text#πηγαῖον ὡς νομίζεται
urn:cts:greekLit:tlg0006.tlg002.fu.sp:100.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:100.1.text#χέρνιβ' ἐπὶ φθιτῶν πύλαις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:101.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:101.1.text#—χαίτα τ' οὔτις ἐπὶ προθύροις τομαῖος,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:102.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:102.1.text# ἃ δὴ νεκύων πένθει
urn:cts:greekLit:tlg0006.tlg002.fu.sp:103.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:103.1.text# πίτνει· οὐ νεολαία
urn:cts:greekLit:tlg0006.tlg002.fu.sp:104.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:104.1.text#δουπεῖ χεὶρ γυναικῶν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:105.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:105.1.text#—καὶ μὴν τόδε κύριον ἦμαρ . . .
urn:cts:greekLit:tlg0006.tlg002.fu.sp:106.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:106.1.text#—τί τόδ' αὐδᾷς;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:107.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:107.1.text#—ᾧ χρή σφε μολεῖν κατὰ γαίας.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:108.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:108.1.text#—ἔθιγες ψυχᾶς, ἔθιγες δὲ φρενῶν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:109.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:109.1.text#—χρὴ τῶν ἀγαθῶν διακναιομένων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:110.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:110.1.text#πενθεῖν ὅστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:111.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:111.1.text#χρηστὸς ἀπ' ἀρχῆς νενόμισται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:112.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:112.1.text#—ἀλλ' οὐδὲ ναυκληρίαν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:113.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:113.1.text#ἔσθ' ὅποι τις αἴας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:114.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:114.1.text#στείλας, ἢ Λυκίαν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:115.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:115.1.text#εἴτ' ἐπὶ τὰς ἀνύδρους
urn:cts:greekLit:tlg0006.tlg002.fu.sp:116.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:116.1.text#Ἀμμωνιάδας [ ἕδρας ],
urn:cts:greekLit:tlg0006.tlg002.fu.sp:117.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:117.1.text#δυστάνου παραλύσαι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:118.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:118.1.text#ψυχάν· μόρος γὰρ ἀπότομος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:119.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:119.1.text#πλάθει· θεῶν δ' ἐπ' ἐσχάραις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:120.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:120.1.text#οὐκ ἔχω ἐπὶ τίνα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:121.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:121.1.text#μηλοθύταν πορευθῶ. [ … ]
urn:cts:greekLit:tlg0006.tlg002.fu.sp:122.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:122.1.text#—μόνος δ' ἄν, εἰ φῶς τόδ' ἦν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:123.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:123.1.text#ὄμμασιν δεδορκὼς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:124.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:124.1.text#Φοίβου παῖς, προλιποῦσ'
urn:cts:greekLit:tlg0006.tlg002.fu.sp:125.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:125.1.text#ἦλθεν ἕδρας σκοτίους
urn:cts:greekLit:tlg0006.tlg002.fu.sp:126.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:126.1.text#Ἅιδα τε πύλας·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:127.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:127.1.text#δμαθέντας γὰρ ἀνίστη,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:128.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:128.1.text#πρὶν αὐτὸν εἷλε διόβολον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:129.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:129.1.text#πλῆκτρον πυρὸς κεραυνίου.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:130.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:130.1.text#νῦν δὲ τίν' ἔτι βίου
urn:cts:greekLit:tlg0006.tlg002.fu.sp:131.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:131.1.text#ἐλπίδα προσδέχωμαι;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:132.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:132.1.text#—πάντα γὰρ ἤδη τετέλεσται βασιλεῦσι,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:133.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:133.1.text#πάντων δὲ θεῶν ἐπὶ βωμοῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:134.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:134.1.text#αἱμόρραντοι θυσίαι πλήρεις·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:135.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:135.1.text#οὐδ' ἔστι κακῶν ἄκος οὐδέν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:136.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:136.1.text#ἀλλ' ἥδ' ὀπαδῶν ἐκ δόμων τις ἔρχεται
urn:cts:greekLit:tlg0006.tlg002.fu.sp:137.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:137.1.text#δακρυρροοῦσα, τίνα τύχην ἀκούσομαι;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:138.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:138.1.text#πενθεῖν μέν, εἴ τι δεσπόταισι τυγχάνει,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:139.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:139.1.text#συγγνωστόν· εἰ δ' ἔτ' ἐστὶν ἔμψυχος γυνὴ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:140.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:140.1.text#εἴτ' οὖν ὄλωλεν εἰδέναι βουλοίμεθ' ἄν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:141.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:141.1.text#καὶ ζῶσαν εἰπεῖν καὶ θανοῦσαν ἔστι σοι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:142.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:142.1.text#καὶ πῶς ἂν αὑτὸς κατθάνοι τε καὶ βλέποι;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:143.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:143.1.text#ἤδη προνωπής ἐστι καὶ ψυχορραγεῖ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:144.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:144.1.text#ὦ τλῆμον, οἵας οἷος ὢν ἁμαρτάνεις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:145.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:145.1.text#οὔπω τόδ' οἶδε δεσπότης, πρὶν ἂν πάθῃ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:146.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:146.1.text#ἐλπὶς μὲν οὐκέτ' ἐστὶ σῴζεσθαι βίον;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:147.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:147.1.text#πεπρωμένη γὰρ ἡμέρα βιάζεται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:148.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:148.1.text#οὔκουν ἐπ' αὐτῇ πράσσεται τὰ πρόσφορα;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:149.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:149.1.text#κόσμος γ' ἕτοιμος, ᾧ σφε συνθάψει πόσις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:150.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:150.1.text#ἴστω νυν εὐκλεής γε κατθανουμένη
urn:cts:greekLit:tlg0006.tlg002.fu.sp:151.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:151.1.text#γυνή τ' ἀρίστη τῶν ὑφ' ἡλίῳ, μακρῷ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:152.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:152.1.text#πῶς δ' οὐκ ἀρίστη; τίς δ' ἐναντιώσεται;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:153.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:153.1.text#τί χρὴ γενέσθαι τὴν ὑπερβεβλημένην
urn:cts:greekLit:tlg0006.tlg002.fu.sp:154.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:154.1.text#γυναῖκα; πῶς δ' ἂν μᾶλλον ἐνδείξαιτό τις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:155.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:155.1.text#πόσιν προτιμῶσ' ἢ θέλουσ' ὑπερθανεῖν;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:156.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:156.1.text#καὶ ταῦτα μὲν δὴ πᾶσ' ἐπίσταται πόλις·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:157.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:157.1.text#ἃ δ' ἐν δόμοις ἔδρασε θαυμάσῃ κλύων.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:158.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:158.1.text#ἐπεὶ γὰρ ᾔσθεθ' ἡμέραν τὴν κυρίαν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:159.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:159.1.text#ἥκουσαν, ὕδασι ποταμίοις λευκὸν χρόα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:160.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:160.1.text#ἐλούσατ', ἐκ δ' ἑλοῦσα κεδρίνων δόμων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:161.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:161.1.text#ἐσθῆτα κόσμον τ' εὐπρεπῶς ἠσκήσατο,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:162.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:162.1.text#καὶ στᾶσα πρόσθεν Ἑστίας κατηύξατο·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:163.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:163.1.text#Δέσποιν', ἐγὼ γὰρ ἔρχομαι κατὰ χθονός,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:164.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:164.1.text#πανύστατόν σε προσπίτνουσ' αἰτήσομαι,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:165.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:165.1.text#τέκν' ὀρφανεῦσαι τἀμά· καὶ τῷ μὲν φίλην
urn:cts:greekLit:tlg0006.tlg002.fu.sp:166.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:166.1.text#σύζευξον ἄλοχον, τῇ δὲ γενναῖον πόσιν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:167.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:167.1.text#μηδ' ὥσπερ αὐτῶν ἡ τεκοῦσ' ἀπόλλυμαι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:168.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:168.1.text#θανεῖν ἀώρους παῖδας, ἀλλ' εὐδαίμονας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:169.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:169.1.text#ἐν γῇ πατρῴᾳ τερπνὸν ἐκπλῆσαι βίον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:170.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:170.1.text#πάντας δὲ βωμούς, οἳ κατ' Ἀδμήτου δόμους,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:171.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:171.1.text#προσῆλθε κἀξέστεψε καὶ προσηύξατο,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:172.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:172.1.text#πτόρθων ἀποσχίζουσα μυρσίνης φόβην,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:173.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:173.1.text#ἄκλαυτος ἀστένακτος, οὐδὲ τοὐπιὸν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:174.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:174.1.text#κακὸν μεθίστη χρωτὸς εὐειδῆ φύσιν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:175.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:175.1.text#κἄπειτα θάλαμον ἐσπεσοῦσα καὶ λέχος,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:176.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:176.1.text#ἐνταῦθα δὴ 'δάκρυσε καὶ λέγει τάδε·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:177.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:177.1.text#Ὦ λέκτρον, ἔνθα παρθένει' ἔλυσ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:178.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:178.1.text#κορεύματ' ἐκ τοῦδ' ἀνδρός, οὗ θνῄσκω πέρι,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:179.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:179.1.text#χαῖρ'· οὐ γὰρ ἐχθαίρω σ'· ἀπώλεσας δ' ἐμὲ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:180.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:180.1.text#μόνην· προδοῦναι γάρ σ' ὀκνοῦσα καὶ πόσιν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:181.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:181.1.text#θνῄσκω. σὲ δ' ἄλλη τις γυνὴ κεκτήσεται,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:182.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:182.1.text#σώφρων μὲν οὐκ ἂν μᾶλλον, εὐτυχὴς δ' ἴσως.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:183.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:183.1.text#κυνεῖ δὲ προσπίτνουσα, πᾶν δὲ δέμνιον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:184.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:184.1.text#ὀφθαλμοτέγκτῳ δεύεται πλημμυρίδι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:185.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:185.1.text#ἐπεὶ δὲ πολλῶν δακρύων εἶχεν κόρον,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:186.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:186.1.text#στείχει προνωπὴς ἐκπεσοῦσα δεμνίων,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:187.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:187.1.text#καὶ πολλὰ θαλάμων ἐξιοῦσ' ἐπεστράφη
urn:cts:greekLit:tlg0006.tlg002.fu.sp:188.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:188.1.text#κἄρριψεν αὑτὴν αὖθις ἐς κοίτην πάλιν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:189.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:189.1.text#παῖδες δὲ πέπλων μητρὸς ἐξηρτημένοι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:190.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:190.1.text#ἔκλαιον· ἣ δὲ λαμβάνουσ' ἐς ἀγκάλας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:191.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:191.1.text#ἠσπάζετ' ἄλλοτ' ἄλλον, ὡς θανουμένη.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:192.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:192.1.text#πάντες δ' ἔκλαιον οἰκέται κατὰ στέγας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:193.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:193.1.text#δέσποιναν οἰκτίροντες. ἣ δὲ δεξιὰν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:194.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:194.1.text#προύτειν' ἑκάστῳ, κοὔτις ἦν οὕτω κακὸς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:195.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:195.1.text#ὃν οὐ προσεῖπε καὶ προσερρήθη πάλιν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:196.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:196.1.text#τοιαῦτ' ἐν οἴκοις ἐστὶν Ἀδμήτου κακά.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:197.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:197.1.text#καὶ κατθανών τἂν ὤλετ', ἐκφυγών δ' ἔχει
urn:cts:greekLit:tlg0006.tlg002.fu.sp:198.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:198.1.text#τοσοῦτον ἄλγος, οὗ ποτ'—οὐ λελήσεται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:199.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:199.1.text#ἦ που στενάζει τοισίδ' Ἄδμητος κακοῖς,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:200.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:200.1.text#ἐσθλῆς γυναικὸς εἰ στερηθῆναί σφε χρή;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:201.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:201.1.text#κλαίει γ' ἄκοιτιν ἐν χεροῖν φίλην ἔχων,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:202.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:202.1.text#καὶ μὴ προδοῦναι λίσσεται, τἀμήχανα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:203.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:203.1.text#ζητῶν· φθίνει γὰρ καὶ μαραίνεται νόσῳ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:204.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:204.1.text#παρειμένη δέ, χειρὸς ἄθλιον βάρος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:204.2.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:204.2.text#[ … ]
urn:cts:greekLit:tlg0006.tlg002.fu.sp:205.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:205.1.text#ὅμως δὲ καίπερ σμικρὸν ἐμπνέουσ' ἔτι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:206.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:206.1.text#βλέψαι πρὸς αὐγὰς βούλεται τὰς ἡλίου
urn:cts:greekLit:tlg0006.tlg002.fu.sp:207.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:207.1.text#ὡς οὔποτ' αὖθις, ἀλλὰ νῦν πανύστατον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:208.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:208.1.text#[ ἀκτῖνα κύκλον θ' ἡλίου προσόψεται. ]
urn:cts:greekLit:tlg0006.tlg002.fu.sp:209.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:209.1.text#ἀλλ' εἶμι καὶ σὴν ἀγγελῶ παρουσίαν·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:210.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:210.1.text#οὐ γάρ τι πάντες εὖ φρονοῦσι κοιράνοις,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:211.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:211.1.text#ὥστ' ἐν κακοῖσιν εὐμενεῖς παρεστάναι·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:212.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:212.1.text#σὺ δ' εἶ παλαιὸς δεσπόταις ἐμοῖς φίλος.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:213.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:213.1.text#— ἰὼ Ζεῦ, τίς ἂν [ πῶς ] πᾷ πόρος κακῶν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:214.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:214.1.text#γένοιτο καὶ λύσις τύχας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:214.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:214.2.text#ἃ πάρεστι κοιράνοις;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:215.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:215.1.text#—αἰαῖ· εἶσί τις; ἢ τέμω τρίχα,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:216.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:216.1.text#καὶ μέλανα στολμὸν πέπλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:217.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:217.1.text#ἀμφιβαλώμεθ' ἤδη;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:218.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:218.1.text#—δῆλα μέν, φίλοι, δῆλά γ', ἀλλ' ὅμως
urn:cts:greekLit:tlg0006.tlg002.fu.sp:219.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:219.1.text#θεοῖσιν εὐχώμεσθα· θεῶν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:219a.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:219a.text#γὰρ δύναμις μεγίστα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:220.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:220.1.text#—ὦναξ Παιάν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:221.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:221.1.text#ἔξευρε μηχανάν τιν' Ἀδμήτῳ κακῶν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:222.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:222.1.text#—πόριζε δὴ πόριζε· καὶ πάρος γὰρ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:223.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:223.1.text#{ τοῦδ' ἐφεῦρες }, καὶ νῦν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:224.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:224.1.text#λυτήριος ἐκ θανάτου γενοῦ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:225.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:225.1.text#φόνιον δ' ἀπόπαυσον Ἅιδαν. [ … ]
urn:cts:greekLit:tlg0006.tlg002.fu.sp:226.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:226.1.text#— παπαῖ [ … ]
urn:cts:greekLit:tlg0006.tlg002.fu.sp:226a.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:226a.text#ὦ παῖ Φέρητος, οἷ' ἔπραξας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:227.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:227.1.text# δάμαρτος σᾶς στερείς.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:228.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:228.1.text#—αἰαῖ· ἄξια καὶ σφαγᾶς τάδε,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:229.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:229.1.text#καὶ πλέον ἢ βρόχῳ δέρην
urn:cts:greekLit:tlg0006.tlg002.fu.sp:230.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:230.1.text#οὐρανίῳ πελάσσαι;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:231.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:231.1.text#τὰν γὰρ οὐ φίλαν ἀλλὰ φιλτάταν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:232.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:232.1.text#γυναῖκα κατθανοῦσαν ἐν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:233.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:233.1.text#ἄματι τῷδ' ἐπόψῃ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:234.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:234.1.text#—ἰδοὺ ἰδού,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:234a.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:234a.text#ἥδ' ἐκ δόμων δὴ καὶ πόσις πορεύεται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:235.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:235.1.text#—βόασον ὦ, στέναξον, ὦ Φεραία
urn:cts:greekLit:tlg0006.tlg002.fu.sp:235a.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:235a.text#χθών, τὰν ἀρίσταν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:236.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:236.1.text#γυναῖκα μαραινομέναν νόσῳ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:237.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:237.1.text#κατὰ γᾶς χθόνιον παρ' Ἅιδαν. [ … ]
urn:cts:greekLit:tlg0006.tlg002.fu.sp:238.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:238.1.text#οὔποτε φήσω γάμον εὐφραίνειν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:239.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:239.1.text#πλέον ἢ λυπεῖν, τοῖς τε πάροιθεν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:240.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:240.1.text#τεκμαιρόμενος καὶ τάσδε τύχας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:241.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:241.1.text#λεύσσων βασιλέως, ὅστις ἀρίστης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:242.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:242.1.text#ἀπλακὼν ἀλόχου τῆσδ' ἀβίωτον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:243.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:243.1.text#τὸν ἔπειτα χρόνον βιοτεύσει. [ … ]
urn:cts:greekLit:tlg0006.tlg002.fu.sp:244.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:244.1.text#Ἅλιε καὶ φάος ἁμέρας,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:245.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:245.1.text#οὐράνιαί τε δῖναι νεφέλας δρομαίου.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:246.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:246.1.text#ὁρᾷ σὲ κἀμέ, δύο κακῶς πεπραγότας,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:247.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:247.1.text#οὐδὲν θεοὺς δράσαντας ἀνθ' ὅτου θανῇ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:248.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:248.1.text#γαῖά τε καὶ μελάθρων στέγαι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:249.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:249.1.text#νυμφίδιοί τε κοῖται πατρίας Ἰωλκοῦ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:250.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:250.1.text#ἔπαιρε σαυτήν, ὦ τάλαινα, μὴ προδῷς·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:251.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:251.1.text#λίσσου δὲ τοὺς κρατοῦντας οἰκτῖραι θεούς. [ … ]
urn:cts:greekLit:tlg0006.tlg002.fu.sp:252.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:252.1.text#ὁρῶ δίκωπον ὁρῶ σκάφος ἐν λίμνᾳ·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:253.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:253.1.text#νεκύων δὲ πορθμεὺς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:254.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:254.1.text#ἔχων χέρ' ἐπὶ κοντῷ Χάρων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:255.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:255.1.text#μ' ἤδη καλεῖ· Τί μέλλεις;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:256.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:256.1.text#ἐπείγου· σὺ κατείργεις. τάδε τοί με
urn:cts:greekLit:tlg0006.tlg002.fu.sp:256a.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:256a.text#σπερχόμενος ταχύνει.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:257.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:257.1.text#οἴμοι, πικράν γε τήνδε μοι ναυκληρίαν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:258.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:258.1.text#ἔλεξας. ὦ δύσδαιμον, οἷα πάσχομεν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:259.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:259.1.text#ἄγει μ' ἄγει τις· ἄγει μέ τις—οὐχ ὁρᾷς;—
urn:cts:greekLit:tlg0006.tlg002.fu.sp:260.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:260.1.text#νεκύων ἐς αὐλάν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:261.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:261.1.text#ὑπ' ὀφρύσι κυαναυγέσι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:262.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:262.1.text#βλέπων πτερωτός—{ αἵδας }.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:263.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:263.1.text#[ μέθες με· ] τί ῥέξεις; ἄφες.—οἵαν ὅδον ἁ δειλαιότατα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:263a.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:263a.text# προβαίνω.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:264.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:264.1.text#οἰκτρὰν φίλοισιν, ἐκ δὲ τῶν μάλιστ' ἐμοὶ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:265.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:265.1.text#καὶ παισίν, οἷς δὴ πένθος ἐν κοινῷ τόδε.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:266.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:266.1.text#μέθετε μέθετέ μ' ἤδη.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:267.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:267.1.text#κλίνατ', οὐ σθένω ποσίν·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:268.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:268.1.text#πλησίον Ἅιδας.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:269.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:269.1.text#σκοτία δ' ἐπ' ὄσσοισι νὺξ ἐφέρπει.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:270.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:270.1.text#τέκνα, τέκν', οὐκέτι δὴ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:271.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:271.1.text#οὐκέτι μάτηρ σφῷν ἔστιν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:272.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:272.1.text#χαίροντες, ὦ τέκνα, τόδε φάος ὁρῷτον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:273.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:273.1.text#οἴμοι· τόδ' ἔπος λυπρὸν ἀκούω
urn:cts:greekLit:tlg0006.tlg002.fu.sp:274.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:274.1.text#καὶ παντὸς ἐμοὶ θανάτου μεῖζον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:275.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:275.1.text#μὴ πρός { σε } θεῶν τλῇς με προδοῦναι,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:276.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:276.1.text#μὴ πρὸς παίδων οὓς ὀρφανιεῖς,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:277.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:277.1.text#ἀλλ' ἄνα, τόλμα·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:277a.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:277a.text#σοῦ γὰρ φθιμένης οὐκέτ' ἂν εἴην·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:278.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:278.1.text#ἐν σοὶ δ' ἐσμὲν καὶ ζῆν καὶ μή·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:279.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:279.1.text#σὴν γὰρ φιλίαν σεβόμεσθα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:280.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:280.1.text#Ἄδμηθ', ὁρᾷς γὰρ τἀμὰ πράγμαθ' ὡς ἔχει,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:281.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:281.1.text#λέξαι θέλω σοι πρὶν θανεῖν ἃ βούλομαι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:282.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:282.1.text#ἐγώ σε πρεσβεύουσα κἀντὶ τῆς ἐμῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:283.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:283.1.text#ψυχῆς καταστήσασα φῶς τόδ' εἰσορᾶν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:284.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:284.1.text#θνῄσκω, παρόν μοι μὴ θανεῖν, ὑπὲρ σέθεν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:285.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:285.1.text#ἀλλ' ἄνδρα τε σχεῖν Θεσσαλῶν ὃν ἤθελον,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:286.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:286.1.text#καὶ δῶμα ναίειν ὄλβιον τυραννίδι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:287.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:287.1.text#οὐκ ἠθέλησα ζῆν ἀποσπασθεῖσά σου
urn:cts:greekLit:tlg0006.tlg002.fu.sp:288.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:288.1.text#σὺν παισὶν ὀρφανοῖσιν, οὐδ' ἐφεισάμην
urn:cts:greekLit:tlg0006.tlg002.fu.sp:289.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:289.1.text#ἥβης, ἔχουσ' ἐν οἷς ἐτερπόμην ἐγώ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:290.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:290.1.text#καίτοι σ' ὁ φύσας χἠ τεκοῦσα προύδοσαν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:291.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:291.1.text#καλῶς μὲν αὐτοῖς κατθανεῖν ἧκον βίου,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:292.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:292.1.text#καλῶς δὲ σῶσαι παῖδα κεὐκλεῶς θανεῖν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:293.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:293.1.text#μόνος γὰρ αὐτοῖς ἦσθα, κοὔτις ἐλπὶς ἦν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:294.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:294.1.text#σοῦ κατθανόντος ἄλλα φιτύσειν τέκνα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:295.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:295.1.text#κἀγώ τ' ἂν ἔζων καὶ σὺ τὸν λοιπὸν χρόνον,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:296.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:296.1.text#κοὐκ ἂν μονωθεὶς σῆς δάμαρτος ἔστενες
urn:cts:greekLit:tlg0006.tlg002.fu.sp:297.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:297.1.text#καὶ παῖδας ὠρφάνευες. ἀλλὰ ταῦτα μὲν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:298.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:298.1.text#θεῶν τις ἐξέπραξεν ὥσθ' οὕτως ἔχειν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:299.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:299.1.text#εἶεν· σὺ νῦν μοι τῶνδ' ἀπόμνησαι χάριν·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:300.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:300.1.text#αἰτήσομαι γάρ σ'—ἀξίαν μὲν οὔποτε·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:301.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:301.1.text#ψυχῆς γὰρ οὐδέν ἐστι τιμιώτερον—
urn:cts:greekLit:tlg0006.tlg002.fu.sp:302.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:302.1.text#δίκαια δ', ὡς φήσεις σύ· τούσδε γὰρ φιλεῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:303.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:303.1.text#οὐχ ἧσσον ἢ 'γὼ παῖδας, εἴπερ εὖ φρονεῖς·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:304.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:304.1.text#τούτους ἀνάσχου δεσπότας ἐμῶν δόμων,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:305.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:305.1.text#καὶ μὴ 'πιγήμῃς τοῖσδε μητρυιὰν τέκνοις,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:306.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:306.1.text#ἥτις κακίων οὖσ' ἐμοῦ γυνὴ φθόνῳ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:307.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:307.1.text#τοῖς σοῖσι κἀμοῖς παισὶ χεῖρα προσβαλεῖ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:308.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:308.1.text#μὴ δῆτα δράσῃς ταῦτά γ', αἰτοῦμαί σ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:309.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:309.1.text#ἐχθρὰ γὰρ ἡ 'πιοῦσα μητρυιὰ τέκνοις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:310.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:310.1.text#τοῖς πρόσθ', ἐχίδνης οὐδὲν ἠπιωτέρα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:311.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:311.1.text#καὶ παῖς μὲν ἄρσην πατέρ' ἔχει πύργον μέγαν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:312.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:312.1.text#[ ὃν καὶ προσεῖπε καὶ προσερρήθη πάλιν. ]
urn:cts:greekLit:tlg0006.tlg002.fu.sp:313.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:313.1.text#σὺ δ', ὦ τέκνον μοι, πῶς κορευθήσῃ καλῶς;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:314.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:314.1.text#ποίας τυχοῦσα συζύγου τῷ σῷ πατρί;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:315.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:315.1.text#μή σοί τιν' αἰσχρὰν προσβαλοῦσα κληδόνα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:316.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:316.1.text#ἥβης ἐν ἀκμῇ σοὺς διαφθείρῃ γάμους.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:317.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:317.1.text#οὐ γάρ σε μήτηρ οὔτε νυμφεύσει ποτὲ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:318.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:318.1.text#οὔτ' ἐν τόκοισι σοῖσι θαρσυνεῖ, τέκνον,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:319.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:319.1.text#παροῦσ', ἵν' οὐδὲν μητρὸς εὐμενέστερον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:320.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:320.1.text#δεῖ γὰρ θανεῖν με· καὶ τόδ' οὐκ ἐς αὔριον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:321.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:321.1.text#οὐδ' ἐς τρίτην μοι μηνὸς ἔρχεται κακόν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:322.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:322.1.text#ἀλλ' αὐτίκ' ἐν τοῖς οὐκέτ' οὖσι λέξομαι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:323.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:323.1.text#χαίροντες εὐφραίνοισθε· καὶ σοὶ μέν, πόσι,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:324.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:324.1.text#γυναῖκ' ἀρίστην ἔστι κομπάσαι λαβεῖν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:325.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:325.1.text#ὑμῖν δέ, παῖδες, μητρὸς ἐκπεφυκέναι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:326.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:326.1.text#θάρσει· πρὸ τούτου γὰρ λέγειν οὐχ ἅζομαι·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:327.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:327.1.text#δράσει τάδ', εἴπερ μὴ φρενῶν ἁμαρτάνει.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:328.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:328.1.text#ἔσται τάδ' ἔσται, μὴ τρέσῃς· ἐπεὶ σ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:329.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:329.1.text#καὶ ζῶσαν εἶχον καὶ θανοῦσ' ἐμὴ γυνὴ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:330.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:330.1.text#μόνη κεκλήσῃ, κοὔτις ἀντὶ σοῦ ποτε
urn:cts:greekLit:tlg0006.tlg002.fu.sp:331.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:331.1.text#τόνδ' ἄνδρα νύμφη Θεσσαλὶς προσφθέγξεται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:332.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:332.1.text#οὐκ ἔστιν οὕτως οὔτε πατρὸς εὐγενοῦς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:333.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:333.1.text#οὔτ' εἶδος ἄλλως ἐκπρεπεστάτη γυνή.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:334.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:334.1.text#ἅλις δὲ παίδων· τῶνδ' ὄνησιν εὔχομαι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:335.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:335.1.text#θεοῖς γενέσθαι· σοῦ γὰρ οὐκ ὠνήμεθα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:336.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:336.1.text#οἴσω δὲ πένθος οὐκ ἐτήσιον τὸ σόν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:337.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:337.1.text#ἀλλ' ἔστ' ἂν αἰὼν οὑμὸς ἀντέχῃ, γύναι,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:338.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:338.1.text#στυγῶν μὲν ἥ μ' ἔτικτεν, ἐχθαίρων δ' ἐμὸν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:339.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:339.1.text#πατέρα· λόγῳ γὰρ ἦσαν οὐκ ἔργῳ φίλοι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:340.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:340.1.text#σὺ δ' ἀντιδοῦσα τῆς ἐμῆς τὰ φίλτατα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:341.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:341.1.text#ψυχῆς ἔσωσας. ἆρά μοι στένειν πάρα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:342.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:342.1.text#τοιᾶσδ' ἁμαρτάνοντι συζύγου σέθεν;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:343.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:343.1.text#παύσω δὲ κώμους συμποτῶν θ' ὁμιλίας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:344.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:344.1.text#στεφάνους τε μοῦσάν θ' ἣ κατεῖχ' ἐμοὺς δόμους.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:345.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:345.1.text#οὐ γάρ ποτ' οὔτ' ἂν βαρβίτου θίγοιμ' ἔτι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:346.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:346.1.text#οὔτ' ἂν φρέν' ἐξαίροιμι πρὸς Λίβυν λακεῖν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:347.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:347.1.text#αὐλόν· σὺ γάρ μου τέρψιν ἐξείλου βίου.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:348.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:348.1.text#σοφῇ δὲ χειρὶ τεκτόνων δέμας τὸ σὸν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:349.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:349.1.text#εἰκασθὲν ἐν λέκτροισιν ἐκταθήσεται,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:350.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:350.1.text#ᾧ προσπεσοῦμαι καὶ περιπτύσσων χέρας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:351.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:351.1.text#ὄνομα καλῶν σὸν τὴν φίλην ἐν ἀγκάλαις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:352.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:352.1.text#δόξω γυναῖκα καίπερ οὐκ ἔχων ἔχειν·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:353.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:353.1.text#ψυχρὰν μέν, οἶμαι, τέρψιν, ἀλλ' ὅμως βάρος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:354.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:354.1.text#ψυχῆς ἀπαντλοίην ἄν. ἐν δ' ὀνείρασι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:355.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:355.1.text#φοιτῶσά μ' εὐφραίνοις ἄν· ἡδὺ γὰρ φίλους
urn:cts:greekLit:tlg0006.tlg002.fu.sp:356.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:356.1.text#κἀν νυκτὶ λεύσσειν, ὅντιν' ἂν παρῇ χρόνον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:357.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:357.1.text#εἰ δ' Ὀρφέως μοι γλῶσσα καὶ μέλος παρῆν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:358.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:358.1.text#ὥστ' ἢ κόρην Δήμητρος ἢ κείνης πόσιν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:359.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:359.1.text#ὕμνοισι κηλήσαντά σ' ἐξ Ἅιδου λαβεῖν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:360.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:360.1.text#κατῆλθον ἄν, καί μ' οὔθ' ὁ Πλούτωνος κύων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:361.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:361.1.text#οὔθ' οὑπὶ κώπῃ ψυχοπομπὸς ἂν Χάρων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:362.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:362.1.text#ἔσχον, πρὶν ἐς φῶς σὸν καταστῆσαι βίον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:363.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:363.1.text#ἀλλ' οὖν ἐκεῖσε προσδόκα μ', ὅταν θάνω,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:364.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:364.1.text#καὶ δῶμ' ἑτοίμαζ', ὡς συνοικήσουσά μοι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:365.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:365.1.text#ἐν ταῖσιν αὐταῖς γάρ μ' ἐπισκήψω κέδροις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:366.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:366.1.text#σοὶ τούσδε θεῖναι πλευρά τ' ἐκτεῖναι πέλας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:367.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:367.1.text#πλευροῖσι τοῖς σοῖς· μηδὲ γὰρ θανών ποτε
urn:cts:greekLit:tlg0006.tlg002.fu.sp:368.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:368.1.text#σοῦ χωρὶς εἴην τῆς μόνης πιστῆς ἐμοί.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:369.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:369.1.text#καὶ μὴν ἐγώ σοι πένθος ὡς φίλος φίλῳ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:370.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:370.1.text#λυπρὸν συνοίσω τῆσδε· καὶ γὰρ ἀξία.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:371.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:371.1.text#ὦ παῖδες, αὐτοὶ δὴ τάδ' εἰσηκούσατε
urn:cts:greekLit:tlg0006.tlg002.fu.sp:372.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:372.1.text#πατρὸς λέγοντος μὴ γαμεῖν ἄλλην ποτὲ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:373.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:373.1.text#γυναῖκ' ἐφ' ὑμῖν μηδ' ἀτιμάσειν ἐμέ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:374.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:374.1.text#καὶ νῦν γέ φημι, καὶ τελευτήσω τάδε.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:375.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:375.1.text#ἐπὶ τοῖσδε παῖδας χειρὸς ἐξ ἐμῆς δέχου.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:376.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:376.1.text#δέχομαι, φίλον γε δῶρον ἐκ φίλης χερός.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:377.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:377.1.text#σὺ νῦν γενοῦ τοῖσδ' ἀντ' ἐμοῦ μήτηρ τέκνοις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:378.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:378.1.text#πολλή μ' ἀνάγκη, σοῦ γ' ἀπεστερημένοις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:379.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:379.1.text#ὦ τέκν', ὅτε ζῆν χρῆν μ', ἀπέρχομαι κάτω.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:380.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:380.1.text#οἴμοι, τί δράσω δῆτα σοῦ μονούμενος;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:381.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:381.1.text#χρόνος μαλάξει σ'· οὐδέν ἐσθ' ὁ κατθανών.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:382.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:382.1.text#ἄγου με σὺν σοί, πρὸς θεῶν, ἄγου κάτω.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:383.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:383.1.text#ἀρκοῦμεν ἡμεῖς οἱ προθνῄσκοντες σέθεν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:384.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:384.1.text#ὦ δαῖμον, οἵας συζύγου μ' ἀποστερεῖς.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:385.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:385.1.text#καὶ μὴν σκοτεινὸν ὄμμα μου βαρύνεται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:386.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:386.1.text#ἀπωλόμην ἄρ', εἴ με δὴ λείψεις, γύναι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:387.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:387.1.text#ὡς οὐκέτ' οὖσαν οὐδὲν ἂν λέγοις ἐμέ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:388.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:388.1.text#ὄρθου πρόσωπον, μὴ λίπῃς παῖδας σέθεν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:389.1.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:389.1.text#οὐ δῆθ' ἑκοῦσά γ', ἀλλὰ χαίρετ', ὦ τέκνα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:390.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:390.1.text#βλέψον πρὸς αὐτοὺς βλέψον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:390.2.speaker#Ἄλκηστις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:390.2.text#οὐδέν εἰμ' ἔτι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:391.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:391.1.text#τί δρᾷς; προλείπεις;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:391.2.speaker#Ἄλκηστις 
urn:cts:greekLit:tlg0006.tlg002.fu.sp:391.2.text#χαῖρ'.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:391.3.speaker#Ἄδμητος 
urn:cts:greekLit:tlg0006.tlg002.fu.sp:391.3.text#ἀπωλόμην τάλας.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:392.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:392.1.text#βέβηκεν, οὐκέτ' ἔστιν Ἀδμήτου γυνή.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:393.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:393.1.text#ἰώ μοι τύχας. μαῖα δὴ κάτω
urn:cts:greekLit:tlg0006.tlg002.fu.sp:394.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:394.1.text#βέβακεν, οὐκέτ' ἔστιν, ὦ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:395.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:395.1.text#πάτερ, ὑφ' ἁλίῳ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:396.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:396.1.text#προλιποῦσα δ' ἀμὸν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:397.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:397.1.text#βίον ὠρφάνισσε τλάμων.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:398.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:398.1.text#ἴδε γὰρ ἴδε βλέφαρον καὶ παρατόνους χέρας.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:400.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:400.1.text#ὑπάκουσον ἄκουσον, ὦ μᾶτερ, ἀντιάζω.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:401.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:401.1.text#ἐγώ σ' ἐγώ, μᾶτερ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:402.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:402.1.text#καλοῦμαί σ' ὁ σὸς ποτὶ σοῖσι πίτστόμασιν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:403.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:403.1.text# νεοσσός.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:404.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:404.1.text#τὴν οὐ κλύουσαν οὐδ' ὁρῶσαν· ὥστ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:405.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:405.1.text#καὶ σφὼ βαρείᾳ συμφορᾷ πεπλήγμεθα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:406.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:406.1.text#νέος ἐγώ, πάτερ, λείπομαι φίλας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:407.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:407.1.text#μονόστολός τε ματρός· ὦ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:408.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:408.1.text#σχέτλια δὴ παθὼν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:409.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:409.1.text#ἐγὼ ἐργὰ . .,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:410.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:410.1.text#σύ τέ μοι σύγκασι κούρα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:411.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:411.1.text#συνέτλας· [ … ] ὦ πάτερ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:412.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:412.1.text#ἀνόνατ' ἀνόνατ' ἐνύμφευσας, οὐδὲ γήρως
urn:cts:greekLit:tlg0006.tlg002.fu.sp:413.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:413.1.text#ἔβας τέλος σὺν τᾷδ'·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:414.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:414.1.text#ἔφθιτο γὰρ πάρος· οἰχομένας δὲ σοῦ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:415.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:415.1.text#μᾶτερ, ὄλωλεν οἶκος.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:416.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:416.1.text#Ἄδμητ', ἀνάγκη τάσδε συμφορὰς φέρειν·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:417.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:417.1.text#οὐ γάρ τι πρῶτος οὐδὲ λοίσθιος βροτῶν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:418.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:418.1.text#γυναικὸς ἐσθλῆς ἤμπλακες· γίγνωσκε δὲ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:419.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:419.1.text#ὡς πᾶσιν ἡμῖν κατθανεῖν ὀφείλεται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:420.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:420.1.text#ἐπίσταμαί γε, κοὐκ ἄφνω κακὸν τόδε
urn:cts:greekLit:tlg0006.tlg002.fu.sp:421.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:421.1.text#προσέπτατ'· εἰδὼς δ' αὔτ' ἐτειρόμην πάλαι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:422.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:422.1.text#ἀλλ', ἐκφορὰν γὰρ τοῦδε θήσομαι νεκροῦ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:423.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:423.1.text#πάρεστε καὶ μένοντες ἀντηχήσατε
urn:cts:greekLit:tlg0006.tlg002.fu.sp:424.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:424.1.text#παιᾶνα τῷ κάτωθεν ἀσπόνδῳ θεῷ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:425.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:425.1.text#πᾶσιν δὲ Θεσσαλοῖσιν ὧν ἐγὼ κρατῶ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:426.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:426.1.text#πένθους γυναικὸς τῆσδε κοινοῦσθαι λέγω
urn:cts:greekLit:tlg0006.tlg002.fu.sp:427.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:427.1.text#κουρᾷ ξυρήκει καὶ μελαμπέπλῳ στολῇ·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:428.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:428.1.text#τέθριππά θ' οἳ ζεύγνυσθε καὶ μονάμπυκας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:429.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:429.1.text#πώλους, σιδήρῳ τέμνετ' αὐχένων φόβην.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:430.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:430.1.text#αὐλῶν δὲ μὴ κατ' ἄστυ, μὴ λύρας κτύπος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:431.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:431.1.text#ἔστω σελήνας δώδεκ' ἐκπληρουμένας·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:432.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:432.1.text#οὐ γάρ τιν' ἄλλον φίλτερον θάψω νεκρὸν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:433.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:433.1.text#τοῦδ' οὐδ' ἀμείνον' εἰς ἔμ'· ἀξία δέ μοι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:434.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:434.1.text#τιμῆς, ἐπεὶ τέθνηκεν ἀντ' ἐμοῦ μόνη.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:435.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:435.1.text#ὦ Πελίου θύγατερ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:436.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:436.1.text#χαίρουσά μοι εἰν Ἀίδαο δόμοις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:437.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:437.1.text#τὸν ἀνάλιον οἶκον οἰκετεύοις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:438.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:438.1.text#ἴστω δ' Ἀίδας ὁ μελαγχαίτας θεὸς ὅς τ' ἐπὶ κώπᾳ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:440.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:440.1.text#πηδαλίῳ τε γέρων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:441.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:441.1.text#νεκροπομπὸς ἵζει,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:442.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:442.1.text#πολὺ δὴ πολὺ δὴ γυναῖκ' ἀρίσταν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:443.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:443.1.text#λίμναν Ἀχεροντίαν πορεύσας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:444.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:444.1.text# ἐλάτᾳ δικώπῳ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:445.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:445.1.text#πολλά σε μουσοπόλοι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:446.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:446.1.text#μέλψουσι καθ' ἑπτάτονόν τ' ὀρείαν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:447.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:447.1.text#χέλυν ἔν τ' ἀλύροις κλέοντες ὕμνοις,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:448.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:448.1.text#Σπάρτᾳ κύκλος ἁνίκα Καρνείου περινίσσεται ὥρας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:450.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:450.1.text#μηνός, ἀειρομένας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:451.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:451.1.text#παννύχου σελάνας,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:452.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:452.1.text#λιπαραῖσί τ' ἐν ὀλβίαις Ἀθάναις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:453.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:453.1.text#τοίαν ἔλιπες θανοῦσα μολπὰν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:454.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:454.1.text# μελέων ἀοιδοῖς.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:455.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:455.1.text#εἴθ' ἐπ' ἐμοὶ μὲν εἴη,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:456.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:456.1.text#δυναίμαν δέ σε πέμψαι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:457.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:457.1.text#φάος ἐξ Ἀίδα τεράμνων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:458.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:458.1.text#καὶ Κωκυτοῖο ῥεέθρων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:459.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:459.1.text#ποταμίᾳ νερτέρᾳ τε κώπᾳ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:460.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:460.1.text#σὺ γὰρ ὤ, μόνα, ὦ φίλα γυναικῶν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:461.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:461.1.text#σὺ τὸν αὑτᾶς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:462.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:462.1.text#ἔτλας πόσιν ἀντὶ σᾶς ἀμεῖψαι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:462a.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:462a.text#ψυχᾶς ἐξ Ἅιδα. κούφα σοι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:463.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:463.1.text#χθὼν ἐπάνωθε πέσοι, γύναι. εἰ δέ τι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:464.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:464.1.text#καινὸν ἕλοιτο πόσις λέχος, ἦ μάλ' ἂν ἔμοιγ' ἂν εἴη
urn:cts:greekLit:tlg0006.tlg002.fu.sp:465.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:465.1.text#στυγηθεὶς τέκνοις τε τοῖς σοῖς.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:466.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:466.1.text#ματέρος οὐ θελούσας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:467.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:467.1.text#πρὸ παιδὸς χθονὶ κρύψαι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:468.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:468.1.text#δέμας, οὐδὲ πατρὸς γεραιοῦ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:468a.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:468a.text#[ … ]
urn:cts:greekLit:tlg0006.tlg002.fu.sp:469.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:469.1.text#ὃν ἔτεκον δ', οὐκ ἔτλαν ῥύεσθαι,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:470.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:470.1.text#σχετλίω, πολιὰν ἔχοντε χαίταν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:470a.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:470a.text#σὺ δ' ἐν ἥβᾳ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:471.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:471.1.text#νέᾳ προθανοῦσα φωτὸς οἴχῃ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:472.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:472.1.text#τοιαύτας εἴη μοι κῦρσαι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:473.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:473.1.text#συνδυάδος φιλίας [ ἀλόχου ]· τοῦτο γὰρ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:474.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:474.1.text#ἐν βιότῳ σπάνιον μέρος· ἦ γὰρ ἂν ἔμοιγ' ἄλυπος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:475.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:475.1.text#δι' αἰῶνος ἂν ξυνείη.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:476.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:476.1.text#ξένοι, Φεραίας τῆσδε κωμῆται χθονός,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:477.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:477.1.text#Ἄδμητον ἐν δόμοισιν ἆρα κιγχάνω;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:478.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:478.1.text#ἔστ' ἐν δόμοισι παῖς Φέρητος, Ἡράκλεις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:479.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:479.1.text#ἀλλ' εἰπὲ χρεία τίς σε Θεσσαλῶν χθόνα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:480.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:480.1.text#πέμπει, Φεραῖον ἄστυ προσβῆναι τόδε.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:481.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:481.1.text#Τιρυνθίῳ πράσσω τιν' Εὐρυσθεῖ πόνον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:482.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:482.1.text#καὶ ποῖ πορεύῃ; τῷ προσέζευξαι πλάνῳ;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:483.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:483.1.text#Θρῃκὸς τέτρωρον ἅρμα Διομήδους μέτα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:484.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:484.1.text#πῶς οὖν δυνήσῃ; μῶν ἄπειρος εἶ ξένου;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:485.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:485.1.text#ἄπειρος· οὔπω Βιστόνων ἦλθον χθόνα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:486.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:486.1.text#οὐκ ἔστιν ἵππων δεσπόσαι σ' ἄνευ μάχης.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:487.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:487.1.text#ἀλλ' οὐδ' ἀπειπεῖν μὴν πόνους οἷόν τ' ἐμοί.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:488.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:488.1.text#κτανὼν ἄρ' ἥξεις ἢ θανὼν αὐτοῦ μενεῖς.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:489.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:489.1.text#οὐ τόνδ' ἀγῶνα πρῶτον ἂν δράμοιμ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:490.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:490.1.text#τί δ' ἂν κρατήσας δεσπότην πλέον λάβοις;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:491.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:491.1.text#πώλους ἀπάξω κοιράνῳ Τιρυνθίῳ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:492.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:492.1.text#οὐκ εὐμαρὲς χαλινὸν ἐμβαλεῖν γνάθοις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:493.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:493.1.text#εἰ μή γε πῦρ πνέουσι μυκτήρων ἄπο.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:494.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:494.1.text#ἀλλ' ἄνδρας ἀρταμοῦσι λαιψηραῖς γνάθοις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:495.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:495.1.text#θηρῶν ὀρείων χόρτον, οὐχ ἵππων, λέγεις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:496.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:496.1.text#φάτνας ἴδοις ἂν αἵμασιν πεφυρμένας.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:497.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:497.1.text#τίνος δ' ὁ θρέψας παῖς πατρὸς κομπάζεται;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:498.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:498.1.text#Ἄρεος, ζαχρύσου Θρῃκίας πέλτης ἄναξ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:499.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:499.1.text#καὶ τόνδε τοὐμοῦ δαίμονος πόνον λέγεις·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:500.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:500.1.text#σκληρὸς γὰρ αἰεὶ καὶ πρὸς αἶπος ἔρχεται·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:501.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:501.1.text#εἰ χρή με παισὶν οἷς Ἄρης ἐγείνατο
urn:cts:greekLit:tlg0006.tlg002.fu.sp:502.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:502.1.text#μάχην συνάψαι, πρῶτα μὲν Λυκάονι,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:503.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:503.1.text#αὖθις δὲ Κύκνῳ, τόνδε δ' ἔρχομαι τρίτον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:504.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:504.1.text#ἀγῶνα πώλοις δεσπότῃ τε συμβαλῶν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:505.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:505.1.text#ἀλλ' οὔτις ἔστιν ὃς τὸν Ἀλκμήνης γόνον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:506.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:506.1.text#τρέσαντα χεῖρα πολεμίαν ποτ' ὄψεται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:507.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:507.1.text#καὶ μὴν ὅδ' αὐτὸς τῆσδε κοίρανος χθονὸς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:508.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:508.1.text#Ἄδμητος ἔξω δωμάτων πορεύεται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:509.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:509.1.text#χαῖρ', ὦ Διὸς παῖ Περσέως τ' ἀφ' αἵματος.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:510.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:510.1.text#Ἄδμητε, καὶ σὺ χαῖρε, Θεσσαλῶν ἄναξ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:511.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:511.1.text#θέλοιμ' ἄν· εὔνουν δ' ὄντα σ' ἐξεπίσταμαι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:512.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:512.1.text#τί χρῆμα κουρᾷ τῇδε πενθίμῳ πρέπεις;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:513.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:513.1.text#θάπτειν τιν' ἐν τῇδ' ἡμέρᾳ μέλλω νεκρόν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:514.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:514.1.text#ἀπ' οὖν τέκνων σῶν πημονὴν εἴργοι θεός.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:515.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:515.1.text#ζῶσιν κατ' οἴκους παῖδες οὓς ἔφυσ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:516.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:516.1.text#πατήρ γε μὴν ὡραῖος, εἴπερ οἴχεται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:517.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:517.1.text#κἀκεῖνος ἔστι χἡ τεκοῦσά μ', Ἡράκλεις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:518.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:518.1.text#οὐ μὴν γυνή γ' ὄλωλεν Ἄλκηστις σέθεν;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:519.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:519.1.text#διπλοῦς ἐπ' αὐτῇ μῦθος ἔστι μοι λέγειν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:520.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:520.1.text#πότερα θανούσης εἶπας ἢ ζώσης ἔτι;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:521.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:521.1.text#ἔστιν τε κοὐκέτ' ἔστιν, ἀλγύνει δ' ἐμέ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:522.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:522.1.text#οὐδέν τι μᾶλλον οἶδ'· ἄσημα γὰρ λέγεις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:523.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:523.1.text#οὐκ οἶσθα μοίρας ἧς τυχεῖν αὐτὴν χρεών;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:524.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:524.1.text#οἶδ', ἀντὶ σοῦ γε κατθανεῖν ὑφειμένην.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:525.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:525.1.text#πῶς οὖν ἔτ' ἔστιν, εἴπερ ᾔνεσεν τάδε;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:526.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:526.1.text#ἆ, μὴ πρόκλαι' ἄκοιτιν, ἐς τότ' ἀμβαλοῦ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:527.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:527.1.text#τέθνηχ' ὁ μέλλων, κοὐκέτ' ἔσθ' ὁ κατθανών.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:528.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:528.1.text#χωρὶς τό τ' εἶναι καὶ τὸ μὴ νομίζεται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:529.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:529.1.text#σὺ τῇδε κρίνεις, Ἡράκλεις, κείνῃ δ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:530.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:530.1.text#τί δῆτα κλαίεις; τίς φίλων ὁ κατθανών;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:531.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:531.1.text#γυνή· γυναικὸς ἀρτίως μεμνήμεθα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:532.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:532.1.text#ὀθνεῖος ἢ σοὶ συγγενὴς γεγῶσά τις;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:533.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:533.1.text#ὀθνεῖος, ἄλλως δ' ἦν ἀναγκαία δόμοις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:534.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:534.1.text#πῶς οὖν ἐν οἴκοις σοῖσιν ὤλεσεν βίον;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:535.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:535.1.text#πατρὸς θανόντος ἐνθάδ' ὠρφανεύετο.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:536.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:536.1.text#φεῦ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:536.2.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:536.2.text#εἴθ' ηὕρομέν σ', Ἄδμητε, μὴ λυπούμενον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:537.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:537.1.text#ὡς δὴ τί δράσων τόνδ' ὑπορράπτεις λόγον;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:538.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:538.1.text#ξένων πρὸς ἄλλων ἑστίαν πορεύσομαι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:539.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:539.1.text#οὐκ ἔστιν, ὦναξ· μὴ τοσόνδ' ἔλθοι κακόν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:540.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:540.1.text#λυπουμένοις ὀχληρός, εἰ μόλοι, ξένος.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:541.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:541.1.text#τεθνᾶσιν οἱ θανόντες· ἀλλ' ἴθ' ἐς δόμους.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:542.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:542.1.text#αἰσχρὸν παρὰ κλαίουσι θοινᾶσθαι ξένους.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:543.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:543.1.text#χωρὶς ξενῶνές εἰσιν οἷ σ' ἐσάξομεν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:544.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:544.1.text#μέθες με, καί σοι μυρίαν ἕξω χάριν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:545.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:545.1.text#οὐκ ἔστιν ἄλλου σ' ἀνδρὸς ἑστίαν μολεῖν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:546.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:546.1.text#ἡγοῦ σὺ τῷδε δωμάτων ἐξωπίους
urn:cts:greekLit:tlg0006.tlg002.fu.sp:547.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:547.1.text#ξενῶνας οἴξας, τοῖς τ' ἐφεστῶσιν φράσον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:548.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:548.1.text#σίτων παρεῖναι πλῆθος· εὖ δὲ κλῄσατε
urn:cts:greekLit:tlg0006.tlg002.fu.sp:549.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:549.1.text#θύρας μεσαύλους· οὐ πρέπει θοινωμένους
urn:cts:greekLit:tlg0006.tlg002.fu.sp:550.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:550.1.text#κλύειν στεναγμῶν οὐδὲ λυπεῖσθαι ξένους.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:551.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:551.1.text#τί δρᾷς; τοιαύτης συμφορᾶς προκειμένης,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:552.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:552.1.text#Ἄδμητε, τολμᾷς ξενοδοκεῖν; τί μῶρος εἶ;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:553.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:553.1.text#ἀλλ' εἰ δόμων σφε καὶ πόλεως ἀπήλασα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:554.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:554.1.text#ξένον μολόντα, μᾶλλον ἄν μ' ἐπῄνεσας;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:555.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:555.1.text#οὐ δῆτ', ἐπεί μοι συμφορὰ μὲν οὐδὲν ἂν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:556.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:556.1.text#μείων ἐγίγνετ', ἀξενώτερος δ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:557.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:557.1.text#καὶ πρὸς κακοῖσιν ἄλλο τοῦτ' ἂν ἦν κακόν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:558.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:558.1.text#δόμους καλεῖσθαι τοὺς ἐμοὺς ἐχθροξένους.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:559.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:559.1.text#αὐτὸς δ' ἀρίστου τοῦδε τυγχάνω ξένου,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:560.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:560.1.text#ὅταν ποτ' Ἄργους διψίαν ἔλθω χθόνα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:561.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:561.1.text#πῶς οὖν ἔκρυπτες τὸν παρόντα δαίμονα,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:562.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:562.1.text#φίλου μολόντος ἀνδρός, ὡς αὐτὸς λέγεις;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:563.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:563.1.text#οὐκ ἄν ποτ' ἠθέλησεν εἰσελθεῖν δόμους,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:564.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:564.1.text#εἰ τῶν ἐμῶν τι πημάτων ἐγνώρισε.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:565.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:565.1.text#καὶ τῷ μέν, οἶμαι, δρῶν τάδ' οὐ φρονεῖν δοκῶ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:566.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:566.1.text#οὐδ' αἰνέσει με· τἀμὰ δ' οὐκ ἐπίσταται
urn:cts:greekLit:tlg0006.tlg002.fu.sp:567.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:567.1.text#μέλαθρ' ἀπωθεῖν οὐδ' ἀτιμάζειν ξένους. [ … ]
urn:cts:greekLit:tlg0006.tlg002.fu.sp:568.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:568.1.text#ὦ πολύξεινος καὶ ἐλεύθερος ἀνδρὸς ἀεί ποτ' οἶκος,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:570.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:570.1.text#σέ τοι καὶ ὁ Πύθιος εὐλύρας Ἀπόλλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:571.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:571.1.text#ἠξίωσε ναίειν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:572.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:572.1.text#ἔτλα δὲ σοῖσι μηλονόμας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:573.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:573.1.text#ἐν δόμοις γενέσθαι,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:575.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:575.1.text#δοχμιᾶν διὰ κλιτύων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:576.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:576.1.text#βοσκήμασι σοῖσι συρίζων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:577.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:577.1.text#ποιμνίτας ὑμεναίους.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:578.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:578.1.text#σὺν δ' ἐποιμαίνοντο χαρᾷ μελέων βαλιαί τε λύγκες,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:580.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:580.1.text#ἔβα δὲ λιποῦσ' Ὄθρυος νάπαν λεόντων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:581.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:581.1.text#ἁ δαφοινὸς ἴλα·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:582.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:582.1.text#χόρευσε δ' ἀμφὶ σὰν κιθάραν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:583.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:583.1.text#Φοῖβε, ποικιλόθριξ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:585.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:585.1.text#νεβρὸς ὑψικόμων πέραν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:586.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:586.1.text#βαίνουσ' ἐλατᾶν σφυρῷ κούφῳ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:587.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:587.1.text#χαίρουσ' εὔφρονι μολπᾷ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:588.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:588.1.text#τοιγὰρ πολυμηλοτάταν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:589.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:589.1.text#ἑστίαν οἰκεῖς παρὰ καλλίναον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:590.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:590.1.text#Βοιβίαν λίμναν. ἀρότοις δὲ γυᾶν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:591.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:591.1.text#καὶ πεδίων δαπέδοις ὅρον ἀμφὶ μὲν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:592.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:592.1.text#ἀελίου κνεφαίαν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:593.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:593.1.text#ἱππόστασιν αἰθέρα τὰν Μολοσσῶν [ … ] τίθεται,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:595.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:595.1.text#πόντιον δ' Αἰγαίων' ἐπ' ἀκτὰν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:596.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:596.1.text#ἀλίμενον Πηλίου κρατύνει.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:597.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:597.1.text#καὶ νῦν δόμον ἀμπετάσας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:598.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:598.1.text#δέξατο ξεῖνον νοτερῷ βλεφάρῳ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:599.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:599.1.text#τᾶς φίλας κλαίων ἀλόχου νέκυν ἐν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:600.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:600.1.text#δώμασιν ἀρτιθανῆ· τὸ γὰρ εὐγενὲς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:601.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:601.1.text#ἐκφέρεται πρὸς αἰδῶ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:602.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:602.1.text#ἐν τοῖς ἀγαθοῖσι δὲ πάντ' ἔνεστιν σοφίας. ἄγαμαι·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:603.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:603.1.text#πρὸς δ' ἐμᾷ ψυχᾷ θάρσος ἧσται
urn:cts:greekLit:tlg0006.tlg002.fu.sp:605.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:605.1.text#θεοσεβῆ φῶτα κεδνὰ πράξειν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:606.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:606.1.text#ἀνδρῶν Φεραίων εὐμενὴς παρουσία,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:607.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:607.1.text#νέκυν μὲν ἤδη πάντ' ἔχοντα πρόσπολοι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:608.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:608.1.text#φέρουσιν ἄρδην πρὸς τάφον τε καὶ πυράν·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:609.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:609.1.text#ὑμεῖς δὲ τὴν θανοῦσαν, ὡς νομίζεται,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:610.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:610.1.text#προσείπατ' ἐξιοῦσαν ὑστάτην ὁδόν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:611.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:611.1.text#καὶ μὴν ὁρῶ σὸν πατέρα γηραιῷ ποδὶ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:612.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:612.1.text#στείχοντ', ὀπαδούς τ' ἐν χεροῖν δάμαρτι σῇ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:613.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:613.1.text#κόσμον φέροντας, νερτέρων ἀγάλματα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:614.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:614.1.text#ἥκω κακοῖσι σοῖσι συγκάμνων, τέκνον·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:615.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:615.1.text#ἐσθλῆς γάρ, οὐδεὶς ἀντερεῖ, καὶ σώφρονος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:616.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:616.1.text#γυναικὸς ἡμάρτηκας. ἀλλὰ ταῦτα μὲν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:617.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:617.1.text#φέρειν ἀνάγκη καίπερ ὄντα δύσφορα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:618.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:618.1.text#δέχου δὲ κόσμον τόνδε, καὶ κατὰ χθονὸς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:619.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:619.1.text#ἴτω. τὸ ταύτης σῶμα τιμᾶσθαι χρεών,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:620.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:620.1.text#ἥτις γε τῆς σῆς προύθανε ψυχῆς, τέκνον,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:621.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:621.1.text#καί μ' οὐκ ἄπαιδ' ἔθηκεν οὐδ' εἴασε σοῦ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:622.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:622.1.text#στερέντα γήρᾳ πενθίμῳ καταφθίνειν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:623.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:623.1.text#πάσαις δ' ἔθηκεν εὐκλεέστερον βίον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:624.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:624.1.text#γυναιξίν, ἔργον τλᾶσα γενναῖον τόδε.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:625.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:625.1.text#ὦ τόνδε μὲν σώσασ', ἀναστήσασα δὲ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:626.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:626.1.text#ἡμᾶς πίτνοντας, χαῖρε, κἀν Ἅιδου δόμοις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:627.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:627.1.text#εὖ σοι γένοιτο. φημὶ τοιούτους γάμους
urn:cts:greekLit:tlg0006.tlg002.fu.sp:628.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:628.1.text#λύειν βροτοῖσιν, ἢ γαμεῖν οὐκ ἄξιον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:629.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:629.1.text#οὔτ' ἦλθες ἐς τόνδ' ἐξ ἐμοῦ κληθεὶς τάφον,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:630.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:630.1.text#οὔτ' ἐν φίλοισι σὴν παρουσίαν λέγω.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:631.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:631.1.text#κόσμον δὲ τὸν σὸν οὔποθ' ἥδ' ἐνδύσεται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:632.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:632.1.text#οὐ γάρ τι τῶν σῶν ἐνδεὴς ταφήσεται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:633.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:633.1.text#τότε ξυναλγεῖν χρῆν σ' ὅτ' ὠλλύμην ἐγώ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:634.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:634.1.text#σὺ δ' ἐκποδὼν στὰς καὶ παρεὶς ἄλλῳ θανεῖν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:635.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:635.1.text#νέῳ γέρων ὤν, τόνδ' ἀποιμώξῃ νεκρόν;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:636.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:636.1.text#οὐκ ἦσθ' ἄρ' ὀρθῶς τοῦδε σώματος πατήρ;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:637.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:637.1.text#οὐδ' ἡ τεκεῖν φάσκουσα καὶ κεκλημένη
urn:cts:greekLit:tlg0006.tlg002.fu.sp:638.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:638.1.text#μήτηρ μ' ἔτικτε; δουλίου δ' ἀφ' αἵματος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:639.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:639.1.text#μαστῷ γυναικὸς σῆς ὑπεβλήθην λάθρᾳ;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:640.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:640.1.text#ἔδειξας εἰς ἔλεγχον ἐξελθὼν ὃς εἶ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:641.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:641.1.text#καί μ' οὐ νομίζω παῖδα σὸν πεφυκέναι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:642.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:642.1.text#ἦ τἄρα πάντων διαπρέπεις ἀψυχίᾳ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:643.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:643.1.text#ὃς τηλικόσδ' ὢν κἀπὶ τέρμ' ἥκων βίου
urn:cts:greekLit:tlg0006.tlg002.fu.sp:644.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:644.1.text#οὐκ ἠθέλησας οὐδ' ἐτόλμησας θανεῖν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:645.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:645.1.text#τοῦ σοῦ πρὸ παιδός, ἀλλὰ τήνδ' εἰάσατε
urn:cts:greekLit:tlg0006.tlg002.fu.sp:646.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:646.1.text#γυναῖκ' ὀθνείαν, ἣν ἐγὼ καὶ μητέρα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:647.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:647.1.text#πατέρα τέ γ' ἐνδίκως ἂν ἡγοίμην μόνην.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:648.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:648.1.text#καίτοι καλόν γ' ἂν τόνδ' ἀγῶν' ἠγωνίσω,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:649.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:649.1.text#τοῦ σοῦ πρὸ παιδὸς κατθανών, βραχὺς δέ σοι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:650.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:650.1.text#πάντως ὁ λοιπὸς ἦν βιώσιμος χρόνος.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:651.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:651.1.text#[ κἀγώ τ' ἂν ἔζων χἥδε τὸν λοιπὸν χρόνον, ]
urn:cts:greekLit:tlg0006.tlg002.fu.sp:652.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:652.1.text#[ κοὐκ ἂν μονωθεὶς ἔστενον κακοῖς ἐμοῖς. ]
urn:cts:greekLit:tlg0006.tlg002.fu.sp:653.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:653.1.text#καὶ μὴν ὅσ' ἄνδρα χρὴ παθεῖν εὐδαίμονα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:654.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:654.1.text#πέπονθας· ἥβησας μὲν ἐν τυραννίδι,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:655.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:655.1.text#παῖς δ' ἦν ἐγώ σοι τῶνδε διάδοχος δόμων,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:656.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:656.1.text#ὥστ' οὐκ ἄτεκνος κατθανὼν ἄλλοις δόμον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:657.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:657.1.text#λείψειν ἔμελλες ὀρφανὸν διαρπάσαι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:658.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:658.1.text#οὐ μὴν ἐρεῖς γέ μ' ὡς ἀτιμάζοντα σὸν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:659.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:659.1.text#γῆρας θανεῖν προύδωκας, ὅστις αἰδόφρων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:660.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:660.1.text#πρὸς σ' ἦ μάλιστα· κἀντὶ τῶνδέ μοι χάριν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:661.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:661.1.text#τοιάνδε καὶ σὺ χἡ τεκοῦσ' ἠλλαξάτην.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:662.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:662.1.text#τοιγὰρ φυτεύων παῖδας οὐκέτ' ἂν φθάνοις,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:663.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:663.1.text#οἳ γηροβοσκήσουσι καὶ θανόντα σε
urn:cts:greekLit:tlg0006.tlg002.fu.sp:664.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:664.1.text#περιστελοῦσι καὶ προθήσονται νεκρόν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:665.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:665.1.text#οὐ γάρ σ' ἔγωγε τῇδ' ἐμῇ θάψω χερί·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:666.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:666.1.text#τέθνηκα γὰρ δὴ τοὐπὶ σέ· εἰ δ' ἄλλου τυχὼν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:667.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:667.1.text#σωτῆρος αὐγὰς εἰσορῶ, κείνου λέγω
urn:cts:greekLit:tlg0006.tlg002.fu.sp:668.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:668.1.text#καὶ παῖδά μ' εἶναι καὶ φίλον γηροτρόφον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:669.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:669.1.text#μάτην ἄρ' οἱ γέροντες εὔχονται θανεῖν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:670.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:670.1.text#γῆρας ψέγοντες καὶ μακρὸν χρόνον βίου·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:671.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:671.1.text#ἢν δ' ἐγγὺς ἔλθῃ θάνατος, οὐδεὶς βούλεται
urn:cts:greekLit:tlg0006.tlg002.fu.sp:672.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:672.1.text#θνῄσκειν, τὸ γῆρας δ' οὐκέτ' ἔστ' αὐτοῖς βαρύ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:673.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:673.1.text#παύσασθ'· ἅλις γὰρ ἡ παροῦσα συμφορά·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:674.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:674.1.text#ὦ παῖ, πατρὸς δὲ μὴ παροξύνῃς φρένας.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:675.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:675.1.text#ὦ παῖ, τίν' αὐχεῖς, πότερα Λυδὸν ἢ Φρύγα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:676.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:676.1.text#κακοῖς ἐλαύνειν ἀργυρώνητον σέθεν;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:677.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:677.1.text#οὐκ οἶσθα Θεσσαλόν με κἀπὸ Θεσσαλοῦ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:678.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:678.1.text#πατρὸς γεγῶτα γνησίως ἐλεύθερον;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:679.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:679.1.text#ἄγαν ὑβρίζεις, καὶ νεανίας λόγους
urn:cts:greekLit:tlg0006.tlg002.fu.sp:680.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:680.1.text#ῥίπτων ἐς ἡμᾶς οὐ βαλὼν οὕτως ἄπει.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:681.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:681.1.text#ἐγὼ δέ σ' οἴκων δεσπότην ἐγεινάμην
urn:cts:greekLit:tlg0006.tlg002.fu.sp:682.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:682.1.text#κἄθρεψ', ὀφείλω δ' οὐχ ὑπερθνῄσκειν σέθεν·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:683.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:683.1.text#οὐ γὰρ πατρῷον τόνδ' ἐδεξάμην νόμον,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:684.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:684.1.text#παίδων προθνῄσκειν πατέρας, οὐδ' Ἑλληνικόν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:685.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:685.1.text#σαυτῷ γὰρ εἴτε δυστυχὴς εἴτ' εὐτυχὴς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:686.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:686.1.text#ἔφυς· ἃ δ' ἡμῶν χρῆν σε τυγχάνειν, ἔχεις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:687.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:687.1.text#πολλῶν μὲν ἄρχεις, πολυπλέθρους δέ σοι γύας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:688.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:688.1.text#λείψω· πατρὸς γὰρ ταὔτ' ἐδεξάμην πάρα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:689.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:689.1.text#τί δῆτά σ' ἠδίκηκα; τοῦ σ' ἀποστερῶ;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:690.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:690.1.text#μὴ θνῇσχ' ὑπὲρ τοῦδ' ἀνδρός, οὐδ' ἐγὼ πρὸ σοῦ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:691.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:691.1.text#χαίρεις ὁρῶν φῶς· πατέρα δ' οὐ χαίρειν δοκεῖς;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:692.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:692.1.text#ἦ μὴν πολύν γε τὸν κάτω λογίζομαι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:693.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:693.1.text#χρόνον, τὸ δὲ ζῆν μικρόν, ἀλλ' ὅμως γλυκύ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:694.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:694.1.text#σὺ γοῦν ἀναιδῶς διεμάχου τὸ μὴ θανεῖν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:695.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:695.1.text#καὶ ζῇς παρελθὼν τὴν πεπρωμένην τύχην,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:696.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:696.1.text#ταύτην κατακτάς· εἶτ' ἐμὴν ἀψυχίαν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:697.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:697.1.text#λέγεις, γυναικός, ὦ κάκισθ', ἡσσημένος,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:698.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:698.1.text#ἣ τοῦ καλοῦ σοῦ προύθανεν νεανίου;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:699.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:699.1.text#σοφῶς δ' ἐφηῦρες ὥστε μὴ θανεῖν ποτε,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:700.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:700.1.text#εἰ τὴν παροῦσαν κατθανεῖν πείσεις ἀεὶ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:701.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:701.1.text#γυναῖχ' ὑπὲρ σοῦ· κᾆτ' ὀνειδίζεις φίλοις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:702.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:702.1.text#τοῖς μὴ θέλουσι δρᾶν τάδ', αὐτὸς ὢν κακός;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:703.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:703.1.text#σίγα· νόμιζε δ', εἰ σὺ τὴν σαυτοῦ φιλεῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:704.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:704.1.text#ψυχήν, φιλεῖν ἅπαντας· εἰ δ' ἡμᾶς κακῶς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:705.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:705.1.text#ἐρεῖς, ἀκούσῃ πολλὰ κοὐ ψευδῆ κακά.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:706.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:706.1.text#πλείω λέλεκται νῦν τε καὶ τὰ πρὶν κακά·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:707.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:707.1.text#παῦσαι δέ, πρέσβυ, παῖδα σὸν κακορροθῶν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:708.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:708.1.text#λέγ', ὡς ἐμοῦ λέξαντος· εἰ δ' ἀλγεῖς κλύων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:709.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:709.1.text#τἀληθές, οὐ χρῆν σ' εἰς ἔμ' ἐξαμαρτάνειν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:710.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:710.1.text#σοῦ δ' ἂν προθνῄσκων μᾶλλον ἐξημάρτανον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:711.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:711.1.text#ταὐτὸν γὰρ ἡβῶντ' ἄνδρα καὶ πρέσβυν θανεῖν;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:712.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:712.1.text#ψυχῇ μιᾷ ζῆν, οὐ δυοῖν, ὀφείλομεν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:713.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:713.1.text#καὶ μὴν Διός γε μείζονα ζῴης χρόνον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:714.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:714.1.text#ἀρᾷ γονεῦσιν οὐδὲν ἔκδικον παθών;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:715.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:715.1.text#μακροῦ βίου γὰρ ᾐσθόμην ἐρῶντά σε.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:716.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:716.1.text#ἀλλ' οὐ σὺ νεκρὸν ἀντὶ σοῦ τόνδ' ἐκφέρεις;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:717.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:717.1.text#σημεῖα τῆς σῆς, ὦ κάκιστ', ἀψυχίας.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:718.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:718.1.text#οὔτοι πρὸς ἡμῶν γ' ὤλετ'· οὐκ ἐρεῖς τόδε.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:719.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:719.1.text#φεῦ· εἴθ' ἀνδρὸς ἔλθοις τοῦδέ γ' ἐς χρείαν ποτέ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:720.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:720.1.text#μνήστευε πολλάς, ὡς θάνωσι πλείονες.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:721.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:721.1.text#σοὶ τοῦτ' ὄνειδος· οὐ γὰρ ἤθελες θανεῖν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:722.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:722.1.text#φίλον τὸ φέγγος τοῦτο τοῦ θεοῦ, φίλον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:723.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:723.1.text#κακὸν τὸ λῆμα κοὐκ ἐν ἀνδράσιν τὸ σόν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:724.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:724.1.text#οὐκ ἐγγελᾷς γέροντα βαστάζων νεκρόν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:725.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:725.1.text#θανῇ γε μέντοι δυσκλεής, ὅταν θάνῃς.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:726.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:726.1.text#κακῶς ἀκούειν οὐ μέλει θανόντι μοι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:727.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:727.1.text#φεῦ φεῦ· τὸ γῆρας ὡς ἀναιδείας πλέων.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:728.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:728.1.text#ἥδ' οὐκ ἀναιδής· τήνδ' ἐφηῦρες ἄφρονα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:729.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:729.1.text#ἄπελθε κἀμὲ τόνδ' ἔα θάψαι νεκρόν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:730.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:730.1.text#ἄπειμι· θάψεις δ' αὐτὸς ὢν αὐτῆς φονεύς,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:731.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:731.1.text#δίκας δὲ δώσεις σοῖσι κηδεσταῖς ἔτι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:732.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:732.1.text#ἦ τἄρ' Ἄκαστος οὐκέτ' ἔστ' ἐν ἀνδράσιν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:733.1.speaker#Φέρης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:733.1.text#εἰ μή σ' ἀδελφῆς αἷμα τιμωρήσεται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:734.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:734.1.text#ἔρρων νυν, αὐτὸς χἡ ξυνοικήσασά σοι,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:735.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:735.1.text#ἄπαιδε παιδὸς ὄντος, ὥσπερ ἄξιοι,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:736.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:736.1.text#γηράσκετ'· οὐ γὰρ τῷδ' ἔτ' ἐς ταὐτὸν στέγος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:737.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:737.1.text#νεῖσθ'· εἰ δ' ἀπειπεῖν χρῆν με κηρύκων ὕπο
urn:cts:greekLit:tlg0006.tlg002.fu.sp:738.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:738.1.text#τὴν σὴν πατρῴαν ἑστίαν, ἀπεῖπον ἄν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:739.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:739.1.text#ἡμεῖς δέ—τοὐν ποσὶν γὰρ οἰστέον κακόν—
urn:cts:greekLit:tlg0006.tlg002.fu.sp:740.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:740.1.text#ὡς ἂν ἐν πυρᾷ θῶμεν νεκρόν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:741.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:741.1.text#ἰὼ ἰώ. σχετλία τόλμης,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:742.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:742.1.text#ὦ γενναία καὶ μέγ' ἀρίστη,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:743.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:743.1.text#χαῖρε· πρόφρων σὲ χθόνιός θ' Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:744.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:744.1.text#Ἅιδης τε δέχοιτ'. εἰ δέ τι κἀκεῖ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:745.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:745.1.text#πλέον ἔστ' ἀγαθοῖς, τούτων μετέχουσ'
urn:cts:greekLit:tlg0006.tlg002.fu.sp:746.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:746.1.text#Ἅιδου νύμφῃ παρεδρεύοις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:747.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:747.1.text#πολλοὺς μὲν ἤδη κἀπὸ παντοίας χθονὸς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:748.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:748.1.text#ξένους μολόντας οἶδ' ἐς Ἀδμήτου δόμους,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:749.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:749.1.text#οἷς δεῖπνα προύθηκ'· ἀλλὰ τοῦδ' οὔπω ξένου
urn:cts:greekLit:tlg0006.tlg002.fu.sp:750.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:750.1.text#κακίον' ἐς τήνδ' ἑστίαν ἐδεξάμην.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:751.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:751.1.text#ὃς πρῶτα μὲν πενθοῦντα δεσπότην ὁρῶν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:752.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:752.1.text#ἐσῆλθε κἀτόλμησ' ἀμείψασθαι πύλας.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:753.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:753.1.text#ἔπειτα δ' οὔτι σωφρόνως ἐδέξατο
urn:cts:greekLit:tlg0006.tlg002.fu.sp:754.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:754.1.text#τὰ προστυχόντα ξένια, συμφορὰν μαθών,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:755.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:755.1.text#ἀλλ', εἴ τι μὴ φέροιμεν, ὤτρυνεν φέρειν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:756.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:756.1.text#ποτῆρα δ' ἐν χείρεσσι κίσσινον λαβὼν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:757.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:757.1.text#πίνει μελαίνης μητρὸς εὔζωρον μέθυ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:758.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:758.1.text#ἕως ἐθέρμην' αὐτὸν ἀμφιβᾶσα φλὸξ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:759.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:759.1.text#οἴνου· στέφει δὲ κρᾶτα μυρσίνης κλάδοις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:760.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:760.1.text#ἄμουσ' ὑλακτῶν· δισσὰ δ' ἦν μέλη κλύειν·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:761.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:761.1.text#ὃ μὲν γὰρ ᾖδε, τῶν ἐν Ἀδμήτου κακῶν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:762.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:762.1.text#οὐδὲν προτιμῶν, οἰκέται δ' ἐκλαίομεν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:763.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:763.1.text#δέσποιναν· ὄμμα δ' οὐκ ἐδείκνυμεν ξένῳ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:764.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:764.1.text#τέγγοντες· Ἄδμητος γὰρ ὧδ' ἐφίετο.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:765.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:765.1.text#καὶ νῦν ἐγὼ μὲν ἐν δόμοισιν ἑστιῶ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:766.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:766.1.text#ξένον, πανοῦργον κλῶπα καὶ λῃστήν τινα,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:767.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:767.1.text#ἣ δ' ἐκ δόμων βέβηκεν, οὐδ' ἐφεσπόμην
urn:cts:greekLit:tlg0006.tlg002.fu.sp:768.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:768.1.text#οὐδ' ἐξέτεινα χεῖρ', ἀποιμώζων ἐμὴν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:769.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:769.1.text#δέσποιναν, ἣ 'μοὶ πᾶσί τ' οἰκέταισιν ἦν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:770.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:770.1.text#μήτηρ· κακῶν γὰρ μυρίων ἐρρύετο,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:771.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:771.1.text#ὀργὰς μαλάσσουσ' ἀνδρός. ἆρα τὸν ξένον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:772.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:772.1.text#στυγῶ δικαίως, ἐν κακοῖς ἀφιγμένον;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:773.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:773.1.text#οὗτος, τί σεμνὸν καὶ πεφροντικὸς βλέπεις;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:774.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:774.1.text#οὐ χρὴ σκυθρωπὸν τοῖς ξένοις τὸν πρόσπολον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:775.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:775.1.text#εἶναι, δέχεσθαι δ' εὐπροσηγόρῳ φρενί.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:776.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:776.1.text#σὺ δ' ἄνδρ' ἑταῖρον δεσπότου παρόνθ' ὁρῶν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:777.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:777.1.text#στυγνῷ προσώπῳ καὶ συνωφρυωμένῳ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:778.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:778.1.text#δέχῃ, θυραίου πήματος σπουδὴν ἔχων.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:779.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:779.1.text#δεῦρ' ἔλθ', ὅπως ἂν καὶ σοφώτερος γένῃ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:780.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:780.1.text#τὰ θνητὰ πράγματ' οἶδας ἣν ἔχει φύσιν;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:781.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:781.1.text#οἶμαι μὲν οὔ· πόθεν γάρ; ἀλλ' ἄκουέ μου.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:782.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:782.1.text#βροτοῖς ἅπασι κατθανεῖν ὀφείλεται,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:783.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:783.1.text#κοὐκ ἔστι θνητῶν ὅστις ἐξεπίσταται
urn:cts:greekLit:tlg0006.tlg002.fu.sp:784.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:784.1.text#τὴν αὔριον μέλλουσαν εἰ βιώσεται·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:785.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:785.1.text#τὸ τῆς τύχης γὰρ ἀφανὲς οἷ προβήσεται,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:786.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:786.1.text#κἄστ' οὐ διδακτὸν οὐδ' ἁλίσκεται τέχνῃ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:787.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:787.1.text#ταῦτ' οὖν ἀκούσας καὶ μαθὼν ἐμοῦ πάρα,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:788.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:788.1.text#εὔφραινε σαυτόν, πῖνε, τὸν καθ' ἡμέραν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:789.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:789.1.text#βίον λογίζου σόν, τὰ δ' ἄλλα τῆς τύχης.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:790.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:790.1.text#τίμα δὲ καὶ τὴν πλεῖστον ἡδίστην θεῶν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:791.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:791.1.text#Κύπριν βροτοῖσιν· εὐμενὴς γὰρ ἡ θεός.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:792.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:792.1.text#τὰ δ' ἄλλ' ἔασον ταῦτα καὶ πιθοῦ λόγοις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:793.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:793.1.text#ἐμοῖσιν—εἴπερ ὀρθά σοι δοκῶ λέγειν;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:794.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:794.1.text#οἶμαι μέν. οὔκουν τὴν ἄγαν λύπην ἀφεὶς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:795.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:795.1.text#πίῃ μεθ' ἡμῶν τάσδ' ὑπερβαλὼν τύχας,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:796.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:796.1.text#στεφάνοις πυκασθείς; καὶ σάφ' οἶδ' ὁθούνεκα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:797.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:797.1.text#τοῦ νῦν σκυθρωποῦ καὶ ξυνεστῶτος φρενῶν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:798.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:798.1.text#μεθορμιεῖ σε πίτυλος ἐμπεσὼν σκύφου.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:799.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:799.1.text#ὄντας δὲ θνητοὺς θνητὰ καὶ φρονεῖν χρεών·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:800.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:800.1.text#ὡς τοῖς γε σεμνοῖς καὶ συνωφρυωμένοις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:801.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:801.1.text#ἅπασίν ἐστιν, ὥς γ' ἐμοὶ χρῆσθαι κριτῇ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:802.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:802.1.text#οὐ βίος ἀληθῶς ὁ βίος, ἀλλὰ συμφορά.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:803.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:803.1.text#ἐπιστάμεσθα ταῦτα· νῦν δὲ πράσσομεν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:804.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:804.1.text#οὐχ οἷα κώμου καὶ γέλωτος ἄξια.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:805.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:805.1.text#γυνὴ θυραῖος ἡ θανοῦσα· μὴ λίαν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:806.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:806.1.text#πένθει· δόμων γὰρ ζῶσι τῶνδε δεσπόται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:807.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:807.1.text#τί ζῶσιν; οὐ κάτοισθα τἀν δόμοις κακά;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:808.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:808.1.text#εἰ μή τι σός με δεσπότης ἐψεύσατο.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:809.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:809.1.text#ἄγαν ἐκεῖνός ἐστ' ἄγαν φιλόξενος.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:810.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:810.1.text#οὐ χρῆν μ' ὀθνείου γ' οὕνεκ' εὖ πάσχειν νεκροῦ;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:811.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:811.1.text#ἦ κάρτα μέντοι καὶ λίαν θυραῖος ἦν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:812.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:812.1.text#μῶν ξυμφοράν τιν' οὖσαν οὐκ ἔφραζέ μοι;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:813.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:813.1.text#χαίρων ἴθ'· ἡμῖν δεσποτῶν μέλει κακά.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:814.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:814.1.text#ὅδ' οὐ θυραίων πημάτων ἄρχει λόγος.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:815.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:815.1.text#οὐ γάρ τι κωμάζοντ' ἂν ἠχθόμην σ' ὁρῶν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:816.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:816.1.text#ἀλλ' ἦ πέπονθα δείν' ὑπὸ ξένων ἐμῶν;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:817.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:817.1.text#οὐκ ἦλθες ἐν δέοντι δέξασθαι δόμοις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:818.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:818.1.text#πένθος γὰρ ἡμῖν ἐστι· καὶ στολμοὺς βλέπεις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:819.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:819.1.text#μελαμπέπλους κουράν τε.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:819.2.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:819.2.text#τίς δ' ὁ κατθανών;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:820.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:820.1.text#μῶν ἢ τέκνων τι φροῦδον ἢ γέρων πατήρ;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:821.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:821.1.text#γυνὴ μὲν οὖν ὄλωλεν Ἀδμήτου, ξένε.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:822.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:822.1.text#τί φῄς; ἔπειτα δῆτά μ' ἐξενίζετε;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:823.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:823.1.text#ᾐδεῖτο γάρ σε τῶνδ' ἀπώσασθαι δόμων.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:824.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:824.1.text#ὦ σχέτλι', οἵας ἤμπλακες ξυναόρου.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:825.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:825.1.text#ἀπωλόμεσθα πάντες, οὐ κείνη μόνη.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:826.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:826.1.text#ἀλλ' ᾐσθόμην μὲν ὄμμ' ἰδὼν δακρυρροοῦν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:827.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:827.1.text#κουράν τε καὶ πρόσωπον· ἀλλ' ἔπειθέ με
urn:cts:greekLit:tlg0006.tlg002.fu.sp:828.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:828.1.text#λέγων θυραῖον κῆδος ἐς τάφον φέρειν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:829.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:829.1.text#βίᾳ δὲ θυμοῦ τάσδ' ὑπερβαλὼν πύλας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:830.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:830.1.text#ἔπινον ἀνδρὸς ἐν φιλοξένου δόμοις,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:831.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:831.1.text#πράσσοντος οὕτω. κᾆτ' ἐκώμαζον κάρα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:832.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:832.1.text#στεφάνοις πυκασθείς; ἀλλὰ σοῦ τὸ μὴ φράσαι,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:833.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:833.1.text#κακοῦ τοσούτου δώμασιν προκειμένου.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:834.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:834.1.text#ποῦ καί σφε θάπτει; ποῦ νιν εὑρήσω μολών;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:835.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:835.1.text#ὀρθὴν παρ' οἶμον, ἣ 'πὶ Λάρισαν φέρει,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:836.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:836.1.text#τύμβον κατόψῃ ξεστὸν ἐκ προαστίου.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:837.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:837.1.text#ὦ πολλὰ τλᾶσα καρδία καὶ χεὶρ ἐμή,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:838.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:838.1.text#νῦν δεῖξον οἷον παῖδά σ' ἡ Τιρυνθία
urn:cts:greekLit:tlg0006.tlg002.fu.sp:839.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:839.1.text#Ἠλεκτρύωνος γείνατ' Ἀλκμήνη Διί.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:840.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:840.1.text#δεῖ γάρ με σῶσαι τὴν θανοῦσαν ἀρτίως
urn:cts:greekLit:tlg0006.tlg002.fu.sp:841.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:841.1.text#γυναῖκα κἀς τόνδ' αὖθις ἱδρῦσαι δόμον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:842.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:842.1.text#Ἄλκηστιν, Ἀδμήτῳ θ' ὑπουργῆσαι χάριν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:843.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:843.1.text#ἐλθὼν δ' ἄνακτα τὸν μελάμπεπλον νεκρῶν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:844.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:844.1.text#Θάνατον φυλάξω, καί νιν εὑρήσειν δοκῶ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:845.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:845.1.text#πίνοντα τύμβου πλησίον προσφαγμάτων.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:846.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:846.1.text#κἄνπερ λοχαίας αὐτὸν ἐξ ἕδρας συθεὶς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:847.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:847.1.text#μάρψω, κύκλον δὲ περιβάλω χεροῖν ἐμαῖν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:848.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:848.1.text#οὐκ ἔστιν ὅστις αὐτὸν ἐξαιρήσεται
urn:cts:greekLit:tlg0006.tlg002.fu.sp:849.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:849.1.text#μογοῦντα πλευρά, πρὶν γυναῖκ' ἐμοὶ μεθῇ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:850.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:850.1.text#ἢν δ' οὖν ἁμάρτω τῆσδ' ἄγρας, καὶ μὴ μόλῃ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:851.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:851.1.text#πρὸς αἱματηρὸν πέλανον, εἶμι τῶν κάτω
urn:cts:greekLit:tlg0006.tlg002.fu.sp:852.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:852.1.text#Κόρης Ἄνακτός τ' εἰς ἀνηλίους δόμους
urn:cts:greekLit:tlg0006.tlg002.fu.sp:853.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:853.1.text#αἰτήσομαί τε· καὶ πέποιθ' ἄξειν ἄνω
urn:cts:greekLit:tlg0006.tlg002.fu.sp:854.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:854.1.text#Ἄλκηστιν, ὥστε χερσὶν ἐνθεῖναι ξένου,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:855.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:855.1.text#ὅς μ' ἐς δόμους ἐδέξατ' οὐδ' ἀπήλασε,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:856.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:856.1.text#καίπερ βαρείᾳ συμφορᾷ πεπληγμένος,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:857.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:857.1.text#ἔκρυπτε δ' ὢν γενναῖος, αἰδεσθεὶς ἐμέ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:858.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:858.1.text#τίς τοῦδε μᾶλλον Θεσσαλῶν φιλόξενος,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:859.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:859.1.text#τίς Ἑλλάδ' οἰκῶν; τοιγὰρ οὐκ ἐρεῖ κακὸν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:860.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:860.1.text#εὐεργετῆσαι φῶτα γενναῖος γεγώς.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:861.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:861.1.text#ἰώ, στυγναὶ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:861.2.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:861.2.text#πρόσοδοι, στυγναὶ δ' ὄψεις χήρων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:862.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:862.1.text#μελάθρων.  ἰώ μοί μοι. αἶ αἶ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:863.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:863.1.text#ποῖ βῶ; ποῖ στῶ; τί λέγω; τί δὲ μή;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:864.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:864.1.text#πῶς ἂν ὀλοίμαν;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:865.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:865.1.text#ἦ βαρυδαίμονα μήτηρ μ' ἔτεκεν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:866.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:866.1.text#ζηλῶ φθιμένους, κείνων ἔραμαι,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:867.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:867.1.text#κεῖν' ἐπιθυμῶ δώματα ναίειν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:868.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:868.1.text#οὔτε γὰρ αὐγὰς χαίρω προσορῶν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:869.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:869.1.text#οὔτ' ἐπὶ γαίας πόδα πεζεύων·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:870.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:870.1.text#τοῖον ὅμηρόν μ' ἀποσυλήσας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:871.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:871.1.text#Ἅιδῃ Θάνατος παρέδωκεν. [ … ]
urn:cts:greekLit:tlg0006.tlg002.fu.sp:872.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:872.1.text#—πρόβα, πρόβα· βᾶθι κεῦθος οἴκων.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:872.2.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:872.2.text#αἰαῖ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:873.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:873.1.text#—πέπονθας ἄξι' αἰαγμάτων.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:873.2.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:873.2.text#ἒ ἔ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:874.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:874.1.text#—δι' ὀδύνας ἔβας, σάφ' οἶδα . . .
urn:cts:greekLit:tlg0006.tlg002.fu.sp:874.2.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:874.2.text#φεῦ φεῦ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:875.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:875.1.text#—τὰν νέρθε δ' οὐδὲν ὠφελεῖς.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:875.2.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:875.2.text#ἰώ μοί μοι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:876.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:876.1.text#—τὸ μήποτ' εἰσιδεῖν φιλίας ἀλόχου
urn:cts:greekLit:tlg0006.tlg002.fu.sp:877.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:877.1.text#πρόσωπόν ἄντα λυπρόν. [ … ]
urn:cts:greekLit:tlg0006.tlg002.fu.sp:878.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:878.1.text#ἔμνησας ὅ μου φρένας ἥλκωσεν·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:879.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:879.1.text#τί γὰρ ἀνδρὶ κακὸν μεῖζον ἁμαρτεῖν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:880.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:880.1.text#πιστῆς ἀλόχου; μή ποτε γήμας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:881.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:881.1.text#ὤφελον οἰκεῖν μετὰ τῆσδε δόμους.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:882.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:882.1.text#ζηλῶ δ' ἀγάμους ἀτέκνους τε βροτῶν·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:883.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:883.1.text#μία γὰρ ψυχή, τῆς ὑπεραλγεῖν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:884.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:884.1.text#μέτριον ἄχθος·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:885.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:885.1.text#παίδων δὲ νόσους καὶ νυμφιδίους
urn:cts:greekLit:tlg0006.tlg002.fu.sp:886.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:886.1.text#εὐνὰς θανάτοις κεραϊζομένας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:887.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:887.1.text#οὐ τλητὸν ὁρᾶν, ἐξὸν ἀτέκνους
urn:cts:greekLit:tlg0006.tlg002.fu.sp:888.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:888.1.text#ἀγάμους τ' εἶναι διὰ παντός.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:889.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:889.1.text#—τύχα τύχα δυσπάλαιστος ἥκει·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:889.2.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:889.2.text#αἰαῖ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:890.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:890.1.text#—πέρας δέ γ' οὐδὲν ἀλγέων τίθης.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:890.2.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:890.2.text#ἒ ἔ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:891.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:891.1.text#—βαρέα μὲν φέρειν, ὅμως δὲ . . .
urn:cts:greekLit:tlg0006.tlg002.fu.sp:891.2.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:891.2.text#φεῦ φεῦ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:892.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:892.1.text#—τλᾶθ'· οὐ σὺ πρῶτος ὤλεσας . . .
urn:cts:greekLit:tlg0006.tlg002.fu.sp:892.2.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:892.2.text#ἰώ μοί μοι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:893.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:893.1.text#—γυναῖκα· συμφορὰ δ' ἑτέρους ἑτέρα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:894.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:894.1.text#πιέζει φανεῖσα θνατῶν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:895.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:895.1.text#ὦ μακρὰ πένθη λῦπαί τε φίλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:896.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:896.1.text#τῶν ὑπὸ γαῖαν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:897.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:897.1.text#τί μ' ἐκώλυσας ῥῖψαι τύμβου
urn:cts:greekLit:tlg0006.tlg002.fu.sp:898.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:898.1.text#τάφρον ἐς κοίλην καὶ μετ' ἐκείνης
urn:cts:greekLit:tlg0006.tlg002.fu.sp:899.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:899.1.text#τῆς μέγ' ἀρίστης κεῖσθαι φθίμενον;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:900.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:900.1.text#δύο δ' ἀντὶ μιᾶς Ἅιδης ψυχὰς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:901.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:901.1.text#τὰς πιστοτάτας σὺν ἂν ἔσχεν, ὁμοῦ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:902.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:902.1.text#χθονίαν λίμνην διαβάντε.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:903.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:903.1.text#ἐμοί τις ἦν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:904.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:904.1.text#ἐν γένει, ᾧ κόρος ἀξιόθρηνος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:905.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:905.1.text#ὤλετ' ἐν δόμοισιν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:906.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:906.1.text#μονόπαις· ἀλλ' ἔμπας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:907.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:907.1.text#ἔφερε κακὸν ἅλις, ἄτεκνος ὤν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:908.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:908.1.text#πολιὰς ἐπὶ χαίτας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:909.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:909.1.text#ἤδη προπετὴς ὢν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:910.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:910.1.text#βιότου τε πόρσω.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:912.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:912.1.text#ὦ σχῆμα δόμων, πῶς εἰσέλθω;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:913.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:913.1.text#πῶς δ' οἰκήσω μεταπίπτοντος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:914.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:914.1.text#δαίμονος; οἴμοι. πολὺ γὰρ τὸ μέσον·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:915.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:915.1.text#τότε μὲν πεύκαις σὺν Πηλιάσιν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:916.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:916.1.text#σύν θ' ὑμεναίοις ἔστειχον ἔσω,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:917.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:917.1.text#φιλίας ἀλόχου χέρα βαστάζων,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:918.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:918.1.text#πολυάχητος δ' εἵπετο κῶμος,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:919.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:919.1.text#τήν τε θανοῦσαν κἄμ' ὀλβίζων,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:920.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:920.1.text#ὡς εὐπατρίδαι καὶ ἀπ' ἀμφοτέρων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:921.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:921.1.text#ὄντες ἀρίστων σύζυγες εἶμεν·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:922.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:922.1.text#νῦν δ' ὑμεναίων γόος ἀντίπαλος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:923.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:923.1.text#λευκῶν τε πέπλων μέλανες στολμοὶ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:924.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:924.1.text#πέμπουσί μ' ἔσω
urn:cts:greekLit:tlg0006.tlg002.fu.sp:925.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:925.1.text#λέκτρων κοίτας ἐς ἐρήμους.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:926.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:926.1.text#παρ' εὐτυχῆ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:927.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:927.1.text#σοὶ πότμον ἦλθεν ἀπειροκάκῳ τόδ'
urn:cts:greekLit:tlg0006.tlg002.fu.sp:928.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:928.1.text#ἄλγος· ἀλλ' ἔσωσας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:929.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:929.1.text#βίοτον καὶ ψυχάν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:930.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:930.1.text#ἔθανε δάμαρ, ἔλιπε φιλίαν·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:931.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:931.1.text#τί νέον τόδε; πολλοῖς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:932.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:932.1.text#ἤδη παρέλυσεν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:933.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:933.1.text#θάνατος δάμαρτας.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:935.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:935.1.text#φίλοι, γυναικὸς δαίμον' εὐτυχέστερον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:936.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:936.1.text#τοὐμοῦ νομίζω, καίπερ οὐ δοκοῦνθ' ὅμως·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:937.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:937.1.text#τῆς μὲν γὰρ οὐδὲν ἄλγος ἅψεταί ποτε,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:938.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:938.1.text#πολλῶν δὲ μόχθων εὐκλεὴς ἐπαύσατο.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:939.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:939.1.text#ἐγὼ δ', ὃν οὐ χρῆν ζῆν, παρεὶς τὸ μόρσιμον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:940.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:940.1.text#λυπρὸν διάξω βίοτον· ἄρτι μανθάνω.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:941.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:941.1.text#πῶς γὰρ δόμων τῶνδ' εἰσόδους ἀνέξομαι;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:942.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:942.1.text#τίν' ἂν προσειπών, τοῦ δὲ προσρηθεὶς ὕπο,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:943.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:943.1.text#τερπνῆς τύχοιμ' ἂν ἐξόδου; ποῖ τρέψομαι;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:944.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:944.1.text#ἡ μὲν γὰρ ἔνδον ἐξελᾷ μ' ἐρημία,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:945.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:945.1.text#γυναικὸς εὐνὰς εὖτ' ἂν εἰσίδω κενὰς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:946.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:946.1.text#θρόνους τ' ἐν οἷσιν ἷζε, καὶ κατὰ στέγας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:947.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:947.1.text#αὐχμηρὸν οὖδας, τέκνα δ' ἀμφὶ γούνασι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:948.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:948.1.text#πίπτοντα κλαίῃ μητέρ', οἳ δὲ δεσπότιν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:949.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:949.1.text#στένωσιν οἵαν ἐκ δόμων ἀπώλεσαν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:950.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:950.1.text#τὰ μὲν κατ' οἴκους τοιάδ'· ἔξωθεν δέ με
urn:cts:greekLit:tlg0006.tlg002.fu.sp:951.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:951.1.text#γάμοι τ' ἐλῶσι Θεσσαλῶν καὶ ξύλλογοι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:952.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:952.1.text#γυναικοπληθεῖς· οὐ γὰρ ἐξανέξομαι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:953.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:953.1.text#λεύσσων δάμαρτος τῆς ἐμῆς ὁμήλικας.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:954.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:954.1.text#ἐρεῖ δέ μ' ὅστις ἐχθρὸς ὢν κυρεῖ τάδε·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:955.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:955.1.text#Ἰδοῦ τὸν αἰσχρῶς ζῶνθ', ὃς οὐκ ἔτλη θανεῖν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:956.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:956.1.text#ἀλλ' ἣν ἔγημεν ἀντιδοὺς ἀψυχίᾳ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:957.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:957.1.text#πέφευγεν Ἅιδην· εἶτ' ἀνὴρ εἶναι δοκεῖ;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:958.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:958.1.text#στυγεῖ δὲ τοὺς τεκόντας, αὐτὸς οὐ θέλων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:959.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:959.1.text#θανεῖν. τοιάνδε πρὸς κακοῖσι κληδόνα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:960.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:960.1.text#ἕξω. τί μοι ζῆν δῆτα κέρδιον, φίλοι,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:961.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:961.1.text#κακῶς κλύοντι καὶ κακῶς πεπραγότι; [ … ]
urn:cts:greekLit:tlg0006.tlg002.fu.sp:962.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:962.1.text#ἐγὼ καὶ διὰ μούσας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:963.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:963.1.text#καὶ μετάρσιος ᾖξα, καὶ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:964.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:964.1.text#πλείστων ἁψάμενος λόγων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:965.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:965.1.text#κρεῖσσον οὐδὲν Ἀνάγκας
urn:cts:greekLit:tlg0006.tlg002.fu.sp:966.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:966.1.text#ηὗρον, οὐδέ τι φάρμακον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:967.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:967.1.text#Θρῄσσαις ἐν σανίσιν, τὰς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:968.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:968.1.text#Ὀρφεία κατέγραψεν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:970.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:970.1.text#γῆρυς, οὐδ' ὅσα Φοῖβος Ἀσκληπιάδαις ἔδωκε
urn:cts:greekLit:tlg0006.tlg002.fu.sp:971.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:971.1.text#φάρμακα πολυπόνοις ἀντιτεμὼν βροτοῖσιν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:973.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:973.1.text#μόνας δ' οὔτ' ἐπὶ βωμοὺς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:974.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:974.1.text#ἔστιν οὔτε βρέτας θεᾶς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:975.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:975.1.text#ἐλθεῖν, οὐ σφαγίων κλύει.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:976.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:976.1.text#μή μοι, πότνια, μείζων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:977.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:977.1.text#ἔλθοις ἢ τὸ πρὶν ἐν βίῳ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:978.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:978.1.text#καὶ γὰρ Ζεὺς ὅ τι νεύσῃ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:979.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:979.1.text#σὺν σοὶ τοῦτο τελευτᾷ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:980.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:980.1.text#καὶ τὸν ἐν Χαλύβοις δαμάζεις σὺ βίᾳ σίδαρον,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:981.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:981.1.text#οὐδέ τις ἀποτόμου λήματός ἐστιν αἰδώς.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:984.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:984.1.text#καὶ σ' ἐν ἀφύκτοισι χερῶν εἷλε θεὰ δεσμοῖς.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:985.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:985.1.text#τόλμα δ'· οὐ γὰρ ἀνάξεις ποτ' ἔνερθεν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:986.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:986.1.text#κλαίων τοὺς φθιμένους ἄνω.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:987.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:987.1.text#καὶ θεῶν σκότιοι φθίνουσι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:990.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:990.1.text#παῖδες ἐν θανάτῳ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:991.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:991.1.text#φίλα μὲν ὅτ' ἦν μεθ' ἡμῶν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:992.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:992.1.text#φίλα δὲ { καὶ θανοῦσ' ἔσται, }
urn:cts:greekLit:tlg0006.tlg002.fu.sp:994.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:994.1.text#γενναιοτάταν δὲ πασᾶν ἐζεύξω κλισίαις ἄκοιτιν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:995.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:995.1.text#μηδὲ νεκρῶν ὡς φθιμένων χῶμα νομιζέσθω
urn:cts:greekLit:tlg0006.tlg002.fu.sp:996.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:996.1.text#τύμβος σᾶς ἀλόχου, θεοῖσι δ' ὁμοίως
urn:cts:greekLit:tlg0006.tlg002.fu.sp:997.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:997.1.text#τιμάσθω, σέβας ἐμπόρων.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1000.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1000.1.text#καί τις δοχμίαν κέλευθον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1001.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1001.1.text#ἐκβαίνων τόδ' ἐρεῖ·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1002.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1002.1.text#Αὕτα ποτὲ προύθαν' ἀνδρός,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1003.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1003.1.text#νῦν δ' ἐστὶ μάκαιρα δαίμων·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1004.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1004.1.text#χαῖρ', ὦ πότνι', εὖ δὲ δοίης. τοῖαί νιν προσεροῦσι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1005.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1005.1.text#φῆμαι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1006.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1006.1.text#—καὶ μὴν ὅδ', ὡς ἔοικεν, Ἀλκμήνης γόνος,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1007.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1007.1.text#Ἄδμητε, πρὸς σὴν ἑστίαν πορεύεται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1008.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1008.1.text#φίλον πρὸς ἄνδρα χρὴ λέγειν ἐλευθέρως,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1009.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1009.1.text#Ἄδμητε, μομφὰς δ' οὐχ ὑπὸ σπλάγχνοις ἔχειν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1010.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1010.1.text#σιγῶντ'. ἐγὼ δὲ σοῖς κακοῖσιν ἠξίουν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1011.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1011.1.text#ἐγγὺς παρεστὼς ἐξετάζεσθαι φίλος·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1012.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1012.1.text#σὺ δ' οὐκ ἔφραζες σῆς προκείμενον νέκυν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1013.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1013.1.text#γυναικός, ἀλλά μ' ἐξένιζες ἐν δόμοις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1014.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1014.1.text#ὡς δὴ θυραίου πήματος σπουδὴν ἔχων.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1015.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1015.1.text#κἄστεψα κρᾶτα καὶ θεοῖς ἐλειψάμην
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1016.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1016.1.text#σπονδὰς ἐν οἴκοις δυστυχοῦσι τοῖσι σοῖς.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1017.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1017.1.text#καὶ μέμφομαι μέν, μέμφομαι, παθὼν τάδε,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1018.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1018.1.text#οὐ μήν σε λυπεῖν ἐν κακοῖσι βούλομαι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1019.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1019.1.text#ὧν δ' οὕνεχ' ἥκω δεῦρ' ὑποστρέψας πάλιν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1020.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1020.1.text#λέξω. γυναῖκα τήνδε μοι σῷσον λαβών,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1021.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1021.1.text#ἕως ἂν ἵππους δεῦρο Θρῃκίας ἄγων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1022.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1022.1.text#ἔλθω, τύραννον Βιστόνων κατακτανών.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1023.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1023.1.text#πράξας δ' ὃ μὴ τύχοιμι—νοστήσαιμι γάρ—
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1024.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1024.1.text#τήνδε σοῖσι προσπολεῖν δόμοις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1025.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1025.1.text#πολλῷ δὲ μόχθῳ χεῖρας ἦλθεν εἰς ἐμάς·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1026.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1026.1.text#ἀγῶνα γὰρ πάνδημον εὑρίσκω τινὰς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1027.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1027.1.text#τιθέντας, ἀθληταῖσιν ἄξιον πόνον,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1028.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1028.1.text#ὅθεν κομίζω τήνδε νικητήρια
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1029.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1029.1.text#λαβών· τὰ μὲν γὰρ κοῦφα τοῖς νικῶσιν ἦν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1030.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1030.1.text#ἵππους ἄγεσθαι, τοῖσι δ' αὖ τὰ μείζονα
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1031.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1031.1.text#νικῶσι, πυγμὴν καὶ πάλην, βουφόρβια·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1032.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1032.1.text#γυνὴ δ' ἐπ' αὐτοῖς εἵπετ'· ἐντυχόντι δὲ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1033.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1033.1.text#αἰσχρὸν παρεῖναι κέρδος ἦν τόδ' εὐκλεές.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1034.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1034.1.text#ἀλλ', ὥσπερ εἶπον, σοὶ μέλειν γυναῖκα χρή·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1035.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1035.1.text#οὐ γὰρ κλοπαίαν, ἀλλὰ σὺν πόνῳ λαβὼν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1036.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1036.1.text#ἥκω· χρόνῳ δὲ καὶ σύ μ' αἰνέσεις ἴσως.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1037.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1037.1.text#οὔτοι σ' ἀτίζων οὐδ' ἐν αἰσχροῖσιν τιθεὶς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1038.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1038.1.text#ἔκρυψ' ἐμῆς γυναικὸς ἀθλίου τύχας·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1039.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1039.1.text#ἀλλ' ἄλγος ἄλγει τοῦτ' ἂν ἦν προσκείμενον,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1040.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1040.1.text#εἴ του πρὸς ἄλλου δώμαθ' ὡρμήθης ξένου·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1041.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1041.1.text#ἅλις δὲ κλαίειν τοὐμὸν ἦν ἐμοὶ κακόν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1042.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1042.1.text#γυναῖκα δ', εἴ πως ἔστιν, αἰτοῦμαί σ', ἄναξ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1043.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1043.1.text#ἄλλον τιν' ὅστις μὴ πέπονθεν οἷ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1044.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1044.1.text#σῴζειν ἄνωχθι Θεσσαλῶν· πολλοὶ δέ σοι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1045.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1045.1.text#ξένοι Φεραίων· μή μ' ἀναμνήσῃς κακῶν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1046.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1046.1.text#οὐκ ἂν δυναίμην τήνδ' ὁρῶν ἐν δώμασιν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1047.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1047.1.text#ἄδακρυς εἶναι· μὴ νοσοῦντί μοι νόσον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1048.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1048.1.text#προσθῇς· ἅλις γὰρ συμφορᾷ βαρύνομαι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1049.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1049.1.text#ποῦ καὶ τρέφοιτ' ἂν δωμάτων νέα γυνή;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1050.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1050.1.text#νέα γάρ, ὡς ἐσθῆτι καὶ κόσμῳ πρέπει.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1051.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1051.1.text#πότερα κατ' ἀνδρῶν δῆτ' ἐνοικήσει στέγην;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1052.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1052.1.text#καὶ πῶς ἀκραιφνὴς ἐν νέοις στρωφωμένη
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1053.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1053.1.text#ἔσται; τὸν ἡβῶνθ', Ἡράκλεις, οὐ ῥᾴδιον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1054.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1054.1.text#εἴργειν· ἐγὼ δὲ σοῦ προμηθίαν ἔχω.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1055.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1055.1.text#ἢ τῆς θανούσης θάλαμον ἐσβήσας τρέφω;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1056.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1056.1.text#καὶ πῶς ἐπεσφρῶ τήνδε τῷ κείνης λέχει;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1057.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1057.1.text#διπλῆν φοβοῦμαι μέμψιν, ἔκ τε δημοτῶν,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1058.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1058.1.text#μή τίς μ' ἐλέγξῃ τὴν ἐμὴν εὐεργέτιν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1059.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1059.1.text#προδόντ' ἐν ἄλλης δεμνίοις πίτνειν νέας,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1060.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1060.1.text#καὶ τῆς θανούσης· ἀξία δέ μοι σέβειν·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1061.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1061.1.text#πολλὴν πρόνοιαν δεῖ μ' ἔχειν. σὺ δ', ὦ γύναι,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1062.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1062.1.text#ἥτις ποτ' εἶ σύ, ταὔτ' ἔχουσ' Ἀλκήστιδι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1063.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1063.1.text#μορφῆς μέτρ' ἴσθι· καὶ προσήιξαι δέμας.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1064.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1064.1.text#οἴμοι. κόμιζε πρὸς θεῶν ἐξ ὀμμάτων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1065.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1065.1.text#γυναῖκα τήνδε, μή μ' ἕλῃς ᾑρημένον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1066.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1066.1.text#δοκῶ γὰρ αὐτὴν εἰσορῶν γυναῖχ' ὁρᾶν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1067.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1067.1.text#ἐμήν· θολοῖ δὲ καρδίαν, ἐκ δ' ὀμμάτων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1068.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1068.1.text#πηγαὶ κατερρώγασιν· ὦ τλήμων ἐγώ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1069.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1069.1.text#ὡς ἄρτι πένθους τοῦδε γεύομαι πικροῦ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1070.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1070.1.text#ἐγὼ μὲν οὐκ ἔχοιμ' ἂν εὖ λέγειν τύχην·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1071.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1071.1.text#χρὴ δ', ὅστις εἶ σύ, καρτερεῖν θεοῦ δόσιν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1072.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1072.1.text#εἰ γὰρ τοσαύτην δύναμιν εἶχον ὥστε σὴν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1073.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1073.1.text#ἐς φῶς πορεῦσαι νερτέρων ἐκ δωμάτων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1074.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1074.1.text#γυναῖκα καί σοι τήνδε πορσῦναι χάριν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1075.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1075.1.text#σάφ' οἶδα βούλεσθαί σ' ἄν. ἀλλὰ ποῦ τόδε;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1076.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1076.1.text#οὐκ ἔστι τοὺς θανόντας ἐς φάος μολεῖν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1077.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1077.1.text#μή νυν ὑπέρβαλλ', ἀλλ' ἐναισίμως φέρε.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1078.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1078.1.text#ῥᾷον παραινεῖν ἢ παθόντα καρτερεῖν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1079.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1079.1.text#τί δ' ἂν προκόπτοις, εἰ θέλοις ἀεὶ στένειν;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1080.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1080.1.text#ἔγνωκα καὐτός, ἀλλ' ἔρως τις ἐξάγει.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1081.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1081.1.text#τὸ γὰρ φιλῆσαι τὸν θανόντ' ἄγει δάκρυ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1082.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1082.1.text#ἀπώλεσέν με, κἄτι μᾶλλον ἢ λέγω.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1083.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1083.1.text#γυναικὸς ἐσθλῆς ἤμπλακες· τίς ἀντερεῖ;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1084.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1084.1.text#ὥστ' ἄνδρα τόνδε μηκέθ' ἥδεσθαι βίῳ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1085.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1085.1.text#χρόνος μαλάξει, νῦν δ' ἔθ' ἡβάσκει κακόν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1086.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1086.1.text#χρόνον λέγοις ἄν, εἰ χρόνος τὸ κατθανεῖν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1087.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1087.1.text#γυνή σε παύσει καὶ νέου γάμου πόθοι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1088.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1088.1.text#σίγησον· οἷον εἶπας. οὐκ ἂν ᾠόμην.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1089.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1089.1.text#τί δ'; οὐ γαμεῖς γάρ, ἀλλὰ χηρεύσῃ λέχος;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1090.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1090.1.text#οὐκ ἔστιν ἥτις τῷδε συγκλιθήσεται.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1091.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1091.1.text#μῶν τὴν θανοῦσαν ὠφελεῖν τι προσδοκᾷς;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1092.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1092.1.text#κείνην ὅπουπερ ἔστι τιμᾶσθαι χρεών.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1093.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1093.1.text#αἰνῶ μὲν αἰνῶ· μωρίαν δ' ὀφλισκάνεις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1094.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1094.1.text#ὡς μήποτ' ἄνδρα τόνδε νυμφίον καλῶν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1095.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1095.1.text#ἐπῄνεσ' ἀλόχῳ πιστὸς οὕνεκ' εἶ φίλος.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1096.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1096.1.text#θάνοιμ' ἐκείνην καίπερ οὐκ οὖσαν προδούς.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1097.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1097.1.text#δέχου νυν εἴσω τήνδε γενναίων δόμων.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1098.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1098.1.text#μή, πρός σε τοῦ σπείραντος ἄντομαι Διός.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1099.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1099.1.text#καὶ μὴν ἁμαρτήσῃ γε μὴ δράσας τάδε.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1100.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1100.1.text#καὶ δρῶν γε λύπῃ καρδίαν δηχθήσομαι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1101.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1101.1.text#πιθοῦ· τάχ' ἂν γὰρ ἐς δέον πέσοι χάρις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1102.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1102.1.text#φεῦ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1102.2.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1102.2.text#εἴθ' ἐξ ἀγῶνος τήνδε μὴ ῎λαβές ποτε.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1103.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1103.1.text#νικῶντι μέντοι καὶ σὺ συννικᾷς ἐμοί.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1104.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1104.1.text#καλῶς ἔλεξας· ἡ γυνὴ δ' ἀπελθέτω.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1105.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1105.1.text#ἄπεισιν, εἰ χρή· πρῶτα δ' εἰ χρεὼν ἄθρει.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1106.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1106.1.text#χρή, σοῦ γε μὴ μέλλοντος ὀργαίνειν ἐμοί.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1107.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1107.1.text#εἰδώς τι κἀγὼ τήνδ' ἔχω προθυμίαν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1108.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1108.1.text#νίκα νυν. οὐ μὴν ἁνδάνοντά μοι ποιεῖς.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1109.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1109.1.text#ἀλλ' ἔσθ' ὅθ' ἡμᾶς αἰνέσεις· πιθοῦ μόνον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1110.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1110.1.text#κομίζετ', εἰ χρὴ τήνδε δέξασθαι δόμοις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1111.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1111.1.text#οὐκ ἂν μεθείην τὴν γυναῖκα προσπόλοις.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1112.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1112.1.text#σὺ δ' αὐτὸς αὐτὴν εἴσαγ', εἰ βούλῃ, δόμους.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1113.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1113.1.text#ἐς σὰς μὲν οὖν ἔγωγε θήσομαι χέρας.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1114.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1114.1.text#οὐκ ἂν θίγοιμι· δῶμα δ' εἰσελθεῖν πάρα.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1115.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1115.1.text#τῇ σῇ πέποιθα χειρὶ δεξιᾷ μόνῃ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1116.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1116.1.text#ἄναξ, βιάζῃ μ' οὐ θέλοντα δρᾶν τάδε.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1117.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1117.1.text#τόλμα προτεῖναι χεῖρα καὶ θιγεῖν ξένης.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1118.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1118.1.text#καὶ δὴ προτείνω, Γοργόν' ὡς καρατομῶν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1119.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1119.1.text#ἔχεις;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1119.2.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1119.2.text#ἔχω; ναί.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1119.3.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1119.3.text#σῷζέ νυν, καὶ τὸν Διὸς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1120.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1120.1.text#φήσεις ποτ' εἶναι παῖδα γενναῖον ξένον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1121.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1121.1.text#βλέψον πρὸς αὐτήν, εἴ τι σῇ δοκεῖ πρέπειν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1122.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1122.1.text#γυναικί· λύπης δ' εὐτυχῶν μεθίστασο.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1123.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1123.1.text#ὦ θεοί, τί λέξω—θαῦμ' ἀνέλπιστον τόδε—
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1124.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1124.1.text#γυναῖκα λεύσσων τήνδ'; —ἐμὴν ἐτητύμως;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1125.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1125.1.text#ἢ κέρτομός με θεοῦ τις ἐκπλήσσει χαρά;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1126.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1126.1.text#οὐκ ἔστιν, ἀλλὰ τήνδ' ὁρᾷς δάμαρτα σήν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1127.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1127.1.text#ὅρα γε μή τι φάσμα νερτέρων τόδ' ᾖ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1128.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1128.1.text#οὐ ψυχαγωγὸν τόνδ' ἐποιήσω ξένον.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1129.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1129.1.text#ἀλλ' ἣν ἔθαπτον εἰσορῶ δάμαρτ' ἐμήν;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1130.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1130.1.text#σάφ' ἴσθ'. ἀπιστεῖν δ' οὔ σε θαυμάζω τύχην.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1131.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1131.1.text#θίγω, προσείπω ζῶσαν ὡς δάμαρτ' ἐμήν;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1132.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1132.1.text#πρόσειπ'. ἔχεις γὰρ πᾶν ὅσονπερ ἤθελες.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1133.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1133.1.text#ὦ φιλτάτης γυναικὸς ὄμμα καὶ δέμας,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1134.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1134.1.text#ἔχω σ' ἀέλπτως, οὔποτ' ὄψεσθαι δοκῶν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1135.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1135.1.text#ἔχεις· φθόνος δὲ μὴ γένοιτό τις θεῶν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1136.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1136.1.text#ὦ τοῦ μεγίστου Ζηνὸς εὐγενὲς τέκνον,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1137.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1137.1.text#εὐδαιμονοίης, καί σ' ὁ φιτύσας πατὴρ
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1138.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1138.1.text#σῴζοι· σὺ γὰρ δὴ τἄμ' ἀνώρθωσας μόνος.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1139.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1139.1.text#πῶς τήνδ' ἔπεμψας νέρθεν ἐς φάος τόδε;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1140.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1140.1.text#μάχην συνάψας δαιμόνων τῷ κυρίῳ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1141.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1141.1.text#ποῦ τόνδε Θανάτῳ φῂς ἀγῶνα συμβαλεῖν;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1142.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1142.1.text#τύμβον παρ' αὐτὸν ἐκ λόχου μάρψας χεροῖν.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1143.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1143.1.text#τί γάρ ποθ' ἥδ' ἄναυδος ἕστηκεν γυνή;
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1144.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1144.1.text#οὔπω θέμις σοι τῆσδε προσφωνημάτων
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1145.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1145.1.text#κλύειν, πρὶν ἂν θεοῖσι τοῖσι νερτέροις
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1146.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1146.1.text#ἀφαγνίσηται καὶ τρίτον μόλῃ φάος.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1147.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1147.1.text#ἀλλ' εἴσαγ' εἴσω τήνδε· καὶ δίκαιος ὢν
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1148.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1148.1.text#τὸ λοιπόν, Ἄδμητ', εὐσέβει περὶ ξένους.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1149.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1149.1.text#καὶ χαῖρ'· ἐγὼ δὲ τὸν προκείμενον πόνον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1150.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1150.1.text#Σθενέλου τυράννῳ παιδὶ πορσυνῶ μολών.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1151.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1151.1.text#μεῖνον παρ' ἡμῖν καὶ ξυνέστιος γενοῦ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1152.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1152.1.text#αὖθις τόδ' ἔσται, νῦν δ' ἐπείγεσθαί με δεῖ.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1153.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1153.1.text#ἀλλ' εὐτυχοίης, νόστιμον δ' ἔλθοις { δόμον. }
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1154.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1154.1.text#ἀστοῖς δὲ πάσῃ τ' ἐννέπω τετραρχίᾳ,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1155.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1155.1.text#χοροὺς ἐπ' ἐσθλαῖς συμφοραῖσιν ἱστάναι
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1156.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1156.1.text#βωμούς τε κνισᾶν βουθύτοισι προστροπαῖς.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1157.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1157.1.text#νῦν γὰρ μεθηρμόσμεσθα βελτίω βίον
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1158.1.speaker#Ἄδμητος
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1158.1.text#τοῦ πρόσθεν· οὐ γὰρ εὐτυχῶν ἀρνήσομαι.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1159.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1159.1.text#πολλαὶ μορφαὶ τῶν δαιμονίων,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1160.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1160.1.text#πολλὰ δ' ἀέλπτως κραίνουσι θεοί·
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1161.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1161.1.text#καὶ τὰ δοκηθέντ' οὐκ ἐτελέσθη,
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1162.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1162.1.text#τῶν δ' ἀδοκήτων πόρον ηὗρε θεός.
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1163.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg002.fu.sp:1163.1.text#τοιόνδ' ἀπέβη τόδε πρᾶγμα. [ … ]
