#!ctsdata
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1.1.text#Ἄτλας, ὁ χαλκέοισι [ νώτοις οὐρανὸν ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:2.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:2.1.text#[ θεῶν παλαιὸν οἶκον ἐκτρίβων, θεῶν ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:3.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:3.1.text#[ μιᾶς ] ἔφυσε Μαῖαν, ἣ 'μ' ἐγείνατο
urn:cts:greekLit:tlg0006.tlg010.fu.sp:4.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:4.1.text#Ἑρμῆν μεγίστῳ Ζηνί, δαιμόνων λάτριν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:5.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:5.1.text#ἥκω δὲ Δελφῶν τήνδε γῆν, ἵν' ὀμφαλὸν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:6.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:6.1.text#μέσον καθίζων Φοῖβος ὑμνῳδεῖ βροτοῖς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:7.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:7.1.text#τά τ' ὄντα καὶ μέλλοντα θεσπίζων ἀεί.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:8.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:8.1.text#ἔστιν γὰρ οὐκ ἄσημος Ἑλλήνων πόλις,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:9.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:9.1.text#τῆς χρυσολόγχου Παλλάδος κεκλημένη,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:10.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:10.1.text#οὗ παῖδ' Ἐρεχθέως Φοῖβος ἔζευξεν γάμοις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:11.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:11.1.text#βίᾳ Κρέουσαν, ἔνθα προσβόρρους πέτρας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:12.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:12.1.text#Παλλάδος ὑπ' ὄχθῳ τῆς Ἀθηναίων χθονὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:13.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:13.1.text#Μακρὰς καλοῦσι γῆς ἄνακτες Ἀτθίδος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:14.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:14.1.text#ἀγνὼς δὲ πατρί — τῷ θεῷ γὰρ ἦν φίλον —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:15.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:15.1.text#γαστρὸς διήνεγκ' ὄγκον. ὡς δ' ἦλθεν χρόνος,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:16.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:16.1.text#τεκοῦσ' ἐν οἴκοις παῖδ' ἀπήνεγκεν βρέφος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:17.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:17.1.text#ἐς ταὐτὸν ἄντρον οὗπερ ηὐνάσθη θεῷ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:18.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:18.1.text#Κρέουσα, κἀκτίθησιν ὡς θανούμενον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:19.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:19.1.text#κοίλης ἐν ἀντίπηγος εὐτρόχῳ κύκλῳ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:20.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:20.1.text#προγόνων νόμον σῴζουσα τοῦ τε γηγενοῦς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:21.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:21.1.text#Ἐριχθονίου. κείνῳ γὰρ ἡ Διὸς κόρη
urn:cts:greekLit:tlg0006.tlg010.fu.sp:22.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:22.1.text#φρουρὼ παραζεύξασα φύλακε σώματος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:23.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:23.1.text#δισσὼ δράκοντε, παρθένοις Ἀγλαυρίσι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:24.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:24.1.text#δίδωσι σῴζειν· ὅθεν Ἐρεχθείδαις ἐκεῖ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:25.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:25.1.text#νόμος τις ἔστιν ὄφεσιν ἐν χρυσηλάτοις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:26.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:26.1.text#τρέφειν τέκνα. ἀλλ' ἣν εἶχε παρθένος χλιδὴν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:27.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:27.1.text#τέκνῳ προσάψασ' ἔλιπεν ὡς θανουμένῳ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:28.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:28.1.text#κἄμ' ὢν ἀδελφὸς Φοῖβος αἰτεῖται τάδε·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:29.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:29.1.text#ὦ σύγγον', ἐλθὼν λαὸν εἰς αὐτόχθονα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:30.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:30.1.text#κλεινῶν Ἀθηνῶν — οἶσθα γὰρ θεᾶς πόλιν —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:31.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:31.1.text#λαβὼν βρέφος νεογνὸν ἐκ κοίλης πέτρας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:32.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:32.1.text#αὐτῷ σὺν ἄγγει σπαργάνοισί θ' οἷς ἔχει
urn:cts:greekLit:tlg0006.tlg010.fu.sp:33.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:33.1.text#ἔνεγκε Δελφῶν τἀμὰ πρὸς χρηστήρια,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:34.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:34.1.text#καὶ θὲς πρὸς αὐταῖς εἰσόδοις δόμων ἐμῶν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:35.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:35.1.text#τὰ δ' ἄλλ' — ἐμὸς γάρ ἐστιν, ὡς εἰδῇς, ὁ παῖς —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:36.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:36.1.text#ἡμῖν μελήσει. Λοξίᾳ δ' ἐγὼ χάριν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:37.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:37.1.text#πράσσων ἀδελφῷ πλεκτὸν ἐξάρας κύτος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:38.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:38.1.text#ἤνεγκα, καὶ τὸν παῖδα κρηπίδων ἔπι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:39.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:39.1.text#τίθημι ναοῦ τοῦδ', ἀναπτύξας κύτος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:40.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:40.1.text#ἑλικτὸν ἀντίπηγος, ὡς ὁρῷθ' ὁ παῖς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:41.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:41.1.text#κυρεῖ δ' ἅμ' ἱππεύοντος ἡλίου κύκλῳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:42.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:42.1.text#προφῆτις ἐσβαίνουσα μαντεῖον θεοῦ·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:43.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:43.1.text#ὄψιν δὲ προσβαλοῦσα παιδὶ νηπίῳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:44.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:44.1.text#ἐθαύμασ' εἴ τις Δελφίδων τλαίη κόρη
urn:cts:greekLit:tlg0006.tlg010.fu.sp:45.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:45.1.text#λαθραῖον ὠδῖν' ἐς θεοῦ ῥῖψαι δόμον,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:46.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:46.1.text#ὑπέρ τε θυμέλας διορίσαι πρόθυμος ἦν·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:47.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:47.1.text#οἴκτῳ δ' ἀφῆκεν ὠμότητα — καὶ θεὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:48.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:48.1.text#συνεργὸς ἦν τῷ παιδὶ μὴ 'κπεσεῖν δόμων —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:49.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:49.1.text#τρέφει δέ νιν λαβοῦσα. τὸν σπείραντα δὲ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:50.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:50.1.text#οὐκ οἶδε Φοῖβον οὐδὲ μητέρ' ἧς ἔφυ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:51.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:51.1.text#ὁ παῖς τε τοὺς τεκόντας οὐκ ἐπίσταται.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:52.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:52.1.text#νέος μὲν οὖν ὢν ἀμφὶ βωμίους τροφὰς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:53.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:53.1.text#ἠλᾶτ' ἀθύρων· ὡς δ' ἀπηνδρώθη δέμας,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:54.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:54.1.text#Δελφοί σφ' ἔθεντο χρυσοφύλακα τοῦ θεοῦ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:55.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:55.1.text#ταμίαν τε πάντων πιστόν, ἐν δ' ἀνακτόροις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:56.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:56.1.text#θεοῦ καταζῇ δεῦρ' ἀεὶ σεμνὸν βίον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:57.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:57.1.text#Κρέουσα δ' ἡ τεκοῦσα τὸν νεανίαν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:58.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:58.1.text#Ξούθῳ γαμεῖται συμφορᾶς τοιᾶσδ' ὕπο·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:59.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:59.1.text#ἦν ταῖς Ἀθήναις τοῖς τε Χαλκωδοντίδαις,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:60.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:60.1.text#οἳ γῆν ἔχουσ' Εὐβοῖδα, πολέμιος κλύδων·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:61.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:61.1.text#ὃν συμπονήσας καὶ συνεξελὼν δορὶ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:62.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:62.1.text#γάμων Κρεούσης ἀξίωμ' ἐδέξατο,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:63.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:63.1.text#οὐκ ἐγγενὴς ὤν, Αἰόλου δὲ τοῦ Διὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:64.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:64.1.text#γεγὼς Ἀχαιός. χρόνια δὲ σπείρας λέχη
urn:cts:greekLit:tlg0006.tlg010.fu.sp:65.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:65.1.text#ἄτεκνός ἐστι, καὶ Κρέουσ'· ὧν οὕνεκα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:66.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:66.1.text#ἥκουσι πρὸς μαντεῖ' Ἀπόλλωνος τάδε
urn:cts:greekLit:tlg0006.tlg010.fu.sp:67.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:67.1.text#ἔρωτι παίδων. Λοξίας δὲ τὴν τύχην
urn:cts:greekLit:tlg0006.tlg010.fu.sp:68.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:68.1.text#ἐς τοῦτ' ἐλαύνει, κοὐ λέληθεν, ὡς δοκεῖ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:69.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:69.1.text#δώσει γὰρ εἰσελθόντι μαντεῖον τόδε
urn:cts:greekLit:tlg0006.tlg010.fu.sp:70.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:70.1.text#Ξούθῳ τὸν αὑτοῦ παῖδα, καὶ πεφυκέναι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:71.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:71.1.text#κείνου σφε φήσει, μητρὸς ὡς ἐλθὼν δόμους
urn:cts:greekLit:tlg0006.tlg010.fu.sp:72.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:72.1.text#γνωσθῇ Κρεούσῃ, καὶ γάμοι τε Λοξίου
urn:cts:greekLit:tlg0006.tlg010.fu.sp:73.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:73.1.text#κρυπτοὶ γένωνται παῖς τ' ἔχῃ τὰ πρόσφορα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:74.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:74.1.text#Ἴωνα δ' αὐτόν, κτίστορ' Ἀσιάδος χθονός,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:75.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:75.1.text#ὄνομα κεκλῆσθαι θήσεται καθ' Ἑλλάδα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:76.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:76.1.text#ἀλλ' ἐς δαφνώδη γύαλα βήσομαι τάδε,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:77.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:77.1.text#τὸ κρανθὲν ὡς ἂν ἐκμάθω παιδὸς πέρι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:78.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:78.1.text#ὁρῶ γὰρ ἐκβαίνοντα Λοξίου γόνον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:79.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:79.1.text#τόνδ', ὡς πρὸ ναοῦ λαμπρὰ θῇ πυλώματα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:80.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:80.1.text#δάφνης κλάδοισιν. ὄνομα δ', οὗ μέλλει τυχεῖν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:81.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:81.1.text#Ἴων' ἐγώ { νιν } πρῶτος ὀνομάζω θεῶν.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:82.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:82.1.text#ἅρματα μὲν τάδε λαμπρὰ τεθρίππων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:83.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:83.1.text#Ἥλιος ἤδη λάμπει κατὰ γῆν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:84.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:84.1.text#ἄστρα δὲ φεύγει πυρὶ τῷδ' αἰθέρος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:85.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:85.1.text#ἐς νύχθ' ἱεράν·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:86.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:86.1.text#Παρνησιάδες δ' ἄβατοι κορυφαὶ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:87.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:87.1.text#καταλαμπόμεναι τὴν ἡμερίαν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:88.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:88.1.text#ἁψῖδα βροτοῖσι δέχονται.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:89.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:89.1.text#σμύρνης δ' ἀνύδρου καπνὸς εἰς ὀρόφους
urn:cts:greekLit:tlg0006.tlg010.fu.sp:90.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:90.1.text#Φοίβου πέταται.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:91.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:91.1.text#θάσσει δὲ γυνὴ τρίποδα ζάθεον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:92.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:92.1.text#Δελφίς, ἀείδουσ' Ἕλλησι βοάς,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:93.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:93.1.text#ἃς ἂν Ἀπόλλων κελαδήσῃ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:94.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:94.1.text#ἀλλ', ὦ Φοίβου Δελφοὶ θέραπες,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:95.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:95.1.text#τὰς Κασταλίας ἀργυροειδεῖς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:96.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:96.1.text#βαίνετε δίνας, καθαραῖς δὲ δρόσοις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:97.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:97.1.text#ἀφυδρανάμενοι στείχετε ναούς·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:98.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:98.1.text#στόμα τ' εὔφημον φρουρεῖν ἀγαθόν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:99.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:99.1.text#φήμας τ' ἀγαθὰς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:100.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:100.1.text#τοῖς ἐθέλουσιν μαντεύεσθαι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:101.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:101.1.text#γλώσσης ἰδίας ἀποφαίνειν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:102.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:102.1.text#ἡμεῖς δέ, πόνους οὓς ἐκ παιδὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:103.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:103.1.text#μοχθοῦμεν ἀεί, πτόρθοισι δάφνης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:104.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:104.1.text#στέφεσίν θ' ἱεροῖς ἐσόδους Φοίβου
urn:cts:greekLit:tlg0006.tlg010.fu.sp:105.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:105.1.text#καθαρὰς θήσομεν, ὑγραῖς τε πέδον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:106.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:106.1.text#ῥανίσιν νοτερόν· πτηνῶν τ' ἀγέλας,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:107.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:107.1.text#αἳ βλάπτουσιν σέμν' ἀναθήματα,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:108.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:108.1.text#τόξοισιν ἐμοῖς φυγάδας θήσομεν·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:109.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:109.1.text#ὡς γὰρ ἀμήτωρ ἀπάτωρ τε γεγὼς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:110.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:110.1.text#τοὺς θρέψαντας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:111.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:111.1.text#Φοίβου ναοὺς θεραπεύω.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:112.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:112.1.text#ἄγ', ὦ νεηθαλὲς ὦ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:113.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:113.1.text#καλλίστας προπόλευμα δάφνας,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:114.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:114.1.text#ἃ τὰν Φοίβου θυμέλαν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:115.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:115.1.text#σαίρεις ὑπὸ ναοῖς,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:116.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:116.1.text#κήπων ἐξ ἀθανάτων,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:117.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:117.1.text#ἵνα δρόσοι τέγγουσ' ἱεραί,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:118.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:118.1.text#{ ῥοὰν } ἀέναον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:119.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:119.1.text#παγᾶν ἐκπροϊεῖσαι,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:120.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:120.1.text#μυρσίνας ἱερὰν φόβαν·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:121.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:121.1.text#ᾇ σαίρω δάπεδον θεοῦ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:122.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:122.1.text#παναμέριος ἅμ' ἁλίου
urn:cts:greekLit:tlg0006.tlg010.fu.sp:123.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:123.1.text#πτέρυγι θοᾷ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:124.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:124.1.text#λατρεύων τὸ κατ' ἦμαρ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:125.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:125.1.text#ὦ Παιὰν ὦ Παιάν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:126.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:126.1.text#εὐαίων εὐαίων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:127.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:127.1.text#εἴης, ὦ Λατοῦς παῖ.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:128.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:128.1.text#καλόν γε τὸν πόνον, ὦ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:129.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:129.1.text#Φοῖβε, σοὶ πρὸ δόμων λατρεύω
urn:cts:greekLit:tlg0006.tlg010.fu.sp:130.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:130.1.text#τιμῶν μαντεῖον ἕδραν·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:131.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:131.1.text#κλεινὸς δ' ὁ πόνος μοι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:132.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:132.1.text#θεοῖσιν δούλαν χέρ' ἔχειν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:133.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:133.1.text#οὐ θνατοῖς, ἀλλ' ἀθανάτοις·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:134.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:134.1.text#εὐφάμους δὲ πόνους
urn:cts:greekLit:tlg0006.tlg010.fu.sp:135.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:135.1.text#μοχθεῖν οὐκ ἀποκάμνω.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:136.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:136.1.text#Φοῖβός μοι γενέτωρ πατήρ·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:137.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:137.1.text#τὸν βόσκοντα γὰρ εὐλογῶ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:138.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:138.1.text#τὸ δ' ὠφέλιμον ἐμοὶ πατέρος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:139.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:139.1.text#ὄνομα λέγω
urn:cts:greekLit:tlg0006.tlg010.fu.sp:140.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:140.1.text#Φοίβου τοῦ κατὰ ναόν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:141.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:141.1.text#ὦ Παιὰν ὦ Παιάν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:142.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:142.1.text#εὐαίων εὐαίων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:143.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:143.1.text#εἴης, ὦ Λατοῦς παῖ.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:144.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:144.1.text#ἀλλ' ἐκπαύσω γὰρ μόχθους
urn:cts:greekLit:tlg0006.tlg010.fu.sp:145.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:145.1.text#δάφνας ὁλκοῖς,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:146.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:146.1.text#χρυσέων δ' ἐκ τευχέων ῥίψω
urn:cts:greekLit:tlg0006.tlg010.fu.sp:147.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:147.1.text#Γαίας παγάν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:148.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:148.1.text#ἃν ἀποχεύονται
urn:cts:greekLit:tlg0006.tlg010.fu.sp:149.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:149.1.text#Κασταλίας δῖναι,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:149.2.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:149.2.text#νοτερὸν ὕδωρ βάλλων,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:150.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:150.1.text#ὅσιος ἀπ' εὐνᾶς ὤν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:151.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:151.1.text#εἴθ' οὕτως αἰεὶ Φοίβῳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:152.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:152.1.text#λατρεύων μὴ παυσαίμαν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:153.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:153.1.text#ἢ παυσαίμαν ἀγαθᾷ μοίρᾳ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:154.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:154.1.text#ἔα ἔα·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:154.2.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:154.2.text#φοιτῶσ' ἤδη λείπουσίν τε
urn:cts:greekLit:tlg0006.tlg010.fu.sp:155.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:155.1.text#πτανοὶ Παρνασοῦ κοίτας·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:156.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:156.1.text#αὐδῶ μὴ χρίμπτειν θριγκοῖς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:157.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:157.1.text#μηδ' ἐς χρυσήρεις οἴκους —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:158.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:158.1.text#μάρψω σ' αὖ τόξοις, ὦ Ζηνὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:159.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:159.1.text#κῆρυξ, ὀρνίθων γαμφηλαῖς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:160.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:160.1.text#ἰσχὺν νικῶν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:161.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:161.1.text#ὅδε πρὸς θυμέλας ἄλλος ἐρέσσει
urn:cts:greekLit:tlg0006.tlg010.fu.sp:162.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:162.1.text#κύκνος. οὐκ ἄλλᾳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:163.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:163.1.text#φοινικοφαῆ πόδα κινήσεις;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:164.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:164.1.text#οὐδέν σ' ἁ φόρμιγξ ἁ Φοίβου
urn:cts:greekLit:tlg0006.tlg010.fu.sp:165.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:165.1.text#σύμμολπος τόξων ῥύσαιτ' ἄν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:166.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:166.1.text#πάραγε πτέρυγας·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:167.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:167.1.text#λίμνας ἐπίβα τᾶς Δηλιάδος·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:168.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:168.1.text#αἱμάξεις, εἰ μὴ πείσῃ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:169.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:169.1.text#τὰς καλλιφθόγγους ᾠδάς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:170.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:170.1.text#ἔα ἔα·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:170.2.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:170.2.text#τίς ὅδ' ὀρνίθων καινὸς προσέβα;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:171.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:171.1.text#μῶν ὑπὸ θριγκοὺς εὐναίας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:172.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:172.1.text#καρφυρὰς θήσων τέκνοις;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:173.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:173.1.text#ψαλμοί σ' εἴρξουσιν τόξων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:174.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:174.1.text#οὐ πείσῃ; χωρῶν δίναις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:175.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:175.1.text#ταῖς Ἀλφειοῦ παιδούργει,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:176.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:176.1.text#ἢ νάπος Ἴσθμιον,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:177.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:177.1.text#ὡς ἀναθήματα μὴ βλάπτηται
urn:cts:greekLit:tlg0006.tlg010.fu.sp:178.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:178.1.text#ναοί θ' οἱ Φοίβου [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:179.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:179.1.text#κτείνειν δ' ὑμᾶς αἰδοῦμαι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:180.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:180.1.text#τοὺς θεῶν ἀγγέλλοντας φήμας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:181.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:181.1.text#θνατοῖς· οἷς δ' ἔγκειμαι μόχθοις,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:182.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:182.1.text#Φοίβῳ δουλεύσω, κοὐ λήξω
urn:cts:greekLit:tlg0006.tlg010.fu.sp:183.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:183.1.text#τοὺς βόσκοντας θεραπεύων.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:184.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:184.1.text#— οὐκ ἐν ταῖς ζαθέαις Ἀθάναις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:185.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:185.1.text#εὐκίονες ἦσαν αὐλαὶ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:186.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:186.1.text#θεῶν μόνον, οὐδ' ἀγυιάτιδες
urn:cts:greekLit:tlg0006.tlg010.fu.sp:186.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:186.2.text#θεραπεῖαι·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:187.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:187.1.text#ἀλλὰ καὶ παρὰ Λοξίᾳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:188.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:188.1.text#τῷ Λατοῦς διδύμων προσώπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:189.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:189.1.text#καλλιβλέφαρον φῶς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:190.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:190.1.text#— ἰδοὺ τάνδ', ἄθρησον,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:191.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:191.1.text#Λερναῖον ὕδραν ἐναίρει
urn:cts:greekLit:tlg0006.tlg010.fu.sp:192.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:192.1.text#χρυσέαις ἅρπαις ὁ Διὸς παῖς·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:193.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:193.1.text#φίλα, πρόσιδ' ὄσσοις.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:194.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:194.1.text#— ὁρῶ. καὶ πέλας ἄλλος αὐτοῦ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:195.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:195.1.text#πανὸν πυρίφλεκτον αἴρει
urn:cts:greekLit:tlg0006.tlg010.fu.sp:196.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:196.1.text#τις — ἆρ' ὃς ἐμαῖσι μυθεύεται
urn:cts:greekLit:tlg0006.tlg010.fu.sp:197.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:197.1.text#παρὰ πήναις,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:198.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:198.1.text#ἀσπιστὰς Ἰόλαος, ὃς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:199.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:199.1.text#κοινοὺς αἰρόμενος πόνους
urn:cts:greekLit:tlg0006.tlg010.fu.sp:200.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:200.1.text#Δίῳ παιδὶ συναντλεῖ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:201.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:201.1.text#— καὶ μὰν τόνδ' ἄθρησον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:202.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:202.1.text#πτεροῦντος ἔφεδρον ἵππου·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:203.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:203.1.text#τὰν πῦρ πνέουσαν ἐναίρει
urn:cts:greekLit:tlg0006.tlg010.fu.sp:204.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:204.1.text#τρισώματον ἀλκάν.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:205.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:205.1.text#— πάντᾳ τοι βλέφαρον διώκω.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:206.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:206.1.text#σκέψαι κλόνον ἐν τείχεσσι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:207.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:207.1.text#λαΐνοισι Γιγάντων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:208.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:208.1.text#— ὦ φίλαι, ὧδε δερκόμεσθα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:209.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:209.1.text#— λεύσσεις οὖν ἐπ' Ἐγκελάδῳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:210.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:210.1.text#γοργωπὸν πάλλουσαν ἴτυν —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:211.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:211.1.text#— λεύσσω Παλλάδ', ἐμὰν θεόν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:212.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:212.1.text#— τί γάρ; κεραυνὸν ἀμφίπυρον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:213.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:213.1.text#ὄβριμον ἐν Διὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:214.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:214.1.text#ἑκηβόλοισι χερσίν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:215.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:215.1.text#— ὁρῶ· τὸν δάϊον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:216.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:216.1.text#Μίμαντα πυρὶ καταιθαλοῖ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:217.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:217.1.text#— καὶ Βρόμιος ἄλλον ἀπολέμοισι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:217.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:217.2.text#κισσίνοισι βάκτροις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:218.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:218.1.text#ἐναίρει Γᾶς τέκνων ὁ Βακχεύς.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:219.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:219.1.text#σέ τοι, τὸν παρὰ ναὸν αὐδῶ·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:220.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:220.1.text#θέμις γυάλων ὑπερβῆναι,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:221.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:221.1.text#λευκῷ ποδί γ' — ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:222.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:222.1.text#οὐ θέμις, ὦ ξέναι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:222.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:222.2.text#οὐδ' ἂν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:223.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:223.1.text#ἐκ σέθεν ἂν πυθοίμεθ' αὐδάν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:223.2.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:223.2.text#τίνα τήνδε θέλεις;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:223.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:223.2.text#ἆρ' ὄντως μέσον ὀμφαλὸν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:224.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:224.1.text#γᾶς Φοίβου κατέχει δόμος;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:224.2.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:224.2.text#στέμμασί γ' ἐνδυτόν, ἀμφὶ δὲ Γοργόνες.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:225.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:225.1.text#οὕτω καὶ φάτις αὐδᾷ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:226.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:226.1.text#εἰ μὲν ἐθύσατε πέλανον πρὸ δόμων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:227.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:227.1.text#καί τι πυθέσθαι χρῄζετε Φοίβου,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:228.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:228.1.text#πάριτ' ἐς θυμέλας· ἐπὶ δ' ἀσφάκτοις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:229.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:229.1.text#μήλοισι δόμων μὴ πάριτ' ἐς μυχόν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:230.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:230.1.text#ἔχω μαθοῦσα· θεοῦ δὲ νόμον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:231.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:231.1.text#οὐ παραβαίνομεν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:232.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:232.1.text#ἃ δ' ἐκτός, ὄμμα τέρψει.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:233.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:233.1.text#πάντα θεᾶσθ', ὅ τι καὶ θέμις, ὄμμασι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:233.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:233.2.text#μεθεῖσαν δεσπόται
urn:cts:greekLit:tlg0006.tlg010.fu.sp:234.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:234.1.text#με θεοῦ γύαλα τάδ' εἰσιδεῖν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:234.2.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:234.2.text#δμῳαὶ δὲ τίνων κλῄζεσθε δόμων;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:235.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:235.1.text#Παλλάδι σύνοικα τρόφιμα μέλαθρα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:235.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:235.2.text#τῶν ἐμῶν τυράννων·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:236.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:236.1.text#παρούσας δ' ἀμφὶ τᾶσδ' ἐρωτᾷς.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:237.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:237.1.text#γενναιότης σοι, καὶ τρόπων τεκμήριον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:238.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:238.1.text#τὸ σχῆμ' ἔχεις τόδ', ἥτις εἶ ποτ', ὦ γύναι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:239.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:239.1.text#γνοίη δ' ἂν ὡς τὰ πολλά γ' ἀνθρώπου πέρι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:240.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:240.1.text#τὸ σχῆμ' ἰδών τις εἰ πέφυκεν εὐγενής.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:240.2.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:240.2.text#ἔα·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:241.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:241.1.text#ἀλλ' ἐξέπληξάς μ', ὄμμα συγκλῄσασα σὸν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:242.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:242.1.text#δακρύοις θ' ὑγράνασ' εὐγενῆ παρηίδα,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:243.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:243.1.text#ὡς εἶδες ἁγνὰ Λοξίου χρηστήρια.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:244.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:244.1.text#τί ποτε μερίμνης ἐς τόδ' ἦλθες, ὦ γύναι;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:245.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:245.1.text#ὃ πάντες ἄλλοι γύαλα λεύσσοντες θεοῦ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:246.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:246.1.text#χαίρουσιν, ἐνταῦθ' ὄμμα σὸν δακρυρροεῖ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:247.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:247.1.text#ὦ ξένε, τὸ μὲν σὸν οὐκ ἀπαιδεύτως ἔχει
urn:cts:greekLit:tlg0006.tlg010.fu.sp:248.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:248.1.text#ἐς θαύματ' ἐλθεῖν δακρύων ἐμῶν πέρι·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:249.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:249.1.text#ἐγὼ δ' ἰδοῦσα τούσδ' Ἀπόλλωνος δόμους
urn:cts:greekLit:tlg0006.tlg010.fu.sp:250.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:250.1.text#μνήμην παλαιὰν ἀνεμετρησάμην τινά·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:251.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:251.1.text#οἴκοι δὲ τὸν νοῦν ἔσχον ἐνθάδ' οὖσά που.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:252.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:252.1.text#ὦ τλήμονες γυναῖκες· ὦ τολμήματα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:253.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:253.1.text#θεῶν. τί δῆτα; ποῖ δίκην ἀνοίσομεν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:254.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:254.1.text#εἰ τῶν κρατούντων ἀδικίαις ὀλούμεθα;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:255.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:255.1.text#τί χρῆμ' ἀνερμήνευτα δυσθυμῇ, γύναι;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:256.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:256.1.text#οὐδέν· μεθῆκα τόξα· τἀπὶ τῷδε δὲ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:257.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:257.1.text#ἐγώ τε σιγῶ, καὶ σὺ μὴ φρόντιζ' ἔτι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:258.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:258.1.text#τίς δ' εἶ; πόθεν γῆς ἦλθες; ἐκ ποίας πάτρας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:259.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:259.1.text#πέφυκας; ὄνομα τί σε καλεῖν ἡμᾶς χρεών;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:260.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:260.1.text#Κρέουσα μέν μοι τοὔνομ', ἐκ δ' Ἐρεχθέως
urn:cts:greekLit:tlg0006.tlg010.fu.sp:261.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:261.1.text#πέφυκα, πατρὶς γῆ δ' Ἀθηναίων πόλις.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:262.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:262.1.text#ὦ κλεινὸν οἰκοῦσ' ἄστυ γενναίων τ' ἄπο
urn:cts:greekLit:tlg0006.tlg010.fu.sp:263.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:263.1.text#τραφεῖσα πατέρων, ὥς σε θαυμάζω, γύναι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:264.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:264.1.text#τοσαῦτα κεὐτυχοῦμεν, ὦ ξέν', οὐ πέρα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:265.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:265.1.text#πρὸς θεῶν ἀληθῶς, ὡς μεμύθευται βροτοῖς  [ … ] ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:266.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:266.1.text#τί χρῆμ' ἐρωτᾷς, ὦ ξέν', ἐκμαθεῖν θέλων;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:267.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:267.1.text#ἐκ γῆς πατρός σου πρόγονος ἔβλαστεν πατήρ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:268.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:268.1.text#Ἐριχθόνιός γε· τὸ δὲ γένος μ' οὐκ ὠφελεῖ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:269.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:269.1.text#ἦ καί σφ' Ἀθάνα γῆθεν ἐξανείλετο;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:270.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:270.1.text#ἐς παρθένους γε χεῖρας, οὐ τεκοῦσά νιν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:271.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:271.1.text#δίδωσι δ', ὥσπερ ἐν γραφῇ νομίζεται  [ … ] ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:272.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:272.1.text#Κέκροπός γε σῴζειν παισὶν οὐχ ὁρώμενον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:273.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:273.1.text#ἤκουσα λῦσαι παρθένους τεῦχος θεᾶς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:274.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:274.1.text#τοιγὰρ θανοῦσαι σκόπελον ᾕμαξαν πέτρας.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:275.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:275.1.text#εἶἑν·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:275.2.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:275.2.text#τί δαὶ τόδ'; ἆρ' ἀληθὲς ἢ μάτην λόγος  [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:276.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:276.1.text#τί χρῆμ' ἐρωτᾷς; καὶ γὰρ οὐ κάμνω σχολῇ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:277.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:277.1.text#πατὴρ Ἐρεχθεὺς σὰς ἔθυσε συγγόνους;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:278.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:278.1.text#ἔτλη πρὸ γαίας σφάγια παρθένους κτανεῖν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:279.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:279.1.text#σὺ δ' ἐξεσώθης πῶς κασιγνήτων μόνη;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:280.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:280.1.text#βρέφος νεογνὸν μητρὸς ἦν ἐν ἀγκάλαις.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:281.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:281.1.text#πατέρα δ' ἀληθῶς χάσμα σὸν κρύπτει χθονός;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:282.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:282.1.text#πληγαὶ τριαίνης ποντίου σφ' ἀπώλεσαν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:283.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:283.1.text#Μακραὶ δὲ χῶρός ἐστ' ἐκεῖ κεκλημένος;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:284.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:284.1.text#τί δ' ἱστορεῖς τόδ'; ὥς μ' ἀνέμνησάς τινος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:285.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:285.1.text#τιμᾷ σφε Πύθιος ἀστραπαί τε Πύθιαι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:286.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:286.1.text#[ τιμᾶ τιμᾶ ]· ὡς μήποτ' ὤφελόν σφ' ἰδεῖν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:287.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:287.1.text#τί δὲ στυγεῖς σὺ τοῦ θεοῦ τὰ φίλτατα;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:288.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:288.1.text#οὐδέν· ξύνοιδ' ἄντροισιν αἰσχύνην τινά.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:289.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:289.1.text#πόσις δὲ τίς σ' ἔγημ' Ἀθηναίων, γύναι;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:290.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:290.1.text#οὐκ ἀστός, ἀλλ' ἐπακτὸς ἐξ ἄλλης χθονός.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:291.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:291.1.text#τίς; εὐγενῆ νιν δεῖ πεφυκέναι τινά.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:292.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:292.1.text#Ξοῦθος, πεφυκὼς Αἰόλου Διός τ' ἄπο.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:293.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:293.1.text#καὶ πῶς ξένος σ' ὢν ἔσχεν οὖσαν ἐγγενῆ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:294.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:294.1.text#Εὔβοι' Ἀθήναις ἔστι τις γείτων πόλις   [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:295.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:295.1.text#ὅροις ὑγροῖσιν, ὡς λέγουσ', ὡρισμένη.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:296.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:296.1.text#ταύτην ἔπερσε Κεκροπίδαις κοινῷ δορί.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:297.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:297.1.text#ἐπίκουρος ἐλθών; κᾆτα σὸν γαμεῖ λέχος;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:298.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:298.1.text#φερνάς γε πολέμου καὶ δορὸς λαβὼν γέρας.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:299.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:299.1.text#σὺν ἀνδρὶ δ' ἥκεις ἢ μόνη χρηστήρια;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:300.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:300.1.text#σὺν ἀνδρί. σηκοὺς δ' ἐκστρέφει Τροφωνίου.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:301.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:301.1.text#πότερα θεατὴς ἢ χάριν μαντευμάτων;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:302.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:302.1.text#κείνου τε Φοίβου θ' ἓν θέλων μαθεῖν ἔπος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:303.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:303.1.text#καρποῦ δ' ὕπερ γῆς ἥκετ', ἢ παίδων πέρι;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:304.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:304.1.text#ἄπαιδές ἐσμεν, χρόνι' ἔχοντ' εὐνήματα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:305.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:305.1.text#οὐδ' ἔτεκες οὐδὲν πώποτ', ἀλλ' ἄτεκνος εἶ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:306.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:306.1.text#ὁ Φοῖβος οἶδε τὴν ἐμὴν ἀπαιδίαν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:307.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:307.1.text#ὦ τλῆμον, ὡς τἄλλ' εὐτυχοῦσ' οὐκ εὐτυχεῖς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:308.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:308.1.text#σὺ δ' εἶ τίς; ὥς σου τὴν τεκοῦσαν ὤλβισα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:309.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:309.1.text#τοῦ θεοῦ καλοῦμαι δοῦλος εἰμί τ', ὦ γύναι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:310.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:310.1.text#ἀνάθημα πόλεως, ἤ τινος πραθεὶς ὕπο;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:311.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:311.1.text#οὐκ οἶδα πλὴν ἕν· Λοξίου κεκλήμεθα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:312.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:312.1.text#ἡμεῖς σ' ἄρ' αὖθις, ὦ ξέν', ἀντοικτίρομεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:313.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:313.1.text#ὡς μὴ εἰδόθ' ἥτις μ' ἔτεκεν ἐξ ὅτου τ' ἔφυν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:314.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:314.1.text#ναοῖσι δ' οἰκεῖς τοισίδ' ἢ κατὰ στέγας;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:315.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:315.1.text#ἅπαν θεοῦ μοι δῶμ', ἵν' ἂν λάβῃ μ' ὕπνος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:316.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:316.1.text#παῖς δ' ὢν ἀφίκου ναὸν ἢ νεανίας;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:317.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:317.1.text#βρέφος λέγουσιν οἱ δοκοῦντες εἰδέναι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:318.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:318.1.text#καὶ τίς γάλακτί σ' ἐξέθρεψε Δελφίδων;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:319.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:319.1.text#οὐπώποτ' ἔγνων μαστόν· ἣ δ' ἔθρεψέ με   [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:320.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:320.1.text#τίς, ὦ ταλαίπωρ'; ὡς νοσοῦσ' ηὗρον νόσους.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:321.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:321.1.text#Φοίβου προφῆτις, μητέρ' ὣς νομίζομεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:322.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:322.1.text#ἐς δ' ἄνδρ' ἀφίκου τίνα τροφὴν κεκτημένος;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:323.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:323.1.text#βωμοί μ' ἔφερβον οὑπιών τ' ἀεὶ ξένος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:324.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:324.1.text#τάλαινά σ' ἡ τεκοῦσα· τίς ποτ' ἦν ἄρα;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:325.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:325.1.text#ἀδίκημά του γυναικὸς ἐγενόμην ἴσως.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:326.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:326.1.text#ἔχεις δὲ βίοτον· εὖ γὰρ ἤσκησαι πέπλοις.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:327.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:327.1.text#τοῖς τοῦ θεοῦ κοσμούμεθ', ᾧ δουλεύομεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:328.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:328.1.text#οὐδ' ᾖξας εἰς ἔρευναν ἐξευρεῖν γονάς;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:329.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:329.1.text#ἔχω γὰρ οὐδέν, ὦ γύναι, τεκμήριον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:330.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:330.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:330.2.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:330.2.text#πέπονθέ τις σῇ μητρὶ ταὔτ' ἄλλη γυνή.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:331.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:331.1.text#τίς; εἰ πόνου μοι ξυλλάβοι, χαίροιμεν ἄν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:332.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:332.1.text#ἧς οὕνεκ' ἦλθον δεῦρο πρὶν πόσιν μολεῖν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:333.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:333.1.text#ποῖόν τι χρῄζουσ'; ὡς ὑπουργήσω, γύναι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:334.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:334.1.text#μάντευμα κρυπτὸν δεομένη Φοίβου μαθεῖν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:335.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:335.1.text#λέγοις ἄν· ἡμεῖς τἄλλα προξενήσομεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:336.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:336.1.text#ἄκουε δὴ τὸν μῦθον.  — ἀλλ' αἰδούμεθα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:337.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:337.1.text#οὔ τἄρα πράξεις οὐδέν· ἀργὸς ἡ θεός.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:338.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:338.1.text#Φοίβῳ μιγῆναί φησί τις φίλων ἐμῶν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:339.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:339.1.text#Φοίβῳ γυνὴ γεγῶσα; μὴ λέγ', ὦ ξένη.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:340.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:340.1.text#καὶ παῖδά γ' ἔτεκε τῷ θεῷ λάθρα πατρός.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:341.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:341.1.text#οὐκ ἔστιν· ἀνδρὸς ἀδικίαν αἰσχύνεται.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:342.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:342.1.text#οὔ φησιν αὐτή, καὶ πέπονθεν ἄθλια.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:343.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:343.1.text#τί χρῆμα δράσασ', εἰ θεῷ συνεζύγη;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:344.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:344.1.text#τὸν παῖδ' ὃν ἔτεκεν ἐξέθηκε δωμάτων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:345.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:345.1.text#ὁ δ' ἐκτεθεὶς παῖς ποῦ 'στιν; εἰσορᾷ φάος;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:346.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:346.1.text#οὐκ οἶδεν οὐδείς. ταῦτα καὶ μαντεύομαι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:347.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:347.1.text#εἰ δ' οὐκέτ' ἔστι, τίνι τρόπῳ διεφθάρη;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:348.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:348.1.text#θῆράς σφε τὸν δύστηνον ἐλπίζει κτανεῖν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:349.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:349.1.text#ποίῳ τόδ' ἔγνω χρωμένη τεκμηρίῳ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:350.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:350.1.text#ἐλθοῦσ' ἵν' αὐτὸν ἐξέθηκ' οὐχ ηὗρ' ἔτι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:351.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:351.1.text#ἦν δὲ σταλαγμὸς ἐν στίβῳ τις αἵματος;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:352.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:352.1.text#οὔ φησι. καίτοι πόλλ' ἐπεστράφη πέδον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:353.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:353.1.text#χρόνος δὲ τίς τῷ παιδὶ διαπεπραγμένῳ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:354.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:354.1.text#σοὶ ταὐτὸν ἥβης, εἴπερ, εἶχεν ἂν μέτρον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:355.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:355.1.text#ἀδικεῖ νιν ὁ θεός· ἡ τεκοῦσα δ' ἀθλία.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:356.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:356.1.text#οὔκουν ἔτ' ἄλλον γ' ὕστερον τίκτει γόνον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:357.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:357.1.text#τί δ', εἰ λάθρα νιν Φοῖβος ἐκτρέφει λαβών;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:358.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:358.1.text#τὰ κοινὰ χαίρων οὐ δίκαια δρᾷ μόνος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:359.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:359.1.text#οἴμοι· προσῳδὸς ἡ τύχη τὠμῷ πάθει.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:360.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:360.1.text#καὶ σέ, ὦ ξέν', οἶμαι μητέρ' ἀθλίαν ποθεῖν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:361.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:361.1.text#καὶ μή γ' ἐπ' οἶκτόν μ' ἔξαγ' οὗ 'λελήσμεθα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:362.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:362.1.text#σιγῶ· πέραινε δ' ὧν σ' ἀνιστορῶ πέρι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:363.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:363.1.text#οἶσθ' οὖν ὃ κάμνει τοῦ λόγου μάλιστά σοι;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:364.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:364.1.text#τί δ' οὐκ ἐκείνῃ τῇ ταλαιπώρῳ νοσεῖ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:365.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:365.1.text#πῶς ὁ θεὸς ὃ λαθεῖν βούλεται μαντεύσεται;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:366.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:366.1.text#εἴπερ καθίζει τρίποδα κοινὸν Ἑλλάδος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:367.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:367.1.text#αἰσχύνεται τὸ πρᾶγμα· μὴ 'ξέλεγχέ νιν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:368.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:368.1.text#ἀλγύνεται δέ γ' ἡ παθοῦσα τῇ τύχῃ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:369.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:369.1.text#οὐκ ἔστιν ὅστις σοι προφητεύσει τάδε.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:370.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:370.1.text#ἐν τοῖς γὰρ αὑτοῦ δώμασιν κακὸς φανεὶς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:371.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:371.1.text#Φοῖβος δικαίως τὸν θεμιστεύοντά σοι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:372.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:372.1.text#δράσειεν ἄν τι πῆμα. ἀπαλλάσσου, γύναι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:373.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:373.1.text#τῷ γὰρ θεῷ τἀναντί' οὐ μαντευτέον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:374.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:374.1.text#ἐς γὰρ τοσοῦτον ἀμαθίας ἔλθοιμεν ἄν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:375.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:375.1.text#εἰ τοὺς θεοὺς ἄκοντας ἐκπονήσομεν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:376.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:376.1.text#φράζειν ἃ μὴ θέλουσιν, ἢ προβωμίοις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:377.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:377.1.text#σφαγαῖσι μήλων ἢ δι' οἰωνῶν πτεροῖς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:378.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:378.1.text#ἃν γὰρ βίᾳ σπεύδωμεν ἀκόντων θεῶν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:379.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:379.1.text#ἄκοντα κεκτήμεσθα τἀγάθ', ὦ γύναι·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:380.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:380.1.text#ἃ δ' ἂν διδῶσ' ἑκόντες, ὠφελούμεθα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:381.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:381.1.text#πολλαί γε πολλοῖς εἰσι συμφοραὶ βροτῶν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:382.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:382.1.text#μορφαὶ δὲ διαφέρουσιν· ἓν δ' ἂν εὐτυχὲς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:383.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:383.1.text#μόλις ποτ' ἐξεύροι τις ἀνθρώπων βίῳ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:384.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:384.1.text#ὦ Φοῖβε, κἀκεῖ κἀνθάδ' οὐ δίκαιος εἶ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:385.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:385.1.text#ἐς τὴν ἀποῦσαν, ἧς πάρεισιν οἱ λόγοι·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:386.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:386.1.text#ὃς οὔτ' ἔσωσας τὸν σὸν ὃν σῶσαί σ' ἐχρῆν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:387.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:387.1.text#οὔθ' ἱστορούσῃ μητρὶ μάντις ὢν ἐρεῖς,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:388.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:388.1.text#ὡς, εἰ μὲν οὐκέτ' ἔστιν, ὀγκωθῇ τάφῳ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:389.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:389.1.text#εἰ δ' ἔστιν   [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:390.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:390.1.text#ἀλλ' ἐᾶν χρὴ τάδ', εἰ πρὸς τοῦ θεοῦ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:391.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:391.1.text#κωλυόμεσθα μὴ μαθεῖν ἃ βούλομαι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:392.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:392.1.text#ἀλλ', ὦ ξέν', εἰσορῶ γὰρ εὐγενῆ πόσιν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:393.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:393.1.text#Ξοῦθον πέλας δὴ τόνδε, τὰς Τροφωνίου
urn:cts:greekLit:tlg0006.tlg010.fu.sp:394.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:394.1.text#λιπόντα θαλάμας, τοὺς λελεγμένους λόγους
urn:cts:greekLit:tlg0006.tlg010.fu.sp:395.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:395.1.text#σίγα πρὸς ἄνδρα, μή τιν' αἰσχύνην λάβω
urn:cts:greekLit:tlg0006.tlg010.fu.sp:396.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:396.1.text#διακονοῦσα κρυπτά, καὶ προβῇ λόγος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:397.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:397.1.text#οὐχ ᾗπερ ἡμεῖς αὐτὸν ἐξειλίσσομεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:398.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:398.1.text#τὰ γὰρ γυναικῶν δυσχερῆ πρὸς ἄρσενας,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:399.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:399.1.text#κἀν ταῖς κακαῖσιν ἁγαθαὶ μεμειγμέναι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:400.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:400.1.text#μισούμεθ'· οὕτω δυστυχεῖς πεφύκαμεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:401.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:401.1.text#πρῶτον μὲν ὁ θεὸς τῶν ἐμῶν προσφθεγμάτων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:402.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:402.1.text#λαβὼν ἀπαρχὰς χαιρέτω, σύ τ', ὦ γύναι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:403.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:403.1.text#μῶν χρόνιος ἐλθών σ' ἐξέπληξ' ὀρρωδίᾳ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:404.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:404.1.text#οὐδέν γ'· ἀφίκου δ' ἐς μέριμναν. ἀλλά μοι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:405.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:405.1.text#λέξον, τί θέσπισμ' ἐκ Τροφωνίου φέρεις,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:406.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:406.1.text#παίδων ὅπως νῷν σπέρμα συγκραθήσεται;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:407.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:407.1.text#οὐκ ἠξίωσε τοῦ θεοῦ προλαμβάνειν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:408.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:408.1.text#μαντεύμαθ'· ἓν δ' οὖν εἶπεν· οὐκ ἄπαιδά με
urn:cts:greekLit:tlg0006.tlg010.fu.sp:409.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:409.1.text#πρὸς οἶκον ἥξειν οὐδὲ σὲ ἐκ χρηστηρίων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:410.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:410.1.text#ὦ πότνια Φοίβου μῆτερ, εἰ γὰρ αἰσίως
urn:cts:greekLit:tlg0006.tlg010.fu.sp:411.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:411.1.text#ἔλθοιμεν, ἅ τε νῷν συμβόλαια πρόσθεν ἦν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:412.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:412.1.text#ἐς παῖδα τὸν σόν, μεταπέσοι βελτίονα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:413.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:413.1.text#ἔσται τάδ'· ἀλλὰ τίς προφητεύει θεοῦ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:414.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:414.1.text#ἡμεῖς τά γ' ἔξω, τῶν ἔσω δ' ἄλλοις μέλει,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:415.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:415.1.text#οἳ πλησίον θάσσουσι τρίποδος, ὦ ξένε,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:416.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:416.1.text#Δελφῶν ἀριστῆς, οὓς ἐκλήρωσεν πάλος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:417.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:417.1.text#καλῶς· ἔχω δὴ πάνθ' ὅσων ἐχρῄζομεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:418.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:418.1.text#στείχοιμ' ἂν εἴσω· καὶ γάρ, ὡς ἐγὼ κλύω,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:419.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:419.1.text#χρηστήριον πέπτωκε τοῖς ἐπήλυσι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:420.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:420.1.text#κοινὸν πρὸ ναοῦ· βούλομαι δ' ἐν ἡμέρᾳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:421.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:421.1.text#τῇδ' — αἰσία γάρ — θεοῦ λαβεῖν μαντεύματα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:422.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:422.1.text#σὺ δ' ἀμφὶ βωμούς, ὦ γύναι, δαφνηφόρους
urn:cts:greekLit:tlg0006.tlg010.fu.sp:423.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:423.1.text#λαβοῦσα κλῶνας, εὐτέκνους εὔχου θεοῖς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:424.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:424.1.text#χρησμούς μ' ἐνεγκεῖν ἐξ Ἀπόλλωνος δόμων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:425.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:425.1.text#ἔσται τάδ', ἔσται. Λοξίας δ' ἐὰν θέλῃ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:426.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:426.1.text#νῦν ἀλλὰ τὰς πρὶν ἀναλαβεῖν ἁμαρτίας,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:427.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:427.1.text#ἅπας μὲν οὐ γένοιτ' ἂν εἰς ἡμᾶς φίλος,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:428.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:428.1.text#ὅσον δὲ χρῄζει — θεὸς γάρ ἐστι — δέξομαι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:429.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:429.1.text#τί ποτε λόγοισιν ἡ ξένη πρὸς τὸν θεὸν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:430.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:430.1.text#κρυπτοῖσιν αἰεὶ λοιδοροῦσ' αἰνίσσεται;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:431.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:431.1.text#ἤτοι φιλοῦσά γ' ἧς ὕπερ μαντεύεται,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:432.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:432.1.text#ἢ καί τι σιγῶσ' ὧν σιωπᾶσθαι χρεών;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:433.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:433.1.text#ἀτὰρ θυγατρὸς τῆς Ἐρεχθέως τί μοι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:434.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:434.1.text#μέλει; προσήκει γ' οὐδέν. ἀλλὰ χρυσέαις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:435.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:435.1.text#πρόχοισιν ἐλθὼν εἰς ἀπορραντήρια
urn:cts:greekLit:tlg0006.tlg010.fu.sp:436.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:436.1.text#δρόσον καθήσω. νουθετητέος δέ μοι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:437.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:437.1.text#Φοῖβος, τί πάσχει· παρθένους βίᾳ γαμῶν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:438.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:438.1.text#προδίδωσι; παῖδας ἐκτεκνούμενος λάθρᾳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:439.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:439.1.text#θνῄσκοντας ἀμελεῖ; μὴ σύ γ'· ἀλλ', ἐπεὶ κρατεῖς,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:440.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:440.1.text#ἀρετὰς δίωκε. καὶ γὰρ ὅστις ἂν βροτῶν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:441.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:441.1.text#κακὸς πεφύκῃ, ζημιοῦσιν οἱ θεοί.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:442.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:442.1.text#πῶς οὖν δίκαιον τοὺς νόμους ὑμᾶς βροτοῖς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:443.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:443.1.text#γράψαντας, αὐτοὺς ἀνομίαν ὀφλισκάνειν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:444.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:444.1.text#εἰ δ' — οὐ γὰρ ἔσται, τῷ λόγῳ δὲ χρήσομαι —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:445.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:445.1.text#δίκας βιαίων δώσετ' ἀνθρώποις γάμων,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:446.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:446.1.text#σὺ καὶ Ποσειδῶν Ζεύς θ' ὃς οὐρανοῦ κρατεῖ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:447.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:447.1.text#ναοὺς τίνοντες ἀδικίας κενώσετε.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:448.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:448.1.text#τὰς ἡδονὰς γὰρ τῆς προμηθίας πάρος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:449.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:449.1.text#σπεύδοντες ἀδικεῖτ'. οὐκέτ' ἀνθρώπους κακῶς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:450.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:450.1.text#λέγειν δίκαιον, εἰ τὰ τῶν θεῶν καλὰ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:451.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:451.1.text#μιμούμεθ', ἀλλὰ τοὺς διδάσκοντας τάδε.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:452.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:452.1.text#σὲ τὰν ὠδίνων λοχιᾶν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:453.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:453.1.text#ἀνειλείθυιαν, ἐμὰν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:454.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:454.1.text#Ἀθάναν, ἱκετεύω,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:455.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:455.1.text#Προμηθεῖ Τιτᾶνι λοχευθεῖσαν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:456.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:456.1.text#κατ' ἀκροτάτας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:457.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:457.1.text#κορυφᾶς Διός, ὦ μάκαιρα Νίκα,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:458.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:458.1.text#μόλε Πύθιον οἶκον,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:459.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:459.1.text#Ὀλύμπου χρυσέων θαλάμων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:460.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:460.1.text#πταμένα πρὸς ἀγυιάς,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:461.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:461.1.text#Φοιβήιος ἔνθα γᾶς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:462.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:462.1.text#μεσσόμφαλος ἑστία
urn:cts:greekLit:tlg0006.tlg010.fu.sp:463.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:463.1.text#παρὰ χορευομένῳ τρίποδι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:464.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:464.1.text#μαντεύματα κραίνει,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:465.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:465.1.text#σὺ καὶ παῖς ἁ Λατογενής,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:466.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:466.1.text#δύο θεαὶ δύο παρθένοι,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:467.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:467.1.text#κασίγνηται σεμναὶ Φοίβου.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:468.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:468.1.text#ἱκετεύσατε δ', ὦ κόραι,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:469.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:469.1.text#τὸ παλαιὸν Ἐρεχθέως
urn:cts:greekLit:tlg0006.tlg010.fu.sp:470.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:470.1.text#γένος εὐτεκνίας χρονίου καθαροῖς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:471.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:471.1.text#μαντεύμασι κῦρσαι.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:472.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:472.1.text#ὑπερβαλλούσας γὰρ ἔχει
urn:cts:greekLit:tlg0006.tlg010.fu.sp:473.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:473.1.text#θνατοῖς εὐδαιμονίας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:474.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:474.1.text#ἀκίνητον ἀφορμάν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:475.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:475.1.text#τέκνων οἷς ἂν καρποτρόφοι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:476.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:476.1.text#λάμπωσιν ἐν θαλάμοις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:477.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:477.1.text#πατρίοισι νεάνιδες ἧβαι,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:478.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:478.1.text#διαδέκτορα πλοῦτον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:479.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:479.1.text#ὡς ἕξοντες ἐκ πατέρων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:480.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:480.1.text#ἑτέροις ἐπὶ τέκνοις.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:481.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:481.1.text#ἀλκά τε γὰρ ἐν κακοῖς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:482.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:482.1.text#σύν τ' εὐτυχίαις φίλον,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:483.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:483.1.text#δορί τε γᾷ πατρίᾳ φέρει
urn:cts:greekLit:tlg0006.tlg010.fu.sp:484.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:484.1.text#σωτήριον ἀλκάν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:485.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:485.1.text#ἐμοὶ μὲν πλούτου τε πάρος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:486.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:486.1.text#βασιλικῶν τ' εἶεν θαλάμων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:487.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:487.1.text#τροφαὶ κήδειοι κεδνῶν γε τέκνων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:488.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:488.1.text#τὸν ἄπαιδα δ' ἀποστυγῶ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:489.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:489.1.text#βίον, ᾧ τε δοκεῖ ψέγω·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:490.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:490.1.text#μετὰ δὲ κτεάνων μετρίων βιοτᾶς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:491.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:491.1.text#εὔπαιδος ἐχοίμαν.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:492.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:492.1.text#ὦ Πανὸς θακήματα καὶ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:493.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:493.1.text#παραυλίζουσα πέτρα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:494.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:494.1.text#μυχώδεσι Μακραῖς,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:495.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:495.1.text#ἵνα χοροὺς στείβουσι ποδοῖν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:496.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:496.1.text#Ἀγλαύρου κόραι τρίγονοι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:497.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:497.1.text#στάδια χλοερὰ πρὸ Παλλάδος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:498.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:498.1.text#ναῶν, συρίγγων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:499.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:499.1.text#ὑπ' αἰόλας ἰαχᾶς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:500.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:500.1.text#ὕμνων, ὅτ' ἀναλίοις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:501.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:501.1.text#συρίζεις, ὦ Πάν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:502.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:502.1.text#τοῖς σοῖσιν ἐν ἄντροις,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:503.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:503.1.text#ἵνα τεκοῦσά τις Φοίβῳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:504.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:504.1.text#παρθένος, ὦ μελέα, βρέφος,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:504.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:504.2.text#πτανοῖς ἐξόρισεν θοίναν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:505.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:505.1.text#θηρσί τε φοινίαν δαῖτα, πικρῶν γάμων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:506.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:506.1.text#ὕβριν· οὔτ' ἐπὶ κερκίσιν οὔτε λόγοις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:507.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:507.1.text#φάτιν ἄιον εὐτυχίας μετέχειν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:508.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:508.1.text#θεόθεν τέκνα θνατοῖς.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:510.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:510.1.text#πρόσπολοι γυναῖκες, αἳ τῶνδ' ἀμφὶ κρηπῖδας δόμων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:511.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:511.1.text#θυοδόκων φρούρημ' ἔχουσαι δεσπότιν φυλάσσετε,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:512.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:512.1.text#ἐκλέλοιπ' ἤδη τὸν ἱερὸν τρίποδα καὶ χρηστήριον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:513.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:513.1.text#Ξοῦθος, ἢ μίμνει κατ' οἶκον ἱστορῶν ἀπαιδίαν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:514.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:514.1.text#ἐν δόμοις ἔστ', ὦ ξέν'· οὔπω δῶμ' ὑπερβαίνει τόδε.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:515.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:515.1.text#ὡς δ' ἐπ' ἐξόδοισιν ὄντος, τῶνδ' ἀκούομεν πυλῶν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:516.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:516.1.text#δοῦπον, ἐξιόντα τ' ἤδη δεσπότην ὁρᾶν πάρα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:517.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:517.1.text#ὦ τέκνον, χαῖρ'· ἡ γὰρ ἀρχὴ τοῦ λόγου πρέπουσά μοι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:518.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:518.1.text#χαίρομεν· σὺ δ' εὖ φρόνει γε, καὶ δύ' ὄντ' εὖ πράξομεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:519.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:519.1.text#δὸς χερὸς φίλημά μοι σῆς σώματός τ' ἀμφιπτυχάς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:520.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:520.1.text#εὖ φρονεῖς μέν; ἤ σ' ἔμηνε θεοῦ τις, ὦ ξένε, βλάβη;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:521.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:521.1.text#σωφρονῶ· τὰ φίλταθ' εὑρὼν οὐ φυγεῖν ἐφίεμαι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:522.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:522.1.text#παῦε, μὴ ψαύσας τὰ τοῦ θεοῦ στέμματα ῥήξῃς χερί.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:523.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:523.1.text#ἅψομαι· κοὐ ῥυσιάζω, τἀμὰ δ' εὑρίσκω φίλα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:524.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:524.1.text#οὐκ ἀπαλλάξῃ, πρὶν εἴσω τόξα πλευμόνων λαβεῖν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:525.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:525.1.text#ὡς τί δὴ φεύγεις με; σαυτοῦ γνωρίσας τὰ φίλτατα —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:526.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:526.1.text#οὐ φιλῶ φρενοῦν ἀμούσους καὶ μεμηνότας ξένους.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:527.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:527.1.text#κτεῖνε καὶ πίμπρη· πατρὸς γάρ, ἢν κτάνῃς, ἔσῃ φονεύς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:528.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:528.1.text#ποῦ δέ μοι πατὴρ σύ; ταῦτ' οὖν οὐ γέλως κλύειν ἐμοῦ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:529.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:529.1.text#οὔ· τρέχων ὁ μῦθος ἄν σοι τἀμὰ σημήνειεν ἄν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:530.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:530.1.text#καὶ τί μοι λέξεις;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:530.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:530.2.text#πατὴρ σός εἰμι καὶ σὺ παῖς ἐμός.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:531.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:531.1.text#τίς λέγει τάδε;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:531.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:531.2.text#ὅς σ' ἔθρεψεν ὄντα Λοξίας ἐμόν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:532.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:532.1.text#μαρτυρεῖς σαυτῷ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:532.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:532.2.text#τὰ τοῦ θεοῦ γ' ἐκμαθὼν χρηστήρια.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:533.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:533.1.text#ἐσφάλης αἴνιγμ' ἀκούσας.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:533.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:533.2.text#οὐκ ἄρ' ὄρθ' ἀκούομεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:534.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:534.1.text#ὁ δὲ λόγος τίς ἐστι Φοίβου;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:534.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:534.2.text#τὸν συναντήσαντά μοι —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:535.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:535.1.text#τίνα συνάντησιν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:535.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:535.2.text#δόμων τῶνδ' ἐξιόντι τοῦ θεοῦ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:536.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:536.1.text#συμφορᾶς τίνος κυρῆσαι;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:536.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:536.2.text#παῖδ' ἐμὸν πεφυκέναι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:537.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:537.1.text#σὸν γεγῶτ', ἢ δῶρον ἄλλως;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:537.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:537.2.text#δῶρον, ὄντα δ' ἐξ ἐμοῦ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:538.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:538.1.text#πρῶτα δῆτ' ἐμοὶ ξυνάπτεις πόδα σόν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:538.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:538.2.text#οὐκ ἄλλῳ, τέκνον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:539.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:539.1.text#ἡ τύχη πόθεν ποθ' ἥκει;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:539.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:539.2.text#δύο μίαν θαυμάζομεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:540.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:540.1.text#ἔα. τίνος δέ σοι πέφυκα μητρός;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:540.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:540.2.text#οὐκ ἔχω φράσαι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:541.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:541.1.text#οὐδὲ Φοῖβος εἶπε;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:541.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:541.2.text#τερφθεὶς τοῦτο, κεῖν' οὐκ ἠρόμην.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:542.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:542.1.text#γῆς ἄρ' ἐκπέφυκα μητρός.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:542.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:542.2.text#οὐ πέδον τίκτει τέκνα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:543.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:543.1.text#πῶς ἂν οὖν εἴην σός;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:543.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:543.2.text#οὐκ οἶδ', ἀναφέρω δ' ἐς τὸν θεόν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:544.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:544.1.text#φέρε λόγων ἁψώμεθ' ἄλλων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:544.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:544.2.text#ταῦτ' ἀμείνον', ὦ τέκνον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:545.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:545.1.text#ἦλθες ἐς νόθον τι λέκτρον;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:545.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:545.2.text#μωρίᾳ γε τοῦ νέου.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:546.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:546.1.text#πρὶν κόρην λαβεῖν Ἐρεχθέως;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:546.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:546.2.text#οὐ γὰρ ὕστερόν γέ πω.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:547.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:547.1.text#ἆρα δῆτ' ἐκεῖ μ' ἔφυσας;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:547.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:547.2.text#τῷ χρόνῳ γε συντρέχει.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:548.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:548.1.text#κᾆτα πῶς ἀφικόμεσθα δεῦρο —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:548.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:548.2.text#ταῦτ' ἀμηχανῶ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:549.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:549.1.text#διὰ μακρᾶς ἐλθὼν κελεύθου;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:549.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:549.2.text#τοῦτο κἄμ' ἀπαιολεῖ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:550.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:550.1.text#Πυθίαν δ' ἦλθες πέτραν πρίν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:550.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:550.2.text#ἐς φανάς γε Βακχίου.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:551.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:551.1.text#προξένων δ' ἔν του κατέσχες;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:551.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:551.2.text#ὅς με Δελφίσιν κόραις  [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:552.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:552.1.text#ἐθιάσευσ', ἢ πῶς τάδ' αὐδᾷς;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:552.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:552.2.text#Μαινάσιν γε Βακχίου.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:553.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:553.1.text#ἔμφρον' ἢ κάτοινον ὄντα;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:553.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:553.2.text#Βακχίου πρὸς ἡδοναῖς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:554.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:554.1.text#τοῦτ' ἐκεῖν' ἵν' ἐσπάρημεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:554.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:554.2.text#ὁ πότμος ἐξηῦρεν, τέκνον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:555.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:555.1.text#πῶς δ' ἀφικόμεσθα ναούς;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:555.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:555.2.text#ἔκβολον κόρης ἴσως.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:556.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:556.1.text#ἐκπεφεύγαμεν τὸ δοῦλον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:556.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:556.2.text#πατέρα νυν δέχου, τέκνον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:557.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:557.1.text#τῷ θεῷ γοῦν οὐκ ἀπιστεῖν εἰκός.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:557.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:557.2.text#εὖ φρονεῖς ἄρα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:558.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:558.1.text#καὶ τί βουλόμεσθά γ' ἄλλο —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:558.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:558.2.text#νῦν ὁρᾷς ἃ χρή σ' ὁρᾶν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:559.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:559.1.text#ἢ Διὸς παιδὸς γενέσθαι παῖς;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:559.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:559.2.text#ὃ σοί γε γίγνεται.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:560.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:560.1.text#ἦ θίγω δῆθ' οἵ μ' ἔφυσαν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:560.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:560.2.text#πιθόμενός γε τῷ θεῷ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:561.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:561.1.text#χαῖρέ μοι, πάτερ —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:561.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:561.2.text#φίλον γε φθέγμ' ἐδεξάμην τόδε.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:562.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:562.1.text#ἡμέρα θ' ἡ νῦν παροῦσα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:562.2.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:562.2.text#μακάριόν γ' ἔθηκέ με.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:563.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:563.1.text#ὦ φίλη μῆτερ, πότ' ἆρα καὶ σὸν ὄψομαι δέμας;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:564.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:564.1.text#νῦν ποθῶ σε μᾶλλον ἢ πρίν, ἥτις εἶ ποτ', εἰσιδεῖν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:565.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:565.1.text#ἀλλ' ἴσως τέθνηκας, ἡμεῖς δ' οὐδὲν ἂν δυναίμεθα.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:566.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:566.1.text#κοιναὶ μὲν ἡμῖν δωμάτων εὐπραξίαι·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:567.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:567.1.text#ὅμως δὲ καὶ δέσποιναν ἐς τέκν' εὐτυχεῖν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:568.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:568.1.text#ἐβουλόμην ἂν τούς τ' Ἐρεχθέως δόμους.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:569.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:569.1.text#ὦ τέκνον, ἐς μὲν σὴν ἀνεύρεσιν θεὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:570.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:570.1.text#ὀρθῶς ἔκρανε, καὶ συνῆψ' ἐμοί τε σέ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:571.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:571.1.text#σύ τ' αὖ τὰ φίλταθ' ηὗρες οὐκ εἰδὼς πάρος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:572.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:572.1.text#ὃ δ' ᾖξας ὀρθῶς, τοῦτο κἄμ' ἔχει πόθος,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:573.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:573.1.text#ὅπως σύ τ', ὦ παῖ, μητέρ' εὑρήσεις σέθεν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:574.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:574.1.text#ἐγώ θ' ὁποίας μοι γυναικὸς ἐξέφυς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:575.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:575.1.text#χρόνῳ δὲ δόντες ταῦτ' ἴσως εὕροιμεν ἄν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:576.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:576.1.text#ἀλλ' ἐκλιπὼν θεοῦ δάπεδ' ἀλητείαν τε σὴν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:577.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:577.1.text#ἐς τὰς Ἀθήνας στεῖχε κοινόφρων πατρί,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:578.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:578.1.text#οὗ σ' ὄλβιον μὲν σκῆπτρον ἀναμένει πατρός,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:579.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:579.1.text#πολὺς δὲ πλοῦτος· οὐδὲ θάτερον νοσῶν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:580.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:580.1.text#δυοῖν κεκλήσῃ δυσγενὴς πένης θ' ἅμα,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:581.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:581.1.text#ἀλλ' εὐγενής τε καὶ πολυκτήμων βίου.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:582.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:582.1.text#σιγᾷς; τί πρὸς γῆν ὄμμα σὸν βαλὼν ἔχεις;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:583.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:583.1.text#ἐς φροντίδας δ' ἀπῆλθες, ἐκ δὲ χαρμονῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:584.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:584.1.text#πάλιν μεταστὰς δεῖμα προσβάλλεις πατρί.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:585.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:585.1.text#οὐ ταὐτὸν εἶδος φαίνεται τῶν πραγμάτων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:586.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:586.1.text#πρόσωθεν ὄντων ἐγγύθεν θ' ὁρωμένων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:587.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:587.1.text#ἐγὼ δὲ τὴν μὲν συμφορὰν ἀσπάζομαι,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:588.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:588.1.text#πατέρα σ' ἀνευρών· ὧν δὲ γιγνώσκω, πάτερ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:589.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:589.1.text#ἄκουσον. εἶναί φασι τὰς αὐτόχθονας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:590.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:590.1.text#κλεινὰς Ἀθήνας οὐκ ἐπείσακτον γένος,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:591.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:591.1.text#ἵν' ἐσπεσοῦμαι δύο νόσω κεκτημένος,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:592.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:592.1.text#πατρός τ' ἐπακτοῦ καὐτὸς ὢν νοθαγενής.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:593.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:593.1.text#καὶ τοῦτ' ἔχων τοὔνειδος, ἀσθενὴς μὲν ὤν —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:594.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:594.1.text#[ μηδὲν καὶ οὐδὲν ὢν κεκλήσομαι· ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:595.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:595.1.text#ἢν δ' ἐς τὸ πρῶτον πόλεος ὁρμηθεὶς ζυγὸν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:596.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:596.1.text#ζητῶ τις εἶναι, τῶν μὲν ἀδυνάτων ὕπο
urn:cts:greekLit:tlg0006.tlg010.fu.sp:597.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:597.1.text#μισησόμεσθα· λυπρὰ γὰρ τὰ κρείσσονα·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:598.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:598.1.text#ὅσοι δέ, χρηστοὶ δυνάμενοί τ' εἶναι σοφοί,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:599.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:599.1.text#σιγῶσι κοὐ σπεύδουσιν ἐς τὰ πράγματα,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:600.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:600.1.text#γέλωτ' ἐν αὐτοῖς μωρίαν τε λήψομαι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:601.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:601.1.text#οὐχ ἡσυχάζων ἐν πόλει φόβου πλέᾳ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:602.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:602.1.text#τῶν δ' [ αὖ λογίων τε ] χρωμένων τε τῇ πόλει
urn:cts:greekLit:tlg0006.tlg010.fu.sp:603.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:603.1.text#ἐς ἀξίωμα βὰς πλέον φρουρήσομαι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:604.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:604.1.text#ψήφοισιν. οὕτω γὰρ τάδ', ὦ πάτερ, φιλεῖ·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:605.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:605.1.text#οἳ τὰς πόλεις ἔχουσι κἀξιώματα,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:606.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:606.1.text#τοῖς ἀνθαμίλλοις εἰσὶ πολεμιώτατοι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:607.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:607.1.text#ἐλθὼν δ' ἐς οἶκον ἀλλότριον ἔπηλυς ὢν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:608.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:608.1.text#γυναῖκά θ' ὡς ἄτεκνον, ἣ κοινουμένη
urn:cts:greekLit:tlg0006.tlg010.fu.sp:609.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:609.1.text#τὰς συμφοράς σοι πρόσθεν, ἀπολαχοῦσα νῦν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:610.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:610.1.text#αὐτὴ καθ' αὑτὴν τὴν τύχην οἴσει πικρῶς,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:611.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:611.1.text#πῶς οὐχ ὑπ' αὐτῆς εἰκότως μισήσομαι,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:612.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:612.1.text#ὅταν παραστῶ σοὶ μὲν ἐγγύθεν ποδός,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:613.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:613.1.text#ἣ δ' οὖσ' ἄτεκνος τὰ σὰ φίλ' εἰσορᾷ πικρῶς,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:614.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:614.1.text#κᾆτ' ἢ προδοὺς σύ μ' ἐς δάμαρτα σὴν βλέπῃς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:615.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:615.1.text#ἢ τἀμὰ τιμῶν δῶμα συγχέας ἔχῃς;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:616.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:616.1.text#ὅσας σφαγὰς δὴ φαρμάκων τε θανασίμων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:617.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:617.1.text#γυναῖκες ηὗρον ἀνδράσιν διαφθοράς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:618.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:618.1.text#ἄλλως τε τὴν σὴν ἄλοχον οἰκτίρω, πάτερ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:619.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:619.1.text#ἄπαιδα γηράσκουσαν· οὐ γὰρ ἀξία
urn:cts:greekLit:tlg0006.tlg010.fu.sp:620.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:620.1.text#πατέρων ἀπ' ἐσθλῶν οὖσ' ἀπαιδίᾳ νοσεῖν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:621.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:621.1.text#τυραννίδος δὲ τῆς μάτην αἰνουμένης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:622.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:622.1.text#τὸ μὲν πρόσωπον ἡδύ, τἀν δόμοισι δὲ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:623.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:623.1.text#λυπηρά· τίς γὰρ μακάριος, τίς εὐτυχής,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:624.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:624.1.text#ὅστις δεδοικὼς καὶ παραβλέπων βίον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:625.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:625.1.text#αἰῶνα τείνει; δημότης ἂν εὐτυχὴς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:626.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:626.1.text#ζῆν ἂν θέλοιμι μᾶλλον ἢ τύραννος ὤν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:627.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:627.1.text#ᾧ τοὺς πονηροὺς ἡδονὴ φίλους ἔχειν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:628.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:628.1.text#ἐσθλοὺς δὲ μισεῖ κατθανεῖν φοβούμενος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:629.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:629.1.text#εἴποις ἂν ὡς ὁ χρυσὸς ἐκνικᾷ τάδε,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:630.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:630.1.text#πλουτεῖν τε τερπνόν; οὐ φιλῶ ψόφους κλύειν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:631.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:631.1.text#ἐν χερσὶ σῴζων ὄλβον οὐδ' ἔχειν πόνους·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:632.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:632.1.text#εἴη γ' ἐμοὶ { μὲν } μέτρια μὴ λυπουμένῳ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:633.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:633.1.text#ἃ δ' ἐνθάδ' εἶχον ἀγάθ' ἄκουσόν μου, πάτερ·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:634.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:634.1.text#τὴν φιλτάτην μὲν πρῶτον ἀνθρώπῳ σχολὴν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:635.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:635.1.text#ὄχλον τε μέτριον, οὐδέ μ' ἐξέπληξ' ὁδοῦ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:636.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:636.1.text#πονηρὸς οὐδείς· κεῖνο δ' οὐκ ἀνασχετόν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:637.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:637.1.text#εἴκειν ὁδοῦ χαλῶντα τοῖς κακίοσιν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:638.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:638.1.text#θεῶν δ' ἐν εὐχαῖς [ ἢ γόοισιν ἦ ] βροτῶν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:639.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:639.1.text#ὑπηρετῶν χαίρουσιν, οὐ γοωμένοις.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:640.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:640.1.text#καὶ τοὺς μὲν ἐξέπεμπον, οἳ δ' ἧκον ξένοι,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:641.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:641.1.text#ὥσθ' ἡδὺς αἰεὶ καινὸς ἐν καινοῖσιν ἦ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:642.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:642.1.text#ὃ δ' εὐκτὸν ἀνθρώποισι, κἂν ἄκουσιν ᾖ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:643.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:643.1.text#δίκαιον εἶναί μ' ὁ νόμος ἡ φύσις θ' ἅμα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:644.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:644.1.text#παρεῖχε τῷ θεῷ. ταῦτα συννοούμενος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:645.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:645.1.text#κρείσσω νομίζω τἀνθάδ' ἢ τἀκεῖ, πάτερ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:646.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:646.1.text#ἔα δ' ἔμ' αὐτοῦ ζῆν· ἴση γὰρ ἡ χάρις,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:647.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:647.1.text#μεγάλοισι χαίρειν σμικρά θ' ἡδέως ἔχειν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:648.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:648.1.text#καλῶς ἔλεξας, εἴπερ οὓς ἐγὼ φιλῶ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:649.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:649.1.text#ἐν τοῖσι σοῖσιν εὐτυχήσουσιν φίλοις.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:650.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:650.1.text#παῦσαι λόγων τῶνδ', εὐτυχεῖν δ' ἐπίστασο·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:651.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:651.1.text#θέλω γὰρ οὗπέρ σ' ηὗρον ἄρξασθαι, τέκνον,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:652.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:652.1.text#κοινῆς τραπέζης, δαῖτα πρὸς κοινὴν πεσών,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:653.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:653.1.text#θῦσαί θ' ἅ σου πρὶν γενέθλι' οὐκ ἐθύσαμεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:654.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:654.1.text#καὶ νῦν μὲν ὡς δὴ ξένον ἄγων σ' ἐφέστιον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:655.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:655.1.text#δείπνοισι τέρψω, τῆς δ' Ἀθηναίων χθονὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:656.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:656.1.text#ἄξω θεατὴν δῆθεν, ὡς οὐκ ὄντ' ἐμόν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:657.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:657.1.text#καὶ γὰρ γυναῖκα τὴν ἐμὴν οὐ βούλομαι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:658.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:658.1.text#λυπεῖν ἄτεκνον οὖσαν αὐτὸς εὐτυχῶν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:659.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:659.1.text#χρόνῳ δὲ καιρὸν λαμβάνων προσάξομαι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:660.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:660.1.text#δάμαρτ' ἐᾶν σε σκῆπτρα τἄμ' ἔχειν χθονός.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:661.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:661.1.text#Ἴωνα δ' ὀνομάζω σε τῇ τύχῃ πρέπον,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:662.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:662.1.text#ὁθούνεκ' ἀδύτων ἐξιόντι μοι θεοῦ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:663.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:663.1.text#ἴχνος συνῆψας πρῶτος. ἀλλὰ τῶν φίλων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:664.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:664.1.text#πλήρωμ' ἀθροίσας βουθύτῳ σὺν ἡδονῇ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:665.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:665.1.text#πρόσειπε, μέλλων Δελφίδ' ἐκλιπεῖν πόλιν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:666.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:666.1.text#ὑμῖν δὲ σιγᾶν, δμωΐδες, λέγω τάδε,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:667.1.speaker#Ξοῦθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:667.1.text#ἢ θάνατον εἰπούσαισι πρὸς δάμαρτ' ἐμήν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:668.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:668.1.text#στείχοιμ' ἄν. ἓν δὲ τῆς τύχης ἄπεστί μοι·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:669.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:669.1.text#εἰ μὴ γὰρ ἥτις μ' ἔτεκεν εὑρήσω, πάτερ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:670.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:670.1.text#ἀβίωτον ἡμῖν. εἰ δ' ἐπεύξασθαι χρεών,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:671.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:671.1.text#ἐκ τῶν Ἀθηνῶν μ' ἡ τεκοῦσ' εἴη γυνή,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:672.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:672.1.text#ὥς μοι γένηται μητρόθεν παρρησία.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:673.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:673.1.text#καθαρὰν γὰρ ἤν τις ἐς πόλιν πέσῃ ξένος,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:674.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:674.1.text#κἂν τοῖς λόγοισιν ἀστὸς ᾖ, τό γε στόμα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:675.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:675.1.text#δοῦλον πέπαται κοὐκ ἔχει παρρησίαν.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:676.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:676.1.text#ὁρῶ δάκρυα καὶ πενθίμους
urn:cts:greekLit:tlg0006.tlg010.fu.sp:677.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:677.1.text#{ ἀλαλαγὰς } στεναγμάτων τ' ἐσβολάς,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:678.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:678.1.text#ὅταν ἐμὰ τύραννος εὐπαιδίαν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:679.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:679.1.text#πόσιν ἔχοντ' εἰδῇ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:680.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:680.1.text#αὐτὴ δ' ἄπαις ᾖ καὶ λελειμμένη τέκνων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:681.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:681.1.text#τίν', ὦ παῖ πρόμαντι Λατοῦς, ἔχρησας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:682.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:682.1.text#ὑμνῳδίαν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:683.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:683.1.text#πόθεν ὁ παῖς ὅδ' ἀμφὶ ναοὺς σέθεν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:684.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:684.1.text#τρόφιμος ἐξέβα; γυναικῶν τίνος;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:685.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:685.1.text#οὐ γάρ με σαίνει θέσφατα μή τιν' ἔχῃ δόλον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:688.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:688.1.text#δειμαίνω συμφοράν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:689.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:689.1.text#ἐφ' ὅ ποτε βάσεται.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:690.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:690.1.text#ἄτοπος ἄτοπα γὰρ  δίδωσί μοι,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:691.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:691.1.text#τὸ δ' ἔτ' εὔφημ' ἔχει,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:692.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:692.1.text#δόλον τύχαν θ', ὁ παῖς [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:693.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:693.1.text#ἄλλων τραφεὶς ἐξ αἱμάτων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:694.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:694.1.text#τίς οὐ τάδε ξυνοίσεται;[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:695.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:695.1.text#— φίλαι, πότερ' ἐμᾷ δεσποίνᾳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:696.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:696.1.text#τάδε τορῶς ἐς οὖς γεγωνήσομεν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:697.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:697.1.text#πόσιν, ἐν ᾧ τὰ πάντ' ἔχουσ' ἐλπίδων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:698.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:698.1.text#μέτοχος ἦν, τλάμων,  [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:699.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:699.1.text#— νῦν δ' ἣ μὲν ἔρρει συμφοραῖς, ὃ δ' εὐτυχεῖ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:700.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:700.1.text#— πολιὸν ἐσπεσοῦσα γῆρας, πόσις δ'  [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:701.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:701.1.text#— ἀτίετος φίλων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:702.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:702.1.text#— μέλεος, ὃς θυραῖος ἐλθὼν δόμους,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:703.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:703.1.text#μέγαν ἐς ὄλβον, οὐκ ἴσωσεν τύχης [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:704.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:704.1.text#(— ὄλοιτ', ὄλοιτο) πότνιαν ἐξαπαφὼν ἐμάν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:705.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:705.1.text#— καὶ θεοῖσιν μὴ τύχοι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:706.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:706.1.text#καλλίφλογα πέλανον ἐπὶ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:707.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:707.1.text#πυρὶ καθαγνίσας· τὸ δ' ἐμὸν εἴσεται,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:708.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:708.1.text#{ ὅσον ἀμᾶς ἔφυν }
urn:cts:greekLit:tlg0006.tlg010.fu.sp:710.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:710.1.text#τυραννίδος φίλα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:711.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:711.1.text#— ἦ δὴ πέλας δείπνων κυρεῖ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:713.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:713.1.text#παῖς καὶ πατὴρ νέος νέων.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:714.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:714.1.text#ἰὼ δειράδες Παρνασοῦ πέτρας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:715.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:715.1.text#ἔχουσαι σκόπελον οὐράνιόν θ' ἕδραν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:716.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:716.1.text#ἵνα Βάκχιος ἀμφιπύρους ἀνέχων πεύκας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:717.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:717.1.text#λαιψηρὰ πηδᾷ νυκτιπόλοις ἅμα σὺν Βάκχαις,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:719.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:719.1.text#μή ποτ' εἰς ἐμὰν πόλιν ἵκοιθ' ὁ παῖς,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:720.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:720.1.text#νέαν δ' ἁμέραν ἀπολιπὼν θάνοι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:721.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:721.1.text#στενομένα γὰρ ἂν πόλις ἔχοι σκῆψιν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:722.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:722.1.text#ξενικὸν ἐσβολὰν  [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:722.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:722.2.text#[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:723.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:723.1.text#ἁλίσας ὁ πάρος ἀρχαγὸς ὢν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:724.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:724.1.text#Ἐρεχθεὺς ἄναξ.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:725.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:725.1.text#ὦ πρέσβυ παιδαγώγ' Ἐρεχθέως πατρὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:726.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:726.1.text#τοὐμοῦ ποτ' ὄντος, ἡνίκ' ἦν ἔτ' ἐν φάει,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:727.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:727.1.text#ἔπαιρε σαυτὸν πρὸς θεοῦ χρηστήρια,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:728.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:728.1.text#ὥς μοι συνησθῇς, εἴ τι Λοξίας ἄναξ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:729.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:729.1.text#θέσπισμα παίδων ἐς γονὰς ἐφθέγξατο.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:730.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:730.1.text#σὺν τοῖς φίλοις γὰρ ἡδὺ μὲν πράσσειν καλῶς·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:731.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:731.1.text#ἃ μὴ γένοιτο δ', εἴ τι τυγχάνοι κακόν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:732.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:732.1.text#ἐς ὄμματ' εὔνου φωτὸς ἐμβλέψαι γλυκύ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:733.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:733.1.text#ἐγὼ δέ σ', ὥσπερ καὶ σὺ πατέρ' ἐμόν ποτε,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:734.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:734.1.text#δέσποιν' ὅμως οὖσ' ἀντικηδεύω πατρός.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:735.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:735.1.text#ὦ θύγατερ, ἄξι' ἀξίων γεννητόρων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:736.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:736.1.text#ἤθη φυλάσσεις, κοὐ καταισχύνασ' ἔχεις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:737.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:737.1.text#τοὺς σοὺς παλαιούς, ἐκγόνους αὐτόχθονας.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:738.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:738.1.text#ἕλχ' ἕλκε πρὸς μέλαθρα καὶ κόμιζέ με.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:739.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:739.1.text#αἰπεινά τοι μαντεῖα· τοῦ γήρως δέ μοι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:740.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:740.1.text#συνεκπονοῦσα κῶλον ἰατρὸς γενοῦ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:741.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:741.1.text#ἕπου νυν· ἴχνος δ' ἐκφύλασσ' ὅπου τίθης.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:742.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:742.1.text#ἰδού.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:742.2.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:742.2.text#τὸ τοῦ ποδὸς μὲν βραδύ, τὸ τοῦ δὲ νοῦ ταχύ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:743.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:743.1.text#βάκτρῳ δ' ἐρείδου περιφερῆ στίβον χθονός.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:744.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:744.1.text#καὶ τοῦτο τυφλόν, ὅταν ἐγὼ βλέπω βραχύ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:745.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:745.1.text#ὀρθῶς ἔλεξας· ἀλλὰ μὴ παρῇς κόπῳ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:746.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:746.1.text#οὔκουν ἑκών γε· τοῦ δ' ἀπόντος οὐ κρατῶ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:747.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:747.1.text#γυναῖκες, ἱστῶν τῶν ἐμῶν καὶ κερκίδος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:748.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:748.1.text#δούλευμα πιστόν, τίνα τύχην λαβὼν πόσις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:749.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:749.1.text#βέβηκε παίδων, ὧνπερ οὕνεχ' ἥκομεν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:750.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:750.1.text#σημήνατ'· εἰ γὰρ ἀγαθά μοι μηνύσετε,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:751.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:751.1.text#οὐκ εἰς ἀπίστους δεσπότας βαλεῖς χάριν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:752.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:752.1.text#ἰὼ δαῖμον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:753.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:753.1.text#τὸ φροίμιον μὲν τῶν λόγων οὐκ εὐτυχές.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:754.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:754.1.text#ἰὼ τλᾶμον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:755.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:755.1.text#ἀλλ' ἦ τι θεσφάτοισι δεσποτῶν νοσῶ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:756.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:756.1.text#εἶἑν· τί δρῶμεν; θάνατος ὧν κεῖται πέρι  [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:757.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:757.1.text#τίς ἥδε μοῦσα, χὡ φόβος τίνων πέρι;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:758.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:758.1.text#εἴπωμεν ἢ σιγῶμεν; ἢ τί δράσομεν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:759.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:759.1.text#εἴφ'· ὡς ἔχεις γε συμφοράν τιν' εἰς ἐμέ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:760.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:760.1.text#εἰρήσεταί τοι, κεἰ θανεῖν μέλλω διπλῇ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:761.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:761.1.text#οὐκ ἔστι σοι, δέσποιν', ἐπ' ἀγκάλαις λαβεῖν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:762.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:762.1.text#τέκν', οὐδὲ μαστῷ σῷ προσαρμόσαι ποτέ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:762.2.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:762.2.text#ὤμοι, θάνοιμι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:763.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:763.1.text#θύγατερ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:763.2.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:763.2.text#ὦ τάλαιν'
urn:cts:greekLit:tlg0006.tlg010.fu.sp:764.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:764.1.text#ἐγὼ συμφορᾶς, ἔλαβον ἔπαθον ἄχος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:764.2.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:764.2.text#ἀβίοτον, φίλαι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:764.2.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:764.2.text#διοιχόμεσθα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:765.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:765.1.text#τέκνον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:765.2.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:765.2.text#αἰαῖ αἰαῖ·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:767.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:767.1.text#διανταῖος ἔτυπεν ὀδύνα με πλευμόνων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:768.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:768.1.text#τῶνδ' ἔσω.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:769.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:769.1.text#μήπω στενάξῃς [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:769.2.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:769.2.text#ἀλλὰ πάρεισι γόοι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:770.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:770.1.text#πρὶν ἂν μάθωμεν [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:770.2.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:770.2.text#ἀγγελίαν τίνα μοι;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:771.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:771.1.text#εἰ ταὐτὰ πράσσων δεσπότης τῆς συμφορᾶς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:772.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:772.1.text#κοινωνός ἐστιν, ἢ μόνη σὺ δυστυχεῖς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:774.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:774.1.text#κείνῳ μέν, ὦ γεραιέ, παῖδα Λοξίας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:775.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:775.1.text#ἔδωκεν, ἰδίᾳ δ' εὐτυχεῖ ταύτης δίχα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:776.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:776.1.text#τόδ' ἐπὶ τῷδε κακὸν ἄκρον ἔλακες
urn:cts:greekLit:tlg0006.tlg010.fu.sp:777.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:777.1.text#ἄχος ἐμοὶ στένειν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:778.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:778.1.text#πότερα δὲ φῦναι δεῖ γυναικὸς ἔκ τινος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:779.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:779.1.text#τὸν παῖδ' ὃν εἶπας, ἢ γεγῶτ' ἐθέσπισεν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:780.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:780.1.text#ἤδη πεφυκότ' ἐκτελῆ νεανίαν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:781.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:781.1.text#δίδωσιν αὐτῷ Λοξίας· παρῆ δ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:782.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:782.1.text#πῶς φῄς; ἄφατον ἄφατον ἀναύδητον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:783.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:783.1.text#λόγον ἐμοὶ θροεῖς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:785.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:785.1.text#κἄμοιγε. πῶς δ' ὁ χρησμὸς ἐκπεραίνεται,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:786.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:786.1.text#σαφέστερόν μοι φράζε, χὥστις ἔσθ' ὁ παῖς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:787.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:787.1.text#ὅτῳ ξυναντήσειεν ἐκ θεοῦ συθεὶς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:788.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:788.1.text#πρώτῳ πόσις σός, παῖδ' ἔδωκ' αὐτῷ θεός.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:789.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:789.1.text#ὀττοτοττοτοῖ· τὸν δ' ἐμὸν ἄτεκνον ἄτεκνον ἔλακεν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:790.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:790.1.text#ἄρα βίοτον; ἐρημίᾳ δ' ὀρφανοὺς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:791.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:791.1.text#δόμους οἰκήσω.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:792.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:792.1.text#τίς οὖν ἐχρήσθη; τῷ συνῆψ' ἴχνος ποδὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:793.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:793.1.text#πόσις ταλαίνης; πῶς δὲ ποῦ νιν εἰσιδών;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:794.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:794.1.text#οἶσθ', ὦ φίλη δέσποινα, τὸν νεανίαν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:795.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:795.1.text#ὃς τόνδ' ἔσαιρε ναόν; οὗτος ἔσθ' ὁ παῖς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:796.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:796.1.text#ἀν' ὑγρὸν ἀμπταίην αἰθέρα πόρσω γαίας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:797.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:797.1.text#Ἑλλανίας, ἀστέρας ἑσπέρους,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:799.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:799.1.text#οἷον οἷον ἄλγος ἔπαθον, φίλαι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:800.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:800.1.text#ὄνομα δὲ ποῖον αὐτὸν ὀνομάζει πατήρ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:801.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:801.1.text#οἶσθ', ἢ σιωπῇ τοῦτ' ἀκύρωτον μένει;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:802.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:802.1.text#Ἴων', ἐπείπερ πρῶτος ἤντησεν πατρί.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:803.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:803.1.text#μητρὸς δ' ὁποίας ἐστὶν —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:803.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:803.2.text#οὐκ ἔχω φράσαι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:804.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:804.1.text#φροῦδος δ' — ἵν' εἰδῇς πάντα τἀπ' ἐμοῦ, γέρον —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:805.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:805.1.text#παιδὸς προθύσων ξένια καὶ γενέθλια
urn:cts:greekLit:tlg0006.tlg010.fu.sp:806.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:806.1.text#σκηνὰς ἐς ἱερὰς τῆσδε λαθραίως πόσις,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:807.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:807.1.text#κοινὴν ξυνάψων δαῖτα παιδὶ τῷ νέῳ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:808.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:808.1.text#δέσποινα, προδεδόμεσθα — σὺν γάρ σοι νοσῶ —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:809.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:809.1.text#τοῦ σοῦ πρὸς ἀνδρός, καὶ μεμηχανημένως
urn:cts:greekLit:tlg0006.tlg010.fu.sp:810.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:810.1.text#ὑβριζόμεσθα δωμάτων τ' Ἐρεχθέως
urn:cts:greekLit:tlg0006.tlg010.fu.sp:811.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:811.1.text#ἐκβαλλόμεσθα. καὶ σὸν οὐ στυγῶν πόσιν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:812.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:812.1.text#λέγω, σὲ μέντοι μᾶλλον ἢ κεῖνον φιλῶν·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:813.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:813.1.text#ὅστις σε γήμας ξένος ἐπεισελθὼν πόλιν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:814.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:814.1.text#καὶ δῶμα καὶ σὴν παραλαβὼν παγκληρίαν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:815.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:815.1.text#ἄλλης γυναικὸς παῖδας ἐκκαρπούμενος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:816.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:816.1.text#λάθρα πέφηνεν· ὡς λάθρα δ', ἐγὼ φράσω.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:817.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:817.1.text#ἐπεί σ' ἄτεκνον ᾔσθετ', οὐκ ἔστεργέ σοι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:818.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:818.1.text#ὅμοιος εἶναι τῆς τύχης τ' ἴσον φέρειν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:819.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:819.1.text#λαβὼν δὲ δοῦλα λέκτρα νυμφεύσας λάθρα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:820.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:820.1.text#τὸν παῖδ' ἔφυσεν, ἐξενωμένον δέ τῳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:821.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:821.1.text#Δελφῶν δίδωσιν ἐκτρέφειν. ὃ δ' ἐν θεοῦ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:822.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:822.1.text#δόμοισιν ἄφετος, ὡς λάθοι, παιδεύεται.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:823.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:823.1.text#νεανίαν δ' ὡς ᾔσθετ' ἐκτεθραμμένον,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:824.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:824.1.text#ἐλθεῖν σ' ἔπεισε δεῦρ' ἀπαιδίας χάριν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:825.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:825.1.text#κᾆθ' ὁ θεὸς οὐκ ἐψεύσαθ', ὅδε δ' ἐψεύσατο
urn:cts:greekLit:tlg0006.tlg010.fu.sp:826.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:826.1.text#πάλαι τρέφων τὸν παῖδα, κἄπλεκεν πλοκὰς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:827.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:827.1.text#τοιάσδ'· ἁλοὺς μὲν ἀνέφερ' ἐς τὸν δαίμονα,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:828.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:828.1.text#[ ἐλθὼν δὲ καὶ τὸν χρόνον ἀμύνεσθαι θέλων ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:829.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:829.1.text#τυραννίδ' αὐτῷ περιβαλεῖν ἔμελλε γῆς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:830.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:830.1.text#καινὸν δὲ τοὔνομ' ἀνὰ χρόνον πεπλασμένον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:831.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:831.1.text#Ἴων, ἰόντι δῆθεν ὅτι συνήντετο.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:832.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:832.1.text#οἴμοι, κακούργους ἄνδρας ὡς αἰεὶ στυγῶ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:833.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:833.1.text#οἳ συντιθέντες τἄδικ' εἶτα μηχαναῖς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:834.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:834.1.text#κοσμοῦσι. φαῦλον χρηστὸν ἂν λαβεῖν φίλον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:835.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:835.1.text#θέλοιμι μᾶλλον ἢ κακὸν σοφώτερον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:836.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:836.1.text#καὶ τῶνδ' ἁπάντων ἔσχατον πείσῃ κακόν·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:837.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:837.1.text#ἀμήτορ', ἀναρίθμητον, ἐκ δούλης τινὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:838.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:838.1.text#γυναικός, ἐς σὸν δῶμα δεσπότην ἄγειν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:839.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:839.1.text#ἁπλοῦν ἂν ἦν γὰρ τὸ κακόν, εἰ παρ' εὐγενοῦς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:840.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:840.1.text#μητρός, πιθών σε, σὴν λέγων ἀπαιδίαν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:841.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:841.1.text#ἐσῴκισ' οἴκους· εἰ δὲ σοὶ τόδ' ἦν πικρόν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:842.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:842.1.text#τῶν Αἰόλου νιν χρῆν ὀρεχθῆναι γάμων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:843.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:843.1.text#ἐκ τῶνδε δεῖ σε δὴ γυναικεῖόν τι δρᾶν·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:844.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:844.1.text#ἢ γὰρ ξίφος λαβοῦσαν ἢ δόλῳ τινὶ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:845.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:845.1.text#ἢ φαρμάκοισι σὸν κατακτεῖναι πόσιν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:846.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:846.1.text#καὶ παῖδα, πρὶν σοὶ θάνατον ἐκ κείνων μολεῖν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:847.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:847.1.text#[ εἰ γάρ γ' ὑφήσεις τοῦδ', ἀπαλλάξῃ βίου. ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:848.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:848.1.text#[ δυοῖν γὰρ ἐχθροῖν εἰς ἓν ἐλθόντοιν στέγος, ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:849.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:849.1.text#[ ἢ θάτερον δεῖ δυστυχεῖν ἢ θάτερον. ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:850.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:850.1.text#ἐγὼ μὲν οὖν σοι καὶ συνεκπονεῖν θέλω,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:851.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:851.1.text#καὶ συμφονεύειν παῖδ' ἐπεισελθὼν δόμους
urn:cts:greekLit:tlg0006.tlg010.fu.sp:852.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:852.1.text#οὗ δαῖθ' ὁπλίζει, καὶ τροφεῖα δεσπόταις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:853.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:853.1.text#ἀποδοὺς θανεῖν τε ζῶν τε φέγγος εἰσορᾶν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:854.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:854.1.text#ἓν γάρ τι τοῖς δούλοισιν αἰσχύνην φέρει,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:855.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:855.1.text#τοὔνομα· τὰ δ' ἄλλα πάντα τῶν ἐλευθέρων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:856.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:856.1.text#οὐδὲν κακίων δοῦλος, ὅστις ἐσθλὸς ᾖ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:857.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:857.1.text#κἀγώ, φίλη δέσποινα, συμφορὰν θέλω
urn:cts:greekLit:tlg0006.tlg010.fu.sp:858.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:858.1.text#κοινουμένη τήνδ' ἢ θανεῖν ἢ ζῆν καλῶς.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:859.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:859.1.text#ὦ ψυχά, πῶς σιγάσω;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:860.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:860.1.text#πῶς δὲ σκοτίας ἀναφήνω
urn:cts:greekLit:tlg0006.tlg010.fu.sp:861.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:861.1.text#εὐνάς, αἰδοῦς δ' ἀπολειφθῶ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:862.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:862.1.text#τί γὰρ ἐμπόδιον κώλυμ' ἔτι μοι;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:863.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:863.1.text#πρὸς τίν' ἀγῶνας τιθέμεσθ' ἀρετῆς;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:864.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:864.1.text#οὐ πόσις ἡμῶν προδότης γέγονεν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:865.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:865.1.text#στέρομαι δ' οἴκων, στέρομαι παίδων,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:866.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:866.1.text#φροῦδαι δ' ἐλπίδες, ἃς διαθέσθαι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:867.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:867.1.text#χρῄζουσα καλῶς οὐκ ἐδυνήθην,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:868.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:868.1.text#σιγῶσα γάμους,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:869.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:869.1.text#σιγῶσα τόκους πολυκλαύτους;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:870.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:870.1.text#ἀλλ' οὐ τὸ Διὸς πολύαστρον ἕδος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:871.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:871.1.text#καὶ τὴν ἐπ' ἐμοῖς σκοπέλοισι θεὰν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:872.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:872.1.text#λίμνης τ' ἐνύδρου Τριτωνιάδος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:873.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:873.1.text#πότνιαν ἀκτάν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:874.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:874.1.text#οὐκέτι κρύψω λέχος, ὡς στέρνων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:875.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:875.1.text#ἀπονησαμένη ῥᾴων ἔσομαι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:876.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:876.1.text#στάζουσι κόραι δακρύοισιν ἐμαί,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:877.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:877.1.text#ψυχὴ δ' ἀλγεῖ κακοβουλευθεῖσ'
urn:cts:greekLit:tlg0006.tlg010.fu.sp:878.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:878.1.text#ἔκ τ' ἀνθρώπων ἔκ τ' ἀθανάτων,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:879.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:879.1.text#οὓς ἀποδείξω
urn:cts:greekLit:tlg0006.tlg010.fu.sp:880.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:880.1.text#λέκτρων προδότας ἀχαρίστους.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:881.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:881.1.text#ὦ τᾶς ἑπταφθόγγου μέλπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:882.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:882.1.text#κιθάρας ἐνοπάν, ἅτ' ἀγραύλοις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:883.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:883.1.text#κέρασιν ἐν ἀψύχοις ἀχεῖ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:884.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:884.1.text#μουσᾶν ὕμνους εὐαχήτους,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:885.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:885.1.text#σοὶ μομφάν, ὦ Λατοῦς παῖ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:886.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:886.1.text#πρὸς τάνδ' αὐγὰν αὐδάσω.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:887.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:887.1.text#ἦλθές μοι χρυσῷ χαίταν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:888.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:888.1.text#μαρμαίρων, εὖτ' ἐς κόλπους
urn:cts:greekLit:tlg0006.tlg010.fu.sp:889.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:889.1.text#κρόκεα πέταλα φάρεσιν ἔδρεπον,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:890.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:890.1.text#ἀνθίζειν χρυσανταυγῆ·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:891.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:891.1.text#λευκοῖς δ' ἐμφὺς καρποῖσιν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:892.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:892.1.text#χειρῶν εἰς ἄντρου κοίτας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:893.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:893.1.text#κραυγὰν Ὦ μᾶτέρ μ' αὐδῶσαν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:894.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:894.1.text#θεὸς ὁμευνέτας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:895.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:895.1.text#ἆγες ἀναιδείᾳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:896.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:896.1.text#Κύπριδι χάριν πράσσων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:897.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:897.1.text#τίκτω δ' ἁ δύστανός σοι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:898.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:898.1.text#κοῦρον, τὸν φρίκᾳ ματρὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:899.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:899.1.text#εἰς εὐνὰν βάλλω τὰν σάν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:900.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:900.1.text#ἵνα με λέχεσι μελέαν μελέοις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:901.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:901.1.text#ἐζεύξω τὰν δύστανον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:902.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:902.1.text#οἴμοι μοι· καὶ νῦν ἔρρει
urn:cts:greekLit:tlg0006.tlg010.fu.sp:903.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:903.1.text#πτανοῖς ἁρπασθεὶς θοίνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:904.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:904.1.text#παῖς μοι [ … ] καὶ σός, τλάμων·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:905.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:905.1.text#σὺ δὲ κιθάρᾳ κλάζεις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:906.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:906.1.text#παιᾶνας μέλπων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:907.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:907.1.text#ὠή,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:907.2.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:907.2.text#τὸν Λατοῦς αὐδῶ { σ' },
urn:cts:greekLit:tlg0006.tlg010.fu.sp:908.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:908.1.text#ὅστ' ὀμφὰν κληροῖς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:909.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:909.1.text#πρὸς χρυσέους θάκους
urn:cts:greekLit:tlg0006.tlg010.fu.sp:910.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:910.1.text#καὶ γαίας μεσσήρεις ἕδρας,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:911.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:911.1.text#εἰς οὖς αὐδὰν καρύξω·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:912.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:912.1.text#Ἰὼ κακὸς εὐνάτωρ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:913.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:913.1.text#ὃς τῷ μὲν ἐμῷ νυμφεύτᾳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:914.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:914.1.text#χάριν οὐ προλαβὼν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:915.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:915.1.text#παῖδ' εἰς οἴκους οἰκίζεις·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:916.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:916.1.text#ὁ δ' ἐμὸς γενέτας καὶ σός γ', ἀμαθής,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:917.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:917.1.text#οἰωνοῖς ἔρρει συλαθείς,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:918.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:918.1.text#σπάργανα ματέρος ἐξαλλάξας.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:919.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:919.1.text#μισεῖ σ' ἁ Δᾶλος καὶ δάφνας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:920.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:920.1.text#ἔρνεα φοίνικα παρ' ἁβροκόμαν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:921.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:921.1.text#ἔνθα λοχεύματα σέμν' ἐλοχεύσατο
urn:cts:greekLit:tlg0006.tlg010.fu.sp:922.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:922.1.text#Λατὼ Δίοισί σε καρποῖς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:923.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:923.1.text#οἴμοι, μέγας θησαυρὸς ὡς ἀνοίγνυται
urn:cts:greekLit:tlg0006.tlg010.fu.sp:924.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:924.1.text#κακῶν, ἐφ' οἷσι πᾶς ἂν ἐκβάλοι δάκρυ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:925.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:925.1.text#ὦ θύγατερ, οὔτοι σὸν βλέπων ἐμπίμπλαμαι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:926.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:926.1.text#πρόσωπον, ἔξω δ' ἐγενόμην γνώμης ἐμῆς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:927.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:927.1.text#κακῶν γὰρ ἄρτι κῦμ' ὑπεξαντλῶν φρενί,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:928.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:928.1.text#πρύμνηθεν αἴρει μ' ἄλλο σῶν λόγων ὕπο,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:929.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:929.1.text#οὓς ἐκβαλοῦσα τῶν παρεστώτων κακῶν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:930.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:930.1.text#μετῆλθες ἄλλων πημάτων κακὰς ὁδούς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:931.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:931.1.text#τί φῄς; τίνα λόγον Λοξίου κατηγορεῖς;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:932.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:932.1.text#ποῖον τεκεῖν φῂς παῖδα; ποῦ θεῖναι πόλεως
urn:cts:greekLit:tlg0006.tlg010.fu.sp:933.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:933.1.text#θηρσὶν φίλον τύμβευμ'; ἄνελθέ μοι πάλιν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:934.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:934.1.text#αἰσχύνομαι μέν σ', ὦ γέρον, λέξω δ' ὅμως.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:935.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:935.1.text#ὡς συστενάζειν γ' οἶδα γενναίως φίλοις.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:936.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:936.1.text#ἄκουε τοίνυν· οἶσθα Κεκροπίας πέτρας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:937.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:937.1.text#πρόσβορρον ἄντρον, ἃς Μακρὰς κικλήσκομεν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:938.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:938.1.text#οἶδ', ἔνθα Πανὸς ἄδυτα καὶ βωμοὶ πέλας.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:939.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:939.1.text#ἐνταῦθ' ἀγῶνα δεινὸν ἠγωνίσμεθα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:940.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:940.1.text#τίν'; ὡς ἀπαντᾷ δάκρυά μοι τοῖς σοῖς λόγοις.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:941.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:941.1.text#Φοίβῳ ξυνῆψ' ἄκουσα δύστηνον γάμον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:942.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:942.1.text#ὦ θύγατερ, ἆρ' ἦν ταῦθ' ἅ γ' ᾐσθόμην ἐγώ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:943.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:943.1.text#οὐκ οἶδ'· ἀληθῆ δ' εἰ λέγεις φαίημεν ἄν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:944.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:944.1.text#νόσον κρυφαίαν ἡνίκ' ἔστενες λάθρα;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:945.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:945.1.text#τότ' ἦν ἃ νῦν σοι φανερὰ σημαίνω κακά.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:946.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:946.1.text#κᾆτ' ἐξέκλεψας πῶς Ἀπόλλωνος γάμους;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:947.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:947.1.text#ἔτεκον — ἀνάσχου ταῦτ' ἐμοῦ κλύων, γέρον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:948.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:948.1.text#ποῦ; τίς λοχεύει σ'; ἢ μόνη μοχθεῖς τάδε;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:949.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:949.1.text#μόνη κατ' ἄντρον οὗπερ ἐζεύχθην γάμοις.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:950.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:950.1.text#ὁ παῖς δὲ ποῦ 'στιν; ἵνα σὺ μηκέτ' ᾖς ἄπαις.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:951.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:951.1.text#τέθνηκεν, ὦ γεραιέ, θηρσὶν ἐκτεθείς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:952.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:952.1.text#τέθνηκ'; Ἀπόλλων δ' ὁ κακὸς οὐδὲν ἤρκεσεν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:953.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:953.1.text#οὐκ ἤρκεσ'· Ἅιδου δ' ἐν δόμοις παιδεύεται.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:954.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:954.1.text#τίς γάρ νιν ἐξέθηκεν; οὐ γὰρ δὴ σύ γε.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:955.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:955.1.text#ἡμεῖς, ἐν ὄρφνῃ σπαργανώσαντες πέπλοις.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:956.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:956.1.text#οὐδὲ ξυνῄδει σοί τις ἔκθεσιν τέκνου;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:957.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:957.1.text#αἱ ξυμφοραί γε καὶ τὸ λανθάνειν μόνον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:958.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:958.1.text#καὶ πῶς ἐν ἄντρῳ παῖδα σὸν λιπεῖν ἔτλης;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:959.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:959.1.text#πῶς δ' οἰκτρὰ πολλὰ στόματος ἐκβαλοῦσ' ἔπη —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:960.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:960.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:960.2.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:960.2.text#τλήμων σὺ τόλμης, ὁ δὲ θεὸς μᾶλλον σέθεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:961.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:961.1.text#εἰ παῖδά γ' εἶδες χεῖρας ἐκτείνοντά μοι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:962.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:962.1.text#μαστὸν διώκοντ' ἦ πρὸς ἀγκάλαις πεσεῖν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:963.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:963.1.text#ἐνταῦθ', ἵν' οὐκ ὢν ἄδικ' ἔπασχεν ἐξ ἐμοῦ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:964.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:964.1.text#σοὶ δ' ἐς τί δόξ' ἐσῆλθεν ἐκβαλεῖν τέκνον;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:965.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:965.1.text#ὡς τὸν θεὸν σῴζοντα τόν γ' αὑτοῦ γόνον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:966.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:966.1.text#οἴμοι, δόμων σῶν ὄλβος ὡς χειμάζεται.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:967.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:967.1.text#τί κρᾶτα κρύψας, ὦ γέρον, δακρυρροεῖς;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:968.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:968.1.text#σὲ καὶ πατέρα σὸν δυστυχοῦντας εἰσορῶ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:969.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:969.1.text#τὰ θνητὰ τοιαῦτ'· οὐδὲν ἐν ταὐτῷ μένει.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:970.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:970.1.text#μή νυν ἔτ' οἴκτων, θύγατερ, ἀντεχώμεθα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:971.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:971.1.text#τί γάρ με χρὴ δρᾶν; ἀπορία τὸ δυστυχεῖν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:972.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:972.1.text#τὸν πρῶτον ἀδικήσαντά σ' ἀποτίνου θεόν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:973.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:973.1.text#καὶ πῶς τὰ κρείσσω θνητὸς οὖσ' ὑπερδράμω;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:974.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:974.1.text#πίμπρη τὰ σεμνὰ Λοξίου χρηστήρια.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:975.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:975.1.text#δέδοικα· καὶ νῦν πημάτων ἄδην ἔχω.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:976.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:976.1.text#τὰ δυνατά νυν τόλμησον, ἄνδρα σὸν κτανεῖν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:977.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:977.1.text#αἰδούμεθ' εὐνὰς τὰς τόθ' ἡνίκ' ἐσθλὸς ἦν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:978.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:978.1.text#νῦν δ' ἀλλὰ παῖδα τὸν ἐπὶ σοὶ πεφηνότα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:979.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:979.1.text#πῶς; εἰ γὰρ εἴη δυνατόν· ὡς θέλοιμί γ' ἄν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:980.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:980.1.text#ξιφηφόρους σοὺς ὁπλίσασ' ὀπάονας.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:981.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:981.1.text#στείχοιμ' ἄν· ἀλλὰ ποῦ γενήσεται τόδε;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:982.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:982.1.text#ἱεραῖσιν ἐν σκηναῖσιν, οὗ θοινᾷ φίλους.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:983.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:983.1.text#ἐπίσημον ὁ φόνος, καὶ τὸ δοῦλον ἀσθενές.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:984.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:984.1.text#ὤμοι, κακίζῃ· φέρε, σὺ νῦν βούλευέ τι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:985.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:985.1.text#καὶ μὴν ἔχω γε δόλια καὶ δραστήρια.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:986.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:986.1.text#ἀμφοῖν ἂν εἴην τοῖνδ' ὑπηρέτης ἐγώ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:987.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:987.1.text#ἄκουε τοίνυν· οἶσθα γηγενῆ μάχην;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:988.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:988.1.text#οἶδ', ἣν Φλέγρᾳ Γίγαντες ἔστησαν θεοῖς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:989.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:989.1.text#ἐνταῦθα Γοργόν' ἔτεκε Γῆ, δεινὸν τέρας.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:990.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:990.1.text#ἦ παισὶν αὑτῆς σύμμαχον, θεῶν πόνον;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:991.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:991.1.text#ναί· καί νιν ἔκτειν' ἡ Διὸς Παλλὰς θεά.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:992.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:992.1.text#[ ποῖόν τι μορφῆς σχῆμ' ἔχουσαν ἀγρίας; ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:993.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:993.1.text#[ θώρακ' ἐχίδνης περιβόλοις ὡπλισμένον. ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:994.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:994.1.text#ἆρ' οὗτός ἐσθ' ὁ μῦθος ὃν κλύω πάλαι;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:995.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:995.1.text#ταύτης Ἀθάναν δέρος ἐπὶ στέρνοις ἔχειν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:996.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:996.1.text#ἣν αἰγίδ' ὀνομάζουσι, Παλλάδος στολήν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:997.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:997.1.text#τόδ' ἔσχεν ὄνομα θεῶν ὅτ' ᾖξεν ἐς δόρυ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:998.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:998.1.text#τί δῆτα, θύγατερ, τοῦτο σοῖς ἐχθροῖς βλάβος;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:999.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:999.1.text#Ἐριχθόνιον οἶσθ', ἢ — ; τί δ' οὐ μέλλεις, γέρον;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1000.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1000.1.text#ὃν πρῶτον ὑμῶν πρόγονον ἐξανῆκε γῆ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1001.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1001.1.text#τούτῳ δίδωσι Παλλὰς ὄντι νεογόνῳ [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1002.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1002.1.text#τί χρῆμα; μέλλον γάρ τι προσφέρεις ἔπος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1003.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1003.1.text#δισσοὺς σταλαγμοὺς αἵματος Γοργοῦς ἄπο.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1004.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1004.1.text#ἰσχὺν ἔχοντας τίνα πρὸς ἀνθρώπου φύσιν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1005.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1005.1.text#τὸν μὲν θανάσιμον, τὸν δ' ἀκεσφόρον νόσων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1006.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1006.1.text#ἐν τῷ καθάψασ' ἀμφὶ παιδὶ σώματος;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1007.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1007.1.text#χρυσοῖσι δεσμοῖς· ὁ δὲ δίδωσ' ἐμῷ πατρί.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1008.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1008.1.text#κείνου δὲ κατθανόντος ἐς σὲ ἀφίκετο;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1009.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1009.1.text#ναί· κἀπὶ καρπῷ γ' αὔτ' ἐγὼ χερὸς φέρω.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1010.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1010.1.text#πῶς οὖν κέκρανται δίπτυχον δῶρον θεᾶς;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1011.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1011.1.text#κοίλης μὲν ὅστις φλεβὸς ἀπέσταξεν φόνῳ [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1012.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1012.1.text#τί τῷδε χρῆσθαι; δύνασιν ἐκφέρει τίνα;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1013.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1013.1.text#νόσους ἀπείργει καὶ τροφὰς ἔχει βίου.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1014.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1014.1.text#ὁ δεύτερος δ' ἀριθμὸς ὧν λέγεις τί δρᾷ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1015.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1015.1.text#κτείνει, δρακόντων ἰὸς ὢν τῶν Γοργόνος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1016.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1016.1.text#ἐς ἓν δὲ κραθέντ' αὐτὸν ἢ χωρὶς φορεῖς;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1017.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1017.1.text#χωρίς· κακῷ γὰρ ἐσθλὸν οὐ συμμείγνυται.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1018.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1018.1.text#ὦ φιλτάτη παῖ, πάντ' ἔχεις ὅσων σε δεῖ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1019.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1019.1.text#τούτῳ θανεῖται παῖς· σὺ δ' ὁ κτείνων ἔσῃ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1020.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1020.1.text#ποῦ καὶ τί δράσας; σὸν λέγειν, τολμᾶν δ' ἐμόν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1021.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1021.1.text#ἐν ταῖς Ἀθήναις, δῶμ' ὅταν τοὐμὸν μόλῃ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1022.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1022.1.text#οὐκ εὖ τόδ' εἶπας· καὶ σὺ γὰρ τοὐμὸν ψέγεις.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1023.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1023.1.text#πῶς; ἆρ' ὑπείδου τοῦθ' ὃ κἄμ' ἐσέρχεται;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1024.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1024.1.text#σὺ παῖδα δόξεις διολέσαι, κεἰ μὴ κτενεῖς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1025.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1025.1.text#ὀρθῶς· φθονεῖν γάρ φασι μητρυιὰς τέκνοις.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1026.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1026.1.text#αὐτοῦ νυν αὐτὸν κτεῖν', ἵν' ἀρνήσῃ φόνους.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1027.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1027.1.text#προλάζυμαι γοῦν τῷ χρόνῳ τῆς ἡδονῆς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1028.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1028.1.text#καὶ σόν γε λήσεις πόσιν ἅ σε σπεύδει λαθεῖν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1029.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1029.1.text#οἶσθ' οὖν ὃ δρᾶσον; χειρὸς ἐξ ἐμῆς λαβὼν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1030.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1030.1.text#χρύσωμ' Ἀθάνας τόδε, παλαιὸν ὄργανον,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1031.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1031.1.text#ἐλθὼν ἵν' ἡμῖν βουθυτεῖ λάθρα πόσις,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1032.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1032.1.text#δείπνων ὅταν λήγωσι καὶ σπονδὰς θεοῖς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1033.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1033.1.text#μέλλωσι λείβειν, ἐν πέπλοις ἔχων τόδε
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1034.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1034.1.text#κάθες βαλὼν ἐς πῶμα τῷ νεανίᾳ [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1035.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1035.1.text#ἰδίᾳ δέ, μή τι πᾶσι, χωρίσας ποτὸν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1036.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1036.1.text#τῷ τῶν ἐμῶν μέλλοντι δεσπόζειν δόμων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1037.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1037.1.text#κἄνπερ διέλθῃ λαιμόν, οὔποθ' ἵξεται
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1038.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1038.1.text#κλεινὰς Ἀθήνας, κατθανὼν δ' αὐτοῦ μενεῖ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1039.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1039.1.text#σὺ μέν νυν εἴσω προξένων μέθες πόδα·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1040.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1040.1.text#ἡμεῖς δ' ἐφ' ᾧ τετάγμεθ' ἐκπονήσομεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1041.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1041.1.text#ἄγ', ὦ γεραιὲ πούς, νεανίας γενοῦ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1042.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1042.1.text#ἔργοισι, κεἰ μὴ τῷ χρόνῳ πάρεστί σοι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1043.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1043.1.text#ἐχθρὸν δ' ἐπ' ἄνδρα στεῖχε δεσποτῶν μέτα,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1044.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1044.1.text#καὶ συμφόνευε καὶ συνεξαίρει δόμων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1045.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1045.1.text#τὴν δ' εὐσέβειαν εὐτυχοῦσι μὲν καλὸν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1046.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1046.1.text#τιμᾶν· ὅταν δὲ πολεμίους δρᾶσαι κακῶς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1047.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1047.1.text#θέλῃ τις, οὐδεὶς ἐμποδὼν κεῖται νόμος.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1048.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1048.1.text#Εἰνοδία θύγατερ Δάματρος, ἃ τῶν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1049.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1049.1.text#νυκτιπόλων ἐφόδων ἀνάσσεις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1050.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1050.1.text#καὶ μεθαμερίων, ὅδωσον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1051.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1051.1.text#δυσθανάτων κρατήρων πληρώματ'
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1052.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1052.1.text#ἐφ' οἷσι πέμπει
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1053.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1053.1.text#πότνια πότνι' ἐμὰ χθονίας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1054.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1054.1.text#Γοργοῦς λαιμοτόμων ἀπὸ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1055.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1055.1.text#σταλαγμῶν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1056.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1056.1.text#τῷ τῶν Ἐρεχθεϊδᾶν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1057.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1057.1.text#δόμων ἐφαπτομένῳ·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1058.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1058.1.text#μηδέ ποτ' ἄλλος [ ἄλλων ἀπ' ] οἴκων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1059.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1059.1.text#πόλεως ἀνάσσοι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1060.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1060.1.text#πλὴν τῶν εὐγενετᾶν Ἐρεχθειδᾶν.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1061.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1061.1.text#εἰ δ' ἀτελὴς θάνατος σπουδαί τε δεσποίνας,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1062.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1062.1.text#ὅ τε καιρὸς ἄπεισι τόλμας,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1063.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1063.1.text#ᾇ νῦν ἐλπὶς ἐφαίνετ', ἢ θηκτὸν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1064.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1064.1.text#ξίφος ἢ δαίμων ἐξάψει
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1065.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1065.1.text#βρόχον ἀμφὶ δειρήν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1066.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1066.1.text#πάθεσι πάθεα δ' ἐξανύτουσ'
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1067.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1067.1.text#εἰς ἄλλας βιότου κάτεισι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1068.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1068.1.text#μορφάς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1069.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1069.1.text#οὐ γὰρ δόμων γ' ἑτέρους
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1070.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1070.1.text#ἄρχοντας ἀλλοδαποὺς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1071.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1071.1.text#ζῶσά ποτ' [ ὄμμασι ] ἐν φαενναῖς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1072.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1072.1.text#ἀνέχοιτ' ἂν αὐγαῖς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1073.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1073.1.text#ἁ τῶν εὐπατριδᾶν γεγῶσ' οἴκων.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1074.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1074.1.text#αἰσχύνομαι τὸν πολύυμνον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1075.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1075.1.text#θεόν, εἰ παρὰ καλλιχόροισι παγαῖς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1076.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1076.1.text#λαμπάδα θεωρὸν εἰκάδων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1077.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1077.1.text#ὄψεται ἐννύχιος ἄυπνος ὤν, ὅτε
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1078.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1078.1.text#καὶ Διὸς ἀστερωπὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1079.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1079.1.text#ἀνεχόρευσεν αἰθήρ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1080.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1080.1.text#χορεύει δὲ σελάνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1081.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1081.1.text#καὶ πεντήκοντα κόραι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1082.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1082.1.text#Νηρέος, αἱ κατὰ πόντον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1083.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1083.1.text#ἀενάων τε ποταμῶν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1084.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1084.1.text#δίνας, χορευόμεναι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1085.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1085.1.text#τὰν χρυσοστέφανον κόραν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1086.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1086.1.text#καὶ ματέρα σεμνάν·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1087.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1087.1.text#ἵν' ἐλπίζει βασιλεύσειν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1088.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1088.1.text#ἄλλων πόνον ἐσπεσὼν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1089.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1089.1.text#ὁ Φοίβειος ἀλάτας.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1090.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1090.1.text#ὁρᾶθ' ὅσοι δυσκελάδοισιν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1091.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1091.1.text#κατὰ μοῦσαν ἰόντες ἀείδεθ' ὕμνοις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1092.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1092.1.text#ἁμέτερα λέχεα καὶ γάμους
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1093.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1093.1.text#Κύπριδος ἀθέμιτας ἀνοσίους, ὅσον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1094.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1094.1.text#εὐσεβίᾳ κρατοῦμεν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1095.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1095.1.text#ἄδικον ἄροτον ἀνδρῶν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1096.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1096.1.text#παλίμφαμος ἀοιδὰ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1097.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1097.1.text#καὶ μοῦσ' εἰς ἄνδρας ἴτω
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1098.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1098.1.text#δυσκέλαδος ἀμφὶ λέκτρων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1099.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1099.1.text#δείκνυσι γὰρ ὁ Διὸς ἐκ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1100.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1100.1.text#παίδων ἀμνημοσύναν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1101.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1101.1.text#οὐ κοινὰν τεκέων τύχαν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1102.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1102.1.text#οἴκοισι φυτεύσας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1103.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1103.1.text#δεσποίνᾳ· πρὸς δ' Ἀφροδίταν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1104.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1104.1.text#ἄλλαν θέμενος χάριν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1105.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1105.1.text#νόθου παιδὸς ἔκυρσεν.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1106.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1106.1.text#κλειναὶ γυναῖκες, ποῦ κόρην Ἐρεχθέως,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1107.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1107.1.text#δέσποιναν εὕρω; πανταχῇ γὰρ ἄστεως
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1108.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1108.1.text#ζητῶν νιν ἐξέπλησα κοὐκ ἔχω λαβεῖν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1109.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1109.1.text#τί δ' ἔστιν, ὦ ξύνδουλε; τίς προθυμία
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1110.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1110.1.text#ποδῶν ἔχει σε, καὶ λόγους τίνας φέρεις;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1111.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1111.1.text#θηρώμεθ'· ἀρχαὶ δ' ἁπιχώριοι χθονὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1112.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1112.1.text#ζητοῦσιν αὐτήν, ὡς θάνῃ πετρουμένη.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1113.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1113.1.text#οἴμοι, τί λέξεις; οὔτι που λελήμμεθα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1114.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1114.1.text#κρυφαῖον ἐς παῖδ' ἐκπορίζουσαι φόνον;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1115.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1115.1.text#ἔγνως;  — μεθέξεις οὐκ ἐν ὑστάτοις κακοῦ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1116.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1116.1.text#ὤφθη δὲ πῶς τὰ κρυπτὰ μηχανήματα;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1117.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1117.1.text#τὸ μὴ δίκαιον τῆς δίκης ἡσσώμενον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1118.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1118.1.text#ἐξηῦρεν ὁ θεός, οὐ μιανθῆναι θέλων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1119.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1119.1.text#πῶς; ἀντιάζω σ' ἱκέτις ἐξειπεῖν τάδε.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1120.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1120.1.text#πεπυσμέναι γάρ, εἰ θανεῖν ὅμως χρεών,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1121.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1121.1.text#ἥδιον ἂν θάνοιμεν, εἴθ' ὁρᾶν φάος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1122.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1122.1.text#ἐπεὶ θεοῦ μαντεῖον ᾤχετ' ἐκλιπὼν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1123.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1123.1.text#πόσις Κρεούσης, παῖδα τὸν καινὸν λαβὼν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1124.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1124.1.text#πρὸς δεῖπνα θυσίας θ' ἃς θεοῖς ὡπλίζετο,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1125.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1125.1.text#Ξοῦθος μὲν ᾤχετ' ἔνθα πῦρ πηδᾷ θεοῦ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1126.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1126.1.text#βακχεῖον, ὡς σφαγαῖσι Διονύσου πέτρας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1127.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1127.1.text#δεύσειε δισσὰς παιδὸς ἀντ' ὀπτηρίων,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1128.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1128.1.text#λέξας· Σὺ μὲν νῦν, τέκνον, ἀμφήρεις μένων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1129.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1129.1.text#σκηνὰς ἀνίστη τεκτόνων μοχθήμασι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1130.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1130.1.text#θύσας δὲ Γενέταις Θεοῖσιν ἢν μακρὸν χρόνον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1131.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1131.1.text#μένω, παροῦσι δαῖτες ἔστωσαν φίλοις.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1132.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1132.1.text#λαβὼν δὲ μόσχους ᾤχεθ'· ὁ δὲ νεανίας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1133.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1133.1.text#σεμνῶς ἀτοίχους περιβολὰς σκηνωμάτων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1134.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1134.1.text#ὀρθοστάταις ἱδρύεθ', ἡλίου βολὰς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1135.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1135.1.text#καλῶς φυλάξας, οὔτε πρὸς μέσας φλογὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1136.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1136.1.text#ἀκτῖνας, οὔτ' αὖ πρὸς τελευτώσας βίον,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1137.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1137.1.text#πλέθρου σταθμήσας μῆκος εἰς εὐγωνίαν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1138.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1138.1.text#μέτρημ' ἔχουσαν τοὐν μέσῳ γε μυρίων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1139.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1139.1.text#ποδῶν ἀριθμόν, ὡς λέγουσιν οἱ σοφοί,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1140.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1140.1.text#ὡς πάντα Δελφῶν λαὸν ἐς θοίνην καλῶν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1141.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1141.1.text#λαβὼν δ' ὑφάσμαθ' ἱερὰ θησαυρῶν πάρα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1142.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1142.1.text#κατεσκίαζε, θαύματ' ἀνθρώποις ὁρᾶν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1143.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1143.1.text#πρῶτον μὲν ὀρόφῳ πτέρυγα περιβάλλει πέπλων,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1144.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1144.1.text#ἀνάθημα Δίου παιδός, οὓς Ἡρακλέης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1145.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1145.1.text#Ἀμαζόνων σκυλεύματ' ἤνεγκεν θεῷ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1146.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1146.1.text#ἐνῆν δ' ὑφανταὶ γράμμασιν τοιαίδ' ὑφαί,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1147.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1147.1.text#Οὐρανὸς ἀθροίζων ἄστρ' ἐν αἰθέρος κύκλῳ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1148.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1148.1.text#ἵππους μὲν ἤλαυν' ἐς τελευταίαν φλόγα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1149.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1149.1.text#Ἥλιος, ἐφέλκων λαμπρὸν Ἑσπέρου φάος·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1150.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1150.1.text#μελάμπεπλος δὲ Νὺξ ἀσείρωτον ζυγοῖς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1151.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1151.1.text#ὄχημ' ἔπαλλεν, ἄστρα δ' ὡμάρτει θεᾷ·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1152.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1152.1.text#Πλειὰς μὲν ᾔει μεσοπόρου δι' αἰθέρος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1153.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1153.1.text#ὅ τε ξιφήρης Ὠρίων, ὕπερθε δὲ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1154.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1154.1.text#Ἄρκτος στρέφουσ' οὐραῖα χρυσήρη πόλῳ·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1155.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1155.1.text#κύκλος δὲ πανσέληνος ἠκόντιζ' ἄνω
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1156.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1156.1.text#μηνὸς διχήρης, Ὑάδες τε, ναυτίλοις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1157.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1157.1.text#σαφέστατον σημεῖον, ἥ τε φωσφόρος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1158.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1158.1.text#Ἕως διώκουσ' ἄστρα. τοίχοισιν δ' ἔπι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1159.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1159.1.text#ἤμπισχεν ἄλλα βαρβάρων ὑφάσματα·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1160.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1160.1.text#εὐηρέτμους ναῦς ἀντίας Ἑλληνίσιν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1161.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1161.1.text#καὶ μιξόθηρας φῶτας, ἱππείας τ' ἄγρας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1162.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1162.1.text#ἐλάφων, λεόντων τ' ἀγρίων θηράματα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1163.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1163.1.text#κατ' εἰσόδους δὲ Κέκροπα θυγατέρων πέλας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1164.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1164.1.text#σπείραισιν εἱλίσσοντ', Ἀθηναίων τινὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1165.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1165.1.text#ἀνάθημα· χρυσέους τ' ἐν μέσῳ συσσιτίῳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1166.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1166.1.text#κρατῆρας ἔστησ'. ἐν δ' ἄκροισι βὰς ποσὶ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1167.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1167.1.text#κῆρυξ ἀνεῖπε τὸν θέλοντ' ἐγχωρίων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1168.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1168.1.text#ἐς δαῖτα χωρεῖν. ὡς δ' ἐπληρώθη στέγη,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1169.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1169.1.text#στεφάνοισι κοσμηθέντες εὐόχθου βορᾶς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1170.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1170.1.text#ψυχὴν ἐπλήρουν. ὡς δ' ἀνεῖσαν ἡδονήν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1171.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1171.1.text#[ … ] παρελθὼν πρέσβυς ἐς μέσον πέδον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1172.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1172.1.text#ἔστη, γέλων δ' ἔθηκε συνδείπνοις πολύν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1173.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1173.1.text#πρόθυμα πράσσων· ἔκ τε γὰρ κρωσσῶν ὕδωρ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1174.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1174.1.text#χεροῖν ἔπεμπε νίπτρα, κἀξεθυμία
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1175.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1175.1.text#σμύρνης ἱδρῶτα, χρυσέων τ' ἐκπωμάτων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1176.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1176.1.text#ἦρχ', αὐτὸς αὑτῷ τόνδε προστάξας πόνον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1177.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1177.1.text#ἐπεὶ δ' ἐς αὐλοὺς ἧκον ἐς κρατῆρά τε
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1178.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1178.1.text#κοινόν, γέρων ἔλεξ'· Ἀφαρπάζειν χρεὼν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1179.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1179.1.text#οἰνηρὰ τεύχη σμικρά, μεγάλα δ' ἐσφέρειν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1180.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1180.1.text#ὡς θᾶσσον ἔλθωσ' οἵδ' ἐς ἡδονὰς φρενῶν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1181.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1181.1.text#ἦν δὴ φερόντων μόχθος ἀργυρηλάτους
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1182.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1182.1.text#χρυσέας τε φιάλας· ὃ δὲ λαβὼν ἐξαίρετον,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1183.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1183.1.text#ὡς τῷ νέῳ δὴ δεσπότῃ χάριν φέρων,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1184.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1184.1.text#ἔδωκε πλῆρες τεῦχος, εἰς οἶνον βαλὼν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1185.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1185.1.text#ὅ φασι δοῦναι φάρμακον δραστήριον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1186.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1186.1.text#δέσποιναν, ὡς παῖς ὁ νέος ἐκλίποι φάος·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1187.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1187.1.text#κοὐδεὶς τάδ' ᾔδειν. ἐν χεροῖν ἔχοντι δὲ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1188.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1188.1.text#σπονδὰς μετ' ἄλλων παιδὶ τῷ πεφηνότι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1189.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1189.1.text#βλασφημίαν τις οἰκετῶν ἐφθέγξατο·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1190.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1190.1.text#ὁ δ', ὡς ἐν ἱερῷ μάντεσίν τ' ἐσθλοῖς τραφείς,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1191.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1191.1.text#οἰωνὸν ἔθετο, κἀκέλευσ' ἄλλον νέον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1192.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1192.1.text#κρατῆρα πληροῦν· τὰς δὲ πρὶν σπονδὰς θεοῦ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1193.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1193.1.text#δίδωσι γαίᾳ, πᾶσί τ' ἐκσπένδειν λέγει.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1194.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1194.1.text#σιγὴ δ' ὑπῆλθεν. ἐκ δ' ἐπίμπλαμεν δρόσου
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1195.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1195.1.text#κρατῆρας ἱεροὺς Βυβλίνου τε πώματος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1196.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1196.1.text#κἀν τῷδε μόχθῳ πτηνὸς ἐσπίπτει δόμοις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1197.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1197.1.text#κῶμος πελειῶν — Λοξίου γὰρ ἐν δόμοις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1198.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1198.1.text#ἄτρεστα ναίουσ' — ὡς δ' ἀπέσπεισαν μέθυ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1199.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1199.1.text#ἐς αὐτὸ χείλη πώματος κεχρημέναι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1200.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1200.1.text#καθῆκαν, εἷλκον δ' εὐπτέρους ἐς αὐχένας.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1201.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1201.1.text#καὶ ταῖς μὲν ἄλλαις ἄνοσος ἦν λοιβὴ θεοῦ·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1202.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1202.1.text#ἣ δ' ἕζετ' ἔνθ' ὁ καινὸς ἔσπεισεν γόνος,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1203.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1203.1.text#ποτοῦ τ' ἐγεύσατ', εὐθὺς εὔπτερον δέμας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1204.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1204.1.text#ἔσεισε κἀβάκχευσεν, ἐκ δ' ἔκλαγξ' ὄπα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1205.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1205.1.text#ἀξύνετον αἰάζουσ'· ἐθάμβησεν δὲ πᾶς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1206.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1206.1.text#θοινατόρων ὅμιλος ὄρνιθος πόνους.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1207.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1207.1.text#θνῄσκει δ' ἀπασπαίρουσα, φοινικοσκελεῖς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1208.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1208.1.text#χηλὰς παρεῖσα. γυμνὰ δ' ἐκ πέπλων μέλη
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1209.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1209.1.text#ὑπὲρ τραπέζης ἧχ' ὁ μαντευτὸς γόνος,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1210.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1210.1.text#βοᾷ δέ· Τίς μ' ἔμελλεν ἀνθρώπων κτενεῖν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1211.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1211.1.text#σήμαινε, πρέσβυ· σὴ γὰρ ἡ προθυμία,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1212.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1212.1.text#καὶ πῶμα χειρὸς σῆς ἐδεξάμην πάρα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1213.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1213.1.text#εὐθὺς δ' ἐρευνᾷ γραῖαν ὠλένην λαβών,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1214.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1214.1.text#ἐπ' αὐτοφώρῳ πρέσβυν ὡς ἔχονθ' ἕλοι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1215.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1215.1.text#ὤφθη δὲ καὶ κατεῖπ' ἀναγκασθεὶς μόγις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1216.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1216.1.text#τόλμας Κρεούσης πώματός τε μηχανάς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1217.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1217.1.text#θεῖ δ' εὐθὺς ἔξω συλλαβὼν θοινάτορας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1218.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1218.1.text#ὁ πυθόχρηστος Λοξίου νεανίας,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1219.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1219.1.text#κἀν κοιράνοισι Πυθικοῖς σταθεὶς λέγει·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1220.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1220.1.text#Ὦ Γαῖα σεμνή, τῆς Ἐρεχθέως ὕπο,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1221.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1221.1.text#ξένης γυναικός, φαρμάκοισι θνῄσκομεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1222.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1222.1.text#Δελφῶν δ' ἄνακτες ὥρισαν πετρορριφῆ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1223.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1223.1.text#θανεῖν ἐμὴν δέσποιναν οὐ ψήφῳ μιᾷ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1224.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1224.1.text#τὸν ἱερὸν ὡς κτείνουσαν ἔν τ' ἀνακτόροις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1225.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1225.1.text#φόνον τιθεῖσαν. πᾶσα δὲ ζητεῖ πόλις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1226.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1226.1.text#τὴν ἀθλίως σπεύσασαν ἀθλίαν ὁδόν·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1227.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1227.1.text#παίδων γὰρ ἐλθοῦσ' εἰς ἔρον Φοίβου πάρα,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1228.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1228.1.text#τὸ σῶμα κοινῇ τοῖς τέκνοις ἀπώλεσεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1229.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1229.1.text#οὐκ ἔστ' οὐκ ἔστιν θανάτου
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1230.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1230.1.text#παρατροπὰ μελέᾳ μοι·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1231.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1231.1.text#φανερὰ [ γὰρ ] φανερὰ τάδ' ἤδη,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1232.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1232.1.text#σπονδᾶς ἐκ Διονύσου,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1233.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1233.1.text#βοτρύων θοᾶς ἐχίδνας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1234.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1234.1.text#σταγόσι μειγνυμένας φόνῳ [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1235.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1235.1.text#φανερὰ θύματα νερτέρων,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1236.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1236.1.text#συμφοραὶ μὲν ἐμῷ βίῳ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1237.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1237.1.text#λεύσιμοι δὲ καταφθοραὶ δεσποίνᾳ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1238.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1238.1.text#τίνα φυγὰν πτερόεσσαν ἢ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1239.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1239.1.text#χθονὸς ὑπὸ σκοτίων μυχῶν πορευθῶ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1240.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1240.1.text#θανάτου λεύσιμον ἄταν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1241.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1241.1.text#ἀποφεύγουσα, τεθρίππων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1242.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1242.1.text#ὠκιστᾶν χαλᾶν ἐπιβᾶσ',
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1243.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1243.1.text#ἢ πρύμνας ἐπὶ ναῶν;[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1244.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1244.1.text#οὐκ ἔστι λαθεῖν, ὅτε μὴ χρῄζων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1245.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1245.1.text#θεὸς ἐκκλέπτει.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1246.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1246.1.text#τί ποτ', ὦ μελέα δέσποινα, μένει
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1247.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1247.1.text#ψυχῇ σε παθεῖν; ἆρα θέλουσαι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1248.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1248.1.text#δρᾶσαί τι κακὸν τοὺς πέλας αὐταὶ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1249.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1249.1.text#πεισόμεθ', ὥσπερ τὸ δίκαιον;[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1250.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1250.1.text#πρόσπολοι, διωκόμεσθα θανασίμους ἐπὶ σφαγάς,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1251.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1251.1.text#Πυθίᾳ ψήφῳ κρατηθεῖσ', ἔκδοτος δὲ γίγνομαι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1252.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1252.1.text#ἴσμεν, ὦ τάλαινα, τὰς σὰς συμφοράς, ἵν' εἶ τύχης.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1253.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1253.1.text#ποῖ φύγω δῆτ'; ἐκ γὰρ οἴκων προύλαβον μόγις πόδα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1254.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1254.1.text#μὴ θανεῖν, κλοπῇ δ' ἀφῖγμαι διαφυγοῦσα πολεμίους.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1255.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1255.1.text#ποῖ δ' ἂν ἄλλοσ' ἢ 'πὶ βωμόν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1255.2.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1255.2.text#καὶ τί μοι πλέον τόδε;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1256.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1256.1.text#ἱκέτιν οὐ θέμις φονεύειν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1256.2.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1256.2.text#τῷ νόμῳ δέ γ' ὄλλυμαι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1257.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1257.1.text#χειρία γ' ἁλοῦσα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1257.2.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1257.2.text#καὶ μὴν οἵδ' ἀγωνισταὶ πικροὶ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1258.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1258.1.text#δεῦρ' ἐπείγονται ξιφήρεις.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1258.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1258.2.text#ἵζε νυν πυρᾶς ἔπι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1259.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1259.1.text#κἂν θάνῃς γὰρ ἐνθάδ' οὖσα, τοῖς ἀποκτείνασί σε
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1260.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1260.1.text#προστρόπαιον αἷμα θήσεις· οἰστέον δὲ τὴν τύχην.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1261.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1261.1.text#ὦ ταυρόμορφον ὄμμα Κηφισοῦ πατρός,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1262.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1262.1.text#οἵαν ἔχιδναν τήνδ' ἔφυσας ἢ πυρὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1263.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1263.1.text#δράκοντ' ἀναβλέποντα φοινίαν φλόγα,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1264.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1264.1.text#ᾗ τόλμα πᾶσ' ἔνεστιν, οὐδ' ἥσσων ἔφυ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1265.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1265.1.text#Γοργοῦς σταλαγμῶν, οἷς ἔμελλέ με κτενεῖν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1266.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1266.1.text#λάζυσθ', ἵν' αὐτῆς τοὺς ἀκηράτους πλόκους
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1267.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1267.1.text#κόμης καταξήνωσι Παρνασοῦ πλάκες,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1268.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1268.1.text#ὅθεν πετραῖον ἅλμα δισκηθήσεται.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1269.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1269.1.text#ἐσθλοῦ δ' ἔκυρσα δαίμονος, πρὶν ἐς πόλιν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1270.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1270.1.text#μολεῖν Ἀθηνῶν χὑπὸ μητρυιὰν πεσεῖν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1271.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1271.1.text#ἐν συμμάχοις γὰρ ἀνεμετρησάμην φρένας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1272.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1272.1.text#τὰς σάς, ὅσον μοι πῆμα δυσμενής τ' ἔφυς·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1273.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1273.1.text#ἔσω γὰρ ἄν με περιβαλοῦσα δωμάτων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1274.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1274.1.text#ἄρδην ἂν ἐξέπεμψας εἰς Ἅιδου δόμους.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1275.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1275.1.text#ἀλλ' οὔτε βωμὸς οὔτ' Ἀπόλλωνος δόμος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1276.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1276.1.text#σώσει σ'· ὁ δ' οἶκτος ὁ σὸς ἐμοὶ κρείσσων πάρα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1277.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1277.1.text#καὶ μητρὶ τἠμῇ· καὶ γὰρ εἰ τὸ σῶμά μοι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1278.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1278.1.text#ἄπεστιν αὐτῆς, τοὔνομ' οὐκ ἄπεστί πω.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1279.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1279.1.text#ἴδεσθε τὴν πανοῦργον, ἐκ τέχνης τέχνην
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1280.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1280.1.text#οἵαν ἔπλεξε· βωμὸν ἔπτηξεν θεοῦ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1281.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1281.1.text#ὡς οὐ δίκην δώσουσα τῶν εἰργασμένων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1282.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1282.1.text#ἀπεννέπω σε μὴ κατακτείνειν ἐμὲ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1283.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1283.1.text#ὑπέρ τ' ἐμαυτῆς τοῦ θεοῦ θ' ἵν' ἕσταμεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1284.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1284.1.text#τί δ' ἐστὶ Φοίβῳ σοί τε κοινὸν ἐν μέσῳ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1285.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1285.1.text#ἱερὸν τὸ σῶμα τῷ θεῷ δίδωμ' ἔχειν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1286.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1286.1.text#κἄπειτ' ἔκαινες φαρμάκοις τὸν τοῦ θεοῦ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1287.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1287.1.text#ἀλλ' οὐκέτ' ἦσθα Λοξίου, πατρὸς δὲ σοῦ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1288.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1288.1.text#ἀλλ' ἐγενόμεσθα πατρός· οὐσίαν λέγω.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1289.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1289.1.text#οὐκοῦν τότ' ἦσθα· νῦν δ' ἐγώ, σὺ δ' οὐκέτι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1290.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1290.1.text#οὐκ εὐσεβεῖς γε· τἀμὰ δ' εὐσεβῆ τότ' ἦν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1291.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1291.1.text#ἔκτεινά σ' ὄντα πολέμιον δόμοις ἐμοῖς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1292.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1292.1.text#οὔτοι σὺν ὅπλοις ἦλθον ἐς τὴν σὴν χθόνα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1293.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1293.1.text#μάλιστα· κἀπίμπρης γ' Ἐρεχθέως δόμους.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1294.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1294.1.text#ποίοισι πανοῖς ἢ πυρὸς ποίᾳ φλογί;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1295.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1295.1.text#ἔμελλες οἰκεῖν τἄμ', ἐμοῦ βίᾳ λαβών.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1296.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1296.1.text#πατρός γε γῆν διδόντος ἣν ἐκτήσατο.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1297.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1297.1.text#τοῖς Αἰόλου δὲ πῶς μετῆν τῶν Παλλάδος;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1298.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1298.1.text#ὅπλοισιν αὐτήν, οὐ λόγοις ἐρρύσατο.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1299.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1299.1.text#ἐπίκουρος οἰκήτωρ γ' ἂν οὐκ εἴη χθονός.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1300.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1300.1.text#κἄπειτα τοῦ μέλλειν μ' ἀπέκτεινες φόβῳ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1301.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1301.1.text#ὡς μὴ θάνοιμί γ', εἰ σὺ μὴ μέλλων τύχοις.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1302.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1302.1.text#φθονεῖς ἄπαις οὖσ', εἰ πατὴρ ἐξηῦρέ με.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1303.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1303.1.text#σὺ τῶν ἀτέκνων δῆτ' ἀναρπάσεις δόμους;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1304.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1304.1.text#ἡμῖν δέ γ' ἀλλὰ πατρικῆς οὐκ ἦν μέρος;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1305.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1305.1.text#ὅσ' ἀσπὶς ἔγχος θ'· ἥδε σοι παμπησία.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1306.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1306.1.text#ἔκλειπε βωμὸν καὶ θεηλάτους ἕδρας.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1307.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1307.1.text#τὴν σὴν ὅπου σοι μητέρ' ἐστὶ νουθέτει.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1308.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1308.1.text#σὺ δ' οὐχ ὑφέξεις ζημίαν, κτείνουσ' ἐμέ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1309.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1309.1.text#ἤν γ' ἐντὸς ἀδύτων τῶνδέ με σφάξαι θέλῃς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1310.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1310.1.text#τίς ἡδονή σοι θεοῦ θανεῖν ἐν στέμμασι;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1311.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1311.1.text#λυπήσομέν τιν', ὧν λελυπήμεσθ' ὕπο.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1312.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1312.1.text#φεῦ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1312.2.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1312.2.text#δεινόν γε, θνητοῖς τοὺς νόμους ὡς οὐ καλῶς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1313.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1313.1.text#ἔθηκεν ὁ θεὸς οὐδ' ἀπὸ γνώμης σοφῆς·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1314.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1314.1.text#τοὺς μὲν γὰρ ἀδίκους βωμὸν οὐχ ἵζειν ἐχρῆν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1315.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1315.1.text#ἀλλ' ἐξελαύνειν· οὐδὲ γὰρ ψαύειν καλὸν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1316.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1316.1.text#θεῶν πονηρὰν χεῖρα· τοῖσι δ' ἐνδίκοις —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1317.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1317.1.text#ἱερὰ καθίζειν, ὅστις ἠδικεῖτ', ἐχρῆν·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1318.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1318.1.text#καὶ μὴ 'πὶ ταὐτὸ τοῦτ' ἰόντ' ἔχειν ἴσον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1319.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1319.1.text#τόν τ' ἐσθλὸν ὄντα τόν τε μὴ θεῶν πάρα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1320.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1320.1.text#ἐπίσχες, ὦ παῖ· τρίποδα γὰρ χρηστήριον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1321.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1321.1.text#λιποῦσα θριγκοῦ τοῦδ' ὑπερβάλλω πόδα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1322.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1322.1.text#Φοίβου προφῆτις, τρίποδος ἀρχαῖον νόμον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1323.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1323.1.text#σῴζουσα, πασῶν Δελφίδων ἐξαίρετος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1324.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1324.1.text#χαῖρ', ὦ φίλη μοι μῆτερ, οὐ τεκοῦσά περ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1325.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1325.1.text#ἀλλ' οὖν λεγώμεθ'· ἡ φάτις δ' οὔ μοι πικρά.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1326.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1326.1.text#ἤκουσας ὥς μ' ἔκτεινεν ἥδε μηχαναῖς;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1327.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1327.1.text#ἤκουσα· καὶ σὺ δ' ὠμὸς ὢν ἁμαρτάνεις.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1328.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1328.1.text#οὐ χρή με τοὺς κτείνοντας ἀνταπολλύναι;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1329.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1329.1.text#προγονοῖς δάμαρτες δυσμενεῖς ἀεί ποτε.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1330.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1330.1.text#ἡμεῖς δὲ μητρυιαῖς γε πάσχοντες κακῶς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1331.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1331.1.text#μὴ ταῦτα· λείπων ἱερὰ καὶ στείχων πάτραν [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1332.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1332.1.text#τί δή με δρᾶσαι νουθετούμενον χρεών;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1333.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1333.1.text#καθαρὸς Ἀθήνας ἔλθ' ὑπ' οἰωνῶν καλῶν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1334.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1334.1.text#καθαρὸς ἅπας τοι πολεμίους ὃς ἂν κτάνῃ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1335.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1335.1.text#μὴ σύ γε· παρ' ἡμῶν δ' ἔκλαβ' οὓς ἔχω λόγους.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1336.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1336.1.text#λέγοις ἄν· εὔνους δ' οὖσ' ἐρεῖς ὅσ' ἂν λέγῃς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1337.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1337.1.text#ὁρᾷς τόδ' ἄγγος χερὸς ὑπ' ἀγκάλαις ἐμαῖς;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1338.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1338.1.text#ὁρῶ παλαιὰν ἀντίπηγ' ἐν στέμμασιν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1339.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1339.1.text#ἐν τῇδέ σ' ἔλαβον νεόγονον βρέφος ποτέ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1340.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1340.1.text#τί φῄς; ὁ μῦθος εἰσενήνεκται νέος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1341.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1341.1.text#σιγῇ γὰρ εἶχον αὐτά· νῦν δὲ δείκνυμεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1342.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1342.1.text#πῶς οὖν ἔκρυπτες τόδε λαβοῦσ' ἡμᾶς πάλαι;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1343.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1343.1.text#ὁ θεός σ' ἐβούλετ' ἐν δόμοις ἔχειν λάτριν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1344.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1344.1.text#νῦν δ' οὐχὶ χρῄζει; τῷ τόδε γνῶναί με χρή;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1345.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1345.1.text#πατέρα κατειπὼν τῆσδέ σ' ἐκπέμπει χθονός.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1346.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1346.1.text#σὺ δ' ἐκ κελευσμῶν ἢ πόθεν σῴζεις τάδε;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1347.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1347.1.text#ἐνθύμιόν μοι τότε τίθησι Λοξίας [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1348.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1348.1.text#τί χρῆμα δρᾶσαι; λέγε, πέραινε σοὺς λόγους.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1349.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1349.1.text#σῶσαι τόδ' εὕρημ' ἐς τὸν ὄντα νῦν χρόνον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1350.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1350.1.text#ἔχει δέ μοι τί κέρδος [ … ] ἢ τίνα βλάβην;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1351.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1351.1.text#ἐνθάδε κέκρυπται σπάργαν' οἷς ἐνῆσθα σύ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1352.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1352.1.text#μητρὸς τάδ' ἡμῖν ἐκφέρεις ζητήματα;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1353.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1353.1.text#ἐπεί γ' ὁ δαίμων βούλεται· πάροιθε δ' οὔ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1354.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1354.1.text#ὦ μακαρίων μοι φασμάτων ἥδ' ἡμέρα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1355.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1355.1.text#λαβών νυν αὐτὰ τὴν τεκοῦσαν ἐκπόνει.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1356.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1356.1.text#πᾶσάν γ' ἐπελθὼν Ἀσιάδ' Εὐρώπης θ' ὅρους.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1357.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1357.1.text#γνώσῃ τάδ' αὐτός. τοῦ θεοῦ δ' ἕκατί σε
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1358.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1358.1.text#ἔθρεψά τ', ὦ παῖ, καὶ τάδ' ἀποδίδωμί σοι,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1359.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1359.1.text#ἃ κεῖνος ἀκέλευστόν μ' ἐβουλήθη λαβεῖν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1360.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1360.1.text#σῶσαί θ'· ὅτου δ' ἐβούλεθ' οὕνεκ', οὐκ ἔχω [ λέγειν ].
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1361.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1361.1.text#ᾔδει δὲ θνητῶν οὔτις ἀνθρώπων τάδε
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1362.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1362.1.text#ἔχοντας ἡμᾶς, οὐδ' ἵν' ἦν κεκρυμμένα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1363.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1363.1.text#καὶ χαῖρ'· ἴσον γάρ σ' ὡς τεκοῦσ' ἀσπάζομαι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1364.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1364.1.text#ἄρξαι δ' ὅθεν σὴν μητέρα ζητεῖν σε χρή·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1365.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1365.1.text#πρῶτον μὲν εἴ τις Δελφίδων τεκοῦσά σε
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1366.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1366.1.text#ἐς τούσδε ναοὺς ἐξέθηκε παρθένος,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1367.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1367.1.text#ἔπειτα δ' εἴ τις Ἑλλάς.  — ἐξ ἡμῶν δ' ἔχεις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1368.1.speaker#Προφῆτις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1368.1.text#ἅπαντα Φοίβου θ', ὃς μετέσχε τῆς τύχης.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1369.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1369.1.text#φεῦ φεῦ· κατ' ὄσσων ὡς ὑγρὸν βάλλω δάκρυ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1370.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1370.1.text#ἐκεῖσε τὸν νοῦν δούς, ὅθ' ἡ τεκοῦσά με
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1371.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1371.1.text#κρυφαῖα νυμφευθεῖσ' ἀπημπόλα λάθρα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1372.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1372.1.text#καὶ μαστὸν οὐκ ὑπέσχεν· ἀλλ' ἀνώνυμος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1373.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1373.1.text#ἐν θεοῦ μελάθροις εἶχον οἰκέτην βίον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1374.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1374.1.text#τὰ τοῦ θεοῦ μὲν χρηστά, τοῦ δὲ δαίμονος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1375.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1375.1.text#βαρέα· χρόνον γὰρ ὅν με χρῆν ἐν ἀγκάλαις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1376.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1376.1.text#μητρὸς τρυφῆσαι καί τι τερφθῆναι βίου,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1377.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1377.1.text#ἀπεστερήθην φιλτάτης μητρὸς τροφῆς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1378.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1378.1.text#τλήμων δὲ χἡ τεκοῦσά μ'· ὡς ταὐτὸν πάθος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1379.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1379.1.text#πέπονθε, παιδὸς ἀπολέσασα χαρμονάς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1380.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1380.1.text#καὶ νῦν λαβὼν τήνδ' ἀντίπηγ' οἴσω θεῷ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1381.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1381.1.text#ἀνάθημ', ἵν' εὕρω μηδὲν ὧν οὐ βούλομαι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1382.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1382.1.text#εἰ γάρ με δούλη τυγχάνει τεκοῦσά τις,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1383.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1383.1.text#εὑρεῖν κάκιον μητέρ' ἢ σιγῶντ' ἐᾶν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1384.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1384.1.text#ὦ Φοῖβε, ναοῖς ἀνατίθημι τήνδε σοῖς [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1385.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1385.1.text#καίτοι τί πάσχω; τοῦ θεοῦ προθυμίᾳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1386.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1386.1.text#πολεμῶ, τὰ μητρὸς σύμβολ' ὃς σέσωκέ μοι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1387.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1387.1.text#ἀνοικτέον τάδ' ἐστὶ καὶ τολμητέον·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1388.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1388.1.text#τὰ γὰρ πεπρωμέν' οὐχ ὑπερβαίην ποτ' ἄν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1389.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1389.1.text#ὦ στέμμαθ' ἱερά, τί ποτέ μοι κεκεύθατε,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1390.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1390.1.text#καὶ σύνδεθ', οἷσι τἄμ' ἐφρουρήθη φίλα;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1391.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1391.1.text#ἰδοὺ περίπτυγμ' ἀντίπηγος εὐκύκλου
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1392.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1392.1.text#ὡς οὐ γεγήρακ' ἔκ τινος θεηλάτου,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1393.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1393.1.text#εὐρώς τ' ἄπεστι πλεγμάτων· ὁ δ' ἐν μέσῳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1394.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1394.1.text#χρόνος πολὺς δὴ τοῖσδε θησαυρίσμασιν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1395.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1395.1.text#τί δῆτα φάσμα τῶν ἀνελπίστων ὁρῶ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1396.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1396.1.text#σίγα σύ· πολλὰ καὶ πάροιθεν οἶσθά μοι [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1397.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1397.1.text#οὐκ ἐν σιωπῇ τἀμά· μή με νουθέτει.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1398.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1398.1.text#ὁρῶ γὰρ ἄγγος οὗ 'ξέθηκ' ἐγώ ποτε [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1399.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1399.1.text#σέ γ', ὦ τέκνον μοι, βρέφος ἔτ' ὄντα νήπιον,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1400.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1400.1.text#Κέκροπος ἐς ἄντρα καὶ Μακρὰς πετρηρεφεῖς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1401.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1401.1.text#λείψω δὲ βωμὸν τόνδε, κεἰ θανεῖν με χρή.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1402.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1402.1.text#λάζυσθε τήνδε· θεομανὴς γὰρ ἥλατο
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1403.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1403.1.text#βωμοῦ λιποῦσα ξόανα· δεῖτε δ' ὠλένας.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1404.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1404.1.text#σφάζοντες οὐ λήγοιτ' ἄν· ὡς ἀνθέξομαι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1405.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1405.1.text#καὶ τῆσδε καὶ σοῦ τῶν τε σῶν κεκρυμμένων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1406.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1406.1.text#τάδ' οὐχὶ δεινά; ῥυσιάζομαι λόγῳ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1407.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1407.1.text#οὔκ, ἀλλὰ σοῖς φίλοισιν εὑρίσκῃ φίλος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1408.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1408.1.text#ἐγὼ φίλος σός; κᾆτά μ' ἔκτεινες λάθρα;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1409.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1409.1.text#παῖς γ', εἰ τόδ' ἐστὶ τοῖς τεκοῦσι φίλτατον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1410.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1410.1.text#παῦσαι πλέκουσα.  — λήψομαί σ' ἐγὼ καλῶς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1411.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1411.1.text#ἐς τοῦθ' ἱκοίμην, τοῦδε τοξεύω, τέκνον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1412.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1412.1.text#κενὸν τόδ' ἄγγος ἢ στέγει πλήρωμά τι;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1413.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1413.1.text#σά γ' ἔνδυθ', οἷσί σ' ἐξέθηκ' ἐγώ ποτε.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1414.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1414.1.text#καὶ τοὔνομ' αὐτῶν ἐξερεῖς πρὶν εἰσιδεῖν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1415.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1415.1.text#κἂν μὴ φράσω γε, κατθανεῖν ὑφίσταμαι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1416.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1416.1.text#λέγ'· ὡς ἔχει τι δεινὸν ἥ γε τόλμα σου.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1417.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1417.1.text#σκέψασθ'· ὃ παῖς ποτ' οὖσ' ὕφασμ' ὕφην' ἐγὼ [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1418.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1418.1.text#ποῖόν τι; πολλὰ παρθένων ὑφάσματα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1419.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1419.1.text#οὐ τέλεον, οἷον δ' ἐκδίδαγμα κερκίδος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1420.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1420.1.text#μορφὴν ἔχον τίν'; ὥς με μὴ ταύτῃ λάβῃς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1421.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1421.1.text#Γοργὼ μὲν ἐν μέσοισιν ἠτρίοις πέπλων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1422.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1422.1.text#ὦ Ζεῦ, τίς ἡμᾶς ἐκκυνηγετεῖ πότμος;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1423.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1423.1.text#κεκρασπέδωται δ' ὄφεσιν αἰγίδος τρόπον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1424.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1424.1.text#ἰδού·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1424.2.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1424.2.text#τόδ' ἔσθ' ὕφασμα, θέσφαθ' ὡς εὑρίσκομεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1425.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1425.1.text#ὦ χρόνιον ἱστῶν παρθένευμα τῶν ἐμῶν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1426.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1426.1.text#ἔστιν τι πρὸς τῷδ', ἢ μόνῳ τῷδ' εὐτυχεῖς;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1427.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1427.1.text#δράκοντες· ἀρχαῖόν τι παγχρύσῳ γένει
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1428.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1428.1.text#δώρημ' Ἀθάνας, ἣ τέκν' ἐντρέφειν λέγει [ … ]</gap>
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1429.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1429.1.text#Ἐριχθονίου γε τοῦ πάλαι μιμήματα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1430.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1430.1.text#τί δρᾶν, τί χρῆσθαι, φράζε μοι, χρυσώματι;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1431.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1431.1.text#δέραια παιδὶ νεογόνῳ φέρειν, τέκνον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1432.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1432.1.text#ἔνεισιν οἵδε· τὸ δὲ τρίτον ποθῶ μαθεῖν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1433.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1433.1.text#στέφανον ἐλαίας ἀμφέθηκά σοι τότε,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1434.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1434.1.text#ἣν πρῶτ' Ἀθάνα σκόπελον εἰσηνέγκατο,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1435.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1435.1.text#ὅς, εἴπερ ἔστιν, οὔποτ' ἐκλείπει χλόην,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1436.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1436.1.text#θάλλει δ', ἐλαίας ἐξ ἀκηράτου γεγώς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1437.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1437.1.text#ὦ φιλτάτη μοι μῆτερ, ἄσμενός σ' ἰδὼν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1438.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1438.1.text#πρὸς ἀσμένας πέπτωκα σὰς παρηίδας.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1439.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1439.1.text#ὦ τέκνον, ὦ φῶς μητρὶ κρεῖσσον ἡλίου —
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1440.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1440.1.text#συγγνώσεται γὰρ ὁ θεός — ἐν χεροῖν σ' ἔχω,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1441.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1441.1.text#ἄελπτον εὕρημ', ὃν κατὰ γᾶς ἐνέρων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1442.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1442.1.text#χθόνιον μετὰ Περσεφόνας τ' ἐδόκουν ναίειν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1443.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1443.1.text#ἀλλ', ὦ φίλη μοι μῆτερ, ἐν χεροῖν σέθεν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1444.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1444.1.text#ὁ κατθανών τε κοὐ θανὼν φαντάζομαι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1445.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1445.1.text#ἰὼ ἰώ, λαμπρᾶς αἰθέρος ἀμπτυχαί,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1446.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1446.1.text#τίν' αὐδὰν ἀύσω,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1447.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1447.1.text#βοάσω; πόθεν μοι
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1448.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1448.1.text#συνέκυρσ' ἀδόκητος ἡδονά; πόθεν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1449.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1449.1.text#ἐλάβομεν χαράν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1450.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1450.1.text#ἐμοὶ γενέσθαι πάντα μᾶλλον ἄν ποτε,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1451.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1451.1.text#μῆτερ, παρέστη τῶνδ', ὅπως σός εἰμ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1452.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1452.1.text#ἔτι φόβῳ τρέμω.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1453.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1453.1.text#μῶν οὐκ ἔχειν μ' ἔχουσα;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1453.2.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1453.2.text#τὰς γὰρ ἐλπίδας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1453.3.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1453.3.text#ἀπέβαλον πρόσω.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1454.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1454.1.text#ἰὼ γύναι, πόθεν πόθεν ἔλαβες ἐμὸν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1454.2.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1454.2.text#βρέφος ἐς ἀγκάλας;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1455.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1455.1.text#τίν' ἀνὰ χεῖρα δόμον ἔβα Λοξίου;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1456.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1456.1.text#θεῖον τόδ'· ἀλλὰ τἀπίλοιπα τῆς τύχης
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1457.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1457.1.text#εὐδαιμονοῖμεν, ὡς τὰ πρόσθε δυστυχῆ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1458.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1458.1.text#τέκνον, οὐκ ἀδάκρυτος ἐκλοχεύῃ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1459.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1459.1.text#γόοις δὲ ματρὸς ἐκ χερῶν ὁρίζῃ·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1460.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1460.1.text#νῦν δὲ γενειάσιν παρὰ σέθεν πνέω
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1461.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1461.1.text#μακαριωτάτας τυχοῦσ' ἡδονᾶς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1462.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1462.1.text#τοὐμὸν λέγουσα καὶ τὸ σὸν κοινῶς λέγεις.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1463.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1463.1.text#ἄπαιδες οὐκέτ' ἐσμὲν οὐδ' ἄτεκνοι·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1464.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1464.1.text#δῶμ' ἑστιοῦται, γᾶ δ' ἔχει τυράννους·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1465.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1465.1.text#ἀνηβᾷ δ' Ἐρεχθεύς,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1466.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1466.1.text#ὅ τε γηγενέτας δόμος οὐκέτι νύκτα δέρκεται,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1467.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1467.1.text#ἀελίου δ' ἀναβλέπει λαμπάσιν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1468.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1468.1.text#μῆτερ, παρών μοι καὶ πατὴρ μετασχέτω
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1469.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1469.1.text#τῆς ἡδονῆς τῆσδ' ἧς ἔδωχ' ὑμῖν ἐγώ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1470.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1470.1.text#ὦ τέκνον,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1471.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1471.1.text#τί φῄς; οἷον οἷον ἀνελέγχομαι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1472.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1472.1.text#πῶς εἶπας;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1472.2.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1472.2.text#ἄλλοθεν γέγονας, ἄλλοθεν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1473.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1473.1.text#ὤμοι· νόθον με παρθένευμ' ἔτικτε σόν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1474.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1474.1.text#οὐχ ὑπὸ λαμπάδων οὐδὲ χορευμάτων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1475.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1475.1.text#ὑμέναιος ἐμός,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1476.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1476.1.text#τέκνον, ἔτικτε σὸν κάρα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1477.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1477.1.text#αἰαῖ· πέφυκα δυσγενής. μῆτερ, πόθεν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1478.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1478.1.text#ἴστω Γοργοφόνα [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1478.2.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1478.2.text#τί τοῦτ' ἔλεξας;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1479.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1479.1.text#ἃ σκοπέλοις ἐπ' ἐμοῖς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1480.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1480.1.text#τὸν ἐλαιοφυῆ πάγον
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1481.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1481.1.text#θάσσει [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1481.2.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1481.2.text#λέγεις μοι δόλια κοὐ σαφῆ τάδε.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1482.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1482.1.text#παρ' ἀηδόνιον πέτραν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1483.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1483.1.text#Φοίβῳ [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1483.2.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1483.2.text#τί Φοῖβον αὐδᾷς;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1484.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1484.1.text#κρυπτόμενον λέχος ηὐνάσθην  [ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1485.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1485.1.text#λέγ'· ὡς ἐρεῖς τι κεδνὸν εὐτυχές τέ μοι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1486.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1486.1.text#δεκάτῳ δέ σε μηνὸς ἐν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1487.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1487.1.text#κύκλῳ κρύφιον ὠδῖν' ἔτεκον Φοίβῳ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1488.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1488.1.text#ὦ φίλτατ' εἰποῦσ', εἰ λέγεις ἐτήτυμα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1489.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1489.1.text#παρθένια δ' ἐμᾶς { λάθρα } ματέρος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1490.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1490.1.text#σπάργαν' ἀμφίβολά σοι τάδ' ἐνῆψα, κερκίδος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1491.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1491.1.text#ἐμᾶς πλάνους.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1492.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1492.1.text#γάλακτι δ' οὐκ ἐπέσχον, οὐδὲ μαστῷ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1493.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1493.1.text#τροφεῖα ματρὸς οὐδὲ λουτρὰ χειροῖν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1494.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1494.1.text#ἀνὰ δ' ἄντρον ἔρημον οἰωνῶν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1495.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1495.1.text#γαμφηλαῖς φόνευμα θοίναμά τ' εἰς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1496.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1496.1.text#Ἅιδαν ἐκβάλλῃ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1497.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1497.1.text#ὦ δεινὰ τλᾶσα μῆτερ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1497.2.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1497.2.text#ἐν φόβῳ, τέκνον,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1498.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1498.1.text#καταδεθεῖσα σὰν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1499.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1499.1.text#ἀπέβαλον ψυχάν·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1500.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1500.1.text#ἔκτεινά σ' ἄκουσ'.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1500.2.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1500.2.text#ἐξ ἐμοῦ τ' [ οὐχ ὅσι' ] ἔθνῃσκες.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1502.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1502.1.text#ἰώ· δειναὶ μὲν τότε τύχαι,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1503.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1503.1.text#δεινὰ δὲ καὶ τάδ'· ἑλισσόμεσθ' ἐκεῖθεν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1505.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1505.1.text#ἐνθάδε δυστυχίαισιν εὐτυχίαις τε πάλιν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1506.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1506.1.text#μεθίσταται δὲ πνεύματα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1508.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1508.1.text#μενέτω· τὰ πάροιθεν ἅλις κακά· νῦν δὲ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1509.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1509.1.text#γένοιτό τις οὖρος ἐκ κακῶν, ὦ παῖ.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1510.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1510.1.text#μηδεὶς δοκείτω μηδὲν ἀνθρώπων ποτὲ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1511.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1511.1.text#ἄελπτον εἶναι πρὸς τὰ τυγχάνοντα νῦν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1512.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1512.1.text#ὦ μεταβαλοῦσα μυρίους ἤδη βροτῶν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1513.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1513.1.text#καὶ δυστυχῆσαι καὖθις αὖ πρᾶξαι καλῶς,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1514.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1514.1.text#Τύχη, παρ' οἵαν ἤλθομεν στάθμην βίου
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1515.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1515.1.text#μητέρα φονεῦσαι καὶ παθεῖν ἀνάξια.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1516.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1516.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1516.2.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1516.2.text#ἆρ' ἐν φαενναῖς ἡλίου περιπτυχαῖς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1517.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1517.1.text#ἔνεστι πάντα τάδε καθ' ἡμέραν μαθεῖν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1518.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1518.1.text#φίλον μὲν οὖν σ' εὕρημα, μῆτερ, ηὕρομεν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1519.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1519.1.text#καὶ τὸ γένος οὐδὲν μεμπτόν, ὡς ἡμῖν, τόδε·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1520.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1520.1.text#τὰ δ' ἄλλα πρὸς σὲ βούλομαι μόνην φράσαι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1521.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1521.1.text#δεῦρ' ἔλθ'· ἐς οὖς γὰρ τοὺς λόγους εἰπεῖν θέλω
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1522.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1522.1.text#καὶ περικαλύψαι τοῖσι πράγμασι σκότον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1523.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1523.1.text#ὅρα σύ, μῆτερ· μὴ σφαλεῖσ' ἃ παρθένοις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1524.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1524.1.text#ἐγγίγνεται νοσήματ' ἐς κρυπτοὺς γάμους,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1525.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1525.1.text#ἔπειτα τῷ θεῷ προστίθης τὴν αἰτίαν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1526.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1526.1.text#καὶ τοὐμὸν αἰσχρὸν ἀποφυγεῖν πειρωμένη,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1527.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1527.1.text#Φοίβῳ τεκεῖν με φῄς, τεκοῦσ' οὐκ ἐκ θεοῦ;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1528.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1528.1.text#μὰ τὴν παρασπίζουσαν ἅρμασίν ποτε
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1529.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1529.1.text#Νίκην Ἀθηνᾶν Ζηνὶ γηγενεῖς ἔπι,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1530.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1530.1.text#οὐκ ἔστιν ὅστις σοι πατὴρ θνητῶν, τέκνον,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1531.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1531.1.text#ἀλλ' ὅσπερ ἐξέθρεψε, Λοξίας ἄναξ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1532.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1532.1.text#πῶς οὖν τὸν αὑτοῦ παῖδ' ἔδωκ' ἄλλῳ πατρὶ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1533.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1533.1.text#Ξούθου τέ φησι παῖδά μ' ἐκπεφυκέναι;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1534.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1534.1.text#πεφυκέναι μὲν οὐχί, δωρεῖται δέ σε
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1535.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1535.1.text#αὑτοῦ γεγῶτα· καὶ γὰρ ἂν φίλος φίλῳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1536.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1536.1.text#δοίη τὸν αὑτοῦ παῖδα δεσπότην δόμων.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1537.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1537.1.text#ὁ θεὸς ἀληθὴς ἢ μάτην μαντεύεται,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1538.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1538.1.text#ἐμοῦ ταράσσει, μῆτερ, εἰκότως φρένα.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1539.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1539.1.text#ἄκουε δή νυν ἅμ' ἐσῆλθεν, ὦ τέκνον·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1540.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1540.1.text#εὐεργετῶν σε Λοξίας ἐς εὐγενῆ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1541.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1541.1.text#δόμον καθίζει· τοῦ θεοῦ δὲ λεγόμενος,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1542.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1542.1.text#οὐκ ἔσχες ἄν ποτ' οὔτε παγκλήρους δόμους
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1543.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1543.1.text#οὔτ' ὄνομα πατρός. πῶς γάρ, οὗ γ' ἐγὼ γάμους
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1544.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1544.1.text#ἔκρυπτον αὐτὴ καί σ' ἀπέκτεινον λάθρα;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1545.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1545.1.text#ὃ δ' ὠφελῶν σε προστίθησ' ἄλλῳ πατρί.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1546.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1546.1.text#οὐχ ὧδε φαύλως αὔτ' ἐγὼ μετέρχομαι,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1547.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1547.1.text#ἀλλ' ἱστορήσω Φοῖβον εἰσελθὼν δόμους,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1548.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1548.1.text#εἴτ' εἰμὶ θνητοῦ πατρὸς εἴτε Λοξίου.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1549.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1549.1.text#ἔα· τίς οἴκων θυοδόκων ὑπερτελὴς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1550.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1550.1.text#ἀντήλιον πρόσωπον ἐκφαίνει θεῶν;
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1551.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1551.1.text#φεύγωμεν, ὦ τεκοῦσα, μὴ τὰ δαιμόνων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1552.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1552.1.text#ὁρῶμεν — εἰ μὴ καιρός ἐσθ' ἡμᾶς ὁρᾶν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1553.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1553.1.text#μὴ φεύγετ'· οὐ γὰρ πολεμίαν με φεύγετε,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1554.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1554.1.text#ἀλλ' ἔν τ' Ἀθήναις κἀνθάδ' οὖσαν εὐμενῆ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1555.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1555.1.text#ἐπώνυμος δὲ σῆς ἀφικόμην χθονὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1556.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1556.1.text#Παλλάς, δρόμῳ σπεύσασ' Ἀπόλλωνος πάρα,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1557.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1557.1.text#ὃς ἐς μὲν ὄψιν σφῷν μολεῖν οὐκ ἠξίου,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1558.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1558.1.text#μὴ τῶν πάροιθε μέμψις ἐς μέσον μόλῃ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1559.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1559.1.text#ἡμᾶς δὲ πέμπει τοὺς λόγους ὑμῖν φράσαι·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1560.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1560.1.text#ὡς ἥδε τίκτει σ' ἐξ Ἀπόλλωνος πατρός,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1561.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1561.1.text#δίδωσι δ' οἷς ἔδωκεν, οὐ φύσασί σε,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1562.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1562.1.text#ἀλλ' ὡς νομίζῃ 'ς οἶκον εὐγενέστατον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1563.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1563.1.text#ἐπεὶ δ' ἀνεῴχθη πρᾶγμα μηνυθὲν τόδε,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1564.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1564.1.text#θανεῖν σε δείσας μητρὸς ἐκ βουλευμάτων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1565.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1565.1.text#καὶ τήνδε πρὸς σοῦ, μηχαναῖς ἐρρύσατο.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1566.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1566.1.text#ἔμελλε δ' αὐτὰ διασιωπήσας ἄναξ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1567.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1567.1.text#ἐν ταῖς Ἀθήναις γνωριεῖν ταύτην τε σήν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1568.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1568.1.text#σέ θ' ὡς πέφυκας τῆσδε καὶ Φοίβου πατρός.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1569.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1569.1.text#ἀλλ' ὡς περαίνω πρᾶγμα, καὶ χρησμοὺς θεοῦ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1570.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1570.1.text#ἐφ' οἷσιν ἔζευξ' ἅρματ', εἰσακούσατον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1571.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1571.1.text#λαβοῦσα τόνδε παῖδα Κεκροπίαν χθόνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1572.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1572.1.text#χώρει, Κρέουσα, κἀς θρόνους τυραννικοὺς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1573.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1573.1.text#ἵδρυσον. ἐκ γὰρ τῶν Ἐρεχθέως γεγὼς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1574.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1574.1.text#δίκαιος ἄρχειν τῆς γ' ἐμῆς ὅδε χθονός,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1575.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1575.1.text#ἔσται τ' ἀν' Ἑλλάδ' εὐκλεής. οἱ τοῦδε γὰρ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1576.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1576.1.text#παῖδες γενόμενοι τέσσαρες ῥίζης μιᾶς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1577.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1577.1.text#ἐπώνυμοι γῆς κἀπιφυλίου χθονὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1578.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1578.1.text#λαῶν ἔσονται, σκόπελον οἳ ναίουσ' ἐμόν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1579.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1579.1.text#Γελέων μὲν ἔσται πρῶτος· εἶτα δεύτερος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1579.2.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1579.2.text#{ [ … ] }
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1580.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1580.1.text#Ὅπλητες Ἀργαδῆς τ', ἐμῆς τ' ἀπ' αἰγίδος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1581.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1581.1.text#ἔμφυλον ἕξουσ' Αἰγικορῆς. οἱ τῶνδε δ' αὖ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1582.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1582.1.text#παῖδες γενόμενοι σὺν χρόνῳ πεπρωμένῳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1583.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1583.1.text#Κυκλάδας ἐποικήσουσι νησαίας πόλεις
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1584.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1584.1.text#χέρσους τε παράλους, ὃ σθένος τἠμῇ χθονὶ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1585.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1585.1.text#δίδωσιν· ἀντίπορθμα δ' ἠπείροιν δυοῖν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1586.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1586.1.text#πεδία κατοικήσουσιν, Ἀσιάδος τε γῆς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1587.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1587.1.text#Εὐρωπίας τε· τοῦδε δ' ὀνόματος χάριν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1588.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1588.1.text#Ἴωνες ὀνομασθέντες ἕξουσιν κλέος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1589.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1589.1.text#Ξούθῳ δὲ καὶ σοὶ γίγνεται κοινὸν γένος,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1590.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1590.1.text#Δῶρος μέν, ἔνθεν Δωρὶς ὑμνηθήσεται
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1591.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1591.1.text#πόλις κατ' αἶαν Πελοπίαν· ὁ δεύτερος
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1592.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1592.1.text#Ἀχαιός, ὃς γῆς παραλίας Ῥίου πέλας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1593.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1593.1.text#τύραννος ἔσται, κἀπισημανθήσεται
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1594.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1594.1.text#κείνου κεκλῆσθαι λαὸς ὄνομ' ἐπώνυμος.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1595.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1595.1.text#καλῶς δ' Ἀπόλλων πάντ' ἔπραξε· πρῶτα μὲν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1596.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1596.1.text#ἄνοσον λοχεύει σ', ὥστε μὴ γνῶναι φίλους·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1597.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1597.1.text#ἐπεὶ δ' ἔτικτες τόνδε παῖδα κἀπέθου
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1598.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1598.1.text#ἐν σπαργάνοισιν, ἁρπάσαντ' ἐς ἀγκάλας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1599.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1599.1.text#Ἑρμῆν κελεύει δεῦρο πορθμεῦσαι βρέφος,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1600.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1600.1.text#ἔθρεψέ τ' οὐδ' εἴασεν ἐκπνεῦσαι βίον.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1601.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1601.1.text#νῦν οὖν σιώπα, παῖς ὅδ' ὡς πέφυκε σός,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1602.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1602.1.text#ἵν' ἡ δόκησις Ξοῦθον ἡδέως ἔχῃ,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1603.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1603.1.text#σύ τ' αὖ τὰ σαυτῆς ἀγάθ' ἔχουσ' ἴῃς, γύναι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1604.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1604.1.text#καὶ χαίρετ'· ἐκ γὰρ τῆσδ' ἀναψυχῆς πόνων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1605.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1605.1.text#εὐδαίμον' ὑμῖν πότμον ἐξαγγέλλομαι.[ … ]
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1606.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1606.1.text#ὦ Διὸς Παλλὰς μεγίστου θύγατερ, οὐκ ἀπιστίᾳ
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1607.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1607.1.text#σοὺς λόγους ἐδεξάμεσθα· πείθομαι δ' εἶναι πατρὸς
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1608.1.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1608.1.text#Λοξίου καὶ τῆσδε. — καὶ πρὶν τοῦτο δ' οὐκ ἄπιστον ἦν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1609.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1609.1.text#τἀμὰ νῦν ἄκουσον· αἰνῶ Φοῖβον οὐκ αἰνοῦσα πρίν,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1610.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1610.1.text#οὕνεχ' οὗ ποτ' ἠμέλησε παιδὸς ἀποδίδωσί μοι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1611.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1611.1.text#αἵδε δ' εὐωποὶ πύλαι μοι καὶ θεοῦ χρηστήρια,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1612.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1612.1.text#δυσμενῆ πάροιθεν ὄντα. νῦν δὲ καὶ ῥόπτρων χέρας
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1613.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1613.1.text#ἡδέως ἐκκρημνάμεσθα καὶ προσεννέπω πύλας.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1614.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1614.1.text#ᾔνεσ' οὕνεκ' εὐλογεῖς θεὸν μεταβαλοῦσ'· ἀεὶ γὰρ οὖν
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1615.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1615.1.text#χρόνια μὲν τὰ τῶν θεῶν πως, ἐς τέλος δ' οὐκ ἀσθενῆ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1616.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1616.1.text#ὦ τέκνον, στείχωμεν οἴκους.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1616.2.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1616.2.text#στείχεθ', ἕψομαι δ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1617.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1617.1.text#ἀξία γ' ἡμῶν ὁδουρός.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1617.2.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1617.2.text#καὶ φιλοῦσά γε πτόλιν.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1618.1.speaker#Κρέουσα
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1618.1.text#ἐς θρόνους δ' ἵζου παλαιούς.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1618.2.speaker#Ἴων
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1618.2.text#ἄξιον τὸ κτῆμά μοι.
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1619.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1619.1.text#ὦ Διὸς Λητοῦς τ' Ἄπολλον, χαῖρ'· ὅτῳ δ' ἐλαύνεται
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1620.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1620.1.text#συμφοραῖς οἶκος, σέβοντα δαίμονας θαρσεῖν χρεών·
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1621.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1621.1.text#ἐς τέλος γὰρ οἱ μὲν ἐσθλοὶ τυγχάνουσιν ἀξίων,
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1622.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg010.fu.sp:1622.1.text#οἱ κακοὶ δ', ὥσπερ πεφύκασ', οὔποτ' εὖ πράξειαν ἄν.
</body>
</text>
</TEI>
