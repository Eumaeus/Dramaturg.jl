#!ctsdata
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1.1.text#Πέλοψ ὁ Ταντάλειος ἐς Πῖσαν μολὼν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:2.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:2.1.text#θοαῖσιν ἵπποις Οἰνομάου γαμεῖ κόρην,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:3.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:3.1.text#ἐξ ἧς Ἀτρεὺς ἔβλαστεν· Ἀτρέως δὲ παῖς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:4.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:4.1.text#Μενέλαος Ἀγαμέμνων τε· τοῦ δ' ἔφυν ἐγώ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:5.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:5.1.text#τῆς Τυνδαρείας θυγατρὸς Ἰφιγένεια παῖς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:6.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:6.1.text#ἣν ἀμφὶ δίναις ἃς θάμ' Εὔριπος πυκναῖς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:7.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:7.1.text#αὔραις ἑλίσσων κυανέαν ἅλα στρέφει,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:8.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:8.1.text#ἔσφαξεν Ἑλένης οὕνεχ', ὡς δοκεῖ, πατὴρ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:9.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:9.1.text#Ἀρτέμιδι κλειναῖς ἐν πτυχαῖσιν Αὐλίδος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:10.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:10.1.text#ἐνταῦθα γὰρ δὴ χιλίων ναῶν στόλον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:11.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:11.1.text#Ἑλληνικὸν συνήγαγ' Ἀγαμέμνων ἄναξ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:12.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:12.1.text#τὸν καλλίνικον στέφανον Ἰλίου θέλων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:13.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:13.1.text#λαβεῖν Ἀχαιοῖς τούς θ' ὑβρισθέντας γάμους
urn:cts:greekLit:tlg0006.tlg013.fu-sp:14.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:14.1.text#Ἑλένης μετελθεῖν, Μενέλεῳ χάριν φέρων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:15.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:15.1.text#δεινῆς δ' ἀπλοίας πνευμάτων τε τυγχάνων,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:16.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:16.1.text#ἐς ἔμπυρ' ἦλθε, καὶ λέγει Κάλχας τάδε·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:17.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:17.1.text#ὦ τῆσδ' ἀνάσσων Ἑλλάδος στρατηγίας,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:18.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:18.1.text#Ἀγάμεμνον, οὐ μὴ ναῦς ἀφορμίσῃ χθονός,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:19.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:19.1.text#πρὶν ἂν κόρην σὴν Ἰφιγένειαν Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:20.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:20.1.text#λάβῃ σφαγεῖσαν· ὅ τι γὰρ ἐνιαυτὸς τέκοι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:21.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:21.1.text#κάλλιστον, ηὔξω φωσφόρῳ θύσειν θεᾷ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:22.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:22.1.text#παῖδ' οὖν ἐν οἴκοις σὴ Κλυταιμήστρα δάμαρ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:23.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:23.1.text#τίκτει — τὸ καλλιστεῖον εἰς ἔμ' ἀναφέρων —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:24.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:24.1.text#ἣν χρή σε θῦσαι. καί μ' Ὀδυσσέως τέχναις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:25.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:25.1.text#μητρὸς παρείλοντ' ἐπὶ γάμοις Ἀχιλλέως.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:26.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:26.1.text#ἐλθοῦσα δ' Αὐλίδ' ἡ τάλαιν' ὑπὲρ πυρᾶς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:27.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:27.1.text#μεταρσία ληφθεῖσ' ἐκαινόμην ξίφει·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:28.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:28.1.text#ἀλλ' ἐξέκλεψεν ἔλαφον ἀντιδοῦσά μου
urn:cts:greekLit:tlg0006.tlg013.fu-sp:29.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:29.1.text#Ἄρτεμις Ἀχαιοῖς, διὰ δὲ λαμπρὸν αἰθέρα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:30.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:30.1.text#πέμψασά μ' ἐς τήνδ' ᾤκισεν Ταύρων χθόνα,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:31.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:31.1.text#οὗ γῆς ἀνάσσει βαρβάροισι βάρβαρος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:32.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:32.1.text#Θόας, ὃς ὠκὺν πόδα τιθεὶς ἴσον πτεροῖς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:33.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:33.1.text#ἐς τοὔνομ' ἦλθε τόδε ποδωκείας χάριν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:34.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:34.1.text#ναοῖσι δ' ἐν τοῖσδ' ἱερέαν τίθησί με·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:35.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:35.1.text#ὅθεν νόμοισι τοῖσιν ἥδεται θεὰ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:36.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:36.1.text#Ἄρτεμις, ἑορτῆς, τοὔνομ' ἧς καλὸν μόνον —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:37.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:37.1.text#τὰ δ' ἄλλα σιγῶ, τὴν θεὸν φοβουμένη —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:38.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:38.1.text#[ θύω γὰρ ὄντος τοῦ νόμου καὶ πρὶν πόλει, ]
urn:cts:greekLit:tlg0006.tlg013.fu-sp:39.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:39.1.text#[ ὃς ἂν κατέλθῃ τήνδε γῆν Ἕλλην ἀνήρ. ]
urn:cts:greekLit:tlg0006.tlg013.fu-sp:40.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:40.1.text#κατάρχομαι μέν, σφάγια δ' ἄλλοισιν μέλει
urn:cts:greekLit:tlg0006.tlg013.fu-sp:41.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:41.1.text#ἄρρητ' ἔσωθεν τῶνδ' ἀνακτόρων θεᾶς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:42.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:42.1.text#ἃ καινὰ δ' ἥκει νὺξ φέρουσα φάσματα,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:43.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:43.1.text#λέξω πρὸς αἰθέρ', εἴ τι δὴ τόδ' ἔστ' ἄκος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:44.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:44.1.text#ἔδοξ' ἐν ὕπνῳ τῆσδ' ἀπαλλαχθεῖσα γῆς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:45.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:45.1.text#οἰκεῖν ἐν Ἄργει, παρθένοισι δ' ἐν μέσαις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:46.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:46.1.text#εὕδειν, χθονὸς δὲ νῶτα σεισθῆναι σάλῳ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:47.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:47.1.text#φεύγειν δὲ κἄξω στᾶσα θριγκὸν εἰσιδεῖν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:48.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:48.1.text#δόμων πίτνοντα, πᾶν δ' ἐρείψιμον στέγος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:49.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:49.1.text#βεβλημένον πρὸς οὖδας ἐξ ἄκρων σταθμῶν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:50.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:50.1.text#μόνος λελεῖφθαι στῦλος εἷς ἔδοξέ μοι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:51.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:51.1.text#δόμων πατρῴων, ἐκ δ' ἐπικράνων κόμας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:52.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:52.1.text#ξανθὰς καθεῖναι, φθέγμα δ' ἀνθρώπου λαβεῖν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:53.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:53.1.text#κἀγὼ τέχνην τήνδ' ἣν ἔχω ξενοκτόνον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:54.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:54.1.text#τιμῶσ' ὑδραίνειν αὐτὸν ὡς θανούμενον,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:55.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:55.1.text#κλαίουσα. τοὔναρ δ' ὧδε συμβάλλω τόδε·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:56.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:56.1.text#τέθνηκ' Ὀρέστης, οὗ κατηρξάμην ἐγώ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:57.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:57.1.text#στῦλοι γὰρ οἴκων παῖδές εἰσιν ἄρσενες·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:58.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:58.1.text#θνῄσκουσι δ' οὓς ἂν χέρνιβες βάλωσ' ἐμαί.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:59.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:59.1.text#[ οὐδ' αὖ συνάψαι τοὔναρ ἐς φίλους ἔχω· ]
urn:cts:greekLit:tlg0006.tlg013.fu-sp:60.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:60.1.text#[ Στροφίῳ γὰρ οὐκ ἦν παῖς, ὅτ' ὠλλύμην ἐγώ. ]
urn:cts:greekLit:tlg0006.tlg013.fu-sp:61.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:61.1.text#νῦν οὖν ἀδελφῷ βούλομαι δοῦναι χοὰς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:62.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:62.1.text#παροῦσ' ἀπόντι — ταῦτα γὰρ δυναίμεθ' ἄν —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:63.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:63.1.text#σὺν προσπόλοισιν, ἃς ἔδωχ' ἡμῖν ἄναξ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:64.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:64.1.text#Ἑλληνίδας γυναῖκας. ἀλλ' ἐξ αἰτίας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:65.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:65.1.text#οὔπω τίνος πάρεισιν; εἶμ' ἔσω δόμων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:66.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:66.1.text#ἐν οἷσι ναίω τῶνδ' ἀνακτόρων θεᾶς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:67.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:67.1.text#ὅρα, φυλάσσου μή τις ἐν στίβῳ βροτῶν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:68.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:68.1.text#ὁρῶ, σκοποῦμαι δ' ὄμμα πανταχῆ στρέφων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:69.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:69.1.text#Πυλάδη, δοκεῖ σοι μέλαθρα ταῦτ' εἶναι θεᾶς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:70.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:70.1.text#ἔνθ' Ἀργόθεν ναῦν ποντίαν ἐστείλαμεν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:71.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:71.1.text#ἔμοιγ', Ὀρέστα· σοὶ δὲ συνδοκεῖν χρεών.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:72.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:72.1.text#καὶ βωμός, Ἕλλην οὗ καταστάζει φόνος;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:73.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:73.1.text#ἐξ αἱμάτων γοῦν ξάνθ' ἔχει τριχώματα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:74.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:74.1.text#θριγκοῖς δ' ὑπ' αὐτοῖς σκῦλ' ὁρᾷς ἠρτημένα;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:75.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:75.1.text#τῶν κατθανόντων γ' ἀκροθίνια ξένων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:76.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:76.1.text#ἀλλ' ἐγκυκλοῦντ' ὀφθαλμὸν εὖ σκοπεῖν χρεών.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:77.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:77.1.text#ὦ Φοῖβε, ποῖ μ' αὖ τήνδ' ἐς ἄρκυν ἤγαγες
urn:cts:greekLit:tlg0006.tlg013.fu-sp:78.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:78.1.text#χρήσας, ἐπειδὴ πατρὸς αἷμ' ἐτεισάμην,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:79.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:79.1.text#μητέρα κατακτάς, διαδοχαῖς δ' Ἐρινύων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:80.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:80.1.text#ἠλαυνόμεσθα φυγάδες ἔξεδροι χθονὸς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:81.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:81.1.text#δρόμους τε πολλοὺς ἐξέπλησα καμπίμους,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:82.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:82.1.text#ἐλθὼν δέ σ' ἠρώτησα πῶς τροχηλάτου
urn:cts:greekLit:tlg0006.tlg013.fu-sp:83.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:83.1.text#μανίας ἂν ἔλθοιμ' ἐς τέλος πόνων τ' ἐμῶν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:84.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:84.1.text#οὓς ἐξεμόχθουν περιπολῶν καθ' Ἑλλάδα —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:85.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:85.1.text#σὺ δ' εἶπας ἐλθεῖν Ταυρικῆς μ' ὅρους χθονός,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:86.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:86.1.text#ἔνθ' Ἄρτεμίς σοι σύγγονος βωμοὺς ἔχοι,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:87.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:87.1.text#λαβεῖν τ' ἄγαλμα θεᾶς, ὅ φασιν ἐνθάδε
urn:cts:greekLit:tlg0006.tlg013.fu-sp:88.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:88.1.text#ἐς τούσδε ναοὺς οὐρανοῦ πεσεῖν ἄπο·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:89.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:89.1.text#λαβόντα δ' ἢ τέχναισιν ἢ τύχῃ τινί,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:90.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:90.1.text#κίνδυνον ἐκπλήσαντ', Ἀθηναίων χθονὶ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:91.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:91.1.text#δοῦναι — τὸ δ' ἐνθένδ' οὐδὲν ἐρρήθη πέρα —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:92.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:92.1.text#καὶ ταῦτα δράσαντ' ἀμπνοὰς ἕξειν πόνων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:93.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:93.1.text#ἥκω δὲ πεισθεὶς σοῖς λόγοισιν ἐνθάδε
urn:cts:greekLit:tlg0006.tlg013.fu-sp:94.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:94.1.text#ἄγνωστον ἐς γῆν, ἄξενον. σὲ δ' ἱστορῶ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:95.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:95.1.text#Πυλάδη — σὺ γάρ μοι τοῦδε συλλήπτωρ πόνου —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:96.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:96.1.text#τί δρῶμεν; ἀμφίβληστρα γὰρ τοίχων ὁρᾷς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:97.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:97.1.text#ὑψηλά· πότερα δωμάτων προσαμβάσεις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:98.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:98.1.text#ἐκβησόμεσθα; πῶς ἂν οὖν λάθοιμεν ἄν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:99.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:99.1.text#ἢ χαλκότευκτα κλῇθρα λύσαντες μοχλοῖς —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:100.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:100.1.text#ὧν οὐδὲν ἴσμεν; ἢν δ' ἀνοίγοντες πύλας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:101.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:101.1.text#ληφθῶμεν ἐσβάσεις τε μηχανώμενοι,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:102.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:102.1.text#θανούμεθ'. ἀλλὰ πρὶν θανεῖν, νεὼς ἔπι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:103.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:103.1.text#φεύγωμεν, ᾗπερ δεῦρ' ἐναυστολήσαμεν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:104.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:104.1.text#φεύγειν μὲν οὐκ ἀνεκτὸν οὐδ' εἰώθαμεν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:105.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:105.1.text#τὸν τοῦ θεοῦ δὲ χρησμὸν οὐ κακιστέον·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:106.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:106.1.text#ναοῦ δ' ἀπαλλαχθέντε κρύψωμεν δέμας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:107.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:107.1.text#κατ' ἄντρ' ἃ πόντος νοτίδι διακλύζει μέλας —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:108.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:108.1.text#νεὼς ἄπωθεν, μή τις εἰσιδὼν σκάφος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:109.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:109.1.text#βασιλεῦσιν εἴπῃ κᾆτα ληφθῶμεν βίᾳ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:110.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:110.1.text#ὅταν δὲ νυκτὸς ὄμμα λυγαίας μόλῃ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:111.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:111.1.text#τολμητέον τοι ξεστὸν ἐκ ναοῦ λαβεῖν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:112.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:112.1.text#ἄγαλμα πάσας προσφέροντε μηχανάς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:113.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:113.1.text#ὅρα δέ γ' εἴσω τριγλύφων ὅποι κενὸν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:114.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:114.1.text#δέμας καθεῖναι· τοὺς πόνους γὰρ ἁγαθοὶ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:115.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:115.1.text#τολμῶσι, δειλοὶ δ' εἰσὶν οὐδὲν οὐδαμοῦ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:116.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:116.1.text#οὔ τοι μακρὸν μὲν ἤλθομεν κώπῃ πόρον,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:117.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:117.1.text#ἐκ τερμάτων δὲ νόστον ἀροῦμεν πάλιν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:118.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:118.1.text#ἀλλ' εὖ γὰρ εἶπας, πειστέον· χωρεῖν χρεὼν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:119.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:119.1.text#ὅποι χθονὸς κρύψαντε λήσομεν δέμας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:120.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:120.1.text#οὐ γὰρ τὸ τοῦ θεοῦ γ' αἴτιον γενήσεται
urn:cts:greekLit:tlg0006.tlg013.fu-sp:121.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:121.1.text#πεσεῖν ἄχρηστον θέσφατον· τολμητέον·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:122.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:122.1.text#μόχθος γὰρ οὐδεὶς τοῖς νέοις σκῆψιν φέρει.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:123.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:123.1.text#εὐφαμεῖτ', ὦ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:124.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:124.1.text#πόντου δισσὰς συγχωρούσας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:125.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:125.1.text#πέτρας Ἀξείνου ναίοντες.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:126.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:126.1.text#ὦ παῖ τᾶς Λατοῦς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:127.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:127.1.text#Δίκτυνν' οὐρεία,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:128.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:128.1.text#πρὸς σὰν αὐλάν, εὐστύλων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:129.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:129.1.text#ναῶν χρυσήρεις θριγκούς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:130.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:130.1.text#πόδα παρθένιον ὅσιον ὁσίας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:131.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:131.1.text#κλῃδούχου δούλα πέμπω,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:132.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:132.1.text#Ἑλλάδος εὐίππου πύργους
urn:cts:greekLit:tlg0006.tlg013.fu-sp:134.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:134.1.text#καὶ τείχη χόρτων τ' εὐδένδρων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:135.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:135.1.text#ἐξαλλάξασ' Εὐρώπαν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:136.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:136.1.text#πατρῴων οἴκων ἕδρας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:137.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:137.1.text#ἔμολον· τί νέον; τίνα φροντίδ' ἔχεις;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:138.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:138.1.text#τί με πρὸς ναοὺς ἄγαγες ἄγαγες,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:139.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:139.1.text#ὦ παῖ τοῦ τᾶς Τροίας πύργους
urn:cts:greekLit:tlg0006.tlg013.fu-sp:140.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:140.1.text#ἐλθόντος κλεινᾷ σὺν κώπᾳ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:141.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:141.1.text#χιλιοναύτα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:142.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:142.1.text#μυριοτευχοῦς Ἀτρείδα; [ τῶν κλεινῶν; ]
urn:cts:greekLit:tlg0006.tlg013.fu-sp:143.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:143.1.text#ἰὼ δμωαί,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:144.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:144.1.text#δυσθρηνήτοις ὡς θρήνοις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:145.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:145.1.text#ἔγκειμαι, τᾶς οὐκ εὐμούσου
urn:cts:greekLit:tlg0006.tlg013.fu-sp:146.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:146.1.text#μολπᾶς [ βοὰν ] ἀλύροις ἐλέγοις, αἰαῖ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:147.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:147.1.text#αἰαῖ, κηδείοις οἴκτοισιν·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:148.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:148.1.text#αἵ μοι συμβαίνουσ' ἆται,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:149.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:149.1.text#σύγγονον ἁμὸν κατακλαιομένα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:150.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:150.1.text#ζωᾶς, οἵαν { οἵαν } ἰδόμαν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:151.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:151.1.text#ὄψιν ὀνείρων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:152.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:152.1.text#νυκτός, τᾶς ἐξῆλθ' ὄρφνα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:152.2.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:152.2.text#ὀλόμαν ὀλόμαν·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:153.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:153.1.text#οὐκ εἴσ' οἶκοι πατρῷοι·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:154.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:154.1.text#οἴμοι { μοι } φροῦδος γέννα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:155.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:155.1.text#φεῦ φεῦ τῶν Ἄργει μόχθων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:156.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:156.1.text#ἰὼ δαῖμον,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:157.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:157.1.text#μόνον ὅς με κασίγνητον συλᾷς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:159.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:159.1.text#Ἀίδᾳ πέμψας, ᾧ τάσδε χοὰς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:160.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:160.1.text#μέλλω κρατῆρά τε τὸν φθιμένων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:161.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:161.1.text#ὑδραίνειν γαίας ἐν νώτοις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:162.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:162.1.text#πηγάς τ' οὐρείων ἐκ μόσχων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:164.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:164.1.text#Βάκχου τ' οἰνηρὰς λοιβὰς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:165.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:165.1.text#ξουθᾶν τε πόνημα μελισσᾶν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:166.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:166.1.text#ἃ νεκροῖς θελκτήρια κεῖται.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:168.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:168.1.text#ἀλλ' ἔνδος μοι πάγχρυσον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:169.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:169.1.text#τεῦχος καὶ λοιβὰν Ἅιδα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:170.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:170.1.text#ὦ κατὰ γαίας Ἀγαμεμνόνιον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:171.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:171.1.text#θάλος, ὡς φθιμένῳ τάδε σοι πέμπω·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:172.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:172.1.text#δέξαι δ'· οὐ γὰρ πρὸς τύμβον σοι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:173.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:173.1.text#ξανθὰν χαίταν, οὐ δάκρυ' οἴσω.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:175.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:175.1.text#τηλόσε γὰρ δὴ σᾶς ἀπενάσθην
urn:cts:greekLit:tlg0006.tlg013.fu-sp:176.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:176.1.text#πατρίδος καὶ ἐμᾶς, ἔνθα δοκήμασι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:177.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:177.1.text#κεῖμαι σφαχθεῖσ' ἁ τλάμων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:178.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:178.1.text#ἀντιψάλμους ᾠδὰς ὕμνων τ'
urn:cts:greekLit:tlg0006.tlg013.fu-sp:180.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:180.1.text#Ἀσιητᾶν σοι βάρβαρον ἀχὰν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:181.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:181.1.text#δεσποίνᾳ γ' ἐξαυδάσω,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:183.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:183.1.text#τὰν ἐν θρήνοισιν μοῦσαν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:184.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:184.1.text#νέκυσι μελομέναν, τὰν ἐν μολπαῖς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:185.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:185.1.text#Ἅιδας ὑμνεῖ δίχα παιάνων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:186.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:186.1.text#οἴμοι, τῶν Ἀτρειδᾶν οἴκων·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:187.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:187.1.text#ἔρρει φῶς σκήπτρων, οἴμοι,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:188.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:188.1.text#πατρῴων οἴκων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:189.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:189.1.text#ἦν ἐκ τῶν εὐόλβων Ἄργει
urn:cts:greekLit:tlg0006.tlg013.fu-sp:190.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:190.1.text#βασιλέων ἀρχά,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:191.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:191.1.text#μόχθος δ' ἐκ μόχθων ᾄσσει·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:192.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:192.1.text#δινευούσαις ἵπποισι { ῥιφαὶ }
urn:cts:greekLit:tlg0006.tlg013.fu-sp:193.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:193.1.text#{ Πέλοπος } πταναῖς· ἀλλάξας δ' ἐξ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:194.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:194.1.text#ἕδρας ἱερὸν { ἱερὸν } ὄμμ' αὐγᾶς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:195.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:195.1.text#ἅλιος. ἄλλαις δ' ἄλλα προσέβα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:196.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:196.1.text#χρυσέας ἀρνὸς μελάθροις ὀδύνα,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:197.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:197.1.text#{ φόνος ἐπὶ φόνῳ, ἄχεα ἄχεσιν }
urn:cts:greekLit:tlg0006.tlg013.fu-sp:199.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:199.1.text#ἔνθεν τῶν πρόσθεν δμαθέντων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:200.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:200.1.text#Τανταλιδᾶν ἐκβαίνει ποινά γ'
urn:cts:greekLit:tlg0006.tlg013.fu-sp:201.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:201.1.text#εἰς οἴκους, σπεύδει δ' ἀσπούδαστ'
urn:cts:greekLit:tlg0006.tlg013.fu-sp:202.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:202.1.text#ἐπὶ σοὶ δαίμων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:203.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:203.1.text#ἐξ ἀρχᾶς μοι δυσδαίμων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:204.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:204.1.text#δαίμων τᾶς ματρὸς ζώνας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:205.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:205.1.text#καὶ νυκτὸς κείνας· ἐξ ἀρχᾶς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:206.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:206.1.text#λόχιαι στερρὰν παιδείαν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:207.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:207.1.text#Μοῖραι ξυντείνουσιν θεαί,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:208.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:208.1.text#τᾷ μναστευθείσᾳ 'ξ Ἑλλάνων,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:209.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:209.1.text#ἃν πρωτόγονον θάλος ἐν θαλάμοις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:210.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:210.1.text#Λήδας ἁ τλάμων κούρα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:211.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:211.1.text#σφάγιον πατρῴᾳ λώβᾳ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:212.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:212.1.text#καὶ θῦμ' οὐκ εὐγάθητον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:213.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:213.1.text#ἔτεκεν, ἔτρεφεν εὐκταίαν·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:214.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:214.1.text#ἱππείοις δ' ἐν δίφροισι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:215.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:215.1.text#ψαμάθων Αὐλίδος ἐπέβασαν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:216.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:216.1.text#νύμφαιον, οἴμοι, δύσνυμφον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:217.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:217.1.text#τῷ τᾶς Νηρέως κούρας, αἰαῖ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:218.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:218.1.text#νῦν δ' ἀξείνου πόντου ξείνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:219.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:219.1.text#δυσχόρτους οἴκους ναίω,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:220.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:220.1.text#ἄγαμος ἄτεκνος ἄπολις ἄφιλος,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:221.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:221.1.text#οὐ τὰν Ἄργει μέλπουσ' Ἥραν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:222.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:222.1.text#οὐδ' ἱστοῖς ἐν καλλιφθόγγοις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:223.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:223.1.text#κερκίδι Παλλάδος Ἀτθίδος εἰκὼ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:224.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:224.1.text#{ καὶ } Τιτάνων ποικίλλουσ', ἀλλ'
urn:cts:greekLit:tlg0006.tlg013.fu-sp:225.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:225.1.text#αἱμόρραντον δυσφόρμιγγα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:226.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:226.1.text#ξείνων { αἱμάσσουσ' ἄταν βωμούς, }
urn:cts:greekLit:tlg0006.tlg013.fu-sp:227.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:227.1.text#οἰκτράν τ' αἰαζόντων αὐδὰν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:228.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:228.1.text#οἰκτρόν τ' ἐκβαλλόντων δάκρυον.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:229.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:229.1.text#καὶ νῦν κείνων μέν μοι λάθα,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:230.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:230.1.text#τὸν δ' Ἄργει δμαθέντα κλαίω
urn:cts:greekLit:tlg0006.tlg013.fu-sp:232.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:232.1.text#σύγγονον, ὃν ἔλιπον ἐπιμαστίδιον,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:233.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:233.1.text#ἔτι βρέφος, ἔτι νέον, ἔτι θάλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:234.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:234.1.text#ἐν χερσὶν ματρὸς πρὸς στέρνοις τ'
urn:cts:greekLit:tlg0006.tlg013.fu-sp:235.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:235.1.text#Ἄργει σκηπτοῦχον Ὀρέσταν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:236.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:236.1.text#καὶ μὴν ὅδ' ἀκτὰς ἐκλιπὼν θαλασσίους
urn:cts:greekLit:tlg0006.tlg013.fu-sp:237.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:237.1.text#βουφορβὸς ἥκει σημανῶν τί σοι νέον.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:238.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:238.1.text#Ἀγαμέμνονός τε καὶ Κλυταιμήστρας τέκνον,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:239.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:239.1.text#ἄκουε καινῶν ἐξ ἐμοῦ κηρυγμάτων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:240.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:240.1.text#τί δ' ἔστι τοῦ παρόντος ἐκπλῆσσον λόγου;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:241.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:241.1.text#ἥκουσιν ἐς γῆν, κυανέαν Συμπληγάδα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:242.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:242.1.text#πλάτῃ φυγόντες, δίπτυχοι νεανίαι,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:243.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:243.1.text#θεᾷ φίλον πρόσφαγμα καὶ θυτήριον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:244.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:244.1.text#Ἀρτέμιδι. χέρνιβας δὲ καὶ κατάργματα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:245.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:245.1.text#οὐκ ἂν φθάνοις ἂν εὐτρεπῆ ποιουμένη.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:246.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:246.1.text#ποδαποί; τίνος γῆς σχῆμ' ἔχουσιν οἱ ξένοι;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:247.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:247.1.text#Ἕλληνες· ἓν τοῦτ' οἶδα κοὐ περαιτέρω.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:248.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:248.1.text#οὐδ' ὄνομ' ἀκούσας οἶσθα τῶν ξένων φράσαι;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:249.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:249.1.text#Πυλάδης ἐκλῄζεθ' ἅτερος πρὸς θατέρου.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:250.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:250.1.text#τοῦ ξυζύγου δὲ τοῦ ξένου τί τοὔνομ' ἦν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:251.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:251.1.text#οὐδεὶς τόδ' οἶδεν· οὐ γὰρ εἰσηκούσαμεν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:252.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:252.1.text#πῶς δ' εἴδετ' αὐτοὺς κἀντυχόντες εἵλετε;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:253.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:253.1.text#ἄκραις ἐπὶ ῥηγμῖσιν ἀξένου πόρου —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:254.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:254.1.text#καὶ τίς θαλάσσης βουκόλοις κοινωνία;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:255.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:255.1.text#βοῦς ἤλθομεν νίψοντες ἐναλίᾳ δρόσῳ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:256.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:256.1.text#ἐκεῖσε δὴ 'πάνελθε, πῶς νιν εἵλετε
urn:cts:greekLit:tlg0006.tlg013.fu-sp:257.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:257.1.text#τρόπῳ θ' ὁποίῳ· τοῦτο γὰρ μαθεῖν θέλω.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:258.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:258.1.text#χρόνιοι γὰρ ἥκουσ'· οὐδέ πω βωμὸς θεᾶς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:259.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:259.1.text#Ἑλληνικαῖσιν ἐξεφοινίχθη ῥοαῖς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:260.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:260.1.text#ἐπεὶ τὸν ἐσρέοντα διὰ Συμπληγάδων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:261.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:261.1.text#βοῦς ὑλοφορβοὺς πόντον εἰσεβάλλομεν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:262.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:262.1.text#ἦν τις διαρρὼξ κυμάτων πολλῷ σάλῳ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:263.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:263.1.text#κοιλωπὸς ἀγμός, πορφυρευτικαὶ στέγαι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:264.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:264.1.text#ἐνταῦθα δισσοὺς εἶδέ τις νεανίας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:265.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:265.1.text#βουφορβὸς ἡμῶν, κἀπεχώρησεν πάλιν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:266.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:266.1.text#ἄκροισι δακτύλοισι πορθμεύων ἴχνος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:267.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:267.1.text#ἔλεξε δ'· Οὐχ ὁρᾶτε; δαίμονές τινες
urn:cts:greekLit:tlg0006.tlg013.fu-sp:268.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:268.1.text#θάσσουσιν οἵδε.  — θεοσεβὴς δ' ἡμῶν τις ὢν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:269.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:269.1.text#ἀνέσχε χεῖρα καὶ προσηύξατ' εἰσιδών·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:270.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:270.1.text#ὦ ποντίας παῖ Λευκοθέας, νεῶν φύλαξ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:271.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:271.1.text#δέσποτα Παλαῖμον, ἵλεως ἡμῖν γενοῦ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:272.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:272.1.text#εἴτ' οὖν ἐπ' ἀκταῖς θάσσετον Διοσκόρω,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:273.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:273.1.text#ἢ Νηρέως ἀγάλμαθ', ὃς τὸν εὐγενῆ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:274.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:274.1.text#ἔτικτε πεντήκοντα Νηρῄδων χορόν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:275.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:275.1.text#ἄλλος δέ τις μάταιος, ἀνομίᾳ θρασύς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:276.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:276.1.text#ἐγέλασεν εὐχαῖς, ναυτίλους δ' ἐφθαρμένους
urn:cts:greekLit:tlg0006.tlg013.fu-sp:277.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:277.1.text#θάσσειν φάραγγ' ἔφασκε τοῦ νόμου φόβῳ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:278.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:278.1.text#κλύοντας ὡς θύοιμεν ἐνθάδε ξένους.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:279.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:279.1.text#ἔδοξε δ' ἡμῶν εὖ λέγειν τοῖς πλείοσι,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:280.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:280.1.text#θηρᾶν τε τῇ θεῷ σφάγια τἀπιχώρια.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:281.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:281.1.text#κἀν τῷδε πέτραν ἅτερος λιπὼν ξένοιν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:282.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:282.1.text#ἔστη κάρα τε διετίναξ' ἄνω κάτω
urn:cts:greekLit:tlg0006.tlg013.fu-sp:283.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:283.1.text#κἀπεστέναξεν ὠλένας τρέμων ἄκρας,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:284.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:284.1.text#μανίαις ἀλαίνων, καὶ βοᾷ κυναγὸς ὥς·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:285.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:285.1.text#Πυλάδη, δέδορκας τήνδε; τήνδε δ' οὐχ ὁρᾷς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:286.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:286.1.text#Ἅιδου δράκαιναν, ὥς με βούλεται κτανεῖν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:287.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:287.1.text#δειναῖς ἐχίδναις εἰς ἔμ' ἐστομωμένη;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:288.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:288.1.text#ἣ δ' ἐκ χιτώνων πῦρ πνέουσα καὶ φόνον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:289.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:289.1.text#πτεροῖς ἐρέσσει, μητέρ' ἀγκάλαις ἐμὴν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:290.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:290.1.text#ἔχουσα — πέτρινον ὄχθον, ὡς ἐπεμβάλῃ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:291.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:291.1.text#οἴμοι, κτενεῖ με· ποῖ φύγω;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:291.2.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:291.2.text#παρῆν δ' ὁρᾶν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:292.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:292.1.text#οὐ ταῦτα μορφῆς σχήματ', ἀλλ' ἠλλάσσετο
urn:cts:greekLit:tlg0006.tlg013.fu-sp:293.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:293.1.text#φθογγάς τε μόσχων καὶ κυνῶν ὑλάγματα,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:294.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:294.1.text#{ ἃς φᾶσ' } Ἐρινῦς ἱέναι μιμήματα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:295.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:295.1.text#ἡμεῖς δὲ συσταλέντες, ὡς θαμβούμενοι,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:296.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:296.1.text#σιγῇ καθήμεθ'· ὃ δὲ χερὶ σπάσας ξίφος,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:297.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:297.1.text#μόσχους ὀρούσας ἐς μέσας λέων ὅπως,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:298.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:298.1.text#παίει σιδήρῳ λαγόνας ἐς πλευράς θ' ἱείς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:299.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:299.1.text#δοκῶν Ἐρινῦς θεὰς ἀμύνεσθαι τάδε,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:300.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:300.1.text#ὡς αἱματηρὸν πέλαγος ἐξανθεῖν ἁλός.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:301.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:301.1.text#κἀν τῷδε πᾶς τις, ὡς ὁρᾷ βουφόρβια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:302.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:302.1.text#πίπτοντα καὶ πορθούμεν', ἐξωπλίζετο,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:303.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:303.1.text#κόχλους τε φυσῶν συλλέγων τ' ἐγχωρίους·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:304.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:304.1.text#πρὸς εὐτραφεῖς γὰρ καὶ νεανίας ξένους
urn:cts:greekLit:tlg0006.tlg013.fu-sp:305.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:305.1.text#φαύλους μάχεσθαι βουκόλους ἡγούμεθα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:306.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:306.1.text#πολλοὶ δ' ἐπληρώθημεν ἐν μακρῷ χρόνῳ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:307.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:307.1.text#πίπτει δὲ μανίας πίτυλον ὁ ξένος μεθείς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:308.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:308.1.text#στάζων ἀφρῷ γένειον· ὡς δ' ἐσείδομεν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:309.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:309.1.text#προύργου πεσόντα, πᾶς ἀνὴρ ἔσχεν πόνον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:310.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:310.1.text#βάλλων ἀράσσων. ἅτερος δὲ τοῖν ξένοιν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:311.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:311.1.text#ἀφρόν τ' ἀπέψη σώματός τ' ἐτημέλει
urn:cts:greekLit:tlg0006.tlg013.fu-sp:312.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:312.1.text#πέπλων τε προυκάλυπτεν εὐπήνους ὑφάς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:313.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:313.1.text#καραδοκῶν μὲν τἀπιόντα τραύματα,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:314.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:314.1.text#φίλον δὲ θεραπείαισιν ἄνδρ' εὐεργετῶν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:315.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:315.1.text#ἔμφρων δ' ἀνᾴξας ὁ ξένος πεσήματος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:316.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:316.1.text#ἔγνω κλύδωνα πολεμίων προσκείμενον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:317.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:317.1.text#καὶ τὴν παροῦσαν συμφορὰν αὐτοῖν πέλας,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:318.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:318.1.text#ᾤμωξέ θ'· ἡμεῖς δ' οὐκ ἀνίεμεν πέτροις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:319.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:319.1.text#βάλλοντες, ἄλλος ἄλλοθεν προσκείμενοι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:320.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:320.1.text#οὗ δὴ τὸ δεινὸν παρακέλευσμ' ἠκούσαμεν·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:321.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:321.1.text#Πυλάδη, θανούμεθ', ἀλλ' ὅπως θανούμεθα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:322.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:322.1.text#κάλλισθ'· ἕπου μοι, φάσγανον σπάσας χερί.  —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:323.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:323.1.text#ὡς δ' εἴδομεν δίπαλτα πολεμίων ξίφη,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:324.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:324.1.text#φυγῇ λεπαίας ἐξεπίμπλαμεν νάπας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:325.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:325.1.text#ἀλλ', εἰ φύγοι τις, ἅτεροι προσκείμενοι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:326.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:326.1.text#ἔβαλλον αὐτούς· εἰ δὲ τούσδ' ὠσαίατο,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:327.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:327.1.text#αὖθις τὸ νῦν ὑπεῖκον ἤρασσεν πέτροις.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:328.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:328.1.text#ἀλλ' ἦν ἄπιστον· μυρίων γὰρ ἐκ χερῶν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:329.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:329.1.text#οὐδεὶς τὰ τῆς θεοῦ θύματ' εὐτύχει βαλών.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:330.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:330.1.text#μόλις δέ νιν τόλμῃ μὲν οὐ χειρούμεθα,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:331.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:331.1.text#κύκλῳ δὲ περιβαλόντες ἐξεκλέψαμεν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:332.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:332.1.text#πέτροισι χειρῶν φάσγαν', ἐς δὲ γῆν γόνυ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:333.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:333.1.text#καμάτῳ καθεῖσαν. πρὸς δ' ἄνακτα τῆσδε γῆς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:334.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:334.1.text#κομίζομέν νιν. ὃ δ' ἐσιδὼν ὅσον τάχος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:335.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:335.1.text#ἐς χέρνιβάς τε καὶ σφαγεῖ' ἔπεμπέ σοι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:336.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:336.1.text#ηὔχου δὲ τοιάδ', ὦ νεᾶνί, σοι ξένων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:337.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:337.1.text#σφάγια παρεῖναι· κἂν ἀναλίσκῃς ξένους
urn:cts:greekLit:tlg0006.tlg013.fu-sp:338.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:338.1.text#τοιούσδε, τὸν σὸν Ἑλλὰς ἀποτείσει φόνον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:339.1.speaker#Βουκόλος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:339.1.text#δίκας τίνουσα τῆς ἐν Αὐλίδι σφαγῆς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:340.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:340.1.text#θαυμάστ' ἔλεξας τὸν μανένθ', ὅστις ποτὲ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:341.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:341.1.text#Ἕλληνος ἐκ γῆς πόντον ἦλθεν ἄξενον.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:342.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:342.1.text#εἶἑν· σὺ μὲν κόμιζε τοὺς ξένους μολών,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:343.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:343.1.text#τὰ δ' ἐνθάδ' ἡμεῖς ὅσια φροντιούμεθα —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:344.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:344.1.text#ὦ καρδία τάλαινα, πρὶν μὲν ἐς ξένους
urn:cts:greekLit:tlg0006.tlg013.fu-sp:345.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:345.1.text#γαληνὸς ἦσθα καὶ φιλοικτίρμων ἀεί,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:346.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:346.1.text#ἐς θοὑμόφυλον ἀναμετρουμένη δάκρυ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:347.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:347.1.text#Ἕλληνας ἄνδρας ἡνίκ' ἐς χέρας λάβοις.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:348.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:348.1.text#νῦν δ' ἐξ ὀνείρων οἷσιν ἠγριώμεθα,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:349.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:349.1.text#δοκοῦσ' Ὀρέστην μηκέθ' ἥλιον βλέπειν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:350.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:350.1.text#δύσνουν με λήψεσθ', οἵτινές ποθ' ἥκετε.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:351.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:351.1.text#καὶ τοῦτ' ἄρ' ἦν ἀληθές, ᾐσθόμην, φίλαι·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:352.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:352.1.text#οἱ δυστυχεῖς γὰρ τοῖσι δυστυχεστέροις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:353.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:353.1.text#αὐτοὶ κακῶς πράξαντες οὐ φρονοῦσιν εὖ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:354.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:354.1.text#ἀλλ' οὔτε πνεῦμα Διόθεν ἦλθε πώποτε,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:355.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:355.1.text#οὐ πορθμίς, ἥτις διὰ πέτρας Συμπληγάδας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:356.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:356.1.text#Ἑλένην ἀπήγαγ' ἐνθάδ', ἥ μ' ἀπώλεσεν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:357.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:357.1.text#Μενέλεών θ', ἵν' αὐτοὺς ἀντετιμωρησάμην,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:358.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:358.1.text#τὴν ἐνθάδ' Αὖλιν ἀντιθεῖσα τῆς ἐκεῖ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:359.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:359.1.text#οὗ μ' ὥστε μόσχον Δαναΐδαι χειρούμενοι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:360.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:360.1.text#ἔσφαζον, ἱερεὺς δ' ἦν ὁ γεννήσας πατήρ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:361.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:361.1.text#οἴμοι — κακῶν γὰρ τῶν τότ' οὐκ ἀμνημονῶ —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:362.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:362.1.text#ὅσας γενείου χεῖρας ἐξηκόντισα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:363.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:363.1.text#γονάτων τε τοῦ τεκόντος, ἐξαρτωμένη,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:364.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:364.1.text#λέγουσα τοιάδ'· ὦ πάτερ, νυμφεύομαι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:365.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:365.1.text#νυμφεύματ' αἰσχρὰ πρὸς σέθεν· μήτηρ δ' ἐμὲ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:366.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:366.1.text#σέθεν κατακτείνοντος Ἀργεῖαί τε νῦν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:367.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:367.1.text#ὑμνοῦσιν ὑμεναίοισιν, αὐλεῖται δὲ πᾶν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:368.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:368.1.text#μέλαθρον· ἡμεῖς δ' ὀλλύμεσθα πρὸς σέθεν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:369.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:369.1.text#Ἅιδης Ἀχιλλεὺς ἦν ἄρ', οὐχ ὁ Πηλέως,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:370.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:370.1.text#ὅν μοι προσείσας πόσιν, ἐν ἁρμάτων ὄχοις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:371.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:371.1.text#ἐς αἱματηρὸν γάμον ἐπόρθμευσας δόλῳ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:372.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:372.1.text#ἐγὼ δὲ λεπτῶν ὄμμα διὰ καλυμμάτων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:373.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:373.1.text#ἔχουσ', ἀδελφόν τ' οὐκ ἀνειλόμην χεροῖν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:374.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:374.1.text#— ὃς νῦν ὄλωλεν — οὐ κασιγνήτῃ στόμα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:375.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:375.1.text#συνῆψ' ὑπ' αἰδοῦς, ὡς ἰοῦσ' ἐς Πηλέως
urn:cts:greekLit:tlg0006.tlg013.fu-sp:376.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:376.1.text#μέλαθρα· πολλὰ δ' ἀπεθέμην ἀσπάσματα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:377.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:377.1.text#ἐς αὖθις, ὡς ἥξουσ' ἐς Ἄργος αὖ πάλιν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:378.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:378.1.text#ὦ τλῆμον, εἰ τέθνηκας, ἐξ οἵων καλῶν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:379.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:379.1.text#ἔρρεις, Ὀρέστα, καὶ πατρὸς ζηλωμάτων —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:380.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:380.1.text#τὰ τῆς θεοῦ δὲ μέμφομαι σοφίσματα,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:381.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:381.1.text#ἥτις βροτῶν μὲν ἤν τις ἅψηται φόνου,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:382.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:382.1.text#ἢ καὶ λοχείας ἢ νεκροῦ θίγῃ χεροῖν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:383.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:383.1.text#βωμῶν ἀπείργει, μυσαρὸν ὡς ἡγουμένη,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:384.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:384.1.text#αὐτὴ δὲ θυσίαις ἥδεται βροτοκτόνοις.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:385.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:385.1.text#οὐκ ἔσθ' ὅπως ἔτεκεν ἂν ἡ Διὸς δάμαρ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:386.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:386.1.text#Λητὼ τοσαύτην ἀμαθίαν. ἐγὼ μὲν οὖν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:387.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:387.1.text#τὰ Ταντάλου θεοῖσιν ἑστιάματα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:388.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:388.1.text#ἄπιστα κρίνω, παιδὸς ἡσθῆναι βορᾷ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:389.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:389.1.text#τοὺς δ' ἐνθάδ', αὐτοὺς ὄντας ἀνθρωποκτόνους,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:390.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:390.1.text#ἐς τὴν θεὸν τὸ φαῦλον ἀναφέρειν δοκῶ·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:391.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:391.1.text#οὐδένα γὰρ οἶμαι δαιμόνων εἶναι κακόν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:392.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:392.1.text#κυάνεαι κυάνεαι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:393.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:393.1.text#σύνοδοι θαλάσσας, ἵν' οἶστρος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:394.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:394.1.text#ὁ πετόμενος Ἀργόθεν ἄξενον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:395.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:395.1.text#ἐπ' οἶδμα διεπέρασεν —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:396.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:396.1.text#Ἀσιήτιδα γαῖαν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:397.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:397.1.text#Εὐρώπας διαμείψας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:399.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:399.1.text#τίνες ποτ' ἄρα τὸν εὔυδρον δονακόχλοα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:400.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:400.1.text#λιπόντες Εὐρώταν ἢ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:401.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:401.1.text#ῥεύματα σεμνὰ Δίρκας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:402.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:402.1.text#ἔβασαν ἔβασαν ἄμεικτον αἶαν, ἔνθα κούρᾳ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:403.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:403.1.text#δίᾳ τέγγει
urn:cts:greekLit:tlg0006.tlg013.fu-sp:405.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:405.1.text#βωμοὺς καὶ περικίονας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:406.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:406.1.text#ναοὺς αἷμα βρότειον;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:407.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:407.1.text#ἦ ῥοθίοις εἰλατίνας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:408.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:408.1.text#δικρότοισι κώπας ἔπλευσαν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:409.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:409.1.text#ἐπὶ πόντια κύματα, νάιον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:410.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:410.1.text#ὄχημα λινοπόροις αὔραις,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:411.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:411.1.text#φιλόπλουτον ἅμιλλαν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:412.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:412.1.text#αὔξοντες μελάθροισιν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:414.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:414.1.text#φίλα γὰρ ἐλπίς γ', ἐπί τε πήμασιν βροτῶν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:415.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:415.1.text#ἄπληστος ἀνθρώποις, ὄλβου
urn:cts:greekLit:tlg0006.tlg013.fu-sp:416.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:416.1.text#βάρος οἳ φέρονται
urn:cts:greekLit:tlg0006.tlg013.fu-sp:417.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:417.1.text#πλάνητες ἐπ' οἶδμα πόλεις τε βαρβάρους περῶντες,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:418.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:418.1.text#κοινᾷ δόξᾳ·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:419.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:419.1.text#γνώμα δ' οἷς μὲν ἄκαιρος ὄλβου,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:420.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:420.1.text#τοῖς δ' ἐς μέσον ἥκει.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:421.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:421.1.text#πῶς πέτρας τὰς συνδρομάδας,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:422.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:422.1.text#πῶς Φινεϊδᾶν ἀΰπνους
urn:cts:greekLit:tlg0006.tlg013.fu-sp:423.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:423.1.text#ἀκτὰς ἐπέρασαν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:424.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:424.1.text#παρ' ἅλιον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:425.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:425.1.text#αἰγιαλὸν ἐπ' Ἀμφιτρίτας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:426.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:426.1.text#ῥοθίῳ δραμόντες,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:427.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:427.1.text#ὅπου πεντήκοντα κορᾶν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:428.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:428.1.text#Νηρῄδων  [ … ] χοροὶ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:429.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:429.1.text#μέλπουσιν ἐγκύκλιοι,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:430.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:430.1.text#πλησιστίοισι πνοαῖς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:431.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:431.1.text#συριζόντων κατὰ πρύμναν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:432.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:432.1.text#εὐναίων πηδαλίων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:433.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:433.1.text#αὔραις { σὺν } νοτίαις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:434.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:434.1.text#ἢ πνεύμασι Ζεφύρου,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:435.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:435.1.text#τὰν πολυόρνιθον ἐπ' αἶαν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:436.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:436.1.text#λευκὰν ἀκτάν, Ἀχιλῆος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:437.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:437.1.text#δρόμους καλλισταδίους,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:438.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:438.1.text#ἄξεινον κατὰ πόντον;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:439.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:439.1.text#εἴθ' εὐχαῖσιν δεσποσύνοις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:439a.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:439a.1.text#Λήδας Ἑλένα φίλα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:440.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:440.1.text#παῖς ἐλθοῦσα τύχοι τὰν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:441.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:441.1.text#Τρῳάδα λιποῦσα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:442.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:442.1.text#πόλιν, ἵν' ἀμφὶ χαίτᾳ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:443.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:443.1.text#δρόσον αἱματηρὰν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:444.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:444.1.text#ἑλιχθεῖσα λαιμοτόμῳ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:445.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:445.1.text#δεσποίνας χειρὶ θάνοι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:446.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:446.1.text#ποινὰς δοῦσ' ἀντιπάλους.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:447.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:447.1.text#ἁδίσταν δ' ἀγγελίαν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:448.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:448.1.text#δεξαίμεσθ', Ἑλλάδος ἐκ γᾶς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:449.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:449.1.text#πλωτήρων εἴ τις ἔβα,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:450.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:450.1.text#δουλείας ἐμέθεν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:451.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:451.1.text#δειλαίας παυσίπονος·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:452.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:452.1.text#κἀν γὰρ ὀνείροισι συνείην
urn:cts:greekLit:tlg0006.tlg013.fu-sp:453.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:453.1.text#δόμοις πόλει τε πατρῴᾳ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:454.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:454.1.text#τερπνῶν ὕπνων ἀπόλαυσιν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:455.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:455.1.text#κοινὰν χάριν ὄλβου.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:456.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:456.1.text#ἀλλ' οἵδε χέρας δεσμοῖς δίδυμοι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:457.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:457.1.text#συνερεισθέντες χωροῦσι, νέον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:458.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:458.1.text#πρόσφαγμα θεᾶς· σιγᾶτε, φίλαι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:459.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:459.1.text#τὰ γὰρ Ἑλλήνων ἀκροθίνια δὴ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:460.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:460.1.text#ναοῖσι πέλας τάδε βαίνει·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:461.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:461.1.text#οὐδ' ἀγγελίας ψευδεῖς ἔλακεν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:462.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:462.1.text#βουφορβὸς ἀνήρ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:463.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:463.1.text#ὦ πότνι', εἴ σοι τάδ' ἀρεσκόντως
urn:cts:greekLit:tlg0006.tlg013.fu-sp:464.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:464.1.text#πόλις ἥδε τελεῖ, δέξαι θυσίας,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:465.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:465.1.text#ἃς ὁ παρ' ἡμῖν νόμος οὐχ ὁσίας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:466.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:466.1.text#[ Ἕλλησι διδοὺς ] ἀναφαίνει.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:467.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:467.1.text#εἶἑν·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:467.2.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:467.2.text#τὰ τῆς θεοῦ μὲν πρῶτον ὡς καλῶς ἔχῃ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:468.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:468.1.text#φροντιστέον μοι. μέθετε τῶν ξένων χέρας,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:469.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:469.1.text#ὡς ὄντες ἱεροὶ μηκέτ' ὦσι δέσμιοι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:470.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:470.1.text#ναοῦ δ' ἔσω στείχοντες εὐτρεπίζετε
urn:cts:greekLit:tlg0006.tlg013.fu-sp:471.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:471.1.text#ἃ χρὴ 'πὶ τοῖς παροῦσι καὶ νομίζεται.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:472.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:472.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:472.2.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:472.2.text#τίς ἆρα μήτηρ ἡ τεκοῦσ' ὑμᾶς ποτε
urn:cts:greekLit:tlg0006.tlg013.fu-sp:473.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:473.1.text#πατήρ τ'; ἀδελφή τ', εἰ γεγῶσα τυγχάνει —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:474.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:474.1.text#οἵων στερεῖσα διπτύχων νεανιῶν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:475.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:475.1.text#ἀνάδελφος ἔσται.  — τὰς τύχας τίς οἶδ' ὅτῳ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:476.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:476.1.text#τοιαίδ' ἔσονται; πάντα γὰρ τὰ τῶν θεῶν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:477.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:477.1.text#ἐς ἀφανὲς ἕρπει, κοὐδὲν οἶδ' οὐδεὶς κακὸν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:477.2.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:477.2.text#{ [ … ] }
urn:cts:greekLit:tlg0006.tlg013.fu-sp:478.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:478.1.text#ἡ γὰρ τύχη παρήγαγ' ἐς τὸ δυσμαθές.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:479.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:479.1.text#πόθεν ποθ' ἥκετ', ὦ ταλαίπωροι ξένοι;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:480.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:480.1.text#ὡς διὰ μακροῦ μὲν τήνδ' ἐπλεύσατε χθόνα,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:481.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:481.1.text#μακρὸν δ' ἀπ' οἴκων χρόνον ἔσεσθ' ἀεὶ κάτω.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:482.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:482.1.text#τί ταῦτ' ὀδύρῃ, κἀπὶ τοῖς μέλλουσι νῷν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:483.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:483.1.text#κακοῖσι λυπεῖς, ἥτις εἶ ποτ', ὦ γύναι;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:484.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:484.1.text#οὔτοι νομίζω σοφόν, ὃς ἂν μέλλων κτενεῖν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:485.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:485.1.text#οἴκτῳ τὸ δεῖμα τοὐλέθρου νικᾶν θέλῃ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:486.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:486.1.text#οὐχ ὅστις Ἅιδην ἐγγὺς ὄντ' οἰκτίζεται
urn:cts:greekLit:tlg0006.tlg013.fu-sp:487.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:487.1.text#σωτηρίας ἄνελπις· ὡς δύ' ἐξ ἑνὸς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:488.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:488.1.text#κακὼ συνάπτει, μωρίαν τ' ὀφλισκάνει
urn:cts:greekLit:tlg0006.tlg013.fu-sp:489.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:489.1.text#θνῄσκει θ' ὁμοίως· τὴν τύχην δ' ἐᾶν χρεών.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:490.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:490.1.text#ἡμᾶς δὲ μὴ θρήνει σύ· τὰς γὰρ ἐνθάδε
urn:cts:greekLit:tlg0006.tlg013.fu-sp:491.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:491.1.text#θυσίας ἐπιστάμεσθα καὶ γιγνώσκομεν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:492.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:492.1.text#πότερος ἄρ' ὑμῶν ἐνθάδ' ὠνομασμένος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:493.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:493.1.text#Πυλάδης κέκληται; τόδε μαθεῖν πρῶτον θέλω.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:494.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:494.1.text#ὅδ', εἴ τι δή σοι τοῦτ' ἐν ἡδονῇ μαθεῖν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:495.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:495.1.text#ποίας πολίτης πατρίδος Ἕλληνος γεγώς;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:496.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:496.1.text#τί δ' ἂν μαθοῦσα τόδε πλέον λάβοις, γύναι;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:497.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:497.1.text#πότερον ἀδελφὼ μητρός ἐστον ἐκ μιᾶς;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:498.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:498.1.text#φιλότητί γ'· ἐσμὲν δ' οὐ κασιγνήτω, γύναι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:499.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:499.1.text#σοὶ δ' ὄνομα ποῖον ἔθεθ' ὁ γεννήσας πατήρ;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:500.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:500.1.text#τὸ μὲν δίκαιον Δυστυχὴς καλοίμεθ' ἄν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:501.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:501.1.text#οὐ τοῦτ' ἐρωτῶ· τοῦτο μὲν δὸς τῇ τύχῃ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:502.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:502.1.text#ἀνώνυμοι θανόντες οὐ γελῴμεθ' ἄν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:503.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:503.1.text#τί δὲ φθονεῖς τοῦτο; ἦ φρονεῖς οὕτω μέγα;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:504.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:504.1.text#τὸ σῶμα θύσεις τοὐμόν, οὐχὶ τοὔνομα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:505.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:505.1.text#οὐδ' ἂν πόλιν φράσειας ἥτις ἐστί σοι;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:506.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:506.1.text#ζητεῖς γὰρ οὐδὲν κέρδος, ὡς θανουμένῳ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:507.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:507.1.text#χάριν δὲ δοῦναι τήνδε κωλύει τί σε;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:508.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:508.1.text#τὸ κλεινὸν Ἄργος πατρίδ' ἐμὴν ἐπεύχομαι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:509.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:509.1.text#πρὸς θεῶν, ἀληθῶς, ὦ ξέν', εἶ κεῖθεν γεγώς;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:510.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:510.1.text#ἐκ τῶν Μυκηνῶν { γ' }, αἵ ποτ' ἦσαν ὄλβιαι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:511.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:511.1.text#φυγὰς { δ' } ἀπῆρας πατρίδος, ἢ ποίᾳ τύχῃ;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:512.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:512.1.text#φεύγω τρόπον γε δή τιν' οὐχ ἑκὼν ἑκών.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:513.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:513.1.text#ἆρ' ἄν τί μοι φράσειας ὧν ἐγὼ θέλω;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:514.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:514.1.text#ὡς ἐν παρέργῳ τῆς ἐμῆς δυσπραξίας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:515.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:515.1.text#καὶ μὴν ποθεινός γ' ἦλθες ἐξ Ἄργους μολών.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:516.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:516.1.text#οὔκουν ἐμαυτῷ γ'· εἰ δὲ σοί, σὺ τοῦτ' ἔρα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:517.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:517.1.text#Τροίαν ἴσως οἶσθ', ἧς ἁπανταχοῦ λόγος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:518.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:518.1.text#ὡς μήποτ' ὤφελόν γε μηδ' ἰδὼν ὄναρ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:519.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:519.1.text#φασίν νιν οὐκέτ' οὖσαν οἴχεσθαι δορί.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:520.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:520.1.text#ἔστιν γὰρ οὕτως οὐδ' ἄκραντ' ἠκούσατε.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:521.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:521.1.text#Ἑλένη δ' ἀφῖκται δῶμα Μενέλεω πάλιν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:522.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:522.1.text#ἥκει, κακῶς γ' ἐλθοῦσα τῶν ἐμῶν τινι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:523.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:523.1.text#καὶ ποῦ 'στι; κἀμοὶ γάρ τι προυφείλει κακόν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:524.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:524.1.text#Σπάρτῃ ξυνοικεῖ τῷ πάρος ξυνευνέτῃ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:525.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:525.1.text#ὦ μῖσος εἰς Ἕλληνας, οὐκ ἐμοὶ μόνῃ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:526.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:526.1.text#ἀπέλαυσα κἀγὼ δή τι τῶν κείνης γάμων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:527.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:527.1.text#νόστος δ' Ἀχαιῶν ἐγένεθ', ὡς κηρύσσεται;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:528.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:528.1.text#ὡς πάνθ' ἅπαξ με συλλαβοῦσ' ἀνιστορεῖς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:529.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:529.1.text#πρὶν γὰρ θανεῖν σε, τοῦδ' ἐπαυρέσθαι θέλω.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:530.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:530.1.text#ἔλεγχ', ἐπειδὴ τοῦδ' ἐρᾷς· λέξω δ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:531.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:531.1.text#Κάλχας τις ἦλθε μάντις ἐκ Τροίας πάλιν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:532.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:532.1.text#ὄλωλεν, ὡς ἦν ἐν Μυκηναίοις λόγος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:533.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:533.1.text#ὦ πότνι', ὡς εὖ.  — τί γὰρ ὁ Λαέρτου γόνος;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:534.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:534.1.text#οὔπω νενόστηκ' οἶκον, ἔστι δ', ὡς λόγος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:535.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:535.1.text#ὄλοιτο, νόστου μήποτ' ἐς πάτραν τυχών.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:536.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:536.1.text#μηδὲν κατεύχου· πάντα τἀκείνου νοσεῖ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:537.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:537.1.text#Θέτιδος δ' ὁ τῆς Νηρῇδος ἔστι παῖς ἔτι;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:538.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:538.1.text#οὐκ ἔστιν· ἄλλως λέκτρ' ἔγημ' ἐν Αὐλίδι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:539.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:539.1.text#δόλια γάρ, ὡς ἴσασιν οἱ πεπονθότες.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:540.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:540.1.text#τίς εἶ ποθ'; ὡς εὖ πυνθάνῃ τἀφ' Ἑλλάδος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:541.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:541.1.text#ἐκεῖθέν εἰμι· παῖς ἔτ' οὖσ' ἀπωλόμην.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:542.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:542.1.text#ὀρθῶς ποθεῖς ἄρ' εἰδέναι τἀκεῖ, γύναι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:543.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:543.1.text#τί δ' ὁ στρατηγός, ὃν λέγουσ' εὐδαιμονεῖν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:544.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:544.1.text#τίς; οὐ γὰρ ὅν γ' ἐγᾦδα τῶν εὐδαιμόνων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:545.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:545.1.text#Ἀτρέως ἐλέγετο δή τις Ἀγαμέμνων ἄναξ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:546.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:546.1.text#οὐκ οἶδ'· ἄπελθε τοῦ λόγου τούτου, γύναι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:547.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:547.1.text#μὴ πρὸς θεῶν, ἀλλ' εἴφ', ἵν' εὐφρανθῶ, ξένε.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:548.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:548.1.text#τέθνηχ' ὁ τλήμων, πρὸς δ' ἀπώλεσέν τινα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:549.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:549.1.text#τέθνηκε; ποίᾳ συμφορᾷ; τάλαιν' ἐγώ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:550.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:550.1.text#τί δ' ἐστέναξας τοῦτο; μῶν προσῆκέ σοι;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:551.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:551.1.text#τὸν ὄλβον αὐτοῦ τὸν πάροιθ' ἀναστένω.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:552.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:552.1.text#δεινῶς γὰρ ἐκ γυναικὸς οἴχεται σφαγείς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:553.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:553.1.text#ὦ πανδάκρυτος ἡ κτανοῦσα  [ … ] χὡ κτανών.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:554.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:554.1.text#παῦσαί νυν ἤδη μηδ' ἐρωτήσῃς πέρα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:555.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:555.1.text#τοσόνδε γ', εἰ ζῇ τοῦ ταλαιπώρου δάμαρ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:556.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:556.1.text#οὐκ ἔστι· παῖς νιν ὃν ἔτεχ', οὗτος ὤλεσεν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:557.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:557.1.text#ὦ συνταραχθεὶς οἶκος. ὡς τί δὴ θέλων;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:558.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:558.1.text#πατρὸς θανόντος τήνδε τιμωρούμενος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:559.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:559.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:559.2.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:559.2.text#ὡς εὖ κακὸν δίκαιον εἰσεπράξατο.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:560.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:560.1.text#ἀλλ' οὐ τὰ πρὸς θεῶν εὐτυχεῖ δίκαιος ὤν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:561.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:561.1.text#λείπει δ' ἐν οἴκοις ἄλλον Ἀγαμέμνων γόνον;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:562.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:562.1.text#λέλοιπεν Ἠλέκτραν γε παρθένον μίαν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:563.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:563.1.text#τί δέ; σφαγείσης θυγατρὸς ἔστι τις λόγος;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:564.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:564.1.text#οὐδείς γε, πλὴν θανοῦσαν οὐχ ὁρᾶν φάος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:565.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:565.1.text#τάλαιν' ἐκείνη χὡ κτανὼν αὐτὴν πατήρ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:566.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:566.1.text#κακῆς γυναικὸς χάριν ἄχαριν ἀπώλετο.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:567.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:567.1.text#ὁ τοῦ θανόντος δ' ἔστι παῖς Ἄργει πατρός;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:568.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:568.1.text#ἔστ', ἄθλιός γε, κοὐδαμοῦ καὶ πανταχοῦ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:569.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:569.1.text#ψευδεῖς ὄνειροι, χαίρετ'· οὐδὲν ἦτ' ἄρα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:570.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:570.1.text#οὐδ' οἱ σοφοί γε δαίμονες κεκλημένοι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:571.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:571.1.text#πτηνῶν ὀνείρων εἰσὶν ἀψευδέστεροι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:572.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:572.1.text#πολὺς ταραγμὸς ἔν τε τοῖς θείοις ἔνι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:573.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:573.1.text#κἀν τοῖς βροτείοις· ἓν δὲ λυπεῖται μόνον,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:574.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:574.1.text#ὃς οὐκ ἄφρων ὢν μάντεων πεισθεὶς λόγοις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:575.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:575.1.text#ὄλωλεν — ὡς ὄλωλε τοῖσιν εἰδόσιν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:576.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:576.1.text#φεῦ φεῦ· τί δ' ἡμεῖς οἵ τ' ἐμοὶ γεννήτορες;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:577.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:577.1.text#ἆρ' εἰσίν; ἆρ' οὐκ εἰσί; τίς φράσειεν ἄν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:578.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:578.1.text#ἀκούσατ'· ἐς γὰρ δή τιν' ἥκομεν λόγον,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:579.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:579.1.text#ὑμῖν τ' ὄνησιν, ὦ ξένοι, σπουδῆς ἅμα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:580.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:580.1.text#κἀμοί. τὸ δ' εὖ μάλιστά γ' οὕτω γίγνεται,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:581.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:581.1.text#εἰ πᾶσι ταὐτὸν πρᾶγμ' ἀρεσκόντως ἔχει.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:582.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:582.1.text#θέλοις ἄν, εἰ σῴσαιμί σ', ἀγγεῖλαί τί μοι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:583.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:583.1.text#πρὸς Ἄργος ἐλθὼν τοῖς ἐμοῖς ἐκεῖ φίλοις,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:584.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:584.1.text#δέλτον τ' ἐνεγκεῖν, ἥν τις οἰκτίρας ἐμὲ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:585.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:585.1.text#ἔγραψεν αἰχμάλωτος, οὐχὶ τὴν ἐμὴν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:586.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:586.1.text#φονέα νομίζων χεῖρα, τοῦ νόμου δ' ὕπο
urn:cts:greekLit:tlg0006.tlg013.fu-sp:587.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:587.1.text#θνῄσκειν τὰ τῆς θεοῦ, τάδε δίκαι' ἡγουμένης;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:588.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:588.1.text#οὐδένα γὰρ εἶχον ὅστις ἀγγείλαι μολὼν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:589.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:589.1.text#ἐς Ἄργος αὖθις, τάς { τ' } ἐμὰς ἐπιστολὰς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:590.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:590.1.text#πέμψειε σωθεὶς τῶν ἐμῶν φίλων τινί.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:591.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:591.1.text#σὺ δ' — εἶ γάρ, ὡς ἔοικας, οὔτε δυσμενὴς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:592.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:592.1.text#καὶ τὰς Μυκήνας οἶσθα χοὓς κἀγὼ θέλω —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:593.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:593.1.text#σώθητι, καὶ σὺ μισθὸν οὐκ αἰσχρὸν λαβών,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:594.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:594.1.text#κούφων ἕκατι γραμμάτων σωτηρίαν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:595.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:595.1.text#οὗτος δ', ἐπείπερ πόλις ἀναγκάζει τάδε,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:596.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:596.1.text#θεᾷ γενέσθω θῦμα χωρισθεὶς σέθεν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:597.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:597.1.text#καλῶς ἔλεξας τἄλλα πλὴν ἕν, ὦ ξένη·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:598.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:598.1.text#τὸ γὰρ σφαγῆναι τόνδε μοι βάρος μέγα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:599.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:599.1.text#ὁ ναυστολῶν γάρ εἰμ' ἐγὼ τὰς συμφοράς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:600.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:600.1.text#οὗτος δὲ συμπλεῖ τῶν ἐμῶν μόχθων χάριν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:601.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:601.1.text#οὔκουν δίκαιον ἐπ' ὀλέθρῳ τῷ τοῦδ' ἐμὲ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:602.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:602.1.text#χάριν τίθεσθαι καὐτὸν ἐκδῦναι κακῶν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:603.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:603.1.text#ἀλλ' ὣς γενέσθω· τῷδε μὲν δέλτον δίδου·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:604.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:604.1.text#πέμψει γὰρ Ἄργος, ὥστε σοι καλῶς ἔχειν·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:605.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:605.1.text#ἡμᾶς δ' ὁ χρῄζων κτεινέτω. τὰ τῶν φίλων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:606.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:606.1.text#αἴσχιστον ὅστις καταβαλὼν ἐς ξυμφορὰς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:607.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:607.1.text#αὐτὸς σέσῳσται. τυγχάνει δ' ὅδ' ὢν φίλος,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:608.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:608.1.text#ὃν οὐδὲν ἧσσον ἢ 'μὲ φῶς ὁρᾶν θέλω.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:609.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:609.1.text#ὦ λῆμ' ἄριστον, ὡς ἀπ' εὐγενοῦς τινος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:610.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:610.1.text#ῥίζης πέφυκας τοῖς φίλοις τ' ὀρθῶς φίλος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:611.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:611.1.text#τοιοῦτος εἴη τῶν ἐμῶν ὁμοσπόρων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:612.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:612.1.text#ὅσπερ λέλειπται. καὶ γὰρ οὐδ' ἐγώ, ξένοι,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:613.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:613.1.text#ἀνάδελφός εἰμι, πλὴν ὅσ' οὐχ ὁρῶσά νιν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:614.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:614.1.text#ἐπεὶ δὲ βούλῃ ταῦτα, τόνδε πέμψομεν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:615.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:615.1.text#δέλτον φέροντα, σὺ δὲ θανῇ· πολλὴ δέ τις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:616.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:616.1.text#προθυμία σε τοῦδ' ἔχουσα τυγχάνει.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:617.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:617.1.text#θύσει δὲ τίς με καὶ τὰ δεινὰ τλήσεται;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:618.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:618.1.text#ἐγώ· θεᾶς γὰρ τῆσδε προστροπὴν ἔχω.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:619.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:619.1.text#ἄζηλά γ', ὦ νεᾶνι, κοὐκ εὐδαίμονα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:620.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:620.1.text#ἀλλ' εἰς ἀνάγκην κείμεθ', ἣν φυλακτέον.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:621.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:621.1.text#αὐτὴ ξίφει θύουσα θῆλυς ἄρσενας;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:622.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:622.1.text#οὔκ, ἀλλὰ χαίτην ἀμφὶ σὴν χερνίψομαι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:623.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:623.1.text#ὁ δὲ σφαγεὺς τίς; εἰ τάδ' ἱστορεῖν με χρή.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:624.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:624.1.text#ἔσω δόμων τῶνδ' εἰσὶν οἷς μέλει τάδε.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:625.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:625.1.text#τάφος δὲ ποῖος δέξεταί μ', ὅταν θάνω;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:626.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:626.1.text#πῦρ ἱερὸν ἔνδον χάσμα τ' εὐρωπὸν πέτρας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:627.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:627.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:627.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:627.2.text#πῶς ἄν μ' ἀδελφῆς χεὶρ περιστείλειεν ἄν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:628.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:628.1.text#μάταιον εὐχήν, ὦ τάλας, ὅστις ποτ' εἶ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:629.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:629.1.text#ηὔξω· μακρὰν γὰρ βαρβάρου ναίει χθονός.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:630.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:630.1.text#οὐ μήν, ἐπειδὴ τυγχάνεις Ἀργεῖος ὤν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:631.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:631.1.text#ἀλλ' ὧν γε δυνατὸν οὐδ' ἐγὼ λείψω χάριν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:632.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:632.1.text#πολύν τε γάρ σοι κόσμον ἐνθήσω τάφῳ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:633.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:633.1.text#ξανθῷ τ' ἐλαίῳ σῶμα σὸν κατασβέσω,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:634.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:634.1.text#καὶ τῆς ὀρείας ἀνθεμόρρυτον γάνος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:635.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:635.1.text#ξουθῆς μελίσσης ἐς πυρὰν βαλῶ σέθεν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:636.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:636.1.text#ἀλλ' εἶμι δέλτον τ' ἐκ θεᾶς ἀνακτόρων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:637.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:637.1.text#οἴσω· τὸ μέντοι δυσμενὲς μὴ 'μοὶ λάβῃς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:638.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:638.1.text#φυλάσσετ' αὐτούς, πρόσπολοι, δεσμῶν ἄτερ —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:639.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:639.1.text#ἴσως ἄελπτα τῶν ἐμῶν φίλων τινὶ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:640.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:640.1.text#πέμψω πρὸς Ἄργος, ὃν μάλιστ' ἐγὼ φιλῶ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:641.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:641.1.text#καὶ δέλτος αὐτῷ ζῶντας οὓς δοκεῖ θανεῖν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:642.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:642.1.text#λέγουσα πιστὰς ἡδονὰς ἀπαγγελεῖ.[ … ]
urn:cts:greekLit:tlg0006.tlg013.fu-sp:644.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:644.1.text#κατολοφύρομαι σὲ τὸν χερνίβων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:645.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:645.1.text#ῥανίσι μελόμενον αἱμακταῖς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:646.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:646.1.text#οἶκτος γὰρ οὐ ταῦτ', ἀλλὰ χαίρετ', ὦ ξέναι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:647.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:647.1.text#σὲ δὲ τύχας μάκαρος, ὦ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:648.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:648.1.text#νεανία, σεβόμεθ', ἐς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:649.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:649.1.text#πάτραν ὅτι ποτ' ἐπεμβάσῃ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:650.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:650.1.text#ἄζηλά τοι φίλοισι, θνῃσκόντων φίλων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:651.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:651.1.text#ὦ σχέτλιοι πομπαί.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:652.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:652.1.text#φεῦ φεῦ, διόλλυσαι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:653.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:653.1.text#αἰαῖ αἰαῖ. πότερος ὁ μᾶλλον;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:655.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:655.1.text#ἔτι γὰρ ἀμφίλογα δίδυμα μέμονε φρήν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:656.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:656.1.text#σὲ πάρος ἢ σὲ ἀναστενάξω γόοις.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:658.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:658.1.text#Πυλάδη, πέπονθας ταὐτὸ πρὸς θεῶν ἐμοί;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:659.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:659.1.text#οὐκ οἶδ'· ἐρωτᾷς οὐ λέγειν ἔχοντά με.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:660.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:660.1.text#τίς ἐστὶν ἡ νεᾶνις; ὡς Ἑλληνικῶς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:661.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:661.1.text#ἀνήρεθ' ἡμᾶς τούς τ' ἐν Ἰλίῳ πόνους
urn:cts:greekLit:tlg0006.tlg013.fu-sp:662.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:662.1.text#νόστον τ' Ἀχαιῶν τόν τ' ἐν οἰωνοῖς σοφὸν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:663.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:663.1.text#Κάλχαντ' Ἀχιλλέως τ' ὄνομα, καὶ τὸν ἄθλιον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:664.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:664.1.text#Ἀγαμέμνον' ὡς ᾤκτιρ' ἀνηρώτα τέ με
urn:cts:greekLit:tlg0006.tlg013.fu-sp:665.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:665.1.text#γυναῖκα παῖδάς τε. ἔστιν ἡ ξένη γένος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:666.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:666.1.text#ἐκεῖθεν Ἀργεία τις· οὐ γὰρ ἄν ποτε
urn:cts:greekLit:tlg0006.tlg013.fu-sp:667.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:667.1.text#δέλτον τ' ἔπεμπε καὶ τάδ' ἐξεμάνθανεν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:668.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:668.1.text#ὡς κοινὰ πράσσουσ', Ἄργος εἰ πράσσει καλῶς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:669.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:669.1.text#ἔφθης με μικρόν· ταὐτὰ δὲ φθάσας λέγεις,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:670.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:670.1.text#πλὴν ἕν· τὰ γὰρ τῶν βασιλέων παθήματα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:671.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:671.1.text#ἴσασι πάντες, ὧν ἐπιστροφή τις ἦν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:672.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:672.1.text#ἀτὰρ διῆλθον χἅτερον λόγον τινά.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:673.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:673.1.text#τίν'; ἐς τὸ κοινὸν δοὺς ἄμεινον ἂν μάθοις.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:674.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:674.1.text#αἰσχρὸν θανόντος σοῦ βλέπειν ἡμᾶς φάος·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:675.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:675.1.text#κοινῇ τ' ἔπλευσα  [ … ] δεῖ με καὶ κοινῇ θανεῖν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:676.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:676.1.text#καὶ δειλίαν γὰρ καὶ κάκην κεκτήσομαι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:677.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:677.1.text#Ἄργει τε Φωκέων τ' ἐν πολυπτύχῳ χθονί,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:678.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:678.1.text#δόξω δὲ τοῖς πολλοῖσι — πολλοὶ γὰρ κακοί —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:679.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:679.1.text#προδοὺς σεσῷσθαί σ' αὐτὸς εἰς οἴκους μόνος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:680.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:680.1.text#ἢ καὶ φονεύσας ἐπὶ νοσοῦσι δώμασι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:681.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:681.1.text#ῥάψαι μόρον σοι σῆς τυραννίδος χάριν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:682.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:682.1.text#ἔγκληρον ὡς δὴ σὴν κασιγνήτην γαμῶν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:683.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:683.1.text#ταῦτ' οὖν φοβοῦμαι καὶ δι' αἰσχύνης ἔχω,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:684.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:684.1.text#κοὐκ ἔσθ' ὅπως οὐ χρὴ συνεκπνεῦσαί μέ σοι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:685.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:685.1.text#καὶ σὺν σφαγῆναι καὶ πυρωθῆναι δέμας,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:686.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:686.1.text#φίλον γεγῶτα καὶ φοβούμενον ψόγον.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:687.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:687.1.text#εὔφημα φώνει· τἀμὰ δεῖ φέρειν κακά,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:688.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:688.1.text#ἁπλᾶς δὲ λύπας ἐξόν, οὐκ οἴσω διπλᾶς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:689.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:689.1.text#ὃ γὰρ σὺ λυπρὸν κἀπονείδιστον λέγεις,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:690.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:690.1.text#ταὔτ' ἔστιν ἡμῖν, εἴ σε συμμοχθοῦντ' ἐμοὶ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:691.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:691.1.text#κτενῶ· τὸ μὲν γὰρ εἰς ἔμ' οὐ κακῶς ἔχει,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:692.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:692.1.text#πράσσονθ' ἃ πράσσω πρὸς θεῶν, λῦσαι βίον.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:693.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:693.1.text#σὺ δ' ὄλβιός τ' εἶ, καθαρά τ', οὐ νοσοῦντ', ἔχεις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:694.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:694.1.text#μέλαθρ', ἐγὼ δὲ δυσσεβῆ καὶ δυστυχῆ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:695.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:695.1.text#σωθεὶς δέ, παῖδας ἐξ ἐμῆς ὁμοσπόρου
urn:cts:greekLit:tlg0006.tlg013.fu-sp:696.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:696.1.text#κτησάμενος, ἣν ἔδωκά σοι δάμαρτ' ἔχειν —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:697.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:697.1.text#ὄνομά τ' ἐμοῦ γένοιτ' ἄν, οὐδ' ἄπαις δόμος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:698.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:698.1.text#πατρῷος οὑμὸς ἐξαλειφθείη ποτ' ἄν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:699.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:699.1.text#ἀλλ' ἕρπε καὶ ζῆ καὶ δόμους οἴκει πατρός.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:700.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:700.1.text#ὅταν δ' ἐς Ἑλλάδ' ἵππιόν τ' Ἄργος μόλῃς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:701.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:701.1.text#πρὸς δεξιᾶς σε τῆσδ' ἐπισκήπτω τάδε·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:702.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:702.1.text#τύμβον τε χῶσον κἀπίθες μνημεῖά μοι,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:703.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:703.1.text#καὶ δάκρυ' ἀδελφὴ καὶ κόμας δότω τάφῳ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:704.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:704.1.text#ἄγγελλε δ' ὡς ὄλωλ' ὑπ' Ἀργείας τινὸς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:705.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:705.1.text#γυναικός, ἀμφὶ βωμὸν ἁγνισθεὶς φόνῳ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:706.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:706.1.text#καὶ μὴ προδῷς μου τὴν κασιγνήτην ποτέ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:707.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:707.1.text#ἔρημα κήδη καὶ δόμους ὁρῶν πατρός.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:708.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:708.1.text#καὶ χαῖρ'· ἐμῶν γὰρ φίλτατόν σ' ηὗρον φίλων,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:709.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:709.1.text#ὦ συγκυναγὲ καὶ συνεκτραφεὶς ἐμοί,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:710.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:710.1.text#ὦ πόλλ' ἐνεγκὼν τῶν ἐμῶν ἄχθη κακῶν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:711.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:711.1.text#ἡμᾶς δ' ὁ Φοῖβος μάντις ὢν ἐψεύσατο·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:712.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:712.1.text#τέχνην δὲ θέμενος ὡς προσώταθ' Ἑλλάδος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:713.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:713.1.text#ἀπήλασ', αἰδοῖ τῶν πάρος μαντευμάτων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:714.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:714.1.text#ᾧ πάντ' ἐγὼ δοὺς τἀμὰ καὶ πεισθεὶς λόγοις,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:715.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:715.1.text#μητέρα κατακτὰς αὐτὸς ἀνταπόλλυμαι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:716.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:716.1.text#ἔσται τάφος σοι, καὶ κασιγνήτης λέχος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:717.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:717.1.text#οὐκ ἂν προδοίην, ὦ τάλας, ἐπεί σ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:718.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:718.1.text#θανόντα μᾶλλον ἢ βλέπονθ' ἕξω φίλον.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:719.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:719.1.text#ἀτὰρ τὸ τοῦ θεοῦ σ' οὐ διέφθορέν γέ πω
urn:cts:greekLit:tlg0006.tlg013.fu-sp:720.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:720.1.text#μάντευμα· καίτοι γ' ἐγγὺς ἕστηκας φόνου.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:721.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:721.1.text#ἀλλ' ἔστιν, ἔστιν, ἡ λίαν δυσπραξία
urn:cts:greekLit:tlg0006.tlg013.fu-sp:722.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:722.1.text#λίαν διδοῦσα μεταβολάς, ὅταν τύχῃ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:723.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:723.1.text#σίγα· τὰ Φοίβου δ' οὐδὲν ὠφελεῖ μ' ἔπη·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:724.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:724.1.text#γυνὴ γὰρ ἥδε δωμάτων ἔξω περᾷ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:725.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:725.1.text#ἀπέλθεθ' ὑμεῖς καὶ παρευτρεπίζετε
urn:cts:greekLit:tlg0006.tlg013.fu-sp:726.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:726.1.text#τἄνδον μολόντες τοῖς ἐφεστῶσι σφαγῇ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:727.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:727.1.text#δέλτου μὲν αἵδε πολύθυροι διαπτυχαί,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:728.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:728.1.text#ξένοι, πάρεισιν· ἃ δ' ἐπὶ τοῖσδε βούλομαι,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:729.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:729.1.text#ἀκούσατ'. οὐδεὶς αὑτὸς ἐν πόνοις { τ' } ἀνὴρ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:730.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:730.1.text#ὅταν τε πρὸς τὸ θάρσος ἐκ φόβου πέσῃ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:731.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:731.1.text#ἐγὼ δὲ ταρβῶ μὴ ἀπονοστήσας χθονὸς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:732.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:732.1.text#θῆται παρ' οὐδὲν τὰς ἐμὰς ἐπιστολὰς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:733.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:733.1.text#ὁ τήνδε μέλλων δέλτον εἰς Ἄργος φέρειν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:734.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:734.1.text#τί δῆτα βούλῃ; τίνος ἀμηχανεῖς πέρι;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:735.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:735.1.text#ὅρκον δότω μοι τάσδε πορθμεύσειν γραφὰς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:736.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:736.1.text#πρὸς Ἄργος, οἷσι βούλομαι πέμψαι φίλων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:737.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:737.1.text#ἦ κἀντιδώσεις τῷδε τοὺς αὐτοὺς λόγους;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:738.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:738.1.text#τί χρῆμα δράσειν ἢ τί μὴ δράσειν; λέγε.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:739.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:739.1.text#ἐκ γῆς ἀφήσειν μὴ θανόντα βαρβάρου.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:740.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:740.1.text#δίκαιον εἶπας· πῶς γὰρ ἀγγείλειεν ἄν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:741.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:741.1.text#ἦ καὶ τύραννος ταῦτα συγχωρήσεται;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:742.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:742.1.text#ναί.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:742.2.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:742.2.text#πείσω σφε, καὐτὴ ναὸς εἰσβήσω σκάφος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:743.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:743.1.text#ὄμνυ· σὺ δ' ἔξαρχ' ὅρκον ὅστις εὐσεβής.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:744.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:744.1.text#δώσω, λέγειν χρή, τήνδε τοῖσι σοῖς φίλοις.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:745.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:745.1.text#τοῖς σοῖς φίλοισι γράμματ' ἀποδώσω τάδε.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:746.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:746.1.text#κἀγὼ σὲ σώσω κυανέας ἔξω πέτρας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:747.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:747.1.text#τίν' οὖν ἐπόμνυς τοισίδ' ὅρκιον θεῶν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:748.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:748.1.text#Ἄρτεμιν, ἐν ἧσπερ δώμασιν τιμὰς ἔχω.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:749.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:749.1.text#ἐγὼ δ' ἄνακτά γ' οὐρανοῦ, σεμνὸν Δία.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:750.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:750.1.text#εἰ δ' ἐκλιπὼν τὸν ὅρκον ἀδικοίης ἐμέ;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:751.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:751.1.text#ἄνοστος εἴην· τί δὲ σύ, μὴ σῴσασά με;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:752.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:752.1.text#μήποτε κατ' Ἄργος ζῶσ' ἴχνος θείην ποδός.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:753.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:753.1.text#ἄκουε δή νυν ὃν παρήλθομεν λόγον.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:754.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:754.1.text#ἀλλ' αὖθις ἔσται καινός, ἢν καλῶς ἔχῃ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:755.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:755.1.text#ἐξαίρετόν μοι δὸς τόδ', ἤν τι ναῦς πάθῃ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:756.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:756.1.text#χἡ δέλτος ἐν κλύδωνι χρημάτων μέτα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:757.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:757.1.text#ἀφανὴς γένηται, σῶμα δ' ἐκσῴσω μόνον,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:758.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:758.1.text#τὸν ὅρκον εἶναι τόνδε μηκέτ' ἔμπεδον.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:759.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:759.1.text#ἀλλ' οἶσθ' ὃ δράσω; πολλὰ γὰρ πολλῶν κυρεῖ·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:760.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:760.1.text#τἀνόντα κἀγγεγραμμέν' ἐν δέλτου πτυχαῖς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:761.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:761.1.text#λόγῳ φράσω σοι πάντ' ἀναγγεῖλαι φίλοις.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:762.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:762.1.text#ἐν ἀσφαλεῖ γάρ· ἢν μὲν ἐκσῴσῃς γραφήν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:763.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:763.1.text#αὐτὴν φράσει σιγῶσα τἀγγεγραμμένα·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:764.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:764.1.text#ἢν δ' ἐν θαλάσσῃ γράμματ' ἀφανισθῇ τάδε,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:765.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:765.1.text#τὸ σῶμα σῴσας τοὺς λόγους σῴσεις ἐμοί.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:766.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:766.1.text#καλῶς ἔλεξας τῶν θεῶν ἐμοῦ θ' ὕπερ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:767.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:767.1.text#σήμαινε δ' ᾧ χρὴ τάσδ' ἐπιστολὰς φέρειν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:768.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:768.1.text#πρὸς Ἄργος ὅ τι τε χρὴ κλύοντα σοῦ λέγειν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:769.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:769.1.text#ἄγγελλ' Ὀρέστῃ, παιδὶ τῷ Ἀγαμέμνονος·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:770.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:770.1.text#Ἡ 'ν Αὐλίδι σφαγεῖσ' ἐπιστέλλει τάδε
urn:cts:greekLit:tlg0006.tlg013.fu-sp:771.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:771.1.text#ζῶσ' Ἰφιγένεια, τοῖς ἐκεῖ δ' οὐ ζῶσ' ἔτι —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:772.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:772.1.text#ποῦ δ' ἔστ' ἐκείνη; κατθανοῦσ' ἥκει πάλιν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:773.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:773.1.text#ἥδ' ἣν ὁρᾷς σύ· μὴ λόγοις ἔκπλησσέ με.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:774.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:774.1.text#Κόμισαί μ' ἐς Ἄργος, ὦ σύναιμε, πρὶν θανεῖν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:775.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:775.1.text#ἐκ βαρβάρου γῆς καὶ μετάστησον θεᾶς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:776.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:776.1.text#σφαγίων, ἐφ' οἷσι ξενοφόνους τιμὰς ἔχω.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:777.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:777.1.text#Πυλάδη, τί λέξω; ποῦ ποτ' ὄνθ' ηὑρήμεθα;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:778.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:778.1.text#ἢ σοῖς ἀραία δώμασιν γενήσομαι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:779.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:779.1.text#Ὀρέστα — ;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:779.2.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:779.2.text#ἵν' αὖθις ὄνομα δὶς κλύων μάθῃς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:780.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:780.1.text#ὦ θεοί.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:780.2.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:780.2.text#τί τοὺς θεοὺς ἀνακαλεῖς ἐν τοῖς ἐμοῖς;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:781.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:781.1.text#οὐδέν· πέραινε δ'· ἐξέβην γὰρ ἄλλοσε.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:782.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:782.1.text#τάχ' οὐκ ἐρωτῶν σ' εἰς ἄπιστ' ἀφίξομαι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:783.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:783.1.text#λέγ' οὕνεκ' ἔλαφον ἀντιδοῦσά μου θεὰ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:784.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:784.1.text#Ἄρτεμις ἔσῳσέ μ', ἣν ἔθυσ' ἐμὸς πατήρ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:785.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:785.1.text#δοκῶν ἐς ἡμᾶς ὀξὺ φάσγανον βαλεῖν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:786.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:786.1.text#ἐς τήνδε δ' ᾤκισ' αἶαν. αἵδ' ἐπιστολαί,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:787.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:787.1.text#τάδ' ἐστὶ τἀν δέλτοισιν ἐγγεγραμμένα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:788.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:788.1.text#ὦ ῥᾳδίοις ὅρκοισι περιβαλοῦσά με,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:789.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:789.1.text#κάλλιστα δ' ὀμόσασ', οὐ πολὺν σχήσω χρόνον,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:790.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:790.1.text#τὸν δ' ὅρκον ὃν κατώμοσ' ἐμπεδώσομεν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:791.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:791.1.text#ἰδού, φέρω σοι δέλτον ἀποδίδωμί τε,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:792.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:792.1.text#Ὀρέστα, τῆσδε σῆς κασιγνήτης πάρα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:793.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:793.1.text#δέχομαι· παρεὶς δὲ γραμμάτων διαπτυχὰς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:794.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:794.1.text#τὴν ἡδονὴν πρῶτ' οὐ λόγοις αἱρήσομαι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:795.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:795.1.text#ὦ φιλτάτη μοι σύγγον', ἐκπεπληγμένος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:796.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:796.1.text#ὅμως σ' ἀπίστῳ περιβαλὼν βραχίονι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:797.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:797.1.text#ἐς τέρψιν εἶμι, πυθόμενος θαυμάστ' ἐμοί.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:798.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:798.1.text#ξέν', οὐ δικαίως τῆς θεοῦ τὴν πρόσπολον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:799.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:799.1.text#χραίνεις ἀθίκτοις περιβαλὼν πέπλοις χέρα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:800.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:800.1.text#ὦ συγκασιγνήτη τε κἀκ ταὐτοῦ πατρὸς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:801.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:801.1.text#Ἀγαμέμνονος γεγῶσα, μή μ' ἀποστρέφου,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:802.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:802.1.text#ἔχουσ' ἀδελφόν, οὐ δοκοῦσ' ἕξειν ποτέ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:803.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:803.1.text#ἐγώ σ' ἀδελφὸν τὸν ἐμόν; οὐ παύσῃ λέγων;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:804.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:804.1.text#τὸ δ' Ἄργος αὐτοῦ μεστὸν ἥ τε Ναυπλία.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:805.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:805.1.text#οὐκ ἔστ' ἐκεῖ σός, ὦ τάλαινα, σύγγονος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:806.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:806.1.text#ἀλλ' ἡ Λάκαινα Τυνδαρίς σ' ἐγείνατο;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:807.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:807.1.text#Πέλοπός γε παιδὶ παιδός, οὗ 'κπέφυκ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:808.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:808.1.text#τί φῄς; ἔχεις τι τῶνδέ μοι τεκμήριον;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:809.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:809.1.text#ἔχω· πατρῴων ἐκ δόμων τι πυνθάνου.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:810.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:810.1.text#οὐκοῦν λέγειν μὲν χρὴ σέ, μανθάνειν δ' ἐμέ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:811.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:811.1.text#λέγοιμ' ἄν, ἀκοῇ πρῶτον Ἠλέκτρας τάδε·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:812.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:812.1.text#Ἀτρέως Θυέστου τ' οἶσθα γενομένην ἔριν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:813.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:813.1.text#ἤκουσα· χρυσῆς ἀρνὸς ἦν νείκη πέρι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:814.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:814.1.text#ταῦτ' οὖν ὑφήνασ' οἶσθ' ἐν εὐπήνοις ὑφαῖς;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:815.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:815.1.text#ὦ φίλτατ', ἐγγὺς τῶν ἐμῶν κάμπτεις φρενῶν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:816.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:816.1.text#εἰκώ τ' ἐν ἱστοῖς ἡλίου μετάστασιν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:817.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:817.1.text#ὕφηνα καὶ τόδ' εἶδος εὐμίτοις πλοκαῖς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:818.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:818.1.text#καὶ λούτρ' ἐς Αὖλιν μητρὸς ἀνεδέξω πάρα;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:819.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:819.1.text#οἶδ'· οὐ γὰρ ὁ γάμος ἐσθλὸς ὤν μ' ἀφείλετο.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:820.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:820.1.text#τί γάρ; κόμας σὰς μητρὶ δοῦσα σῇ φέρειν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:821.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:821.1.text#μνημεῖά γ' ἀντὶ σώματος τοὐμοῦ τάφῳ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:822.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:822.1.text#ἃ δ' εἶδον αὐτός, τάδε φράσω τεκμήρια·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:823.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:823.1.text#Πέλοπος παλαιὰν ἐν δόμοις λόγχην πατρός,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:824.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:824.1.text#ἣν χερσὶ πάλλων παρθένον Πισάτιδα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:825.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:825.1.text#ἐκτήσαθ' Ἱπποδάμειαν, Οἰνόμαον κτανών,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:826.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:826.1.text#ἐν παρθενῶσι τοῖσι σοῖς κεκρυμμένην.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:827.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:827.1.text#ὦ φίλτατ', οὐδὲν ἄλλο, φίλτατος γὰρ εἶ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:828.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:828.1.text#ἔχω σ', Ὀρέστα, τηλύγετον [ χθονὸς ] ἀπὸ πατρίδος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:830.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:830.1.text#Ἀργόθεν, ὦ φίλος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:831.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:831.1.text#κἀγώ σε τὴν θανοῦσαν, ὡς δοξάζεται.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:832.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:832.1.text#κατὰ δὲ δάκρυ, κατὰ δὲ γόος ἅμα χαρᾷ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:833.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:833.1.text#τὸ σὸν νοτίζει βλέφαρον, ὡσαύτως δ' ἐμόν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:834.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:834.1.text#τόδ' ἔτι βρέφος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:835.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:835.1.text#ἔλιπον ἀγκάλαισι νεαρὸν τροφοῦ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:836.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:836.1.text#νεαρὸν ἐν δόμοις.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:837.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:837.1.text#ὦ κρεῖσσον ἢ λόγοισιν εὐτυχοῦσά μου
urn:cts:greekLit:tlg0006.tlg013.fu-sp:839.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:839.1.text#ψυχά, τί φῶ; θαυμάτων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:840.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:840.1.text#πέρα καὶ λόγου πρόσω τάδ' ἐπέβα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:841.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:841.1.text#τὸ λοιπὸν εὐτυχοῖμεν ἀλλήλων μέτα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:842.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:842.1.text#ἄτοπον ἁδονὰν ἔλαβον, ὦ φίλαι·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:843.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:843.1.text#δέδοικα δ' ἐκ χερῶν με μὴ πρὸς αἰθέρα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:844.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:844.1.text#ἀμπτάμενος φύγῃ·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:845.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:845.1.text#ἰὼ Κυκλωπὶς ἑστία· ἰὼ πατρίς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:846.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:846.1.text#Μυκήνα φίλα,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:847.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:847.1.text#χάριν ἔχω ζόας, χάριν ἔχω τροφᾶς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:848.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:848.1.text#ὅτι μοι συνομαίμονα τόνδε δόμοις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:849.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:849.1.text#ἐξεθρέψω φάος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:850.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:850.1.text#γένει μὲν εὐτυχοῦμεν, ἐς δὲ συμφοράς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:851.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:851.1.text#ὦ σύγγον', ἡμῶν δυστυχὴς ἔφυ βίος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:852.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:852.1.text#ἐγᾦδ' ἁ μέλεος, οἶδ', ὅτε φάσγανον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:854.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:854.1.text#δέρᾳ θῆκέ μοι μελεόφρων πατήρ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:855.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:855.1.text#οἴμοι. δοκῶ γὰρ οὐ παρών σ' ὁρᾶν ἐκεῖ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:856.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:856.1.text#ἀνυμέναιος, { ὦ } σύγγον', Ἀχιλλέως
urn:cts:greekLit:tlg0006.tlg013.fu-sp:857.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:857.1.text#ἐς κλισίαν λέκτρων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:859.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:859.1.text#δολίαν ὅτ' ἀγόμαν·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:860.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:860.1.text#παρὰ δὲ βωμὸν ἦν δάκρυα καὶ γόοι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:861.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:861.1.text#φεῦ φεῦ χερνίβων { τῶν } ἐκεῖ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:862.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:862.1.text#ᾤμωξα κἀγὼ τόλμαν ἣν ἔτλη πατήρ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:864.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:864.1.text#ἀπάτορ' ἀπάτορα πότμον ἔλαχον.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:865.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:865.1.text#ἄλλα δ' ἐξ ἄλλων κυρεῖ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:867.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:867.1.text#δαίμονος τύχᾳ τινός.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:866.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:866.1.text#εἰ σόν γ' ἀδελφόν, ὦ τάλαιν', ἀπώλεσας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:868.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:868.1.text#ὦ μελέα δεινᾶς τόλμας. δείν' ἔτλαν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:870.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:870.1.text#δείν' ἔτλαν, ὤμοι σύγγονε. παρὰ δ' ὀλίγον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:871.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:871.1.text#ἀπέφυγες ὄλεθρον ἀνόσιον ἐξ ἐμᾶν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:872.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:872.1.text#δαϊχθεὶς χερῶν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:873.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:873.1.text#ἁ δ' ἐπ' αὐτοῖσι τίς τελευτά;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:874.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:874.1.text#τίς τύχα μοι συγχωρήσει;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:875.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:875.1.text#τίνα σοι πόρον εὑρομένα —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:878.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:878.1.text#πάλιν ἀπὸ πόλεως, ἀπὸ φόνου πέμψω
urn:cts:greekLit:tlg0006.tlg013.fu-sp:879.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:879.1.text#πατρίδ' ἐς Ἀργείαν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:880.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:880.1.text#πρὶν ἐπὶ ξίφος αἵματι σῷ πελάσαι;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:881.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:881.1.text#τόδε τόδε σόν, ὦ μελέα ψυχά,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:882.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:882.1.text#χρέος ἀνευρίσκειν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:884.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:884.1.text#πότερον κατὰ χέρσον, οὐχὶ ναΐ — ;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:885.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:885.1.text#ἀλλὰ ποδῶν ῥιπᾷ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:886.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:886.1.text#θανάτῳ πελάσεις ἄρα βάρβαρα φῦλα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:887.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:887.1.text#καὶ δι' ὁδοὺς ἀνόδους στείχων· διὰ κυανέας μὴν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:890.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:890.1.text#στενοπόρου πέτρας μακρὰ κέλευθα ναΐοισιν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:891.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:891.1.text#δρασμοῖς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:894.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:894.1.text#τάλαινα, τάλαινα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:895.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:895.1.text#τίς ἂν οὖν τάδ' ἂν ἢ θεὸς ἢ βροτὸς ἢ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:896.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:896.1.text#τί τῶν ἀδοκήτων,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:897.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:897.1.text#πόρον ἄπορον ἐξανύσας, δυοῖν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:898.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:898.1.text#τοῖν μόνοιν Ἀτρείδαιν { φαίνοι }
urn:cts:greekLit:tlg0006.tlg013.fu-sp:899.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:899.1.text#κακῶν ἔκλυσιν;[ … ]
urn:cts:greekLit:tlg0006.tlg013.fu-sp:900.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:900.1.text#ἐν τοῖσι θαυμαστοῖσι καὶ μύθων πέρα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:901.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:901.1.text#τάδ' εἶδον αὐτὴ κοὐ κλύουσ' ἀπαγγελῶ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:902.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:902.1.text#τὸ μὲν φίλους ἐλθόντας εἰς ὄψιν φίλων,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:903.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:903.1.text#Ὀρέστα, χειρῶν περιβολὰς εἰκὸς λαβεῖν·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:904.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:904.1.text#λήξαντα δ' οἴκτων κἀπ' ἐκεῖν' ἐλθεῖν χρεών,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:905.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:905.1.text#ὅπως τὸ κλεινὸν ὄνομα τῆς σωτηρίας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:906.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:906.1.text#λαβόντες ἐκ γῆς βησόμεσθα βαρβάρου.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:907.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:907.1.text#σοφῶν γὰρ ἀνδρῶν ταῦτα, μὴ 'κβάντας τύχης,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:908.1.speaker#Πυλάδης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:908.1.text#καιρὸν λαβόντας, ἡδονὰς ἄλλας λαβεῖν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:909.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:909.1.text#καλῶς ἔλεξας· τῇ τύχῃ δ' οἶμαι μέλειν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:910.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:910.1.text#τοῦδε ξὺν ἡμῖν· ἢν δέ τις πρόθυμος ᾖ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:911.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:911.1.text#σθένειν τὸ θεῖον μᾶλλον εἰκότως ἔχει.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:912.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:912.1.text#μηδέν μ' ἐπίσχῃ γ'· οὐδ' ἀποστήσει λόγου,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:913.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:913.1.text#πρῶτον πυθέσθαι τίνα ποτ' Ἠλέκτρα πότμον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:914.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:914.1.text#εἴληχε βιότου· φίλα γὰρ ἔστε πάντ' ἐμοί.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:915.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:915.1.text#τῷδε ξυνοικεῖ βίον ἔχουσ' εὐδαίμονα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:916.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:916.1.text#οὗτος δὲ ποδαπὸς καὶ τίνος πέφυκε παῖς;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:917.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:917.1.text#Στρόφιος ὁ Φωκεὺς τοῦδε κλῄζεται πατήρ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:918.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:918.1.text#ὁ δ' ἐστί γ' Ἀτρέως θυγατρός, ὁμογενὴς ἐμός;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:919.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:919.1.text#ἀνεψιός γε, μόνος ἐμοὶ σαφὴς φίλος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:920.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:920.1.text#οὐκ ἦν τόθ' οὗτος ὅτε πατὴρ ἔκτεινέ με.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:921.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:921.1.text#οὐκ ἦν· χρόνον γὰρ Στρόφιος ἦν ἄπαις τινά.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:922.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:922.1.text#χαῖρ' ὦ πόσις μοι τῆς ἐμῆς ὁμοσπόρου.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:923.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:923.1.text#κἀμός γε σωτήρ, οὐχὶ συγγενὴς μόνον.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:924.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:924.1.text#τὰ δεινὰ δ' ἔργα πῶς ἔτλης μητρὸς πέρι;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:925.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:925.1.text#σιγῶμεν αὐτά· πατρὶ τιμωρῶν ἐμῷ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:926.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:926.1.text#ἡ δ' αἰτία τίς ἀνθ' ὅτου κτείνει πόσιν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:927.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:927.1.text#ἔα τὰ μητρός· οὐδὲ σοὶ κλύειν καλόν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:928.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:928.1.text#σιγῶ· τὸ δ' Ἄργος πρὸς σὲ νῦν ἀποβλέπει;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:929.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:929.1.text#Μενέλαος ἄρχει· φυγάδες ἐσμὲν ἐκ πάτρας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:930.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:930.1.text#οὔ που νοσοῦντας θεῖος ὕβρισεν δόμους;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:931.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:931.1.text#οὔκ, ἀλλ' Ἐρινύων δεῖμά μ' ἐκβάλλει χθονός.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:932.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:932.1.text#ταῦτ' ἆρ' ἐπ' ἀκταῖς κἀνθάδ' ἠγγέλης μανείς;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:933.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:933.1.text#ὤφθημεν οὐ νῦν πρῶτον ὄντες ἄθλιοι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:934.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:934.1.text#ἔγνωκα· μητρός σ' οὕνεκ' ἠλάστρουν θεαί.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:935.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:935.1.text#ὥσθ' αἱματηρὰ στόμι' ἐπεμβαλεῖν ἐμοί.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:936.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:936.1.text#τί γάρ ποτ' ἐς γῆν τήνδ' ἐπόρθμευσας πόδα;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:937.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:937.1.text#Φοίβου κελευσθεὶς θεσφάτοις ἀφικόμην.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:938.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:938.1.text#τί χρῆμα δράσειν; ῥητὸν ἢ σιγώμενον;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:939.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:939.1.text#λέγοιμ' ἄν· ἀρχαὶ δ' αἵδε μοι πολλῶν πόνων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:940.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:940.1.text#ἐπεὶ τὰ μητρὸς ταῦθ' ἃ σιγῶμεν κακὰ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:941.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:941.1.text#ἐς χεῖρας ἦλθε, μεταδρομαῖς Ἐρινύων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:942.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:942.1.text#ἠλαυνόμεσθα φυγάδες, ἔνθεν μοι πόδα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:943.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:943.1.text#ἐς τὰς Ἀθήνας δῆτ' ἔπεμψε Λοξίας,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:944.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:944.1.text#δίκην παρασχεῖν ταῖς ἀνωνύμοις θεαῖς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:945.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:945.1.text#ἔστιν γὰρ ὁσία ψῆφος, ἣν Ἄρει ποτὲ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:946.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:946.1.text#Ζεὺς εἵσατ' ἔκ του δὴ χερῶν μιάσματος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:947.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:947.1.text#ἐλθὼν δ' ἐκεῖσε — πρῶτα μέν μ' οὐδεὶς ξένων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:948.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:948.1.text#ἑκὼν ἐδέξαθ', ὡς θεοῖς στυγούμενον·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:949.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:949.1.text#οἳ δ' ἔσχον αἰδῶ, ξένια μονοτράπεζά μοι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:950.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:950.1.text#παρέσχον, οἴκων ὄντες ἐν ταὐτῷ στέγει,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:951.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:951.1.text#σιγῇ δ' ἐτεκτήναντ' ἀπόφθεγκτόν μ', ὅπως
urn:cts:greekLit:tlg0006.tlg013.fu-sp:952.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:952.1.text#δαιτὸς γενοίμην πώματός τ' αὐτοῖς δίχα,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:953.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:953.1.text#ἐς δ' ἄγγος ἴδιον ἴσον ἅπασι βακχίου
urn:cts:greekLit:tlg0006.tlg013.fu-sp:954.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:954.1.text#μέτρημα πληρώσαντες εἶχον ἡδονήν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:955.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:955.1.text#κἀγὼ 'ξελέγξαι μὲν ξένους οὐκ ἠξίουν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:956.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:956.1.text#ἤλγουν δὲ σιγῇ κἀδόκουν οὐκ εἰδέναι,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:957.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:957.1.text#μέγα στενάζων οὕνεκ' ἦ μητρὸς φονεύς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:958.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:958.1.text#κλύω δ' Ἀθηναίοισι τἀμὰ δυστυχῆ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:959.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:959.1.text#τελετὴν γενέσθαι, κἄτι τὸν νόμον μένειν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:960.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:960.1.text#χοῆρες ἄγγος Παλλάδος τιμᾶν λεών.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:961.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:961.1.text#ὡς δ' εἰς Ἄρειον ὄχθον ἧκον, ἐς δίκην
urn:cts:greekLit:tlg0006.tlg013.fu-sp:962.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:962.1.text#ἔστην, ἐγὼ μὲν θάτερον λαβὼν βάθρον,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:963.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:963.1.text#τὸ δ' ἄλλο πρέσβειρ' ἥπερ ἦν Ἐρινύων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:964.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:964.1.text#εἰπὼν { δ' } ἀκούσας θ' αἵματος μητρὸς πέρι,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:965.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:965.1.text#Φοῖβός μ' ἔσῳσε μαρτυρῶν, ἴσας δέ μοι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:966.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:966.1.text#ψήφους διηρίθμησε Παλλὰς ὠλένῃ·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:967.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:967.1.text#νικῶν δ' ἀπῆρα φόνια πειρατήρια.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:968.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:968.1.text#ὅσαι μὲν οὖν ἕζοντο πεισθεῖσαι δίκῃ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:969.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:969.1.text#ψῆφον παρ' αὐτὴν ἱερὸν ὡρίσαντ' ἔχειν·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:970.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:970.1.text#ὅσαι δ' Ἐρινύων οὐκ ἐπείσθησαν νόμῳ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:971.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:971.1.text#δρόμοις ἀνιδρύτοισιν ἠλάστρουν μ' ἀεί,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:972.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:972.1.text#ἕως ἐς ἁγνὸν ἦλθον αὖ Φοίβου πέδον,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:973.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:973.1.text#καὶ πρόσθεν ἀδύτων ἐκταθείς, νῆστις βορᾶς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:974.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:974.1.text#ἐπώμοσ' αὐτοῦ βίον ἀπορρήξειν θανών,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:975.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:975.1.text#εἰ μή με σώσει Φοῖβος, ὅς μ' ἀπώλεσεν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:976.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:976.1.text#ἐντεῦθεν αὐδὴν τρίποδος ἐκ χρυσοῦ λακὼν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:977.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:977.1.text#Φοῖβός μ' ἔπεμψε δεῦρο, διοπετὲς λαβεῖν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:978.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:978.1.text#ἄγαλμ' Ἀθηνῶν τ' ἐγκαθιδρῦσαι χθονί.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:979.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:979.1.text#ἀλλ' ἥνπερ ἡμῖν ὥρισεν σωτηρίαν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:980.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:980.1.text#σύμπραξον· ἢν γὰρ θεᾶς κατάσχωμεν βρέτας,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:981.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:981.1.text#μανιῶν τε λήξω καὶ σὲ πολυκώπῳ σκάφει
urn:cts:greekLit:tlg0006.tlg013.fu-sp:982.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:982.1.text#στείλας Μυκήναις ἐγκαταστήσω πάλιν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:983.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:983.1.text#ἀλλ', ὦ φιληθεῖσ', ὦ κασίγνητον κάρα,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:984.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:984.1.text#σῷσον πατρῷον οἶκον, ἔκσῳσον δ' ἐμέ·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:985.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:985.1.text#ὡς τἄμ' ὄλωλε πάντα καὶ τὰ Πελοπιδῶν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:986.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:986.1.text#οὐράνιον εἰ μὴ ληψόμεσθα θεᾶς βρέτας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:987.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:987.1.text#δεινή τις ὀργὴ δαιμόνων ἐπέζεσε
urn:cts:greekLit:tlg0006.tlg013.fu-sp:988.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:988.1.text#τὸ Ταντάλειον σπέρμα διὰ πόνων τ' ἄγει.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:989.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:989.1.text#τὸ μὲν πρόθυμον, πρίν σε δεῦρ' ἐλθεῖν, ἔχω
urn:cts:greekLit:tlg0006.tlg013.fu-sp:990.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:990.1.text#Ἄργει γενέσθαι καὶ σέ, σύγγον', εἰσιδεῖν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:991.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:991.1.text#θέλω δ' ἅπερ σύ, σέ τε μεταστῆσαι πόνων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:992.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:992.1.text#νοσοῦντά τ' οἶκον, οὐχὶ τῷ κτανόντι με
urn:cts:greekLit:tlg0006.tlg013.fu-sp:993.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:993.1.text#θυμουμένη, πατρῷον ὀρθῶσαι· θέλω·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:994.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:994.1.text#σφαγῆς τε γὰρ σῆς χεῖρ' ἀπαλλάξαιμεν ἂν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:995.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:995.1.text#σῴσαιμί τ' οἴκους. τὴν θεὸν δ' ὅπως λάθω
urn:cts:greekLit:tlg0006.tlg013.fu-sp:996.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:996.1.text#δέδοικα καὶ τύραννον, ἡνίκ' ἂν κενὰς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:997.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:997.1.text#κρηπῖδας εὕρῃ λαΐνας ἀγάλματος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:998.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:998.1.text#πῶς δ' οὐ θανοῦμαι; τίς δ' ἔνεστί μοι λόγος;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:999.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:999.1.text#ἀλλ', εἰ μὲν — ἕν τι — τοῦθ' ὁμοῦ γενήσεται,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1000.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1000.1.text#ἄγαλμά τ' οἴσεις κἄμ' ἐπ' εὐπρύμνου νεὼς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1001.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1001.1.text#ἄξεις, τὸ κινδύνευμα γίγνεται καλόν·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1002.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1002.1.text#τούτου δὲ χωρισθεῖσ' — ἐγὼ μὲν ὄλλυμαι,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1003.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1003.1.text#σὺ δ' ἂν τὸ σαυτοῦ θέμενος εὖ νόστου τύχοις.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1004.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1004.1.text#οὐ μήν τι φεύγω γ', οὐδέ σ' εἰ θανεῖν χρεὼν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1005.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1005.1.text#σῴσασαν· οὐ γὰρ ἀλλ' ἀνὴρ μὲν ἐκ δόμων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1006.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1006.1.text#θανὼν ποθεινός, τὰ δὲ γυναικὸς ἀσθενῆ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1007.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1007.1.text#οὐκ ἂν γενοίμην σοῦ τε καὶ μητρὸς φονεύς·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1008.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1008.1.text#ἅλις τὸ κείνης αἷμα· κοινόφρων δὲ σοὶ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1009.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1009.1.text#καὶ ζῆν θέλοιμ' ἂν καὶ θανὼν λαχεῖν ἴσον.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1010.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1010.1.text#ἄξω δέ γ', ἤνπερ καὐτὸς ἐνταυθοῖ περῶ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1011.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1011.1.text#πρὸς οἶκον, ἢ σοῦ κατθανὼν μενῶ μέτα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1012.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1012.1.text#γνώμης δ' ἄκουσον· εἰ πρόσαντες ἦν τόδε
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1013.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1013.1.text#Ἀρτέμιδι, πῶς ἂν Λοξίας ἐθέσπισε
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1014.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1014.1.text#κομίσαι μ' ἄγαλμα θεᾶς πόλισμ' ἐς Παλλάδος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1014.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1014.2.text#{ [ … ] }
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1015.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1015.1.text#καὶ σὸν πρόσωπον εἰσιδεῖν; ἅπαντα γὰρ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1016.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1016.1.text#συνθεὶς τάδ' εἰς ἓν νόστον ἐλπίζω λαβεῖν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1017.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1017.1.text#πῶς οὖν γένοιτ' ἂν ὥστε μήθ' ἡμᾶς θανεῖν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1018.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1018.1.text#λαβεῖν θ' ἃ βουλόμεσθα; τῇδε γὰρ νοσεῖ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1019.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1019.1.text#νόστος πρὸς οἴκους· ἡ δὲ βούλησις πάρα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1020.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1020.1.text#ἆρ' ἂν τύραννον διολέσαι δυναίμεθ' ἄν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1021.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1021.1.text#δεινὸν τόδ' εἶπας, ξενοφονεῖν ἐπήλυδας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1022.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1022.1.text#ἀλλ', εἰ σὲ σώσει κἀμέ, κινδυνευτέον.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1023.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1023.1.text#οὐκ ἂν δυναίμην· τὸ δὲ πρόθυμον ᾔνεσα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1024.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1024.1.text#τί δ', εἴ με ναῷ τῷδε κρύψειας λάθρα;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1025.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1025.1.text#ὡς δὴ σκότον λαβόντες ἐκσωθεῖμεν ἄν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1026.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1026.1.text#κλεπτῶν γὰρ ἡ νύξ, τῆς δ' ἀληθείας τὸ φῶς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1027.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1027.1.text#εἴσ' ἔνδον ἱεροὶ φύλακες, οὓς οὐ λήσομεν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1028.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1028.1.text#οἴμοι, διεφθάρμεσθα· πῶς σωθεῖμεν ἄν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1029.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1029.1.text#ἔχειν δοκῶ μοι καινὸν ἐξεύρημά τι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1030.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1030.1.text#ποῖόν τι; δόξης μετάδος, ὡς κἀγὼ μάθω.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1031.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1031.1.text#ταῖς σαῖς ἀνίαις χρήσομαι σοφίσμασι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1032.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1032.1.text#δειναὶ γὰρ αἱ γυναῖκες εὑρίσκειν τέχνας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1033.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1033.1.text#φονέα σε φήσω μητρὸς ἐξ Ἄργους μολεῖν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1034.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1034.1.text#χρῆσαι κακοῖσι τοῖς ἐμοῖς, εἰ κερδανεῖς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1035.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1035.1.text#ὡς οὐ θέμις γε λέξομεν θύειν θεᾷ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1036.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1036.1.text#τίν' αἰτίαν ἔχουσ'; ὑποπτεύω τι γάρ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1037.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1037.1.text#οὐ καθαρὸν ὄντα· τὸ δ' ὅσιον δώσω φόβῳ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1038.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1038.1.text#τί δῆτα μᾶλλον θεᾶς ἄγαλμ' ἁλίσκεται;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1039.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1039.1.text#πόντου σε πηγαῖς ἁγνίσαι βουλήσομαι,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1040.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1040.1.text#ἔτ' ἐν δόμοισι βρέτας, ἐφ' ᾧ πεπλεύκαμεν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1041.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1041.1.text#κἀκεῖνο νίψαι, σοῦ θιγόντος ὥς, ἐρῶ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1042.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1042.1.text#ποῖ δῆτα; πόντου νοτερὸν εἶπας ἔκβολον;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1043.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1043.1.text#οὗ ναῦς χαλινοῖς λινοδέτοις ὁρμεῖ σέθεν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1044.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1044.1.text#σὺ δ' ἤ τις ἄλλος ἐν χεροῖν οἴσει βρέτας;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1045.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1045.1.text#ἐγώ· θιγεῖν γὰρ ὅσιόν ἐστ' ἐμοὶ μόνῃ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1046.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1046.1.text#Πυλάδης δ' ὅδ' ἡμῖν ποῦ τετάξεται πόνου;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1047.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1047.1.text#ταὐτὸν χεροῖν σοὶ λέξεται μίασμ' ἔχων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1048.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1048.1.text#λάθρα δ' ἄνακτος ἢ εἰδότος δράσεις τάδε;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1049.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1049.1.text#πείσασα μύθοις· οὐ γὰρ ἂν λάθοιμί γε.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1050.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1050.1.text#καὶ μὴν νεώς γε πίτυλος εὐήρης πάρα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1051.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1051.1.text#σοὶ δὴ μέλειν χρὴ τἄλλ' ὅπως ἕξει καλῶς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1052.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1052.1.text#ἑνὸς μόνου δεῖ, τάσδε συγκρύψαι τάδε.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1053.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1053.1.text#ἀλλ' ἀντίαζε καὶ λόγους πειστηρίους
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1054.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1054.1.text#εὕρισκ'· ἔχει τοι δύναμιν εἰς οἶκτον γυνή.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1055.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1055.1.text#τὰ δ' ἄλλ' ἴσως — . ἅπαντα συμβαίη καλῶς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1056.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1056.1.text#ὦ φίλταται γυναῖκες, εἰς ὑμᾶς βλέπω,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1057.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1057.1.text#καὶ τἄμ' ἐν ὑμῖν ἐστιν ἢ καλῶς ἔχειν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1058.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1058.1.text#ἢ μηδὲν εἶναι καὶ στερηθῆναι πάτρας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1059.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1059.1.text#φίλου τ' ἀδελφοῦ φιλτάτης τε συγγόνου.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1060.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1060.1.text#καὶ πρῶτα μέν μοι τοῦ λόγου τάδ' ἀρχέτω·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1061.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1061.1.text#γυναῖκές ἐσμεν, φιλόφρον ἀλλήλαις γένος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1062.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1062.1.text#σῴζειν τε κοινὰ πράγματ' ἀσφαλέσταται.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1063.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1063.1.text#σιγήσαθ' ἡμῖν καὶ συνεκπονήσατε
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1064.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1064.1.text#φυγάς. καλόν τοι γλῶσσ' ὅτῳ πιστὴ παρῇ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1065.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1065.1.text#ὁρᾶτε δ' ὡς τρεῖς μία τύχη τοὺς φιλτάτους,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1066.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1066.1.text#ἢ γῆς πατρῴας νόστον ἢ θανεῖν ἔχει.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1067.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1067.1.text#σωθεῖσα δ', ὡς ἂν καὶ σὺ κοινωνῇς τύχης,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1068.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1068.1.text#σώσω σ' ἐς Ἑλλάδ'. ἀλλὰ πρός σε δεξιᾶς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1069.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1069.1.text#σὲ καὶ σὲ ἱκνοῦμαι, σὲ δὲ φίλης παρηίδος,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1070.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1070.1.text#γονάτων τε καὶ τῶν ἐν δόμοισι φιλτάτων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1071.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1071.1.text#μητρὸς πατρός τε καὶ τέκνων ὅτῳ κυρεῖ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1072.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1072.1.text#τί φατέ; τίς ὑμῶν φησιν ἢ τίς οὐ θέλειν —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1073.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1073.1.text#φθέγξασθε — ταῦτα; μὴ γὰρ αἰνουσῶν λόγους
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1074.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1074.1.text#ὄλωλα κἀγὼ καὶ κασίγνητος τάλας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1075.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1075.1.text#θάρσει, φίλη δέσποινα, καὶ σῴζου μόνον·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1076.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1076.1.text#ὡς ἔκ γ' ἐμοῦ σοι πάντα σιγηθήσεται —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1077.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1077.1.text#ἴστω μέγας Ζεύς — ὧν ἐπισκήπτεις πέρι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1078.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1078.1.text#ὄναισθε μύθων καὶ γένοισθ' εὐδαίμονες.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1079.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1079.1.text#σὸν ἔργον ἤδη καὶ σὸν ἐσβαίνειν δόμους·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1080.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1080.1.text#ὡς αὐτίχ' ἥξει τῆσδε κοίρανος χθονός,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1081.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1081.1.text#θυσίαν ἐλέγχων εἰ κατείργασται ξένων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1082.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1082.1.text#ὦ πότνι', ἥπερ μ' Αὐλίδος κατὰ πτυχὰς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1083.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1083.1.text#δεινῆς ἔσωσας ἐκ πατροκτόνου χερός,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1084.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1084.1.text#σῶσόν με καὶ νῦν τούσδε τ'· ἢ τὸ Λοξίου
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1085.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1085.1.text#οὐκέτι βροτοῖσι διὰ σὲ ἐτήτυμον στόμα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1086.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1086.1.text#ἀλλ' εὐμενὴς ἔκβηθι βαρβάρου χθονὸς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1087.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1087.1.text#ἐς τὰς Ἀθήνας· καὶ γὰρ ἐνθάδ' οὐ πρέπει
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1088.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1088.1.text#ναίειν, παρόν σοι πόλιν ἔχειν εὐδαίμονα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1089.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1089.1.text#ὄρνις, ἃ παρὰ πετρίνας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1090.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1090.1.text#πόντου δειράδας, ἀλκυών,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1091.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1091.1.text#ἔλεγον οἶτον ἀείδεις,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1092.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1092.1.text#εὐξύνετον ξυνετοῖς βοάν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1093.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1093.1.text#ὅτι πόσιν κελαδεῖς ἀεὶ μολπαῖς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1094.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1094.1.text#ἐγώ σοι παραβάλλομαι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1095.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1095.1.text#θρήνους, ἄπτερος ὅρνις,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1096.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1096.1.text#ποθοῦσ' Ἑλλάνων ἀγόρους,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1097.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1097.1.text#ποθοῦσ' Ἄρτεμιν λοχίαν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1098.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1098.1.text#ἃ παρὰ Κύνθιον ὄχθον οἰκεῖ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1099.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1099.1.text#φοίνικά θ' ἁβροκόμαν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1100.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1100.1.text#δάφναν τ' εὐερνέα καὶ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1101.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1101.1.text#γλαυκᾶς θαλλὸν ἱερὸν ἐλαίας,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1102.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1102.1.text#Λατοῦς ὠδῖνα φίλαν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1103.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1103.1.text#λίμναν θ' εἱλίσσουσαν ὕδωρ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1104.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1104.1.text#κύκλιον, ἔνθα κύκνος μελῳδὸς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1105.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1105.1.text#Μούσας θεραπεύει.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1106.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1106.1.text#ὦ πολλαὶ δακρύων λιβάδες,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1107.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1107.1.text#αἳ παρηίδας εἰς ἐμὰς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1108.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1108.1.text#ἔπεσον, ἁνίκα πύργων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1109.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1109.1.text#ὀλομένων ἐν ναυσὶν ἔβαν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1110.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1110.1.text#πολεμίων ἐρετμοῖσι καὶ λόγχαις.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1111.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1111.1.text#ζαχρύσου δὲ δι' ἐμπολᾶς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1112.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1112.1.text#νόστον βάρβαρον ἦλθον,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1113.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1113.1.text#ἔνθα τᾶς ἐλαφοκτόνου
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1114.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1114.1.text#θεᾶς ἀμφίπολον κόραν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1115.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1115.1.text#παῖδ' Ἀγαμεμνονίαν λατρεύω
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1116.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1116.1.text#βωμούς τ' οὐ μηλοθύτας,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1117.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1117.1.text#ζηλοῦσ' ἄταν διὰ παντὸς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1118.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1118.1.text#δυσδαίμον'· ἐν γὰρ ἀνάγκαις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1119.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1119.1.text#οὐ κάμνεις σύντροφος ὤν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1120.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1120.1.text#μεταβάλλει δυσδαιμονία·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1121.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1121.1.text#τὸ δὲ μετ' εὐτυχίας κακοῦσθαι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1122.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1122.1.text#θνατοῖς βαρὺς αἰών.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1123.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1123.1.text#καὶ σὲ μέν, πότνι', Ἀργεία
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1124.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1124.1.text#πεντηκόντορος οἶκον ἄξει·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1125.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1125.1.text#συρίζων θ' ὁ κηροδέτας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1126.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1126.1.text#κάλαμος οὐρείου Πανὸς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1127.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1127.1.text#κώπαις ἐπιθωΰξει,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1128.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1128.1.text#ὁ Φοῖβός θ' ὁ μάντις ἔχων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1129.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1129.1.text#κέλαδον ἑπτατόνου λύρας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1130.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1130.1.text#ἀείδων ἄξει λιπαρὰν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1131.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1131.1.text#εὖ σ' Ἀθηναίων ἐπὶ γᾶν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1132.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1132.1.text#ἐμὲ δ' αὐτοῦ λιποῦσα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1133.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1133.1.text#βήσῃ ῥοθίοισι πλάταις·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1134.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1134.1.text#ἀέρι δὲ [ ἱστία ] πρότονοι κατὰ πρῷραν ὑπὲρ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1135.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1135.1.text#στόλον ἐκπετάσουσι πόδα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1136.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1136.1.text#ναὸς ὠκυπόμπου.[ … ]
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1138.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1138.1.text#λαμπροὺς ἱπποδρόμους βαίην,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1139.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1139.1.text#ἔνθ' εὐάλιον ἔρχεται πῦρ·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1140.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1140.1.text#οἰκείων δ' ὑπὲρ θαλάμων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1141.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1141.1.text#πτέρυγας ἐν νώτοις ἁμοῖς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1142.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1142.1.text#λήξαιμι θοάζουσα·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1143.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1143.1.text#χοροῖς δ' ἑσταίην, ὅθι καὶ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1144.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1144.1.text#παρθένος, εὐδοκίμων γάμων,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1145.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1145.1.text#παρὰ πόδ' εἱλίσσουσα φίλας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1146.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1146.1.text#ματρὸς ἡλίκων θιάσους,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1147.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1147.1.text#χαρίτων εἰς ἁμίλλας,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1148.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1148.1.text#χαίτας ἁβρόπλουτον ἔριν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1149.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1149.1.text#ὀρνυμένα, πολυποίκιλα φάρεα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1150.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1150.1.text#καὶ πλοκάμους περιβαλλομένα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1151.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1151.1.text#γένυσιν ἐσκίαζον.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1153.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1153.1.text#ποῦ 'σθ' ἡ πυλωρὸς τῶνδε δωμάτων γυνὴ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1154.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1154.1.text#Ἑλληνίς; ἤδη τῶν ξένων κατήρξατο;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1155.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1155.1.text#ἀδύτοις ἐν ἁγνοῖς σῶμα λάμπονται πυρί;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1156.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1156.1.text#ἥδ' ἐστίν, ἥ σοι πάντ', ἄναξ, ἐρεῖ σαφῶς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1157.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1157.1.text#ἔα·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1157.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1157.2.text#τί τόδε μεταίρεις ἐξ ἀκινήτων βάθρων,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1158.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1158.1.text#Ἀγαμέμνονος παῖ, θεᾶς ἄγαλμ' ἐν ὠλέναις;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1159.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1159.1.text#ἄναξ, ἔχ' αὐτοῦ πόδα σὸν ἐν παραστάσιν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1160.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1160.1.text#τί δ' ἔστιν, Ἰφιγένεια, καινὸν ἐν δόμοις;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1161.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1161.1.text#ἀπέπτυσ'· Ὁσίᾳ γὰρ δίδωμ' ἔπος τόδε.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1162.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1162.1.text#τί φροιμιάζῃ νεοχμόν; ἐξαύδα σαφῶς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1163.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1163.1.text#οὐ καθαρά μοι τὰ θύματ' ἠγρεύσασθ', ἄναξ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1164.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1164.1.text#τί τοὐκδιδάξαν τοῦτό σ'; ἢ δόξαν λέγεις;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1165.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1165.1.text#βρέτας τὸ τῆς θεοῦ πάλιν ἕδρας ἀπεστράφη.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1166.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1166.1.text#αὐτόματον, ἤ νιν σεισμὸς ἔστρεψε χθονός;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1167.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1167.1.text#αὐτόματον· ὄψιν δ' ὀμμάτων ξυνήρμοσεν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1168.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1168.1.text#ἡ δ' αἰτία τίς; ἦ τὸ τῶν ξένων μύσος;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1169.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1169.1.text#ἥδ', οὐδὲν ἄλλο· δεινὰ γὰρ δεδράκατον.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1170.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1170.1.text#ἀλλ' ἦ τιν' ἔκανον βαρβάρων ἀκτῆς ἔπι;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1171.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1171.1.text#οἰκεῖον ἦλθον τὸν φόνον κεκτημένοι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1172.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1172.1.text#τίν'; εἰς ἔρον γὰρ τοῦ μαθεῖν πεπτώκαμεν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1173.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1173.1.text#μητέρα κατειργάσαντο κοινωνῷ ξίφει.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1174.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1174.1.text#Ἄπολλον, οὐδ' ἐν βαρβάροις ἔτλη τις ἄν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1175.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1175.1.text#πάσης διωγμοῖς ἠλάθησαν Ἑλλάδος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1176.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1176.1.text#ἦ τῶνδ' ἕκατι δῆτ' ἄγαλμ' ἔξω φέρεις;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1177.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1177.1.text#σεμνόν γ' ὑπ' αἰθέρ', ὡς μεταστήσω φόνου.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1178.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1178.1.text#μίασμα δ' ἔγνως τοῖν ξένοιν ποίῳ τρόπῳ;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1179.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1179.1.text#ἤλεγχον, ὡς θεᾶς βρέτας ἀπεστράφη πάλιν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1180.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1180.1.text#σοφήν σ' ἔθρεψεν Ἑλλάς, ὡς ᾔσθου καλῶς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1181.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1181.1.text#καὶ μὴν καθεῖσαν δέλεαρ ἡδύ μοι φρενῶν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1182.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1182.1.text#τῶν Ἀργόθεν τι φίλτρον ἀγγέλλοντέ σοι;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1183.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1183.1.text#τὸν μόνον Ὀρέστην ἐμὸν ἀδελφὸν εὐτυχεῖν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1184.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1184.1.text#ὡς δή σφε σῴσαις ἡδοναῖς ἀγγελμάτων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1185.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1185.1.text#καὶ πατέρα γε ζῆν καὶ καλῶς πράσσειν ἐμόν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1186.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1186.1.text#σὺ δ' ἐς τὸ τῆς θεοῦ γ' ἐξένευσας εἰκότως.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1187.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1187.1.text#πᾶσάν γε μισοῦσ' Ἑλλάδ', ἥ μ' ἀπώλεσεν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1188.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1188.1.text#τί δῆτα δρῶμεν, φράζε, τοῖν ξένοιν πέρι;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1189.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1189.1.text#τὸν νόμον ἀνάγκη τὸν προκείμενον σέβειν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1190.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1190.1.text#οὔκουν ἐν ἔργῳ χέρνιβες ξίφος τε σόν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1191.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1191.1.text#ἁγνοῖς καθαρμοῖς πρῶτά νιν νίψαι θέλω.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1192.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1192.1.text#πηγαῖσιν ὑδάτων ἢ θαλασσίᾳ δρόσῳ;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1193.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1193.1.text#θάλασσα κλύζει πάντα τἀνθρώπων κακά.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1194.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1194.1.text#ὁσιώτερον γοῦν τῇ θεῷ πέσοιεν ἄν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1195.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1195.1.text#καὶ τἀμά γ' οὕτω μᾶλλον ἂν καλῶς ἔχοι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1196.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1196.1.text#οὔκουν πρὸς αὐτὸν ναὸν ἐκπίπτει κλύδων;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1197.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1197.1.text#ἐρημίας δεῖ· καὶ γὰρ ἄλλα δράσομεν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1198.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1198.1.text#ἄγ' ἔνθα χρῄζεις· οὐ φιλῶ τἄρρηθ' ὁρᾶν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1199.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1199.1.text#ἁγνιστέον μοι καὶ τὸ τῆς θεοῦ βρέτας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1200.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1200.1.text#εἴπερ γε κηλὶς ἔβαλέ νιν μητροκτόνος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1201.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1201.1.text#οὐ γάρ ποτ' ἄν νιν ἠράμην βάθρων ἄπο.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1202.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1202.1.text#δίκαιος ηὑσέβεια καὶ προμηθία.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1203.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1203.1.text#οἶσθά νυν ἅ μοι γενέσθω;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1203.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1203.2.text#σὸν τὸ σημαίνειν τόδε.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1204.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1204.1.text#δεσμὰ τοῖς ξένοισι πρόσθες.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1204.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1204.2.text#ποῖ δέ σ' ἐκφύγοιεν ἄν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1205.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1205.1.text#πιστὸν Ἑλλὰς οἶδεν οὐδέν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1205.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1205.2.text#ἴτ' ἐπὶ δεσμά, πρόσπολοι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1206.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1206.1.text#κἀκκομιζόντων δὲ δεῦρο τοὺς ξένους —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1206.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1206.2.text#ἔσται τάδε.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1207.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1207.1.text#κρᾶτα κρύψαντες πέπλοισιν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1207.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1207.2.text#ἡλίου πρόσθεν φλογός.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1208.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1208.1.text#σῶν τέ μοι σύμπεμπ' ὀπαδῶν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1208.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1208.2.text#οἵδ' ὁμαρτήσουσί σοι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1209.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1209.1.text#καὶ πόλει πέμψον τιν' ὅστις σημανεῖ —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1209.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1209.2.text#ποίας τύχας;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1210.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1210.1.text#ἐν δόμοις μίμνειν ἅπαντας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1210.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1210.2.text#μὴ συναντῷεν φόνῳ;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1211.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1211.1.text#μυσαρὰ γὰρ τὰ τοιάδ' ἐστί.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1211.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1211.2.text#στεῖχε καὶ σήμαινε σύ —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1212.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1212.1.text#μηδέν' εἰς ὄψιν πελάζειν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1212.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1212.2.text#εὖ γε κηδεύεις πόλιν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1213.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1213.1.text#καὶ φίλων γ' οὓς δεῖ μάλιστα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1213.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1213.2.text#τοῦτ' ἔλεξας εἰς ἐμέ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1214.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1214.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1214.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1214.2.text#ὡς εἰκότως σε πᾶσα θαυμάζει πόλις.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1215.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1215.1.text#σὺ δὲ μένων αὐτοῦ πρὸ ναῶν τῇ θεῷ —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1215.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1215.2.text#τί χρῆμα δρῶ;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1216.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1216.1.text#ἅγνισον πυρσῷ μέλαθρον.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1216.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1216.2.text#καθαρὸν ὡς μόλῃς πάλιν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1217.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1217.1.text#ἡνίκ' ἂν δ' ἔξω περῶσιν οἱ ξένοι —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1217.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1217.2.text#τί χρή με δρᾶν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1218.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1218.1.text#πέπλον ὀμμάτων προθέσθαι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1218.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1218.2.text#μὴ παλαμναῖον λάβω.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1219.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1219.1.text#ἢν δ' ἄγαν δοκῶ χρονίζειν —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1219.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1219.2.text#τοῦδ' ὅρος τίς ἐστί μοι;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1220.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1220.1.text#θαυμάσῃς μηδέν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1220.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1220.2.text#τὰ τῆς θεοῦ πρᾶσσ' — ἐπεὶ σχολή — καλῶς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1221.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1221.1.text#εἰ γὰρ ὡς θέλω καθαρμὸς ὅδε πέσοι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1221.2.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1221.2.text#συνεύχομαι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1222.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1222.1.text#τούσδ' ἄρ' ἐκβαίνοντας ἤδη δωμάτων ὁρῶ ξένους
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1223.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1223.1.text#καὶ θεᾶς κόσμους νεογνούς τ' ἄρνας, ὡς φόνῳ φόνον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1224.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1224.1.text#μυσαρὸν ἐκνίψω, σέλας τε λαμπάδων τά τ' ἄλλ' ὅσα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1225.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1225.1.text#προυθέμην ἐγὼ ξένοισι καὶ θεᾷ καθάρσια.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1226.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1226.1.text#ἐκποδὼν δ' αὐδῶ πολίταις τοῦδ' ἔχειν μιάσματος,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1227.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1227.1.text#εἴ τις ἢ ναῶν πυλωρὸς χεῖρας ἁγνεύει θεοῖς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1228.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1228.1.text#ἢ γάμον στείχει συνάψων ἢ τόκοις βαρύνεται,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1229.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1229.1.text#φεύγετ', ἐξίστασθε, μή τῳ προσπέσῃ μύσος τόδε.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1230.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1230.1.text#ὦ Διὸς Λητοῦς τ' ἄνασσα παρθέν', ἢν νίψω φόνον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1231.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1231.1.text#τῶνδε καὶ θύσωμεν οὗ χρή, καθαρὸν οἰκήσεις δόμον,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1232.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1232.1.text#εὐτυχεῖς δ' ἡμεῖς ἐσόμεθα. τἄλλα δ' οὐ λέγουσ', ὅμως
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1233.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1233.1.text#τοῖς τὰ πλείον' εἰδόσιν θεοῖς σοί τε σημαίνω, θεά.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1234.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1234.1.text#εὔπαις ὁ Λατοῦς γόνος,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1235.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1235.1.text#τόν ποτε Δηλιὰς ἐν καρποφόροις γυάλοις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1236.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1236.1.text#{ ἔτικτε, } χρυσοκόμαν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1238.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1238.1.text#ἐν κιθάρᾳ σοφόν, ἅ τ' ἐπὶ τόξων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1239.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1239.1.text#εὐστοχίᾳ γάνυται· φέρε { δ' αὐτά }
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1240.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1240.1.text#νιν ἀπὸ δειράδος εἰναλίας,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1241.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1241.1.text#λοχεῖα κλεινὰ λιποῦσα μάτηρ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1242.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1242.1.text#τὰν ἀστάκτων ὑδάτων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1243.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1243.1.text#βακχεύουσαν Διονύσῳ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1244.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1244.1.text#Παρνάσιον κορυφάν·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1244a.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1244a.1.text#ὅθι ποικιλόνωτος οἰνωπὸς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1245.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1245.1.text#δράκων,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1246.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1246.1.text#σκιερᾷ κατάχαλκος εὐφύλλῳ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1247.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1247.1.text#δάφνᾳ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1248.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1248.1.text#γᾶς πελώριον τέρας, ἄμφεπε μαντεῖον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1248.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1248.2.text#Χθόνιον.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1249.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1249.1.text#ἔτι μιν ἔτι βρέφος, ἔτι φίλας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1250.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1250.1.text#ἐπὶ ματέρος ἀγκάλαισι θρῴσκων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1251.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1251.1.text#ἔκανες, ὦ Φοῖβε, μαντείων δ' ἐπέβας ζαθέων,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1254.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1254.1.text#τρίποδί τ' ἐν χρυσέῳ θάσσεις, ἐν ἀψευδεῖ θρόνῳ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1255.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1255.1.text#μαντείας βροτοῖς θεσφάτων νέμων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1257.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1257.1.text#ἀδύτων ὕπο, Κασταλίας ῥεέθρων γείτων, μέσον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1258.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1258.1.text#γᾶς ἔχων μέλαθρον.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1259.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1259.1.text#Θέμιν δ' ἐπεὶ γᾶς ἰὼν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1260.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1260.1.text#παῖδ' ἀπενάσσατο { Πυθῶνος } ἀπὸ ζαθέων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1261.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1261.1.text#χρηστηρίων, νύχια
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1262.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1262.1.text#Χθὼν ἐτεκνώσατο φάσματ' ὀ{ νείρων },
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1263.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1263.1.text#οἳ πολέσιν μερόπων τά τε πρῶτα, τά τ'
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1265.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1265.1.text#ἔπειθ', ὅσσα τ' ἔμελλε τυχεῖν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1266.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1266.1.text#ὕπνου κατὰ δνοφερὰς γᾶς εὐνὰς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1267.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1267.1.text#ἔφραζον· Γαῖα δὲ τὰν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1268.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1268.1.text#μαντεῖον ἀφείλετο τιμὰν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1269.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1269.1.text#Φοῖβον, φθόνῳ θυγατρός.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1270.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1270.1.text#ταχύπους δ' ἐς Ὄλυμπον ὁρμαθεὶς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1271.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1271.1.text#ἄναξ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1271.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1271.2.text#χέρα παιδνὸν ἕλιξεν ἐκ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1272.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1272.1.text#Διὸς θρόνων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1273.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1273.1.text#Πυθίων δόμων χθονίαν ἀφελεῖν μῆνιν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1273a.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1273a.1.text#θεᾶς. [ νυχίους τ' ἐνοπὰς. ]
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1274.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1274.1.text#γέλασε δ', ὅτι τέκος ἄφαρ ἔβα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1275.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1275.1.text#πολύχρυσα θέλων λατρεύματα σχεῖν·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1276.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1276.1.text#ἐπὶ δ' ἔσεισεν κόμαν, παῦσαι νυχίους ἐνοπάς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1277.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1277.1.text#ἀπὸ δ' ἀλαθοσύναν νυκτωπὸν ἐξεῖλεν βροτῶν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1280.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1280.1.text#καὶ τιμὰς πάλιν θῆκε Λοξίᾳ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1281.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1281.1.text#πολυάνορι δ' ἐν ξενόεντι θρόνῳ θάρση βροτοῖς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1282.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1282.1.text#θεσφάτων ἀοιδαῖς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1284.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1284.1.text#ὦ ναοφύλακες βώμιοί τ' ἐπιστάται,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1285.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1285.1.text#Θόας ἄναξ γῆς τῆσδε ποῦ κυρεῖ βεβώς;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1286.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1286.1.text#καλεῖτ' ἀναπτύξαντες εὐγόμφους πύλας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1287.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1287.1.text#ἔξω μελάθρων τῶνδε κοίρανον χθονός.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1288.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1288.1.text#τί δ' ἔστιν, εἰ χρὴ μὴ κελευσθεῖσαν λέγειν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1289.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1289.1.text#βεβᾶσι φροῦδοι δίπτυχοι νεανίαι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1290.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1290.1.text#Ἀγαμεμνονείας παιδὸς ἐκ βουλευμάτων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1291.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1291.1.text#φεύγοντες ἐκ γῆς τῆσδε καὶ σεμνὸν βρέτας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1292.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1292.1.text#λαβόντες ἐν κόλποισιν Ἑλλάδος νεώς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1293.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1293.1.text#ἄπιστον εἶπας μῦθον· ὃν δ' ἰδεῖν θέλεις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1294.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1294.1.text#ἄνακτα χώρας, φροῦδος ἐκ ναοῦ συθείς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1295.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1295.1.text#ποῖ; δεῖ γὰρ αὐτὸν εἰδέναι τὰ δρώμενα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1296.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1296.1.text#οὐκ ἴσμεν· ἀλλὰ στεῖχε καὶ δίωκέ νιν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1297.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1297.1.text#ὅπου κυρήσας τούσδ' ἀπαγγελεῖς λόγους.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1298.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1298.1.text#ὁρᾶτ', ἄπιστον ὡς γυναικεῖον γένος·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1299.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1299.1.text#μέτεστι χὑμῖν τῶν πεπραγμένων μέρος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1300.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1300.1.text#μαίνῃ· τί δ' ἡμῖν τῶν ξένων δρασμοῦ μέτα;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1301.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1301.1.text#οὐκ εἶ κρατούντων πρὸς πύλας ὅσον τάχος;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1302.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1302.1.text#οὔ, πρίν γ' ἂν εἴπῃ τοὔπος ἑρμηνεὺς ὅδε,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1303.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1303.1.text#εἴτ' ἔνδον εἴτ' οὐκ ἔνδον ἀρχηγὸς χθονός.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1304.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1304.1.text#ὠή, χαλᾶτε κλῇθρα, τοῖς ἔνδον λέγω,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1305.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1305.1.text#καὶ δεσπότῃ σημήναθ' οὕνεκ' ἐν πύλαις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1306.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1306.1.text#πάρειμι, καινῶν φόρτον ἀγγέλλων κακῶν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1307.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1307.1.text#τίς ἀμφὶ δῶμα θεᾶς τόδ' ἵστησιν βοήν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1308.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1308.1.text#πύλας ἀράξας καὶ ψόφον πέμψας ἔσω;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1309.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1309.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1309.2.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1309.2.text#πῶς ἔλεγον αἵδε, καί μ' ἀπήλαυνον δόμων,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1310.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1310.1.text#ὡς ἐκτὸς εἴης· σὺ δὲ κατ' οἶκον ἦσθ' ἄρα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1311.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1311.1.text#τί προσδοκῶσαι κέρδος ἢ θηρώμεναι;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1312.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1312.1.text#αὖθις τὰ τῶνδε σημανῶ· τὰ δ' ἐν ποσὶ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1313.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1313.1.text#παρόντ' ἄκουσον. ἡ νεᾶνις ἣ 'νθάδε
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1314.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1314.1.text#βωμοῖς παρίστατ', Ἰφιγένει', ἔξω χθονὸς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1315.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1315.1.text#σὺν τοῖς ξένοισιν οἴχεται, σεμνὸν θεᾶς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1316.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1316.1.text#ἄγαλμ' ἔχουσα· δόλια δ' ἦν καθάρματα.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1317.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1317.1.text#πῶς φῄς; τί πνεῦμα συμφορᾶς κεκτημένη;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1318.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1318.1.text#σῴζουσ' Ὀρέστην· τοῦτο γὰρ σὺ θαυμάσῃ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1319.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1319.1.text#τὸν ποῖον; ἆρ' ὃν Τυνδαρὶς τίκτει κόρη;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1320.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1320.1.text#ὃν τοῖσδε βωμοῖς θεὰ καθωσιώσατο.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1321.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1321.1.text#ὦ θαῦμα — πῶς σε μεῖζον ὀνομάσας τύχω;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1322.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1322.1.text#μὴ 'νταῦθα τρέψῃς σὴν φρέν', ἀλλ' ἄκουέ μου·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1323.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1323.1.text#σαφῶς δ' ἀθρήσας καὶ κλύων ἐκφρόντισον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1324.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1324.1.text#διωγμὸς ὅστις τοὺς ξένους θηράσεται.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1325.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1325.1.text#λέγ'· εὖ γὰρ εἶπας· οὐ γὰρ ἀγχίπλουν πόρον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1326.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1326.1.text#φεύγουσιν, ὥστε διαφυγεῖν τοὐμὸν δόρυ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1327.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1327.1.text#ἐπεὶ πρὸς ἀκτὰς ἤλθομεν θαλασσίας,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1328.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1328.1.text#οὗ ναῦς Ὀρέστου κρύφιος ἦν ὡρμισμένη,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1329.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1329.1.text#ἡμᾶς μέν, οὓς σὺ δεσμὰ συμπέμπεις ξένων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1330.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1330.1.text#ἔχοντας, ἐξένευσ' ἀποστῆναι πρόσω
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1331.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1331.1.text#Ἀγαμέμνονος παῖς, ὡς ἀπόρρητον φλόγα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1332.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1332.1.text#θύουσα καὶ καθαρμὸν ὃν μετῴχετο,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1333.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1333.1.text#αὐτὴ δ' ὄπισθε δέσμ' ἔχουσα τοῖν ξένοιν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1334.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1334.1.text#ἔστειχε χερσί. καὶ τάδ' ἦν ὕποπτα μέν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1335.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1335.1.text#ἤρεσκε μέντοι σοῖσι προσπόλοις, ἄναξ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1336.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1336.1.text#χρόνῳ δ', ἵν' ἡμῖν δρᾶν τι δὴ δοκοῖ πλέον,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1337.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1337.1.text#ἀνωλόλυξε καὶ κατῇδε βάρβαρα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1338.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1338.1.text#μέλη μαγεύουσ', ὡς φόνον νίζουσα δή.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1339.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1339.1.text#ἐπεὶ δὲ δαρὸν ἦμεν ἥμενοι χρόνον,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1340.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1340.1.text#ἐσῆλθεν ἡμᾶς μὴ λυθέντες οἱ ξένοι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1341.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1341.1.text#κτάνοιεν αὐτὴν δραπέται τ' οἰχοίατο.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1342.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1342.1.text#φόβῳ δ' ἃ μὴ χρῆν εἰσορᾶν καθήμεθα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1343.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1343.1.text#σιγῇ· τέλος δὲ πᾶσιν ἦν αὑτὸς λόγος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1344.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1344.1.text#στείχειν ἵν' ἦσαν, καίπερ οὐκ ἐωμένοις.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1345.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1345.1.text#κἀνταῦθ' ὁρῶμεν Ἑλλάδος νεὼς σκάφος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1346.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1346.1.text#ταρσῷ κατήρει πίτυλον ἐπτερωμένον,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1347.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1347.1.text#ναύτας τε πεντήκοντ' ἐπὶ σκαλμῶν πλάτας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1348.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1348.1.text#ἔχοντας, ἐκ δεσμῶν δὲ τοὺς νεανίας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1349.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1349.1.text#ἐλευθέρους πρύμνηθεν ἑστῶτας νεώς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1350.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1350.1.text#κοντοῖς δὲ πρῷραν εἶχον, οἳ δ' ἐπωτίδων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1351.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1351.1.text#ἄγκυραν ἐξανῆπτον· οἳ δέ, κλίμακας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1352.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1352.1.text#σπεύδοντες, ἦγον διὰ χερῶν πρυμνήσια,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1353.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1353.1.text#πόντῳ δὲ δόντες τοῖν ξένοιν καθίεσαν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1354.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1354.1.text#ἡμεῖς δ' ἀφειδήσαντες, ὡς ἐσείδομεν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1355.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1355.1.text#δόλια τεχνήματ', εἰχόμεσθα τῆς ξένης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1356.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1356.1.text#πρυμνησίων τε, καὶ δι' εὐθυντηρίας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1357.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1357.1.text#οἴακας ἐξῃροῦμεν εὐπρύμνου νεώς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1358.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1358.1.text#λόγοι δ' ἐχώρουν· Τίνι λόγῳ πορθμεύετε
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1359.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1359.1.text#κλέπτοντες ἐκ γῆς ξόανα καὶ θυηπόλους;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1360.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1360.1.text#τίνος τίς ὢν σὺ τήνδ' ἀπεμπολᾷς χθονός;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1361.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1361.1.text#ὁ δ' εἶπ'· Ὀρέστης, τῆσδ' ὅμαιμος, ὡς μάθῃς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1362.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1362.1.text#Ἀγαμέμνονος παῖς, τήνδ' ἐμὴν κομίζομαι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1363.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1363.1.text#λαβὼν ἀδελφήν, ἣν ἀπώλεσ' ἐκ δόμων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1364.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1364.1.text#ἀλλ' οὐδὲν ἧσσον εἰχόμεσθα τῆς ξένης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1365.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1365.1.text#καὶ πρὸς σὲ ἕπεσθαι διεβιαζόμεσθά νιν·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1366.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1366.1.text#ὅθεν τὰ δεινὰ πλήγματ' ἦν γενειάδων.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1367.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1367.1.text#κεῖνοί τε γὰρ σίδηρον οὐκ εἶχον χεροῖν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1368.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1368.1.text#ἡμεῖς τε· πυγμαί τ' ἦσαν ἐγκροτούμεναι,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1369.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1369.1.text#καὶ κῶλ' ἀπ' ἀμφοῖν τοῖν νεανίαιν ἅμα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1370.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1370.1.text#ἐς πλευρὰ καὶ πρὸς ἧπαρ ἠκοντίζετο,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1371.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1371.1.text#ὡς τῷ ξυνάπτειν καὶ συναποκαμεῖν μέλη.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1372.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1372.1.text#δεινοῖς δὲ σημάντροισιν ἐσφραγισμένοι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1373.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1373.1.text#ἐφεύγομεν πρὸς κρημνόν, οἳ μὲν ἐν κάρᾳ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1374.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1374.1.text#κάθαιμ' ἔχοντες τραύμαθ', οἳ δ' ἐν ὄμμασιν·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1375.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1375.1.text#ὄχθοις δ' ἐπισταθέντες εὐλαβεστέρως
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1376.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1376.1.text#ἐμαρνάμεσθα καὶ πέτρους ἐβάλλομεν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1377.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1377.1.text#ἀλλ' εἶργον ἡμᾶς τοξόται πρύμνης ἔπι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1378.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1378.1.text#σταθέντες ἰοῖς, ὥστ' ἀναστεῖλαι πρόσω.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1379.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1379.1.text#κἀν τῷδε — δεινὸς γὰρ κλύδων ὤκειλε ναῦν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1380.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1380.1.text#πρὸς γῆν, φόβος δ' ἦν { παρθένῳ } τέγξαι πόδα —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1381.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1381.1.text#λαβὼν Ὀρέστης ὦμον εἰς ἀριστερόν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1382.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1382.1.text#βὰς ἐς θάλασσαν κἀπὶ κλίμακος θορών,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1383.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1383.1.text#ἔθηκ' ἀδελφὴν ἐντὸς εὐσήμου νεώς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1384.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1384.1.text#τό τ' οὐρανοῦ πέσημα, τῆς Διὸς κόρης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1385.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1385.1.text#ἄγαλμα. ναὸς { δ' } ἐκ μέσης ἐφθέγξατο
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1386.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1386.1.text#βοή τις· ὦ γῆς Ἑλλάδος ναῦται, νεὼς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1387.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1387.1.text#λάβεσθε κώπαις ῥόθιά τ' ἐκλευκαίνετε·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1388.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1388.1.text#ἔχομεν γὰρ ὧνπερ οὕνεκ' ἄξενον πόρον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1389.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1389.1.text#Συμπληγάδων ἔσωθεν εἰσεπλεύσαμεν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1390.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1390.1.text#οἳ δὲ στεναγμὸν ἡδὺν ἐκβρυχώμενοι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1391.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1391.1.text#ἔπαισαν ἅλμην. ναῦς δ', ἕως μὲν ἐντὸς ἦν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1392.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1392.1.text#λιμένος, ἐχώρει στόμια, διαπερῶσα δὲ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1393.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1393.1.text#λάβρῳ κλύδωνι συμπεσοῦσ' ἠπείγετο·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1394.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1394.1.text#δεινὸς γὰρ ἐλθὼν ἄνεμος ἐξαίφνης νεὼς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1395.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1395.1.text#ὠθεῖ παλίμπρυμν' ἱστί'· οἳ δ' ἐκαρτέρουν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1396.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1396.1.text#πρὸς κῦμα λακτίζοντες· ἐς δὲ γῆν πάλιν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1397.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1397.1.text#κλύδων παλίρρους ἦγε ναῦν. σταθεῖσα δὲ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1398.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1398.1.text#Ἀγαμέμνονος παῖς ηὔξατ'· ὦ Λητοῦς κόρη
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1399.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1399.1.text#σῷσόν με τὴν σὴν ἱερέαν πρὸς Ἑλλάδα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1400.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1400.1.text#ἐκ βαρβάρου γῆς καὶ κλοπαῖς σύγγνωθ' ἐμαῖς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1401.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1401.1.text#φιλεῖς δὲ καὶ σὺ σὸν κασίγνητον, θεά·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1402.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1402.1.text#φιλεῖν δὲ κἀμὲ τοὺς ὁμαίμονας δόκει.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1403.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1403.1.text#ναῦται δ' ἐπευφήμησαν εὐχαῖσιν κόρης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1404.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1404.1.text#παιᾶνα, γυμνὰς ἐκ { πέπλων } ἐπωμίδας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1405.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1405.1.text#κώπῃ προσαρμόσαντες ἐκ κελεύσματος.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1406.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1406.1.text#μᾶλλον δὲ μᾶλλον πρὸς πέτρας ᾔει σκάφος·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1407.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1407.1.text#χὣ μέν τις ἐς θάλασσαν ὡρμήθη ποσίν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1408.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1408.1.text#ἄλλος δὲ πλεκτὰς ἐξανῆπτεν ἀγκύλας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1409.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1409.1.text#κἀγὼ μὲν εὐθὺς πρὸς σὲ δεῦρ' ἀπεστάλην,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1410.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1410.1.text#σοὶ τὰς ἐκεῖθεν σημανῶν, ἄναξ, τύχας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1411.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1411.1.text#ἀλλ' ἕρπε, δεσμὰ καὶ βρόχους λαβὼν χεροῖν·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1412.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1412.1.text#εἰ μὴ γὰρ οἶδμα νήνεμον γενήσεται,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1413.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1413.1.text#οὐκ ἔστιν ἐλπὶς τοῖς ξένοις σωτηρίας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1414.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1414.1.text#πόντου δ' ἀνάκτωρ Ἴλιόν τ' ἐπισκοπεῖ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1415.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1415.1.text#σεμνὸς Ποσειδῶν, Πελοπίδαις ἐναντίος,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1416.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1416.1.text#καὶ νῦν παρέξει τὸν Ἀγαμέμνονος γόνον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1417.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1417.1.text#σοὶ καὶ πολίταις, ὡς ἔοικεν, ἐν χεροῖν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1418.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1418.1.text#λαβεῖν, ἀδελφήν θ', ἣ φόνον τὸν Αὐλίδι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1419.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1419.1.text#ἀμνημόνευτον θεᾷ προδοῦσ' ἁλίσκεται.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1420.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1420.1.text#ὦ τλῆμον Ἰφιγένεια, συγγόνου μέτα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1421.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1421.1.text#θανῇ πάλιν μολοῦσα δεσποτῶν χέρας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1422.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1422.1.text#ὦ πάντες ἀστοὶ τῆσδε βαρβάρου χθονός,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1423.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1423.1.text#οὐκ εἶα πώλοις ἐμβαλόντες ἡνίας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1424.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1424.1.text#παράκτιοι δραμεῖσθε κἀκβολὰς νεὼς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1425.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1425.1.text#Ἑλληνίδος δέξεσθε, σὺν δὲ τῇ θεῷ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1426.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1426.1.text#σπεύδοντες ἄνδρας δυσσεβεῖς θηράσετε,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1427.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1427.1.text#οἳ δ' ὠκυπομποὺς ἕλξετ' ἐς πόντον πλάτας;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1428.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1428.1.text#ὡς ἐκ θαλάσσης ἔκ τε γῆς ἱππεύμασι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1429.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1429.1.text#λαβόντες αὐτοὺς ἢ κατὰ στύφλου πέτρας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1430.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1430.1.text#ῥίψωμεν, ἢ σκόλοψι πήξωμεν δέμας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1431.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1431.1.text#ὑμᾶς δὲ τὰς τῶνδ' ἴστορας βουλευμάτων,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1432.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1432.1.text#γυναῖκες, αὖθις, ἡνίκ' ἂν σχολὴν λάβω,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1433.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1433.1.text#ποινασόμεσθα· νῦν δὲ τὴν προκειμένην
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1434.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1434.1.text#σπουδὴν ἔχοντες οὐ μενοῦμεν ἥσυχοι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1435.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1435.1.text#ποῖ ποῖ διωγμὸν τόνδε πορθμεύεις, ἄναξ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1436.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1436.1.text#Θόας; ἄκουσον τῆσδ' Ἀθηναίας λόγους.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1437.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1437.1.text#παῦσαι διώκων ῥεῦμά τ' ἐξορμῶν στρατοῦ·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1438.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1438.1.text#πεπρωμένος γὰρ θεσφάτοισι Λοξίου
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1439.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1439.1.text#δεῦρ' ἦλθ' Ὀρέστης, τόν τ' Ἐρινύων χόλον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1440.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1440.1.text#φεύγων ἀδελφῆς τ' Ἄργος ἐσπέμψων δέμας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1441.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1441.1.text#ἄγαλμά θ' ἱερὸν εἰς ἐμὴν ἄξων χθόνα,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1441.2.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1441.2.text#τῶν νῦν παρόντων πημάτων ἀναψυχάς.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1442.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1442.1.text#πρὸς μὲν σὲ ὅδ' ἡμῖν μῦθος· ὃν δ' ἀποκτενεῖν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1443.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1443.1.text#δοκεῖς Ὀρέστην ποντίῳ λαβὼν σάλῳ,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1444.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1444.1.text#ἤδη Ποσειδῶν χάριν ἐμὴν ἀκύμονα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1445.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1445.1.text#πόντου τίθησι νῶτα πορθμεύειν πλάτῃ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1446.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1446.1.text#μαθὼν δ', Ὀρέστα, τὰς ἐμὰς ἐπιστολάς —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1447.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1447.1.text#κλύεις γὰρ αὐδὴν καίπερ οὐ παρὼν θεᾶς —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1448.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1448.1.text#χώρει λαβὼν ἄγαλμα σύγγονόν τε σήν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1449.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1449.1.text#ὅταν δ' Ἀθήνας τὰς θεοδμήτους μόλῃς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1450.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1450.1.text#χῶρός τις ἔστιν Ἀτθίδος πρὸς ἐσχάτοις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1451.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1451.1.text#ὅροισι, γείτων δειράδος Καρυστίας,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1452.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1452.1.text#ἱερός, Ἁλάς νιν οὑμὸς ὀνομάζει λεώς·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1453.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1453.1.text#ἐνταῦθα τεύξας ναὸν ἵδρυσαι βρέτας,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1454.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1454.1.text#ἐπώνυμον γῆς Ταυρικῆς πόνων τε σῶν,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1455.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1455.1.text#οὓς ἐξεμόχθεις περιπολῶν καθ' Ἑλλάδα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1456.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1456.1.text#οἴστροις Ἐρινύων. Ἄρτεμιν δέ νιν βροτοὶ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1457.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1457.1.text#τὸ λοιπὸν ὑμνήσουσι Ταυροπόλον θεάν.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1458.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1458.1.text#νόμον τε θὲς τόνδ'· ὅταν ἑορτάζῃ λεώς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1459.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1459.1.text#τῆς σῆς σφαγῆς ἄποιν' ἐπισχέτω ξίφος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1460.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1460.1.text#δέρῃ πρὸς ἀνδρὸς αἷμά τ' ἐξανιέτω,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1461.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1461.1.text#ὁσίας ἕκατι θεά θ' ὅπως τιμὰς ἔχῃ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1462.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1462.1.text#σὲ δ' ἀμφὶ σεμνάς, Ἰφιγένεια, κλίμακας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1463.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1463.1.text#Βραυρωνίας δεῖ τῇδε κλῃδουχεῖν θεᾷ·
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1464.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1464.1.text#οὗ καὶ τεθάψῃ κατθανοῦσα, καὶ πέπλων
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1465.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1465.1.text#ἄγαλμά σοι θήσουσιν εὐπήνους ὑφάς,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1466.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1466.1.text#ἃς ἂν γυναῖκες ἐν τόκοις ψυχορραγεῖς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1467.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1467.1.text#λίπωσ' ἐν οἴκοις. τάσδε δ' ἐκπέμπειν χθονὸς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1468.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1468.1.text#Ἑλληνίδας γυναῖκας ἐξεφίεμαι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1469.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1469.1.text#γνώμης δικαίας οὕνεκ'
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1469.2.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1469.2.text#{ [ … ] }
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1469.2.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1469.2.text#ἐκσῴσασα δὲ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1470.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1470.1.text#καὶ πρίν σ' Ἀρείοις ἐν πάγοις ψήφους ἴσας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1471.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1471.1.text#κρίνασ', Ὀρέστα· καὶ νόμισμ' ἔσται τόδε,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1472.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1472.1.text#νικᾶν ἰσήρεις ὅστις ἂν ψήφους λάβῃ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1473.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1473.1.text#ἀλλ' ἐκκομίζου σὴν κασιγνήτην χθονός,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1474.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1474.1.text#Ἀγαμέμνονος παῖ.  — καὶ σὺ μὴ θυμοῦ, Θόας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1475.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1475.1.text#ἄνασσ' Ἀθάνα, τοῖσι τῶν θεῶν λόγοις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1476.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1476.1.text#ὅστις κλύων ἄπιστος, οὐκ ὀρθῶς φρονεῖ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1477.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1477.1.text#ἐγὼ δ' Ὀρέστῃ τ', εἰ φέρων βρέτας θεᾶς
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1478.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1478.1.text#βέβηκ', ἀδελφῇ τ' οὐχὶ θυμοῦμαι· τί γὰρ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1479.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1479.1.text#πρὸς τοὺς σθένοντας θεοὺς ἁμιλλᾶσθαι καλόν;
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1480.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1480.1.text#ἴτωσαν ἐς σὴν σὺν θεᾶς ἀγάλματι
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1481.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1481.1.text#γαῖαν, καθιδρύσαιντό τ' εὐτυχῶς βρέτας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1482.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1482.1.text#πέμψω δὲ καὶ τάσδ' Ἑλλάδ' εἰς εὐδαίμονα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1483.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1483.1.text#γυναῖκας, ὥσπερ σὸν κέλευσμ' ἐφίεται.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1484.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1484.1.text#παύσω δὲ λόγχην ἣν ἐπαίρομαι ξένοις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1485.1.speaker#Θόας
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1485.1.text#ναῶν τ' ἐρετμά, σοὶ τάδ' ὡς δοκεῖ, θεά.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1486.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1486.1.text#αἰνῶ· τὸ γὰρ χρεὼν σοῦ τε καὶ θεῶν κρατεῖ.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1487.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1487.1.text#ἴτ', ὦ πνοαί, ναυσθλοῦσθε τὸν Ἀγαμέμνονος
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1488.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1488.1.text#παῖδ' εἰς Ἀθήνας· συμπορεύσομαι δ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1489.1.speaker#Ἀθήνα
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1489.1.text#σῴζουσ' ἀδελφῆς τῆς ἐμῆς σεμνὸν βρέτας.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1490.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1490.1.text#ἴτ' ἐπ' εὐτυχίᾳ τῆς σῳζομένης
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1491.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1491.1.text#μοίρας εὐδαίμονες ὄντες.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1492.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1492.1.text#ἀλλ', ὦ σεμνὴ παρά τ' ἀθανάτοις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1493.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1493.1.text#καὶ παρὰ θνητοῖς, Παλλὰς Ἀθάνα,
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1494.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1494.1.text#δράσομεν οὕτως ὡς σὺ κελεύεις.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1495.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1495.1.text#μάλα γὰρ τερπνὴν κἀνέλπιστον
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1496.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1496.1.text#φήμην ἀκοαῖσι δέδεγμαι.
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1497.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1497.1.text#—   —   —
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1497a.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1497a.1.text#ὦ μέγα σεμνὴ Νίκη, τὸν ἐμὸν
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1498.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1498.1.text#βίοτον κατέχοις
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1499.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg013.fu-sp:1499.1.text#καὶ μὴ λήγοις στεφανοῦσα.
