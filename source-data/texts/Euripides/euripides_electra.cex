#!ctsdata
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1.1.text#ὦ γῆς παλαιὸν ἄργος, Ἰνάχου ῥοαί,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:2.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:2.1.text#ὅθεν ποτ' ἄρας ναυσὶ χιλίαις Ἄρη
urn:cts:greekLit:tlg0006.tlg012.fu.sp:3.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:3.1.text#ἐς γῆν ἔπλευσε Τρῳάδ' Ἀγαμέμνων ἄναξ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:4.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:4.1.text#κτείνας δὲ τὸν κρατοῦντ' ἐν Ἰλιάδι χθονὶ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:5.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:5.1.text#Πρίαμον, ἑλών τε Δαρδάνου κλεινὴν πόλιν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:6.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:6.1.text#ἀφίκετ' ἐς τόδ' Ἄργος, ὑψηλῶν δ' ἐπὶ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:7.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:7.1.text#ναῶν ἔθηκε σκῦλα πλεῖστα βαρβάρων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:8.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:8.1.text#κἀκεῖ μὲν εὐτύχησεν· ἐν δὲ δώμασι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:9.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:9.1.text#θνῄσκει γυναικὸς πρὸς Κλυταιμήστρας δόλῳ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:10.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:10.1.text#καὶ τοῦ Θυέστου παιδὸς Αἰγίσθου χερί.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:11.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:11.1.text#χὣ μὲν παλαιὰ σκῆπτρα Ταντάλου λιπὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:12.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:12.1.text#ὄλωλεν, Αἴγισθος δὲ βασιλεύει χθονός,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:13.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:13.1.text#ἄλοχον ἐκείνου Τυνδαρίδα κόρην ἔχων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:14.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:14.1.text#οὓς δ' ἐν δόμοισιν ἔλιφ' ὅτ' ἐς Τροίαν ἔπλει,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:15.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:15.1.text#ἄρσενά τ' Ὀρέστην θῆλύ τ' Ἠλέκτρας θάλος,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:16.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:16.1.text#τὸν μὲν πατρὸς γεραιὸς ἐκκλέπτει τροφεὺς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:17.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:17.1.text#μέλλοντ' Ὀρέστην χερὸς ὑπ' Αἰγίσθου θανεῖν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:18.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:18.1.text#Στροφίῳ τ' ἔδωκε Φωκέων ἐς γῆν τρέφειν·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:19.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:19.1.text#ἣ δ' ἐν δόμοις ἔμεινεν Ἠλέκτρα πατρός,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:20.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:20.1.text#ταύτην ἐπειδὴ θαλερὸς εἶχ' ἥβης χρόνος,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:21.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:21.1.text#μνηστῆρες ᾔτουν Ἑλλάδος πρῶτοι χθονός.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:22.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:22.1.text#δείσας δὲ μή τῳ παῖδ' ἀριστέων τέκοι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:23.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:23.1.text#Ἀγαμέμνονος ποινάτορ', εἶχεν ἐν δόμοις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:24.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:24.1.text#Αἴγισθος οὐδ' ἥρμοζε νυμφίῳ τινί.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:25.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:25.1.text#ἐπεὶ δὲ καὶ τοῦτ' ἦν φόβου πολλοῦ πλέων,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:26.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:26.1.text#μή τῳ λαθραίως τέκνα γενναίῳ τέκοι,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:27.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:27.1.text#κτανεῖν σφε βουλεύσαντος, ὠμόφρων ὅμως
urn:cts:greekLit:tlg0006.tlg012.fu.sp:28.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:28.1.text#μήτηρ νιν ἐξέσῳσεν Αἰγίσθου χερός.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:29.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:29.1.text#ἐς μὲν γὰρ ἄνδρα σκῆψιν εἶχ' ὀλωλότα,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:30.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:30.1.text#παίδων δ' ἔδεισε μὴ φθονηθείη φόνῳ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:31.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:31.1.text#ἐκ τῶνδε δὴ τοιόνδ' ἐμηχανήσατο
urn:cts:greekLit:tlg0006.tlg012.fu.sp:32.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:32.1.text#Αἴγισθος· ὃς μὲν γῆς ἀπηλλάχθη φυγὰς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:33.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:33.1.text#Ἀγαμέμνονος παῖς, χρυσὸν εἶφ' ὃς ἂν κτάνῃ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:34.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:34.1.text#ἡμῖν δὲ δὴ δίδωσιν Ἠλέκτραν ἔχειν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:35.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:35.1.text#δάμαρτα, πατέρων μὲν Μυκηναίων ἄπο
urn:cts:greekLit:tlg0006.tlg012.fu.sp:36.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:36.1.text#γεγῶσιν — οὐ δὴ τοῦτό γ' ἐξελέγχομαι·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:37.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:37.1.text#λαμπροὶ γὰρ ἐς γένος γε, χρημάτων δὲ δὴ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:38.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:38.1.text#πένητες, ἔνθεν ηὑγένει' ἀπόλλυται —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:39.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:39.1.text#ὡς ἀσθενεῖ δοὺς ἀσθενῆ λάβοι φόβον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:40.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:40.1.text#εἰ γάρ νιν ἔσχεν ἀξίωμ' ἔχων ἀνήρ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:41.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:41.1.text#εὕδοντ' ἂν ἐξήγειρε τὸν Ἀγαμέμνονος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:42.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:42.1.text#φόνον δίκη τ' ἂν ἦλθεν Αἰγίσθῳ τότε.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:43.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:43.1.text#ἣν οὔποθ' ἁνὴρ ὅδε — σύνοιδέ μοι Κύπρις —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:44.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:44.1.text#ᾔσχυνεν εὐνῇ· παρθένος δ' ἔτ' ἐστὶ δή.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:45.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:45.1.text#αἰσχύνομαι γὰρ ὀλβίων ἀνδρῶν τέκνα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:46.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:46.1.text#λαβὼν ὑβρίζειν, οὐ κατάξιος γεγώς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:47.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:47.1.text#στένω δὲ τὸν λόγοισι κηδεύοντ' ἐμοὶ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:48.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:48.1.text#ἄθλιον Ὀρέστην, εἴ ποτ' εἰς Ἄργος μολὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:49.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:49.1.text#γάμους ἀδελφῆς δυστυχεῖς ἐσόψεται.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:50.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:50.1.text#ὅστις δέ μ' εἶναί φησι μῶρον, εἰ λαβὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:51.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:51.1.text#νέαν ἐς οἴκους παρθένον μὴ θιγγάνω,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:52.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:52.1.text#γνώμης πονηροῖς κανόσιν ἀναμετρούμενος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:53.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:53.1.text#τὸ σῶφρον ἴστω καὐτὸς αὖ τοιοῦτος ὤν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:54.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:54.1.text#ὦ νὺξ μέλαινα, χρυσέων ἄστρων τροφέ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:55.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:55.1.text#ἐν ᾗ τόδ' ἄγγος τῷδ' ἐφεδρεῦον κάρᾳ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:56.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:56.1.text#φέρουσα πηγὰς ποταμίας μετέρχομαι —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:57.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:57.1.text#οὐ δή τι χρείας ἐς τοσόνδ' ἀφιγμένη,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:58.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:58.1.text#ἀλλ' ὡς ὕβριν δείξωμεν Αἰγίσθου θεοῖς —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:59.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:59.1.text#γόους τ' ἀφίημ' αἰθέρ' ἐς μέγαν πατρί.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:60.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:60.1.text#ἡ γὰρ πανώλης Τυνδαρίς, μήτηρ ἐμή,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:61.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:61.1.text#ἐξέβαλέ μ' οἴκων, χάριτα τιθεμένη πόσει·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:62.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:62.1.text#τεκοῦσα δ' ἄλλους παῖδας Αἰγίσθῳ πάρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:63.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:63.1.text#πάρεργ' Ὀρέστην κἀμὲ ποιεῖται δόμων —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:64.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:64.1.text#τί γὰρ τάδ', ὦ δύστην', ἐμὴν μοχθεῖς χάριν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:65.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:65.1.text#πόνους ἔχουσα, πρόσθεν εὖ τεθραμμένη,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:66.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:66.1.text#καὶ ταῦτ' ἐμοῦ λέγοντος οὐκ ἀφίστασαι;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:67.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:67.1.text#ἐγώ σ' ἴσον θεοῖσιν ἡγοῦμαι φίλον·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:68.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:68.1.text#ἐν τοῖς ἐμοῖς γὰρ οὐκ ἐνύβρισας κακοῖς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:69.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:69.1.text#μεγάλη δὲ θνητοῖς μοῖρα συμφορᾶς κακῆς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:70.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:70.1.text#ἰατρὸν εὑρεῖν, ὡς ἐγὼ σὲ λαμβάνω.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:71.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:71.1.text#δεῖ δή με κἀκέλευστον εἰς ὅσον σθένω
urn:cts:greekLit:tlg0006.tlg012.fu.sp:72.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:72.1.text#μόχθου 'πικουφίζουσαν, ὡς ῥᾷον φέρῃς,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:73.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:73.1.text#συνεκκομίζειν σοι πόνους. ἅλις δ' ἔχεις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:74.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:74.1.text#τἄξωθεν ἔργα· τἀν δόμοις δ' ἡμᾶς χρεὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:75.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:75.1.text#ἐξευτρεπίζειν. εἰσιόντι δ' ἐργάτῃ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:76.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:76.1.text#θύραθεν ἡδὺ τἄνδον εὑρίσκειν καλῶς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:77.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:77.1.text#εἴ τοι δοκεῖ σοι, στεῖχε· καὶ γὰρ οὐ πρόσω
urn:cts:greekLit:tlg0006.tlg012.fu.sp:78.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:78.1.text#πηγαὶ μελάθρων τῶνδ'. ἐγὼ δ' ἅμ' ἡμέρᾳ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:79.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:79.1.text#βοῦς εἰς ἀρούρας ἐσβαλὼν σπερῶ γύας.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:80.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:80.1.text#ἀργὸς γὰρ οὐδεὶς θεοὺς ἔχων ἀνὰ στόμα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:81.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:81.1.text#βίον δύναιτ' ἂν ξυλλέγειν ἄνευ πόνου.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:82.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:82.1.text#Πυλάδη, σὲ γὰρ δὴ πρῶτον ἀνθρώπων ἐγὼ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:83.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:83.1.text#πιστὸν νομίζω καὶ φίλον ξένον τ' ἐμοί·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:84.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:84.1.text#μόνος δ' Ὀρέστην τόνδ' ἐθαύμαζες φίλων,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:85.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:85.1.text#πράσσονθ' ἃ πράσσω δείν' ὑπ' Αἰγίσθου παθών,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:86.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:86.1.text#ὅς μου κατέκτα πατέρα — χἡ πανώλεθρος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:87.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:87.1.text#μήτηρ. ἀφῖγμαι δ' ἐκ θεοῦ μυστηρίων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:88.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:88.1.text#Ἀργεῖον οὖδας οὐδενὸς ξυνειδότος,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:89.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:89.1.text#φόνον φονεῦσι πατρὸς ἀλλάξων ἐμοῦ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:90.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:90.1.text#νυκτὸς δὲ τῆσδε πρὸς τάφον μολὼν πατρὸς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:91.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:91.1.text#δάκρυά τ' ἔδωκα καὶ κόμης ἀπηρξάμην
urn:cts:greekLit:tlg0006.tlg012.fu.sp:92.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:92.1.text#πυρᾷ τ' ἐπέσφαξ' αἷμα μηλείου φόνου,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:93.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:93.1.text#λαθὼν τυράννους οἳ κρατοῦσι τῆσδε γῆς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:94.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:94.1.text#καὶ τειχέων μὲν ἐντὸς οὐ βαίνω πόδα,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:95.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:95.1.text#δυοῖν δ' ἅμιλλαν ξυντιθεὶς ἀφικόμην
urn:cts:greekLit:tlg0006.tlg012.fu.sp:96.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:96.1.text#πρὸς τέρμονας γῆς τῆσδ', ἵν' ἐκβάλω ποδὶ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:97.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:97.1.text#ἄλλην ἐπ' αἶαν, εἴ μέ τις γνοίη σκοπῶν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:98.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:98.1.text#ζητῶν τ' ἀδελφήν· φασὶ γάρ νιν ἐν γάμοις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:99.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:99.1.text#ζευχθεῖσαν οἰκεῖν οὐδὲ παρθένον μένειν·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:100.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:100.1.text#ὡς συγγένωμαι καὶ φόνου ξυνεργάτιν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:101.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:101.1.text#λαβὼν τά γ' εἴσω τειχέων σαφῶς μάθω.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:102.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:102.1.text#νῦν οὖν — ἕως γὰρ λευκὸν ὄμμ' ἀναίρεται —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:103.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:103.1.text#ἔξω τρίβου τοῦδ' ἴχνος ἀλλαξώμεθα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:104.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:104.1.text#ἢ γάρ τις ἀροτὴρ ἤ τις οἰκέτις γυνὴ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:105.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:105.1.text#φανήσεται νῷν, ἥντιν' ἱστορήσομεν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:106.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:106.1.text#εἰ τούσδε ναίει σύγγονος τόπους ἐμή.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:107.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:107.1.text#ἀλλ' — εἰσορῶ γὰρ τήνδε προσπόλον τινά,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:108.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:108.1.text#πηγαῖον ἄχθος ἐν κεκαρμένῳ κάρᾳ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:109.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:109.1.text#φέρουσαν — ἑζώμεσθα κἀκπυθώμεθα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:110.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:110.1.text#δούλης γυναικός, ἤν τι δεξώμεσθ' ἔπος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:111.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:111.1.text#ἐφ' οἷσι, Πυλάδη, τήνδ' ἀφίγμεθα χθόνα.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:112.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:112.1.text#σύντειν' — ὥρα — ποδὸς ὁρμάν· ὤ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:113.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:113.1.text#ἔμβα, ἔμβα κατακλαίουσα·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:114.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:114.1.text#ἰώ μοί μοι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:115.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:115.1.text#ἐγενόμαν Ἀγαμέμνονος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:116.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:116.1.text#καί μ' ἔτεκεν Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:117.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:117.1.text#στυγνὰ Τυνδάρεω κόρα,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:118.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:118.1.text#κικλήσκουσι δέ μ' ἀθλίαν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:119.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:119.1.text#Ἠλέκτραν πολιῆται.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:120.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:120.1.text#φεῦ φεῦ σχετλίων πόνων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:121.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:121.1.text#καὶ στυγερᾶς ζόας.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:122.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:122.1.text#ὦ πάτερ, σὺ δ' ἐν Ἀΐδα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:123.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:123.1.text#κεῖσαι, σᾶς ἀλόχου σφαγαῖς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:124.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:124.1.text#Αἰγίσθου τ', Ἀγάμεμνον.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:125.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:125.1.text#ἴθι τὸν αὐτὸν ἔγειρε γόον,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:126.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:126.1.text#ἄναγε πολύδακρυν ἁδονάν.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:127.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:127.1.text#σύντειν' — ὥρα — ποδὸς ὁρμάν· ὤ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:128.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:128.1.text#ἔμβα, ἔμβα, κατακλαίουσα·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:129.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:129.1.text#ἰώ μοί μοι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:130.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:130.1.text#τίνα πόλιν, τίνα δ' οἶκον, ὦ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:131.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:131.1.text#τλᾶμον σύγγον', ἀλατεύεις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:132.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:132.1.text#οἰκτρὰν ἐν θαλάμοις λιπὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:133.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:133.1.text#πατρῴοις ἐπὶ συμφοραῖς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:134.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:134.1.text#ἀλγίσταισιν ἀδελφάν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:135.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:135.1.text#ἔλθοις τῶνδε πόνων ἐμοὶ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:136.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:136.1.text#τᾷ μελέᾳ λυτήρ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:137.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:137.1.text#ὦ Ζεῦ Ζεῦ, πατρί θ' αἱμάτων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:138.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:138.1.text#ἐχθίστων ἐπίκουρος, Ἄργει
urn:cts:greekLit:tlg0006.tlg012.fu.sp:139.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:139.1.text#κέλσας πόδ' ἀλάταν.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:140.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:140.1.text#θὲς τόδε τεῦχος ἐμῆς ἀπὸ κρατὸς ἑλοῦσ',
urn:cts:greekLit:tlg0006.tlg012.fu.sp:141.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:141.1.text#ἵνα πατρὶ γόους νυχίους
urn:cts:greekLit:tlg0006.tlg012.fu.sp:142.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:142.1.text#ἐπορθροβοάσω,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:143.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:143.1.text#ἰαχάν, Ἀΐδα μέλος,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:144.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:144.1.text#Ἀΐδα, πάτερ, σοι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:144.2.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:144.2.text#κατὰ γᾶς ἐνέπω γόους
urn:cts:greekLit:tlg0006.tlg012.fu.sp:145.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:145.1.text#οἷς ἀεὶ τὸ κατ' ἦμαρ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:146.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:146.1.text#διέπομαι, κατὰ μὲν φίλαν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:147.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:147.1.text#ὄνυχι τεμνομένα δέραν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:148.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:148.1.text#χέρα τε κρᾶτ' ἐπὶ κούριμον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:149.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:149.1.text#τιθεμένα θανάτῳ σῷ.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:150.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:150.1.text#αἶ αἶ, δρύπτε κάρα·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:151.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:151.1.text#οἷα δέ τις κύκνος ἀχέτας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:152.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:152.1.text#ποταμίοις παρὰ χεύμασιν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:153.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:153.1.text#πατέρα φίλτατον καλεῖ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:154.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:154.1.text#ὀλόμενον δολίοις βρόχων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:155.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:155.1.text#ἕρκεσιν, ὣς σὲ τὸν ἄθλιον,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:156.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:156.1.text#πάτερ, ἐγὼ κατακλαίομαι,[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:157.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:157.1.text#λουτρὰ πανύσταθ' ὑδρανάμενον χροῒ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:158.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:158.1.text#κοίτᾳ ἐν οἰκτροτάτᾳ θανάτου.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:159.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:159.1.text#ἰώ μοι, { ἰώ } μοι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:160.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:160.1.text#πικρᾶς μὲν πελέκεως τομᾶς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:161.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:161.1.text#σᾶς, πάτερ, πικρᾶς δ' ἐκ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:162.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:162.1.text#Τροΐας ὁδίου βουλᾶς·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:163.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:163.1.text#οὐ μίτραισι γυνή σε
urn:cts:greekLit:tlg0006.tlg012.fu.sp:164.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:164.1.text#δέξατ' οὐδ' ἐπὶ στεφάνοις,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:164.2.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:164.2.text#ξίφεσι δ' ἀμφιτόμοις λυγρὰν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:165.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:165.1.text#Αἰγίσθου λώβαν θεμένα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:166.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:166.1.text#δόλιον ἔσχεν ἀκοίταν.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:167.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:167.1.text#Ἀγαμέμνονος ὦ κόρα,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:168.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:168.1.text#ἤλυθον, Ἠλέκτρα, ποτὶ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:169.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:169.1.text#σὰν ἀγρότειραν αὐλάν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:170.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:170.1.text#ἔμολέ τις ἔμολεν γαλακτοπότας ἀνὴρ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:170.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:170.2.text#Μυκηναῖος ὀρειβάτας·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:171.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:171.1.text#ἀγγέλλει δ' ὅτι νῦν τριταίαν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:172.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:172.1.text#καρύσσουσιν θυσίαν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:173.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:173.1.text#Ἀργεῖοι, πᾶσαι δὲ παρ' Ἥραν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:174.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:174.1.text#μέλλουσιν παρθενικαὶ στείχειν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:175.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:175.1.text#οὐκ ἐπ' ἀγλαΐαις, φίλαι,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:176.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:176.1.text#θυμὸν οὐδ' ἐπὶ χρυσέοις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:177.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:177.1.text#ὅρμοις ἐκπεπόταμαι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:178.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:178.1.text#τάλαιν', οὐδ' ἱστᾶσα χοροὺς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:179.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:179.1.text#Ἀργείαις ἅμα νύμφαις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:180.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:180.1.text#εἱλικτὸν κρούσω πόδ' ἐμόν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:181.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:181.1.text#δάκρυσι νυχεύω,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:182.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:182.1.text#δακρύων δέ μοι μέλει
urn:cts:greekLit:tlg0006.tlg012.fu.sp:183.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:183.1.text#δειλαίᾳ τὸ κατ' ἦμαρ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:184.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:184.1.text#σκέψαι μου πιναρὰν κόμαν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:185.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:185.1.text#καὶ τρύχη τάδ' ἐμῶν πέπλων,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:186.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:186.1.text#εἰ πρέποντ' Ἀγαμέμνονος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:187.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:187.1.text#κούρᾳ 'σται βασιλείᾳ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:188.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:188.1.text#τᾷ Τροίᾳ θ', ἃ 'μοῦ πατέρος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:189.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:189.1.text#μέμναταί ποθ' ἁλοῦσα.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:190.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:190.1.text#μεγάλα θεός· ἀλλ' ἴθι,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:191.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:191.1.text#καὶ παρ' ἐμοῦ χρῆσαι πολύπηνα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:192.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:192.1.text#φάρεα δῦναι,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:193.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:193.1.text#χρύσεά τε — χαρίσαι — προσθήματ' ἀγλαΐας.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:194.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:194.1.text#δοκεῖς τοῖσι σοῖς δακρύοις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:194.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:194.2.text#μὴ τιμῶσα θεούς, κρατήσειν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:195.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:195.1.text#ἐχθρῶν; οὔτοι στοναχαῖς,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:196.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:196.1.text#ἀλλ' εὐχαῖσι θεοὺς σεβίζουσ'
urn:cts:greekLit:tlg0006.tlg012.fu.sp:197.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:197.1.text#ἕξεις εὐαμερίαν, ὦ παῖ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:198.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:198.1.text#οὐδεὶς θεῶν ἐνοπᾶς κλύει
urn:cts:greekLit:tlg0006.tlg012.fu.sp:199.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:199.1.text#τᾶς δυσδαίμονος, οὐ παλαιῶν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:200.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:200.1.text#πατρὸς σφαγιασμῶν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:201.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:201.1.text#οἴμοι τοῦ καταφθιμένου
urn:cts:greekLit:tlg0006.tlg012.fu.sp:202.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:202.1.text#τοῦ τε ζῶντος ἀλάτα,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:203.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:203.1.text#ὅς που γᾶν ἄλλαν κατέχει,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:204.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:204.1.text#μέλεος ἀλαίνων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:205.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:205.1.text#ποτὶ θῆσσαν ἑστίαν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:206.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:206.1.text#τοῦ κλεινοῦ πατρὸς ἐκφύς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:207.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:207.1.text#αὐτὰ δ' ἐν χερνῆσι δόμοις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:208.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:208.1.text#ναίω ψυχὰν τακομένα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:209.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:209.1.text#δωμάτων πατρίων φυγάς,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:210.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:210.1.text#οὐρείας ἀν' ἐρίπνας.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:211.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:211.1.text#μάτηρ δ' ἐν λέκτροις φονίοις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:212.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:212.1.text#ἄλλῳ σύγγαμος οἰκεῖ.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:213.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:213.1.text#πολλῶν κακῶν Ἕλλησιν αἰτίαν ἔχει
urn:cts:greekLit:tlg0006.tlg012.fu.sp:214.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:214.1.text#σῆς μητρὸς Ἑλένη σύγγονος δόμοις τε σοῖς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:215.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:215.1.text#οἴμοι, γυναῖκες, ἐξέβην θρηνημάτων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:216.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:216.1.text#ξένοι τινὲς παρ' οἶκον οἵδ' ἐφεστίους
urn:cts:greekLit:tlg0006.tlg012.fu.sp:217.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:217.1.text#εὐνὰς ἔχοντες ἐξανίστανται λόχου·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:218.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:218.1.text#φυγῇ σὺ μὲν κατ' οἶμον, ἐς δόμους δ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:219.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:219.1.text#φῶτας κακούργους ἐξαλύξωμεν ποδί.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:220.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:220.1.text#μέν', ὦ τάλαινα· μὴ τρέσῃς ἐμὴν χέρα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:221.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:221.1.text#ὦ Φοῖβ' Ἄπολλον· προσπίτνω σε μὴ θανεῖν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:222.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:222.1.text#ἄλλους κτάνοιμι μᾶλλον ἐχθίους σέθεν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:223.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:223.1.text#ἄπελθε, μὴ ψαῦ' ὧν σε μὴ ψαύειν χρεών.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:224.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:224.1.text#οὐκ ἔσθ' ὅτου θίγοιμ' ἂν ἐνδικώτερον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:225.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:225.1.text#καὶ πῶς ξιφήρης πρὸς δόμοις λοχᾷς ἐμοῖς;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:226.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:226.1.text#μείνασ' ἄκουσον, καὶ τάχ' οὐκ ἄλλως ἐρεῖς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:227.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:227.1.text#ἕστηκα· πάντως δ' εἰμὶ σή· κρείσσων γὰρ εἶ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:228.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:228.1.text#ἥκω φέρων σοι σοῦ κασιγνήτου λόγους.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:229.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:229.1.text#ὦ φίλτατ', ἆρα ζῶντος ἢ τεθνηκότος;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:230.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:230.1.text#ζῇ· πρῶτα γάρ σοι τἀγάθ' ἀγγέλλειν θέλω.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:231.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:231.1.text#εὐδαιμονοίης, μισθὸν ἡδίστων λόγων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:232.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:232.1.text#κοινῇ δίδωμι τοῦτο νῷν ἀμφοῖν ἔχειν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:233.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:233.1.text#ποῦ γῆς ὁ τλήμων τλήμονας φυγὰς ἔχων;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:234.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:234.1.text#οὐχ ἕνα νομίζων φθείρεται πόλεως νόμον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:235.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:235.1.text#οὔ που σπανίζων τοῦ καθ' ἡμέραν βίου;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:236.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:236.1.text#ἔχει μέν, ἀσθενὴς δὲ δὴ φεύγων ἀνήρ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:237.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:237.1.text#λόγον δὲ δὴ τίν' ἦλθες ἐκ κείνου φέρων;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:238.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:238.1.text#εἰ ζῇς, ὅπως τε ζῶσα συμφορᾶς ἔχεις.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:239.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:239.1.text#οὐκοῦν ὁρᾷς μου πρῶτον ὡς ξηρὸν δέμας.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:240.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:240.1.text#λύπαις γε συντετηκός, ὥστε με στένειν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:241.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:241.1.text#καὶ κρᾶτα πλόκαμόν τ' ἐσκυθισμένον ξυρῷ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:242.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:242.1.text#δάκνει σ' ἀδελφὸς ὅ τε θανὼν ἴσως πατήρ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:243.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:243.1.text#οἴμοι, τί γάρ μοι τῶνδέ γ' ἐστὶ φίλτερον;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:244.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:244.1.text#φεῦ φεῦ· τί δαὶ σὺ σῷ κασιγνήτῳ, δοκεῖς;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:245.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:245.1.text#ἀπὼν ἐκεῖνος, οὐ παρὼν ἡμῖν φίλος.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:246.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:246.1.text#ἐκ τοῦ δὲ ναίεις ἐνθάδ' ἄστεως ἑκάς;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:247.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:247.1.text#ἐγημάμεσθ', ὦ ξεῖνε, θανάσιμον γάμον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:248.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:248.1.text#ᾤμωξ' ἀδελφὸν σόν. Μυκηναίων τίνι;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:249.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:249.1.text#οὐχ ᾧ πατήρ μ' ἤλπιζεν ἐκδώσειν ποτέ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:250.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:250.1.text#εἴφ', ὡς ἀκούσας σῷ κασιγνήτῳ λέγω.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:251.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:251.1.text#ἐν τοῖσδ' ἐκείνου τηλορὸς ναίω δόμοις.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:252.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:252.1.text#σκαφεύς τις ἢ βουφορβὸς ἄξιος δόμων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:253.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:253.1.text#πένης ἀνὴρ γενναῖος ἔς τ' ἔμ' εὐσεβής.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:254.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:254.1.text#ἡ δ' εὐσέβεια τίς πρόσεστι σῷ πόσει;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:255.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:255.1.text#οὐπώποτ' εὐνῆς τῆς ἐμῆς ἔτλη θιγεῖν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:256.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:256.1.text#ἅγνευμ' ἔχων τι θεῖον ἤ σ' ἀπαξιῶν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:257.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:257.1.text#γονέας ὑβρίζειν τοὺς ἐμοὺς οὐκ ἠξίου.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:258.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:258.1.text#καὶ πῶς γάμον τοιοῦτον οὐχ ἥσθη λαβών;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:259.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:259.1.text#οὐ κύριον τὸν δόντα μ' ἡγεῖται, ξένε.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:260.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:260.1.text#ξυνῆκ'· Ὀρέστῃ μή ποτ' ἐκτείσῃ δίκην.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:261.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:261.1.text#τοῦτ' αὐτὸ ταρβῶν, πρὸς δὲ καὶ σώφρων ἔφυ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:262.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:262.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:262.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:262.2.text#γενναῖον ἄνδρ' ἔλεξας, εὖ τε δραστέον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:263.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:263.1.text#εἰ δή ποθ' ἥξει γ' ἐς δόμους ὁ νῦν ἀπών.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:264.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:264.1.text#μήτηρ δέ σ' ἡ τεκοῦσα ταῦτ' ἠνέσχετο;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:265.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:265.1.text#γυναῖκες ἀνδρῶν, ὦ ξέν', οὐ παίδων φίλαι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:266.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:266.1.text#τίνος δέ σ' οὕνεχ' ὕβρισ' Αἴγισθος τάδε;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:267.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:267.1.text#τεκεῖν μ' ἐβούλετ' ἀσθενῆ, τοιῷδε δούς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:268.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:268.1.text#ὡς δῆθε παῖδας μὴ τέκοις ποινάτορας;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:269.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:269.1.text#τοιαῦτ' ἐβούλευσ'· ὧν ἐμοὶ δοίη δίκην.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:270.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:270.1.text#οἶδεν δέ σ' οὖσαν παρθένον μητρὸς πόσις;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:271.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:271.1.text#οὐκ οἶδε· σιγῇ τοῦθ' ὑφαιρούμεσθά νιν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:272.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:272.1.text#αἵδ' οὖν φίλαι σοι τούσδ' ἀκούουσιν λόγους;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:273.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:273.1.text#ὥστε στέγειν γε τἀμὰ καὶ σ' ἔπη καλῶς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:274.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:274.1.text#τί δῆτ' Ὀρέστης πρὸς τόδ', Ἄργος ἢν μόλῃ;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:275.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:275.1.text#ἤρου τόδ'; αἰσχρόν γ' εἶπας· οὐ γὰρ νῦν ἀκμή;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:276.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:276.1.text#ἐλθὼν δὲ δὴ πῶς φονέας ἂν κτάνοι πατρός;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:277.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:277.1.text#τολμῶν ὑπ' ἐχθρῶν οἷ' ἐτολμήθη πατήρ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:278.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:278.1.text#ἦ καὶ μετ' αὐτοῦ μητέρ' ἂν τλαίης κτανεῖν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:279.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:279.1.text#ταὐτῷ γε πελέκει τῷ πατὴρ ἀπώλετο.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:280.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:280.1.text#λέγω τάδ' αὐτῷ, καὶ βέβαια τἀπὸ σοῦ;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:281.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:281.1.text#θάνοιμι μητρὸς αἷμ' ἐπισφάξασ' ἐμῆς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:282.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:282.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:282.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:282.2.text#εἴθ' ἦν Ὀρέστης πλησίον κλύων τάδε.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:283.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:283.1.text#ἀλλ', ὦ ξέν', οὐ γνοίην ἂν εἰσιδοῦσά νιν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:284.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:284.1.text#νέα γάρ, οὐδὲν θαῦμ', ἀπεζεύχθης νέου.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:285.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:285.1.text#εἷς ἂν μόνος νιν τῶν ἐμῶν γνοίη φίλων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:286.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:286.1.text#ἆρ' ὃν λέγουσιν αὐτὸν ἐκκλέψαι φόνου;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:287.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:287.1.text#πατρός γε παιδαγωγὸς ἀρχαῖος γέρων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:288.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:288.1.text#ὁ κατθανὼν δὲ σὸς πατὴρ τύμβου κυρεῖ;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:289.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:289.1.text#ἔκυρσεν ὡς ἔκυρσεν, ἐκβληθεὶς δόμων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:290.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:290.1.text#οἴμοι, τόδ' οἷον εἶπας· — αἴσθησις γὰρ οὖν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:291.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:291.1.text#κἀκ τῶν θυραίων πημάτων δάκνει βροτούς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:292.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:292.1.text#λέξον δ', ἵν' εἰδὼς σῷ κασιγνήτῳ φέρω
urn:cts:greekLit:tlg0006.tlg012.fu.sp:293.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:293.1.text#λόγους ἀτερπεῖς, ἀλλ' ἀναγκαίους κλύειν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:294.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:294.1.text#ἔνεστι δ' οἶκτος ἀμαθίᾳ μὲν οὐδαμοῦ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:295.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:295.1.text#σοφοῖσι δ' ἀνδρῶν· καὶ γὰρ οὐδ' ἀζήμιον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:296.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:296.1.text#γνώμην ἐνεῖναι τοῖς σοφοῖς λίαν σοφήν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:297.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:297.1.text#κἀγὼ τὸν αὐτὸν τῷδ' ἔρον ψυχῆς ἔχω.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:298.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:298.1.text#πρόσω γὰρ ἄστεως οὖσα τἀν πόλει κακὰ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:299.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:299.1.text#οὐκ οἶδα, νῦν δὲ βούλομαι κἀγὼ μαθεῖν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:300.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:300.1.text#λέγοιμ' ἄν, εἰ χρή — χρὴ δὲ πρὸς φίλον λέγειν —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:301.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:301.1.text#τύχας βαρείας τὰς ἐμὰς κἀμοῦ πατρός.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:302.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:302.1.text#ἐπεὶ δὲ κινεῖς μῦθον, ἱκετεύω, ξένε,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:303.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:303.1.text#ἄγγελλ' Ὀρέστῃ τἀμὰ καὶ κείνου κακά,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:304.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:304.1.text#πρῶτον μὲν οἵοις ἐν πέπλοις αὐλίζομαι,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:305.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:305.1.text#πίνῳ θ' ὅσῳ βέβριθ', ὑπὸ στέγαισί τε
urn:cts:greekLit:tlg0006.tlg012.fu.sp:306.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:306.1.text#οἵαισι ναίω βασιλικῶν ἐκ δωμάτων,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:307.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:307.1.text#αὐτὴ μὲν ἐκμοχθοῦσα κερκίσιν πέπλους,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:308.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:308.1.text#ἢ γυμνὸν ἕξω σῶμα κἀστερήσομαι,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:309.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:309.1.text#αὐτὴ δὲ πηγὰς ποταμίους φορουμένη,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:310.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:310.1.text#ἀνέορτος ἱερῶν καὶ χορῶν τητωμένη.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:311.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:311.1.text#ἀναίνομαι γυναῖκας οὖσα παρθένος,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:312.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:312.1.text#ἀναίνομαι δὲ Κάστορ', ᾧ πρὶν ἐς θεοὺς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:313.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:313.1.text#ἐλθεῖν ἔμ' ἐμνήστευον, οὖσαν ἐγγενῆ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:314.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:314.1.text#μήτηρ δ' ἐμὴ Φρυγίοισιν ἐν σκυλεύμασιν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:315.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:315.1.text#θρόνῳ κάθηται, πρὸς δ' ἕδραισιν Ἀσίδες
urn:cts:greekLit:tlg0006.tlg012.fu.sp:316.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:316.1.text#δμωαὶ στατίζουσ', ἃς ἔπερσ' ἐμὸς πατήρ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:317.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:317.1.text#Ἰδαῖα φάρη χρυσέαις ἐζευγμέναι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:318.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:318.1.text#πόρπαισιν. αἷμα δ' ἔτι πατρὸς κατὰ στέγας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:319.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:319.1.text#μέλαν σέσηπεν, ὃς δ' ἐκεῖνον ἔκτανεν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:320.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:320.1.text#ἐς ταὐτὰ βαίνων ἅρματ' ἐκφοιτᾷ πατρί,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:321.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:321.1.text#καὶ σκῆπτρ' ἐν οἷς Ἕλλησιν ἐστρατηλάτει
urn:cts:greekLit:tlg0006.tlg012.fu.sp:322.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:322.1.text#μιαιφόνοισι χερσὶ γαυροῦται λαβών.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:323.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:323.1.text#Ἀγαμέμνονος δὲ τύμβος ἠτιμασμένος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:324.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:324.1.text#οὔπω χοάς ποτ' οὐδὲ κλῶνα μυρσίνης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:325.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:325.1.text#ἔλαβε, πυρὰ δὲ χέρσος ἀγλαϊσμάτων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:326.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:326.1.text#μέθῃ δὲ βρεχθεὶς τῆς ἐμῆς μητρὸς πόσις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:327.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:327.1.text#ὁ κλεινός, ὡς λέγουσιν, ἐνθρῴσκει τάφῳ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:328.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:328.1.text#πέτροις τε λεύει μνῆμα λάινον πατρός,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:329.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:329.1.text#καὶ τοῦτο τολμᾷ τοὔπος εἰς ἡμᾶς λέγειν·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:330.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:330.1.text#ποῦ παῖς Ὀρέστης; ἆρά σοι τύμβῳ καλῶς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:331.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:331.1.text#παρὼν ἀμύνει;  — ταῦτ' ἀπὼν ὑβρίζεται.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:332.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:332.1.text#ἀλλ', ὦ ξέν', ἱκετεύω σ', ἀπάγγειλον τάδε.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:333.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:333.1.text#πολλοὶ δ' ἐπιστέλλουσιν, ἑρμηνεὺς δ' ἐγώ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:334.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:334.1.text#αἱ χεῖρες ἡ γλῶσσ' ἡ ταλαίπωρός τε φρήν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:335.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:335.1.text#κάρα τ' ἐμὸν ξυρῆκες, ὅ τ' ἐκεῖνον τεκών.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:336.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:336.1.text#αἰσχρὸν γάρ, εἰ πατὴρ μὲν ἐξεῖλεν Φρύγας,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:337.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:337.1.text#ὁ δ' ἄνδρ' ἕν' εἷς ὢν οὐ δυνήσεται κτανεῖν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:338.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:338.1.text#νέος πεφυκὼς κἀξ ἀμείνονος πατρός.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:339.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:339.1.text#καὶ μὴν δέδορκα τόνδε, σὸν λέγω πόσιν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:340.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:340.1.text#λήξαντα μόχθου πρὸς δόμους ὡρμημένον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:341.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:341.1.text#ἔα· τίνας τούσδ' ἐν πύλαις ὁρῶ ξένους;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:342.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:342.1.text#τίνος δ' ἕκατι τάσδ' ἐπ' ἀγραύλους πύλας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:343.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:343.1.text#προσῆλθον; ἦ 'μοῦ δεόμενοι; γυναικί τοι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:344.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:344.1.text#αἰσχρὸν μετ' ἀνδρῶν ἑστάναι νεανιῶν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:345.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:345.1.text#ὦ φίλτατ', εἰς ὕποπτα μὴ μόλῃς ἐμοί·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:346.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:346.1.text#τὸν ὄντα δ' εἴσῃ μῦθον· οἵδε γὰρ ξένοι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:347.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:347.1.text#ἥκουσ' Ὀρέστου πρός με κήρυκες λόγων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:348.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:348.1.text#ἀλλ', ὦ ξένοι, σύγγνωτε τοῖς εἰρημένοις.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:349.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:349.1.text#τί φασίν; ἁνὴρ ἔστι καὶ λεύσσει φάος;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:350.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:350.1.text#ἔστιν λόγῳ γοῦν, φασὶ δ' οὐκ ἄπιστ' ἐμοί.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:351.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:351.1.text#ἦ καί τι πατρὸς σῶν τε μέμνηται κακῶν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:352.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:352.1.text#ἐν ἐλπίσιν ταῦτ'· ἀσθενὴς φεύγων ἀνήρ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:353.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:353.1.text#ἦλθον δ' Ὀρέστου τίν' ἀγορεύοντες λόγον;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:354.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:354.1.text#σκοποὺς ἔπεμψε τούσδε τῶν ἐμῶν κακῶν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:355.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:355.1.text#οὐκοῦν τὰ μὲν λεύσσουσι, τὰ δὲ σύ που λέγεις.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:356.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:356.1.text#ἴσασιν, οὐδὲν τῶνδ' ἔχουσιν ἐνδεές.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:357.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:357.1.text#οὐκοῦν πάλαι χρῆν τοῖσδ' ἀνεπτύχθαι πύλας;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:358.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:358.1.text#χωρεῖτ' ἐς οἴκους· ἀντὶ γὰρ χρηστῶν λόγων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:359.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:359.1.text#ξενίων κυρήσεθ', οἷ' ἐμὸς κεύθει δόμος.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:360.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:360.1.text#αἴρεσθ', ὀπαδοί, τῶνδ' ἔσω τεύχη δόμων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:361.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:361.1.text#καὶ μηδὲν ἀντείπητε, παρὰ φίλου φίλοι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:362.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:362.1.text#μολόντες ἀνδρός· καὶ γὰρ εἰ πένης ἔφυν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:363.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:363.1.text#οὔτοι τό γ' ἦθος δυσγενὲς παρέξομαι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:364.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:364.1.text#πρὸς θεῶν, ὅδ' ἁνὴρ ὃς συνεκκλέπτει γάμους
urn:cts:greekLit:tlg0006.tlg012.fu.sp:365.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:365.1.text#τοὺς σούς, Ὀρέστην οὐ καταισχύνειν θέλων;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:366.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:366.1.text#οὗτος κέκληται πόσις ἐμὸς τῆς ἀθλίας.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:367.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:367.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:367.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:367.2.text#οὐκ ἔστ' ἀκριβὲς οὐδὲν εἰς εὐανδρίαν·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:368.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:368.1.text#ἔχουσι γὰρ ταραγμὸν αἱ φύσεις βροτῶν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:369.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:369.1.text#ἤδη γὰρ εἶδον ἄνδρα γενναίου πατρὸς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:370.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:370.1.text#τὸ μηδὲν ὄντα, χρηστά τ' ἐκ κακῶν τέκνα,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:371.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:371.1.text#λιμόν τ' ἐν ἀνδρὸς πλουσίου φρονήματι,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:372.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:372.1.text#γνώμην τε μεγάλην ἐν πένητι σώματι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:373.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:373.1.text#πῶς οὖν τις αὐτὰ διαλαβὼν ὀρθῶς κρινεῖ;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:374.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:374.1.text#πλούτῳ; πονηρῷ τἄρα χρήσεται κριτῇ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:375.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:375.1.text#ἢ τοῖς ἔχουσι μηδέν; ἀλλ' ἔχει νόσον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:376.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:376.1.text#πενία, διδάσκει δ' ἄνδρα τῇ χρείᾳ κακόν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:377.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:377.1.text#ἀλλ' εἰς ὅπλ' ἔλθω; τίς δὲ πρὸς λόγχην βλέπων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:378.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:378.1.text#μάρτυς γένοιτ' ἂν ὅστις ἐστὶν ἁγαθός;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:379.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:379.1.text#κράτιστον εἰκῇ ταῦτ' ἐᾶν ἀφειμένα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:380.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:380.1.text#οὗτος γὰρ ἁνὴρ οὔτ' ἐν Ἀργείοις μέγας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:381.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:381.1.text#οὔτ' αὖ δοκήσει δωμάτων ὠγκωμένος,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:382.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:382.1.text#ἐν τοῖς δὲ πολλοῖς ὤν, ἄριστος ηὑρέθη.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:383.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:383.1.text#οὐ μὴ ἀφρονήσεθ', οἳ κενῶν δοξασμάτων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:384.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:384.1.text#πλήρεις πλανᾶσθε, τῇ δ' ὁμιλίᾳ βροτοὺς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:385.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:385.1.text#κρινεῖτε καὶ τοῖς ἤθεσιν τοὺς εὐγενεῖς;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:386.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:386.1.text#οἱ γὰρ τοιοῦτοι καὶ πόλεις οἰκοῦσιν εὖ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:387.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:387.1.text#καὶ δώμαθ'· αἱ δὲ σάρκες αἱ κεναὶ φρενῶν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:388.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:388.1.text#ἀγάλματ' ἀγορᾶς εἰσιν. οὐδὲ γὰρ δόρυ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:389.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:389.1.text#μᾶλλον βραχίων σθεναρὸς ἀσθενοῦς μένει·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:390.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:390.1.text#ἐν τῇ φύσει δὲ τοῦτο κἀν εὐψυχίᾳ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:391.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:391.1.text#ἀλλ' — ἄξιος γὰρ ὅ τε παρὼν ὅ τ' οὐ παρὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:392.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:392.1.text#Ἀγαμέμνονος παῖς, οὗπερ οὕνεχ' ἥκομεν —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:393.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:393.1.text#δεξώμεθ' οἴκων καταλύσεις. χωρεῖν χρεών,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:394.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:394.1.text#δμῶες, δόμων τῶνδ' ἐντός. ὡς ἐμοὶ πένης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:395.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:395.1.text#εἴη πρόθυμος πλουσίου μᾶλλον ξένος.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:396.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:396.1.text#αἰνῶ μὲν οὖν τοῦδ' ἀνδρὸς ἐσδοχὰς δόμων,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:397.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:397.1.text#ἐβουλόμην δ' ἄν, εἰ κασίγνητός με σὸς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:398.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:398.1.text#ἐς εὐτυχοῦντας ἦγεν εὐτυχῶν δόμους.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:399.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:399.1.text#ἴσως δ' ἂν ἔλθοι· Λοξίου γὰρ ἔμπεδοι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:400.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:400.1.text#χρησμοί, βροτῶν δὲ μαντικὴν χαίρειν ἐῶ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:401.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:401.1.text#νῦν ἢ πάροιθεν μᾶλλον, Ἠλέκτρα, χαρᾷ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:402.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:402.1.text#θερμαινόμεσθα καρδίαν· ἴσως γὰρ ἂν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:403.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:403.1.text#μόλις προβαίνουσ' ἡ τύχη σταίη καλῶς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:404.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:404.1.text#ὦ τλῆμον, εἰδὼς δωμάτων χρείαν σέθεν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:405.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:405.1.text#τί τούσδ' ἐδέξω μείζονας σαυτοῦ ξένους;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:406.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:406.1.text#τί δ'; εἴπερ εἰσὶν ὡς δοκοῦσιν εὐγενεῖς,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:407.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:407.1.text#οὐκ ἔν τε μικροῖς ἔν τε μὴ στέρξουσ' ὁμῶς;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:408.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:408.1.text#ἐπεί νυν ἐξήμαρτες ἐν σμικροῖσιν ὤν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:409.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:409.1.text#ἔλθ' ὡς παλαιὸν τροφὸν ἐμοῦ φίλον πατρός,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:410.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:410.1.text#ὃς ἀμφὶ ποταμὸν Τάναον Ἀργείας ὅρους
urn:cts:greekLit:tlg0006.tlg012.fu.sp:411.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:411.1.text#τέμνοντα γαίας Σπαρτιάτιδός τε γῆς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:412.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:412.1.text#ποίμναις ὁμαρτεῖ πόλεος ἐκβεβλημένος·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:413.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:413.1.text#κέλευε δ' αὐτὸν τῶνδ' ἐμοὐσαφιγμένων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:414.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:414.1.text#ἐλθεῖν, ξένων τ' ἐς δαῖτα πορσῦναί τινα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:415.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:415.1.text#ἡσθήσεταί τοι καὶ προσεύξεται θεοῖς,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:416.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:416.1.text#ζῶντ' εἰσακούσας παῖδ' ὃν ἐκσῴζει ποτέ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:417.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:417.1.text#οὐ γὰρ πατρῴων ἐκ δόμων μητρὸς πάρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:418.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:418.1.text#λάβοιμεν ἄν τι· πικρὰ δ' ἀγγείλαιμεν ἄν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:419.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:419.1.text#εἰ ζῶντ' Ὀρέστην ἡ τάλαιν' αἴσθοιτ' ἔτι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:420.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:420.1.text#ἀλλ', εἰ δοκεῖ σοι, τούσδ' ἀπαγγελῶ λόγους
urn:cts:greekLit:tlg0006.tlg012.fu.sp:421.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:421.1.text#γέροντι· χώρει δ' ἐς δόμους ὅσον τάχος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:422.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:422.1.text#καὶ τἄνδον ἐξάρτυε. πολλά τοι γυνὴ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:423.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:423.1.text#χρῄζουσ' ἂν εὕροι δαιτὶ προσφορήματα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:424.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:424.1.text#ἔστιν δὲ δὴ τοσαῦτά γ' ἐν δόμοις ἔτι,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:425.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:425.1.text#ὥσθ' ἕν γ' ἐπ' ἦμαρ τούσδε πληρῶσαι βορᾶς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:426.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:426.1.text#ἐν τοῖς τοιούτοις δ' ἡνίκ' ἂν γνώμης πέσω,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:427.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:427.1.text#σκοπῶ τὰ χρήμαθ' ὡς ἔχει μέγα σθένος,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:428.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:428.1.text#ξένοις τε δοῦναι σῶμά τ' ἐς νόσους πεσὸν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:429.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:429.1.text#δαπάναισι σῷσαι· τῆς δ' ἐφ' ἡμέραν βορᾶς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:430.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:430.1.text#ἐς σμικρὸν ἥκει· πᾶς γὰρ ἐμπλησθεὶς ἀνὴρ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:431.1.speaker#Αὐτουργός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:431.1.text#ὁ πλούσιός τε χὡ πένης ἴσον φέρει.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:432.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:432.1.text#κλειναὶ νᾶες, αἵ ποτ' ἔβατε Τροίαν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:433.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:433.1.text#τοῖς ἀμετρήτοις ἐρετμοῖς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:434.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:434.1.text#πέμπουσαι χοροὺς μετὰ Νηρῄδων,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:435.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:435.1.text#ἵν' ὁ φίλαυλος ἔπαλλε δελφὶς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:436.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:436.1.text#πρῴραις κυανεμβόλοισιν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:437.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:437.1.text#εἱλισσόμενος,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:438.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:438.1.text#πορεύων τὸν τᾶς Θέτιδος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:439.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:439.1.text#κοῦφον ἅλμα ποδῶν Ἀχιλῆ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:440.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:440.1.text#σὺν Ἀγαμέμνονι Τρωίας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:441.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:441.1.text#ἐπὶ Σιμουντίδας ἀκτάς.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:442.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:442.1.text#Νηρῇδες δ' Εὐβοῖδας ἄκρας λιποῦσαι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:443.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:443.1.text#μόχθους ἀσπιστὰς ἀκμόνων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:444.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:444.1.text#Ἡφαίστου χρυσέων ἔφερον τευχέων,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:445.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:445.1.text#ἀνά τε Πήλιον ἀνά τε πρυμνὰς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:446.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:446.1.text#Ὄσσας ἱερᾶς νάπας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:447.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:447.1.text#{ Νυμφαίας σκοπιὰς }
urn:cts:greekLit:tlg0006.tlg012.fu.sp:448.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:448.1.text#{ κόρας μάτευσ', } ἔνθα πατὴρ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:449.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:449.1.text#ἱππότας τρέφεν Ἑλλάδι φῶς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:450.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:450.1.text#Θέτιδος εἰνάλιον γόνον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:451.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:451.1.text#ταχύπορον πόδ' Ἀτρείδαις.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:452.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:452.1.text#Ἰλιόθεν δ' ἔκλυόν τινος ἐν λιμέσιν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:453.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:453.1.text#Ναυπλίοισι βεβῶτος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:454.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:454.1.text#τᾶς σᾶς, ὦ Θέτιδος παῖ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:455.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:455.1.text#κλεινᾶς ἀσπίδος ἐν κύκλῳ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:456.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:456.1.text#τοιάδε σήματα, δείματα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:457.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:457.1.text#Φρύγια, τετύχθαι·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:458.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:458.1.text#περιδρόμῳ μὲν ἴτυος ἕδρᾳ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:459.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:459.1.text#Περσέα λαιμοτόμαν ὑπὲρ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:460.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:460.1.text#ἁλὸς ποτανοῖσι πεδίλοισι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:461.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:461.1.text#φυὰν Γοργόνος ἴσχειν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:462.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:462.1.text#Διὸς ἀγγέλῳ σὺν Ἑρμᾷ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:463.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:463.1.text#τῷ Μαίας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:463.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:463.2.text#ἀγροτῆρι κούρῳ·[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:464.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:464.1.text#ἐν δὲ μέσῳ κατέλαμπε σάκει φαέθων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:465.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:465.1.text#κύκλος ἀελίοιο
urn:cts:greekLit:tlg0006.tlg012.fu.sp:466.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:466.1.text#ἵπποις ἂμ πτεροέσσαις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:467.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:467.1.text#ἄστρων τ' αἰθέριοι χοροί,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:468.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:468.1.text#Πλειάδες, Ὑάδες, Ἕκτορος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:469.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:469.1.text#ὄμμασι τροπαῖοι·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:470.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:470.1.text#ἐπὶ δὲ χρυσοτύπῳ κράνει
urn:cts:greekLit:tlg0006.tlg012.fu.sp:471.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:471.1.text#Σφίγγες ὄνυξιν ἀοίδιμον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:472.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:472.1.text#ἄγραν φέρουσαι· περιπλεύρῳ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:473.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:473.1.text#δὲ κύτει πύρπνοος ἔσπευδε
urn:cts:greekLit:tlg0006.tlg012.fu.sp:474.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:474.1.text#δρόμῳ λέαινα χαλαῖς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:474.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:474.2.text#Πειρηναῖον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:475.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:475.1.text#ὁρῶσα πῶλον.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:476.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:476.1.text#ἄορι δ' ἐν φονίῳ τετραβάμονες ἵπποι ἔπαλλον,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:477.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:477.1.text#κελαινὰ δ' ἀμφὶ νῶθ' ἵετο κόνις.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:479.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:479.1.text#τοιῶνδ' ἄνακτα δοριπόνων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:480.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:480.1.text#ἔκανεν ἀνδρῶν, Τυνδαρίς,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:481.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:481.1.text#σὰ λέχεα, κακόφρων κούρα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:483.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:483.1.text#τοιγάρ σέ ποτ' οὐρανίδαι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:484.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:484.1.text#πέμψουσιν θανάτοις· ἦ σὰν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:485.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:485.1.text#ἔτ' ἔτι φόνιον ὑπὸ δέραν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:486.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:486.1.text#ὄψομαι αἷμα χυθὲν σιδάρῳ.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:487.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:487.1.text#ποῦ ποῦ νεᾶνις πότνι' ἐμὴ δέσποινά τε,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:488.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:488.1.text#Ἀγαμέμνονος παῖς, ὅν ποτ' ἐξέθρεψ' ἐγώ;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:489.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:489.1.text#ὡς πρόσβασιν τῶνδ' ὀρθίαν οἴκων ἔχει
urn:cts:greekLit:tlg0006.tlg012.fu.sp:490.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:490.1.text#ῥυσῷ γέροντι τῷδε προσβῆναι ποδί.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:491.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:491.1.text#ὅμως δὲ πρός γε τοὺς φίλους ἐξελκτέον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:492.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:492.1.text#διπλῆν ἄκανθαν καὶ παλίρροπον γόνυ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:493.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:493.1.text#ὦ θύγατερ — ἄρτι γάρ σε πρὸς δόμοις ὁρῶ —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:494.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:494.1.text#ἥκω φέρων σοι τῶν ἐμῶν βοσκημάτων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:495.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:495.1.text#ποίμνης νεογνὸν θρέμμ' ὑποσπάσας τόδε
urn:cts:greekLit:tlg0006.tlg012.fu.sp:496.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:496.1.text#στεφάνους τε τευχέων τ' ἐξελὼν τυρεύματα,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:497.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:497.1.text#παλαιόν τε θησαύρισμα Διονύσου τόδε
urn:cts:greekLit:tlg0006.tlg012.fu.sp:498.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:498.1.text#ὀσμῇ κατῆρες, μικρόν, ἀλλ' ἐπεσβαλεῖν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:499.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:499.1.text#ἡδὺ σκύφον τοῦδ' ἀσθενεστέρῳ ποτῷ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:500.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:500.1.text#ἴτω φέρων τις τοῖς ξένοις τάδ' ἐς δόμους·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:501.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:501.1.text#ἐγὼ δὲ τρύχει τῷδ' ἐμῶν πέπλων κόρας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:502.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:502.1.text#δακρύοισι τέγξας ἐξομόρξασθαι θέλω.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:503.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:503.1.text#τί δ', ὦ γεραιέ, διάβροχον τόδ' ὄμμ' ἔχεις;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:504.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:504.1.text#μῶν τἀμὰ διὰ χρόνου σ' ἀνέμνησεν κακά;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:505.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:505.1.text#ἢ τὰς Ὀρέστου τλήμονας φυγὰς στένεις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:506.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:506.1.text#καὶ πατέρα τὸν ἐμόν, ὅν ποτ' ἐν χεροῖν ἔχων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:507.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:507.1.text#ἀνόνητ' ἔθρεψας σοί τε καὶ τοῖς σοῖς φίλοις;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:508.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:508.1.text#ἀνόνηθ'· ὅμως δ' οὖν τοῦτό γ' οὐκ ἠνεσχόμην.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:509.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:509.1.text#ἦλθον γὰρ αὐτοῦ πρὸς τάφον πάρεργ' ὁδοῦ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:510.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:510.1.text#καὶ προσπεσὼν ἔκλαυσ' ἐρημίας τυχών,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:511.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:511.1.text#σπονδάς τε, λύσας ἀσκὸν ὃν φέρω ξένοις,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:512.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:512.1.text#ἔσπεισα, τύμβῳ δ' ἀμφέθηκα μυρσίνας.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:513.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:513.1.text#πυρᾶς δ' ἐπ' αὐτῆς οἶν μελάγχιμον πόκῳ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:514.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:514.1.text#σφάγιον ἐσεῖδον αἷμά τ' οὐ πάλαι χυθὲν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:515.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:515.1.text#ξανθῆς τε χαίτης βοστρύχους κεκαρμένους.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:516.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:516.1.text#κἀθαύμασ', ὦ παῖ, τίς ποτ' ἀνθρώπων ἔτλη
urn:cts:greekLit:tlg0006.tlg012.fu.sp:517.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:517.1.text#πρὸς τύμβον ἐλθεῖν· οὐ γὰρ Ἀργείων γέ τις.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:518.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:518.1.text#ἀλλ' ἦλθ' ἴσως που σὸς κασίγνητος λάθρᾳ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:519.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:519.1.text#μολὼν δ' ἐθαύμασ' ἄθλιον τύμβον πατρός.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:520.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:520.1.text#σκέψαι δὲ χαίτην προστιθεῖσα σῇ κόμῃ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:521.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:521.1.text#εἰ χρῶμα ταὐτὸν κουρίμης ἔσται τριχός·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:522.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:522.1.text#φιλεῖ γάρ, αἷμα ταὐτὸν οἷς ἂν ᾖ πατρός,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:523.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:523.1.text#τὰ πόλλ' ὅμοια σώματος πεφυκέναι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:524.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:524.1.text#οὐκ ἄξι' ἀνδρός, ὦ γέρον, σοφοῦ λέγεις,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:525.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:525.1.text#εἰ κρυπτὸν ἐς γῆν τήνδ' ἂν Αἰγίσθου φόβῳ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:526.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:526.1.text#δοκεῖς ἀδελφὸν τὸν ἐμὸν εὐθαρσῆ μολεῖν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:527.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:527.1.text#ἔπειτα χαίτης πῶς συνοίσεται πλόκος,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:528.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:528.1.text#ὁ μὲν παλαίστραις ἀνδρὸς εὐγενοῦς τραφείς,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:529.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:529.1.text#ὁ δὲ κτενισμοῖς θῆλυς; ἀλλ' ἀμήχανον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:530.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:530.1.text#πολλοῖς δ' ἂν εὕροις βοστρύχους ὁμοπτέρους
urn:cts:greekLit:tlg0006.tlg012.fu.sp:531.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:531.1.text#καὶ μὴ γεγῶσιν αἵματος ταὐτοῦ, γέρον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:532.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:532.1.text#σὺ δ' εἰς ἴχνος βᾶσ' ἀρβύλης σκέψαι βάσιν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:533.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:533.1.text#εἰ σύμμετρος σῷ ποδὶ γενήσεται, τέκνον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:534.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:534.1.text#πῶς δ' ἂν γένοιτ' ἂν ἐν κραταιλέῳ πέδῳ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:535.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:535.1.text#γαίας ποδῶν ἔκμακτρον; εἰ δ' ἔστιν τόδε,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:536.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:536.1.text#δυοῖν ἀδελφοῖν ποὺς ἂν οὐ γένοιτ' ἴσος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:537.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:537.1.text#ἀνδρός τε καὶ γυναικός, ἀλλ' ἅρσην κρατεῖ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:538.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:538.1.text#οὐκ ἔστιν, εἰ καὶ γῆν κασίγνητος μολών,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:538.2.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:538.2.text#[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:539.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:539.1.text#κερκίδος ὅτῳ γνοίης ἂν ἐξύφασμα σῆς,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:540.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:540.1.text#ἐν ᾧ ποτ' αὐτὸν ἐξέκλεψα μὴ θανεῖν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:541.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:541.1.text#οὐκ οἶσθ', Ὀρέστης ἡνίκ' ἐκπίπτει χθονός,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:542.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:542.1.text#νέαν μ' ἔτ' οὖσαν; εἰ δὲ κἄκρεκον πέπλους,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:543.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:543.1.text#πῶς ἂν τότ' ὢν παῖς ταὐτὰ νῦν ἔχοι φάρη,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:544.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:544.1.text#εἰ μὴ ξυναύξοινθ' οἱ πέπλοι τῷ σώματι;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:545.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:545.1.text#ἀλλ' ἤ τις αὐτοῦ τάφον ἐποικτίρας ξένος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:546.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:546.1.text#{ ἐκείρατ', ἢ τῆσδε σκοποὺς λαβὼν χθονὸς —  }
urn:cts:greekLit:tlg0006.tlg012.fu.sp:547.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:547.1.text#οἱ δὲ ξένοι ποῦ; βούλομαι γὰρ εἰσιδὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:548.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:548.1.text#αὐτοὺς ἔρεσθαι σοῦ κασιγνήτου πέρι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:549.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:549.1.text#οἵδ' ἐκ δόμων βαίνουσι λαιψηρῷ ποδί.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:550.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:550.1.text#ἀλλ' εὐγενεῖς μέν, ἐν δὲ κιβδήλῳ τόδε·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:551.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:551.1.text#πολλοὶ γὰρ ὄντες εὐγενεῖς εἰσιν κακοί.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:552.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:552.1.text#ὅμως δέ.  — χαίρειν τοὺς ξένους προσεννέπω.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:553.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:553.1.text#χαῖρ', ὦ γεραιέ.  — τοῦ ποτ', Ἠλέκτρα, τόδε
urn:cts:greekLit:tlg0006.tlg012.fu.sp:554.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:554.1.text#παλαιὸν ἀνδρὸς λείψανον φίλων κυρεῖ;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:555.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:555.1.text#οὗτος τὸν ἁμὸν πατέρ' ἔθρεψεν, ὦ ξένε.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:556.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:556.1.text#τί φῄς; ὅδ' ὃς σὸν ἐξέκλεψε σύγγονον;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:557.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:557.1.text#ὅδ' ἔσθ' ὁ σώσας κεῖνον, εἴπερ ἔστ' ἔτι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:558.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:558.1.text#ἔα·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:558.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:558.2.text#τί μ' ἐσδέδορκεν ὥσπερ ἀργύρου σκοπῶν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:559.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:559.1.text#λαμπρὸν χαρακτῆρ'; ἢ προσεικάζει μέ τῳ;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:560.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:560.1.text#ἴσως Ὀρέστου σ' ἥλιχ' ἥδεται βλέπων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:561.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:561.1.text#φίλου γε φωτός. τί δὲ κυκλεῖ πέριξ πόδα;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:562.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:562.1.text#καὐτὴ τόδ' εἰσορῶσα θαυμάζω, ξένε.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:563.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:563.1.text#ὦ πότνι', εὔχου, θύγατερ Ἠλέκτρα, θεοῖς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:564.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:564.1.text#τί τῶν ἀπόντων ἢ τί τῶν ὄντων πέρι;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:565.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:565.1.text#λαβεῖν φίλον θησαυρόν, ὃν φαίνει θεός.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:566.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:566.1.text#ἰδού· καλῶ θεούς. ἢ τί δὴ λέγεις, γέρον;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:567.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:567.1.text#βλέψον νυν ἐς τόνδ', ὦ τέκνον, τὸν φίλτατον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:568.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:568.1.text#πάλαι δέδορκα, μὴ σύ γ' οὐκέτ' εὖ φρονῇς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:569.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:569.1.text#οὐκ εὖ φρονῶ 'γὼ σὸν κασίγνητον βλέπων;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:570.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:570.1.text#πῶς εἶπας, ὦ γεραί', ἀνέλπιστον λόγον;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:571.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:571.1.text#ὁρᾶν Ὀρέστην τόνδε τὸν Ἀγαμέμνονος.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:572.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:572.1.text#ποῖον χαρακτῆρ' εἰσιδών, ᾧ πείσομαι;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:573.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:573.1.text#οὐλὴν παρ' ὀφρύν, ἥν ποτ' ἐν πατρὸς δόμοις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:574.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:574.1.text#νεβρὸν διώκων σοῦ μέθ' ᾑμάχθη πεσών.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:575.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:575.1.text#πῶς φῄς; ὁρῶ μὲν πτώματος τεκμήριον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:576.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:576.1.text#ἔπειτα μέλλεις προσπίτνειν τοῖς φιλτάτοις;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:577.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:577.1.text#ἀλλ' οὐκέτ', ὦ γεραιέ· συμβόλοισι γὰρ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:578.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:578.1.text#τοῖς σοῖς πέπεισμαι θυμόν.  — ὦ χρόνῳ φανείς,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:579.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:579.1.text#ἔχω σ' ἀέλπτως —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:579.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:579.2.text#κἀξ ἐμοῦ γ' ἔχῃ χρόνῳ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:580.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:580.1.text#οὐδέποτε δόξασα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:580.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:580.2.text#οὐδ' ἐγὼ γὰρ ἤλπισα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:581.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:581.1.text#ἐκεῖνος εἶ σύ;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:581.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:581.2.text#σύμμαχός γέ σοι μόνος.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:582.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:582.1.text#ἢν δ' ἀνσπάσωμαί γ' ὃν μετέρχομαι βόλον —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:583.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:583.1.text#πέποιθα δ'· ἢ χρὴ μηκέθ' ἡγεῖσθαι θεούς,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:584.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:584.1.text#εἰ τἄδικ' ἔσται τῆς δίκης ὑπέρτερα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:585.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:585.1.text#ἔμολες ἔμολες, ὤ, χρόνιος ἁμέρα,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:586.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:586.1.text#κατέλαμψας, ἔδειξας ἐμφανῆ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:587.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:587.1.text#πόλει πυρσόν, ὃς παλαιᾷ φυγᾷ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:588.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:588.1.text#πατρίων ἀπὸ δωμάτων τάλας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:589.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:589.1.text#ἀλαίνων ἔβα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:590.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:590.1.text#θεὸς αὖ θεὸς ἁμετέραν τις ἄγει
urn:cts:greekLit:tlg0006.tlg012.fu.sp:591.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:591.1.text#νίκαν, ὦ φίλα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:592.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:592.1.text#ἄνεχε χέρας, ἄνεχε λόγον, ἵει λιτὰς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:593.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:593.1.text#ἐς θεούς, τύχᾳ σοι τύχᾳ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:595.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:595.1.text#κασίγνητον ἐμβατεῦσαι πόλιν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:596.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:596.1.text#εἶἑν· φίλας μὲν ἡδονὰς ἀσπασμάτων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:597.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:597.1.text#ἔχω, χρόνῳ δὲ καὖθις αὐτὰ δώσομεν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:598.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:598.1.text#σὺ δ', ὦ γεραιέ — καίριος γὰρ ἤλυθες —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:599.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:599.1.text#λέξον, τί δρῶν ἂν φονέα τεισαίμην πατρός;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:600.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:600.1.text#[ μητέρα τε κοινωνὸν ἀνοσίων γάμων; ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:601.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:601.1.text#ἔστιν τί μοι κατ' Ἄργος εὐμενὲς φίλων;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:602.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:602.1.text#ἢ πάντ' ἀνεσκευάσμεθ', ὥσπερ αἱ τύχαι;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:603.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:603.1.text#τῷ ξυγγένωμαι; νύχιος ἢ καθ' ἡμέραν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:604.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:604.1.text#ποίαν ὁδὸν τραπώμεθ' εἰς ἐχθροὺς ἐμούς;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:605.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:605.1.text#ὦ τέκνον, οὐδεὶς δυστυχοῦντί σοι φίλος.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:606.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:606.1.text#εὕρημα γάρ τοι χρῆμα γίγνεται τόδε,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:607.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:607.1.text#κοινῇ μετασχεῖν τἀγαθοῦ καὶ τοῦ κακοῦ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:608.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:608.1.text#σὺ δ' — ἐκ βάθρων γὰρ πᾶς ἀνῄρησαι φίλοις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:609.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:609.1.text#οὐδ' ἐλλέλοιπας ἐλπίδ' — ἴσθι μου κλύων,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:610.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:610.1.text#ἐν χειρὶ τῇ σῇ πάντ' ἔχεις καὶ τῇ τύχῃ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:611.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:611.1.text#πατρῷον οἶκον καὶ πόλιν λαβεῖν σέθεν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:612.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:612.1.text#τί δῆτα δρῶντες τοῦδ' ἂν ἐξικοίμεθα;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:613.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:613.1.text#κτανὼν Θυέστου παῖδα σήν τε μητέρα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:614.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:614.1.text#ἥκω 'πὶ τόνδε στέφανον· ἀλλὰ πῶς λάβω;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:615.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:615.1.text#τειχέων μὲν ἐλθὼν ἐντὸς οὐδ' ἂν εἰ θέλοις.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:616.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:616.1.text#φρουραῖς κέκασται δεξιαῖς τε δορυφόρων;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:617.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:617.1.text#ἔγνως· φοβεῖται γάρ σε κοὐχ εὕδει σαφῶς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:618.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:618.1.text#εἶἑν· σὺ δὴ τοὐνθένδε βούλευσον, γέρον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:619.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:619.1.text#κἀμοῦ γ' ἄκουσον· ἄρτι γάρ μ' ἐσῆλθέ τι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:620.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:620.1.text#ἐσθλόν τι μηνύσειας, αἰσθοίμην δ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:621.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:621.1.text#Αἴγισθον εἶδον, ἡνίχ' εἷρπον ἐνθάδε.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:622.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:622.1.text#προσηκάμην τὸ ῥηθέν. ἐν ποίοις τόποις;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:623.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:623.1.text#ἀγρῶν πέλας τῶνδ' ἱπποφορβίων ἔπι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:624.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:624.1.text#τί δρῶνθ'; ὁρῶ γὰρ ἐλπίδ' ἐξ ἀμηχάνων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:625.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:625.1.text#Νύμφαις ἐπόρσυν' ἔροτιν, ὡς ἔδοξέ μοι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:626.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:626.1.text#τροφεῖα παίδων ἢ πρὸ μέλλοντος τόκου;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:627.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:627.1.text#οὐκ οἶδα πλὴν ἕν· βουσφαγεῖν ὡπλίζετο.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:628.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:628.1.text#πόσων μετ' ἀνδρῶν; ἢ μόνος δμώων μέτα;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:629.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:629.1.text#οὐδεὶς παρῆν Ἀργεῖος, οἰκεία δὲ χείρ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:630.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:630.1.text#οὔ πού τις ὅστις γνωριεῖ μ' ἰδών, γέρον;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:631.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:631.1.text#δμῶες μέν εἰσιν, οἳ σέ γ' οὐκ εἶδόν ποτε.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:632.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:632.1.text#ἡμῖν ἂν εἶεν, εἰ κρατοῖμεν, εὐμενεῖς;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:633.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:633.1.text#δούλων γὰρ ἴδιον τοῦτο, σοὶ δὲ σύμφορον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:634.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:634.1.text#πῶς οὖν ἂν αὐτῷ πλησιασθείην ποτέ;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:635.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:635.1.text#στείχων ὅθεν σε βουθυτῶν ἐσόψεται.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:636.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:636.1.text#ὁδὸν παρ' αὐτήν, ὡς ἔοικ', ἀγροὺς ἔχει;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:637.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:637.1.text#ὅθεν γ' ἰδών σε δαιτὶ κοινωνὸν καλεῖ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:638.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:638.1.text#πικρόν γε συνθοινάτορ', ἢν θεὸς θέλῃ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:639.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:639.1.text#τοὐνθένδε πρὸς τὸ πῖπτον αὐτὸς ἐννόει.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:640.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:640.1.text#καλῶς ἔλεξας.  — ἡ τεκοῦσα δ' ἐστὶ ποῦ;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:641.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:641.1.text#Ἄργει· παρέσται δ' οὖν πόσει θοίνην ἔπι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:642.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:642.1.text#τί δ' οὐχ ἅμ' ἐξωρμᾶτ' ἐμὴ μήτηρ πόσει;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:643.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:643.1.text#ψόγον τρέμουσα δημοτῶν ἐλείπετο.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:644.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:644.1.text#ξυνῆχ'· ὕποπτος οὖσα γιγνώσκει πόλει.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:645.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:645.1.text#τοιαῦτα· μισεῖται γὰρ ἀνόσιος γυνή.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:646.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:646.1.text#πῶς οὖν ἐκείνην τόνδε τ' ἐν ταὐτῷ κτενῶ;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:647.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:647.1.text#ἐγὼ φόνον γε μητρὸς ἐξαρτύσομαι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:648.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:648.1.text#καὶ μὴν ἐκεῖνά γ' ἡ τύχη θήσει καλῶς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:649.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:649.1.text#ὑπηρετείτω μὲν δυοῖν ὄντοιν ὅδε.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:650.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:650.1.text#ἔσται τάδ'· εὑρίσκεις δὲ μητρὶ πῶς φόνον;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:651.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:651.1.text#λέγ', ὦ γεραιέ, τάδε Κλυταιμήστρᾳ μολών·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:652.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:652.1.text#λεχώ μ' ἀπάγγελλ' οὖσαν ἄρσενος τόκῳ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:653.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:653.1.text#πότερα πάλαι τεκοῦσαν ἢ νεωστὶ δή;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:654.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:654.1.text#δέχ' ἡλίους, ἐν οἷσιν ἁγνεύει λεχώ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:655.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:655.1.text#καὶ δὴ τί τοῦτο μητρὶ προσβάλλει φόνον;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:656.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:656.1.text#ἥξει κλύουσα λόχιά μου νοσήματα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:657.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:657.1.text#πόθεν; τί δ' αὐτῇ σοῦ μέλειν δοκεῖς, τέκνον;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:658.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:658.1.text#ναί· καὶ δακρύσει γ' ἀξίωμ' ἐμῶν τόκων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:659.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:659.1.text#ἴσως· πάλιν τοι μῦθον ἐς καμπὴν ἄγε.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:660.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:660.1.text#ἐλθοῦσα μέντοι δῆλον ὡς ἀπόλλυται.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:661.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:661.1.text#καὶ μὴν ἐπ' αὐτάς γ' εἶσι σῶν δόμων πύλας.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:662.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:662.1.text#οὐκοῦν τραπέσθαι σμικρὸν εἰς Ἅιδου τόδε;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:663.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:663.1.text#εἰ γὰρ θάνοιμι τοῦτ' ἰδὼν ἐγώ ποτε.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:664.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:664.1.text#πρώτιστα μέν νυν τῷδ' ὑφήγησαι, γέρον —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:665.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:665.1.text#Αἴγισθος ἔνθα νῦν θυηπολεῖ θεοῖς;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:666.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:666.1.text#ἔπειτ' ἀπαντῶν μητρὶ τἀπ' ἐμοῦ φράσον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:667.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:667.1.text#ὥστ' αὐτά γ' ἐκ σοῦ στόματος εἰρῆσθαι δοκεῖν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:668.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:668.1.text#σὸν ἔργον ἤδη· πρόσθεν εἴληχας φόνου.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:669.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:669.1.text#στείχοιμ' ἄν, εἴ τις ἡγεμὼν γίγνοιθ' ὁδοῦ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:670.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:670.1.text#καὶ μὴν ἐγὼ πέμποιμ' ἂν οὐκ ἀκουσίως.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:671.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:671.1.text#ὦ Ζεῦ Πατρῷε, καὶ Τροπαῖ' ἐχθρῶν γενοῦ —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:672.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:672.1.text#οἴκτιρέ θ' ἡμᾶς· οἰκτρὰ γὰρ πεπόνθαμεν —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:673.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:673.1.text#οἴκτιρε δῆτα σούς γε φύντας ἐκγόνους.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:674.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:674.1.text#Ἥρα τε, βωμῶν ἣ Μυκηναίων κρατεῖς —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:675.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:675.1.text#νίκην δὸς ἡμῖν, εἰ δίκαι' αἰτούμεθα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:676.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:676.1.text#δὸς δῆτα πατρὸς τοῖσδε τιμωρὸν δίκην.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:677.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:677.1.text#σύ τ', ὦ κάτω γῆς ἀνοσίως οἰκῶν πάτερ —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:678.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:678.1.text#καὶ Γαῖ' ἄνασσα, χεῖρας ᾗ δίδωμ' ἐμὰς —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:679.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:679.1.text#ἄμυν' ἄμυνε τοῖσδε φιλτάτοις τέκνοις.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:680.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:680.1.text#νῦν πάντα νεκρὸν ἐλθὲ σύμμαχον λαβών.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:681.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:681.1.text#οἵπερ γε σὺν σοὶ Φρύγας ἀνήλωσαν δορὶ —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:683.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:683.1.text#χὥσοι στυγοῦσιν ἀνοσίους μιάστορας.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:682.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:682.1.text#ἤκουσας, ὦ δείν' ἐξ ἐμῆς μητρὸς παθών;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:684.1.speaker#Πρέσβυς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:684.1.text#πάντ', οἶδ', ἀκούει τάδε πατήρ· στείχειν δ' ἀκμή.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:685.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:685.1.text#καί σοι προφωνῶ πρὸς τάδ' Αἴγισθον θανεῖν·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:686.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:686.1.text#ὡς εἰ παλαισθεὶς πτῶμα θανάσιμον πεσῇ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:687.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:687.1.text#τέθνηκα κἀγώ, μηδέ με ζῶσαν λέγε·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:688.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:688.1.text#παίσω γὰρ ἧπαρ τοὐμὸν ἀμφήκει ξίφει.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:689.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:689.1.text#δόμων ἔσω βᾶσ' εὐτρεπὲς ποήσομαι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:690.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:690.1.text#ὡς ἢν μὲν ἔλθῃ πύστις εὐτυχὴς σέθεν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:691.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:691.1.text#ὀλολύξεται πᾶν δῶμα· θνῄσκοντος δέ σου
urn:cts:greekLit:tlg0006.tlg012.fu.sp:692.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:692.1.text#τἀναντί' ἔσται τῶνδε· ταῦτά σοι λέγω.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:693.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:693.1.text#πάντ' οἶδα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:693.2.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:693.2.text#πρὸς τάδ' ἄνδρα γίγνεσθαί σε χρή.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:694.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:694.1.text#ὑμεῖς δέ μοι, γυναῖκες, εὖ πυρσεύετε
urn:cts:greekLit:tlg0006.tlg012.fu.sp:695.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:695.1.text#κραυγὴν ἀγῶνος τοῦδε· φρουρήσω δ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:696.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:696.1.text#πρόχειρον ἔγχος χειρὶ βαστάζουσ' ἐμῇ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:697.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:697.1.text#οὐ γάρ ποτ' ἐχθροῖς τοῖς ἐμοῖς νικωμένη
urn:cts:greekLit:tlg0006.tlg012.fu.sp:698.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:698.1.text#δίκην ὑφέξω, σῶμ' ἐμὸν καθυβρίσαι.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:699.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:699.1.text#ἀταλᾶς ὑπὸ ματρὸς { ἄρν' }
urn:cts:greekLit:tlg0006.tlg012.fu.sp:699.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:699.2.text#Ἀργείων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:700.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:700.1.text#ὀρέων ποτὲ κληδὼν ἐν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:701.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:701.1.text#πολιαῖσι μένει φήμαις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:702.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:702.1.text#εὐαρμόστοις ἐν καλάμοις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:703.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:703.1.text#Πᾶνα μοῦσαν ἡδύθροον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:704.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:704.1.text#πνέοντ', ἀγρῶν ταμίαν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:705.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:705.1.text#χρυσέαν καλλιπλόκαμον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:706.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:706.1.text#πορεῦσαι. πετρίνοις δ' ἐπιστὰς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:707.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:707.1.text#κᾶρυξ ἰάχει βάθροις·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:708.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:708.1.text#Ἀγορὰν ἀγοράν, Μυκηναῖοι,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:709.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:709.1.text#στείχετε μακαρίων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:710.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:710.1.text#ὀψόμενοι τυράννων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:711.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:711.1.text#φάσματα { δείματα [ … ] χοροὶ δ' Ἀτρει- }
urn:cts:greekLit:tlg0006.tlg012.fu.sp:712.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:712.1.text#{ δᾶν } ἐγέραιρον οἴκους·[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:713.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:713.1.text#θυμέλαι δ' ἐπίτναντο χρυσήλατοι,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:714.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:714.1.text#σήλατοι,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:715.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:715.1.text#σελαγεῖτο δʼ ἀνʼ ἄστυ πῦρ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:715.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:715.2.text#ἐπιβώμιον Ἀργείων·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:716.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:716.1.text#λωτὸς δὲ φθόγγον κελάδει
urn:cts:greekLit:tlg0006.tlg012.fu.sp:717.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:717.1.text#κάλλιστον, Μουσᾶν θεράπων·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:718.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:718.1.text#μολπαὶ δ' ηὔξοντ' ἐραταί,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:719.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:719.1.text#χρυσέας ἀρνὸς ἐπίλογοι,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:720.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:720.1.text#Θυέστου· κρυφίαις γὰρ εὐναῖς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:721.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:721.1.text#πείσας ἄλοχον φίλαν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:722.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:722.1.text#Ἀτρέως, τέρας ἐκκομίζει
urn:cts:greekLit:tlg0006.tlg012.fu.sp:723.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:723.1.text#πρὸς δώματα· νεόμενος δ'
urn:cts:greekLit:tlg0006.tlg012.fu.sp:724.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:724.1.text#εἰς ἀγόρους ἀυτεῖ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:724.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:724.2.text#τὰν κερόεσσαν ἔχειν χρυσεόμαλλον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:725.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:725.1.text#κατὰ δῶμα ποίμναν.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:726.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:726.1.text#τότε δὴ τότε φαεννὰς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:727.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:727.1.text#ἄστρων μετέβασ' ὁδοὺς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:728.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:728.1.text#Ζεὺς καὶ φέγγος ἀελίου
urn:cts:greekLit:tlg0006.tlg012.fu.sp:730.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:730.1.text#λευκόν τε πρόσωπον ἀοῦς,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:731.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:731.1.text#τὰ δ' ἕσπερα νῶτ' ἐλαύνει
urn:cts:greekLit:tlg0006.tlg012.fu.sp:732.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:732.1.text#θερμᾷ φλογὶ θεοπύρῳ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:733.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:733.1.text#νεφέλαι δ' ἔνυδροι πρὸς ἄρκτον,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:734.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:734.1.text#ξηραί τ' Ἀμμωνίδες ἕδραι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:735.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:735.1.text#φθίνουσ' ἀπειρόδροσοι,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:736.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:736.1.text#καλλίστων ὄμβρων Διόθεν στερεῖσαι.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:737.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:737.1.text#λέγεται, τὰν δὲ πίστιν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:738.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:738.1.text#σμικρὰν παρ' ἔμοιγ' ἔχει,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:739.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:739.1.text#στρέψαι θερμὰν ἀέλιον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:740.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:740.1.text#χρυσωπὸν ἕδραν ἀλλάξαντα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:741.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:741.1.text#δυστυχίᾳ βροτείῳ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:742.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:742.1.text#θνατᾶς ἕνεκεν δίκας.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:743.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:743.1.text#φοβεροὶ δὲ βροτοῖσι μῦθοι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:744.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:744.1.text#κέρδος πρὸς θεῶν θεραπείαν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:745.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:745.1.text#ὧν οὐ μνασθεῖσα πόσιν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:746.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:746.1.text#κτείνεις, κλεινῶν συγγενέτειρ' ἀδελφῶν.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:747.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:747.1.text#ἔα ἔα·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:747.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:747.2.text#φίλαι, βοῆς ἠκούσατ' — ἢ δοκὼ κενὴ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:748.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:748.1.text#ὑπῆλθέ μ';  — ὥστε νερτέρα βροντὴ Διός;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:749.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:749.1.text#ἰδού, τάδ' οὐκ ἄσημα πνεύματ' αἴρεται·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:750.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:750.1.text#δέσποιν', ἄμειψον δώματ', Ἠλέκτρα, τάδε.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:751.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:751.1.text#φίλαι, τί χρῆμα; πῶς ἀγῶνος ἥκομεν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:752.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:752.1.text#οὐκ οἶδα πλὴν ἕν· φόνιον οἰμωγὴν κλύω.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:753.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:753.1.text#ἤκουσα κἀγώ, τηλόθεν μέν, ἀλλ' ὅμως.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:754.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:754.1.text#μακρὰν γὰρ ἕρπει γῆρυς, ἐμφανής γε μήν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:755.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:755.1.text#Ἀργεῖος ὁ στεναγμός· ἦ φίλων ἐμῶν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:756.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:756.1.text#οὐκ οἶδα· πᾶν γὰρ μείγνυται μέλος βοῆς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:757.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:757.1.text#σφαγὴν ἀυτεῖς τήνδε μοι· τί μέλλομεν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:758.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:758.1.text#ἔπισχε, τρανῶς ὡς μάθῃς τύχας σέθεν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:759.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:759.1.text#οὐκ ἔστι· νικώμεσθα· ποῦ γὰρ ἄγγελοι;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:760.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:760.1.text#ἥξουσιν· οὔτοι βασιλέα φαῦλον κτανεῖν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:761.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:761.1.text#ὦ καλλίνικοι παρθένοι Μυκηνίδες,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:762.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:762.1.text#νικῶντ' Ὀρέστην πᾶσιν ἀγγέλλω φίλοις,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:763.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:763.1.text#Ἀγαμέμνονος δὲ φονέα κείμενον πέδῳ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:764.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:764.1.text#Αἴγισθον· ἀλλὰ θεοῖσιν εὔχεσθαι χρεών.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:765.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:765.1.text#τίς δ' εἶ σύ; πῶς μοι πιστὰ σημαίνεις τάδε;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:766.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:766.1.text#οὐκ οἶσθ' ἀδελφοῦ μ' εἰσορῶσα πρόσπολον;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:767.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:767.1.text#ὦ φίλτατ', ἔκ τοι δείματος δυσγνωσίαν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:768.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:768.1.text#εἶχον προσώπου· νῦν δὲ γιγνώσκω σε δή.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:769.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:769.1.text#τί φῄς; τέθνηκε πατρὸς ἐμοῦ στυγνὸς φονεύς;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:770.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:770.1.text#τέθνηκε· δίς σοι ταὔθ', ἃ γοῦν βούλῃ, λέγω.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:771.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:771.1.text#ὦ θεοί, Δίκη τε πάνθ' ὁρῶσ', ἦλθές ποτε.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:772.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:772.1.text#ποίῳ τρόπῳ δὲ καὶ τίνι ῥυθμῷ φόνου
urn:cts:greekLit:tlg0006.tlg012.fu.sp:773.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:773.1.text#κτείνει Θυέστου παῖδα; βούλομαι μαθεῖν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:774.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:774.1.text#ἐπεὶ μελάθρων τῶνδ' ἀπήραμεν πόδα,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:775.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:775.1.text#ἐσβάντες ᾖμεν δίκροτον εἰς ἁμαξιτὸν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:776.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:776.1.text#ἔνθ' ἦν ὁ κλεινὸς τῶν Μυκηναίων ἄναξ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:777.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:777.1.text#κυρεῖ δὲ κήποις ἐν καταρρύτοις βεβώς,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:778.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:778.1.text#δρέπων τερείνης μυρσίνης κάρᾳ πλόκους·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:779.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:779.1.text#ἰδών τ' ἀυτεῖ· Χαίρετ', ὦ ξένοι· τίνες
urn:cts:greekLit:tlg0006.tlg012.fu.sp:780.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:780.1.text#πόθεν πορεύεσθ'; ἔστε τ' ἐκ ποίας χθονός;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:781.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:781.1.text#ὁ δ' εἶπ' Ὀρέστης· Θεσσαλοί· πρὸς δ' Ἀλφεὸν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:782.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:782.1.text#θύσοντες ἐρχόμεσθ' Ὀλυμπίῳ Διί.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:783.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:783.1.text#κλύων δὲ ταῦτ' Αἴγισθος ἐννέπει τάδε·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:784.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:784.1.text#νῦν μὲν παρ' ἡμῖν χρὴ συνεστίους ἐμοὶ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:785.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:785.1.text#θοίνης γενέσθαι· τυγχάνω δὲ βουθυτῶν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:786.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:786.1.text#νύμφαις· ἑῷοι δ' ἐξαναστάντες λέχους
urn:cts:greekLit:tlg0006.tlg012.fu.sp:787.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:787.1.text#ἐς ταὐτὸν ἥξετ'. ἀλλ' ἴωμεν ἐς δόμους —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:788.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:788.1.text#καὶ ταῦθ' ἅμ' ἠγόρευε καὶ χερὸς λαβὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:789.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:789.1.text#παρῆγεν ἡμᾶς — οὐδ' ἀπαρνεῖσθαι χρεών·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:790.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:790.1.text#[ ἐπεὶ δ' ἐν οἴκοις ἦμεν, ἐννέπει τάδε· ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:791.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:791.1.text#λούτρ' ὡς τάχιστα τοῖς ξένοις τις αἰρέτω,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:792.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:792.1.text#ὡς ἀμφὶ βωμὸν στῶσι χερνίβων πέλας.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:793.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:793.1.text#ἀλλ' εἶπ' Ὀρέστης· Ἀρτίως ἡγνίσμεθα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:794.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:794.1.text#λουτροῖσι καθαροῖς ποταμίων ῥείθρων ἄπο.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:795.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:795.1.text#εἰ δὲ ξένους ἀστοῖσι συνθύειν χρεών,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:796.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:796.1.text#Αἴγισθ', ἕτοιμοι κοὐκ ἀπαρνούμεσθ', ἄναξ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:797.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:797.1.text#τοῦτον μὲν οὖν μεθεῖσαν ἐκ μέσου λόγον·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:798.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:798.1.text#λόγχας δὲ θέντες δεσπότου φρουρήματα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:799.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:799.1.text#δμῶες πρὸς ἔργον πάντες ἵεσαν χέρας·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:800.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:800.1.text#οἳ μὲν σφαγεῖον ἔφερον, οἳ δ' ᾖρον κανᾶ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:801.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:801.1.text#ἄλλοι δὲ πῦρ ἀνῆπτον ἀμφί τ' ἐσχάρας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:802.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:802.1.text#λέβητας ὤρθουν· πᾶσα δ' ἐκτύπει στέγη.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:803.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:803.1.text#λαβὼν δὲ προχύτας μητρὸς εὐνέτης σέθεν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:804.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:804.1.text#ἔβαλλε βωμούς, τοιάδ' ἐννέπων ἔπη·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:805.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:805.1.text#νύμφαι πετραῖαι, πολλάκις με βουθυτεῖν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:806.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:806.1.text#καὶ τὴν κατ' οἴκους Τυνδαρίδα δάμαρτ' ἐμὴν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:807.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:807.1.text#πράσσοντας ὡς νῦν, τοὺς δ' ἐμοὺς ἐχθροὺς κακῶς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:808.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:808.1.text#— λέγων Ὀρέστην καὶ σέ. δεσπότης δ' ἐμὸς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:809.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:809.1.text#τἀναντί' ηὔχετ', οὐ γεγωνίσκων λόγους,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:810.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:810.1.text#λαβεῖν πατρῷα δώματ'. ἐκ κανοῦ δ' ἑλὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:811.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:811.1.text#Αἴγισθος ὀρθὴν σφαγίδα, μοσχείαν τρίχα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:812.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:812.1.text#τεμὼν ἐφ' ἁγνὸν πῦρ ἔθηκε δεξιᾷ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:813.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:813.1.text#κἄσφαξ' ἐπ' ὤμων μόσχον ὡς ἦραν χεροῖν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:814.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:814.1.text#δμῶες, λέγει δὲ σῷ κασιγνήτῳ τάδε·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:815.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:815.1.text#Ἐκ τῶν καλῶν κομποῦσι τοῖσι Θεσσαλοῖς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:816.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:816.1.text#εἶναι τόδ', ὅστις ταῦρον ἀρταμεῖ καλῶς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:817.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:817.1.text#ἵππους τ' ὀχμάζει· λαβὲ σίδηρον, ὦ ξένε,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:818.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:818.1.text#δεῖξόν τε φήμην ἔτυμον ἀμφὶ Θεσσαλῶν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:819.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:819.1.text#ὁ δ' εὐκρότητον Δωρίδ' ἁρπάσας χεροῖν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:820.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:820.1.text#ῥίψας ἀπ' ὤμων εὐπρεπῆ πορπάματα,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:821.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:821.1.text#Πυλάδην μὲν εἵλετ' ἐν πόνοις ὑπηρέτην,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:822.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:822.1.text#δμῶας δ' ἀπωθεῖ· καὶ λαβὼν μόσχου πόδα,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:823.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:823.1.text#λευκὰς ἐγύμνου σάρκας ἐκτείνων χέρα·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:824.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:824.1.text#θᾶσσον δὲ βύρσαν ἐξέδειρεν ἢ δρομεὺς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:825.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:825.1.text#δισσοὺς διαύλους ἱππίους διήνυσε,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:826.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:826.1.text#κἀνεῖτο λαγόνας. ἱερὰ δ' ἐς χεῖρας λαβὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:827.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:827.1.text#Αἴγισθος ἤθρει. καὶ λοβὸς μὲν οὐ προσῆν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:828.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:828.1.text#σπλάγχνοις, πύλαι δὲ καὶ δοχαὶ χολῆς πέλας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:829.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:829.1.text#κακὰς ἔφαινον τῷ σκοποῦντι προσβολάς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:830.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:830.1.text#χὣ μὲν σκυθράζει, δεσπότης δ' ἀνιστορεῖ·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:831.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:831.1.text#τί χρῆμ' ἀθυμεῖς;  — ὦ ξέν', ὀρρωδῶ τινα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:832.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:832.1.text#δόλον θυραῖον. ἔστι δ' ἔχθιστος βροτῶν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:833.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:833.1.text#Ἀγαμέμνονος παῖς πολέμιός τ' ἐμοῖς δόμοις·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:834.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:834.1.text#ὃ δ' εἶπε· φυγάδος δῆτα δειμαίνεις δόλον,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:835.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:835.1.text#πόλεως ἀνάσσων; οὐχ, ὅπως παστήρια
urn:cts:greekLit:tlg0006.tlg012.fu.sp:836.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:836.1.text#θοινασόμεσθα, Φθιάδ' ἀντὶ Δωρικῆς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:837.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:837.1.text#οἴσει τις ἡμῖν κοπίδ', ἀπορρήξω χέλυν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:838.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:838.1.text#λαβὼν δὲ κόπτει. σπλάγχνα δ' Αἴγισθος λαβὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:839.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:839.1.text#ἤθρει διαιρῶν. τοῦ δὲ νεύοντος κάτω
urn:cts:greekLit:tlg0006.tlg012.fu.sp:840.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:840.1.text#ὄνυχας ἐπ' ἄκρους στὰς κασίγνητος σέθεν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:841.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:841.1.text#ἐς σφονδύλους ἔπαισε, νωτιαῖα δὲ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:842.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:842.1.text#ἔρρηξεν ἄρθρα· πᾶν δὲ σῶμ' ἄνω κάτω
urn:cts:greekLit:tlg0006.tlg012.fu.sp:843.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:843.1.text#ἤσπαιρεν ἠλάλαζε δυσθνῄσκων φόνῳ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:844.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:844.1.text#δμῶες δ' ἰδόντες εὐθὺς ᾖξαν ἐς δόρυ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:845.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:845.1.text#πολλοὶ μάχεσθαι πρὸς δύ'· ἀνδρείας δ' ὕπο
urn:cts:greekLit:tlg0006.tlg012.fu.sp:846.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:846.1.text#ἔστησαν ἀντίπρῳρα σείοντες βέλη
urn:cts:greekLit:tlg0006.tlg012.fu.sp:847.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:847.1.text#Πυλάδης Ὀρέστης τ'. εἶπε δ'· οὐχὶ δυσμενὴς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:848.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:848.1.text#ἥκω πόλει τῇδ' οὐδ' ἐμοῖς ὀπάοσιν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:849.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:849.1.text#φονέα δὲ πατρὸς ἀντετιμωρησάμην
urn:cts:greekLit:tlg0006.tlg012.fu.sp:850.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:850.1.text#τλήμων Ὀρέστης· ἀλλὰ μή με καίνετε,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:851.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:851.1.text#πατρὸς παλαιοὶ δμῶες. οἳ δ', ἐπεὶ λόγων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:852.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:852.1.text#ἤκουσαν, ἔσχον κάμακας· ἐγνώσθη δ' ὑπὸ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:853.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:853.1.text#γέροντος ἐν δόμοισιν ἀρχαίου τινός.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:854.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:854.1.text#στέφουσι δ' εὐθὺς σοῦ κασιγνήτου κάρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:855.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:855.1.text#χαίροντες ἀλαλάζοντες. ἔρχεται δὲ σοὶ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:856.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:856.1.text#κάρα 'πιδείξων οὐχὶ Γοργόνος φέρων,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:857.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:857.1.text#ἀλλ' ὃν στυγεῖς Αἴγισθον· αἷμα δ' αἵματος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:858.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:858.1.text#πικρὸς δανεισμὸς ἦλθε τῷ θανόντι νῦν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:859.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:859.1.text#θὲς ἐς χορόν, ὦ φίλα, ἴχνος,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:860.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:860.1.text#ὡς νεβρὸς οὐράνιον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:861.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:861.1.text#πήδημα κουφίζουσα σὺν ἀγλαΐᾳ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:862.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:862.1.text#νικᾷ στεφαναφορίαν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:863.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:863.1.text#{ κρείσσω τοῖς } παρ' Ἀλφειοῦ ῥεέθροισι τελέσσας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:864.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:864.1.text#κασίγνητος σέθεν· ἀλλ' ἐπάειδε
urn:cts:greekLit:tlg0006.tlg012.fu.sp:865.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:865.1.text#καλλίνικον ᾠδὰν ἐμῷ χορῷ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:866.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:866.1.text#ὦ φέγγος, ὦ τέθριππον ἡλίου σέλας,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:867.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:867.1.text#ὦ γαῖα καὶ νὺξ ἣν ἐδερκόμην πάρος,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:868.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:868.1.text#νῦν ὄμμα τοὐμὸν ἀμπτυχαί τ' ἐλεύθεροι,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:869.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:869.1.text#ἐπεὶ πατρὸς πέπτωκεν Αἴγισθος φονεύς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:870.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:870.1.text#φέρ', οἷα δὴ χω καὶ δόμοι κεύθουσί μου
urn:cts:greekLit:tlg0006.tlg012.fu.sp:871.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:871.1.text#κόμης ἀγάλματ' ἐξενέγκωμαι, φίλαι,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:872.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:872.1.text#στέψω τ' ἀδελφοῦ κρᾶτα τοῦ νικηφόρου.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:873.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:873.1.text#σὺ μέν νυν ἀγάλματ' ἄειρε
urn:cts:greekLit:tlg0006.tlg012.fu.sp:874.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:874.1.text#κρατί· τὸ δ' ἁμέτερον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:875.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:875.1.text#χωρήσεται Μούσαισι χόρευμα φίλον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:876.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:876.1.text#νῦν οἱ πάρος ἁμέτεροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:877.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:877.1.text#γαίας τυραννεύσουσι φίλοι βασιλῆες,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:878.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:878.1.text#δικαίως  [ … ] τοὺς ἀδίκους καθελόντες.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:879.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:879.1.text#ἀλλ' ἴτω ξύναυλος βοὰ χαρᾷ.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:880.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:880.1.text#ὦ καλλίνικε, πατρὸς ἐκ νικηφόρου
urn:cts:greekLit:tlg0006.tlg012.fu.sp:881.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:881.1.text#γεγώς, Ὀρέστα, τῆς ὑπ' Ἰλίῳ μάχης,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:882.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:882.1.text#δέξαι κόμης σῆς βοστρύχων ἀνδήματα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:883.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:883.1.text#ἥκεις γὰρ οὐκ ἀχρεῖον ἔκπλεθρον δραμὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:884.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:884.1.text#ἀγῶν' ἐς οἴκους, ἀλλὰ πολέμιον κτανὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:885.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:885.1.text#Αἴγισθον, ὃς σὸν πατέρα κἀμὸν ὤλεσε.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:886.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:886.1.text#σύ τ', ὦ παρασπίστ', ἀνδρὸς εὐσεβεστάτου
urn:cts:greekLit:tlg0006.tlg012.fu.sp:887.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:887.1.text#παίδευμα Πυλάδη, στέφανον ἐξ ἐμῆς χερὸς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:888.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:888.1.text#δέχου· φέρῃ γὰρ καὶ σὺ τῷδ' ἴσον μέρος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:889.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:889.1.text#ἀγῶνος· αἰεὶ δ' εὐτυχεῖς φαίνοισθέ μοι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:890.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:890.1.text#θεοὺς μὲν ἡγοῦ πρῶτον, Ἠλέκτρα, τύχης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:891.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:891.1.text#ἀρχηγέτας τῆσδ', εἶτα κἄμ' ἐπαίνεσον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:892.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:892.1.text#τὸν τῶν θεῶν τε τῆς τύχης θ' ὑπηρέτην.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:893.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:893.1.text#ἥκω γὰρ οὐ λόγοισιν ἀλλ' ἔργοις κτανὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:894.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:894.1.text#Αἴγισθον· ὡς δὲ τῷ σάφ' εἰδέναι τάδε
urn:cts:greekLit:tlg0006.tlg012.fu.sp:895.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:895.1.text#προσθῶμεν, αὐτὸν τὸν θανόντα σοι φέρω,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:896.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:896.1.text#ὃν εἴτε χρῄζεις θηρσὶν ἁρπαγὴν πρόθες,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:897.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:897.1.text#ἢ σκῦλον οἰωνοῖσιν, αἰθέρος τέκνοις,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:898.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:898.1.text#πήξασ' ἔρεισον σκόλοπι· σὸς γάρ ἐστι νῦν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:899.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:899.1.text#[ δοῦλος, πάροιθε δεσπότης κεκλημένος. ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:900.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:900.1.text#αἰσχύνομαι μέν, βούλομαι δ' εἰπεῖν ὅμως.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:901.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:901.1.text#τί χρῆμα; λέξον· ὡς φόβου γ' ἔξωθεν εἶ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:902.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:902.1.text#νεκροὺς ὑβρίζειν, μή μέ τις φθόνῳ βάλῃ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:903.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:903.1.text#οὐκ ἔστιν οὐδεὶς ὅστις ἂν μέμψαιτό σε.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:904.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:904.1.text#δυσάρεστος ἡμῶν καὶ φιλόψογος πόλις.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:905.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:905.1.text#λέγ', εἴ τι χρῄζεις, σύγγον'· ἀσπόνδοισι γὰρ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:906.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:906.1.text#νόμοισιν ἔχθραν τῷδε συμβεβλήκαμεν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:907.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:907.1.text#εἶἑν· τίν' ἀρχὴν πρῶτά σ' ἐξείπω κακῶν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:908.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:908.1.text#ποίας τελευτάς; τίνα μέσον τάξω λόγον;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:909.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:909.1.text#καὶ μὴν δι' ὄρθρων γ' οὔποτ' ἐξελίμπανον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:910.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:910.1.text#θρυλοῦσ' ἅ γ' εἰπεῖν ἤθελον κατ' ὄμμα σόν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:911.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:911.1.text#εἰ δὴ γενοίμην δειμάτων ἐλευθέρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:912.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:912.1.text#τῶν πρόσθε. νῦν οὖν ἐσμεν· ἀποδώσω δέ σοι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:913.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:913.1.text#ἐκεῖν' ἅ σε ζῶντ' ἤθελον λέξαι κακά.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:914.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:914.1.text#ἀπώλεσάς με κὠρφανὴν φίλου πατρὸς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:915.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:915.1.text#καὶ τόνδ' ἔθηκας, οὐδὲν ἠδικημένος,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:916.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:916.1.text#κἄγημας αἰσχρῶς μητέρ' ἄνδρα τ' ἔκτανες
urn:cts:greekLit:tlg0006.tlg012.fu.sp:917.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:917.1.text#στρατηλατοῦνθ' Ἕλλησιν, οὐκ ἐλθὼν Φρύγας.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:918.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:918.1.text#ἐς τοῦτο δ' ἦλθες ἀμαθίας ὥστ' ἤλπισας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:919.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:919.1.text#ὡς ἐς σὲ ἐμὴν δὴ μητέρ' οὐχ ἕξοις κακὴν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:920.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:920.1.text#γήμας, ἐμοῦ δὲ πατρὸς ἠδίκεις λέχη.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:921.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:921.1.text#ἴστω δ', ὅταν τις διολέσας δάμαρτά του
urn:cts:greekLit:tlg0006.tlg012.fu.sp:922.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:922.1.text#κρυπταῖσιν εὐναῖς εἶτ' ἀναγκασθῇ λαβεῖν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:923.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:923.1.text#δύστηνός ἐστιν, εἰ δοκεῖ τὸ σωφρονεῖν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:924.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:924.1.text#ἐκεῖ μὲν αὐτὴν οὐκ ἔχειν, παρ' οἷ δ' ἔχειν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:925.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:925.1.text#ἄλγιστα δ' ᾤκεις, οὐ δοκῶν οἰκεῖν κακῶς·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:926.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:926.1.text#ᾔδησθα γὰρ δῆτ' ἀνόσιον γήμας γάμον,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:927.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:927.1.text#μήτηρ δὲ σ' ἄνδρα δυσσεβῆ κεκτημένη.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:928.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:928.1.text#ἄμφω πονηρὼ δ' ὄντ' ἀνῃρεῖσθον τύχην
urn:cts:greekLit:tlg0006.tlg012.fu.sp:929.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:929.1.text#{ κείνη τε τὴν σὴν καὶ σὺ τοὐκείνης κακόν. }
urn:cts:greekLit:tlg0006.tlg012.fu.sp:930.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:930.1.text#πᾶσιν δ' ἐν Ἀργείοισιν ἤκουες τάδε·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:931.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:931.1.text#Ὁ τῆς γυναικός — οὐχὶ τἀνδρὸς ἡ γυνή.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:932.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:932.1.text#καίτοι τόδ' αἰσχρόν, προστατεῖν γε δωμάτων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:933.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:933.1.text#γυναῖκα, μὴ τὸν ἄνδρα· κἀκείνους στυγῶ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:934.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:934.1.text#τοὺς παῖδας, ὅστις τοῦ μὲν ἄρσενος πατρὸς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:935.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:935.1.text#οὐκ ὠνόμασται, τῆς δὲ μητρὸς ἐν πόλει.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:936.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:936.1.text#ἐπίσημα γὰρ γήμαντι καὶ μείζω λέχη
urn:cts:greekLit:tlg0006.tlg012.fu.sp:937.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:937.1.text#τἀνδρὸς μὲν οὐδείς, τῶν δὲ θηλειῶν λόγος.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:938.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:938.1.text#ὃ δ' ἠπάτα σε πλεῖστον οὐκ ἐγνωκότα,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:939.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:939.1.text#ηὔχεις τις εἶναι τοῖσι χρήμασι σθένων·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:940.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:940.1.text#τὰ δ' οὐδὲν εἰ μὴ βραχὺν ὁμιλῆσαι χρόνον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:941.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:941.1.text#ἡ γὰρ φύσις βέβαιος, οὐ τὰ χρήματα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:942.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:942.1.text#ἣ μὲν γὰρ αἰεὶ παραμένουσ' αἴρει κακά·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:943.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:943.1.text#ὁ δ' ὄλβος ἀδίκως καὶ μετὰ σκαιῶν ξυνὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:944.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:944.1.text#ἐξέπτατ' οἴκων, σμικρὸν ἀνθήσας χρόνον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:945.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:945.1.text#ἃ δ' ἐς γυναῖκας — παρθένῳ γὰρ οὐ καλὸν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:946.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:946.1.text#λέγειν — σιωπῶ, γνωρίμως δ' αἰνίξομαι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:947.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:947.1.text#ὕβριζες, ὡς δὴ βασιλικοὺς ἔχων δόμους
urn:cts:greekLit:tlg0006.tlg012.fu.sp:948.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:948.1.text#κάλλει τ' ἀραρώς. ἀλλ' ἔμοιγ' εἴη πόσις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:949.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:949.1.text#μὴ παρθενωπός, ἀλλὰ τἀνδρείου τρόπου.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:950.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:950.1.text#τὰ γὰρ τέκν' αὐτῶν Ἄρεος ἐκκρεμάννυται,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:951.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:951.1.text#τὰ δ' εὐπρεπῆ δὴ κόσμος ἐν χοροῖς μόνον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:952.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:952.1.text#ἔρρ', οὐδὲν εἰδὼς ὧν ἐφευρεθεὶς χρόνῳ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:953.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:953.1.text#δίκην δέδωκας.  — ὧδέ τις κακοῦργος ὢν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:954.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:954.1.text#μή μοι τὸ πρῶτον βῆμ' ἐὰν δράμῃ καλῶς,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:955.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:955.1.text#νικᾶν δοκείτω τὴν Δίκην, πρὶν ἂν πέλας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:956.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:956.1.text#γραμμῆς ἵκηται καὶ τέλος κάμψῃ βίου.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:957.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:957.1.text#ἔπραξε δεινά, δεινὰ δ' ἀντέδωκε σοὶ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:958.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:958.1.text#καὶ τῷδ'· ἔχει γὰρ ἡ Δίκη μέγα σθένος.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:959.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:959.1.text#εἶἑν· κομίζειν τοῦδε σῶμ' ἔσω χρεὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:960.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:960.1.text#σκότῳ τε δοῦναι, δμῶες, ὡς, ὅταν μόλῃ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:961.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:961.1.text#μήτηρ, σφαγῆς πάροιθε μὴ εἰσίδῃ νεκρόν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:962.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:962.1.text#ἐπίσχες· ἐμβάλωμεν εἰς ἄλλον λόγον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:963.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:963.1.text#τί δ'; ἐκ Μυκηνῶν μῶν βοηδρόμους ὁρῶ;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:964.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:964.1.text#οὔκ, ἀλλὰ τὴν τεκοῦσαν ἥ μ' ἐγείνατο.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:965.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:965.1.text#καλῶς ἄρ' ἄρκυν ἐς μέσην πορεύεται —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:966.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:966.1.text#καὶ μὴν ὄχοις γε καὶ στολῇ λαμπρύνεται.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:967.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:967.1.text#τί δῆτα δρῶμεν; μητέρ' ἦ φονεύσομεν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:968.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:968.1.text#μῶν σ' οἶκτος εἷλε, μητρὸς ὡς εἶδες δέμας;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:969.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:969.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:969.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:969.2.text#πῶς γὰρ κτάνω νιν, ἥ μ' ἔθρεψε κἄτεκεν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:970.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:970.1.text#ὥσπερ πατέρα σὸν ἥδε κἀμὸν ὤλεσεν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:971.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:971.1.text#ὦ Φοῖβε, πολλήν γ' ἀμαθίαν ἐθέσπισας —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:972.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:972.1.text#ὅπου δ' Ἀπόλλων σκαιὸς ᾖ, τίνες σοφοί;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:973.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:973.1.text#ὅστις μ' ἔχρησας μητέρ', ἣν οὐ χρῆν, κτανεῖν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:974.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:974.1.text#βλάπτῃ δὲ δὴ τί πατρὶ τιμωρῶν σέθεν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:975.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:975.1.text#μητροκτόνος νῦν φεύξομαι, τόθ' ἁγνὸς ὤν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:976.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:976.1.text#καὶ μή γ' ἀμύνων πατρὶ δυσσεβὴς ἔσῃ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:977.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:977.1.text#ἐγὼ δὲ μητρὸς — ; τῷ φόνου δώσω δίκας;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:978.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:978.1.text#τῷ δ' ἢν πατρῴαν διαμεθῇς τιμωρίαν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:979.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:979.1.text#ἆρ' αὔτ' ἀλάστωρ εἶπ' ἀπεικασθεὶς θεῷ;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:980.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:980.1.text#ἱερὸν καθίζων τρίποδ'; ἐγὼ μὲν οὐ δοκῶ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:981.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:981.1.text#οὐδ' ἂν πιθοίμην εὖ μεμαντεῦσθαι τάδε.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:982.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:982.1.text#οὐ μὴ κακισθεὶς εἰς ἀνανδρίαν πεσῇ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:983.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:983.1.text#ἀλλ' ἦ τὸν αὐτὸν τῇδ' ὑποστήσω δόλον;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:984.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:984.1.text#ᾧ καὶ πόσιν καθεῖλες, Αἴγισθον κτανών.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:985.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:985.1.text#ἔσειμι· δεινοῦ δ' ἄρχομαι προβλήματος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:986.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:986.1.text#καὶ δεινὰ δράσω γε — εἰ θεοῖς δοκεῖ τάδε,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:987.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:987.1.text#ἔστω· πικρὸν δὲ χἡδὺ τἀγώνισμά μοι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:988.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:988.1.text#[ ἰώ, ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:988.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:988.2.text#βασίλεια γύναι χθονὸς Ἀργείας,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:989.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:989.1.text#παῖ Τυνδάρεω,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:990.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:990.1.text#καὶ τοῖν ἀγαθοῖν ξύγγονε κούροιν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:991.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:991.1.text#Διός, οἳ φλογερὰν αἰθέρ' ἐν ἄστροις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:992.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:992.1.text#ναίουσι, βροτῶν ἐν ἁλὸς ῥοθίοις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:993.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:993.1.text#τιμὰς σωτῆρας ἔχοντες·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:994.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:994.1.text#χαῖρε, σεβίζω σ' ἴσα καὶ μάκαρας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:995.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:995.1.text#πλούτου μεγάλης τ' εὐδαιμονίας.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:996.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:996.1.text#τὰς σὰς δὲ τύχας θεραπεύεσθαι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:997.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:997.1.text#καιρός. { χαῖρ', } ὦ βασίλεια.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:998.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:998.1.text#ἔκβητ' ἀπήνης, Τρῳάδες, χειρὸς δ' ἐμῆς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:999.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:999.1.text#λάβεσθ', ἵν' ἔξω τοῦδ' ὄχου στήσω πόδα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1000.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1000.1.text#σκύλοισι μὲν γὰρ θεῶν κεκόσμηνται δόμοι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1001.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1001.1.text#Φρυγίοις, ἐγὼ δὲ τάσδε, Τρῳάδος χθονὸς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1002.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1002.1.text#ἐξαίρετ', ἀντὶ παιδὸς ἣν ἀπώλεσα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1003.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1003.1.text#σμικρὸν γέρας, καλὸν δὲ κέκτημαι δόμοις.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1004.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1004.1.text#οὔκουν ἐγώ — δούλη γὰρ ἐκβεβλημένη
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1005.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1005.1.text#δόμων πατρῴων δυστυχεῖς οἰκῶ δόμους —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1006.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1006.1.text#μῆτερ, λάβωμαι μακαρίας τῆς σῆς χερός;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1007.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1007.1.text#δοῦλαι πάρεισιν αἵδε, μὴ σύ μοι πόνει.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1008.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1008.1.text#τί δ'; αἰχμάλωτόν τοί μ' ἀπῴκισας δόμων,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1009.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1009.1.text#ᾑρημένων δὲ δωμάτων ᾑρήμεθα,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1010.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1010.1.text#ὡς αἵδε, πατρὸς ὀρφαναὶ λελειμμέναι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1011.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1011.1.text#τοιαῦτα μέντοι σὸς πατὴρ βουλεύματα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1012.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1012.1.text#ἐς οὓς ἐχρῆν ἥκιστ' ἐβούλευσεν φίλων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1013.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1013.1.text#λέξω δὲ  [ … ] καίτοι δόξ' ὅταν λάβῃ κακὴ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1014.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1014.1.text#γυναῖκα, γλώσσῃ πικρότης ἔνεστί τις.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1015.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1015.1.text#ὡς μὲν παρ' ἡμῖν, οὐ καλῶς· τὸ πρᾶγμα δὲ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1016.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1016.1.text#μαθόντας, ἢν μὲν ἀξίως μισεῖν ἔχῃ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1017.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1017.1.text#στυγεῖν δίκαιον· εἰ δὲ μή, τί δεῖ στυγεῖν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1018.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1018.1.text#ἡμᾶς ἔδωκε Τυνδάρεως τῷ σῷ πατρί,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1019.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1019.1.text#οὐχ ὥστε θνῄσκειν, οὐδ' ἃ γειναίμην ἐγώ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1020.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1020.1.text#κεῖνος δὲ παῖδα τὴν ἐμὴν Ἀχιλλέως
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1021.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1021.1.text#λέκτροισι πείσας ᾤχετ' ἐκ δόμων ἄγων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1022.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1022.1.text#πρυμνοῦχον Αὖλιν, ἔνθ' ὑπερτείνας πυρᾶς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1023.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1023.1.text#λευκὴν διήμησ' Ἰφιγόνης παρηΐδα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1024.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1024.1.text#κεἰ μὲν πόλεως ἅλωσιν ἐξιώμενος,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1025.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1025.1.text#ἢ δῶμ' ὀνήσων τἄλλα τ' ἐκσῴζων τέκνα,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1026.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1026.1.text#ἔκτεινε πολλῶν μίαν ὕπερ, συγγνώστ' ἂν ἦν·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1027.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1027.1.text#νῦν δ' οὕνεχ' Ἑλένη μάργος ἦν ὅ τ' αὖ λαβὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1028.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1028.1.text#ἄλοχον κολάζειν προδότιν οὐκ ἠπίστατο,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1029.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1029.1.text#τούτων ἕκατι παῖδ' ἐμὴν διώλεσεν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1030.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1030.1.text#ἐπὶ τοῖσδε τοίνυν καίπερ ἠδικημένη
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1031.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1031.1.text#οὐκ ἠγριώμην οὐδ' ἂν ἔκτανον πόσιν·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1032.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1032.1.text#ἀλλ' ἦλθ' ἔχων μοι μαινάδ' ἔνθεον κόρην
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1033.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1033.1.text#λέκτροις τ' ἐπεισέφρηκε, καὶ νύμφα δύο
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1034.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1034.1.text#ἐν τοῖσιν αὐτοῖς δώμασιν κατείχομεν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1035.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1035.1.text#μῶρον μὲν οὖν γυναῖκες, οὐκ ἄλλως λέγω·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1036.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1036.1.text#ὅταν δ', ὑπόντος τοῦδ', ἁμαρτάνῃ πόσις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1037.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1037.1.text#τἄνδον παρώσας λέκτρα, μιμεῖσθαι θέλει
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1038.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1038.1.text#γυνὴ τὸν ἄνδρα χἅτερον κτᾶσθαι φίλον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1039.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1039.1.text#κἄπειτ' ἐν ἡμῖν ὁ ψόγος λαμπρύνεται,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1040.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1040.1.text#οἱ δ' αἴτιοι τῶνδ' οὐ κλύουσ' ἄνδρες κακῶς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1041.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1041.1.text#εἰ δ' ἐκ δόμων ἥρπαστο Μενέλεως λάθρᾳ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1042.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1042.1.text#κτανεῖν μ' Ὀρέστην χρῆν, κασιγνήτης πόσιν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1043.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1043.1.text#Μενέλαον ὡς σώσαιμι; σὸς δὲ πῶς πατὴρ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1044.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1044.1.text#ἠνέσχετ' ἂν ταῦτ'; εἶτα τὸν μὲν οὐ θανεῖν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1045.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1045.1.text#κτείνοντα χρῆν τἄμ', ἐμὲ δὲ πρὸς κείνου παθεῖν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1046.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1046.1.text#ἔκτειν', ἐτρέφθην ἥνπερ ἦν πορεύσιμον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1047.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1047.1.text#πρὸς τοὺς ἐκείνῳ πολεμίους. φίλων γὰρ ἂν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1048.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1048.1.text#τίς ἂν πατρὸς σοῦ φόνον ἐκοινώνησέ μοι;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1049.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1049.1.text#λέγ', εἴ τι χρῄζεις, κἀντίθες παρρησίᾳ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1050.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1050.1.text#ὅπως τέθνηκε σὸς πατὴρ οὐκ ἐνδίκως.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1051.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1051.1.text#δίκαι' ἔλεξας· ἡ δίκη δ' αἰσχρῶς ἔχει.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1052.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1052.1.text#γυναῖκα γὰρ χρὴ πάντα συγχωρεῖν πόσει,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1053.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1053.1.text#ἥτις φρενήρης· ᾗ δὲ μὴ δοκεῖ τάδε,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1054.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1054.1.text#οὐδ' εἰς ἀριθμὸν τῶν ἐμῶν ἥκει λόγων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1055.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1055.1.text#μέμνησο, μῆτερ, οὓς ἔλεξας ὑστάτους
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1056.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1056.1.text#λόγους, διδοῦσα πρὸς σέ μοι παρρησίαν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1057.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1057.1.text#καὶ νῦν γέ φημι κοὐκ ἀπαρνοῦμαι, τέκνον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1058.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1058.1.text#{ ἆρα } κλύουσα, μῆτερ, εἶτ' ἔρξεις κακῶς;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1059.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1059.1.text#οὐκ ἔστι, τῇ σῇ δ' ἡδὺ προσθήσω φρενί.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1060.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1060.1.text#λέγοιμ' ἄν· ἀρχὴ δ' ἥδε μοι προοιμίου·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1061.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1061.1.text#εἴθ' εἶχες, ὦ τεκοῦσα, βελτίους φρένας.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1062.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1062.1.text#τὸ μὲν γὰρ εἶδος αἶνον ἄξιον φέρειν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1063.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1063.1.text#Ἑλένης τε καὶ σοῦ, δύο δ' ἔφυτε συγγόνω,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1064.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1064.1.text#ἄμφω ματαίω Κάστορός τ' οὐκ ἀξίω.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1065.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1065.1.text#ἣ μὲν γὰρ ἁρπασθεῖσ' ἑκοῦσ' ἀπώλετο,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1066.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1066.1.text#σὺ δ' ἄνδρ' ἄριστον Ἑλλάδος διώλεσας,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1067.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1067.1.text#σκῆψιν προτείνουσ', ὡς ὑπὲρ τέκνου πόσιν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1068.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1068.1.text#ἔκτεινας· οὐ γάρ σ' ὡς ἔγωγ' ἴσασιν εὖ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1069.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1069.1.text#ἥτις, θυγατρὸς πρὶν κεκυρῶσθαι σφαγάς,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1070.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1070.1.text#νέον τ' ἀπ' οἴκων ἀνδρὸς ἐξωρμημένου,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1071.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1071.1.text#ξανθὸν κατόπτρῳ πλόκαμον ἐξήσκεις κόμης.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1072.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1072.1.text#γυνὴ δ', ἀπόντος ἀνδρός ἥτις ἐκ δόμων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1073.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1073.1.text#ἐς κάλλος ἀσκεῖ, διάγραφ' ὡς οὖσαν κακήν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1074.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1074.1.text#οὐδὲν γὰρ αὐτὴν δεῖ θύρασιν εὐπρεπὲς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1075.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1075.1.text#φαίνειν πρόσωπον, ἤν τι μὴ ζητῇ κακόν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1076.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1076.1.text#μόνη δὲ πασῶν οἶδ' ἐγὼ σ' Ἑλληνίδων,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1077.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1077.1.text#εἰ μὲν τὰ Τρώων εὐτυχοῖ, κεχαρμένην,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1078.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1078.1.text#εἰ δ' ἥσσον' εἴη, συννεφοῦσαν ὄμματα,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1079.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1079.1.text#Ἀγαμέμνον' οὐ χρῄζουσαν ἐκ Τροίας μολεῖν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1080.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1080.1.text#καίτοι καλῶς γε σωφρονεῖν παρεῖχέ σοι·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1081.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1081.1.text#ἄνδρ' εἶχες οὐ κακίον' Αἰγίσθου πόσιν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1082.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1082.1.text#ὃν Ἑλλὰς αὑτῆς εἵλετο στρατηλάτην·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1083.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1083.1.text#Ἑλένης δ' ἀδελφῆς τοιάδ' ἐξειργασμένης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1084.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1084.1.text#ἐξῆν κλέος σοι μέγα λαβεῖν· τὰ γὰρ κακὰ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1085.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1085.1.text#παράδειγμα τοῖς ἐσθλοῖσιν εἴσοψίν τ' ἔχει.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1086.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1086.1.text#εἰ δ', ὡς λέγεις, σὴν θυγατέρ' ἔκτεινεν πατήρ,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1087.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1087.1.text#ἐγὼ τί σ' ἠδίκησ' ἐμός τε σύγγονος;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1088.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1088.1.text#πῶς οὐ πόσιν κτείνασα πατρῴους δόμους
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1089.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1089.1.text#ἡμῖν προσῆψας, ἀλλ' ἐπηνέγκω λέχει
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1090.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1090.1.text#τἀλλότρια, μισθοῦ τοὺς γάμους ὠνουμένη;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1091.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1091.1.text#κοὔτ' ἀντιφεύγει παιδὸς ἀντὶ σοῦ πόσις,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1092.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1092.1.text#οὔτ' ἀντ' ἐμοῦ τέθνηκε, δὶς τόσως ἐμὲ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1093.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1093.1.text#κτείνας ἀδελφῆς ζῶσαν. εἰ δ' ἀμείψεται
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1094.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1094.1.text#φόνον δικάζων φόνος, ἀποκτενῶ σ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1095.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1095.1.text#καὶ παῖς Ὀρέστης πατρὶ τιμωρούμενοι·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1096.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1096.1.text#εἰ γὰρ δίκαι' ἐκεῖνα, καὶ τάδ' ἔνδικα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1097.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1097.1.text#[ ὅστις δὲ πλοῦτον ἢ εὐγένειαν εἰσιδὼν ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1098.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1098.1.text#[ γαμεῖ πονηράν, μῶρός ἐστι· μικρὰ γὰρ ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1099.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1099.1.text#[ μεγάλων ἀμείνω σώφρον' ἐν δόμοις λέχη. ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1100.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1100.1.text#[ τύχη γυναικῶν ἐς γάμους. τὰ μὲν γὰρ εὖ, ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1101.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1101.1.text#[ τὰ δ' οὐ καλῶς πίπτοντα δέρκομαι βροτῶν. ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1102.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1102.1.text#ὦ παῖ, πέφυκας πατέρα σὸν στέργειν ἀεί·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1103.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1103.1.text#ἔστιν δὲ καὶ τόδ'· οἳ μέν εἰσιν ἀρσένων,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1104.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1104.1.text#οἳ δ' αὖ φιλοῦσι μητέρας μᾶλλον πατρός.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1105.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1105.1.text#συγγνώσομαί σοι· καὶ γὰρ οὐχ οὕτως ἄγαν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1106.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1106.1.text#χαίρω τι, τέκνον, τοῖς δεδραμένοις ἐμοί.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1107.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1107.1.text#σὺ δ' ὧδ' ἄλουτος καὶ δυσείματος χρόα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1108.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1108.1.text#λεχὼ νεογνῶν ἐκ τόκων πεπαυμένη;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1109.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1109.1.text#οἴμοι τάλαινα τῶν ἐμῶν βουλευμάτων·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1110.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1110.1.text#ὡς μᾶλλον ἢ χρῆν ἤλασ' εἰς ὀργὴν πόσιν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1111.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1111.1.text#ὀψὲ στενάζεις, ἡνίκ' οὐκ ἔχεις ἄκη.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1112.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1112.1.text#πατὴρ μὲν οὖν τέθνηκε· τὸν δ' ἔξω χθονὸς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1113.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1113.1.text#πῶς οὐ κομίζῃ παῖδ' ἀλητεύοντα σόν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1114.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1114.1.text#δέδοικα· τοὐμὸν δ', οὐχὶ τοὐκείνου, σκοπῶ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1115.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1115.1.text#πατρὸς γάρ, ὡς λέγουσι, θυμοῦται φόνῳ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1116.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1116.1.text#τί δαὶ πόσιν σὸν ἄγριον εἰς ἡμᾶς ἔχεις;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1117.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1117.1.text#τρόποι τοιοῦτοι· καὶ σὺ δ' αὐθάδης ἔφυς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1118.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1118.1.text#ἀλγῶ γάρ· ἀλλὰ παύσομαι θυμουμένη.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1119.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1119.1.text#καὶ μὴν ἐκεῖνος οὐκέτ' ἔσται σοι βαρύς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1120.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1120.1.text#φρονεῖ μέγ'· ἐν γὰρ τοῖς ἐμοῖς ναίει δόμοις.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1121.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1121.1.text#ὁρᾷς; ἀν' αὖ σὺ ζωπυρεῖς νείκη νέα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1122.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1122.1.text#σιγῶ· δέδοικα γάρ νιν ὡς δέδοικ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1123.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1123.1.text#παῦσαι λόγων τῶνδε. ἀλλὰ τί μ' ἐκάλεις, τέκνον;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1124.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1124.1.text#ἤκουσας, οἶμαι, τῶν ἐμῶν λοχευμάτων·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1125.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1125.1.text#τούτων ὕπερ μοι θῦσον — οὐ γὰρ οἶδ' ἐγώ —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1126.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1126.1.text#δεκάτῃ σελήνῃ παιδὸς ὡς νομίζεται·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1127.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1127.1.text#τρίβων γὰρ οὐκ εἴμ', ἄτοκος οὖσ' ἐν τῷ πάρος.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1128.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1128.1.text#ἄλλης τόδ' ἔργον, ἥ σ' ἔλυσεν ἐκ τόκων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1129.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1129.1.text#αὐτὴ 'λόχευον κἄτεκον μόνη βρέφος.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1130.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1130.1.text#οὕτως ἀγείτων οἶκος ἵδρυται φίλων;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1131.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1131.1.text#πένητας οὐδεὶς βούλεται κτᾶσθαι φίλους.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1132.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1132.1.text#ἀλλ' εἶμι, παιδὸς ἀριθμὸν ὡς τελεσφόρον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1133.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1133.1.text#θύσω θεοῖσι· σοὶ δ' ὅταν πράξω χάριν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1134.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1134.1.text#τήνδ', εἶμ' ἐπ' ἀγρὸν οὗ πόσις θυηπολεῖ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1135.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1135.1.text#νύμφαισιν. ἀλλὰ τούσδ' ὄχους, ὀπάονες,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1136.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1136.1.text#φάτναις ἄγοντες πρόσθεθ'· ἡνίκ' ἂν δέ με
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1137.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1137.1.text#δοκῆτε θυσίας τῆσδ' ἀπηλλάχθαι θεοῖς,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1138.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1138.1.text#πάρεστε· δεῖ γὰρ καὶ πόσει δοῦναι χάριν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1139.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1139.1.text#χώρει πένητας ἐς δόμους· φρούρει δέ μοι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1140.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1140.1.text#μή σ' αἰθαλώσῃ πολύκαπνον στέγος πέπλους.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1141.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1141.1.text#θύσεις γὰρ οἷα χρή σε δαίμοσιν θύη.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1142.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1142.1.text#κανοῦν δ' ἐνῆρκται καὶ τεθηγμένη σφαγίς,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1143.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1143.1.text#ἥπερ καθεῖλε ταῦρον, οὗ πέλας πεσῇ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1144.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1144.1.text#πληγεῖσα· νυμφεύσῃ δὲ κἀν Ἅιδου δόμοις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1145.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1145.1.text#ᾧπερ ξυνηῦδες ἐν φάει. τοσήνδ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1146.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1146.1.text#δώσω χάριν σοι, σὺ δὲ δίκην ἐμοὶ πατρός.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1147.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1147.1.text#ἀμοιβαὶ κακῶν· μετάτροποι πνέουσιν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1148.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1148.1.text#αὖραι δόμων. τότε μὲν { ἐν } λουτροῖς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1149.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1149.1.text#ἔπεσεν ἐμὸς ἐμὸς ἀρχέτας,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1150.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1150.1.text#ἰάχησε δὲ στέγα λάινοί τε θριγκοὶ δόμων,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1151.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1151.1.text#τάδ' ἐνέποντος· Ὦ σχέτλια· τί με, γύναι, φονεύσεις φίλαν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1152.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1152.1.text#πατρίδα δεκέτεσιν σποραῖσιν ἐλθόντ' ἐμάν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1153.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1153.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1154.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1154.1.text#[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1155.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1155.1.text#παλίρρους δὲ τάνδ' ὑπάγεται δίκα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1156.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1156.1.text#διαδρόμου λέχους μέλεον ἃ πόσιν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1157.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1157.1.text#χρόνιον ἱκόμενον εἰς οἴκους
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1158.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1158.1.text#Κυκλώπειά τ' οὐράνια τείχε' ὀξυθήκτου βέλους
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1160.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1160.1.text#ἔκανεν αὐτόχειρ, πέλεκυν ἐν χεροῖν λαβοῦσ'· ἆ τλάμων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1161.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1161.1.text#πόσις, ὅ τί ποτε τὰν τάλαιναν ἔσχεν κακόν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1162.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1162.1.text#ὀρεία τις ὡς λέαιν' ὀργάδων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1163.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1163.1.text#δρύοχα νεμομένα, τάδε κατήνυσεν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1165.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1165.1.text#ὦ τέκνα, πρὸς θεῶν, μὴ κτάνητε μητέρα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1166.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1166.1.text#κλύεις ὑπώροφον βοάν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1167.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1167.1.text#ἰώ μοί μοι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1168.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1168.1.text#ᾤμωξα κἀγὼ πρὸς τέκνων χειρουμένης.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1169.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1169.1.text#νέμει τοι δίκαν θεός, ὅταν τύχῃ·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1170.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1170.1.text#σχέτλια μὲν ἔπαθες, ἀνόσια δ' εἰργάσω,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1171.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1171.1.text#τάλαιν', εὐνέταν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1172.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1172.1.text#ἀλλ' οἵδε μητρὸς νεοφόνοις ἐν αἵμασι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1173.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1173.1.text#πεφυρμένοι βαίνουσιν ἐξ οἴκων πόδα,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1174.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1174.1.text#τροπαῖα δείγματ' ἀθλίων προσφαγμάτων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1175.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1175.1.text#οὐκ ἔστιν οὐδεὶς οἶκος ἀθλιώτερος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1176.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1176.1.text#τῶν Τανταλείων οὐδ' ἔφυ ποτ' ἐκγόνων.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1177.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1177.1.text#ἰὼ Γᾶ καὶ Ζεῦ πανδερκέτα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1178.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1178.1.text#βροτῶν, ἴδετε τάδ' ἔργα φόνια
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1179.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1179.1.text#μυσαρά, δίγονα σώματ' ἐν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1180.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1180.1.text#χθονὶ κείμενα πλαγᾷ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1181.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1181.1.text#χερὸς ὑπ' ἐμᾶς, ἄποιν' ἐμῶν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1181.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1181.2.text#πημάτων  [ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1181.3.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1181.3.text#[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1182.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1182.1.text#δακρύτ' ἄγαν, ὦ σύγγον', αἰτία δ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1183.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1183.1.text#διὰ πυρὸς ἔμολον ἁ τάλαινα ματρὶ τᾷδ',
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1184.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1184.1.text#ἅ μ' ἔτικτε κούραν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1185.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1185.1.text#ἰὼ τύχας, σᾶς τύχας,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1186.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1186.1.text#μᾶτερ τεκοῦσ' { ἄλαστα },
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1187.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1187.1.text#ἄλαστα μέλεα καὶ πέρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1188.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1188.1.text#παθοῦσα σῶν τέκνων ὑπαί.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1189.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1189.1.text#πατρὸς δ' ἔτεισας φόνον δικαίως.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1190.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1190.1.text#ἰὼ Φοῖβ', ἀνύμνησας δίκαι'
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1191.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1191.1.text#ἄφαντα, φανερὰ δ' ἐξέπραξας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1192.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1192.1.text#ἄχεα, φόνια δ' ὤπασας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1193.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1193.1.text#λάχε' ἀπὸ γᾶς [ τᾶς ] Ἑλλανίδος.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1194.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1194.1.text#τίνα δ' ἑτέραν μόλω πόλιν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1195.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1195.1.text#τίς ξένος, τίς εὐσεβὴς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1196.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1196.1.text#ἐμὸν κάρα προσόψεται
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1197.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1197.1.text#ματέρα κτανόντος;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1198.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1198.1.text#ἰὼ ἰώ μοι. ποῖ δ' ἐγώ, τίν' ἐς χορόν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1199.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1199.1.text#τίνα γάμον εἶμι; τίς πόσις με δέξεται
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1200.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1200.1.text#νυμφικὰς ἐς εὐνάς;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1201.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1201.1.text#πάλιν, πάλιν φρόνημα σὸν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1202.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1202.1.text#μετεστάθη πρὸς αὔραν·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1203.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1203.1.text#φρονεῖς γὰρ ὅσια νῦν, τότ' οὐ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1204.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1204.1.text#φρονοῦσα, δεινὰ δ' εἰργάσω,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1205.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1205.1.text#φίλα, κασίγνητον οὐ θέλοντα.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1206.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1206.1.text#κατεῖδες, οἷον ἁ τάλαιν' ἔξω πέπλων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1207.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1207.1.text#ἔβαλεν, ἔδειξε μαστὸν ἐν φοναῖσιν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1208.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1208.1.text#ἰώ μοι, πρὸς πέδῳ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1209.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1209.1.text#τιθεῖσα γόνιμα μέλεα; τὰν κόμαν δ' ἐγὼ —
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1210.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1210.1.text#σάφ' οἶδα, δι' ὀδύνας ἔβας,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1211.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1211.1.text#ἰήιον κλύων γόον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1212.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1212.1.text#ματρός, ἅ σ' ἔτικτε.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1214.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1214.1.text#βοὰν δ' ἔλασκε τάνδε, πρὸς γένυν ἐμὰν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1215.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1215.1.text#τιθεῖσα χεῖρα· Τέκος ἐμόν, λιταίνω·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1216.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1216.1.text#παρῄδων τ' ἐξ ἐμᾶν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1217.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1217.1.text#ἐκρίμναθ', ὥστε χέρας ἐμὰς λιπεῖν βέλος.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1218.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1218.1.text#τάλαινα· πῶς ἔτλας φόνον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1219.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1219.1.text#δι' ὀμμάτων ἰδεῖν σέθεν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1220.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1220.1.text#ματρὸς ἐκπνεούσας;[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1221.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1221.1.text#ἐγὼ μὲν ἐπιβαλὼν φάρη κόραις ἐμαῖς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1222.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1222.1.text#φασγάνῳ κατηρξάμαν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1223.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1223.1.text#ματέρος ἔσω δέρας μεθείς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1224.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1224.1.text#ἐγὼ δ' ἐπεγκέλευσά σοι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1225.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1225.1.text#ξίφους τ' ἐφηψάμαν ἅμα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1226.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1226.1.text#δεινότατον παθέων ἔρεξας.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1227.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1227.1.text#λαβοῦ, κάλυπτε μέλεα ματέρος πέπλοις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1228.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1228.1.text#{ καὶ } καθάρμοσον σφαγάς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1229.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1229.1.text#φονέας ἔτικτες ἆρά σοι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1230.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1230.1.text#ἰδού, φίλᾳ τε κοὐ φίλᾳ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1231.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1231.1.text#φάρεα τάδ' ἀμφιβάλλομεν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1232.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1232.1.text#τέρμα κακῶν μεγάλων δόμοισιν.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1233.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1233.1.text#ἀλλ' οἵδε δόμων ὑπὲρ ἀκροτάτων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1234.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1234.1.text#φαίνουσι τίνες — δαίμονες ἢ θεῶν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1235.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1235.1.text#τῶν οὐρανίων; οὐ γὰρ θνητῶν γ'
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1236.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1236.1.text#ἥδε κέλευθος· τί ποτ' ἐς φανερὰν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1237.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1237.1.text#ὄψιν βαίνουσι βροτοῖσιν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1238.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1238.1.text#Ἀγαμέμνονος παῖ, κλῦθι· δίπτυχοι δέ σε
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1239.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1239.1.text#καλοῦσι μητρὸς σύγγονοι Διόσκοροι,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1240.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1240.1.text#Κάστωρ κασίγνητός τε Πολυδεύκης ὅδε.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1241.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1241.1.text#δεινὸν δὲ ναυσὶν ἀρτίως πόντου σάλον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1242.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1242.1.text#παύσαντ' ἀφίγμεθ' Ἄργος, ὡς ἐσείδομεν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1243.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1243.1.text#σφαγὰς ἀδελφῆς τῆσδε, μητέρος δὲ σῆς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1244.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1244.1.text#δίκαια μέν νυν ἥδ' ἔχει, σὺ δ' οὐχὶ δρᾷς·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1245.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1245.1.text#Φοῖβός τε, Φοῖβος — ἀλλ' ἄναξ γάρ ἐστ' ἐμός,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1246.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1246.1.text#σιγῶ· σοφὸς δ' ὢν οὐκ ἔχρησέ σοι σοφά.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1247.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1247.1.text#αἰνεῖν δ' ἀνάγκη ταῦτα· τἀντεῦθεν δὲ χρὴ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1248.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1248.1.text#πράσσειν ἃ Μοῖρα Ζεύς τ' ἔκρανε σοῦ πέρι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1249.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1249.1.text#Πυλάδῃ μὲν Ἠλέκτραν δὸς ἄλοχον ἐς δόμους,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1250.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1250.1.text#σὺ δ' Ἄργος ἔκλιπ'· οὐ γὰρ ἔστι σοι πόλιν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1251.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1251.1.text#τήνδ' ἐμβατεύειν, μητέρα κτείναντι σήν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1252.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1252.1.text#δειναὶ δὲ κῆρές { σ' } αἱ κυνώπιδες θεαὶ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1253.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1253.1.text#τροχηλατήσουσ' ἐμμανῆ πλανώμενον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1254.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1254.1.text#ἐλθὼν δ' Ἀθήνας Παλλάδος σεμνὸν βρέτας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1255.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1255.1.text#πρόσπτυξον· εἵρξει γάρ νιν ἐπτοημένας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1256.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1256.1.text#δεινοῖς δράκουσιν ὥστε μὴ ψαύειν σέθεν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1257.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1257.1.text#γοργῶφ' ὑπερτείνουσα σῷ κάρᾳ κύκλον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1258.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1258.1.text#ἔστιν δ' Ἄρεώς τις ὄχθος, οὗ πρῶτον θεοὶ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1259.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1259.1.text#ἕζοντ' ἐπὶ ψήφοισιν αἵματος πέρι,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1260.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1260.1.text#Ἁλιρρόθιον ὅτ' ἔκταν' ὠμόφρων Ἄρης,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1261.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1261.1.text#μῆνιν θυγατρὸς ἀνοσίων νυμφευμάτων,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1262.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1262.1.text#πόντου κρέοντος παῖδ', ἵν' εὐσεβεστάτη
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1263.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1263.1.text#ψῆφος βεβαία τ' ἐστὶν { ἔκ τε τοῦ } θεοῖς.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1264.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1264.1.text#ἐνταῦθα καὶ σὲ δεῖ δραμεῖν φόνου πέρι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1265.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1265.1.text#ἴσαι δέ σ' ἐκσῴζουσι μὴ θανεῖν δίκῃ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1266.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1266.1.text#ψῆφοι τεθεῖσαι· Λοξίας γὰρ αἰτίαν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1267.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1267.1.text#ἐς αὑτὸν οἴσει, μητέρος χρήσας φόνον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1268.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1268.1.text#καὶ τοῖσι λοιποῖς ὅδε νόμος τεθήσεται,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1269.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1269.1.text#νικᾶν ἴσαις ψήφοισι τὸν φεύγοντ' ἀεί.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1270.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1270.1.text#δειναὶ μὲν οὖν θεαὶ τῷδ' ἄχει πεπληγμέναι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1271.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1271.1.text#πάγον παρ' αὐτὸν χάσμα δύσονται χθονός,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1272.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1272.1.text#σεμνὸν βροτοῖσιν εὐσεβὲς χρηστήριον·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1273.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1273.1.text#σὲ δ' Ἀρκάδων χρὴ πόλιν ἐπ' Ἀλφειοῦ ῥοαῖς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1274.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1274.1.text#οἰκεῖν Λυκαίου πλησίον σηκώματος·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1275.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1275.1.text#ἐπώνυμος δὲ σοῦ πόλις κεκλήσεται.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1276.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1276.1.text#σοὶ μὲν τάδ' εἶπον· τόνδε δ' Αἰγίσθου νέκυν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1277.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1277.1.text#Ἄργους πολῖται γῆς καλύψουσιν τάφῳ.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1278.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1278.1.text#μητέρα δὲ τὴν σὴν ἄρτι Ναυπλίαν παρὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1279.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1279.1.text#Μενέλαος, ἐξ οὗ Τρωικὴν εἷλε χθόνα,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1280.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1280.1.text#Ἑλένη τε θάψει· Πρωτέως γὰρ ἐκ δόμων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1281.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1281.1.text#ἥκει λιποῦσ' Αἴγυπτον οὐδ' ἦλθεν Φρύγας·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1282.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1282.1.text#Ζεὺς δ', ὡς ἔρις γένοιτο καὶ φόνος βροτῶν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1283.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1283.1.text#εἴδωλον Ἑλένης ἐξέπεμψ' ἐς Ἴλιον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1284.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1284.1.text#Πυλάδης μὲν οὖν κόρην τε καὶ δάμαρτ' ἔχων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1285.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1285.1.text#Ἀχαιίδος γῆς οἴκαδ' ἐσπορευέτω,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1286.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1286.1.text#καὶ τὸν λόγῳ σὸν πενθερὸν κομιζέτω
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1287.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1287.1.text#Φωκέων ἐς αἶαν καὶ δότω πλούτου βάρος·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1288.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1288.1.text#σὺ δ' Ἰσθμίας γῆς αὐχέν' ἐμβαίνω ποδὶ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1289.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1289.1.text#χώρει πρὸς ὄχθον Κεκροπίας εὐδαίμονα.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1290.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1290.1.text#πεπρωμένην γὰρ μοῖραν ἐκπλήσας φόνου
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1291.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1291.1.text#εὐδαιμονήσεις τῶνδ' ἀπαλλαχθεὶς πόνων.[ … ]
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1292.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1292.1.text#ὦ παῖδε Διός, θέμις ἐς φθογγὰς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1293.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1293.1.text#τὰς ὑμετέρας ἡμῖν πελάθειν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1294.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1294.1.text#θέμις, οὐ μυσαραῖς τοῖσδε σφαγίοις.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1295.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1295.1.text#κἀμοὶ μύθου μέτα, Τυνδαρίδαι;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1296.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1296.1.text#καὶ σοί· Φοίβῳ τήνδ' ἀναθήσω
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1297.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1297.1.text#πρᾶξιν φονίαν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1298.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1298.1.text#πῶς ὄντε θεὼ τῆσδέ τ' ἀδελφὼ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1299.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1299.1.text#τῆς καπφθιμένης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1300.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1300.1.text#οὐκ ἠρκέσατον κῆρας μελάθροις;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1301.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1301.1.text#μοῖρά τ' ἀνάγκης ἦγ' ἐς τὸ χρεών,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1302.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1302.1.text#Φοίβου τ' ἄσοφοι γλώσσης ἐνοπαί.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1303.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1303.1.text#τίς δ' ἔμ' Ἀπόλλων, ποῖοι χρησμοὶ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1304.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1304.1.text#φονίαν ἔδοσαν μητρὶ γενέσθαι;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1305.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1305.1.text#κοιναὶ πράξεις, κοινοὶ δὲ πότμοι,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1306.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1306.1.text#μία δ' ἀμφοτέρους
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1307.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1307.1.text#ἄτη πατέρων διέκναισεν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1308.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1308.1.text#ὦ σύγγονέ μοι, χρονίαν σ' ἐσιδὼν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1309.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1309.1.text#τῶν σῶν εὐθὺς φίλτρων στέρομαι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1310.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1310.1.text#καὶ σ' ἀπολείψω σοῦ λειπόμενος.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1311.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1311.1.text#πόσις ἔστ' αὐτῇ καὶ δόμος· οὐχ ἥδ'
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1312.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1312.1.text#οἰκτρὰ πέπονθεν, πλὴν ὅτι λείπει
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1313.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1313.1.text#πόλιν Ἀργείων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1314.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1314.1.text#καὶ τίνες ἄλλαι στοναχαὶ μείζους
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1315.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1315.1.text#ἢ γῆς πατρίας ὅρον ἐκλείπειν;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1316.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1316.1.text#ἀλλ' ἐγὼ οἴκων ἔξειμι πατρὸς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1317.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1317.1.text#καὶ ἐπ' ἀλλοτρίαις ψήφοισι φόνον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1318.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1318.1.text#μητρὸς ὑφέξω.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1319.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1319.1.text#θάρσει· Παλλάδος
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1320.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1320.1.text#ὁσίαν ἥξεις πόλιν· ἀλλ' ἀνέχου.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1321.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1321.1.text#περί μοι στέρνοις στέρνα πρόσαψον,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1322.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1322.1.text#σύγγονε φίλτατε·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1323.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1323.1.text#διὰ γὰρ ζευγνῦσ' ἡμᾶς πατρίων
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1324.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1324.1.text#μελάθρων μητρὸς φόνιοι κατάραι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1325.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1325.1.text#βάλε, πρόσπτυξον σῶμα· θανόντος δ'
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1326.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1326.1.text#ὡς ἐπὶ τύμβῳ καταθρήνησον.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1327.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1327.1.text#φεῦ φεῦ· δεινὸν τόδ' ἐγηρύσω
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1328.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1328.1.text#καὶ θεοῖσι κλύειν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1329.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1329.1.text#ἔνι γὰρ κἀμοὶ τοῖς τ' οὐρανίδαις
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1330.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1330.1.text#οἶκτοι θνητῶν πολυμόχθων.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1331.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1331.1.text#οὐκέτι σ' ὄψομαι.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1332.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1332.1.text#οὐδ' ἐγὼ ἐς σὸν βλέφαρον πελάσω.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1333.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1333.1.text#τάδε λοίσθιά μοι προσφθέγματά σου.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1334.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1334.1.text#ὦ χαῖρε, πόλις·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1335.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1335.1.text#χαίρετε δ' ὑμεῖς πολλά, πολίτιδες.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1336.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1336.1.text#ὦ πιστοτάτη, στείχεις ἤδη;
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1337.1.speaker#Ἠλέκτρα
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1337.1.text#στείχω βλέφαρον τέγγουσ' ἁπαλόν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1340.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1340.1.text#Πυλάδη, χαίρων ἴθι, νυμφεύου
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1341.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1341.1.text#δέμας Ἠλέκτρας.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1342.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1342.1.text#τοῖσδε μελήσει γάμος· ἀλλὰ κύνας
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1343.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1343.1.text#τάσδ' ὑποφεύγων στεῖχ' ἐπ' Ἀθηνῶν·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1344.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1344.1.text#δεινὸν γὰρ ἴχνος βάλλουσ' ἐπὶ σοὶ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1345.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1345.1.text#χειροδράκοντες χρῶτα κελαιναί,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1346.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1346.1.text#δεινῶν ὀδυνῶν καρπὸν ἔχουσαι·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1347.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1347.1.text#νὼ δ' ἐπὶ πόντον Σικελὸν σπουδῇ
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1348.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1348.1.text#σῴσοντε νεῶν πρῴρας ἐνάλους.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1349.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1349.1.text#διὰ δ' αἰθερίας στείχοντε πλακὸς
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1350.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1350.1.text#τοῖς μὲν μυσαροῖς οὐκ ἐπαρήγομεν,
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1351.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1351.1.text#οἷσιν δ' ὅσιον καὶ τὸ δίκαιον
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1352.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1352.1.text#φίλον ἐν βιότῳ, τούτους χαλεπῶν
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1353.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1353.1.text#ἐκλύοντες μόχθων σῴζομεν.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1354.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1354.1.text#οὕτως ἀδικεῖν μηδεὶς θελέτω
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1355.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1355.1.text#μηδ' ἐπιόρκων μέτα συμπλείτω·
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1356.1.speaker#Διόσκουροι
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1356.1.text#θεὸς ὢν θνητοῖς ἀγορεύω.
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1357.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1357.1.text#χαίρετε· χαίρειν δ' ὅστις δύναται
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1358.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1358.1.text#καὶ ξυντυχίᾳ μή τινι κάμνει
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1359.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg012.fu.sp:1359.1.text#θνητῶν, εὐδαίμονα πράσσει.
