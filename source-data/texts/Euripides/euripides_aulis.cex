#!ctsdata
urn:cts:greekLit:tlg0006.tlg018.fu.sp:49.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:49.1.text#Ἐγένοντο Λήδᾳ Θεστιάδι τρεῖς παρθένοι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:50.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:50.1.text#Φοίβη Κλυταιμήστρα τ', ἐμὴ ξυνάορος,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:51.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:51.1.text#Ἑλένη τε· ταύτης οἱ τὰ πρῶτ' ὠλβισμένοι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:52.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:52.1.text#μνηστῆρες ἦλθον Ἑλλάδος νεανίαι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:53.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:53.1.text#δειναὶ δ' ἀπειλαὶ καὶ κατ' ἀλλήλων φόνος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:54.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:54.1.text#ξυνίσταθ', ὅστις μὴ λάβοι τὴν παρθένον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:55.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:55.1.text#τὸ πρᾶγμα δ' ἀπόρως εἶχε Τυνδάρεῳ πατρί,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:56.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:56.1.text#δοῦναί τε μὴ δοῦναί τε, τῆς τύχης ὅπως
urn:cts:greekLit:tlg0006.tlg018.fu.sp:57.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:57.1.text#ἅψαιτ' ἄριστα. καί νιν εἰσῆλθεν τάδε·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:58.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:58.1.text#ὅρκους συνάψαι δεξιάς τε συμβαλεῖν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:59.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:59.1.text#μνηστῆρας ἀλλήλοισι καὶ δι' ἐμπύρων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:60.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:60.1.text#σπονδὰς καθεῖναι κἀπαράσασθαι τάδε·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:61.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:61.1.text#ὅτου γυνὴ γένοιτο Τυνδαρὶς κόρη,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:62.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:62.1.text#τούτῳ ξυναμυνεῖν, εἴ τις ἐκ δόμων λαβὼν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:63.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:63.1.text#οἴχοιτο τόν τ' ἔχοντ' ἀπωθοίη λέχους,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:64.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:64.1.text#κἀπιστρατεύσειν καὶ κατασκάψειν πόλιν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:65.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:65.1.text#Ἕλλην' ὁμοίως βάρβαρόν θ' ὅπλων μέτα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:66.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:66.1.text#ἐπεὶ δ' ἐπιστώθησαν — εὖ δέ πως γέρων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:67.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:67.1.text#ὑπῆλθεν αὐτοὺς Τυνδάρεως πυκνῇ φρενί —
urn:cts:greekLit:tlg0006.tlg018.fu.sp:68.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:68.1.text#δίδωσ' ἑλέσθαι θυγατρὶ μνηστήρων ἕνα,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:69.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:69.1.text#ὅτου πνοαὶ φέροιεν Ἀφροδίτης φίλαι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:70.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:70.1.text#ἣ δ' εἵλεθ', ὅς σφε μήποτ' ὤφελεν λαβεῖν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:71.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:71.1.text#Μενέλαον. ἐλθὼν δ' ἐκ Φρυγῶν ὁ τὰς θεὰς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:72.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:72.1.text#κρίνων ὅδ', ὡς ὁ μῦθος Ἀργείων ἔχει,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:73.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:73.1.text#Λακεδαίμον', ἀνθηρὸς μὲν εἱμάτων στολῇ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:74.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:74.1.text#χρυσῷ δὲ λαμπρός, βαρβάρῳ χλιδήματι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:75.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:75.1.text#ἐρῶν ἐρῶσαν ᾤχετ' ἐξαναρπάσας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:76.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:76.1.text#Ἑλένην πρὸς Ἴδης βούσταθμ', ἔκδημον λαβὼν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:77.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:77.1.text#Μενέλαον. ὃ δὲ καθ' Ἑλλάδ' οἰστρήσας δρόμῳ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:78.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:78.1.text#ὅρκους παλαιοὺς Τυνδάρεω μαρτύρεται,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:79.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:79.1.text#ὡς χρὴ βοηθεῖν τοῖσιν ἠδικημένοις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:80.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:80.1.text#τοὐντεῦθεν οὖν Ἕλληνες ᾄξαντες δορί,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:81.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:81.1.text#τεύχη λαβόντες στενόπορ' Αὐλίδος βάθρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:82.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:82.1.text#ἥκουσι τῆσδε, ναυσὶν ἀσπίσιν θ' ὁμοῦ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:83.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:83.1.text#ἵπποις τε πολλοῖς ἅρμασίν τ' ἠσκημένοι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:84.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:84.1.text#κἀμὲ στρατηγεῖν { κἆτα Μενέλεω χάριν }
urn:cts:greekLit:tlg0006.tlg018.fu.sp:85.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:85.1.text#εἵλοντο, σύγγονόν γε. τἀξίωμα δὲ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:86.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:86.1.text#ἄλλος τις ὤφελ' ἀντ' ἐμοῦ λαβεῖν τόδε.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:87.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:87.1.text#ἠθροισμένου δὲ καὶ ξυνεστῶτος στρατοῦ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:88.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:88.1.text#ἥμεσθ' ἀπλοίᾳ χρώμενοι κατ' Αὐλίδα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:89.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:89.1.text#Κάλχας δ' ὁ μάντις ἀπορίᾳ κεχρημένοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:90.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:90.1.text#ἀνεῖλεν Ἰφιγένειαν ἣν ἔσπειρ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:91.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:91.1.text#Ἀρτέμιδι θῦσαι τῇ τόδ' οἰκούσῃ πέδον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:92.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:92.1.text#καὶ πλοῦν τ' ἔσεσθαι καὶ κατασκαφὰς Φρυγῶν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:93.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:93.1.text#[ θύσασι, μὴ θύσασι δ' οὐκ εἶναι τάδε. ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:94.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:94.1.text#κλύων δ' ἐγὼ ταῦτ', ὀρθίῳ κηρύγματι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:95.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:95.1.text#Ταλθύβιον εἶπον πάντ' ἀφιέναι στρατόν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:96.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:96.1.text#ὡς οὔποτ' ἂν τλὰς θυγατέρα κτανεῖν ἐμήν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:97.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:97.1.text#οὗ δή μ' ἀδελφὸς πάντα προσφέρων λόγον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:98.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:98.1.text#ἔπεισε τλῆναι δεινά. κἀν δέλτου πτυχαῖς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:99.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:99.1.text#γράψας ἔπεμψα πρὸς δάμαρτα τὴν ἐμὴν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:100.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:100.1.text#πέμπειν Ἀχιλλεῖ θυγατέρ' ὡς γαμουμένην,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:101.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:101.1.text#τό τ' ἀξίωμα τἀνδρὸς ἐκγαυρούμενος,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:102.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:102.1.text#συμπλεῖν τ' Ἀχαιοῖς οὕνεκ' οὐ θέλοι λέγων,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:103.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:103.1.text#εἰ μὴ παρ' ἡμῶν εἶσιν ἐς Φθίαν λέχος·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:104.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:104.1.text#πειθὼ γὰρ εἶχον τήνδε πρὸς δάμαρτ' ἐμήν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:105.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:105.1.text#[ ψευδῆ συνάψας ἀντὶ παρθένου γάμον. ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:106.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:106.1.text#[ μόνοι δ' Ἀχαιῶν ἴσμεν ὡς ἔχει τάδε ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:107.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:107.1.text#[ Κάλχας Ὀδυσσεὺς Μενέλεώς θ'. ἃ δ' οὐ καλῶς ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:108.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:108.1.text#[ ἔγνων τότ', αὖθις μεταγράφω καλῶς πάλιν ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:109.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:109.1.text#[ ἐς τήνδε δέλτον, ἣν κατ' εὐφρόνης σκιὰν ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:110.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:110.1.text#[ λύοντα καὶ συνδοῦντά μ' εἰσεῖδες, γέρον. ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:111.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:111.1.text#[ ἀλλ' εἶα χώρει τάσδ' ἐπιστολὰς λαβὼν ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:112.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:112.1.text#[ πρὸς Ἄργος. ἃ δὲ κέκευθε δέλτος ἐν πτυχαῖς, ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:113.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:113.1.text#[ λόγῳ φράσω σοι πάντα τἀγγεγραμμένα· ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:114.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:114.1.text#[ πιστὸς γὰρ ἀλόχῳ τοῖς τ' ἐμοῖς δόμοισιν εἶ. ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1.1.text#Ὦ πρέσβυ, δόμων τῶνδε πάροιθεν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1.2.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1.2.text#στεῖχε.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:2.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:2.1.text#στείχω. τί δὲ καινουργεῖς,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:3.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:3.1.text#Ἀγάμεμνον ἄναξ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:3.2.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:3.2.text#σπεύσεις;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:3.3.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:3.3.text#σπεύδω.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:4.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:4.1.text#μάλα τοι γῆρας τοὐμὸν ἄυπνον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:5.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:5.1.text#καὶ ἐπ' ὀφθαλμοῖς ὀξὺ πάρεστιν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:6.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:6.1.text#τίς ποτ' ἄρ' ἀστὴρ ὅδε πορθμεύει;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:7.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:7.1.text#Σείριος ἐγγὺς τῆς ἑπταπόρου
urn:cts:greekLit:tlg0006.tlg018.fu.sp:8.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:8.1.text#Πλειάδος ᾄσσων ἔτι μεσσήρης.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:9.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:9.1.text#οὔκουν φθόγγος γ' οὔτ' ὀρνίθων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:10.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:10.1.text#οὔτε θαλάσσης· σιγαὶ δ' ἀνέμων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:11.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:11.1.text#τόνδε κατ' Εὔριπον ἔχουσιν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:12.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:12.1.text#τί δὲ σὺ σκηνῆς ἐκτὸς ἀίσσεις,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:13.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:13.1.text#Ἀγάμεμνον ἄναξ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:14.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:14.1.text#ἔτι δ' ἡσυχία τῇδε κατ' Αὖλιν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:15.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:15.1.text#καὶ ἀκίνητοι φυλακαὶ τειχέων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:16.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:16.1.text#στείχωμεν ἔσω.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:16.2.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:16.2.text#ζηλῶ σέ, γέρον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:17.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:17.1.text#ζηλῶ δ' ἀνδρῶν ὃς ἀκίνδυνον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:18.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:18.1.text#βίον ἐξεπέρασ' ἀγνὼς ἀκλεής·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:19.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:19.1.text#τοὺς δ' ἐν τιμαῖς ἧσσον ζηλῶ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:20.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:20.1.text#καὶ μὴν τὸ καλόν γ' ἐνταῦθα βίου.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:21.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:21.1.text#τοῦτο δέ γ' ἐστὶν τὸ καλὸν σφαλερόν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:22.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:22.1.text#καὶ τὸ πρότιμον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:23.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:23.1.text#γλυκὺ μέν, λυπεῖ δὲ προσιστάμενον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:24.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:24.1.text#τοτὲ μὲν τὰ θεῶν οὐκ ὀρθωθέντ'
urn:cts:greekLit:tlg0006.tlg018.fu.sp:25.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:25.1.text#ἀνέτρεψε βίον, τοτὲ δ' ἀνθρώπων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:26.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:26.1.text#γνῶμαι πολλαὶ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:27.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:27.1.text#καὶ δυσάρεστοι διέκναισαν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:28.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:28.1.text#οὐκ ἄγαμαι ταῦτ' ἀνδρὸς ἀριστέως.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:29.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:29.1.text#οὐκ ἐπὶ πᾶσίν σ' ἐφύτευσ' ἀγαθοῖς,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:30.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:30.1.text#Ἀγάμεμνον, Ἀτρεύς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:31.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:31.1.text#δεῖ δέ σε χαίρειν καὶ λυπεῖσθαι·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:32.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:32.1.text#θνητὸς γὰρ ἔφυς. κἂν μὴ σὺ θέλῃς,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:33.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:33.1.text#τὰ θεῶν οὕτω βουλόμεν' ἔσται.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:34.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:34.1.text#σὺ δὲ λαμπτῆρος φάος ἀμπετάσας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:35.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:35.1.text#δέλτον τε γράφεις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:36.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:36.1.text#τήνδ' ἣν πρὸ χερῶν ἔτι βαστάζεις,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:37.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:37.1.text#καὶ ταὐτὰ πάλιν γράμματα συγχεῖς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:38.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:38.1.text#καὶ σφραγίζεις λύεις τ' ὀπίσω
urn:cts:greekLit:tlg0006.tlg018.fu.sp:39.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:39.1.text#ῥίπτεις τε πέδῳ πεύκην, θαλερὸν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:40.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:40.1.text#κατὰ δάκρυ χέων,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:41.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:41.1.text#καὶ τῶν ἀπόρων οὐδενὸς ἐνδεῖς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:42.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:42.1.text#μὴ οὐ μαίνεσθαι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:43.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:43.1.text#τί πονεῖς; τί νέον περὶ σοί, βασιλεῦ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:44.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:44.1.text#φέρε κοίνωσον μῦθον ἐς ἡμᾶς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:45.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:45.1.text#πρὸς { δ' } ἄνδρ' ἀγαθὸν πιστόν τε φράσεις·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:46.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:46.1.text#σῇ γάρ μ' ἀλόχῳ τότε Τυνδάρεως
urn:cts:greekLit:tlg0006.tlg018.fu.sp:47.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:47.1.text#πέμπει φερνὴν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:48.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:48.1.text#συννυμφοκόμον τε δίκαιον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:115.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:115.1.text#πέμπω σοι πρὸς ταῖς πρόσθεν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:116.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:116.1.text#δέλτους, ὦ Λήδας ἔρνος—
urn:cts:greekLit:tlg0006.tlg018.fu.sp:117.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:117.1.text#λέγε καὶ σήμαιν', ἵνα καὶ γλώσσῃ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:118.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:118.1.text#σύντονα τοῖς σοῖς γράμμασιν αὐδῶ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:119.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:119.1.text#μὴ στέλλειν τὰν σὰν ἶνιν πρὸς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:120.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:120.1.text#τὰν κολπώδη πτέρυγ' Εὐβοίας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:121.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:121.1.text#Αὖλιν ἀκλύσταν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:122.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:122.1.text#εἰς ἄλλας ὥρας γὰρ δὴ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:123.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:123.1.text#παιδὸς δαίσομεν ὑμεναίους.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:124.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:124.1.text#καὶ πῶς Ἀχιλεὺς λέκτρων ἀπλακὼν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:125.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:125.1.text#οὐ μέγα φυσῶν θυμὸν ἐπαρεῖ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:126.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:126.1.text#σοὶ σῇ τ' ἀλόχῳ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:127.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:127.1.text#τόδε καὶ δεινόν· σήμαιν' ὅ τι φῄς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:128.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:128.1.text#ὄνομ', οὐκ ἔργον, παρέχων Ἀχιλεὺς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:129.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:129.1.text#οὐκ οἶδε γάμους, οὐδ' ὅ τι πράσσομεν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:130.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:130.1.text#οὐδ' ὅτι κείνῳ παῖδ' ἐπεφήμισα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:131.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:131.1.text#νυμφείους εἰς ἀγκώνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:132.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:132.1.text#εὐνὰς ἐκδώσειν λέκτροις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:133.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:133.1.text#δεινά γ' ἐτόλμας, Ἀγάμεμνον ἄναξ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:134.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:134.1.text#ὃς τῷ τῆς θεᾶς σὴν παῖδ' ἄλοχον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:135.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:135.1.text#φατίσας ἦγες σφάγιον Δαναοῖς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:136.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:136.1.text#οἴμοι, γνώμας ἐξέσταν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:137.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:137.1.text#αἰαῖ, πίπτω δ' εἰς ἄταν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:139.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:139.1.text#ἀλλ' ἴθ' ἐρέσσων σὸν πόδα, γήρᾳ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:140.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:140.1.text#μηδὲν ὑπείκων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:140.2.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:140.2.text#σπεύδω, βασιλεῦ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:141.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:141.1.text#μή νυν μήτ' ἀλσώδεις ἵζου
urn:cts:greekLit:tlg0006.tlg018.fu.sp:142.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:142.1.text#κρήνας μήθ' ὕπνῳ θελχθῇς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:143.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:143.1.text#εὔφημα θρόει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:144.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:144.1.text#πάντῃ δὲ πόρον σχιστὸν ἀμείβων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:145.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:145.1.text#λεῦσσε, φυλάσσων μή τίς σε λάθῃ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:146.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:146.1.text#τροχαλοῖσιν ὄχοις παραμειψαμένη
urn:cts:greekLit:tlg0006.tlg018.fu.sp:147.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:147.1.text#παῖδα κομίζουσ' ἐνθάδ' ἀπήνη
urn:cts:greekLit:tlg0006.tlg018.fu.sp:148.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:148.1.text#Δαναῶν πρὸς ναῦς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:149.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:149.1.text#ἔσται τάδε.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:149.2.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:149.2.text#κλῄθρων δ' ἐξόρμοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:150.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:150.1.text#ἤν νιν πομπαῖς ἀντήσῃς,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:151.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:151.1.text#πάλιν εἰσόρμα, σεῖε χαλινούς,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:152.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:152.1.text#ἐπὶ Κυκλώπων ἱεὶς θυμέλας.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:153.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:153.1.text#πιστὸς δὲ φράσας τάδε πῶς ἔσομαι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:154.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:154.1.text#λέγε, παιδὶ σέθεν τῇ σῇ τ' ἀλόχῳ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:155.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:155.1.text#σφραγῖδα φύλασσ' ἣν ἐπὶ δέλτῳ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:156.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:156.1.text#τήνδε κομίζεις. ἴθι. λευκαίνει
urn:cts:greekLit:tlg0006.tlg018.fu.sp:157.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:157.1.text#τόδε φῶς ἤδη λάμπουσ' ἠὼς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:158.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:158.1.text#πῦρ τε τεθρίππων τῶν Ἀελίου·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:160.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:160.1.text#σύλλαβε μόχθων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:161.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:161.1.text#θνητῶν δ' ὄλβιος ἐς τέλος οὐδεὶς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:162.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:162.1.text#οὐδ' εὐδαίμων·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:163.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:163.1.text#οὔπω γὰρ ἔφυ τις ἄλυπος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:164.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:164.1.text#—ἔμολον ἀμφὶ παρακτίαν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:165.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:165.1.text#ψάμαθον Αὐλίδος ἐναλίας,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:166.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:166.1.text#Εὐρίπου διὰ χευμάτων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:167.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:167.1.text#κέλσασα στενοπόρθμων,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:168.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:168.1.text#Χαλκίδα πόλιν ἐμὰν προλιποῦσ',
urn:cts:greekLit:tlg0006.tlg018.fu.sp:169.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:169.1.text#ἀγχιάλων ὑδάτων τροφὸν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:170.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:170.1.text#τᾶς κλεινᾶς Ἀρεθούσας,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:171.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:171.1.text#Ἀχαιῶν στρατιὰν ὡς ἐσιδοίμαν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:172.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:172.1.text#Ἀχαιῶν τε πλάτας ναυσιπόρους ἡμιθέων,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:173.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:173.1.text#οὓς ἐπὶ Τροίαν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:174.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:174.1.text#ἐλάταις χιλιόναυσιν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:175.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:175.1.text#τὸν ξανθὸν Μενέλαόν θ'
urn:cts:greekLit:tlg0006.tlg018.fu.sp:176.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:176.1.text#ἁμέτεροι πόσεις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:177.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:177.1.text#ἐνέπουσ' Ἀγαμέμνονά τ' εὐπατρίδαν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:178.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:178.1.text#στέλλειν ἐπὶ τὰν Ἑλέναν, ἀπ'
urn:cts:greekLit:tlg0006.tlg018.fu.sp:179.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:179.1.text#Εὐρώτα δονακοτρόφου
urn:cts:greekLit:tlg0006.tlg018.fu.sp:180.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:180.1.text#Πάρις ὁ βουκόλος ἃν ἔλαβε
urn:cts:greekLit:tlg0006.tlg018.fu.sp:181.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:181.1.text#δῶρον τᾶς Ἀφροδίτας,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:182.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:182.1.text#ὅτ' ἐπὶ κρηναίαισι δρόσοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:183.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:183.1.text#Ἥρᾳ Παλλάδι τ' ἔριν ἔριν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:184.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:184.1.text#μορφᾶς ἁ Κύπρις ἔσχεν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:185.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:185.1.text#—πολύθυτον δὲ δι' ἄλσος Ἀρτέμιδος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:186.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:186.1.text#ἤλυθον ὀρομένα,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:187.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:187.1.text#φοινίσσουσα παρῇδ' ἐμὰν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:188.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:188.1.text#αἰσχύνᾳ νεοθαλεῖ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:189.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:189.1.text#ἀσπίδος ἔρυμα καὶ κλισίας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:190.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:190.1.text#ὁπλοφόρους Δαναῶν θέλουσ'
urn:cts:greekLit:tlg0006.tlg018.fu.sp:191.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:191.1.text#ἵππων τ' ὄχλον ἰδέσθαι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:192.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:192.1.text#κατεῖδον δὲ δύ' Αἴαντε συνέδρω,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:193.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:193.1.text#τὸν Οἰλέως Τελαμῶνός τε γόνον, τὸν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:194.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:194.1.text#Σαλαμῖνος στέφανον· Πρωτεσίλαόν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:195.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:195.1.text#τ' ἐπὶ θάκοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:196.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:196.1.text#πεσσῶν ἡδομένους μορφαῖσι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:197.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:197.1.text#πολυπλόκοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:198.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:198.1.text#Παλαμήδεά θ', ὃν τέκε παῖς ὁ Ποσειδᾶνος,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:199.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:199.1.text#Διομήδεά θ' ἡδο-
urn:cts:greekLit:tlg0006.tlg018.fu.sp:200.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:200.1.text#ναῖς δίσκου κεχαρημένον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:201.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:201.1.text#παρὰ δὲ Μηριόνην, Ἄρεος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:202.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:202.1.text#ὄζον, θαῦμα βροτοῖσιν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:203.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:203.1.text#τὸν ἀπὸ νησαίων τ' ὀρέων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:204.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:204.1.text#Λαέρτα τόκον, ἅμα δὲ Νιρέα,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:205.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:205.1.text#κάλλιστον Ἀχαιῶν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:206.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:206.1.text#—τὸν ἰσάνεμόν τε ποδοῖν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:207.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:207.1.text#λαιψηροδρόμον Ἀχιλῆα,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:208.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:208.1.text#τὸν ἁ Θέτις τέκε καὶ Χείρων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:209.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:209.1.text#ἐξεπόνησεν, εἶδον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:210.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:210.1.text#αἰγιαλοῖς παρά τε κροκάλαις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:211.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:211.1.text#δρόμον ἔχοντα σὺν ὅπλοις·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:213.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:213.1.text#ἅμιλλαν δ' ἐπόνει ποδοῖν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:214.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:214.1.text#πρὸς ἅρμα τέτρωρον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:215.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:215.1.text#ἑλίσσων περὶ νίκας.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:216.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:216.1.text#ὁ δὲ διφρηλάτας ἐβοᾶτ',
urn:cts:greekLit:tlg0006.tlg018.fu.sp:217.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:217.1.text#Εὔμηλος Φερητιάδας,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:218.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:218.1.text#ᾧ καλλίστους ἰδόμαν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:219.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:219.1.text#χρυσοδαιδάλτους στομίοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:220.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:220.1.text#πώλους κέντρῳ θεινομένους,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:221.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:221.1.text#τοὺς μὲν μέσους ζυγίους
urn:cts:greekLit:tlg0006.tlg018.fu.sp:222.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:222.1.text#λευκοστίκτῳ τριχὶ βαλιούς,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:223.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:223.1.text#τοὺς δ' ἔξω σειροφόρους
urn:cts:greekLit:tlg0006.tlg018.fu.sp:224.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:224.1.text#ἀντήρεις καμπαῖσι δρόμων,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:225.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:225.1.text#πυρσότριχας, μονόχαλα δ' ὑπὸ σφυρὰ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:226.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:226.1.text#ποικιλοδέρμονας· οἷς παρεπάλλετο
urn:cts:greekLit:tlg0006.tlg018.fu.sp:229.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:229.1.text#Πηλεΐδας σὺν ὅπλοισι παρ' ἄντυγα καὶ σύριγγας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:230.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:230.1.text#ἁρματείους.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:231.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:231.1.text#—ναῶν δ' εἰς ἀριθμὸν ἤλυθον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:232.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:232.1.text#καὶ θέαν ἀθέσφατον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:233.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:233.1.text#τὰν γυναικεῖον ὄψιν ὀμμάτων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:234.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:234.1.text#ὡς πλήσαιμι, μέλινον ἁδονάν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:235.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:235.1.text#καὶ κέρας μὲν ἦν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:236.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:236.1.text#δεξιὸν πλάτας ἔχων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:237.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:237.1.text#Φθιώτας ὁ Μυρμιδὼν Ἄρης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:238.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:238.1.text#πεντήκοντα ναυσὶ θουρίαις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:239.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:239.1.text#χρυσέαις δ' εἰκόσιν κατ' ἄκρα Νηρῇδες
urn:cts:greekLit:tlg0006.tlg018.fu.sp:240.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:240.1.text#ἕστασαν θεαί,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:241.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:241.1.text#πρύμναις σῆμ' Ἀχιλλείου στρατοῦ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:242.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:242.1.text#—Ἀργείων δὲ ταῖσδ' ἰσήρετμοι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:243.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:243.1.text#νᾶες ἕστασαν πέλας·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:244.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:244.1.text#ὧν ὁ Μηκιστέως στρατηλάτας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:245.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:245.1.text#παῖς ἦν, Ταλαὸς ὃν τρέφει πατήρ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:246.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:246.1.text#Καπανέως τε παῖς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:247.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:247.1.text#Σθένελος· Ἀτθίδας δ' ἄγων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:248.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:248.1.text#ἑξήκοντα ναῦς ὁ Θησέως
urn:cts:greekLit:tlg0006.tlg018.fu.sp:249.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:249.1.text#παῖς ἑξῆς ἐναυλόχει, θεὰν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:250.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:250.1.text#Παλλάδ' ἐν μωνύχοις ἔχων πτερωτοῖσιν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:251.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:251.1.text#ἅρμασιν θετόν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:252.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:252.1.text#εὔσημόν γε φάσμα ναυβάταις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:253.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:253.1.text#Βοιωτῶν δ' ὅπλισμα πόντιον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:254.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:254.1.text#πεντήκοντα νῆας εἰδόμαν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:255.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:255.1.text#σημείοισιν ἐστολισμένας·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:256.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:256.1.text#τοῖς δὲ Κάδμος ἦν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:257.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:257.1.text#χρύσεον δράκοντ' ἔχων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:258.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:258.1.text#ἀμφὶ ναῶν κόρυμβα·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:259.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:259.1.text#Λήιτος δ' ὁ γηγενὴς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:260.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:260.1.text#ἆρχε ναΐου στρατοῦ·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:261.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:261.1.text#Φωκίδος δ' ἀπὸ χθονὸς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:262.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:262.1.text#Λοκρᾶς τε τοῖσδ' ἴσας ἄγων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:263.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:263.1.text#ναῦς { ἦλθ' } Οἰλέως τόκος κλυτὰν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:264.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:264.1.text#Θρονιάδ' ἐκλιπὼν πόλιν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:265.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:265.1.text#—Μυκήνας δὲ τᾶς Κυκλωπίας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:266.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:266.1.text#παῖς Ἀτρέως ἔπεμπε ναυβάτας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:267.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:267.1.text#ναῶν ἑκατὸν ἠθροϊσμένους·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:268.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:268.1.text#σὺν δ' Ἄδραστος ἦν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:269.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:269.1.text#ταγός, ὡς φίλος φίλῳ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:270.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:270.1.text#τᾶς φυγούσας μέλαθρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:271.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:271.1.text#βαρβάρων χάριν γάμων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:272.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:272.1.text#πρᾶξιν Ἑλλὰς ὡς λάβοι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:273.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:273.1.text#ἐκ Πύλου δὲ Νέστορος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:274.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:274.1.text#Γερηνίου κατειδόμαν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:275.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:275.1.text#πρύμνας σῆμα ταυρόπουν ὁρᾶν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:276.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:276.1.text#τὸν πάροικον Ἀλφεόν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:277.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:277.1.text#—Αἰνιάνων δὲ δωδεκάστολοι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:278.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:278.1.text#νᾶες ἦσαν, ὧν ἄναξ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:279.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:279.1.text#Γουνεὺς ἆρχε· τῶνδε δ' αὖ πέλας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:280.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:280.1.text#Ἤλιδος δυνάστορες,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:281.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:281.1.text#οὓς Ἐπειοὺς ὠνόμαζε πᾶς λεώς·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:282.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:282.1.text#Εὔρυτος δ' ἄνασσε τῶνδε,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:283.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:283.1.text#λευκήρετμον δ' Ἄρη
urn:cts:greekLit:tlg0006.tlg018.fu.sp:284.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:284.1.text#Τάφιον ἦγεν, ὧν Μέγης ἄνασσε,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:285.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:285.1.text#Φυλέως λόχευμα,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:286.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:286.1.text#τὰς Ἐχίνας λιπὼν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:287.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:287.1.text#νήσους ναυβάταις ἀπροσφόρους.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:288.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:288.1.text#—Αἴας δ' ὁ Σαλαμῖνος ἔντροφος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:290.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:290.1.text#δεξιὸν κέρας { πρὸς τὸ λαιὸν ξυνᾶγε },
urn:cts:greekLit:tlg0006.tlg018.fu.sp:291.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:291.1.text#τῶν ἆσσον ὥρμει πλάταισιν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:292.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:292.1.text#ἐσχάταισι συμπλέκων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:293.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:293.1.text#δώδεκ' εὐστροφωτάταισι ναυσίν. ὣς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:294.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:294.1.text#ἄιον καὶ ναυβάταν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:295.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:295.1.text#εἰδόμαν λεών·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:296.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:296.1.text#ᾧ τις εἰ προσαρμόσει
urn:cts:greekLit:tlg0006.tlg018.fu.sp:297.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:297.1.text#βαρβάρους βάριδας,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:298.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:298.1.text#νόστον οὐκ ἀποίσεται,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:299.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:299.1.text#ἐνθάδ' οἷον εἰδόμαν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:300.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:300.1.text#νάιον πόρευμα,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:301.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:301.1.text#τὰ δὲ κατ' οἴκους κλύουσα συγκλήτου
urn:cts:greekLit:tlg0006.tlg018.fu.sp:302.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:302.1.text#μνήμην σῴζομαι στρατεύματος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:303.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:303.1.text#Μενέλαε, τολμᾷς δείν', ἅ σ' οὐ τολμᾶν χρεών.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:304.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:304.1.text#ἄπελθε· λίαν δεσπόταισι πιστὸς εἶ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:305.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:305.1.text#καλόν γέ μοι τοὔνειδος ἐξωνείδισας.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:306.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:306.1.text#κλαίοις ἄν, εἰ πράσσοις ἃ μὴ πράσσειν σε δεῖ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:307.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:307.1.text#οὐ χρῆν σε λῦσαι δέλτον, ἣν ἐγὼ 'φερον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:308.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:308.1.text#οὐδέ γε φέρειν σὲ πᾶσιν Ἕλλησιν κακά.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:309.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:309.1.text#ἄλλοις ἁμιλλῶ ταῦτ'· ἄφες δὲ τήνδ' ἐμοί.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:310.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:310.1.text#οὐκ ἂν μεθείμην.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:310.2.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:310.2.text#οὐδ' ἔγωγ' ἀφήσομαι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:311.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:311.1.text#σκήπτρῳ τάχ' ἆρα σὸν καθαιμάξω κάρα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:312.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:312.1.text#ἀλλ' εὐκλεές τοι δεσποτῶν θνῄσκειν ὕπερ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:313.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:313.1.text#μέθες· μακροὺς δὲ δοῦλος ὢν λέγεις λόγους.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:314.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:314.1.text#ὦ δέσποτ', ἀδικούμεσθα. σὰς δ' ἐπιστολὰς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:315.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:315.1.text#ἐξαρπάσας ὅδ' ἐκ χερῶν ἐμῶν βίᾳ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:316.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:316.1.text#Ἀγάμεμνον, οὐδὲν τῇ δίκῃ χρῆσθαι θέλει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:317.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:317.1.text#ἔα·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:317.2.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:317.2.text#τίς ποτ' ἐν πύλαισι θόρυβος καὶ λόγων ἀκοσμία;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:318.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:318.1.text#οὑμὸς οὐχ ὁ τοῦδε μῦθος κυριώτερος λέγειν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:319.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:319.1.text#σὺ δὲ τί τῷδ' ἐς ἔριν ἀφῖξαι, Μενέλεως, βίᾳ τ' ἄγεις;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:320.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:320.1.text#βλέψον εἰς ἡμᾶς, ἵν' ἀρχὰς τῶν λόγων ταύτας λάβω.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:321.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:321.1.text#μῶν τρέσας οὐκ ἀνακαλύψω βλέφαρον, Ἀτρέως γεγώς;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:322.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:322.1.text#τήνδ' ὁρᾷς δέλτον, κακίστων γραμμάτων ὑπηρέτιν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:323.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:323.1.text#εἰσορῶ· καὶ πρῶτα ταύτην σῶν ἀπάλλαξον χερῶν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:324.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:324.1.text#οὔ, πρὶν ἂν δείξω γε Δαναοῖς πᾶσι τἀγγεγραμμένα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:325.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:325.1.text#ἦ γὰρ οἶσθ' ἃ μή σε καιρὸς εἰδέναι σήμαντρ' ἀνείς;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:326.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:326.1.text#ὥστε σ' ἀλγῦναί γ', ἀνοίξας ἃ σὺ κάκ' εἰργάσω λάθρᾳ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:327.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:327.1.text#ποῦ δὲ κἄλαβές νιν; ὦ θεοί, σῆς ἀναισχύντου φρενός.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:328.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:328.1.text#προσδοκῶν σὴν παῖδ' ἀπ' Ἄργους, εἰ στράτευμ' ἀφίξεται.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:329.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:329.1.text#τί δέ σε τἀμὰ δεῖ φυλάσσειν; οὐκ ἀναισχύντου τόδε;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:330.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:330.1.text#ὅτι τὸ βούλεσθαί μ' ἔκνιζε· σὸς δὲ δοῦλος οὐκ ἔφυν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:331.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:331.1.text#οὐχὶ δεινά; τὸν ἐμὸν οἰκεῖν οἶκον οὐκ ἐάσομαι;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:332.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:332.1.text#πλάγια γὰρ φρονεῖς, τὰ μὲν νῦν, τὰ δὲ πάλαι, τὰ δ' αὐτίκα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:333.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:333.1.text#εὖ κεκόμψευσαι πονηρά· γλῶσσ' ἐπίφθονον σοφή.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:334.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:334.1.text#νοῦς δέ γ' οὐ βέβαιος ἄδικον κτῆμα κοὐ σαφὲς φίλοις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:335.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:335.1.text#βούλομαι δέ σ' ἐξελέγξαι, καὶ σὺ μήτ' ὀργῆς ὕπο
urn:cts:greekLit:tlg0006.tlg018.fu.sp:336.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:336.1.text#ἀποτρέπου τἀληθὲς οὔτ' αὖ κατατενῶ λίαν ἐγώ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:337.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:337.1.text#οἶσθ', ὅτ' ἐσπούδαζες ἄρχειν Δαναΐδαις πρὸς Ἴλιον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:338.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:338.1.text#τῷ δοκεῖν μὲν οὐχὶ χρῄζων, τῷ δὲ βούλεσθαι θέλων,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:339.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:339.1.text#ὡς ταπεινὸς ἦσθα, πάσης δεξιᾶς προσθιγγάνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:340.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:340.1.text#καὶ θύρας ἔχων ἀκλῄστους τῷ θέλοντι δημοτῶν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:341.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:341.1.text#καὶ διδοὺς πρόσρησιν ἑξῆς πᾶσι — κεἰ μή τις θέλοι —
urn:cts:greekLit:tlg0006.tlg018.fu.sp:342.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:342.1.text#τοῖς τρόποις ζητῶν πρίασθαι τὸ φιλότιμον ἐκ μέσου;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:343.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:343.1.text#κᾆτ', ἐπεὶ κατέσχες ἀρχάς, μεταβαλὼν ἄλλους τρόπους
urn:cts:greekLit:tlg0006.tlg018.fu.sp:344.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:344.1.text#τοῖς φίλοισιν οὐκέτ' ἦσθα τοῖς πρὶν ὡς πρόσθεν φίλος,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:345.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:345.1.text#δυσπρόσιτος ἔσω τε κλῄθρων σπάνιος. ἄνδρα δ' οὐ χρεὼν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:346.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:346.1.text#τὸν ἀγαθὸν πράσσοντα μεγάλα τοὺς τρόπους μεθιστάναι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:347.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:347.1.text#ἀλλὰ καὶ βέβαιον εἶναι τότε μάλιστα τοῖς φίλοις,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:348.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:348.1.text#ἡνίκ' ὠφελεῖν μάλιστα δυνατός ἐστιν εὐτυχῶν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:349.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:349.1.text#ταῦτα μέν σε πρῶτ' ἐπῆλθον, ἵνα σε πρῶθ' ηὗρον κακόν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:350.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:350.1.text#ὡς δ' ἐς Αὖλιν ἦλθες αὖθις χὡ Πανελλήνων στρατός,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:351.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:351.1.text#οὐδὲν ἦσθ', ἀλλ' ἐξεπλήσσου τῇ τύχῃ τῇ τῶν θεῶν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:352.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:352.1.text#οὐρίας πομπῆς σπανίζων· Δαναΐδαι δ' ἀφιέναι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:353.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:353.1.text#ναῦς διήγγελλον, μάτην δὲ μὴ πονεῖν ἐν Αὐλίδι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:354.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:354.1.text#ὡς ἄνολβον εἶχες ὄμμα σύγχυσίν τ', εἰ μὴ νεῶν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:355.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:355.1.text#χιλίων ἄρχων τὸ Πριάμου πεδίον ἐμπλήσεις δορός.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:356.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:356.1.text#κἀμὲ παρεκάλεις· Τί δράσω; τίνα δὲ πόρον εὕρω πόθεν; —
urn:cts:greekLit:tlg0006.tlg018.fu.sp:357.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:357.1.text#ὥστε μὴ στερέντα σ' ἀρχῆς ἀπολέσαι καλὸν κλέος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:358.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:358.1.text#κᾆτ', ἐπεὶ Κάλχας ἐν ἱεροῖς εἶπε σὴν θῦσαι κόρην
urn:cts:greekLit:tlg0006.tlg018.fu.sp:359.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:359.1.text#Ἀρτέμιδι, καὶ πλοῦν ἔσεσθαι Δαναΐδαις, ἡσθεὶς φρένας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:360.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:360.1.text#ἄσμενος θύσειν ὑπέστης παῖδα· καὶ πέμπεις ἑκών,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:361.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:361.1.text#οὐ βίᾳ — μὴ τοῦτο λέξῃς — σῇ δάμαρτι, παῖδα σὴν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:362.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:362.1.text#δεῦρ' ἀποστέλλειν, Ἀχιλλεῖ πρόφασιν ὡς γαμουμένην.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:363.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:363.1.text#κᾆθ' ὑποστρέψας λέληψαι μεταβαλὼν ἄλλας γραφάς,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:364.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:364.1.text#ὡς φονεὺς οὐκέτι θυγατρὸς σῆς ἔσῃ. μάλιστά γε.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:365.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:365.1.text#οὗτος αὑτός ἐστιν αἰθὴρ ὃς τάδ' ἤκουσεν σέθεν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:366.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:366.1.text#μυρίοι δέ τοι πεπόνθασ' αὐτό· πρὸς τὰ πράγματα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:367.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:367.1.text#ἐκπονοῦσ' ἔχοντες, εἶτα δ' ἐξεχώρησαν κακῶς,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:368.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:368.1.text#τὰ μὲν ὑπὸ γνώμης πολιτῶν ἀσυνέτου, τὰ δ' ἐνδίκως
urn:cts:greekLit:tlg0006.tlg018.fu.sp:369.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:369.1.text#ἀδύνατοι γεγῶτες αὐτοὶ διαφυλάξασθαι πόλιν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:370.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:370.1.text#Ἑλλάδος μάλιστ' ἔγωγε τῆς ταλαιπώρου στένω,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:371.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:371.1.text#ἥ, θέλουσα δρᾶν τι κεδνόν, βαρβάρους τοὺς οὐδένας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:372.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:372.1.text#καταγελῶντας ἐξανήσει διὰ σὲ καὶ τὴν σὴν κόρην.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:373.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:373.1.text#μηδέν' ἀνδρείας ἕκατι προστάτην θείμην χθονός,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:374.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:374.1.text#μηδ' ὅπλων ἄρχοντα· νοῦν χρὴ τὸν στρατηλάτην ἔχειν·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:375.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:375.1.text#πόλεος ὡς ἄρχων ἀνὴρ πᾶς, ξύνεσιν ἢν ἔχων τύχῃ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:376.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:376.1.text#δεινὸν κασιγνήτοισι γίγνεσθαι λόγους
urn:cts:greekLit:tlg0006.tlg018.fu.sp:377.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:377.1.text#μάχας θ', ὅταν ποτ' ἐμπέσωσιν εἰς ἔριν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:378.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:378.1.text#βούλομαί σ' εἰπεῖν κακῶς εὖ, βραχέα, μὴ λίαν ἄνω
urn:cts:greekLit:tlg0006.tlg018.fu.sp:379.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:379.1.text#βλέφαρα πρὸς τἀναιδὲς ἀγαγών, ἀλλὰ σωφρονεστέρως,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:380.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:380.1.text#ὡς ἀδελφὸν ὄντ'· ἀνὴρ γὰρ χρηστὸς αἰδεῖσθαι φιλεῖ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:381.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:381.1.text#εἰπέ μοι, τί δεινὰ φυσᾷς αἱματηρὸν ὄμμ' ἔχων;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:382.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:382.1.text#τίς ἀδικεῖ σε; τοῦ κέχρησαι; χρηστὰ λέκτρ' ἐρᾷς λαβεῖν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:383.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:383.1.text#οὐκ ἔχοιμ' ἄν σοι παρασχεῖν· ὧν γὰρ ἐκτήσω, κακῶς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:384.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:384.1.text#ἦρχες. εἶτ' ἐγὼ δίκην δῶ σῶν κακῶν, ὁ μὴ σφαλείς;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:385.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:385.1.text#οὐ δάκνει σε τὸ φιλότιμον τοὐμόν, ἀλλ' ἐν ἀγκάλαις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:386.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:386.1.text#εὐπρεπῆ γυναῖκα χρῄζεις, τὸ λελογισμένον παρεὶς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:387.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:387.1.text#καὶ τὸ καλόν, ἔχειν. πονηροῦ φωτὸς ἡδοναὶ κακαί.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:388.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:388.1.text#εἰ δ' ἐγώ, γνοὺς πρόσθεν οὐκ εὖ, μετετέθην εὐβουλίᾳ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:389.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:389.1.text#μαίνομαι; σὺ μᾶλλον, ὅστις ἀπολέσας κακὸν λέχος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:390.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:390.1.text#ἀναλαβεῖν θέλεις, θεοῦ σοι τὴν τύχην διδόντος εὖ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:391.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:391.1.text#ὤμοσαν τὸν Τυνδάρειον ὅρκον οἱ κακόφρονες
urn:cts:greekLit:tlg0006.tlg018.fu.sp:392.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:392.1.text#φιλόγαμοι μνηστῆρες — ἡ δέ γ' Ἐλπίς, οἶμαι μέν, θεός,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:393.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:393.1.text#κἀξέπραξεν αὐτὸ μᾶλλον ἢ σὺ καὶ τὸ σὸν σθένος —
urn:cts:greekLit:tlg0006.tlg018.fu.sp:394.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:394.1.text#οὓς λαβὼν στράτευε· ἕτοιμοι δ' εἰσὶ μωρίᾳ φρενῶν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:394a.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:394a.1.text#οὐ γὰρ ἀσύνετον τὸ θεῖον, ἀλλ' ἔχει συνιέναι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:395.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:395.1.text#τοὺς κακῶς παγέντας ὅρκους καὶ κατηναγκασμένους.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:396.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:396.1.text#τἀμὰ δ' οὐκ ἀποκτενῶ 'γὼ τέκνα· κοὐ τὸ σὸν μὲν εὖ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:397.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:397.1.text#παρὰ δίκην ἔσται κακίστης εὔνιδος τιμωρίᾳ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:398.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:398.1.text#ἐμὲ δὲ συντήξουσι νύκτες ἡμέραι τε δακρύοις,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:399.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:399.1.text#ἄνομα δρῶντα κοὐ δίκαια παῖδας οὓς ἐγεινάμην.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:400.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:400.1.text#ταῦτά σοι βραχέα λέλεκται καὶ σαφῆ καὶ ῥᾴδια·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:401.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:401.1.text#εἰ δὲ μὴ βούλῃ φρονεῖν εὖ, τἄμ' ἐγὼ θήσω καλῶς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:402.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:402.1.text#οἵδ' αὖ διάφοροι τῶν πάρος λελεγμένων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:403.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:403.1.text#μύθων, καλῶς δ' ἔχουσι, φείδεσθαι τέκνων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:404.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:404.1.text#αἰαῖ, φίλους ἄρ' οὐχὶ κεκτήμην τάλας.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:405.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:405.1.text#εἰ τοὺς φίλους γε μὴ θέλεις ἀπολλύναι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:406.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:406.1.text#δείξεις δὲ ποῦ μοι πατρὸς ἐκ ταὐτοῦ γεγώς;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:407.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:407.1.text#συνσωφρονεῖν σοι βούλομ', ἀλλ' οὐ συννοσεῖν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:408.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:408.1.text#ἐς κοινὸν ἀλγεῖν τοῖς φίλοισι χρὴ φίλους.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:409.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:409.1.text#εὖ δρῶν παρακάλει μ', ἀλλὰ μὴ λυπῶν ἐμέ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:410.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:410.1.text#οὐκ ἄρα δοκεῖ σοι τάδε πονεῖν σὺν Ἑλλάδι;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:411.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:411.1.text#Ἑλλὰς δὲ σὺν σοὶ κατὰ θεὸν νοσεῖ τινα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:412.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:412.1.text#σκήπτρῳ νυν αὔχει, σὸν κασίγνητον προδούς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:413.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:413.1.text#ἐγὼ δ' ἐπ' ἄλλας εἶμι μηχανάς τινας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:414.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:414.1.text#φίλους τ' ἐπ' ἄλλους —
urn:cts:greekLit:tlg0006.tlg018.fu.sp:414.2.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:414.2.text#ὦ Πανελλήνων ἄναξ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:415.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:415.1.text#Ἀγάμεμνον, ἥκω παῖδά σοι τὴν σὴν ἄγων,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:416.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:416.1.text#ἣν Ἰφιγένειαν ὠνόμαζες ἐν δόμοις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:417.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:417.1.text#μήτηρ δ' ὁμαρτεῖ, σῆς Κλυταιμήστρας δέμας,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:418.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:418.1.text#καὶ παῖς Ὀρέστης, ὥς τι τερφθείης ἰδών,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:419.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:419.1.text#χρόνον παλαιὸν δωμάτων ἔκδημος ὤν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:420.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:420.1.text#ἀλλ' ὡς μακρὰν ἔτεινον, εὔρυτον παρὰ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:421.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:421.1.text#κρήνην ἀναψύχουσι θηλύπουν βάσιν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:422.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:422.1.text#αὐταί τε πῶλοί τ'· ἐς δὲ λειμώνων χλόην
urn:cts:greekLit:tlg0006.tlg018.fu.sp:423.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:423.1.text#καθεῖμεν αὐτάς, ὡς βορᾶς γευσαίατο.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:424.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:424.1.text#ἐγὼ δὲ πρόδρομος σῆς παρασκευῆς χάριν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:425.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:425.1.text#ἥκω· πέπυσται γὰρ στρατός — ταχεῖα γὰρ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:426.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:426.1.text#διῇξε φήμη — παῖδα σὴν ἀφιγμένην.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:427.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:427.1.text#πᾶς δ' ἐς θένα ὅμιλος ἔρχεται δρόμῳ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:428.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:428.1.text#σὴν παῖδ' ὅπως ἴδωσιν· οἱ δ' εὐδαίμονες
urn:cts:greekLit:tlg0006.tlg018.fu.sp:429.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:429.1.text#ἐν πᾶσι κλεινοὶ καὶ περίβλεπτοι βροτοῖς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:430.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:430.1.text#λέγουσι δ'· Ὑμέναιός τις ἢ τί πράσσεται;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:431.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:431.1.text#ἢ πόθον ἔχων θυγατρὸς Ἀγαμέμνων ἄναξ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:432.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:432.1.text#ἐκόμισε παῖδα; τῶν δ' ἂν ἤκουσας τάδε·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:433.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:433.1.text#Ἀρτέμιδι προτελίζουσι τὴν νεάνιδα,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:434.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:434.1.text#Αὐλίδος ἀνάσσῃ. τίς νιν ἄξεταί ποτε;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:435.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:435.1.text#ἀλλ' εἶα, τἀπὶ τοισίδ' ἐξάρχου κανᾶ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:436.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:436.1.text#στεφανοῦσθε κρᾶτα καὶ σύ, Μενέλεως ἄναξ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:437.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:437.1.text#ὑμέναιον εὐτρέπιζε καὶ κατὰ στέγας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:438.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:438.1.text#λωτὸς βοάσθω καὶ ποδῶν ἔστω κτύπος·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:439.1.speaker#Αγγελος Α
urn:cts:greekLit:tlg0006.tlg018.fu.sp:439.1.text#φῶς γὰρ τόδ' ἥκει μακάριον τῇ παρθένῳ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:440.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:440.1.text#ἐπῄνεσ', ἀλλὰ στεῖχε δωμάτων ἔσω·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:441.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:441.1.text#τὰ δ' ἄλλ' ἰούσης τῆς τύχης ἔσται καλῶς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:442.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:442.1.text#οἴμοι, τί φῶ δύστηνος; ἄρξωμαι πόθεν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:443.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:443.1.text#ἐς οἷ' ἀνάγκης ζεύγματ' ἐμπεπτώκαμεν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:444.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:444.1.text#ὑπῆλθε δαίμων, ὥστε τῶν σοφισμάτων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:445.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:445.1.text#πολλῷ γενέσθαι τῶν ἐμῶν σοφώτερος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:446.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:446.1.text#ἡ δυσγένεια δ' ὡς ἔχει τι χρήσιμον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:447.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:447.1.text#καὶ γὰρ δακρῦσαι ῥᾳδίως αὐτοῖς ἔχει,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:448.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:448.1.text#ἅπαντά τ' εἰπεῖν. τῷ δὲ γενναίῳ φύσιν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:449.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:449.1.text#ἄνολβα ταῦτα. προστάτην δὲ τοῦ βίου
urn:cts:greekLit:tlg0006.tlg018.fu.sp:450.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:450.1.text#τὸν ὄγκον ἔχομεν τῷ τ' ὄχλῳ δουλεύομεν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:451.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:451.1.text#ἐγὼ γὰρ ἐκβαλεῖν μὲν αἰδοῦμαι δάκρυ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:452.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:452.1.text#τὸ μὴ δακρῦσαι δ' αὖθις αἰδοῦμαι τάλας,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:453.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:453.1.text#ἐς τὰς μεγίστας συμφορὰς ἀφιγμένος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:454.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:454.1.text#εἶἑν· τί φήσω πρὸς δάμαρτα τὴν ἐμήν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:455.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:455.1.text#πῶς δέξομαί νιν; ποῖον ὄμμα συμβαλῶ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:456.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:456.1.text#καὶ γάρ μ' ἀπώλεσ' ἐπὶ κακοῖς ἅ μοι πάρος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:457.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:457.1.text#ἐλθοῦσ' ἄκλητος. εἰκότως δ' ἅμ' ἕσπετο
urn:cts:greekLit:tlg0006.tlg018.fu.sp:458.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:458.1.text#θυγατρὶ νυμφεύσουσα καὶ τὰ φίλτατα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:459.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:459.1.text#δώσουσ', ἵν' ἡμᾶς ὄντας εὑρήσει κακούς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:460.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:460.1.text#τὴν δ' αὖ τάλαιναν παρθένον — τί παρθένον;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:461.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:461.1.text#Ἅιδης νιν, ὡς ἔοικε, νυμφεύσει τάχα —
urn:cts:greekLit:tlg0006.tlg018.fu.sp:462.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:462.1.text#ὡς ᾤκτισ'· οἶμαι γάρ νιν ἱκετεύσειν τάδε·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:463.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:463.1.text#Ὦ πάτερ, ἀποκτενεῖς με; τοιούτους γάμους
urn:cts:greekLit:tlg0006.tlg018.fu.sp:464.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:464.1.text#γήμειας αὐτὸς χὥστις ἐστί σοι φίλος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:465.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:465.1.text#παρὼν δ' Ὀρέστης ἐγγὺς ἀναβοήσεται
urn:cts:greekLit:tlg0006.tlg018.fu.sp:466.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:466.1.text#οὐ συνετὰ συνετῶς· ἔτι γάρ ἐστι νήπιος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:467.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:467.1.text#αἰαῖ, τὸν Ἑλένης ὥς μ' ἀπώλεσεν γάμον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:468.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:468.1.text#γήμας ὁ Πριάμου Πάρις, ὃς εἴργασται τάδε.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:469.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:469.1.text#κἀγὼ κατῴκτιρ', ὡς γυναῖκα δεῖ ξένην
urn:cts:greekLit:tlg0006.tlg018.fu.sp:470.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:470.1.text#ὑπὲρ τυράννων συμφορᾶς καταστένειν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:471.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:471.1.text#ἀδελφέ, δός μοι δεξιᾶς τῆς σῆς θιγεῖν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:472.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:472.1.text#δίδωμι· σὸν γὰρ τὸ κράτος, ἄθλιος δ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:473.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:473.1.text#Πέλοπα κατόμνυμ', ὃς πατὴρ τοὐμοῦ πατρὸς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:474.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:474.1.text#τοῦ σοῦ τ' ἐκλήθη, τὸν τεκόντα τ' Ἀτρέα,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:475.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:475.1.text#ἦ μὴν ἐρεῖν σοι τἀπὸ καρδίας σαφῶς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:476.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:476.1.text#καὶ μὴ 'πίτηδες μηδέν, ἀλλ' ὅσον φρονῶ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:477.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:477.1.text#ἐγώ σ' ἀπ' ὄσσων ἐκβαλόντ' ἰδὼν δάκρυ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:478.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:478.1.text#ᾤκτιρα, καὐτὸς ἀνταφῆκά σοι πάλιν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:479.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:479.1.text#καὶ τῶν παλαιῶν ἐξαφίσταμαι λόγων,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:480.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:480.1.text#οὐκ ἐς σὲ δεινός· εἰμὶ δ' οὗπερ εἶ σὺ νῦν·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:481.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:481.1.text#καί σοι παραινῶ μήτ' ἀποκτείνειν τέκνον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:482.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:482.1.text#μήτ' ἀνθελέσθαι τοὐμόν. οὐ γὰρ ἔνδικον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:483.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:483.1.text#σὲ μὲν στενάζειν, τἀμὰ δ' ἡδέως ἔχειν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:484.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:484.1.text#θνῄσκειν τε τοὺς σούς, τοὺς δ' ἐμοὺς ὁρᾶν φάος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:485.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:485.1.text#τί βούλομαι γάρ; οὐ γάμους ἐξαιρέτους
urn:cts:greekLit:tlg0006.tlg018.fu.sp:486.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:486.1.text#ἄλλους λάβοιμ' ἄν, εἰ γάμων ἱμείρομαι;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:487.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:487.1.text#ἀλλ' ἀπολέσας ἀδελφόν, ὅν μ' ἥκιστα χρῆν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:488.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:488.1.text#Ἑλένην ἕλωμαι, τὸ κακὸν ἀντὶ τἀγαθοῦ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:489.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:489.1.text#ἄφρων νέος τ' ἦ, πρὶν τὰ πράγματ' ἐγγύθεν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:490.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:490.1.text#σκοπῶν ἐσεῖδον οἷον ἦν κτείνειν τέκνα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:491.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:491.1.text#ἄλλως τέ μ' ἔλεος τῆς ταλαιπώρου κόρης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:492.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:492.1.text#ἐσῆλθε, συγγένειαν ἐννοουμένῳ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:493.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:493.1.text#ἣ τῶν ἐμῶν ἕκατι θύεσθαι γάμων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:494.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:494.1.text#μέλλει. τί δ' Ἑλένης παρθένῳ τῇ σῇ μέτα;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:495.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:495.1.text#ἴτω στρατεία διαλυθεῖσ' ἐξ Αὐλίδος,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:496.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:496.1.text#σὺ δ' ὄμμα παῦσαι δακρύοις τέγγων τὸ σόν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:497.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:497.1.text#ἀδελφέ, κἀμὲ παρακαλῶν ἐς δάκρυα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:498.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:498.1.text#εἰ δέ τι κόρης σῆς θεσφάτων μέτεστι σοί,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:499.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:499.1.text#μὴ 'μοὶ μετέστω· σοὶ νέμω τοὐμὸν μέρος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:500.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:500.1.text#ἀλλ' ἐς μεταβολὰς ἦλθον ἀπὸ δεινῶν λόγων;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:501.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:501.1.text#εἰκὸς πέπονθα· τὸν ὁμόθεν πεφυκότα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:502.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:502.1.text#στέργων μετέπεσον. ἀνδρὸς οὐ κακοῦ τροπαὶ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:503.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:503.1.text#τοιαίδε, χρῆσθαι τοῖσι βελτίστοις ἀεί.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:504.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:504.1.text#γενναῖ' ἔλεξας Ταντάλῳ τε τῷ Διὸς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:505.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:505.1.text#πρέποντα· προγόνους οὐ καταισχύνεις σέθεν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:506.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:506.1.text#αἰνῶ σε, Μενέλα', ὅτι παρὰ γνώμην ἐμὴν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:507.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:507.1.text#ὑπέθηκας ὀρθῶς τοὺς λόγους σοῦ τ' ἀξίως.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:508.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:508.1.text#ταραχὴ δ' ἀδελφῶν διά τ' ἔρωτα γίγνεται
urn:cts:greekLit:tlg0006.tlg018.fu.sp:509.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:509.1.text#πλεονεξίαν τε δωμάτων· ἀπέπτυσα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:510.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:510.1.text#τοιάνδε συγγένειαν ἀλλήλοιν πικράν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:511.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:511.1.text#ἀλλ' ἥκομεν γὰρ εἰς ἀναγκαίας τύχας,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:512.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:512.1.text#θυγατρὸς αἱματηρὸν ἐκπρᾶξαι φόνον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:513.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:513.1.text#πῶς; τίς δ' ἀναγκάσει σε τήν γε σὴν κτανεῖν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:514.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:514.1.text#ἅπας Ἀχαιῶν σύλλογος στρατεύματος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:515.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:515.1.text#οὔκ, ἤν νιν εἰς Ἄργος γ' ἀποστείλῃς πάλιν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:516.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:516.1.text#λάθοιμι τοῦτ' ἄν. ἀλλ' ἐκεῖν' οὐ λήσομεν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:517.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:517.1.text#τὸ ποῖον; οὔτοι χρὴ λίαν ταρβεῖν ὄχλον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:518.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:518.1.text#Κάλχας ἐρεῖ μαντεύματ' Ἀργείων στρατῷ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:519.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:519.1.text#οὔκ, ἢν θάνῃ γε πρόσθε· τοῦτο δ' εὐμαρές.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:520.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:520.1.text#τὸ μαντικὸν πᾶν σπέρμα φιλότιμον κακόν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:521.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:521.1.text#{ κοὐδέν γ' ἄχρηστον, οὐδὲ χρήσιμον παρόν. }
urn:cts:greekLit:tlg0006.tlg018.fu.sp:522.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:522.1.text#ἐκεῖνο δ' οὐ δέδοικας ὃ ἔμ' ἐσέρχεται;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:523.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:523.1.text#ὃν μὴ σὺ φράζεις, πῶς ὑπολάβοιμ' ἂν λόγον;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:524.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:524.1.text#τὸ Σισύφειον σπέρμα πάντ' οἶδεν τάδε.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:525.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:525.1.text#οὐκ ἔστ' Ὀδυσσεὺς ὅ τι σὲ κἀμὲ πημανεῖ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:526.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:526.1.text#ποικίλος ἀεὶ πέφυκε τοῦ τ' ὄχλου μέτα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:527.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:527.1.text#φιλοτιμίᾳ μὲν ἐνέχεται, δεινῷ κακῷ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:528.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:528.1.text#οὐκ οὖν δοκεῖς νιν στάντ' ἐν Ἀργείοις μέσοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:529.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:529.1.text#λέξειν ἃ Κάλχας θέσφατ' ἐξηγήσατο,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:530.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:530.1.text#κἄμ' ὡς ὑπέστην θῦμα, κᾆτ' ἐψευδόμην,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:531.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:531.1.text#Ἀρτέμιδι θύσειν; οὐ ξυναρπάσας στρατόν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:532.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:532.1.text#σὲ κἄμ' ἀποκτείναντας Ἀργείους κόρην
urn:cts:greekLit:tlg0006.tlg018.fu.sp:533.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:533.1.text#σφάξαι κελεύσει; κἂν πρὸς Ἄργος ἐκφύγω,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:534.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:534.1.text#ἐλθόντες αὐτοῖς τείχεσιν Κυκλωπίοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:535.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:535.1.text#συναρπάσουσι καὶ κατασκάψουσι γῆν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:536.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:536.1.text#τοιαῦτα τἀμὰ πήματ'· ὦ τάλας ἐγώ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:537.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:537.1.text#ὡς ἠπόρημαι πρὸς θεῶν τὰ νῦν τάδε.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:538.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:538.1.text#ἕν μοι φύλαξον, Μενέλεως, ἀνὰ στρατὸν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:539.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:539.1.text#ἐλθών, ὅπως ἂν μὴ Κλυταιμήστρα τάδε
urn:cts:greekLit:tlg0006.tlg018.fu.sp:540.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:540.1.text#μάθῃ, πρὶν Ἅιδῃ παῖδ' ἐμὴν προσθῶ λαβών,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:541.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:541.1.text#ὡς ἐπ' ἐλαχίστοις δακρύοις πράσσω κακῶς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:542.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:542.1.text#ὑμεῖς τε σιγήν, ὦ ξέναι, φυλάσσετε.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:543.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:543.1.text#—μάκαρες οἳ μετρίας θεοῦ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:544.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:544.1.text#μετά τε σωφροσύνας μετέσχον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:545.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:545.1.text#λέκτρων Ἀφροδίτας,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:546.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:546.1.text#γαλανείᾳ χρησάμενοι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:547.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:547.1.text#μανιάδων οἴστρων, ὅθι δὴ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:548.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:548.1.text#δίδυμ' Ἔρως ὁ χρυσοκόμας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:549.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:549.1.text#τόξ' ἐντείνεται χαρίτων,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:550.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:550.1.text#τὸ μὲν ἐπ' εὐαίωνι πότμῳ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:551.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:551.1.text#τὸ δ' ἐπὶ συγχύσει βιοτᾶς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:552.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:552.1.text#ἀπενέπω νιν ἁμετέρων,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:553.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:553.1.text#Κύπρι καλλίστα, θαλάμων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:554.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:554.1.text#εἴη δέ μοι μετρία μὲν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:555.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:555.1.text#χάρις, πόθοι δ' ὅσιοι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:556.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:556.1.text#καὶ μετέχοιμι τᾶς Ἀφροδίτας,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:557.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:557.1.text#πολλὰν δ' ἀποθείμαν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:558.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:558.1.text#—διάφοροι δὲ φύσεις βροτῶν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:559.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:559.1.text#διάφοροι δὲ τρόποι· τὸ δ' ὀρθῶς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:560.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:560.1.text#ἐσθλὸν σαφὲς αἰεί·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:561.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:561.1.text#τροφαί θ' αἱ παιδευόμεναι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:562.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:562.1.text#μέγα φέρουσ' ἐς τὰν ἀρετάν·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:563.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:563.1.text#τό τε γὰρ αἰδεῖσθαι σοφία,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:564.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:564.1.text#τάν τ' ἐξαλλάσσουσαν ἔχει
urn:cts:greekLit:tlg0006.tlg018.fu.sp:565.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:565.1.text#χάριν ὑπὸ γνώμας ἐσορᾶν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:566.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:566.1.text#τὸ δέον, ἔνθα δόξα φέρει
urn:cts:greekLit:tlg0006.tlg018.fu.sp:567.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:567.1.text#κλέος ἀγήρατον βιοτᾷ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:568.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:568.1.text#μέγα τι θηρεύειν ἀρετάν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:569.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:569.1.text#γυναιξὶ μὲν κατὰ Κύπριν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:570.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:570.1.text#κρυπτάν, ἐν ἀνδράσι δ' αὖ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:571.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:571.1.text#κόσμος ἐνὼν ὁ μυριοπληθὴς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:572.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:572.1.text#μείζω πόλιν αὔξει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:573.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:573.1.text#—ἔμολες, ὦ Πάρις, ᾗτε σύ γε
urn:cts:greekLit:tlg0006.tlg018.fu.sp:574.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:574.1.text#βουκόλος ἀργενναῖς ἐτράφης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:575.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:575.1.text#Ἰδαίαις παρὰ μόσχοις,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:576.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:576.1.text#βάρβαρα συρίζων, Φρυγίων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:577.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:577.1.text#αὐλῶν Ὀλύμπου καλάμοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:578.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:578.1.text#μιμήματα πνείων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:579.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:579.1.text#εὔθηλοι δὲ τρέφοντο βόες,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:580.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:580.1.text#ὅτε σε κρίσις ἔμηνε θεᾶν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:581.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:581.1.text#ἅ σ' Ἑλλάδα πέμπει·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:582.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:582.1.text#ἐλεφαντοδέτων πάροιθεν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:583.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:583.1.text#δόμων δὲ στὰς Ἑλένας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:584.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:584.1.text#ἐν ἀντωποῖς βλεφάροισιν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:585.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:585.1.text#ἔρωτά τ' ἔδωκας, ἔρωτι δ'
urn:cts:greekLit:tlg0006.tlg018.fu.sp:586.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:586.1.text#αὐτὸς ἐπτοάθης.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:587.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:587.1.text#ὅθεν ἔρις ἔριν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:588.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:588.1.text#Ἑλλάδα σὺν δορὶ ναυσί τ' ἄγει
urn:cts:greekLit:tlg0006.tlg018.fu.sp:589.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:589.1.text#[ ἐς ] Τροίας πέργαμα [ … ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:590.1.speaker#Χορός ανδρων Αργειων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:590.1.text#ἰὼ ἰώ· μεγάλαι μεγάλων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:591.1.speaker#Χορός ανδρων Αργειων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:591.1.text#εὐδαιμονίαι· τὴν τοῦ βασιλέως
urn:cts:greekLit:tlg0006.tlg018.fu.sp:592.1.speaker#Χορός ανδρων Αργειων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:592.1.text#ἴδετ' Ἰφιγένειαν, ἄνασσαν ἐμήν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:593.1.speaker#Χορός ανδρων Αργειων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:593.1.text#τὴν Τυνδάρεω τε Κλυταιμήστραν·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:594.1.speaker#Χορός ανδρων Αργειων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:594.1.text#ὡς ἐκ μεγάλων ἐβλαστήκασ'
urn:cts:greekLit:tlg0006.tlg018.fu.sp:595.1.speaker#Χορός ανδρων Αργειων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:595.1.text#ἐπί τ' εὐμήκεις ἥκουσι τύχας.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:596.1.speaker#Χορός ανδρων Αργειων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:596.1.text#θεοί γ' οἱ κρείσσους οἵ τ' ὀλβοφόροι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:597.1.speaker#Χορός ανδρων Αργειων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:597.1.text#τοῖς οὐκ εὐδαίμοσι θνητῶν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:598.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:598.1.text#στῶμεν, Χαλκίδος ἔκγονα θρέμματα,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:599.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:599.1.text#τὴν βασίλειαν δεξώμεθ' ὄχων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:600.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:600.1.text#ἄπο μὴ σφαλερῶς ἐπὶ γαῖαν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:601.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:601.1.text#ἀγανῶς δὲ χεροῖν μαλακῇ ῥώμῃ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:602.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:602.1.text#μὴ ταρβήσῃ { νεωστί μοι μολὸν }
urn:cts:greekLit:tlg0006.tlg018.fu.sp:603.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:603.1.text#{ κλεινὸν τέκνον Ἀγαμέμνονος, }
urn:cts:greekLit:tlg0006.tlg018.fu.sp:604.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:604.1.text#{ μηδὲ θόρυβον } μηδ' ἔκπληξιν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:605.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:605.1.text#ταῖς Ἀργείαις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:606.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:606.1.text#ξεῖναι ξείναις παρέχωμεν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:607.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:607.1.text#ὄρνιθα μὲν τόνδ' αἴσιον ποιούμεθα,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:608.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:608.1.text#τὸ σόν τε χρηστὸν καὶ λόγων εὐφημίαν·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:609.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:609.1.text#ἐλπίδα δ' ἔχω τιν' ὡς ἐπ' ἐσθλοῖσιν γάμοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:610.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:610.1.text#πάρειμι νυμφαγωγός. ἀλλ' ὀχημάτων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:611.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:611.1.text#ἔξω πορεύεθ' ἃς φέρω φερνὰς κόρῃ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:612.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:612.1.text#καὶ πέμπετ' ἐς μέλαθρον εὐλαβούμενοι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:613.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:613.1.text#σὺ δ', ὦ τέκνον μοι, λεῖπε πωλικοὺς ὄχους,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:614.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:614.1.text#ἁβρὸν τιθεῖσα κῶλον ἀσθενές θ' ἅμα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:615.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:615.1.text#ὑμεῖς δέ, νεάνιδές, νιν ἀγκάλαις ἔπι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:616.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:616.1.text#δέξασθε καὶ πορεύσατ' ἐξ ὀχημάτων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:617.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:617.1.text#κἀμοὶ χερός τις ἐνδότω στηρίγματα,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:618.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:618.1.text#θάκους ἀπήνης ὡς ἂν ἐκλίπω καλῶς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:619.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:619.1.text#αἳ δ' ἐς τὸ πρόσθεν στῆτε πωλικῶν ζυγῶν·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:620.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:620.1.text#φοβερὸν γὰρ ἀπαράμυθον ὄμμα πωλικόν·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:621.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:621.1.text#καὶ παῖδα τόνδε, τὸν Ἀγαμέμνονος γόνον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:622.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:622.1.text#λάζυσθ', Ὀρέστην· ἔτι γάρ ἐστι νήπιος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:623.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:623.1.text#τέκνον, καθεύδεις πωλικῷ δαμεὶς ὄχῳ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:624.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:624.1.text#ἔγειρ' ἀδελφῆς ἐφ' ὑμέναιον εὐτυχῶς·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:625.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:625.1.text#ἀνδρὸς γὰρ ἀγαθοῦ κῆδος αὐτὸς ἐσθλὸς ὢν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:626.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:626.1.text#λήψῃ, κόρης Νηρῇδος ἰσόθεον γένος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:627.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:627.1.text#ἑξῆς κάθησο δεῦρό μου ποδός, τέκνον·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:628.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:628.1.text#πρὸς μητέρ', Ἰφιγένεια, μακαρίαν δέ με
urn:cts:greekLit:tlg0006.tlg018.fu.sp:629.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:629.1.text#ξέναισι ταῖσδε πλησία σταθεῖσα δός,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:630.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:630.1.text#καὶ — δεῦρο δὴ — πατέρα πρόσειπε σὸν φίλον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:631.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:631.1.text#ὦ μῆτερ, ὑποδραμοῦσά σ'· ὀργισθῇς δὲ μή·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:632.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:632.1.text#πρὸς στέρνα πατρὸς στέρνα τἀμὰ περιβαλῶ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:633.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:633.1.text#ὦ σέβας ἐμοὶ μέγιστον, Ἀγαμέμνων ἄναξ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:634.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:634.1.text#ἥκομεν, ἐφετμαῖς οὐκ ἀπιστοῦσαι σέθεν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:635.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:635.1.text#[ ἐγὼ δὲ βούλομαι τὰ σὰ στέρν', ὦ πάτερ, ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:636.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:636.1.text#[ ὑποδραμοῦσα προσβαλεῖν διὰ χρόνου· ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:637.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:637.1.text#ποθῶ γὰρ ὄμμα δὴ σόν. ὀργισθῇς δὲ μή.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:638.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:638.1.text#ἀλλ', ὦ τέκνον, χρή· φιλοπάτωρ δ' ἀεί ποτ' εἶ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:639.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:639.1.text#μάλιστα παίδων τῷδ' ὅσους ἐγὼ 'τεκον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:640.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:640.1.text#ὦ πάτερ, ἐσεῖδόν σ' ἀσμένη πολλῷ χρόνῳ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:641.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:641.1.text#καὶ γὰρ πατὴρ σέ· τόδ' ἴσον ὑπὲρ ἀμφοῖν λέγεις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:642.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:642.1.text#χαῖρ'· εὖ δέ μ' ἀγαγὼν πρὸς σ' ἐποίησας, πάτερ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:643.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:643.1.text#οὐκ οἶδ' ὅπως φῶ τοῦτο καὶ μὴ φῶ, τέκνον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:644.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:644.1.text#ἔα·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:644.2.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:644.2.text#ὡς οὐ βλέπεις ἕκηλον ἄσμενός μ' ἰδών.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:645.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:645.1.text#πόλλ' ἀνδρὶ βασιλεῖ καὶ στρατηλάτῃ μέλει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:646.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:646.1.text#παρ' ἐμοὶ γενοῦ νῦν, μὴ 'πὶ φροντίδας τρέπου.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:647.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:647.1.text#ἀλλ' εἰμὶ παρὰ σοὶ νῦν ἅπας κοὐκ ἄλλοθι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:648.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:648.1.text#μέθες νυν ὀφρὺν ὄμμα τ' ἔκτεινον φίλον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:649.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:649.1.text#ἰδού, γέγηθά σ' ὡς γέγηθ' ὁρῶν, τέκνον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:650.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:650.1.text#κἄπειτα λείβεις δάκρυ' ἀπ' ὀμμάτων σέθεν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:651.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:651.1.text#μακρὰ γὰρ ἡμῖν ἡ 'πιοῦσ' ἀπουσία.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:652.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:652.1.text#{ οὐκ οἶδ' ὅ τι φῄς, οὐκ οἶδα, φίλτατ' ἐμοὶ πάτερ. }
urn:cts:greekLit:tlg0006.tlg018.fu.sp:653.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:653.1.text#συνετὰ λέγουσα μᾶλλον εἰς οἶκτόν μ' ἄγεις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:654.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:654.1.text#ἀσύνετά νυν ἐροῦμεν, εἰ σέ γ' εὐφρανῶ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:655.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:655.1.text#παπαῖ. τὸ σιγᾶν οὐ σθένω· σὲ δ' ᾔνεσα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:656.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:656.1.text#μέν', ὦ πάτερ, κατ' οἶκον ἐπὶ τέκνοις σέθεν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:657.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:657.1.text#θέλω γε· τὸ θέλειν δ' οὐκ ἔχων ἀλγύνομαι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:658.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:658.1.text#ὄλοιντο λόγχαι καὶ τὰ Μενέλεω κακά.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:659.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:659.1.text#ἄλλους ὀλεῖ πρόσθ' ἃ ἐμὲ διολέσαντ' ἔχει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:660.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:660.1.text#ὡς πολὺν ἀπῆσθα χρόνον ἐν Αὐλίδος μυχοῖς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:661.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:661.1.text#καὶ νῦν γέ μ' ἴσχει δή τι μὴ στέλλειν στρατόν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:662.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:662.1.text#ποῦ τοὺς Φρύγας λέγουσιν ᾠκίσθαι, πάτερ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:663.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:663.1.text#οὗ μήποτ' οἰκεῖν ὤφελ' ὁ Πριάμου Πάρις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:664.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:664.1.text#μακρὰν ἀπαίρεις, ὦ πάτερ, λιπὼν ἐμέ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:665.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:665.1.text#{ εἰς ταὐτόν, ὦ θύγατερ, ἥκεις σῷ πατρί. }
urn:cts:greekLit:tlg0006.tlg018.fu.sp:666.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:666.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:666.2.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:666.2.text#εἴθ' ἦν καλόν μοι σοί τ' ἄγειν σύμπλουν ἐμέ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:667.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:667.1.text#ἔτ' ἔστι καὶ σοὶ πλοῦς, ἵν' ἀμμνήσῃ πατρός.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:668.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:668.1.text#σὺν μητρὶ πλεύσασ' ἢ μόνη πορεύσομαι;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:669.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:669.1.text#μόνη, μονωθεῖσ' ἀπὸ πατρὸς καὶ μητέρος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:670.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:670.1.text#οὔ πού μ' ἐς ἄλλα δώματ' οἰκίζεις, πάτερ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:671.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:671.1.text#ἐατέ'· οὐ χρὴ τοιάδ' εἰδέναι κόρας.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:672.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:672.1.text#σπεῦδ' ἐκ Φρυγῶν μοι, θέμενος εὖ τἀκεῖ, πάτερ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:673.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:673.1.text#θῦσαί με θυσίαν πρῶτα δεῖ τιν' ἐνθάδε.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:674.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:674.1.text#ἀλλὰ ξὺν ἱεροῖς χρὴ τό γ' εὐσεβὲς σκοπεῖν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:675.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:675.1.text#εἴσῃ σύ· χερνίβων γὰρ ἑστήξῃ πέλας.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:676.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:676.1.text#στήσομεν ἄρ' ἀμφὶ βωμόν, ὦ πάτερ, χορούς;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:677.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:677.1.text#ζηλῶ σὲ μᾶλλον ἢ 'μὲ τοῦ μηδὲν φρονεῖν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:678.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:678.1.text#χώρει δὲ μελάθρων ἐντός — ὀφθῆναι κόραις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:679.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:679.1.text#πικρόν — φίλημα δοῦσα δεξιάν τέ μοι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:680.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:680.1.text#μέλλουσα δαρὸν πατρὸς ἀποικήσειν χρόνον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:681.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:681.1.text#ὦ στέρνα καὶ παρῇδες, ὦ ξανθαὶ κόμαι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:682.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:682.1.text#ὡς ἄχθος ὑμῖν ἐγένεθ' ἡ Φρυγῶν πόλις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:683.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:683.1.text#Ἑλένη τε. — παύω τοὺς λόγους· ταχεῖα γὰρ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:684.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:684.1.text#νοτὶς διώκει μ' ὀμμάτων ψαύσαντά σου.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:685.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:685.1.text#ἴθ' ἐς μέλαθρα. σὲ δὲ παραιτοῦμαι τάδε,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:686.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:686.1.text#Λήδας γένεθλον, εἰ κατῳκτίσθην ἄγαν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:687.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:687.1.text#μέλλων Ἀχιλλεῖ θυγατέρ' ἐκδώσειν ἐμήν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:688.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:688.1.text#ἀποστολαὶ γὰρ μακάριαι μέν, ἀλλ' ὅμως
urn:cts:greekLit:tlg0006.tlg018.fu.sp:689.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:689.1.text#δάκνουσι τοὺς τεκόντας, ὅταν ἄλλοις δόμοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:690.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:690.1.text#παῖδας παραδιδῷ πολλὰ μοχθήσας πατήρ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:691.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:691.1.text#οὐχ ὧδ' ἀσύνετός εἰμι, πείσεσθαι δέ με
urn:cts:greekLit:tlg0006.tlg018.fu.sp:692.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:692.1.text#καὐτὴν δόκει τάδ', ὥστε μή σε νουθετεῖν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:693.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:693.1.text#ὅταν σὺν ὑμεναίοισιν ἐξάγω κόρην·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:694.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:694.1.text#ἀλλ' ὁ νόμος αὐτὰ τῷ χρόνῳ συνισχανεῖ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:695.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:695.1.text#τοὔνομα μὲν οὖν παῖδ' οἶδ' ὅτῳ κατῄνεσας,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:696.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:696.1.text#γένους δ' ὁποίου χὡπόθεν, μαθεῖν θέλω.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:697.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:697.1.text#Αἴγινα θυγάτηρ ἐγένετ' Ἀσωποῦ πατρός.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:698.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:698.1.text#ταύτην δὲ θνητῶν ἢ θεῶν ἔζευξε τίς;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:699.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:699.1.text#Ζεύς· Αἰακὸν δ' ἔφυσεν, Οἰνώνης πρόμον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:700.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:700.1.text#τὰ δ' Αἰακοῦ παῖς τίς κατέσχε δώματα;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:701.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:701.1.text#Πηλεύς· ὁ Πηλεὺς δ' ἔσχε Νηρέως κόρην.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:702.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:702.1.text#θεοῦ διδόντος, ἢ βίᾳ θεῶν λαβών;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:703.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:703.1.text#Ζεὺς ἠγγύησε καὶ δίδωσ' ὁ κύριος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:704.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:704.1.text#γαμεῖ δὲ ποῦ νιν; ἦ κατ' οἶδμα πόντιον;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:705.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:705.1.text#Χείρων ἵν' οἰκεῖ σεμνὰ Πηλίου βάθρα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:706.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:706.1.text#οὗ φασι Κενταύρειον ᾠκίσθαι γένος;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:707.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:707.1.text#ἐνταῦθ' ἔδαισαν Πηλέως γάμους θεοί.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:708.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:708.1.text#Θέτις δ' ἔθρεψεν ἢ πατὴρ Ἀχιλλέα;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:709.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:709.1.text#Χείρων, ἵν' ἤθη μὴ μάθοι κακῶν βροτῶν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:710.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:710.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:710.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:710.2.text#σοφός γ' ὁ θρέψας χὡ διδοὺς σοφώτερος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:711.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:711.1.text#τοιόσδε παιδὸς σῆς ἀνὴρ ἔσται πόσις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:712.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:712.1.text#οὐ μεμπτός. οἰκεῖ δ' ἄστυ ποῖον Ἑλλάδος;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:713.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:713.1.text#Ἀπιδανὸν ἀμφὶ ποταμὸν ἐν Φθίας ὅροις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:714.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:714.1.text#ἐκεῖσ' ἀπάξει σὴν ἐμήν τε παρθένον;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:715.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:715.1.text#κείνῳ μελήσει ταῦτα, τῷ κεκτημένῳ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:716.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:716.1.text#ἀλλ' εὐτυχοίτην. τίνι δ' ἐν ἡμέρᾳ γαμεῖ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:717.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:717.1.text#ὅταν σελήνης εὐτυχὴς ἔλθῃ κύκλος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:718.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:718.1.text#προτέλεια δ' ἤδη παιδὸς ἔσφαξας θεᾷ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:719.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:719.1.text#μέλλω· 'πὶ ταύτῃ καὶ καθέσταμεν τύχῃ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:720.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:720.1.text#κἄπειτα δαίσεις τοὺς γάμους ἐς ὕστερον;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:721.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:721.1.text#θύσας γε θύμαθ' ἃ ἐμὲ χρὴ θῦσαι θεοῖς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:722.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:722.1.text#ἡμεῖς δὲ θοίνην ποῦ γυναιξὶ θήσομεν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:723.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:723.1.text#ἐνθάδε παρ' εὐπρύμνοισιν Ἀργείων πλάταις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:724.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:724.1.text#καλῶς ἀναγκαίως τε· συνενέγκοι δ' ὅμως.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:725.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:725.1.text#οἶσθ' οὖν ὃ δρᾶσον, ὦ γύναι; πιθοῦ δέ μοι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:726.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:726.1.text#τί χρῆμα; πείθεσθαι γὰρ εἴθισμαι σέθεν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:727.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:727.1.text#ἡμεῖς μὲν ἐνθάδ', οὗπέρ ἐσθ' ὁ νυμφίος—
urn:cts:greekLit:tlg0006.tlg018.fu.sp:728.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:728.1.text#μητρὸς τί χωρὶς δράσεθ', ἃ ἐμὲ δρᾶν χρεών;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:729.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:729.1.text#ἐκδώσομεν σὴν παῖδα Δαναϊδῶν μέτα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:730.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:730.1.text#ἡμᾶς δὲ ποῦ χρὴ τηνικαῦτα τυγχάνειν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:731.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:731.1.text#χώρει πρὸς Ἄργος παρθένους τε τημέλει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:732.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:732.1.text#λιποῦσα παῖδα; τίς δ' ἀνασχήσει φλόγα;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:733.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:733.1.text#ἐγὼ παρέξω φῶς ὃ νυμφίοις πρέπει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:734.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:734.1.text#οὐχ ὁ νόμος οὗτος οὐδὲ φαῦλ' ἡγητέα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:735.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:735.1.text#οὐ καλὸν ἐν ὄχλῳ σ' ἐξομιλεῖσθαι στρατοῦ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:736.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:736.1.text#καλὸν τεκοῦσαν τἀμά μ' ἐκδοῦναι τέκνα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:737.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:737.1.text#καὶ τάς γ' ἐν οἴκῳ μὴ μόνας εἶναι κόρας.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:738.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:738.1.text#ὀχυροῖσι παρθενῶσι φρουροῦνται καλῶς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:739.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:739.1.text#πιθοῦ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:730.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:730.2.text#μὰ τὴν ἄνασσαν Ἀργείαν θεάν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:740.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:740.1.text#ἐλθὼν δὲ τἄξω πρᾶσσε, τἀν δόμοις δ' ἐγώ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:741.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:741.1.text#[ ἃ χρὴ παρεῖναι νυμφίοισι παρθένοις. ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:742.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:742.1.text#οἴμοι· μάτην ᾖξ', ἐλπίδος δ' ἀπεσφάλην,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:743.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:743.1.text#ἐξ ὀμμάτων δάμαρτ' ἀποστεῖλαι θέλων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:744.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:744.1.text#σοφίζομαι δὲ κἀπὶ τοῖσι φιλτάτοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:745.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:745.1.text#τέχνας πορίζω, πανταχῇ νικώμενος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:746.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:746.1.text#ὅμως δὲ σὺν Κάλχαντι τῷ θυηπόλῳ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:747.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:747.1.text#κοινῇ τὸ τῆς θεοῦ φίλον, ἐμοὶ δ' οὐκ εὐτυχές,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:748.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:748.1.text#ἐξευπορήσων εἶμι, μόχθον Ἑλλάδος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:749.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:749.1.text#χρὴ δ' ἐν δόμοισιν ἄνδρα τὸν σοφὸν τρέφειν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:750.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:750.1.text#γυναῖκα χρηστὴν κἀγαθήν, ἢ μὴ τρέφειν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:751.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:751.1.text#ἥξει δὴ Σιμόεντα καὶ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:752.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:752.1.text#δίνας ἀργυροειδεῖς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:753.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:753.1.text#ἄγυρις Ἑλλάνων στρατιᾶς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:754.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:754.1.text#ἀνά τε ναυσὶν καὶ σὺν ὅπλοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:755.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:755.1.text#Ἴλιον ἐς τὸ Τροίας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:756.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:756.1.text#Φοιβήιον δάπεδον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:757.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:757.1.text#τὰν Κασάνδραν ἵν' ἀκούω
urn:cts:greekLit:tlg0006.tlg018.fu.sp:758.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:758.1.text#ῥίπτειν ξανθοὺς πλοκάμους
urn:cts:greekLit:tlg0006.tlg018.fu.sp:759.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:759.1.text#χλωροκόμῳ στεφάνῳ δάφνας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:760.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:760.1.text#κοσμηθεῖσαν, ὅταν θεοῦ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:761.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:761.1.text#μαντόσυνοι πνεύσωσ' ἀνάγκαι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:762.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:762.1.text#στάσονται δ' ἐπὶ περγάμων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:763.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:763.1.text#Τροίας ἀμφί τε τείχη
urn:cts:greekLit:tlg0006.tlg018.fu.sp:764.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:764.1.text#Τρῶες, ὅταν χάλκασπις Ἄρης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:765.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:765.1.text#πόντιος εὐπρῴροιο πλάτας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:766.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:766.1.text#εἰρεσίᾳ πελάζῃ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:767.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:767.1.text#Σιμουντίοις ὀχετοῖς,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:768.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:768.1.text#τὰν τῶν ἐν αἰθέρι δισσῶν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:769.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:769.1.text#Διοσκούρων Ἑλέναν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:770.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:770.1.text#ἐκ Πριάμου κομίσαι θέλων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:771.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:771.1.text#ἐς γᾶν Ἑλλάδα δοριπόνοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:772.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:772.1.text#ἀσπίσι καὶ λόγχαις Ἀχαιῶν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:773.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:773.1.text#Πέργαμον δὲ Φρυγῶν πόλιν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:774.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:774.1.text#λαΐνους περὶ πύργους
urn:cts:greekLit:tlg0006.tlg018.fu.sp:775.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:775.1.text#κυκλώσας Ἄρει φονίῳ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:776.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:776.1.text#λαιμοτόμου κεφαλᾶς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:777.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:777.1.text#σπάσας { Πάριν Ἀτρεΐδας, }
urn:cts:greekLit:tlg0006.tlg018.fu.sp:778.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:778.1.text#πέρσας κατάκρας πόλιν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:779.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:779.1.text#θήσει κόρας πολυκλαύτους
urn:cts:greekLit:tlg0006.tlg018.fu.sp:780.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:780.1.text#δάμαρτά τε Πριάμου.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:781.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:781.1.text#ἁ δὲ Διὸς Ἑλένα κόρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:782.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:782.1.text#πολύκλαυτος ἑδεῖται
urn:cts:greekLit:tlg0006.tlg018.fu.sp:783.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:783.1.text#πόσιν προλιποῦσα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:784.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:784.1.text#μήτ' ἐμοὶ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:784.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:784.2.text#μήτ' ἐμοῖσι τέκνων τέκνοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:785.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:785.1.text#ἐλπὶς ἅδε ποτ' ἔλθοι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:786.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:786.1.text#οἵαν αἱ πολύχρυσοι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:787.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:787.1.text#Λυδαὶ καὶ Φρυγῶν ἄλοχοι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:788.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:788.1.text#στήσουσι παρ' ἱστοῖς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:789.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:789.1.text#μυθεῦσαι τάδ' ἐς ἀλλήλας·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:790.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:790.1.text#Τίς ἄρα μ' εὐπλοκάμου κόμας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:791.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:791.1.text#ῥῦμα δακρυόεν τανύσας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:792.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:792.1.text#πατρίδος ὀλλυμένας ἀπολωτιεῖ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:793.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:793.1.text#διὰ σέ, τὰν κύκνου δολιχαύχενος γόνον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:794.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:794.1.text#εἰ δὴ φάτις ἔτυμος ὡς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:795.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:795.1.text#ἔτυχεν, [ Λήδα ] ὄρνιθι πταμένῳ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:797.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:797.1.text#Διὸς ὅτ' ἠλλάχθη δέμας, εἴτ'
urn:cts:greekLit:tlg0006.tlg018.fu.sp:798.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:798.1.text#ἐν δέλτοις Πιερίσιν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:799.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:799.1.text#μῦθοι τάδ' ἐς ἀνθρώπους
urn:cts:greekLit:tlg0006.tlg018.fu.sp:800.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:800.1.text#ἤνεγκαν παρὰ καιρὸν ἄλλως.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:801.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:801.1.text#ποῦ τῶν Ἀχαιῶν ἐνθάδ' ὁ στρατηλάτης;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:802.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:802.1.text#τίς ἂν φράσειε προσπόλων τὸν Πηλέως
urn:cts:greekLit:tlg0006.tlg018.fu.sp:803.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:803.1.text#ζητοῦντά νιν παῖδ' ἐν πύλαις Ἀχιλλέα;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:804.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:804.1.text#οὐκ ἐξ ἴσου γὰρ μένομεν Εὐρίπου πέλας.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:805.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:805.1.text#οἳ μὲν γὰρ ἡμῶν, ὄντες ἄζυγες γάμων,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:806.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:806.1.text#οἴκους ἐρήμους ἐκλιπόντες ἐνθάδε
urn:cts:greekLit:tlg0006.tlg018.fu.sp:807.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:807.1.text#θάσσουσ' ἐπ' ἀκταῖς, οἳ δ' ἔχοντες εὔνιδας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:808.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:808.1.text#ἄπαιδες· οὕτω δεινὸς ἐμπέπτωκ' ἔρως
urn:cts:greekLit:tlg0006.tlg018.fu.sp:809.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:809.1.text#τῆσδε στρατείας Ἑλλάδ' οὐκ ἄνευ θεῶν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:810.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:810.1.text#τοὐμὸν μὲν οὖν δίκαιον ἐμὲ λέγειν χρεών,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:811.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:811.1.text#ἄλλος δ' ὁ χρῄζων αὐτὸς ὑπὲρ αὑτοῦ φράσει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:812.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:812.1.text#γῆν γὰρ λιπὼν Φάρσαλον ἠδὲ Πηλέα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:813.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:813.1.text#μένω 'πὶ λεπταῖς ταισίδ' Εὐρίπου πνοαῖς,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:814.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:814.1.text#Μυρμιδόνας ἴσχων· οἳ δ' ἀεὶ προσκείμενοι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:815.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:815.1.text#λέγουσ'· Ἀχιλλεῦ, τί μένομεν; πόσον χρόνον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:816.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:816.1.text#ἔτ' ἐκμετρῆσαι χρὴ πρὸς Ἰλίου στόλον;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:817.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:817.1.text#δρᾶ γ', εἴ τι δράσεις, ἢ ἄπαγ' οἴκαδε στρατόν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:818.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:818.1.text#τὰ τῶν Ἀτρειδῶν μὴ μένων μελλήματα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:819.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:819.1.text#ὦ παῖ θεᾶς Νηρῇδος, ἔνδοθεν λόγων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:820.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:820.1.text#τῶν σῶν ἀκούσασ' ἐξέβην πρὸ δωμάτων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:821.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:821.1.text#ὦ πότνι' αἰδώς, τήνδε τίνα λεύσσω ποτὲ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:822.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:822.1.text#γυναῖκα, μορφὴν εὐπρεπῆ κεκτημένην;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:823.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:823.1.text#οὐ θαῦμά σ' ἡμᾶς ἀγνοεῖν, οἷς μὴ πάρος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:824.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:824.1.text#προσῆκες· αἰνῶ δ' ὅτι σέβεις τὸ σωφρονεῖν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:825.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:825.1.text#τίς δ' εἶ; τί δ' ἦλθες Δαναϊδῶν ἐς σύλλογον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:826.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:826.1.text#γυνὴ πρὸς ἄνδρας ἀσπίσιν πεφραγμένους;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:827.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:827.1.text#Λήδας μέν εἰμι παῖς, Κλυταιμήστρα δέ μοι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:828.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:828.1.text#ὄνομα, πόσις δέ μοὐστὶν Ἀγαμέμνων ἄναξ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:829.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:829.1.text#καλῶς ἔλεξας ἐν βραχεῖ τὰ καίρια.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:830.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:830.1.text#αἰσχρὸν δέ μοι γυναιξὶ συμβάλλειν λόγους.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:831.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:831.1.text#μεῖνον — τί φεύγεις; — δεξιάν τ' ἐμῇ χερὶ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:832.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:832.1.text#σύναψον, ἀρχὴν μακαρίαν νυμφευμάτων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:833.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:833.1.text#τί φῄς; ἐγώ σοι δεξιάν; αἰδοίμεθ' ἂν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:834.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:834.1.text#Ἀγαμέμνον', εἰ ψαύοιμεν ὧν μή μοι θέμις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:835.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:835.1.text#θέμις μάλιστα, τὴν ἐμὴν ἐπεὶ γαμεῖς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:836.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:836.1.text#παῖδ', ὦ θεᾶς παῖ ποντίας Νηρηίδος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:837.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:837.1.text#ποίους γάμους φῄς; ἀφασία μ' ἔχει, γύναι·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:838.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:838.1.text#εἰ μή τι παρανοοῦσα καινουργεῖς λόγον;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:839.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:839.1.text#πᾶσιν τόδ' ἐμπέφυκεν, αἰδεῖσθαι φίλους
urn:cts:greekLit:tlg0006.tlg018.fu.sp:840.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:840.1.text#καινοὺς ὁρῶσι καὶ γάμου μεμνημένοις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:841.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:841.1.text#οὐπώποτ' ἐμνήστευσα παῖδα σήν, γύναι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:842.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:842.1.text#οὐδ' ἐξ Ἀτρειδῶν ἦλθέ μοι λόγος γάμων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:843.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:843.1.text#τί δῆτ' ἂν εἴη; σὺ πάλιν αὖ λόγους ἐμοὺς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:844.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:844.1.text#θαύμαζ'· ἐμοὶ γὰρ θαύματ' ἐστὶ τὰ παρὰ σοῦ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:845.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:845.1.text#εἴκαζε· κοινόν ἐστιν εἰκάζειν τάδε·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:846.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:846.1.text#ἄμφω γὰρ οὐ ψευδόμεθα τοῖς λόγοις ἴσως.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:847.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:847.1.text#ἀλλ' ἦ πέπονθα δεινά; μνηστεύω γάμους
urn:cts:greekLit:tlg0006.tlg018.fu.sp:848.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:848.1.text#οὐκ ὄντας, ὡς εἴξασιν· αἰδοῦμαι τάδε.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:849.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:849.1.text#ἴσως ἐκερτόμησε κἀμὲ καὶ σέ τις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:850.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:850.1.text#ἀλλ' ἀμελίᾳ δὸς αὐτὰ καὶ φαύλως φέρε.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:851.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:851.1.text#χαῖρ'· οὐ γὰρ ὀρθοῖς ὄμμασίν σ' ἔτ' εἰσορῶ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:852.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:852.1.text#ψευδὴς γενομένη καὶ παθοῦσ' ἀνάξια.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:853.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:853.1.text#καὶ σοὶ τόδ' ἐστὶν ἐξ ἐμοῦ· πόσιν δὲ σὸν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:854.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:854.1.text#στείχω ματεύσων τῶνδε δωμάτων ἔσω.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:855.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:855.1.text#ὦ ξέν', Αἰακοῦ γένεθλον, μεῖνον· ὦ, σέ τοι λέγω,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:856.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:856.1.text#τὸν θεᾶς γεγῶτα παῖδα, καὶ σέ, τὴν Λήδας κόρην.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:857.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:857.1.text#τίς ὁ καλῶν πύλας παροίξας; ὡς τεταρβηκὼς καλεῖ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:858.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:858.1.text#δοῦλος, οὐχ ἁβρύνομαι τῷδ'· ἡ τύχη γὰρ οὐκ ἐᾷ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:859.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:859.1.text#τίνος; ἐμὸς μὲν οὐχί· χωρὶς τἀμὰ καὶ Ἀγαμέμνονος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:860.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:860.1.text#τῆσδε τῆς πάροιθεν οἴκων, Τυνδάρεω δόντος πατρός.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:861.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:861.1.text#ἕσταμεν· φράζ', εἴ τι χρῄζεις, ὧν μ' ἐπέσχες οὕνεκα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:862.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:862.1.text#ἦ μόνω παρόντε δῆτα ταῖσδ' ἐφέστατον πύλαις;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:863.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:863.1.text#ὡς μόνοιν λέγοις ἄν, ἔξω δ' ἐλθὲ βασιλείων δόμων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:864.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:864.1.text#ὦ Τύχη πρόνοιά θ' ἡμή, σῴσαθ' οὓς ἐγὼ θέλω.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:865.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:865.1.text#ὁ λόγος ἐς μέλλοντ' { ἂν ὤση } χρόνον· ἔχει δ' ὄγκον τινά.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:866.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:866.1.text#δεξιᾶς ἕκατι μὴ μέλλ', εἴ τί μοι χρῄζεις λέγειν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:867.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:867.1.text#οἶσθα δῆτ' ἔμ', ὅστις ὢν σοὶ καὶ τέκνοις εὔνους ἔφυν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:868.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:868.1.text#οἶδά σ' ὄντ' ἐγὼ παλαιὸν δωμάτων ἐμῶν λάτριν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:869.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:869.1.text#χὥτι μ' ἐν ταῖς σαῖσι φερναῖς ἔλαβεν Ἀγαμέμνων ἄναξ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:870.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:870.1.text#ἦλθες εἰς Ἄργος μεθ' ἡμῶν καὶ ἐμὸς ἦσθ' ἀεί ποτε.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:871.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:871.1.text#ὧδ' ἔχει. καὶ σοὶ μὲν εὔνους εἰμί, σῷ δ' ἧσσον πόσει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:872.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:872.1.text#ἐκκάλυπτε νῦν ποθ' ἡμῖν οὕστινας λέγεις λόγους.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:873.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:873.1.text#παῖδα σὴν πατὴρ ὁ φύσας αὐτόχειρ μέλλει κτενεῖν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:874.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:874.1.text#πῶς; ἀπέπτυσ', ὦ γεραιέ, μῦθον· οὐ γὰρ εὖ φρονεῖς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:875.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:875.1.text#φασγάνῳ λευκὴν φονεύων τῆς ταλαιπώρου δέρην.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:876.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:876.1.text#ὦ τάλαιν' ἐγώ. μεμηνὼς ἆρα τυγχάνει πόσις;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:877.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:877.1.text#ἀρτίφρων, πλὴν ἐς σὲ καὶ σὴν παῖδα· τοῦτο δ' οὐ φρονεῖ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:878.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:878.1.text#ἐκ τίνος λόγου; τίς αὐτὸν οὑπάγων ἀλαστόρων;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:879.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:879.1.text#θέσφαθ', ὥς γέ φησι Κάλχας, ἵνα πορεύηται στρατός.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:880.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:880.1.text#ποῖ; τάλαιν' ἐγώ, τάλαινα δ' ἣν πατὴρ μέλλει κτενεῖν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:881.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:881.1.text#Δαρδάνου πρὸς δώμαθ', Ἑλένην Μενέλεως ὅπως λάβῃ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:882.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:882.1.text#εἰς ἄρ' Ἰφιγένειαν Ἑλένης νόστος ἦν πεπρωμένος;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:883.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:883.1.text#πάντ' ἔχεις· Ἀρτέμιδι θύσειν παῖδα σὴν μέλλει πατήρ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:884.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:884.1.text#ὁ δὲ γάμος τίν' εἶχε πρόφασιν, ᾧ μ' ἐκόμισεν ἐκ δόμων;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:885.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:885.1.text#ἵν' ἀγάγοις χαίρουσ' Ἀχιλλεῖ παῖδα νυμφεύσουσα σήν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:886.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:886.1.text#ὦ θύγατερ, ἥκεις ἐπ' ὀλέθρῳ καὶ σὺ καὶ μήτηρ σέθεν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:887.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:887.1.text#οἰκτρὰ πάσχετον δύ' οὖσαι· δεινὰ δ' Ἀγαμέμνων ἔτλη.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:888.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:888.1.text#οἴχομαι τάλαινα, δακρύων τ' ὄμματ' οὐκέτι στέγω.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:889.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:889.1.text#εἴπερ ἀλγεινὸν τὸ τέκνων στερόμενον, δακρυρρόει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:890.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:890.1.text#σὺ δὲ τάδ', ὦ γέρον, πόθεν φῂς εἰδέναι πεπυσμένος;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:891.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:891.1.text#δέλτον ᾠχόμην φέρων σοι πρὸς τὰ πρὶν γεγραμμένα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:892.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:892.1.text#οὐκ ἐῶν ἢ ξυγκελεύων παῖδ' ἄγειν θανουμένην;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:893.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:893.1.text#μὴ μὲν οὖν ἄγειν· φρονῶν γὰρ ἔτυχε σὸς πόσις τότ' εὖ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:894.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:894.1.text#κᾆτα πῶς φέρων γε δέλτον οὐκ ἐμοὶ δίδως λαβεῖν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:895.1.speaker#Πρεσβύτης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:895.1.text#Μενέλεως ἀφείλεθ' ἡμᾶς, ὃς κακῶν τῶνδ' αἴτιος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:896.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:896.1.text#ὦ τέκνον Νηρῇδος, ὦ παῖ Πηλέως, κλύεις τάδε;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:897.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:897.1.text#ἔκλυον οὖσαν ἀθλίαν σε, τὸ δ' ἐμὸν οὐ φαύλως φέρω.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:898.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:898.1.text#παῖδά μου κατακτενοῦσι σοῖς δολώσαντες γάμοις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:899.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:899.1.text#μέμφομαι κἀγὼ πόσει σῷ, κοὐχ ἁπλῶς οὕτω φέρω.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:900.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:900.1.text#οὐκ ἐπαιδεσθήσομαί γε προσπεσεῖν τὸ σὸν γόνυ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:901.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:901.1.text#θνητὸς ἐκ θεᾶς γεγῶτα· τί γὰρ ἐγὼ σεμνύνομαι;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:902.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:902.1.text#ἢ τίνος σπουδαστέον μοι μᾶλλον ἢ τέκνου πέρι;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:903.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:903.1.text#ἀλλ' ἄμυνον, ὦ θεᾶς παῖ, τῇ τ' ἐμῇ δυσπραξίᾳ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:904.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:904.1.text#τῇ τε λεχθείσῃ δάμαρτι σῇ — μάτην μέν, ἀλλ' ὅμως.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:905.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:905.1.text#σοὶ καταστέψασ' ἐγώ νιν ἦγον ὡς γαμουμένην,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:906.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:906.1.text#νῦν δ' ἐπὶ σφαγὰς κομίζω· σοὶ δ' ὄνειδος ἵξεται,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:907.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:907.1.text#ὅστις οὐκ ἤμυνας· εἰ γὰρ μὴ γάμοισιν ἐζύγης,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:908.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:908.1.text#ἀλλ' ἐκλήθης γοῦν ταλαίνης παρθένου φίλος πόσις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:909.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:909.1.text#πρὸς γενειάδος { σε }, πρός σε δεξιᾶς, πρὸς μητέρος —
urn:cts:greekLit:tlg0006.tlg018.fu.sp:910.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:910.1.text#ὄνομα γὰρ τὸ σόν μ' ἀπώλεσ', ᾧ σ' ἀμυναθεῖν χρεών —
urn:cts:greekLit:tlg0006.tlg018.fu.sp:911.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:911.1.text#οὐκ ἔχω βωμὸν καταφυγεῖν ἄλλον ἢ τὸ σὸν γόνυ·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:912.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:912.1.text#οὐδὲ φίλος οὐδεὶς γελᾷ μοι· τὰ δ' Ἀγαμέμνονος κλύεις,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:913.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:913.1.text#ὠμὰ καὶ πάντολμ'· ἀφῖγμαι δ', ὥσπερ εἰσορᾷς, γυνὴ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:914.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:914.1.text#ναυτικὸν στράτευμ' ἄναρχον κἀπὶ τοῖς κακοῖς θρασύ—
urn:cts:greekLit:tlg0006.tlg018.fu.sp:915.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:915.1.text#χρήσιμον δ', ὅταν θέλωσιν. ἢν δὲ τολμήσῃς σύ μου
urn:cts:greekLit:tlg0006.tlg018.fu.sp:916.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:916.1.text#χεῖρ' ὑπερτεῖναι, σεσῴσμεθ'· εἰ δὲ μή, οὐ σεσῴσμεθα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:917.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:917.1.text#δεινὸν τὸ τίκτειν καὶ φέρει φίλτρον μέγα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:918.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:918.1.text#πᾶσίν τε κοινὸν ὥσθ' ὑπερκάμνειν τέκνων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:919.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:919.1.text#ὑψηλόφρων μοι θυμὸς αἴρεται πρόσω·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:920.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:920.1.text#ἐπίσταμαι δὲ τοῖς κακοῖσί τ' ἀσχαλᾶν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:921.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:921.1.text#μετρίως τε χαίρειν τοῖσιν ἐξωγκωμένοις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:922.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:922.1.text#λελογισμένοι γὰρ οἱ τοιοίδ' εἰσὶν βροτῶν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:923.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:923.1.text#ὀρθῶς διαζῆν τὸν βίον γνώμης μέτα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:924.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:924.1.text#ἔστιν μὲν οὖν ἵν' ἡδὺ μὴ λίαν φρονεῖν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:925.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:925.1.text#ἔστιν δὲ χὥπου χρήσιμον γνώμην ἔχειν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:926.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:926.1.text#ἐγὼ δ', ἐν ἀνδρὸς εὐσεβεστάτου τραφεὶς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:927.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:927.1.text#Χείρωνος, ἔμαθον τοὺς τρόπους ἁπλοῦς ἔχειν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:928.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:928.1.text#καὶ τοῖς Ἀτρείδαις, ἢν μὲν ἡγῶνται καλῶς,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:929.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:929.1.text#πεισόμεθ', ὅταν δὲ μὴ καλῶς, οὐ πείσομαι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:930.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:930.1.text#ἀλλ' ἐνθάδ' ἐν Τροίᾳ τ' ἐλευθέραν φύσιν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:931.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:931.1.text#παρέχων, Ἄρη τὸ κατ' ἐμὲ κοσμήσω δορί.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:932.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:932.1.text#σὲ δ', ὦ σχέτλια παθοῦσα πρὸς τῶν φιλτάτων,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:933.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:933.1.text#ἃ δὴ κατ' ἄνδρα γίγνεται νεανίαν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:934.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:934.1.text#τοσοῦτον οἶκτον περιβαλὼν καταστελῶ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:935.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:935.1.text#κοὔποτε κόρη σὴ πρὸς πατρὸς σφαγήσεται,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:936.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:936.1.text#ἐμὴ φατισθεῖσ'· οὐ γὰρ ἐμπλέκειν πλοκὰς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:937.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:937.1.text#ἐγὼ παρέξω σῷ πόσει τοὐμὸν δέμας.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:938.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:938.1.text#τοὔνομα γάρ, εἰ καὶ μὴ σίδηρον ἤρατο,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:939.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:939.1.text#τοὐμὸν φονεύσει παῖδα σήν. τὸ δ' αἴτιον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:940.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:940.1.text#πόσις σός. ἁγνὸν δ' οὐκέτ' ἐστὶ σῶμ' ἐμόν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:941.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:941.1.text#εἰ δι' ἔμ' ὀλεῖται διά τε τοὺς ἐμοὺς γάμους
urn:cts:greekLit:tlg0006.tlg018.fu.sp:942.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:942.1.text#ἡ δεινὰ τλᾶσα κοὐκ ἀνεκτὰ παρθένος,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:943.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:943.1.text#θαυμαστὰ δ' ὡς ἀνάξι' ἠτιμασμένη.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:944.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:944.1.text#ἐγὼ κάκιστος ἦν ἄρ' Ἀργείων ἀνήρ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:945.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:945.1.text#ἐγὼ τὸ μηδέν, Μενέλεως δ' ἐν ἀνδράσιν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:946.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:946.1.text#ὡς οὐχὶ Πηλέως, ἀλλ' ἀλάστορος γεγώς,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:947.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:947.1.text#εἴπερ φονεύει τοὐμὸν ὄνομα σῷ πόσει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:948.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:948.1.text#μὰ τὸν δι' ὑγρῶν κυμάτων τεθραμμένον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:949.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:949.1.text#Νηρέα, φυτουργὸν Θέτιδος ἥ μ' ἐγείνατο,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:950.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:950.1.text#οὐχ ἅψεται σῆς θυγατρὸς Ἀγαμέμνων ἄναξ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:951.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:951.1.text#οὐδ' εἰς ἄκραν χεῖρ', ὥστε προσβαλεῖν πέπλοις·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:952.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:952.1.text#ἢ Σίπυλος ἔσται πόλις, ὅρισμα βαρβάρων,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:953.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:953.1.text#ὅθεν πεφύκασ' οἱ στρατηλάται γένος,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:954.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:954.1.text#Φθίας δὲ τοὔνομ' οὐδαμοῦ κεκλήσεται.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:955.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:955.1.text#πικροὺς δὲ προχύτας χέρνιβάς τ' ἀνάξεται
urn:cts:greekLit:tlg0006.tlg018.fu.sp:956.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:956.1.text#Κάλχας ὁ μάντις. τίς δὲ μάντις ἔστ' ἀνήρ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:957.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:957.1.text#ὃς ὀλίγ' ἀληθῆ, πολλὰ δὲ ψευδῆ λέγει
urn:cts:greekLit:tlg0006.tlg018.fu.sp:958.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:958.1.text#τυχών, ὅταν δὲ μὴ τύχῃ, διοίχεται;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:959.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:959.1.text#οὐ τῶν γάμων ἕκατι — μυρίαι κόραι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:960.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:960.1.text#θηρῶσι λέκτρον τοὐμόν — εἴρηται τόδε·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:961.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:961.1.text#ἀλλ' ὕβριν ἐς ἡμᾶς ὕβρισ' Ἀγαμέμνων ἄναξ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:962.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:962.1.text#χρῆν δ' αὐτὸν αἰτεῖν τοὐμὸν ὄνομ' ἐμοῦ πάρα,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:963.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:963.1.text#θήραμα παιδός· ἡ Κλυταιμήστρα δ' ἐμοὶ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:964.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:964.1.text#μάλιστ' ἐπείσθη θυγατέρ' ἐκδοῦναι πόσει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:965.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:965.1.text#ἔδωκά τἂν Ἕλλησιν, εἰ πρὸς Ἴλιον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:966.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:966.1.text#ἐν τῷδ' ἔκαμνε νόστος· οὐκ ἠρνούμεθ' ἂν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:967.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:967.1.text#τὸ κοινὸν αὔξειν ὧν μέτ' ἐστρατευόμην.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:968.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:968.1.text#νῦν δ' οὐδέν εἰμι, παρὰ δὲ τοῖς στρατηλάταις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:969.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:969.1.text#ἐν εὐμαρεῖ με δρᾶν τε καὶ μὴ δρᾶν κακῶς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:970.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:970.1.text#τάχ' εἴσεται σίδηρος, ὃν πρὶν ἐς Φρύγας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:971.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:971.1.text#ἐλθεῖν, { φόνου κηλῖσιν αἵματι } χρανῶ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:972.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:972.1.text#εἴ τίς με τὴν σὴν θυγατέρ' ἐξαιρήσεται.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:973.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:973.1.text#ἀλλ' ἡσύχαζε· θεὸς ἐγὼ πέφηνά σοι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:974.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:974.1.text#μέγιστος, οὐκ ὤν· ἀλλ' ὅμως γενήσομαι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:975.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:975.1.text#ἔλεξας, ὦ παῖ Πηλέως, σοῦ τ' ἄξια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:976.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:976.1.text#καὶ τῆς ἐναλίας δαίμονος, σεμνῆς θεοῦ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:977.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:977.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:977.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:977.2.text#πῶς ἄν σ' ἐπαινέσαιμι μὴ λίαν λόγοις,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:978.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:978.1.text#μηδ' ἐνδεὴς τοῦδ' ἀπολέσαιμι τὴν χάριν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:979.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:979.1.text#αἰνούμενοι γὰρ οἱ ἀγαθοὶ τρόπον τινὰ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:980.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:980.1.text#μισοῦσι τοὺς αἰνοῦντας, ἢν αἰνῶσ' ἄγαν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:981.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:981.1.text#αἰσχύνομαι δὲ παραφέρουσ' οἰκτροὺς λόγους,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:982.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:982.1.text#ἰδίᾳ νοσοῦσα· σὺ δ' ἄνοσος κακῶν ἐμῶν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:983.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:983.1.text#ἀλλ' οὖν ἔχει τοι σχῆμα, κἂν ἄπωθεν ᾖ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:984.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:984.1.text#ἀνὴρ ὁ χρηστός, δυστυχοῦντας ὠφελεῖν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:985.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:985.1.text#οἴκτιρε δ' ἡμᾶς· οἰκτρὰ γὰρ πεπόνθαμεν·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:986.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:986.1.text#ἣ πρῶτα μέν σε γαμβρὸν οἰηθεῖσ' ἔχειν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:987.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:987.1.text#κενὴν κατέσχον ἐλπίδ'· εἶτά σοι τάχα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:988.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:988.1.text#ὄρνις γένοιτ' ἂν τοῖσι μέλλουσιν γάμοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:989.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:989.1.text#θανοῦσ' ἐμὴ παῖς, ὅ σε φυλάξασθαι χρεών.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:990.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:990.1.text#ἀλλ' εὖ μὲν ἀρχὰς εἶπας, εὖ δὲ καὶ τέλη·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:991.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:991.1.text#σοῦ γὰρ θέλοντος παῖς ἐμὴ σωθήσεται.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:992.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:992.1.text#βούλῃ νιν ἱκέτιν σὸν περιπτύξαι γόνυ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:993.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:993.1.text#ἀπαρθένευτα μὲν τάδ'· εἰ δέ σοι δοκεῖ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:994.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:994.1.text#ἥξει, δι' αἰδοῦς ὄμμ' ἔχουσ' ἐλεύθερον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:995.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:995.1.text#εἰ δ' οὐ παρούσης ταὐτὰ τεύξομαι σέθεν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:996.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:996.1.text#μενέτω κατ' οἴκους· σεμνὰ γὰρ σεμνύνεται.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:997.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:997.1.text#ὅμως δ' ὅσον γε δυνατὸν αἰδεῖσθαι χρεών.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:998.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:998.1.text#σὺ μήτε σὴν παῖδ' ἔξαγ' ὄψιν εἰς ἐμήν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:999.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:999.1.text#μήτ' εἰς ὄνειδος ἀμαθὲς ἔλθωμεν, γύναι·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1000.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1000.1.text#στρατὸς γὰρ ἀθρόος, ἀργὸς ὢν τῶν οἴκοθεν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1001.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1001.1.text#λέσχας πονηρὰς καὶ κακοστόμους φιλεῖ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1002.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1002.1.text#πάντως δέ μ' ἱκετεύοντέ θ' ἥξετ' εἰς ἴσον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1003.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1003.1.text#εἴ τ' ἀνικέτευτος· εἷς ἐμοὶ γάρ ἐστ' ἀγὼν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1004.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1004.1.text#μέγιστος ὑμᾶς ἐξαπαλλάξαι κακῶν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1005.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1005.1.text#ὡς ἕν γ' ἀκούσασ' ἴσθι, μὴ ψευδῶς μ' ἐρεῖν·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1006.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1006.1.text#ψευδῆ λέγων δὲ καὶ μάτην ἐγκερτομῶν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1007.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1007.1.text#θάνοιμι· μὴ θάνοιμι δ', ἢν σῴσω κόρην.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1008.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1008.1.text#ὄναιο συνεχῶς δυστυχοῦντας ὠφελῶν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1009.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1009.1.text#ἄκουε δή νυν, ἵνα τὸ πρᾶγμ' ἔχῃ καλῶς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1010.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1010.1.text#τί τοῦτ' ἔλεξας; ὡς ἀκουστέον γέ σου.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1011.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1011.1.text#{ πειθώμεθ' αὖτις } πατέρα βέλτιον φρονεῖν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1012.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1012.1.text#κακός τίς ἐστι καὶ λίαν ταρβεῖ στρατόν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1013.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1013.1.text#ἀλλ' οἱ λόγοι γε καταπαλαίουσιν λόγους.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1014.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1014.1.text#ψυχρὰ μὲν ἐλπίς· ὅ τι δὲ χρή με δρᾶν φράσον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1015.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1015.1.text#ἱκέτευ' ἐκεῖνον πρῶτα μὴ κτείνειν τέκνα·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1016.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1016.1.text#ἢν δ' ἀντιβαίνῃ, πρὸς ἐμέ σοι πορευτέον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1017.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1017.1.text#ᾗ γὰρ τὸ χρῇζον ἐπίθετ', οὐ τοὐμὸν χρεὼν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1018.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1018.1.text#χωρεῖν· ἔχει γὰρ αὐτὸ τὴν σωτηρίαν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1019.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1019.1.text#κἀγώ τ' ἀμείνων πρὸς φίλον γενήσομαι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1020.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1020.1.text#στρατός τ' ἂν οὐ μέμψαιτό μ', εἰ τὰ πράγματα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1021.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1021.1.text#λελογισμένως πράσσοιμι μᾶλλον ἢ σθένει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1022.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1022.1.text#{ καλῶς δὲ κρανθέντων [ καὶ ] πρὸς ἡδονὴν φίλοις }
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1023.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1023.1.text#{ σοί τ' ἂν γένοιτο κἂν ἐμοῦ χωρὶς τάδε. }
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1024.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1024.1.text#ὡς σώφρον' εἶπας. δραστέον δ' ἅ σοι δοκεῖ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1025.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1025.1.text#ἢν δ' αὖ τι μὴ πράσσωμεν ὧν ἐγὼ θέλω,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1026.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1026.1.text#ποῦ σ' αὖθις ὀψόμεσθα, ποῦ; χρή μ' ἀθλίαν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1027.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1027.1.text#ἐλθοῦσαν εὑρεῖν σὴν χέρ' ἐπίκουρον κακῶν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1028.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1028.1.text#ἡμεῖς σε φύλακες οὗ χρεὼν φυλάξομεν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1029.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1029.1.text#μή τίς σ' ἴδῃ στείχουσαν ἐπτοημένην
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1030.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1030.1.text#Δαναῶν δι' ὄχλου· μηδὲ πατρῷον δόμον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1031.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1031.1.text#αἴσχυν'· ὁ γάρ τοι Τυνδάρεως οὐκ ἄξιος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1032.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1032.1.text#κακῶς ἀκούειν· ἐν γὰρ Ἕλλησιν μέγας.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1033.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1033.1.text#ἔστιν τάδ'· ἄρχε· σοί με δουλεύειν χρεών.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1034.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1034.1.text#εἰ δ' εἰσὶ θεοί, δίκαιος ὢν ἀνὴρ { θεῶν }
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1035.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1035.1.text#ἐσθλῶν κυρήσεις· εἰ δὲ μή, τί δεῖ πονεῖν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1036.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1036.1.text#τίν' ἄρ' Ὑμέναιος διὰ λωτοῦ Λίβυος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1037.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1037.1.text#μετά τε φιλοχόρου κιθάρας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1038.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1038.1.text#συρίγγων θ' ὑπὸ καλαμοεσσᾶν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1039.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1039.1.text#ἔστασεν ἰαχάν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1040.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1040.1.text#ὅτ' ἀνὰ Πήλιον αἱ καλλιπλόκαμοι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1041.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1041.1.text#δαιτὶ θεῶν ἔνι Πιερίδες
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1042.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1042.1.text#χρυσεοσάνδαλον ἴχνος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1043.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1043.1.text#ἐν γᾷ κρούουσαι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1044.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1044.1.text#Πηλέως ἐς γάμον ἦλθον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1045.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1045.1.text#μελῳδοῖς Θέτιν ἀχήμασι τόν τ' Αἰακίδαν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1046.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1046.1.text#Κενταύρων ἐν ὄρεσι κλέουσαι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1047.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1047.1.text#Πηλιάδα καθ' ὕλαν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1049.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1049.1.text#ὁ δὲ Δαρδανίδας, Διὸς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1050.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1050.1.text#λέκτρων τρύφημα φίλον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1051.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1051.1.text#χρυσέοισιν ἄφυσσε λοιβὰν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1052.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1052.1.text#ἐν κρατήρων γυάλοις,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1053.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1053.1.text#ὁ Φρύγιος Γανυμήδης.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1054.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1054.1.text#παρὰ δὲ λευκοφαῆ ψάμαθον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1055.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1055.1.text#εἱλισσόμεναι κύκλια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1056.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1056.1.text#πεντήκοντα κόραι γάμους
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1057.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1057.1.text#Νηρέως ἐχόρευσαν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1058.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1058.1.text#ἀνὰ δ' ἐλάταισι στεφανώδει τε χλόᾳ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1059.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1059.1.text#θίασος ἔμολεν ἱπποβάτας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1060.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1060.1.text#Κενταύρων ἐπὶ δαῖτα τὰν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1061.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1061.1.text#θεῶν κρατῆρά τε Βάκχου.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1062.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1062.1.text#μέγα δ' ἀνέκλαγον· Ὦ Νηρηὶ κόρα,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1063.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1063.1.text#παῖδα σὲ Θεσσαλίᾳ μέγα φῶς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1064.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1064.1.text#μάντις ὁ φοιβάδα μοῦσαν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1065.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1065.1.text#εἰδὼς γεννάσειν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1066.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1066.1.text#Χείρων ἐξονόμαζεν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1068.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1068.1.text#ὃς ἥξει χθόνα λογχήρεσι σὺν Μυρμιδόνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1069.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1069.1.text#ἀσπισταῖς Πριάμοιο κλεινὰν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1070.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1070.1.text#γαῖαν ἐκπυρώσων,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1071.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1071.1.text#περὶ σώματι χρυσέων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1072.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1072.1.text#ὅπλων Ἡφαιστοπόνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1073.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1073.1.text#κεκορυθμένος ἔνδυτ', ἐκ θεᾶς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1074.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1074.1.text#ματρὸς δωρήματ' ἔχων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1075.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1075.1.text#Θέτιδος, ἅ νιν ἔτικτεν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1076.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1076.1.text#μακάριον τότε δαίμονες
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1077.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1077.1.text#τᾶς εὐπάτριδος γάμον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1078.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1078.1.text#Νηρῄδων ἔθεσαν πρώτας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1079.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1079.1.text#Πηλέως θ' ὑμεναίους.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1080.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1080.1.text#—σὲ δ' ἐπὶ κάρα στέψουσι καλλικόμαν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1081.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1081.1.text#πλόκαμον Ἀργεῖοι, βαλιὰν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1082.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1082.1.text#ὥστε πετραίων ἀπ' ἄντρων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1082.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1082.2.text#{ ἐλθοῦσαν ὀρέων }
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1083.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1083.1.text#μόσχον ἀκήρατον, βρότειον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1084.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1084.1.text#αἱμάσσοντες λαιμόν·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1085.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1085.1.text#οὐ σύριγγι τραφεῖσαν οὐδ'
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1086.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1086.1.text#ἐν ῥοιβδήσεσι βουκόλων,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1087.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1087.1.text#παρὰ δὲ ματέρι νυμφοκόμον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1088.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1088.1.text#Ἰναχίδαις γάμον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1089.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1089.1.text#ποῦ τὸ τᾶς Αἰδοῦς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1090.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1090.1.text#ἢ τὸ τᾶς Ἀρετᾶς ἔχει
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1091.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1091.1.text#σθένειν τι πρόσωπον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1092.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1092.1.text#ὁπότε τὸ μὲν ἄσεπτον ἔχει
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1093.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1093.1.text#δύνασιν, ἁ δ' Ἀρετὰ κατόπισθεν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1094.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1094.1.text#θνατοῖς ἀμελεῖται,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1095.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1095.1.text#Ἀνομία δὲ νόμων κρατεῖ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1096.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1096.1.text#καὶ { μὴ } κοινὸς ἀγὼν βροτοῖς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1097.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1097.1.text#μή τις θεῶν φθόνος ἔλθῃ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1098.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1098.1.text#ἐξῆλθον οἴκων προσκοπουμένη πόσιν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1099.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1099.1.text#χρόνιον ἀπόντα κἀκλελοιπότα στέγας.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1100.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1100.1.text#ἐν δακρύοισι δ' ἡ τάλαινα παῖς ἐμή,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1101.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1101.1.text#πολλὰς ἱεῖσα μεταβολὰς ὀδυρμάτων,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1102.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1102.1.text#θάνατον ἀκούσασ', ὃν πατὴρ βουλεύεται.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1103.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1103.1.text#μνήμην δ' ἄρ' εἶχον πλησίον βεβηκότος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1104.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1104.1.text#Ἀγαμέμνονος τοῦδ', ὃς ἐπὶ τοῖς αὑτοῦ τέκνοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1105.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1105.1.text#ἀνόσια πράσσων αὐτίχ' εὑρεθήσεται.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1106.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1106.1.text#Λήδας γένεθλον, ἐν καλῷ σ' ἔξω δόμων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1107.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1107.1.text#ηὕρηχ', ἵν' εἴπω παρθένου χωρὶς λόγους
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1108.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1108.1.text#οὓς οὐκ ἀκούειν τὰς γαμουμένας πρέπει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1109.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1109.1.text#τί δ' ἔστιν, οὗ σοι καιρὸς ἀντιλάζυται;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1110.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1110.1.text#ἔκπεμπε παῖδα δωμάτων πατρὸς μέτα·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1111.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1111.1.text#ὡς χέρνιβες πάρεισιν εὐτρεπισμέναι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1112.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1112.1.text#προχύται τε βάλλειν πῦρ καθάρσιον χεροῖν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1113.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1113.1.text#μόσχοι τε, πρὸ γάμων ἃς θεᾷ πεσεῖν χρεών.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1114.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1114.1.text#[ Ἀρτέμιδι, μέλανος αἵματος φυσήματα. ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1115.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1115.1.text#τοῖς ὀνόμασιν μὲν εὖ λέγεις, τὰ δ' ἔργα σου
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1116.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1116.1.text#οὐκ οἶδ' ὅπως χρή μ' ὀνομάσασαν εὖ λέγειν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1117.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1117.1.text#χώρει δέ, θύγατερ, ἐκτός — οἶσθα γὰρ πατρὸς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1118.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1118.1.text#πάντως ἃ μέλλει — χὑπὸ τοῖς πέπλοις ἄγε
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1119.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1119.1.text#λαβοῦσ' Ὀρέστην, σὸν κασίγνητον, τέκνον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1120.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1120.1.text#ἰδοὺ πάρεστιν ἥδε πειθαρχοῦσά σοι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1121.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1121.1.text#τὰ δ' ἄλλ' ἐγὼ πρὸ τῆσδε κἀμαυτῆς φράσω.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1122.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1122.1.text#τέκνον, τί κλαίεις, οὐδ' ἔθ' ἡδέως ὁρᾷς,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1123.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1123.1.text#ἐς γῆν δ' ἐρείσασ' ὄμμα πρόσθ' ἔχεις πέπλους;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1124.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1124.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1124.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1124.2.text#τίν' ἂν λάβοιμι τῶν ἐμῶν ἀρχὴν κακῶν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1125.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1125.1.text#ἅπασι γὰρ πρώτοισι χρήσασθαι πάρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1126.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1126.1.text#κἀν ὑστάτοισι κἀν μέσοισι πανταχοῦ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1127.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1127.1.text#τί δ' ἔστιν; ὥς μοι πάντες εἰς ἓν ἥκετε,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1128.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1128.1.text#σύγχυσιν ἔχοντες καὶ ταραγμὸν ὀμμάτων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1129.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1129.1.text#εἴφ' ἃν ἐρωτήσω σε γενναίως, πόσι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1130.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1130.1.text#οὐδὲν κελευσμοῦ δεῖ σ'· ἐρωτᾶσθαι θέλω.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1131.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1131.1.text#τὴν παῖδα τὴν σὴν τήν τ' ἐμὴν μέλλεις κτενεῖν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1132.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1132.1.text#ἔα·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1132.2.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1132.2.text#τλήμονά γ' ἔλεξας, ὑπονοεῖς θ' ἃ μή σε χρή.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1133.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1133.1.text#ἔχ' ἥσυχος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1133.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1133.2.text#κἀκεῖνό μοι τὸ πρῶτον ἀπόκριναι πάλιν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1134.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1134.1.text#σὺ δ', ἤν γ' ἐρωτᾷς εἰκότ', εἰκότ' ἂν κλύοις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1135.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1135.1.text#οὐκ ἄλλ' ἐρωτῶ, καὶ σὺ μὴ λέγ' ἄλλα μοι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1136.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1136.1.text#ὦ πότνια μοῖρα καὶ τύχη δαίμων τ' ἐμός.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1137.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1137.1.text#κἀμός γε καὶ τῆσδ', εἷς τριῶν δυσδαιμόνων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1138.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1138.1.text#τίν' ἠδίκησαι;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1138.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1138.2.text#τοῦτ' ἐμοῦ πεύθῃ πάρα;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1139.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1139.1.text#ὁ νοῦς ὅδ' αὐτὸς νοῦν ἔχων οὐ τυγχάνει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1140.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1140.1.text#ἀπωλόμεσθα. προδέδοται τὰ κρυπτά μου.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1141.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1141.1.text#πάντ' οἶδα, καὶ πεπύσμεθ' ἃ σὺ μέλλεις με δρᾶν·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1142.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1142.1.text#αὐτὸ δὲ τὸ σιγᾶν ὁμολογοῦντός ἐστί σου
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1143.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1143.1.text#καὶ τὸ στενάζειν· πολλὰ μὴ κάμῃς λέγων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1144.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1144.1.text#ἰδοὺ σιωπῶ· τὸ γὰρ ἀναίσχυντον τί δεῖ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1145.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1145.1.text#ψευδῆ λέγοντα προσλαβεῖν τῇ συμφορᾷ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1146.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1146.1.text#ἄκουε δή νυν· ἀνακαλύψω γὰρ λόγους,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1147.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1147.1.text#κοὐκέτι παρῳδοῖς χρησόμεσθ' αἰνίγμασιν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1148.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1148.1.text#πρῶτον μέν, ἵνα σοι πρῶτα τοῦτ' ὀνειδίσω,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1149.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1149.1.text#ἔγημας ἄκουσάν με κἄλαβες βίᾳ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1150.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1150.1.text#τὸν πρόσθεν ἄνδρα Τάνταλον κατακτανών·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1151.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1151.1.text#βρέφος τε τοὐμὸν σῷ προσούδισας πάλῳ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1152.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1152.1.text#μαστῶν βιαίως τῶν ἐμῶν ἀποσπάσας.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1153.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1153.1.text#καὶ τὼ Διός σε παῖδ', ἐμὼ δὲ συγγόνω,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1154.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1154.1.text#ἵπποισι μαρμαίροντ' ἐπεστρατευσάτην·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1155.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1155.1.text#πατὴρ δὲ πρέσβυς Τυνδάρεώς σ' ἐρρύσατο
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1156.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1156.1.text#ἱκέτην γενόμενον, τἀμὰ δ' ἔσχες αὖ λέχη.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1157.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1157.1.text#οὗ σοι καταλλαχθεῖσα περὶ σὲ καὶ δόμους
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1158.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1158.1.text#συμμαρτυρήσεις ὡς ἄμεμπτος ἦ γυνή,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1159.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1159.1.text#ἔς τ' Ἀφροδίτην σωφρονοῦσα καὶ τὸ σὸν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1160.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1160.1.text#μέλαθρον αὔξουσ', ὥστε σ' εἰσιόντα τε
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1161.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1161.1.text#χαίρειν θύραζέ τ' ἐξιόντ' εὐδαιμονεῖν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1162.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1162.1.text#σπάνιον δὲ θήρευμ' ἀνδρὶ τοιαύτην λαβεῖν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1163.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1163.1.text#δάμαρτα· φλαύραν δ' οὐ σπάνις γυναῖκ' ἔχειν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1164.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1164.1.text#τίκτω δ' ἐπὶ τρισὶ παρθένοισι παῖδά σοι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1165.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1165.1.text#τόνδ', ὧν μιᾶς σὺ τλημόνως μ' ἀποστερεῖς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1166.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1166.1.text#κἄν τίς σ' ἔρηται τίνος ἕκατί νιν κτενεῖς,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1167.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1167.1.text#λέξον, τί φήσεις; ἢ 'μὲ χρὴ λέγειν τὰ σά;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1168.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1168.1.text#Ἑλένην Μενέλεως ἵνα λάβῃ. καλὸν { γένος },
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1169.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1169.1.text#κακῆς γυναικὸς μισθὸν ἀποτεῖσαι τέκνα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1170.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1170.1.text#τἄχθιστα τοῖσι φιλτάτοις ὠνούμεθα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1171.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1171.1.text#ἄγ', εἰ στρατεύσῃ καταλιπών μ' ἐν δώμασιν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1172.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1172.1.text#κἀκεῖ γενήσῃ διὰ μακρᾶς ἀπουσίας,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1173.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1173.1.text#τίν' ἐν δόμοις με καρδίαν ἕξειν δοκεῖς;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1174.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1174.1.text#ὅταν θρόνους τῆσδ' εἰσίδω πάντας κενούς,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1175.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1175.1.text#κενοὺς δὲ παρθενῶνας, ἐπὶ δὲ δακρύοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1176.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1176.1.text#μόνη κάθωμαι, τήνδε θρηνῳδοῦσ' ἀεί·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1177.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1177.1.text#Ἀπώλεσέν σ', ὦ τέκνον, ὁ φυτεύσας πατήρ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1178.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1178.1.text#αὐτὸς κτανών, οὐκ ἄλλος οὐδ' ἄλλῃ χερί,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1179.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1179.1.text#τοιόνδε { νόστον } καταλιπὼν πρὸς τοὺς δόμους.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1180.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1180.1.text#ἐπεὶ βραχείας προφάσεως ἔδει μόνον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1181.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1181.1.text#ἐφ' ᾗ σ' ἐγὼ καὶ παῖδες αἱ λελειμμέναι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1182.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1182.1.text#δεξόμεθα δέξιν ἥν σε δέξασθαι χρεών.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1183.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1183.1.text#μὴ δῆτα πρὸς θεῶν μήτ' ἀναγκάσῃς ἐμὲ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1184.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1184.1.text#κακὴν γενέσθαι περὶ σέ, μήτ' αὐτὸς γένῃ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1185.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1185.1.text#εἶἑν·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1185.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1185.2.text#θύσεις { δὲ παῖδ', ἔνθα } τίνας εὐχὰς ἐρεῖς;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1186.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1186.1.text#τί σοι κατεύξῃ τἀγαθόν, σφάζων τέκνον;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1187.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1187.1.text#νόστον πονηρόν, οἴκοθέν γ' αἰσχρῶς ἰών;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1188.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1188.1.text#ἀλλ' ἐμὲ δίκαιον ἀγαθὸν εὔχεσθαί τί σοι;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1189.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1189.1.text#οὔ τἄρ' ἀσυνέτους τοὺς θεοὺς ἡγοίμεθ' ἄν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1190.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1190.1.text#εἰ τοῖσιν αὐθένταισιν εὖ φρονήσομεν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1191.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1191.1.text#ἥκων δ' ἂν Ἄργος προσπέσοις τέκνοισι σοῖς;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1192.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1192.1.text#ἀλλ' οὐ θέμις σοι. τίς δὲ καὶ προσβλέψεται
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1193.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1193.1.text#παίδων σ', ἵν' αὐτῶν προσέμενος κτάνῃς τινά;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1194.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1194.1.text#ταῦτ' ἦλθες ἤδη διὰ λόγων, ἢ σκῆπτρά σοι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1195.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1195.1.text#μόνον διαφέρειν καὶ στρατηλατεῖν μέλει;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1196.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1196.1.text#ὃν χρῆν δίκαιον λόγον ἐν Ἀργείοις λέγειν·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1197.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1197.1.text#Βούλεσθ', Ἀχαιοί, πλεῖν Φρυγῶν ἐπὶ χθόνα;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1198.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1198.1.text#κλῆρον τίθεσθε παῖδ' ὅτου θανεῖν χρεών.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1199.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1199.1.text#ἐν ἴσῳ γὰρ ἦν τόδ', ἀλλὰ μὴ σὲ ἐξαίρετον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1200.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1200.1.text#σφάγιον παρασχεῖν Δαναΐδαισι παῖδα σήν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1201.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1201.1.text#ἢ Μενέλεων πρὸ μητρὸς Ἑρμιόνην κτανεῖν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1202.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1202.1.text#οὗπερ τὸ πρᾶγμ' ἦν. νῦν δ' ἐγὼ μὲν ἡ τὸ σὸν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1203.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1203.1.text#σῴζουσα λέκτρον παιδὸς ἐστερήσομαι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1204.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1204.1.text#ἡ δ' ἐξαμαρτοῦσ', ὑπότροφον νεάνιδα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1205.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1205.1.text#Σπάρτῃ κομίζουσ', εὐτυχὴς γενήσεται.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1206.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1206.1.text#τούτων ἄμειψαί μ' εἴ τι μὴ καλῶς λέγω·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1207.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1207.1.text#εἰ δ' εὖ λέλεκται, { νῶι μὴ δή γε κτάνῃς }
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1208.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1208.1.text#τὴν σήν τε κἀμὴν παῖδα, καὶ σώφρων ἔσῃ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1209.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1209.1.text#πιθοῦ. τὸ γάρ τοι τέκνα συνσῴζειν καλόν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1210.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1210.1.text#Ἀγάμεμνον· οὐδεὶς πρὸς τάδ' ἀντερεῖ βροτῶν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1211.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1211.1.text#εἰ μὲν τὸν Ὀρφέως εἶχον, ὦ πάτερ, λόγον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1212.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1212.1.text#πείθειν ἐπᾴδουσ', ὥσθ' ὁμαρτεῖν μοι πέτρας,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1213.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1213.1.text#κηλεῖν τε τοῖς λόγοισιν οὓς ἐβουλόμην,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1214.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1214.1.text#ἐνταῦθ' ἂν ἦλθον· νῦν δέ, τἀπ' ἐμοῦ σοφά,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1215.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1215.1.text#δάκρυα παρέξω· ταῦτα γὰρ δυναίμεθ' ἄν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1216.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1216.1.text#ἱκετηρίαν δὲ γόνασιν ἐξάπτω σέθεν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1217.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1217.1.text#τὸ σῶμα τοὐμόν, ὅπερ ἔτικτεν ἥδε σοι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1218.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1218.1.text#μή μ' ἀπολέσῃς ἄωρον· ἡδὺ γὰρ τὸ φῶς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1219.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1219.1.text#βλέπειν· τὰ δ' ὑπὸ γῆς μή μ' ἰδεῖν ἀναγκάσῃς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1220.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1220.1.text#πρώτη σ' ἐκάλεσα πατέρα καὶ σὺ παῖδ' ἐμέ·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1221.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1221.1.text#πρώτη δὲ γόνασι σοῖσι σῶμα δοῦσ' ἐμὸν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1222.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1222.1.text#φίλας χάριτας ἔδωκα κἀντεδεξάμην.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1223.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1223.1.text#λόγος δ' ὁ μὲν σὸς ἦν ὅδ'· Ἆρά σ', ὦ τέκνον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1224.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1224.1.text#εὐδαίμον' ἀνδρὸς ἐν δόμοισιν ὄψομαι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1225.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1225.1.text#ζῶσάν τε καὶ θάλλουσαν ἀξίως ἐμοῦ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1226.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1226.1.text#οὑμὸς δ' ὅδ' ἦν αὖ περὶ σὸν ἐξαρτωμένης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1227.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1227.1.text#γένειον, οὗ νῦν ἀντιλάζυμαι χερί·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1228.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1228.1.text#Τί δ' ἆρ' ἐγὼ σέ; πρέσβυν ἆρ' ἐσδέξομαι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1229.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1229.1.text#ἐμῶν φίλαισιν ὑποδοχαῖς δόμων, πάτερ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1230.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1230.1.text#πόνων τιθηνοὺς ἀποδιδοῦσά σοι τροφάς;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1231.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1231.1.text#τούτων ἐγὼ μὲν τῶν λόγων μνήμην ἔχω,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1232.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1232.1.text#σὺ δ' ἐπιλέλησαι, καί μ' ἀποκτεῖναι θέλεις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1233.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1233.1.text#μή, πρός σε Πέλοπος καὶ πρὸς Ἀτρέως πατρὸς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1234.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1234.1.text#καὶ τῆσδε μητρός, ἣ πρὶν ὠδίνουσ' ἐμὲ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1235.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1235.1.text#νῦν δευτέραν ὠδῖνα τήνδε λαμβάνει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1236.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1236.1.text#τί μοι μέτεστι τῶν Ἀλεξάνδρου γάμων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1237.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1237.1.text#Ἑλένης τε; πόθεν ἦλθ' ἐπ' ὀλέθρῳ τὠμῷ, πάτερ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1238.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1238.1.text#βλέψον πρὸς ἡμᾶς, ὄμμα δὸς φίλημά τε,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1239.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1239.1.text#ἵν' ἀλλὰ τοῦτο κατθανοῦσ' ἔχω σέθεν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1240.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1240.1.text#μνημεῖον, ἢν μὴ τοῖς ἐμοῖς πεισθῇς λόγοις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1241.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1241.1.text#ἀδελφέ, μικρὸς μὲν σύ γ' ἐπίκουρος φίλοις,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1242.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1242.1.text#ὅμως δὲ συνδάκρυσον, ἱκέτευσον πατρὸς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1243.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1243.1.text#τὴν σὴν ἀδελφὴν μὴ θανεῖν· αἴσθημά τοι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1244.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1244.1.text#κἀν νηπίοις γε τῶν κακῶν ἐγγίγνεται.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1245.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1245.1.text#ἰδοὺ σιωπῶν λίσσεταί σ' ὅδ', ὦ πάτερ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1246.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1246.1.text#ἀλλ' αἴδεσαί με καὶ κατοίκτιρον βίου.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1247.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1247.1.text#ναί, πρὸς γενείου σ' ἀντόμεσθα δύο φίλω·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1248.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1248.1.text#ὃ μὲν νεοσσός ἐστιν, ἣ δ' ηὐξημένη.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1249.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1249.1.text#ἓν συντεμοῦσα πάντα νικήσω λόγον·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1250.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1250.1.text#τὸ φῶς τόδ' ἀνθρώποισιν ἥδιστον βλέπειν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1251.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1251.1.text#τὰ νέρθε δ' οὐδέν· μαίνεται δ' ὃς εὔχεται
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1252.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1252.1.text#θανεῖν. κακῶς ζῆν κρεῖσσον ἢ καλῶς θανεῖν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1253.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1253.1.text#ὦ τλῆμον Ἑλένη, διὰ σὲ καὶ τοὺς σοὺς γάμους
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1254.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1254.1.text#ἀγὼν Ἀτρείδαις καὶ τέκνοις ἥκει μέγας.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1255.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1255.1.text#ἐγὼ τά τ' οἰκτρὰ συνετός εἰμι καὶ τὰ μή,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1256.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1256.1.text#φιλῶ τ' ἐμαυτοῦ τέκνα· μαινοίμην γὰρ ἄν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1257.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1257.1.text#δεινῶς δ' ἔχει μοι ταῦτα τολμῆσαι, γύναι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1258.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1258.1.text#δεινῶς δὲ καὶ μή· τοῦτο γὰρ πρᾶξαί με δεῖ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1259.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1259.1.text#ὁρᾶθ' ὅσον στράτευμα ναύφρακτον τόδε,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1260.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1260.1.text#χαλκέων θ' ὅπλων ἄνακτες Ἑλλήνων ὅσοι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1261.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1261.1.text#οἷς νόστος οὐκ ἔστ' Ἰλίου πύργους ἔπι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1262.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1262.1.text#εἰ μή σε θύσω, μάντις ὡς Κάλχας λέγει,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1263.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1263.1.text#οὐδ' ἔστι Τροίας ἐξελεῖν κλεινὸν βάθρον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1264.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1264.1.text#μέμηνε δ' Ἀφροδίτη τις Ἑλλήνων στρατῷ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1265.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1265.1.text#πλεῖν ὡς τάχιστα βαρβάρων ἐπὶ χθόνα,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1266.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1266.1.text#παῦσαί τε λέκτρων ἁρπαγὰς Ἑλληνικῶν·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1267.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1267.1.text#οἳ τὰς ἐν Ἄργει παρθένους κτενοῦσί μου
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1268.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1268.1.text#ὑμᾶς τε κἀμέ, θέσφατ' εἰ λύσω θεᾶς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1269.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1269.1.text#οὐ Μενέλεώς με καταδεδούλωται, τέκνον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1270.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1270.1.text#οὐδ' ἐπὶ τὸ κείνου βουλόμενον ἐλήλυθα,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1271.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1271.1.text#ἀλλ' Ἑλλάς, ᾗ δεῖ, κἂν θέλω κἂν μὴ θέλω,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1272.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1272.1.text#θῦσαί σε· τούτου δ' ἥσσονες καθέσταμεν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1273.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1273.1.text#ἐλευθέραν γὰρ δεῖ νιν ὅσον ἐν σοί, τέκνον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1274.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1274.1.text#κἀμοὶ γενέσθαι, μηδὲ βαρβάροις ὕπο
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1275.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1275.1.text#Ἕλληνας ὄντας λέκτρα συλᾶσθαι βίᾳ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1276.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1276.1.text#ὦ τέκνον, ὦ ξέναι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1277.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1277.1.text#οἲ 'γὼ θανάτου { τοῦ } σοῦ μελέα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1278.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1278.1.text#φεύγει σε πατὴρ Ἅιδῃ παραδούς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1279.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1279.1.text#οἲ 'γώ, μᾶτερ· ταὐτὸν τόδε γὰρ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1280.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1280.1.text#μέλος εἰς ἄμφω πέπτωκε τύχης,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1281.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1281.1.text#κοὐκέτι μοι φῶς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1282.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1282.1.text#οὐδ' ἀελίου τόδε φέγγος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1283.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1283.1.text#ἰὼ ἰώ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1284.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1284.1.text#νιφόβολον Φρυγῶν νάπος Ἴδας τ' ὄρεα,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1285.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1285.1.text#Πρίαμος ὅθι ποτὲ βρέφος ἁπαλὸν ἔβαλε
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1286.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1286.1.text#ματέρος ἀποπρὸ νοσφίσας ἐπὶ μόρῳ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1289.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1289.1.text#θανατόεντι Πάριν, ὃς Ἰδαῖος Ἰδαῖος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1290.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1290.1.text#ἐλέγετ' ἐλέγετ' ἐν Φρυγῶν πόλει,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1291.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1291.1.text#μή ποτ' ὤφελες τὸν ἀμφὶ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1292.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1292.1.text#βουσὶ βουκόλον τραφέντ'
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1293.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1293.1.text#Ἀλέξανδρον οἰκίσαι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1294.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1294.1.text#ἀμφὶ τὸ λευκὸν ὕδωρ, ὅθι κρῆναι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1295.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1295.1.text#Νυμφᾶν κεῖνται
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1296.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1296.1.text#λειμών τ' ἔρνεσι θάλλων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1297.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1297.1.text#χλωροῖς καὶ ῥοδόεντ'
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1299.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1299.1.text#ἄνθε' ὑακίνθινά τε θεαῖς δρέπειν· ἔνθα ποτὲ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1300.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1300.1.text#Παλλὰς ἔμολε καὶ δολιόφρων Κύπρις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1302.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1302.1.text#Ἥρα θ' Ἑρμᾶς θ', ὁ Διὸς ἄγγελος,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1304.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1304.1.text#ἃ μὲν ἐπὶ πόθῳ τρυφῶσα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1305.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1305.1.text#Κύπρις, ἃ δὲ δορὶ Παλλάς,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1306.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1306.1.text#Ἥρα τε Διὸς ἄνακτος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1307.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1307.1.text#εὐναῖσι βασιλίσιν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1308.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1308.1.text#κρίσιν ἐπὶ στυγνὰν ἔριν τε
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1309.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1309.1.text#καλλονᾶς, ἐμοὶ δὲ θάνατον —
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1310.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1310.1.text#ὄνομα μὲν φέροντα Δαναΐδαισιν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1310a.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1310a.1.text#ὦ κόραι, πρόθυμα δ'
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1311.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1311.1.text#ἔλαβεν Ἄρτεμις πρὸς Ἴλιον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1312.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1312.1.text#ὁ δὲ τεκών με τὰν τάλαιναν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1313.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1313.1.text#ὦ μᾶτερ ὦ μᾶτερ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1314.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1314.1.text#οἴχεται προδοὺς ἔρημον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1315.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1315.1.text#ὦ δυστάλαιν' ἐγώ, πικρὰν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1316.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1316.1.text#πικρὰν ἰδοῦσα δυσελέναν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1317.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1317.1.text#φονεύομαι διόλλυμαι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1318.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1318.1.text#σφαγαῖσιν ἀνοσίοισιν ἀνοσίου πατρός.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1319.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1319.1.text#μή μοι ναῶν χαλκεμβολάδων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1320.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1320.1.text#πρύμνας [ ἅδ' ] Αὐλὶς δέξασθαι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1321.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1321.1.text#τούσδ' εἰς ὅρμους [ ἐς Τροίαν ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1322.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1322.1.text#ὤφελεν ἐλάταν πομπαίαν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1323.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1323.1.text#μηδ' ἀνταίαν Εὐρίπῳ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1324.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1324.1.text#πνεῦσαι πομπὰν Ζεύς, μειλίσσων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1325.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1325.1.text#αὔραν ἄλλοις ἄλλαν θνατῶν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1326.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1326.1.text#λαίφεσι χαίρειν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1327.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1327.1.text#τοῖσι δὲ λύπαν, τοῖσι δ' ἀνάγκαν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1328.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1328.1.text#τοῖς δ' ἐξορμᾶν, τοῖς δὲ στέλλειν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1329.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1329.1.text#τοῖσι δὲ μέλλειν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1330.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1330.1.text#ἦ πολύμοχθον ἄρ' ἦν γένος, ἦ πολύμοχθον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1331.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1331.1.text#ἁμερίων, { τὸ } χρεὼν δέ τι δύσποτμον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1332.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1332.1.text#ἀνδράσιν ἀνευρεῖν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1333.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1333.1.text#ἰὼ ἰώ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1334.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1334.1.text#μεγάλα πάθεα, μεγάλα δ' ἄχεα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1335.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1335.1.text#Δαναΐδαις τιθεῖσα Τυνδαρὶς κόρα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1336.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1336.1.text#ἐγὼ μὲν οἰκτίρω σε συμφορᾶς κακῆς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1337.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1337.1.text#τυχοῦσαν, οἵας μήποτ' ὤφελες τυχεῖν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1338.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1338.1.text#ὦ τεκοῦσα μῆτερ, ἀνδρῶν ὄχλον εἰσορῶ πέλας.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1339.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1339.1.text#τόν τε τῆς θεᾶς παῖδα, τέκνον, ᾧ { σὺ } δεῦρ' ἐλήλυθας.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1340.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1340.1.text#διαχαλᾶτέ μοι μέλαθρα, δμῶες, ὡς κρύψω δέμας.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1341.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1341.1.text#τί δὲ τέκνον, φεύγεις;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1341.2.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1341.2.text#Ἀχιλλέα τόνδ' ἰδεῖν αἰσχύνομαι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1342.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1342.1.text#ὡς τί δή;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1342.2.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1342.2.text#τὸ δυστυχές μοι τῶν γάμων αἰδῶ φέρει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1343.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1343.1.text#οὐκ ἐν ἁβρότητι κεῖσαι πρὸς τὰ νῦν πεπτωκότα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1344.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1344.1.text#ἀλλὰ μίμν'· οὐ σεμνότητος ἔργον, ἢν ὀνώμεθα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1345.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1345.1.text#ὦ γύναι τάλαινα, Λήδας θύγατερ—
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1345.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1345.2.text#οὐ ψευδῆ θροεῖς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1346.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1346.1.text#δείν' ἐν Ἀργείοις βοᾶται—
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1346.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1346.2.text#τίνα βοήν; σήμαινέ μοι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1347.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1347.1.text#ἀμφὶ σῆς παιδός—
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1347.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1347.2.text#πονηρὸν εἶπας οἰωνὸν λόγον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1348.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1348.1.text#ὡς χρεὼν σφάξαι νιν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1348.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1348.2.text#οὐδεὶς { τοῖσδ' } ἐναντίον λέγει;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1349.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1349.1.text#ἐς θόρυβον ἐγώ τι καὐτὸς ἤλυθον—
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1349.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1349.2.text#τίν', ὦ ξένε;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1350.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1350.1.text#σῶμα λευσθῆναι πέτροισι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1350.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1350.2.text#μῶν κόρην σῴζων ἐμήν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1351.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1351.1.text#αὐτὸ τοῦτο.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1351.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1351.2.text#τίς δ' ἂν ἔτλη [ τοῦ ] σώματος τοῦ σοῦ θιγεῖν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1352.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1352.1.text#πάντες Ἕλληνες.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1352.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1352.2.text#στρατὸς δὲ Μυρμιδὼν οὔ σοι παρῆν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1353.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1353.1.text#πρῶτος ἦν ἐκεῖνος ἐχθρός.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1353.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1353.2.text#δι' ἄρ' ὀλώλαμεν, τέκνον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1354.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1354.1.text#οἵ με τὸν γάμων ἀπεκάλουν ἥσσονα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1354.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1354.2.text#ἀπεκρίνω δὲ τί;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1355.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1355.1.text#τὴν ἐμὴν μέλλουσαν εὐνὴν μὴ κτανεῖν—
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1355.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1355.2.text#δίκαια γάρ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1356.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1356.1.text#ἣν ἐφήμισεν πατήρ μοι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1356.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1356.2.text#καὶ Ἀργόθεν γ' ἐπέμψατο.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1357.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1357.1.text#ἀλλ' ἐνικώμην κεκραγμοῦ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1357.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1357.2.text#τὸ πολὺ γὰρ δεινὸν κακόν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1358.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1358.1.text#ἀλλ' ὅμως ἀρήξομέν σοι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1358.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1358.2.text#καὶ μαχῇ πολλοῖσιν εἷς;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1359.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1359.1.text#εἰσορᾷς τεύχη φέροντας τούσδε;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1359.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1359.2.text#ὄναιο τῶν φρενῶν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1360.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1360.1.text#ἀλλ' ὀνησόμεσθα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1360.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1360.2.text#παῖς ἄρ' οὐκέτι σφαγήσεται;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1361.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1361.1.text#οὔκ, ἐμοῦ γ' ἑκόντος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1361.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1361.2.text#ἥξει δ' ὅστις ἅψεται κόρης;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1362.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1362.1.text#μυρίοι γ', ἄξει δ' Ὀδυσσεύς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1362.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1362.2.text#ἆρ' ὁ Σισύφου γόνος;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1363.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1363.1.text#αὐτὸς οὗτος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1363.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1363.2.text#ἴδια πράσσων, ἢ στρατοῦ ταχθεὶς ὕπο;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1364.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1364.1.text#αἱρεθεὶς ἑκών.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1364.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1364.2.text#πονηράν γ' αἵρεσιν, μιαιφονεῖν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1365.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1365.1.text#ἀλλ' ἐγὼ σχήσω νιν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1365.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1365.2.text#ἄξει δ' οὐχ ἑκοῦσαν ἁρπάσας;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1366.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1366.1.text#δηλαδὴ ξανθῆς ἐθείρας.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1366.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1366.2.text#ἐμὲ δὲ δρᾶν τί χρὴ τότε;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1367.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1367.1.text#ἀντέχου θυγατρός.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1367.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1367.2.text#ὡς τοῦδ' εἵνεκ' οὐ σφαγήσεται.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1368.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1368.1.text#ἀλλὰ μὴν ἐς τοῦτό γ' ἥξει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1368.2.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1368.2.text#μῆτερ, εἰσακούσατε
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1369.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1369.1.text#τῶν ἐμῶν λόγων· μάτην γάρ σ' εἰσορῶ θυμουμένην
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1370.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1370.1.text#σῷ πόσει· τὰ δ' ἀδύναθ' ἡμῖν καρτερεῖν οὐ ῥᾴδιον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1371.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1371.1.text#τὸν μὲν οὖν ξένον δίκαιον αἰνέσαι προθυμίας·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1372.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1372.1.text#ἀλλὰ καὶ σὲ τοῦθ' ὁρᾶν χρή, μὴ διαβληθῇ στρατῷ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1373.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1373.1.text#καὶ πλέον πράξωμεν οὐδέν, ὅδε δὲ συμφορᾶς τύχῃ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1374.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1374.1.text#οἷα δ' εἰσῆλθέν μ', ἄκουσον, μῆτερ, ἐννοουμένην·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1375.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1375.1.text#κατθανεῖν μέν μοι δέδοκται· τοῦτο δ' αὐτὸ βούλομαι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1376.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1376.1.text#εὐκλεῶς πρᾶξαι, παρεῖσά γ' ἐκποδὼν τὸ δυσγενές.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1377.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1377.1.text#δεῦρο δὴ σκέψαι μεθ' ἡμῶν, μῆτερ, ὡς καλῶς λέγω·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1378.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1378.1.text#εἰς ἔμ' Ἑλλὰς ἡ μεγίστη πᾶσα νῦν ἀποβλέπει,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1379.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1379.1.text#κἀν ἐμοὶ πορθμός τε ναῶν καὶ Φρυγῶν κατασκαφαὶ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1380.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1380.1.text#τάς τε μελλούσας γυναῖκας, ἤν τι δρῶσι βάρβαροι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1381.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1381.1.text#μηκέθ' ἁρπάζειν ἐᾶν τούσδ' ὀλβίας ἐξ Ἑλλάδος,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1382.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1382.1.text#τὸν Ἑλένης τείσαντας ὄλεθρον, ἣν { ἀν }ήρπασεν Πάρις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1383.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1383.1.text#ταῦτα πάντα κατθανοῦσα ῥύσομαι, καί μου κλέος,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1384.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1384.1.text#Ἑλλάδ' ὡς ἠλευθέρωσα, μακάριον γενήσεται.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1385.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1385.1.text#καὶ γὰρ οὐδέ τοί τι λίαν ἐμὲ φιλοψυχεῖν χρεών·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1386.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1386.1.text#πᾶσι γάρ μ' Ἕλλησι κοινὸν ἔτεκες, οὐχὶ σοὶ μόνῃ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1387.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1387.1.text#ἀλλὰ μυρίοι μὲν ἄνδρες ἀσπίσιν πεφραγμένοι,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1388.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1388.1.text#μυρίοι δ' ἐρέτμ' ἔχοντες, πατρίδος ἠδικημένης,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1389.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1389.1.text#δρᾶν τι τολμήσουσιν ἐχθροὺς χὑπὲρ Ἑλλάδος θανεῖν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1390.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1390.1.text#ἡ δ' ἐμὴ ψυχὴ μί' οὖσα πάντα κωλύσει τάδε;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1391.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1391.1.text#τί τὸ δίκαιον τοῦτό γε; ἆρ' ἔχοιμ' ἂν ἀντειπεῖν ἔπος;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1392.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1392.1.text#κἀπ' ἐκεῖν' ἔλθωμεν· οὐ δεῖ τόνδε διὰ μάχης μολεῖν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1393.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1393.1.text#πᾶσιν Ἀργείοις γυναικὸς εἵνεκ' οὐδὲ κατθανεῖν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1394.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1394.1.text#εἷς γ' ἀνὴρ κρείσσων γυναικῶν μυρίων ὁρᾶν φάος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1395.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1395.1.text#εἰ βεβούληται δὲ σῶμα τοὐμὸν Ἄρτεμις λαβεῖν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1396.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1396.1.text#ἐμποδὼν γενήσομαι 'γὼ θνητὸς οὖσα τῇ θεῷ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1397.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1397.1.text#ἀλλ' ἀμήχανον· δίδωμι σῶμα τοὐμὸν Ἑλλάδι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1398.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1398.1.text#θύετ', ἐκπορθεῖτε Τροίαν. ταῦτα γὰρ μνημεῖά μου
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1399.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1399.1.text#διὰ μακροῦ, καὶ παῖδες οὗτοι καὶ γάμοι καὶ δόξ' ἐμή.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1400.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1400.1.text#βαρβάρων δ' Ἕλληνας ἄρχειν εἰκός, ἀλλ' οὐ βαρβάρους,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1401.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1401.1.text#μῆτερ, Ἑλλήνων· τὸ μὲν γὰρ δοῦλον, οἳ δ' ἐλεύθεροι.[ … ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1402.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1402.1.text#τὸ μὲν σόν, ὦ νεᾶνι, γενναίως ἔχει·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1403.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1403.1.text#τὸ τῆς τύχης δὲ καὶ τὸ τῆς θεοῦ νοσεῖ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1404.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1404.1.text#Ἀγαμέμνονος παῖ, μακάριόν μέ τις θεῶν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1405.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1405.1.text#ἔμελλε θήσειν, εἰ τύχοιμι σῶν γάμων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1406.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1406.1.text#ζηλῶ δὲ σοῦ μὲν Ἑλλάδ', Ἑλλάδος δὲ σέ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1407.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1407.1.text#εὖ γὰρ τόδ' εἶπας ἀξίως τε πατρίδος·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1408.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1408.1.text#τὸ θεομαχεῖν γὰρ ἀπολιποῦσ', ὅ σου κρατεῖ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1409.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1409.1.text#ἐξελογίσω τὰ χρηστὰ τἀναγκαῖά τε.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1410.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1410.1.text#μᾶλλον δὲ λέκτρων σῶν πόθος μ' ἐσέρχεται
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1411.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1411.1.text#ἐς τὴν φύσιν βλέψαντα· γενναία γὰρ εἶ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1412.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1412.1.text#ὅρα δ'· ἐγὼ γὰρ βούλομαί σ' εὐεργετεῖν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1413.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1413.1.text#λαβεῖν τ' ἐς οἴκους· ἄχθομαί τ', ἴστω Θέτις,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1414.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1414.1.text#εἰ μή σε σώσω Δαναΐδαισι διὰ μάχης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1415.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1415.1.text#ἐλθών. ἄθρησον· ὁ θάνατος δεινὸν κακόν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1416.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1416.1.text#λέγω τάδ' οὐδὲν οὐδέν' εὐλαβουμένη.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1417.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1417.1.text#ἡ Τυνδαρὶς παῖς διὰ τὸ σῶμ' ἀρκεῖ μάχας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1418.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1418.1.text#ἀνδρῶν τιθεῖσα καὶ φόνους· σὺ δ', ὦ ξένε,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1419.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1419.1.text#μὴ θνῇσκε δι' ἐμὲ μηδ' ἀποκτείνῃς τινά,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1420.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1420.1.text#ἔα δὲ σῷσαί μ' Ἑλλάδ', ἢν δυνώμεθα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1421.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1421.1.text#ὦ λῆμ' ἄριστον, οὐκ ἔχω πρὸς τοῦτ' ἔτι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1422.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1422.1.text#λέγειν, ἐπεί σοι τάδε δοκεῖ· γενναῖα γὰρ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1423.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1423.1.text#φρονεῖς· τί γὰρ τἀληθὲς οὐκ εἴποι τις ἄν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1424.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1424.1.text#ὅμως δ', ἴσως γὰρ κἂν μεταγνοίης τάδε,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1425.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1425.1.text#[ ὡς οὖν ἂν εἰδῇς τἀπ' ἐμοῦ λελεγμένα, ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1426.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1426.1.text#ἐλθὼν τάδ' ὅπλα θήσομαι βωμοῦ πέλας,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1427.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1427.1.text#ὡς οὐκ ἐάσων σ' ἀλλὰ κωλύσων θανεῖν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1428.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1428.1.text#χρήσῃ δὲ καὶ σὺ τοῖς ἐμοῖς λόγοις τάχα,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1429.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1429.1.text#ὅταν πέλας σῆς φάσγανον δέρης ἴδῃς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1430.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1430.1.text#οὔκουν ἐάσω σ' ἀφροσύνῃ τῇ σῇ θανεῖν·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1431.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1431.1.text#ἐλθὼν δὲ σὺν ὅπλοις τοῖσδε πρὸς ναὸν θεᾶς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1432.1.speaker#Ἀχιλλεύς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1432.1.text#καραδοκήσω σὴν ἐκεῖ παρουσίαν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1433.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1433.1.text#μῆτερ, τί σιγῇ δακρύοις τέγγεις κόρας;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1434.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1434.1.text#ἔχω τάλαινα πρόφασιν ὥστ' ἀλγεῖν φρένα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1435.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1435.1.text#παῦσαι· 'μὲ μὴ κάκιζε· τάδε δέ μοι πιθοῦ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1436.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1436.1.text#λέγ'· ὡς παρ' ἡμῶν οὐδὲν ἀδικήσῃ, τέκνον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1437.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1437.1.text#μήτ' οὖν γε τὸν σὸν πλόκαμον ἐκτέμῃς τριχός,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1438.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1438.1.text#μήτ' ἀμφὶ σῶμα μέλανας ἀμπίσχῃ πέπλους.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1439.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1439.1.text#τί δὴ τόδ' εἶπας, τέκνον; ἀπολέσασά σε;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1440.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1440.1.text#οὐ σύ γε· σέσῳσμαι, κατ' ἐμὲ δ' εὐκλεὴς ἔσῃ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1441.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1441.1.text#πῶς εἶπας; οὐ πενθεῖν με σὴν ψυχὴν χρεών;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1442.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1442.1.text#ἥκιστ', ἐπεί μοι τύμβος οὐ χωσθήσεται.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1443.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1443.1.text#τί δαί; τὸ θνῄσκειν, οὐ τάφος, νομίζεται.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1444.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1444.1.text#βωμὸς θεᾶς μοι μνῆμα τῆς Διὸς κόρης.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1445.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1445.1.text#ἀλλ', ὦ τέκνον, σοὶ πείσομαι· λέγεις γὰρ εὖ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1446.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1446.1.text#ὡς εὐτυχοῦσά γ' Ἑλλάδος τ' εὐεργέτις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1447.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1447.1.text#τί δὴ κασιγνήταισιν ἀγγελῶ σέθεν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1448.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1448.1.text#μηδ' ἀμφὶ κείναις μέλανας ἐξάψῃ πέπλους.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1449.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1449.1.text#εἴπω δὲ παρὰ σοῦ φίλον ἔπος τι παρθένοις;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1450.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1450.1.text#χαίρειν γε. Ὀρέστην τ' ἔκτρεφ' ἄνδρα τόνδε μοι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1451.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1451.1.text#προσέλκυσαί νιν ὕστατον θεωμένη.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1452.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1452.1.text#ὦ φίλτατ', ἐπεκούρησας ὅσον εἶχες φίλοις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1453.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1453.1.text#ἔσθ' ὅ τι κατ' Ἄργος δρῶσά σοι χάριν φέρω;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1454.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1454.1.text#πατέρα τὸν ἀμὸν μὴ στύγει, πόσιν γε σόν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1455.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1455.1.text#δεινοὺς ἀγῶνας διὰ σὲ δεῖ κεῖνον δραμεῖν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1456.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1456.1.text#ἄκων μ' ὑπὲρ γῆς Ἑλλάδος διώλεσεν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1457.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1457.1.text#δόλῳ δ', ἀγεννῶς Ἀτρέως τ' οὐκ ἀξίως.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1458.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1458.1.text#τίς μ' εἶσιν ἄξων πρὶν σπαράσσεσθαι κόμης;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1459.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1459.1.text#ἐγώ, μετά γε σοῦ—
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1459.2.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1459.2.text#μὴ σύ γ'· οὐ καλῶς λέγεις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1460.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1460.1.text#πέπλων ἐχομένη σῶν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1460.2.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1460.2.text#ἐμοί, μῆτερ, πιθοῦ·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1461.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1461.1.text#μέν'· ὡς ἐμοί τε σοί τε κάλλιον τόδε.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1462.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1462.1.text#πατρὸς δ' ὀπαδῶν τῶνδέ τίς με πεμπέτω
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1463.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1463.1.text#Ἀρτέμιδος ἐς λειμῶν', ὅπου σφαγήσομαι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1464.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1464.1.text#ὦ τέκνον, οἴχῃ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1464.2.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1464.2.text#καὶ πάλιν γ' οὐ μὴ μόλω.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1465.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1465.1.text#λιποῦσα μητέρα;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1465.2.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1465.2.text#ὡς ὁρᾷς γ', οὐκ ἀξίως.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1466.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1466.1.text#σχές, μή με προλίπῃς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1466.2.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1466.2.text#οὐκ ἐῶ στάζειν δάκρυ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1467.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1467.1.text#ὑμεῖς δ' ἐπευφημήσατ', ὦ νεάνιδες,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1468.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1468.1.text#παιᾶνα τἠμῇ συμφορᾷ Διὸς κόρην
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1469.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1469.1.text#Ἄρτεμιν· ἴτω δὲ Δαναΐδαις εὐφημία.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1470.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1470.1.text#κανᾶ δ' ἐναρχέσθω τις, αἰθέσθω δὲ πῦρ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1471.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1471.1.text#προχύταις καθαρσίοισι, καὶ πατὴρ ἐμὸς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1472.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1472.1.text#ἐνδεξιούσθω βωμόν· ὡς σωτηρίαν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1473.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1473.1.text#Ἕλλησι δώσουσ' ἔρχομαι νικηφόρον.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1475.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1475.1.text#ἄγετέ με τὰν Ἰλίου
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1476.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1476.1.text#καὶ Φρυγῶν ἑλέπτολιν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1477.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1477.1.text#στέφεα περίβολα δίδοτε, φέρετε
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1478.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1478.1.text#— πλόκαμος ὅδε καταστέφειν —
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1479.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1479.1.text#χερνίβων τε παγάς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1480.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1480.1.text#ἑλίσσετ' ἀμφὶ ναὸν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1481.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1481.1.text#ἀμφὶ βωμὸν Ἄρτεμιν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1482.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1482.1.text#τὰν ἄνασσαν Ἄρτεμιν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1483.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1483.1.text#τὰν μάκαιραν· ὡς ἐμοῖσιν, εἰ χρεών,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1485.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1485.1.text#αἵμασι θύμασί [ τε ]
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1486.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1486.1.text#θέσφατ' ἐξαλείψω.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1487.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1487.1.text#ὦ πότνια πότνια μᾶτερ, οὐ δάκρυά γέ σοι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1489.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1489.1.text#δώσομεν ἁμέτερα·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1490.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1490.1.text#παρ' ἱεροῖς γὰρ οὐ πρέπει.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1491.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1491.1.text#ἰὼ ἰὼ νεάνιδες,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1492.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1492.1.text#συνεπαείδετ' Ἄρτεμιν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1493.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1493.1.text#Χαλκίδος ἀντίπορον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1495.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1495.1.text#ἵνα τε δόρατα μέμονε δάϊ'
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1496.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1496.1.text#ὄνομα δι' ἐμὸν [ τᾶσδ' ] Αὐλίδος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1497.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1497.1.text#στενοπόροις ἐν ὅρμοις.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1498.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1498.1.text#ἰὼ γᾶ μᾶτερ ὦ Πελασγία,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1499.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1499.1.text#Μυκηναῖαί τ' ἐμαὶ θεράπναι—
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1500.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1500.1.text#καλεῖς πόλισμα Περσέως,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1501.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1501.1.text#Κυκλωπίων πόνον χερῶν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1502.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1502.1.text#ἐθρέψαθ' Ἑλλάδι με φάος·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1503.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1503.1.text#θανοῦσα δ' οὐκ ἀναίνομαι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1504.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1504.1.text#κλέος γὰρ οὔ σε μὴ λίπῃ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1505.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1505.1.text#ἰὼ ἰώ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1506.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1506.1.text#λαμπαδοῦχος ἁμέρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1507.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1507.1.text#Διός τε φέγγος, ἕτερον ἕτερον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1508.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1508.1.text#αἰῶνα καὶ μοῖραν οἰκήσομεν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1509.1.speaker#Ἰφιγένεια
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1509.1.text#χαῖρέ μοι, φίλον φάος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1510.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1510.1.text#ἰὼ ἰώ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1510.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1510.2.text#ἴδεσθε τὰν Ἰλίου
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1511.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1511.1.text#καὶ Φρυγῶν ἑλέπτολιν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1512.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1512.1.text#στείχουσαν, ἐπὶ κάρα στέφη
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1513.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1513.1.text#βαλουμέναν χερνίβων τε παγάς,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1514.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1514.1.text#βωμόν γε δαίμονος θεᾶς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1515.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1515.1.text#ῥανίσιν αἱματορρύτοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1516.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1516.1.text#χρανοῦσαν εὐφυῆ τε σώματος δέρην
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1517.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1517.1.text#[ σφαγεῖσαν. ] εὔδροσοι παγαὶ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1518.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1518.1.text#πατρῷαι μένουσι χέρνιβές τέ σε
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1519.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1519.1.text#στρατός τ' Ἀχαιῶν θέλων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1520.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1520.1.text#Ἰλίου πόλιν μολεῖν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1521.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1521.1.text#ἀλλὰ τὰν Διὸς κόραν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1522.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1522.1.text#κλῄσωμεν Ἄρτεμιν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1523.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1523.1.text#θεῶν ἄνασσαν, ὡς ἐπ' εὐτυχεῖ πότμῳ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1524.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1524.1.text#ὦ πότνια, πότνια, θύμασιν βροτησίοις
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1525.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1525.1.text#χαρεῖσα, πέμψον ἐς Φρυγῶν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1526.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1526.1.text#γαῖαν Ἑλλάνων στρατὸν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1527.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1527.1.text#{ καὶ δολόεντα Τροίας ἕδη, }
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1528.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1528.1.text#{ Ἀγαμέμνονά τε λόγχαις }
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1529.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1529.1.text#{ Ἑλλάδι κλεινότατον στέφανον }
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1530.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1530.1.text#{ δὸς ἀμφὶ κάρα ἑὸν }
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1531.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1531.1.text#κλέος ἀείμνηστον ἀμφιθεῖναι.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1532.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1532.1.text#ὦ Τυνδαρεία παῖ, Κλυταιμήστρα, δόμων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1533.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1533.1.text#ἔξω πέρασον, ὡς κλύῃς ἐμῶν λόγων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1534.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1534.1.text#φθογγῆς κλύουσα δεῦρο σῆς ἀφικόμην,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1535.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1535.1.text#ταρβοῦσα τλήμων κἀκπεπληγμένη φόβῳ·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1536.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1536.1.text#μή μοί τιν' ἄλλην ξυμφορὰν ἥκεις φέρων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1537.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1537.1.text#πρὸς τῇ παρούσῃ;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1537.2.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1537.2.text#σῆς μὲν οὖν παιδὸς πέρι
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1538.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1538.1.text#θαυμαστά σοι καὶ δεινὰ σημῆναι θέλω.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1539.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1539.1.text#μὴ μέλλε τοίνυν, ἀλλὰ φράζ' ὅσον τάχος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1540.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1540.1.text#ἀλλ', ὦ φίλη δέσποινα, πᾶν πεύσῃ σαφῶς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1541.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1541.1.text#λέξω δ' ἀπ' ἀρχῆς, ἤν τι μὴ σφαλεῖσά μου
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1542.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1542.1.text#γνώμη ταράξῃ γλῶσσαν ἐν λόγοις ἐμήν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1543.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1543.1.text#ἐπεὶ γὰρ ἱκόμεσθα τῆς Διὸς κόρης
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1544.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1544.1.text#Ἀρτέμιδος ἄλσος λείμακάς τ' ἀνθεσφόρους,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1545.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1545.1.text#ἵν' ἦν Ἀχαιῶν σύλλογος στρατεύματος,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1546.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1546.1.text#σὴν παῖδ' ἄγοντες, εὐθὺς Ἀργείων ὄχλος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1547.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1547.1.text#ἠθροίζεθ'. ὡς δ' ἐσεῖδεν Ἀγαμέμνων ἄναξ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1548.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1548.1.text#ἐπὶ σφαγὰς στείχουσαν εἰς ἄλσος κόρην,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1549.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1549.1.text#ἀνεστέναξε, κἄμπαλιν στρέψας κάρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1550.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1550.1.text#δάκρυε, πρόσθεν ὀμμάτων πέπλον προθείς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1551.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1551.1.text#ἣ δὲ σταθεῖσα τῷ τεκόντι πλησίον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1552.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1552.1.text#ἔλεξε τοιάδ'· Ὦ πάτερ, πάρειμί σοι·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1553.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1553.1.text#τοὐμὸν δὲ σῶμα τῆς ἐμῆς ὑπὲρ πάτρας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1554.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1554.1.text#καὶ τῆς ἁπάσης Ἑλλάδος γαίας ὕπερ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1555.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1555.1.text#θῦσαι δίδωμ' ἑκοῦσα πρὸς βωμὸν θεᾶς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1556.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1556.1.text#ἄγοντας, εἴπερ ἐστὶ θέσφατον τόδε.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1557.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1557.1.text#καὶ τοὐπ' ἔμ' εὐτυχεῖτε· καὶ νικηφόρου
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1558.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1558.1.text#δώρου τύχοιτε πατρίδα τ' ἐξίκοισθε γῆν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1559.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1559.1.text#πρὸς ταῦτα μὴ ψαύσῃ τις Ἀργείων ἐμοῦ·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1560.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1560.1.text#σιγῇ παρέξω γὰρ δέρην εὐκαρδίως.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1561.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1561.1.text#τοσαῦτ' ἔλεξε· πᾶς δ' ἐθάμβησεν κλύων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1562.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1562.1.text#εὐψυχίαν τε κἀρετὴν τῆς παρθένου.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1563.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1563.1.text#στὰς δ' ἐν μέσῳ Ταλθύβιος, ᾧ τόδ' ἦν μέλον,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1564.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1564.1.text#εὐφημίαν ἀνεῖπε καὶ σιγὴν στρατῷ·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1565.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1565.1.text#Κάλχας δ' ὁ μάντις ἐς κανοῦν χρυσήλατον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1566.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1566.1.text#ἔθηκεν ὀξὺ χειρὶ φάσγανον σπάσας
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1567.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1567.1.text#κολεῶν ἔσωθεν, κρᾶτά τ' ἔστεψεν κόρης.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1568.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1568.1.text#ὁ παῖς δ' ὁ Πηλέως ἐν κύκλῳ βωμὸν θεᾶς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1569.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1569.1.text#λαβὼν κανοῦν ἔβρεξε χέρνιβάς θ' ὁμοῦ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1570.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1570.1.text#ἔλεξε δ'· Ὦ παῖ Ζηνός, ὦ θηροκτόνε,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1571.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1571.1.text#τὸ λαμπρὸν εἱλίσσουσ' ἐν εὐφρόνῃ φάος,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1572.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1572.1.text#δέξαι τὸ θῦμα τόδ' ὅ γέ σοι δωρούμεθα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1573.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1573.1.text#στρατός τ' Ἀχαιῶν { Ἀγαμέμνων ἄναξ θ' ὁμοῦ, }
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1574.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1574.1.text#ἄχραντον αἷμα καλλιπαρθένου δέρης,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1575.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1575.1.text#καὶ δὸς γενέσθαι πλοῦν νεῶν ἀπήμονα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1576.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1576.1.text#Τροίας τε πέργαμ' ἐξελεῖν ἡμᾶς δορί.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1577.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1577.1.text#ἐς γῆν δ' Ἀτρεῖδαι πᾶς στρατός τ' ἔστη βλέπων.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1578.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1578.1.text#[ … ]ἱερεὺς δὲ φάσγανον λαβὼν ἐπεύξατο,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1579.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1579.1.text#λαιμόν τ' ἐπεσκοπεῖθ', ἵνα πλήξειεν ἄν·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1580.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1580.1.text#ἐμοὶ δέ τ' ἄλγος οὐ μικρὸν εἰσῄει φρενί,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1581.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1581.1.text#κἄστην νενευκώς· θαῦμα δ' ἦν αἴφνης ὁρᾶν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1582.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1582.1.text#πληγῆς κτύπον γὰρ πᾶς τις ᾔσθετ' ἂν σαφῶς,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1583.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1583.1.text#τὴν παρθένον δ' οὐκ εἶδεν οὗ γῆς εἰσέδυ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1584.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1584.1.text#βοᾷ δ' ἱερεύς, ἅπας δ' ἐπήχησε στρατός,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1585.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1585.1.text#ἄελπτον εἰσιδόντες ἐκ θεῶν τινος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1586.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1586.1.text#φάσμ', οὗ γε μηδ' ὁρωμένου πίστις παρῆν·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1587.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1587.1.text#ἔλαφος γὰρ ἀσπαίρουσ' ἔκειτ' ἐπὶ χθονὶ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1588.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1588.1.text#ἰδεῖν μεγίστη διαπρεπής τε τὴν θέαν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1589.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1589.1.text#ἧς αἵματι βωμὸς ἐραίνετ' ἄρδην τῆς θεοῦ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1590.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1590.1.text#κἀν τῷδε Κάλχας πῶς δοκεῖς χαίρων ἔφη·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1591.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1591.1.text#Ὦ τοῦδ' Ἀχαιῶν κοίρανοι κοινοῦ στρατοῦ,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1592.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1592.1.text#ὁρᾶτε τήνδε θυσίαν, ἣν ἡ θεὸς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1593.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1593.1.text#προύθηκε βωμίαν, ἔλαφον ὀρειδρόμον;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1594.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1594.1.text#ταύτην μάλιστα τῆς κόρης ἀσπάζεται,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1595.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1595.1.text#ὡς μὴ μιάνῃ βωμὸν εὐγενεῖ φόνῳ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1596.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1596.1.text#ἡδέως τε τοῦτ' ἐδέξατο, καὶ πλοῦν οὔριον
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1597.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1597.1.text#δίδωσιν ἡμῖν Ἰλίου τ' ἐπιδρομάς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1598.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1598.1.text#πρὸς ταῦτα πᾶς τις θάρσος αἶρε ναυβάτης,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1599.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1599.1.text#χώρει τε πρὸς ναῦν· ὡς ἡμέρᾳ τῇδε δεῖ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1600.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1600.1.text#λιπόντας ἡμᾶς Αὐλίδος κοίλους μυχοὺς
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1601.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1601.1.text#Αἴγαιον οἶδμα διαπερᾶν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1601.2.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1601.2.text#ἐπεὶ δ' ἅπαν
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1602.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1602.1.text#κατηνθρακώθη θῦμ' ἐν Ἡφαίστου φλογί,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1603.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1603.1.text#τὰ πρόσφορ' ηὔξαθ', ὡς τύχοι νόστου στρατός.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1604.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1604.1.text#πέμπει δ' Ἀγαμέμνων μ' ὥστε σοι φράσαι τάδε,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1605.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1605.1.text#λέγειν θ' ὁποίας ἐκ θεῶν μοίρας κυρεῖ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1606.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1606.1.text#καὶ δόξαν ἔσχεν ἄφθιτον καθ' Ἑλλάδα.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1607.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1607.1.text#ἐγὼ παρὼν δὲ καὶ τὸ πρᾶγμ' ὁρῶν λέγω·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1608.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1608.1.text#ἡ παῖς σαφῶς σοι πρὸς θεοὺς ἀφίπτατο.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1609.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1609.1.text#λύπης δ' ἀφαίρει καὶ πόσει πάρες χόλον·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1610.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1610.1.text#ἀπροσδόκητα δὲ βροτοῖς τὰ τῶν θεῶν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1611.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1611.1.text#σώζουσί θ' οὓς φιλοῦσιν. ἦμαρ γὰρ τόδε
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1612.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1612.1.text#θανοῦσαν εἶδε καὶ βλέπουσαν παῖδα σήν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1613.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1613.1.text#ὡς ἥδομαί τοι ταῦτ' ἀκούσασ' ἀγγέλου·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1614.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1614.1.text#ζῶν δ' ἐν θεοῖσι σὸν μένειν φράζει τέκος.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1615.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1615.1.text#ὦ παῖ, θεῶν τοῦ κλέμμα γέγονας;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1616.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1616.1.text#πῶς σε προσείπω; πῶς δ' οὐ φῶ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1617.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1617.1.text#παραμυθεῖσθαι τούσδε μάτην μύθους,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1618.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1618.1.text#ὥς σου πένθους λυγροῦ παυσαίμαν;
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1619.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1619.1.text#καὶ μὴν Ἀγαμέμνων ἄναξ στείχει,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1620.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1620.1.text#τούσδ' αὐτοὺς ἔχων σοι φράζειν μύθους.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1621.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1621.1.text#γύναι, θυγατρὸς ἕνεκ' ὄλβιοι γενοίμεθ' ἄν·
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1622.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1622.1.text#ἔχει γὰρ ὄντως ἐν θεοῖς ὁμιλίαν.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1623.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1623.1.text#χρὴ δέ σε λαβοῦσαν τόνδε μόσχον νεαγενῆ
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1624.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1624.1.text#στείχειν πρὸς οἴκους· ὡς στρατὸς πρὸς πλοῦν ὁρᾷ.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1625.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1625.1.text#καὶ χαῖρε· χρόνια γε τἀμά σοι προσφθέγματα
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1626.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1626.1.text#Τροίηθεν ἔσται. καὶ γένοιτό σοι καλῶς.
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1627.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1627.1.text#χαίρων, Ἀτρείδη, γῆν ἱκοῦ Φρυγίαν,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1628.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1628.1.text#χαίρων δ' ἐπάνηκε,
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1629.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg018.fu.sp:1629.1.text#κάλλιστά μοι σκῦλ' ἀπὸ Τροίας ἑλών.
