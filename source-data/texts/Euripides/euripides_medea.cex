#!ctsdata
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1.1.text#Εἴθ' ὤφελ' Ἀργοῦς μὴ διαπτάσθαι σκάφος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:2.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:2.1.text#Κόλχων ἐς αἶαν κυανέας Συμπληγάδας,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:3.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:3.1.text#μηδ' ἐν νάπαισι Πηλίου πεσεῖν ποτε
urn:cts:greekLit:tlg0006.tlg003.fu-sp:4.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:4.1.text#τμηθεῖσα πεύκη, μηδ' ἐρετμῶσαι χέρας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:5.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:5.1.text#ἀνδρῶν ἀρίστων, οἳ τὸ πάγχρυσον δέρας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:6.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:6.1.text#Πελίᾳ μετῆλθον. οὐ γὰρ ἂν δέσποιν' ἐμὴ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:7.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:7.1.text#Μήδεια πύργους γῆς ἔπλευσ' Ἰωλκίας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:8.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:8.1.text#ἔρωτι θυμὸν ἐκπλαγεῖσ' Ἰάσονος·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:9.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:9.1.text#οὐδ' ἂν κτανεῖν πείσασα Πελιάδας κόρας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:10.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:10.1.text#πατέρα κατῴκει τήνδε γῆν Κορινθίαν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:11.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:11.1.text#ξὺν ἀνδρὶ καὶ τέκνοισιν, ἁνδάνουσα μὲν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:12.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:12.1.text#φυγῇ πολιτῶν ὧν ἀφίκετο χθόνα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:13.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:13.1.text#αὐτή τε πάντα ξυμφέρουσ' Ἰάσονι·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:14.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:14.1.text#ἥπερ μεγίστη γίγνεται σωτηρία,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:15.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:15.1.text#ὅταν γυνὴ πρὸς ἄνδρα μὴ διχοστατῇ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:16.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:16.1.text#νῦν δ' ἐχθρὰ πάντα, καὶ νοσεῖ τὰ φίλτατα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:17.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:17.1.text#προδοὺς γὰρ αὑτοῦ τέκνα δεσπότιν τ' ἐμὴν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:18.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:18.1.text#γάμοις Ἰάσων βασιλικοῖς εὐνάζεται,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:19.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:19.1.text#γήμας Κρέοντος παῖδ', ὃς αἰσύμνᾷ χθονός·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:20.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:20.1.text#Μήδεια δ' ἡ δύστηνος ἠτιμασμένη
urn:cts:greekLit:tlg0006.tlg003.fu-sp:21.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:21.1.text#βοᾷ μὲν ὅρκους, ἀνακαλεῖ δὲ δεξιάς,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:22.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:22.1.text#πίστιν μεγίστην, καὶ θεοὺς μαρτύρεται
urn:cts:greekLit:tlg0006.tlg003.fu-sp:23.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:23.1.text#οἵας ἀμοιβῆς ἐξ Ἰάσονος κυρεῖ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:24.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:24.1.text#κεῖται δ' ἄσιτος, σῶμ' ὑφεῖσ' ἀλγηδόσι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:25.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:25.1.text#τὸν πάντα συντήκουσα δακρύοις χρόνον,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:26.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:26.1.text#ἐπεὶ πρὸς ἀνδρὸς ᾔσθετ' ἠδικημένη,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:27.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:27.1.text#οὔτ' ὄμμ' ἐπαίρουσ' οὔτ' ἀπαλλάσσουσα γῆς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:28.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:28.1.text#πρόσωπον· ὡς δὲ πέτρος ἢ θαλάσσιος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:29.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:29.1.text#κλύδων ἀκούει νουθετουμένη φίλων·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:30.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:30.1.text#ἢν μή ποτε στρέψασα πάλλευκον δέρην
urn:cts:greekLit:tlg0006.tlg003.fu-sp:31.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:31.1.text#αὐτὴ πρὸς αὑτὴν πατέρ' ἀποιμώξῃ φίλον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:32.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:32.1.text#καὶ γαῖαν οἴκους θ', οὓς προδοῦσ' ἀφίκετο
urn:cts:greekLit:tlg0006.tlg003.fu-sp:33.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:33.1.text#μετ' ἀνδρὸς ὅς σφε νῦν ἀτιμάσας ἔχει.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:34.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:34.1.text#ἔγνωκε δ' ἡ τάλαινα συμφορᾶς ὕπο
urn:cts:greekLit:tlg0006.tlg003.fu-sp:35.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:35.1.text#οἷον πατρῴας μὴ ἀπολείπεσθαι χθονός.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:36.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:36.1.text#στυγεῖ δὲ παῖδας οὐδ' ὁρῶσ' εὐφραίνεται.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:37.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:37.1.text#δέδοικα δ' αὐτὴν μή τι βουλεύσῃ νέον·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:38.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:38.1.text#βαρεῖα γὰρ φρήν, οὐδ' ἀνέξεται κακῶς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:39.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:39.1.text#πάσχουσ'· ἐγᾦδα τήνδε, δειμαίνω τέ νιν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:40.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:40.1.text#μὴ θηκτὸν ὤσῃ φάσγανον δι' ἥπατος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:41.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:41.1.text#σιγῇ δόμους εἰσβᾶσ', ἵν' ἔστρωται λέχος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:42.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:42.1.text#ἢ καὶ τύραννον τόν τε γήμαντα κτάνῃ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:43.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:43.1.text#κἄπειτα μείζω συμφορὰν λάβῃ τινά.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:44.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:44.1.text#δεινὴ γάρ· οὔτοι ῥᾳδίως γε συμβαλὼν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:45.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:45.1.text#ἔχθραν τις αὐτῇ καλλίνικον οἴσεται.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:46.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:46.1.text#ἀλλ' οἵδε παῖδες ἐκ τρόχων πεπαυμένοι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:47.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:47.1.text#στείχουσι, μητρὸς οὐδὲν ἐννοούμενοι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:48.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:48.1.text#κακῶν· νέα γὰρ φροντὶς οὐκ ἀλγεῖν φιλεῖ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:49.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:49.1.text#παλαιὸν οἴκων κτῆμα δεσποίνης ἐμῆς,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:50.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:50.1.text#τί πρὸς πύλαισι τήνδ' ἄγουσ' ἐρημίαν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:51.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:51.1.text#ἕστηκας, αὐτὴ θρεομένη σαυτῇ κακά;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:52.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:52.1.text#πῶς σοῦ μόνη Μήδεια λείπεσθαι θέλει;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:53.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:53.1.text#τέκνων ὀπαδὲ πρέσβυ τῶν Ἰάσονος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:54.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:54.1.text#χρηστοῖσι δούλοις ξυμφορὰ τὰ δεσποτῶν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:55.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:55.1.text#κακῶς πίτνοντα, καὶ φρενῶν ἀνθάπτεται.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:56.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:56.1.text#ἐγὼ γὰρ ἐς τοῦτ' ἐκβέβηκ' ἀλγηδόνος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:57.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:57.1.text#ὥσθ' ἵμερός μ' ὑπῆλθε γῇ τε κοὐρανῷ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:58.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:58.1.text#λέξαι μολούσῃ δεῦρο δεσποίνης τύχας.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:59.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:59.1.text#οὔπω γὰρ ἡ τάλαινα παύεται γόων;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:60.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:60.1.text#ζηλῶ σ'· ἐν ἀρχῇ πῆμα κοὐδέπω μεσοῖ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:61.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:61.1.text#ὦ  μῶρος—εἰ χρὴ δεσπότας εἰπεῖν τόδε·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:62.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:62.1.text#ὡς οὐδὲν οἶδε τῶν νεωτέρων κακῶν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:63.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:63.1.text#τί δ' ἔστιν, ὦ γεραιέ; μὴ φθόνει φράσαι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:64.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:64.1.text#οὐδέν· μετέγνων καὶ τὰ πρόσθ' εἰρημένα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:65.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:65.1.text#μή, πρὸς γενείου, κρύπτε σύνδουλον σέθεν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:66.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:66.1.text#σιγὴν γάρ, εἰ χρή, τῶνδε θήσομαι πέρι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:67.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:67.1.text#ἤκουσά του λέγοντος, οὐ δοκῶν κλύειν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:68.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:68.1.text#πεσσοὺς προσελθών, ἔνθα δὴ παλαίτατοι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:69.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:69.1.text#θάσσουσι, σεμνὸν ἀμφὶ Πειρήνης ὕδωρ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:70.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:70.1.text#ὡς τούσδε παῖδας γῆς ἐλᾶν Κορινθίας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:71.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:71.1.text#σὺν μητρὶ μέλλοι τῆσδε κοίρανος χθονὸς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:72.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:72.1.text#Κρέων. ὁ μέντοι μῦθος εἰ σαφὴς ὅδε
urn:cts:greekLit:tlg0006.tlg003.fu-sp:73.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:73.1.text#οὐκ οἶδα· βουλοίμην δ' ἂν οὐκ εἶναι τόδε.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:74.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:74.1.text#καὶ ταῦτ' Ἰάσων παῖδας ἐξανέξεται
urn:cts:greekLit:tlg0006.tlg003.fu-sp:75.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:75.1.text#πάσχοντας, εἰ καὶ μητρὶ διαφορὰν ἔχει;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:76.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:76.1.text#παλαιὰ καινῶν λείπεται κηδευμάτων,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:77.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:77.1.text#κοὐκ ἔστ' ἐκεῖνος τοῖσδε δώμασιν φίλος.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:78.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:78.1.text#ἀπωλόμεσθ' ἄρ', εἰ κακὸν προσοίσομεν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:79.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:79.1.text#νέον παλαιῷ, πρὶν τόδ' ἐξηντληκέναι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:80.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:80.1.text#ἀτὰρ σύ γ'—οὐ γὰρ καιρὸς εἰδέναι τόδε
urn:cts:greekLit:tlg0006.tlg003.fu-sp:81.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:81.1.text#δέσποιναν—ἡσύχαζε καὶ σίγα λόγον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:82.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:82.1.text#ὦ τέκν', ἀκούεθ' οἷος εἰς ὑμᾶς πατήρ;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:83.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:83.1.text#ὄλοιτο μὲν μή· δεσπότης γάρ ἐστ' ἐμός·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:84.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:84.1.text#ἀτὰρ κακός γ' ὢν ἐς φίλους ἁλίσκεται.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:85.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:85.1.text#τίς δ' οὐχὶ θνητῶν; ἄρτι γιγνώσκεις τόδε,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:86.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:86.1.text#ὡς πᾶς τις αὑτὸν τοῦ πέλας μᾶλλον φιλεῖ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:87.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:87.1.text#οἳ μὲν δικαίως, οἳ δὲ καὶ κέρδους χάριν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:88.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:88.1.text#εἰ τούσδε γ' εὐνῆς οὕνεκ' οὐ στέργει πατήρ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:89.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:89.1.text#ἴτ'—εὖ γὰρ ἔσται—δωμάτων ἔσω, τέκνα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:90.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:90.1.text#σὺ δ' ὡς μάλιστα τούσδ' ἐρημώσας ἔχε
urn:cts:greekLit:tlg0006.tlg003.fu-sp:91.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:91.1.text#καὶ μὴ πέλαζε μητρὶ δυσθυμουμένῃ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:92.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:92.1.text#ἤδη γὰρ εἶδον ὄμμα νιν ταυρουμένην
urn:cts:greekLit:tlg0006.tlg003.fu-sp:93.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:93.1.text#τοῖσδ', ὥς τι δρασείουσαν· οὐδὲ παύσεται
urn:cts:greekLit:tlg0006.tlg003.fu-sp:94.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:94.1.text#χόλου, σάφ' οἶδα, πρὶν κατασκῆψαί τινα . . .
urn:cts:greekLit:tlg0006.tlg003.fu-sp:95.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:95.1.text#ἐχθρούς γε μέντοι, μὴ φίλους, δράσειέ τι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:96.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:96.1.text#ἰώ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:96.2.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:96.2.text#δύστανος ἐγὼ μελέα τε πόνων,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:97.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:97.1.text#ἰώ μοί μοι, πῶς ἂν ὀλοίμαν;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:98.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:98.1.text#τόδ' ἐκεῖνο, φίλοι παῖδες· μήτηρ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:99.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:99.1.text#κινεῖ κραδίαν, κινεῖ δὲ χόλον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:100.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:100.1.text#σπεύσατε θᾶσσον δώματος εἴσω
urn:cts:greekLit:tlg0006.tlg003.fu-sp:101.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:101.1.text#καὶ μὴ πελάσητ' ὄμματος ἐγγύς,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:102.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:102.1.text#μηδὲ προσέλθητ', ἀλλὰ φυλάσσεσθ'
urn:cts:greekLit:tlg0006.tlg003.fu-sp:103.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:103.1.text#ἄγριον ἦθος στυγεράν τε φύσιν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:104.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:104.1.text#φρενὸς αὐθάδους.—
urn:cts:greekLit:tlg0006.tlg003.fu-sp:105.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:105.1.text#ἴτε νῦν, χωρεῖθ' ὡς τάχος εἴσω.—
urn:cts:greekLit:tlg0006.tlg003.fu-sp:106.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:106.1.text#δῆλον δ' ἀρχῆς ἐξαιρόμενον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:107.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:107.1.text#νέφος οἰμωγῆς ὡς τάχ' ἀνάψει
urn:cts:greekLit:tlg0006.tlg003.fu-sp:108.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:108.1.text#μείζονι θυμῷ· τί ποτ' ἐργάσεται
urn:cts:greekLit:tlg0006.tlg003.fu-sp:109.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:109.1.text#μεγαλόσπλαγχνος δυσκατάπαυστος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:110.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:110.1.text#ψυχὴ δηχθεῖσα κακοῖσιν;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:111.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:111.1.text#αἰαῖ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:111.2.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:111.2.text#ἔπαθον τλάμων ἔπαθον μεγάλων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:112.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:112.1.text#ἄξι' ὀδυρμῶν· ὦ κατάρατοι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:113.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:113.1.text#παῖδες ὄλοισθε στυγερᾶς ματρὸς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:114.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:114.1.text#σὺν πατρί, καὶ πᾶς δόμος ἔρροι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:115.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:115.1.text#ἰώ μοί μοι, ἰὼ τλήμων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:116.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:116.1.text#τί δέ σοι παῖδες πατρὸς ἀμπλακίας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:117.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:117.1.text#μετέχουσι; τί τούσδ' ἔχθεις; οἴμοι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:118.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:118.1.text#τέκνα, μή τι πάθηθ' ὡς ὑπεραλγῶ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:119.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:119.1.text#δεινὰ τυράννων λήματα καί πως
urn:cts:greekLit:tlg0006.tlg003.fu-sp:120.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:120.1.text#ὀλίγ' ἀρχόμενοι, πολλὰ κρατοῦντες
urn:cts:greekLit:tlg0006.tlg003.fu-sp:121.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:121.1.text#χαλεπῶς ὀργὰς μεταβάλλουσιν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:122.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:122.1.text#τὸ γὰρ εἰθίσθαι ζῆν ἐπ' ἴσοισιν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:123.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:123.1.text#κρεῖσσον· ἐμοὶ γοῦν ἐν μὴ μεγάλοις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:124.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:124.1.text#ὀχυρῶς γ' εἴη καταγηράσκειν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:125.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:125.1.text#τῶν γὰρ μετρίων πρῶτα μὲν εἰπεῖν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:126.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:126.1.text#τοὔνομα νικᾷ, χρῆσθαί τε μακρῷ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:127.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:127.1.text#λῷστα βροτοῖσιν· τὰ δ' ὑπερβάλλοντ'
urn:cts:greekLit:tlg0006.tlg003.fu-sp:128.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:128.1.text#οὐδένα καιρὸν δύναται θνητοῖς·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:129.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:129.1.text#μείζους δ' ἄτας, ὅταν ὀργισθῇ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:130.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:130.1.text#δαίμων οἴκοις, ἀπέδωκεν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:131.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:131.1.text#ἔκλυον φωνάν, ἔκλυον δὲ βοὰν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:132.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:132.1.text#τᾶς δυστάνου Κολχίδος, οὐδέ πω
urn:cts:greekLit:tlg0006.tlg003.fu-sp:133.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:133.1.text#ἤπιος· ἀλλ' ὦ γηραιά,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:134.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:134.1.text#λέξον· ἐπ' ἀμφιπύλου γὰρ ἔσω μελάθρου βοὰν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:135.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:135.1.text#ἔκλυον· οὐδὲ συνήδομαι, ὦ γύναι, ἄλγεσιν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:136.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:136.1.text#δώματος· ἐπεί μοι φίλον κέκρανται.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:139.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:139.1.text#οὐκ εἰσὶ δόμοι· φροῦδα τάδ' ἤδη.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:140.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:140.1.text#τὸν μὲν γὰρ ἔχει λέκτρα τυράννων,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:141.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:141.1.text#ἃ δ' ἐν θαλάμοις τάκει βιοτὰν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:142.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:142.1.text#δέσποινα, φίλων οὐδενὸς οὐδὲν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:143.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:143.1.text#παραθαλπομένα φρένα μύθοις.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:144.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:144.1.text#αἰαῖ· { ὦ Ζεῦ καὶ Γᾶ καὶ Φῶς· }
urn:cts:greekLit:tlg0006.tlg003.fu-sp:144a.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:144a.1.text#διά μου κεφαλᾶς φλὸξ οὐρανία
urn:cts:greekLit:tlg0006.tlg003.fu-sp:145.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:145.1.text#βαίη· τί δέ μοι ζῆν ἔτι κέρδος;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:146.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:146.1.text#φεῦ φεῦ· θανάτῳ καταλυσαίμαν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:147.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:147.1.text#βιοτὰν στυγερὰν προλιποῦσα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:148.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:148.1.text#—ἄιες· ὦ Ζεῦ καὶ γᾶ καὶ φῶς·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:149.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:149.1.text#ἀχὰν οἵαν ἁ δύστανος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:150.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:150.1.text#μέλπει νύμφα;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:151.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:151.1.text#—τίς σοί ποτε τᾶς ἀπλάτου
urn:cts:greekLit:tlg0006.tlg003.fu-sp:152.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:152.1.text#κοίτας ἔρος, ὦ ματαία;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:153.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:153.1.text#σπεύσει θανάτου τελευτά·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:154.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:154.1.text#μηδὲν τόδε λίσσου.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:155.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:155.1.text#—εἰ δὲ σὸς πόσις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:156.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:156.1.text#καινὰ λέχη σεβίζει,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:157.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:157.1.text#κείνῳ τόδε· μὴ χαράσσου·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:158.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:158.1.text#—Ζεύς σοι τάδε συνδικήσει. μὴ λίαν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:159.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:159.1.text#τάκου δυρομένα σὸν εὐνάταν.[ … ]
urn:cts:greekLit:tlg0006.tlg003.fu-sp:160.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:160.1.text#ὦ μεγάλα Θέμι καὶ πότνι' Ἄρτεμι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:161.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:161.1.text#λεύσσεθ' ἃ πάσχω, μεγάλοις ὅρκοις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:162.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:162.1.text#ἐνδησαμένα τὸν κατάρατον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:163.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:163.1.text#πόσιν; ὅν ποτ' ἐγὼ νύμφαν τ' ἐσίδοιμ'
urn:cts:greekLit:tlg0006.tlg003.fu-sp:164.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:164.1.text#αὐτοῖς μελάθροις διακναιομένους,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:165.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:165.1.text#οἷ' ἐμὲ πρόσθεν τολμῶσ' ἀδικεῖν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:166.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:166.1.text#ὦ πάτερ, ὦ πόλις, ὧν ἀπενάσθην
urn:cts:greekLit:tlg0006.tlg003.fu-sp:167.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:167.1.text#αἰσχρῶς τὸν ἐμὸν κτείνασα κάσιν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:168.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:168.1.text#κλύεθ' οἷα λέγει κἀπιβοᾶται
urn:cts:greekLit:tlg0006.tlg003.fu-sp:169.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:169.1.text#Θέμιν εὐκταίαν Ζῆνά θ', ὃς ὅρκων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:170.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:170.1.text#θνητοῖς ταμίας νενόμισται;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:171.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:171.1.text#οὐκ ἔστιν ὅπως ἔν τινι μικρῷ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:172.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:172.1.text#δέσποινα χόλον καταπαύσει.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:173.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:173.1.text#—πῶς ἂν ἐς ὄψιν τὰν ἁμετέραν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:174.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:174.1.text#ἔλθοι μύθων τ' αὐδαθέντων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:175.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:175.1.text#δέξαιτ' ὀμφάν;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:176.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:176.1.text#—εἴ πως βαρύθυμον ὀργὰν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:177.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:177.1.text#καὶ λῆμα φρενῶν μεθείη,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:178.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:178.1.text#μήτοι τό γ' ἐμὸν πρόθυμον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:179.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:179.1.text#φίλοισιν ἀπέστω.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:180.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:180.1.text#—ἀλλὰ βᾶσά νιν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:181.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:181.1.text#δεῦρο πόρευσον οἴκων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:182.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:182.1.text#ἔξω· φίλα καὶ τάδ' αὔδα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:183.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:183.1.text#—{ σπεῦσον πρίν τι } κακῶσαι τοὺς εἴσω·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:183a.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:183a.1.text#πένθος γὰρ μεγάλως τόδ' ὁρμᾶται.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:184.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:184.1.text#δράσω τάδ'· ἀτὰρ φόβος εἰ πείσω
urn:cts:greekLit:tlg0006.tlg003.fu-sp:185.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:185.1.text#δέσποιναν ἐμήν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:186.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:186.1.text#μόχθου δὲ χάριν τήνδ' ἐπιδώσω.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:187.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:187.1.text#καίτοι τοκάδος δέργμα λεαίνης
urn:cts:greekLit:tlg0006.tlg003.fu-sp:188.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:188.1.text#ἀποταυροῦται δμωσίν, ὅταν τις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:189.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:189.1.text#μῦθον προφέρων πέλας ὁρμηθῇ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:190.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:190.1.text#σκαιοὺς δὲ λέγων κοὐδέν τι σοφοὺς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:191.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:191.1.text#τοὺς πρόσθε βροτοὺς οὐκ ἂν ἁμάρτοις,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:192.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:192.1.text#οἵτινες ὕμνους ἐπὶ μὲν θαλίαις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:193.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:193.1.text#ἐπί τ' εἰλαπίναις καὶ παρὰ δείπνοις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:194.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:194.1.text#ηὕροντο βίου τερπνὰς ἀκοάς·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:195.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:195.1.text#στυγίους δὲ βροτῶν οὐδεὶς λύπας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:196.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:196.1.text#ηὕρετο μούσῃ καὶ πολυχόρδοις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:197.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:197.1.text#ᾠδαῖς παύειν, ἐξ ὧν θάνατοι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:198.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:198.1.text#δειναί τε τύχαι σφάλλουσι δόμους.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:199.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:199.1.text#καίτοι τάδε μὲν κέρδος ἀκεῖσθαι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:200.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:200.1.text#μολπαῖσι βροτούς· ἵνα δ' εὔδειπνοι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:201.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:201.1.text#δαῖτες, τί μάτην τείνουσι βοήν;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:202.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:202.1.text#τὸ παρὸν γὰρ ἔχει τέρψιν ἀφ' αὑτοῦ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:203.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:203.1.text#δαιτὸς πλήρωμα βροτοῖσιν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:204.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:204.1.text#ἰαχὰν ἄιον πολύστονον γόων,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:205.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:205.1.text#λιγυρὰ δ' ἄχεα μογερὰ βοᾷ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:206.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:206.1.text#τὸν ἐν λέχει προδόταν κακόνυμφον·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:207.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:207.1.text#θεοκλυτεῖ δ' ἄδικα παθοῦσα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:208.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:208.1.text#τὰν Ζηνὸς ὁρκίαν Θέμιν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:209.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:209.1.text#ἅ νιν ἔβασεν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:210.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:210.1.text#Ἑλλάδ' ἐς ἀντίπορον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:211.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:211.1.text#δι' ἅλα νύχιον ἐφ' ἁλμυρὰν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:212.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:212.1.text#πόντου κλῇδ' ἀπέραντον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:214.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:214.1.text#Κορίνθιαι γυναῖκες, ἐξῆλθον δόμων,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:215.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:215.1.text#μή μοί τι μέμφησθ'· οἶδα γὰρ πολλοὺς βροτῶν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:216.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:216.1.text#σεμνοὺς γεγῶτας, τοὺς μὲν ὀμμάτων ἄπο,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:217.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:217.1.text#τοὺς δ' ἐν θυραίοις· οἱ δ' ἀφ' ἡσύχου ποδὸς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:218.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:218.1.text#δύσκλειαν ἐκτήσαντο καὶ ῥᾳθυμίαν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:219.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:219.1.text#δίκη γὰρ οὐκ ἔνεστ' ἐν ὀφθαλμοῖς βροτῶν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:220.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:220.1.text#ὅστις πρὶν ἀνδρὸς σπλάγχνον ἐκμαθεῖν σαφῶς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:221.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:221.1.text#στυγεῖ δεδορκώς, οὐδὲν ἠδικημένος. . . .
urn:cts:greekLit:tlg0006.tlg003.fu-sp:222.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:222.1.text#χρὴ δὲ ξένον μὲν κάρτα προσχωρεῖν πόλει . . .
urn:cts:greekLit:tlg0006.tlg003.fu-sp:223.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:223.1.text#οὐδ' ἀστὸν ᾔνεσ' ὅστις αὐθάδης γεγὼς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:224.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:224.1.text#πικρὸς πολίταις ἐστὶν ἀμαθίας ὕπο.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:225.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:225.1.text#ἐμοὶ δ' ἄελπτον πρᾶγμα προσπεσὸν τόδε
urn:cts:greekLit:tlg0006.tlg003.fu-sp:226.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:226.1.text#ψυχὴν διέφθαρκ'· οἴχομαι δὲ καὶ βίου
urn:cts:greekLit:tlg0006.tlg003.fu-sp:227.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:227.1.text#χάριν μεθεῖσα κατθανεῖν χρῄζω, φίλαι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:228.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:228.1.text#ἐν ᾧ γὰρ ἦν μοι πάντα γιγνώσκειν καλῶς,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:229.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:229.1.text#κάκιστος ἀνδρῶν ἐκβέβηχ' οὑμὸς πόσις.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:230.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:230.1.text#πάντων δ' ὅσ' ἔστ' ἔμψυχα καὶ γνώμην ἔχει
urn:cts:greekLit:tlg0006.tlg003.fu-sp:231.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:231.1.text#γυναῖκές ἐσμεν ἀθλιώτατον φυτόν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:232.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:232.1.text#ἃς πρῶτα μὲν δεῖ χρημάτων ὑπερβολῇ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:233.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:233.1.text#πόσιν πρίασθαι, δεσπότην τε σώματος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:234.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:234.1.text#λαβεῖν· κακοῦ γὰρ τοῦτ' ἔτ' ἄλγιον κακόν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:235.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:235.1.text#κἀν τῷδ' ἀγὼν μέγιστος, ἢ κακὸν λαβεῖν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:236.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:236.1.text#ἢ χρηστόν. οὐ γὰρ εὐκλεεῖς ἀπαλλαγαὶ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:237.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:237.1.text#γυναιξίν, οὐδ' οἷόν τ' ἀνήνασθαι πόσιν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:238.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:238.1.text#ἐς καινὰ δ' ἤθη καὶ νόμους ἀφιγμένην
urn:cts:greekLit:tlg0006.tlg003.fu-sp:239.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:239.1.text#δεῖ μάντιν εἶναι, μὴ μαθοῦσαν οἴκοθεν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:240.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:240.1.text#ὅτῳ μάλιστα χρήσεται ξυνευνέτῃ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:241.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:241.1.text#κἂν μὲν τάδ' ἡμῖν ἐκπονουμέναισιν εὖ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:242.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:242.1.text#πόσις ξυνοικῇ μὴ βίᾳ φέρων ζυγόν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:243.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:243.1.text#ζηλωτὸς αἰών· εἰ δὲ μή, θανεῖν χρεών.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:244.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:244.1.text#ἀνὴρ δ', ὅταν τοῖς ἔνδον ἄχθηται ξυνών,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:245.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:245.1.text#ἔξω μολὼν ἔπαυσε καρδίαν ἄσης·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:246.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:246.1.text#[ ἢ πρὸς φίλον τιν' ἢ πρὸς ἥλικα τραπείς· ]
urn:cts:greekLit:tlg0006.tlg003.fu-sp:247.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:247.1.text#ἡμῖν δ' ἀνάγκη πρὸς μίαν ψυχὴν βλέπειν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:248.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:248.1.text#λέγουσι δ' ἡμᾶς ὡς ἀκίνδυνον βίον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:249.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:249.1.text#ζῶμεν κατ' οἴκους, οἳ δὲ μάρνανται δορί·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:250.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:250.1.text#κακῶς φρονοῦντες· ὡς τρὶς ἂν παρ' ἀσπίδα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:251.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:251.1.text#στῆναι θέλοιμ' ἂν μᾶλλον ἢ τεκεῖν ἅπαξ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:252.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:252.1.text#ἀλλ' οὐ γὰρ αὑτὸς πρὸς σὲ κἄμ' ἥκει λόγος·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:253.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:253.1.text#σοὶ μὲν πόλις θ' ἥδ' ἐστὶ καὶ πατρὸς δόμοι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:254.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:254.1.text#βίου τ' ὄνησις καὶ φίλων συνουσία,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:255.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:255.1.text#ἐγὼ δ' ἔρημος ἄπολις οὖσ' ὑβρίζομαι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:256.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:256.1.text#πρὸς ἀνδρός, ἐκ γῆς βαρβάρου λελῃσμένη,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:257.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:257.1.text#οὐ μητέρ', οὐκ ἀδελφόν, οὐχὶ συγγενῆ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:258.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:258.1.text#μεθορμίσασθαι τῆσδ' ἔχουσα συμφορᾶς.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:259.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:259.1.text#τοσοῦτον οὖν σου τυγχάνειν βουλήσομαι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:260.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:260.1.text#ἤν μοι πόρος τις μηχανή τ' ἐξευρεθῇ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:261.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:261.1.text#πόσιν δίκην τῶνδ' ἀντιτείσασθαι κακῶν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:262.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:262.1.text#[ τὸν δόντα τ' αὐτῷ θυγατέρ' ἥ τ' ἐγήματο ]
urn:cts:greekLit:tlg0006.tlg003.fu-sp:263.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:263.1.text#σιγᾶν. γυνὴ γὰρ τἄλλα μὲν φόβου πλέα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:264.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:264.1.text#κακή τ' ἐς ἀλκὴν καὶ σίδηρον εἰσορᾶν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:265.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:265.1.text#ὅταν δ' ἐς εὐνὴν ἠδικημένη κυρῇ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:266.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:266.1.text#οὐκ ἔστιν ἄλλη φρὴν μιαιφονωτέρα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:267.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:267.1.text#δράσω τάδ'· ἐνδίκως γὰρ ἐκτείσῃ πόσιν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:268.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:268.1.text#Μήδεια. πενθεῖν δ' οὔ σε θαυμάζω τύχας.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:269.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:269.1.text#ὁρῶ δὲ καὶ Κρέοντα, τῆσδ' ἄνακτα γῆς,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:270.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:270.1.text#στείχοντα, καινῶν ἄγγελον βουλευμάτων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:271.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:271.1.text#σὲ τὴν σκυθρωπὸν καὶ πόσει θυμουμένην,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:272.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:272.1.text#Μήδειαν, εἶπον τῆσδε γῆς ἔξω περᾶν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:273.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:273.1.text#φυγάδα, λαβοῦσαν δισσὰ σὺν σαυτῇ τέκνα·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:274.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:274.1.text#καὶ μή τι μέλλειν· ὡς ἐγὼ βραβεὺς λόγου
urn:cts:greekLit:tlg0006.tlg003.fu-sp:275.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:275.1.text#τοῦδ' εἰμί, κοὐκ ἄπειμι πρὸς δόμους πάλιν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:276.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:276.1.text#πρὶν ἄν σε γαίας τερμόνων ἔξω βάλω.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:277.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:277.1.text#αἰαῖ· πανώλης ἡ τάλαιν' ἀπόλλυμαι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:278.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:278.1.text#ἐχθροὶ γὰρ ἐξιᾶσι πάντα δὴ κάλων,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:279.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:279.1.text#κοὐκ ἔστιν ἄτης εὐπρόσοιστος ἔκβασις.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:280.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:280.1.text#ἐρήσομαι δὲ καὶ κακῶς πάσχουσ' ὅμως·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:281.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:281.1.text#τίνος μ' ἕκατι γῆς ἀποστέλλεις, Κρέον;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:282.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:282.1.text#δέδοικά σ'—οὐδὲν δεῖ παραμπίσχειν λόγους—
urn:cts:greekLit:tlg0006.tlg003.fu-sp:283.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:283.1.text#μή μοί τι δράσῃς παῖδ' ἀνήκεστον κακόν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:284.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:284.1.text#συμβάλλεται δὲ πολλὰ τοῦδε δείματος·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:285.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:285.1.text#σοφὴ πέφυκας καὶ κακῶν πολλῶν ἴδρις,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:286.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:286.1.text#λυπῇ δὲ λέκτρων ἀνδρὸς ἐστερημένη.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:287.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:287.1.text#κλύω δ' ἀπειλεῖν σ', ὡς ἀπαγγέλλουσί μοι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:288.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:288.1.text#τὸν δόντα καὶ γήμαντα καὶ γαμουμένην
urn:cts:greekLit:tlg0006.tlg003.fu-sp:289.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:289.1.text#δράσειν τι. ταῦτ' οὖν πρὶν παθεῖν φυλάξομαι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:290.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:290.1.text#κρεῖσσον δέ μοι νῦν πρός σ' ἀπεχθέσθαι, γύναι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:291.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:291.1.text#ἢ μαλθακισθένθ' ὕστερον μέγα στένειν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:292.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:292.1.text#φεῦ φεῦ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:292.2.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:292.2.text#οὐ νῦν με πρῶτον, ἀλλὰ πολλάκις, Κρέον,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:293.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:293.1.text#ἔβλαψε δόξα μεγάλα τ' εἴργασται κακά.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:294.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:294.1.text#χρὴ δ' οὔποθ' ὅστις ἀρτίφρων πέφυκ' ἀνὴρ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:295.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:295.1.text#παῖδας περισσῶς ἐκδιδάσκεσθαι σοφούς·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:296.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:296.1.text#χωρὶς γὰρ ἄλλης ἧς ἔχουσιν ἀργίας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:297.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:297.1.text#φθόνον πρὸς ἀστῶν ἀλφάνουσι δυσμενῆ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:298.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:298.1.text#σκαιοῖσι μὲν γὰρ καινὰ προσφέρων σοφὰ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:299.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:299.1.text#δόξεις ἀχρεῖος κοὐ σοφὸς πεφυκέναι·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:300.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:300.1.text#τῶν δ' αὖ δοκούντων εἰδέναι τι ποικίλον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:301.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:301.1.text#κρείσσων νομισθεὶς ἐν πόλει λυπρὸς φανῇ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:302.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:302.1.text#ἐγὼ δὲ καὐτὴ τῆσδε κοινωνῶ τύχης.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:303.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:303.1.text#σοφὴ γὰρ οὖσα, τοῖς μέν εἰμ' ἐπίφθονος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:304.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:304.1.text#τοῖς δ' ἡσυχαία, τοῖς δὲ θατέρου τρόπου,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:305.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:305.1.text#τοῖς δ' αὖ προσάντης· εἰμὶ δ' οὐκ ἄγαν σοφή.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:306.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:306.1.text#σὺ δ' οὖν φοβῇ με· μὴ τί πλημμελὲς πάθῃς;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:307.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:307.1.text#οὐχ ὧδ' ἔχει μοι—μὴ τρέσῃς ἡμᾶς, Κρέον—
urn:cts:greekLit:tlg0006.tlg003.fu-sp:308.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:308.1.text#ὥστ' ἐς τυράννους ἄνδρας ἐξαμαρτάνειν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:309.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:309.1.text#σὺ γὰρ τί μ' ἠδίκηκας; ἐξέδου κόρην
urn:cts:greekLit:tlg0006.tlg003.fu-sp:310.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:310.1.text#ὅτῳ σε θυμὸς ἦγεν. ἀλλ' ἐμὸν πόσιν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:311.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:311.1.text#μισῶ· σὺ δ', οἶμαι, σωφρονῶν ἔδρας τάδε.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:312.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:312.1.text#καὶ νῦν τὸ μὲν σὸν οὐ φθονῶ καλῶς ἔχειν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:313.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:313.1.text#νυμφεύετ', εὖ πράσσοιτε· τήνδε δὲ χθόνα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:314.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:314.1.text#ἐᾶτέ μ' οἰκεῖν. καὶ γὰρ ἠδικημένοι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:315.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:315.1.text#σιγησόμεσθα, κρεισσόνων νικώμενοι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:316.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:316.1.text#λέγεις ἀκοῦσαι μαλθάκ', ἀλλ' ἔσω φρενῶν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:317.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:317.1.text#ὀρρωδία μοι μή τι βουλεύσῃς κακόν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:318.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:318.1.text#τόσῳ δέ γ' ἧσσον ἢ πάρος πέποιθά σοι·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:319.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:319.1.text#γυνὴ γὰρ ὀξύθυμος, ὡς δ' αὔτως ἀνήρ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:320.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:320.1.text#ῥᾴων φυλάσσειν ἢ σιωπηλὸς σοφός.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:321.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:321.1.text#ἀλλ' ἔξιθ' ὡς τάχιστα, μὴ λόγους λέγε·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:322.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:322.1.text#ὡς ταῦτ' ἄραρε, κοὐκ ἔχεις τέχνην ὅπως
urn:cts:greekLit:tlg0006.tlg003.fu-sp:323.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:323.1.text#μενεῖς παρ' ἡμῖν οὖσα δυσμενὴς ἐμοί.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:324.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:324.1.text#μή, πρός σε γονάτων τῆς τε νεογάμου κόρης.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:325.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:325.1.text#λόγους ἀναλοῖς· οὐ γὰρ ἂν πείσαις ποτέ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:326.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:326.1.text#ἀλλ' ἐξελᾷς με κοὐδὲν αἰδέσῃ λιτάς;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:327.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:327.1.text#φιλῶ γὰρ οὐ σὲ μᾶλλον ἢ δόμους ἐμούς.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:328.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:328.1.text#ὦ πατρίς, ὥς σου κάρτα νῦν μνείαν ἔχω.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:329.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:329.1.text#πλὴν γὰρ τέκνων ἔμοιγε φίλτατον πολύ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:330.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:330.1.text#φεῦ φεῦ, βροτοῖς ἔρωτες ὡς κακὸν μέγα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:331.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:331.1.text#ὅπως ἄν, οἶμαι, καὶ παραστῶσιν τύχαι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:332.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:332.1.text#Ζεῦ, μὴ λάθοι σε τῶνδ' ὃς αἴτιος κακῶν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:333.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:333.1.text#ἕρπ', ὦ ματαία, καί μ' ἀπάλλαξον πόνων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:334.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:334.1.text#πονοῦμεν ἡμεῖς κοὐ πόνων κεχρήμεθα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:335.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:335.1.text#τάχ' ἐξ ὀπαδῶν χειρὸς ὠσθήσῃ βίᾳ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:336.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:336.1.text#μὴ δῆτα τοῦτό γ', ἀλλά σ' αἰτοῦμαι, Κρέον . . .
urn:cts:greekLit:tlg0006.tlg003.fu-sp:337.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:337.1.text#ὄχλον παρέξεις, ὡς ἔοικας, ὦ γύναι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:338.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:338.1.text#φευξούμεθ'· οὐ τοῦθ' ἱκέτευσα σοῦ τυχεῖν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:339.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:339.1.text#τί δαὶ βιάζῃ κοὐκ ἀπαλλάσσῃ χερός;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:340.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:340.1.text#μίαν με μεῖναι τήνδ' ἔασον ἡμέραν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:341.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:341.1.text#καὶ ξυμπερᾶναι φροντίδ' ᾗ φευξούμεθα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:342.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:342.1.text#παισίν τ' ἀφορμὴν τοῖς ἐμοῖς, ἐπεὶ πατὴρ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:343.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:343.1.text#οὐδὲν προτιμᾷ μηχανήσασθαι τέκνοις.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:344.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:344.1.text#οἴκτιρε δ' αὐτούς· καὶ σύ τοι παίδων πατὴρ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:345.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:345.1.text#πέφυκας· εἰκὸς δ' ἐστὶν εὔνοιάν σ' ἔχειν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:346.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:346.1.text#τοὐμοῦ γὰρ οὔ μοι φροντίς, εἰ φευξούμεθα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:347.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:347.1.text#κείνους δὲ κλαίω συμφορᾷ κεχρημένους.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:348.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:348.1.text#ἥκιστα τοὐμὸν λῆμ' ἔφυ τυραννικόν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:349.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:349.1.text#αἰδούμενος δὲ πολλὰ δὴ διέφθορα·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:350.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:350.1.text#καὶ νῦν ὁρῶ μὲν ἐξαμαρτάνων, γύναι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:351.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:351.1.text#ὅμως δὲ τεύξῃ τοῦδε· προυννέπω δέ σοι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:352.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:352.1.text#εἴ σ' ἡ 'πιοῦσα λαμπὰς ὄψεται θεοῦ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:353.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:353.1.text#καὶ παῖδας ἐντὸς τῆσδε τερμόνων χθονός,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:354.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:354.1.text#θανῇ· λέλεκται μῦθος ἀψευδὴς ὅδε.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:355.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:355.1.text#νῦν δ', εἰ μένειν δεῖ, μίμν' ἐφ' ἡμέραν μίαν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:356.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:356.1.text#οὐ γάρ τι δράσεις δεινὸν ὧν φόβος μ' ἔχει.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:357.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:357.1.text#[ δύστανε γύναι, ]
urn:cts:greekLit:tlg0006.tlg003.fu-sp:358.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:358.1.text#φεῦ φεῦ, μελέα τῶν σῶν ἀχέων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:359.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:359.1.text#ποῖ ποτε τρέψῃ; τίνα πρὸς ξενίαν;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:360.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:360.1.text#ἦ δόμον ἢ χθόνα σωτῆρα κακῶν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:361.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:361.1.text#ἐξευρήσεις;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:362.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:362.1.text#ὡς εἰς ἄπορόν σε κλύδωνα θεός,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:363.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:363.1.text#Μήδεια, κακῶν ἐπόρευσε.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:364.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:364.1.text#κακῶς πέπρακται πανταχῇ· τίς ἀντερεῖ;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:365.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:365.1.text#ἀλλ' οὔτι ταύτῃ ταῦτα, μὴ δοκεῖτέ πω.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:366.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:366.1.text#ἔτ' εἴσ' ἀγῶνες τοῖς νεωστὶ νυμφίοις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:367.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:367.1.text#καὶ τοῖσι κηδεύσασιν οὐ σμικροὶ πόνοι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:368.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:368.1.text#δοκεῖς γὰρ ἄν με τόνδε θωπεῦσαί ποτε,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:369.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:369.1.text#εἰ μή τι κερδαίνουσαν ἢ τεχνωμένην;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:370.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:370.1.text#οὐδ' ἂν προσεῖπον οὐδ' ἂν ἡψάμην χεροῖν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:371.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:371.1.text#ὃ δ' ἐς τοσοῦτον μωρίας ἀφίκετο,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:372.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:372.1.text#ὥστ' ἐξὸν αὐτῷ τἄμ' ἑλεῖν βουλεύματα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:373.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:373.1.text#γῆς ἐκβαλόντι, τήνδ' ἀφῆκεν ἡμέραν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:374.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:374.1.text#μεῖναί μ', ἐν ᾗ τρεῖς τῶν ἐμῶν ἐχθρῶν νεκροὺς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:375.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:375.1.text#θήσω, πατέρα τε καὶ κόρην πόσιν τ' ἐμόν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:376.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:376.1.text#πολλὰς δ' ἔχουσα θανασίμους αὐτοῖς ὁδούς,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:377.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:377.1.text#οὐκ οἶδ' ὁποίᾳ πρῶτον ἐγχειρῶ, φίλαι·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:378.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:378.1.text#πότερον ὑφάψω δῶμα νυμφικὸν πυρί,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:379.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:379.1.text#ἢ θηκτὸν ὤσω φάσγανον δι' ἥπάτος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:380.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:380.1.text#σιγῇ δόμους ἐσβᾶσ', ἵν' ἔστρωται λέχος.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:381.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:381.1.text#ἀλλ' ἕν τί μοι πρόσαντες· εἰ ληφθήσομαι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:382.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:382.1.text#δόμους ὑπεσβαίνουσα καὶ τεχνωμένη,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:383.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:383.1.text#θανοῦσα θήσω τοῖς ἐμοῖς ἐχθροῖς γέλων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:384.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:384.1.text#κράτιστα τὴν εὐθεῖαν, ᾗ πεφύκαμεν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:385.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:385.1.text#σοφαὶ μάλιστα, φαρμάκοις αὐτοὺς ἑλεῖν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:386.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:386.1.text#εἶἑν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:386.2.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:386.2.text#καὶ δὴ τεθνᾶσι· τίς με δέξεται πόλις;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:387.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:387.1.text#τίς γῆν ἄσυλον καὶ δόμους ἐχεγγύους
urn:cts:greekLit:tlg0006.tlg003.fu-sp:388.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:388.1.text#ξένος παρασχὼν ῥύσεται τοὐμὸν δέμας;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:389.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:389.1.text#οὐκ ἔστι. μείνασ' οὖν ἔτι σμικρὸν χρόνον,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:390.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:390.1.text#ἢν μέν τις ἡμῖν πύργος ἀσφαλὴς φανῇ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:391.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:391.1.text#δόλῳ μέτειμι τόνδε καὶ σιγῇ φόνον·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:392.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:392.1.text#ἢν δ' ἐξελαύνῃ ξυμφορά μ' ἀμήχανος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:393.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:393.1.text#αὐτὴ ξίφος λαβοῦσα, κεἰ μέλλω θανεῖν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:394.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:394.1.text#κτενῶ σφε, τόλμης δ' εἶμι πρὸς τὸ καρτερόν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:395.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:395.1.text#οὐ γὰρ μὰ τὴν δέσποιναν ἣν ἐγὼ σέβω
urn:cts:greekLit:tlg0006.tlg003.fu-sp:396.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:396.1.text#μάλιστα πάντων καὶ ξυνεργὸν εἱλόμην,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:397.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:397.1.text#Ἑκάτην, μυχοῖς ναίουσαν ἑστίας ἐμῆς,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:398.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:398.1.text#χαίρων τις αὐτῶν τοὐμὸν ἀλγυνεῖ κέαρ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:399.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:399.1.text#πικροὺς δ' ἐγώ σφιν καὶ λυγροὺς θήσω γάμους,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:400.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:400.1.text#πικρὸν δὲ κῆδος καὶ φυγὰς ἐμὰς χθονός.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:401.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:401.1.text#ἀλλ' εἶα· φείδου μηδὲν ὧν ἐπίστασαι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:402.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:402.1.text#Μήδεια, βουλεύουσα καὶ τεχνωμένη·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:403.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:403.1.text#ἕρπ' ἐς τὸ δεινόν· νῦν ἀγὼν εὐψυχίας.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:404.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:404.1.text#ὁρᾷς ἃ πάσχεις· οὐ γέλωτα δεῖ σ' ὀφλεῖν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:405.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:405.1.text#τοῖς Σισυφείοις τοῖς τ' Ἰάσονος γάμοις,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:406.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:406.1.text#γεγῶσαν ἐσθλοῦ πατρὸς Ἡλίου τ' ἄπο.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:407.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:407.1.text#ἐπίστασαι δέ· πρὸς δὲ καὶ πεφύκαμεν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:408.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:408.1.text#γυναῖκες, ἐς μὲν ἔσθλ' ἀμηχανώταται,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:409.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:409.1.text#κακῶν δὲ πάντων τέκτονες σοφώταται.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:410.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:410.1.text#ἄνω ποταμῶν ἱερῶν χωροῦσι παγαί,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:411.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:411.1.text#καὶ δίκα καὶ πάντα πάλιν στρέφεται.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:412.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:412.1.text#ἀνδράσι μὲν δόλιαι βουλαί, θεῶν δ'
urn:cts:greekLit:tlg0006.tlg003.fu-sp:414.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:414.1.text#οὐκέτι πίστις ἄραρε·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:415.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:415.1.text#τὰν δ' ἐμὰν εὔκλειαν ἔχειν βιοτὰν στρέψουσι φᾶμαι·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:419.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:419.1.text#ἔρχεται τιμὰ γυναικείῳ γένει·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:420.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:420.1.text#οὐκέτι δυσκέλαδος φάμα γυναῖκας ἕξει.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:421.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:421.1.text#μοῦσαι δὲ παλαιγενέων λήξουσ' ἀοιδῶν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:422.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:422.1.text#τὰν ἐμὰν ὑμνεῦσαι ἀπιστοσύναν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:423.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:423.1.text#οὐ γὰρ ἐν ἁμετέρᾳ γνώμᾳ λύρας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:425.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:425.1.text#ὤπασε θέσπιν ἀοιδὰν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:426.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:426.1.text#Φοῖβος, ἀγήτωρ μελέων· ἐπεὶ ἀντάχησ' ἂν ὕμνον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:427.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:427.1.text#ἀρσένων γέννᾳ. μακρὸς δ' αἰὼν ἔχει
urn:cts:greekLit:tlg0006.tlg003.fu-sp:430.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:430.1.text#πολλὰ μὲν ἁμετέραν ἀνδρῶν τε μοῖραν εἰπεῖν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:431.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:431.1.text#σὺ δ' ἐκ μὲν οἴκων πατρίων ἔπλευσας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:432.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:432.1.text#μαινομένᾳ κραδίᾳ, διδύμους ὁρίσασα πόντου
urn:cts:greekLit:tlg0006.tlg003.fu-sp:433.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:433.1.text#πέτρας· ἐπὶ δὲ ξένᾳ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:435.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:435.1.text#ναίεις χθονί, τᾶς ἀνάνδρου
urn:cts:greekLit:tlg0006.tlg003.fu-sp:436.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:436.1.text#κοίτας ὀλέσασα λέκτρον,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:437.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:437.1.text#τάλαινα, φυγὰς δὲ χώρας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:438.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:438.1.text#ἄτιμος ἐλαύνῃ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:439.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:439.1.text#βέβακε δ' ὅρκων χάρις, οὐδ' ἔτ' αἰδὼς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:440.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:440.1.text#Ἑλλάδι τᾷ μεγάλᾳ μένει, αἰθερία δ' ἀνέπτα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:441.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:441.1.text#σοὶ δ' οὔτε πατρὸς δόμοι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:442.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:442.1.text#δύστανε, μεθορμίσασθαι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:443.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:443.1.text#μόχθων πάρα, τῶν τε λέκτρων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:444.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:444.1.text#ἄλλα βασίλεια κρείσσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:445.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:445.1.text#δόμοισιν ἐπέστα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:446.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:446.1.text#οὐ νῦν κατεῖδον πρῶτον ἀλλὰ πολλάκις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:447.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:447.1.text#τραχεῖαν ὀργὴν ὡς ἀμήχανον κακόν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:448.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:448.1.text#σοὶ γὰρ παρὸν γῆν τήνδε καὶ δόμους ἔχειν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:449.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:449.1.text#κούφως φερούσῃ κρεισσόνων βουλεύματα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:450.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:450.1.text#λόγων ματαίων οὕνεκ' ἐκπεσῇ χθονός.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:451.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:451.1.text#κἀμοὶ μὲν οὐδὲν πρᾶγμα· μὴ παύσῃ ποτὲ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:452.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:452.1.text#λέγουσ' Ἰάσον' ὡς κάκιστός ἐστ' ἀνήρ·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:453.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:453.1.text#ἃ δ' ἐς τυράννους ἐστί σοι λελεγμένα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:454.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:454.1.text#πᾶν κέρδος ἡγοῦ ζημιουμένη φυγῇ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:455.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:455.1.text#κἀγὼ μὲν αἰεὶ βασιλέων θυμουμένων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:456.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:456.1.text#ὀργὰς ἀφῄρουν καί σ' ἐβουλόμην μένειν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:457.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:457.1.text#σὺ δ' οὐκ ἀνίεις μωρίας, λέγουσ' ἀεὶ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:458.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:458.1.text#κακῶς τυράννους· τοιγὰρ ἐκπεσῇ χθονός.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:459.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:459.1.text#ὅμως δὲ κἀκ τῶνδ' οὐκ ἀπειρηκὼς φίλοις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:460.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:460.1.text#ἥκω, τὸ σὸν δὲ προσκοπούμενος, γύναι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:461.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:461.1.text#ὡς μήτ' ἀχρήμων σὺν τέκνοισιν ἐκπέσῃς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:462.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:462.1.text#μήτ' ἐνδεής του· πόλλ' ἐφέλκεται φυγὴ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:463.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:463.1.text#κακὰ ξὺν αὑτῇ. καὶ γὰρ εἰ σύ με στυγεῖς,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:464.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:464.1.text#οὐκ ἂν δυναίμην σοὶ κακῶς φρονεῖν ποτε.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:465.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:465.1.text#ὦ παγκάκιστε, τοῦτο γάρ σ' εἰπεῖν ἔχω,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:466.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:466.1.text#γλώσσῃ μέγιστον εἰς ἀνανδρίαν κακόν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:467.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:467.1.text#ἦλθες πρὸς ἡμᾶς, ἦλθες ἔχθιστος γεγώς;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:468.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:468.1.text#[ θεοῖς τε κἀμοὶ παντί τ' ἀνθρώπων γένει; ]
urn:cts:greekLit:tlg0006.tlg003.fu-sp:469.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:469.1.text#οὔτοι θράσος τόδ' ἐστὶν οὐδ' εὐτολμία,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:470.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:470.1.text#φίλους κακῶς δράσαντ' ἐναντίον βλέπειν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:471.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:471.1.text#ἀλλ' ἡ μεγίστη τῶν ἐν ἀνθρώποις νόσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:472.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:472.1.text#πασῶν, ἀναίδει'· εὖ δ' ἐποίησας μολών·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:473.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:473.1.text#ἐγώ τε γὰρ λέξασα κουφισθήσομαι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:474.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:474.1.text#ψυχὴν κακῶς σε καὶ σὺ λυπήσῃ κλύων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:475.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:475.1.text#ἐκ τῶν δὲ πρώτων πρῶτον ἄρξομαι λέγειν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:476.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:476.1.text#ἔσῳσά σ', ὡς ἴσασιν Ἑλλήνων ὅσοι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:477.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:477.1.text#ταὐτὸν συνεισέβησαν Ἀργῷον σκάφος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:478.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:478.1.text#πεμφθέντα ταύρων πυρπνόων ἐπιστάτην
urn:cts:greekLit:tlg0006.tlg003.fu-sp:479.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:479.1.text#ζεύγλῃσι καὶ σπεροῦντα θανάσιμον γύην·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:480.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:480.1.text#δράκοντά θ', ὃς πάγχρυσον ἀμπέχων δέρας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:481.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:481.1.text#σπείραις ἔσῳζε πολυπλόκοις ἄυπνος ὤν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:482.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:482.1.text#κτείνασ' ἀνέσχον σοὶ φάος σωτήριον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:483.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:483.1.text#αὐτὴ δὲ πατέρα καὶ δόμους προδοῦσ' ἐμοὺς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:484.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:484.1.text#τὴν Πηλιῶτιν εἰς Ἰωλκὸν ἱκόμην
urn:cts:greekLit:tlg0006.tlg003.fu-sp:485.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:485.1.text#σὺν σοί, πρόθυμος μᾶλλον ἢ σοφωτέρα·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:486.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:486.1.text#Πελίαν τ' ἀπέκτειν', ὥσπερ ἄλγιστον θανεῖν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:487.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:487.1.text#παίδων ὑπ' αὐτοῦ, πάντα τ' ἐξεῖλον δόμον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:488.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:488.1.text#καὶ ταῦθ' ὑφ' ἡμῶν, ὦ κάκιστ' ἀνδρῶν, παθὼν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:489.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:489.1.text#προύδωκας ἡμᾶς, καινὰ δ' ἐκτήσω λέχη—
urn:cts:greekLit:tlg0006.tlg003.fu-sp:490.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:490.1.text#παίδων γεγώτων· εἰ γὰρ ἦσθ' ἄπαις ἔτι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:491.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:491.1.text#συγγνώστ' ἂν ἦν σοι τοῦδ' ἐρασθῆναι λέχους.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:492.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:492.1.text#ὅρκων δὲ φρούδη πίστις, οὐδ' ἔχω μαθεῖν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:493.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:493.1.text#ἦ θεοὺς νομίζεις τοὺς τότ' οὐκ ἄρχειν ἔτι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:494.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:494.1.text#ἢ καινὰ κεῖσθαι θέσμι' ἀνθρώποις τὰ νῦν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:495.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:495.1.text#ἐπεὶ σύνοισθά γ' εἰς ἔμ' οὐκ εὔορκος ὤν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:496.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:496.1.text#φεῦ δεξιὰ χείρ, ἧς σὺ πόλλ' ἐλαμβάνου,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:497.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:497.1.text#καὶ τῶνδε γονάτων, ὡς μάτην κεχρῴσμεθα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:498.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:498.1.text#κακοῦ πρὸς ἀνδρός, ἐλπίδων δ' ἡμάρτομεν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:499.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:499.1.text#ἄγ'· ὡς φίλῳ γὰρ ὄντι σοι κοινώσομαι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:500.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:500.1.text#—δοκοῦσα μὲν τί πρός γε σοῦ πράξειν καλῶς;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:501.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:501.1.text#ὅμως δ'· ἐρωτηθεὶς γὰρ αἰσχίων φανῇ—
urn:cts:greekLit:tlg0006.tlg003.fu-sp:502.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:502.1.text#νῦν ποῖ τράπωμαι; πότερα πρὸς πατρὸς δόμους,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:503.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:503.1.text#οὓς σοὶ προδοῦσα καὶ πάτραν ἀφικόμην;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:504.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:504.1.text#ἢ πρὸς ταλαίνας Πελιάδας; καλῶς γ' ἂν οὖν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:505.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:505.1.text#δέξαιντό μ' οἴκοις ὧν πατέρα κατέκτανον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:506.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:506.1.text#ἔχει γὰρ οὕτω· τοῖς μὲν οἴκοθεν φίλοις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:507.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:507.1.text#ἐχθρὰ καθέστηχ', οὓς δέ μ' οὐκ ἐχρῆν κακῶς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:508.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:508.1.text#δρᾶν, σοὶ χάριν φέρουσα πολεμίους ἔχω.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:509.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:509.1.text#τοιγάρ με πολλαῖς μακαρίαν Ἑλληνίδων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:510.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:510.1.text#ἔθηκας ἀντὶ τῶνδε· θαυμαστὸν δέ σε
urn:cts:greekLit:tlg0006.tlg003.fu-sp:511.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:511.1.text#ἔχω πόσιν καὶ πιστὸν ἡ τάλαιν' ἐγώ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:512.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:512.1.text#εἰ φεύξομαί γε γαῖαν ἐκβεβλημένη,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:513.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:513.1.text#φίλων ἔρημος, σὺν τέκνοις μόνη μόνοις—
urn:cts:greekLit:tlg0006.tlg003.fu-sp:514.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:514.1.text#καλόν γ' ὄνειδος τῷ νεωστὶ νυμφίῳ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:515.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:515.1.text#πτωχοὺς ἀλᾶσθαι παῖδας ἥ τ' ἔσῳσά σε.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:516.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:516.1.text#ὦ Ζεῦ, τί δὴ χρυσοῦ μὲν ὃς κίβδηλος ᾖ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:517.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:517.1.text#τεκμήρι' ἀνθρώποισιν ὤπασας σαφῆ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:518.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:518.1.text#ἀνδρῶν δ' ὅτῳ χρὴ τὸν κακὸν διειδέναι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:519.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:519.1.text#οὐδεὶς χαρακτὴρ ἐμπέφυκε σώματι;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:520.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:520.1.text#δεινή τις ὀργὴ καὶ δυσίατος πέλει,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:521.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:521.1.text#ὅταν φίλοι φίλοισι συμβάλωσ' ἔριν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:522.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:522.1.text#δεῖ μ', ὡς ἔοικε, μὴ κακὸν φῦναι λέγειν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:523.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:523.1.text#ἀλλ' ὥστε ναὸς κεδνὸν οἰακοστρόφον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:524.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:524.1.text#ἄκροισι λαίφους κρασπέδοις ὑπεκδραμεῖν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:525.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:525.1.text#τὴν σὴν στόμαργον, ὦ γύναι, γλωσσαλγίαν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:526.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:526.1.text#ἐγὼ δ', ἐπειδὴ καὶ λίαν πυργοῖς χάριν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:527.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:527.1.text#Κύπριν νομίζω τῆς ἐμῆς ναυκληρίας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:528.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:528.1.text#σώτειραν εἶναι θεῶν τε κἀνθρώπων μόνην.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:529.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:529.1.text#σοὶ δ' ἔστι μὲν νοῦς λεπτός—ἀλλ' ἐπίφθονος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:530.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:530.1.text#λόγος διελθεῖν, ὡς Ἔρως σ' ἠνάγκασε
urn:cts:greekLit:tlg0006.tlg003.fu-sp:531.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:531.1.text#{ τόξοις ἀφύκτοις } τοὐμὸν ἐκσῷσαι δέμας.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:532.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:532.1.text#ἀλλ' οὐκ ἀκριβῶς αὐτὸ θήσομαι λίαν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:533.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:533.1.text#ὅπῃ γὰρ οὖν ὤνησας, οὐ κακῶς ἔχει.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:534.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:534.1.text#μείζω γε μέντοι τῆς ἐμῆς σωτηρίας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:535.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:535.1.text#εἴληφας ἢ δέδωκας, ὡς ἐγὼ φράσω.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:536.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:536.1.text#πρῶτον μὲν Ἑλλάδ' ἀντὶ βαρβάρου χθονὸς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:537.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:537.1.text#γαῖαν κατοικεῖς καὶ δίκην ἐπίστασαι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:538.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:538.1.text#νόμοις τε χρῆσθαι μὴ πρὸς ἰσχύος χάριν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:539.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:539.1.text#πάντες δέ σ' ᾔσθοντ' οὖσαν Ἕλληνες σοφὴν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:540.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:540.1.text#καὶ δόξαν ἔσχες· εἰ δὲ γῆς ἐπ' ἐσχάτοις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:541.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:541.1.text#ὅροισιν ᾤκεις, οὐκ ἂν ἦν λόγος σέθεν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:542.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:542.1.text#εἴη δ' ἔμοιγε μήτε χρυσὸς ἐν δόμοις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:543.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:543.1.text#μήτ' Ὀρφέως κάλλιον ὑμνῆσαι μέλος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:544.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:544.1.text#εἰ μὴ 'πίσημος ἡ τύχη γένοιτό μοι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:545.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:545.1.text#τοσαῦτα μέν σοι τῶν ἐμῶν πόνων πέρι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:546.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:546.1.text#ἔλεξ'· ἅμιλλαν γὰρ σὺ προύθηκας λόγων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:547.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:547.1.text#ἃ δ' ἐς γάμους μοι βασιλικοὺς ὠνείδισας,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:548.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:548.1.text#ἐν τῷδε δείξω πρῶτα μὲν σοφὸς γεγώς,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:549.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:549.1.text#ἔπειτα σώφρων, εἶτα σοὶ μέγας φίλος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:550.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:550.1.text#καὶ παισὶ τοῖς ἐμοῖσιν—ἀλλ' ἔχ' ἥσυχος.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:551.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:551.1.text#ἐπεὶ μετέστην δεῦρ' Ἰωλκίας χθονὸς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:552.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:552.1.text#πολλὰς ἐφέλκων συμφορὰς ἀμηχάνους,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:553.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:553.1.text#τί τοῦδ' ἂν εὕρημ' ηὗρον εὐτυχέστερον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:554.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:554.1.text#ἢ παῖδα γῆμαι βασιλέως φυγὰς γεγώς;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:555.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:555.1.text#οὐχ, ᾗ σὺ κνίζῃ, σὸν μὲν ἐχθαίρων λέχος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:556.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:556.1.text#καινῆς δὲ νύμφης ἱμέρῳ πεπληγμένος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:557.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:557.1.text#οὐδ' εἰς ἅμιλλαν πολύτεκνον σπουδὴν ἔχων·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:558.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:558.1.text#ἅλις γὰρ οἱ γεγῶτες οὐδὲ μέμφομαι·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:559.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:559.1.text#ἀλλ' ὡς, τὸ μὲν μέγιστον, οἰκοῖμεν καλῶς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:560.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:560.1.text#καὶ μὴ σπανιζοίμεσθα, γιγνώσκων ὅτι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:561.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:561.1.text#πένητα φεύγει πᾶς τις ἐκποδὼν φίλος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:562.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:562.1.text#παῖδας δὲ θρέψαιμ' ἀξίως δόμων ἐμῶν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:563.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:563.1.text#σπείρας τ' ἀδελφοὺς τοῖσιν ἐκ σέθεν τέκνοις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:564.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:564.1.text#ἐς ταὐτὸ θείην, καὶ ξυναρτήσας γένος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:565.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:565.1.text#εὐδαιμονοῖμεν. σοί τε γὰρ παίδων τί δεῖ;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:566.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:566.1.text#ἐμοί τε λύει τοῖσι μέλλουσιν τέκνοις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:567.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:567.1.text#τὰ ζῶντ' ὀνῆσαι. μῶν βεβούλευμαι κακῶς;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:568.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:568.1.text#οὐδ' ἂν σὺ φαίης, εἴ σε μὴ κνίζοι λέχος.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:569.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:569.1.text#ἀλλ' ἐς τοσοῦτον ἥκεθ' ὥστ' ὀρθουμένης
urn:cts:greekLit:tlg0006.tlg003.fu-sp:570.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:570.1.text#εὐνῆς γυναῖκες πάντ' ἔχειν νομίζετε,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:571.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:571.1.text#ἢν δ' αὖ γένηται ξυμφορά τις ἐς λέχος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:572.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:572.1.text#τὰ λῷστα καὶ κάλλιστα πολεμιώτατα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:573.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:573.1.text#τίθεσθε. χρῆν γὰρ ἄλλοθέν ποθεν βροτοὺς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:574.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:574.1.text#παῖδας τεκνοῦσθαι, θῆλυ δ' οὐκ εἶναι γένος·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:575.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:575.1.text#χοὕτως ἂν οὐκ ἦν οὐδὲν ἀνθρώποις κακόν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:576.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:576.1.text#Ἰᾶσον, εὖ μὲν τούσδ' ἐκόσμησας λόγους·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:577.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:577.1.text#ὅμως δ' ἔμοιγε, κεἰ παρὰ γνώμην ἐρῶ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:578.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:578.1.text#δοκεῖς προδοὺς σὴν ἄλοχον οὐ δίκαια δρᾶν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:579.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:579.1.text#ἦ πολλὰ πολλοῖς εἰμι διάφορος βροτῶν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:580.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:580.1.text#ἐμοὶ γὰρ ὅστις ἄδικος ὢν σοφὸς λέγειν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:581.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:581.1.text#πέφυκε, πλείστην ζημίαν ὀφλισκάνει·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:582.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:582.1.text#γλώσσῃ γὰρ αὐχῶν τἄδικ' εὖ περιστελεῖν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:583.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:583.1.text#τολμᾷ πανουργεῖν· ἔστι δ' οὐκ ἄγαν σοφός.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:584.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:584.1.text#ὡς καὶ σὺ μή νυν εἰς ἔμ' εὐσχήμων γένῃ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:585.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:585.1.text#λέγειν τε δεινός. ἓν γὰρ ἐκτενεῖ σ' ἔπος·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:586.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:586.1.text#χρῆν σ', εἴπερ ἦσθα μὴ κακός, πείσαντά με
urn:cts:greekLit:tlg0006.tlg003.fu-sp:587.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:587.1.text#γαμεῖν γάμον τόνδ', ἀλλὰ μὴ σιγῇ φίλων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:588.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:588.1.text#καλῶς γ' ἄν, οἶμαι, τῷδ' ὑπηρέτεις λόγῳ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:589.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:589.1.text#εἴ σοι γάμον κατεῖπον, ἥτις οὐδὲ νῦν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:590.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:590.1.text#τολμᾷς μεθεῖναι καρδίας μέγαν χόλον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:591.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:591.1.text#οὐ τοῦτό σ' εἶχεν, ἀλλὰ βάρβαρον λέχος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:592.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:592.1.text#πρὸς γῆρας οὐκ εὔδοξον ἐξέβαινέ σοι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:593.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:593.1.text#εὖ νῦν τόδ' ἴσθι, μὴ γυναικὸς οὕνεκα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:594.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:594.1.text#γῆμαί με λέκτρα βασιλέων ἃ νῦν ἔχω,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:595.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:595.1.text#ἀλλ', ὥσπερ εἶπον καὶ πάρος, σῷσαι θέλων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:596.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:596.1.text#σέ, καὶ τέκνοισι τοῖς ἐμοῖς ὁμοσπόρους
urn:cts:greekLit:tlg0006.tlg003.fu-sp:597.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:597.1.text#φῦσαι τυράννους παῖδας, ἔρυμα δώμασι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:598.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:598.1.text#μή μοι γένοιτο λυπρὸς εὐδαίμων βίος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:599.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:599.1.text#μηδ' ὄλβος ὅστις τὴν ἐμὴν κνίζοι φρένα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:600.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:600.1.text#οἶσθ' ὡς μέτευξαι, καὶ σοφωτέρα φανῇ;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:601.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:601.1.text#τὰ χρηστὰ μή σοι λυπρὰ φαίνεσθαι ποτέ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:602.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:602.1.text#μηδ' εὐτυχοῦσα δυστυχὴς εἶναι δοκεῖν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:603.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:603.1.text#ὕβριζ', ἐπειδὴ σοὶ μὲν ἔστ' ἀποστροφή,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:604.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:604.1.text#ἐγὼ δ' ἔρημος τήνδε φευξοῦμαι χθόνα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:605.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:605.1.text#αὐτὴ τάδ' εἵλου· μηδέν' ἄλλον αἰτιῶ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:606.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:606.1.text#τί δρῶσα; μῶν γαμοῦσα καὶ προδοῦσά σε;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:607.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:607.1.text#ἀρὰς τυράννοις ἀνοσίους ἀρωμένη.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:608.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:608.1.text#καὶ σοῖς ἀραία γ' οὖσα τυγχάνω δόμοις.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:609.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:609.1.text#ὡς οὐ κρινοῦμαι τῶνδέ σοι τὰ πλείονα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:610.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:610.1.text#ἀλλ', εἴ τι βούλῃ παισὶν ἢ σαυτῆς φυγῇ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:611.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:611.1.text#προσωφέλημα χρημάτων ἐμῶν λαβεῖν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:612.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:612.1.text#λέγ'· ὡς ἕτοιμος ἀφθόνῳ δοῦναι χερὶ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:613.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:613.1.text#ξένοις τε πέμπειν σύμβολ', οἳ δράσουσί σ' εὖ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:614.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:614.1.text#καὶ ταῦτα μὴ θέλουσα μωρανεῖς, γύναι·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:615.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:615.1.text#λήξασα δ' ὀργῆς κερδανεῖς ἀμείνονα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:616.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:616.1.text#οὔτ' ἂν ξένοισι τοῖσι σοῖς χρησαίμεθ' ἄν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:617.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:617.1.text#οὔτ' ἄν τι δεξαίμεσθα, μηδ' ἡμῖν δίδου·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:618.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:618.1.text#κακοῦ γὰρ ἀνδρὸς δῶρ' ὄνησιν οὐκ ἔχει.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:619.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:619.1.text#ἀλλ' οὖν ἐγὼ μὲν δαίμονας μαρτύρομαι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:620.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:620.1.text#ὡς πάνθ' ὑπουργεῖν σοί τε καὶ τέκνοις θέλω· 
urn:cts:greekLit:tlg0006.tlg003.fu-sp:621.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:621.1.text#σοὶ δ' οὐκ ἀρέσκει τἀγάθ', ἀλλ' αὐθαδίᾳ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:622.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:622.1.text#φίλους ἀπωθῇ· τοιγὰρ ἀλγυνῇ πλέον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:623.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:623.1.text#χώρει· πόθῳ γὰρ τῆς νεοδμήτου κόρης
urn:cts:greekLit:tlg0006.tlg003.fu-sp:624.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:624.1.text#αἱρῇ χρονίζων δωμάτων ἐξώπιος.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:625.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:625.1.text#νύμφευ'· ἴσως γάρ—σὺν θεῷ δ' εἰρήσεται—
urn:cts:greekLit:tlg0006.tlg003.fu-sp:626.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:626.1.text#γαμεῖς τοιοῦτον ὥστε σ' ἀρνεῖσθαι γάμον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:627.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:627.1.text#ἔρωτες ὑπὲρ μὲν ἄγαν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:628.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:628.1.text#ἐλθόντες οὐκ εὐδοξίαν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:629.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:629.1.text#οὐδ' ἀρετὰν παρέδωκαν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:630.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:630.1.text#ἀνδράσιν· εἰ δ' ἅλις ἔλθοι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:631.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:631.1.text#Κύπρις, οὐκ ἄλλα θεὸς εὔχαρις οὕτως.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:632.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:632.1.text#μήποτ', ὦ δέσποιν', ἐπ' ἐμοὶ χρυσέων τόξων ἐφείης
urn:cts:greekLit:tlg0006.tlg003.fu-sp:633.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:633.1.text#ἱμέρῳ χρίσασ' ἄφυκτον οἰστόν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:635.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:635.1.text#στέργοι δέ με σωφροσύνα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:636.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:636.1.text#δώρημα κάλλιστον θεῶν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:637.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:637.1.text#μηδέ ποτ' ἀμφιλόγους ὀργὰς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:638.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:638.1.text#ἀκόρεστά τε νείκη
urn:cts:greekLit:tlg0006.tlg003.fu-sp:639.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:639.1.text#θυμὸν ἐκπλήξασ' ἑτέροις ἐπὶ λέκτροις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:640.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:640.1.text#προσβάλοι δεινὰ Κύπρις, ἀπτολέμους δ' εὐνὰς σεβίζουσ'
urn:cts:greekLit:tlg0006.tlg003.fu-sp:641.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:641.1.text#ὀξύφρων κρίνοι λέχη γυναικῶν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:643.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:643.1.text#ὦ πατρίς, ὦ δώματα, μὴ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:644.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:644.1.text#δῆτ' ἄπολις γενοίμαν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:645.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:645.1.text#τὸν ἀμηχανίας ἔχουσα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:646.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:646.1.text#δυσπέρατον αἰῶν',
urn:cts:greekLit:tlg0006.tlg003.fu-sp:647.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:647.1.text#οἰκτροτάτων ἀχέων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:648.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:648.1.text#θανάτῳ θανάτῳ πάρος δαμείην
urn:cts:greekLit:tlg0006.tlg003.fu-sp:649.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:649.1.text#ἁμέραν τάνδ' ἐξανύσασα· μόχθων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:650.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:650.1.text# δ' οὐκ ἄλλος ὕπερθεν ἢ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:651.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:651.1.text#γᾶς πατρίας στέρεσθαι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:652.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:652.1.text#εἴδομεν, οὐκ ἐξ ἑτέρων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:653.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:653.1.text#μῦθον ἔχω φράσασθαι·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:655.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:655.1.text#σὲ γὰρ οὐ πόλις, οὐ φίλων τις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:656.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:656.1.text#ᾤκτισεν παθοῦσαν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:657.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:657.1.text#δεινότατον παθέων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:658.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:658.1.text#ἀχάριστος ὄλοιθ', ὅτῳ πάρεστιν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:660.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:660.1.text#μὴ φίλους τιμᾶν καθαρᾶν ἀνοίξαντα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:661.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:661.1.text# κλῇδα φρενῶν· ἐμοὶ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:662.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:662.1.text#μὲν φίλος οὔποτ' ἔσται.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:663.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:663.1.text#Μήδεια, χαῖρε· τοῦδε γὰρ προοίμιον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:664.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:664.1.text#κάλλιον οὐδεὶς οἶδε προσφωνεῖν φίλους.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:665.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:665.1.text#ὦ χαῖρε καὶ σύ, παῖ σοφοῦ Πανδίονος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:666.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:666.1.text#Αἰγεῦ. πόθεν γῆς τῆσδ' ἐπιστρωφᾷ πέδον;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:667.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:667.1.text#Φοίβου παλαιὸν ἐκλιπὼν χρηστήριον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:668.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:668.1.text#τί δ' ὀμφαλὸν γῆς θεσπιῳδὸν ἐστάλης;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:669.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:669.1.text#παίδων ἐρευνῶν σπέρμ' ὅπως γένοιτό μοι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:670.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:670.1.text#πρὸς θεῶν—ἄπαις γὰρ δεῦρ' ἀεὶ τείνεις βίον;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:671.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:671.1.text#ἄπαιδές ἐσμεν δαίμονός τινος τύχῃ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:672.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:672.1.text#δάμαρτος οὔσης, ἢ λέχους ἄπειρος ὤν;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:673.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:673.1.text#οὐκ ἐσμὲν εὐνῆς ἄζυγες γαμηλίου.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:674.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:674.1.text#τί δῆτα Φοῖβος εἶπέ σοι παίδων πέρι;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:675.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:675.1.text#σοφώτερ' ἢ κατ' ἄνδρα συμβαλεῖν ἔπη.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:676.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:676.1.text#θέμις μὲν ἡμᾶς χρησμὸν εἰδέναι θεοῦ;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:677.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:677.1.text#μάλιστ', ἐπεί τοι καὶ σοφῆς δεῖται φρενός.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:678.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:678.1.text#τί δῆτ' ἔχρησε; λέξον, εἰ θέμις κλύειν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:679.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:679.1.text#ἀσκοῦ με τὸν προύχοντα μὴ λῦσαι πόδα—
urn:cts:greekLit:tlg0006.tlg003.fu-sp:680.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:680.1.text#πρὶν ἂν τί δράσῃς ἢ τίν' ἐξίκῃ χθόνα;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:681.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:681.1.text#πρὶν ἂν πατρῴαν αὖθις ἑστίαν μόλω.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:682.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:682.1.text#σὺ δ' ὡς τί χρῄζων τήνδε ναυστολεῖς χθόνα;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:683.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:683.1.text#Πιτθεύς τις ἔστι, γῆς ἄναξ Tροζηνίας. . . . 
urn:cts:greekLit:tlg0006.tlg003.fu-sp:684.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:684.1.text#παῖς, ὡς λέγουσι, Πέλοπος, εὐσεβέστατος.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:685.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:685.1.text#τούτῳ θεοῦ μάντευμα κοινῶσαι θέλω.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:686.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:686.1.text#σοφὸς γὰρ ἁνὴρ καὶ τρίβων τὰ τοιάδε.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:687.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:687.1.text#κἀμοί γε πάντων φίλτατος δορυξένων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:688.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:688.1.text#ἀλλ' εὐτυχοίης καὶ τύχοις ὅσων ἐρᾷς.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:689.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:689.1.text#τί γὰρ σὸν ὄμμα χρώς τε συντέτηχ' ὅδε;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:690.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:690.1.text#Αἰγεῦ, κάκιστός ἐστί μοι πάντων πόσις.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:691.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:691.1.text#τί φῄς; σαφῶς μοι σὰς φράσον δυσθυμίας.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:692.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:692.1.text#ἀδικεῖ μ' Ἰάσων οὐδὲν ἐξ ἐμοῦ παθών.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:693.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:693.1.text#τί χρῆμα δράσας; φράζε μοι σαφέστερον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:694.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:694.1.text#γυναῖκ' ἐφ' ἡμῖν δεσπότιν δόμων ἔχει.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:695.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:695.1.text#οὔ που τετόλμηκ' ἔργον αἴσχιστον τόδε;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:696.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:696.1.text#σάφ' ἴσθ'· ἄτιμοι δ' ἐσμὲν οἱ πρὸ τοῦ φίλοι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:697.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:697.1.text#πότερον ἐρασθεὶς ἢ σὸν ἐχθαίρων λέχος;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:698.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:698.1.text#μέγαν γ' ἔρωτα πιστὸς οὐκ ἔφυ φίλοις.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:699.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:699.1.text#ἴτω νυν, εἴπερ, ὡς λέγεις, ἐστὶν κακός.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:700.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:700.1.text#ἀνδρῶν τυράννων κῆδος ἠράσθη λαβεῖν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:701.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:701.1.text#δίδωσι δ' αὐτῷ τίς; πέραινέ μοι λόγον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:702.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:702.1.text#Κρέων, ὃς ἄρχει τῆσδε γῆς Κορινθίας.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:703.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:703.1.text#συγγνωστὰ μέν τἄρ' ἦν σε λυπεῖσθαι, γύναι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:704.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:704.1.text#ὄλωλα· καὶ πρός γ' ἐξελαύνομαι χθονός.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:705.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:705.1.text#πρὸς τοῦ; τόδ' ἄλλο καινὸν αὖ λέγεις κακόν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:706.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:706.1.text#Κρέων μ' ἐλαύνει φυγάδα γῆς Κορινθίας.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:707.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:707.1.text#ἐᾷ δ' Ἰάσων; οὐδὲ ταῦτ' ἐπῄνεσα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:708.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:708.1.text#λόγῳ μὲν οὐχί, καρτερεῖν δὲ βούλεται.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:709.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:709.1.text#ἀλλ' ἄντομαί σε τῆσδε πρὸς γενειάδος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:710.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:710.1.text#γονάτων τε τῶν σῶν ἱκεσία τε γίγνομαι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:711.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:711.1.text#οἴκτιρον οἴκτιρόν με τὴν δυσδαίμονα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:712.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:712.1.text#καὶ μή μ' ἔρημον ἐκπεσοῦσαν εἰσίδῃς,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:713.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:713.1.text#δέξαι δὲ χώρᾳ καὶ δόμοις ἐφέστιον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:714.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:714.1.text#οὕτως ἔρως σοὶ πρὸς θεῶν τελεσφόρος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:715.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:715.1.text#γένοιτο παίδων, καὐτὸς ὄλβιος θάνοις.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:716.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:716.1.text#εὕρημα δ' οὐκ οἶσθ' οἷον ηὕρηκας τόδε·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:717.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:717.1.text#παύσω δέ σ' ὄντ' ἄπαιδα καὶ παίδων γονὰς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:718.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:718.1.text#σπεῖραί σε θήσω· τοιάδ' οἶδα φάρμακα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:719.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:719.1.text#πολλῶν ἕκατι τήνδε σοι δοῦναι χάριν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:720.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:720.1.text#γύναι, πρόθυμός εἰμι, πρῶτα μὲν θεῶν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:721.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:721.1.text#ἔπειτα παίδων ὧν ἐπαγγέλλῃ γονάς·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:722.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:722.1.text#ἐς τοῦτο γὰρ δὴ φροῦδός εἰμι πᾶς ἐγώ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:723.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:723.1.text#οὕτω δ' ἔχει μοι· σοῦ μὲν ἐλθούσης χθόνα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:724.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:724.1.text#πειράσομαί σου προξενεῖν δίκαιος ὤν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:725.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:725.1.text#τόσον γε μέντοι σοι προσημαίνω, γύναι·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:726.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:726.1.text#ἐκ τῆσδε μὲν γῆς οὔ σ' ἄγειν βουλήσομαι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:727.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:727.1.text#αὐτὴ δ' ἐάνπερ εἰς ἐμοὺς ἔλθῃς δόμους,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:728.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:728.1.text#μενεῖς ἄσυλος κοὔ σε μὴ μεθῶ τινι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:729.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:729.1.text#ἐκ τῆσδε δ' αὐτὴ γῆς ἀπαλλάσσου πόδα·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:730.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:730.1.text#ἀναίτιος γὰρ καὶ ξένοις εἶναι θέλω.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:731.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:731.1.text#ἔσται τάδ'· ἀλλὰ πίστις εἰ γένοιτό μοι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:732.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:732.1.text#τούτων, ἔχοιμ' ἂν πάντα πρὸς σέθεν καλῶς.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:733.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:733.1.text#μῶν οὐ πέποιθας; ἢ τί σοι τὸ δυσχερές;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:734.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:734.1.text#πέποιθα· Πελίου δ' ἐχθρός ἐστί μοι δόμος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:735.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:735.1.text#Κρέων τε. τούτοις δ' ὁρκίοισι μὲν ζυγεὶς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:736.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:736.1.text#ἄγουσιν οὐ μεθεῖ' ἂν ἐκ γαίας ἐμέ·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:737.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:737.1.text#λόγοις δὲ συμβὰς καὶ θεῶν ἀνώμοτος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:738.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:738.1.text#{ φίλος γένοι' ἂν τἀπικηρυκεύματα·— }
urn:cts:greekLit:tlg0006.tlg003.fu-sp:739.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:739.1.text#οὐκ ἂν πίθοιο· τἀμὰ μὲν γὰρ ἀσθενῆ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:740.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:740.1.text#τοῖς δ' ὄλβος ἐστὶ καὶ δόμος τυραννικός.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:741.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:741.1.text#{ πολλὴν ἔλεξας ἐν λόγοις προμηθίαν· }
urn:cts:greekLit:tlg0006.tlg003.fu-sp:742.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:742.1.text#ἀλλ', εἰ δοκεῖ σοι, δρᾶν τάδ' οὐκ ἀφίσταμαι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:743.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:743.1.text#ἐμοί τε γὰρ τάδ' ἐστὶν ἀσφαλέστατα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:744.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:744.1.text#σκῆψίν τιν' ἐχθροῖς σοῖς ἔχοντα δεικνύναι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:745.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:745.1.text#τὸ σόν τ' ἄραρε μᾶλλον· ἐξηγοῦ θεούς.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:746.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:746.1.text#ὄμνυ πέδον Γῆς, πατέρα θ' Ἥλιον πατρὸς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:747.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:747.1.text#τοὐμοῦ, θεῶν τε συντιθεὶς ἅπαν γένος.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:748.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:748.1.text#τί χρῆμα δράσειν ἢ τί μὴ δράσειν; λέγε.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:749.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:749.1.text#μήτ' αὐτὸς ἐκ γῆς σῆς ἔμ' ἐκβαλεῖν ποτε,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:750.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:750.1.text#μήτ' ἄλλος ἤν τις τῶν ἐμῶν ἐχθρῶν ἄγειν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:751.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:751.1.text#χρῄζῃ, μεθήσειν ζῶν ἑκουσίῳ τρόπῳ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:752.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:752.1.text#ὄμνυμι Γαῖαν { Ἡλίου θ' ἁγνὸν σέβας }
urn:cts:greekLit:tlg0006.tlg003.fu-sp:753.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:753.1.text#θεούς τε πάντας ἐμμενεῖν ἅ σου κλύω.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:754.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:754.1.text#ἀρκεῖ· τί δ' ὅρκῳ τῷδε μὴ 'μμένων πάθοις;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:755.1.speaker#Αἰγεύς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:755.1.text#ἃ τοῖσι δυσσεβοῦσι γίγνεται βροτῶν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:756.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:756.1.text#χαίρων πορεύου· πάντα γὰρ καλῶς ἔχει.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:757.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:757.1.text#κἀγὼ πόλιν σὴν ὡς τάχιστ' ἀφίξομαι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:758.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:758.1.text#πράξασ' ἃ μέλλω καὶ τυχοῦσ' ἃ βούλομαι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:759.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:759.1.text#ἀλλά σ' ὁ Μαίας πομπαῖος ἄναξ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:760.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:760.1.text#πελάσειε δόμοις, ὧν τ' ἐπίνοιαν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:761.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:761.1.text#σπεύδεις κατέχων πράξειας, ἐπεὶ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:762.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:762.1.text#γενναῖος ἀνήρ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:763.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:763.1.text#Αἰγεῦ, παρ' ἐμοὶ δεδόκησαι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:764.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:764.1.text#ὦ Ζεῦ Δίκη τε Ζηνὸς Ἡλίου τε φῶς,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:765.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:765.1.text#νῦν καλλίνικοι τῶν ἐμῶν ἐχθρῶν, φίλαι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:766.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:766.1.text#γενησόμεσθα κεἰς ὁδὸν βεβήκαμεν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:767.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:767.1.text#νῦν [ δ' ] ἐλπὶς ἐχθροὺς τοὺς ἐμοὺς τείσειν δίκην.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:768.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:768.1.text#οὗτος γὰρ ἁνὴρ ᾗ μάλιστ' ἐκάμνομεν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:769.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:769.1.text#λιμὴν πέφανται τῶν ἐμῶν βουλευμάτων·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:770.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:770.1.text#ἐκ τοῦδ' ἀναψόμεσθα πρυμνήτην κάλων,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:771.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:771.1.text#μολόντες ἄστυ καὶ πόλισμα Παλλάδος.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:772.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:772.1.text#ἤδη δὲ πάντα τἀμά σοι βουλεύματα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:773.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:773.1.text#λέξω· δέχου δὲ μὴ πρὸς ἡδονὴν λόγους.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:774.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:774.1.text#πέμψασ' ἐμῶν τιν' οἰκετῶν Ἰάσονα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:775.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:775.1.text#ἐς ὄψιν ἐλθεῖν τὴν ἐμὴν αἰτήσομαι·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:776.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:776.1.text#μολόντι δ' αὐτῷ μαλθακοὺς λέξω λόγους,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:777.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:777.1.text#ὡς καὶ δοκεῖ μοι ταὐτά, καὶ καλῶς ἔχειν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:778.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:778.1.text#γάμους τυράννων οὓς προδοὺς ἡμᾶς ἔχει·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:779.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:779.1.text#καὶ ξύμφορ' εἶναι καὶ καλῶς ἐγνωσμένα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:780.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:780.1.text#παῖδας δὲ μεῖναι τοὺς ἐμοὺς αἰτήσομαι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:781.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:781.1.text#οὐχ ὡς λιποῦσ' ἂν πολεμίας ἐπὶ χθονὸς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:782.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:782.1.text#ἐχθροῖσι παῖδας τοὺς ἐμοὺς καθυβρίσαι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:783.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:783.1.text#ἀλλ' ὡς δόλοισι παῖδα βασιλέως κτάνω.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:784.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:784.1.text#πέμψω γὰρ αὐτοὺς δῶρ' ἔχοντας ἐν χεροῖν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:785.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:785.1.text#νύμφῃ φέροντας, τήνδε μὴ φυγεῖν χθόνα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:786.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:786.1.text#λεπτόν τε πέπλον καὶ πλόκον χρυσήλατον·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:787.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:787.1.text#κἄνπερ λαβοῦσα κόσμον ἀμφιθῇ χροΐ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:788.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:788.1.text#κακῶς ὀλεῖται πᾶς θ' ὃς ἂν θίγῃ κόρης·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:789.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:789.1.text#τοιοῖσδε χρίσω φαρμάκοις δωρήματα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:790.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:790.1.text#ἐνταῦθα μέντοι τόνδ' ἀπαλλάσσω λόγον·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:791.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:791.1.text#ᾤμωξα δ' οἷον ἔργον ἔστ' ἐργαστέον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:792.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:792.1.text#τοὐντεῦθεν ἡμῖν· τέκνα γὰρ κατακτενῶ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:793.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:793.1.text#τἄμ'· οὔτις ἔστιν ὅστις ἐξαιρήσεται·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:794.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:794.1.text#δόμον τε πάντα συγχέασ' Ἰάσονος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:795.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:795.1.text#ἔξειμι γαίας, φιλτάτων παίδων φόνον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:796.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:796.1.text#φεύγουσα καὶ τλᾶσ' ἔργον ἀνοσιώτατον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:797.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:797.1.text#οὐ γὰρ γελᾶσθαι τλητὸν ἐξ ἐχθρῶν, φίλαι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:798.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:798.1.text#ἴτω· τί μοι ζῆν κέρδος; οὔτε μοι πατρὶς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:799.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:799.1.text#οὔτ' οἶκος ἔστιν οὔτ' ἀποστροφὴ κακῶν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:800.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:800.1.text#ἡμάρτανον τόθ' ἡνίκ' ἐξελίμπανον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:801.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:801.1.text#δόμους πατρῴους, ἀνδρὸς Ἕλληνος λόγοις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:802.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:802.1.text#πεισθεῖσ', ὃς ἡμῖν σὺν θεῷ τείσει δίκην.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:803.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:803.1.text#οὔτ' ἐξ ἐμοῦ γὰρ παῖδας ὄψεταί ποτε
urn:cts:greekLit:tlg0006.tlg003.fu-sp:804.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:804.1.text#ζῶντας τὸ λοιπὸν οὔτε τῆς νεοζύγου
urn:cts:greekLit:tlg0006.tlg003.fu-sp:805.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:805.1.text#νύμφης τεκνώσει παῖδ', ἐπεὶ κακῶς κακὴν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:806.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:806.1.text#θανεῖν σφ' ἀνάγκη τοῖς ἐμοῖσι φαρμάκοις.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:807.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:807.1.text#μηδείς με φαύλην κἀσθενῆ νομιζέτω
urn:cts:greekLit:tlg0006.tlg003.fu-sp:808.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:808.1.text#μηδ' ἡσυχαίαν, ἀλλὰ θατέρου τρόπου,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:809.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:809.1.text#βαρεῖαν ἐχθροῖς καὶ φίλοισιν εὐμενῆ·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:810.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:810.1.text#τῶν γὰρ τοιούτων εὐκλεέστατος βίος.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:811.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:811.1.text#ἐπείπερ ἡμῖν τόνδ' ἐκοίνωσας λόγον,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:812.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:812.1.text#σέ τ'' ὠφελεῖν θέλουσα, καὶ νόμοις βροτῶν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:813.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:813.1.text#ξυλλαμβάνουσα, δρᾶν σ' ἀπεννέπω τάδε.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:814.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:814.1.text#οὐκ ἔστιν ἄλλως· σοὶ δὲ συγγνώμη λέγειν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:815.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:815.1.text#τάδ' ἐστί, μὴ πάσχουσαν, ὡς ἐγώ, κακῶς.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:816.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:816.1.text#ἀλλὰ κτανεῖν σὸν σπέρμα τολμήσεις, γύναι;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:817.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:817.1.text#οὕτω γὰρ ἂν μάλιστα δηχθείη πόσις.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:818.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:818.1.text#σὺ δ' ἂν γένοιό γ' ἀθλιωτάτη γυνή.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:819.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:819.1.text#ἴτω· περισσοὶ πάντες οὑν μέσῳ λόγοι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:820.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:820.1.text#ἀλλ' εἶα χώρει καὶ κόμιζ' Ἰάσονα·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:821.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:821.1.text#ἐς πάντα γὰρ δὴ σοὶ τὰ πιστὰ χρώμεθα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:822.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:822.1.text#λέξῃς δὲ μηδὲν τῶν ἐμοὶ δεδογμένων,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:823.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:823.1.text#εἴπερ φρονεῖς εὖ δεσπόταις γυνή τ' ἔφυς.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:824.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:824.1.text#Ἐρεχθεΐδαι τὸ παλαιὸν ὄλβιοι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:825.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:825.1.text#καὶ θεῶν παῖδες μακάρων, ἱερᾶς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:826.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:826.1.text#χώρας ἀπορθήτου τ' ἄπο, φερβόμενοι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:827.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:827.1.text#κλεινοτάταν σοφίαν, αἰεὶ διὰ λαμπροτάτου
urn:cts:greekLit:tlg0006.tlg003.fu-sp:830.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:830.1.text#βαίνοντες ἁβρῶς αἰθέρος, ἔνθα ποθ' ἁγνὰς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:831.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:831.1.text#ἐννέα Πιερίδας Μούσας λέγουσι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:832.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:832.1.text#ξανθὰν Ἁρμονίαν φυτεῦσαι·[ … ]
urn:cts:greekLit:tlg0006.tlg003.fu-sp:835.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:835.1.text#τοῦ καλλινάου τ' ἐπὶ Κηφισοῦ ῥοαῖς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:836.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:836.1.text#τὰν Κύπριν κλῄζουσιν ἀφυσσαμέναν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:837.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:837.1.text#χώραν καταπνεῦσαι μετρίας ἀνέμων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:840.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:840.1.text#ἡδυπνόους αὔρας· αἰεὶ δ' ἐπιβαλλομέναν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:841.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:841.1.text#χαίταισιν εὐώδη ῥοδέων πλόκον ἀνθέων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:842.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:842.1.text#τᾷ Σοφίᾳ παρέδρους πέμπειν Ἔρωτας,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:845.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:845.1.text#παντοίας ἀρετᾶς ξυνεργούς.[ … ]
urn:cts:greekLit:tlg0006.tlg003.fu-sp:846.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:846.1.text#πῶς οὖν ἱερῶν ποταμῶν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:847.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:847.1.text#{ ἢ πόλις }; ἦ φίλων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:848.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:848.1.text#πόμπιμός σε χώρα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:849.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:849.1.text#τὰν παιδολέτειραν ἕξει,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:850.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:850.1.text#τὰν οὐχ ὁσίαν μετ' ἄλλων;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:851.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:851.1.text#σκέψαι τεκέων πλαγάν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:852.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:852.1.text#σκέψαι φόνον οἷον αἴρῃ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:853.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:853.1.text#μή, πρὸς γονάτων σε πάντη
urn:cts:greekLit:tlg0006.tlg003.fu-sp:854.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:854.1.text#πάντως ἱκετεύομεν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:855.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:855.1.text#τέκνα φονεύσῃς.[ … ]
urn:cts:greekLit:tlg0006.tlg003.fu-sp:856.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:856.1.text#πόθεν θράσος { ἢ φρενὸς ἢ }
urn:cts:greekLit:tlg0006.tlg003.fu-sp:857.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:857.1.text#{ χειρὶ τέκνων σέθεν }
urn:cts:greekLit:tlg0006.tlg003.fu-sp:858.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:858.1.text#{ καρδίᾳ τε λήψῃ }
urn:cts:greekLit:tlg0006.tlg003.fu-sp:859.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:859.1.text#δεινὰν προσάγουσα τόλμαν;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:860.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:860.1.text#πῶς δ' ὄμματα προσβαλοῦσα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:861.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:861.1.text#τέκνοις ἄδακρυν μοῖραν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:862.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:862.1.text#σχήσεις φόνου; οὐ δυνάσῃ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:863.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:863.1.text#παίδων ἱκετᾶν πιτνόντων,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:864.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:864.1.text#τέγξαι χέρα φοινίαν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:865.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:865.1.text#τλάμονι θυμῷ.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg003.fu-sp:866.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:866.1.text#ἥκω κελευσθείς· καὶ γὰρ οὖσα δυσμενὴς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:867.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:867.1.text#οὔ τἂν ἁμάρτοις τοῦδέ γ', ἀλλ' ἀκούσομαι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:868.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:868.1.text#τί χρῆμα βούλῃ καινὸν ἐξ ἐμοῦ, γύναι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:869.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:869.1.text#Ἰᾶσον, αἰτοῦμαί σε τῶν εἰρημένων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:870.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:870.1.text#συγγνώμον' εἶναι· τὰς δ' ἐμὰς ὀργὰς φέρειν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:871.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:871.1.text#εἰκός σ', ἐπεὶ νῷν πόλλ' ὑπείργασται φίλα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:872.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:872.1.text#ἐγὼ δ' ἐμαυτῇ διὰ λόγων ἀφικόμην
urn:cts:greekLit:tlg0006.tlg003.fu-sp:873.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:873.1.text#κἀλοιδόρησα· Σχετλία, τί μαίνομαι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:874.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:874.1.text#καὶ δυσμεναίνω τοῖσι βουλεύουσιν εὖ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:875.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:875.1.text#ἐχθρὰ δὲ γαίας κοιράνοις καθίσταμαι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:876.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:876.1.text#πόσει θ', ὃς ἡμῖν δρᾷ τὰ συμφορώτατα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:877.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:877.1.text#γήμας τύραννον καὶ κασιγνήτους τέκνοις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:878.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:878.1.text#ἐμοῖς φυτεύων; οὐκ ἀπαλλαχθήσομαι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:879.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:879.1.text#θυμοῦ—τί πάσχω;—θεῶν ποριζόντων καλῶς;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:880.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:880.1.text#οὐκ εἰσὶ μέν μοι παῖδες, οἶδα δὲ χθόνα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:881.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:881.1.text#φεύγοντας ἡμᾶς καὶ σπανίζοντας φίλων;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:882.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:882.1.text#ταῦτ' ἐννοήσασ' ᾐσθόμην ἀβουλίαν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:883.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:883.1.text#πολλὴν ἔχουσα καὶ μάτην θυμουμένη.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:884.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:884.1.text#νῦν οὖν ἐπαινῶ· σωφρονεῖν τ' ἐμοὶ δοκεῖς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:885.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:885.1.text#κῆδος τόδ' ἡμῖν προσλαβών, ἐγὼ δ' ἄφρων,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:886.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:886.1.text#ᾗ χρῆν μετεῖναι τῶνδε τῶν βουλευμάτων,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:887.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:887.1.text#καὶ ξυγγαμεῖν σοι, καὶ παρεστάναι λέχει
urn:cts:greekLit:tlg0006.tlg003.fu-sp:888.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:888.1.text#νύμφην τε κηδεύουσαν ἥδεσθαι σέθεν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:889.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:889.1.text#ἀλλ' ἐσμὲν οἷόν ἐσμεν, οὐκ ἐρῶ κακόν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:890.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:890.1.text#γυναῖκες· οὔκουν χρῆν σ' ὁμοιοῦσθαι κακοῖς,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:891.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:891.1.text#οὐδ' ἀντιτείνειν νήπι' ἀντὶ νηπίων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:892.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:892.1.text#παριέμεσθα, καί φαμεν κακῶς φρονεῖν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:893.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:893.1.text#τότ', ἀλλ' ἄμεινον νῦν βεβούλευμαι τάδε·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:894.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:894.1.text#ὦ τέκνα τέκνα, δεῦτε, λείπετε στέγας,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:895.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:895.1.text#ἐξέλθετ', ἀσπάσασθε καὶ προσείπατε
urn:cts:greekLit:tlg0006.tlg003.fu-sp:896.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:896.1.text#πατέρα μεθ' ἡμῶν, καὶ διαλλάχθηθ' ἅμα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:897.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:897.1.text#τῆς πρόσθεν ἔχθρας ἐς φίλους μητρὸς μέτα·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:898.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:898.1.text#σπονδαὶ γὰρ ἡμῖν καὶ μεθέστηκεν χόλος.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:899.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:899.1.text#λάβεσθε χειρὸς δεξιᾶς· οἴμοι, κακῶν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:900.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:900.1.text#ὡς ἐννοοῦμαι δή τι τῶν κεκρυμμένων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:901.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:901.1.text#ἆρ', ὦ τέκν', οὕτω καὶ πολὺν ζῶντες χρόνον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:902.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:902.1.text#φίλην ὀρέξετ' ὠλένην; τάλαιν' ἐγώ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:903.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:903.1.text#ὡς ἀρτίδακρύς εἰμι καὶ φόβου πλέα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:904.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:904.1.text#χρόνῳ δὲ νεῖκος πατρὸς ἐξαιρουμένη
urn:cts:greekLit:tlg0006.tlg003.fu-sp:905.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:905.1.text#ὄψιν τέρειναν τήνδ' ἔπλησα δακρύων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:906.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:906.1.text#κἀμοὶ κατ' ὄσσων χλωρὸν ὡρμήθη δάκρυ·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:907.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:907.1.text#καὶ μὴ προβαίη μεῖζον ἢ τὸ νῦν κακόν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:908.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:908.1.text#αἰνῶ, γύναι, τάδ', οὐδ' ἐκεῖνα μέμφομαι·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:909.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:909.1.text#εἰκὸς γὰρ ὀργὰς θῆλυ ποιεῖσθαι γένος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:910.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:910.1.text#{ γάμου παρεμπολῶντος ἀλλοίου πόσει. }
urn:cts:greekLit:tlg0006.tlg003.fu-sp:911.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:911.1.text#ἀλλ' ἐς τὸ λῷον σὸν μεθέστηκεν κέαρ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:912.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:912.1.text#ἔγνως δὲ τὴν νικῶσαν, ἀλλὰ τῷ χρόνῳ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:913.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:913.1.text#βουλήν· γυναικὸς ἔργα ταῦτα σώφρονος.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:914.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:914.1.text#ὑμῖν δέ, παῖδες, οὐκ ἀφροντίστως πατὴρ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:915.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:915.1.text#πολλὴν ἔθηκε σὺν θεοῖς σωτηρίαν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:916.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:916.1.text#οἶμαι γὰρ ὑμᾶς τῆσδε γῆς Κορινθίας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:917.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:917.1.text#τὰ πρῶτ' ἔσεσθαι σὺν κασιγνήτοις ἔτι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:918.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:918.1.text#ἀλλ' αὐξάνεσθε· τἄλλα δ' ἐξεργάζεται
urn:cts:greekLit:tlg0006.tlg003.fu-sp:919.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:919.1.text#πατήρ τε καὶ θεῶν ὅστις ἐστὶν εὐμενής·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:920.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:920.1.text#ἴδοιμι δ' ὑμᾶς εὐτραφεῖς ἥβης τέλος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:921.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:921.1.text#μολόντας, ἐχθρῶν τῶν ἐμῶν ὑπερτέρους.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:922.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:922.1.text#αὕτη, τί χλωροῖς δακρύοις τέγγεις κόρας,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:923.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:923.1.text#στρέψασα λευκὴν ἔμπαλιν παρηίδα;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:924.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:924.1.text#κοὐκ ἀσμένη τόνδ' ἐξ ἐμοῦ δέχῃ λόγον;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:925.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:925.1.text#οὐδέν. τέκνων τῶνδ' ἐννοουμένη πέρι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:926.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:926.1.text#θάρσει νυν· εὖ γὰρ τῶνδ' ἐγὼ θήσω πέρι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:927.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:927.1.text#δράσω τάδ'· οὔτοι σοῖς ἀπιστήσω λόγοις·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:928.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:928.1.text#γυνὴ δὲ θῆλυ κἀπὶ δακρύοις ἔφυ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:929.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:929.1.text#τί δῆτα λίαν τοῖσδ' ἐπιστένεις τέκνοις;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:930.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:930.1.text#ἔτικτον αὐτούς· ζῆν δ' ὅτ' ἐξηύχου τέκνα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:931.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:931.1.text#ἐσῆλθέ μ' οἶκτος εἰ γενήσεται τάδε.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:932.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:932.1.text#ἀλλ' ὧνπερ οὕνεκ' εἰς ἐμοὺς ἥκεις λόγους,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:933.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:933.1.text#τὰ μὲν λέλεκται, τῶν δ' ἐγὼ μνησθήσομαι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:934.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:934.1.text#ἐπεὶ τυράννοις γῆς μ' ἀποστεῖλαι δοκεῖ—
urn:cts:greekLit:tlg0006.tlg003.fu-sp:935.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:935.1.text#κἀμοὶ τάδ' ἐστὶ λῷστα, γιγνώσκω καλῶς,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:936.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:936.1.text#μήτ' ἐμποδὼν σοὶ μήτε κοιράνοις χθονὸς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:937.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:937.1.text#ναίειν· δοκῶ γὰρ δυσμενὴς εἶναι δόμοις—
urn:cts:greekLit:tlg0006.tlg003.fu-sp:938.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:938.1.text#ἡμεῖς μὲν ἐκ γῆς τῆσδ' ἀπαίρομεν φυγῇ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:939.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:939.1.text#παῖδες δ' ὅπως ἂν ἐκτραφῶσι σῇ χερί,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:940.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:940.1.text#αἰτοῦ Κρέοντα τήνδε μὴ φεύγειν χθόνα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:941.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:941.1.text#οὐκ οἶδ' ἂν εἰ πείσαιμι, πειρᾶσθαι δὲ χρή.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:942.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:942.1.text#σὺ δ' ἀλλὰ σὴν κέλευσον αἰτεῖσθαι πατρὸς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:943.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:943.1.text#γυναῖκα παῖδας τήνδε μὴ φεύγειν χθόνα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:944.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:944.1.text#μάλιστα, καὶ πείσειν γε δοξάζω σφ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:945.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:945.1.text#εἴπερ γυναικῶν ἐστι τῶν ἄλλων μία.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:946.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:946.1.text#συλλήψομαι δὲ τοῦδέ σοι κἀγὼ πόνου·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:947.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:947.1.text#πέμψω γὰρ αὐτῇ δῶρ' ἃ καλλιστεύεται
urn:cts:greekLit:tlg0006.tlg003.fu-sp:948.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:948.1.text#τῶν νῦν ἐν ἀνθρώποισιν, οἶδ' ἐγώ, πολύ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:949.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:949.1.text#λεπτόν τε πέπλον καὶ πλόκον χρυσήλατον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:950.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:950.1.text#παῖδας φέροντας. ἀλλ' ὅσον τάχος χρεὼν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:951.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:951.1.text#κόσμον κομίζειν δεῦρο προσπόλων τινά.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:952.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:952.1.text#εὐδαιμονήσει δ' οὐχ ἕν, ἀλλὰ μυρία,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:953.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:953.1.text#ἀνδρός τ' ἀρίστου σοῦ τυχοῦσ' ὁμευνέτου
urn:cts:greekLit:tlg0006.tlg003.fu-sp:954.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:954.1.text#κεκτημένη τε κόσμον ὅν ποθ' Ἥλιος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:955.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:955.1.text#πατρὸς πατὴρ δίδωσιν ἐκγόνοισιν οἷς.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:956.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:956.1.text#λάζυσθε φερνὰς τάσδε, παῖδες, ἐς χέρας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:957.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:957.1.text#καὶ τῇ τυράννῳ μακαρίᾳ νύμφῃ δότε
urn:cts:greekLit:tlg0006.tlg003.fu-sp:958.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:958.1.text#φέροντες· οὔτοι δῶρα μεμπτὰ δέξεται.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:959.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:959.1.text#τί δ', ὦ ματαία, τῶνδε σὰς κενοῖς χέρας;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:960.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:960.1.text#δοκεῖς σπανίζειν δῶμα βασίλειον πέπλων,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:961.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:961.1.text#δοκεῖς δὲ χρυσοῦ; σῷζε, μὴ δίδου τάδε.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:962.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:962.1.text#εἴπερ γὰρ ἡμᾶς ἀξιοῖ λόγου τινὸς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:963.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:963.1.text#γυνή, προθήσει χρημάτων, σάφ' οἶδ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:964.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:964.1.text#μή μοι σύ· πείθειν δῶρα καὶ θεοὺς λόγος·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:965.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:965.1.text#χρυσὸς δὲ κρείσσων μυρίων λόγων βροτοῖς.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:966.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:966.1.text#κείνης ὁ δαίμων, κεῖνα νῦν αὔξει θεός,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:967.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:967.1.text#νέα τυραννεῖ· τῶν δ' ἐμῶν παίδων φυγὰς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:968.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:968.1.text#ψυχῆς ἂν ἀλλαξαίμεθ', οὐ χρυσοῦ μόνον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:969.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:969.1.text#ἀλλ', ὦ τέκν', εἰσελθόντε πλουσίους δόμους
urn:cts:greekLit:tlg0006.tlg003.fu-sp:970.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:970.1.text#πατρὸς νέαν γυναῖκα, δεσπότιν δ' ἐμήν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:971.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:971.1.text#ἱκετεύετ', ἐξαιτεῖσθε μὴ φυγεῖν χθόνα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:972.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:972.1.text#κόσμον διδόντες—τοῦδε γὰρ μάλιστα δεῖ—
urn:cts:greekLit:tlg0006.tlg003.fu-sp:973.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:973.1.text#ἐς χεῖρ' ἐκείνης δῶρα δέξασθαι τάδε.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:974.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:974.1.text#ἴθ' ὡς τάχιστα· μητρὶ δ' ὧν ἐρᾷ τυχεῖν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:975.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:975.1.text#εὐάγγελοι γένοισθε πράξαντες καλῶς.[ … ]
urn:cts:greekLit:tlg0006.tlg003.fu-sp:976.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:976.1.text#νῦν ἐλπίδες οὐκέτι μοι παίδων ζόας,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:977.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:977.1.text#οὐκέτι· στείχουσι γὰρ ἐς φόνον ἤδη.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:978.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:978.1.text#δέξεται νύμφα χρυσέων ἀναδεσμῶν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:979.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:979.1.text#δέξεται δύστανος ἄταν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:980.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:980.1.text#ξανθᾷ δ' ἀμφὶ κόμᾳ θήσει τὸν Ἅιδα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:981.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:981.1.text#κόσμον αὐτὰ χεροῖν. [ λαβοῦσα. ]
urn:cts:greekLit:tlg0006.tlg003.fu-sp:983.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:983.1.text#πείσει χάρις ἀμβρόσιός τ' αὐγὰ πέπλων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:984.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:984.1.text#χρυσέων τευκτὸν στέφανον περιθέσθαι·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:985.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:985.1.text#νερτέροις δ' ἤδη πάρα νυμφοκομήσει.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:986.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:986.1.text#τοῖον εἰς ἕρκος πεσεῖται
urn:cts:greekLit:tlg0006.tlg003.fu-sp:987.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:987.1.text#καὶ μοῖραν θανάτου δύστανος· ἄταν δ'
urn:cts:greekLit:tlg0006.tlg003.fu-sp:988.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:988.1.text#οὐχ ὑπεκφεύξεται.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:990.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:990.1.text#σὺ δ', ὦ τάλαν, ὦ κακόνυμφε κηδεμὼν τυράννων,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:991.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:991.1.text#παισὶν οὐ κατειδὼς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:992.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:992.1.text#ὄλεθρον βιοτᾷ προσάγεις ἀλόχῳ τε
urn:cts:greekLit:tlg0006.tlg003.fu-sp:993.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:993.1.text#σᾷ στυγερὸν θάνατον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:995.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:995.1.text#δύστανε μοίρας ὅσον παροίχῃ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:996.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:996.1.text#μεταστένομαι δὲ σὸν ἄλγος, ὦ τάλαινα παίδων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:997.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:997.1.text#μᾶτερ, ἃ φονεύσεις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:998.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:998.1.text#τέκνα νυμφιδίων ἕνεκεν λεχέων, ἅ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1000.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1000.1.text#σοι προλιπὼν ἀνόμως
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1001.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1001.1.text#ἄλλᾳ ξυνοικεῖ πόσις συνεύνῳ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1002.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1002.1.text#δέσποιν', ἀφεῖνται παῖδες οἵδε σοὶ φυγῆς,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1003.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1003.1.text#καὶ δῶρα νύμφη βασιλὶς ἀσμένη χεροῖν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1004.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1004.1.text#ἐδέξατ'· εἰρήνη δὲ τἀκεῖθεν τέκνοις.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1005.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1005.1.text#ἔα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1005.2.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1005.2.text#τί συγχυθεῖσ' ἕστηκας ἡνίκ' εὐτυχεῖς;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1006.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1006.1.text#[ τί σὴν ἔστρεψας ἔμπαλιν παρηίδα ]
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1007.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1007.1.text#[ κοὐκ ἀσμένη τόνδ' ἐξ ἐμοῦ δέχῃ λόγον; ]
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1008.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1008.1.text#αἰαῖ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1008.2.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1008.2.text#τάδ' οὐ ξυνῳδὰ τοῖσιν ἐξηγγελμένοις.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1009.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1009.1.text#αἰαῖ μάλ' αὖθις.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1009.2.speaker#Παιδαγωγός.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1009.2.text#μῶν τιν' ἀγγέλλων τύχην
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1010.1.speaker#Παιδαγωγός.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1010.1.text#οὐκ οἶδα, δόξης δ' ἐσφάλην εὐαγγέλου;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1011.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1011.1.text#ἤγγειλας οἷ' ἤγγειλας· οὐ σὲ μέμφομαι.·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1012.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1012.1.text#τί δαὶ κατηφεῖς ὄμμα καὶ δακρυρροεῖς;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1013.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1013.1.text#πολλή μ' ἀνάγκη, πρέσβυ· ταῦτα γὰρ θεοὶ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1014.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1014.1.text#κἀγὼ κακῶς φρονοῦσ' ἐμηχανησάμην.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1015.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1015.1.text#θάρσει· κάτει τοι καὶ σὺ πρὸς τέκνων ἔτι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1016.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1016.1.text#ἄλλους κατάξω πρόσθεν ἡ τάλαιν' ἐγώ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1017.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1017.1.text#οὔτοι μόνη σὺ σῶν ἀπεζύγης τέκνων·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1018.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1018.1.text#κούφως φέρειν χρὴ θνητὸν ὄντα συμφοράς.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1019.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1019.1.text#δράσω τάδ'. ἀλλὰ βαῖνε δωμάτων ἔσω
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1020.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1020.1.text#καὶ παισὶ πόρσυν' οἷα χρὴ καθ' ἡμέραν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1021.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1021.1.text#ὦ τέκνα τέκνα, σφῷν μὲν ἔστι δὴ πόλις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1022.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1022.1.text#καὶ δῶμ', ἐν ᾧ, λιπόντες ἀθλίαν ἐμέ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1023.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1023.1.text#οἰκήσετ' αἰεὶ μητρὸς ἐστερημένοι·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1024.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1024.1.text#ἐγὼ δ' ἐς ἄλλην γαῖαν εἶμι δὴ φυγάς,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1025.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1025.1.text#πρὶν σφῷν ὀνάσθαι κἀπιδεῖν εὐδαίμονας,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1026.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1026.1.text#πρὶν λέκτρα καὶ γυναῖκα καὶ γαμηλίους
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1027.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1027.1.text#εὐνὰς ἀγῆλαι λαμπάδας τ' ἀνασχεθεῖν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1028.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1028.1.text#ὦ δυστάλαινα τῆς ἐμῆς αὐθαδίας.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1029.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1029.1.text#ἄλλως ἄρ' ὑμᾶς, ὦ τέκν', ἐξεθρεψάμην,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1030.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1030.1.text#ἄλλως δ' ἐμόχθουν καὶ κατεξάνθην πόνοις,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1031.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1031.1.text#στερρὰς ἐνεγκοῦσ' ἐν τόκοις ἀλγηδόνας.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1032.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1032.1.text#ἦ μήν ποθ' ἡ δύστηνος εἶχον ἐλπίδας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1033.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1033.1.text#πολλὰς ἐν ὑμῖν, γηροβοσκήσειν τ' ἐμὲ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1034.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1034.1.text#καὶ κατθανοῦσαν χερσὶν εὖ περιστελεῖν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1035.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1035.1.text#ζηλωτὸν ἀνθρώποισι· νῦν δ' ὄλωλε δὴ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1036.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1036.1.text#γλυκεῖα φροντίς. σφῷν γὰρ ἐστερημένη
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1037.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1037.1.text#λυπρὸν διάξω βίοτον ἀλγεινόν τ' ἐμοί.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1038.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1038.1.text#ὑμεῖς δὲ μητέρ' οὐκέτ' ὄμμασιν φίλοις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1039.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1039.1.text#ὄψεσθ', ἐς ἄλλο σχῆμ' ἀποστάντες βίου.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1040.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1040.1.text#φεῦ φεῦ· τί προσδέρκεσθέ μ' ὄμμασιν, τέκνα;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1041.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1041.1.text#τί προσγελᾶτε τὸν πανύστατον γέλων;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1042.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1042.1.text#αἰαῖ· τί δράσω; καρδία γὰρ οἴχεται,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1043.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1043.1.text#γυναῖκες, ὄμμα φαιδρὸν ὡς εἶδον τέκνων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1044.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1044.1.text#οὐκ ἂν δυναίμην· χαιρέτω βουλεύματα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1045.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1045.1.text#τὰ πρόσθεν· ἄξω παῖδας ἐκ γαίας ἐμούς.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1046.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1046.1.text#τί δεῖ με πατέρα τῶνδε τοῖς τούτων κακοῖς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1047.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1047.1.text#λυποῦσαν αὐτὴν δὶς τόσα κτᾶσθαι κακά;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1048.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1048.1.text#οὐ δῆτ' ἔγωγε. χαιρέτω βουλεύματα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1049.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1049.1.text#καίτοι τί πάσχω; βούλομαι γέλωτ' ὀφλεῖν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1050.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1050.1.text#ἐχθροὺς μεθεῖσα τοὺς ἐμοὺς ἀζημίους;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1051.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1051.1.text#τολμητέον τάδ'. ἀλλὰ τῆς ἐμῆς κάκης,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1052.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1052.1.text#τὸ καὶ προσέσθαι μαλθακοὺς λόγους φρενί.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1053.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1053.1.text#χωρεῖτε, παῖδες, ἐς δόμους. ὅτῳ δὲ μὴ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1054.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1054.1.text#θέμις παρεῖναι τοῖς ἐμοῖσι θύμασιν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1055.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1055.1.text#αὐτῷ μελήσει· χεῖρα δ' οὐ διαφθερῶ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1056.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1056.1.text#ἆ ἆ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1056.2.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1056.2.text#μὴ δῆτα, θυμέ, μὴ σύ γ' ἐργάσῃ τάδε·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1057.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1057.1.text#ἔασον αὐτούς, ὦ τάλαν, φεῖσαι τέκνων·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1058.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1058.1.text#ἐκεῖ μεθ' ἡμῶν ζῶντες εὐφρανοῦσί σε.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1059.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1059.1.text#μὰ τοὺς παρ' Ἅιδῃ νερτέρους ἀλάστορας,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1060.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1060.1.text#οὔτοι ποτ' ἔσται τοῦθ' ὅπως ἐχθροῖς ἐγὼ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1061.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1061.1.text#παῖδας παρήσω τοὺς ἐμοὺς καθυβρίσαι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1062.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1062.1.text#[ πάντως σφ' ἀνάγκη κατθανεῖν· ἐπεὶ δὲ χρή, ]
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1063.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1063.1.text#[ ἡμεῖς κτενοῦμεν οἵπερ ἐξεφύσαμεν. ]
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1064.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1064.1.text#πάντως πέπρακται ταῦτα κοὐκ ἐκφεύξεται.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1065.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1065.1.text#καὶ δὴ 'πὶ κρατὶ στέφανος, ἐν πέπλοισι δὲ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1066.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1066.1.text#νύμφη τύραννος ὄλλυται, σάφ' οἶδ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1067.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1067.1.text#ἀλλ', εἶμι γὰρ δὴ τλημονεστάτην ὁδόν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1068.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1068.1.text#καὶ τούσδε πέμψω τλημονεστέραν ἔτι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1069.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1069.1.text#παῖδας προσειπεῖν βούλομαι.—δότ', ὦ τέκνα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1070.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1070.1.text#δότ' ἀσπάσασθαι μητρὶ δεξιὰν χέρα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1071.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1071.1.text#ὦ φιλτάτη χείρ, φίλτατον δέ μοι στόμα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1072.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1072.1.text#καὶ σχῆμα καὶ πρόσωπον εὐγενὲς τέκνων,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1073.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1073.1.text#εὐδαιμονοῖτον, ἀλλ' ἐκεῖ· τὰ δ' ἐνθάδε
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1074.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1074.1.text#πατὴρ ἀφείλετ'. ὦ γλυκεῖα προσβολή,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1075.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1075.1.text#ὦ μαλθακὸς χρὼς πνεῦμά θ' ἥδιστον τέκνων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1076.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1076.1.text#χωρεῖτε χωρεῖτ'· οὐκέτ' εἰμὶ προσβλέπειν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1077.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1077.1.text#οἵα τε { πρὸς ὑμᾶς }, ἀλλὰ νικῶμαι κακοῖς.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1078.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1078.1.text#καὶ μανθάνω μὲν οἷα δρᾶν μέλλω κακά,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1079.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1079.1.text#θυμὸς δὲ κρείσσων τῶν ἐμῶν βουλευμάτων,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1080.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1080.1.text#ὅσπερ μεγίστων αἴτιος κακῶν βροτοῖς.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1081.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1081.1.text#πολλάκις ἤδη
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1082.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1082.1.text#διὰ λεπτοτέρων μύθων ἔμολον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1083.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1083.1.text#καὶ πρὸς ἁμίλλας ἦλθον μείζους
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1084.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1084.1.text#ἢ χρὴ γενεὰν θῆλυν ἐρευνᾶν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1085.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1085.1.text#ἀλλὰ γὰρ ἔστιν μοῦσα καὶ ἡμῖν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1086.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1086.1.text#ἣ προσομιλεῖ σοφίας ἕνεκεν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1087.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1087.1.text#πάσαισι μὲν οὔ· παῦρον { δὲ δὴ }
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1088.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1088.1.text#{ γένος ἐν πολλαῖς εὕροις ἂν ἴσως }
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1089.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1089.1.text#κοὐκ ἀπόμουσον τὸ γυναικῶν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1090.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1090.1.text#καί φημι βροτῶν οἵτινές εἰσιν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1091.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1091.1.text#πάμπαν ἄπειροι μηδ' ἐφύτευσαν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1092.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1092.1.text#παῖδας, προφέρειν εἰς εὐτυχίαν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1093.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1093.1.text#τῶν γειναμένων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1094.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1094.1.text#οἱ μὲν ἄτεκνοι δι' ἀπειροσύνην
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1095.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1095.1.text#εἴθ' ἡδὺ βροτοῖς εἴτ' ἀνιαρὸν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1096.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1096.1.text#παῖδες τελέθουσ' οὐχὶ τυχόντες
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1097.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1097.1.text#πολλῶν μόχθων ἀπέχονται·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1098.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1098.1.text#οἷσι δὲ τέκνων ἔστιν ἐν οἴκοις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1099.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1099.1.text#γλυκερὸν { βλάστημ', ὁρῶ } μελέτῃ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1100.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1100.1.text#κατατρυχομένους τὸν ἅπαντα χρόνον,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1101.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1101.1.text#πρῶτον μὲν ὅπως θρέψουσι καλῶς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1102.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1102.1.text#βίοτόν θ' ὁπόθεν λείψουσι τέκνοις·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1103.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1103.1.text#ἔτι δ' ἐκ τούτων εἴτ' ἐπὶ φλαύροις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1104.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1104.1.text#εἴτ' ἐπὶ χρηστοῖς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1104a.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1104a.1.text#μοχθοῦσι, τόδ' ἐστὶν ἄδηλον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1105.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1105.1.text#ἓν δὲ τὸ πάντων λοίσθιον ἤδη
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1106.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1106.1.text#πᾶσιν κατερῶ θνητοῖσι κακόν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1107.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1107.1.text#καὶ δὴ γὰρ ἅλις βίοτόν θ' ηὗρον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1108.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1108.1.text#σῶμά τ' ἐς ἥβην ἤλυθε τέκνων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1109.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1109.1.text#χρηστοί τ' ἐγένοντ'· εἰ δὲ κυρήσαι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1110.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1110.1.text#δαίμων οὕτως, φροῦδος ἐς Ἅιδην
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1111.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1111.1.text#θάνατος προφέρων σώματα τέκνων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1112.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1112.1.text#πῶς οὖν λύει πρὸς τοῖς ἄλλοις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1113.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1113.1.text#τήνδ' ἔτι λύπην ἀνιαροτάτην
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1114.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1114.1.text#παίδων ἕνεκεν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1115.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1115.1.text#θνητοῖσι θεοὺς ἐπιβάλλειν;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1116.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1116.1.text#φίλαι, πάλαι τοι προσμένουσα τὴν τύχην
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1117.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1117.1.text#καραδοκῶ τἀκεῖθεν οἷ προβήσεται.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1118.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1118.1.text#καὶ δὴ δέδορκα τόνδε τῶν Ἰάσονος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1119.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1119.1.text#στείχοντ' ὀπαδῶν· πνεῦμα δ' ἠρεθισμένον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1120.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1120.1.text#δείκνυσιν ὥς τι καινὸν ἀγγελεῖ κακόν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1121.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1121.1.text#ὦ δεινὸν ἔργον παρανόμως εἰργασμένη,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1122.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1122.1.text#Μήδεια, φεῦγε φεῦγε, μήτε ναΐαν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1123.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1123.1.text#λιποῦσ' ἀπήνην μήτ' ὄχον πεδοστιβῆ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1124.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1124.1.text#τί δ' ἄξιόν μοι τῆσδε τυγχάνει φυγῆς;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1125.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1125.1.text#ὄλωλεν ἡ τύραννος ἀρτίως κόρη
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1126.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1126.1.text#Κρέων θ' ὁ φύσας φαρμάκων τῶν σῶν ὕπο.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1127.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1127.1.text#κάλλιστον εἶπας μῦθον, ἐν δ' εὐεργέταις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1128.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1128.1.text#τὸ λοιπὸν ἤδη καὶ φίλοις ἐμοῖς ἔσῃ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1129.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1129.1.text#τί φῄς; φρονεῖς μὲν ὀρθὰ κοὐ μαίνῃ, γύναι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1130.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1130.1.text#ἥτις, τυράννων ἑστίαν ᾐκισμένη,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1131.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1131.1.text#χαίρεις κλύουσα κοὐ φοβῇ τὰ τοιάδε;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1132.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1132.1.text#ἔχω τι κἀγὼ τοῖς γε σοῖς ἐναντίον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1133.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1133.1.text#λόγοισιν εἰπεῖν· ἀλλὰ μὴ σπέρχου, φίλος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1134.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1134.1.text#λέξον δέ· πῶς ὤλοντο; δὶς τόσον γὰρ ἂν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1135.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1135.1.text#τέρψειας ἡμᾶς, εἰ τεθνᾶσι παγκάκως.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1136.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1136.1.text#ἐπεὶ τέκνων σῶν ἦλθε δίπτυχος γονὴ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1137.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1137.1.text#σὺν πατρί, καὶ παρῆλθε νυμφικοὺς δόμους,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1138.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1138.1.text#ἥσθημεν οἵπερ σοῖς ἐκάμνομεν κακοῖς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1139.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1139.1.text#δμῶες· δι' ὤτων δ' εὐθὺς ἦν πολὺς λόγος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1140.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1140.1.text#σὲ καὶ πόσιν σὸν νεῖκος ἐσπεῖσθαι τὸ πρίν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1141.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1141.1.text#κυνεῖ δ' ὃ μέν τις χεῖρ', ὃ δὲ ξανθὸν κάρα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1142.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1142.1.text#παίδων· ἐγὼ δὲ καὐτὸς ἡδονῆς ὕπο
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1143.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1143.1.text#στέγας γυναικῶν σὺν τέκνοις ἅμ' ἑσπόμην.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1144.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1144.1.text#δέσποινα δ' ἣν νῦν ἀντὶ σοῦ θαυμάζομεν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1145.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1145.1.text#πρὶν μὲν τέκνων σῶν εἰσιδεῖν ξυνωρίδα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1146.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1146.1.text#πρόθυμον εἶχ' ὀφθαλμὸν εἰς Ἰάσονα·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1147.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1147.1.text#ἔπειτα μέντοι προὐκαλύψατ' ὄμματα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1148.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1148.1.text#λευκήν τ' ἀπέστρεψ' ἔμπαλιν παρηίδα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1149.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1149.1.text#παίδων μυσαχθεῖσ' εἰσόδους· πόσις δὲ σὸς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1150.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1150.1.text#ὀργάς τ' ἀφῄρει καὶ χόλον νεάνιδος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1151.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1151.1.text#λέγων τάδ'· Οὐ μὴ δυσμενὴς ἔσῃ φίλοις,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1152.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1152.1.text#παύσῃ δὲ θυμοῦ καὶ πάλιν στρέψεις κάρα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1153.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1153.1.text#φίλους νομίζουσ' οὕσπερ ἂν πόσις σέθεν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1154.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1154.1.text#δέξῃ δὲ δῶρα καὶ παραιτήσῃ πατρὸς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1155.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1155.1.text#φυγὰς ἀφεῖναι παισὶ τοῖσδ', ἐμὴν χάριν;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1156.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1156.1.text#ἣ δ' ὡς ἐσεῖδε κόσμον, οὐκ ἠνέσχετο,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1157.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1157.1.text#ἀλλ' ᾔνεσ' ἀνδρὶ πάντα, καὶ πρὶν ἐκ δόμων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1158.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1158.1.text#μακρὰν ἀπεῖναι πατέρα καὶ παῖδας, [ σέθεν ]
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1159.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1159.1.text#λαβοῦσα πέπλους ποικίλους ἠμπέσχετο,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1160.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1160.1.text#χρυσοῦν τε θεῖσα στέφανον ἀμφὶ βοστρύχοις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1161.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1161.1.text#λαμπρῷ κατόπτρῳ σχηματίζεται κόμην,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1162.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1162.1.text#ἄψυχον εἰκὼ προσγελῶσα σώματος.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1163.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1163.1.text#κἄπειτ' ἀναστᾶσ' ἐκ θρόνων διέρχεται
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1164.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1164.1.text#στέγας, ἁβρὸν βαίνουσα παλλεύκῳ ποδί,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1165.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1165.1.text#δώροις ὑπερχαίρουσα, πολλὰ πολλάκις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1166.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1166.1.text#τένοντ' ἐς ὀρθὸν ὄμμασι σκοπουμένη.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1167.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1167.1.text#τοὐνθένδε μέντοι δεινὸν ἦν θέαμ' ἰδεῖν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1168.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1168.1.text#χροιὰν γὰρ ἀλλάξασα λεχρία πάλιν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1169.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1169.1.text#χωρεῖ τρέμουσα κῶλα καὶ μόλις φθάνει
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1170.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1170.1.text#θρόνοισιν ἐμπεσοῦσα μὴ χαμαὶ πεσεῖν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1171.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1171.1.text#καί τις γεραιὰ προσπόλων, δόξασά που
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1172.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1172.1.text#ἢ Πανὸς ὀργὰς ἢ τινὸς θεῶν μολεῖν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1173.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1173.1.text#ἀνωλόλυξε, πρίν γ' ὁρᾷ διὰ στόμα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1174.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1174.1.text#χωροῦντα λευκὸν ἀφρόν, ὀμμάτων τ' ἄπο
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1175.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1175.1.text#κόρας στρέφουσαν, αἷμά τ' οὐκ ἐνὸν χροΐ·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1176.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1176.1.text#εἶτ' ἀντίμολπον ἧκεν ὀλολυγῆς μέγαν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1177.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1177.1.text#κωκυτόν. εὐθὺς δ' ἣ μὲν ἐς πατρὸς δόμους
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1178.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1178.1.text#ὥρμησεν, ἣ δὲ πρὸς τὸν ἀρτίως πόσιν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1179.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1179.1.text#φράσουσα νύμφης συμφοράν· ἅπασα δὲ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1180.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1180.1.text#στέγη πυκνοῖσιν ἐκτύπει δρομήμασιν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1181.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1181.1.text#ἤδη δ' ἀνέλκων κῶλον ἔκπλεθρον δρόμου
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1182.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1182.1.text#ταχὺς βαδιστὴς τερμόνων ἂν ἥπτετο,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1183.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1183.1.text#ἣ δ' ἐξ ἀναύδου καὶ μύσαντος ὄμματος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1184.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1184.1.text#δεινὸν στενάξασ' ἡ τάλαιν' ἠγείρετο.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1185.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1185.1.text#διπλοῦν γὰρ αὐτῇ πῆμ' ἐπεστρατεύετο·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1186.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1186.1.text#χρυσοῦς μὲν ἀμφὶ κρατὶ κείμενος πλόκος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1187.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1187.1.text#θαυμαστὸν ἵει νᾶμα παμφάγου πυρός,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1188.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1188.1.text#πέπλοι δὲ λεπτοί, σῶν τέκνων δωρήματα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1189.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1189.1.text#λεπτὴν ἔδαπτον σάρκα τῆς δυσδαίμονος.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1190.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1190.1.text#φεύγει δ' ἀναστᾶσ' ἐκ θρόνων πυρουμένη,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1191.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1191.1.text#σείουσα χαίτην κρᾶτά τ' ἄλλοτ' ἄλλοσε,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1192.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1192.1.text#ῥῖψαι θέλουσα στέφανον· ἀλλ' ἀραρότως
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1193.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1193.1.text#σύνδεσμα χρυσὸς εἶχε, πῦρ δ', ἐπεὶ κόμην
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1194.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1194.1.text#ἔσεισε, μᾶλλον δὶς τόσως ἐλάμπετο.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1195.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1195.1.text#πίτνει δ' ἐς οὖδας συμφορᾷ νικωμένη,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1196.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1196.1.text#πλὴν τῷ τεκόντι κάρτα δυσμαθὴς ἰδεῖν·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1197.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1197.1.text#οὔτ' ὀμμάτων γὰρ δῆλος ἦν κατάστασις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1198.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1198.1.text#οὔτ' εὐφυὲς πρόσωπον, αἷμα δ' ἐξ ἄκρου
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1199.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1199.1.text#ἔσταζε κρατὸς συμπεφυρμένον πυρί,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1200.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1200.1.text#σάρκες δ' ἀπ' ὀστέων ὥστε πεύκινον δάκρυ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1201.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1201.1.text#γναθμοῖς ἀδήλοις φαρμάκων ἀπέρρεον,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1202.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1202.1.text#δεινὸν θέαμα· πᾶσι δ' ἦν φόβος θιγεῖν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1203.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1203.1.text#νεκροῦ· τύχην γὰρ εἴχομεν διδάσκαλον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1204.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1204.1.text#πατὴρ δ' ὁ τλήμων συμφορᾶς ἀγνωσίᾳ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1205.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1205.1.text#ἄφνω προσελθὼν δῶμα προσπίτνει νεκρῷ·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1206.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1206.1.text#ᾤμωξε δ' εὐθύς, καὶ περιπτύξας χέρας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1207.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1207.1.text#κυνεῖ προσαυδῶν τοιάδ'· Ὦ δύστηνε παῖ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1208.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1208.1.text#τίς σ' ὧδ' ἀτίμως δαιμόνων ἀπώλεσε;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1209.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1209.1.text#τίς τὸν γέροντα τύμβον ὀρφανὸν σέθεν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1210.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1210.1.text#τίθησιν; οἴμοι, συνθάνοιμί σοι, τέκνον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1211.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1211.1.text#ἐπεὶ δὲ θρήνων καὶ γόων ἐπαύσατο,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1212.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1212.1.text#χρῄζων γεραιὸν ἐξαναστῆσαι δέμας
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1213.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1213.1.text#προσείχεθ' ὥστε κισσὸς ἔρνεσιν δάφνης
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1214.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1214.1.text#λεπτοῖσι πέπλοις, δεινὰ δ' ἦν παλαίσματα·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1215.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1215.1.text#ὃ μὲν γὰρ ἤθελ' ἐξαναστῆσαι γόνυ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1216.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1216.1.text#ἣ δ' ἀντελάζυτ'. εἰ δὲ πρὸς βίαν ἄγοι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1217.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1217.1.text#σάρκας γεραιὰς ἐσπάρασσ' ἀπ' ὀστέων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1218.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1218.1.text#χρόνῳ δ' ἀπέσβη καὶ μεθῆχ' ὁ δύσμορος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1219.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1219.1.text#ψυχήν· κακοῦ γὰρ οὐκέτ' ἦν ὑπέρτερος.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1220.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1220.1.text#κεῖνται δὲ νεκροὶ παῖς τε καὶ γέρων πατὴρ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1221.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1221.1.text#πέλας, ποθεινὴ δακρύοισι συμφορά.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1222.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1222.1.text#καί μοι τὸ μὲν σὸν ἐκποδὼν ἔστω λόγου·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1223.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1223.1.text#γνώσῃ γὰρ αὐτὴ ζημίας ἀποστροφήν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1224.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1224.1.text#τὰ θνητὰ δ' οὐ νῦν πρῶτον ἡγοῦμαι σκιάν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1225.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1225.1.text#οὐδ' ἂν τρέσας εἴποιμι τοὺς σοφοὺς βροτῶν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1226.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1226.1.text#δοκοῦντας εἶναι καὶ μεριμνητὰς λόγων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1227.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1227.1.text#τούτους μεγίστην ζημίαν ὀφλισκάνειν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1228.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1228.1.text#θνητῶν γὰρ οὐδείς ἐστιν εὐδαίμων ἀνήρ·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1229.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1229.1.text#ὄλβου δ' ἐπιρρυέντος εὐτυχέστερος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1230.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1230.1.text#ἄλλου γένοιτ' ἂν ἄλλος, εὐδαίμων δ' ἂν οὔ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1231.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1231.1.text#ἔοιχ' ὁ δαίμων πολλὰ τῇδ' ἐν ἡμέρᾳ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1232.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1232.1.text#κακὰ ξυνάπτειν ἐνδίκως Ἰάσονι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1233.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1233.1.text#ὦ τλῆμον, ὥς σου συμφορὰς οἰκτίρομεν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1234.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1234.1.text#κόρη Κρέοντος, ἥτις εἰς Ἅιδου δόμους
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1235.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1235.1.text#οἴχῃ γάμων ἕκατι τῶν Ἰάσονος.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1236.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1236.1.text#φίλαι, δέδοκται τοὔργον ὡς τάχιστά μοι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1237.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1237.1.text#παῖδας κτανούσῃ τῆσδ' ἀφορμᾶσθαι χθονός,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1238.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1238.1.text#καὶ μὴ σχολὴν ἄγουσαν ἐκδοῦναι τέκνα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1239.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1239.1.text#ἄλλῃ φονεῦσαι δυσμενεστέρᾳ χερί.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1240.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1240.1.text#πάντως σφ' ἀνάγκη κατθανεῖν· ἐπεὶ δὲ χρή,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1241.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1241.1.text#ἡμεῖς κτενοῦμεν, οἵπερ ἐξεφύσαμεν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1242.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1242.1.text#ἀλλ' εἶ' ὁπλίζου, καρδία. τί μέλλομεν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1243.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1243.1.text#τὰ δεινὰ κἀναγκαῖα μὴ πράσσειν κακά;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1244.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1244.1.text#ἄγ', ὦ τάλαινα χεὶρ ἐμή, λαβὲ ξίφος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1245.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1245.1.text#λάβ', ἕρπε πρὸς βαλβῖδα λυπηρὰν βίου,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1246.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1246.1.text#καὶ μὴ κακισθῇς μηδ' ἀναμνησθῇς τέκνων,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1247.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1247.1.text#ὡς φίλταθ', ὡς ἔτικτες· ἀλλὰ τήνδε γε
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1248.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1248.1.text#λαθοῦ βραχεῖαν ἡμέραν παίδων σέθεν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1249.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1249.1.text#κἄπειτα θρήνει· καὶ γὰρ εἰ κτενεῖς σφ', ὅμως
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1250.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1250.1.text#φίλοι γ' ἔφυσαν—δυστυχὴς δ' ἐγὼ γυνή.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1251.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1251.1.text#ἰὼ Γᾶ τε καὶ παμφαὴς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1252.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1252.1.text#ἀκτὶς Ἀελίου, κατίδετ' ἴδετε τὰν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1253.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1253.1.text#ὀλομέναν γυναῖκα, πρὶν φοινίαν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1254.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1254.1.text#τέκνοις προσβαλεῖν χέρ' αὐτοκτόνον·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1255.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1255.1.text#τεᾶς γὰρ ἀπὸ χρυσέας γονᾶς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1256.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1256.1.text#ἔβλαστεν, θεοῦ δ' { αἷμά τι } πίτνειν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1257.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1257.1.text#φόβος ὑπ' ἀνέρων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1258.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1258.1.text#ἀλλά νιν, ὦ φάος διογενές, κάτειργε
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1259.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1259.1.text# κατάπαυσον, ἔξελ' οἴκων φονίαν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1260.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1260.1.text#τάλαινάν τ' Ἐρινὺν ὑπ' ἀλαστόρων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1261.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1261.1.text#μάταν μόχθος ἔρρει τέκνων,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1262.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1262.1.text#ἆρα μάταν γένος φίλιον ἔτεκες, ὦ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1263.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1263.1.text#κυανεᾶν λιποῦσα Συμπληγάδων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1264.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1264.1.text#πετρᾶν ἀξενωτάταν ἐσβολάν;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1265.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1265.1.text#δειλαία, τί σοι φρενῶν βαρὺς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1266.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1266.1.text#χόλος προσπίτνει καὶ δυσμενὴς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1267.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1267.1.text#φόνος; ἀμείβεται
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1268.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1268.1.text#χαλεπὰ γὰρ βροτοῖς ὁμογενῆ μιάσματα
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1269.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1269.1.text# { ἐπὶ γαῖαν αὐτοφόνταις ξυνῳ- }
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1270.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1270.1.text#{ δὰ θεόθεν πίτνοντ' ἐπὶ δόμοις ἄχη. }
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1270.2.speaker#{ Παῖδες }
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1270.2.text#{ αἰαῖ. }
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1273.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1273.1.text#—ἀκούεις βοὰν ἀκούεις τέκνων;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1274.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1274.1.text#—ἰὼ τλᾶμον, ὦ κακοτυχὲς γύναι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1271.1.speaker#Παῖδες
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1271.1.text#—οἴμοι, τί δράσω; ποῖ φύγω μητρὸς χέρας;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1272.1.speaker#Παῖδες
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1272.1.text#—οὐκ οἶδ', ἄδελφε φίλτατ'· ὀλλύμεσθα γάρ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1275.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1275.1.text#παρέλθω δόμους; ἀρῆξαι φόνον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1276.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1276.1.text#δοκεῖ μοι τέκνοις.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1277.1.speaker#Παῖδες
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1277.1.text#—ναί, πρὸς θεῶν, ἀρήξατ'· ἐν δέοντι γάρ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1278.1.speaker#Παῖδες
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1278.1.text#—ὡς ἐγγὺς ἤδη γ' ἐσμὲν ἀρκύων ξίφους.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1279.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1279.1.text#—τάλαιν', ὡς ἄρ' ἦσθα πέτρος ἢ σίδαρος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1280.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1280.1.text# ἅτις τέκνων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1281.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1281.1.text#ὃν ἔτεκες ἄροτον αὐτόχειρι μοίρᾳ κτενεῖς.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1282.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1282.1.text#—μίαν δὴ κλύω μίαν τῶν πάρος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1283.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1283.1.text#γυναῖκ' ἐν φίλοις χέρα βαλεῖν τέκνοις·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1284.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1284.1.text#Ἰνὼ μανεῖσαν ἐκ θεῶν, ὅθ' ἡ Διὸς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1285.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1285.1.text#δάμαρ νιν ἐξέπεμψε δωμάτων ἄλῃ·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1286.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1286.1.text#πίτνει δ' ἁ τάλαιν' ἐς ἅλμαν φόνῳ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1287.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1287.1.text#τέκνων δυσσεβεῖ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1288.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1288.1.text#ἀκτῆς ὑπερτείνασα ποντίας πόδα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1289.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1289.1.text#δυοῖν τε παίδοιν συνθανοῦσ' ἀπόλλυται.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1290.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1290.1.text#τί δῆτ' οὖν γένοιτ' ἂν ἔτι δεινόν; ὦ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1291.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1291.1.text#γυναικῶν λέχος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1292.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1292.1.text#πολύπονον, ὅσα βροτοῖς ἔρεξας ἤδη κακά.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1293.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1293.1.text#γυναῖκες, αἳ τῆσδ' ἐγγὺς ἕστατε στέγης,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1294.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1294.1.text#ἆρ' ἐν δόμοισιν ἡ τὰ δείν' εἰργασμένη
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1295.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1295.1.text#Μήδεια τοῖσδ' ἔτ', ἢ μεθέστηκεν φυγῇ;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1296.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1296.1.text#δεῖ γάρ νιν ἤτοι γῆς γε κρυφθῆναι κάτω,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1297.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1297.1.text#ἢ πτηνὸν ἆραι σῶμ' ἐς αἰθέρος βάθος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1298.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1298.1.text#εἰ μὴ τυράννων δώμασιν δώσει δίκην·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1299.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1299.1.text#πέποιθ' ἀποκτείνασα κοιράνους χθονὸς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1300.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1300.1.text#ἀθῷος αὐτὴ τῶνδε φεύξεσθαι δόμων;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1301.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1301.1.text#ἀλλ' οὐ γὰρ αὐτῆς φροντίδ' ὡς τέκνων ἔχω·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1302.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1302.1.text#κείνην μὲν οὓς ἔδρασεν ἔρξουσιν κακῶς,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1303.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1303.1.text#ἐμῶν δὲ παίδων ἦλθον ἐκσῴσων βίον,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1304.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1304.1.text#μή μοί τι δράσωσ' οἱ προσήκοντες γένει,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1305.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1305.1.text#μητρῷον ἐκπράσσοντες ἀνόσιον φόνον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1306.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1306.1.text#ὦ τλῆμον, οὐκ οἶσθ' οἷ κακῶν ἐλήλυθας,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1307.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1307.1.text#Ἰᾶσον· οὐ γὰρ τούσδ' ἂν ἐφθέγξω λόγους.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1308.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1308.1.text#τί δ' ἔστιν; ἦ που κἄμ' ἀποκτεῖναι θέλει;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1309.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1309.1.text#παῖδες τεθνᾶσι χειρὶ μητρῴᾳ σέθεν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1310.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1310.1.text#οἴμοι τί λέξεις; ὥς μ' ἀπώλεσας, γύναι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1311.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1311.1.text#ὡς οὐκέτ' ὄντων σῶν τέκνων φρόντιζε δή.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1312.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1312.1.text#ποῦ γάρ νιν ἔκτειν'; ἐντὸς ἢ ἔξωθεν δόμων;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1313.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1313.1.text#πύλας ἀνοίξας σῶν τέκνων ὄψῃ φόνον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1314.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1314.1.text#χαλᾶτε κλῇδας ὡς τάχιστα, πρόσπολοι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1315.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1315.1.text#ἐκλύεθ' ἁρμούς, ὡς ἴδω διπλοῦν κακόν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1316.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1316.1.text#τοὺς μὲν θανόντας—τὴν δὲ τείσωμαι δίκην.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1317.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1317.1.text#τί τάσδε κινεῖς κἀναμοχλεύεις πύλας,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1318.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1318.1.text#νεκροὺς ἐρευνῶν κἀμὲ τὴν εἰργασμένην;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1319.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1319.1.text#παῦσαι πόνου τοῦδ'. εἰ δ' ἐμοῦ χρείαν ἔχεις,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1320.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1320.1.text#λέγ', εἴ τι βούλῃ, χειρὶ δ' οὐ ψαύσεις ποτέ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1321.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1321.1.text#τοιόνδ' ὄχημα πατρὸς Ἥλιος πατὴρ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1322.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1322.1.text#δίδωσιν ἡμῖν, ἔρυμα πολεμίας χερός.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1323.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1323.1.text#ὦ μῖσος, ὦ μέγιστον ἐχθίστη γύναι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1324.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1324.1.text#θεοῖς τε κἀμοὶ παντί τ' ἀνθρώπων γένει,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1325.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1325.1.text#ἥτις τέκνοισι σοῖσιν ἐμβαλεῖν ξίφος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1326.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1326.1.text#ἔτλης τεκοῦσα, κἄμ' ἄπαιδ' ἀπώλεσας·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1327.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1327.1.text#καὶ ταῦτα δράσασ' ἥλιόν τε προσβλέπεις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1328.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1328.1.text#καὶ γαῖαν, ἔργον τλᾶσα δυσσεβέστατον·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1329.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1329.1.text#ὄλοι'· ἐγὼ δὲ νῦν φρονῶ, τότ' οὐ φρονῶν,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1330.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1330.1.text#ὅτ' ἐκ δόμων σε βαρβάρου τ' ἀπὸ χθονὸς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1331.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1331.1.text#Ἕλλην' ἐς οἶκον ἠγόμην, κακὸν μέγα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1332.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1332.1.text#πατρός τε καὶ γῆς προδότιν ἥ σ' ἐθρέψατο.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1333.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1333.1.text#τὸν σὸν δ' ἀλάστορ' εἰς ἔμ' ἔσκηψαν θεοί·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1334.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1334.1.text#κτανοῦσα γὰρ δὴ σὸν κάσιν παρέστιον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1335.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1335.1.text#τὸ καλλίπρῳρον εἰσέβης Ἀργοῦς σκάφος.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1336.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1336.1.text#ἤρξω μὲν ἐκ τοιῶνδε· νυμφευθεῖσα δὲ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1337.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1337.1.text#παρ' ἀνδρὶ τῷδε καὶ τεκοῦσά μοι τέκνα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1338.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1338.1.text#εὐνῆς ἕκατι καὶ λέχους σφ' ἀπώλεσας.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1339.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1339.1.text#οὐκ ἔστιν ἥτις τοῦτ' ἂν Ἑλληνὶς γυνὴ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1340.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1340.1.text#ἔτλη ποθ', ὧν γε πρόσθεν ἠξίουν ἐγὼ
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1341.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1341.1.text#γῆμαι σέ, κῆδος ἐχθρὸν ὀλέθριόν τ' ἐμοί,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1342.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1342.1.text#λέαιναν, οὐ γυναῖκα, τῆς Τυρσηνίδος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1343.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1343.1.text#Σκύλλης ἔχουσαν ἀγριωτέραν φύσιν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1344.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1344.1.text#ἀλλ' οὐ γὰρ ἄν σε μυρίοις ὀνείδεσι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1345.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1345.1.text#δάκοιμι· τοιόνδ' ἐμπέφυκέ σοι θράσος·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1346.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1346.1.text#ἔρρ', αἰσχροποιὲ καὶ τέκνων μιαιφόνε·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1347.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1347.1.text#ἐμοὶ δὲ τὸν ἐμὸν δαίμον' αἰάζειν πάρα,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1348.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1348.1.text#ὃς οὔτε λέκτρων νεογάμων ὀνήσομαι,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1349.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1349.1.text#οὐ παῖδας οὓς ἔφυσα κἀξεθρεψάμην
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1350.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1350.1.text#ἕξω προσειπεῖν ζῶντας, ἀλλ' ἀπώλεσα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1351.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1351.1.text#μακρὰν ἂν ἐξέτεινα τοῖσδ' ἐναντίον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1352.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1352.1.text#λόγοισιν, εἰ μὴ Ζεὺς πατὴρ ἠπίστατο
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1353.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1353.1.text#οἷ' ἐξ ἐμοῦ πέπονθας οἷά τ' εἰργάσω·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1354.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1354.1.text#σὺ δ' οὐκ ἔμελλες τἄμ' ἀτιμάσας λέχη
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1355.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1355.1.text#τερπνὸν διάξειν βίοτον ἐγγελῶν ἐμοί·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1356.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1356.1.text#οὐδ' ἡ τύραννος, οὐδ' ὁ σοὶ προσθεὶς γάμους
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1357.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1357.1.text#Κρέων ἀνατεὶ τῆσδέ μ' ἐκβαλεῖν χθονός.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1358.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1358.1.text#πρὸς ταῦτα καὶ λέαιναν, εἰ βούλῃ, κάλει
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1359.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1359.1.text#καὶ Σκύλλαν ἣ Τυρσηνὸν { ᾤκησεν πέδον· }
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1360.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1360.1.text#τῆς σῆς γὰρ ὡς χρὴ καρδίας ἀνθηψάμην.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1361.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1361.1.text#καὐτή γε λυπῇ καὶ κακῶν κοινωνὸς εἶ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1362.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1362.1.text#σάφ' ἴσθι· λύει δ' ἄλγος, ἢν σὺ μὴ 'γγελᾷς.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1363.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1363.1.text#ὦ τέκνα, μητρὸς ὡς κακῆς ἐκύρσατε.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1364.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1364.1.text#ὦ παῖδες, ὡς ὤλεσθε πατρῴᾳ νόσῳ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1365.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1365.1.text#οὔτοι νυν ἡμὴ δεξιά σφ' ἀπώλεσεν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1366.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1366.1.text#ἀλλ' ὕβρις, οἵ τε σοὶ νεοδμῆτες γάμοι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1367.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1367.1.text#λέχους σφε κἠξίωσας οὕνεκα κτανεῖν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1368.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1368.1.text#σμικρὸν γυναικὶ πῆμα τοῦτ' εἶναι δοκεῖς;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1369.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1369.1.text#ἥτις γε σώφρων· σοὶ δὲ πάντ' ἐστὶν κακά.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1370.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1370.1.text#οἵδ' οὐκέτ' εἰσί· τοῦτο γάρ σε δήξεται.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1371.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1371.1.text#οἵδ' εἰσίν, οἴμοι, σῷ κάρᾳ μιάστορες.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1372.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1372.1.text#ἴσασιν ὅστις ἦρξε πημονῆς θεοί.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1373.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1373.1.text#ἴσασι δῆτα σήν γ' ἀπόπτυστον φρένα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1374.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1374.1.text#στύγει· πικρὰν δὲ βάξιν ἐχθαίρω σέθεν.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1375.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1375.1.text#καὶ μὴν ἐγὼ σήν· ῥᾴδιον δ' ἀπαλλαγαί.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1376.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1376.1.text#πῶς οὖν; τί δράσω; κάρτα γὰρ κἀγὼ θέλω.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1377.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1377.1.text#θάψαι νεκρούς μοι τούσδε καὶ κλαῦσαι πάρες.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1378.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1378.1.text#οὐ δῆτ', ἐπεί σφας τῇδ' ἐγὼ θάψω χερί,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1379.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1379.1.text#φέρουσ' ἐς Ἥρας τέμενος Ἀκραίας θεοῦ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1380.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1380.1.text#ὡς μή τις αὐτοὺς πολεμίων καθυβρίσῃ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1381.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1381.1.text#τύμβους ἀνασπῶν· γῇ δὲ τῇδε Σισύφου
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1382.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1382.1.text#σεμνὴν ἑορτὴν καὶ τέλη προσάψομεν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1383.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1383.1.text#τὸ λοιπὸν ἀντὶ τοῦδε δυσσεβοῦς φόνου.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1384.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1384.1.text#αὐτὴ δὲ γαῖαν εἶμι τὴν Ἐρεχθέως,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1385.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1385.1.text#Αἰγεῖ συνοικήσουσα τῷ Πανδίονος.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1386.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1386.1.text#σὺ δ', ὥσπερ εἰκός, κατθανῇ κακὸς κακῶς,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1387.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1387.1.text#Ἀργοῦς κάρα σὸν λειψάνῳ πεπληγμένος,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1388.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1388.1.text#πικρὰς τελευτὰς τῶν ἐμῶν γάμων ἰδών.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1389.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1389.1.text#ἀλλά σ' Ἐρινὺς ὀλέσειε τέκνων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1390.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1390.1.text#φονία τε Δίκη.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1391.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1391.1.text#τίς δὲ κλύει σοῦ θεὸς ἢ δαίμων,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1392.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1392.1.text#τοῦ ψευδόρκου καὶ ξειναπάτου;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1393.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1393.1.text#φεῦ φεῦ, μυσαρὰ καὶ παιδολέτορ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1394.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1394.1.text#στεῖχε πρὸς οἴκους καὶ θάπτ' ἄλοχον.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1395.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1395.1.text#στείχω, δισσῶν γ' ἄμορος τέκνων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1396.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1396.1.text#οὔπω θρηνεῖς· μένε καὶ γῆρας.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1397.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1397.1.text#ὦ τέκνα φίλτατα.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1397.2.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1397.2.text#μητρί γε, σοὶ δ' οὔ.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1398.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1398.1.text#κἄπειτ' ἔκανες;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1398.2.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1398.2.text#σέ γε πημαίνουσ'.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1399.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1399.1.text#ὤμοι, φιλίου χρῄζω στόματος
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1400.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1400.1.text#παίδων ὁ τάλας προσπτύξασθαι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1401.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1401.1.text#νῦν σφε προσαυδᾷς, νῦν ἀσπάζῃ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1402.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1402.1.text#τότ' ἀπωσάμενος.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1402.2.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1402.2.text#δός μοι πρὸς θεῶν
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1403.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1403.1.text#μαλακοῦ χρωτὸς ψαῦσαι τέκνων.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1404.1.speaker#Μήδεια
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1404.1.text#οὐκ ἔστι· μάτην ἔπος ἔρριπται.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1405.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1405.1.text#Ζεῦ, τάδ' ἀκούεις ὡς ἀπελαυνόμεθ',
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1406.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1406.1.text#οἷά τε πάσχομεν ἐκ τῆς μυσαρᾶς
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1407.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1407.1.text#καὶ παιδοφόνου τῆσδε λεαίνης;
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1408.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1408.1.text#ἀλλ' ὁπόσον γοῦν πάρα καὶ δύναμαι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1409.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1409.1.text#τάδε καὶ θρηνῶ κἀπιθεάζω,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1410.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1410.1.text#μαρτυρόμενος δαίμονας ὥς μοι
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1411.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1411.1.text#τέκνα κτείνασ' ἀποκωλύεις
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1412.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1412.1.text#ψαῦσαί τε χεροῖν θάψαι τε νεκρούς,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1413.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1413.1.text#οὓς μήποτ' ἐγὼ φύσας ὄφελον
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1414.1.speaker#Ἰάσων
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1414.1.text#πρὸς σοῦ φθιμένους ἐπιδέσθαι.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1415.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1415.1.text#πολλῶν ταμίας Ζεὺς ἐν Ὀλύμπῳ,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1416.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1416.1.text#πολλὰ δ' ἀέλπτως κραίνουσι θεοί·
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1417.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1417.1.text#καὶ τὰ δοκηθέντ' οὐκ ἐτελέσθη,
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1418.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1418.1.text#τῶν δ' ἀδοκήτων πόρον ηὗρε θεός.
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1419.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg003.fu-sp:1419.1.text#τοιόνδ' ἀπέβη τόδε πρᾶγμα.
