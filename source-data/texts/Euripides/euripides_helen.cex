#!ctsdata
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1.1.text#Νείλου μὲν αἵδε καλλιπάρθενοι ῥοαί,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:2.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:2.1.text#ὃς ἀντὶ δίας ψακάδος Αἰγύπτου πέδον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:3.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:3.1.text#λευκῆς τακείσης χιόνος ὑγραίνει γύας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:4.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:4.1.text#Πρωτεὺς δ' ὅτ' ἔζη τῆσδε γῆς τύραννος ἦν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:5.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:5.1.text#Φάρον μὲν οἰκῶν νῆσον, Αἰγύπτου δ' ἄναξ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:6.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:6.1.text#ὃς τῶν κατ' οἶδμα παρθένων μίαν γαμεῖ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:7.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:7.1.text#Ψαμάθην, ἐπειδὴ λέκτρ' ἀφῆκεν Αἰακοῦ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:8.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:8.1.text#τίκτει δὲ τέκνα δισσὰ τοῖσδε δώμασι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:9.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:9.1.text#Θεοκλύμενον ἄρσεν' [ ὅτι δὴ θεοὺς σέβων ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:10.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:10.1.text#[ βίον διήνεγκ' ] εὐγενῆ τε παρθένον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:11.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:11.1.text#Εἰδώ, τὸ μητρὸς ἀγλάισμ', ὅτ' ἦν βρέφος·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:12.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:12.1.text#ἐπεὶ δ' ἐς ἥβην ἦλθεν ὡραίαν γάμων,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:13.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:13.1.text#καλοῦσιν αὐτὴν Θεονόην· τὰ θεῖα γὰρ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:14.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:14.1.text#τά τ' ὄντα καὶ μέλλοντα πάντ' ἠπίστατο,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:15.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:15.1.text#προγόνου λαβοῦσα Νηρέως τιμὰς πάρα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:16.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:16.1.text#ἡμῖν δὲ γῆ μὲν πατρὶς οὐκ ἀνώνυμος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:17.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:17.1.text#Σπάρτη, πατὴρ δὲ Τυνδάρεως· ἔστιν δὲ δὴ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:18.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:18.1.text#λόγος τις ὡς Ζεὺς μητέρ' ἔπτατ' εἰς ἐμὴν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:19.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:19.1.text#Λήδαν κύκνου μορφώματ' ὄρνιθος λαβών,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:20.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:20.1.text#ὃς δόλιον εὐνὴν ἐξέπραξ' ὑπ' αἰετοῦ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:21.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:21.1.text#δίωγμα φεύγων, εἰ σαφὴς οὗτος λόγος·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:22.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:22.1.text#Ἑλένη δ' ἐκλήθην. ἃ δὲ πεπόνθαμεν κακὰ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:23.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:23.1.text#λέγοιμ' ἄν. ἦλθον τρεῖς θεαὶ κάλλους πέρι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:24.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:24.1.text#Ἰδαῖον ἐς κευθμῶν' Ἀλέξανδρον πάρα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:25.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:25.1.text#Ἥρα Κύπρις τε διογενής τε παρθένος,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:26.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:26.1.text#μορφῆς θέλουσαι διαπεράνασθαι κρίσιν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:27.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:27.1.text#τοὐμὸν δὲ κάλλος, εἰ καλὸν τὸ δυστυχές,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:28.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:28.1.text#Κύπρις προτείνασ' ὡς Ἀλέξανδρος γαμεῖ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:29.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:29.1.text#νικᾷ. λιπὼν δὲ βούσταθμ' Ἰδαῖος Πάρις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:30.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:30.1.text#Σπάρτην ἀφίκεθ' ὡς ἐμὸν σχήσων λέχος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:31.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:31.1.text#Ἥρα δὲ μεμφθεῖσ' οὕνεκ' οὐ νικᾷ θεάς,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:32.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:32.1.text#ἐξηνέμωσε τἄμ' Ἀλεξάνδρῳ λέχη,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:33.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:33.1.text#δίδωσι δ' οὐκ ἔμ', ἀλλ' ὁμοιώσασ' ἐμοὶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:34.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:34.1.text#εἴδωλον ἔμπνουν οὐρανοῦ ξυνθεῖσ' ἄπο,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:35.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:35.1.text#Πριάμου τυράννου παιδί· καὶ δοκεῖ μ' ἔχειν —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:36.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:36.1.text#κενὴν δόκησιν, οὐκ ἔχων. τὰ δ' αὖ Διὸς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:37.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:37.1.text#βουλεύματ' ἄλλα τοῖσδε συμβαίνει κακοῖς·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:38.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:38.1.text#πόλεμον γὰρ εἰσήνεγκεν Ἑλλήνων χθονὶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:39.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:39.1.text#καὶ Φρυξὶ δυστήνοισιν, ὡς ὄχλου βροτῶν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:40.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:40.1.text#πλήθους τε κουφίσειε μητέρα χθόνα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:41.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:41.1.text#γνωτόν τε θείη τὸν κράτιστον Ἑλλάδος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:42.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:42.1.text#Φρυγῶν δ' ἐς ἀλκὴν προυτέθην ἐγὼ μὲν οὔ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:43.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:43.1.text#τὸ δ' ὄνομα τοὐμόν, ἆθλον Ἕλλησιν δορός.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:44.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:44.1.text#λαβὼν δέ μ' Ἑρμῆς ἐν πτυχαῖσιν αἰθέρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:45.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:45.1.text#νεφέλῃ καλύψας — οὐ γὰρ ἠμέλησέ μου
urn:cts:greekLit:tlg0006.tlg014.fu.sp:46.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:46.1.text#Ζεύς — τόνδ' ἐς οἶκον Πρωτέως ἱδρύσατο,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:47.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:47.1.text#πάντων προκρίνας σωφρονέστατον βροτῶν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:48.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:48.1.text#ἀκέραιον ὡς σῴσαιμι Μενέλεῳ λέχος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:49.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:49.1.text#κἀγὼ μὲν ἐνθάδ' εἴμ', ὁ δ' ἄθλιος πόσις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:50.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:50.1.text#στράτευμ' ἀθροίσας τὰς ἐμὰς ἀναρπαγὰς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:51.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:51.1.text#θηρᾷ πορευθεὶς Ἰλίου πυργώματα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:52.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:52.1.text#ψυχαὶ δὲ πολλαὶ δι' ἔμ' ἐπὶ Σκαμανδρίοις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:53.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:53.1.text#ῥοαῖσιν ἔθανον· ἡ δὲ πάντα τλᾶσ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:54.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:54.1.text#κατάρατός εἰμι καὶ δοκῶ προδοῦσ' ἐμὸν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:55.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:55.1.text#πόσιν συνάψαι πόλεμον Ἕλλησιν μέγαν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:56.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:56.1.text#τί δῆτ' ἔτι ζῶ; θεοῦ τόδ' εἰσήκουσ' ἔπος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:57.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:57.1.text#Ἑρμοῦ, τὸ κλεινὸν ἔτι κατοικήσειν πέδον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:58.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:58.1.text#Σπάρτης σὺν ἀνδρί, γνόντος ὡς ἐς Ἴλιον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:59.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:59.1.text#οὐκ ἦλθον, ἵνα μὴ λέκτρ' ὑποστρώσω τινί.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:60.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:60.1.text#ἕως μὲν οὖν φῶς ἡλίου τόδ' ἔβλεπεν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:61.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:61.1.text#Πρωτεύς, ἄσυλος ἦ γάμων· ἐπεὶ δὲ γῆς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:62.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:62.1.text#σκότῳ κέκρυπται, παῖς ὁ τοῦ τεθνηκότος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:63.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:63.1.text#θηρᾷ γαμεῖν με. τὸν πάλαι δ' ἐγὼ πόσιν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:64.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:64.1.text#τιμῶσα Πρωτέως μνῆμα προσπίτνω τόδε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:65.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:65.1.text#ἱκέτις, ἵν' ἀνδρὶ τἀμὰ διασῴσῃ λέχη,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:66.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:66.1.text#ὡς, εἰ καθ' Ἑλλάδ' ὄνομα δυσκλεὲς φέρω,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:67.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:67.1.text#μή μοι τὸ σῶμά γ' ἐνθάδ' αἰσχύνην ὄφλῃ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:68.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:68.1.text#τίς τῶνδ' ἐρυμνῶν δωμάτων ἔχει κράτος;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:69.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:69.1.text#πλούτου γὰρ οἶκος ἄξιος προσεικάσαι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:70.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:70.1.text#βασίλειά τ' ἀμφιβλήματ' εὔθριγκοί θ' ἕδραι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:71.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:71.1.text#ἔα·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:72.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:72.1.text#ὦ θεοί, τίν' εἶδον ὄψιν; ἐχθίστην ὁρῶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:73.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:73.1.text#γυναικὸς εἰκὼ φόνιον, ἥ μ' ἀπώλεσεν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:74.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:74.1.text#πάντας τ' Ἀχαιούς. θεοί σ', ὅσον μίμημ' ἔχεις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:75.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:75.1.text#Ἑλένης, ἀποπτύσειαν. εἰ δὲ μὴ 'ν ξένῃ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:76.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:76.1.text#γαίᾳ πόδ' εἶχον, τῷδ' ἂν εὐστόχῳ πτερῷ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:77.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:77.1.text#ἀπόλαυσιν εἰκοῦς ἔθανες ἂν Διὸς κόρης.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:78.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:78.1.text#τί δ', ὦ ταλαίπωρ' — ὅστις ὤν μ' ἀπεστράφης
urn:cts:greekLit:tlg0006.tlg014.fu.sp:79.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:79.1.text#καὶ ταῖς ἐκείνης συμφοραῖς ἐμὲ στυγεῖς;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:80.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:80.1.text#ἥμαρτον· ὀργῇ δ' εἶξα μᾶλλον ἤ με χρῆν·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:81.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:81.1.text#μισεῖ γὰρ Ἑλλὰς πᾶσα τὴν Διὸς κόρην.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:82.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:82.1.text#σύγγνωθι δ' ἡμῖν τοῖς λελεγμένοις, γύναι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:83.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:83.1.text#τίς δ' εἶ; πόθεν γῆς τῆσδ' ἐπεστράφης πέδον;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:84.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:84.1.text#εἷς τῶν Ἀχαιῶν, ὦ γύναι, τῶν ἀθλίων.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:85.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:85.1.text#οὐ τἄρα σ' Ἑλένην εἰ στυγεῖς θαυμαστέον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:86.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:86.1.text#ἀτὰρ τίς εἶ πόθεν; τίνος δ' αὐδᾶν σε χρή;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:87.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:87.1.text#ὄνομα μὲν ἡμῖν Τεῦκρος, ὁ δὲ φύσας πατὴρ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:88.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:88.1.text#Τελαμών, Σαλαμὶς δὲ πατρὶς ἡ θρέψασά με.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:89.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:89.1.text#τί δῆτα Νείλου τούσδ' ἐπιστρέφῃ γύας;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:90.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:90.1.text#φυγὰς πατρῴας ἐξελήλαμαι χθονός.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:91.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:91.1.text#τλήμων ἂν εἴης· τίς δέ σ' ἐκβάλλει πάτρας;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:92.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:92.1.text#Τελαμὼν ὁ φύσας. τίν' ἂν ἔχοις μᾶλλον φίλον;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:93.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:93.1.text#ἐκ τοῦ; τὸ γάρ τοι πρᾶγμα συμφορὰν ἔχει.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:94.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:94.1.text#Αἴας μ' ἀδελφὸς ὤλεσ' ἐν Τροίᾳ θανών.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:95.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:95.1.text#πῶς; οὔ τί που σῷ φασγάνῳ βίον στερείς;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:96.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:96.1.text#οἰκεῖον αὐτὸν ὤλεσ' ἅλμ' ἐπὶ ξίφος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:97.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:97.1.text#μανέντ'; ἐπεὶ τίς σωφρονῶν τλαίη τάδ' ἄν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:98.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:98.1.text#τὸν Πηλέως τιν' οἶσθ' Ἀχιλλέα γόνον;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:99.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:99.1.text#ναί·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:99.2.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:99.2.text#μνηστήρ ποθ' Ἑλένης ἦλθεν, ὡς ἀκούομεν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:100.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:100.1.text#θανὼν ὅδ' ὅπλων ἔριν ἔθηκε συμμάχοις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:101.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:101.1.text#καὶ δὴ τί τοῦτ' Αἴαντι γίγνεται κακόν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:102.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:102.1.text#ἄλλου λαβόντος ὅπλ' ἀπηλλάχθη βίου.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:103.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:103.1.text#σὺ τοῖς ἐκείνου δῆτα πήμασιν νοσεῖς;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:104.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:104.1.text#ὁθούνεκ' αὐτῷ γ' οὐ ξυνωλόμην ὁμοῦ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:105.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:105.1.text#ἦλθες γάρ, ὦ ξέν', Ἰλίου κλεινὴν πόλιν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:106.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:106.1.text#καὶ ξύν γε πέρσας αὐτὸς ἀνταπωλόμην.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:107.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:107.1.text#ἤδη γὰρ ἧπται καὶ κατείργασται πυρί;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:108.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:108.1.text#ὥστ' οὐδ' ἴχνος γε τειχέων εἶναι σαφές.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:109.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:109.1.text#ὦ τλῆμον Ἑλένη, διὰ σ' ἀπόλλυνται Φρύγες.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:110.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:110.1.text#καὶ πρός γ' Ἀχαιοί· μεγάλα δ' εἴργασται κακά.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:111.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:111.1.text#πόσον χρόνον γὰρ διαπεπόρθηται πόλις;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:112.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:112.1.text#ἑπτὰ σχεδόν τι καρπίμους ἐτῶν κύκλους.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:113.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:113.1.text#χρόνον δ' ἐμείνατ' ἄλλον ἐν Τροίᾳ πόσον;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:114.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:114.1.text#πολλὰς σελήνας, δέκα διελθούσας ἔτη.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:115.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:115.1.text#ἦ καὶ γυναῖκα Σπαρτιᾶτιν εἵλετε;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:116.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:116.1.text#Μενέλαος αὐτὴν ἦγ' ἐπισπάσας κόμης.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:117.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:117.1.text#εἶδες σὺ τὴν δύστηνον; ἢ κλύων λέγεις;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:118.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:118.1.text#ὥσπερ γε σέ, οὐδὲν ἧσσον, ὀφθαλμοῖς ὁρῶ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:119.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:119.1.text#σκοπεῖτε μὴ δόκησιν εἴχετ' ἐκ θεῶν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:120.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:120.1.text#ἄλλου λόγου μέμνησο, μὴ κείνης ἔτι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:121.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:121.1.text#οὕτω δοκεῖτε τὴν δόκησιν ἀσφαλῆ;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:122.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:122.1.text#αὐτὸς γὰρ ὄσσοις εἰδόμην· καὶ νοῦς ὁρᾷ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:123.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:123.1.text#ἤδη δ' ἐν οἴκοις σὺν δάμαρτι Μενέλεως;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:124.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:124.1.text#οὔκουν ἐν Ἄργει { γ' } οὐδ' ἐπ' Εὐρώτα ῥοαῖς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:125.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:125.1.text#αἰαῖ· κακὸν τόδ' εἶπας οἷς κακὸν λέγεις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:126.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:126.1.text#ὡς κεῖνος ἀφανὴς σὺν δάμαρτι κλῄζεται.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:127.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:127.1.text#οὐ πᾶσι πορθμὸς αὑτὸς Ἀργείοισιν ἦν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:128.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:128.1.text#ἦν, ἀλλὰ χειμὼν ἄλλοσ' ἄλλον ὥρισεν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:129.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:129.1.text#ποίοισιν ἐν νώτοισι ποντίας ἁλός;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:130.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:130.1.text#μέσον περῶσι πέλαγος Αἰγαίου πόρου.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:131.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:131.1.text#κἀκ τοῦδε Μενέλαν οὔτις εἶδ' ἀφιγμένον;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:132.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:132.1.text#οὐδείς· θανὼν δὲ κλῄζεται καθ' Ἑλλάδα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:133.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:133.1.text#ἀπωλόμεσθα· Θεστιὰς δ' ἔστιν κόρη;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:134.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:134.1.text#Λήδαν ἔλεξας; οἴχεται θανοῦσα δή.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:135.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:135.1.text#οὔ πού νιν Ἑλένης αἰσχρὸν ὤλεσεν κλέος;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:136.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:136.1.text#φασίν, βρόχῳ γ' ἅψασαν εὐγενῆ δέρην.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:137.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:137.1.text#οἱ Τυνδάρειοι δ' εἰσὶν ἢ οὐκ εἰσὶν κόροι;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:138.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:138.1.text#τεθνᾶσι καὶ οὐ τεθνᾶσι· δύο δ' ἐστὸν λόγω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:139.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:139.1.text#πότερος ὁ κρείσσων; ὦ τάλαιν' ἐγὼ κακῶν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:140.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:140.1.text#ἄστροις σφ' ὁμοιωθέντε φάσ' εἶναι θεώ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:141.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:141.1.text#καλῶς ἔλεξας τοῦτο· θάτερον δὲ τί;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:142.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:142.1.text#σφαγαῖς ἀδελφῆς οὕνεκ' ἐκπνεῦσαι βίον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:143.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:143.1.text#ἅλις δὲ μύθων· οὐ διπλᾶ χρῄζω στένειν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:144.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:144.1.text#ὧν δ' οὕνεκ' ἦλθον τούσδε βασιλείους δόμους,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:145.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:145.1.text#τὴν θεσπιῳδὸν Θεονόην χρῄζων ἰδεῖν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:146.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:146.1.text#σὺ προξένησον, ὡς τύχω μαντευμάτων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:147.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:147.1.text#ὅπῃ νεὼς στείλαιμ' ἂν οὔριον πτερὸν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:148.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:148.1.text#ἐς γῆν ἐναλίαν Κύπρον, οὗ μ' ἐθέσπισεν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:149.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:149.1.text#οἰκεῖν Ἀπόλλων, ὄνομα νησιωτικὸν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:150.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:150.1.text#Σαλαμῖνα θέμενον τῆς ἐκεῖ χάριν πάτρας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:151.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:151.1.text#πλοῦς, ὦ ξέν', αὐτὸς σημανεῖ· σὺ δ' ἐκλιπὼν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:152.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:152.1.text#γῆν τήνδε φεῦγε πρίν σε παῖδα Πρωτέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:153.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:153.1.text#ἰδεῖν, ὃς ἄρχει τῆσδε γῆς· ἄπεστι δὲ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:154.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:154.1.text#κυσὶν πεποιθὼς ἐν φοναῖς θηροκτόνοις·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:155.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:155.1.text#κτείνει γὰρ Ἕλλην' ὅντιν' ἂν λάβῃ ξένον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:156.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:156.1.text#ὅτου δ' ἕκατι, μήτε σὺ ζήτει μαθεῖν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:157.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:157.1.text#ἐγώ τε σιγῶ· τί γὰρ ἂν ὠφελοῖμί σε;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:158.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:158.1.text#καλῶς ἔλεξας, ὦ γύναι· θεοὶ δέ σοι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:159.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:159.1.text#ἐσθλῶν ἀμοιβὰς ἀντιδωρησαίατο.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:160.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:160.1.text#Ἑλένῃ δ' ὅμοιον σῶμ' ἔχουσ' οὐ τὰς φρένας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:161.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:161.1.text#ἔχεις ὁμοίας, ἀλλὰ διαφόρους πολύ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:162.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:162.1.text#κακῶς δ' ὄλοιτο μηδ' ἐπ' Εὐρώτα ῥοὰς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:163.1.speaker#Τεῦκρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:163.1.text#ἔλθοι· σὺ δ' εἴης εὐτυχὴς ἀεί, γύναι.[ … ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:164.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:164.1.text#ὤ, μεγάλων ἀχέων καταβαλλομένα μέγαν οἶκτον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:165.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:165.1.text#ποῖον ἁμιλλαθῶ γόον; ἢ τίνα μοῦσαν ἐπέλθω
urn:cts:greekLit:tlg0006.tlg014.fu.sp:166.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:166.1.text#δάκρυσιν ἢ θρήνοις ἢ πένθεσιν; αἰαῖ.[ … ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:167.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:167.1.text#πτεροφόροι νεάνιδες,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:168.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:168.1.text#παρθένοι Χθονὸς κόραι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:169.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:169.1.text#Σειρῆνες, εἴθ' ἐμοῖς γόοις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:170.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:170.1.text#μόλοιτ' ἔχουσαι Λίβυν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:171.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:171.1.text#λωτὸν ἢ σύριγγας ἢ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:171.2.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:171.2.text#φόρμιγγας, αἰλίνοις κακοῖς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:172.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:172.1.text#τοῖς ἐμοῖσι σύνοχα δάκρυα·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:173.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:173.1.text#πάθεσι πάθεα, μέλεσι μέλεα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:174.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:174.1.text#μουσεῖα θρηνήμασι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:174.2.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:174.2.text#ξυνῳδὰ πέμψειε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:175.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:175.1.text#Φερσέφασσα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:176.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:176.1.text#φόνια, χάριτας ἵν' ἐπὶ δάκρυσι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:177.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:177.1.text#παρ' ἐμέθεν ὑπὸ μέλαθρα νύχια
urn:cts:greekLit:tlg0006.tlg014.fu.sp:177.2.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:177.2.text#παιᾶνα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:178.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:178.1.text#νέκυσιν ὀλομένοις λάβῃ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:179.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:179.1.text#κυανοειδὲς ἀμφ' ὕδωρ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:180.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:180.1.text#ἔτυχον ἕλικά τ' ἀνὰ χλόαν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:181.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:181.1.text#φοίνικας ἁλίου πέπλους
urn:cts:greekLit:tlg0006.tlg014.fu.sp:182.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:182.1.text#αὐγαῖσιν ἐν χρυσέαις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:183.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:183.1.text#ἀμφὶ δόνακος ἔρνεσιν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:183.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:183.2.text#θάλπουσα· { ποτνίας δ' ἐμᾶς, }
urn:cts:greekLit:tlg0006.tlg014.fu.sp:184.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:184.1.text#ἔνθεν οἰκτρὸν ἀνεβόασεν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:185.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:185.1.text#ὅμαδον ἔκλυον, ἄλυρον ἔλεγον,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:186.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:186.1.text#ὅτι ποτ' ἔλακεν αἰάγμασι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:186.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:186.2.text#στένουσα, Νύμφα τις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:187.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:187.1.text#οἷα Ναῒς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:188.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:188.1.text#ὄρεσι φυγάδα νόμον ἱεῖσα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:189.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:189.1.text#γοερόν, ὑπὸ δὲ πέτρινα γύαλα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:189.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:189.2.text#κλαγγαῖσι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:190.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:190.1.text#Πανὸς ἀναβοᾷ γάμους.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:191.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:191.1.text#ἰὼ ἰώ·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:192.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:192.1.text#θήραμα βαρβάρου πλάτας,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:193.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:193.1.text#Ἑλλανίδες κόραι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:194.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:194.1.text#ναύτας Ἀχαιῶν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:195.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:195.1.text#τις ἔμολεν ἔμολε δάκρυα δάκρυσί μοι φέρων.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:196.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:196.1.text#Ἰλίου κατασκαφαὶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:197.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:197.1.text#πυρὶ μέλουσι δαΐῳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:198.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:198.1.text#δι' ἐμὲ τὰν πολυκτόνον,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:199.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:199.1.text#δι' ἐμὸν ὄνομα πολύπονον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:200.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:200.1.text#Λήδα δ' ἐν ἀγχόναις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:201.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:201.1.text#θάνατον ἔλαβεν αἰσχύνας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:202.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:202.1.text#ἐμᾶς ὑπ' ἀλγέων.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:203.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:203.1.text#ὁ δ' ἐμὸς ἐν ἁλὶ πολυπλανὴς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:204.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:204.1.text#πόσις ὀλόμενος οἴχεται,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:205.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:205.1.text#κάστορός τε συγγόνου τε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:206.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:206.1.text#διδυμογενὲς ἄγαλμα πατρίδος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:207.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:207.1.text#ἀφανὲς ἀφανὲς ἱππόκροτα λέλοιπε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:208.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:208.1.text#δάπεδα γυμνάσιά τε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:210.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:210.1.text#δονακόεντος Εὐρώτα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:210.2.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:210.2.text#νεανιᾶν πόνον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:211.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:211.1.text#αἰαῖ αἰαῖ·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:211.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:211.2.text#ὦ δαίμονος πολυστόνου
urn:cts:greekLit:tlg0006.tlg014.fu.sp:212.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:212.1.text#μοίρας τε σᾶς, γύναι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:213.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:213.1.text#αἰὼν δυσαίων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:214.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:214.1.text#τις ἔλαχεν ἔλαχεν, ὅτε σ' ἐτέκετο ματρόθεν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:215.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:215.1.text#χιονόχρως κύκνου πτερῷ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:216.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:216.1.text#Ζεὺς πρέπων δι' αἰθέρος·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:217.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:217.1.text#τί γὰρ ἄπεστί σοι κακῶν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:218.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:218.1.text#τίνα δὲ βίοτον οὐκ ἔτλας;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:219.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:219.1.text#μάτηρ μὲν οἴχεται,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:220.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:220.1.text#δίδυμά τε Διὸς οὐκ εὐδαιμονεῖ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:221.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:221.1.text#τέκεα φίλα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:222.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:222.1.text#χθόνα δὲ πάτριον οὐχ ὁρᾷς,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:223.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:223.1.text#διὰ δὲ πόλεας ἔρχεται
urn:cts:greekLit:tlg0006.tlg014.fu.sp:224.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:224.1.text#βάξις, ἅ σε βαρβάροισι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:225.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:225.1.text#πότνια, παραδίδωσι λέχεσιν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:226.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:226.1.text#ὁ δὲ σὸς ἐν ἁλὶ κύμασί τε λέλοιπε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:227.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:227.1.text#βίοτον, οὐδέ ποτ' ἔτι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:228.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:228.1.text#πάτρια μέλαθρα καὶ τὰν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:228.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:228.2.text#Χαλκίοικον ὀλβιεῖς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:229.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:229.1.text#φεῦ φεῦ, τίς ἢ Φρυγῶν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:230.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:230.1.text#ἢ τίς Ἑλλανίας ἀπὸ χθονὸς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:231.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:231.1.text#ἔτεμε τὰν δακρυόεσσαν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:232.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:232.1.text#Ἰλίῳ πεύκαν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:233.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:233.1.text#ἔνθεν ὀλόμενον σκάφος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:234.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:234.1.text#συναρμόσας ὁ Πριαμίδας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:234.2.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:234.2.text#ἔπλευσε βαρβάρῳ πλάτᾳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:235.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:235.1.text#τὰν ἐμὰν ἐφ' ἑστίαν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:236.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:236.1.text#ἐπὶ τὸ δυστυχέστατον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:237.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:237.1.text#κάλλος, ὡς ἕλοι, γάμων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:238.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:238.1.text#ἀμῶν· ἅ τε δόλιος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:239.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:239.1.text#ἁ πολυκτόνος Κύπρις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:239.2.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:239.2.text#Δαναΐδαις ἄγουσα θάνατον [ Πριαμίδαις ],
urn:cts:greekLit:tlg0006.tlg014.fu.sp:240.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:240.1.text#ὦ τάλαινα συμφορᾶς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:241.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:241.1.text#ἁ δὲ χρυσέοις θρόνοις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:242.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:242.1.text#Διὸς ὑπαγκάλισμα σεμνὸν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:243.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:243.1.text#Ἥρα τὸν ὠκύπουν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:243.2.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:243.2.text#ἔπεμψε Μαιάδος γόνον·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:244.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:244.1.text#ὅς με χλοερὰ δρεπομέναν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:245.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:245.1.text#ἔσω πέπλων ῥόδεα πέταλα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:245.2.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:245.2.text#Χαλκίοικον ὡς [ Ἀθάναν ] μόλοιμ',
urn:cts:greekLit:tlg0006.tlg014.fu.sp:246.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:246.1.text#ἀναρπάσας δι' αἰθέρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:247.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:247.1.text#τάνδε γαῖαν εἰς ἄνολβον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:248.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:248.1.text#ἔριν ἔριν τάλαιναν ἔθετο
urn:cts:greekLit:tlg0006.tlg014.fu.sp:249.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:249.1.text#Πριαμίδαισιν Ἑλλάδος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:249.2.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:249.2.text#τὸ δ' ἐμὸν ὄνομα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:250.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:250.1.text#παρὰ Σιμουντίοις ῥοαῖσι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:251.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:251.1.text#μαψίδιον ἔχει φάτιν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:253.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:253.1.text#ἔχεις μὲν ἀλγείν', οἶδα· σύμφορον δέ τοι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:254.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:254.1.text#ὡς ῥᾷστα τἀναγκαῖα τοῦ βίου φέρειν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:255.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:255.1.text#φίλαι γυναῖκες, τίνι πότμῳ συνεζύγην;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:256.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:256.1.text#ἆρ' ἡ τεκοῦσά μ' ἔτεκεν ἀνθρώποις τέρας;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:257.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:257.1.text#[ γυνὴ γὰρ οὔθ' Ἑλληνὶς οὔτε βάρβαρος ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:258.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:258.1.text#[ τεῦχος νεοσσῶν λευκὸν ἐκλοχεύεται, ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:259.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:259.1.text#[ ἐν ᾧ με Λήδαν φασὶν ἐκ Διὸς τεκεῖν. ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:260.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:260.1.text#τέρας γὰρ ὁ βίος καὶ τὰ πράγματ' ἐστί μου,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:261.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:261.1.text#τὰ μὲν δι' Ἥραν, τὰ δὲ τὸ κάλλος αἴτιον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:262.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:262.1.text#εἴθ' ἐξαλειφθεῖσ' ὡς ἄγαλμ' αὖθις πάλιν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:263.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:263.1.text#αἴσχιον εἶδος ἔλαβον ἀντὶ τοῦ καλοῦ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:264.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:264.1.text#καὶ τὰς τύχας μὲν τὰς κακὰς ἃς νῦν ἔχω
urn:cts:greekLit:tlg0006.tlg014.fu.sp:265.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:265.1.text#Ἕλληνες ἐπελάθοντο, τὰς δὲ μὴ κακὰς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:266.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:266.1.text#ἔσῳζον ὥσπερ τὰς κακὰς σῴζουσί μου.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:267.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:267.1.text#ὅστις μὲν οὖν ἐς μίαν ἀποβλέπων τύχην
urn:cts:greekLit:tlg0006.tlg014.fu.sp:268.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:268.1.text#πρὸς θεῶν κακοῦται, βαρὺ μέν, οἰστέον δ' ὅμως·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:269.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:269.1.text#ἡμεῖς δὲ πολλαῖς συμφοραῖς ἐγκείμεθα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:270.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:270.1.text#πρῶτον μὲν οὐκ οὖσ' ἄδικος, εἰμὶ δυσκλεής·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:271.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:271.1.text#καὶ τοῦτο μεῖζον τῆς ἀληθείας κακόν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:272.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:272.1.text#ὅστις τὰ μὴ προσόντα κέκτηται κακά.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:273.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:273.1.text#ἔπειτα πατρίδος θεοί μ' ἀφιδρύσαντο γῆς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:274.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:274.1.text#ἐς βάρβαρ' ἤθη, καὶ φίλων τητωμένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:275.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:275.1.text#δούλη καθέστηκ' οὖσ' ἐλευθέρων ἄπο·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:276.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:276.1.text#τὰ βαρβάρων γὰρ δοῦλα πάντα πλὴν ἑνός.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:277.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:277.1.text#ἄγκυρα δ' ἥ μου τὰς τύχας ὤχει μόνη,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:278.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:278.1.text#πόσιν ποθ' ἥξειν καί μ' ἀπαλλάξειν κακῶν —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:279.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:279.1.text#οὗτος τέθνηκεν, οὗτος οὐκέτ' ἔστι δή.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:280.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:280.1.text#μήτηρ δ' ὄλωλε, καὶ φονεὺς αὐτῆς ἐγώ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:281.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:281.1.text#ἀδίκως μέν, ἀλλὰ τἄδικον τοῦτ' ἔστ' ἐμόν·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:282.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:282.1.text#ὃ δ' ἀγλάισμα δωμάτων ἐμοῦ τ' ἔφυ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:283.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:283.1.text#θυγάτηρ ἄνανδρος πολιὰ παρθενεύεται·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:284.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:284.1.text#τὼ τοῦ Διὸς δὲ λεγομένω Διοσκόρω
urn:cts:greekLit:tlg0006.tlg014.fu.sp:285.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:285.1.text#οὐκ ἐστόν. ἀλλὰ πάντ' ἔχουσα δυστυχῆ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:286.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:286.1.text#τοῖς πράγμασιν τέθνηκα, τοῖς δ' ἔργοισιν οὔ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:287.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:287.1.text#τὸ δ' ἔσχατον τοῦτ', εἰ μόλοιμεν ἐς πάτραν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:288.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:288.1.text#κλῄθροις ἂν εἰργοίμεσθα — τὴν ὑπ' Ἰλίῳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:289.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:289.1.text#δοκοῦντες Ἑλένην Μενέλεώ μ' ἐλθεῖν μέτα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:290.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:290.1.text#εἰ μὲν γὰρ ἔζη πόσις, ἀνεγνώσθημεν ἂν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:291.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:291.1.text#ἐλθόντες, ἃ φανέρ' ἦν μόνοις, ἐς ξύμβολα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:292.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:292.1.text#νῦν δ' οὔτε τοῦτ' ἔστ' οὔτε μὴ σωθῇ ποτε.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:293.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:293.1.text#τί δῆτ' ἔτι ζῶ; τίν' ὑπολείπομαι τύχην;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:294.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:294.1.text#γάμους ἑλομένη τῶν κακῶν ὑπαλλαγάς,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:295.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:295.1.text#μετ' ἀνδρὸς οἰκεῖν βαρβάρου πρὸς πλουσίαν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:296.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:296.1.text#τράπεζαν ἵζουσ'; ἀλλ' ὅταν πόσις πικρὸς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:297.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:297.1.text#ξυνῇ γυναικί, καὶ τὸ σῶμ' ἐστιν πικρόν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:298.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:298.1.text#θανεῖν κράτιστον· πῶς θάνοιμ' ἂν οὐ καλῶς;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:299.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:299.1.text#[ ἀσχήμονες μὲν ἀγχόναι μετάρσιοι, ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:300.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:300.1.text#[ κἀν τοῖσι δούλοις δυσπρεπὲς νομίζεται· ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:301.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:301.1.text#[ σφαγαὶ δ' ἔχουσιν εὐγενές τι καὶ καλόν, ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:302.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:302.1.text#[ σμικρὸν δ' ὁ καιρὸς σάρκ' ἀπαλλάξαι βίου. ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:303.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:303.1.text#ἐς γὰρ τοσοῦτον ἤλθομεν βάθος κακῶν·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:304.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:304.1.text#αἱ μὲν γὰρ ἄλλαι διὰ τὸ κάλλος εὐτυχεῖς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:305.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:305.1.text#γυναῖκες, ἡμᾶς δ' αὐτὸ τοῦτ' ἀπώλεσεν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:306.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:306.1.text#Ἑλένη, τὸν ἐλθόνθ', ὅστις ἐστὶν ὁ ξένος,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:307.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:307.1.text#μὴ πάντ' ἀληθῆ δοξάσῃς εἰρηκέναι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:308.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:308.1.text#καὶ μὴν σαφῶς γ' ἔλεξ' ὀλωλέναι πόσιν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:309.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:309.1.text#πόλλ' ἂν γένοιτο καὶ διὰ ψευδῶν ἔπη.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:310.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:310.1.text#καὶ τἄμπαλίν γε τῶνδ' ἀληθείᾳ σαφῆ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:311.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:311.1.text#ἐς ξυμφορὰν γὰρ ἀντὶ τἀγαθοῦ φέρῃ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:312.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:312.1.text#φόβος γὰρ ἐς τὸ δεῖμα περιβαλών μ' ἄγει.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:313.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:313.1.text#πῶς δ' εὐμενείας τοισίδ' ἐν δόμοις ἔχεις;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:314.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:314.1.text#πάντες φίλοι μοι πλὴν ὁ θηρεύων γάμους.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:315.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:315.1.text#οἶσθ' οὖν ὃ δρᾶσον; μνήματος λιποῦσ' ἕδραν —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:316.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:316.1.text#ἐς ποῖον ἕρπεις μῦθον ἢ παραίνεσιν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:317.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:317.1.text#ἐλθοῦσ' ἐς οἴκους, ἣ τὰ πάντ' ἐπίσταται,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:318.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:318.1.text#τῆς ποντίας Νηρῇδος ἐκγόνου κόρης,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:319.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:319.1.text#πυθοῦ πόσιν σὸν Θεονόης, εἴτ' ἔστ' ἔτι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:320.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:320.1.text#εἴτ' ἐκλέλοιπε φέγγος· ἐκμαθοῦσα δ' εὖ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:321.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:321.1.text#πρὸς τὰς τύχας τὸ χάρμα τοὺς γόους τ' ἔχε.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:322.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:322.1.text#πρὶν δ' οὐδὲν ὀρθῶς εἰδέναι, τί σοι πλέον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:323.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:323.1.text#λυπουμένῃ γένοιτ' ἄν; ἀλλ' ἐμοὶ πιθοῦ·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:324.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:324.1.text#τάφον λιποῦσα τόνδε σύμμειξον κόρῃ·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:325.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:325.1.text#ὅθενπερ εἴσῃ πάντα τἀληθῆ μαθεῖν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:326.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:326.1.text#ἔχουσ' ἐν οἴκοις τοῖσδε, τί βλέπεις πρόσω;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:327.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:327.1.text#θέλω δὲ κἀγὼ σοὶ συνεισελθεῖν δόμους
urn:cts:greekLit:tlg0006.tlg014.fu.sp:328.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:328.1.text#καὶ συμπυθέσθαι παρθένου θεσπίσματα·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:329.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:329.1.text#γυναῖκα γὰρ δὴ συμπονεῖν γυναικὶ χρή.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:330.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:330.1.text#φίλαι, λόγους ἐδεξάμαν·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:331.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:331.1.text#βᾶτε βᾶτε δ' ἐς δόμους,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:332.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:332.1.text#ἀγῶνας ἐντὸς οἴκων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:333.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:333.1.text#ὡς πύθησθε τοὺς ἐμούς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:334.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:334.1.text#θέλουσαν οὐ μόλις καλεῖς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:335.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:335.1.text#ἰὼ μέλεος ἁμέρα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:336.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:336.1.text#τίν' ἄρα τάλαινα τίνα δακρυόεντα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:337.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:337.1.text#λόγον ἀκούσομαι;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:338.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:338.1.text#μὴ πρόμαντις ἀλγέων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:339.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:339.1.text#προλάμβαν', ὦ φίλα, γόους.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:340.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:340.1.text#τί μοι πόσις μέλεος ἔτλα;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:341.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:341.1.text#πότερα δέρκεται φάος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:342.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:342.1.text#τέθριππά θ' ἁλίου κέλευθά τ' ἀστέρων,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:344.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:344.1.text#ἢ 'ν νέκυσι κατὰ χθονὸς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:345.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:345.1.text#τὰν χρόνιον ἔχει τύχαν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:346.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:346.1.text#ἐς τὸ φέρτερον τίθει
urn:cts:greekLit:tlg0006.tlg014.fu.sp:347.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:347.1.text#τὸ μέλλον, ὅ τι γενήσεται.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:348.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:348.1.text#σὲ γὰρ ἐκάλεσα, σὲ δὲ κατόμοσα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:349.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:349.1.text#τὸν ὑδρόεντι δόνακι χλωρὸν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:350.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:350.1.text#Εὐρώταν, θανόντος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:351.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:351.1.text#εἰ βάξις ἔτυμος ἀνδρὸς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:352.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:352.1.text#ἅδε μοι — τί τάδ' ἀσύνετα;  —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:353.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:353.1.text#φόνιον αἰώρημα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:353.2.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:353.2.text#διὰ δέρης ὀρέξομαι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:354.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:354.1.text#ἢ ξιφοκτόνον δίωγμα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:355.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:355.1.text#λαιμορρύτου σφαγᾶς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:356.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:356.1.text#αὐτοσίδαρον ἔσω πελάσω διὰ σαρκὸς ἅμιλλαν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:357.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:357.1.text#θῦμα τριζύγοις θεαῖσι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:358.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:358.1.text#τῷ τε σήραγγας Ἰδαίας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:359.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:359.1.text#ἐνίζοντι Πριαμίδᾳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:359.2.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:359.2.text#ποτ' ἀμφὶ βουστάθμους.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:360.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:360.1.text#ἄλλοσ' ἀποτροπὰ κακῶν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:361.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:361.1.text#γένοιτο, τὸ δὲ σὸν εὐτυχές.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:362.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:362.1.text#ἰὼ Τροία τάλαινα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:362.2.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:362.2.text#δι' ἔργ' ἄνεργ' ὄλλυσαι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:363.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:363.1.text#μέλεά τ' ἔτλας· τὰ δ' ἐμὰ δῶρα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:364.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:364.1.text#Κύπριδος ἔτεκε πολὺ μὲν αἷμα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:365.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:365.1.text#πολὺ δὲ δάκρυον· ἄχεά τ' ἄχεσι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:366.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:366.1.text#δάκρυα δάκρυσιν ἔλαβε, πάθεα [ … ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:367.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:367.1.text#ματέρες τε παῖδας ὄλεσαν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:368.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:368.1.text#ἀπὸ δὲ παρθένοι κόμας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:369.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:369.1.text#ἔθεντο σύγγονοι νεκρῶν Σκαμάνδριον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:369.2.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:369.2.text#ἀμφὶ Φρύγιον οἶδμα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:370.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:370.1.text#βοὰν βοὰν δ' Ἑλλὰς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:371.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:371.1.text#κελάδησε κἀνοτότυξεν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:372.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:372.1.text#ἐπὶ δὲ κρατὶ χέρας ἔθηκεν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:373.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:373.1.text#ὄνυχι δ' ἁπαλόχροα γένυν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:374.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:374.1.text#δεῦσε φονίαισι πλαγαῖς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:375.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:375.1.text#ὦ μάκαρ Ἀρκαδίᾳ ποτὲ παρθένε Καλλιστοῖ, Διὸς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:376.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:376.1.text#ἃ λεχέων ἐπέβας τετραβάμοσι γυίοις,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:377.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:377.1.text#ὡς πολὺ ματρὸς ἐμᾶς ἔλαχες πλέον,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:378.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:378.1.text#ἁ μορφᾷ θηρῶν λαχνογυίων —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:379.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:379.1.text#ὄμματι λάβρῷ σχῆμα λεαίνης —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:380.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:380.1.text#ἐξαλλάξασ' ἄχθεα λύπης·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:381.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:381.1.text#ἅν τέ ποτ' Ἄρτεμις ἐξεχορεύσατο
urn:cts:greekLit:tlg0006.tlg014.fu.sp:382.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:382.1.text#χρυσοκέρατ' ἔλαφον Μέροπος Τιτανίδα κούραν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:383.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:383.1.text#καλλοσύνας ἕνεκεν· τὸ δ' ἐμὸν δέμας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:384.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:384.1.text#ὤλεσεν ὤλεσε πέργαμα Δαρδανίας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:385.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:385.1.text#ὀλομένους τ' Ἀχαιούς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:386.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:386.1.text#ὦ τὰς τεθρίππους Οἰνομάῳ Πῖσαν κάτα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:387.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:387.1.text#Πέλοψ ἁμίλλας ἐξαμιλληθείς ποτε,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:388.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:388.1.text#εἴθ' ὤφελες τόθ', ἡνίκ' ἔρανον εἰς θεοὺς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:389.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:389.1.text#πεισθεὶς ἐποίεις, ἐν θεοῖς λιπεῖν βίον,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:390.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:390.1.text#πρὶν τὸν ἐμὸν Ἀτρέα πατέρα γεννῆσαί ποτε,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:391.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:391.1.text#ὃς ἐξέφυσεν Ἀερόπης λέκτρων ἄπο
urn:cts:greekLit:tlg0006.tlg014.fu.sp:392.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:392.1.text#Ἀγαμέμνον' ἐμέ τε Μενέλεων, κλεινὸν ζυγόν·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:393.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:393.1.text#πλεῖστον γὰρ οἶμαι — καὶ τόδ' οὐ κόμπῳ λέγω —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:394.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:394.1.text#στράτευμα κώπῃ διορίσαι Τροίαν ἔπι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:395.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:395.1.text#τύραννος οὐδὲν πρὸς βίαν στρατηλατῶν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:396.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:396.1.text#ἑκοῦσι δ' ἄρξας Ἑλλάδος νεανίαις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:397.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:397.1.text#καὶ τοὺς μὲν οὐκέτ' ὄντας ἀριθμῆσαι πάρα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:398.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:398.1.text#τοὺς δ' ἐκ θαλάσσης ἀσμένους πεφευγότας,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:399.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:399.1.text#νεκρῶν φέροντας ὀνόματ' εἰς οἴκους πάλιν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:400.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:400.1.text#ἐγὼ δ' ἐπ' οἶδμα πόντιον γλαυκῆς ἁλὸς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:401.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:401.1.text#τλήμων ἀλῶμαι χρόνον ὅσονπερ Ἰλίου
urn:cts:greekLit:tlg0006.tlg014.fu.sp:402.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:402.1.text#πύργους ἔπερσα, κἀς πάτραν χρῄζων μολεῖν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:403.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:403.1.text#οὐκ ἀξιοῦμαι τοῦδε πρὸς θεῶν τυχεῖν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:404.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:404.1.text#Λιβύης τ' ἐρήμους ἀξένους τ' ἐπιδρομὰς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:405.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:405.1.text#πέπλευκα πάσας· χὥταν ἐγγὺς ὦ πάτρας,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:406.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:406.1.text#πάλιν μ' ἀπωθεῖ πνεῦμα, κοὔποτ' οὔριον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:407.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:407.1.text#ἐσῆλθε λαῖφος ὥστε μ' ἐς πάτραν μολεῖν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:408.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:408.1.text#καὶ νῦν τάλας ναυαγὸς ἀπολέσας φίλους
urn:cts:greekLit:tlg0006.tlg014.fu.sp:409.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:409.1.text#ἐξέπεσον ἐς γῆν τήνδε· ναῦς δὲ πρὸς πέτρας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:410.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:410.1.text#πολλοὺς ἀριθμοὺς ἄγνυται ναυαγίων.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:411.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:411.1.text#τρόπις δ' ἐλείφθη ποικίλων ἁρμοσμάτων,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:412.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:412.1.text#ἐφ' ἧς ἐσώθην μόλις ἀνελπίστῳ τύχῃ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:413.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:413.1.text#Ἑλένη τε, Τροίας ἣν ἀποσπάσας ἔχω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:414.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:414.1.text#ὄνομα δὲ χώρας ἥτις ἥδε καὶ λεὼς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:415.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:415.1.text#οὐκ οἶδα· ὄχλον γὰρ ἐσπεσεῖν ᾐσχυνόμην
urn:cts:greekLit:tlg0006.tlg014.fu.sp:416.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:416.1.text#ὥσθ' ἱστορῆσαι, τὰς ἐμὰς δυσχλαινίας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:417.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:417.1.text#κρύπτων ὑπ' αἰδοῦς τῆς τύχης. ὅταν δ' ἀνὴρ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:418.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:418.1.text#πράξῃ κακῶς ὑψηλός, εἰς ἀηθίαν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:419.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:419.1.text#πίπτει κακίω τοῦ πάλαι δυσδαίμονος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:420.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:420.1.text#χρεία δὲ τείρει μ'· οὔτε γὰρ σῖτος πάρα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:421.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:421.1.text#οὔτ' ἀμφὶ χρῶτ' ἐσθῆτες· αὐτὰ δ' εἰκάσαι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:422.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:422.1.text#πάρεστι ναὸς ἐκβόλοις ἃ ἀμπίσχομαι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:423.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:423.1.text#πέπλους δὲ τοὺς πρὶν λαμπρά τ' ἀμφιβλήματα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:424.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:424.1.text#χλιδάς τε πόντος ἥρπασ'· ἐν δ' ἄντρου μυχοῖς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:425.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:425.1.text#κρύψας γυναῖκα τὴν κακῶν πάντων ἐμοὶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:426.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:426.1.text#ἄρξασαν ἥκω τούς τε περιλελειμμένους
urn:cts:greekLit:tlg0006.tlg014.fu.sp:427.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:427.1.text#φίλων φυλάσσειν τἄμ' ἀναγκάσας λέχη.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:428.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:428.1.text#μόνος δὲ νοστῶ, τοῖς ἐκεῖ ζητῶν φίλοις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:429.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:429.1.text#τὰ πρόσφορ' ἤν πως ἐξερευνήσας λάβω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:430.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:430.1.text#ἰδὼν δὲ δῶμα περιφερὲς θριγκοῖς τόδε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:431.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:431.1.text#πύλας τε σεμνὰς ἀνδρὸς ὀλβίου τινός,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:432.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:432.1.text#προσῆλθον· ἐλπὶς δ' ἔκ γε πλουσίων δόμων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:433.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:433.1.text#λαβεῖν τι ναύταις· ἐκ δὲ μὴ ἐχόντων βίον —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:434.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:434.1.text#οὐδ' εἰ θέλοιεν, ὠφελεῖν ἔχοιεν ἄν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:435.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:435.1.text#ὠή· τίς ἂν πυλωρὸς ἐκ δόμων μόλοι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:436.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:436.1.text#ὅστις διαγγείλειε τἄμ' ἔσω κακά;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:437.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:437.1.text#τίς πρὸς πύλαισιν; οὐκ ἀπαλλάξῃ δόμων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:438.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:438.1.text#καὶ μὴ πρὸς αὐλείοισιν ἑστηκὼς πύλαις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:439.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:439.1.text#ὄχλον παρέξεις δεσπόταις; ἢ κατθανῇ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:440.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:440.1.text#Ἕλλην πεφυκώς, οἷσιν οὐκ ἐπιστροφαί.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:441.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:441.1.text#ὦ γραῖα, ταὐτὰ ταῦτ' ἔπη κἄλλως λέγειν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:442.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:442.1.text#ἔξεστι, πείσομαι γάρ· ἀλλ' ἄνες λόγον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:443.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:443.1.text#ἄπελθ'· ἐμοὶ γὰρ τοῦτο πρόσκειται, ξένε,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:444.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:444.1.text#μηδένα πελάζειν τοισίδ' Ἑλλήνων δόμοις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:445.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:445.1.text#ἆ· μὴ προσείλει χεῖρα μηδ' ὤθει βίᾳ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:446.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:446.1.text#πείθῃ γὰρ οὐδὲν ὧν λέγω, σὺ δ' αἴτιος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:447.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:447.1.text#ἄγγειλον εἴσω δεσπόταισι τοῖσι σοῖς [ … ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:448.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:448.1.text#πικρῶς ἄρ' οἶμαί γ' ἀγγελεῖν τοὺς σοὺς λόγους.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:449.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:449.1.text#ναυαγὸς ἥκω ξένος, ἀσύλητον γένος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:450.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:450.1.text#οἶκον πρὸς ἄλλον νύν τιν' ἀντὶ τοῦδ' ἴθι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:451.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:451.1.text#οὔκ, ἀλλ' ἔσω πάρειμι· καὶ σύ μοι πιθοῦ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:452.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:452.1.text#ὀχληρὸς ἴσθ' ὤν· καὶ τάχ' ὠσθήσῃ βίᾳ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:453.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:453.1.text#αἰαῖ· τὰ κλεινὰ ποῦ 'στί μοι στρατεύματα;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:454.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:454.1.text#οὐκοῦν ἐκεῖ που σεμνὸς ἦσθ', οὐκ ἐνθάδε.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:455.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:455.1.text#ὦ δαῖμον, ὡς ἀνάξι' ἠτιμώμεθα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:456.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:456.1.text#τί βλέφαρα τέγγεις δάκρυσι; πρὸς τίν' οἰκτρὸς εἶ;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:457.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:457.1.text#πρὸς τὰς πάροιθεν συμφορὰς εὐδαίμονας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:458.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:458.1.text#οὔκουν ἀπελθὼν δάκρυα σοῖς δώσεις φίλοις;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:459.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:459.1.text#τίς δ' ἥδε χώρα; τοῦ δὲ βασίλειοι δόμοι;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:460.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:460.1.text#Πρωτεὺς τάδ' οἰκεῖ δώματ', Αἴγυπτος δὲ γῆ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:461.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:461.1.text#Αἴγυπτος; ὦ δύστηνος, οἷ πέπλευκ' ἄρα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:462.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:462.1.text#τί δὴ τὸ Νείλου μεμπτόν ἐστί σοι γάνος;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:463.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:463.1.text#οὐ τοῦτ' ἐμέμφθην· τὰς ἐμὰς στένω τύχας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:464.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:464.1.text#πολλοὶ κακῶς πράσσουσιν, οὐ σὺ δὴ μόνος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:465.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:465.1.text#ἔστ' οὖν ἐν οἴκοις ὅντιν' ὀνομάζεις ἄναξ;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:466.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:466.1.text#τόδ' ἐστὶν αὐτοῦ μνῆμα, παῖς δ' ἄρχει χθονός.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:467.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:467.1.text#ποῦ δῆτ' ἂν εἴη; πότερον ἐκτὸς ἢ 'ν δόμοις;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:468.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:468.1.text#οὐκ ἔνδον· Ἕλλησιν δὲ πολεμιώτατος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:469.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:469.1.text#τίν' αἰτίαν σχὼν ἧς ἐπηυρόμην ἐγώ;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:470.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:470.1.text#Ἑλένη κατ' οἴκους ἐστὶ τούσδ' ἡ τοῦ Διός.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:471.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:471.1.text#πῶς φῄς; τίν' εἶπας μῦθον; αὖθίς μοι φράσον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:472.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:472.1.text#ἡ Τυνδαρὶς παῖς, ἣ κατὰ Σπάρτην ποτ' ἦν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:473.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:473.1.text#πόθεν μολοῦσα; τίνα τὸ πρᾶγμ' ἔχει λόγον;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:474.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:474.1.text#Λακεδαίμονος γῆς δεῦρο νοστήσασ' ἄπο.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:475.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:475.1.text#πότε; οὔ τί που λελῄσμεθ' ἐξ ἄντρων λέχος;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:476.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:476.1.text#πρὶν τοὺς Ἀχαιούς, ὦ ξέν', ἐς Τροίαν μολεῖν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:477.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:477.1.text#ἀλλ' ἕρπ' ἀπ' οἴκων· ἔστι γάρ τις ἐν δόμοις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:478.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:478.1.text#τύχη, τύραννος ᾗ ταράσσεται δόμος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:479.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:479.1.text#καιρὸν γὰρ οὐδέν' ἦλθες· ἢν δὲ δεσπότης
urn:cts:greekLit:tlg0006.tlg014.fu.sp:480.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:480.1.text#λάβῃ σε, θάνατος ξένιά σοι γενήσεται.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:481.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:481.1.text#εὔνους γάρ εἰμ' Ἕλλησιν, οὐχ ὅσον πικροὺς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:482.1.speaker#Γραῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:482.1.text#λόγους ἔδωκα δεσπότην φοβουμένη.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:483.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:483.1.text#τί φῶ; τί λέξω; συμφορὰς γὰρ ἀθλίας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:484.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:484.1.text#ἐκ τῶν πάροιθεν τὰς παρεστώσας κλύω,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:485.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:485.1.text#εἰ τὴν μὲν αἱρεθεῖσαν ἐκ Τροίας ἄγων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:486.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:486.1.text#ἥκω δάμαρτα καὶ κατ' ἄντρα σῴζεται,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:487.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:487.1.text#ὄνομα δὲ ταὐτὸν τῆς ἐμῆς ἔχουσά τις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:488.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:488.1.text#δάμαρτος ἄλλη τοισίδ' ἐνναίει δόμοις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:489.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:489.1.text#Διὸς δ' ἔλεξε παῖδά νιν πεφυκέναι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:490.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:490.1.text#ἀλλ' ἦ τις ἔστι Ζηνὸς ὄνομ' ἔχων ἀνὴρ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:491.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:491.1.text#Νείλου παρ' ὄχθας; εἷς γὰρ ὅ γε κατ' οὐρανόν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:492.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:492.1.text#Σπάρτη δὲ ποῦ γῆς ἐστι πλὴν ἵνα ῥοαὶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:493.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:493.1.text#τοῦ καλλιδόνακός εἰσιν Εὐρώτα μόνον;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:494.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:494.1.text#ἁπλοῦν δὲ Τυνδάρειον ὄνομα κλῄζεται.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:495.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:495.1.text#Λακεδαίμονος δὲ γαῖα τίς ξυνώνυμος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:496.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:496.1.text#Τροίας τε; ἐγὼ μὲν οὐκ ἔχω τί χρὴ λέγειν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:497.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:497.1.text#πολλοὶ γάρ, ὡς εἴξασιν, ἐν πολλῇ χθονὶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:498.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:498.1.text#ὀνόματα ταὔτ' ἔχουσι καὶ πόλις πόλει
urn:cts:greekLit:tlg0006.tlg014.fu.sp:499.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:499.1.text#γυνὴ γυναικί τ'· οὐδὲν οὖν θαυμαστέον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:500.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:500.1.text#οὐδ' αὖ τὸ δεινὸν προσπόλου φευξούμεθα·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:501.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:501.1.text#ἀνὴρ γὰρ οὐδεὶς ὧδε βάρβαρος φρένας,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:502.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:502.1.text#ὃς ὄνομ' ἀκούσας τοὐμὸν οὐ δώσει βοράν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:503.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:503.1.text#κλεινὸν τὸ Τροίας πῦρ ἐγώ θ' ὃς ἧψά νιν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:504.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:504.1.text#Μενέλαος, οὐκ ἄγνωστος ἐν πάσῃ χθονί.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:505.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:505.1.text#δόμων ἄνακτα προσμενῶ· δισσὰς δέ μοι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:506.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:506.1.text#ἔχει φυλάξεις· ἢν μὲν ὠμόφρων τις ᾖ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:507.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:507.1.text#κρύψας ἐμαυτὸν εἶμι πρὸς ναυάγια·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:508.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:508.1.text#ἢν δ' ἐνδιδῷ τι μαλθακόν, τὰ πρόσφορα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:509.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:509.1.text#τῆς νῦν παρούσης συμφορᾶς αἰτήσομαι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:510.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:510.1.text#κακῶν μὲν ἡμῖν ἔσχατον τοῖς ἀθλίοις,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:511.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:511.1.text#ἄλλους τυράννους αὐτὸν ὄντα βασιλέα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:512.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:512.1.text#βίον προσαιτεῖν· ἀλλ' ἀναγκαίως ἔχει.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:513.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:513.1.text#λόγος γάρ ἐστιν οὐκ ἐμός, σοφὸν δ' ἔπος,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:514.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:514.1.text#δεινῆς ἀνάγκης οὐδὲν ἰσχύειν πλέον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:515.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:515.1.text#ἤκουσα τᾶς θεσπιῳδοῦ κόρας,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:516.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:516.1.text#ἃ χρῄζουσ' ἐφάνη τυράννοις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:517.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:517.1.text#δόμοις, ὡς Μενέλαος οὔπω
urn:cts:greekLit:tlg0006.tlg014.fu.sp:518.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:518.1.text#μελαμφαὲς οἴχεται
urn:cts:greekLit:tlg0006.tlg014.fu.sp:519.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:519.1.text#δι' ἔρεβος χθονὶ κρυφθείς,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:520.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:520.1.text#ἀλλ' ἔτι κατ' οἶδμ' ἅλιον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:521.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:521.1.text#τρυχόμενος οὔπω λιμένων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:522.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:522.1.text#ψαύσειεν πατρίας γᾶς,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:523.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:523.1.text#ἀλατείᾳ βιότου
urn:cts:greekLit:tlg0006.tlg014.fu.sp:524.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:524.1.text#ταλαίφρων, ἄφιλος φίλων,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:525.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:525.1.text#παντοδαπᾶς { ἐπὶ γᾶς } πόδα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:526.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:526.1.text#χριμπτόμενος εἰναλίῳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:527.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:527.1.text#κώπᾳ Τρῳάδος ἐκ γᾶς.[ … ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:528.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:528.1.text#ἥδ' αὖ τάφου τοῦδ' εἰς ἕδρας ἐγὼ πάλιν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:529.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:529.1.text#στείχω, μαθοῦσα Θεονόης φίλους λόγους,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:530.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:530.1.text#ἣ πάντ' ἀληθῶς οἶδε· φησὶ δ' ἐν φάει
urn:cts:greekLit:tlg0006.tlg014.fu.sp:531.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:531.1.text#πόσιν τὸν ἁμὸν ζῶντα φέγγος εἰσορᾶν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:532.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:532.1.text#πορθμοὺς δ' ἀλᾶσθαι μυρίους πεπλωκότα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:533.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:533.1.text#ἐκεῖσε κἀκεῖσ' οὐδ' ἀγύμναστον πλάνοις,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:534.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:534.1.text#ἥξειν { δ' } ὅταν δὴ πημάτων λάβῃ τέλος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:535.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:535.1.text#ἓν δ' οὐκ ἔλεξεν, εἰ μολὼν σωθήσεται.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:536.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:536.1.text#ἐγὼ δ' ἀπέστην τοῦτ' ἐρωτῆσαι σαφῶς,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:537.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:537.1.text#ἡσθεῖσ' ἐπεί νιν εἶπέ μοι σεσῳσμένον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:538.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:538.1.text#ἐγγὺς δέ νίν που τῆσδ' ἔφασκ' εἶναι χθονός,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:539.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:539.1.text#ναυαγὸν ἐκπεσόντα σὺν παύροις φίλοις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:540.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:540.1.text#ὤμοι, πόθ' ἥξεις; ὡς ποθεινὸς ἂν μόλοις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:541.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:541.1.text#ἔα, τίς οὗτος; οὔ τί που κρυπτεύομαι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:542.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:542.1.text#Πρωτέως ἀσέπτου παιδὸς ἐκ βουλευμάτων;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:543.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:543.1.text#οὐχ ὡς δρομαία πῶλος ἢ Βάκχη θεοῦ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:544.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:544.1.text#τάφῳ ξυνάψω κῶλον; ἄγριος δέ τις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:545.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:545.1.text#μορφὴν ὅδ' ἐστίν, ὅς με θηρᾶται λαβεῖν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:546.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:546.1.text#σὲ τὴν ὄρεγμα δεινὸν ἡμιλλημένην
urn:cts:greekLit:tlg0006.tlg014.fu.sp:547.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:547.1.text#τύμβου 'πὶ κρηπῖδ' ἐμπύρους τ' ὀρθοστάτας,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:548.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:548.1.text#μεῖνον· τί φεύγεις; ὡς δέμας δείξασα σὸν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:549.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:549.1.text#ἔκπληξιν ἡμῖν ἀφασίαν τε προστίθης.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:550.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:550.1.text#ἀδικούμεθ', ὦ γυναῖκες· εἰργόμεσθα γὰρ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:551.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:551.1.text#τάφου πρὸς ἀνδρὸς τοῦδε, καί μ' ἑλὼν θέλει
urn:cts:greekLit:tlg0006.tlg014.fu.sp:552.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:552.1.text#δοῦναι τυράννοις ὧν ἐφεύγομεν γάμους.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:553.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:553.1.text#οὐ κλῶπές ἐσμεν, οὐχ ὑπηρέται κακῶν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:554.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:554.1.text#καὶ μὴν στολήν γ' ἄμορφον ἀμφὶ σῶμ' ἔχεις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:555.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:555.1.text#στῆσον, φόβου μεθεῖσα, λαιψηρὸν πόδα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:556.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:556.1.text#ἵστημ', ἐπεί γε τοῦδ' ἐφάπτομαι τόπου.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:557.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:557.1.text#τίς εἶ; τίν' ὄψιν σήν, γύναι, προσδέρκομαι;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:558.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:558.1.text#σὺ δ' εἶ τίς; αὑτὸς γὰρ σὲ κἄμ' ἔχει λόγος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:559.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:559.1.text#οὐπώποτ' εἶδον προσφερέστερον δέμας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:560.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:560.1.text#ὦ θεοί· θεὸς γὰρ καὶ τὸ γιγνώσκειν φίλους.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:561.1.speaker#{ Μενελέως }

urn:cts:greekLit:tlg0006.tlg014.fu.sp:561.1.text#{ Ἑλληνὶς εἶ τις ἢ ἐπιχωρία γυνή; }
urn:cts:greekLit:tlg0006.tlg014.fu.sp:562.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:562.1.text#Ἑλληνίς· ἀλλὰ καὶ τὸ σὸν θέλω μαθεῖν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:563.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:563.1.text#Ἑλένῃ σ' ὁμοίαν δὴ μάλιστ' εἶδον, γύναι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:564.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:564.1.text#ἐγὼ δὲ Μενέλεῴ γε σέ· οὐδ' ἔχω τί φῶ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:565.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:565.1.text#ἔγνως γὰρ ὀρθῶς ἄνδρα δυστυχέστατον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:566.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:566.1.text#ὦ χρόνιος ἐλθὼν σῆς δάμαρτος ἐς χέρας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:567.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:567.1.text#ποίας δάμαρτος; μὴ θίγῃς ἐμῶν πέπλων.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:568.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:568.1.text#ἥν σοι δίδωσι Τυνδάρεως, ἐμὸς πατήρ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:569.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:569.1.text#ὦ φωσφόρ' Ἑκάτη, πέμπε φάσματ' εὐμενῆ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:570.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:570.1.text#οὐ νυκτίφαντον πρόπολον Ἐνοδίας μ' ὁρᾷς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:571.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:571.1.text#οὐ μὴν γυναικῶν γ' εἷς δυοῖν ἔφυν πόσις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:572.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:572.1.text#ποίων δὲ λέκτρων δεσπότης ἄλλων ἔφυς;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:573.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:573.1.text#ἣν ἄντρα κεύθει κἀκ Φρυγῶν κομίζομαι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:574.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:574.1.text#οὐκ ἔστιν ἄλλη σή τις ἀντ' ἐμοῦ γυνή.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:575.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:575.1.text#οὔ που φρονῶ μὲν εὖ, τὸ δ' ὄμμα μου νοσεῖ;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:576.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:576.1.text#οὐ γάρ με λεύσσων σὴν δάμαρθ' ὁρᾶν δοκεῖς;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:577.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:577.1.text#τὸ σῶμ' ὅμοιον, τὸ δὲ σαφές μ' ἀποστερεῖ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:578.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:578.1.text#σκέψαι· τί σοὐνδεῖ; τίς δὲ σοῦ σοφώτερος;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:579.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:579.1.text#ἔοικας· οὔτοι τοῦτό γ' ἐξαρνήσομαι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:580.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:580.1.text#τίς οὖν διδάξει σ' ἄλλος ἢ τὰ σ' ὄμματα;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:581.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:581.1.text#ἐκεῖ νοσοῦμεν, ὅτι δάμαρτ' ἄλλην ἔχω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:582.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:582.1.text#οὐκ ἦλθον ἐς γῆν Τρῳάδ', ἀλλ' εἴδωλον ἦν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:583.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:583.1.text#καὶ τίς βλέποντα σώματ' ἐξεργάζεται;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:584.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:584.1.text#αἰθήρ, ὅθεν σὺ θεοπόνητ' ἔχεις λέχη.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:585.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:585.1.text#τίνος πλάσαντος θεῶν; ἄελπτα γὰρ λέγεις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:586.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:586.1.text#Ἥρας, διάλλαγμ', ὡς Πάρις με μὴ λάβοι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:587.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:587.1.text#πῶς οὖν ἂν ἐνθάδ' ἦσθά { τ' } ἐν Τροίᾳ θ' ἅμα;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:588.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:588.1.text#τοὔνομα γένοιτ' ἂν πολλαχοῦ, τὸ σῶμα δ' οὔ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:589.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:589.1.text#μέθες με, λύπης ἅλις ἔχων ἐλήλυθα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:590.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:590.1.text#λείψεις γὰρ ἡμᾶς, τὰ δὲ κέν' ἐξάξεις λέχη;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:591.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:591.1.text#καὶ χαῖρέ γ', Ἑλένῃ προσφερὴς ὁθούνεκ' εἶ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:592.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:592.1.text#ἀπωλόμην· λαβοῦσά σ' οὐχ ἕξω πόσιν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:593.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:593.1.text#τοὐκεῖ με μέγεθος τῶν πόνων πείθει, σὺ δ' οὔ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:594.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:594.1.text#οἲ ἐγώ· τίς ἡμῶν ἐγένετ' ἀθλιωτέρα;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:595.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:595.1.text#οἱ φίλτατοι λείπουσί μ' οὐδ' ἀφίξομαι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:596.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:596.1.text#Ἕλληνας οὐδὲ πατρίδα τὴν ἐμήν ποτε.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:597.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:597.1.text#Μενέλαε, μαστεύων σε κιγχάνω μόλις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:598.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:598.1.text#πᾶσαν πλανηθεὶς τήνδε βάρβαρον χθόνα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:599.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:599.1.text#πεμφθεὶς ἑταίρων τῶν λελειμμένων ὕπο.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:600.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:600.1.text#τί δ' ἔστιν; οὔ που βαρβάρων συλᾶσθ' ὕπο;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:601.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:601.1.text#θαῦμ' ἔστ', ἔλασσον τοὔνομ' ἢ τὸ πρᾶγμ' ἔχον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:602.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:602.1.text#λέγ'· ὡς φέρεις τι τῇδε τῇ σπουδῇ νέον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:603.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:603.1.text#λέγω πόνους σε μυρίους τλῆναι μάτην.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:604.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:604.1.text#παλαιὰ θρηνεῖς πήματ'· ἀγγέλλεις δὲ τί;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:605.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:605.1.text#βέβηκεν ἄλοχος σὴ πρὸς αἰθέρος πτυχὰς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:606.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:606.1.text#ἀρθεῖσ' ἄφαντος· οὐρανῷ δὲ κρύπτεται
urn:cts:greekLit:tlg0006.tlg014.fu.sp:607.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:607.1.text#λιποῦσα σεμνὸν ἄντρον οὗ σφ' ἐσῴζομεν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:608.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:608.1.text#τοσόνδε λέξασ'· ὦ ταλαίπωροι Φρύγες
urn:cts:greekLit:tlg0006.tlg014.fu.sp:609.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:609.1.text#πάντες τ' Ἀχαιοί, δι' ἔμ' ἐπὶ Σκαμανδρίοις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:610.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:610.1.text#ἀκταῖσιν Ἥρας μηχαναῖς ἐθνῄσκετε,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:611.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:611.1.text#δοκοῦντες Ἑλένην οὐκ ἔχοντ' ἔχειν Πάριν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:612.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:612.1.text#ἐγὼ δ', ἐπειδὴ χρόνον ἔμειν' ὅσον με χρῆν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:613.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:613.1.text#τὸ μόρσιμον σῴσασα, πατέρ' ἐς οὐρανὸν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:614.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:614.1.text#ἄπειμι· φήμας δ' ἡ τάλαινα Τυνδαρὶς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:615.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:615.1.text#ἄλλως κακὰς ἤκουσεν οὐδὲν αἰτία.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:616.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:616.1.text#ὦ χαῖρε, Λήδας θύγατερ, ἐνθάδ' ἦσθ' ἄρα;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:617.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:617.1.text#ἐγὼ δέ σ' ἄστρων ὡς βεβηκυῖαν μυχοὺς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:618.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:618.1.text#ἤγγελλον εἰδὼς οὐδὲν ὡς ὑπόπτερον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:619.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:619.1.text#δέμας φοροίης. οὐκ ἐῶ σε κερτομεῖν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:620.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:620.1.text#ἡμᾶς τόδ' αὖθις, ὡς ἄδην ἐν Ἰλίῳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:621.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:621.1.text#πόνους παρεῖχες σῷ πόσει καὶ συμμάχοις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:622.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:622.1.text#τοῦτ' ἔστ' ἐκεῖνο· ξυμβεβᾶσιν οἱ λόγοι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:623.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:623.1.text#οἱ τῆσδ' ἀληθεῖς. ὦ ποθεινὸς ἡμέρα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:624.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:624.1.text#ἥ σ' εἰς ἐμὰς ἔδωκεν ὠλένας λαβεῖν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:625.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:625.1.text#ὦ φίλτατ' ἀνδρῶν Μενέλεως, ὁ μὲν χρόνος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:626.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:626.1.text#παλαιός, ἡ δὲ τέρψις ἀρτίως πάρα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:627.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:627.1.text#ἔλαβον ἀσμένα πόσιν ἐμόν, φίλαι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:628.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:628.1.text#περί τ' ἐπέτασα χέρα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:629.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:629.1.text#φίλιον ἐν μακρᾷ φλογὶ φαεσφόρῳ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:630.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:630.1.text#κἀγὼ σέ· πολλοὺς δ' ἐν μέσῳ λόγους ἔχων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:631.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:631.1.text#οὐκ οἶδ' ὁποίου πρῶτον ἄρξωμαι τὰ νῦν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:632.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:632.1.text#γέγηθα, κρατὶ δ' ὀρθίους ἐθείρας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:633.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:633.1.text#ἀνεπτέρωκα καὶ δάκρυ σταλάσσω,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:634.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:634.1.text#περὶ δὲ γυῖα χέρας ἔβαλον, ἡδονάν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:635.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:635.1.text#ὦ πόσις, ὡς λάβω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:636.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:636.1.text#ὦ φιλτάτη πρόσοψις, οὐκ ἐμέμφθην·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:637.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:637.1.text#ἔχω τὰ τῆς Διός τε λέκτρα Λήδας θ',
urn:cts:greekLit:tlg0006.tlg014.fu.sp:638.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:638.1.text#ἃν ὑπὸ λαμπάδων κόροι λεύκιπποι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:640.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:640.1.text#ξυνομαίμονες ὤλβισαν ὤλβισαν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:641.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:641.1.text#τὸ πρόσθεν, ἐκ δόμων δὲ νοσφίσας σ' ἐμοῦ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:642.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:642.1.text#πρὸς ἄλλαν ἐλαύνει
urn:cts:greekLit:tlg0006.tlg014.fu.sp:643.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:643.1.text#θεὸς συμφορὰν τᾶσδε κρείσσω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:644.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:644.1.text#τὸ κακὸν δ' ἀγαθὸν σέ τε κἀμὲ συνάγαγε, πόσιν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:645.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:645.1.text#χρόνιον, ἀλλ' ὅμως ὀναίμαν τύχας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:646.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:646.1.text#ὄναιο δῆτα. ταὐτὰ δὴ ξυνεύχομαι·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:647.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:647.1.text#δυοῖν γὰρ ὄντοιν οὐχ ὃ μὲν τλήμων, ὃ δ' οὔ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:648.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:648.1.text#φίλαι φίλαι, τὰ πάρος οὐκέτι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:649.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:649.1.text#στένομεν οὐδ' ἀλγῶ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:650.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:650.1.text#πόσιν ἐμὸν ἔχομεν [ ἔχομεν, ] ὃν [ ἔμενον ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:651.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:651.1.text#ἔμενον ἐκ Τροίας πολυετῆ μολεῖν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:652.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:652.1.text#ἔχεις, ἐγώ τε σέ· ἡλίους δὲ μυρίους
urn:cts:greekLit:tlg0006.tlg014.fu.sp:653.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:653.1.text#μόλις διελθὼν ᾐσθόμην τὰ τῆς θεοῦ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:654.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:654.1.text#ἐμὰ δὲ χαρμονὰ δάκρυα· πλέον ἔχει
urn:cts:greekLit:tlg0006.tlg014.fu.sp:655.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:655.1.text#χάριτος ἢ λύπας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:656.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:656.1.text#τί φῶ; τίς ἂν τάδ' ἤλπισεν βροτῶν ποτε;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:657.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:657.1.text#ἀδόκητον ἔχω σε πρὸς στέρνοις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:658.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:658.1.text#κἀγὼ σὲ τὴν δοκοῦσαν Ἰδαίαν πόλιν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:659.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:659.1.text#μολεῖν Ἰλίου τε μελέους πύργους.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:660.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:660.1.text#πρὸς θεῶν, δόμων πῶς τῶν ἐμῶν ἀπεστάλης;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:661.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:661.1.text#ἒ ἔ· πικρὰς ἐς ἀρχὰς βαίνεις,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:662.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:662.1.text#ἒ ἔ· πικρὰν δ' ἐρευνᾷς φάτιν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:663.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:663.1.text#λέγ'· ὡς ἀκουστὰ πάντα δῶρα δαιμόνων.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:664.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:664.1.text#ἀπέπτυσα μὲν λόγον, οἷον οἷον ἐσοίσομαι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:665.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:665.1.text#ὅμως δὲ λέξον· ἡδύ τοι μόχθων κλύειν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:666.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:666.1.text#οὐκ ἐπὶ βαρβάρου λέκτρα νεανία
urn:cts:greekLit:tlg0006.tlg014.fu.sp:667.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:667.1.text#πετομένας κώπας,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:668.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:668.1.text#πετομένου δ' ἔρωτος ἀδίκων γάμων  [ … ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:669.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:669.1.text#τίς { γάρ } σε δαίμων ἢ πότμος συλᾷ πάτρας;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:670.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:670.1.text#ὁ Διὸς ὁ Διός, ὦ πόσι, παῖς μ'  [ … ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:671.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:671.1.text#ἐπέλασεν Νείλῳ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:672.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:672.1.text#θαυμαστά· τοῦ πέμψαντος; ὦ δεινοὶ λόγοι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:673.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:673.1.text#κατεδάκρυσα καὶ βλέφαρον ὑγραίνω
urn:cts:greekLit:tlg0006.tlg014.fu.sp:674.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:674.1.text#δάκρυσιν· ἁ Διός μ' ἄλοχος ὤλεσεν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:675.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:675.1.text#Ἥρα; τί νῷν χρῄζουσα προσθεῖναι κακόν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:676.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:676.1.text#ὤμοι ἐμῶν δεινῶν, λουτρῶν καὶ κρηνῶν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:677.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:677.1.text#ἵνα θεαὶ μορφὰν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:678.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:678.1.text#ἐφαίδρυναν, ἔνθεν ἔμολεν κρίσις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:679.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:679.1.text#τὰ δ' ἐς κρίσιν σοι τῶνδ' ἔθηχ' Ἥρα κακῶν — ;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:680.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:680.1.text#Πάριν ὡς ἀφέλοιτο —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:680.2.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:680.2.text#πῶς; αὔδα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:681.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:681.1.text#Κύπρις ᾧ μ' ἐπένευσεν —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:681.2.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:681.2.text#ὦ τλᾶμον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:682.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:682.1.text#τλάμων, τλάμων· ὧδ' ἐπέλασ' Αἰγύπτῳ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:683.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:683.1.text#εἶτ' ἀντέδωκ' εἴδωλον, ὡς σέθεν κλύω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:684.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:684.1.text#τὰ δὲ { σὰ } κατὰ μέλαθρα πάθεα πάθεα, μᾶτερ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:685.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:685.1.text#οἲ 'γώ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:685.2.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:685.2.text#τί φῄς;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:686.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:686.1.text#οὐκ ἔστι μάτηρ· ἀγχόνιον δὲ βρόχον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:687.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:687.1.text#δι' ἐμὰν κατεδήσατο δυσγάμου αἰσχύναν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:688.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:688.1.text#ὤμοι· θυγατρὸς δ' Ἑρμιόνης ἔστιν βίος;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:689.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:689.1.text#ἄγαμος ἄτεκνος, ὦ πόσι, καταστένει
urn:cts:greekLit:tlg0006.tlg014.fu.sp:690.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:690.1.text#γάμον ἄγαμον { ἐμόν }.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:691.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:691.1.text#ὦ πᾶν κατ' ἄκρας δῶμ' ἐμὸν πέρσας Πάρις,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:692.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:692.1.text#τάδε καὶ σὲ διώλεσε μυριάδας τε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:693.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:693.1.text#χαλκεόπλων Δαναῶν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:694.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:694.1.text#ἐμὲ δὲ πατρίδος ἄπο κακόποτμον ἀραίαν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:695.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:695.1.text#ἔβαλε θεὸς ἀπό { τε } πόλεος ἀπό τε σέθεν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:696.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:696.1.text#ὅτε μέλαθρα λέχεά τ' ἔλιπον — οὐ λιποῦσ'
urn:cts:greekLit:tlg0006.tlg014.fu.sp:697.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:697.1.text#ἐπ' αἰσχροῖς γάμοις.[ … ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:698.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:698.1.text#εἰ καὶ τὰ λοιπὰ τῆς τύχης εὐδαίμονος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:699.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:699.1.text#τύχοιτε, πρὸς τὰ πρόσθεν ἀρκέσειεν ἄν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:700.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:700.1.text#Μενέλαε, κἀμοὶ πρόσδοτον τῆς ἡδονῆς,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:701.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:701.1.text#ἣν μανθάνω μὲν καὐτός, οὐ σαφῶς δ' ἔχω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:702.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:702.1.text#ἀλλ', ὦ γεραιέ, καὶ σὺ κοινώνει λόγων.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:703.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:703.1.text#οὐχ ἥδε μόχθων τῶν ἐν Ἰλίῳ βραβεύς;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:704.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:704.1.text#οὐχ ἥδε, πρὸς θεῶν δ' ἦμεν ἠπατημένοι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:705.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:705.1.text#νεφέλης ἄγαλμ' ἔχοντες ἐν χεροῖν λυγρόν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:706.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:706.1.text#τί φῄς;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:707.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:707.1.text#νεφέλης ἄρ' ἄλλως εἴχομεν πόνους πέρι;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:708.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:708.1.text#Ἥρας τάδ' ἔργα καὶ θεῶν τρισσῶν ἔρις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:709.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:709.1.text#ἡ δ' οὖσ' ἀληθῶς ἐστιν ἥδε σὴ δάμαρ;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:710.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:710.1.text#αὕτη· λόγοις [ δ' ] ἐμοῖσι πίστευσον τάδε.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:711.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:711.1.text#ὦ θύγατερ, ὁ θεὸς ὡς ἔφυ τι ποικίλον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:712.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:712.1.text#καὶ δυστέκμαρτον. εὖ δέ πως πάντα στρέφει
urn:cts:greekLit:tlg0006.tlg014.fu.sp:713.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:713.1.text#ἐκεῖσε κἀκεῖσ' ἀναφέρων· ὃ μὲν πονεῖ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:714.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:714.1.text#ὃ δ' οὐ πονήσας αὖθις ὄλλυται κακῶς,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:715.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:715.1.text#βέβαιον οὐδὲν τῆς ἀεὶ τύχης ἔχων.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:716.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:716.1.text#σὺ γὰρ πόσις τε σὸς πόνων μετέσχετε,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:717.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:717.1.text#σὺ μὲν λόγοισιν, ὃ δὲ δορὸς προθυμίᾳ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:718.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:718.1.text#σπεύδων δ' ὅτ' ἔσπευδ' οὐδὲν εἶχε· νῦν δ' ἔχει
urn:cts:greekLit:tlg0006.tlg014.fu.sp:719.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:719.1.text#αὐτόματα πράξας τἀγάθ' εὐτυχέστατα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:720.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:720.1.text#οὐκ ἄρα γέροντα πατέρα καὶ Διοσκόρω
urn:cts:greekLit:tlg0006.tlg014.fu.sp:721.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:721.1.text#ᾔσχυνας, οὐδ' ἔδρασας οἷα κλῄζεται.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:722.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:722.1.text#νῦν ἀνανεοῦμαι τὸν σὸν ὑμέναιον πάλιν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:723.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:723.1.text#καὶ λαμπάδων μεμνήμεθ' ἃς τετραόροις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:724.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:724.1.text#ἵπποις τροχάζων παρέφερον· σὺ δ' ἐν δίφροις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:725.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:725.1.text#ξὺν τῷδε νύμφη δῶμ' ἔλειπες ὄλβιον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:726.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:726.1.text#κακὸς γὰρ ὅστις μὴ σέβει τὰ δεσποτῶν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:727.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:727.1.text#καὶ ξυγγέγηθε καὶ συνωδίνει κακοῖς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:728.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:728.1.text#ἐγὼ μὲν εἴην, κεἰ πέφυχ' ὅμως λάτρις,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:729.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:729.1.text#ἐν τοῖσι γενναίοισιν ἠριθμημένος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:730.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:730.1.text#δούλοισι, τοὔνομ' οὐκ ἔχων ἐλεύθερον,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:731.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:731.1.text#τὸν νοῦν δέ· κρεῖσσον γὰρ τόδ' ἢ δυοῖν κακοῖν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:732.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:732.1.text#ἕν' ὄντα χρῆσθαι, τὰς φρένας τ' ἔχειν κακὰς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:733.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:733.1.text#ἄλλων τ' ἀκούειν δοῦλον ὄντα τῶν πέλας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:734.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:734.1.text#ἄγ', ὦ γεραιέ, πολλὰ μὲν παρ' ἀσπίδα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:735.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:735.1.text#μοχθήματ' ἐξέπλησας ἐκπονῶν ἐμοί,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:736.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:736.1.text#καὶ νῦν μετασχὼν τῆς ἐμῆς εὐπραξίας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:737.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:737.1.text#ἄγγειλον ἐλθὼν τοῖς λελειμμένοις φίλοις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:738.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:738.1.text#τάδ' ὡς ἔχονθ' ηὕρηκας οἷ τ' ἐσμὲν τύχης,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:739.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:739.1.text#μένειν τ' ἐπ' ἀκταῖς τούς τ' ἐμοὺς καραδοκεῖν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:740.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:740.1.text#ἀγῶνας οἳ μένουσί μ', ὡς ἐλπίζομεν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:741.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:741.1.text#κεἰ τήνδε πως δυναίμεθ' ἐκκλέψαι χθονός,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:742.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:742.1.text#φρουρεῖν ὅπως ἂν εἰς ἓν ἐλθόντες τύχης
urn:cts:greekLit:tlg0006.tlg014.fu.sp:743.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:743.1.text#ἐκ βαρβάρων σωθῶμεν, ἢν δυνώμεθα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:744.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:744.1.text#ἔσται τάδ', ὦναξ. ἀλλά τοι τὰ μάντεων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:745.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:745.1.text#ἐσεῖδον ὡς φαῦλ' ἐστὶ καὶ ψευδῶν πλέα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:746.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:746.1.text#οὐδ' ἦν ἄρ' ὑγιὲς οὐδὲν ἐμπύρου φλογὸς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:747.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:747.1.text#οὐδὲ πτερωτῶν φθέγματ'· εὔηθες δέ τοι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:748.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:748.1.text#τὸ καὶ δοκεῖν ὄρνιθας ὠφελεῖν βροτούς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:749.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:749.1.text#Κάλχας γὰρ οὐκ εἶπ' οὐδ' ἐσήμηνε στρατῷ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:750.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:750.1.text#νεφέλης ὑπερθνῄσκοντας εἰσορῶν φίλους
urn:cts:greekLit:tlg0006.tlg014.fu.sp:751.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:751.1.text#οὐδ' Ἕλενος, ἀλλὰ πόλις ἀνηρπάσθη μάτην.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:752.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:752.1.text#εἴποις ἄν· οὕνεχ' ὁ θεὸς οὐκ ἠβούλετο;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:753.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:753.1.text#τί δῆτα μαντευόμεθα; τοῖς θεοῖσι χρὴ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:754.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:754.1.text#θύοντας αἰτεῖν ἀγαθά, μαντείας δ' ἐᾶν·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:755.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:755.1.text#βίου γὰρ ἄλλως δέλεαρ ηὑρέθη τόδε,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:756.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:756.1.text#κοὐδεὶς ἐπλούτησ' ἐμπύροισιν ἀργὸς ὤν·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:757.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:757.1.text#γνώμη δ' ἀρίστη μάντις ἥ τ' εὐβουλία.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:758.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:758.1.text#ἐς ταὐτὸ κἀμοὶ δόξα μαντειῶν πέρι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:759.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:759.1.text#χωρεῖ γέροντι· τοὺς θεοὺς ἔχων τις ἂν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:760.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:760.1.text#φίλους ἀρίστην μαντικὴν ἔχοι δόμοις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:761.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:761.1.text#εἶἑν· τὰ μὲν δὴ δεῦρ' ἀεὶ καλῶς ἔχει.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:762.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:762.1.text#ὅπως δ' ἐσώθης, ὦ τάλας, Τροίας ἄπο,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:763.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:763.1.text#κέρδος μὲν οὐδὲν εἰδέναι, πόθος δέ τις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:764.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:764.1.text#τὰ τῶν φίλων φίλοισιν αἰσθέσθαι κακά.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:765.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:765.1.text#ἦ πόλλ' ἀνήρου μ' ἑνὶ λόγῳ μιᾷ θ' ὁδῷ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:766.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:766.1.text#τί σοι λέγοιμ' ἂν τὰς ἐν Αἰγαίῳ φθορὰς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:767.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:767.1.text#τὰ Ναυπλίου τ' Εὐβοικὰ πυρπολήματα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:768.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:768.1.text#Κρήτην τε Λιβύης θ' ἃς ἐπεστράφην πόλεις,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:769.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:769.1.text#σκοπιάς τε Περσέως; οὐ γὰρ ἐμπλήσαιμί σ' { ἂν }
urn:cts:greekLit:tlg0006.tlg014.fu.sp:770.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:770.1.text#μύθων, λέγων τ' ἄν σοι κάκ' ἀλγοίην ἔτι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:771.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:771.1.text#πάσχων τ' ἔκαμνον· δὶς δὲ λυπηθεῖμεν ἄν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:772.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:772.1.text#κάλλιον εἶπας ἤ σ' ἀνηρόμην ἐγώ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:773.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:773.1.text#ἓν δ' εἰπὲ πάντα παραλιπών, πόσον χρόνον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:774.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:774.1.text#πόντου 'πὶ νώτοις ἅλιον ἐφθείρου πλάνον;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:775.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:775.1.text#ἐν ναυσὶν ὢν πρὸς τοῖσιν ἐν Τροίᾳ δέκα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:776.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:776.1.text#ἔτεσι διῆλθον ἑπτὰ περιδρομὰς ἐτῶν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:777.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:777.1.text#φεῦ φεῦ· μακρόν γ' ἔλεξας, ὦ τάλας, χρόνον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:778.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:778.1.text#σωθεὶς δ' ἐκεῖθεν ἐνθάδ' ἦλθες ἐς σφαγάς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:779.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:779.1.text#πῶς φῄς; τί λέξεις; ὥς μ' ἀπώλεσας, γύναι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:780.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:780.1.text#φεῦγ' ὡς τάχιστα τῆσδ' ἀπαλλαχθεὶς χθονός.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:781.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:781.1.text#θανῇ πρὸς ἀνδρὸς οὗ τάδ' ἐστὶ δώματα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:782.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:782.1.text#τί χρῆμα δράσας ἄξιον τῆς συμφορᾶς;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:783.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:783.1.text#ἥκεις ἄελπτος ἐμποδὼν ἐμοῖς γάμοις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:784.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:784.1.text#ἦ γὰρ γαμεῖν τις τἄμ' ἐβουλήθη λέχη;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:785.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:785.1.text#ὕβριν θ' ὑβρίζειν εἰς ἔμ', ἣν ἔτλην ἐγώ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:786.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:786.1.text#ἰδίᾳ σθένων τις ἢ τυραννεύων χθονός;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:787.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:787.1.text#ὃς γῆς ἀνάσσει τῆσδε Πρωτέως γόνος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:788.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:788.1.text#τόδ' ἔστ' ἐκεῖν' αἴνιγμ' ὃ προσπόλου κλύω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:789.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:789.1.text#ποίοις ἐπιστὰς βαρβάροις πυλώμασιν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:790.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:790.1.text#τοῖσδ', ἔνθεν ὥσπερ πτωχὸς ἐξηλαυνόμην.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:791.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:791.1.text#οὔ που προσῄτεις βίοτον; ὦ τάλαιν' ἐγώ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:792.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:792.1.text#τοὔργον μὲν ἦν τοῦτ', ὄνομα δ' οὐκ εἶχεν τόδε.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:793.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:793.1.text#πάντ' οἶσθ' ἄρ', ὡς ἔοικας, ἀμφ' ἐμῶν γάμων.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:794.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:794.1.text#οἶδ'· εἰ δὲ λέκτρα διέφυγες τάδ' οὐκ ἔχω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:795.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:795.1.text#ἄθικτον εὐνὴν ἴσθι σοι σεσῳσμένην.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:796.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:796.1.text#τίς τοῦδε πειθώ; φίλα γάρ, εἰ σαφῆ λέγεις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:797.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:797.1.text#ὁρᾷς τάφου τοῦδ' ἀθλίους ἕδρας ἐμάς;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:798.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:798.1.text#ὁρῶ ταλαίνας στιβάδας, ὧν τί σοὶ μέτα;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:799.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:799.1.text#ἐνταῦθα λέκτρων ἱκετεύομεν φυγάς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:800.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:800.1.text#βωμοῦ σπανίζουσ' ἢ νόμοισι βαρβάροις;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:801.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:801.1.text#ἐρρύεθ' ἡμᾶς τοῦτ' ἴσον ναοῖς θεῶν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:802.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:802.1.text#οὐδ' ἄρα πρὸς οἴκους ναυστολεῖν { σ' } ἔξεστί μοι;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:803.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:803.1.text#ξίφος μένει σε μᾶλλον ἢ τοὐμὸν λέχος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:804.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:804.1.text#οὕτως ἂν εἴην ἀθλιώτατος βροτῶν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:805.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:805.1.text#μή νυν καταιδοῦ, φεῦγε δ' ἐκ τῆσδε χθονός.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:806.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:806.1.text#λιπών σε; Τροίαν ἐξέπερσα σὴν χάριν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:807.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:807.1.text#κρεῖσσον γὰρ ἤ σε τἄμ' ἀποκτεῖναι λέχη.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:808.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:808.1.text#ἄνανδρά γ' εἶπας Ἰλίου τ' οὐκ ἄξια.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:809.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:809.1.text#οὐκ ἂν κτάνοις τύραννον, ὃ σπεύδεις ἴσως.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:810.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:810.1.text#οὕτω σιδήρῳ τρωτὸν οὐκ ἔχει δέμας;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:811.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:811.1.text#εἴσῃ. τὸ τολμᾶν δ' ἀδύνατ' ἀνδρὸς οὐ σοφοῦ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:812.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:812.1.text#σιγῇ παράσχω δῆτ' ἐμὰς δῆσαι χέρας;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:813.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:813.1.text#ἐς ἄπορον ἥκεις· δεῖ δὲ μηχανῆς τινος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:814.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:814.1.text#δρῶντας γὰρ ἢ μὴ δρῶντας ἥδιον θανεῖν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:815.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:815.1.text#μί' ἔστιν ἐλπίς, ᾗ μόνῃ σωθεῖμεν ἄν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:816.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:816.1.text#ὠνητὸς ἢ τολμητὸς ἢ λόγων ὕπο;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:817.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:817.1.text#εἰ μὴ τύραννός { σ' } ἐκπύθοιτ' ἀφιγμένον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:818.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:818.1.text#ἐρεῖ δὲ τίς μ'; οὐ γνώσεταί γ' ὅς εἰμ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:819.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:819.1.text#ἔστ' ἔνδον αὐτῷ ξύμμαχος θεοῖς ἴση.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:820.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:820.1.text#φήμη τις οἴκων ἐν μυχοῖς ἱδρυμένη;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:821.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:821.1.text#οὔκ, ἀλλ' ἀδελφή· Θεονόην καλοῦσί νιν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:822.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:822.1.text#χρηστήριον μὲν τοὔνομ'· ὅ τι δὲ δρᾷ φράσον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:823.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:823.1.text#πάντ' οἶδ', ἐρεῖ τε συγγόνῳ παρόντα σε.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:824.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:824.1.text#θνῄσκοιμεν ἄν· λαθεῖν γὰρ οὐχ οἷόν τέ μοι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:825.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:825.1.text#ἴσως ἂν ἀναπείσαιμεν ἱκετεύοντέ νιν —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:826.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:826.1.text#τί χρῆμα δρᾶσαι; τίν' ὑπάγεις μ' ἐς ἐλπίδα;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:827.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:827.1.text#παρόντα γαίᾳ μὴ φράσαι σε συγγόνῳ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:828.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:828.1.text#πείσαντε δ' ἐκ γῆς διορίσαιμεν ἂν πόδα;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:829.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:829.1.text#κοινῇ γ' ἐκείνῃ ῥᾳδίως, λάθρᾳ δ' ἂν οὔ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:830.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:830.1.text#σὸν ἔργον, ὡς γυναικὶ πρόσφορον γυνή.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:831.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:831.1.text#ὡς οὐκ ἄχρωστα γόνατ' ἐμῶν ἕξει χερῶν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:832.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:832.1.text#φέρ', ἢν δὲ δὴ νῷν μὴ ἀποδέξηται λόγους;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:833.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:833.1.text#θανῇ· γαμοῦμαι δ' ἡ τάλαιν' ἐγὼ βίᾳ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:834.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:834.1.text#προδότις ἂν εἴης· τὴν βίαν σκήψασ' ἔχεις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:835.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:835.1.text#ἀλλ' ἁγνὸν ὅρκον σὸν κάρα κατώμοσα  [ … ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:836.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:836.1.text#τί φῄς; θανεῖσθαι; κοὔποτ' ἀλλάξεις λέχη;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:837.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:837.1.text#ταὐτῷ ξίφει γε· κείσομαι δὲ σοῦ πέλας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:838.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:838.1.text#ἐπὶ τοῖσδε τοίνυν δεξιᾶς ἐμῆς θίγε.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:839.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:839.1.text#ψαύω, θανόντος σοῦ τόδ' ἐκλείψειν φάος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:840.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:840.1.text#κἀγὼ στερηθεὶς σοῦ τελευτήσειν βίον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:841.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:841.1.text#πῶς οὖν θανούμεθ' ὥστε καὶ δόξαν λαβεῖν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:842.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:842.1.text#τύμβου 'πὶ νώτῳ σὲ κτανὼν ἐμὲ κτενῶ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:843.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:843.1.text#πρῶτον δ' ἀγῶνα μέγαν ἀγωνιούμεθα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:844.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:844.1.text#λέκτρων ὑπὲρ σῶν. ὁ δὲ θέλων ἴτω πέλας·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:845.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:845.1.text#τὸ Τρωικὸν γὰρ οὐ καταισχυνῶ κλέος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:846.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:846.1.text#οὐδ' Ἑλλάδ' ἐλθὼν λήψομαι πολὺν ψόγον,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:847.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:847.1.text#ὅστις Θέτιν μὲν ἐστέρησ' Ἀχιλλέως,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:848.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:848.1.text#Τελαμωνίου δ' Αἴαντος εἰσεῖδον σφαγάς,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:849.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:849.1.text#τὸν Νηλέως τ' ἄπαιδα· διὰ δὲ τὴν ἐμὴν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:850.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:850.1.text#οὐκ ἀξιώσω κατθανεῖν δάμαρτ' ἐγώ;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:851.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:851.1.text#μάλιστά γε· εἰ γάρ εἰσιν οἱ θεοὶ σοφοί,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:852.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:852.1.text#εὔψυχον ἄνδρα πολεμίων θανόνθ' ὕπο
urn:cts:greekLit:tlg0006.tlg014.fu.sp:853.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:853.1.text#κούφῃ καταμπίσχουσιν ἐν τύμβῳ χθονί,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:854.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:854.1.text#κακοὺς δ' ἐφ' ἕρμα στερεὸν ἐκβάλλουσι γῆς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:855.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:855.1.text#ὦ θεοί, γενέσθω δή ποτ' εὐτυχὲς γένος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:856.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:856.1.text#τὸ Ταντάλειον καὶ μεταστήτω κακῶν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:857.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:857.1.text#οἲ ἐγὼ τάλαινα· τῆς τύχης γὰρ ὧδ' ἔχω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:858.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:858.1.text#Μενέλαε, διαπεπράγμεθ'· ἐκβαίνει δόμων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:859.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:859.1.text#ἡ θεσπιῳδὸς Θεονόη· κτυπεῖ δόμος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:860.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:860.1.text#κλῄθρων λυθέντων. φεῦγ'· ἀτὰρ τί φευκτέον;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:861.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:861.1.text#ἀποῦσα γάρ σε καὶ παροῦσ' ἀφιγμένον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:862.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:862.1.text#δεῦρ' οἶδεν· ὦ δύστηνος, ὡς ἀπωλόμην.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:863.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:863.1.text#Τροίας δὲ σωθεὶς κἀπὸ βαρβάρου χθονὸς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:864.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:864.1.text#ἐς βάρβαρ' ἐλθὼν φάσγαν' αὖθις ἐμπεσῇ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:865.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:865.1.text#ἡγοῦ σύ μοι φέρουσα λαμπτήρων σέλας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:866.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:866.1.text#θείου δε σεμνὸν θεσμὸν αἰθέρος μυχούς,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:867.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:867.1.text#ὡς πνεῦμα καθαρὸν οὐρανοῦ δεξώμεθα·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:868.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:868.1.text#σὺ δ' αὖ κέλευθον εἴ τις ἔβλαψεν ποδὶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:869.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:869.1.text#στείβων ἀνοσίῳ, δὸς καθαρσίῳ φλογί,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:870.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:870.1.text#κροῦσον δὲ πεύκην, ἵνα διεξέλθω, πυρός.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:871.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:871.1.text#νόμον δὲ τὸν ἐμὸν θεοῖσιν ἀποδοῦσαι πάρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:872.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:872.1.text#ἐφέστιον φλόγ' ἐς δόμους κομίζετε.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:873.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:873.1.text#Ἑλένη, τί τἀμὰ — πῶς ἔχει — θεσπίσματα;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:874.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:874.1.text#ἥκει πόσις σοι Μενέλεως ὅδ' ἐμφανής,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:875.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:875.1.text#νεῶν στερηθεὶς τοῦ τε σοῦ μιμήματος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:876.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:876.1.text#ὦ τλῆμον, οἵους διαφυγὼν ἦλθες πόνους,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:877.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:877.1.text#οὐδ' οἶσθα νόστον οἴκαδ' εἴτ' αὐτοῦ μενεῖς·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:878.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:878.1.text#ἔρις γὰρ ἐν θεοῖς σύλλογός τε σοῦ πέρι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:879.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:879.1.text#ἔσται πάρεδρος Ζηνὶ τῷδ' ἐν ἤματι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:880.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:880.1.text#Ἥρα μέν, ἥ σοι δυσμενὴς πάροιθεν ἦν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:881.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:881.1.text#νῦν ἐστιν εὔνους κἀς πάτραν σῷσαι θέλει
urn:cts:greekLit:tlg0006.tlg014.fu.sp:882.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:882.1.text#ξὺν τῇδ', ἵν' Ἑλλὰς τοὺς Ἀλεξάνδρου γάμους,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:883.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:883.1.text#δώρημα Κύπριδος, ψευδονυμφεύτους μάθῃ·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:884.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:884.1.text#Κύπρις δὲ νόστον σὸν διαφθεῖραι θέλει,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:885.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:885.1.text#ὡς μὴ 'ξελεγχθῇ μηδὲ πριαμένη φανῇ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:886.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:886.1.text#τὸ κάλλος, Ἑλένης οὕνεκ', ἀνονήτοις γάμοις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:887.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:887.1.text#τέλος δ' ἐφ' ἡμῖν, εἴθ', ἃ βούλεται Κύπρις,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:888.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:888.1.text#λέξασ' ἀδελφῷ σ' ἐνθάδ' ὄντα διολέσω,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:889.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:889.1.text#εἴτ' αὖ μεθ' Ἥρας στᾶσα σὸν σώσω βίον,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:890.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:890.1.text#κρύψασ' ὁμαίμον', ὅς με προστάσσει τάδε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:891.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:891.1.text#εἰπεῖν, ὅταν γῆν τήνδε νοστήσας τύχῃς [ … ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:892.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:892.1.text#τίς εἶσ' ἀδελφῷ τόνδε σημανῶν ἐμῷ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:893.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:893.1.text#παρόνθ', ὅπως ἂν τοὐμὸν ἀσφαλῶς ἔχῃ;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:894.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:894.1.text#ὦ παρθέν', ἱκέτις ἀμφὶ σὸν πίτνω γόνυ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:895.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:895.1.text#καὶ προσκαθίζω θᾶκον οὐκ εὐδαίμονα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:896.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:896.1.text#ὑπέρ τ' ἐμαυτῆς τοῦδέ θ', ὃν μόλις ποτὲ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:897.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:897.1.text#λαβοῦσ' ἐπ' ἀκμῆς εἰμι κατθανόντ' ἰδεῖν·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:898.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:898.1.text#μή μοι κατείπῃς σῷ κασιγνήτῳ πόσιν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:899.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:899.1.text#τόνδ' εἰς ἐμὰς ἥκοντα φιλτάτας χέρας,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:900.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:900.1.text#σῷσον δέ, λίσσομαί σε· συγγόνῳ δὲ σῷ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:901.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:901.1.text#τὴν εὐσέβειαν μὴ προδῷς τὴν σήν ποτε,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:902.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:902.1.text#χάριτας πονηρὰς κἀδίκους ὠνουμένη.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:903.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:903.1.text#μισεῖ γὰρ ὁ θεὸς τὴν βίαν, τὰ κτητὰ δὲ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:904.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:904.1.text#κτᾶσθαι κελεύει πάντας οὐκ ἐς ἁρπαγάς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:905.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:905.1.text#[ ἐατέος δ' ὁ πλοῦτος ἄδικός τις ὤν. ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:906.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:906.1.text#κοινὸς γάρ ἐστιν οὐρανὸς πᾶσιν βροτοῖς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:907.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:907.1.text#καὶ γαῖ', ἐν ᾗ χρὴ δώματ' ἀναπληρουμένους
urn:cts:greekLit:tlg0006.tlg014.fu.sp:908.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:908.1.text#τἀλλότρια μὴ σχεῖν μηδ' ἀφαιρεῖσθαι βίᾳ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:909.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:909.1.text#ἡμᾶς δὲ καιρίως μέν, ἀθλίως δ' ἐμοί,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:910.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:910.1.text#Ἑρμῆς ἔδωκε πατρὶ σῷ σῴζειν πόσει
urn:cts:greekLit:tlg0006.tlg014.fu.sp:911.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:911.1.text#τῷδ' ὃς πάρεστι κἀπολάζυσθαι θέλει.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:912.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:912.1.text#πῶς οὖν θανὼν ἂν ἀπολάβοι; κεῖνος δὲ πῶς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:913.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:913.1.text#τὰ ζῶντα τοῖς θανοῦσιν ἀποδοίη ποτ' ἄν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:914.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:914.1.text#ἤδη τὰ τοῦ θεοῦ καὶ τὰ τοῦ πατρὸς σκόπει·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:915.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:915.1.text#πότερον ὁ δαίμων χὡ θανὼν τὰ τῶν πέλας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:916.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:916.1.text#βούλοιντ' ἂν ἢ οὐ βούλοιντ' ἂν ἀποδοῦναι πάλιν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:917.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:917.1.text#δοκῶ μέν. οὔκουν χρή σε συγγόνῳ πλέον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:918.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:918.1.text#νέμειν ματαίῳ μᾶλλον ἢ χρηστῷ πατρί.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:919.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:919.1.text#εἰ δ' οὖσα μάντις καὶ τὰ θεῖ' ἡγουμένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:920.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:920.1.text#τὸ μὲν δίκαιον τοῦ πατρὸς διαφθερεῖς,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:921.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:921.1.text#τῷ δ' οὐ δικαίῳ συγγόνῳ σώσεις χάριν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:922.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:922.1.text#αἰσχρὸν τὰ μέν σε θεῖα πάντ' ἐξειδέναι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:923.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:923.1.text#τά τ' ὄντα καὶ μέλλοντα, τὰ δὲ δίκαια μή.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:924.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:924.1.text#τήν τ' ἀθλίαν ἔμ', οἷσιν ἔγκειμαι κακοῖς,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:925.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:925.1.text#ῥῦσαι, πάρεργον δοῦσα τοῦτο τῆς τύχης·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:926.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:926.1.text#Ἑλένην γὰρ οὐδεὶς ὅστις οὐ στυγεῖ βροτῶν·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:927.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:927.1.text#ἣ κλῄζομαι καθ' Ἑλλάδ' ὡς προδοῦσ' ἐμὸν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:928.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:928.1.text#πόσιν Φρυγῶν ᾤκησα πολυχρύσους δόμους.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:929.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:929.1.text#ἢν δ' Ἑλλάδ' ἔλθω κἀπιβῶ Σπάρτης { πάλιν },
urn:cts:greekLit:tlg0006.tlg014.fu.sp:930.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:930.1.text#κλύοντες εἰσιδόντες ὡς τέχναις θεῶν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:931.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:931.1.text#ὤλοντ', ἐγὼ δὲ προδότις οὐκ ἄρ' ἦ φίλων,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:932.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:932.1.text#πάλιν μ' ἀνάξουσ' ἐς τὸ σῶφρον αὖθις αὖ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:933.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:933.1.text#ἑδνώσομαί τε θυγατέρ', ἣν οὐδεὶς γαμεῖ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:934.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:934.1.text#τὴν δ' ἐνθάδ' ἐκλιποῦσ' ἀλητείαν πικρὰν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:935.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:935.1.text#ὄντων ἐν οἴκοις χρημάτων ὀνήσομαι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:936.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:936.1.text#κεἰ μὲν θανὼν ὅδ' ἐν πυρᾷ κατεσφάγη,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:937.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:937.1.text#πρόσω σφ' ἀπόντα δακρύοις ἂν ἠγάπων·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:938.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:938.1.text#νῦν δ' ὄντα καὶ σωθέντ' ἀφαιρεθήσομαι;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:939.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:939.1.text#μὴ δῆτα, παρθέν', ἀλλά σ' ἱκετεύω τόδε·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:940.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:940.1.text#δὸς τὴν χάριν μοι τήνδε καὶ μιμοῦ τρόπους
urn:cts:greekLit:tlg0006.tlg014.fu.sp:941.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:941.1.text#πατρὸς δικαίου· παισὶ γὰρ κλέος τόδε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:942.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:942.1.text#κάλλιστον, ὅστις ἐκ πατρὸς χρηστοῦ γεγὼς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:943.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:943.1.text#ἐς ταὐτὸν ἦλθε τοῖς τεκοῦσι τοὺς τρόπους.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:944.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:944.1.text#οἰκτρὸν μὲν οἱ παρόντες ἐν μέσῳ λόγοι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:945.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:945.1.text#οἰκτρὰ δὲ καὶ σύ. τοὺς δὲ Μενέλεω ποθῶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:946.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:946.1.text#λόγους ἀκοῦσαι τίνας ἐρεῖ ψυχῆς πέρι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:947.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:947.1.text#ἐγὼ σὸν οὔτ' ἂν προσπεσεῖν τλαίην γόνυ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:948.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:948.1.text#οὔτ' ἂν δακρῦσαι βλέφαρα· τὴν Τροίαν γὰρ ἂν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:949.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:949.1.text#δειλοὶ γενόμενοι πλεῖστον αἰσχύνοιμεν ἄν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:950.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:950.1.text#καίτοι λέγουσιν ὡς πρὸς ἀνδρὸς εὐγενοῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:951.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:951.1.text#ἐν ξυμφοραῖσι δάκρυ' ἀπ' ὀφθαλμῶν βαλεῖν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:952.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:952.1.text#ἀλλ' οὐχὶ τοῦτο τὸ καλόν, εἰ καλὸν τόδε,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:953.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:953.1.text#αἱρήσομαι 'γὼ πρόσθε τῆς εὐψυχίας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:954.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:954.1.text#ἀλλ', εἰ μὲν ἄνδρα σοι δοκεῖ σῷσαι ξένον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:955.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:955.1.text#ζητοῦντά γ' ὀρθῶς ἀπολαβεῖν δάμαρτ' ἐμήν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:956.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:956.1.text#ἀπόδος τε καὶ πρὸς σῷσον· εἰ δὲ μὴ δοκεῖ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:957.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:957.1.text#ἐγὼ μὲν οὐ νῦν πρῶτον ἀλλὰ πολλάκις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:958.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:958.1.text#ἄθλιος ἂν εἴην, σὺ δὲ γυνὴ κακὴ φανῇ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:959.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:959.1.text#ἃ δ' ἄξι' ἡμῶν καὶ δίκαι' ἡγούμεθα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:960.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:960.1.text#καὶ σῆς μάλιστα καρδίας ἀνθάψεται,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:961.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:961.1.text#λέξω τάδ' ἀμφὶ μνῆμα σοῦ πατρὸς πόθῳ·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:962.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:962.1.text#ὦ γέρον, ὃς οἰκεῖς τόνδε λάινον τάφον,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:963.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:963.1.text#ἀπόδος, ἀπαιτῶ τὴν ἐμὴν δάμαρτά σε,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:964.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:964.1.text#ἣν Ζεὺς ἔπεμψε δεῦρό σοι σῴζειν ἐμοί.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:965.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:965.1.text#οἶδ' οὕνεκ' ἡμῖν οὔποτ' ἀποδώσεις θανών·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:966.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:966.1.text#ἀλλ' ἥδε πατέρα νέρθεν ἀνακαλούμενον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:967.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:967.1.text#οὐκ ἀξιώσει τὸν πρὶν εὐκλεέστατον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:968.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:968.1.text#κακῶς ἀκοῦσαι· κυρία γάρ ἐστι νῦν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:969.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:969.1.text#ὦ νέρτερ' Ἅιδη, καὶ σὲ σύμμαχον καλῶ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:970.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:970.1.text#ὃς πόλλ' ἐδέξω τῆσδ' ἕκατι σώματα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:971.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:971.1.text#πεσόντα τὠμῷ φασγάνῳ, μισθὸν δ' ἔχεις·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:972.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:972.1.text#ἢ νῦν ἐκείνους ἀπόδος ἐμψύχους πάλιν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:973.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:973.1.text#ἢ τήνδε πατρὸς εὐσεβοῦς ἀνάγκασον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:974.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:974.1.text#κρείσσω φανεῖσαν τἀμά γ' ἀποδοῦναι λέχη.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:975.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:975.1.text#εἰ δ' ἐμὲ γυναῖκα τὴν ἐμὴν συλήσετε,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:976.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:976.1.text#ἅ σοι παρέλιπεν ἥδε τῶν λόγων, φράσω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:977.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:977.1.text#ὅρκοις κεκλῄμεθ', ὡς μάθῃς, ὦ παρθένε,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:978.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:978.1.text#πρῶτον μὲν ἐλθεῖν διὰ μάχης σῷ συγγόνῳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:979.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:979.1.text#κἀκεῖνον ἢ 'μὲ δεῖ θανεῖν· ἁπλοῦς λόγος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:980.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:980.1.text#ἢν δ' ἐς μὲν ἀλκὴν μὴ πόδ' ἀντιθῇ ποδί,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:981.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:981.1.text#λιμῷ δὲ θηρᾷ τύμβον ἱκετεύοντε νώ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:982.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:982.1.text#κτανεῖν δέδοκται τήνδε μοι κἄπειτ' ἐμὸν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:983.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:983.1.text#πρὸς ἧπαρ ὦσαι δίστομον ξίφος τόδε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:984.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:984.1.text#τύμβου 'πὶ νώτοις τοῦδ', ἵν' αἵματος ῥοαὶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:985.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:985.1.text#τάφου καταστάζωσι· κεισόμεσθα δὲ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:986.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:986.1.text#νεκρὼ δύ' ἑξῆς τῷδ' ἐπὶ ξεστῷ τάφῳ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:987.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:987.1.text#ἀθάνατον ἄλγος σοί, ψόγος δὲ σῷ πατρί.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:988.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:988.1.text#οὐ γὰρ γαμεῖ τήνδ' οὔτε σύγγονος σέθεν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:989.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:989.1.text#οὔτ' ἄλλος οὐδείς· ἀλλ' ἐγώ σφ' ἀπάξομαι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:990.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:990.1.text#εἰ μὴ πρὸς οἴκους δυνάμεθ', ἀλλὰ πρὸς νεκρούς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:991.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:991.1.text#τί ταῦτα; δακρύοις ἐς τὸ θῆλυ τρεπόμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:992.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:992.1.text#ἐλεινὸς ἦν ἂν μᾶλλον ἢ δραστήριος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:993.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:993.1.text#κτεῖν', εἰ δοκεῖ σοι· δυσκλεᾶς γὰρ οὐ κτενεῖς·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:994.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:994.1.text#μᾶλλόν γε μέντοι τοῖς ἐμοῖς πείθου λόγοις,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:995.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:995.1.text#ἵν' ᾖς δικαία καὶ δάμαρτ' ἐγὼ λάβω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:996.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:996.1.text#ἐν σοὶ βραβεύειν, ὦ νεᾶνι, τοὺς λόγους·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:997.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:997.1.text#οὕτω δὲ κρῖνον, ὡς ἅπασιν ἁνδάνῃς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:998.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:998.1.text#ἐγὼ πέφυκά τ' εὐσεβεῖν καὶ βούλομαι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:999.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:999.1.text#φιλῶ τ' ἐμαυτήν, καὶ κλέος τοὐμοῦ πατρὸς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1000.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1000.1.text#οὐκ ἂν μιάναιμ', οὐδὲ συγγόνῳ χάριν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1001.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1001.1.text#δοίην ἂν ἐξ ἧς δυσκλεὴς φανήσομαι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1002.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1002.1.text#ἔνεστι δ' ἱερὸν τῆς δίκης ἐμοὶ μέγα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1003.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1003.1.text#ἐν τῇ φύσει· καὶ τοῦτο Νηρέως πάρα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1004.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1004.1.text#ἔχουσα σῴζειν, Μενέλεως, πειράσομαι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1005.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1005.1.text#Ἥρᾳ δ', ἐπείπερ βούλεταί σ' εὐεργετεῖν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1006.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1006.1.text#ἐς ταὐτὸν οἴσω ψῆφον· ἡ Κύπρις δ' ἐμοὶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1007.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1007.1.text#ἵλεως μὲν εἴη, ξυμβέβηκε δ' οὐδαμοῦ·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1008.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1008.1.text#πειράσομαι δὲ παρθένος μένειν ἀεί.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1009.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1009.1.text#ἃ δ' ἀμφὶ τύμβῳ τῷδ' ὀνειδίζεις πατρί,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1010.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1010.1.text#ἡμῖν ὅδ' αὑτὸς μῦθος. ἀδικοίημεν ἄν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1011.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1011.1.text#εἰ μὴ ἀποδώσω· καὶ γὰρ ἂν κεῖνος βλέπων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1012.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1012.1.text#ἀπέδωκεν ἂν σοὶ τήνδ' ἔχειν, ταύτῃ δὲ σέ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1013.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1013.1.text#καὶ γὰρ τίσις τῶνδ' ἐστὶ τοῖς τε νερτέροις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1014.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1014.1.text#καὶ τοῖς ἄνωθεν πᾶσιν ἀνθρώποις· ὁ νοῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1015.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1015.1.text#τῶν κατθανόντων ζῇ μὲν οὔ, γνώμην δ' ἔχει
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1016.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1016.1.text#ἀθάνατον εἰς ἀθάνατον αἰθέρ' ἐμπεσών.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1017.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1017.1.text#ὡς οὖν παραινῶ μὴ μακράν, σιγήσομαι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1018.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1018.1.text#ἅ μου καθικετεύσατ', οὐδὲ μωρίᾳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1019.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1019.1.text#ξύμβουλος ἔσομαι τῇ κασιγνήτου ποτέ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1020.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1020.1.text#εὐεργετῶ γὰρ κεῖνον οὐ δοκοῦσ' ὅμως,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1021.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1021.1.text#ἐκ δυσσεβείας ὅσιον εἰ τίθημί νιν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1022.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1022.1.text#αὐτοὶ μὲν οὖν ὁδόν τιν' ἐξευρίσκετε,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1023.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1023.1.text#ἐγὼ δ' ἀποστᾶσ' ἐκποδὼν σιγήσομαι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1024.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1024.1.text#ἐκ τῶν θεῶν δ' ἄρχεσθε χἱκετεύετε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1025.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1025.1.text#τὴν μέν σ' ἐᾶσαι πατρίδα νοστῆσαι Κύπριν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1026.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1026.1.text#Ἥρας δὲ τὴν ἔννοιαν ἐν ταὐτῷ μένειν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1027.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1027.1.text#ἣν ἐς σὲ καὶ σὸν πόσιν ἔχει σωτηρίας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1028.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1028.1.text#σὺ δ', ὦ θανών μοι πάτερ, ὅσον γ' ἐγὼ σθένω,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1029.1.speaker#Θεονόη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1029.1.text#οὔποτε κεκλήσῃ δυσσεβὴς ἀντ' εὐσεβοῦς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1030.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1030.1.text#οὐδείς ποτ' εὐτύχησεν ἔκδικος γεγώς,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1031.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1031.1.text#ἐν τῷ δικαίῳ δ' ἐλπίδες σωτηρίας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1032.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1032.1.text#Μενέλαε, πρὸς μὲν παρθένου σεσῴσμεθα·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1033.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1033.1.text#τοὐνθένδε δὴ σὲ τοὺς λόγους φέροντα χρὴ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1034.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1034.1.text#κοινὴν ξυνάπτειν μηχανὴν σωτηρίας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1035.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1035.1.text#ἄκουε δή νυν· χρόνιος εἶ κατὰ στέγας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1036.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1036.1.text#καὶ συντέθραψαι προσπόλοισι βασιλέως.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1037.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1037.1.text#τί τοῦτ' ἔλεξας; ἐσφέρεις γὰρ ἐλπίδας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1038.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1038.1.text#ὡς δή τι δράσων χρηστὸν ἐς κοινόν γε νῷν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1039.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1039.1.text#πείσειας ἄν τιν' οἵτινες τετραζύγων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1040.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1040.1.text#ὄχων ἀνάσσουσ', ὥστε νῷν δοῦναι δίφρους;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1041.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1041.1.text#πείσαιμ' { ἄν }· ἀλλὰ τίνα φυγὴν φευξούμεθα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1042.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1042.1.text#πεδίων ἄπειροι βαρβάρου τ' ὄντες χθονός;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1043.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1043.1.text#ἀδύνατον εἶπας. φέρε, τί δ', εἰ κρυφθεὶς δόμοις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1044.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1044.1.text#κτάνοιμ' ἄνακτα τῷδε διστόμῳ ξίφει;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1045.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1045.1.text#οὐκ ἄν σ' ἀνάσχοιτ' οὐδὲ σιγήσειεν ἂν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1046.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1046.1.text#μέλλοντ' ἀδελφὴ σύγγονον κατακτενεῖν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1047.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1047.1.text#ἀλλ' οὐδὲ μὴν ναῦς ἔστιν ᾗ σωθεῖμεν ἂν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1048.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1048.1.text#φεύγοντες· ἣν γὰρ εἴχομεν θάλασσ' ἔχει.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1049.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1049.1.text#ἄκουσον, ἤν τι καὶ γυνὴ λέξῃ σοφόν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1050.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1050.1.text#βούλῃ λέγεσθαι, μὴ θανών, λόγῳ θανεῖν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1051.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1051.1.text#κακὸς μὲν ὄρνις· εἰ δὲ κερδανῶ, λέγειν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1052.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1052.1.text#ἕτοιμός εἰμι μὴ θανὼν λόγῳ θανεῖν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1053.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1053.1.text#καὶ μὴν γυναικείοις σ' ἂν οἰκτισαίμεθα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1054.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1054.1.text#κουραῖσι καὶ θρήνοισι πρὸς τὸν ἀνόσιον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1055.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1055.1.text#σωτηρίας δὲ τοῦτ' ἔχει τί νῷν ἄκος;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1056.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1056.1.text#παλαιότης γὰρ τῷ λόγῳ γ' ἔνεστί τις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1057.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1057.1.text#ὡς δὴ θανόντα σ' ἐνάλιον κενῷ τάφῳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1058.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1058.1.text#θάψαι τύραννον τῆσδε γῆς αἰτήσομαι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1059.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1059.1.text#καὶ δὴ παρεῖκεν· εἶτα πῶς ἄνευ νεὼς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1060.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1060.1.text#σωθησόμεσθα κενοταφοῦντ' ἐμὸν δέμας;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1061.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1061.1.text#δοῦναι κελεύσω πορθμίδ', ᾗ καθήσομαι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1062.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1062.1.text#κόσμον τάφῳ σῷ πελαγίους ἐς ἀγκάλας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1063.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1063.1.text#ὡς εὖ τόδ' εἶπας πλὴν ἕν· εἰ χέρσῳ ταφὰς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1064.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1064.1.text#θεῖναι κελεύσει σ', οὐδὲν ἡ σκῆψις φέρει.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1065.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1065.1.text#ἀλλ' οὐ νομίζειν φήσομεν καθ' Ἑλλάδα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1066.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1066.1.text#χέρσῳ καλύπτειν τοὺς θανόντας ἐναλίους.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1067.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1067.1.text#τοῦτ' αὖ κατορθοῖς· εἶτ' ἐγὼ συμπλεύσομαι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1068.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1068.1.text#καὶ συγκαθήσω κόσμον ἐν ταὐτῷ σκάφει.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1069.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1069.1.text#σὲ καὶ παρεῖναι δεῖ μάλιστα τούς τε σοὺς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1070.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1070.1.text#πλωτῆρας οἵπερ ἔφυγον ἐκ ναυαγίας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1071.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1071.1.text#καὶ μὴν ἐάνπερ ναῦν ἐπ' ἀγκύρας λάβω,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1072.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1072.1.text#ἀνὴρ παρ' ἄνδρα στήσεται ξιφηφόρος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1073.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1073.1.text#σὲ χρὴ βραβεύειν πάντα· πόμπιμοι μόνον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1074.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1074.1.text#λαίφει πνοαὶ γένοιντο καὶ νεὼς δρόμος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1075.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1075.1.text#ἔσται· πόνους γὰρ δαίμονες παύσουσί μου.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1076.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1076.1.text#ἀτὰρ θανόντα τοῦ μ' ἐρεῖς πεπυσμένη;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1077.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1077.1.text#σοῦ· καὶ μόνος γε φάσκε διαφυγεῖν μόρον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1078.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1078.1.text#Ἀτρέως πλέων σὺν παιδὶ καὶ θανόνθ' ὁρᾶν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1079.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1079.1.text#καὶ μὴν τάδ' ἀμφίβληστρα σώματος ῥάκη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1080.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1080.1.text#ξυμμαρτυρήσει ναυτικῶν ἐρειπίων.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1081.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1081.1.text#ἐς καιρὸν ἦλθε, τότε δ' ἄκαιρ' ἀπώλλυτο·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1082.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1082.1.text#τὸ δ' ἄθλιον κεῖν' εὐτυχὲς τάχ' ἂν πέσοι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1083.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1083.1.text#πότερα δ' ἐς οἴκους σοὶ συνεισελθεῖν με χρὴ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1084.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1084.1.text#ἢ πρὸς τάφῳ τῷδ' ἥσυχοι καθώμεθα;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1085.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1085.1.text#αὐτοῦ μέν'· ἢν γὰρ καί τι πλημμελές σε δρᾷ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1086.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1086.1.text#τάφος σ' ὅδ' ἂν ῥύσαιτο φάσγανόν τε σόν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1087.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1087.1.text#ἐγὼ δ' ἐς οἴκους βᾶσα βοστρύχους τεμῶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1088.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1088.1.text#πέπλων τε λευκῶν μέλανας ἀνταλλάξομαι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1089.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1089.1.text#παρῇδί τ' ὄνυχα φόνιον ἐμβαλῶ χροός.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1090.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1090.1.text#μέγας γὰρ ἁγών, καὶ βλέπω δύο ῥοπάς·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1091.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1091.1.text#ἢ γὰρ θανεῖν δεῖ μ', ἢν ἁλῶ τεχνωμένη,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1092.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1092.1.text#ἢ πατρίδα τ' ἐλθεῖν καὶ σὸν ἐκσῷσαι δέμας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1093.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1093.1.text#ὦ πότνι' ἣ Δίοισιν ἐν λέκτροις πίτνεις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1094.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1094.1.text#Ἥρα, δύ' οἰκτρὼ φῶτ' ἀνάψυξον πόνων,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1095.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1095.1.text#αἰτούμεθ' ὀρθὰς ὠλένας πρὸς οὐρανὸν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1096.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1096.1.text#ῥίπτονθ', ἵν' οἰκεῖς ἀστέρων ποικίλματα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1097.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1097.1.text#σύ θ', ἣ 'πὶ τὠμῷ κάλλος ἐκτήσω γάμῳ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1098.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1098.1.text#κόρη Διώνης Κύπρι, μή μ' ἐξεργάσῃ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1099.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1099.1.text#ἅλις δὲ λύμης ἥν μ' ἐλυμήνω πάρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1100.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1100.1.text#τοὔνομα παρασχοῦσ', οὐ τὸ σῶμ', ἐν βαρβάροις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1101.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1101.1.text#θανεῖν δ' ἔασόν μ', εἰ κατακτεῖναι θέλεις,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1102.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1102.1.text#ἐν γῇ πατρῴᾳ. τί ποτ' ἄπληστος εἶ κακῶν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1103.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1103.1.text#ἔρωτας ἀπάτας δόλιά τ' ἐξευρήματα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1104.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1104.1.text#ἀσκοῦσα φίλτρα θ' αἱματηρὰ δωμάτων;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1105.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1105.1.text#εἰ δ' ἦσθα μετρία, τἄλλα γ' ἡδίστη θεῶν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1106.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1106.1.text#πέφυκας ἀνθρώποισιν· οὐκ ἄλλως λέγω.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1107.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1107.1.text#σὲ τὰν ἐναύλοις ὑπὸ δενδροκόμοις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1108.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1108.1.text#μουσεῖα καὶ θάκους ἐνίζουσαν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1109.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1109.1.text#ἀναβοάσω,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1110.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1110.1.text#σὲ τὰν ἀοιδοτάταν ὄρνιθα μελῳδὸν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1111.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1111.1.text#ἀηδόνα δακρυόεσσαν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1111.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1111.2.text#ἔλθ' ὦ διὰ ξουθᾶν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1112.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1112.1.text#γενύων ἐλελιζομένα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1113.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1113.1.text#θρήνων ἐμοὶ ξυνεργός,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1114.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1114.1.text#Ἑλένας μελέας πόνους
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1115.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1115.1.text#τὸν Ἰλιάδων τ' ἀειδούσᾳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1115.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1115.2.text#δακρυόεντα πότμον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1116.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1116.1.text#Ἀχαιῶν ὑπὸ λόγχαις·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1117.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1117.1.text#ὅτ' ἔδραμε ῥόθια πεδία βαρβάρῳ πλάτᾳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1118.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1118.1.text#ὅτ' ἔμολεν ἔμολε, μέλεα Πριαμίδαις ἄγων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1119.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1119.1.text#Λακεδαίμονος ἄπο λέχεα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1120.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1120.1.text#σέθεν, ὦ Ἑλένα, Πάρις αἰνόγαμος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1121.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1121.1.text#πομπαῖσιν Ἀφροδίτας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1122.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1122.1.text#πολλοὶ δ' Ἀχαιῶν δορὶ καὶ πετρίναις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1123.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1123.1.text#ῥιπαῖσιν ἐκπνεύσαντες Ἅιδαν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1124.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1124.1.text#μέλεον ἔχουσιν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1125.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1125.1.text#ταλαινᾶν ἀλόχων κείραντες ἔθειραν·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1126.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1126.1.text#ἄνυμφα δὲ μέλαθρα κεῖται·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1126.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1126.2.text#πολλοὺς δὲ πυρσεύσας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1127.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1127.1.text#φλογερὸν σέλας ἀμφιρύταν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1128.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1128.1.text#Εὔβοιαν εἷλ' Ἀχαιῶν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1129.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1129.1.text#μονόκωπος ἀνήρ, πέτραις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1129.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1129.2.text#Καφηρίσιν ἐμβαλὼν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1130.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1130.1.text#Αἰγαίαις τ' ἐνάλοις δόλιον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1131.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1131.1.text#ἀκταῖς ἀστέρα λάμψας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1132.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1132.1.text#ἀλίμενα δ' ὄρεα Μάλεα χειμάτων πνοᾷ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1133.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1133.1.text#ὅτ' ἔσυτο πατρίδος ἀποπρό, βαρβάρου στολᾶς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1134.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1134.1.text#γέρας, οὐ γέρας ἀλλ' ἔριν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1135.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1135.1.text#Δαναῶν Μενέλας ἐπὶ ναυσὶν ἄγων,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1136.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1136.1.text#εἴδωλον ἱερὸν Ἥρας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1137.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1137.1.text#ὅ τι θεὸς ἢ μὴ θεὸς ἢ τὸ μέσον,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1138.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1138.1.text#τίς φησ' ἐρευνήσας βροτῶν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1139.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1139.1.text#μακρότατον πέρας εὑρεῖν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1140.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1140.1.text#ὃς τὰ θεῶν ἐσορᾷ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1141.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1141.1.text#δεῦρο καὶ αὖθις ἐκεῖσε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1142.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1142.1.text#καὶ πάλιν ἀντιλόγοις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1143.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1143.1.text#πηδῶντ' ἀνελπίστοις τύχαις;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1144.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1144.1.text#σὺ Διὸς ἔφυς, ὦ Ἑλένα, θυγάτηρ·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1145.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1145.1.text#πτανὸς γὰρ ἐν κόλποις σε Λήδας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1146.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1146.1.text#ἐτέκνωσε πατήρ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1147.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1147.1.text#κᾆτ' ἰαχήθης καθ' Ἑλλανίαν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1148.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1148.1.text#προδότις ἄπιστος ἄδικος ἄθεος· οὐδ' ἔχω
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1149.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1149.1.text#τί τὸ σαφὲς ἔτι ποτ' ἐν βροτοῖς·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1150.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1150.1.text#τὸ τῶν θεῶν { δ' } ἔπος ἀλαθὲς ηὗρον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1151.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1151.1.text#ἄφρονες ὅσοι τὰς ἀρετὰς πολέμῳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1152.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1152.1.text#λόγχαισί τ' ἀλκαίου δορὸς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1153.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1153.1.text#κτᾶσθε, πόνους ἀμαθῶς θνατῶν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1154.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1154.1.text#καταπαυόμενοι·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1155.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1155.1.text#εἰ γὰρ ἅμιλλα κρινεῖ νιν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1156.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1156.1.text#αἵματος, οὔποτ' ἔρις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1157.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1157.1.text#λείψει κατ' ἀνθρώπων πόλεις·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1158.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1158.1.text#ᾇ Πριαμίδος γᾶς ἔλαχον θαλάμους,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1159.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1159.1.text#ἐξὸν διορθῶσαι λόγοις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1160.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1160.1.text#σὰν ἔριν, ὦ Ἑλένα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1161.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1161.1.text#νῦν δ' οἳ μὲν Ἅιδᾳ μέλονται κάτω,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1162.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1162.1.text#τείχεα δὲ φλογμὸς ὥστε Διός ἐπέσυτο φλόξ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1163.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1163.1.text#ἐπὶ δὲ πάθεα πάθεσι φέρεις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1164.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1164.1.text#{ ἀθλίοις συμφοραῖς αἰλίνοις. }
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1165.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1165.1.text#ὦ χαῖρε, πατρὸς μνῆμ'· ἐπ' ἐξόδοισι γὰρ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1166.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1166.1.text#ἔθαψα, Πρωτεῦ, σ' ἕνεκ' ἐμῆς προσρήσεως·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1167.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1167.1.text#ἀεὶ δέ σ' ἐξιών τε κἀσιὼν δόμους
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1168.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1168.1.text#Θεοκλύμενος παῖς ὅδε προσεννέπει, πάτερ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1169.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1169.1.text#ὑμεῖς μὲν οὖν κύνας τε καὶ θηρῶν βρόχους,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1170.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1170.1.text#δμῶες, κομίζετ' ἐς δόμους τυραννικούς·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1171.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1171.1.text#ἐγὼ δ' ἐμαυτὸν πόλλ' ἐλοιδόρησα δή·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1172.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1172.1.text#οὐ γάρ τι θανάτῳ τοὺς κακοὺς κολάζομεν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1173.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1173.1.text#καὶ νῦν πέπυσμαι φανερὸν Ἑλλήνων τινὰ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1174.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1174.1.text#ἐς γῆν ἀφῖχθαι καὶ λεληθέναι σκοπούς,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1175.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1175.1.text#ἤτοι κατόπτην ἢ κλοπαῖς θηρώμενον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1176.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1176.1.text#Ἑλένην· θανεῖται δ', ἤν γε δὴ ληφθῇ μόνον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1177.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1177.1.text#ἔα·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1178.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1178.1.text#ἀλλ', ὡς ἔοικε, πάντα διαπεπραγμένα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1179.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1179.1.text#ηὕρηκα· τύμβου γὰρ κενὰς λιποῦσ' ἕδρας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1179a.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1179a.1.text#ἡ Τυνδαρὶς παῖς ἐκπεπόρθμευται χθονός.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1180.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1180.1.text#ὠή, χαλᾶτε κλῇθρα· λύεθ' ἱππικὰ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1181.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1181.1.text#φάτνης, ὀπαδοί, κἀκκομίζεθ' ἅρματα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1182.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1182.1.text#ὡς ἂν πόνου γ' ἕκατι μὴ λάθῃ με γῆς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1183.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1183.1.text#τῆσδ' ἐκκομισθεῖσ' ἄλοχος, ἧς ἐφίεμαι.  —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1184.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1184.1.text#ἐπίσχετ'· εἰσορῶ γὰρ οὓς διώκομεν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1185.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1185.1.text#παρόντας ἐν δόμοισι κοὐ πεφευγότας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1186.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1186.1.text#αὕτη, τί πέπλους μέλανας ἐξήψω χροὸς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1187.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1187.1.text#λευκῶν ἀμείψασ' ἔκ τε κρατὸς εὐγενοῦς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1188.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1188.1.text#κόμας σίδηρον ἐμβαλοῦσ' ἀπέθρισας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1189.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1189.1.text#χλωροῖς τε τέγγεις δάκρυσι σὴν παρηίδα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1190.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1190.1.text#κλαίουσα; πότερον ἐννύχοις πεπεισμένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1191.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1191.1.text#στένεις ὀνείροις, ἢ φάτιν τιν' οἴκοθεν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1192.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1192.1.text#κλύουσα λύπῃ σὰς διέφθαρσαι φρένας;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1193.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1193.1.text#ὦ δέσποτ' — ἤδη γὰρ τόδ' ὀνομάζω σ' ἔπος —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1194.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1194.1.text#ὄλωλα· φροῦδα τἀμὰ κοὐδέν εἰμ' ἔτι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1195.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1195.1.text#ἐν τῷ δὲ κεῖσαι συμφορᾶς; τίς ἡ τύχη;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1196.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1196.1.text#Μενέλαος — οἴμοι, πῶς φράσω;  — τέθνηκέ μοι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1197.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1197.1.text#οὐδέν τι χαίρω σοῖς λόγοις, τὰ δ' εὐτυχῶ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1198.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1198.1.text#πῶς { δ' } οἶσθα; μῶν σοι Θεονόη λέγει τάδε;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1199.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1199.1.text#κείνη τε φησὶν ὅ τε παρὼν ὅτ' ὤλλυτο.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1200.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1200.1.text#ἥκει γὰρ ὅστις καὶ τάδ' ἀγγέλλει σαφῆ;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1201.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1201.1.text#ἥκει· μόλοι γὰρ οἷ σφ' ἐγὼ χρῄζω μολεῖν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1202.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1202.1.text#τίς ἐστι; ποῦ 'στιν; ἵνα σαφέστερον μάθω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1203.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1203.1.text#ὅδ' ὃς κάθηται τῷδ' ὑποπτήξας τάφῳ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1204.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1204.1.text#Ἄπολλον, ὡς ἐσθῆτι δυσμόρφῳ πρέπει.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1205.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1205.1.text#οἴμοι, δοκῶ μὲν κἀμὸν ὧδ' ἔχειν πόσιν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1206.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1206.1.text#ποδαπὸς δ' ὅδ' ἁνὴρ καὶ πόθεν κατέσχε γῆν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1207.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1207.1.text#Ἕλλην, Ἀχαιῶν εἷς ἐμῷ σύμπλους πόσει.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1208.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1208.1.text#θανάτῳ δὲ ποίῳ φησὶ Μενέλεων θανεῖν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1209.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1209.1.text#οἰκτρόταθ', ὑγροῖσιν ἐν κλυδωνίοις ἁλός.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1210.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1210.1.text#ποῦ βαρβάροισι πελάγεσιν ναυσθλούμενον;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1211.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1211.1.text#Λιβύης ἀλιμένοις ἐκπεσόντα πρὸς πέτραις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1212.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1212.1.text#καὶ πῶς ὅδ' οὐκ ὄλωλε κοινωνῶν πλάτης;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1213.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1213.1.text#ἐσθλῶν κακίους ἐνίοτ' εὐτυχέστεροι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1214.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1214.1.text#λιπὼν δὲ ναὸς ποῦ πάρεστιν ἔκβολα;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1215.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1215.1.text#ὅπου κακῶς ὄλοιτο, Μενέλεως δὲ μή.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1216.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1216.1.text#ὄλωλ' ἐκεῖνος. ἦλθε δ' ἐν ποίῳ σκάφει;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1217.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1217.1.text#ναῦταί σφ' ἀνείλοντ' ἐντυχόντες, ὡς λέγει.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1218.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1218.1.text#ποῦ δὴ τὸ πεμφθὲν ἀντὶ σοῦ Τροίᾳ κακόν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1219.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1219.1.text#νεφέλης λέγεις ἄγαλμα; ἐς αἰθέρ' οἴχεται.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1220.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1220.1.text#ὦ Πρίαμε καὶ γῆ Τρῳάς, { ὡς } ἔρρεις μάτην.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1221.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1221.1.text#κἀγὼ μετέσχον Πριαμίδαις δυσπραξίας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1222.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1222.1.text#πόσιν δ' ἄθαπτον ἔλιπεν ἢ κρύπτει χθονί;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1223.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1223.1.text#ἄθαπτον· οἲ ἐγὼ τῶν ἐμῶν τλήμων κακῶν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1224.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1224.1.text#τῶνδ' οὕνεκ' ἔταμες βοστρύχους ξανθῆς κόμης·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1225.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1225.1.text#φίλος γάρ ἐστιν, ὅς ποτ' ἐστίν, ἐνθάδ' ὤν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1226.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1226.1.text#ὀρθῶς μὲν ἥδε συμφορὰ δακρύεται —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1227.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1227.1.text#ἐν εὐμαρεῖ γοῦν σὴν κασιγνήτην λαθεῖν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1228.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1228.1.text#οὐ δῆτα. πῶς οὖν; τόνδ' ἔτ' οἰκήσεις τάφον;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1229.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1229.1.text#τί κερτομεῖς με, τὸν θανόντα δ' οὐκ ἐᾷς;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1230.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1230.1.text#πιστὴ γὰρ εἶ σὺ σῷ πόσει φεύγουσά με.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1231.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1231.1.text#ἀλλ' οὐκέτ'· ἤδη δ' ἄρχε τῶν ἐμῶν γάμων.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1232.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1232.1.text#χρόνια μὲν ἦλθεν, ἀλλ' ὅμως αἰνῶ τάδε.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1233.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1233.1.text#οἶσθ' οὖν ὃ δρᾶσον; τῶν πάρος λαθώμεθα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1234.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1234.1.text#ἐπὶ τῷ; χάρις γὰρ ἀντὶ χάριτος ἐλθέτω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1235.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1235.1.text#σπονδὰς τέμωμεν καὶ διαλλάχθητί μοι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1236.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1236.1.text#μεθίημι νεῖκος τὸ σόν, ἴτω δ' ὑπόπτερον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1237.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1237.1.text#πρός νύν σε γονάτων τῶνδ', ἐπείπερ εἶ φίλος —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1238.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1238.1.text#τί χρῆμα θηρῶσ' ἱκέτις ὠρέχθης ἐμοῦ;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1239.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1239.1.text#τὸν κατθανόντα πόσιν ἐμὸν θάψαι θέλω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1240.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1240.1.text#τί δ'; ἔστ' ἀπόντων τύμβος; ἢ θάψεις σκιάν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1241.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1241.1.text#Ἕλλησίν ἐστι νόμος, ὃς ἂν πόντῳ θάνῃ —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1242.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1242.1.text#τί δρᾶν; σοφοί τοι Πελοπίδαι τὰ τοιάδε.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1243.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1243.1.text#κενοῖσι θάπτειν ἐν πέπλων ὑφάσμασιν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1244.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1244.1.text#κτέριζ'· ἀνίστη τύμβον οὗ χρῄζεις χθονός.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1245.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1245.1.text#οὐχ ὧδε ναύτας ὀλομένους τυμβεύομεν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1246.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1246.1.text#πῶς δαί; λέλειμμαι τῶν ἐν Ἕλλησιν νόμων.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1247.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1247.1.text#ἐς πόντον ὅσα χρὴ νέκυσιν ἐξορμίζομεν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1248.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1248.1.text#τί σοι παράσχω δῆτα τῷ τεθνηκότι;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1249.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1249.1.text#ὅδ' οἶδ', ἐγὼ δ' ἄπειρος, εὐτυχοῦσα πρίν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1250.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1250.1.text#ὦ ξένε, λόγων μὲν κληδόν' ἤνεγκας φίλην.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1251.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1251.1.text#οὔκουν ἐμαυτῷ γ' οὐδὲ τῷ τεθνηκότι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1252.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1252.1.text#πῶς τοὺς θανόντας θάπτετ' ἐν πόντῳ νεκρούς;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1253.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1253.1.text#ὡς ἂν παρούσης οὐσίας ἕκαστος ᾖ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1254.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1254.1.text#πλούτου λέγ' οὕνεχ' ὅ τι θέλεις ταύτης χάριν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1255.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1255.1.text#προσφάζεται μὲν αἷμα πρῶτα νερτέροις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1256.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1256.1.text#τίνος; σύ μοι σήμαινε, πείσομαι δ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1257.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1257.1.text#αὐτὸς σὺ γίγνωσκ'· ἀρκέσει γὰρ ἃν διδῷς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1258.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1258.1.text#ἐν βαρβάροις μὲν ἵππον ἢ ταῦρον νόμος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1259.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1259.1.text#διδούς γε μὲν δὴ δυσγενὲς μηδὲν δίδου.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1260.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1260.1.text#οὐ τῶνδ' ἐν ἀγέλαις ὀλβίαις σπανίζομεν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1261.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1261.1.text#καὶ στρωτὰ φέρεται λέκτρα σώματος κενά.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1262.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1262.1.text#ἔσται· τί δ' ἄλλο προσφέρειν νομίζεται;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1263.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1263.1.text#χαλκήλαθ' ὅπλα· καὶ γὰρ ἦν φίλος δορί.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1264.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1264.1.text#ἄξια τάδ' ἔσται Πελοπιδῶν ἃ δώσομεν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1265.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1265.1.text#καὶ τἄλλ' ὅσα χθὼν καλὰ φέρει βλαστήματα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1266.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1266.1.text#πῶς οὖν; ἐς οἶδμα τίνι τρόπῳ καθίετε;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1267.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1267.1.text#ναῦν δεῖ παρεῖναι κἀρετμῶν ἐπιστάτας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1268.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1268.1.text#πόσον δ' ἀπείργει μῆκος ἐκ γαίας δόρυ;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1269.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1269.1.text#ὥστ' ἐξορᾶσθαι ῥόθια χερσόθεν μόλις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1270.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1270.1.text#τί δή; τόδ' Ἑλλὰς νόμιμον ἐκ τίνος σέβει;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1271.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1271.1.text#ὡς μὴ πάλιν γῇ λύματ' ἐκβάλῃ κλύδων.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1272.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1272.1.text#Φοίνισσα κώπη ταχύπορος γενήσεται.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1273.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1273.1.text#καλῶς ἂν εἴη Μενέλεῴ τε πρὸς χάριν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1274.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1274.1.text#οὔκουν σὺ χωρὶς τῆσδε δρῶν ἀρκεῖς τάδε;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1275.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1275.1.text#μητρὸς τόδ' ἔργον ἢ γυναικὸς ἢ τέκνων.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1276.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1276.1.text#ταύτης ὁ μόχθος, ὡς λέγεις, θάπτειν πόσιν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1277.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1277.1.text#ἐν εὐσεβεῖ γοῦν νόμιμα μὴ κλέπτειν νεκρῶν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1278.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1278.1.text#ἴτω· πρὸς ἡμῶν ἄλοχον εὐσεβῆ τρέφειν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1279.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1279.1.text#ἐλθὼν δ' ἐς οἴκους ἐξελοῦ κόσμον νεκρῷ·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1280.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1280.1.text#καὶ σὲ οὐ κεναῖσι χερσὶ γῆς ἀποστελῶ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1281.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1281.1.text#δράσαντα τῇδε πρὸς χάριν· φήμας δ' ἐμοὶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1282.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1282.1.text#ἐσθλὰς ἐνεγκὼν ἀντὶ τῆς ἀχλαινίας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1283.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1283.1.text#ἐσθῆτα λήψῃ σῖτά θ', ὥστε σ' ἐς πάτραν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1284.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1284.1.text#ἐλθεῖν, ἐπεὶ νῦν γ' ἀθλίως ἔχονθ' ὁρῶ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1285.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1285.1.text#σὺ δ', ὦ τάλαινα, μὴ 'πὶ τοῖς ἀνηνύτοις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1286.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1286.1.text#τρύχουσα σαυτήν — Μενέλεως δ' ἔχει πότμον,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1287.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1287.1.text#κοὐκ ἂν δύναιτο ζῆν ὁ κατθανὼν πόσις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1288.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1288.1.text#σὸν ἔργον, ὦ νεᾶνι· τὸν παρόντα μὲν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1289.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1289.1.text#στέργειν πόσιν χρή, τὸν δὲ μηκέτ' ὄντ' ἐᾶν·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1290.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1290.1.text#ἄριστα γάρ σοι ταῦτα πρὸς τὸ τυγχάνον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1291.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1291.1.text#ἢν δ' Ἑλλάδ' ἔλθω καὶ τύχω σωτηρίας,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1293.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1293.1.text#παύσω ψόγου σε τοῦ πρίν, ἢν γυνὴ γένῃ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1292.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1292.1.text#οἵαν γενέσθαι χρή σε σῷ ξυνευνέτῃ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1294.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1294.1.text#ἔσται τάδ'· οὐδὲ μέμψεται πόσις ποτὲ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1295.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1295.1.text#ἡμῖν· σὺ δ' αὐτὸς ἐγγὺς ὢν εἴσῃ τάδε.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1296.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1296.1.text#ἀλλ', ὦ τάλας, εἴσελθε καὶ λουτρῶν τύχε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1297.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1297.1.text#ἐσθῆτά τ' ἐξάλλαξον. οὐκ ἐς ἀμβολὰς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1298.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1298.1.text#εὐεργετήσω σ'· εὐμενέστερον γὰρ ἂν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1299.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1299.1.text#τῷ φιλτάτῳ μοι Μενέλεῳ τὰ πρόσφορα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1300.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1300.1.text#δρῴης ἄν, ἡμῶν τυγχάνων οἵων σε χρή.[ … ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1301.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1301.1.text#Ὀρεία ποτὲ δρομάδι κώλῳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1302.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1302.1.text#μάτηρ θεῶν ἐσύθη ἀν'
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1303.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1303.1.text#ὑλάεντα νάπη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1304.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1304.1.text#ποτάμιόν τε χεῦμ' ὑδάτων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1305.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1305.1.text#βαρύβρομόν τε κῦμ' ἅλιον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1306.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1306.1.text#πόθῳ τᾶς ἀποιχομένας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1307.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1307.1.text#ἀρρήτου κούρας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1308.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1308.1.text#κρόταλα δὲ βρόμια διαπρύσιον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1309.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1309.1.text#ἱέντα κέλαδον ἀνεβόα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1310.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1310.1.text#θηρῶν ὅτε ζυγίους
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1311.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1311.1.text#ζευξάσᾳ θεᾷ σατίνας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1312.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1312.1.text#τὰν ἁρπασθεῖσαν κυκλίων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1313.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1313.1.text#χορῶν ἔξω παρθενίων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1314.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1314.1.text#μετὰ κούραν, ἀελλόποδες,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1315.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1315.1.text#ἃ μὲν τόξοις Ἄρτεμις, ἃ δ'
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1316.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1316.1.text#ἔγχει Γοργῶπις πάνοπλος,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1317.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1317.1.text#{ συνείποντο. Ζεὺς δ' ἑδράνων }
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1318.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1318.1.text#αὐγάζων ἐξ οὐρανίων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1318.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1318.2.text#ἄλλαν μοῖραν ἔκραινε.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1319.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1319.1.text#δρομαῖον δ' ὅτε πολυπλάνητον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1320.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1320.1.text#μάτηρ ἔπαυσε πόνον,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1321.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1321.1.text#μαστεύουσα { πόνους }
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1322.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1322.1.text#θυγατρὸς ἁρπαγὰς δολίους,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1323.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1323.1.text#χιονοθρέμμονάς γ' ἐπέρασ'
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1324.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1324.1.text#Ἰδαιᾶν Νυμφᾶν σκοπιάς·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1325.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1325.1.text#ῥίπτει δ' ἐν πένθει
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1326.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1326.1.text#πέτρινα κατὰ δρία πολυνιφέα·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1327.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1327.1.text#βροτοῖσι δ' ἄχλοα πεδία γᾶς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1328.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1328.1.text#οὐ καρπίζουσ' ἀρότοις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1329.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1329.1.text#λαῶν [ δὲ ] φθείρει γενεάν·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1330.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1330.1.text#ποίμναις δ' οὐχ ἵει θαλερὰς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1331.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1331.1.text#βοσκὰς εὐφύλλων ἑλίκων,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1332.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1332.1.text#πόλεων δ' ἀπέλειπε βίος·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1333.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1333.1.text#οὐδ' ἦσαν θεῶν θυσίαι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1334.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1334.1.text#βωμοῖς δ' ἄφλεκτοι πέλανοι·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1335.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1335.1.text#πηγὰς δ' ἀμπαύει δροσερὰς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1336.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1336.1.text#λευκῶν ἐκβάλλειν ὑδάτων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1337.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1337.1.text#πένθει παιδὸς ἀλάστωρ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1338.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1338.1.text#ἐπεὶ δ' ἔπαυσ' εἰλαπίνας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1339.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1339.1.text#θεοῖς βροτείῳ τε γένει,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1340.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1340.1.text#Ζεὺς μειλίσσων στυγίους
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1341.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1341.1.text#ματρὸς ὀργὰς ἐνέπει·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1342.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1342.1.text#βᾶτε, σεμναὶ Χάριτες,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1343.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1343.1.text#ἴτε, τᾷ περὶ παρθένῳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1344.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1344.1.text#Δηοῖ θυμωσαμένᾳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1344.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1344.2.text#λύπαν ἐξαλλάξατ' ἀλαλᾷ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1345.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1345.1.text#Μοῦσαί θ' ὕμνοισι χορῶν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1346.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1346.1.text#χαλκοῦ δ' αὐδὰν χθονίαν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1347.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1347.1.text#τύπανά τ' ἔλαβε βυρσοτενῆ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1348.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1348.1.text#καλλίστα τότε πρῶτα μακάρων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1349.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1349.1.text#Κύπρις· γέλασέν τε θεὰ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1350.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1350.1.text#δέξατό τ' ἐς χέρας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1351.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1351.1.text#βαρύβρομον αὐλὸν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1352.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1352.1.text#τερφθεῖσ' ἀλαλαγμῷ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1353.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1353.1.text#ὧν οὐ θέμις { σ' } οὔθ' ὁσία
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1354.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1354.1.text#'π'ύρωσας ἐν { θεῶν } θαλάμοις,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1355.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1355.1.text#μῆνιν δ' ἔσχες μεγάλας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1356.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1356.1.text#ματρός, ὦ παῖ, θυσίας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1357.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1357.1.text#οὐ σεβίζουσα θεᾶς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1358.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1358.1.text#μέγα τοι δύναται νεβρῶν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1359.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1359.1.text#παμποίκιλοι στολίδες
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1360.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1360.1.text#κισσοῦ τε στεφθεῖσα χλόα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1361.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1361.1.text#νάρθηκας εἰς ἱερούς,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1362.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1362.1.text#ῥόμβου θ' εἱλισσομένα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1363.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1363.1.text#κύκλιος ἔνοσις αἰθερία,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1364.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1364.1.text#βακχεύουσά τ' ἔθειρα Βρομίῳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1365.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1365.1.text#καὶ παννυχίδες θεᾶς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1366.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1366.1.text#{ εὖ δέ νιν ἄμασιν }
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1367.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1367.1.text#{ ὑπέρβαλε σελάνα }
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1368.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1368.1.text#μορφᾷ μόνον ηὔχεις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1369.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1369.1.text#τὰ μὲν κατ' οἴκους εὐτυχοῦμεν, ὦ φίλαι·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1370.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1370.1.text#ἡ γὰρ συνεκκλέπτουσα Πρωτέως κόρη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1371.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1371.1.text#πόσιν παρόντα τὸν ἐμὸν ἱστορουμένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1372.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1372.1.text#οὐκ εἶπ' ἀδελφῷ· κατθανόντα δ' ἐν χθονὶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1373.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1373.1.text#οὔ φησιν αὐγὰς εἰσορᾶν ἐμὴν χάριν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1374.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1374.1.text#{ [ … ] }
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1374.2.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1374.2.text#κάλλιστα δῆτ' ἀνήρπασ' ἐν τύχῃ πόσις·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1375.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1375.1.text#ἃ γὰρ καθήσειν ὅπλ' ἔμελλεν εἰς ἅλα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1376.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1376.1.text#ταῦτ' ἐμβαλὼν πόρπακι γενναίαν χέρα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1377.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1377.1.text#αὐτὸς κομίζει δόρυ τε δεξιᾷ λαβών,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1378.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1378.1.text#ὡς τῷ θανόντι χάριτα δὴ συνεκπονῶν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1379.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1379.1.text#προύργου δ' ἐς ἀλκὴν σῶμ' ὅπλοις ἠσκήσατο,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1380.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1380.1.text#ὡς βαρβάρων τρόπαια μυρίων χερὶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1381.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1381.1.text#θήσων, ὅταν κωπῆρες ἐσβῶμεν σκάφος,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1382.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1382.1.text#πέπλους δ' ἀμείψασ' ἀντὶ ναυφθόρου στολῆς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1383.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1383.1.text#ἐγώ νιν ἐξήσκησα, καὶ λουτροῖς χρόα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1384.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1384.1.text#ἔδωκα, χρόνια νίπτρα ποταμίας δρόσου.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1385.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1385.1.text#ἀλλ', ἐκπερᾷ γὰρ δωμάτων ὁ τοὺς ἐμοὺς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1386.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1386.1.text#γάμους ἑτοίμους ἐν χεροῖν ἔχειν δοκῶν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1387.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1387.1.text#σιγητέον μοι· καὶ σὲ προσποιούμεθα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1388.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1388.1.text#εὔνουν κρατεῖν τε στόματος, ἢν δυνώμεθα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1389.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1389.1.text#σωθέντες αὐτοὶ καὶ σὲ συνσῶσαί ποτε.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1390.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1390.1.text#χωρεῖτ' ἐφεξῆς, ὡς ἔταξεν ὁ ξένος,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1391.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1391.1.text#δμῶες, φέροντες ἐνάλια κτερίσματα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1392.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1392.1.text#Ἑλένη, σὺ δ', ἤν σοι μὴ κακῶς δόξω λέγειν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1393.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1393.1.text#πείθου, μέν' αὐτοῦ· ταὐτὰ γὰρ παροῦσά τε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1394.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1394.1.text#πράξεις τὸν ἄνδρα τὸν σὸν ἤν τε μὴ παρῇς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1395.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1395.1.text#δέδοικα γάρ σε μή τις ἐμπεσὼν πόθος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1396.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1396.1.text#πείσῃ μεθεῖναι σῶμ' ἐς οἶδμα πόντιον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1397.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1397.1.text#τοῦ πρόσθεν ἀνδρὸς χάρισιν ἐκπεπληγμένην·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1398.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1398.1.text#ἄγαν γὰρ αὐτὸν οὐ παρόνθ' ὅμως στένεις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1399.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1399.1.text#ὦ καινὸς ἡμῖν πόσις, ἀναγκαίως ἔχει
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1400.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1400.1.text#τὰ πρῶτα λέκτρα νυμφικάς θ' ὁμιλίας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1401.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1401.1.text#τιμᾶν· ἐγὼ δὲ διὰ τὸ μὲν στέργειν πόσιν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1402.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1402.1.text#καὶ ξυνθάνοιμ' ἄν· ἀλλὰ τίς κείνῳ χάρις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1403.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1403.1.text#ξὺν κατθανόντι κατθανεῖν; ἔα δέ με
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1404.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1404.1.text#αὐτὴν μολοῦσαν ἐντάφια δοῦναι νεκρῷ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1405.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1405.1.text#θεοὶ δὲ σοί τε δοῖεν οἷ' ἐγὼ θέλω,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1406.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1406.1.text#καὶ τῷ ξένῳ τῷδ', ὅτι συνεκπονεῖ τάδε.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1407.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1407.1.text#ἕξεις δέ μ' οἵαν χρή σ' ἔχειν ἐν δώμασι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1408.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1408.1.text#γυναῖκ', ἐπειδὴ Μενέλεων εὐεργετεῖς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1409.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1409.1.text#κἄμ'· ἔρχεται γὰρ δή τιν' ἐς τύχην τάδε.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1410.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1410.1.text#ὅστις δὲ δώσει ναῦν ἐν ᾗ τάδ' ἄξομεν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1411.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1411.1.text#πρόσταξον, ὡς ἂν τὴν χάριν πλήρη λάβω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1412.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1412.1.text#χώρει σὺ καὶ ναῦν τοῖσδε πεντηκόντορον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1413.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1413.1.text#Σιδωνίαν δὸς κἀρετμῶν ἐπιστάτας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1414.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1414.1.text#οὔκουν ὅδ' ἄρξει ναὸς ὃς κοσμεῖ τάφον;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1415.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1415.1.text#μάλιστ'· ἀκούειν τοῦδε χρὴ ναύτας ἐμούς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1416.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1416.1.text#αὖθις κέλευσον, ἵνα σαφῶς μάθωσί σου.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1417.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1417.1.text#αὖθις κελεύω καὶ τρίτον γ', εἴ σοι φίλον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1418.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1418.1.text#ὄναιο· κἀγὼ τῶν ἐμῶν βουλευμάτων.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1419.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1419.1.text#μή νυν ἄγαν σὸν δάκρυσιν ἐκτήξῃς χρόα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1420.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1420.1.text#ἥδ' ἡμέρα σοι τὴν ἐμὴν δείξει χάριν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1421.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1421.1.text#τὰ τῶν θανόντων οὐδέν, ἀλλ' ἄλλως πόνος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1422.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1422.1.text#ἔστιν τι κἀκεῖ κἀνθάδ' ὧν ἐγὼ λέγω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1423.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1423.1.text#οὐδὲν κακίω Μενέλεώ μ' ἕξεις πόσιν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1424.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1424.1.text#οὐδὲν σὺ μεμπτός· τῆς τύχης με δεῖ μόνον.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1425.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1425.1.text#ἐν σοὶ τόδ', ἢν σὴν εἰς ἔμ' εὔνοιαν διδῷς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1426.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1426.1.text#οὐ νῦν διδαξόμεσθα τοὺς φίλους φιλεῖν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1427.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1427.1.text#βούλῃ ξυνεργῶν αὐτὸς ἐκπέμψω στόλον;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1428.1.speaker#Ἑλένη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1428.1.text#ἥκιστα· μὴ δούλευε σοῖς δούλοις, ἄναξ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1429.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1429.1.text#ἀλλ' εἶα· τοὺς μὲν Πελοπιδῶν ἐῶ νόμους·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1430.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1430.1.text#καθαρὰ γὰρ ἡμῖν δώματ'· οὐ γὰρ ἐνθάδε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1431.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1431.1.text#ψυχὴν ἀφῆκε Μενέλεως· ἴτω δέ τις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1432.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1432.1.text#φράσων ὑπάρχοις τοῖς ἐμοῖς φέρειν γάμων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1433.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1433.1.text#ἀγάλματ' οἴκους εἰς ἐμούς· πᾶσαν δὲ χρὴ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1434.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1434.1.text#γαῖαν βοᾶσθαι μακαρίαις ὑμνῳδίαις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1435.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1435.1.text#ὑμέναιον Ἑλένης κἀμόν, ὡς ζηλωτὸς ᾖ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1436.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1436.1.text#σὺ δ', ὦ ξέν', ἐλθών, πελαγίους ἐς ἀγκάλας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1437.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1437.1.text#τῷ τῆσδε πρίν ποτ' ὄντι δοὺς πόσει τάδε,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1438.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1438.1.text#πάλιν πρὸς οἴκους σπεῦδ' ἐμὴν δάμαρτ' ἔχων,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1439.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1439.1.text#ὡς τοὺς γάμους τοὺς τῆσδε συνδαίσας ἐμοὶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1440.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1440.1.text#στέλλῃ πρὸς οἴκους ἢ μένων εὐδαιμονῇς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1441.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1441.1.text#ὦ Ζεῦ, πατήρ τε καὶ σοφὸς κλῄζῃ θεός,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1442.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1442.1.text#βλέψον πρὸς ἡμᾶς καὶ μετάστησον κακῶν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1443.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1443.1.text#ἕλκουσι δ' ἡμῖν πρὸς λέπας τὰς συμφορὰς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1444.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1444.1.text#σπουδῇ σύναψαι· κἂν ἄκρᾳ θίγῃς χερί,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1445.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1445.1.text#ἥξομεν ἵν' ἐλθεῖν βουλόμεσθα τῆς τύχης.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1446.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1446.1.text#ἅλις δὲ μόχθων οὓς ἐμοχθοῦμεν πάρος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1447.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1447.1.text#κέκλησθέ μοι, θεοί, πολλά χρήσθ' ἐμοῦ κλύειν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1448.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1448.1.text#καὶ λύπρ'· ὀφείλω δ' οὐκ ἀεὶ πράσσειν κακῶς,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1449.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1449.1.text#ὀρθῷ δὲ βῆναι ποδί· μίαν δέ μοι χάριν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1450.1.speaker#Μενελέως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1450.1.text#δόντες τὸ λοιπὸν εὐτυχῆ με θήσετε.[ … ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1451.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1451.1.text#Φοίνισσα Σιδωνιὰς ὦ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1452.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1452.1.text#ταχεῖα κώπα, ῥοθίοισι μάτηρ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1453.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1453.1.text#εἰρεσίας φίλα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1454.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1454.1.text#χοραγὲ τῶν καλλιχόρων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1455.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1455.1.text#δελφίνων, ὅταν αὔραις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1456.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1456.1.text#πέλαγος ἀνήνεμον ᾖ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1457.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1457.1.text#γλαυκὰ δὲ Πόντου θυγάτηρ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1458.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1458.1.text#Γαλάνεια τάδ' εἴπῃ·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1459.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1459.1.text#κατὰ μὲν ἱστία πετάσατ' αὔραις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1460.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1460.1.text#λιπόντες εἰναλίαις,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1461.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1461.1.text#λάβετε δ' εἰλατίνας πλάτας,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1462.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1462.1.text#ὦ ναῦται, ναῦται,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1463.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1463.1.text#πέμποντες εὐλιμένους
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1464.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1464.1.text#Περσείων οἴκων Ἑλέναν ἐπ' ἀκτάς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1465.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1465.1.text#ἦ που κόρας ἂν ποταμοῦ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1466.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1466.1.text#παρ' οἶδμα Λευκιππίδας ἢ πρὸ ναοῦ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1467.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1467.1.text#Παλλάδος ἂν λάβοις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1468.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1468.1.text#χρόνῳ ξυνελθοῦσα χοροῖς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1469.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1469.1.text#ἢ κώμοις Ὑακίνθου
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1470.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1470.1.text#νύχιον ἐς εὐφροσύναν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1471.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1471.1.text#ὃν ἐξαμιλλησάμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1472.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1472.1.text#τροχῷ τέρμονα δίσκου
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1473.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1473.1.text#ἔκανε Φοῖβος, τᾷ Λακαίνᾳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1474.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1474.1.text#γᾷ βούθυτον ἁμέραν·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1475.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1475.1.text#ὁ Διὸς δ' εἶπε σέβειν γόνος·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1476.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1476.1.text#μόσχον θ', ἃν οἴκοις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1476.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1476.2.text#{ ἔλειπες, Ἑρμιόναν, }
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1477.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1477.1.text#ἇς οὔπω πεῦκαι πρὸ γάμων ἔλαμψαν.[ … ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1478.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1478.1.text#δι' ἀέρος εἴθε ποτανοὶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1479.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1479.1.text#γενοίμεσθ' ᾇ Λιβύας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1480.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1480.1.text#οἰωνοὶ στοχάδες
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1481.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1481.1.text#ὄμβρον λιποῦσαι χειμέριον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1482.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1482.1.text#νίσονται πρεσβυτάτᾳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1483.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1483.1.text#σύριγγι πειθόμεναι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1485.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1485.1.text#ποιμένος, ὃς ἄβροχα πεδία καρποφόρα τε γᾶς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1486.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1486.1.text#ἐπιπετόμενος ἰαχεῖ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1487.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1487.1.text#ὦ πταναὶ δολιχαύχενες,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1488.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1488.1.text#σύννομοι νεφέων δρόμου,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1489.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1489.1.text#βᾶτε Πλειάδας ὑπὸ μέσας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1490.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1490.1.text#ὠρίωνά τ' ἐννύχιον·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1491.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1491.1.text#καρύξατ' ἀγγελίαν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1492.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1492.1.text#Εὐρώταν ἐφεζόμεναι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1493.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1493.1.text#Μενέλεως ὅτι Δαρδάνου
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1494.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1494.1.text#πόλιν ἑλὼν δόμον ἥξει.[ … ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1495.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1495.1.text#μόλοιτέ ποθ' ἵππιον οἶμον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1496.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1496.1.text#δι' αἰθέρος ἱέμενοι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1497.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1497.1.text#παῖδες Τυνδαρίδαι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1498.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1498.1.text#λαμπρῶν ἄστρων ὑπ' ἀέλλαισιν·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1499.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1499.1.text#οἳ ναίετ' οὐράνιοι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1500.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1500.1.text#σωτῆρες τᾶς Ἑλένας,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1501.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1501.1.text#γλαυκὸν ἔπιτ' οἶδμα κυανόχροά τε κυμάτων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1502.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1502.1.text#ῥόθια πολιὰ θαλάσσας,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1503.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1503.1.text#ναύταις εὐαεῖς ἀνέμων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1505.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1505.1.text#πέμποντες Διόθεν πνοάς·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1506.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1506.1.text#δύσκλειαν δ' ἀπὸ συγγόνου
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1507.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1507.1.text#βάλετε βαρβάρων λεχέων,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1508.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1508.1.text#ἃν Ἰδαίων ἐρίδων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1509.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1509.1.text#ποιναθεῖσ' ἐκτήσατο, γᾶν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1510.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1510.1.text#οὐκ ἐλθοῦσά { ποτ' } Ἰλίου
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1511.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1511.1.text#Φοιβείους ἐπὶ πύργους.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1512.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1512.1.text#{ ἄναξ, τὰ κάκιστ' ἐν δόμοις εὑρήκαμεν· }
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1513.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1513.1.text#ὡς καίν' ἀκούσῃ πήματ' ἐξ ἐμοῦ τάχα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1514.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1514.1.text#τί δ' ἔστιν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1514.2.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1514.2.text#ἄλλης ἐκπόνει μνηστεύματα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1515.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1515.1.text#γυναικός· Ἑλένη γὰρ βέβηκ' ἔξω χθονός.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1516.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1516.1.text#πτεροῖσιν ἀρθεῖσ' ἢ πεδοστιβεῖ ποδί;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1517.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1517.1.text#Μενέλαος αὐτὴν ἐκπεπόρθμευται χθονός,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1518.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1518.1.text#ὃς αὐτὸς αὑτὸν ἦλθεν ἀγγέλλων θανεῖν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1519.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1519.1.text#ὦ δεινὰ λέξας· τίς δέ νιν ναυκληρία
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1520.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1520.1.text#ἐκ τῆσδ' ἀπῆρε χθονός; ἄπιστα γὰρ λέγεις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1521.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1521.1.text#ἥν γε ξένῳ δίδως σύ· τούς τε σοὺς ἔχων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1522.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1522.1.text#ναύτας βέβηκεν, ὡς ἂν ἐν βραχεῖ μάθῃς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1523.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1523.1.text#πῶς; εἰδέναι πρόθυμος· οὐ γὰρ ἐλπίδων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1524.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1524.1.text#ἔσω βέβηκα μίαν ὑπερδραμεῖν χέρα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1525.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1525.1.text#τοσούσδε ναύτας, ὧν ἀπεστάλης μέτα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1526.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1526.1.text#ἐπεὶ λιποῦσα τούσδε βασιλείους δόμους
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1527.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1527.1.text#ἡ τοῦ Διὸς παῖς πρὸς θάλασσαν ἐστάλη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1528.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1528.1.text#σοφώταθ' ἁβρὸν πόδα τιθεῖσ' ἀνέστενε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1529.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1529.1.text#πόσιν πέλας παρόντα κοὐ τεθνηκότα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1530.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1530.1.text#ὡς δ' ἤλθομεν σῶν περίβολον νεωρίων,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1531.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1531.1.text#Σιδωνίαν ναῦν πρωτόπλουν καθείλκομεν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1532.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1532.1.text#ζυγῶν τε πεντήκοντα κἀρετμῶν μέτρα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1533.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1533.1.text#ἔχουσαν. ἔργου δ' ἔργον ἐξημείβετο·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1534.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1534.1.text#ὃ μὲν γὰρ ἱστόν, ὃ δὲ πλάτην καθίσατο
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1535.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1535.1.text#{ ταρσόν τε χειρί, λευκά θ' ἱστί' εἰς ἓν ἦν }
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1536.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1536.1.text#πηδάλιά τε ζεύγλαισι παρακαθίετο.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1537.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1537.1.text#κἀν τῷδε μόχθῳ, τοῦτ' ἄρα σκοπούμενοι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1538.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1538.1.text#Ἕλληνες ἄνδρες Μενέλεῳ ξυνέμποροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1539.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1539.1.text#προσῆλθον ἀκταῖς ναυφθόροις ἠσθημένοι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1540.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1540.1.text#πέπλοισιν, εὐειδεῖς μέν, αὐχμηροὶ δ' ὁρᾶν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1541.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1541.1.text#ἰδὼν δέ νιν παρόντας Ἀτρέως γόνος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1542.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1542.1.text#προσεῖπε δόλιον οἶκτον ἐς μέσον φέρων·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1543.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1543.1.text#ὦ τλήμονες, πῶς ἐκ τίνος νεώς ποτε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1544.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1544.1.text#Ἀχαιίδος θραύσαντες ἥκετε σκάφος;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1545.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1545.1.text#ἆρ' Ἀτρέως παῖδ' ὀλόμενον συνθάπτετε,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1546.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1546.1.text#ὃν Τυνδαρὶς παῖς ἥδ' ἀπόντα κενοταφεῖ;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1547.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1547.1.text#οἳ δ' ἐκβαλόντες δάκρυα ποιητῷ τρόπῳ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1548.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1548.1.text#ἐς ναῦν ἐχώρουν Μενέλεῳ ποντίσματα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1549.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1549.1.text#φέροντες. ἡμῖν δ' ἦν μὲν ἥδ' ὑποψία
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1550.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1550.1.text#λόγος τ' ἐν ἀλλήλοισι, τῶν ἐπεσβατῶν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1551.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1551.1.text#ὡς πλῆθος εἴη· διεσιωπῶμεν δ' ὅμως
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1552.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1552.1.text#τοὺς σοὺς λόγους σῴζοντες· ἄρχειν γὰρ νεὼς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1553.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1553.1.text#ξένον κελεύσας πάντα συνέχεας τάδε.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1554.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1554.1.text#καὶ τἄλλα μὲν δὴ ῥᾳδίως ἔσω νεὼς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1555.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1555.1.text#ἐθέμεθα κουφίζοντα· ταύρειος δὲ ποὺς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1556.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1556.1.text#οὐκ ἤθελ' ὀρθὸς σανίδα προσβῆναι κάτα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1557.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1557.1.text#ἀλλ' ἐξεβρυχᾶτ' ὄμμ' ἀναστρέφων κύκλῳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1558.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1558.1.text#κυρτῶν τε νῶτα κἀς κέρας παρεμβλέπων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1559.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1559.1.text#μὴ θιγγάνειν ἀπεῖργεν. ὁ δ' Ἑλένης πόσις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1560.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1560.1.text#ἐκάλεσεν· ὦ πέρσαντες Ἰλίου πόλιν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1561.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1561.1.text#οὐκ εἶ' ἀναρπάσαντες Ἑλλήνων νόμῳ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1562.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1562.1.text#νεανίαις ὤμοισι ταύρειον δέμας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1563.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1563.1.text#ἐς πρῷραν ἐμβαλεῖτε, { φάσγανόν θ' ἅμα }
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1564.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1564.1.text#{ πρόχειρον ὤσει } σφάγια τῷ τεθνηκότι;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1565.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1565.1.text#οἳ δ' ἐς κέλευσμ' ἐλθόντες ἐξανήρπασαν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1566.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1566.1.text#ταῦρον φέροντές τ' εἰσέθεντο σέλματα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1567.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1567.1.text#μονάμπυκον δὲ Μενέλεως ψήχων δέρην
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1568.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1568.1.text#μέτωπά τ' ἐξέπεισεν ἐσβῆναι δόρυ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1569.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1569.1.text#τέλος δ', ἐπειδὴ ναῦς τὰ πάντ' ἐδέξατο,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1570.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1570.1.text#πλήσασα κλιμακτῆρας εὐσφύρῳ ποδί
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1571.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1571.1.text#Ἑλένη καθέζετ' ἐν μέσοις ἑδωλίοις,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1572.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1572.1.text#ὅ τ' οὐκέτ' ὢν λόγοισι Μενέλεως πέλας·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1573.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1573.1.text#ἄλλοι δὲ τοίχους δεξιοὺς λαιούς τ' ἴσοι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1574.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1574.1.text#ἀνὴρ παρ' ἄνδρ' ἕζονθ', ὑφ' εἵμασι ξίφη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1575.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1575.1.text#λαθραῖ' ἔχοντες, ῥόθιά τ' ἐξεπίμπλατο
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1576.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1576.1.text#βοῆς κελευστοῦ φθέγμαθ' ὡς ἠκούσαμεν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1577.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1577.1.text#ἐπεὶ δὲ γαίας ἦμεν οὔτ' ἄγαν πρόσω
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1578.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1578.1.text#οὔτ' ἐγγύς, οὕτως ἤρετ' οἰάκων φύλαξ·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1579.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1579.1.text#ἔτ', ὦ ξέν', ἐς τὸ πρόσθεν — ἢ καλῶς ἔχει —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1580.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1580.1.text#πλεύσωμεν; ἀρχαὶ γὰρ νεὼς μέλουσι σοί.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1581.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1581.1.text#ὃ δ' εἶφ'· ἅλις μοι. δεξιᾷ δ' ἑλὼν ξίφος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1582.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1582.1.text#ἐς πρῷραν εἷρπε κἀπὶ ταυρείῳ σφαγῇ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1583.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1583.1.text#σταθεὶς νεκρῶν μὲν οὐδενὸς μνήμην ἔχων,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1584.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1584.1.text#τέμνων δὲ λαιμὸν ηὔχετ'· ὦ ναίων ἅλα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1585.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1585.1.text#πόντιε Πόσειδον Νηρέως θ' ἁγναὶ κόραι,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1586.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1586.1.text#σώσατέ μ' ἐπ' ἀκτὰς Ναυπλίας δάμαρτά τε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1587.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1587.1.text#ἄσυλον ἐκ γῆς. αἵματος δ' ἀπορροαὶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1588.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1588.1.text#ἐς οἶδμ' ἐσηκόντιζον οὔριοι ξένῳ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1589.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1589.1.text#καί τις τόδ' εἶπε· δόλιος ἡ ναυκληρία.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1590.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1590.1.text#πάλιν πλέωμεν· δεξιὰν κέλευε σύ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1591.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1591.1.text#σὺ δὲ στρέφ' οἴακ'. ἐκ δὲ ταυρείου φόνου
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1592.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1592.1.text#Ἀτρέως σταθεὶς παῖς ἀνεβόησε συμμάχους·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1593.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1593.1.text#τί μέλλετ', ὦ γῆς Ἑλλάδος λωτίσματα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1594.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1594.1.text#σφάζειν φονεύειν βαρβάρους νεώς τ' ἄπο
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1595.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1595.1.text#ῥίπτειν ἐς οἶδμα; ναυβάταις δὲ τοῖσι σοῖς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1596.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1596.1.text#βοᾷ κελευστὴς τὴν ἐναντίαν ὄπα·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1597.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1597.1.text#οὐκ εἶ' ὃ μέν τις λοῖσθον ἀρεῖται δόρυ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1598.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1598.1.text#ὃ δὲ ζύγ' ἄξας, ὃ δ' ἀφελὼν σκαλμοῦ πλάτην
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1599.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1599.1.text#καθαιματώσει κρᾶτα πολεμίων ξένων;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1600.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1600.1.text#ὀρθοὶ δ' ἀνῇξαν πάντες, οἳ μὲν ἐν χεροῖν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1601.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1601.1.text#κορμοὺς ἔχοντες ναυτικούς, οἳ δὲ ξίφη·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1602.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1602.1.text#φόνῳ δὲ ναῦς ἐρρεῖτο. παρακέλευσμα δ' ἦν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1603.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1603.1.text#πρύμνηθεν Ἑλένης· ποῦ τὸ Τρωικὸν κλέος;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1604.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1604.1.text#δείξατε πρὸς ἄνδρας βαρβάρους· σπουδῆς δ' ὕπο
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1605.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1605.1.text#ἔπιπτον, οἳ δ' ὠρθοῦντο, τοὺς δὲ κειμένους
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1606.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1606.1.text#νεκροὺς ἂν εἶδες. Μενέλεως δ' ἔχων ὅπλα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1607.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1607.1.text#ὅποι νοσοῖεν ξύμμαχοι κατασκοπῶν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1608.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1608.1.text#ταύτῃ προσῆγε χειρὶ δεξιᾷ ξίφος,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1609.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1609.1.text#ὥστ' ἐκκολυμβᾶν ναός, ἠρήμωσε δὲ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1610.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1610.1.text#σῶν ναυβατῶν ἐρετμά. ἐπ' οἰάκων δὲ βὰς
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1611.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1611.1.text#ἄνακτ' ἐς Ἑλλάδ' εἶπεν εὐθύνειν δόρυ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1612.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1612.1.text#οἳ δ' ἱστὸν ᾖρον, οὔριαι δ' ἧκον πνοαί.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1613.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1613.1.text#βεβᾶσι δ' ἐκ γῆς. διαφυγὼν δ' ἐγὼ φόνον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1614.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1614.1.text#καθῆκ' ἐμαυτὸν εἰς ἅλ' ἄγκυραν πάρα·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1615.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1615.1.text#ἤδη δὲ κάμνονθ' ὁρμιατόνων μέ τις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1616.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1616.1.text#ἀνείλετ', ἐς δὲ γαῖαν ἐξέβησέ σοι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1617.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1617.1.text#τάδ' ἀγγελοῦντα. σώφρονος δ' ἀπιστίας
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1618.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1618.1.text#οὐκ ἔστιν οὐδὲν χρησιμώτερον βροτοῖς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1619.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1619.1.text#οὐκ ἄν ποτ' ηὔχουν οὔτε σ' οὔθ' ἡμᾶς λαθεῖν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1620.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1620.1.text#Μενέλαον, ὦναξ, ὡς ἐλάνθανεν παρών.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1621.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1621.1.text#ὦ γυναικείαις τέχναισιν αἱρεθεὶς ἐγὼ τάλας·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1622.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1622.1.text#ἐκπεφεύγασιν γάμοι με. κεἰ μὲν ἦν ἁλώσιμος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1623.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1623.1.text#ναῦς διώγμασιν, πονήσας εἷλον ἂν τάχα ξένους·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1624.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1624.1.text#νῦν δὲ τὴν προδοῦσαν ἡμᾶς τεισόμεσθα σύγγονον,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1625.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1625.1.text#ἥτις ἐν δόμοις ὁρῶσα Μενέλεων οὐκ εἶπέ μοι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1626.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1626.1.text#τοιγὰρ οὔποτ' ἄλλον ἄνδρα ψεύσεται μαντεύμασιν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1627.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1627.1.text#οὗτος ὤ, ποῖ σὸν πόδ' αἴρεις, δέσποτ', ἐς ποῖον φόνον;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1628.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1628.1.text#οἷπερ ἡ δίκη κελεύει με· ἀλλ' ἀφίστασ' ἐκποδών.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1629.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1629.1.text#οὐκ ἀφήσομαι πέπλων σῶν· μεγάλα { γὰρ } σπεύδεις κακά.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1630.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1630.1.text#ἀλλὰ δεσποτῶν κρατήσεις δοῦλος ὤν;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1630.2.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1630.2.text#φρονῶ γὰρ εὖ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1631.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1631.1.text#οὐκ ἔμοιγ', εἰ μή μ' ἐάσεις —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1631.2.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1631.2.text#οὐ μὲν οὖν σ' ἐάσομεν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1632.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1632.1.text#σύγγονον κτανεῖν κακίστην —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1632.2.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1632.2.text#εὐσεβεστάτην μὲν οὖν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1633.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1633.1.text#ἥ με προύδωκεν —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1633.2.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1633.2.text#καλήν γε προδοσίαν, δίκαια δρᾶν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1634.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1634.1.text#τἀμὰ λέκτρ' ἄλλῳ διδοῦσα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1634.2.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1634.2.text#τοῖς γε κυριωτέροις.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1635.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1635.1.text#κύριος δὲ τῶν ἐμῶν τίς;
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1635.2.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1635.2.text#ὃς ἔλαβεν πατρὸς πάρα.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1636.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1636.1.text#ἀλλ' ἔδωκεν ἡ τύχη μοι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1636.2.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1636.2.text#τὸ δὲ χρεὼν ἀφείλετο.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1637.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1637.1.text#οὐ σὲ τἀμὰ χρὴ δικάζειν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1637.2.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1637.2.text#ἤν γε βελτίω λέγω.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1638.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1638.1.text#ἀρχόμεσθ' ἄρ', οὐ κρατοῦμεν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1638.2.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1638.2.text#ὅσια δρᾶν, τὰ δ' ἔκδικ' οὔ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1639.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1639.1.text#κατθανεῖν ἐρᾶν ἔοικας.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1639.2.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1639.2.text#κτεῖνε· σύγγονον δὲ σὴν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1640.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1640.1.text#οὐ κτενεῖς ἡμῶν ἑκόντων, ἀλλ' ἔμε· { ὡς } πρὸ δεσποτῶν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1641.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1641.1.text#τοῖσι γενναίοισι δούλοις εὐκλεέστατον θανεῖν.[ … ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1642.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1642.1.text#ἐπίσχες ὀργὰς αἷσιν οὐκ ὀρθῶς φέρῃ,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1643.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1643.1.text#Θεοκλύμενε, γαίας τῆσδ' ἄναξ· δισσοὶ δέ σε
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1644.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1644.1.text#Διόσκοροι καλοῦμεν, οὓς Λήδα ποτὲ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1645.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1645.1.text#ἔτικτεν Ἑλένην θ', ἣ πέφευγε σοὺς δόμους·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1646.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1646.1.text#οὐ γὰρ πεπρωμένοισιν ὀργίζῃ γάμοις,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1647.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1647.1.text#οὐδ' ἡ θεᾶς Νηρῇδος ἔκγονος κόρη
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1648.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1648.1.text#ἀδικεῖ σ' ἀδελφὴ Θεονόη, τὰ τῶν θεῶν
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1649.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1649.1.text#τιμῶσα πατρός τ' ἐνδίκους ἐπιστολάς.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1650.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1650.1.text#ἐς μὲν γὰρ αἰεὶ τὸν παρόντα νῦν χρόνον
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1651.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1651.1.text#κείνην κατοικεῖν σοῖσιν ἐν δόμοις ἐχρῆν·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1652.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1652.1.text#ἐπεὶ δὲ Τροίας ἐξανεστάθη βάθρα,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1653.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1653.1.text#καὶ τοῖς θεοῖς παρέσχε τοὔνομ', οὐκέτι·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1654.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1654.1.text#ἐν τοῖσι δ' αὑτῆς δεῖ νιν ἐζεῦχθαι γάμοις
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1655.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1655.1.text#ἐλθεῖν τ' ἐς οἴκους καὶ συνοικῆσαι πόσει.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1656.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1656.1.text#ἀλλ' ἴσχε μὲν σῆς συγγόνου μέλαν ξίφος,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1657.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1657.1.text#νόμιζε δ' αὐτὴν σωφρόνως πράσσειν τάδε.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1658.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1658.1.text#πάλαι δ' ἀδελφὴν κἂν πρὶν ἐξεσώσαμεν,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1659.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1659.1.text#ἐπείπερ ἡμᾶς Ζεὺς ἐποίησεν θεούς·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1660.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1660.1.text#ἀλλ' ἥσσον' ἦμεν τοῦ πεπρωμένου θ' ἅμα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1661.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1661.1.text#καὶ τῶν θεῶν, οἷς ταῦτ' ἔδοξεν ὧδ' ἔχειν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1662.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1662.1.text#σοὶ μὲν τάδ' αὐδῶ, συγγόνῳ δ' ἐμῇ λέγω·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1663.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1663.1.text#πλεῖ ξὺν πόσει σῷ· πνεῦμα δ' ἕξετ' οὔριον·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1664.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1664.1.text#σωτῆρε δ' ἡμεῖς σὼ κασιγνήτω διπλῶ
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1665.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1665.1.text#πόντον παριππεύοντε πέμψομεν πάτραν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1666.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1666.1.text#ὅταν δὲ κάμψῃς καὶ τελευτήσῃς βίον,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1667.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1667.1.text#θεὸς κεκλήσῃ καὶ Διοσκόρων μέτα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1668.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1668.1.text#σπονδῶν μεθέξεις ξένιά τ' ἀνθρώπων πάρα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1669.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1669.1.text#ἕξεις μεθ' ἡμῶν· Ζεὺς γὰρ ὧδε βούλεται.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1670.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1670.1.text#οὗ δ' ὥρισέν σοι πρῶτα Μαιάδος τόκος,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1671.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1671.1.text#Σπάρτης ἀπάρας, τὸν κατ' οὐρανὸν δρόμον,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1672.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1672.1.text#κλέψας δέμας σὸν μὴ Πάρις γήμειέ σε,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1673.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1673.1.text#— φρουρὸν παρ' Ἀκτὴν τεταμένην νῆσον λέγω —
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1674.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1674.1.text#Ἑλένη τὸ λοιπὸν ἐν βροτοῖς κεκλήσεται,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1675.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1675.1.text#ἐπεὶ κλοπαίαν σ' ἐκ δόμων ἐδέξατο.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1676.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1676.1.text#καὶ τῷ πλανήτῃ Μενέλεῳ θεῶν πάρα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1677.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1677.1.text#μακάρων κατοικεῖν νῆσόν ἐστι μόρσιμον·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1678.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1678.1.text#τοὺς εὐγενεῖς γὰρ οὐ στυγοῦσι δαίμονες,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1679.1.speaker#Διόσκοροι
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1679.1.text#τῶν δ' ἀναριθμήτων μᾶλλόν εἰσιν οἱ πόνοι.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1680.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1680.1.text#ὦ παῖδε Λήδας καὶ Διός, τὰ μὲν πάρος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1681.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1681.1.text#νείκη μεθήσω σφῶν κασιγνήτης πέρι·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1682.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1682.1.text#ἐγὼ δ' ἀδελφὴν οὐκέτ' ἂν κτάνοιμ' ἐμήν.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1683.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1683.1.text#κείνη δ' ἴτω πρὸς οἶκον, εἰ θεοῖς δοκεῖ.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1684.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1684.1.text#ἴστον δ' ἀρίστης σωφρονεστάτης θ' ἅμα
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1685.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1685.1.text#γεγῶτ' ἀδελφῆς ὁμογενοῦς ἀφ' αἵματος.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1686.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1686.1.text#καὶ χαίρεθ' Ἑλένης οὕνεκ' εὐγενεστάτης
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1687.1.speaker#Θεοκλύμενος
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1687.1.text#γνώμης, ὃ πολλαῖς ἐν γυναιξὶν οὐκ ἔνι.[ … ]
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1688.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1688.1.text#πολλαὶ μορφαὶ τῶν δαιμονίων,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1689.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1689.1.text#πολλὰ δ' ἀέλπτως κραίνουσι θεοί·
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1690.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1690.1.text#καὶ τὰ δοκηθέντ' οὐκ ἐτελέσθη,
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1691.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1691.1.text#τῶν δ' ἀδοκήτων πόρον ηὗρε θεός.
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1692.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg014.fu.sp:1692.1.text#τοιόνδ' ἀπέβη τόδε πρᾶγμα.
