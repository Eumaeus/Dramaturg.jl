#!ctsdata
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1.1.text#Πολλὴ μὲν ἐν βροτοῖσι κοὐκ ἀνώνυμος,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:2.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:2.1.text#θεὰ κέκλημαι Κύπρις, οὐρανοῦ τ' ἔσω·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:3.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:3.1.text#ὅσοι τε Πόντου τερμόνων τ' Ἀτλαντικῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:4.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:4.1.text#ναίουσιν εἴσω φῶς ὁρῶντες ἡλίου,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:5.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:5.1.text#τοὺς μὲν σέβοντας τἀμὰ πρεσβεύω κράτη,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:6.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:6.1.text#σφάλλω δ' ὅσοι φρονοῦσιν εἰς ἡμᾶς μέγα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:7.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:7.1.text#ἔνεστι γὰρ δὴ κἀν θεῶν γένει τόδε·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:8.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:8.1.text#τιμώμενοι χαίρουσιν ἀνθρώπων ὕπο.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:9.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:9.1.text#δείξω δὲ μύθων τῶνδ' ἀλήθειαν τάχα·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:10.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:10.1.text#ὁ γάρ με Θησέως παῖς, Ἀμαζόνος τόκος,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:11.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:11.1.text#Ἱππόλυτος, ἁγνοῦ Πιτθέως παιδεύματα,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:12.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:12.1.text#μόνος πολιτῶν τῆσδε γῆς Τροζηνίας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:13.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:13.1.text#λέγει κακίστην δαιμόνων πεφυκέναι,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:14.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:14.1.text#ἀναίνεται δὲ λέκτρα κοὐ ψαύει γάμων·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:15.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:15.1.text#Φοίβου δ' ἀδελφὴν  Ἄρτεμιν, Διὸς κόρην,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:16.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:16.1.text#τιμᾷ, μεγίστην δαιμόνων ἡγούμενος·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:17.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:17.1.text#χλωρὰν δ' ἀν' ὕλην παρθένῳ ξυνὼν ἀεὶ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:18.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:18.1.text#κυσὶν ταχείαις θῆρας ἐξαιρεῖ χθονός,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:19.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:19.1.text#μείζω βροτείας προσπεσὼν ὁμιλίας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:20.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:20.1.text#τούτοισι μέν νυν οὐ φθονῶ· τί γάρ με δεῖ;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:21.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:21.1.text#ἃ δ' εἰς ἔμ' ἡμάρτηκε, τιμωρήσομαι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:22.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:22.1.text#Ἱππόλυτον ἐν τῇδ' ἡμέρᾳ· τὰ πολλὰ δὲ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:23.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:23.1.text#πάλαι προκόψασ' — οὐ πόνου πολλοῦ με δεῖ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:24.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:24.1.text#ἐλθόντα γάρ νιν Πιτθέως ποτ' ἐκ δόμων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:25.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:25.1.text#σεμνῶν ἐς ὄψιν καὶ τέλη μυστηρίων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:26.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:26.1.text#Πανδίονος γῆν, πατρὸς εὐγενὴς δάμαρ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:27.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:27.1.text#ἰδοῦσα Φαίδρα καρδίαν κατέσχετο
urn:cts:greekLit:tlg0006.tlg005.fu.sp:28.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:28.1.text#ἔρωτι δεινῷ τοῖς ἐμοῖς βουλεύμασιν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:29.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:29.1.text#καὶ πρὶν μὲν ἐλθεῖν τήνδε γῆν Τροζηνίαν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:30.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:30.1.text#πέτραν παρ' αὐτὴν Παλλάδος, κατόψιον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:31.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:31.1.text#γῆς τῆσδε, ναὸν Κύπριδος ἐγκαθίσατο,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:32.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:32.1.text#ἐρῶσ' ἔρωτ' ἔκδημον· Ἱππολύτῳ δ' ἔπι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:33.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:33.1.text#τὸ λοιπὸν ὠνόμαζ' ἐνιδρῦσθαι θεάν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:34.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:34.1.text#ἐπεὶ δὲ Θησεὺς Κεκροπίαν λείπει χθόνα,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:35.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:35.1.text#μίασμα φεύγων αἵματος Παλλαντιδῶν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:36.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:36.1.text#καὶ τήνδε σὺν δάμαρτι ναυστολεῖ χθόνα,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:37.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:37.1.text#ἐνιαυσίαν ἔκδημον αἰνέσας φυγήν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:38.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:38.1.text#ἐνταῦθα δὴ στένουσα κἀκπεπληγμένη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:39.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:39.1.text#κέντροις ἔρωτος ἡ τάλαιν' ἀπόλλυται
urn:cts:greekLit:tlg0006.tlg005.fu.sp:40.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:40.1.text#σιγῇ· ξύνοιδε δ' οὔτις οἰκετῶν νόσον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:41.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:41.1.text#ἀλλ' οὔτι ταύτῃ τόνδ' ἔρωτα χρὴ πεσεῖν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:42.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:42.1.text#δείξω δὲ { Θησεῖ πρᾶγμα }, κἀκφανήσεται.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:43.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:43.1.text#καὶ τὸν μὲν ἡμῖν πολέμιον νεανίαν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:44.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:44.1.text#κτενεῖ πατὴρ ἀραῖσιν, ἃς ὁ πόντιος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:45.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:45.1.text#ἄναξ Ποσειδῶν ὤπασεν Θησεῖ γέρας,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:46.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:46.1.text#μηδὲν μάταιον ἐς τρὶς εὔξασθαι θεῷ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:47.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:47.1.text#ἣ δ' εὐκλεὴς μέν, ἀλλ' ὅμως ἀπόλλυται,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:48.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:48.1.text#Φαίδρα· τὸ γὰρ τῆσδ' οὐ προτιμήσω κακὸν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:49.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:49.1.text#τὸ μὴ οὐ παρασχεῖν τοὺς ἐμοὺς ἐχθροὺς ἐμοὶ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:50.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:50.1.text#δίκην τοσαύτην ὥστ' ἐμοὶ καλῶς ἔχειν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:51.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:51.1.text#ἀλλ', εἰσορῶ γὰρ τόνδε παῖδα Θησέως
urn:cts:greekLit:tlg0006.tlg005.fu.sp:52.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:52.1.text#στείχοντα, θήρας μόχθον ἐκλελοιπότα,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:53.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:53.1.text#Ἱππόλυτον, ἔξω τῶνδε βήσομαι τόπων.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:54.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:54.1.text#πολὺς δ' ἅμ' αὐτῷ προσπόλων ὀπισθόπους
urn:cts:greekLit:tlg0006.tlg005.fu.sp:55.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:55.1.text#κῶμος λέλακεν, Ἄρτεμιν τιμῶν θεὰν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:56.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:56.1.text#ὕμνοισιν· οὐ γὰρ οἶδ' ἀνεῳγμένας πύλας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:57.1.speaker#Ἀφροδίτη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:57.1.text#Ἅιδου, φάος δὲ λοίσθιον βλέπων τόδε.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:58.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:58.1.text#ἕπεσθ' ἀείδοντες ἕπεσθε
urn:cts:greekLit:tlg0006.tlg005.fu.sp:59.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:59.1.text#τὰν Διὸς οὐρανίαν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:60.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:60.1.text#Ἄρτεμιν, ᾇ μελόμεσθα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:61.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:61.1.text#πότνια πότνια σεμνοτάτα,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:62.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:62.1.text#Ζανὸς γένεθλον,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:63.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:63.1.text#χαῖρε, χαῖρέ μοι, ὦ κόρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:65.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:65.1.text#Λατοῦς Ἄρτεμι καὶ Διός,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:66.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:66.1.text#καλλίστα πολὺ παρθένων,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:67.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:67.1.text#ἃ μέγαν κατ' οὐρανὸν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:68.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:68.1.text#ναίεις εὐπατέρειαν αὐλάν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:69.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:69.1.text#Ζηνὸς πολύχρυσον οἶκον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:70.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:70.1.text#χαῖρέ μοι, ὦ καλλίστα καλλίστα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:71.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:71.1.text#τῶν κατ'  Ὄλυμπον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:72.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:72.1.text#[ παρθένων, Ἄρτεμι. ][ … ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:73.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:73.1.text#σοὶ τόνδε πλεκτὸν στέφανον ἐξ ἀκηράτου
urn:cts:greekLit:tlg0006.tlg005.fu.sp:74.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:74.1.text#λειμῶνος, ὦ δέσποινα, κοσμήσας φέρω,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:75.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:75.1.text#ἔνθ' οὔτε ποιμὴν ἀξιοῖ φέρβειν βοτὰ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:76.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:76.1.text#οὔτ' ἦλθέ πω σίδαρος, ἀλλ' ἀκήρατον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:77.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:77.1.text#μέλισσα λειμῶν' ἠρινὴ διέρχεται,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:78.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:78.1.text#Αἰδὼς δὲ ποταμίαισι κηπεύει δρόσοις·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:79.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:79.1.text#ὅσοις διδακτὸν μηδέν, ἀλλ' ἐν τῇ φύσει
urn:cts:greekLit:tlg0006.tlg005.fu.sp:80.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:80.1.text#τὸ σωφρονεῖν εἴληχεν ἐς τὰ πάνθ' ὁμῶς,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:81.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:81.1.text#τούτοις δρέπεσθαι, τοῖς κακοῖσι δ' οὐ θέμις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:82.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:82.1.text#ἀλλ', ὦ φίλη δέσποινα, χρυσέας κόμης
urn:cts:greekLit:tlg0006.tlg005.fu.sp:83.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:83.1.text#ἀνάδημα δέξαι χειρὸς εὐσεβοῦς ἄπο.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:84.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:84.1.text#μόνῳ γάρ ἐστι τοῦτ' ἐμοὶ γέρας βροτῶν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:85.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:85.1.text#σοὶ καὶ ξύνειμι καὶ λόγοις ἀμείβομαι,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:86.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:86.1.text#κλύων μὲν αὐδήν, ὄμμα δ' οὐχ ὁρῶν τὸ σόν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:87.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:87.1.text#τέλος δὲ κάμψαιμ' ὥσπερ ἠρξάμην βίου.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:88.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:88.1.text#ἄναξ — θεοὺς γὰρ δεσπότας καλεῖν χρεών —
urn:cts:greekLit:tlg0006.tlg005.fu.sp:89.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:89.1.text#ἆρ' ἄν τί μου δέξαιο βουλεύσαντος εὖ;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:90.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:90.1.text#καὶ κάρτα γ'· ἦ γὰρ οὐ σοφοὶ φαινοίμεθ' ἄν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:91.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:91.1.text#οἶσθ' οὖν βροτοῖσιν ὃς καθέστηκεν νόμος [ … ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:92.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:92.1.text#οὐκ οἶδα· τοῦ δὲ καί μ' ἀνιστορεῖς πέρι;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:93.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:93.1.text#μισεῖν τὸ σεμνὸν καὶ τὸ μὴ πᾶσιν φίλον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:94.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:94.1.text#ὀρθῶς γε· τίς δ' οὐ σεμνὸς ἀχθεινὸς βροτῶν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:95.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:95.1.text#ἐν δ' εὐπροσηγόροισιν ἔστι τις χάρις;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:96.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:96.1.text#πλείστη γε, καὶ κέρδος γε σὺν μόχθῳ βραχεῖ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:97.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:97.1.text#ἦ κἀν θεοῖσι ταὐτὸν ἐλπίζεις τόδε;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:98.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:98.1.text#εἴπερ γε θνητοὶ θεῶν νόμοισι χρώμεθα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:99.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:99.1.text#πῶς οὖν σὺ σεμνός, δαίμον' οὐ προσεννέπων [ … ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:100.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:100.1.text#τίν'; εὐλαβοῦ δὲ μή τί σου σφαλῇ στόμα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:101.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:101.1.text#τήνδ', ἣ πύλαισι σαῖς ἐφέστηκεν Κύπρις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:102.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:102.1.text#πρόσωθεν αὐτὴν ἁγνὸς ὢν ἀσπάζομαι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:103.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:103.1.text#σεμνός γε μέντοι κἀπίσημος ἐν βροτοῖς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:104.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:104.1.text#ἄλλοισιν ἄλλος θεῶν τε κἀνθρώπων μέλει.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:105.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:105.1.text#εὐδαιμονοίης νοῦν ἔχων ὅσον σε δεῖ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:106.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:106.1.text#οὐδείς μ' ἀρέσκει νυκτὶ θαυμαστὸς θεῶν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:107.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:107.1.text#τιμαῖσιν, ὦ παῖ, δαιμόνων χρῆσθαι χρεών.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:108.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:108.1.text#χωρεῖτ', ὀπαδοί, καὶ παρελθόντες δόμους
urn:cts:greekLit:tlg0006.tlg005.fu.sp:109.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:109.1.text#σίτων μέλεσθε· τερπνὸν ἐκ κυναγίας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:110.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:110.1.text#τράπεζα πλήρης· καὶ καταψήχειν χρεὼν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:111.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:111.1.text#ἵππους, ὅπως ἂν ἅρμασιν ζεύξας ὕπο
urn:cts:greekLit:tlg0006.tlg005.fu.sp:112.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:112.1.text#βορᾶς κορεσθεὶς γυμνάσω τὰ πρόσφορα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:113.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:113.1.text#τὴν σὴν δὲ Κύπριν πόλλ' ἐγὼ χαίρειν λέγω.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:114.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:114.1.text#ἡμεῖς δέ — τοὺς νέους γὰρ οὐ μιμητέον,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:115.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:115.1.text#φρονοῦντας  οὕτως — ὡς πρέπει δούλοις λέγειν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:116.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:116.1.text#προσευξόμεσθα τοῖσι σοῖς ἀγάλμασιν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:117.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:117.1.text#δέσποινα Κύπρι. χρὴ δὲ συγγνώμην ἔχειν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:118.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:118.1.text#εἴ τίς σ' ὑφ' ἥβης σπλάγχνον ἔντονον φέρων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:119.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:119.1.text#μάταια βάζει· μὴ δόκει τούτων κλύειν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:120.1.speaker#Θεράπων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:120.1.text#σοφωτέρους γὰρ χρὴ βροτῶν εἶναι θεούς.[ … ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:121.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:121.1.text#Ὠκεανοῦ τις ὕδωρ στάζουσα πέτρα λέγεται,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:122.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:122.1.text#βαπτὰν κάλπισι ῥυτὰν παγὰν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:123.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:123.1.text#προιεῖσα κρημνῶν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:125.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:125.1.text#ὅθι μοί τις ἦν φίλα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:126.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:126.1.text#πορφύρεα φάρεα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:127.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:127.1.text#ποταμίᾳ δρόσῳ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:128.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:128.1.text#τέγγουσα, θερμᾶς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:128.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:128.2.text#δ' ἐπὶ νῶτα πέτρας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:129.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:129.1.text#εὐαλίου κατέβαλλ'· ὅθεν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:130.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:130.1.text#μοι πρώτα φάτις ἦλθε δεσποίνας·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:131.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:131.1.text#τειρομέναν νοσερᾷ κοίτᾳ δέμας ἐντὸς ἔχειν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:132.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:132.1.text#οἴκων, λεπτὰ δὲ φάρη ξάνθαν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:133.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:133.1.text#κεφαλὰν σκιάζειν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:135.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:135.1.text#τριτάταν δέ νιν κλύω
urn:cts:greekLit:tlg0006.tlg005.fu.sp:136.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:136.1.text#τάνδ' ἀβρωσίᾳ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:137.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:137.1.text#στόματος ἁμέραν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:138.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:138.1.text#Δάματρος ἀκτᾶς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:138.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:138.2.text#δέμας ἁγνὸν ἴσχειν, κρυπτῷ 
urn:cts:greekLit:tlg0006.tlg005.fu.sp:139.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:139.1.text#πένθει θανάτου θέλουσαν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:140.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:140.1.text#κέλσαι ποτὶ τέρμα δύστανον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:141.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:141.1.text#— ἦ σὺ γ' ἔνθεος, ὦ κούρα,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:142.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:142.1.text#εἴτ' ἐκ Πανὸς εἴθ' Ἑκάτας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:143.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:143.1.text#ἢ σεμνῶν Κορυβάντων φοιτᾷς 
urn:cts:greekLit:tlg0006.tlg005.fu.sp:144.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:144.1.text#ἢ ματρὸς ὀρείας;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:145.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:145.1.text#— σὺ δ' ἀμφὶ τὰν πολύθηρον Δίκτυνναν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:146.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:146.1.text#ἀμπλακίαις ἀνίερος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:147.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:147.1.text#ἀθύτων πελάνων τρύχῃ;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:148.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:148.1.text#φοιτᾷ γὰρ καὶ διὰ λίμνας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:149.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:149.1.text#χέρσον θ' ὑπὲρ πελάγους
urn:cts:greekLit:tlg0006.tlg005.fu.sp:150.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:150.1.text#δίναις ἐν νοτίαις ἅλμας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:151.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:151.1.text#— ἢ πόσιν, τὸν Ἐρεχθειδᾶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:152.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:152.1.text#ἀρχαγόν, τὸν εὐπατρίδαν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:153.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:153.1.text#ποιμαίνει τις ἐν οἴκοις κρυπτὰ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:154.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:154.1.text#κοίτα λεχέων σῶν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:155.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:155.1.text#— ἢ ναυβάτας τις ἔπλευσεν Κρήτας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:156.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:156.1.text#ἔξορμος ἀνὴρ λιμένα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:157.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:157.1.text#τὸν εὐξεινότατον ναύταις,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:158.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:158.1.text#φήμαν πέμπων βασιλείᾳ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:159.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:159.1.text#λύπᾳ δ' ὑπὲρ παθέων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:160.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:160.1.text#εὐναία δέδεται ψυχά;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:161.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:161.1.text#— φιλεῖ δὲ τᾷ δυστρόπῳ γυναικῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:162.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:162.1.text#ἁρμονίᾳ κακὰ δύστανος ἀμηχανία συνοικεῖν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:163.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:163.1.text#ὠδινῶν τε καὶ ἀφροσύνας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:165.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:165.1.text#δι' ἐμᾶς ᾖξέν ποτε νηδύος ἅδ'
urn:cts:greekLit:tlg0006.tlg005.fu.sp:166.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:166.1.text#αὔρα. τὰν δ' εὔλοχον οὐρανίαν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:167.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:167.1.text#τόξων μεδέουσαν ἀύτευν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:168.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:168.1.text#Ἄρτεμιν, καί μοι πολυζήλωτος αἰεὶ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:169.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:169.1.text#σὺν θεοῖσι φοιτᾷ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:170.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:170.1.text#— ἀλλ' ἥδε τροφὸς γεραιὰ πρὸ θυρῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:171.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:171.1.text#τήνδε κομίζουσ' ἔξω μελάθρων·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:172.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:172.1.text#[ στυγνὸν δ' ὀφρύων νέφος αὐξάνεται. ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:173.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:173.1.text#τί ποτ' ἔστι μαθεῖν ἔραται ψυχή,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:174.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:174.1.text#τί δεδήληται
urn:cts:greekLit:tlg0006.tlg005.fu.sp:175.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:175.1.text#δέμας ἀλλόχροον βασιλείας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:176.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:176.1.text#ὦ κακὰ θνητῶν στυγεραί τε νόσοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:177.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:177.1.text#τί σ' ἐγὼ δράσω; τί δὲ μὴ δράσω;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:178.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:178.1.text#τόδε σοι φέγγος λαμπρόν, ὅδ' αἰθήρ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:179.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:179.1.text#ἔξω δὲ δόμων ἤδη νοσερᾶς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:180.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:180.1.text#δέμνια κοίτης.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:181.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:181.1.text#δεῦρο γὰρ ἐλθεῖν πᾶν ἔπος ἦν σοι·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:182.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:182.1.text#τάχα δ' ἐς θαλάμους σπεύσεις τὸ πάλιν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:183.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:183.1.text#ταχὺ γὰρ σφάλλῃ κοὐδενὶ χαίρεις,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:184.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:184.1.text#οὐδέ σ' ἀρέσκει τὸ παρόν, τὸ δ' ἀπὸν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:185.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:185.1.text#φίλτερον ἡγῇ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:186.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:186.1.text#κρεῖσσον δὲ νοσεῖν ἢ θεραπεύειν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:187.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:187.1.text#τὸ μέν ἐστιν ἁπλοῦν, τῷ δὲ συνάπτει
urn:cts:greekLit:tlg0006.tlg005.fu.sp:188.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:188.1.text#λύπη τε φρενῶν χερσίν τε πόνος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:189.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:189.1.text#πᾶς δ' ὀδυνηρὸς βίος ἀνθρώπων,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:190.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:190.1.text#κοὐκ ἔστι πόνων ἀνάπαυσις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:191.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:191.1.text#ἀλλ' ὅ τι τοῦ ζῆν φίλτερον ἄλλο
urn:cts:greekLit:tlg0006.tlg005.fu.sp:192.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:192.1.text#σκότος ἀμπίσχων κρύπτει νεφέλαις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:194.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:194.1.text#τοῦ δ' ὅ τι τοῦτο στίλβει κατὰ γῆν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:193.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:193.1.text#δυσέρωτες δὴ φαινόμεθ' ὄντες,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:195.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:195.1.text#δι' ἀπειροσύνην ἄλλου βιότου
urn:cts:greekLit:tlg0006.tlg005.fu.sp:196.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:196.1.text#κοὐκ ἀπόδειξιν τῶν ὑπὸ γαίας·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:197.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:197.1.text#μύθοις δ' ἄλλως φερόμεσθα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:198.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:198.1.text#ἄρατέ μου δέμας, ὀρθοῦτε κάρα·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:199.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:199.1.text#λέλυμαι μελέων σύνδεσμα φίλων.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:200.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:200.1.text#λάβετ' εὐπήχεις χεῖρας, πρόπολοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:201.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:201.1.text#βαρύ μοι κεφαλᾶς ἐπίκρανον ἔχειν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:202.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:202.1.text#ἄφελ', ἀμπέτασον βόστρυχον ὤμοις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:203.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:203.1.text#θάρσει, τέκνον, καὶ μὴ χαλεπῶς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:204.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:204.1.text#μετάβαλλε δέμας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:205.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:205.1.text#ῥᾷον δὲ νόσον μετά θ' ἡσυχίας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:206.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:206.1.text#καὶ γενναίου λήματος οἴσεις·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:207.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:207.1.text#μοχθεῖν δὲ βροτοῖσιν ἀνάγκη.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:208.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:208.1.text#αἰαῖ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:208.2.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:208.2.text#πῶς ἂν δροσερᾶς ἀπὸ κρηνῖδος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:209.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:209.1.text#καθαρῶν ὑδάτων πῶμ' ἀρυσαίμαν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:210.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:210.1.text#ὑπό τ' αἰγείροις ἔν τε κομήτῃ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:211.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:211.1.text#λειμῶνι κλιθεῖσ' ἀναπαυσαίμαν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:212.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:212.1.text#ὦ παῖ, τί θροεῖς;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:213.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:213.1.text#οὐ μὴ παρ' ὄχλῳ τάδε γηρύσῃ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:214.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:214.1.text#μανίας ἔποχον ῥίπτουσα λόγον;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:215.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:215.1.text#πέμπετέ μ' εἰς ὄρος· εἶμι πρὸς ὕλαν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:216.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:216.1.text#καὶ παρὰ πεύκας, ἵνα θηροφόνοι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:217.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:217.1.text#στείβουσι κύνες
urn:cts:greekLit:tlg0006.tlg005.fu.sp:218.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:218.1.text#βαλιαῖς ἐλάφοις ἐγχριμπτόμεναι·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:219.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:219.1.text#πρὸς θεῶν, ἔραμαι κυσὶ θωΰξαι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:220.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:220.1.text#καὶ παρὰ χαίταν ξανθὰν ῥῖψαι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:221.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:221.1.text#Θεσσαλὸν ὅρπακ', ἐπίλογχον ἔχουσ'
urn:cts:greekLit:tlg0006.tlg005.fu.sp:222.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:222.1.text#ἐν χειρὶ βέλος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:223.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:223.1.text#τί ποτ', ὦ τέκνον, τάδε κηραίνεις;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:224.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:224.1.text#τί κυνηγεσίων καὶ σοὶ μελέτη;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:225.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:225.1.text#τί δὲ κρηναίων νασμῶν ἔρασαι;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:226.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:226.1.text#πάρα γὰρ δροσερὰ πύργοις συνεχὴς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:227.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:227.1.text#κλιτύς, ὅθεν σοι πῶμα γένοιτ' ἄν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:228.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:228.1.text#δέσποιν' ἁλίας  Ἄρτεμι Λίμνας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:229.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:229.1.text#καὶ γυμνασίων τῶν ἱπποκρότων,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:230.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:230.1.text#εἴθε γενοίμαν ἐν σοῖς δαπέδοις,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:231.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:231.1.text#πώλους Ἐνέτας δαμαλιζομένα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:232.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:232.1.text#τί τόδ' αὖ παράφρων ἔρριψας ἔπος;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:233.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:233.1.text#νῦν δὴ μὲν ὄρος βᾶσ' ἐπὶ θήρας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:234.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:234.1.text#πόθον ἐστέλλου, νῦν δ' αὖ ψαμάθοις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:235.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:235.1.text#ἐπ' ἀκυμάντοις πώλων ἔρασαι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:236.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:236.1.text#τάδε μαντείας ἄξια πολλῆς,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:237.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:237.1.text#ὅστις σε θεῶν ἀνασειράζει
urn:cts:greekLit:tlg0006.tlg005.fu.sp:238.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:238.1.text#καὶ παρακόπτει φρένας, ὦ παῖ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:239.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:239.1.text#δύστηνος ἐγώ, τί ποτ' εἰργασάμην;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:240.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:240.1.text#ποῖ παρεπλάγχθην γνώμης ἀγαθῆς;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:241.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:241.1.text#ἐμάνην, ἔπεσον δαίμονος ἄτῃ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:242.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:242.1.text#φεῦ φεῦ, τλήμων.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:243.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:243.1.text#μαῖα, πάλιν μου κρύψον κεφαλήν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:244.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:244.1.text#αἰδούμεθα γὰρ τὰ λελεγμένα μοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:245.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:245.1.text#κρύπτε· κατ' ὄσσων δάκρυ μοι βαίνει,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:246.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:246.1.text#καὶ ἐπ' αἰσχύνην ὄμμα τέτραπται.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:247.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:247.1.text#τὸ γὰρ ὀρθοῦσθαι γνώμην ὀδυνᾷ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:248.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:248.1.text#τὸ δὲ μαινόμενον κακόν· ἀλλὰ κρατεῖ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:249.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:249.1.text#μὴ γιγνώσκοντ' ἀπολέσθαι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:250.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:250.1.text#κρύπτω· τὸ δ' ἐμὸν πότε δὴ θάνατος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:251.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:251.1.text#σῶμα καλύψει;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:252.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:252.1.text#πολλὰ διδάσκει μ' ὁ πολὺς βίοτος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:253.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:253.1.text#χρῆν γὰρ μετρίας εἰς ἀλλήλους
urn:cts:greekLit:tlg0006.tlg005.fu.sp:254.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:254.1.text#φιλίας θνητοὺς ἀνακίρνασθαι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:255.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:255.1.text#καὶ μὴ πρὸς ἄκρον μυελὸν ψυχῆς,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:256.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:256.1.text#εὔλυτα δ' εἶναι στέργηθρα φρενῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:257.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:257.1.text#ἀπό τ' ὤσασθαι καὶ ξυντεῖναι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:258.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:258.1.text#τὸ δ' ὑπὲρ δισσῶν μίαν ὠδίνειν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:259.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:259.1.text#ψυχὴν χαλεπὸν βάρος, ὡς κἀγὼ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:260.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:260.1.text#τῆσδ' ὑπεραλγῶ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:261.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:261.1.text#βιότου δ' ἀτρεκεῖς ἐπιτηδεύσεις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:262.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:262.1.text#φασὶ σφάλλειν πλέον ἢ τέρπειν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:263.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:263.1.text#τῇ θ' ὑγιείᾳ μᾶλλον πολεμεῖν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:264.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:264.1.text#οὕτω τὸ λίαν ἧσσον ἐπαινῶ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:265.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:265.1.text#τοῦ μηδὲν ἄγαν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:266.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:266.1.text#καὶ ξυμφήσουσι σοφοί μοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:267.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:267.1.text#γύναι γεραιά, βασιλίδος πιστὴ τροφὲ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:268.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:268.1.text#Φαίδρας, ὁρῶμεν τάσδε δυστήνους τύχας,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:269.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:269.1.text#ἄσημα δ' ἡμῖν ἥτις ἐστὶν ἡ νόσος·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:270.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:270.1.text#σοῦ δ' ἂν πυθέσθαι καὶ κλύειν βουλοίμεθ' ἄν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:271.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:271.1.text#οὐκ οἶδ' ἐλέγχους· οὐ γὰρ ἐννέπειν θέλει.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:272.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:272.1.text#οὐδ' ἥτις ἀρχὴ τῶνδε πημάτων ἔφυ;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:273.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:273.1.text#ἐς ταὐτὸν ἥκεις· πάντα γὰρ σιγᾷ τάδε.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:274.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:274.1.text#ὡς ἀσθενεῖ τε καὶ κατέξανται δέμας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:275.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:275.1.text#πῶς δ' οὔ, τριταίαν γ' οὖσ' ἄσιτος ἡμέραν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:276.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:276.1.text#πότερον ὑπ' ἄτης ἢ θανεῖν πειρωμένη;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:277.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:277.1.text#θανεῖν; ἀσιτεῖ γ' εἰς ἀπόστασιν βίου.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:278.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:278.1.text#θαυμαστὸν εἶπας, εἰ τάδ' ἐξαρκεῖ πόσει.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:279.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:279.1.text#κρύπτει γὰρ ἥδε πῆμα κοὔ φησιν νοσεῖν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:280.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:280.1.text#ὃ δ' ἐς πρόσωπον οὐ τεκμαίρεται βλέπων;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:281.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:281.1.text#ἔκδημος ὢν γὰρ τῆσδε τυγχάνει χθονός.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:282.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:282.1.text#σὺ δ' οὐκ ἀνάγκην προσφέρεις, πειρωμένη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:283.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:283.1.text#νόσον πυθέσθαι τῆσδε καὶ πλάνον φρενῶν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:284.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:284.1.text#ἐς πάντ' ἀφῖγμαι κοὐδὲν εἴργασμαι πλέον·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:285.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:285.1.text#οὐ μὴν ἀνήσω γ' οὐδὲ νῦν προθυμίας,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:286.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:286.1.text#ὡς ἂν παροῦσα καὶ σύ μοι ξυμμαρτυρῇς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:287.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:287.1.text#οἵα πέφυκα δυστυχοῦσι δεσπόταις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:288.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:288.1.text#ἄγ', ὦ φίλη παῖ, τῶν πάροιθε μὲν λόγων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:289.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:289.1.text#λαθώμεθ' ἄμφω, καὶ σύ θ' ἡδίων γενοῦ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:290.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:290.1.text#στυγνὴν ὀφρὺν λύσασα καὶ γνώμης ὁδόν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:291.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:291.1.text#ἐγώ θ' ὅπῃ σοι μὴ καλῶς τόθ' εἱπόμην
urn:cts:greekLit:tlg0006.tlg005.fu.sp:292.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:292.1.text#μεθεῖσ' ἐπ' ἄλλον εἶμι βελτίω λόγον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:293.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:293.1.text#κεἰ μὲν νοσεῖς τι τῶν ἀπορρήτων κακῶν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:294.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:294.1.text#γυναῖκες αἵδε συγκαθιστάναι νόσον·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:295.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:295.1.text#εἰ δ' ἔκφορός σοι συμφορὰ πρὸς ἄρσενας,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:296.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:296.1.text#λέγ', ὡς ἰατροῖς πρᾶγμα μηνυθῇ τόδε.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:297.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:297.1.text#εἶἑν· τί σιγᾷς; οὐκ ἐχρῆν σιγᾶν, τέκνον,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:298.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:298.1.text#ἀλλ' ἤ μ' ἐλέγχειν, εἴ τι μὴ καλῶς λέγω,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:299.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:299.1.text#ἢ τοῖσιν εὖ λεχθεῖσι συγχωρεῖν λόγοις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:300.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:300.1.text#φθέγξαι τι, δεῦρ' ἄθρησον. — ὦ τάλαιν' ἐγώ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:301.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:301.1.text#γυναῖκες, ἄλλως τούσδε μοχθοῦμεν πόνους,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:302.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:302.1.text#ἴσον δ' ἄπεσμεν τῷ πρίν· οὔτε γὰρ τότε
urn:cts:greekLit:tlg0006.tlg005.fu.sp:303.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:303.1.text#λόγοις ἐτέγγεθ' ἥδε νῦν τ' οὐ πείθεται. —
urn:cts:greekLit:tlg0006.tlg005.fu.sp:304.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:304.1.text#ἀλλ' ἴσθι μέντοι — πρὸς τάδ' αὐθαδεστέρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:305.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:305.1.text#γίγνου θαλάσσης — εἰ θανῇ, προδοῦσα σοὺς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:306.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:306.1.text#παῖδας πατρῴων μὴ μεθέξοντας δόμων,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:307.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:307.1.text#μὰ τὴν ἄνασσαν ἱππίαν Ἀμαζόνα,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:308.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:308.1.text#ἣ σοῖς τέκνοισι δεσπότην ἐγείνατο
urn:cts:greekLit:tlg0006.tlg005.fu.sp:309.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:309.1.text#νόθον φρονοῦντα γνήσι', οἶσθά νιν καλῶς,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:310.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:310.1.text#Ἱππόλυτον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:310.2.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:310.2.text#οἴμοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:310.3.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:310.3.text#θιγγάνει σέθεν τόδε;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:311.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:311.1.text#ἀπώλεσάς με, μαῖα, καί σε πρὸς θεῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:312.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:312.1.text#τοῦδ' ἀνδρὸς αὖθις λίσσομαι σιγᾶν πέρι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:313.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:313.1.text#ὁρᾷς; φρονεῖς μὲν εὖ, φρονοῦσα δ' οὐ θέλεις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:314.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:314.1.text#παῖδάς τ' ὀνῆσαι καὶ σὸν ἐκσῶσαι βίον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:315.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:315.1.text#φιλῶ τέκν'· ἄλλῃ δ' ἐν τύχῃ χειμάζομαι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:316.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:316.1.text#ἁγνὰς μέν, ὦ παῖ, χεῖρας αἵματος φορεῖς;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:317.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:317.1.text#χεῖρες μὲν ἁγναί, φρὴν δ' ἔχει μίασμά τι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:318.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:318.1.text#μῶν ἐξ ἐπακτοῦ πημονῆς ἐχθρῶν τινος;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:319.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:319.1.text#φίλος μ' ἀπόλλυσ' οὐχ ἑκοῦσαν οὐχ ἑκών.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:320.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:320.1.text#Θησεύς τιν' ἡμάρτηκεν ἐς σ' ἁμαρτίαν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:321.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:321.1.text#μὴ δρῶσ' ἔγωγ' ἐκεῖνον ὀφθείην κακῶς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:322.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:322.1.text#τί γὰρ τὸ δεινὸν τοῦθ' ὅ σ' ἐξαίρει θανεῖν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:323.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:323.1.text#ἔα μ' ἁμαρτεῖν· οὐ γὰρ ἐς σὲ ἁμαρτάνω.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:324.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:324.1.text#οὐ δῆθ' ἑκοῦσά γ', ἐν δὲ σοὶ λελείψομαι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:325.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:325.1.text#τί δρᾷς; βιάζῃ χειρὸς ἐξαρτωμένη;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:326.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:326.1.text#καὶ σῶν γε γονάτων, κοὐ μεθήσομαί ποτε.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:327.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:327.1.text#κάκ', ὦ τάλαινα, σοὶ τάδ', εἰ πεύσῃ, κακά.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:328.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:328.1.text#μεῖζον γὰρ ἢ σοῦ μὴ τυχεῖν τί μοι κακόν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:329.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:329.1.text#ὀλεῖς· τὸ μέντοι πρᾶγμ' ἐμοὶ τιμὴν φέρει.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:330.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:330.1.text#κἄπειτα κρύπτεις χρήσθ' ἱκνουμένης ἐμοῦ;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:331.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:331.1.text#ἐκ τῶν γὰρ αἰσχρῶν ἐσθλὰ μηχανώμεθα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:332.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:332.1.text#οὐκοῦν λέγουσα τιμιωτέρα φανῇ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:333.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:333.1.text#ἄπελθε πρὸς θεῶν δεξιᾶς τ' ἐμῆς μέθες.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:334.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:334.1.text#οὐ δῆτ', ἐπεί μοι δῶρον οὐ δίδως ὃ χρῆν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:335.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:335.1.text#δώσω· σέβας γὰρ χειρὸς αἰδοῦμαι τὸ σόν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:336.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:336.1.text#σιγῷμ' ἂν ἤδη· σὸς γὰρ οὑντεῦθεν λόγος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:337.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:337.1.text#ὦ τλῆμον, οἷον, μῆτερ, ἠράσθης ἔρον,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:338.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:338.1.text#ὃν ἔσχε Ταύρου, τέκνον, ἢ τί φῂς τόδε;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:339.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:339.1.text#σύ τ', ὦ τάλαιν' ὅμαιμε, Διονύσου δάμαρ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:340.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:340.1.text#τέκνον, τί πάσχεις; συγγόνους κακορροθεῖς;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:341.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:341.1.text#τρίτη δ' ἐγὼ δύστηνος ὡς ἀπόλλυμαι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:342.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:342.1.text#ἔκ τοι πέπληγμαι· ποῖ προβήσεται λόγος;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:343.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:343.1.text#ἐκεῖθεν ἡμεῖς, οὐ νεωστί, δυστυχεῖς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:344.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:344.1.text#οὐδέν τι μᾶλλον οἶδ' ἃ βούλομαι κλύειν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:345.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:345.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:345.2.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:345.2.text#πῶς ἂν σύ μοι λέξειας ἁμὲ χρὴ λέγειν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:346.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:346.1.text#οὐ μάντις εἰμὶ τἀφανῆ γνῶναι σαφῶς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:347.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:347.1.text#τί τοῦθ', ὃ δὴ λέγουσιν ἀνθρώπους, ἐρᾶν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:348.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:348.1.text#ἥδιστον, ὦ παῖ, ταὐτὸν ἀλγεινόν θ' ἅμα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:349.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:349.1.text#ἡμεῖς ἂν εἶμεν θατέρῳ κεχρημένοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:350.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:350.1.text#τί φῄς; ἐρᾷς, ὦ τέκνον; ἀνθρώπων τίνος;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:351.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:351.1.text#ὅστις ποθ' οὗτός ἐσθ', ὁ τῆς Ἀμαζόνος [ … ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:352.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:352.1.text#Ἱππόλυτον αὐδᾷς;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:352.2.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:352.2.text#σοῦ τάδ', οὐκ ἐμοῦ κλύεις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:353.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:353.1.text#οἴμοι, τί λέξεις, τέκνον; ὥς μ' ἀπώλεσας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:354.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:354.1.text#γυναῖκες, οὐκ ἀνασχέτ'· οὐκ ἀνέξομαι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:355.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:355.1.text#ζῶσ'· ἐχθρὸν ἦμαρ, ἐχθρὸν εἰσορῶ φάος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:356.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:356.1.text#ῥίψω μεθήσω σῶμ', ἀπαλλαχθήσομαι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:357.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:357.1.text#βίου θανοῦσα· χαίρετ'· οὐκέτ' εἴμ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:358.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:358.1.text#οἱ σώφρονες γὰρ οὐχ ἑκόντες, ἀλλ' ὅμως
urn:cts:greekLit:tlg0006.tlg005.fu.sp:359.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:359.1.text#κακῶν ἐρῶσι. Κύπρις οὐκ ἄρ' ἦν θεός,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:360.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:360.1.text#ἀλλ' εἴ τι μεῖζον ἄλλο γίγνεται θεοῦ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:361.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:361.1.text#ἣ τήνδε κἀμὲ καὶ δόμους ἀπώλεσεν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:362.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:362.1.text#ἄιες ὤ, ἔκλυες ὤ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:362.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:362.2.text#ἀνήκουστα τᾶς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:363.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:363.1.text#τυράννου πάθεα μέλεα θρεομένας;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:364.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:364.1.text#— ὀλοίμαν ἔγωγε, { πρὶν σὰν φιλίαν }
urn:cts:greekLit:tlg0006.tlg005.fu.sp:365.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:365.1.text#{ κατανύσαι φρενῶν. } ἰώ μοι, φεῦ φεῦ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:366.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:366.1.text#— ὦ τάλαινα τῶνδ' ἀλγέων·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:367.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:367.1.text#— ὦ πόνοι τρέφοντες βροτούς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:368.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:368.1.text#— ὄλωλας, ἐξέφηνας ἐς φάος κακά.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:369.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:369.1.text#— τίς σε παναμέριος ὅδε χρόνος μένει;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:370.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:370.1.text#— τελευτάσεταί τι καινὸν δόμοις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:371.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:371.1.text#— ἄσημα δ' οὐκέτ' ἐστὶν οἷ φθίνει τύχα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:372.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:372.1.text#Κύπριδος, ὦ τάλαινα παῖ Κρησία.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:373.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:373.1.text#Τροζήνιαι γυναῖκες, αἳ τόδ' ἔσχατον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:374.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:374.1.text#οἰκεῖτε χώρας Πελοπίας προνώπιον,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:375.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:375.1.text#ἤδη ποτ' ἄλλως νυκτὸς ἐν μακρῷ χρόνῳ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:376.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:376.1.text#θνητῶν ἐφρόντισ' ᾗ διέφθαρται βίος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:377.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:377.1.text#καί μοι δοκοῦσιν οὐ κατὰ γνώμης φύσιν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:378.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:378.1.text#πράσσειν κάκιον· ἔστι γὰρ τό γ' εὖ φρονεῖν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:379.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:379.1.text#πολλοῖσιν· ἀλλὰ τῇδ' ἀθρητέον τόδε·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:380.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:380.1.text#τὰ χρήστ' ἐπιστάμεσθα καὶ γιγνώσκομεν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:381.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:381.1.text#οὐκ ἐκπονοῦμεν δ', οἳ μὲν ἀργίας ὕπο,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:382.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:382.1.text#οἳ δ' ἡδονὴν προθέντες ἀντὶ τοῦ καλοῦ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:383.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:383.1.text#ἄλλην τιν'. εἰσὶ δ' ἡδοναὶ πολλαὶ βίου,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:384.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:384.1.text#μακραί τε λέσχαι καὶ σχολή, τερπνὸν κακόν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:385.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:385.1.text#αἰδώς τε. δισσαὶ δ' εἰσίν, ἣ μὲν οὐ κακή,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:386.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:386.1.text#ἣ δ' ἄχθος οἴκων. εἰ δ' ὁ καιρὸς ἦν σαφής,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:387.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:387.1.text#οὐκ ἂν δύ' ἤστην ταὔτ' ἔχοντε γράμματα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:388.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:388.1.text#ταῦτ' οὖν ἐπειδὴ τυγχάνω φρονοῦσ' ἐγώ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:389.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:389.1.text#οὐκ ἔσθ' ὁποίῳ φαρμάκῳ διαφθερεῖν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:390.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:390.1.text#ἔμελλον, ὥστε τοὔμπαλιν πεσεῖν φρενῶν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:391.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:391.1.text#λέξω δὲ καὶ σοὶ τῆς ἐμῆς γνώμης ὁδόν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:392.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:392.1.text#ἐπεί μ' ἔρως ἔτρωσεν, ἐσκόπουν ὅπως
urn:cts:greekLit:tlg0006.tlg005.fu.sp:393.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:393.1.text#κάλλιστ' ἐνέγκαιμ' αὐτόν. ἠρξάμην μὲν οὖν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:394.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:394.1.text#ἐκ τοῦδε, σιγᾶν τήνδε καὶ κρύπτειν νόσον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:395.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:395.1.text#γλώσσῃ γὰρ οὐδὲν πιστόν, ἣ θυραῖα μὲν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:396.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:396.1.text#φρονήματ' ἀνδρῶν νουθετεῖν ἐπίσταται,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:397.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:397.1.text#αὐτὴ δ' ὑφ' αὑτῆς πλεῖστα κέκτηται κακά.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:398.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:398.1.text#τὸ δεύτερον δὲ τὴν ἄνοιαν εὖ φέρειν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:399.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:399.1.text#τῷ σωφρονεῖν νικῶσα προυνοησάμην.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:400.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:400.1.text#τρίτον δ', ἐπειδὴ τοισίδ' οὐκ ἐξήνυτον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:401.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:401.1.text#Κύπριν κρατῆσαι, κατθανεῖν ἔδοξέ μοι,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:402.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:402.1.text#κράτιστον — οὐδεὶς ἀντερεῖ — βουλευμάτων.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:403.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:403.1.text#ἐμοὶ γὰρ εἴη μήτε λανθάνειν καλὰ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:404.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:404.1.text#μήτ' αἰσχρὰ δρώσῃ μάρτυρας πολλοὺς ἔχειν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:405.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:405.1.text#τὸ δ' ἔργον ᾔδη τὴν νόσον τε δυσκλεᾶ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:406.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:406.1.text#γυνή τε πρὸς τοῖσδ' οὖσ' ἐγίγνωσκον καλῶς,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:407.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:407.1.text#μίσημα πᾶσιν. ὡς ὄλοιτο παγκάκως
urn:cts:greekLit:tlg0006.tlg005.fu.sp:408.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:408.1.text#ἥτις πρὸς ἄνδρας ἤρξατ' αἰσχύνειν λέχη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:409.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:409.1.text#πρώτη θυραίους. ἐκ δὲ γενναίων δόμων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:410.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:410.1.text#τόδ' ἦρξε θηλείαισι γίγνεσθαι κακόν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:411.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:411.1.text#ὅταν γὰρ αἰσχρὰ τοῖσιν ἐσθλοῖσιν δοκῇ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:412.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:412.1.text#ἦ κάρτα δόξει τοῖς κακοῖς γ' εἶναι καλά.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:413.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:413.1.text#μισῶ δὲ καὶ τὰς σώφρονας μὲν ἐν λόγοις,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:414.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:414.1.text#λάθρᾳ δὲ τόλμας οὐ καλὰς κεκτημένας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:415.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:415.1.text#αἳ πῶς ποτ', ὦ δέσποινα ποντία Κύπρι,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:416.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:416.1.text#βλέπουσιν ἐς πρόσωπα τῶν ξυνευνετῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:417.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:417.1.text#οὐδὲ σκότον φρίσσουσι τὸν ξυνεργάτην
urn:cts:greekLit:tlg0006.tlg005.fu.sp:418.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:418.1.text#τέραμνά τ' οἴκων μή ποτε φθογγὴν ἀφῇ;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:419.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:419.1.text#ἡμᾶς γὰρ αὐτὸ τοῦτ' ἀποκτείνει, φίλαι,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:420.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:420.1.text#ὡς μήποτ' ἄνδρα τὸν ἐμὸν αἰσχύνασ' ἁλῶ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:421.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:421.1.text#μὴ παῖδας οὓς ἔτικτον· ἀλλ' ἐλεύθεροι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:422.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:422.1.text#παρρησίᾳ θάλλοντες οἰκοῖεν πόλιν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:423.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:423.1.text#κλεινῶν Ἀθηνῶν, μητρὸς οὕνεκ' εὐκλεεῖς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:424.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:424.1.text#δουλοῖ γὰρ ἄνδρα, κἂν θρασύσπλαγχνός τις ᾖ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:425.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:425.1.text#ὅταν ξυνειδῇ μητρὸς ἢ πατρὸς κακά.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:426.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:426.1.text#μόνον δὲ τοῦτό φασ' ἁμιλλᾶσθαι βίῳ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:427.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:427.1.text#γνώμην δικαίαν κἀγαθήν, ὅτῳ παρῇ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:428.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:428.1.text#κακοὺς δὲ θνητῶν ἐξέφην', ὅταν τύχῃ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:429.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:429.1.text#προθεὶς κάτοπτρον ὥστε παρθένῳ νέᾳ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:430.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:430.1.text#χρόνος· παρ' οἷσι μήποτ' ὀφθείην ἐγώ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:431.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:431.1.text#φεῦ φεῦ· τὸ σῶφρον ὡς ἁπανταχοῦ καλὸν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:432.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:432.1.text#καὶ δόξαν ἐσθλὴν ἐν βροτοῖς καρπίζεται.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:433.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:433.1.text#δέσποιν', ἐμοί τοι συμφορὰ μὲν  ἀρτίως
urn:cts:greekLit:tlg0006.tlg005.fu.sp:434.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:434.1.text#ἡ σὴ παρέσχε δεινὸν ἐξαίφνης φόβον·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:435.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:435.1.text#νῦν δ' ἐννοοῦμαι φαῦλος οὖσα· κἀν βροτοῖς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:436.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:436.1.text#αἱ δεύτεραί πως φροντίδες σοφώτεραι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:437.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:437.1.text#οὐ γὰρ περισσὸν οὐδὲν οὐδ' ἔξω λόγου
urn:cts:greekLit:tlg0006.tlg005.fu.sp:438.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:438.1.text#πέπονθας· ὀργαὶ δ' ἐς σ' ἀπέσκηψαν θεᾶς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:439.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:439.1.text#ἐρᾷς· τί τοῦτο θαῦμα; σὺν πολλοῖς βροτῶν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:440.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:440.1.text#κἄπειτ' ἔρωτος οὕνεκα ψυχὴν ὀλεῖς;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:441.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:441.1.text#οὔ τἄρα λύει τοῖς ἐρῶσι τῶν πέλας,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:442.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:442.1.text#ὅσοι τε μέλλουσ', εἰ θανεῖν αὐτοὺς χρεών·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:443.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:443.1.text#Κύπρις γὰρ οὐ φορητός, ἢν πολλὴ ῥυῇ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:444.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:444.1.text#ἣ τὸν μὲν εἴκονθ' ἡσυχῇ μετέρχεται,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:445.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:445.1.text#ὃν δ' ἂν περισσὸν καὶ φρονοῦνθ' εὕρῃ μέγα,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:446.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:446.1.text#τοῦτον λαβοῦσα — πῶς δοκεῖς; — καθύβρισεν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:447.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:447.1.text#φοιτᾷ δ' ἀν' αἰθέρ', ἔστι δ' ἐν θαλασσίῳ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:448.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:448.1.text#κλύδωνι Κύπρις, πάντα δ' ἐκ ταύτης ἔφυ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:449.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:449.1.text#ἥδ' ἐστὶν ἡ σπείρουσα καὶ διδοῦσ' ἔρον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:450.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:450.1.text#οὗ πάντες ἐσμὲν οἱ κατὰ χθόν' ἔγγονοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:451.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:451.1.text#ὅσοι μὲν οὖν γραφάς τε τῶν παλαιτέρων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:452.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:452.1.text#ἔχουσιν αὐτοί τ' εἰσὶν ἐν μούσαις ἀεί,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:453.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:453.1.text#ἴσασι μὲν Ζεὺς ὥς ποτ' ἠράσθη γάμων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:454.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:454.1.text#Σεμέλης, ἴσασι δ' ὡς ἀνήρπασέν ποτε
urn:cts:greekLit:tlg0006.tlg005.fu.sp:455.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:455.1.text#ἡ καλλιφεγγὴς Κέφαλον ἐς θεοὺς Ἕως
urn:cts:greekLit:tlg0006.tlg005.fu.sp:456.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:456.1.text#ἔρωτος εἵνεκ'· ἀλλ' ὅμως ἐν οὐρανῷ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:457.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:457.1.text#ναίουσι κοὐ φεύγουσιν ἐκποδὼν θεούς,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:458.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:458.1.text#στέργουσι δ', οἶμαι, ξυμφορᾷ νικώμενοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:459.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:459.1.text#σὺ δ' οὐκ ἀνέξῃ; χρῆν σ' ἐπὶ ῥητοῖς ἄρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:460.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:460.1.text#πατέρα φυτεύειν, ἢ 'πὶ δεσπόταις θεοῖς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:461.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:461.1.text#ἄλλοισιν, εἰ μὴ τούσδε γε στέρξεις νόμους.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:462.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:462.1.text#πόσους δοκεῖς δὴ κάρτ' ἔχοντας εὖ φρενῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:463.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:463.1.text#νοσοῦνθ' ὁρῶντας λέκτρα μὴ δοκεῖν ὁρᾶν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:464.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:464.1.text#πόσους δὲ παισὶ πατέρας ἡμαρτηκόσι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:465.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:465.1.text#συνεκκομίζειν Κύπριν; ἐν σοφοῖσι γὰρ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:466.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:466.1.text#τάδ' ἐστὶ θνητῶν, λανθάνειν τὰ μὴ καλά.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:467.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:467.1.text#οὐδ' ἐκπονεῖν τοι χρὴ βίον λίαν βροτούς·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:468.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:468.1.text#{ οὐδὲ στέγην γὰρ ἧς κατηρεφεῖς δόμοι }
urn:cts:greekLit:tlg0006.tlg005.fu.sp:469.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:469.1.text#{ καλῶς ἀκριβώσειαν· } ἐς δὲ τὴν τύχην
urn:cts:greekLit:tlg0006.tlg005.fu.sp:470.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:470.1.text#πεσοῦσ' ὅσην σὺ πῶς ἂν ἐκνεῦσαι δοκεῖς;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:471.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:471.1.text#ἀλλ', εἰ τὰ πλείω χρηστὰ τῶν κακῶν ἔχεις,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:472.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:472.1.text#ἄνθρωπος οὖσα, κάρτα γ' εὖ πράξειας ἄν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:473.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:473.1.text#ἀλλ', ὦ φίλη παῖ, λῆγε μὲν κακῶν φρενῶν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:474.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:474.1.text#λῆξον δ' ὑβρίζουσ'· οὐ γὰρ ἄλλο πλὴν ὕβρις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:475.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:475.1.text#τάδ' ἐστί, κρείσσω δαιμόνων εἶναι θέλειν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:476.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:476.1.text#τόλμα δ' ἐρῶσα· θεὸς ἐβουλήθη τάδε.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:477.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:477.1.text#νοσοῦσα δ' εὖ πως τὴν νόσον καταστρέφου.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:478.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:478.1.text#εἰσὶν δ' ἐπῳδαὶ καὶ λόγοι θελκτήριοι·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:479.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:479.1.text#φανήσεταί τι τῆσδε φάρμακον νόσου.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:480.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:480.1.text#ἦ τἄρ' ἂν ὀψέ γ' ἄνδρες ἐξεύροιεν ἄν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:481.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:481.1.text#εἰ μὴ γυναῖκες μηχανὰς εὑρήσομεν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:482.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:482.1.text#Φαίδρα, λέγει μὲν ἥδε χρησιμώτερα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:483.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:483.1.text#πρὸς τὴν παροῦσαν ξυμφοράν, αἰνῶ δὲ σέ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:484.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:484.1.text#ὁ δ' αἶνος οὗτος δυσχερέστερος λόγων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:485.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:485.1.text#τῶν τῆσδε καὶ σοὶ μᾶλλον ἀλγίων κλύειν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:486.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:486.1.text#τοῦτ' ἔσθ' ὃ θνητῶν εὖ πόλεις οἰκουμένας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:487.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:487.1.text#δόμους τ' ἀπόλλυσ', οἱ καλοὶ λίαν λόγοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:488.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:488.1.text#οὐ γὰρ τὰ τοῖσιν ὠσὶ τερπνὰ χρὴ λέγειν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:489.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:489.1.text#ἀλλ' ἐξ ὅτου τις εὐκλεὴς γενήσεται.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:490.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:490.1.text#τί σεμνομυθεῖς; οὐ λόγων εὐσχημόνων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:491.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:491.1.text#δεῖ σ', ἀλλὰ  τἀνδρός. — ὡς τάχος διοιστέον,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:492.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:492.1.text#τὸν εὐθὺν ἐξειπόντας ἀμφὶ σοῦ λόγον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:493.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:493.1.text#εἰ μὲν γὰρ ἦν σοι μὴ 'πὶ συμφοραῖς βίος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:494.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:494.1.text#τοιαῖσδε, σώφρων δ' οὖσ' ἐτύγχανες γυνή,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:495.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:495.1.text#οὐκ ἄν ποτ' εὐνῆς οὕνεχ' ἡδονῆς τε σῆς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:496.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:496.1.text#προσῆγον ἄν σε δεῦρο· νῦν δ' ἀγὼν μέγας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:497.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:497.1.text#σῶσαι βίον σόν, κοὐκ ἐπίφθονον τόδε.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:498.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:498.1.text#ὦ δεινὰ λέξασ', οὐχὶ συγκλῄσεις στόμα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:499.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:499.1.text#καὶ μὴ μεθήσεις αὖθις αἰσχίστους λόγους;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:500.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:500.1.text#αἴσχρ', ἀλλ' ἀμείνω τῶν καλῶν τάδ' ἐστί σοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:501.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:501.1.text#κρεῖσσον δὲ τοὔργον, εἴπερ ἐκσώσει γέ σε,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:502.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:502.1.text#ἢ τοὔνομ', ᾧ σὺ κατθανῇ γαυρουμένη.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:503.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:503.1.text#καὶ μή σε πρὸς θεῶν — εὖ λέγεις γάρ, αἰσχρὰ δέ —
urn:cts:greekLit:tlg0006.tlg005.fu.sp:504.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:504.1.text#πέρα προβῇς τῶνδ'· ὡς ὑπείργασμαι μὲν εὖ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:505.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:505.1.text#ψυχὴν ἔρωτι, τᾀσχρὰ δ' ἢν λέγῃς καλῶς,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:506.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:506.1.text#ἐς τοῦθ' ὃ φεύγω νῦν ἀναλωθήσομαι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:507.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:507.1.text#εἴ τοι δοκεῖ σοι, χρῆν μὲν οὔ σ' ἁμαρτάνειν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:508.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:508.1.text#εἰ δ' οὖν, πιθοῦ μοι· δευτέρα γὰρ ἡ χάρις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:509.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:509.1.text#ἔστιν κατ' οἴκους φίλτρα μοι θελκτήρια
urn:cts:greekLit:tlg0006.tlg005.fu.sp:510.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:510.1.text#ἔρωτος, ἦλθε δ' ἄρτι μοι γνώμης ἔσω,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:511.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:511.1.text#ἅ σ' οὔτ' ἐπ' αἰσχροῖς οὔτ' ἐπὶ βλάβῃ φρενῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:512.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:512.1.text#παύσει νόσου τῆσδ', ἢν σὺ μὴ γένῃ κακή.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:513.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:513.1.text#δεῖ δ' ἐξ ἐκείνου δή τι τοῦ ποθουμένου
urn:cts:greekLit:tlg0006.tlg005.fu.sp:514.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:514.1.text#σημεῖον, ἢ λόγον τιν' ἢ πέπλων ἄπο
urn:cts:greekLit:tlg0006.tlg005.fu.sp:515.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:515.1.text#λαβεῖν, συνάψαι τ' ἐκ δυοῖν μίαν χάριν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:516.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:516.1.text#πότερα δὲ χριστὸν ἢ ποτὸν τὸ φάρμακον;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:517.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:517.1.text#οὐκ οἶδ'· ὀνάσθαι, μὴ μαθεῖν βούλου, τέκνον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:518.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:518.1.text#δέδοιχ' ὅπως μοι μὴ λίαν φανῇς σοφή.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:519.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:519.1.text#πάντ' ἂν φοβηθεῖσ' ἴσθι· δειμαίνεις δὲ τί;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:520.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:520.1.text#μή μοί τι Θησέως τῶνδε μηνύσῃς τόκῳ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:521.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:521.1.text#ἔασον, ὦ παῖ· ταῦτ' ἐγὼ θήσω καλῶς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:522.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:522.1.text#μόνον σύ μοι, δέσποινα ποντία Κύπρι,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:523.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:523.1.text#συνεργὸς εἴης. τἄλλα δ' οἷ' ἐγὼ φρονῶ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:524.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:524.1.text#τοῖς ἔνδον ἡμῖν ἀρκέσει λέξαι φίλοις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:525.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:525.1.text#Ἔρως Ἔρως, ὃ κατ' ὀμμάτων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:526.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:526.1.text#στάζεις πόθον, εἰσάγων γλυκεῖαν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:527.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:527.1.text#ψυχᾷ χάριν οὓς ἐπιστρατεύσῃ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:528.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:528.1.text#μή μοί ποτε σὺν κακῷ φανείης
urn:cts:greekLit:tlg0006.tlg005.fu.sp:529.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:529.1.text#μηδ' ἄρρυθμος ἔλθοις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:530.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:530.1.text#οὔτε γὰρ πυρὸς οὔτ' ἄστρων ὑπέρτερον βέλος,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:531.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:531.1.text#οἷον τὸ τᾶς Ἀφροδίτας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:532.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:532.1.text#ἵησιν ἐκ χερῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:533.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:533.1.text#Ἔρως, ὁ Διὸς παῖς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:535.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:535.1.text#ἄλλως ἄλλως παρά τ' Ἀλφεῷ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:536.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:536.1.text#Φοίβου τ' ἐπὶ Πυθίοις τεράμνοις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:537.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:537.1.text#βούταν φόνον Ἑλλὰς { αἶ' } ἀέξει·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:538.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:538.1.text#Ἔρωτα δέ, τὸν τύραννον ἀνδρῶν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:539.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:539.1.text#τὸν τᾶς Ἀφροδίτας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:540.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:540.1.text#φιλτάτων θαλάμων κλῃδοῦχον, οὐ σεβίζομεν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:541.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:541.1.text#πέρθοντα καὶ διὰ πάσας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:542.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:542.1.text#ἰόντα συμφορᾶς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:543.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:543.1.text#θνατοῖς, ὅταν ἔλθῃ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:545.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:545.1.text#τὰν μὲν Οἰχαλίᾳ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:546.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:546.1.text#πῶλον ἄζυγα λέκτρων, ἄνανδρον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:547.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:547.1.text#τὸ πρὶν καὶ ἄνυμφον, οἴκων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:548.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:548.1.text#ζεύξασ' ἀπ' Εὐρυτίων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:549.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:549.1.text#δρομάδα Ναΐδ' ὅπως τε Βάκχαν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:550.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:550.1.text#σὺν αἵματι, σὺν καπνῷ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:551.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:551.1.text#φονίοις θ' { ὑμεναίοις }
urn:cts:greekLit:tlg0006.tlg005.fu.sp:552.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:552.1.text#Ἀλκμήνας τόκῳ Κύπρις ἐξέδωκεν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:553.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:553.1.text#ὦ τλάμων ὑμεναίων.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:555.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:555.1.text#ὦ Θήβας ἱερὸν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:556.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:556.1.text#τεῖχος, ὦ στόμα Δίρκας, συνείποιτ'
urn:cts:greekLit:tlg0006.tlg005.fu.sp:557.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:557.1.text#ἂν ἁ Κύπρις οἷον ἕρπει.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:558.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:558.1.text#βροντᾷ γὰρ ἀμφιπύρῳ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:559.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:559.1.text#τοκάδα τὰν διγόνοιο Βάκχου
urn:cts:greekLit:tlg0006.tlg005.fu.sp:560.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:560.1.text#νυμφευσαμένα πότμῳ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:561.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:561.1.text#φονίῳ κατηύνασεν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:562.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:562.1.text#δεινὰ γὰρ παντᾷ ποτιπνεῖ, μέλισσα δ'
urn:cts:greekLit:tlg0006.tlg005.fu.sp:563.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:563.1.text#οἵα τις πεπόταται.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:565.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:565.1.text#σιγήσατ', ὦ γυναῖκες· ἐξειργάσμεθα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:566.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:566.1.text#τί δ' ἔστι, Φαίδρα, δεινὸν ἐν δόμοισί σοι;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:567.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:567.1.text#ἐπίσχετ', αὐδὴν τῶν ἔσωθεν ἐκμάθω.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:568.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:568.1.text#σιγῶ· τὸ μέντοι φροίμιον κακὸν τόδε.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:569.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:569.1.text#ἰώ μοι, αἰαῖ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:570.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:570.1.text#ὦ δυστάλαινα τῶν ἐμῶν παθημάτων.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:571.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:571.1.text#τίνα θροεῖς αὐδάν; τίνα βοᾷς λόγον;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:572.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:572.1.text#ἔνεπε, τίς φοβεῖ σε φήμα, γύναι,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:573.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:573.1.text#φρένας ἐπίσσυτος;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:575.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:575.1.text#ἀπωλόμεσθα. ταῖσδ' ἐπιστᾶσαι πύλαις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:576.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:576.1.text#ἀκούσαθ' οἷος κέλαδος ἐν δόμοις πίτνει.[ … ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:577.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:577.1.text#σὺ παρὰ κλῇθρα, σοὶ μέλει πομπίμα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:578.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:578.1.text#φάτις δωμάτων.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:579.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:579.1.text#ἔνεπε δ' ἔνεπέ μοι, τί ποτ' ἔβα κακόν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:581.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:581.1.text#ὁ τῆς φιλίππου παῖς Ἀμαζόνος βοᾷ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:582.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:582.1.text#Ἱππόλυτος, αὐδῶν δεινὰ πρόσπολον κακά.[ … ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:585.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:585.1.text#ἀχὰν μὲν κλύω, σαφὲς δ' οὐκ ἔχω·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:586.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:586.1.text#γεγωνεῖ δ' ὅπᾳ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:587.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:587.1.text#διὰ πύλας ἔμολεν ἔμολε σοὶ βοά.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:589.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:589.1.text#καὶ μὴν σαφῶς γε τὴν κακῶν προμνήστριαν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:590.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:590.1.text#τὴν δεσπότου προδοῦσαν ἐξαυδᾷ λέχος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:591.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:591.1.text#ὤμοι ἐγὼ κακῶν· προδέδοσαι, φίλα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:592.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:592.1.text#τί σοι μήσομαι;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:593.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:593.1.text#τὰ κρυπτὰ γὰρ πέφηνε, διὰ δ' ὄλλυσαι —
urn:cts:greekLit:tlg0006.tlg005.fu.sp:594.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:594.1.text#αἰαῖ, ἒ ἔ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:595.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:595.1.text#πρόδοτος ἐκ φίλων.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:596.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:596.1.text#ἀπώλεσέν μ' εἰποῦσα συμφορὰς ἐμάς,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:597.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:597.1.text#φίλως, καλῶς δ' οὐ τήνδ' ἰωμένη νόσον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:598.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:598.1.text#πῶς οὖν; τί δράσεις, ὦ παθοῦσ' ἀμήχανα;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:599.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:599.1.text#οὐκ οἶδα πλὴν ἕν· κατθανεῖν ὅσον τάχος,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:600.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:600.1.text#τῶν νῦν παρόντων πημάτων ἄκος μόνον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:601.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:601.1.text#ὦ γαῖα μῆτερ ἡλίου τ' ἀναπτυχαί,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:602.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:602.1.text#οἵων λόγων ἄρρητον εἰσήκουσ' ὄπα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:603.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:603.1.text#σίγησον, ὦ παῖ, πρίν τιν' αἰσθέσθαι βοῆς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:604.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:604.1.text#οὐκ ἔστ' ἀκούσας δείν' ὅπως σιγήσομαι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:605.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:605.1.text#ναὶ πρός σε τῆς σῆς δεξιᾶς εὐωλένου.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:606.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:606.1.text#οὐ μὴ προσοίσεις χεῖρα μηδ' ἅψῃ πέπλων.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:607.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:607.1.text#ὦ πρός σε γονάτων, μηδαμῶς μ' ἐξεργάσῃ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:608.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:608.1.text#τί δ', εἴπερ, ὡς φῄς, μηδὲν εἴρηκας κακόν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:609.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:609.1.text#ὁ μῦθος, ὦ παῖ, κοινὸς οὐδαμῶς ὅδε.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:610.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:610.1.text#τά τοι κάλ' ἐν πολλοῖσι κάλλιον λέγειν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:611.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:611.1.text#ὦ τέκνον, ὅρκους μηδαμῶς ἀτιμάσῃς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:612.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:612.1.text#ἡ γλῶσσ' ὀμώμοχ', ἡ δὲ φρὴν ἀνώμοτος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:613.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:613.1.text#ὦ παῖ, τί δράσεις; σοὺς φίλους διεργάσῃ;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:614.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:614.1.text#ἀπέπτυσ'· οὐδεὶς ἄδικός ἐστί μοι φίλος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:615.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:615.1.text#σύγγνωθ'· ἁμαρτεῖν εἰκὸς ἀνθρώπους, τέκνον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:616.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:616.1.text#ὦ Ζεῦ, τί δὴ κίβδηλον ἀνθρώποις κακὸν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:617.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:617.1.text#γυναῖκας ἐς φῶς ἡλίου κατῴκισας;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:618.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:618.1.text#εἰ γὰρ βρότειον ἤθελες σπεῖραι γένος,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:619.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:619.1.text#οὐκ ἐκ γυναικῶν χρῆν παρασχέσθαι τόδε,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:620.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:620.1.text#ἀλλ' ἀντιθέντας σοῖσιν ἐν ναοῖς βροτοὺς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:621.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:621.1.text#ἢ χρυσὸν ἢ σίδηρον ἢ χαλκοῦ βάρος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:622.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:622.1.text#παίδων πρίασθαι σπέρμα, τοῦ τιμήματος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:623.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:623.1.text#τῆς ἀξίας ἕκαστον, ἐν δὲ δώμασιν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:624.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:624.1.text#ναίειν ἐλευθέροισι θηλειῶν ἄτερ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:625.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:625.1.text#[ νῦν δ' ἐς δόμους μὲν πρῶτον ἄξεσθαι κακὸν ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:626.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:626.1.text#[ μέλλοντες ὄλβον δωμάτων ἐκπίνομεν. ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:627.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:627.1.text#τούτῳ δὲ δῆλον ὡς γυνὴ κακὸν μέγα·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:628.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:628.1.text#προσθεὶς γὰρ ὁ σπείρας τε καὶ θρέψας πατὴρ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:629.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:629.1.text#φερνὰς ἀπῴκισ', ὡς ἀπαλλαχθῇ κακοῦ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:630.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:630.1.text#ὁ δ' αὖ λαβὼν ἀτηρὸν ἐς δόμους φυτὸν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:631.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:631.1.text#γέγηθε κόσμον προστιθεὶς ἀγάλματι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:632.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:632.1.text#καλὸν κακίστῳ καὶ πέπλοισιν ἐκπονεῖ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:633.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:633.1.text#δύστηνος, ὄλβον δωμάτων ὑπεξελών.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:634.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:634.1.text#[ ἔχει δ' ἀνάγκην, ὥστε κηδεύσας καλοῖς ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:635.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:635.1.text#[ γαμβροῖσι χαίρων σῴζεται πικρὸν λέχος, ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:636.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:636.1.text#[ ἢ χρηστὰ λέκτρα, πενθεροὺς δ' ἀνωφελεῖς ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:637.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:637.1.text#[ λαβὼν πιέζει τἀγαθῷ τὸ δυστυχές. ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:638.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:638.1.text#ῥᾷστον δ' ὅτῳ τὸ μηδέν, ἀλλ' ἀνωφελὴς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:639.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:639.1.text#εὐηθίᾳ κατ' οἶκον ἵδρυται γυνή.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:640.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:640.1.text#σοφὴν δὲ μισῶ· μὴ γὰρ ἔν γ' ἐμοῖς δόμοις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:641.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:641.1.text#εἴη φρονοῦσα πλείον' ἢ γυναῖκα χρή.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:642.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:642.1.text#τὸ γὰρ κακοῦργον μᾶλλον ἐντίκτει Κύπρις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:643.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:643.1.text#ἐν ταῖς σοφαῖσιν· ἡ δ' ἀμήχανος γυνὴ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:644.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:644.1.text#γνώμῃ βραχείᾳ μωρίαν ἀφῃρέθη.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:645.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:645.1.text#χρῆν δ' ἐς γυναῖκα πρόσπολον μὲν οὐ περᾶν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:646.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:646.1.text#ἄφθογγα δ' αὐταῖς συγκατοικίζειν δάκη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:647.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:647.1.text#θηρῶν, ἵν' εἶχον μήτε προσφωνεῖν τινα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:648.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:648.1.text#μήτ' ἐξ ἐκείνων φθέγμα δέξασθαι πάλιν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:649.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:649.1.text#νῦν δ' αἳ μὲν ἔνδον { δρῶσιν αἱ κακαὶ } κακὰ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:650.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:650.1.text#βουλεύματ', ἔξω δ' ἐκφέρουσι πρόσπολοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:651.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:651.1.text#ὡς καὶ σύ γ' ἡμῖν πατρός, ὦ κακὸν κάρα,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:652.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:652.1.text#λέκτρων ἀθίκτων ἦλθες ἐς συναλλαγάς·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:653.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:653.1.text#ἁγὼ ῥυτοῖς νασμοῖσιν ἐξομόρξομαι,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:654.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:654.1.text#ἐς ὦτα κλύζων. πῶς ἂν οὖν εἴην κακός,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:655.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:655.1.text#ὃς οὐδ' ἀκούσας τοιάδ' ἁγνεύειν δοκῶ;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:656.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:656.1.text#εὖ δ' ἴσθι, τοὐμόν σ' εὐσεβὲς σῴζει, γύναι·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:657.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:657.1.text#εἰ μὴ γὰρ ὅρκοις θεῶν ἄφαρκτος ᾑρέθην,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:658.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:658.1.text#οὐκ ἄν ποτ' ἔσχον μὴ οὐ τάδ' ἐξειπεῖν πατρί.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:659.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:659.1.text#νῦν δ' ἐκ δόμων μέν, ἔστ' ἂν ἔκδημος χθονὸς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:660.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:660.1.text#Θησεύς, ἄπειμι· σῖγα δ' ἕξομεν στόμα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:661.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:661.1.text#θεάσομαι δὲ σὺν πατρὸς μολὼν ποδὶ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:662.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:662.1.text#πῶς νιν προσόψῃ καὶ σὺ καὶ δέσποινα σή·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:663.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:663.1.text#τῆς σῆς δὲ τόλμης εἴσομαι γεγευμένος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:664.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:664.1.text#ὄλοισθε. μισῶν δ' οὔποτ' ἐμπλησθήσομαι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:665.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:665.1.text#γυναῖκας, οὐδ' εἴ φησί τίς μ' ἀεὶ λέγειν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:666.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:666.1.text#ἀεὶ γὰρ οὖν πώς εἰσι κἀκεῖναι κακαί.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:667.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:667.1.text#ἤ νύν τις αὐτὰς σωφρονεῖν διδαξάτω,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:668.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:668.1.text#ἢ κἄμ' ἐάτω ταῖσδ' ἐπεμβαίνειν ἀεί.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:669.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:669.1.text#τάλανες ὦ κακοτυχεῖς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:669.2.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:669.2.text#γυναικῶν πότμοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:670.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:670.1.text#τίνα νῦν ἢ τέχναν ἔχομεν ἢ { τίνας }
urn:cts:greekLit:tlg0006.tlg005.fu.sp:671.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:671.1.text#σφαλεῖσαι κάθαμμα λύειν λόγους;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:672.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:672.1.text#ἐτύχομεν δίκας· ἰὼ γᾶ καὶ φῶς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:673.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:673.1.text#πᾷ ποτ' ἐξαλύξω τύχας;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:674.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:674.1.text#πῶς δὲ πῆμα κρύψω, φίλαι;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:675.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:675.1.text#τίς ἂν θεῶν ἀρωγὸς ἢ τίς ἂν βροτῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:676.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:676.1.text#πάρεδρος ἢ ξυνεργὸς ἀδίκων ἔργων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:677.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:677.1.text#φανείη; τὸ γὰρ παρ' ἡμῖν πάθος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:678.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:678.1.text#πέραν δυσεκπέρατον ἔρχεται βίου.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:679.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:679.1.text#κακοτυχεστάτα γυναικῶν ἐγώ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:680.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:680.1.text#φεῦ φεῦ· πέπρακται, κοὐ κατώρθωνται τέχναι,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:681.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:681.1.text#δέσποινα, τῆς σῆς προσπόλου, κακῶς δ' ἔχει.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:682.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:682.1.text#ὦ παγκακίστη καὶ φίλων διαφθορεῦ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:683.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:683.1.text#οἷ' εἰργάσω με. Ζεύς σε γεννήτωρ ἐμὸς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:684.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:684.1.text#πρόρριζον ἐκτρίψειεν οὐτάσας πυρί.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:685.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:685.1.text#οὐκ εἶπον — οὐ σῆς προυνοησάμην φρενός; —
urn:cts:greekLit:tlg0006.tlg005.fu.sp:686.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:686.1.text#σιγᾶν ἐφ' οἷσι νῦν ἐγὼ κακύνομαι;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:687.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:687.1.text#σὺ δ' οὐκ ἀνέσχου· τοιγὰρ οὐκέτ' εὐκλεεῖς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:688.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:688.1.text#θανούμεθ'. ἀλλὰ δεῖ με δὴ καινῶν λόγων.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:689.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:689.1.text#οὗτος γὰρ ὀργῇ συντεθηγμένος φρένας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:690.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:690.1.text#ἐρεῖ καθ' ἡμῶν πατρὶ σὰς ἁμαρτίας,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:691.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:691.1.text#ἐρεῖ δὲ Πιτθεῖ τῷ γέροντι συμφοράς,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:692.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:692.1.text#πλήσει τε πᾶσαν γαῖαν αἰσχίστων λόγων.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:693.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:693.1.text#ὄλοιο καὶ σὺ χὥστις ἄκοντας φίλους
urn:cts:greekLit:tlg0006.tlg005.fu.sp:694.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:694.1.text#πρόθυμός ἐστι μὴ καλῶς εὐεργετεῖν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:695.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:695.1.text#δέσποιν', ἔχεις μὲν τἀμὰ μέμψασθαι κακά·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:696.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:696.1.text#τὸ γὰρ δάκνον σου τὴν διάγνωσιν κρατεῖ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:697.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:697.1.text#ἔχω δὲ κἀγὼ πρὸς τάδ', εἰ δέξῃ, λέγειν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:698.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:698.1.text#ἔθρεψά σ' εὔνους τ' εἰμί· τῆς νόσου δέ σοι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:699.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:699.1.text#ζητοῦσα φάρμαχ' ηὗρον οὐχ ἁβουλόμην.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:700.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:700.1.text#εἰ δ' εὖ γ' ἔπραξα, κάρτ' ἂν ἐν σοφοῖσιν ἦ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:701.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:701.1.text#πρὸς τὰς τύχας γὰρ τὰς φρένας κεκτήμεθα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:702.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:702.1.text#ἦ γὰρ δίκαια ταῦτα κἀξαρκοῦντά μοι,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:703.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:703.1.text#τρώσασαν ἡμᾶς εἶτα συγχωρεῖν λόγοις;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:704.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:704.1.text#μακρηγοροῦμεν· οὐκ ἐσωφρόνουν ἐγώ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:705.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:705.1.text#ἀλλ' ἔστι κἀκ τῶνδ' ὥστε σωθῆναι, τέκνον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:706.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:706.1.text#παῦσαι λέγουσα· καὶ τὰ πρὶν γὰρ οὐ καλῶς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:707.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:707.1.text#παρῄνεσάς μοι κἀπεχείρησας κακά.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:708.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:708.1.text#ἀλλ' ἐκποδὼν ἄπελθε καὶ σαυτῆς πέρι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:709.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:709.1.text#φρόντιζ'· ἐγὼ γὰρ τἀμὰ θήσομαι καλῶς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:710.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:710.1.text#ὑμεῖς δέ, παῖδες εὐγενεῖς Τροζήνιαι,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:711.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:711.1.text#τοσόνδε μοι παράσχετ' ἐξαιτουμένῃ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:712.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:712.1.text#σιγῇ καλύπτειν ἁνθάδ' εἰσηκούσατε.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:713.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:713.1.text#ὄμνυμι σεμνὴν Ἄρτεμιν, Διὸς κόρην,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:714.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:714.1.text#μηδὲν κακῶν σῶν ἐς φάος δείξειν ποτέ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:715.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:715.1.text#καλῶς ἔλεξας· ἓν δὲ { προτρέπουσ' } ἐγὼ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:716.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:716.1.text#εὕρημα δῆτα τῆσδε συμφορᾶς ἔχω,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:717.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:717.1.text#ὥστ' εὐκλεᾶ μὲν παισὶ προσθεῖναι βίον,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:718.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:718.1.text#αὐτή τ' ὀνάσθαι πρὸς τὰ νῦν πεπτωκότα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:719.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:719.1.text#οὐ γάρ ποτ' αἰσχυνῶ γε Κρησίους δόμους,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:720.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:720.1.text#οὐδ' ἐς πρόσωπον Θησέως ἀφίξομαι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:721.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:721.1.text#αἰσχροῖς ἐπ' ἔργοις οὕνεκα ψυχῆς μιᾶς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:722.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:722.1.text#μέλλεις δὲ δὴ τί δρᾶν ἀνήκεστον κακόν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:723.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:723.1.text#θανεῖν· ὅπως δέ, τοῦτ' ἐγὼ βουλεύσομαι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:724.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:724.1.text#εὔφημος ἴσθι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:724.2.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:724.2.text#καὶ σύ γ' εὖ με νουθέτει.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:725.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:725.1.text#ἐγὼ δὲ Κύπριν, ἥπερ ἐξόλλυσί με,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:726.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:726.1.text#ψυχῆς ἀπαλλαχθεῖσα τῇδ' ἐν ἡμέρᾳ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:727.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:727.1.text#τέρψω· πικροῦ δ' ἔρωτος ἡσσηθήσομαι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:728.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:728.1.text#ἀτὰρ κακόν γε χἁτέρῳ γενήσομαι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:729.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:729.1.text#θανοῦσ', ἵν' εἰδῇ μὴ 'πὶ τοῖς ἐμοῖς κακοῖς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:730.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:730.1.text#ὑψηλὸς εἶναι· τῆς νόσου δὲ τῆσδέ μοι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:731.1.speaker#Φαίδρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:731.1.text#κοινῇ μετασχὼν σωφρονεῖν μαθήσεται.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:732.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:732.1.text#Ἠλιβάτοις ὑπὸ κευθμῶσι γενοίμαν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:733.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:733.1.text#ἵνα με πτεροῦσσαν ὄρνιν ἀγέλῃσι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:734.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:734.1.text#ποταναῖς θεὸς ἐνθείη·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:735.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:735.1.text#ἀρθείην δ' ἐπὶ πόντιον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:736.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:736.1.text#κῦμα τᾶς Ἀδριηνᾶς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:737.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:737.1.text#ἀκτᾶς Ἠριδανοῦ θ' ὕδωρ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:738.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:738.1.text#ἔνθα πορφύρεον σταλάσσουσιν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:738.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:738.2.text#ἐς οἶδμα πατρὸς τάλαιναι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:739.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:739.1.text#κόραι Φαέθοντος οἴκτῳ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:740.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:740.1.text#δακρύων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:741.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:741.1.text#τὰς ἠλεκτροφαεῖς αὐγάς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:742.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:742.1.text#Ἑσπερίδων δ' ἐπὶ μηλόσπορον ἀκτὰν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:743.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:743.1.text#ἀνύσαιμι τᾶν ἀοιδῶν, ἵν' ὁ ποντομέδων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:744.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:744.1.text#πορφυρέας λίμνας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:745.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:745.1.text#ναύταις οὐκέθ' ὁδὸν νέμει,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:746.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:746.1.text#σεμνὸν τέρμονα κυρῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:747.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:747.1.text#οὐρανοῦ, τὸν Ἄτλας ἔχει·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:748.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:748.1.text#κρῆναί τ' ἀμβρόσιαι χέονται
urn:cts:greekLit:tlg0006.tlg005.fu.sp:749.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:749.1.text#Ζηνὸς μελάθρων παρὰ κοίταις,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:750.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:750.1.text#ἵν' ἁ βιόδωρος αὔξει
urn:cts:greekLit:tlg0006.tlg005.fu.sp:750.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:750.2.text#ζαθέα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:751.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:751.1.text#χθὼν εὐδαιμονίαν θεοῖς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:752.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:752.1.text#ὦ λευκόπτερε Κρησία
urn:cts:greekLit:tlg0006.tlg005.fu.sp:753.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:753.1.text#πορθμίς, ἃ διὰ πόντιον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:754.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:754.1.text#κῦμ' ἁλίκτυπον ἅλμας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:755.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:755.1.text#ἐπόρευσας ἐμὰν ἄνασσαν ὀλβίων ἀπ' οἴκων,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:756.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:756.1.text#κακονυμφοτάταν ὄνασιν. ἦ γὰρ ἀπ' ἀμφοτέρων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:757.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:757.1.text#ἁ Κρησίας ἐκ γᾶς δύσορνις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:758.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:758.1.text#ἔπτατο κλεινὰς Ἀθήνας·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:759.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:759.1.text#Μουνίχου δ' ἀκταῖσιν ἐκδήσαντο
urn:cts:greekLit:tlg0006.tlg005.fu.sp:760.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:760.1.text#πλεκτὰς πεισμάτων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:761.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:761.1.text#ἀρχάς, ἐπ' ἀπείρου
urn:cts:greekLit:tlg0006.tlg005.fu.sp:762.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:762.1.text#τε γᾶς ἔβασαν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:764.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:764.1.text#ἀνθ' ὧν, οὐχ ὁσίων ἐρώτων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:765.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:765.1.text#δεινᾷ φρένας Ἀφροδίτας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:766.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:766.1.text#νόσῳ κατεκλάσθη·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:767.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:767.1.text#χαλεπᾷ δ' ὑπέραντλος οὖσα συμφορᾷ τεράμνων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:768.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:768.1.text#ἀπὸ νυμφιδίων κρεμαστὸν ἅψεται ἀμφὶ βρόχον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:769.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:769.1.text#λευκᾷ καθαρμόζουσα δείρᾳ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:770.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:770.1.text#δαίμονα στυγνὸν καταιδεσθεῖσα,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:771.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:771.1.text#τὰν δ' εὔδοξον ἀνθαιρουμένα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:772.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:772.1.text#φήμαν, ἀπαλλάσσουσά
urn:cts:greekLit:tlg0006.tlg005.fu.sp:773.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:773.1.text#τ' ἀλγεινὸν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:774.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:774.1.text#φρενῶν ἔρωτα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:776.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:776.1.text#ἰοὺ ἰού·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:776.2.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:776.2.text#βοηδρομεῖτε πάντες οἱ πέλας δόμων·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:777.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:777.1.text#ἐν ἀγχόναις δέσποινα, Θησέως δάμαρ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:778.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:778.1.text#— φεῦ φεῦ, πέπρακται· βασιλὶς οὐκέτ' ἔστι δὴ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:779.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:779.1.text#γυνή, κρεμαστοῖς ἐν βρόχοις ἠρτημένη.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:780.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:780.1.text#οὐ σπεύσετ'; οὐκ οἴσει τις ἀμφιδέξιον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:781.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:781.1.text#σίδηρον, ᾧ τόδ' ἅμμα λύσομεν δέρης;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:782.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:782.1.text#— φίλαι, τί δρῶμεν; ἢ δοκεῖ περᾶν δόμους
urn:cts:greekLit:tlg0006.tlg005.fu.sp:783.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:783.1.text#λῦσαί τ' ἄνασσαν ἐξ ἐπισπαστῶν βρόχων;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:784.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:784.1.text#— τί δ'; οὐ πάρεισι πρόσπολοι νεανίαι;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:785.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:785.1.text#τὸ πολλὰ πράσσειν οὐκ ἐν ἀσφαλεῖ βίου.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:786.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:786.1.text#ὀρθώσατ' ἐκτείνοντες ἄθλιον νέκυν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:787.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:787.1.text#πικρὸν τόδ' οἰκούρημα δεσπόταις ἐμοῖς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:788.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:788.1.text#— ὄλωλεν ἡ δύστηνος, ὡς κλύω, γυνή·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:789.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:789.1.text#ἤδη γὰρ ὡς νεκρόν νιν ἐκτείνουσι δή.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:790.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:790.1.text#γυναῖκες, ἴστε τίς ποτ' ἐν δόμοις βοή;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:791.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:791.1.text#ἠχὼ βαρεῖα προσπόλων ἀφίκετο.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:792.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:792.1.text#οὐ γάρ τί μ' ὡς θεωρὸν ἀξιοῖ δόμος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:793.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:793.1.text#πύλας ἀνοίξας εὐφρόνως προσεννέπειν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:794.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:794.1.text#μῶν Πιτθέως τι γῆρας εἴργασται νέον;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:795.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:795.1.text#πρόσω μὲν ἤδη βίοτος, ἀλλ' ὅμως ἔτ' ἂν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:796.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:796.1.text#λυπηρὸς ἡμῖν τούσδ' ἂν ἐκλίποι δόμους.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:797.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:797.1.text#οὐκ ἐς γέροντας ἥδε σοι τείνει τύχη,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:798.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:798.1.text#Θησεῦ· νέοι θανόντες ἀλγυνοῦσί σε.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:799.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:799.1.text#οἴμοι· τέκνων μοι μή τι συλᾶται βίος;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:800.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:800.1.text#ζῶσιν, θανούσης μητρὸς ὡς ἄλγιστά σοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:801.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:801.1.text#τί φῄς; ὄλωλεν ἄλοχος; ἐκ τίνος τύχης;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:802.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:802.1.text#βρόχον κρεμαστὸν ἀγχόνης ἀνήψατο.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:803.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:803.1.text#λύπῃ παχνωθεῖσ', ἢ ἀπὸ συμφορᾶς τινος;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:804.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:804.1.text#τοσοῦτον ἴσμεν· ἄρτι γὰρ κἀγὼ δόμοις,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:805.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:805.1.text#Θησεῦ, πάρειμι σῶν κακῶν πενθήτρια.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:806.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:806.1.text#αἰαῖ· τί δῆτα τοῖσδ' ἀνέστεμμαι κάρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:807.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:807.1.text#πλεκτοῖσι φύλλοις, δυστυχὴς θεωρὸς ὤν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:808.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:808.1.text#χαλᾶτε κλῇθρα, πρόσπολοι, πυλωμάτων,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:825.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:825.1.text#ἐκλύεθ' ἁρμούς, ὡς ἴδω πικρὰν θέαν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:810.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:810.1.text#γυναικός, ἥ με κατθανοῦσ' ἀπώλεσεν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:811.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:811.1.text#— ἰὼ ἰὼ τάλαινα μελέων κακῶν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:811.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:811.2.text#ἔπαθες, εἰργάσω
urn:cts:greekLit:tlg0006.tlg005.fu.sp:812.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:812.1.text#τοσοῦτον ὥστε τούσδε συγχέαι δόμους.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:813.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:813.1.text#— αἰαῖ τόλμας, ὦ βιαίως θανοῦσ'
urn:cts:greekLit:tlg0006.tlg005.fu.sp:814.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:814.1.text#ἀνοσίῳ τε συμφορᾷ, σᾶς χερὸς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:815.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:815.1.text#πάλαισμα μελέας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:816.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:816.1.text#— τίς ἄρα σάν, τάλαιν', ἀμαυροῖ ζόαν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:817.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:817.1.text#ὤμοι ἐγὼ πόνων· ἔπαθον, ὦ πόλις,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:818.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:818.1.text#τὰ μάκιστ' ἐμῶν κακῶν. ὦ τύχα,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:819.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:819.1.text#ὥς μοι βαρεῖα καὶ δόμοις ἐπεστάθης,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:820.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:820.1.text#κηλὶς ἄφραστος ἐξ ἀλαστόρων τινός.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:821.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:821.1.text#κατακονὰ μὲν οὖν ἀβίοτος βίου·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:822.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:822.1.text#κακῶν δ', ὢ τάλας, πέλαγος εἰσορῶ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:823.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:823.1.text#τοσοῦτον ὥστε μήποτ' ἐκνεῦσαι πάλιν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:824.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:824.1.text#μηδ' ἐκπερᾶσαι κῦμα τῆσδε συμφορᾶς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:826.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:826.1.text#τίνα λόγον τάλας, τίνα τύχαν σέθεν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:827.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:827.1.text#βαρύποτμον, γύναι, προσαυδῶν τύχω;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:828.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:828.1.text#ὄρνις γὰρ ὥς τις ἐκ χερῶν ἄφαντος εἶ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:829.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:829.1.text#πήδημ' ἐς Ἅιδου κραιπνὸν ὁρμήσασά μοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:830.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:830.1.text#αἰαῖ αἰαῖ, μέλεα μέλεα τάδε πάθη.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:831.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:831.1.text#πρόσωθεν δέ ποθεν ἀνακομίζομαι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:832.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:832.1.text#τύχαν δαιμόνων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:833.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:833.1.text#ἀμπλακίαισι τῶν πάροιθέν τινος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:834.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:834.1.text#οὐ σοὶ τάδ', ὦναξ, ἦλθε δὴ μόνῳ κακά,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:835.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:835.1.text#πολλῶν μετ' ἄλλων δ' ὤλεσας κεδνὸν λέχος.[ … ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:836.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:836.1.text#τὸ κατὰ γᾶς θέλω, τὸ κατὰ γᾶς κνέφας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:837.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:837.1.text#μετοικεῖν σκότῳ θανὼν ὁ τλάμων,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:838.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:838.1.text#τῆς σῆς στερηθεὶς φιλτάτης ὁμιλίας·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:839.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:839.1.text#ἀπώλεσας γὰρ μᾶλλον ἢ κατέφθισο.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:840.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:840.1.text#{ τίνος κλύω; πόθεν θανάσιμος τύχα, }
urn:cts:greekLit:tlg0006.tlg005.fu.sp:841.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:841.1.text#{ γύναι, σὰν ἔβα, τάλαινα, καρδίαν; }
urn:cts:greekLit:tlg0006.tlg005.fu.sp:842.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:842.1.text#εἴποι τις ἂν τὸ πραχθέν, ἢ μάτην ὄχλον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:843.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:843.1.text#στέγει τύραννον δῶμα προσπόλων ἐμῶν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:844.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:844.1.text#ὤμοι μοι σέθεν, [ … ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:845.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:845.1.text#μέλεος, οἷον εἶδον ἄλγος δόμων,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:846.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:846.1.text#οὐ τλητὸν οὐδὲ ῥητόν. ἀλλ' ἀπωλόμην·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:847.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:847.1.text#ἔρημος οἶκος, καὶ τέκν' ὀρφανεύεται.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:848.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:848.1.text#ἔλιπες { οὓς ἔτεκες, } ἔλιπες, ὦ φίλα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:849.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:849.1.text#γυναικῶν ἀρίστα θ' ὁπόσας ὁρᾷ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:850.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:850.1.text#φέγγος ἀελίου
urn:cts:greekLit:tlg0006.tlg005.fu.sp:851.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:851.1.text#τε καὶ νυκτὸς ἀστερωπὸν σέλας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:852.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:852.1.text#ἰὼ τάλας· ὦ τάλας· ὅσον κακὸν ἔχει δόμος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:853.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:853.1.text#δάκρυσί μου βλέφαρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:854.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:854.1.text#καταχυθέντα τέγγεται σᾷ τύχᾳ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:855.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:855.1.text#τὸ δ' ἐπὶ τῷδε πῆμα φρίσσω πάλαι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:856.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:856.1.text#ἔα ἔα·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:856.2.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:856.2.text#τί δή ποθ' ἥδε δέλτος ἐκ φίλης χερὸς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:857.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:857.1.text#ἠρτημένη; θέλει τι σημῆναι νέον;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:858.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:858.1.text#ἀλλ' ἦ λέχους μοι καὶ τέκνων ἐπιστολὰς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:859.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:859.1.text#ἔγραψεν ἡ δύστηνος, ἐξαιτουμένη;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:860.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:860.1.text#θάρσει, τάλαινα· λέκτρα γὰρ τὰ Θησέως
urn:cts:greekLit:tlg0006.tlg005.fu.sp:861.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:861.1.text#οὐκ ἔστι δῶμά θ' ἥτις εἴσεισιν γυνή.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:862.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:862.1.text#καὶ μὴν τύποι γε σφενδόνης χρυσηλάτου
urn:cts:greekLit:tlg0006.tlg005.fu.sp:863.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:863.1.text#τῆς οὐκέτ' οὔσης τῆσδε προσσαίνουσί με.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:864.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:864.1.text#φέρ', ἐξελίξας περιβολὰς σφραγισμάτων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:865.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:865.1.text#ἴδω τί λέξαι δέλτος ἥδε μοι θέλει.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:866.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:866.1.text#— φεῦ φεῦ· τόδ' αὖ νεοχμὸν ἐκδοχαῖς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:867.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:867.1.text#ἐπιφέρει θεὸς κακόν. ἐμοὶ μὲν οὖν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:868.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:868.1.text#ἀβίοτος βίου τύχα { πρὸς τὸ κρανθέν· εἴη τυχεῖν. }
urn:cts:greekLit:tlg0006.tlg005.fu.sp:869.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:869.1.text#— ὀλομένους γάρ, οὐκέτ' ὄντας λέγω,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:870.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:870.1.text#φεῦ φεῦ, τῶν ἐμῶν τυράννων δόμους.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:871.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:871.1.text#— ὦ δαῖμον, εἴ πως ἔστι, μὴ σφήλῃς δόμους,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:872.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:872.1.text#αἰτουμένης δὲ κλῦθί μου· πρὸς γάρ τινος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:873.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:873.1.text#οἰωνὸν ὥστε μάντις εἰσορῶ κακοῦ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:874.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:874.1.text#οἴμοι· τόδ' οἷον ἄλλο πρὸς κακῷ κακόν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:875.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:875.1.text#οὐ τλητὸν οὐδὲ λεκτόν. ὦ τάλας ἐγώ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:876.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:876.1.text#τί χρῆμα; λέξον, εἴ τί μοι λόγου μέτα.[ … ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:877.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:877.1.text#βοᾷ βοᾷ δέλτος ἄλαστα. πᾷ φύγω
urn:cts:greekLit:tlg0006.tlg005.fu.sp:878.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:878.1.text#βάρος κακῶν; ἀπὸ γὰρ ὀλόμενος οἴχομαι,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:879.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:879.1.text#οἷον οἷον εἶδον [ ἐν ] γραφαῖς μέλος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:880.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:880.1.text#φθεγγόμενον τλάμων.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:881.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:881.1.text#αἰαῖ, κακῶν ἀρχηγὸν ἐκφαίνεις λόγον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:882.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:882.1.text#τόδε μὲν οὐκέτι στόματος ἐν πύλαις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:883.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:883.1.text#καθέξω δυσεκπέρατον, ὀλοὸν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:884.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:884.1.text#κακόν· ἰὼ πόλις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:885.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:885.1.text#Ἱππόλυτος εὐνῆς τῆς ἐμῆς ἔτλη θιγεῖν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:886.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:886.1.text#βίᾳ, τὸ σεμνὸν Ζηνὸς ὄμμ' ἀτιμάσας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:887.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:887.1.text#ἀλλ', ὦ πάτερ Πόσειδον, ἃς ἐμοί ποτε
urn:cts:greekLit:tlg0006.tlg005.fu.sp:888.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:888.1.text#ἀρὰς ὑπέσχου τρεῖς, μιᾷ κατέργασαι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:889.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:889.1.text#τούτων ἐμὸν παῖδ', ἡμέραν δὲ μὴ φύγοι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:890.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:890.1.text#τήνδ', εἴπερ ἡμῖν ὤπασας σαφεῖς ἀράς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:891.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:891.1.text#ἄναξ, ἀπεύχου ταῦτα πρὸς θεῶν πάλιν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:892.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:892.1.text#γνώσῃ γὰρ αὖθις ἀμπλακών. ἐμοὶ πιθοῦ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:893.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:893.1.text#οὐκ ἔστι· καὶ πρός γ' ἐξελῶ σφε τῆσδε γῆς,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:894.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:894.1.text#δυοῖν δὲ μοίραιν θατέρᾳ πεπλήξεται·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:895.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:895.1.text#ἢ γὰρ Ποσειδῶν αὐτὸν εἰς Ἅιδου δόμους
urn:cts:greekLit:tlg0006.tlg005.fu.sp:896.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:896.1.text#θανόντα πέμψει τὰς ἐμὰς ἀρὰς σέβων,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:897.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:897.1.text#ἢ τῆσδε χώρας ἐκπεσὼν ἀλώμενος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:898.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:898.1.text#ξένην ἐπ' αἶαν λυπρὸν ἀντλήσει βίον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:899.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:899.1.text#καὶ μὴν ὅδ' αὐτὸς παῖς σὸς ἐς καιρὸν πάρα,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:900.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:900.1.text#Ἱππόλυτος· ὀργῆς δ' ἐξανεὶς κακῆς, ἄναξ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:901.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:901.1.text#Θησεῦ, τὸ λῷστον σοῖσι βούλευσαι δόμοις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:902.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:902.1.text#κραυγῆς ἀκούσας σῆς ἀφικόμην, πάτερ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:903.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:903.1.text#σπουδῇ· τὸ μέντοι πρᾶγμ' ἐφ' ᾧτινι στένεις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:904.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:904.1.text#οὐκ οἶδα, βουλοίμην δ' ἂν ἐκ σέθεν κλύειν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:905.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:905.1.text#ἔα, τί χρῆμα; σὴν δάμαρθ' ὁρῶ, πάτερ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:906.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:906.1.text#νεκρόν· μεγίστου θαύματος τόδ' ἄξιον·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:907.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:907.1.text#ἣν ἀρτίως ἔλειπον, ἣ φάος τόδε
urn:cts:greekLit:tlg0006.tlg005.fu.sp:908.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:908.1.text#οὔπω χρόνον παλαιὸν εἰσεδέρκετο.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:909.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:909.1.text#τί χρῆμα πάσχει; τῷ τρόπῳ διόλλυται;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:910.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:910.1.text#πάτερ, πυθέσθαι βούλομαι σέθεν πάρα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:911.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:911.1.text#σιγᾷς· σιωπῆς δ' οὐδὲν ἔργον ἐν κακοῖς·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:912.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:912.1.text#ἡ γὰρ ποθοῦσα πάντα καρδία κλύειν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:913.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:913.1.text#κἀν τοῖς κακοῖσι λίχνος οὖσ' ἁλίσκεται.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:914.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:914.1.text#οὐ μὴν φίλους γε κἄτι μᾶλλον ἢ φίλους
urn:cts:greekLit:tlg0006.tlg005.fu.sp:915.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:915.1.text#κρύπτειν δίκαιον σάς, πάτερ, δυσπραξίας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:916.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:916.1.text#ὦ πόλλ' ἁμαρτάνοντες ἄνθρωποι μάτην,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:917.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:917.1.text#τί δὴ τέχνας μὲν μυρίας διδάσκετε
urn:cts:greekLit:tlg0006.tlg005.fu.sp:918.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:918.1.text#καὶ πάντα μηχανᾶσθε κἀξευρίσκετε,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:919.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:919.1.text#ἓν δ' οὐκ ἐπίστασθ' οὐδ' ἐθηράσασθέ πω,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:920.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:920.1.text#φρονεῖν διδάσκειν οἷσιν οὐκ ἔνεστι νοῦς;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:921.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:921.1.text#δεινὸν σοφιστὴν εἶπας, ὅστις εὖ φρονεῖν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:922.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:922.1.text#τοὺς μὴ φρονοῦντας δυνατός ἐστ' ἀναγκάσαι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:923.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:923.1.text#ἀλλ' οὐ γὰρ ἐν δέοντι λεπτουργεῖς, πάτερ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:924.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:924.1.text#δέδοικα μή σου γλῶσσ' ὑπερβάλῃ κακοῖς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:925.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:925.1.text#φεῦ, χρῆν βροτοῖσι τῶν φίλων τεκμήριον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:926.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:926.1.text#σαφές τι κεῖσθαι καὶ διάγνωσιν φρενῶν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:927.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:927.1.text#ὅστις τ' ἀληθής ἐστιν ὅς τε μὴ φίλος,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:928.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:928.1.text#δισσάς τε φωνὰς πάντας ἀνθρώπους ἔχειν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:929.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:929.1.text#τὴν μὲν δικαίαν, τὴν δ' ὅπως ἐτύγχανεν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:930.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:930.1.text#ὡς ἡ φρονοῦσα τἄδικ' ἐξηλέγχετο
urn:cts:greekLit:tlg0006.tlg005.fu.sp:931.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:931.1.text#πρὸς τῆς δικαίας, κοὐκ ἂν ἠπατώμεθα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:932.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:932.1.text#ἀλλ' ἦ τις ἐς σὸν οὖς με διαβαλὼν ἔχει
urn:cts:greekLit:tlg0006.tlg005.fu.sp:933.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:933.1.text#φίλων, νοσοῦμεν δ' οὐδὲν ὄντες αἴτιοι;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:934.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:934.1.text#ἔκ τοι πέπληγμαι· σοὶ γὰρ ἐκπλήσσουσί με
urn:cts:greekLit:tlg0006.tlg005.fu.sp:935.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:935.1.text#λόγοι παραλλάσσοντες ἔξεδροι φρενῶν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:936.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:936.1.text#φεῦ τῆς βροτείας· ποῖ προβήσεται; φρενός.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:937.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:937.1.text#τί τέρμα τόλμης καὶ θράσους γενήσεται;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:938.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:938.1.text#εἰ γὰρ κατ' ἀνδρὸς βίοτον ἐξογκώσεται,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:939.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:939.1.text#ὁ δ' ὕστερος τοῦ πρόσθεν εἰς ὑπερβολὴν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:940.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:940.1.text#πανοῦργος ἔσται, θεοῖσι προσβαλεῖν χθονὶ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:941.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:941.1.text#ἄλλην δεήσει γαῖαν, ἣ χωρήσεται
urn:cts:greekLit:tlg0006.tlg005.fu.sp:942.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:942.1.text#τοὺς μὴ δικαίους καὶ κακοὺς πεφυκότας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:943.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:943.1.text#σκέψασθε δ' ἐς τόνδ', ὅστις ἐξ ἐμοῦ γεγὼς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:944.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:944.1.text#ᾔσχυνε τἀμὰ λέκτρα κἀξελέγχεται
urn:cts:greekLit:tlg0006.tlg005.fu.sp:945.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:945.1.text#πρὸς τῆς θανούσης ἐμφανῶς κάκιστος ὤν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:946.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:946.1.text#δεῖξον δ', ἐπειδή γ' ἐς μίασμ' ἐλήλυθας,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:947.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:947.1.text#τὸ σὸν πρόσωπον δεῦρ' ἐναντίον πατρί.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:948.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:948.1.text#σὺ δὴ θεοῖσιν ὡς περισσὸς ὢν ἀνὴρ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:949.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:949.1.text#ξύνει; σὺ σώφρων καὶ κακῶν ἀκήρατος;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:950.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:950.1.text#οὐκ ἂν πιθοίμην τοῖσι σοῖς κόμποις ἐγὼ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:951.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:951.1.text#θεοῖσι προσθεὶς ἀμαθίαν φρονεῖν κακῶς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:952.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:952.1.text#{ ἤδη νυν αὔχει καὶ δι' ἀψύχου βορᾶς }
urn:cts:greekLit:tlg0006.tlg005.fu.sp:953.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:953.1.text#{ σίτοις } καπήλευ', Ὀρφέα τ' ἄνακτ' ἔχων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:954.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:954.1.text#βάκχευε πολλῶν γραμμάτων τιμῶν καπνούς·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:955.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:955.1.text#ἐπεί γ' ἐλήφθης. τοὺς δὲ τοιούτους ἐγὼ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:956.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:956.1.text#φεύγειν προφωνῶ πᾶσι· θηρεύουσι γὰρ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:957.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:957.1.text#σεμνοῖς λόγοισιν, αἰσχρὰ μηχανώμενοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:958.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:958.1.text#τέθνηκεν ἥδε· τοῦτό σ' ἐκσώσειν δοκεῖς;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:959.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:959.1.text#ἐν τῷδ' ἁλίσκῃ πλεῖστον, ὦ κάκιστε σύ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:960.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:960.1.text#ποῖοι γὰρ ὅρκοι κρείσσονες, τίνες λόγοι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:961.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:961.1.text#τῆσδ' ἂν γένοιντ' ἄν, ὥστε σ' αἰτίαν φυγεῖν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:962.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:962.1.text#μισεῖν σε φήσεις τήνδε καὶ τὸ δὴ νόθον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:963.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:963.1.text#τοῖς γνησίοισι πολέμιον πεφυκέναι·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:964.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:964.1.text#κακὴν ἄρ' αὐτὴν ἔμπορον βίου λέγεις,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:965.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:965.1.text#εἰ δυσμενείᾳ σῇ τὰ φίλτατ' ὤλεσεν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:966.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:966.1.text#ἀλλ' ὡς τὸ μῶρον ἀνδράσιν μὲν οὐκ ἔνι,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:967.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:967.1.text#γυναιξὶ δ' ἐμπέφυκεν; οἶδ' ἐγὼ νέους,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:968.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:968.1.text#οὐδὲν γυναικῶν ὄντας ἀσφαλεστέρους,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:969.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:969.1.text#ὅταν ταράξῃ Κύπρις ἡβῶσαν φρένα·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:970.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:970.1.text#τὸ δ' ἄρσεν αὐτοὺς ὠφελεῖ προσκείμενον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:971.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:971.1.text#νῦν οὖν — τί ταῦτα σοῖς ἁμιλλῶμαι λόγοις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:972.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:972.1.text#νεκροῦ παρόντος μάρτυρος σαφεστάτου;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:973.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:973.1.text#ἔξερρε γαίας τῆσδ' ὅσον τάχος φυγάς,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:974.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:974.1.text#καὶ μήτ' Ἀθήνας τὰς θεοδμήτους μόλῃς,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:975.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:975.1.text#μήτ' εἰς ὅρους γῆς ἧς ἐμὸν κρατεῖ δόρυ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:976.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:976.1.text#εἰ γὰρ παθών γε σοῦ τάδ' ἡσσηθήσομαι,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:977.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:977.1.text#οὐ μαρτυρήσει μ'  Ἴσθμιος Σίνις ποτὲ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:978.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:978.1.text#κτανεῖν ἑαυτόν, ἀλλὰ κομπάζειν μάτην,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:979.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:979.1.text#οὐδ' αἱ θαλάσσῃ σύννομοι Σκιρωνίδες
urn:cts:greekLit:tlg0006.tlg005.fu.sp:980.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:980.1.text#φήσουσι πέτραι τοῖς κακοῖς μ' εἶναι βαρύν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:981.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:981.1.text#οὐκ οἶδ' ὅπως εἴποιμ' ἂν εὐτυχεῖν τινα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:982.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:982.1.text#θνητῶν· τὰ γὰρ δὴ πρῶτ' ἀνέστραπται πάλιν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:983.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:983.1.text#πάτερ, μένος μὲν ξύστασίς τε σῶν φρενῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:984.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:984.1.text#δεινή· τὸ μέντοι πρᾶγμ' ἔχον καλοὺς λόγους,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:985.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:985.1.text#εἴ τις διαπτύξειεν, οὐ καλὸν τόδε.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:986.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:986.1.text#ἐγὼ δ' ἄκομψος εἰς ὄχλον δοῦναι λόγον,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:987.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:987.1.text#ἐς ἥλικας δὲ κὠλίγους σοφώτερος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:988.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:988.1.text#ἔχει δὲ μοῖραν καὶ τόδ'· οἱ γὰρ ἐν σοφοῖς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:989.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:989.1.text#φαῦλοι παρ' ὄχλῳ μουσικώτεροι λέγειν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:990.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:990.1.text#ὅμως δ' ἀνάγκη, ξυμφορᾶς ἀφιγμένης,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:991.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:991.1.text#γλῶσσάν μ' ἀφεῖναι. πρῶτα δ' ἄρξομαι λέγειν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:992.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:992.1.text#ὅθεν μ' ὑπῆλθες πρῶτον ὡς διαφθερῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:993.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:993.1.text#κοὐκ ἀντιλέξοντ'. εἰσορᾷς φάος τόδε
urn:cts:greekLit:tlg0006.tlg005.fu.sp:994.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:994.1.text#καὶ γαῖαν· ἐν τοῖσδ' οὐκ ἔνεστ' ἀνὴρ ἐμοῦ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:995.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:995.1.text#οὐδ' ἢν σὺ μὴ φῇς, σωφρονέστερος γεγώς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:996.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:996.1.text#ἐπίσταμαι γὰρ πρῶτα μὲν θεοὺς σέβειν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:997.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:997.1.text#φίλοις τε χρῆσθαι μὴ ἀδικεῖν πειρωμένοις,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:998.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:998.1.text#ἀλλ' οἷσιν αἰδὼς μήτ' ἐπαγγέλλειν κακὰ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:999.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:999.1.text#μήτ' ἀνθυπουργεῖν αἰσχρὰ τοῖσι χρωμένοις·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1000.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1000.1.text#οὐκ ἐγγελαστὴς τῶν ὁμιλούντων, πάτερ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1001.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1001.1.text#ἀλλ' αὑτὸς οὐ παροῦσι κἀγγὺς ὢν φίλοις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1002.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1002.1.text#ἑνὸς δ' ἄθικτος, ᾧ με νῦν ἑλεῖν δοκεῖς·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1003.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1003.1.text#λέχους γὰρ ἐς τόδ' ἡμέρας ἁγνὸν δέμας·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1004.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1004.1.text#οὐκ οἶδα πρᾶξιν τήνδε πλὴν λόγῳ κλύων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1005.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1005.1.text#γραφῇ τε λεύσσων· οὐδὲ ταῦτα γὰρ σκοπεῖν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1006.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1006.1.text#πρόθυμός εἰμι, παρθένον ψυχὴν ἔχων.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1007.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1007.1.text#καὶ δὴ τὸ σῶφρον τοὐμὸν οὐ πείθει σ'· ἴτω·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1008.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1008.1.text#δεῖ δή σε δεῖξαι τῷ τρόπῳ διεφθάρην.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1009.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1009.1.text#πότερα τὸ τῆσδε σῶμ' ἐκαλλιστεύετο
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1010.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1010.1.text#πασῶν γυναικῶν; ἢ σὸν οἰκήσειν δόμον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1011.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1011.1.text#ἔγκληρον εὐνὴν προσλαβὼν ἐπήλπισα;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1012.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1012.1.text#μάταιος ἆρ' ἦν, οὐδαμοῦ μὲν οὖν φρενῶν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1013.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1013.1.text#ἀλλ' ὡς τυραννεῖν ἡδύ; τοῖσι σώφροσιν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1014.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1014.1.text#ἥκιστά γ', εἰ μὴ τὰς φρένας διέφθορεν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1015.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1015.1.text#θνητῶν ὅσοισιν ἁνδάνει μοναρχία.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1016.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1016.1.text#ἐγὼ δ' ἀγῶνας μὲν κρατεῖν Ἑλληνικοὺς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1017.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1017.1.text#πρῶτος θέλοιμ' ἄν, ἐν πόλει δὲ δεύτερος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1018.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1018.1.text#σὺν τοῖς ἀρίστοις εὐτυχεῖν ἀεὶ φίλοις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1019.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1019.1.text#πράσσειν τε γὰρ πάρεστι, κίνδυνός τ' ἀπὼν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1020.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1020.1.text#κρείσσω δίδωσι τῆς τυραννίδος χάριν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1021.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1021.1.text#ἓν οὐ λέλεκται τῶν ἐμῶν, τὰ δ' ἄλλ' ἔχεις·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1022.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1022.1.text#εἰ μὲν γὰρ ἦν μοι μάρτυς οἷός εἰμ' ἐγώ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1023.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1023.1.text#καὶ τῆσδ' ὁρώσης φέγγος ἠγωνιζόμην,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1024.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1024.1.text#ἔργοις ἂν εἶδες τοὺς κακοὺς διεξιών·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1025.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1025.1.text#νῦν δ' ὅρκιόν σοι Ζῆνα καὶ πέδον χθονὸς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1026.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1026.1.text#ὄμνυμι τῶν σῶν μήποθ' ἅψασθαι γάμων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1027.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1027.1.text#μηδ' ἂν θελῆσαι μηδ' ἂν ἔννοιαν λαβεῖν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1028.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1028.1.text#ἦ τἄρ' ὀλοίμην ἀκλεὴς ἀνώνυμος,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1029.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1029.1.text#ἄπολις ἄοικος, φυγὰς ἀλητεύων χθόνα,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1030.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1030.1.text#καὶ μήτε πόντος μήτε γῆ δέξαιτό μου
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1031.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1031.1.text#σάρκας θανόντος, εἰ κακὸς πέφυκ' ἀνήρ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1032.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1032.1.text#εἰ δ' ἥδε δειμαίνουσ' ἀπώλεσεν βίον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1033.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1033.1.text#οὐκ οἶδ'· ἐμοὶ γὰρ οὐ θέμις πέρα λέγειν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1034.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1034.1.text#ἐσωφρόνησεν οὐκ ἔχουσα σωφρονεῖν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1035.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1035.1.text#ἡμεῖς δ' ἔχοντες οὐ καλῶς ἐχρώμεθα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1036.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1036.1.text#ἀρκοῦσαν εἶπας αἰτίας ἀποστροφήν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1037.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1037.1.text#ὅρκους παρασχών, πίστιν οὐ σμικράν, θεῶν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1038.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1038.1.text#ἆρ' οὐκ ἐπῳδὸς καὶ γόης πέφυχ' ὅδε,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1039.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1039.1.text#ὃς τὴν ἐμὴν πέποιθεν εὐοργησίᾳ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1040.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1040.1.text#ψυχὴν κρατήσειν, τὸν τεκόντ' ἀτιμάσας;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1041.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1041.1.text#καὶ σοῦ γε ταὐτὰ κάρτα θαυμάζω, πάτερ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1042.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1042.1.text#εἰ γὰρ σὺ μὲν παῖς ἦσθ', ἐγὼ δὲ σὸς πατήρ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1043.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1043.1.text#ἔκτεινά τοί σ' ἂν κοὐ φυγαῖς ἐζημίουν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1044.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1044.1.text#εἴπερ γυναικὸς ἠξίουν σ' ἐμῆς θιγεῖν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1045.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1045.1.text#ὡς ἄξιον τόδ' εἶπας· οὐχ οὕτω θανῇ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1047.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1047.1.text#ταχὺς γὰρ Ἅιδης ῥᾷστος ἀνδρὶ δυστυχεῖ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1048.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1048.1.text#ἀλλ' ἐκ πατρῴας φυγὰς ἀλητεύων χθονὸς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1046.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1046.1.text#ὥσπερ σὺ σαυτῷ τόνδε προύθηκας νόμον —
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1049.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1049.1.text#[ ξένην ἐπ' αἶαν λυπρὸν ἀντλήσεις βίον· ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1050.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1050.1.text#[ μισθὸς γὰρ οὗτός ἐστιν ἀνδρὶ δυσσεβεῖ. ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1051.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1051.1.text#οἴμοι, τί δράσεις; οὐδὲ μηνυτὴν χρόνον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1052.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1052.1.text#δέξῃ καθ' ἡμῶν, ἀλλά μ' ἐξελᾷς χθονός;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1053.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1053.1.text#πέραν γε πόντου καὶ τόπων Ἀτλαντικῶν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1054.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1054.1.text#εἴ πως δυναίμην, ὡς σὸν ἐχθαίρω κάρα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1055.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1055.1.text#οὐδ' ὅρκον οὐδὲ πίστιν οὐδὲ μάντεων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1056.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1056.1.text#φήμας ἐλέγξας ἄκριτον ἐκβαλεῖς με γῆς;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1057.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1057.1.text#ἡ δέλτος ἥδε κλῆρον οὐ δεδεγμένη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1058.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1058.1.text#κατηγορεῖ σου πιστά· τοὺς δ' ὑπὲρ κάρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1059.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1059.1.text#φοιτῶντας ὄρνις πόλλ' ἐγὼ χαίρειν λέγω.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1060.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1060.1.text#ὦ θεοί, τί δῆτα τοὐμὸν οὐ λύω στόμα,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1061.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1061.1.text#ὅστις γ' ὑφ' ὑμῶν, οὓς σέβω, διόλλυμαι;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1062.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1062.1.text#οὐ δῆτα· πάντως οὐ πίθοιμ' ἂν οὕς με δεῖ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1063.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1063.1.text#μάτην δ' ἂν ὅρκους συγχέαιμ' οὓς ὤμοσα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1064.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1064.1.text#οἴμοι, τὸ σεμνὸν ὥς μ' ἀποκτενεῖ τὸ σόν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1065.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1065.1.text#οὐκ εἶ πατρῴας ἐκτὸς ὡς τάχιστα γῆς;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1066.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1066.1.text#ποῖ δῆθ' ὁ τλήμων τρέψομαι; τίνος ξένων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1067.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1067.1.text#δόμους ἔσειμι, τῇδ' ἐπ' αἰτίᾳ φυγών;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1068.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1068.1.text#ὅστις γυναικῶν λυμεῶνας ἥδεται
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1069.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1069.1.text#ξένους κομίζων καὶ ξυνοικούρους κακῶν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1070.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1070.1.text#αἰαῖ, πρὸς ἧπαρ· δακρύων [ τ' ] ἐγγὺς τόδε,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1071.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1071.1.text#εἰ δὴ κακός γε φαίνομαι, δοκῶ τέ σοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1072.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1072.1.text#τότε στενάζειν καὶ προγιγνώσκειν σ' ἐχρῆν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1073.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1073.1.text#ὅτ' ἐς πατρῴαν ἄλοχον ὑβρίζειν ἔτλης.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1074.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1074.1.text#ὦ δώματ', εἴθε φθέγμα γηρύσαισθέ μοι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1075.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1075.1.text#καὶ μαρτυρήσαιτ' εἰ κακὸς πέφυκ' ἀνήρ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1076.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1076.1.text#ἐς τοὺς ἀφώνους μάρτυρας φεύγεις σοφῶς·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1077.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1077.1.text#τὸ δ' ἔργον οὐ λέγον σε μηνύει κακόν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1078.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1078.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1078.2.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1078.2.text#εἴθ' ἦν ἐμαυτὸν προσβλέπειν ἐναντίον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1079.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1079.1.text#στάνθ', ὡς ἐδάκρυσ' οἷα πάσχομεν κακά.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1080.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1080.1.text#πολλῷ γε μᾶλλον σαυτὸν ἤσκησας σέβειν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1081.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1081.1.text#ἢ τοὺς τεκόντας ὅσια δρᾶν δίκαιος ὤν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1082.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1082.1.text#ὦ δυστάλαινα μῆτερ, ὦ πικραὶ γοναί·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1083.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1083.1.text#μηδείς ποτ' εἴη τῶν ἐμῶν φίλων νόθος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1084.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1084.1.text#οὐχ ἕλξετ' αὐτόν, δμῶες; οὐκ ἀκούετε
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1085.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1085.1.text#πάλαι ξενοῦσθαι τόνδε προυννέποντά με;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1086.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1086.1.text#κλαίων τις αὐτῶν ἆρ' ἐμοῦ τεθίξεται·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1087.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1087.1.text#σὺ δ' αὐτός, εἴ σοι θυμός, ἐξώθει χθονός.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1088.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1088.1.text#δράσω τάδ', εἰ μὴ τοῖς ἐμοῖς πείσῃ λόγοις·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1089.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1089.1.text#οὐ γάρ τις οἶκτος σῆς μ' ὑπέρχεται φυγῆς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1090.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1090.1.text#ἄραρεν, ὡς ἔοικεν· ὦ τάλας ἐγώ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1091.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1091.1.text#ὡς οἶδα μὲν ταῦτ', οἶδα δ' οὐχ ὅπως φράσω.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1092.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1092.1.text#ὦ φιλτάτη μοι δαιμόνων Λητοῦς κόρη,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1093.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1093.1.text#σύνθακε, συγκύναγε, φευξόμεσθα δὴ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1094.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1094.1.text#κλεινὰς Ἀθήνας. ἀλλὰ χαιρέτω πόλις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1095.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1095.1.text#καὶ γαῖ' Ἐρεχθέως· ὦ πέδον Τροζήνιον,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1096.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1096.1.text#ὡς ἐγκαθηβᾶν πόλλ' ἔχεις εὐδαίμονα,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1097.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1097.1.text#χαῖρ'· ὕστατον γάρ σ' εἰσορῶν προσφθέγγομαι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1098.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1098.1.text#ἴτ' ὦ νέοι μοι τῆσδε γῆς ὁμήλικες,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1099.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1099.1.text#προσείπαθ' ἡμᾶς καὶ προπέμψατε χθονός·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1100.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1100.1.text#ὡς οὔποτ' ἄλλον ἄνδρα σωφρονέστερον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1101.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1101.1.text#ὄψεσθε, κεἰ μὴ ταῦτ' ἐμῷ δοκεῖ πατρί.[ … ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1102.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1102.1.text#ἦ μέγα μοι τὰ θεῶν μελεδήμαθ', ὅταν φρένας ἔλθῃ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1103.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1103.1.text#λύπας παραιρεῖ· ξύνεσιν δέ τιν' ἐλπίδι κεύθων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1104.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1104.1.text#λείπομαι ἔν τε τύχαις θνατῶν καὶ ἐν ἔργμασι λεύσσων·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1105.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1105.1.text#ἄλλα γὰρ ἄλλοθεν ἀμείβεται, μετὰ δ' ἵσταται ἀνδράσιν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1106.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1106.1.text#αἰὼν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1107.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1107.1.text#πολυπλάνητος αἰεί.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1111.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1111.1.text#εἴθε μοι εὐξαμένᾳ θεόθεν τάδε μοῖρα παράσχοι,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1112.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1112.1.text#τύχαν μετ' ὄλβου καὶ ἀκήρατον ἄλγεσι θυμόν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1115.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1115.1.text#δόξα δὲ μήτ' ἀτρεκὴς μήτ' αὖ παράσημος ἐνείη·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1116.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1116.1.text#ῥᾴδια δ' ἤθεα τὸν αὔριον μεταβαλλομένα χρόνον αἰεὶ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1118.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1118.1.text#βίον συνευτυχοίην.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1120.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1120.1.text#οὐκέτι γὰρ καθαρὰν φρέν' ἔχω { τὰ } παρ' ἐλπίδα λεύσσων,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1121.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1121.1.text#ἐπεὶ τὸν Ἑλλανίας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1122.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1122.1.text#φανερώτατον ἀστέρ' Ἀθήνας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1123.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1123.1.text#εἴδομεν εἴδομεν ἐκ πατρὸς ὀργᾶς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1125.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1125.1.text#ἄλλαν ἐπ' αἶαν ἱέμενον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1126.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1126.1.text#ὦ ψάμαθοι πολιήτιδος ἀκτᾶς,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1128.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1128.1.text#ὦ δρυμὸς ὄρειος, ὅθι κυνῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1129.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1129.1.text#ὠκυπόδων μέτα θῆρας ἔναιρεν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1130.1.speaker#Χορός Κυνηγῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1130.1.text#Δίκτυνναν ἀμφὶ σεμνάν.[ … ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1131.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1131.1.text#οὐκέτι συζυγίαν πώλων Ἐνετᾶν ἐπιβάσῃ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1132.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1132.1.text#τὸν ἀμφὶ Λίμνας τρόχον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1133.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1133.1.text#κατέχων ποδὶ γυμνάδος ἵππου.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1134.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1134.1.text#μοῦσα δ' ἄυπνος ὑπ' ἄντυγι χορδᾶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1135.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1135.1.text#λήξει πατρῷον ἀνὰ δόμον·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1136.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1136.1.text#ἀστέφανοι δὲ κόρας ἀνάπαυλαι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1137.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1137.1.text#Λατοῦς βαθεῖαν ἀνὰ χλόαν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1138.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1138.1.text#νυμφιδία δ' ἀπόλωλε φυγᾷ σᾷ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1139.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1139.1.text#λέκτρων ἅμιλλα κούραις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1142.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1142.1.text#— ἐγὼ δὲ σᾷ δυστυχίᾳ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1143.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1143.1.text#δάκρυσι διοίσω πότμον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1144.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1144.1.text#ἄποτμον· ὦ τάλαινα μᾶτερ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1145.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1145.1.text#ἔτεκες ἀνόνατα· φεῦ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1146.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1146.1.text#μανίω θεοῖσιν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1147.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1147.1.text#ἰὼ ἰώ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1148.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1148.1.text#συζύγιαι Χάριτες, τί τὸν τάλαν' ἐκ πατρίας γᾶς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1149.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1149.1.text#οὐδὲν ἄτας αἴτιον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1150.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1150.1.text#πέμπετε τῶνδ' ἀπ' οἴκων;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1151.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1151.1.text#— καὶ μὴν ὀπαδὸν Ἱππολύτου τόνδ' εἰσορῶ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1152.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1152.1.text#σπουδῇ σκυθρωπὸν πρὸς δόμους ὁρμώμενον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1153.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1153.1.text#ποῖ γῆς ἄνακτα τῆσδε Θησέα μολὼν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1154.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1154.1.text#εὕροιμ' ἄν, ὦ γυναῖκες; εἴπερ ἴστε μοι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1155.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1155.1.text#σημήνατ'· ἆρα τῶνδε δωμάτων ἔσω;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1156.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1156.1.text#ὅδ' αὐτὸς ἔξω δωμάτων πορεύεται.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1157.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1157.1.text#Θησεῦ, μερίμνης ἄξιον φέρω λόγον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1158.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1158.1.text#σοὶ καὶ πολίταις οἵ τ' Ἀθηναίων πόλιν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1159.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1159.1.text#ναίουσι καὶ γῆς τέρμονας Τροζηνίας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1160.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1160.1.text#τί δ' ἔστι; μῶν τις συμφορὰ νεωτέρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1161.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1161.1.text#δισσὰς κατείληφ' ἀστυγείτονας πόλεις;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1162.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1162.1.text#Ἱππόλυτος οὐκέτ' ἔστιν, ὡς εἰπεῖν ἔπος·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1163.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1163.1.text#δέδορκε μέντοι φῶς ἐπὶ σμικρᾶς ῥοπῆς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1164.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1164.1.text#πρὸς τοῦ; δι' ἔχθρας μῶν τις ἦν ἀφιγμένος,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1165.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1165.1.text#ὅτου κατῄσχυν' ἄλοχον ὡς πατρὸς βίᾳ;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1166.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1166.1.text#οἰκεῖος αὐτὸν ὤλεσ' ἁρμάτων ὄχος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1167.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1167.1.text#ἀραί τε τοῦ σοῦ στόματος, ἃς σὺ σῷ πατρὶ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1168.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1168.1.text#πόντου κρέοντι παιδὸς ἠράσω πέρι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1169.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1169.1.text#ὦ θεοὶ Πόσειδόν θ', ὡς ἄρ' ἦσθ' ἐμὸς πατὴρ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1170.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1170.1.text#ὀρθῶς, ἀκούσας τῶν ἐμῶν κατευγμάτων.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1171.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1171.1.text#πῶς καὶ διώλετ'; εἰπέ· τῷ τρόπῳ Δίκης
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1172.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1172.1.text#ἔπαισεν αὐτὸν ῥόπτρον αἰσχύναντ' ἐμέ;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1173.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1173.1.text#ἡμεῖς μὲν ἀκτῆς κυμοδέγμονος πέλας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1174.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1174.1.text#ψήκτραισιν ἵππων ἐκτενίζομεν τρίχας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1175.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1175.1.text#κλαίοντες· ἦλθε γάρ τις ἄγγελος λέγων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1176.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1176.1.text#ὡς οὐκέτ' ἐν γῇ τῇδ' ἀναστρέψοι πόδα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1177.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1177.1.text#Ἱππόλυτος, ἐκ σοῦ τλήμονας φυγὰς ἔχων.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1178.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1178.1.text#ὃ δ' ἦλθε ταὐτὸν δακρύων ἔχων μέλος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1179.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1179.1.text#ἡμῖν ἐπ' ἀκτάς· μυρία δ' ὀπισθόπους
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1180.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1180.1.text#φίλων ἅμ' ἔστειχ' ἡλίκων { θ' } ὁμήγυρις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1181.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1181.1.text#χρόνῳ δὲ δήποτ' εἶπ' ἀπαλλαχθεὶς γόων·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1182.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1182.1.text#Τί ταῦτ' ἀλύω; πειστέον πατρὸς λόγοις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1183.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1183.1.text#ἐντύναθ' ἵππους ἅρμασι ζυγηφόρους,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1184.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1184.1.text#δμῶες· πόλις γὰρ οὐκέτ' ἔστιν ἥδε μοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1185.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1185.1.text#τοὐνθένδε μέντοι πᾶς ἀνὴρ ἠπείγετο,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1186.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1186.1.text#καὶ θᾶσσον ἢ λέγοι τις ἐξηρτυμένας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1187.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1187.1.text#πώλους παρ' αὐτὸν δεσπότην ἐστήσαμεν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1188.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1188.1.text#μάρπτει δὲ χερσὶν ἡνίας ἀπ' ἄντυγος,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1189.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1189.1.text#αὐταῖσιν ἀρβύλαισιν ἁρμόσας πόδα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1190.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1190.1.text#καὶ πρῶτα μὲν θεοῖς εἶπ' ἀναπτύξας χέρας·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1191.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1191.1.text#Ζεῦ, μηκέτ' εἴην, εἰ κακὸς πέφυκ' ἀνήρ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1192.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1192.1.text#αἴσθοιτο δ' ἡμᾶς ὡς ἀτιμάζει πατὴρ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1193.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1193.1.text#ἤτοι θανόντας ἢ φάος δεδορκότας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1194.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1194.1.text#κἀν τῷδ' ἐπῆγε κέντρον ἐς χεῖρας λαβὼν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1195.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1195.1.text#πώλοις ὁμαρτῇ· πρόσπολοι δ' ὑφ' ἅρματος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1196.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1196.1.text#πέλας χαλινῶν εἱπόμεσθα δεσπότῃ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1197.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1197.1.text#τὴν εὐθὺς Ἄργους κἀπιδαυρίας ὁδόν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1198.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1198.1.text#ἐπεὶ δ' ἔρημον χῶρον εἰσεβάλλομεν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1199.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1199.1.text#ἀκτή τις ἔστι τοὐπέκεινα τῆσδε γῆς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1200.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1200.1.text#πρὸς πόντον ἤδη κειμένη Σαρωνικόν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1201.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1201.1.text#ἔνθεν τις ἠχὼ χθόνιος ὡς βροντὴ Διὸς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1202.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1202.1.text#βαρὺν βρόμον μεθῆκε, φρικώδη κλύειν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1203.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1203.1.text#ὀρθὸν δὲ κρᾶτ' ἔστησαν οὖς τ' ἐς οὐρανὸν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1204.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1204.1.text#ἵπποι· παρ' ἡμῖν δ' ἦν φόβος νεανικὸς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1205.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1205.1.text#πόθεν ποτ' εἴη φθόγγος. ἐς δ' ἁλιρρόθους
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1206.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1206.1.text#ἀκτὰς ἀποβλέψαντες ἱερὸν εἴδομεν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1207.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1207.1.text#κῦμ' οὐρανῷ στηρίζον, ὥστ' ἀφῃρέθη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1208.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1208.1.text#Σκίρωνος ἀκτὰς ὄμμα τοὐμὸν εἰσορᾶν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1209.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1209.1.text#ἔκρυπτε δ' Ἰσθμὸν καὶ πέτραν Ἀσκληπιοῦ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1210.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1210.1.text#κἄπειτ' ἀνοιδῆσάν τε καὶ πέριξ ἀφρὸν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1211.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1211.1.text#πολὺν καχλάζον ποντίῳ φυσήματι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1212.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1212.1.text#χωρεῖ πρὸς ἀκτὰς οὗ τέθριππος ἦν ὄχος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1213.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1213.1.text#αὐτῷ δὲ σὺν κλύδωνι καὶ τρικυμίᾳ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1214.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1214.1.text#κῦμ' ἐξέθηκε ταῦρον, ἄγριον τέρας·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1215.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1215.1.text#οὗ πᾶσα μὲν χθὼν φθέγματος πληρουμένη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1216.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1216.1.text#φρικῶδες ἀντεφθέγγετ', εἰσορῶσι δὲ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1217.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1217.1.text#κρεῖσσον θέαμα δεργμάτων ἐφαίνετο.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1218.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1218.1.text#εὐθὺς δὲ πώλοις δεινὸς ἐμπίπτει φόβος·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1219.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1219.1.text#καὶ δεσπότης μὲν ἱππικοῖσιν ἤθεσιν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1220.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1220.1.text#πολὺς ξυνοικῶν ἥρπασ' ἡνίας χεροῖν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1221.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1221.1.text#ἕλκει δὲ κώπην ὥστε ναυβάτης ἀνὴρ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1222.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1222.1.text#ἱμᾶσιν ἐς τοὔπισθεν ἀρτήσας δέμας·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1223.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1223.1.text#αἳ δ' ἐνδακοῦσαι στόμια πυριγενῆ γναθμοῖς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1224.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1224.1.text#βίᾳ φέρουσιν, οὔτε ναυκλήρου χερὸς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1225.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1225.1.text#οὔθ' ἱπποδέσμων οὔτε κολλητῶν ὄχων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1226.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1226.1.text#μεταστρέφουσαι. κεἰ μὲν ἐς τὰ μαλθακὰ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1227.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1227.1.text#γαίας ἔχων οἴακας εὐθύνοι δρόμον,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1228.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1228.1.text#προυφαίνετ' ἐς τὸ πρόσθεν, ὥστ' ἀναστρέφειν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1229.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1229.1.text#ταῦρος, φόβῳ τέτρωρον ἐκμαίνων ὄχον·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1230.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1230.1.text#εἰ δ' ἐς πέτρας φέροιντο μαργῶσαι φρένας,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1231.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1231.1.text#σιγῇ πελάζων ἄντυγι ξυνείπετο
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1232.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1232.1.text#ἐς τοῦθ' ἕως ἔσφηλε κἀνεχαίτισεν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1233.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1233.1.text#ἁψῖδα πέτρῳ προσβαλὼν ὀχήματος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1234.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1234.1.text#σύμφυρτα δ' ἦν ἅπαντα· σύριγγές τ' ἄνω
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1235.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1235.1.text#τροχῶν ἐπήδων ἀξόνων τ' ἐνήλατα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1236.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1236.1.text#αὐτὸς δ' ὁ τλήμων ἡνίαισιν ἐμπλακεὶς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1237.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1237.1.text#δεσμὸν δυσεξήνυστον ἕλκεται δεθείς,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1238.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1238.1.text#σποδούμενος μὲν πρὸς πέτραις φίλον κάρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1239.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1239.1.text#θραύων τε σάρκας, δεινὰ δ' ἐξαυδῶν κλύειν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1240.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1240.1.text#Στῆτ', ὦ φάτναισι ταῖς ἐμαῖς τεθραμμέναι,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1241.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1241.1.text#μή μ' ἐξαλείψητ'· ὦ πατρὸς τάλαιν' ἀρά.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1242.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1242.1.text#τίς ἄνδρ' ἄριστον βούλεται σῶσαι παρών;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1243.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1243.1.text#πολλοὶ δὲ βουληθέντες ὑστέρῳ ποδὶ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1244.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1244.1.text#ἐλειπόμεσθα. χὣ μὲν ἐκ δεσμῶν λυθεὶς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1245.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1245.1.text#τμητῶν ἱμάντων οὐ κάτοιδ' ὅτῳ τρόπῳ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1246.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1246.1.text#πίπτει, βραχὺν δὴ βίοτον ἐμπνέων ἔτι·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1247.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1247.1.text#ἵπποι δ' ἔκρυφθεν καὶ τὸ δύστηνον τέρας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1248.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1248.1.text#ταύρου λεπαίας οὐ κάτοιδ' ὅποι χθονός.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1249.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1249.1.text#δοῦλος μὲν οὖν ἔγωγε σῶν δόμων, ἄναξ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1250.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1250.1.text#ἀτὰρ τοσοῦτόν γ' οὐ δυνήσομαί ποτε,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1251.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1251.1.text#τὸν σὸν πιθέσθαι παῖδ' ὅπως ἐστὶν κακός·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1252.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1252.1.text#οὐδ' εἰ γυναικῶν πᾶν κρεμασθείη γένος,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1253.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1253.1.text#καὶ τὴν ἐν Ἴδῃ  γραμμάτων πλήσειέ τις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1254.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1254.1.text#πεύκην, ἐπεί νιν ἐσθλὸν ὄντ' ἐπίσταμαι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1255.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1255.1.text#αἰαῖ· κέκρανται συμφορὰ νέων κακῶν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1256.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1256.1.text#οὐδ' ἔστι μοίρας τοῦ χρεών τ' ἀπαλλαγή.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1257.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1257.1.text#μίσει μὲν ἀνδρὸς τοῦ πεπονθότος τάδε
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1258.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1258.1.text#λόγοισιν ἥσθην τοῖσδε· νῦν δ' αἰδούμενος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1259.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1259.1.text#θεούς τ' ἐκεῖνόν θ', οὕνεκ' ἐστὶν ἐξ ἐμοῦ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1260.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1260.1.text#οὔθ' ἥδομαι τοῖσδ' οὔτ' ἐπάχθομαι κακοῖς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1261.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1261.1.text#πῶς οὖν; κομίζειν, ἢ τί χρὴ τὸν ἄθλιον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1262.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1262.1.text#δράσαντας ἡμᾶς σῇ χαρίζεσθαι φρενί;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1263.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1263.1.text#φρόντιζ'· ἐμοῖς δὲ χρώμενος βουλεύμασιν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1264.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1264.1.text#οὐκ ὠμὸς ἐς σὸν παῖδα δυστυχοῦντ' ἔσῃ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1265.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1265.1.text#κομίζετ' αὐτόν, ὡς ἰδὼν ἐν ὄμμασιν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1266.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1266.1.text#τὸν τἄμ' ἀπαρνηθέντα μὴ χρᾶναι λέχη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1267.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1267.1.text#λόγοις τ' ἐλέγξω δαιμόνων τε συμφοραῖς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1268.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1268.1.text#σὺ τὰν θεῶν ἄκαμπτον φρένα καὶ βροτῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1269.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1269.1.text#ἄγεις, Κύπρι, σὺν δ'
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1270.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1270.1.text#ὁ ποικιλόπτερος ἀμφιβαλὼν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1271.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1271.1.text#ὠκυτάτῳ πτερῷ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1272.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1272.1.text#ποτᾶται δὲ γαῖαν εὐάχητόν θ'
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1273.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1273.1.text#ἁλμυρὸν ἐπὶ πόντον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1274.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1274.1.text#θέλγει δ' Ἔρως, ᾧ μαινομένᾳ κραδίᾳ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1275.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1275.1.text#πτανὸς ἐφορμάσῃ χρυσοφαής,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1276.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1276.1.text#φύσιν ὀρεσκόων σκυλάκων πελαγίων θ'
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1277.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1277.1.text#ὅσα τε γᾶ τρέφει
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1278.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1278.1.text#τά τ' ἀέλιος αἰθόμενα δέρκεται,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1280.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1280.1.text#ἄνδρας τε· συμπάντων βασιληίδα τιμάν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1281.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1281.1.text#Κύπρι, τῶνδε μόνα κρατύνεις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1283.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1283.1.text#σὲ τὸν εὐπατρίδην Αἰγέως κέλομαι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1284.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1284.1.text#παῖδ' ἐπακοῦσαι·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1285.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1285.1.text#Λητοῦς δὲ κόρη σ'  Ἄρτεμις αὐδῶ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1286.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1286.1.text#Θησεῦ, τί τάλας τοῖσδε συνήδῃ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1287.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1287.1.text#παῖδ' οὐχ ὁσίως σὸν ἀποκτείνας,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1288.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1288.1.text#ψευδέσι μύθοις ἀλόχου πεισθεὶς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1289.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1289.1.text#ἀφανῆ; φανερὰν δ' ἔσχεθες ἄτην.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1290.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1290.1.text#πῶς οὐχ ὑπὸ γῆς τάρταρα κρύπτεις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1291.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1291.1.text#δέμας αἰσχυνθείς,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1292.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1292.1.text#ἢ πτηνὸς ἄνω μεταβὰς βίοτον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1293.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1293.1.text#πήματος ἔξω πόδα τοῦδ' ἀνέχεις;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1294.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1294.1.text#ὡς ἔν γ' ἀγαθοῖς ἀνδράσιν οὔ σοι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1295.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1295.1.text#κτητὸν βιότου μέρος ἐστίν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1296.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1296.1.text#ἄκουε, Θησεῦ, σῶν κακῶν κατάστασιν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1297.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1297.1.text#καίτοι προκόψω γ' οὐδέν, ἀλγυνῶ δέ σε.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1298.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1298.1.text#ἀλλ' ἐς τόδ' ἦλθον, παιδὸς ἐκδεῖξαι φρένα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1299.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1299.1.text#τοῦ σοῦ δικαίαν, ὡς ὑπ' εὐκλείας θάνῃ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1300.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1300.1.text#καὶ σῆς γυναικὸς οἶστρον ἢ τρόπον τινὰ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1301.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1301.1.text#γενναιότητα· τῆς γὰρ ἐχθίστης θεῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1302.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1302.1.text#ἡμῖν, ὅσαισι παρθένειος ἡδονή,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1303.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1303.1.text#δηχθεῖσα κέντροις παιδὸς ἠράσθη σέθεν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1304.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1304.1.text#γνώμῃ δὲ νικᾶν τὴν Κύπριν πειρωμένη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1305.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1305.1.text#τροφοῦ διώλετ' οὐχ ἑκοῦσα μηχαναῖς,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1306.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1306.1.text#ἣ σῷ δι' ὅρκων παιδὶ σημαίνει νόσον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1307.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1307.1.text#ὃ δ', ὥσπερ ὢν δίκαιος, οὐκ ἐφέσπετο
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1308.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1308.1.text#λόγοισιν, οὐδ' αὖ πρὸς σέθεν κακούμενος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1309.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1309.1.text#ὅρκων ἀφεῖλε πίστιν, εὐσεβὴς γεγώς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1310.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1310.1.text#ἣ δ' εἰς ἔλεγχον μὴ πέσῃ φοβουμένη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1311.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1311.1.text#ψευδεῖς γραφὰς ἔγραψε καὶ διώλεσεν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1312.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1312.1.text#δόλοισι σὸν παῖδ'· ἀλλ' ὅμως ἔπεισέ σε.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1313.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1313.1.text#οἴμοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1313.2.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1313.2.text#δάκνει σε, Θησεῦ, μῦθος; ἀλλ' ἔχ' ἥσυχος,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1314.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1314.1.text#τοὐνθένδ' ἀκούσας ὡς ἂν οἰμώξῃς πλέον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1315.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1315.1.text#ἆρ' οἶσθα πατρὸς τρεῖς ἀρὰς ἔχων σαφεῖς;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1316.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1316.1.text#ὧν τὴν μίαν παρεῖλες, ὦ κάκιστε σύ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1317.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1317.1.text#ἐς παῖδα τὸν σόν, ἐξὸν εἰς ἐχθρόν τινα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1318.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1318.1.text#πατὴρ μὲν οὖν σοι πόντιος φρονῶν καλῶς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1319.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1319.1.text#ἔδωχ' ὅσονπερ χρῆν, ἐπείπερ ᾔνεσεν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1320.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1320.1.text#σὺ δ' ἔν τ' ἐκείνῳ κἀν ἐμοὶ φαίνῃ κακός,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1321.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1321.1.text#ὃς οὔτε πίστιν οὔτε μάντεων ὄπα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1322.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1322.1.text#ἔμεινας, οὐκ ἤλεγξας, οὐ χρόνῳ μακρῷ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1323.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1323.1.text#σκέψιν παρέσχες, ἀλλὰ θᾶσσον ἤ σ' ἐχρῆν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1324.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1324.1.text#ἀρὰς ἀφῆκας παιδὶ καὶ κατέκτανες.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1325.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1325.1.text#δέσποιν', ὀλοίμην.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1325.2.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1325.2.text#δείν' ἔπραξας, ἀλλ' ὅμως
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1326.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1326.1.text#ἔτ' ἔστι καί σοι τῶνδε συγγνώμης τυχεῖν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1327.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1327.1.text#Κύπρις γὰρ ἤθελ' ὥστε γίγνεσθαι τόδε,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1328.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1328.1.text#πληροῦσα θυμόν. θεοῖσι δ' ὧδ' ἔχει νόμος·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1329.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1329.1.text#οὐδεὶς ἀπαντᾶν βούλεται προθυμίᾳ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1330.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1330.1.text#τῇ τοῦ θέλοντος, ἀλλ' ἀφιστάμεσθ' ἀεί.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1331.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1331.1.text#ἐπεί, σάφ' ἴσθι, Ζῆνα μὴ φοβουμένη
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1332.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1332.1.text#οὐκ ἄν ποτ' ἦλθον ἐς τόδ' αἰσχύνης ἐγὼ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1333.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1333.1.text#ὥστ' ἄνδρα πάντων φίλτατον βροτῶν ἐμοὶ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1334.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1334.1.text#θανεῖν ἐᾶσαι. τὴν δὲ σὴν ἁμαρτίαν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1335.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1335.1.text#τὸ μὴ εἰδέναι μὲν πρῶτον ἐκλύει κάκης·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1336.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1336.1.text#ἔπειτα δ' ἡ θανοῦσ' ἀνήλωσεν γυνὴ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1337.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1337.1.text#λόγων ἐλέγχους ὥστε σὴν πεῖσαι φρένα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1338.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1338.1.text#μάλιστα μέν νυν σοὶ τάδ' ἔρρωγεν κακά,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1339.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1339.1.text#λύπη δὲ κἀμοί· τοὺς γὰρ εὐσεβεῖς θεοὶ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1340.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1340.1.text#θνῄσκοντας οὐ χαίρουσι· τούς γε μὴν κακοὺς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1341.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1341.1.text#αὐτοῖς τέκνοισι καὶ δόμοις ἐξόλλυμεν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1342.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1342.1.text#καὶ μὴν ὁ τάλας ὅδε δὴ στείχει,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1343.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1343.1.text#σάρκας νεαρὰς ξανθόν τε κάρα
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1344.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1344.1.text#διαλυμανθείς. ὦ πόνος οἴκων,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1345.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1345.1.text#οἷον ἐκράνθη δίδυμον μελάθροις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1346.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1346.1.text#πένθος θεόθεν καταληπτόν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1347.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1347.1.text#αἰαῖ αἰαῖ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1348.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1348.1.text#δύστηνος ἐγώ, πατρὸς ἐξ ἀδίκου
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1349.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1349.1.text#χρησμοῖς ἀδίκοις διελυμάνθην.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1350.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1350.1.text#ἀπόλωλα τάλας, οἴμοι μοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1351.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1351.1.text#διά μου κεφαλῆς ᾄσσουσ' ὀδύναι,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1352.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1352.1.text#κατὰ δ' ἐγκέφαλον πηδᾷ σφάκελος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1353.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1353.1.text#σχές, ἀπειρηκὸς σῶμ' ἀναπαύσω.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1354.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1354.1.text#[ ἓ ἕ· ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1355.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1355.1.text#ὦ στυγνὸν ὄχημ' ἵππειον, ἐμῆς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1356.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1356.1.text#βόσκημα χερός,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1357.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1357.1.text#διά μ' ἔφθειρας, κατὰ δ' ἔκτεινας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1358.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1358.1.text#φεῦ φεῦ· πρὸς θεῶν, ἀτρέμας, δμῶες,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1359.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1359.1.text#χροὸς ἑλκώδους ἅπτεσθε χεροῖν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1360.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1360.1.text#τίς ἐφέστηκεν δεξιὰ πλευροῖς;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1361.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1361.1.text#πρόσφορά μ' αἴρετε, σύντονα δ' ἕλκετε
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1362.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1362.1.text#τὸν κακοδαίμονα καὶ κατάρατον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1363.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1363.1.text#πατρὸς ἀμπλακίαις. Ζεῦ Ζεῦ, τάδ' ὁρᾷς;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1364.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1364.1.text#ὅδ' ὁ σεμνὸς ἐγὼ καὶ θεοσέπτωρ,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1365.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1365.1.text#ὅδ' ὁ σωφροσύνῃ πάντας ὑπερσχὼν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1366.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1366.1.text#προῦπτον ἐς Ἅιδην στείχω κατ' ἄκρας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1367.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1367.1.text#ὀλέσας βίοτον· μόχθους δ' ἄλλως
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1368.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1368.1.text#τῆς εὐσεβίας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1369.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1369.1.text#εἰς ἀνθρώπους ἐπόνησα.[ … ]
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1370.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1370.1.text#αἰαῖ αἰαῖ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1371.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1371.1.text#καὶ νῦν ὀδύνα μ' ὀδύνα βαίνει —
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1372.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1372.1.text#μέθετέ με,  τάλανες —
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1373.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1373.1.text#καί μοι θάνατος Παιὰν ἔλθοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1374.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1374.1.text#προσαπόλλυτ' ἀπόλλυτε τὸν δυσδαίμονά
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1375.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1375.1.text#{ μ'· } ἀμφιτόμου λόγχας ἔραμαι,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1376.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1376.1.text#διαμοιρᾶσαι
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1377.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1377.1.text#διά τ' εὐνᾶσαι τὸν ἐμὸν βίοτον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1378.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1378.1.text#ὦ πατρὸς ἐμοῦ δύστηνος ἀρά·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1379.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1379.1.text#μιαιφόνων [ τε ] συγγόνων παλαιῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1380.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1380.1.text#προγεννητόρων ἐξορίζεται
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1381.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1381.1.text#κακόν, { οὐδὲ μέλλει, }
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1382.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1382.1.text#ἔμολέ τ' ἐπ' ἐμὲ τί ποτε τὸν οὐδὲν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1383.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1383.1.text#ὄντ' ἐπαίτιον κακῶν;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1384.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1384.1.text#ἰώ μοί μοι·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1385.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1385.1.text#— τί φῶ; πῶς ἀπαλλάξω βιοτὰν ἐμὰν τάνδ' ἀναλγήτου
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1386.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1386.1.text#πάθους; εἴθε με κοιμάσειε
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1387.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1387.1.text#τὸν δυσδαίμον' Ἅιδου
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1388.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1388.1.text#μέλαινα νύκτερός τ' ἀνάγκα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1389.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1389.1.text#ὦ τλῆμον, οἵᾳ συμφορᾷ συνεζύγης·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1390.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1390.1.text#τὸ δ' εὐγενές σε τῶν φρενῶν ἀπώλεσεν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1391.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1391.1.text#ἔα·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1391.2.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1391.2.text#ὦ θεῖον ὀδμῆς πνεῦμα· καὶ γὰρ ἐν κακοῖς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1392.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1392.1.text#ὢν ᾐσθόμην σου κἀνεκουφίσθην δέμας·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1393.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1393.1.text#ἔστ' ἐν τόποισι τοισίδ'  Ἄρτεμις θεά.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1394.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1394.1.text#ὦ τλῆμον, ἔστι, σοί γε φιλτάτη θεῶν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1395.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1395.1.text#ὁρᾷς με, δέσποιν', ὡς ἔχω, τὸν ἄθλιον;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1396.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1396.1.text#ὁρῶ· κατ' ὄσσων δ' οὐ θέμις βαλεῖν δάκρυ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1397.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1397.1.text#οὐκ ἔστι σοι κυναγὸς οὐδ' ὑπηρέτης,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1398.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1398.1.text#οὐ δῆτ'· ἀτάρ μοι προσφιλής γ' ἀπόλλυσαι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1399.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1399.1.text#οὐδ' ἱππονώμας οὐδ' ἀγαλμάτων φύλαξ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1400.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1400.1.text#Κύπρις γὰρ ἡ πανοῦργος ὧδ' ἐμήσατο.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1401.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1401.1.text#ὤμοι· φρονῶ δὴ δαίμον' ἥ μ' ἀπώλεσεν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1402.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1402.1.text#τιμῆς ἐμέμφθη σωφρονοῦντι δ' ἤχθετο.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1403.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1403.1.text#τρεῖς ὄντας ἡμᾶς ὤλεσ', ᾔσθημαι, Κύπρις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1404.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1404.1.text#πατέρα γε καὶ σὲ καὶ τρίτην ξυνάορον.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1405.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1405.1.text#ᾤμωξα τοίνυν καὶ πατρὸς δυσπραξίας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1406.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1406.1.text#ἐξηπατήθη δαίμονος βουλεύμασιν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1407.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1407.1.text#ὦ δυστάλας σὺ τῆσδε συμφορᾶς, πάτερ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1408.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1408.1.text#ὄλωλα, τέκνον, οὐδέ μοι χάρις βίου.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1409.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1409.1.text#στένω σὲ μᾶλλον ἢ 'μὲ τῆς ἁμαρτίας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1410.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1410.1.text#εἰ γὰρ γενοίμην, τέκνον, ἀντὶ σοῦ νεκρός.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1411.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1411.1.text#ὦ δῶρα πατρὸς σοῦ Ποσειδῶνος πικρά.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1412.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1412.1.text#ὡς μήποτ' ἐλθεῖν ὤφελ' ἐς τοὐμὸν στόμα.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1413.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1413.1.text#τί δ'; ἔκτανές τἄν μ', ὡς τότ' ἦσθ' ὠργισμένος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1414.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1414.1.text#δόξης γὰρ ἦμεν πρὸς θεῶν ἐσφαλμένοι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1415.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1415.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1415.2.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1415.2.text#εἴθ' ἦν ἀραῖον δαίμοσιν βροτῶν γένος.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1416.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1416.1.text#ἔασον· οὐ γὰρ οὐδὲ γῆς ὑπὸ ζόφον
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1417.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1417.1.text#θεᾶς ἄτιμοι Κύπριδος ἐκ προθυμίας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1418.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1418.1.text#ὀργαὶ κατασκήψουσιν ἐς τὸ σὸν δέμας
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1419.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1419.1.text#σῆς εὐσεβείας κἀγαθῆς φρενὸς χάριν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1420.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1420.1.text#ἐγὼ γὰρ αὐτῆς ἄλλον ἐξ ἐμῆς χερὸς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1421.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1421.1.text#ὃς ἂν μάλιστα φίλτατος κυρῇ βροτῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1422.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1422.1.text#τόξοις ἀφύκτοις τοῖσδε τιμωρήσομαι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1423.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1423.1.text#σοὶ δ', ὦ ταλαίπωρ', ἀντὶ τῶνδε τῶν κακῶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1424.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1424.1.text#τιμὰς μεγίστας ἐν πόλει Τροζηνίᾳ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1425.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1425.1.text#δώσω· κόραι γὰρ ἄζυγες γάμων πάρος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1426.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1426.1.text#κόμας κεροῦνταί σοι, δι' αἰῶνος μακροῦ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1427.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1427.1.text#πένθη μέγιστα δακρύων καρπουμένῳ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1428.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1428.1.text#ἀεὶ δὲ μουσοποιὸς ἐς σὲ παρθένων
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1429.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1429.1.text#ἔσται μέριμνα, κοὐκ ἀνώνυμος πεσὼν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1430.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1430.1.text#ἔρως ὁ Φαίδρας ἐς σὲ σιγηθήσεται.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1431.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1431.1.text#σὺ δ', ὦ γεραιοῦ τέκνον Αἰγέως, λαβὲ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1432.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1432.1.text#σὸν παῖδ' ἐν ἀγκάλαισι καὶ προσέλκυσαι·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1433.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1433.1.text#ἄκων γὰρ ὤλεσάς νιν· ἀνθρώποισι δὲ
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1434.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1434.1.text#θεῶν διδόντων εἰκὸς ἐξαμαρτάνειν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1435.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1435.1.text#καὶ σοὶ παραινῶ πατέρα μὴ στυγεῖν σέθεν,
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1436.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1436.1.text#Ἱππόλυτ'· ἔχεις γὰρ μοῖραν ᾗ διεφθάρης.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1437.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1437.1.text#καὶ χαῖρ'· ἐμοὶ γὰρ οὐ θέμις φθιτοὺς ὁρᾶν
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1438.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1438.1.text#οὐδ' ὄμμα χραίνειν θανασίμοισιν ἐκπνοαῖς·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1439.1.speaker#Ἄρτεμις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1439.1.text#ὁρῶ δέ σ' ἤδη τοῦδε πλησίον κακοῦ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1440.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1440.1.text#χαίρουσα καὶ σὺ στεῖχε, παρθέν' ὀλβία·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1441.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1441.1.text#μακρὰν δὲ λείπεις ῥᾳδίως ὁμιλίαν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1442.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1442.1.text#λύω δὲ νεῖκος πατρὶ χρῃζούσης σέθεν·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1443.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1443.1.text#καὶ γὰρ πάροιθε σοῖς ἐπειθόμην λόγοις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1444.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1444.1.text#αἰαῖ, κατ' ὄσσων κιγχάνει μ' ἤδη σκότος·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1445.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1445.1.text#λαβοῦ, πάτερ, μου καὶ κατόρθωσον δέμας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1446.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1446.1.text#οἴμοι, τέκνον, τί δρᾷς με τὸν δυσδαίμονα;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1447.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1447.1.text#ὄλωλα καὶ δὴ νερτέρων ὁρῶ πύλας.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1448.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1448.1.text#ἦ τὴν ἐμὴν ἄναγνον ἐκλιπὼν χέρα;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1449.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1449.1.text#οὐ δῆτ', ἐπεί σε τοῦδ' ἐλευθερῶ φόνου.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1450.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1450.1.text#τί φῄς; ἀφίης αἵματός μ' ἐλεύθερον;
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1451.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1451.1.text#τὴν τοξόδαμνον Ἄρτεμιν μαρτύρομαι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1452.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1452.1.text#ὦ φίλταθ', ὡς γενναῖος ἐκφαίνῃ πατρί.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1455.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1455.1.text#τοιῶνδε παίδων γνησίων εὔχου τυχεῖν.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1454.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1454.1.text#οἴμοι φρενὸς σῆς εὐσεβοῦς τε κἀγαθῆς.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1453.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1453.1.text#ὦ χαῖρε καὶ σύ, χαῖρε πολλά μοι, πάτερ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1456.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1456.1.text#μή νυν προδῷς με, τέκνον, ἀλλὰ καρτέρει.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1457.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1457.1.text#κεκαρτέρηται τἄμ'· ὄλωλα γάρ, πάτερ.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1458.1.speaker#Ἱππόλυτος
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1458.1.text#κρύψον δέ μου πρόσωπον ὡς τάχος πέπλοις.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1459.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1459.1.text#ὦ κλείν' { Ἀθῆναι Παλλάδος θ' ὁρίσματα, }
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1460.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1460.1.text#οἵου στερήσεσθ' ἀνδρός. ὦ τλήμων ἐγώ·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1461.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1461.1.text#ὡς πολλά, Κύπρι, σῶν κακῶν μεμνήσομαι.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1462.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1462.1.text#κοινὸν τόδ' ἄχος πᾶσι πολίταις
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1463.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1463.1.text#ἦλθεν ἀέλπτως.
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1464.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1464.1.text#πολλῶν δακρύων ἔσται πίτυλος·
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1465.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1465.1.text#τῶν γὰρ μεγάλων ἀξιοπενθεῖς
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1466.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg005.fu.sp:1466.1.text#φῆμαι μᾶλλον κατέχουσιν.
