#!ctsdata
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1.1.text#Ζεὺς μὲν ἀφίκτωρ ἐπίδοι προφρόνως
urn:cts:greekLit:tlg0085.tlg001.fu.sp:2.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:2.1.text#στόλον ἡμέτερον νάιον ἀρθέντ'
urn:cts:greekLit:tlg0085.tlg001.fu.sp:3.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:3.1.text#ἀπὸ προστομίων λεπτοψαμάθων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:4.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:4.1.text#Νείλου.  Δίαν δὲ λιποῦσαι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:5.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:5.1.text#χθόνα σύγχορτον Συρίᾳ  φεύγομεν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:6.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:6.1.text#οὔτιν' ἐφ' αἵματι δημηλασίαν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:7.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:7.1.text#ψήφῳ πόλεως γνωσθεῖσαν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:8.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:8.1.text#ἀλλ' αὐτογενεῖ φυξανορίᾳ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:9.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:9.1.text#γάμον Αἰγύπτου παίδων ἀσεβῆ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:10.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:10.1.text#'ξ'ονοταζόμεναι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:11.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:11.1.text#Δαναὸς δὲ πατὴρ καὶ βούλαρχος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:12.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:12.1.text#καὶ στασίαρχος τάδε πεσσονομῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:13.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:13.1.text#κύδιστ' ἀχέων ἐπέκρανε,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:14.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:14.1.text#φεύγειν ἀνέδην διὰ κῦμ' ἅλιον,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:15.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:15.1.text#κέλσαι δ' Ἄργους γαῖαν, ὅθεν δὴ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:16.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:16.1.text#γένος ἡμέτερον τῆς οἰστροδόνου
urn:cts:greekLit:tlg0085.tlg001.fu.sp:17.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:17.1.text#βοὸς ἐξ ἐπαφῆς κἀξ ἐπιπνοίας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:18.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:18.1.text#Διὸς εὐχόμενον τετέλεσται.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:19.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:19.1.text#τίν' ἂν οὖν χώραν εὔφρονα μᾶλλον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:20.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:20.1.text#τῆσδ' ἀφικοίμεθα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:21.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:21.1.text#σὺν τοῖσδ' ἱκετῶν ἐγχειριδίοις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:22.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:22.1.text#ἐριοστέπτοισι κλάδοισιν;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:23.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:23.1.text#ὦ πόλις, ὦ γῆ, καὶ λευκὸν ὕδωρ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:24.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:24.1.text#ὕπατοί τε θεοί, καὶ βαρύτιμοι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:25.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:25.1.text#χθόνιοι θήκας κατέχοντες,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:26.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:26.1.text#καὶ Ζεὺς σωτὴρ τρίτος, οἰκοφύλαξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:27.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:27.1.text#ὁσίων ἀνδρῶν, δέξασθ' ἱκέτην
urn:cts:greekLit:tlg0085.tlg001.fu.sp:28.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:28.1.text#τὸν θηλυγενῆ στόλον αἰδοίῳ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:29.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:29.1.text#πνεύματι χώρας·  ἀρσενοπληθῆ δ'
urn:cts:greekLit:tlg0085.tlg001.fu.sp:30.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:30.1.text#ἑσμὸν ὑβριστὴν Αἰγυπτογενῆ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:31.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:31.1.text#πρὶν πόδα χέρσῳ τῆ δ' ἐν ἀσώδει
urn:cts:greekLit:tlg0085.tlg001.fu.sp:32.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:32.1.text#θεῖναι, ξὺν ὄχῳ ταχυήρει
urn:cts:greekLit:tlg0085.tlg001.fu.sp:33.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:33.1.text#πέμψατε πόντονδ'·  ἔνθα δὲ λαίλαπι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:34.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:34.1.text#χειμωνοτύπῳ, βροντῇ στεροπῇ τ'
urn:cts:greekLit:tlg0085.tlg001.fu.sp:35.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:35.1.text#ὀμβροφόροισίν τ' ἀνέμοις ἀγρίας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:36.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:36.1.text#ἁλὸς ἀντήσαντες, ὄλοιντο,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:37.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:37.1.text#πρίν ποτε λέκτρων, ὧν θέμις εἴργει,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:38.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:38.1.text#σφετεριξάμενοι πατραδέλφειαν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:39.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:39.1.text#τήνδ' ἀεκόντων ἐπιβῆναι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:40.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:40.1.text#νῦν δ' ἐπικεκλομένα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:41.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:41.1.text#Δῖον πόρτιν ὑπερ-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:42.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:42.1.text#πόντιον τιμάορ', ἶνίν τ'
urn:cts:greekLit:tlg0085.tlg001.fu.sp:43.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:43.1.text#ἀνθονομούσας προγόνου
urn:cts:greekLit:tlg0085.tlg001.fu.sp:44.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:44.1.text#βοὸς ἐξ ἐπιπνοίας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:45.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:45.1.text#Ζηνὸς ἔφαψιν· ἐπωνυμίᾳ δ'
urn:cts:greekLit:tlg0085.tlg001.fu.sp:46.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:46.1.text#ἐπεκραίνετο μόρσιμος αἰὼν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:47.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:47.1.text#εὐλόγως,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:48.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:48.1.text#Ἔπαφόν τ' ἐγέννασεν·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:49.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:49.1.text#ὅντ'   ἐπιλεξαμένα,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:50.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:50.1.text#νῦν ἐν ποιονόμοις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:51.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:51.1.text#ματρὸς ἀρχαίας τόποις τῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:52.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:52.1.text#πρόσθε πόνων μνασαμένα,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:53.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:53.1.text#τά τε νῦν ἐπιδείξω
urn:cts:greekLit:tlg0085.tlg001.fu.sp:54.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:54.1.text#πιστὰ τεκμήρια γαιονόμοις,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:55.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:55.1.text#τὰ δ' ἄελπτά περ ὄντα φανεῖται.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:56.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:56.1.text#γνώσεται
urn:cts:greekLit:tlg0085.tlg001.fu.sp:57.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:57.1.text#δὲ λόγους τις ἐν μάκει.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:58.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:58.1.text#εἰ δὲ κυρεῖ τις πέλας οἰωνοπόλων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:59.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:59.1.text#ἔγγαιος οἶκτον [ οἰκτρὸν ] ἀίων,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:60.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:60.1.text#δοξάσει τις ἀκούειν ὄπα τᾶς Τηρεΐας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:61.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:61.1.text#Μήτιδος οἰκτρᾶς ἀλόχου,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:62.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:62.1.text#κιρκηλάτου τ' ἀηδόνος,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:63.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:63.1.text#ἅτ' ἀπὸ χλωρῶν πετάλων ἐργομένα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:64.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:64.1.text#πενθεῖ μὲν οἶκτον ἠθέων·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:65.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:65.1.text#ξυντίθησι δὲ παιδὸς μόρον, ὡς αὐτοφόνως
urn:cts:greekLit:tlg0085.tlg001.fu.sp:66.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:66.1.text#ὤλετο πρὸς χειρὸς ἕθεν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:67.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:67.1.text#δυσμάτορος κότου τυχών·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:68.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:68.1.text#τὼς καὶ ἐγὼ φιλόδυρ-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:69.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:69.1.text#τος Ἰαονίοισι νόμοισι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:70.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:70.1.text#δάπτω τὰν ἁπαλὰν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:71.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:71.1.text#Νειλοθερῆ παρειὰν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:72.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:72.1.text#ἀπειρόδακρύν τε καρδίαν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:73.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:73.1.text#γοεδνὰ δ' ἀνθεμίζομαι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:74.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:74.1.text#δειμαίνουσα φίλους, τᾶσδε φυγᾶς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:75.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:75.1.text#ἀερίας ἀπὸ γᾶς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:76.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:76.1.text#εἴ τις ἐστὶ κηδεμών.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:77.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:77.1.text#ἀλλά, θεοὶ γενέται
urn:cts:greekLit:tlg0085.tlg001.fu.sp:78.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:78.1.text#κλύετ' εὖ τὸ δίκαιον ἰδόντες·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:79.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:79.1.text#ἥβᾳ μὴ τέλεον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:80.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:80.1.text#δόντες ἔχειν παρ' αἶσαν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:81.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:81.1.text#ὕβριν δ' ἑτοίμως στυγοῦντες,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:82.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:82.1.text#πέλοιτ' ἂν ἔνδικοι γάμοις.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:83.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:83.1.text#ἔστι δὲ κἀκ πολέμου τειρομένοις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:84.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:84.1.text#βωμὸς ἀρῆς φυγάσιν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:85.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:85.1.text#ῥῦμα, δαιμόνων σέβας.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:86.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:86.1.text#εὖ δ' εἴη Διόθεν παναληθῶς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:87.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:87.1.text#Διὸς ἵμερος οὐκ εὐθήρατος ἐτύχθη.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:88.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:88.1.text#παντᾷ  τοι φλεγέθει
urn:cts:greekLit:tlg0085.tlg001.fu.sp:89.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:89.1.text#κἀν σκότῳ μελαίνᾳ ξὺν τύχᾳ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:90.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:90.1.text#μερόπεσσι λαοῖς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:91.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:91.1.text#πίπτει δ' ἀσφαλὲς οὐδ' ἐπὶ νώτῳ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:92.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:92.1.text#κορυφᾷ  Διὸς εἰ κρανθῇ , πρᾶγμα τέλειον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:93.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:93.1.text#δαυλοὶ γὰρ πραπίδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:94.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:94.1.text#δάσκιοί τε τείνουσιν πόροι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:95.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:95.1.text#κατιδεῖν ἄφραστοι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:96.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:96.1.text#ἰάπτει δ' ἐλπίδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:97.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:97.1.text#ἀφ' ὑψιπύργων πανώλεις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:98.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:98.1.text#βροτούς, βίαν δ'
urn:cts:greekLit:tlg0085.tlg001.fu.sp:99.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:99.1.text#οὔτιν' ἐξοπλίζει·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:100.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:100.1.text#πᾶν ἄπονον δαιμονίων.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:101.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:101.1.text#ἥμενος ὃν φρόνημά πως
urn:cts:greekLit:tlg0085.tlg001.fu.sp:102.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:102.1.text#αὐτόθεν ἐξέπραξεν ἔμπας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:103.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:103.1.text#ἑδράνων ἐφ' ἁγνῶν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:104.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:104.1.text#ἰδέσθω δ' εἰς ὕβριν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:105.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:105.1.text#βρότειον, οἵα  νεάζει
urn:cts:greekLit:tlg0085.tlg001.fu.sp:106.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:106.1.text#πυθμὴν δι' ἁ-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:107.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:107.1.text#μὸν γάμον τεθαλὼς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:108.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:108.1.text#δυσπαραβούλοισι φρεσίν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:109.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:109.1.text#καὶ διάνοιαν μαινόλιν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:110.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:110.1.text#κέντρον ἔχων ἄφυκτον, ἄταν δ'
urn:cts:greekLit:tlg0085.tlg001.fu.sp:111.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:111.1.text#ἀπάτᾳ μεταγνούς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:112.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:112.1.text#τοιαῦτα πάθεα μέλεα θρεομένα λέγω
urn:cts:greekLit:tlg0085.tlg001.fu.sp:113.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:113.1.text#λιγέα βαρέα δακρυοπετῆ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:114.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:114.1.text#ἰὴ ἰή,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:115.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:115.1.text#ἰηλέμοισιν ἐμπρεπῆ· [ θρεομένη μέλη ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:116.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:116.1.text#ζῶσα γόοις με τιμῶ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:117.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:117.1.text#ἱλεοῦμαι μὲν Ἀπίαν βοῦνιν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:118.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:118.1.text#καρβᾶνα δ' αὐδὰν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:119.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:119.1.text#εὖ, γᾶ, κοννεῖς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:120.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:120.1.text#πολλάκι δ' ἐμπίτνω ξὺν λακίδι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:121.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:121.1.text#λινοσινεῖ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:122.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:122.1.text#Σιδονία  καλύπτρᾳ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:123.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:123.1.text#θεοῖς δ' ἐναγέα τέλεα πελομένων καλῶς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:124.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:124.1.text#ἐπίδρομ', ὁπόθι θάνατος ἀπῇ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:125.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:125.1.text#ἰὼ ἰώ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:126.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:126.1.text#ἰὼ δυσάγκριτοι πόνοι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:127.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:127.1.text#ποῖ τόδε κῦμ' ἀπάξει;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:128.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:128.1.text#ἱλεοῦμαι μὲν Ἀπίαν βοῦνιν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:129.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:129.1.text#καρβᾶνα δ' αὐδὰν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:130.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:130.1.text#εὖ, γᾶ, κοννεῖς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:131.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:131.1.text#πολλάκι δ' ἐμπίτνω ξὺν λακίδι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:132.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:132.1.text#λινοσινεῖ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:133.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:133.1.text#Σιδονίᾳ καλύπτρᾳ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:134.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:134.1.text#πλάτα μὲν οὖν  λινορραφής τε
urn:cts:greekLit:tlg0085.tlg001.fu.sp:135.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:135.1.text#δόμος ἅλα στέγων δορὸς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:136.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:136.1.text#ἀχείματόν μ' ἔπεμπε σὺν πνοαῖς·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:137.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:137.1.text#οὐδὲ μέμφομαι·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:138.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:138.1.text#τελευτὰς δ' ἐν χρόνῳ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:139.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:139.1.text#πατήρ μοι παντόπτας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:140.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:140.1.text#πρευμενεῖς κτίσειεν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:141.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:141.1.text#σπέρμα  σεμνᾶς μέγα ματρὸς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:142.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:142.1.text#εὐνὰς ἀνδρῶν, ἒ ἔ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:143.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:143.1.text#ἄγαμον ἀδάματον ἐκφυγεῖν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:144.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:144.1.text#θέλουσα δ'   αὖ  θέλουσαν ἁγνά  μ'
urn:cts:greekLit:tlg0085.tlg001.fu.sp:145.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:145.1.text#ἐπιδέτω Διὸς κόρα,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:146.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:146.1.text#ἔχουσα σέμν' ἐνώπι' ἀσφαλῶς,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:147.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:147.1.text#παντὶ δὲ σθένει
urn:cts:greekLit:tlg0085.tlg001.fu.sp:148.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:148.1.text#διωγμοῖς ἀσχαλῶσ'
urn:cts:greekLit:tlg0085.tlg001.fu.sp:149.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:149.1.text#ἀδμήτας ἀδμήτα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:150.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:150.1.text#ῥύσιος γενέσθω,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:151.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:151.1.text#σπέρμα σεμνᾶς μέγα ματρὸς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:152.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:152.1.text#εὐνὰς ἀνδρῶν, ἒ ἔ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:153.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:153.1.text#ἄγαμον ἀδάματον ἐκφυγεῖν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:154.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:154.1.text#εἰ δὲ μή, μελανθὲς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:155.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:155.1.text#ἡλιόκτυπον γένος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:156.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:156.1.text#τὸν γάιον,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:157.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:157.1.text#τὸν πολυξενώτατον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:158.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:158.1.text#Ζῆνα τῶν κεκμηκότων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:159.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:159.1.text#ἱξόμεθα σὺν κλάδοις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:160.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:160.1.text#ἀρτάναις θανοῦσαι,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:161.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:161.1.text#μὴ τυχοῦσαι θεῶν Ὀλυμπίων.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:162.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:162.1.text#ἆ Ζήν, Ἰοῦς ἰῷ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:163.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:163.1.text#μῆνις μάστειρ' ἐκ θεῶν·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:164.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:164.1.text#κοννῶ δ' ἄγαν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:165.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:165.1.text#γαμετᾶς οὐρανόνικον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:166.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:166.1.text#χαλεποῦ γὰρ ἐκ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:167.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:167.1.text#πνεύματος εἶσι χειμών.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:168.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:168.1.text#καὶ τότ'  οὐ δικαίοις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:169.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:169.1.text#Ζεὺς ἐνέξεται λόγοις,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:170.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:170.1.text#τὸν τᾶς βοὸς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:171.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:171.1.text#παῖδ' ἀτιμάσας, τὸν αὐ-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:172.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:172.1.text#τός ποτ' ἔκτισεν γόνῳ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:173.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:173.1.text#νῦν ἔχων παλίντροπον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:174.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:174.1.text#ὄψιν ἐν λιταῖσιν;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:175.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:175.1.text#ὑψόθεν δ' εὖ κλύοι καλούμενος.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:162.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:162.1.text#ἆ Ζήν, Ἰοῦς ἰῶ ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:163.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:163.1.text#μῆνις μάστειρ' ἐκ θεῶν·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:164.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:164.1.text#κοννῶ δ' ἄγαν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:165.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:165.1.text#γαμετᾶς οὐρανόνικον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:166.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:166.1.text#χαλεποῦ γὰρ ἐκ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:167.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:167.1.text#πνεύματος εἶσι χειμών.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:176.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:176.1.text#παῖδες, φρονεῖν χρή·  ξὺν φρονοῦντι δ' ἥκετε
urn:cts:greekLit:tlg0085.tlg001.fu.sp:177.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:177.1.text#πιστῷ γέροντι τῷ δε ναυκλήρῳ πατρί.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:178.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:178.1.text#καὶ τἀπὶ χέρσου νῦν προμηθίαν λαβὼν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:179.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:179.1.text#αἰνῶ φυλάξαι τἄμ' ἔπη δελτουμένας.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:180.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:180.1.text#ὁρῶ κόνιν, ἄναυδον ἄγγελον στρατοῦ·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:181.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:181.1.text#σύριγγες οὐ σιγῶσιν ἀξονήλατοι·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:182.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:182.1.text#ὄχλον δ' ὑπασπιστῆρα καὶ δορυσσόον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:183.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:183.1.text#λεύσσω, ξὺν ἵπποις καμπύλοις τ' ὀχήμασιν·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:184.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:184.1.text#τάχ' ἂν πρὸς ἡμᾶς τῆσδε γῆς ἀρχηγέται
urn:cts:greekLit:tlg0085.tlg001.fu.sp:185.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:185.1.text#ὀπτῆρες εἶεν ἀγγέλων πεπυσμένοι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:186.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:186.1.text#ἀλλ' εἴτ' ἀπήμων εἴτε καὶ τεθηγμένος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:187.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:187.1.text#ὠμῇ ξὺν ὀργῇ τόνδ' ἐπόρνυται στόλον,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:188.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:188.1.text#ἄμεινόν ἐστι παντὸς εἵνεκ', ὦ κόραι,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:189.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:189.1.text#πάγον προσίζειν τόνδ' ἀγωνίων θεῶν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:190.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:190.1.text#κρεῖσσον δὲ πύργου βωμός, ἄρρηκτον σάκος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:191.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:191.1.text#ἀλλ' ὡς τάχιστα βᾶτε, καὶ λευκοστεφεῖς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:192.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:192.1.text#ἱκετηρίας, ἁγάλματ' αἰδοίου Διός,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:193.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:193.1.text#σεμνῶς ἔχουσαι διὰ χερῶν εὐωνύμων,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:194.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:194.1.text#αἰδοῖα καὶ γοεδνὰ καὶ ζαχρεῖ' ἔπη
urn:cts:greekLit:tlg0085.tlg001.fu.sp:195.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:195.1.text#ξένους ἀμείβεσθ', ὡς ἐπήλυδας πρέπει,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:196.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:196.1.text#τορῶς λέγουσαι τάσδ' ἀναιμάκτους φυγάς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:197.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:197.1.text#φθογγῇ δ' ἑπέσθω πρῶτα μὲν τὸ μὴ θρασύ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:198.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:198.1.text#τὸ μὴ μάταιον δ' ἐκ μετωποσωφρόνων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:199.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:199.1.text#ἴτω προσώπων ὄμματος παρ' ἡσύχου.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:200.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:200.1.text#καὶ μὴ πρόλεσχος μηδ' ἐφολκὸς ἐν λόγῳ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:201.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:201.1.text#γένῃ. τὸ τῇδε κάρτ' ἐπίφθονον γένος.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:202.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:202.1.text#μέμνησο δ' εἴκειν· χρεῖος εἶ ξένη φυγάς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:203.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:203.1.text#θρασυστομεῖν γὰρ οὐ πρέπει τοὺς ἥσσονας.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:204.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:204.1.text#πάτερ, φρονούντως πρὸς φρονοῦντας ἐννέπεις.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:205.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:205.1.text#φυλάξομαι δὲ τάσδε μεμνῆσθαι σέθεν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:206.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:206.1.text#κεδνὰς ἐφετμάς. Ζεὺς δὲ γεννήτωρ ἴδοι·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:207.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:207.1.text#ἴδοιτο δῆτα πρευμενοῦς ἀπ' ὄμματος·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:208.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:208.1.text#θέλοιμ' ἂν ἤδη σοὶ πέλας θρόνους ἔχειν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:209.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:209.1.text#μή νυν σχόλαζε, μηχανῆς δ' ἔστω κράτος.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:210.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:210.1.text#ὦ Ζεῦ, κόπων οἴκτιρε μὴ ἀπολωλότας.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:211.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:211.1.text#κείνου θέλοντος εὖ τελευτήσει τάδε.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:211.2.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:211.2.text#[ … ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:212.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:212.1.text#καὶ Ζηνὸς ὄρνιν τόνδε νῦν κικλῄσκετε.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:213.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:213.1.text#καλοῦμεν αὐγὰς ἡλίου σωτηρίους,—
urn:cts:greekLit:tlg0085.tlg001.fu.sp:214.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:214.1.text#ἁγνόν τ' Ἀπόλλω, φυγάδ' ἀπ' οὐρανοῦ θεόν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:215.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:215.1.text#εἰδὼς ἂν αἶσαν τήνδε συγγνοίη βροτοῖς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:216.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:216.1.text#συγγνοῖτο δῆτα καὶ παρασταίη πρόφρων.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:217.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:217.1.text#τίν' οὖν κικλῄσκω τῶνδε δαιμόνων ἔτι;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:218.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:218.1.text#ὁρῶ τρίαιναν τήνδε σημεῖον θεοῦ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:219.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:219.1.text#ἀλλ' εὖ τ' ἔπεμψεν εὖ τε δεξάσθω χθονί.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:220.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:220.1.text#Ἑρμῆς ὅδ' ἄλλος τοῖσιν Ἑλλήνων νόμοις.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:221.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:221.1.text#ἐλευθέροις νυν ἐσθλὰ κηρυκευέτω.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:222.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:222.1.text#πάντων δ' ἀνάκτων τῶνδε κοινοβωμίαν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:223.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:223.1.text#σέβεσθ'· ἐν ἁγνῷ δ' ἑσμὸς ὡς πελειάδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:224.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:224.1.text#ἵζεσθε κίρκων τῶν ὁμοπτέρων φόβῳ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:225.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:225.1.text#ἐχθρῶν ὁμαίμων καὶ μιαινόντων γένος.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:226.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:226.1.text#ὄρνιθος ὄρνις πῶς ἂν ἁγνεύοι φαγών;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:227.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:227.1.text#πῶς δ' ἂν γαμῶν ἄκουσαν ἄκοντος πάρα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:228.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:228.1.text#ἁγνὸς γένοιτ' ἄν; οὐδὲ μὴ 'ν Ἅιδου θανὼν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:229.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:229.1.text#φύγῃ ματαίων αἰτίας, πράξας τάδε.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:230.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:230.1.text#κἀκεῖ δικάζει τἀπλακήμαθ', ὡς λόγος,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:231.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:231.1.text#Ζεὺς ἄλλος ἐν καμοῦσιν ὑστάτας δίκας.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:232.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:232.1.text#σκοπεῖτε, κἀμείβεσθε τόνδε τὸν τρόπον,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:233.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:233.1.text#ὅπως ἂν ὑμῖν πρᾶγος εὖ νικᾷ τόδε.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:234.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:234.1.text#ποδαπὸν ὅμιλον τόνδ' ἀνελληνόστολον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:235.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:235.1.text#πέπλοισι βαρβάροισι καὶ πυκνώμασι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:236.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:236.1.text#χλίοντα προσφωνοῦμεν; οὐ γὰρ Ἀργολὶς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:237.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:237.1.text#ἐσθὴς γυναικῶν οὐδ' ἀφ' Ἑλλάδος τόπων.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:238.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:238.1.text#ὅπως δὲ χώραν οὔτε κηρύκων ὕπο,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:239.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:239.1.text#ἀπρόξενοί τε, νόσφιν ἡγητῶν, μολεῖν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:240.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:240.1.text#ἔτλητ' ἀτρέστως, τοῦτο θαυμαστὸν πέλει.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:241.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:241.1.text#κλάδοι γε μὲν δὴ κατὰ νόμους ἀφικτόρων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:242.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:242.1.text#κεῖνται παρ' ὑμῖν πρὸς θεοῖς ἀγωνίοις·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:243.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:243.1.text#μόνον τόδ' Ἑλλὰς χθὼν συνοίσεται στόχῳ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:244.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:244.1.text#καὶ τἄλλα πόλλ' ἔτ' εἰκάσαι δίκαιον ἦν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:245.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:245.1.text#εἰ μὴ παρόντι φθόγγος ἦν ὁ σημανῶν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:246.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:246.1.text#εἴρηκας ἀμφὶ κόσμον ἀψευδῆ λόγον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:247.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:247.1.text#ἐγὼ δὲ πρὸς σὲ πότερον ὡς ἔτην λέγω,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:248.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:248.1.text#ἢ ῥήτορ' ἱεροράβδον, ἢ πόλεως ἀγόν;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:249.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:249.1.text#πρὸς ταῦτ' ἀμείβου καὶ λέγ' εὐθαρσὴς ἐμοί.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:250.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:250.1.text#τοῦ γηγενοῦς γάρ εἰμ' ἐγὼ Παλαίχθονος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:251.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:251.1.text#ἶνις Πελασγός, τῆσδε γῆς ἀρχηγέτης.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:252.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:252.1.text#ἐμοῦ δ' ἄνακτος εὐλόγως ἐπώνυμον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:253.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:253.1.text#γένος Πελασγῶν τήνδε καρποῦται χθόνα.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:254.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:254.1.text#καὶ πᾶσαν αἶαν, ἧς δι' ἁγνὸς ἔρχεται
urn:cts:greekLit:tlg0085.tlg001.fu.sp:255.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:255.1.text#Στρυμών, τὸ πρὸς δύνοντος ἡλίου, κρατῶ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:256.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:256.1.text#ὁρίζομαι δὲ τήν τε Περραίβων χθόνα,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:257.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:257.1.text#Πίνδου τε τἀπέκεινα, Παιόνων πέλας,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:258.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:258.1.text#ὄρη τε Δωδωναῖα.  συντέμνει δ' ὅρος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:259.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:259.1.text#ὑγρᾶς θαλάσσης· τῶνδε τἀπὶ τάδε κρατῶ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:260.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:260.1.text#αὐτῆς δὲ χώρας  Ἀπίας πέδον τόδε
urn:cts:greekLit:tlg0085.tlg001.fu.sp:261.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:261.1.text#πάλαι κέκληται φωτὸς ἰατροῦ χάριν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:262.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:262.1.text#Ἆπις γὰρ ἐλθὼν ἐκ πέρας Ναυπακτίας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:263.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:263.1.text#ἰατρόμαντις παῖς Ἀπόλλωνος χθόνα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:264.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:264.1.text#τήνδ' ἐκκαθαίρει κνωδάλων βροτοφθόρων,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:265.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:265.1.text#τὰ δὴ παλαιῶν αἱμάτων μιάσμασιν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:266.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:266.1.text#χρανθεῖσ' ἀνῆκε γαῖα μηνιταῖ' ἄχη
urn:cts:greekLit:tlg0085.tlg001.fu.sp:267.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:267.1.text#δρακονθόμιλον δυσμενῆ ξυνοικίαν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:268.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:268.1.text#τούτων ἄκη τομαῖα καὶ λυτήρια
urn:cts:greekLit:tlg0085.tlg001.fu.sp:269.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:269.1.text#πράξας ἀμέμπτως Ἆπις Ἀργείᾳ χθονὶ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:270.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:270.1.text#μνήμην ποτ' ἀντίμισθον ηὕρετ' ἐν λιταῖς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:271.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:271.1.text#ἔχουσα δ' ἤδη τἀπ' ἐμοῦ τεκμήρια
urn:cts:greekLit:tlg0085.tlg001.fu.sp:272.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:272.1.text#γένος τ' ἂν ἐξεύχοιο καὶ λέγοις πρόσω.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:273.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:273.1.text#μακράν γε μὲν δὴ ῥῆσιν οὐ στέργει πόλις.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:274.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:274.1.text#βραχὺς τορός θ' ὁ μῦθος· Ἀργεῖαι γένος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:275.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:275.1.text#ἐξευχόμεσθα, σπέρματ' εὐτέκνου βοός·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:276.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:276.1.text#καὶ ταῦτ' ἀληθῆ πάντα προσφύσω λόγῳ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:277.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:277.1.text#ἄπιστα μυθεῖσθ', ὦ ξέναι, κλύειν ἐμοί,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:278.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:278.1.text#ὅπως τόδ' ὑμῖν ἐστιν Ἀργεῖον γένος.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:279.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:279.1.text#Λιβυστικαῖς γὰρ μᾶλλον ἐμφερέστεραι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:280.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:280.1.text#γυναιξίν ἐστε κοὐδαμῶς ἐγχωρίαις.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:281.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:281.1.text#καὶ Νεῖλος ἂν θρέψειε τοιοῦτον φυτόν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:282.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:282.1.text#Κύπριος χαρακτήρ τ' ἐν γυναικείοις τύποις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:283.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:283.1.text#εἰκὼς πέπληκται τεκτόνων πρὸς ἀρσένων·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:284.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:284.1.text#τοίας τ' ἀκούω νομάδας ἱπποβάμοσιν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:285.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:285.1.text#εἶναι καμήλοις ἀστραβιζούσας, χθόνα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:286.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:286.1.text#παρ' Αἰθίοψιν ἀστυγειτονουμένας.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:287.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:287.1.text#καὶ τὰς ἀνάνδρους κρεοβόρους τ' Ἀμαζόνας,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:288.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:288.1.text#εἰ τοξοτευχεῖς ἦτε, κάρτ' ἂν ᾔκασα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:289.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:289.1.text#ὑμᾶς.  διδαχθεὶς δ' ἂν τόδ' εἰδείην πλέον,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:290.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:290.1.text#ὅπως γένεθλον σπέρμα τ' Ἀργεῖον τὸ σόν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:291.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:291.1.text#κλῃδοῦχον Ἥρας φασὶ δωμάτων ποτὲ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:292.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:292.1.text#Ἰὼ γενέσθαι τῇ δ' ἐν Ἀργείᾳ χθονί;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:293.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:293.1.text#ἦν ὡς μάλιστα, καὶ φάτις πολλὴ κρατεῖ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:295.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:295.1.text#μὴ καὶ λόγος τις Ζῆνα μειχθῆναι βροτῷ;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:296.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:296.1.text#κἄκρυπτά γ' Ἥρας ταῦτα τἀμπαλάγματα.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:297.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:297.1.text#πῶς οὖν τελευτᾷ βασιλέων νείκη τάδε;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:298.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:298.1.text#βοῦν τὴν γυναῖκ' ἔθηκεν Ἀργεία θεός.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:300.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:300.1.text#οὔκουν πελάζει Ζεὺς ἐπ'  εὐκραίρῳ βοΐ;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:301.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:301.1.text#φασίν, πρέποντα βουθόρῳ ταύρῳ δέμας.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:302.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:302.1.text#τί δῆτα πρὸς ταῦτ' ἄλοχος ἰσχυρὰ Διός;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:303.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:303.1.text#τὸν πάνθ' ὁρῶντα φύλακ' ἐπέστησεν βοΐ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:304.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:304.1.text#ποῖον πανόπτην οἰοβουκόλον λέγεις;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:305.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:305.1.text#Ἄργον, τὸν Ἑρμῆς παῖδα γῆς κατέκτανεν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:306.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:306.1.text#τί οὖν ἔτευξεν ἄλλο δυσπότμῳ βοΐ;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:307.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:307.1.text#βοηλάτην μύωπα κινητήριον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:308.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:308.1.text#οἶστρον καλοῦσιν αὐτὸν οἱ Νείλου πέλας.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:309.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:309.1.text#τοιγάρ νιν ἐκ γῆς ἤλασεν μακρῷ  δρόμῳ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:310.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:310.1.text#καὶ ταῦτ' ἔλεξας πάντα συγκόλλως ἐμοί.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:311.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:311.1.text#καὶ μὴν Κάνωβον κἀπὶ Μέμφιν ἵκετο.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:312.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:312.1.text#καὶ Ζεύς γ' ἐφάπτωρ χειρὶ φιτύει γόνον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:313.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:313.1.text#τίς οὖν ὁ Δῖος πόρτις εὔχεται βοός;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:315.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:315.1.text#Ἔπαφος ἀληθῶς ῥυσίων ἐπώνυμος.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:315.2.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:315.2.text#[ … ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:317.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:317.1.text#Λιβύη, μέγιστον γῆς πέδον καρπουμένη.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:317.2.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:317.2.text#[ … ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:317.3.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:317.3.text#[ … ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:318.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:318.1.text#τίν' οὖν ἔτ' ἄλλον τῆσδε βλαστημὸν λέγεις;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:319.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:319.1.text#Βῆλον δίπαιδα πατέρα τοῦδ' ἐμοῦ πατρός.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:320.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:320.1.text#τὸ πάνσοφον νῦν ὄνομα τοῦτό μοι φράσον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:321.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:321.1.text#Δαναός, ἀδελφὸς δ' ἐστὶ πεντηκοντάπαις.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:322.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:322.1.text#καὶ τοῦδ' ἄνοιγε τοὔνομ' ἀφθόνῳ λόγῳ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:323.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:323.1.text#Αἴγυπτος.  εἰδὼς δ' ἁμὸν ἀρχαῖον γένος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:324.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:324.1.text#πράσσοις ἂν ὡς Ἀργεῖον ἀνστήσῃς στόλον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:325.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:325.1.text#δοκεῖτε δή μοι τῆσδε κοινωνεῖν χθονὸς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:326.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:326.1.text#τἀρχαῖον.  ἀλλὰ πῶς πατρῷα δώματα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:327.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:327.1.text#λιπεῖν ἔτλητε; τίς κατέσκηψεν τύχη;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:328.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:328.1.text#ἄναξ Πελασγῶν, αἰόλ' ἀνθρώπων κακά.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:329.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:329.1.text#πόνου δ' ἴδοις ἂν οὐδαμοῦ ταὐτὸν πτερόν·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:330.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:330.1.text#ἐπεὶ τίς ηὔχει τήνδ' ἀνέλπιστον φυγὴν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:331.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:331.1.text#κέλσειν ἐς Ἄργος κῆδος ἐγγενὲς τὸ πρίν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:332.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:332.1.text#ἔχθει μεταπτοιοῦσαν εὐναίων γάμων;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:333.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:333.1.text#τί φὴς ἱκνεῖσθαι τῶνδ' ἀγωνίων θεῶν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:334.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:334.1.text#λευκοστεφεῖς ἔχουσα νεοδρέπτους κλάδους;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:335.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:335.1.text#ὡς μὴ γένωμαι δμωὶς Αἰγύπτου γένει.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:336.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:336.1.text#πότερα κατ' ἔχθραν, ἢ τὸ μὴ θέμις λέγεις;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:337.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:337.1.text#τίς δ' ἂν φίλους ὠνοῖτο τοὺς κεκτημένους;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:338.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:338.1.text#σθένος μὲν οὕτως μεῖζον αὔξεται βροτοῖς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:339.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:339.1.text#καὶ δυστυχούντων γ' εὐμαρὴς ἀπαλλαγή.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:340.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:340.1.text#πῶς οὖν πρὸς ὑμᾶς εὐσεβὴς ἐγὼ πέλω;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:341.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:341.1.text#αἰτοῦσι μὴ 'κδοὺς παισὶν Αἰγύπτου πάλιν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:342.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:342.1.text#βαρέα σύ γ' εἶπας, πόλεμον ἄρασθαι νέον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:343.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:343.1.text#ἀλλ' ἡ δίκη γε ξυμμάχων ὑπερστατεῖ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:344.1.speaker#βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:344.1.text#εἴπερ γ' ἀπ' ἀρχῆς πραγμάτων κοινωνὸς ἦν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:345.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:345.1.text#αἰδοῦ σὺ πρύμναν πόλεος ὧδ' ἐστεμμένην.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:346.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:346.1.text#πέφρικα λεύσσων τάσδ' ἕδρας κατασκίους.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:347.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:347.1.text#βαρύς γε μέντοι Ζηνὸς ἱκεσίου κότος.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:348.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:348.1.text#Παλαίχθονος τέκος, κλῦθί μου
urn:cts:greekLit:tlg0085.tlg001.fu.sp:349.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:349.1.text#πρόφρονι καρδίᾳ,   Πελασγῶν ἄναξ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:350.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:350.1.text#ἴδε με τὰν ἱκέτιν φυγάδα περίδρομον,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:351.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:351.1.text#λυκοδίωκτον ὡς δάμαλιν ἂμ πέτραις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:352.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:352.1.text#ἠλιβάτοις, ἵν' ἀλκᾷ πίσυνος μέμυ-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:353.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:353.1.text#κε φράζουσα βοτῆρι μόχθους.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:354.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:354.1.text#ὁρῶ κλάδοισι νεοδρόποις κατάσκιον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:355.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:355.1.text#νεύονθ' ὅμιλον τόνδ' ἀγωνίων θεῶν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:356.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:356.1.text#εἴη δ' ἄνατον πρᾶγμα τοῦτ' ἀστοξένων.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:357.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:357.1.text#μηδ' ἐξ ἀέλπτων κἀπρομηθήτων πόλει
urn:cts:greekLit:tlg0085.tlg001.fu.sp:358.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:358.1.text#νεῖκος γένηται· τῶν γὰρ οὐ δεῖται πόλις.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:359.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:359.1.text#ἴδοιτο δῆτ' ἄνατον φυγὰν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:360.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:360.1.text#ἱκεσία Θέμις Διὸς κλαρίου.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:361.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:361.1.text#σὺ δὲ παρ' ὀψιγόνου μάθε γεραιόφρων·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:362.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:362.1.text#ποτιτρόπαιον αἰδόμενος { οὖνπερ }
urn:cts:greekLit:tlg0085.tlg001.fu.sp:363.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:363.1.text#{ ἱεροδόκα } [ … ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:364.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:364.1.text#θεῶν λήματ' ἀπ'  ἀνδρὸς ἁγνοῦ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:365.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:365.1.text#οὔτοι κάθησθε δωμάτων ἐφέστιοι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:366.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:366.1.text#ἐμῶν.  τὸ κοινὸν δ' εἰ μιαίνεται πόλις,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:367.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:367.1.text#ξυνῇ μελέσθω λαὸς ἐκπονεῖν ἄκη.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:368.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:368.1.text#ἐγὼ δ' ἂν οὐ κραίνοιμ' ὑπόσχεσιν πάρος,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:369.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:369.1.text#ἀστοῖς δὲ πᾶσι τῶνδε κοινώσας πέρι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:370.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:370.1.text#σύ τοι πόλις, σὺ δὲ τὸ δάμιον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:371.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:371.1.text#πρύτανις ἄκριτος ὤν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:372.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:372.1.text#κρατύνεις βωμόν, ἑστίαν χθονός,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:373.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:373.1.text#μονοψήφοισι νεύμασιν σέθεν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:374.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:374.1.text#μονοσκήπτροισι δ' ἐν θρόνοις χρέος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:375.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:375.1.text#πᾶν ἐπικραίνεις· ἄγος φυλάσσου.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:376.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:376.1.text#ἄγος μὲν εἴη τοῖς ἐμοῖς παλιγκότοις,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:377.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:377.1.text#ὑμῖν δ' ἀρήγειν οὐκ ἔχω βλάβης ἄτερ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:378.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:378.1.text#οὐδ' αὖ τόδ' εὖφρον, τάσδ' ἀτιμάσαι λιτάς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:379.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:379.1.text#ἀμηχανῶ δὲ καὶ φόβος μ' ἔχει φρένας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:380.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:380.1.text#δρᾶσαί τε μὴ δρᾶσαί τε καὶ τύχην ἑλεῖν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:381.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:381.1.text#τὸν ὑψόθεν σκοπὸν ἐπισκόπει,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:382.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:382.1.text#φύλακα πολυπόνων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:383.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:383.1.text#βροτῶν, οἳ τοῖς πέλας προσήμενοι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:384.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:384.1.text#δίκας οὐ τυγχάνουσιν ἐννόμου.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:385.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:385.1.text#μένει τοι Ζηνὸς ἱκταίου κότος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:386.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:386.1.text#δυσπαραθέλκτους παθόντος οἴκτοις.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:387.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:387.1.text#εἴ τοι κρατοῦσι παῖδες Αἰγύπτου σέθεν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:388.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:388.1.text#νόμῳ πόλεως, φάσκοντες ἐγγύτατα γένους
urn:cts:greekLit:tlg0085.tlg001.fu.sp:389.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:389.1.text#εἶναι, τίς ἂν τοῖσδ' ἀντιωθῆναι θέλοι;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:390.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:390.1.text#δεῖ τοί σε φεύγειν κατὰ νόμους τοὺς οἴκοθεν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:391.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:391.1.text#ὡς οὐκ ἔχουσιν κῦρος οὐδὲν ἀμφὶ σοῦ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:392.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:392.1.text#μή τί ποτ' οὖν γενοίμαν ὑποχείριος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:393.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:393.1.text#κράτεσιν ἀρσένων.  ὕπαστρον δέ τοι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:394.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:394.1.text#μῆχαρ ὁρίζομαι γάμου δύσφρονος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:395.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:395.1.text#φυγάν· ξύμμαχον δ' ἑλόμενος δίκαν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:396.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:396.1.text#κρῖνε σέβας τὸ πρὸς θεῶν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:397.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:397.1.text#οὐκ εὔκριτον τὸ κρῖμα. μή μ' αἱροῦ κριτήν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:398.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:398.1.text#εἶπον δὲ καὶ πρίν, οὐκ ἄνευ δήμου τάδε
urn:cts:greekLit:tlg0085.tlg001.fu.sp:399.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:399.1.text#πράξαιμ' ἄν, οὐδέ περ κρατῶν, μὴ καί ποτε
urn:cts:greekLit:tlg0085.tlg001.fu.sp:400.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:400.1.text#εἴπῃ λεώς, εἴ πού τι μὴ τοῖον τύχοι,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:401.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:401.1.text#"ἐπήλυδας τιμῶν ἀπώλεσας πόλιν."
urn:cts:greekLit:tlg0085.tlg001.fu.sp:402.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:402.1.text#ἀμφοτέρους ὁμαίμων τάδ' ἐπισκοπεῖ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:403.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:403.1.text#Ζεὺς ἑτερορρεπής, νέμων εἰκότως
urn:cts:greekLit:tlg0085.tlg001.fu.sp:404.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:404.1.text#ἄδικα μὲν κακοῖς, ὅσια δ' ἐννόμοις.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:405.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:405.1.text#τί τῶνδ' ἐξ ἴσου ῥεπομένων μεταλ-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:406.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:406.1.text#γεῖς τὸ δίκαιον ἔρξας;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:407.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:407.1.text#δεῖ τοι βαθείας φροντίδος σωτηρίου,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:408.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:408.1.text#δίκην κολυμβητῆρος, ἐς βυθὸν μολεῖν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:409.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:409.1.text#δεδορκὸς ὄμμα, μηδ' ἄγαν ᾠνωμένον,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:410.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:410.1.text#ὅπως ἄνατα ταῦτα πρῶτα μὲν πόλει,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:411.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:411.1.text#αὐτοῖσί θ' ἡμῖν ἐκτελευτήσει καλῶς,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:412.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:412.1.text#καὶ μήτε δῆρις ῥυσίων ἐφάψεται
urn:cts:greekLit:tlg0085.tlg001.fu.sp:413.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:413.1.text#μήτ' ἐν θεῶν ἕδραισιν ὧδ' ἱδρυμένας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:414.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:414.1.text#ἐκδόντες ὑμᾶς τὸν πανώλεθρον θεὸν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:415.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:415.1.text#βαρὺν ξύνοικον θησόμεσθ' ἀλάστορα,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:416.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:416.1.text#ὃς οὐδ' ἐν Ἅιδου τὸν θανόντ' ἐλευθεροῖ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:417.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:417.1.text#μῶν οὐ δοκεῖ δεῖν φροντίδος σωτηρίου;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:418.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:418.1.text#φρόντισον καὶ γενοῦ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:419.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:419.1.text#πανδίκως εὐσεβὴς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:420.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:420.1.text#πρόξενος· τὰν φυγάδα μὴ προδῷς,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:421.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:421.1.text#τὰν ἕκαθεν ἐκβολαῖς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:422.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:422.1.text#δυσθέοις ὀρμέναν·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:423.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:423.1.text#μηδ' ἴδῃς μ' ἐξ ἑδρᾶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:424.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:424.1.text#πολυθέων ῥυσια-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:425.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:425.1.text#σθεῖσαν, ὦ πᾶν κράτος ἔχων χθονός.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:426.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:426.1.text#γνῶθι δ' ὕβριν ἀνέρων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:427.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:427.1.text#καὶ φύλαξαι κότον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:428.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:428.1.text#μή τι τλῇς τὰν ἱκέτιν εἰσιδεῖν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:429.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:429.1.text#ἀπὸ βρετέων βίᾳ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:430.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:430.1.text#δίκας ἀγομέναν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:431.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:431.1.text#ἱππηδὸν ἀμπύκων,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:432.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:432.1.text#πολυμίτων πέπλων τ' ἐπιλαβὰς ἐμῶν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:433.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:433.1.text#ἴσθι γάρ· παισὶ τάδε καὶ δόμοις,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:434.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:434.1.text#ὁπότερ' ἂν κτίσῃς,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:435.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:435.1.text#μένει ἄρ ἐκτίνειν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:436.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:436.1.text#ὁμοιΐαν θέμιν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:437.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:437.1.text#τάδε φράσαι δίκαια Διόθεν κράτη.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:438.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:438.1.text#καὶ δὴ πέφρασμαι. δεῦρο δ' ἐξοκέλλεται.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:439.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:439.1.text#ἢ τοῖσιν ἢ τοῖς πόλεμον αἴρεσθαι μέγαν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:440.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:440.1.text#πᾶσ' ἔστ' ἀνάγκη, καὶ γεγόμφωται σκάφος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:441.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:441.1.text#στρέβλαισι ναυτικαῖσιν ὡς προσηγμένον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:442.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:442.1.text#ἄνευ δὲ λύπης οὐδαμοῦ καταστροφή.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:443.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:443.1.text#καὶ χρημάτων μὲν ἐκ δόμων πορθουμένων,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:444.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:444.1.text#{ ἄτην γε μείζω καὶ μέγ' ἐμπλήσας γόμου }
urn:cts:greekLit:tlg0085.tlg001.fu.sp:445.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:445.1.text#γένοιτ' ἂν ἄλλα Κτησίου Διὸς χάριν·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:446.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:446.1.text#καὶ γλῶσσα τοξεύσασα μὴ τὰ καίρια,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:447.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:447.1.text#γένοιτο μύθου μῦθος ἂν θελκτήριος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:448.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:448.1.text#[ ἀλγεινὰ θυμοῦ κάρτα κινητήρια ].
urn:cts:greekLit:tlg0085.tlg001.fu.sp:449.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:449.1.text#ὅπως δ' ὅμαιμον αἷμα μὴ γενήσεται,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:450.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:450.1.text#δεῖ κάρτα θύειν καὶ πεσεῖν χρηστήρια
urn:cts:greekLit:tlg0085.tlg001.fu.sp:451.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:451.1.text#θεοῖσι πολλοῖς πολλά, πημονῆς ἄκη.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:452.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:452.1.text#ἦ κάρτα νείκους τοῦδ' ἔσω παροίχομαι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:453.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:453.1.text#θέλω δ' ἄιδρις μᾶλλον ἢ σοφὸς κακῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:454.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:454.1.text#εἶναι. γένοιτο δ' εὖ παρὰ γνώμην ἐμήν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:455.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:455.1.text#πολλῶν ἄκουσον τέρματ' αἰδοίων λόγων.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:456.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:456.1.text#ἤκουσα, καὶ λέγοις ἄν. οὔ με φεύξεται.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:457.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:457.1.text#ἔχω στρόφους ζώνας τε, συλλαβὰς πέπλων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:458.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:458.1.text#τάχ' ἂν γυναιξὶ ταῦτα συμπρεπῆ πέλοι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:459.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:459.1.text#ἐκ τῶνδε τοίνυν, ἴσθι, μηχανὴ καλή—
urn:cts:greekLit:tlg0085.tlg001.fu.sp:460.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:460.1.text#λέξον τίν' αὐδὴν τήνδε γηρυθεῖσ' ἔσῃ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:461.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:461.1.text#εἰ μή τι πιστὸν τῷδ' ὑποστήσεις στόλῳ—
urn:cts:greekLit:tlg0085.tlg001.fu.sp:462.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:462.1.text#τί σοι περαίνει μηχανὴ συζωμάτων;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:463.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:463.1.text#νέοις πίναξι βρέτεα κοσμῆσαι τάδε.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:464.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:464.1.text#αἰνιγματῶδες τοὔπος· ἀλλ' ἁπλῶς φράσον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:465.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:465.1.text#ἐκ τῶνδ' ὅπως τάχιστ' ἀπάγξασθαι θεῶν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:466.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:466.1.text#ἤκουσα μαστικτῆρα καρδίας λόγον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:467.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:467.1.text#ξυνῆκας· ὠμμάτωσα γὰρ σαφέστερον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:468.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:468.1.text#καὶ πολλαχῇ γε δυσπάλαιστα πράγματα,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:469.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:469.1.text#κακῶν δὲ πλῆθος ποταμὸς ὣς ἐπέρχεται·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:470.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:470.1.text#ἄτης δ'  ἄβυσσον πέλαγος οὐ μάλ'  εὔπορον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:471.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:471.1.text#τόδ' ἐσβέβηκα, κοὐδαμοῦ λιμὴν κακῶν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:472.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:472.1.text#εἰ μὲν γὰρ ὑμῖν μὴ τόδ' ἐκπράξω χρέος,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:473.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:473.1.text#μίασμ' ἔλεξας οὐχ ὑπερτοξεύσιμον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:474.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:474.1.text#εἰ δ' αὖθ' ὁμαίμοις παισὶν Αἰγύπτου σέθεν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:475.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:475.1.text#σταθεὶς πρὸ τειχέων διὰ μάχης ἥξω τέλους,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:476.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:476.1.text#πῶς οὐχὶ τἀνάλωμα γίγνεται πικρόν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:477.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:477.1.text#ἄνδρας γυναικῶν οὕνεχ' αἱμάξαι πέδον;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:478.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:478.1.text#ὅμως δ' ἀνάγκη Ζηνὸς αἰδεῖσθαι κότον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:479.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:479.1.text#ἱκτῆρος· ὕψιστος γὰρ ἐν βροτοῖς φόβος.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:480.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:480.1.text#σὺ μέν, πάτερ γεραιὲ τῶνδε παρθένων,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:481.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:481.1.text#κλάδους τε τούτους αἶψ' ἐν ἀγκάλαις λαβὼν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:482.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:482.1.text#βωμοὺς ἐπ' ἄλλους δαιμόνων ἐγχωρίων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:483.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:483.1.text#θές, ὡς ἴδωσι τῆσδ' ἀφίξεως τέκμαρ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:484.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:484.1.text#πάντες πολῖται, μηδ' ἀπορριφθῇ ψόγος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:485.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:485.1.text#ἐμοῦ·  κατ' ἀρχῆς γὰρ φιλαίτιος λεώς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:486.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:486.1.text#καὶ γὰρ τάχ' ἄν τις οἰκτίσας ἰδὼν τάδε
urn:cts:greekLit:tlg0085.tlg001.fu.sp:487.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:487.1.text#ὕβριν μὲν ἐχθήρειεν ἄρσενος στόλου,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:488.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:488.1.text#ὑμῖν δ' ἂν εἴη δῆμος εὐμενέστερος·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:489.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:489.1.text#τοῖς ἥσσοσιν γὰρ πᾶς τις εὐνοίας φέρει.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:490.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:490.1.text#πολλῶν τάδ' ἡμῖν ἐστιν ἠξιωμένα,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:491.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:491.1.text#αἰδοῖον εὑρεθέντα πρόξενον λαβεῖν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:492.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:492.1.text#ὀπάονας δὲ φράστοράς τ' ἐγχωρίων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:493.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:493.1.text#ξύμπεμψον, ὡς ἂν τῶν πολισσούχων θεῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:494.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:494.1.text#βωμοὺς προνάους καὶ { πολισσούχων } ἕδρας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:495.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:495.1.text#εὕρωμεν, ἀσφάλεια δ' ᾖ δι' ἄστεως
urn:cts:greekLit:tlg0085.tlg001.fu.sp:496.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:496.1.text#στείχουσι· μορφῆς δ' οὐχ ὁμόστολος φύσις.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:497.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:497.1.text#Νεῖλος γὰρ οὐχ ὅμοιον Ἰνάχῳ γένος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:498.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:498.1.text#τρέφει.  φύλαξαι μὴ θράσος τέκῃ φόβον·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:499.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:499.1.text#καὶ δὴ φίλον τις ἔκταν' ἀγνοίας ὕπο.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:500.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:500.1.text#στείχοιτ' ἄν, ἄνδρες· εὖ γὰρ ὁ ξένος λέγει.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:501.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:501.1.text#ἡγεῖσθε βωμοὺς ἀστικούς, θεῶν ἕδρας·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:502.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:502.1.text#καὶ ξυμβολοῦσιν οὐ πολυστομεῖν χρεὼν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:503.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:503.1.text#ναύτην ἄγοντας τόνδ' ἐφέστιον θεῶν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:504.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:504.1.text#τούτῳ μὲν εἶπας, καὶ τεταγμένος κίοι·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:505.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:505.1.text#ἐγὼ δὲ πῶς δρῶ; ποῦ θράσος νέμεις ἐμοί;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:506.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:506.1.text#κλάδους μὲν αὐτοῦ λεῖπε, σημεῖον πόνου.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:507.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:507.1.text#καὶ δή σφε λείπω χειρὶ καὶ λόγοις σέθεν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:508.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:508.1.text#λευρὸν κατ' ἄλσος νῦν ἐπιστρέφου τόδε.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:509.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:509.1.text#καὶ πῶς βέβηλον ἄλσος ἂν ῥύοιτό με;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:510.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:510.1.text#οὔτοι πτερωτῶν ἁρπαγαῖς σ' ἐκδώσομεν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:511.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:511.1.text#ἀλλ' εἰ δρακόντων δυσφρόνων ἐχθίοσιν;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:512.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:512.1.text#εὔφημον εἴη τοὔπος εὐφημουμένῃ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:513.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:513.1.text#οὔτοι τι θαῦμα δυσφορεῖν φόβῳ φρενός.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:514.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:514.1.text#ἀεί γ' ἄναρκτόν ἐστι δεῖμ' ἐξαίσιον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:515.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:515.1.text#σὺ καὶ λέγων εὔφραινε καὶ πράσσων φρένα.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:516.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:516.1.text#ἀλλ' οὔτι δαρὸν χρόνον ἐρημώσει πατήρ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:517.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:517.1.text#ἐγὼ δὲ λαοὺς συγκαλῶν ἐγχωρίους
urn:cts:greekLit:tlg0085.tlg001.fu.sp:518.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:518.1.text#στείχω, τὸ κοινὸν ὡς ἂν εὐμενὲς τιθῶ·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:519.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:519.1.text#καὶ σὸν διδάξω πατέρα ποῖα χρὴ λέγειν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:520.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:520.1.text#πρὸς ταῦτα μίμνε καὶ θεοὺς ἐγχωρίους
urn:cts:greekLit:tlg0085.tlg001.fu.sp:521.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:521.1.text#λιταῖς παραιτοῦ τῶν σ' ἔρως ἔχει τυχεῖν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:522.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:522.1.text#ἐγὼ δὲ ταῦτα πορσυνῶν ἐλεύσομαι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:523.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:523.1.text#πειθὼ δ' ἕποιτο καὶ τύχη πρακτήριος.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:524.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:524.1.text#ἄναξ ἀνάκτων, μακάρων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:525.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:525.1.text#μακάρτατε καὶ τελέων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:526.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:526.1.text#τελειότατον κράτος, ὄλβιε Ζεῦ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:527.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:527.1.text#πιθοῦ τε καὶ γένει σῷ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:528.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:528.1.text#ἄλευσον ἀνδρῶν ὕβριν εὖ στυγήσας.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:529.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:529.1.text#λίμνᾳ δ' ἔμβαλε πορφυροειδεῖ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:530.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:530.1.text#τὰν μελανόζυγ'  ἄταν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:531.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:531.1.text#τὸ πρὸς γυναικῶν δ' ἐπιδὼν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:532.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:532.1.text#παλαίφατον ἁμέτερον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:533.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:533.1.text#γένος φιλίας προγόνου γυναικὸς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:534.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:534.1.text#νέωσον εὔφρον' αἶνον,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:535.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:535.1.text#γενοῦ πολυμνάστωρ, ἔφαπτορ Ἰοῦς·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:536.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:536.1.text#Δῖαί τοι γένος εὐχόμεθ' εἶναι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:537.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:537.1.text#γᾶς ἀπὸ τᾶσδ' ἄποικοι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:538.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:538.1.text#παλαιὸν, δ'  εἰς ἴχνος μετέσταν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:539.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:539.1.text#ματέρος ἀνθονόμους ἐπωπάς,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:540.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:540.1.text#λειμῶνα βούχιλον, ἔνθεν Ἰὼ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:541.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:541.1.text#οἴστρῳ ἐρεθομένα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:542.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:542.1.text#φεύγει ἁμαρτίνοος,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:543.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:543.1.text#πολλὰ βροτῶν διαμειβομένα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:544.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:544.1.text#φῦλα, διχῇ δ' ἀντίπορον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:545.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:545.1.text#γαῖαν ἐν αἴσᾳ διατέμ-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:546.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:546.1.text#νουσα πόρον κυματίαν ὁρίζει·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:547.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:547.1.text#ἰάπτει δ' Ἀσίδος δι'  αἴας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:548.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:548.1.text#μηλοβότου Φρυγίας διαμπάξ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:549.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:549.1.text#περᾷ δὲ Τεύθραντος ἄστυ Μυσῶν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:550.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:550.1.text#Λύδιά τε γύαλα,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:551.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:551.1.text#καὶ δι' ὀρῶν Κιλίκων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:552.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:552.1.text#Παμφύλων τε [ γένη ] διορνυμένα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:553.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:553.1.text#καί ποταμοὺς ἀενάους
urn:cts:greekLit:tlg0085.tlg001.fu.sp:554.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:554.1.text#καὶ βαθύπλουτον χθόνα καὶ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:555.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:555.1.text#τὰν Ἀφροδίτας πολύπυρον αἶαν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:556.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:556.1.text#ἱκνεῖται δὴ σινουμένα βέλει
urn:cts:greekLit:tlg0085.tlg001.fu.sp:557.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:557.1.text#βουκόλου πτερόεντος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:558.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:558.1.text#Δῖον πάμβοτον ἄλσος,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:559.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:559.1.text#λειμῶνα χιονόβοσκον, ὅντ' ἐπέρχεται
urn:cts:greekLit:tlg0085.tlg001.fu.sp:560.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:560.1.text#Τυφῶ μένος,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:561.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:561.1.text#ὕδωρ τε Νείλου νόσοις ἄθικτον,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:562.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:562.1.text#μαινομένα πόνοις ἀτί-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:563.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:563.1.text#μοις ὀδύναις τε κεντροδα-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:564.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:564.1.text#λήτισι, θυιὰς Ἥρας.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:565.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:565.1.text#βροτοὶ δ', οἳ γᾶς τότ' ἦσαν ἔννομοι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:566.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:566.1.text#χλωρῷ δείματι θυμὸν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:567.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:567.1.text#πάλλοντ' ὄψιν ἀήθη,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:568.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:568.1.text#βοτὸν ἐσορῶντες δυσχερὲς μειξόμβροτον,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:569.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:569.1.text#τὰν μὲν βοός,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:570.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:570.1.text#τὰν δ' αὖ γυναικός· τέρας δ' ἐθάμβουν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:571.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:571.1.text#καὶ τότε δὴ τίς ἦν ὁ θέλ-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:572.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:572.1.text#ξας πολύπλαγκτον ἀθλίαν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:573.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:573.1.text#οἰστροδόνητον Ἰώ;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:574.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:574.1.text#δι'  αἰῶνος κρέων ἀπαύστου
urn:cts:greekLit:tlg0085.tlg001.fu.sp:575.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:575.1.text#Ζεὺς [ … ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:576.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:576.1.text#Διὸς δ' ἀπημάντῳ σθένει
urn:cts:greekLit:tlg0085.tlg001.fu.sp:577.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:577.1.text#καὶ θείαις ἐπιπνοίαις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:578.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:578.1.text#παύεται, δακρύων δ' ἀπο-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:579.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:579.1.text#στάζει πένθιμον αἰδῶ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:580.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:580.1.text#λαβοῦσα δ' ἕρμα Δῖον ἀψευδεῖ λόγῳ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:581.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:581.1.text#γείνατο παῖδ' ἀμεμφῆ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:582.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:582.1.text#δι' αἰῶνος μακροῦ πάνολβον·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:583.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:583.1.text#ἔνθεν πᾶσα βοᾷ χθών,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:584.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:584.1.text#"φυσιζόου γένος τόδε"
urn:cts:greekLit:tlg0085.tlg001.fu.sp:585.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:585.1.text#"Ζηνός ἐστιν ἀληθῶς·"
urn:cts:greekLit:tlg0085.tlg001.fu.sp:586.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:586.1.text#"τίς γὰρ ἂν κατέπαυσεν Ἥ-"
urn:cts:greekLit:tlg0085.tlg001.fu.sp:587.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:587.1.text#"ρας νόσους ἐπιβούλους;"
urn:cts:greekLit:tlg0085.tlg001.fu.sp:588.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:588.1.text#Διὸς τόδ' ἔργον καὶ τόδ' ἂν γένος λέγων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:589.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:589.1.text#ἐξ Ἐπάφου κυρήσαις.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:590.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:590.1.text#τίν' ἂν θεῶν ἐνδικωτέροισιν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:591.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:591.1.text#κεκλοίμαν εὐλόγως ἐπ' ἔργοις;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:592.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:592.1.text#αὐτὸς ὁ πατὴρ φυτουργὸς αὐτόχειρ ἄναξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:593.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:593.1.text#γένους παλαιόφρων μέγας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:594.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:594.1.text#τέκτων, τὸ πᾶν μῆχαρ οὔριος Ζεύς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:595.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:595.1.text#ὑπ' ἀρχᾶς δ' οὔ τινος θοάζων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:596.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:596.1.text#τὸ μεῖον κρεισσόνων κρατύνει.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:597.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:597.1.text#οὔτινος ἄνωθεν ἡμένου σέβει κράτη.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:598.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:598.1.text#πάρεστι δ' ἔργον ὡς ἔπος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:599.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:599.1.text#σπεῦσαί τι τῶν βούλιος φέρει φρήν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:600.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:600.1.text#θαρσεῖτε παῖδες. εὖ τὰ τῶν ἐγχωρίων·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:601.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:601.1.text#δήμου δέδοκται παντελῆ ψηφίσματα.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:602.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:602.1.text#ὦ χαῖρε πρέσβυ, φίλτατ' ἀγγέλλων ἐμοί
urn:cts:greekLit:tlg0085.tlg001.fu.sp:603.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:603.1.text#ἔνισπε δ' ἡμῖν ποῖ κεκύρωται τέλος,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:604.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:604.1.text#δήμου κρατοῦσα χεὶρ ὅπῃ πληθύνεται.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:605.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:605.1.text#ἔδοξεν Ἀργείοισιν οὐ διχορρόπως,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:606.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:606.1.text#ἀλλ' ὥστ' ἀνηβῆσαί με γηραιᾷ φρενί·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:607.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:607.1.text#πανδημίᾳ γὰρ χερσὶ δεξιωνύμοις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:608.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:608.1.text#ἔφριξεν αἰθὴρ τόνδε κραινόντων λόγον·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:609.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:609.1.text#ἡμᾶς μετοικεῖν τῆσδε γῆς ἐλευθέρους
urn:cts:greekLit:tlg0085.tlg001.fu.sp:610.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:610.1.text#κἀρρυσιάστους ξύν τ' ἀσυλίᾳ βροτῶν·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:611.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:611.1.text#καὶ μήτ' ἐνοίκων μήτ' ἐπηλύδων τινὰ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:612.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:612.1.text#ἄγειν· ἐὰν δὲ προστιθῇ τὸ καρτερόν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:613.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:613.1.text#τὸν μὴ βοηθήσαντα τῶνδε γαμόρων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:614.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:614.1.text#ἄτιμον εἶναι ξὺν φυγῇ δημηλάτῳ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:615.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:615.1.text#τοιάνδ' ἔπειθεν ῥῆσιν ἀμφ' ἡμῶν λέγων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:616.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:616.1.text#ἄναξ Πελασγῶν, ἱκεσίου Ζηνὸς κότον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:617.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:617.1.text#μέγαν προφωνῶν μήποτ' εἰσόπιν χρόνου
urn:cts:greekLit:tlg0085.tlg001.fu.sp:618.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:618.1.text#πόλιν παχῦναι, ξενικὸν ἀστικόν θ' ἅμα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:619.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:619.1.text#λέγων διπλοῦν μίασμα πρὸ πόλεως φανὲν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:620.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:620.1.text#ἀμήχανον βόσκημα πημονῆς πέλειν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:621.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:621.1.text#τοιαῦτ' ἀκούων χερσὶν Ἀργεῖος λεὼς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:622.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:622.1.text#ἔκραν' ἄνευ κλητῆρος ὡς εἶναι τάδε.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:623.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:623.1.text#δημηγόρους δ' ἤκουσεν εὐπιθὴς στροφὰς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:624.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:624.1.text#δῆμος Πελασγῶν· Ζεὺς δ' ἐπέκρανεν τέλος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:625.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:625.1.text#ἄγε δή, λέξωμεν ἐπ' Ἀργείοις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:626.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:626.1.text#εὐχὰς ἀγαθάς, ἀγαθῶν ποινάς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:627.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:627.1.text#Ζεὺς δ' ἐφορεύοι ξένιος ξενίου
urn:cts:greekLit:tlg0085.tlg001.fu.sp:628.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:628.1.text#στόματος τιμὰς ἐπ' ἀληθείᾳ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:629.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:629.1.text#τέρμον' ἄμεμπτον προσαπαντᾶν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:630.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:630.1.text#νῦν ὅτε καί, θεοὶ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:631.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:631.1.text#διογενεῖς, κλύοιτ' εὐ-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:632.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:632.1.text#κταῖα γένει χεούσας·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:633.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:633.1.text#μήποτε πυρίφατον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:634.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:634.1.text#γᾶν Πελασγίαν [ πόλιν ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:635.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:635.1.text#τὸν ἄκορον βοᾶς,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:636.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:636.1.text#κτίσαι μάχλον Ἄπη,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:637.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:637.1.text#τὸν ἀρότοις θερί-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:638.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:638.1.text#ζοντα βροτοὺς ἐν ἄλλοις,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:639.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:639.1.text#οὕνεκ' ᾤκτισαν ἡμᾶς,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:640.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:640.1.text#ψῆφον δ' εὔφρον' ἔθεντο,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:641.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:641.1.text#αἰδοῦνται δ' ἱκέτας Διός,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:642.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:642.1.text#ποίμναν τάνδ' ἀμέγαρτον·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:643.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:643.1.text#οὐδὲ μετ' ἀρσένων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:644.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:644.1.text#ψῆφον ἔθεντ' ἀτιμώ-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:645.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:645.1.text#σαντες ἔριν γυναικῶν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:646.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:646.1.text#Δῖον ἐπιδόμενοι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:647.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:647.1.text#πράκτορά [ τε ] σκοπὸν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:648.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:648.1.text#δυσπολέμητον, ὃν [ οὐ ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:649.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:649.1.text#τίς ἂν δόμος ἔχοι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:650.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:650.1.text#ἐπ' ὀρόφων μιαί-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:651.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:651.1.text#νοντα; βαρὺς δ' ἐφίζει.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:652.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:652.1.text#ἅζονται γὰρ ὁμαίμους
urn:cts:greekLit:tlg0085.tlg001.fu.sp:653.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:653.1.text#Ζηνὸς ἵκτορας ἁγνοῦ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:654.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:654.1.text#τοιγάρτοι καθαροῖσι βω-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:655.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:655.1.text#μοῖς θεοὺς ἀρέσονται.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:656.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:656.1.text#τοιγὰρ ὑποσκίων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:657.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:657.1.text#ἐκ στομάτων ποτά-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:658.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:658.1.text#σθω φιλότιμος εὐχά,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:659.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:659.1.text#μήποτε λοιμὸς ἀνδρῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:660.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:660.1.text#τάνδε  πόλιν κενώσαι·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:661.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:661.1.text#μηδ' ἐπιχωρίοις ἔρις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:662.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:662.1.text#πτώμασιν αἱματίσαι πέδον γᾶς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:663.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:663.1.text#ἥβας δ' ἄνθος ἄδρεπτον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:664.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:664.1.text#ἔστω, μηδ' Ἀφροδίτας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:665.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:665.1.text#εὐνάτωρ βροτολοιγὸς  Ἄ-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:666.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:666.1.text#ρης κέρσειεν ἄωτον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:667.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:667.1.text#{ καὶ γεραροῖσι πρε- }
urn:cts:greekLit:tlg0085.tlg001.fu.sp:668.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:668.1.text#{ σβυτοδόκοι γεμόν- }
urn:cts:greekLit:tlg0085.tlg001.fu.sp:669.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:669.1.text#{ των } θυμέλαι φλεγόντων.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:670.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:670.1.text#τὼς πόλις εὖ νέμοιτο
urn:cts:greekLit:tlg0085.tlg001.fu.sp:671.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:671.1.text#Ζῆνα μέγαν σεβόντων,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:672.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:672.1.text#τὸν ξένιον δ' ὑπερτάτως,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:673.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:673.1.text#ὃς πολιῷ νόμῳ αἶσαν ὀρθοῖ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:674.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:674.1.text#τίκτεσθαι δ' ἐφόρους γᾶς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:675.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:675.1.text#ἄλλους εὐχόμεθ'  ἀεί,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:676.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:676.1.text#Ἄρτεμιν δ' Ἑκάταν γυναι-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:677.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:677.1.text#κῶν λόχους ἐφορεύειν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:678.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:678.1.text#μηδέ τις ἀνδροκμὴς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:679.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:679.1.text#λοιγὸς ἐπελθέτω
urn:cts:greekLit:tlg0085.tlg001.fu.sp:680.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:680.1.text#τάνδε πόλιν δαΐζων,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:681.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:681.1.text#ἄχορον ἀκίθαριν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:682.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:682.1.text#δακρυογόνον Ἄρη
urn:cts:greekLit:tlg0085.tlg001.fu.sp:683.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:683.1.text#βοάν τ' ἔνδημον ἐξοπλίζων.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:684.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:684.1.text#νούσων δ' ἑσμὸς ἀπ' ἀστῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:685.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:685.1.text#ἵζοι κρατὸς ἀτερπής·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:686.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:686.1.text#εὐμενὴς δ' ὁ Λύκειος ἔ-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:687.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:687.1.text#στω πάσᾳ νεολαίᾳ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:688.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:688.1.text#καρποτελῆ  δέ τοι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:689.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:689.1.text#Ζεὺς ἐπικραινέτω
urn:cts:greekLit:tlg0085.tlg001.fu.sp:690.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:690.1.text#φέρματι γᾶν πανώρῳ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:691.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:691.1.text#πρόνομα δὲ βότ' ἀγροῖς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:692.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:692.1.text#πολύγονα τελέθοι·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:693.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:693.1.text#τὸ πᾶν τ' ἐκ δαιμόνων λάχοιεν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:694.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:694.1.text#εὔφαμον δ' ἐπὶ βωμοῖς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:695.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:695.1.text#μοῦσαν θείατ' ἀοιδοί.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:696.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:696.1.text#ἁγνῶν τ' ἐκ στομάτων φερέ-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:697.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:697.1.text#σθω φάμα φιλοφόρμιγξ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:698.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:698.1.text#φυλάσσοι τ' ἀτρεμαῖα τιμὰς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:699.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:699.1.text#τὸ δάμιον, τὸ πτόλιν κρατύνει,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:700.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:700.1.text#προμαθὶς εὐκοινόμητις ἀρχά.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:701.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:701.1.text#ξένοισί τ' εὐξυμβόλους,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:702.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:702.1.text#πρὶν ἐξοπλίζειν Ἄρη,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:703.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:703.1.text#δίκας ἄτερ πημάτων διδοῖεν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:704.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:704.1.text#θεοὺς δ', οἳ γᾶν ἔχουσιν  ἀεὶ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:705.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:705.1.text#τίοιεν ἐγχωρίοις πατρῴαις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:706.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:706.1.text#δαφνηφόροις βουθύτοισι τιμαῖς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:707.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:707.1.text#τὸ γὰρ τεκόντων σέβας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:708.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:708.1.text#τρίτον τόδ' ἐν θεσμίοις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:709.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:709.1.text#Δίκας γέγραπται μεγιστοτίμου.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:710.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:710.1.text#εὐχὰς μὲν αἰνῶ τάσδε σώφρονας, φίλαι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:711.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:711.1.text#ὑμεῖς δὲ μὴ τρέσητ' ἀκούσασαι πατρὸς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:712.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:712.1.text#ἀπροσδοκήτους τούσδε καὶ νέους λόγους.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:713.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:713.1.text#ἱκεταδόκου γὰρ τῆσδ' ἀπὸ σκοπῆς ὁρῶ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:714.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:714.1.text#τὸ πλοῖον.  εὔσημον γὰρ οὔ με λανθάνει·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:715.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:715.1.text#στολμοί τε λαίφους καὶ παραρρύσεις νεώς,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:716.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:716.1.text#καὶ πρῷρα πρόσθεν ὄμμασιν βλέπουσ' ὁδόν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:717.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:717.1.text#οἴακος εὐθυντῆρος ὑστάτου νεὼς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:718.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:718.1.text#ἄγαν καλῶς κλύουσα, τοῖσιν οὐ φίλη.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:719.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:719.1.text#πρέπουσι δ' ἄνδρες νάιοι μελαγχίμοις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:720.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:720.1.text#γυίοισι λευκῶν ἐκ πεπλωμάτων ἰδεῖν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:721.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:721.1.text#καὶ τἄλλα πλοῖα πᾶσά θ' ἡ 'πικουρία
urn:cts:greekLit:tlg0085.tlg001.fu.sp:722.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:722.1.text#εὔπρεπτος·  αὐτὴ δ' ἡγεμὼν ὑπὸ χθόνα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:723.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:723.1.text#στείλασα λαῖφος παγκρότως ἐρέσσεται.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:724.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:724.1.text#ἀλλ' ἡσύχως χρὴ καὶ σεσωφρονισμένως
urn:cts:greekLit:tlg0085.tlg001.fu.sp:725.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:725.1.text#πρὸς πρᾶγμ' ὁρώσας τῶνδε μὴ ἀμελεῖν θεῶν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:726.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:726.1.text#ἐγὼ δ' ἀρωγοὺς ξυνδίκους θ' ἥξω λαβών.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:727.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:727.1.text#ἴσως γὰρ ἂν κῆρυξ τις ἢ πρέσβη μόλοι,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:728.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:728.1.text#ἄγειν θέλοντες ῥυσίων ἐφάπτορες.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:729.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:729.1.text#ἀλλ' οὐδὲν ἔσται τῶνδε· μὴ τρέσητέ νιν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:730.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:730.1.text#ὅμως δ' ἄμεινον, εἰ βραδύνοιμεν βοῇ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:731.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:731.1.text#ἀλκῆς λαθέσθαι τῆσδε μηδαμῶς ποτε.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:732.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:732.1.text#θάρσει· χρόνῳ τοι κυρίῳ τ' ἐν ἡμέρᾳ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:733.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:733.1.text#θεοὺς ἀτίζων τις βροτῶν δώσει δίκην.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:734.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:734.1.text#πάτερ, φοβοῦμαι, νῆες ὡς ὠκύπτεροι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:735.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:735.1.text#ἥκουσι· μῆκος δ' οὐδὲν ἐν μέσῳ χρόνου.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:736.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:736.1.text#περίφοβόν μ' ἔχει τάρβος ἐτητύμως
urn:cts:greekLit:tlg0085.tlg001.fu.sp:737.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:737.1.text#πολυδρόμου φυγᾶς ὄφελος εἴ τί μοι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:738.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:738.1.text#παροίχομαι, πάτερ, δείματι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:739.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:739.1.text#ἐπεὶ τελεία ψῆφος Ἀργείων, τέκνα,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:740.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:740.1.text#θάρσει, μαχοῦνται περὶ σέθεν, σάφ' οἶδ' ἐγώ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:741.1.speaker#[ Χορός ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:741.1.text#ἐξῶλές ἐστι μάργον Αἰγύπτου γένος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:742.1.speaker#[ Χορός ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:742.1.text#μάχης τ' ἄπληστον·  καὶ λέγω πρὸς εἰδότα.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:743.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:743.1.text#δοριπαγεῖς δ' ἔχοντες κυανώπιδας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:744.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:744.1.text#νῆας ἔπλευσαν ὧδ' ἐπιτυχεῖ κότῳ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:745.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:745.1.text#πολεῖ μελαγχίμῳ σὺν στρατῷ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:746.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:746.1.text#πολλοὺς δέ γ' εὑρήσουσιν ἐν μεσημβρίας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:747.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:747.1.text#θάλπει βραχίον' εὖ κατερρινημένους.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:748.1.speaker#[ Χορός ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:748.1.text#μόνην δὲ μὴ πρόλειπε· λίσσομαι, πάτερ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:749.1.speaker#[ Χορός ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:749.1.text#γυνὴ μονωθεῖσ' οὐδέν· οὐκ ἔνεστ' Ἄρης.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:750.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:750.1.text#οὐλόφρονες, δὲ καὶ δολιομήτιδες
urn:cts:greekLit:tlg0085.tlg001.fu.sp:751.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:751.1.text#δυσάγνοις φρεσίν, κόρακες ὥστε, βω-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:752.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:752.1.text#μῶν ἀλέγοντες οὐδέν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:753.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:753.1.text#καλῶς ἂν ἡμῖν ξυμφέροι ταῦτ' ὦ τέκνα,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:754.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:754.1.text#εἰ σοί τε καὶ θεοῖσιν ἐχθαιροίατο.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:755.1.speaker#[ Χορός ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:755.1.text#οὐ μὴ τριαίνας τάσδε καὶ θεῶν σέβη
urn:cts:greekLit:tlg0085.tlg001.fu.sp:756.1.speaker#[ Χορός ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:756.1.text#δείσαντες ἡμῶν χεῖρ' ἀπόσχωνται, πάτερ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:757.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:757.1.text#περίφρονες δ' ἄγαν ἀνιέρῳ μένει
urn:cts:greekLit:tlg0085.tlg001.fu.sp:758.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:758.1.text#μεμαργωμένοι κυνοθρασεῖς, θεῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:759.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:759.1.text#οὐδὲν ἐπαΐοντες.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:760.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:760.1.text#ἀλλ' ἔστι φήμη τοὺς λύκους κρείσσους κυνῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:761.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:761.1.text#εἶναι· βύβλου δὲ καρπὸς οὐ κρατεῖ στάχυν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:762.1.speaker#[ Χορός ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:762.1.text#ὡς καὶ ματαίων ἀνοσίων τε κνωδάλων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:763.1.speaker#[ Χορός ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:763.1.text#ἔχοντας ὀργάς, χρὴ φυλάσσεσθαι τάχος.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:764.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:764.1.text#οὔτοι ταχεῖα ναυτικοῦ στρατοῦ στολή,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:765.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:765.1.text#οὐδ' ὅρμος, οὗ δεῖ πεισμάτων σωτήρια
urn:cts:greekLit:tlg0085.tlg001.fu.sp:766.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:766.1.text#ἐς γῆν ἐνεγκεῖν, οὐδ' ἐν ἀγκυρουχίαις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:767.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:767.1.text#θαρσοῦσι ναῶν ποιμένες παραυτίκα,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:768.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:768.1.text#ἄλλως τε καὶ μολόντες ἀλίμενον χθόνα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:769.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:769.1.text#ἐς νύκτ' ἀποστείχοντος ἡλίου.  φιλεῖ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:770.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:770.1.text#ὠδῖνα τίκτειν νὺξ κυβερνήτῃ σοφῷ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:771.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:771.1.text#οὕτω γένοιτ' ἂν οὐδ' ἂν ἔκβασις στρατοῦ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:772.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:772.1.text#καλή, πρὶν ὅρμῳ ναῦν θρασυνθῆναι.  σὺ δὲ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:773.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:773.1.text#φρόνει μὲν ὡς ταρβοῦσα μὴ ἀμελεῖν θεῶν·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:774.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:774.1.text#[ … ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:774.2.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:774.2.text#πράξας ἀρωγήν· ἄγγελον δ' οὐ μέμψεται
urn:cts:greekLit:tlg0085.tlg001.fu.sp:775.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:775.1.text#πόλις γέρονθ', ἡβῶντα δ' εὐγλώσσῳ φρενί.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:776.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:776.1.text#ἰὼ γᾶ βοῦνι, πάνδικον σέβας,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:777.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:777.1.text#τί πεισόμεσθα; ποῖ φύγωμεν Ἀπίας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:778.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:778.1.text#χθονός, κελαινὸν εἴ τι κεῦθός ἐστί που;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:779.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:779.1.text#μέλας γενοίμαν καπνὸς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:780.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:780.1.text#νέφεσσι γειτονῶν Διός·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:781.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:781.1.text#τὸ πᾶν δ' ἄφαντος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:782.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:782.1.text#ἀμπετὴς ἀιδνὸς ὡς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:783.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:783.1.text#κόνις ἄτερθε πτερύγων ὀλοίμαν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:784.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:784.1.text#ἄφυκτον δ' οὐκέτ' ἂν πέλοι κακόν·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:785.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:785.1.text#κελαινόχρως δὲ πάλλεταί μου καρδία.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:786.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:786.1.text#πατρὸς σκοπαὶ δέ μ' εἷλον· οἴχομαι φόβῳ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:787.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:787.1.text#θέλοιμι δ' ἂν μορσίμου
urn:cts:greekLit:tlg0085.tlg001.fu.sp:788.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:788.1.text#βρόχου τυχεῖν ἐν ἀρτάναις,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:789.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:789.1.text#πρὶν ἄνδρ' ἀπευκτὸν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:790.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:790.1.text#τῷδε χριμφθῆναι χροΐ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:791.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:791.1.text#πρόπαρ θανούσας δ' Ἀίδας ἀνάσσοι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:792.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:792.1.text#πόθεν δέ μοι γένοιτ' ἂν αἰθέρος θρόνος,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:793.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:793.1.text#πρὸς ὃν νέφη μυδηλὰ γίγνεται χιών,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:794.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:794.1.text#ἢ λισσὰς αἰγίλιψ ἀπρόσ-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:795.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:795.1.text#δεικτος οἰόφρων κρεμὰς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:796.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:796.1.text#γυπιὰς πέτρα, βαθὺ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:797.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:797.1.text#πτῶμα μαρτυροῦσά μοι,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:798.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:798.1.text#πρὶν δαΐκτορος βίᾳ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:799.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:799.1.text#καρδίας γάμου κυρῆσαι;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:800.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:800.1.text#κυσὶν δ' ἔπειθ' ἕλωρα κἀπιχωρίοις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:801.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:801.1.text#ὄρνισι δεῖπνον οὐκ ἀναίνομαι πέλειν·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:802.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:802.1.text#τὸ γὰρ θανεῖν ἐλευθεροῦ-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:803.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:803.1.text#ται φιλαιάκτων κακῶν.  [ ἐλθέτω ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:804.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:804.1.text#ἐλθέτω μόρος, πρὸ κοί-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:805.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:805.1.text#τας γαμηλίου τυχών.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:806.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:806.1.text#ἀμφυγᾶς τίν' ἔτι πόρον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:807.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:807.1.text#τέμνω γάμου λυτῆρα;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:808.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:808.1.text#ἴυζε δ' ὀμφὰν οὐρανίαν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:809.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:809.1.text#μέλεα μέλη λιτανὰ θεοῖς·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:810.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:810.1.text#τέλεα δέ πως πελόμενά μοι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:811.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:811.1.text#λύσιμά τ' ἄχιμά τ' ἔπιδε, πάτερ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:812.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:812.1.text#βίαια μὴ φαιδρῶς ὁρῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:813.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:813.1.text#ὄμμασιν ἐνδίκοις.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:815.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:815.1.text#σεβίζου δ' ἱκέτας σέθεν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:816.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:816.1.text#γαιάοχε παγκρατὲς Ζεῦ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:817.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:817.1.text#γένος γὰρ Αἰγύπτειον ὕβριν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:818.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:818.1.text#δύσφορον ἀρσενογενὲς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:819.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:819.1.text#μετά με δρόμοισι διόμενοι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:820.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:820.1.text#φυγάδα μάταισι πολυθρόοις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:821.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:821.1.text#βίαια δίζηνται λαβεῖν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:822.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:822.1.text#σὸν δ' ἐπίπαν ζυγὸν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:823.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:823.1.text#ταλάντου.  τί δ' ἄνευ σέθεν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:824.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:824.1.text#θνατοῖσι τέλειόν ἐστιν;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:825.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:825.1.text#ό ό ό, ά ά ά·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:826.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:826.1.text#ὅδε μάρπτις νάιος γάιος.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:827.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:827.1.text#τῶν πρό, μάρπτι, κάμνοις·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:828.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:828.1.text#{ ἰόφ .. ὀμ .. αὖθι κάκκας νυ }
urn:cts:greekLit:tlg0085.tlg001.fu.sp:829.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:829.1.text#{ δυϊαν βοᾶν ἀμφαίνω. }
urn:cts:greekLit:tlg0085.tlg001.fu.sp:830.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:830.1.text#ὁρῶ τάδε φροίμια { πράξαν } πόνων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:831.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:831.1.text#βιαίων ἐμῶν.  ἠὲ ἠέ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:832.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:832.1.text#βαῖνε φυγᾷ πρὸς ἀλκάν·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:833.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:833.1.text#{ βλοσυρόφρονα χλιδᾷ }
urn:cts:greekLit:tlg0085.tlg001.fu.sp:834.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:834.1.text#{ δύσφορα ναῒ κἀν γᾷ. }
urn:cts:greekLit:tlg0085.tlg001.fu.sp:835.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:835.1.text#{ γαϊάναξ προτάσσου. }
urn:cts:greekLit:tlg0085.tlg001.fu.sp:836.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:836.1.text#σοῦσθε σοῦσθ' ἐπὶ βᾶ-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:837.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:837.1.text#ριν ὅπως ποδῶν ἔχετε
urn:cts:greekLit:tlg0085.tlg001.fu.sp:838.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:838.1.text#{ οὐκοῦν οὐκοῦν }
urn:cts:greekLit:tlg0085.tlg001.fu.sp:839.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:839.1.text#τιλμοὶ τιλμοὶ καὶ στιγμοί,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:840.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:840.1.text#πολυαίμων φόνιος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:841.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:841.1.text#ἀποκοπὰ κρατός.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:842.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:842.1.text#σοῦσθε σοῦσθ' { ὀλύμεναι } ὀλόμεν' ἐπαμίδα.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:843.1.speaker#Χορός 
urn:cts:greekLit:tlg0085.tlg001.fu.sp:843.1.text#εἴθ'  ἀνὰ  πολύρυτον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:844.1.speaker#Χορός 
urn:cts:greekLit:tlg0085.tlg001.fu.sp:844.1.text#ἁλμήεντα πόρον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:845.1.speaker#Χορός 
urn:cts:greekLit:tlg0085.tlg001.fu.sp:845.1.text#δεσποσίῳ ξὺν ὕβρει,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:846.1.speaker#Χορός 
urn:cts:greekLit:tlg0085.tlg001.fu.sp:846.1.text#γομφοδέτῳ τε δόρει διώλου.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:847.1.speaker#Χορός 
urn:cts:greekLit:tlg0085.tlg001.fu.sp:847.1.text#{ αἵμονες ὡς ἐπάμιδα }
urn:cts:greekLit:tlg0085.tlg001.fu.sp:848.1.speaker#Χορός 
urn:cts:greekLit:tlg0085.tlg001.fu.sp:848.1.text#{ ησυδουπιάπιτα }
urn:cts:greekLit:tlg0085.tlg001.fu.sp:849.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:849.1.text#{ κελεύω βοᾶν μεθέσθαι }
urn:cts:greekLit:tlg0085.tlg001.fu.sp:850.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:850.1.text#{ ἴχαρ φρενί τ' ἄταν. }
urn:cts:greekLit:tlg0085.tlg001.fu.sp:851.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:851.1.text#ἰοὺ ἰού.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:852.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:852.1.text#λεῖφ' ἕδρανα, κί' ἐς δόρυ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:853.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:853.1.text#ἀτίετον ἄπολιν οὐ σέβω.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:854.1.speaker#Χορός 
urn:cts:greekLit:tlg0085.tlg001.fu.sp:854.1.text#μήποτε πάλιν ἴδοιμ'
urn:cts:greekLit:tlg0085.tlg001.fu.sp:855.1.speaker#Χορός 
urn:cts:greekLit:tlg0085.tlg001.fu.sp:855.1.text#ἀλφεσίβοιον ὕδωρ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:856.1.speaker#Χορός 
urn:cts:greekLit:tlg0085.tlg001.fu.sp:856.1.text#ἔνθεν ἀεξόμενον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:857.1.speaker#Χορός 
urn:cts:greekLit:tlg0085.tlg001.fu.sp:857.1.text#ζώφυτον αἷμα βροτοῖσι θάλλει.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:858.1.speaker#Χορός 
urn:cts:greekLit:tlg0085.tlg001.fu.sp:858.1.text#ἔγγαιος ἐγὼ βαθυχαῖος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:860.1.speaker#Χορός 
urn:cts:greekLit:tlg0085.tlg001.fu.sp:860.1.text#{ βαθρείας βαθρείας, γέρον. }
urn:cts:greekLit:tlg0085.tlg001.fu.sp:861.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:861.1.text#σὺ δ' ἐν ναῒ ναῒ βάσῃ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:862.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:862.1.text#τάχα θέλεος ἀθέλεος,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:863.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:863.1.text#βίᾳ βίᾳ τε πολλᾷ φροῦδα.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:864.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:864.1.text#{ βάτεαι βαθυμιτροκακὰ παθῶν }
urn:cts:greekLit:tlg0085.tlg001.fu.sp:865.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:865.1.text#[ ὀλόμεναι παλάμαις ].
urn:cts:greekLit:tlg0085.tlg001.fu.sp:866.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:866.1.text#αἰαῖ αἰαῖ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:867.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:867.1.text#αἲ γὰρ δυσπαλάμως ὄλοιο
urn:cts:greekLit:tlg0085.tlg001.fu.sp:868.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:868.1.text#δι' ἁλίρρυτον ἄλσος,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:869.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:869.1.text#κατὰ Σαρπηδόνιον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:870.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:870.1.text#χῶμα πολύψαμμον ἀλαθεὶς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:871.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:871.1.text#Εὐρεΐαισιν αὔραις.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:872.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:872.1.text#ἴυζε καὶ λάκαζε καὶ κάλει θεούς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:873.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:873.1.text#Αἰγυπτίαν γὰρ βᾶριν οὐχ ὑπερθορῇ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:874.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:874.1.text#[ ἴυζε καὶ ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:875.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:875.1.text#βόα, χέον πικρότερον  οἰζύος νόμον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:876.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:876.1.text#οἰοῖ οἰοῖ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:877.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:877.1.text#λύμας, ᾇ σὺ πρὸ γᾶς ὑλάσκων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:878.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:878.1.text#περί, χάμψα, βρυάζεις·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:879.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:879.1.text#ὃς ἐπωπᾷ σ', ὁ μέγας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:880.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:880.1.text#Νεῖλος, ὑβρίζοντά  σ' ἀποτρέ-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:881.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:881.1.text#ψειεν ἄιστον ὕβριν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:882.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:882.1.text#βαίνειν κελεύω βᾶριν εἰς ἀμφίστροφον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:883.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:883.1.text#ὅσον τάχιστα· μηδέ τις σχολαζέτω.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:884.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:884.1.text#ὁλκὴ γὰρ οὔτοι πλόκαμον οὐδάμ' ἅζεται.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:885.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:885.1.text#οἰοῖ, πάτερ, βρέτεος ἄρος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:886.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:886.1.text#ἀτᾷ μ'·· ἅλαδ' ἄγει
urn:cts:greekLit:tlg0085.tlg001.fu.sp:887.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:887.1.text#ἄραχνος ὡς βάδην.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:888.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:888.1.text#ὄναρ ὄναρ μέλαν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:889.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:889.1.text#ὀτοτοτοτοῖ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:890.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:890.1.text#μᾶ Γᾶ μᾶ Γᾶ, βοὰν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:891.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:891.1.text#φοβερὸν ἀπότρεπε,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:892.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:892.1.text#ὦ πᾶ, Γᾶς παῖ, Ζεῦ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:893.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:893.1.text#οὔτοι φοβοῦμαι δαίμονας τοὺς ἐνθάδε·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:894.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:894.1.text#οὐ γάρ μ' ἔθρεψαν, οὐδ' ἐγήρασαν τροφῇ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:895.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:895.1.text#μαιμᾷ πέλας  δίπους ὄφις·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:895.2.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:895.2.text#[ … ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:896.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:896.1.text#ἔχιδνα δ' ὥς μέ τις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:897.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:897.1.text#πόδα δακοῦσ' ἔχει.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:898.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:898.1.text#ὀτοτοτοτοῖ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:899.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:899.1.text#μᾶ Γᾶ μᾶ Γᾶ βοὰν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:900.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:900.1.text#φοβερὸν ἀπότρεπε,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:901.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:901.1.text#ὦ πᾶ, Γᾶς παῖ, Ζεῦ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:902.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:902.1.text#εἰ μή τις ἐς ναῦν εἶσιν αἰνέσας τάδε,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:903.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:903.1.text#λακὶς χιτῶνος ἔργον οὐ κατοικτιεῖ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:904.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:904.1.text#διωλόμεσθ'· ἄσεπτ', ἄναξ, πάσχομεν—
urn:cts:greekLit:tlg0085.tlg001.fu.sp:905.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:905.1.text#πολλοὺς ἄνακτας, παῖδας Αἰγύπτου τάχα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:906.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:906.1.text#ὄψεσθε· θαρσεῖτ', οὐκ ἐρεῖτ' ἀναρχίαν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:907.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:907.1.text#ἰὼ πόλεως ἀγοὶ πρόμοι, δάμναμαι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:909.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:909.1.text#ἕλξειν ἔοιχ' ὑμᾶς ἀποσπάσας κόμης,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:910.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:910.1.text#ἐπεὶ οὐκ ἀκούετ' ὀξὺ τῶν ἐμῶν λόγων.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:911.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:911.1.text#οὗτος, τί ποιεῖς; ἐκ ποίου φρονήματος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:912.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:912.1.text#ἀνδρῶν Πελασγῶν τήνδ' ἀτιμάζεις χθόνα;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:913.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:913.1.text#ἀλλ' ἦ γυναικῶν ἐς πόλιν δοκεῖς μολεῖν;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:914.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:914.1.text#κάρβανος ὢν δ' Ἕλλησιν ἐγχλίεις ἄγαν·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:915.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:915.1.text#καὶ πόλλ' ἁμαρτὼν οὐδὲν ὤρθωσας φρενί.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:916.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:916.1.text#τί δ' ἠμπλάκηται τῶνδ' ἐμοὶ δίκης ἄτερ;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:917.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:917.1.text#ξένος μὲν εἶναι πρῶτον οὐκ ἐπίστασαι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:918.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:918.1.text#πῶς δ' οὐχί; τἄμ' ὀλωλόθ' εὑρίσκων ἄγω.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:919.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:919.1.text#ποίοισιν εἰπὼν προξένοις ἐγχωρίοις;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:920.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:920.1.text#Ἑρμῇ μεγίστῳ προξένῳ μαστηρίῳ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:921.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:921.1.text#θεοῖσιν εἰπὼν τοὺς θεοὺς οὐδὲν σέβῃ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:922.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:922.1.text#τοὺς ἀμφὶ Νεῖλον δαίμονας σεβίζομαι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:923.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:923.1.text#οἱ δ' ἐνθάδ' οὐδέν, ὡς ἐγὼ σέθεν κλύω;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:924.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:924.1.text#ἄγοιμ' ἄν, εἴ τις τάσδε μὴ 'ξαιρήσεται.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:925.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:925.1.text#κλάοις ἄν, εἰ ψαύσειας, οὐ μάλ' ἐς μακράν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:926.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:926.1.text#ἤκουσα τοὔπος δ' οὐδαμῶς φιλόξενον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:927.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:927.1.text#οὐ γὰρ ξενοῦμαι τοὺς θεῶν συλήτορας.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:928.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:928.1.text#λέγοιμ' ἂν ἐλθὼν παισὶν Αἰγύπτου τάδε.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:929.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:929.1.text#ἀβουκόλητον τοῦτ' ἐμῷ, φρονήματι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:930.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:930.1.text#ἀλλ' ὡς ἂν εἰδὼς ἐννέπω σαφέστερον,—
urn:cts:greekLit:tlg0085.tlg001.fu.sp:931.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:931.1.text#καὶ γὰρ πρέπει κήρυκ' ἀπαγγέλλειν τορῶς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:932.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:932.1.text#ἕκαστα,—πῶς φῶ, πρὸς τίνος τ' ἀφαιρεθεὶς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:933.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:933.1.text#ἥκειν γυναικῶν αὐτανέψιον στόλον;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:934.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:934.1.text#οὔτοι δικάζει ταῦτα μαρτύρων ὕπο
urn:cts:greekLit:tlg0085.tlg001.fu.sp:935.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:935.1.text#Ἄρης· τὸ νεῖκος δ' οὐκ ἐν ἀργύρου λαβῇ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:936.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:936.1.text#ἔλυσεν· ἀλλὰ πολλὰ γίγνεται πάρος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:937.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:937.1.text#πεσήματ' ἀνδρῶν κἀπολακτισμοὶ βίου.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:938.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:938.1.text#τί σοι λέγειν χρὴ τοὔνομ'; ἐν χρόνῳ μαθὼν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:939.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:939.1.text#εἴσῃ σύ τ' αὐτὸς χοἰ ξυνέμποροι σέθεν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:940.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:940.1.text#ταύτας δ' ἑκούσας μὲν κατ' εὔνοιαν φρενῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:941.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:941.1.text#ἄγοις ἄν, εἴπερ εὐσεβὴς πίθοι λόγος.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:942.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:942.1.text#τοία δὲ δημόπρακτος ἐκ πόλεως μία
urn:cts:greekLit:tlg0085.tlg001.fu.sp:943.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:943.1.text#ψῆφος κέκρανται, μήποτ' ἐκδοῦναι βίᾳ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:944.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:944.1.text#στόλον γυναικῶν· τῶνδ' ἐφήλωται τορῶς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:945.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:945.1.text#γόμφος διαμπάξ, ὡς μένειν ἀραρότως.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:946.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:946.1.text#ταῦτ' οὐ πίναξίν ἐστιν ἐγγεγραμμένα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:947.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:947.1.text#οὐδ' ἐν πτυχαῖς βίβλων κατεσφραγισμένα,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:948.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:948.1.text#σαφῆ δ' ἀκούεις ἐξ ἐλευθεροστόμου
urn:cts:greekLit:tlg0085.tlg001.fu.sp:949.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:949.1.text#γλώσσης.  κομίζου δ' ὡς τάχιστ' ἐξ ὀμμάτων.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:950.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:950.1.text#ἔοιγμεν ἤδη πόλεμον ἀρεῖσθαι νέον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:951.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:951.1.text#εἴη δὲ νίκη καὶ κράτη τοῖς ἄρσεσιν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:952.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:952.1.text#ἀλλ' ἄρσενάς τοι τῆσδε γῆς οἰκήτορας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:953.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:953.1.text#εὑρήσετ' οὐ πίνοντας ἐκ κριθῶν μέθυ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:954.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:954.1.text#ὑμεῖς δὲ πᾶσαι σὺν φίλαις ὀπάοσι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:955.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:955.1.text#θράσος λαβοῦσαι στείχετ' εὐερκῆ πόλιν,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:956.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:956.1.text#πύργων βαθείᾳ μηχανῇ κεκλῃμένην.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:957.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:957.1.text#καὶ δώματ' ἐστὶ πολλὰ μὲν τὰ δήμια,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:958.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:958.1.text#δεδωμάτωμαι δ' οὐδ' ἐγὼ σμικρᾷ χερί.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:959.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:959.1.text#ἔνθ' ὑμίν ἐστιν εὐτύκους ναίειν δόμους
urn:cts:greekLit:tlg0085.tlg001.fu.sp:960.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:960.1.text#πολλῶν μετ' ἄλλων· εἰ δέ τις μείζων χάρις,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:961.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:961.1.text#πάρεστιν οἰκεῖν καὶ μονορρύθμους δόμους.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:962.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:962.1.text#τούτων τὰ λῷστα καὶ τὰ θυμηδέστατα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:963.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:963.1.text#πάρεστι, λωτίσασθε.  προστάτης δ' ἐγὼ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:964.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:964.1.text#ἀστοί τε πάντες, ὧνπερ ἥδε κραίνεται
urn:cts:greekLit:tlg0085.tlg001.fu.sp:965.1.speaker#Βασιλεύς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:965.1.text#ψῆφος.  τί τῶνδε κυριωτέρους μένεις;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:966.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:966.1.text#ἀλλ' ἀντ' ἀγαθῶν ἀγαθοῖσι βρύοις,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:967.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:967.1.text#δῖε Πελασγῶν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:968.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:968.1.text#πέμψον δὲ πρόφρων δεῦρ' ἡμέτερον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:969.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:969.1.text#πατέρ' εὐθαρσῆ Δαναόν, πρόνοον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:970.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:970.1.text#καὶ βούλαρχον.  τοῦ γὰρ προτέρα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:971.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:971.1.text#μῆτις, ὅπου χρὴ δώματα ναίειν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:972.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:972.1.text#καὶ τόπος εὔφρων.  πᾶς τις ἐπειπεῖν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:973.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:973.1.text#ψόγον ἀλλοθρόοις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:974.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:974.1.text#εὔτυκος· εἴη δὲ τὰ λῷστα.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:975.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:975.1.text#σύν τ'  εὐκλείᾳ καὶ ἀμηνίτῳ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:976.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:976.1.text#βάξει λαῶν ἐγχώρων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:976.2.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:976.2.text#[ … ]
urn:cts:greekLit:tlg0085.tlg001.fu.sp:977.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:977.1.text#τάσσεσθε, φίλαι δμωίδες, οὕτως
urn:cts:greekLit:tlg0085.tlg001.fu.sp:978.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:978.1.text#ὡς ἐφ' ἑκάστῃ διεκλήρωσεν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:979.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:979.1.text#Δαναὸς θεραποντίδα φερνήν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:980.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:980.1.text#ὦ παῖδες, Ἀργείοισιν εὔχεσθαι χρεών,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:981.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:981.1.text#θύειν τε λείβειν θ', ὡς θεοῖς, Ὀλυμπίοις,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:982.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:982.1.text#σπονδάς, ἐπεὶ σωτῆρες οὐ διχορρόπως.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:983.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:983.1.text#καί μου τὰ μὲν πραχθέντα πρὸς τοὺς ἐγγενεῖς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:984.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:984.1.text#φίλους πικρῶς ἤκουσαν αὐτανεψίοις·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:985.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:985.1.text#ἐμοὶ δ' ὀπαδοὺς τούσδε καὶ δορυσσόους
urn:cts:greekLit:tlg0085.tlg001.fu.sp:986.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:986.1.text#ἔταξαν, ὡς ἔχοιμι τίμιον γέρας,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:987.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:987.1.text#καὶ μὴ 'ξ ἀέλπτων δορικανεῖ μόρῳ θανὼν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:988.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:988.1.text#λάθοιμι, χώρᾳ δ' ἄχθος ἀείζων πέλοι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:989.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:989.1.text#τοιῶνδε τυγχάνοντας ἐκ πρυμνῆς φρενὸς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:990.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:990.1.text#χάριν σέβεσθαι τιμιωτέραν χρεών.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:991.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:991.1.text#καὶ ταῦθ' ἅμ' ἐγγράψασθε πρὸς γεγραμμένοις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:992.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:992.1.text#πολλοῖσιν ἄλλοις σωφρονίσμασιν πατρός,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:993.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:993.1.text#ἀγνῶθ' ὅμιλον ἐξελέγχεσθαι χρόνῳ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:994.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:994.1.text#πᾶς δ' ἐν μετοίκῳ γλῶσσαν εὔτυκον φέρει
urn:cts:greekLit:tlg0085.tlg001.fu.sp:995.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:995.1.text#κακήν, τό τ' εἰπεῖν εὐπετὲς μύσαγμά πως.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:996.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:996.1.text#ὑμᾶς δ' ἐπαινῶ μὴ καταισχύνειν ἐμέ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:997.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:997.1.text#ὥραν ἐχούσας τήνδ' ἐπίστρεπτον βροτοῖς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:998.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:998.1.text#τέρειν' ὀπώρα δ' εὐφύλακτος οὐδαμῶς·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:999.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:999.1.text#θῆρες δὲ κηραίνουσι καὶ βροτοί, τί μήν;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1000.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1000.1.text#καὶ κνώδαλα πτεροῦντα καὶ πεδοστιβῆ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1001.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1001.1.text#{ καρπώματα στάζοντα κηρύσσει Κύπρις }
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1002.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1002.1.text#{ καλωρα κωλύουσαν θωσμένειν ἐρῶ, }
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1003.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1003.1.text#καὶ παρθένων χλιδαῖσιν εὐμόρφοις ἔπι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1004.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1004.1.text#πᾶς τις παρελθὼν ὄμματος θελκτήριον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1005.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1005.1.text#τόξευμ' ἔπεμψεν, ἱμέρου νικώμενος.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1006.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1006.1.text#πρὸς ταῦτα μὴ πάθωμεν ὧν πολὺς πόνος
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1007.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1007.1.text#πολὺς δὲ πόντος οὕνεκ' ἠρόθη δορί,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1008.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1008.1.text#μηδ' αἶσχος ἡμῖν, ἡδονὴν δ' ἐχθροῖς ἐμοῖς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1009.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1009.1.text#πράξωμεν. οἴκησις δὲ καὶ διπλῆ πάρα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1010.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1010.1.text#τὴν μὲν Πελασγός, τὴν δὲ καὶ πόλις διδοῖ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1011.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1011.1.text#οἰκεῖν λάτρων ἄτερθεν· εὐπετῆ τάδε.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1012.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1012.1.text#μόνον φύλαξαι τάσδ' ἐπιστολὰς πατρός,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1013.1.speaker#Δαναός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1013.1.text#τὸ σωφρονεῖν τιμῶσα τοῦ βίου πλέον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1014.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1014.1.text#τἄλλ' εὐτυχοῖμεν πρὸς θεῶν Ὀλυμπίων.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1015.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1015.1.text#ἐμῆς δ' ὀπώρας οὕνεκ' εὖ θάρσει, πάτερ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1016.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1016.1.text#εἰ γάρ τι μὴ θεοῖς βεβούλευται νέον,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1017.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1017.1.text#ἴχνος τὸ πρόσθεν οὐ διαστρέψω φρενός.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1018.1.speaker#Χορός Δαναΐδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1018.1.text#ἴτε μὰν ἀστυάνακτας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1019.1.speaker#Χορός Δαναΐδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1019.1.text#μάκαρας θεοὺς γανάοντες πολιούχους
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1020.1.speaker#Χορός Δαναΐδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1020.1.text#τε καὶ οἳ χεῦμ' Ἐρασίνου
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1021.1.speaker#Χορός Δαναΐδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1021.1.text#περιναίουσιν παλαιόν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1022.1.speaker#Χορός Δαναΐδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1022.1.text#ὑποδέξασθε δ' ὀπαδοὶ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1023.1.speaker#Χορός Δαναΐδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1023.1.text#μέλος· αἶνος δὲ πόλιν τήνδε Πελασγῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1024.1.speaker#Χορός Δαναΐδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1024.1.text#ἐχέτω, μηδ' ἔτι Νείλου
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1025.1.speaker#Χορός Δαναΐδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1025.1.text#προχοὰς σέβωμεν ὕμνοις.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1026.1.speaker#Χορός Δαναΐδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1026.1.text#ποταμοὺς δ' οἳ διὰ χώρας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1027.1.speaker#Χορός Δαναΐδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1027.1.text#θελεμὸν πῶμα χέουσιν πολύτεκνοι,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1028.1.speaker#Χορός Δαναΐδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1028.1.text#λιπαροῖς χεύμασι γαίας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1029.1.speaker#Χορός Δαναΐδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1029.1.text#τόδε μειλίσσοντες οὖδας.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1030.1.speaker#Χορός Δαναΐδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1030.1.text#ἐπίδοι δ' Ἄρτεμις ἁγνὰ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1031.1.speaker#Χορός Δαναΐδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1031.1.text#στόλον οἰκτιζομένα, μηδ' ὑπ' ἀνάγκας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1032.1.speaker#Χορός Δαναΐδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1032.1.text#γάμος ἔλθοι Κυθερείας·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1033.1.speaker#Χορός Δαναΐδων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1033.1.text#στυγίων πέλοι τόδ' ἆθλον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1034.1.speaker#Χορός Θεραπαινῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1034.1.text#Κύπριδος δ' οὐκ ἀμελεῖ θεσμὸς ὅδ' εὔφρων
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1035.1.speaker#Χορός Θεραπαινῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1035.1.text#δύναται γὰρ Διὸς ἄγχιστα σὺν Ἥρᾳ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1036.1.speaker#Χορός Θεραπαινῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1036.1.text#τίεται δ' αἰολόμητις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1037.1.speaker#Χορός Θεραπαινῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1037.1.text#θεὸς ἔργοις ἐπὶ σεμνοῖς.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1038.1.speaker#Χορός Θεραπαινῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1038.1.text#μετάκοινοι δὲ φίλᾷ ματρὶ πάρεισιν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1039.1.speaker#Χορός Θεραπαινῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1039.1.text#Πόθος ᾇ τ' οὐδὲν ἄπαρνον
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1040.1.speaker#Χορός Θεραπαινῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1040.1.text#τελέθει θέλκτορι Πειθοῖ.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1041.1.speaker#Χορός Θεραπαινῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1041.1.text#δέδοται δ' Ἁρμονίᾳ μοῖρ' Ἀφροδίτας
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1042.1.speaker#Χορός Θεραπαινῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1042.1.text#ψεδυρᾷ τρίβῳ τ' Ἐρώτων.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1043.1.speaker#Χορός Θεραπαινῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1043.1.text#φυγάδεσσιν δ' ἐπιπνοίας κακά τ' ἄλγη
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1044.1.speaker#Χορός Θεραπαινῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1044.1.text#πολέμους θ' αἱματόεντας προφοβοῦμαι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1045.1.speaker#Χορός Θεραπαινῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1045.1.text#τί ποτ' εὔπλοιαν ἔπραξαν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1046.1.speaker#Χορός Θεραπαινῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1046.1.text#ταχυπόμποισι διωγμοῖς;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1047.1.speaker#Χορός Θεραπαινῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1047.1.text#ὅ τί τοι μόρσιμόν ἐστιν, τὸ γένοιτ' ἄν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1048.1.speaker#Χορός Θεραπαινῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1048.1.text#Διὸς οὐ παρβατός ἐστιν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1049.1.speaker#Χορός Θεραπαινῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1049.1.text#μεγάλα φρὴν ἀπέρατος·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1050.1.speaker#Χορός Θεραπαινῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1050.1.text#μετὰ πολλῶν δὲ γάμων ἅδε τελευτὰ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1051.1.speaker#Χορός Θεραπαινῶν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1051.1.text#προτερᾶν πέλοι γυναικῶν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1052.1.speaker#Δαναΐς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1052.1.text#ὁ μέγας Ζεὺς ἀπαλέξαι
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1053.1.speaker#Δαναΐς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1053.1.text#γάμον Αἰγυπτογενῆ μοι.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1054.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1054.1.text#τὸ μὲν ἂν βέλτατον εἴη·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1055.1.speaker#Δαναΐς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1055.1.text#σὺ δὲ θέλγοις ἂν ἄθελκτον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1056.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1056.1.text#σὺ δέ γ' οὐκ οἶσθα τὸ μέλλον.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1057.1.speaker#Δαναΐς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1057.1.text#τί δὲ μέλλω φρένα Δίαν
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1058.1.speaker#Δαναΐς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1058.1.text#καθορᾶν, ὄψιν ἄβυσσον;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1059.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1059.1.text#μέτριον νῦν ἔπος εὔχου·
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1060.1.speaker#Δαναΐς
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1060.1.text#τίνα καιρόν με διδάσκεις;
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1061.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1061.1.text#τὰ θεῶν μηδὲν ἀγάζειν.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1062.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1062.1.text#Ζεὺς ἄναξ ἀποστεροί-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1063.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1063.1.text#η γάμον δυσάνορα
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1064.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1064.1.text#δάιον, ὅσπερ Ἰὼ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1065.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1065.1.text#πημονᾶς ἐλύσατ' εὖ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1066.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1066.1.text#χειρὶ παιωνίᾳ κατασχεθών,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1067.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1067.1.text#εὐμενῆ βίαν κτίσας.
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1068.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1068.1.text#καὶ κράτος νέμοι γυναι-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1069.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1069.1.text#ξίν· τὸ βέλτερον κακοῦ
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1070.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1070.1.text#καὶ τὸ δίμοιρον αἰνῶ,
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1071.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1071.1.text#καὶ δίκᾳ δίκας ἕπε-
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1072.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1072.1.text#σθαι, ξὺν εὐχαῖς ἐμαῖς, λυτηρίοις
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1073.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg001.fu.sp:1073.1.text#μαχαναῖς θεοῦ πάρα.
