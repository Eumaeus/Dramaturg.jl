#!ctsdata
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1.1.text#Χθονὸς μὲν ἐς τηλουρὸν ἥκομεν πέδον,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:2.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:2.1.text#Σκύθην ἐς οἷμον, ἄβατον εἰς ἐρημίαν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:3.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:3.1.text#Ἥφαιστε, σοὶ δὲ χρὴ μέλειν ἐπιστολὰς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:4.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:4.1.text#ἅς σοι πατὴρ ἐφεῖτο, τόνδε πρὸς πέτραις
urn:cts:greekLit:tlg0085.tlg003.fu.sp:5.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:5.1.text#ὑψηλοκρήμνοις τὸν λεωργὸν ὀχμάσαι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:6.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:6.1.text#ἀδαμαντίνων δεσμῶν ἐν ἀρρήκτοις πέδαις.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:7.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:7.1.text#τὸ σὸν γὰρ ἄνθος, παντέχνου πυρὸς σέλας,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:8.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:8.1.text#θνητοῖσι κλέψας ὤπασεν. τοιᾶσδέ τοι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:9.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:9.1.text#ἁμαρτίας σφε δεῖ θεοῖς δοῦναι δίκην,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:10.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:10.1.text#ὡς ἂν διδαχθῇ τὴν Διὸς τυραννίδα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:11.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:11.1.text#στέργειν, φιλανθρώπου δὲ παύεσθαι τρόπου.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:12.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:12.1.text#Κράτος Βία τε, σφῷν μὲν ἐντολὴ Διὸς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:13.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:13.1.text#ἔχει τέλος δὴ κοὐδὲν ἐμποδὼν ἔτι·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:14.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:14.1.text#ἐγὼ δ' ἄτολμός εἰμι συγγενῆ θεὸν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:15.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:15.1.text#δῆσαι βίᾳ φάραγγι πρὸς δυσχειμέρῳ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:16.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:16.1.text#πάντως δ' ἀνάγκη τῶνδέ μοι τόλμαν σχεθεῖν·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:17.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:17.1.text#ἐξωριάζειν γὰρ πατρὸς λόγους βαρύ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:18.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:18.1.text#τῆς ὀρθοβούλου Θέμιδος αἰπυμῆτα παῖ,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:19.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:19.1.text#ἄκοντά σ' ἄκων δυσλύτοις χαλκεύμασι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:20.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:20.1.text#προσπασσαλεύσω τῷδ' ἀπανθρώπῳ πάγῳ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:21.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:21.1.text#ἵν' οὔτε φωνὴν οὔτε του μορφὴν βροτῶν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:22.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:22.1.text#ὄψει, σταθευτὸς δ' ἡλίου φοίβῃ φλογὶ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:23.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:23.1.text#χροιᾶς ἀμείψεις ἄνθος. ἀσμένῳ δέ σοι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:24.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:24.1.text#ἡ ποικιλείμων νὺξ ἀποκρύψει φάος,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:25.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:25.1.text#πάχνην θ' ἑῴαν ἥλιος σκεδᾷ πάλιν·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:26.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:26.1.text#ἀεὶ δὲ τοῦ παρόντος ἀχθηδὼν κακοῦ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:27.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:27.1.text#τρύσει σ'· ὁ λωφήσων γὰρ οὐ πέφυκέ πω.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:28.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:28.1.text#τοιαῦτ' ἐπηύρω τοῦ φιλανθρώπου τρόπου.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:29.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:29.1.text#θεὸς θεῶν γὰρ οὐχ ὑποπτήσσων χόλον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:30.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:30.1.text#βροτοῖσι τιμὰς ὤπασας πέρα δίκης.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:31.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:31.1.text#ἀνθ' ὧν ἀτερπῆ τήνδε φρουρήσεις πέτραν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:32.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:32.1.text#ὀρθοστάδην, ἄυπνος, οὐ κάμπτων γόνυ·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:33.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:33.1.text#πολλοὺς δ' ὀδυρμοὺς καὶ γόους ἀνωφελεῖς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:34.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:34.1.text#φθέγξῃ· Διὸς γὰρ δυσπαραίτητοι φρένες.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:35.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:35.1.text#ἅπας δὲ τραχὺς ὅστις ἂν νέον κρατῇ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:36.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:36.1.text#εἶεν, τί μέλλεις καὶ κατοικτίζῃ μάτην;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:37.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:37.1.text#τί τὸν θεοῖς ἔχθιστον οὐ στυγεῖς θεόν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:38.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:38.1.text#ὅστις τὸ σὸν θνητοῖσι προὔδωκεν γέρας;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:39.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:39.1.text#τὸ συγγενές τοι δεινὸν ἥ θ' ὁμιλία.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:40.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:40.1.text#σύμφημ'· ἀνηκουστεῖν δὲ τῶν πατρὸς λόγων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:41.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:41.1.text#οἷόν τε πῶς; οὐ τοῦτο δειμαίνεις πλέον;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:42.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:42.1.text#αἰεί γε δὴ νηλὴς σὺ καὶ θράσους πλέως.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:43.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:43.1.text#ἄκος γὰρ οὐδὲν τόνδε θρηνεῖσθαι. σὺ δὲ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:44.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:44.1.text#τὰ μηδὲν ὠφελοῦντα μὴ πόνει μάτην.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:45.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:45.1.text#ὦ πολλὰ μισηθεῖσα χειρωναξία.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:46.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:46.1.text#τί νιν στυγεῖς; πόνων γὰρ ὡς ἁπλῷ λόγῳ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:47.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:47.1.text#τῶν νῦν παρόντων οὐδὲν αἰτία τέχνη.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:48.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:48.1.text#ἔμπας τις αὐτὴν ἄλλος ὤφελεν λαχεῖν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:49.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:49.1.text#ἅπαντ' ἐπαχθῆ πλὴν θεοῖσι κοιρανεῖν·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:50.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:50.1.text#ἐλεύθερος γὰρ οὔτις ἐστὶ πλὴν Διός.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:51.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:51.1.text#ἔγνωκα τοῖσδε κοὐδὲν ἀντειπεῖν ἔχω.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:52.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:52.1.text#οὔκουν ἐπείξῃ τῷδε δεσμὰ περιβαλεῖν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:53.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:53.1.text#ὡς μή σ' ἐλινύοντα προσδερχθῇ πατήρ;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:54.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:54.1.text#καὶ δὴ πρόχειρα ψάλια δέρκεσθαι πάρα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:55.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:55.1.text#βαλών νιν ἀμφὶ χερσὶν ἐγκρατεῖ σθένει
urn:cts:greekLit:tlg0085.tlg003.fu.sp:56.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:56.1.text#ῥαιστῆρι θεῖνε, πασσάλευε πρὸς πέτραις.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:57.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:57.1.text#περαίνεται δὴ κοὐ ματᾷ τοὔργον τόδε.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:58.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:58.1.text#ἄρασσε μᾶλλον, σφίγγε, μηδαμῇ χάλα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:59.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:59.1.text#δεινὸς γὰρ εὑρεῖν κἀξ ἀμηχάνων πόρον.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:60.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:60.1.text#ἄραρεν ἥδε γ' ὠλένη δυσεκλύτως.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:61.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:61.1.text#καὶ τήνδε νῦν πόρπασον ἀσφαλῶς, ἵνα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:62.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:62.1.text#μάθῃ σοφιστὴς ὢν Διὸς νωθέστερος.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:63.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:63.1.text#πλὴν τοῦδ' ἂν οὐδεὶς ἐνδίκως μέμψαιτό μοι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:64.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:64.1.text#ἀδαμαντίνου νῦν σφηνὸς αὐθάδη γνάθον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:65.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:65.1.text#στέρνων διαμπὰξ πασσάλευ' ἐρρωμένως.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:66.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:66.1.text#αἰαῖ, Προμηθεῦ, σῶν ὑπερστένω πόνων.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:67.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:67.1.text#σὺ δ' αὖ κατοκνεῖς τῶν Διός τ' ἐχθρῶν ὕπερ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:68.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:68.1.text#στένεις; ὅπως μὴ σαυτὸν οἰκτιεῖς ποτε.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:69.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:69.1.text#ὁρᾷς θέαμα δυσθέατον ὄμμασιν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:70.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:70.1.text#ὁρῶ κυροῦντα τόνδε τῶν ἐπαξίων.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:71.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:71.1.text#ἀλλ' ἀμφὶ πλευραῖς μασχαλιστῆρας βάλε.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:72.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:72.1.text#δρᾶν ταῦτ' ἀνάγκη, μηδὲν ἐγκέλευ' ἄγαν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:73.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:73.1.text#ἦ μὴν κελεύσω κἀπιθωύξω γε πρός.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:74.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:74.1.text#χώρει κάτω, σκέλη δὲ κίρκωσον βίᾳ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:75.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:75.1.text#καὶ δὴ πέπρακται τοὔργον οὐ μακρῷ πόνῳ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:76.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:76.1.text#ἐρρωμένως νῦν θεῖνε διατόρους πέδας·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:77.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:77.1.text#ὡς οὑπιτιμητής γε τῶν ἔργων βαρύς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:78.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:78.1.text#ὅμοια μορφῇ γλῶσσά σου γηρύεται.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:79.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:79.1.text#σὺ μαλθακίζου, τὴν δ' ἐμὴν αὐθαδίαν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:80.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:80.1.text#ὀργῆς τε τραχύτητα μὴ 'πίπλησσέ μοι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:81.1.speaker#Ἥφαιστος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:81.1.text#στείχωμεν, ὡς κώλοισιν ἀμφίβληστρ' ἔχει.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:82.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:82.1.text#ἐνταῦθα νῦν ὕβριζε καὶ θεῶν γέρα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:83.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:83.1.text#συλῶν ἐφημέροισι προστίθει. τί σοι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:84.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:84.1.text#οἷοί τε θνητοὶ τῶνδ' ἀπαντλῆσαι πόνων;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:85.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:85.1.text#ψευδωνύμως σε δαίμονες Προμηθέα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:86.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:86.1.text#καλοῦσιν· αὐτὸν γάρ σε δεῖ προμηθέως,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:87.1.speaker#Κράτος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:87.1.text#ὅτῳ τρόπῳ τῆσδ' ἐκκυλισθήσῃ τέχνης.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:88.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:88.1.text#ὦ δῖος αἰθὴρ καὶ ταχύπτεροι πνοαί,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:89.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:89.1.text#ποταμῶν τε πηγαί, ποντίων τε κυμάτων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:90.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:90.1.text#ἀνήριθμον γέλασμα, παμμῆτόρ τε γῆ,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:91.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:91.1.text#καὶ τὸν πανόπτην κύκλον ἡλίου καλῶ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:92.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:92.1.text#ἴδεσθέ μ' οἷα πρὸς θεῶν πάσχω θεός.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:93.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:93.1.text#δέρχθηθ' οἵαις αἰκείαισιν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:94.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:94.1.text#διακναιόμενος τὸν μυριετῆ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:95.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:95.1.text#χρόνον ἀθλεύσω.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:96.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:96.1.text#τοιόνδ' ὁ νέος ταγὸς μακάρων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:97.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:97.1.text#ἐξηῦρ' ἐπ' ἐμοὶ δεσμὸν ἀεικῆ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:98.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:98.1.text#φεῦ φεῦ, τὸ παρὸν τό τ' ἐπερχόμενον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:99.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:99.1.text#πῆμα στενάχω, πῇ ποτε μόχθων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:100.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:100.1.text#χρὴ τέρματα τῶνδ' ἐπιτεῖλαι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:101.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:101.1.text#καίτοι τί φημι; πάντα προυξεπίσταμαι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:102.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:102.1.text#σκεθρῶς τὰ μέλλοντ', οὐδέ μοι ποταίνιον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:103.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:103.1.text#πῆμ' οὐδὲν ἥξει. τὴν πεπρωμένην δὲ χρὴ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:104.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:104.1.text#αἶσαν φέρειν ὡς ῥᾷστα, γιγνώσκονθ' ὅτι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:105.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:105.1.text#τὸ τῆς ἀνάγκης ἔστ' ἀδήριτον σθένος.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:106.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:106.1.text#ἀλλ' οὔτε σιγᾶν οὔτε μὴ σιγᾶν τύχας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:107.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:107.1.text#οἷόν τέ μοι τάσδ' ἐστί. θνητοῖς γὰρ γέρα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:108.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:108.1.text#πορὼν ἀνάγκαις ταῖσδ' ἐνέζευγμαι τάλας.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:109.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:109.1.text#ναρθηκοπλήρωτον δὲ θηρῶμαι πυρὸς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:110.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:110.1.text#πηγὴν κλοπαίαν, ἣ διδάσκαλος τέχνης
urn:cts:greekLit:tlg0085.tlg003.fu.sp:111.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:111.1.text#πάσης βροτοῖς πέφηνε καὶ μέγας πόρος.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:112.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:112.1.text#τοιῶνδε ποινὰς ἀμπλακημάτων τίνω
urn:cts:greekLit:tlg0085.tlg003.fu.sp:113.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:113.1.text#ὑπαιθρίοις δεσμοῖς πεπασσαλευμένος.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:114.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:114.1.text#ἆ ἆ ἔα ἔα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:115.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:115.1.text#τίς ἀχώ, τίς ὀδμὰ προσέπτα μ' ἀφεγγής,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:116.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:116.1.text#θεόσυτος, ἢ βρότειος, ἢ κεκραμένη;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:117.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:117.1.text#ἵκετο τερμόνιον ἐπὶ πάγον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:118.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:118.1.text#πόνων ἐμῶν θεωρός, ἢ τί δὴ θέλων;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:119.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:119.1.text#ὁρᾶτε δεσμώτην με δύσποτμον θεόν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:120.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:120.1.text#τὸν Διὸς ἐχθρόν, τὸν πᾶσι θεοῖς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:121.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:121.1.text#δι' ἀπεχθείας ἐλθόνθ' ὁπόσοι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:122.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:122.1.text#τὴν Διὸς αὐλὴν εἰσοιχνεῦσιν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:123.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:123.1.text#διὰ τὴν λίαν φιλότητα βροτῶν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:124.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:124.1.text#φεῦ φεῦ, τί ποτ' αὖ κινάθισμα κλύω
urn:cts:greekLit:tlg0085.tlg003.fu.sp:125.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:125.1.text#πέλας οἰωνῶν; αἰθὴρ δ' ἐλαφραῖς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:126.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:126.1.text#πτερύγων ῥιπαῖς ὑποσυρίζει.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:127.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:127.1.text#πᾶν μοι φοβερὸν τὸ προσέρπον.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:128.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:128.1.text#μηδὲν φοβηθῇς· φιλία
urn:cts:greekLit:tlg0085.tlg003.fu.sp:128.2.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:128.2.text#γὰρ ἅδε τάξις πτερύγων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:129.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:129.1.text#θοαῖς ἁμίλλαις προσέβα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:130.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:130.1.text#τόνδε πάγον, πατρῴας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:131.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:131.1.text#μόγις παρειποῦσα φρένας.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:132.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:132.1.text#κραιπνοφόροι δέ μ' ἔπεμψαν αὖραι·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:133.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:133.1.text#κτύπου γὰρ ἀχὼ χάλυβος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:130b.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:130b.1.text#διῇξεν ἄντρων μυχόν, ἐκ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:134.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:134.1.text#δ' ἔπληξέ μου τὰν θεμερῶπιν αἰδῶ·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:135.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:135.1.text#σύθην δ' ἀπέδιλος ὄχῳ πτερωτῷ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:136.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:136.1.text#αἰαῖ αἰαῖ,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:137.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:137.1.text#τῆς πολυτέκνου Τηθύος ἔκγονα,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:138.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:138.1.text#τοῦ περὶ πᾶσάν θ' εἱλισσομένου
urn:cts:greekLit:tlg0085.tlg003.fu.sp:139.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:139.1.text#χθόν' ἀκοιμήτῳ ῥεύματι παῖδες
urn:cts:greekLit:tlg0085.tlg003.fu.sp:140.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:140.1.text#πατρὸς, Ὠκεανοῦ,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:141.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:141.1.text#δέρχθητ', ἐσίδεσθ' οἵῳ δεσμῷ,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:142.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:142.1.text#προσπορπατὸς τῆσδε φάραγγος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:143.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:143.1.text#σκοπέλοις ἐν ἄκροις
urn:cts:greekLit:tlg0085.tlg003.fu.sp:143.2.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:143.2.text#φρουρὰν ἄζηλον ὀχήσω.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:144.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:144.1.text#λεύσσω, Προμηθεῦ· φοβερὰ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:145.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:145.1.text#δ' ἐμοῖσιν ὄσσοις ὀμίχλα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:146.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:146.1.text#προσῇξε πλήρης δακρύων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:147.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:147.1.text#σὸν δέμας εἰσιδούσᾳ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:148.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:148.1.text#πέτραις προσαυαινόμενον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:149.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:149.1.text#ταῖσδ' ἀδαμαντοδέτοισι λύμαις.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:150.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:150.1.text#νέοι γὰρ οἰακονόμοι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:151.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:151.1.text#κρατοῦσ', Ὀλύμπου· νεοχμοῖς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:150a.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:150a.1.text#δὲ δὴ νόμοις Ζεὺς ἀθέτως κρατύνει.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:151a.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:151a.1.text#τὰ πρὶν δὲ πελώρια νῦν ἀιστοῖ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:152.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:152.1.text#εἰ γάρ μ' ὑπὸ γῆν νέρθεν θ' Ἅιδου
urn:cts:greekLit:tlg0085.tlg003.fu.sp:153.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:153.1.text#τοῦ νεκροδέγμονος εἰς ἀπέρατον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:154.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:154.1.text#Τάρταρον ἧκεν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:155.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:155.1.text#δεσμοῖς ἀλύτοις ἀγρίως πελάσας,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:156.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:156.1.text#ὡς μήτε θεὸς μήτε τις ἄλλος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:157.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:157.1.text#τοῖσδ' ἐπεγήθει.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:158.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:158.1.text#νῦν δ' αἰθέριον κίνυγμ' ὁ τάλας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:159.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:159.1.text#ἐχθροῖς ἐπίχαρτα πέπονθα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:160.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:160.1.text#τίς ὧδε τλησικάρδιος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:161.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:161.1.text#θεῶν, ὅτῳ τάδ' ἐπιχαρῆ;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:162.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:162.1.text#τίς οὐ ξυνασχαλᾷ κακοῖς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:163.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:163.1.text#τεοῖσι, δίχα γε Διός; ὁ δ' ἐπικότως ἀεὶ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:164.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:164.1.text#θέμενος ἄγναμπτον νόον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:165.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:165.1.text#δάμναται Οὐρανίαν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:166.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:166.1.text#γένναν, οὐδὲ λήξει, πρὶν ἂν ἢ κορέσῃ κέαρ ἢ παλάμᾳ τινὶ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:167.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:167.1.text#τὰν δυσάλωτον ἕλῃ τις ἀρχάν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:168.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:168.1.text#ἦ μὴν ἔτ' ἐμοῦ, καίπερ κρατεραῖς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:169.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:169.1.text#ἐν γυιοπέδαις αἰκιζομένου,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:170.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:170.1.text#χρείαν ἕξει μακάρων πρύτανις,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:171.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:171.1.text#δεῖξαι τὸ νέον βούλευμ' ὑφ' ὅτου
urn:cts:greekLit:tlg0085.tlg003.fu.sp:172.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:172.1.text#σκῆπτρον τιμάς τ' ἀποσυλᾶται.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:173.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:173.1.text#καί μ' οὔτι μελιγλώσσοις πειθοῦς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:174.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:174.1.text#ἐπαοιδαῖσιν θέλξει, στερεάς τ'
urn:cts:greekLit:tlg0085.tlg003.fu.sp:175.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:175.1.text#οὔποτ' ἀπειλὰς πτήξας τόδ' ἐγὼ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:176.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:176.1.text#καταμηνύσω,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:177.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:177.1.text#πρὶν ἂν ἐξ ἀγρίων δεσμῶν χαλάσῃ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:178.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:178.1.text#ποινάς τε τίνειν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:179.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:179.1.text#τῆσδ' αἰκείας ἐθελήσῃ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:180.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:180.1.text#σὺ μὲν θρασύς τε καὶ πικραῖς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:181.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:181.1.text#δύαισιν οὐδὲν ἐπιχαλᾷς,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:182.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:182.1.text#ἄγαν δ' ἐλευθεροστομεῖς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:183.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:183.1.text#ἐμὰς δὲ φρένας ἐρέθισε διάτορος φόβος·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:184.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:184.1.text#δέδια δ' ἀμφὶ σαῖς τύχαις,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:185.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:185.1.text#πᾷ ποτε τῶνδε πόνων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:186.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:186.1.text#χρή σε τέρμα κέλ-
urn:cts:greekLit:tlg0085.tlg003.fu.sp:187.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:187.1.text#σαντ' ἐσιδεῖν· ἀκίχητα γὰρ ἤθεα καὶ κέαρ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:188.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:188.1.text#ἀπαράμυθον ἔχει Κρόνου παῖς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:189.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:189.1.text#οἶδ' ὅτι τραχὺς καὶ παρ' ἑαυτῷ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:190.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:190.1.text#τὸ δίκαιον ἔχων Ζεύς. ἀλλ' ἔμπας [ ὀίω ]
urn:cts:greekLit:tlg0085.tlg003.fu.sp:191.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:191.1.text#μαλακογνώμων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:192.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:192.1.text#ἔσται ποθ', ὅταν ταύτῃ ῥαισθῇ·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:193.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:193.1.text#τὴν δ' ἀτέραμνον στορέσας ὀργὴν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:194.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:194.1.text#εἰς ἀρθμὸν ἐμοὶ καὶ φιλότητα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:195.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:195.1.text#σπεύδων σπεύδοντί ποθ' ἥξει.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:196.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:196.1.text#πάντ' ἐκκάλυψον καὶ γέγων' ἡμῖν λόγον,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:197.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:197.1.text#ποίῳ λαβών σε Ζεὺς ἐπ' αἰτιάματι,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:198.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:198.1.text#οὕτως ἀτίμως καὶ πικρῶς αἰκίζεται·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:199.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:199.1.text#δίδαξον ἡμᾶς, εἴ τι μὴ βλάπτει λόγῳ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:200.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:200.1.text#ἀλγεινὰ μέν μοι καὶ λέγειν ἐστὶν τάδε,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:200.2.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:200.2.text#ἄλγος δὲ σιγᾶν, πανταχῇ δὲ δύσποτμα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:201.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:201.1.text#ἐπεὶ τάχιστ' ἤρξαντο δαίμονες χόλου
urn:cts:greekLit:tlg0085.tlg003.fu.sp:202.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:202.1.text#στάσις τ' ἐν ἀλλήλοισιν ὠροθύνετο,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:203.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:203.1.text#οἱ μὲν θέλοντες ἐκβαλεῖν ἕδρας Κρόνον,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:204.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:204.1.text#ὡς Ζεὺς ἀνάσσοι δῆθεν, οἱ δὲ τοὔμπαλιν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:205.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:205.1.text#σπεύδοντες, ὡς Ζεὺς μήποτ' ἄρξειεν θεῶν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:206.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:206.1.text#ἐνταῦθ' ἐγὼ τὰ λῷστα βουλεύων πιθεῖν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:207.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:207.1.text#Τιτᾶνας, Οὐρανοῦ τε καὶ Χθονὸς τέκνα,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:208.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:208.1.text#οὐκ ἠδυνήθην. αἱμύλας δὲ μηχανὰς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:209.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:209.1.text#ἀτιμάσαντες καρτεροῖς φρονήμασιν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:210.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:210.1.text#ᾤοντ' ἀμοχθεὶ πρὸς βίαν τε δεσπόσειν·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:211.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:211.1.text#ἐμοὶ δὲ μήτηρ οὐχ ἅπαξ μόνον Θέμις,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:212.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:212.1.text#καὶ Γαῖα, πολλῶν ὀνομάτων μορφὴ μία,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:213.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:213.1.text#τὸ μέλλον ᾗ κραίνοιτο προυτεθεσπίκει,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:214.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:214.1.text#ὡς οὐ κατ' ἰσχὺν οὐδὲ πρὸς τὸ καρτερόν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:215.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:215.1.text#χρείη, δόλῳ δὲ τοὺς ὑπερσχόντας κρατεῖν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:216.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:216.1.text#τοιαῦτ' ἐμοῦ λόγοισιν ἐξηγουμένου
urn:cts:greekLit:tlg0085.tlg003.fu.sp:217.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:217.1.text#οὐκ ἠξίωσαν οὐδὲ προσβλέψαι τὸ πᾶν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:218.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:218.1.text#κράτιστα δή μοι τῶν παρεστώτων τότε
urn:cts:greekLit:tlg0085.tlg003.fu.sp:219.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:219.1.text#ἐφαίνετ' εἶναι προσλαβόντα μητέρα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:220.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:220.1.text#ἑκόνθ' ἑκόντι Ζηνὶ συμπαραστατεῖν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:221.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:221.1.text#ἐμαῖς δὲ βουλαῖς Ταρτάρου μελαμβαθὴς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:222.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:222.1.text#κευθμὼν καλύπτει τὸν παλαιγενῆ Κρόνον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:223.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:223.1.text#αὐτοῖσι συμμάχοισι. τοιάδ' ἐξ ἐμοῦ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:224.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:224.1.text#ὁ τῶν θεῶν τύραννος ὠφελημένος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:225.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:225.1.text#κακαῖσι ποιναῖς ταῖσδὲ μ' ἐξημείψατο.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:226.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:226.1.text#ἔνεστι γάρ πως τοῦτο τῇ τυραννίδι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:227.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:227.1.text#νόσημα, τοῖς φίλοισι μὴ πεποιθέναι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:228.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:228.1.text#ὃ δ' οὖν ἐρωτᾶτ', αἰτίαν καθ' ἥντινα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:229.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:229.1.text#αἰκίζεταί με, τοῦτο δὴ σαφηνιῶ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:230.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:230.1.text# ὅπως τάχιστα τὸν πατρῷον ἐς θρόνον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:231.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:231.1.text#καθέζετ', εὐθὺς δαίμοσιν νέμει γέρα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:232.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:232.1.text#ἄλλοισιν ἄλλα καὶ διεστοιχίζετο
urn:cts:greekLit:tlg0085.tlg003.fu.sp:233.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:233.1.text#ἀρχήν· βροτῶν δὲ τῶν ταλαιπώρων λόγον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:234.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:234.1.text#οὐκ ἔσχεν οὐδέν', ἀλλ' ἀιστώσας γένος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:235.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:235.1.text#τὸ πᾶν ἔχρῃζεν ἄλλο φιτῦσαι νέον.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:236.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:236.1.text#καὶ τοῖσιν οὐδεὶς ἀντέβαινε πλὴν ἐμοῦ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:237.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:237.1.text#ἐγὼ δ' ἐτόλμησ'· ἐξελυσάμην βροτοὺς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:238.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:238.1.text#τὸ μὴ διαρραισθέντας εἰς Ἅιδου μολεῖν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:239.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:239.1.text#τῷ τοι τοιαῖσδε πημοναῖσι κάμπτομαι,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:240.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:240.1.text#πάσχειν μὲν ἀλγειναῖσιν, οἰκτραῖσιν δ' ἰδεῖν·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:241.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:241.1.text#θνητοὺς δ' ἐν οἴκτῳ προθέμενος, τούτου τυχεῖν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:242.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:242.1.text#οὐκ ἠξιώθην αὐτός, ἀλλὰ νηλεῶς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:243.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:243.1.text#ὧδ' ἐρρύθμισμαι, Ζηνὶ δυσκλεὴς θέα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:244.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:244.1.text#σιδηρόφρων τε κἀκ πέτρας εἰργασμένος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:245.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:245.1.text#ὅστις, Προμηθεῦ, σοῖσιν οὐ συνασχαλᾷ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:246.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:246.1.text#μόχθοις· ἐγὼ γὰρ οὔτ' ἂν εἰσιδεῖν τάδε
urn:cts:greekLit:tlg0085.tlg003.fu.sp:247.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:247.1.text#ἔχρῃζον εἰσιδοῦσά τ' ἠλγύνθην κέαρ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:248.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:248.1.text#καὶ μὴν φίλοις γ'  ἐλεινὸς εἰσορᾶν ἐγώ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:249.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:249.1.text#μή πού τι προύβης τῶνδε καὶ περαιτέρω;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:250.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:250.1.text#θνητούς γ' ἔπαυσα μὴ προδέρκεσθαι μόρον.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:251.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:251.1.text#τὸ ποῖον εὑρὼν τῆσδε φάρμακον νόσου;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:252.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:252.1.text#τυφλὰς ἐν αὐτοῖς ἐλπίδας κατῴκισα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:253.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:253.1.text#μέγ' ὠφέλημα τοῦτ' ἐδωρήσω βροτοῖς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:254.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:254.1.text#πρὸς τοῖσδε μέντοι πῦρ ἐγώ σφιν ὤπασα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:255.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:255.1.text#καὶ νῦν φλογωπὸν πῦρ ἔχουσ' ἐφήμεροι;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:256.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:256.1.text#ἀφ' οὗ γε πολλὰς ἐκμαθήσονται τέχνας.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:257.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:257.1.text#τοιοῖσδε δή σε Ζεὺς ἐπ' αἰτιάμασιν—
urn:cts:greekLit:tlg0085.tlg003.fu.sp:258.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:258.1.text#αἰκίζεταί τε κοὐδαμῇ χαλᾷ κακῶν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:259.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:259.1.text#οὐδ' ἔστιν ἄθλου τέρμα σοι προκείμενον;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:260.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:260.1.text#οὐκ ἄλλο γ' οὐδέν, πλὴν ὅταν κείνῳ δοκῇ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:261.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:261.1.text#δόξει δὲ πῶς; τίς ἐλπίς; οὐχ ὁρᾷς ὅτι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:262.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:262.1.text#ἥμαρτες; ὡς δ' ἥμαρτες οὔτ' ἐμοὶ λέγειν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:263.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:263.1.text#καθ' ἡδονὴν σοί τ' ἄλγος. ἀλλὰ ταῦτα μὲν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:264.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:264.1.text#μεθῶμεν, ἄθλου δ' ἔκλυσιν ζήτει τινά.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:265.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:265.1.text#ἐλαφρὸν ὅστις πημάτων ἔξω πόδα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:266.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:266.1.text#ἔχει παραινεῖν νουθετεῖν τε τὸν κακῶς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:267.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:267.1.text#πράσσοντ'· ἐγὼ δὲ ταῦθ' ἅπαντ' ἠπιστάμην.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:268.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:268.1.text#ἑκὼν ἑκὼν ἥμαρτον, οὐκ ἀρνήσομαι·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:269.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:269.1.text#θνητοῖς ἀρήγων αὐτὸς ηὑρόμην πόνους.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:270.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:270.1.text#οὐ μήν τι ποιναῖς γ' ᾠόμην τοίαισί με
urn:cts:greekLit:tlg0085.tlg003.fu.sp:271.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:271.1.text#κατισχνανεῖσθαι πρὸς πέτραις πεδαρσίοις,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:272.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:272.1.text#τυχόντ' ἐρήμου τοῦδ' ἀγείτονος πάγου.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:273.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:273.1.text#καί μοι τὰ μὲν παρόντα μὴ δύρεσθ' ἄχη,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:274.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:274.1.text#πέδοι δὲ βᾶσαι τὰς προσερπούσας τύχας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:275.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:275.1.text#ἀκούσαθ', ὡς μάθητε διὰ τέλους τὸ πᾶν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:276.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:276.1.text#πίθεσθέ μοι πίθεσθε, συμπονήσατε
urn:cts:greekLit:tlg0085.tlg003.fu.sp:277.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:277.1.text#τῷ νῦν μογοῦντι. ταὐτά τοι πλανωμένη
urn:cts:greekLit:tlg0085.tlg003.fu.sp:278.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:278.1.text#πρὸς ἄλλοτ' ἄλλον πημονὴ προσιζάνει.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:279.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:279.1.text#οὐκ ἀκούσαις ἐπεθώυξας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:280.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:280.1.text#τοῦτο, Προμηθεῦ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:281.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:281.1.text#καὶ νῦν ἐλαφρῷ ποδὶ κραιπνόσυτον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:282.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:282.1.text#θᾶκον προλιποῦσ', αἰθέρα θ' ἁγνὸν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:283.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:283.1.text#πόρον οἰωνῶν, ὀκριοέσσῃ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:284.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:284.1.text#χθονὶ τῇδε πελῶ, τοὺς σοὺς δὲ πόνους
urn:cts:greekLit:tlg0085.tlg003.fu.sp:285.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:285.1.text#χρῄζω διὰ παντὸς ἀκοῦσαι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:286.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:286.1.text#ἥκω δολιχῆς τέρμα κελεύθου
urn:cts:greekLit:tlg0085.tlg003.fu.sp:287.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:287.1.text#διαμειψάμενος πρὸς σέ, Προμηθεῦ,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:288.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:288.1.text#τὸν πτερυγωκῆ τόνδ' οἰωνὸν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:289.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:289.1.text#γνώμῃ στομίων ἄτερ εὐθύνων·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:290.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:290.1.text#ταῖς σαῖς δὲ τύχαις, ἴσθι, συναλγῶ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:291.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:291.1.text#τὸ τε γάρ με, δοκῶ, συγγενὲς οὕτως
urn:cts:greekLit:tlg0085.tlg003.fu.sp:292.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:292.1.text#ἐσαναγκάζει,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:293.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:293.1.text#χωρίς τε γένους οὐκ ἔστιν ὅτῳ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:294.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:294.1.text#μείζονα μοῖραν νείμαιμ' ἢ σοί.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:295.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:295.1.text#γνώσῃ δὲ τάδ' ὡς ἔτυμ', οὐδὲ μάτην
urn:cts:greekLit:tlg0085.tlg003.fu.sp:296.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:296.1.text#χαριτογλωσσεῖν ἔνι μοι· φέρε γὰρ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:297.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:297.1.text#σήμαιν' ὅ τι χρή σοι συμπράσσειν·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:298.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:298.1.text#οὐ γάρ ποτ' ἐρεῖς ὡς Ὠκεανοῦ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:299.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:299.1.text#φίλος ἐστὶ βεβαιότερός σοι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:300.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:300.1.text#ἔα· τί χρῆμα λεύσσω; καὶ σὺ δὴ πόνων ἐμῶν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:301.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:301.1.text#ἥκεις ἐπόπτης; πῶς ἐτόλμησας, λιπὼν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:302.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:302.1.text#ἐπώνυμόν τε ῥεῦμα καὶ πετρηρεφῆ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:303.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:303.1.text#αὐτόκτιτ' ἄντρα, τὴν σιδηρομήτορα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:304.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:304.1.text#ἐλθεῖν ἐς αἶαν; ἦ θεωρήσων τύχας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:305.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:305.1.text#ἐμὰς ἀφῖξαι καὶ συνασχαλῶν κακοῖς;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:306.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:306.1.text#δέρκου θέαμα, τόνδε τὸν Διὸς φίλον,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:307.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:307.1.text#τὸν συγκαταστήσαντα τὴν τυραννίδα,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:308.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:308.1.text#οἵαις ὑπ' αὐτοῦ πημοναῖσι κάμπτομαι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:309.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:309.1.text#ὁρῶ, Προμηθεῦ, καὶ παραινέσαι γέ σοι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:310.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:310.1.text#θέλω τὰ λῷστα, καίπερ ὄντι ποικίλῳ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:311.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:311.1.text#γίγνωσκε σαυτὸν καὶ μεθάρμοσαι τρόπους
urn:cts:greekLit:tlg0085.tlg003.fu.sp:312.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:312.1.text#νέους· νέος γὰρ καὶ τύραννος ἐν θεοῖς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:313.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:313.1.text#εἰ δ' ὧδε τραχεῖς καὶ τεθηγμένους λόγους
urn:cts:greekLit:tlg0085.tlg003.fu.sp:314.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:314.1.text#ῥίψεις, τάχ' ἄν σου καὶ μακρὰν ἀνωτέρω
urn:cts:greekLit:tlg0085.tlg003.fu.sp:315.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:315.1.text#θακῶν κλύοι Ζεύς, ὥστε σοι τὸν νῦν ὄχλον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:316.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:316.1.text#παρόντα μόχθων παιδιὰν εἶναι δοκεῖν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:317.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:317.1.text#ἀλλ', ὦ ταλαίπωρ', ἃς ἔχεις ὀργὰς ἄφες,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:318.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:318.1.text#ζήτει δὲ τῶνδε πημάτων ἀπαλλαγάς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:319.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:319.1.text#ἀρχαῖ' ἴσως σοι φαίνομαι λέγειν τάδε·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:320.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:320.1.text#τοιαῦτα μέντοι τῆς ἄγαν ὑψηγόρου
urn:cts:greekLit:tlg0085.tlg003.fu.sp:321.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:321.1.text#γλώσσης, Προμηθεῦ, τἀπίχειρα γίγνεται.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:322.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:322.1.text#σὺ δ' οὐδέπω ταπεινὸς οὐδ' εἴκεις κακοῖς,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:323.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:323.1.text#πρὸς τοῖς παροῦσι δ' ἄλλα προσλαβεῖν θέλεις.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:324.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:324.1.text#οὔκουν ἔμοιγε χρώμενος διδασκάλῳ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:325.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:325.1.text#πρὸς κέντρα κῶλον ἐκτενεῖς, ὁρῶν ὅτι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:326.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:326.1.text#τραχὺς μόναρχος οὐδ' ὑπεύθυνος κρατεῖ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:327.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:327.1.text#καὶ νῦν ἐγὼ μὲν εἶμι καὶ πειράσομαι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:328.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:328.1.text#ἐὰν δύνωμαι τῶνδέ σ' ἐκλῦσαι πόνων.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:329.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:329.1.text#σὺ δ' ἡσύχαζε μηδ' ἄγαν λαβροστόμει.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:330.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:330.1.text#ἢ οὐκ οἶσθ' ἀκριβῶς ὢν περισσόφρων ὅτι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:331.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:331.1.text#γλώσσῃ ματαίᾳ ζημία προστρίβεται;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:332.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:332.1.text#ζηλῶ σ' ὁθούνεκ' ἐκτὸς αἰτίας κυρεῖς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:333.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:333.1.text#τούτων μετασχεῖν καὶ τετολμηκὼς ἐμοί.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:334.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:334.1.text#καὶ νῦν ἔασον μηδέ σοι μελησάτω.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:335.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:335.1.text#πάντως γὰρ οὐ πείσεις νιν· οὐ γὰρ εὐπιθής.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:336.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:336.1.text#πάπταινε δ' αὐτὸς μή τι πημανθῇς ὁδῷ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:337.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:337.1.text#πολλῷ γ' ἀμείνων τοὺς πέλας φρενοῦν ἔφυς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:338.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:338.1.text#ἢ σαυτόν· ἔργῳ κοὐ λόγῳ τεκμαίρομαι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:340.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:340.1.text#ὁρμώμενον δὲ μηδαμῶς ἀντισπάσῃς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:341.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:341.1.text#αὐχῶ γὰρ αὐχῶ τήνδε δωρεὰν ἐμοὶ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:342.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:342.1.text#δώσειν Δί', ὥστε τῶνδέ σ' ἐκλῦσαι πόνων.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:343.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:343.1.text#τὰ μὲν σ' ἐπαινῶ κοὐδαμῇ λήξω ποτέ·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:343.2.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:343.2.text#προθυμίας γὰρ οὐδὲν ἐλλείπεις. ἀτὰρ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:344.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:344.1.text#μηδὲν πόνει. μάτην γὰρ οὐδὲν ὠφελῶν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:345.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:345.1.text#ἐμοὶ πονήσεις, εἴ τι καὶ πονεῖν θέλεις.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:346.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:346.1.text#ἀλλ' ἡσύχαζε σαυτὸν ἐκποδὼν ἔχων·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:347.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:347.1.text#ἐγὼ γὰρ οὐκ, εἰ δυστυχῶ, τοῦδ' εἵνεκα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:348.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:348.1.text#θέλοιμ' ἂν ὡς πλείστοισι πημονὰς τυχεῖν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:349.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:349.1.text#οὐ δῆτ' ἐπεί με καὶ κασιγνήτου τύχαι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:350.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:350.1.text#τείρουσ' Ἄτλαντος, ὃς πρὸς ἑσπέρους τόπους
urn:cts:greekLit:tlg0085.tlg003.fu.sp:351.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:351.1.text#ἕστηκε κίον' οὐρανοῦ τε καὶ χθονὸς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:352.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:352.1.text#ὤμοις ἐρείδων, ἄχθος οὐκ εὐάγκαλον.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:353.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:353.1.text#τὸν γηγενῆ τε Κιλικίων οἰκήτορα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:354.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:354.1.text#ἄντρων ἰδὼν ᾤκτιρα, δάιον τέρας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:355.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:355.1.text#ἑκατογκάρανον πρὸς βίαν χειρούμενον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:356.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:356.1.text#Τυφῶνα θοῦρον· πᾶσιν [ ὅς ] ἀντέστη θεοῖς,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:357.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:357.1.text#σμερδναῖσι γαμφηλαῖσι συρίζων φόβον·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:358.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:358.1.text#ἐξ ὀμμάτων δ' ἤστραπτε γοργωπὸν σέλας,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:359.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:359.1.text#ὡς τὴν Διὸς τυραννίδ' ἐκπέρσων βίᾳ·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:360.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:360.1.text#ἀλλ' ἦλθεν αὐτῷ Ζηνὸς ἄγρυπνον βέλος,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:361.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:361.1.text#καταιβάτης κεραυνὸς ἐκπνέων φλόγα,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:362.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:362.1.text#ὃς αὐτὸν ἐξέπληξε τῶν ὑψηγόρων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:363.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:363.1.text#κομπασμάτων. φρένας γὰρ εἰς αὐτὰς τυπεὶς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:364.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:364.1.text#ἐφεψαλώθη κἀξεβροντήθη σθένος.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:365.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:365.1.text#καὶ νῦν ἀχρεῖον καὶ παράορον δέμας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:366.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:366.1.text#κεῖται στενωποῦ πλησίον θαλασσίου
urn:cts:greekLit:tlg0085.tlg003.fu.sp:367.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:367.1.text#ἰπούμενος ῥίζαισιν Αἰτναίαις ὕπο·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:368.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:368.1.text#κορυφαῖς δ' ἐν ἄκραις ἥμενος μυδροκτυπεῖ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:369.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:369.1.text#Ἥφαιστος· ἔνθεν ἐκραγήσονταί ποτε
urn:cts:greekLit:tlg0085.tlg003.fu.sp:370.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:370.1.text#ποταμοὶ πυρὸς δάπτοντες ἀγρίαις γνάθοις
urn:cts:greekLit:tlg0085.tlg003.fu.sp:371.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:371.1.text#τῆς καλλικάρπου Σικελίας λευροὺς γύας·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:372.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:372.1.text#τοιόνδε Τυφὼς ἐξαναζέσει χόλον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:373.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:373.1.text#θερμοῖς ἀπλάτου βέλεσι πυρπνόου ζάλης,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:374.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:374.1.text#καίπερ κεραυνῷ Ζηνὸς ἠνθρακωμένος.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:375.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:375.1.text# σὺ δ' οὐκ ἄπειρος, οὐδ' ἐμοῦ διδασκάλου
urn:cts:greekLit:tlg0085.tlg003.fu.sp:376.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:376.1.text#χρῄζεις· σεαυτὸν σῷζ' ὅπως ἐπίστασαι·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:377.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:377.1.text#ἐγὼ δὲ τὴν παροῦσαν ἀντλήσω τύχην,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:378.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:378.1.text#ἔστ' ἂν Διὸς φρόνημα λωφήσῃ χόλου.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:379.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:379.1.text#οὔκουν, Προμηθεῦ, τοῦτο γιγνώσκεις, ὅτι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:380.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:380.1.text#ὀργῆς νοσούσης εἰσὶν ἰατροὶ λόγοι;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:381.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:381.1.text#ἐάν τις ἐν καιρῷ γε μαλθάσσῃ κέαρ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:382.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:382.1.text#καὶ μὴ σφριγῶντα θυμὸν ἰσχναίνῃ βίᾳ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:383.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:383.1.text#ἐν τῷ προθυμεῖσθαι δὲ καὶ τολμᾶν τίνα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:384.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:384.1.text#ὁρᾷς ἐνοῦσαν ζημίαν; δίδασκέ με.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:385.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:385.1.text#μόχθον περισσὸν κουφόνουν τ' εὐηθίαν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:386.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:386.1.text#ἔα με τῇδε τῇ νόσῳ νοσεῖν, ἐπεὶ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:387.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:387.1.text#κέρδιστον εὖ φρονοῦντα μὴ φρονεῖν δοκεῖν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:388.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:388.1.text#ἐμὸν δοκήσει τἀμπλάκημ' εἶναι τόδε.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:389.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:389.1.text#σαφῶς μ' ἐς οἶκον σὸς λόγος στέλλει πάλιν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:390.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:390.1.text#μὴ γάρ σε θρῆνος οὑμὸς εἰς ἔχθραν βάλῃ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:391.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:391.1.text#ἦ τῷ νέον θακοῦντι παγκρατεῖς ἕδρας;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:392.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:392.1.text#τούτου φυλάσσου μή ποτ' ἀχθεσθῇ κέαρ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:393.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:393.1.text#ἡ σή, Προμηθεῦ, συμφορὰ διδάσκαλος.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:394.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:394.1.text#στέλλου, κομίζου, σῷζε τὸν παρόντα νοῦν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:395.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:395.1.text#ὁρμωμένῳ μοι τόνδ' ἐθώυξας λόγον.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:396.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:396.1.text#λευρὸν γὰρ οἷμον αἰθέρος ψαίρει πτεροῖς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:397.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:397.1.text#τετρασκελὴς οἰωνός· ἄσμενος δέ τἂν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:398.1.speaker#Ὠκεανός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:398.1.text#σταθμοῖς ἐν οἰκείοισι κάμψειεν γόνυ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:399.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:399.1.text#στένω σε τᾶς οὐλομένας τύχας, Προμηθεῦ·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:400.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:400.1.text#δακρυσίστακτα δ' ἀπ' ὄσσων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:401.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:401.1.text#ῥαδινὰν λειβομένα ῥέος παρειὰν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:402.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:402.1.text#νοτίοις ἔτεγξα παγαῖς·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:403.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:403.1.text#ἀμέγαρτα γὰρ τάδε Ζεὺς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:404.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:404.1.text#ἰδίοις νόμοις κρατύνων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:405.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:405.1.text#ὑπερήφανον θεοῖς τοῖς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:406.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:406.1.text#πάρος ἐνδείκνυσιν αἰχμάν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:407.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:407.1.text#πρόπασα δ' ἤδη στονόεν λέλακε χώρα,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:408.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:408.1.text#μεγαλοσχήμονά ἀρχαι-
urn:cts:greekLit:tlg0085.tlg003.fu.sp:409.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:409.1.text#[ οπρεπῆ ] στένουσι τὰν σὰν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:410.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:410.1.text#ξυνομαιμόνων τε τιμάν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:411.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:411.1.text#ὁπόσοι τ' ἔποικον ἁγνᾶς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:412.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:412.1.text#Ἀσίας ἕδος νέμονται,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:413.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:413.1.text#μεγαλοστόνοισι σοῖς πή-
urn:cts:greekLit:tlg0085.tlg003.fu.sp:414.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:414.1.text#μασι συγκάμνουσι θνατοί.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:415.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:415.1.text#Κολχίδος τε γᾶς ἔνοικοι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:416.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:416.1.text#παρθένοι, μάχας ἄτρεστοι,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:417.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:417.1.text#καὶ Σκύθης ὅμιλος, οἳ γᾶς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:418.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:418.1.text#ἔσχατον τόπον ἀμφὶ Μαι-
urn:cts:greekLit:tlg0085.tlg003.fu.sp:419.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:419.1.text#ῶτιν ἔχουσι λίμναν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:420.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:420.1.text#{ Ἀραβίας } τ' ἄρειον ἄνθος,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:421.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:421.1.text#ὑψίκρημνον οἳ πόλισμα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:422.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:422.1.text#Καυκάσου πέλας νέμονται,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:423.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:423.1.text#δάιος στρατός, ὀξυπρῴ-
urn:cts:greekLit:tlg0085.tlg003.fu.sp:424.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:424.1.text#ροισι βρέμων ἐν αἰχμαῖς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:425.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:425.1.text#{ μόνον δὴ πρόσθεν ἄλλον ἐν πόνοις }
urn:cts:greekLit:tlg0085.tlg003.fu.sp:426.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:426.1.text#{ δαμέντ' ἀδαμαντοδέτοις }
urn:cts:greekLit:tlg0085.tlg003.fu.sp:427.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:427.1.text#{ Τιτᾶνα λύμαις εἰσιδόμαν, θεόν, }
urn:cts:greekLit:tlg0085.tlg003.fu.sp:428.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:428.1.text#{ Ἄτλαντος [ αἰὲν ]; ὑπέροχον σθένος κραταιόν, }
urn:cts:greekLit:tlg0085.tlg003.fu.sp:429.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:429.1.text#{ ὃς οὐράνιόν [ τε ] πόλον }
urn:cts:greekLit:tlg0085.tlg003.fu.sp:430.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:430.1.text#{ νώτοις στέγων ὑποστενάζει. }
urn:cts:greekLit:tlg0085.tlg003.fu.sp:431.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:431.1.text#βοᾷ δὲ πόντιος κλύδων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:432.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:432.1.text#ξυμπίτνων, στένει βυθός,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:433.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:433.1.text#κελαινὸς δ' Ἄιδος ὑποβρέμει μυχὸς γᾶς,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:434.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:434.1.text#παγαί θ' ἁγνορύτων ποταμῶν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:435.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:435.1.text#στένουσιν ἄλγος οἰκτρόν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:436.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:436.1.text#μή τοι χλιδῇ δοκεῖτε μηδ' αὐθαδίᾳ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:437.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:437.1.text#σιγᾶν με· συννοίᾳ δὲ δάπτομαι κέαρ,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:438.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:438.1.text#ὁρῶν ἐμαυτὸν ὧδε προυσελούμενον.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:439.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:439.1.text#καίτοι θεοῖσι τοῖς νέοις τούτοις γέρα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:440.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:440.1.text#τίς ἄλλος ἢ 'γὼ παντελῶς διώρισεν;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:441.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:441.1.text#ἀλλ' αὐτὰ σιγῶ· καὶ γὰρ εἰδυίαισιν ἂν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:442.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:442.1.text#ὑμῖν λέγοιμι· τἀν βροτοῖς δὲ πήματα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:443.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:443.1.text#ἀκούσαθ', ὥς σφας νηπίους ὄντας τὸ πρὶν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:444.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:444.1.text#ἔννους ἔθηκα καὶ φρενῶν ἐπηβόλους.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:445.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:445.1.text#λέξω δέ, μέμψιν οὔτιν' ἀνθρώποις ἔχων,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:446.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:446.1.text#ἀλλ' ὧν δέδωκ' εὔνοιαν ἐξηγούμενος·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:447.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:447.1.text#οἳ πρῶτα μὲν βλέποντες ἔβλεπον μάτην,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:448.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:448.1.text#κλύοντες οὐκ ἤκουον, ἀλλ' ὀνειράτων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:449.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:449.1.text#ἀλίγκιοι μορφαῖσι τὸν μακρὸν βίον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:450.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:450.1.text#ἔφυρον εἰκῇ πάντα, κοὔτε πλινθυφεῖς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:451.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:451.1.text#δόμους προσείλους, ᾖσαν, οὐ ξυλουργίαν·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:452.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:452.1.text#κατώρυχες δ' ἔναιον ὥστ' ἀήσυροι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:453.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:453.1.text#μύρμηκες ἄντρων ἐν μυχοῖς ἀνηλίοις.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:454.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:454.1.text#ἦν δ' οὐδὲν αὐτοῖς οὔτε χείματος τέκμαρ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:455.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:455.1.text#οὔτ' ἀνθεμώδους ἦρος οὔτε καρπίμου
urn:cts:greekLit:tlg0085.tlg003.fu.sp:456.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:456.1.text#θέρους βέβαιον, ἀλλ' ἄτερ γνώμης τὸ πᾶν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:457.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:457.1.text#ἔπρασσον, ἔστε δή σφιν ἀντολὰς ἐγὼ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:458.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:458.1.text#ἄστρων ἔδειξα τάς τε δυσκρίτους δύσεις.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:459.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:459.1.text#καὶ μὴν ἀριθμόν, ἔξοχον σοφισμάτων,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:460.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:460.1.text#ἐξηῦρον αὐτοῖς, γραμμάτων τε συνθέσεις,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:461.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:461.1.text#μνήμην ἁπάντων, μουσομήτορ' ἐργάνην.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:462.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:462.1.text#κἄζευξα πρῶτος ἐν ζυγοῖσι κνώδαλα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:463.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:463.1.text#ζεύγλαισι δουλεύοντα σάγμασὶν θ', ὅπως
urn:cts:greekLit:tlg0085.tlg003.fu.sp:464.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:464.1.text#θνητοῖς μεγίστων διάδοχοι μοχθημάτων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:465.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:465.1.text#γένοινθ' , ὑφ' ἅρμα τ' ἤγαγον φιληνίους
urn:cts:greekLit:tlg0085.tlg003.fu.sp:466.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:466.1.text#ἵππους, ἄγαλμα τῆς ὑπερπλούτου χλιδῆς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:467.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:467.1.text#θαλασσόπλαγκτα δ' οὔτις ἄλλος ἀντ' ἐμοῦ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:468.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:468.1.text#λινόπτερ' ηὗρε ναυτίλων ὀχήματα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:469.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:469.1.text#τοιαῦτα μηχανήματ' ἐξευρὼν τάλας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:470.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:470.1.text#βροτοῖσιν, αὐτὸς οὐκ ἔχω σόφισμ' ὅτῳ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:471.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:471.1.text#τῆς νῦν παρούσης πημονῆς ἀπαλλαγῶ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:472.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:472.1.text#πέπονθας αἰκὲς πῆμ'· ἀποσφαλεὶς φρενῶν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:473.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:473.1.text#πλανᾷ, κακὸς δ' ἰατρὸς ὥς τις ἐς νόσον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:474.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:474.1.text#πεσὼν ἀθυμεῖς καὶ σεαυτὸν οὐκ ἔχεις
urn:cts:greekLit:tlg0085.tlg003.fu.sp:475.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:475.1.text#εὑρεῖν ὁποίοις φαρμάκοις ἰάσιμος.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:476.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:476.1.text#τὰ λοιπά μου κλύουσα θαυμάσῃ πλέον,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:477.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:477.1.text#οἵας τέχνας τε καὶ πόρους ἐμησάμην.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:478.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:478.1.text#τὸ μὲν μέγιστον, εἴ τις ἐς νόσον πέσοι,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:479.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:479.1.text#οὐκ ἦν ἀλέξημ' οὐδέν, οὔτε βρώσιμον,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:480.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:480.1.text#οὐ χριστόν, οὐδὲ πιστόν, ἀλλὰ φαρμάκων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:481.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:481.1.text#χρείᾳ κατεσκέλλοντο, πρίν γ' ἐγώ σφισιν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:482.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:482.1.text#ἔδειξα κράσεις ἠπίων ἀκεσμάτων,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:483.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:483.1.text#αἷς τὰς ἁπάσας ἐξαμύνονται νόσους.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:484.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:484.1.text#τρόπους τε πολλοὺς μαντικῆς ἐστοίχισα,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:485.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:485.1.text#κἄκρινα πρῶτος ἐξ ὀνειράτων ἃ χρὴ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:486.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:486.1.text#ὕπαρ γενέσθαι, κληδόνας τε δυσκρίτους
urn:cts:greekLit:tlg0085.tlg003.fu.sp:487.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:487.1.text#ἐγνώρισ' αὐτοῖς ἐνοδίους τε συμβόλους·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:488.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:488.1.text#γαμψωνύχων τε πτῆσιν οἰωνῶν σκεθρῶς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:489.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:489.1.text#διώρισ', οἵτινές τε δεξιοὶ φύσιν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:490.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:490.1.text#εὐωνύμους τε, καὶ δίαιταν ἥντινα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:491.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:491.1.text#ἔχουσ' ἕκαστοι, καὶ πρὸς ἀλλήλους τίνες
urn:cts:greekLit:tlg0085.tlg003.fu.sp:492.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:492.1.text#ἔχθραι τε καὶ στέργηθρα καὶ συνεδρίαι·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:493.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:493.1.text#σπλάγχνων τε λειότητα, καὶ χροιὰν τίνα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:494.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:494.1.text#ἔχουσ' ἂν εἴη δαίμοσιν πρὸς ἡδονὴν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:495.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:495.1.text#χολή, λοβοῦ τε ποικίλην εὐμορφίαν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:496.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:496.1.text#κνίσῃ τε κῶλα συγκαλυπτὰ καὶ μακρὰν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:497.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:497.1.text#ὀσφῦν πυρώσας δυστέκμαρτον ἐς τέχνην
urn:cts:greekLit:tlg0085.tlg003.fu.sp:498.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:498.1.text#ὥδωσα θνητούς, καὶ φλογωπὰ σήματα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:499.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:499.1.text#ἐξωμμάτωσα, πρόσθεν ὄντ' ἐπάργεμα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:500.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:500.1.text#τοιαῦτα μὲν δὴ ταῦτ'· ἔνερθε δὲ χθονὸς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:501.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:501.1.text#κεκρυμμέν', ἀνθρώποισιν ὠφελήματα,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:502.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:502.1.text#χαλκόν, σίδηρον, ἄργυρον, χρυσόν τε τίς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:503.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:503.1.text#φήσειεν ἂν πάροιθεν ἐξευρεῖν ἐμοῦ;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:504.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:504.1.text#οὐδείς, σάφ' οἶδα, μὴ μάτην φλύσαι θέλων.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:505.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:505.1.text#βραχεῖ δὲ μύθῳ πάντα συλλήβδην μάθε,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:506.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:506.1.text#πᾶσαι τέχναι βροτοῖσιν ἐκ Προμηθέως.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:507.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:507.1.text#μή νυν βροτοὺς μὲν ὠφέλει καιροῦ πέρα,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:508.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:508.1.text#σαυτοῦ δ' ἀκήδει δυστυχοῦντος. ὡς ἐγὼ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:509.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:509.1.text#εὔελπίς εἰμι τῶνδέ σ' ἐκ δεσμῶν ἔτι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:510.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:510.1.text#λυθέντα μηδὲν μεῖον ἰσχύσειν Διός.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:511.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:511.1.text#οὐ ταῦτα ταύτῃ Μοῖρά πω τελεσφόρος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:512.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:512.1.text#κρᾶναι πέπρωται, μυρίαις δὲ πημοναῖς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:513.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:513.1.text#δύαις τε καμφθεὶς ὧδε δεσμὰ φυγγάνω·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:514.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:514.1.text#τέχνη δ' ἀνάγκης ἀσθενεστέρα μακρῷ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:515.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:515.1.text#τίς οὖν ἀνάγκης ἐστὶν οἰακοστρόφος;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:516.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:516.1.text#Μοῖραι τρίμορφοι μνήμονές τ' Ἐρινύες
urn:cts:greekLit:tlg0085.tlg003.fu.sp:517.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:517.1.text#τούτων ἄρα Ζεύς ἐστιν ἀσθενέστερος;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:518.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:518.1.text#οὔκουν ἂν ἐκφύγοι γε τὴν πεπρωμένην.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:519.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:519.1.text#τί γὰρ πέπρωται Ζηνὶ πλὴν ἀεὶ κρατεῖν;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:520.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:520.1.text#τοῦτ' οὐκέτ' ἂν πύθοιο μηδὲ λιπάρει.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:521.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:521.1.text#ἦ πού τι σεμνόν ἐστιν ὃ ξυναμπέχεις.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:522.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:522.1.text#ἄλλου λόγου μέμνησθε, τόνδε δ' οὐδαμῶς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:523.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:523.1.text#καιρὸς γεγωνεῖν, ἀλλὰ συγκαλυπτέος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:524.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:524.1.text#ὅσον μάλιστα· τόνδε γὰρ σῴζων ἐγὼ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:525.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:525.1.text#δεσμοὺς ἀεικεῖς καὶ δύας ἐκφυγγάνω.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:526.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:526.1.text#μηδάμ' ὁ πάντα νέμων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:527.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:527.1.text#θεῖτ' ἐμᾷ γνώμᾳ κράτος ἀντίπαλον Ζεύς,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:530.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:530.1.text#μηδ' ἐλινύσαιμι θεοὺς ὁσίαις θοίναις ποτινισομένα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:531.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:531.1.text#βουφόνοις παρ' Ὠκεανοῦ πατρὸς ἄσβεστον πόρον,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:535.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:535.1.text#μηδ' ἀλίτοιμι λόγοις·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:536.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:536.1.text#ἀλλά μοι τόδ' ἐμμένοι καὶ μήποτ' ἐκτακείη·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:537.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:537.1.text#ἁδύ τι θαρσαλέαις
urn:cts:greekLit:tlg0085.tlg003.fu.sp:538.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:538.1.text#τὸν μακρὸν τείνειν βίον ἐλπίσι, φαναῖς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:539.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:539.1.text#θυμὸν ἀλδαίνουσαν ἐν εὐφροσύναις. φρίσ-
urn:cts:greekLit:tlg0085.tlg003.fu.sp:540.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:540.1.text#σω δέ σε δερκομένα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:541.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:541.1.text#μυρίοις μόχθοις διακναιόμενον { }.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:542.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:542.1.text#Ζῆνα γὰρ οὐ τρομέων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:543.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:543.1.text#ἰδίᾳ γνώμᾳ σέβῃ θνατοὺς ἄγαν, Προμηθεῦ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:545.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:545.1.text#φέρ', ὅπως ἄχαρις χάρις, ὦ φίλος·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:546.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:546.1.text#εἰπὲ ποῦ τίς ἀλκά;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:547.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:547.1.text#τίς ἐφαμερίων ἄρηξις; οὐδ' ἐδέρχθης
urn:cts:greekLit:tlg0085.tlg003.fu.sp:548.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:548.1.text#ὀλιγοδρανίαν ἄκικυν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:549.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:549.1.text#ἰσόνειρον, ᾇ τὸ φωτῶν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:550.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:550.1.text#ἀλαὸν γένος ἐμπεποδισμένον; οὔποτε { } 
urn:cts:greekLit:tlg0085.tlg003.fu.sp:551.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:551.1.text#τὰν Διὸς ἁρμονίαν θνατῶν παρεξίασι βουλαί.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:552.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:552.1.text#ἔμαθον τάδε σὰς προσιδοῦσ' ὀλο-
urn:cts:greekLit:tlg0085.tlg003.fu.sp:553.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:553.1.text#ὰς τύχας, Προμηθεῦ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:554.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:554.1.text#τὸ διαμφίδιον δέ μοι μέλος προσέπτα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:555.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:555.1.text#τόδ' ἐκεῖνό θ', ὅ τ' ἀμφὶ λουτρὰ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:556.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:556.1.text#καὶ λέχος σὸν ὑμεναίουν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:557.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:557.1.text#ἰότατι γάμων, ὅτε τὰν ὁμοπάτριον ἕδνοις
urn:cts:greekLit:tlg0085.tlg003.fu.sp:560.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:560.1.text#ἄγαγες Ἡσιόναν πείθὼν δάμαρτα κοινόλεκτρον.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:561.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:561.1.text#τίς γῆ; τί γένος; τίνα φῶ λεύσσειν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:562.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:562.1.text#τόνδε χαλινοῖς ἐν πετρίνοισιν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:563.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:563.1.text#χειμαζόμενον;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:564.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:564.1.text#τίνος ἀμπλακίας ποινὰς ὀλέκῃ;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:565.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:565.1.text#σήμηνον ὅποι γῆς ἡ μογερὰ πεπλάνημαι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:566.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:566.1.text#ἆ ἆ, ἒ ἔ,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:567.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:567.1.text#χρίει τις αὖ με τὰν τάλαιναν οἶστρος,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:568.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:568.1.text#εἴδωλον Ἄργου γηγενοῦς, ἄλευ' ἆ δᾶ· φοβοῦμαι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:569.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:569.1.text#τὸν μυριωπὸν εἰσορῶσα βούταν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:570.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:570.1.text#ὁ δὲ πορεύεται δόλιον ὄμμ' ἔχων,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:570.2.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:570.2.text#ὃν οὐδὲ κατθανόντα γαῖα κεύθει.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:571.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:571.1.text#ἀλλ', ἐμὲ τὰν τάλαιναν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:572.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:572.1.text#ἐξ ἐνέρων περῶν κυναγετεῖ, πλανᾷ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:573.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:573.1.text#τε νῆστιν ἀνὰ τὰν παραλίαν ψάμμαν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:574.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:574.1.text#ὑπὸ δὲ κηρόπλαστος ὀτοβεῖ δόναξ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:575.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:575.1.text#ἀχέτας ὑπνοδόταν νόμον·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:576.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:576.1.text#ἰὼ ἰὼ πόποι, ποῖ μ' ἄγουσι τη-
urn:cts:greekLit:tlg0085.tlg003.fu.sp:577.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:577.1.text#λέπλαγκτοι πλάναι;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:578.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:578.1.text#τί ποτέ μ', ὦ Κρόνιε παῖ, τί ποτε ταῖσδ'
urn:cts:greekLit:tlg0085.tlg003.fu.sp:579.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:579.1.text#ἐνέζευξας εὑρὼν ἁμαρτοῦσαν ἐν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:580.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:580.1.text#πημοναῖσιν; ἓ ἕ,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:581.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:581.1.text#οἰστρηλάτῳ δὲ δείματι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:582.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:582.1.text#δειλαίαν παράκοπον ὧδε τείρεις;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:583.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:583.1.text#πυρί με  φλέξον, ἢ χθονὶ κάλυψον, ἤ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:584.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:584.1.text#ποντίοις δάκεσι δὸς βοράν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:585.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:585.1.text#μηδέ μοι φθονήσῃς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:585.2.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:585.2.text#ἄδην με πολύπλανοι πλάναι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:586.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:586.1.text#εὐγμάτων, ἄναξ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:586.2.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:586.2.text#γεγυμνάκασιν, οὐδ' ἔχω μαθεῖν ὅπα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:587.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:587.1.text#πημονὰς ἀλύξω.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:588.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:588.1.text#κλύεις φθέγμα τᾶς βούκερω παρθένου;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:589.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:589.1.text#πῶς δ' οὐ κλύω τῆς οἰστροδινήτου κόρης,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:590.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:590.1.text#τῆς Ἰναχείας; ἣ Διὸς θάλπει κέαρ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:591.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:591.1.text#ἔρωτι, καὶ νῦν τοὺς ὑπερμήκεις δρόμους
urn:cts:greekLit:tlg0085.tlg003.fu.sp:592.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:592.1.text#Ἥρᾳ στυγητὸς πρὸς βίαν γυμνάζεται.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:593.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:593.1.text#πόθεν ἐμοῦ σὺ πατρὸς ὄνομ' ἀπύεις;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:594.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:594.1.text#εἰπέ μοι τᾷ μογερᾷ τίς ὤν;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:595.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:595.1.text#τίς ἄρα μ', ὦ τάλας, τὰν τάλαιναν ὧδ'
urn:cts:greekLit:tlg0085.tlg003.fu.sp:596.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:596.1.text#ἔτυμα προσθροεῖς;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:597.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:597.1.text#θεόσυτόν τε νόσον ὠνόμασας, ἃ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:598.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:598.1.text#μαραίνει με χρίουσα κέντροις, ἰώ,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:599.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:599.1.text#φοιταλέοισιν ἓ ἕ·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:600.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:600.1.text#σκιρτημάτων δὲ νήστισιν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:600.2.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:600.2.text#αἰκείαις λαβρόσυτος ἦλθον, Ἥρας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:601.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:601.1.text#ἐπικότοισι μήδεσι δαμεῖσα. δυσ-
urn:cts:greekLit:tlg0085.tlg003.fu.sp:602.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:602.1.text#δαιμόνων δὲ τίνες οἵ, ἓ ἕ,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:603.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:603.1.text#οἷ' ἐγὼ μογοῦσιν;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:604.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:604.1.text#ἀλλά μοι τορῶς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:605.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:605.1.text#τέκμηρον ὅ τι μ' ἐπαμμένει
urn:cts:greekLit:tlg0085.tlg003.fu.sp:606.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:606.1.text#παθεῖν, τί μῆχαρ, ἢ τί φάρμακον νόσου,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:607.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:607.1.text#δεῖξον, εἴπερ οἶσθα·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:608.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:608.1.text#θρόει, φράζε τᾷ δυσπλάνῳ παρθένῳ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:609.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:609.1.text#λέξω τορῶς σοι πᾶν ὅπερ χρῄζεις μαθεῖν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:610.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:610.1.text#οὐκ ἐμπλέκων αἰνίγματ', ἀλλ' ἁπλῷ λόγῳ,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:611.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:611.1.text#ὥσπερ δίκαιον πρὸς φίλους οἴγειν στόμα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:612.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:612.1.text#πυρὸς βροτοῖς δοτῆρ' ὁρᾷς Προμηθέα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:613.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:613.1.text#ὦ κοινὸν ὠφέλημα θνητοῖσιν φανείς,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:614.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:614.1.text#τλῆμον Προμηθεῦ, τοῦ δίκην πάσχεις τάδε;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:615.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:615.1.text#ἁρμοῖ πέπαυμαι τοὺς ἐμοὺς θρηνῶν πόνους.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:616.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:616.1.text#οὔκουν πόροις ἂν τήνδε δωρεὰν ἐμοί;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:617.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:617.1.text#λέγ' ἥντιν' αἰτῇ· πᾶν γὰρ ἂν πύθοιό μου.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:618.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:618.1.text#σήμηνον ὅστις ἐν φάραγγί σ' ὤχμασεν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:619.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:619.1.text#βούλευμα μὲν τὸ Δῖον, Ἡφαίστου δὲ χείρ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:620.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:620.1.text#ποινὰς δὲ ποίων ἀμπλακημάτων τίνεις;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:621.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:621.1.text#τοσοῦτον ἀρκῶ σοι σαφηνίσας μόνον.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:622.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:622.1.text#καὶ πρός γε τούτοις τέρμα τῆς ἐμῆς πλάνης
urn:cts:greekLit:tlg0085.tlg003.fu.sp:623.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:623.1.text#δεῖξον, τίς ἔσται τῇ ταλαιπώρῳ χρόνος.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:624.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:624.1.text#τὸ μὴ μαθεῖν σοι κρεῖσσον ἢ μαθεῖν τάδε.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:625.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:625.1.text#μήτοι με κρύψῃς τοῦθ' ὅπερ μέλλω παθεῖν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:626.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:626.1.text#ἀλλ' οὐ μεγαίρω τοῦδέ σοι δωρήματος.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:627.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:627.1.text#τί δῆτα μέλλεις μὴ οὐ γεγωνίσκειν τὸ πᾶν;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:628.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:628.1.text#φθόνος μὲν οὐδείς, σὰς δ' ὀκνῶ θράξαι φρένας.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:629.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:629.1.text#μή μου προκήδου μᾶσσον ὡς ἐμοὶ γλυκύ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:630.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:630.1.text#ἐπεὶ προθυμῇ, χρὴ λέγειν. ἄκουε δή.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:631.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:631.1.text#μήπω γε· μοῖραν δ' ἡδονῆς κἀμοὶ πόρε.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:632.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:632.1.text#τὴν τῆσδε πρῶτον ἱστορήσωμεν νόσον,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:633.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:633.1.text#αὐτῆς λεγούσης τὰς πολυφθόρους τύχας·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:634.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:634.1.text#τὰ λοιπὰ δ' ἄθλων σοῦ διδαχθήτω πάρα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:635.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:635.1.text#σὸν ἔργον, Ἰοῖ, ταῖσδ' ὑπουργῆσαι χάριν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:636.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:636.1.text#ἄλλως τε πάντως καὶ κασιγνήταις πατρός.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:637.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:637.1.text#ὡς τἀποκλαῦσαι κἀποδύρασθαι τύχας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:638.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:638.1.text#ἐνταῦθ', ὅπου μέλλοι τις οἴσεσθαι δάκρυ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:639.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:639.1.text#πρὸς τῶν κλυόντων, ἀξίαν τριβὴν ἔχει.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:640.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:640.1.text#οὐκ οἶδ' ὅπως ὑμῖν ἀπιστῆσαί με χρή,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:641.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:641.1.text#σαφεῖ δὲ μύθῳ πᾶν ὅπερ προσχρῄζετε
urn:cts:greekLit:tlg0085.tlg003.fu.sp:642.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:642.1.text#πεύσεσθε· καίτοι καὶ λέγουσ' αἰσχύνομαι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:643.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:643.1.text#θεόσσυτον χειμῶνα καὶ διαφθορὰν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:644.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:644.1.text#μορφῆς, ὅθεν μοι σχετλίᾳ προσέπτατο.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:645.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:645.1.text#αἰεὶ γὰρ ὄψεις ἔννυχοι πωλεύμεναι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:646.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:646.1.text#ἐς παρθενῶνας τοὺς ἐμοὺς παρηγόρουν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:647.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:647.1.text#λείοισι μύθοις "ὦ μέγ' εὔδαιμον κόρη,"
urn:cts:greekLit:tlg0085.tlg003.fu.sp:648.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:648.1.text#"τί παρθενεύει δαρόν, ἐξόν σοι γάμου"
urn:cts:greekLit:tlg0085.tlg003.fu.sp:649.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:649.1.text#"τυχεῖν μεγίστου; Ζεὺς γὰρ ἱμέρου βέλει"
urn:cts:greekLit:tlg0085.tlg003.fu.sp:650.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:650.1.text#"πρὸς σοῦ τέθαλπται καὶ συναίρεσθαι Κύπριν"
urn:cts:greekLit:tlg0085.tlg003.fu.sp:651.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:651.1.text#"θέλει· σὺ δ', ὦ παῖ, μὴ 'πολακτίσῃς λέχος"
urn:cts:greekLit:tlg0085.tlg003.fu.sp:652.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:652.1.text#"τὸ Ζηνός, ἀλλ' ἔξελθε πρὸς Λέρνης βαθὺν"
urn:cts:greekLit:tlg0085.tlg003.fu.sp:653.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:653.1.text#"λειμῶνα, ποίμνας βουστάσεις τε πρὸς πατρός,"
urn:cts:greekLit:tlg0085.tlg003.fu.sp:654.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:654.1.text#"ὡς ἂν τὸ Δῖον ὄμμα λωφήσῃ πόθου."
urn:cts:greekLit:tlg0085.tlg003.fu.sp:655.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:655.1.text#τοιοῖσδε πάσας εὐφρόνας ὀνείρασι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:656.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:656.1.text#συνειχόμην δύστηνος, ἔστε δὴ πατρὶ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:657.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:657.1.text#ἔτλην γεγωνεῖν νυκτίφοιτ' ὀνείρατα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:658.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:658.1.text#ὁ δ' ἔς τε Πυθὼ κἀπὶ Δωδώνης πυκνοὺς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:659.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:659.1.text#θεοπρόπους ἴαλλεν, ὡς μάθοι τί χρὴ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:660.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:660.1.text#δρῶντ' ἢ λέγοντα δαίμοσιν πράσσειν φίλα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:661.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:661.1.text#ἧκον δ' ἀναγγέλλοντες αἰολοστόμους
urn:cts:greekLit:tlg0085.tlg003.fu.sp:662.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:662.1.text#χρησμοὺς ἀσήμους δυσκρίτως τ' εἰρημένους.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:663.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:663.1.text#τέλος δ' ἐναργὴς βάξις ἦλθεν Ἰνάχῳ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:664.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:664.1.text#σαφῶς ἐπισκήπτουσα καὶ μυθουμένη
urn:cts:greekLit:tlg0085.tlg003.fu.sp:665.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:665.1.text#ἔξω δόμων τε καὶ πάτρας ὠθεῖν ἐμέ,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:666.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:666.1.text#ἄφετον ἀλᾶσθαι γῆς ἐπ' ἐσχάτοις ὅροις·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:667.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:667.1.text#κεἰ μὴ θέλοι, πυρωπὸν ἐκ Διὸς μολεῖν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:668.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:668.1.text#κεραυνόν, ὃς πᾶν ἐξαϊστώσοι γένος.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:669.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:669.1.text#τοιοῖσδε πεισθεὶς Λοξίου μαντεύμασιν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:670.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:670.1.text#ἐξήλασέν με κἀπέκλῃσε δωμάτων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:671.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:671.1.text#ἄκουσαν ἄκων· ἀλλ' ἐπηνάγκαζέ νιν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:672.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:672.1.text#Διὸς χαλινὸς πρὸς βίαν πράσσειν τάδε.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:673.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:673.1.text#εὐθὺς δὲ μορφὴ καὶ φρένες διάστροφοι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:674.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:674.1.text#ἦσαν, κεραστὶς δ', ὡς ὁρᾶτ', ὀξυστόμῳ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:675.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:675.1.text#μύωπι χρισθεῖσ' ἐμμανεῖ σκιρτήματι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:676.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:676.1.text#ᾖσσον πρὸς εὔποτόν τε Κερχνείας ῥέος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:677.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:677.1.text#Λέρνης τε κρήνην · βουκόλος δὲ γηγενὴς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:678.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:678.1.text#ἄκρατος ὀργὴν Ἄργος ὡμάρτει, πυκνοῖς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:679.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:679.1.text#ὄσσοις δεδορκὼς τοὺς ἐμοὺς κατὰ στίβους.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:680.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:680.1.text#ἀπροσδόκητος δ' αὐτὸν ἀφνίδιος μόρος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:681.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:681.1.text#τοῦ ζῆν ἀπεστέρησεν. οἰστροπλὴξ δ' ἐγὼ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:682.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:682.1.text#μάστιγι θείᾳ γῆν πρὸ γῆς ἐλαύνομαι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:683.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:683.1.text#κλύεις τὰ πραχθέντ'· εἰ δ' ἔχεις εἰπεῖν ὅ τι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:684.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:684.1.text#λοιπὸν πόνων, σήμαινε· μηδέ μ' οἰκτίσας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:685.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:685.1.text#ξύνθαλπε μύθοις ψευδέσιν· νόσημα γὰρ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:686.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:686.1.text#αἴσχιστον εἶναί φημι συνθέτους λόγους.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:687.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:687.1.text#ἔα ἔα, ἄπεχε, φεῦ·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:688.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:688.1.text#οὔποτ' οὔποτ' ηὔχουν ὧδε  ξένους
urn:cts:greekLit:tlg0085.tlg003.fu.sp:689.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:689.1.text#μολεῖσθαι λόγους εἰς ἀκοὰν ἐμάν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:690.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:690.1.text#οὐδ' ὧδε δυσθέατα καὶ δύσοιστα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:691.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:691.1.text#πήματα, λύματα, [ δείματα ] ἀμ-
urn:cts:greekLit:tlg0085.tlg003.fu.sp:692.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:692.1.text#φάκει κέντρῳ τύψειν ψυχὰν ἐμάν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:693.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:693.1.text#ἰὼ [ ἰὼ ] μοῖρα μοῖρα,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:695.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:695.1.text#πέφρικ' εἰσιδοῦσα πρᾶξιν Ἰοῦς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:696.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:696.1.text#πρῴ γε στενάζεις καὶ φόβου πλέα τις εἶ·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:697.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:697.1.text#ἐπίσχες ἔστ' ἂν καὶ τὰ λοιπὰ προσμάθῃς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:698.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:698.1.text#λέγ', ἐκδίδασκε· τοῖς νοσοῦσί τοι γλυκὺ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:699.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:699.1.text#τὸ λοιπὸν ἄλγος προυξεπίστασθαι τορῶς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:700.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:700.1.text#τὴν πρίν γε χρείαν ἠνύσασθ' ἐμοῦ πάρα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:701.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:701.1.text#κούφως· μαθεῖν γὰρ τῆσδε πρῶτ' ἐχρῄζετε
urn:cts:greekLit:tlg0085.tlg003.fu.sp:702.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:702.1.text#τὸν ἀμφ' ἑαυτῆς ἆθλον ἐξηγουμένης·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:703.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:703.1.text#τὰ λοιπὰ νῦν ἀκούσαθ', οἷα χρὴ πάθη
urn:cts:greekLit:tlg0085.tlg003.fu.sp:704.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:704.1.text#τλῆναι πρὸς Ἥρας τήνδε τὴν νεάνιδα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:705.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:705.1.text#σύ τ' Ἰνάχειον σπέρμα, τοὺς ἐμοὺς λόγους
urn:cts:greekLit:tlg0085.tlg003.fu.sp:706.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:706.1.text#θυμῷ βάλ', ὡς ἂν τέρματ' ἐκμάθῃς ὁδοῦ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:707.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:707.1.text#πρῶτον μὲν ἐνθένδ' ἡλίου πρὸς ἀντολὰς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:708.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:708.1.text#στρέψασα σαυτὴν στεῖχ' ἀνηρότους γύας·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:709.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:709.1.text#Σκύθας δ' ἀφίξῃ νομάδας, οἳ πλεκτὰς στέγας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:710.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:710.1.text#πεδάρσιοι ναίουσ' ἐπ' εὐκύκλοις ὄχοις
urn:cts:greekLit:tlg0085.tlg003.fu.sp:711.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:711.1.text#ἑκηβόλοις τόξοισιν ἐξηρτυμένοι·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:712.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:712.1.text#οἷς μὴ πελάζειν, ἀλλ' ἁλιστόνοις πόδας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:713.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:713.1.text#χρίμπτουσα ῥαχίαισιν ἐκπερᾶν χθόνα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:714.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:714.1.text#λαιᾶς δὲ χειρὸς οἱ σιδηροτέκτονες
urn:cts:greekLit:tlg0085.tlg003.fu.sp:715.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:715.1.text#οἰκοῦσι Χάλυβες, οὓς φυλάξασθαί σε χρή.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:716.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:716.1.text#ἀνήμεροι γὰρ οὐδὲ πρόσπλατοι ξένοις.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:717.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:717.1.text#ἥξεις δ' Ὑβριστὴν ποταμὸν οὐ ψευδώνυμον,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:718.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:718.1.text#ὃν μὴ περάσῃς, οὐ γὰρ εὔβατος περᾶν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:719.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:719.1.text#πρὶν ἂν πρὸς αὐτὸν Καύκασον μόλῃς, ὀρῶν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:720.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:720.1.text#ὕψιστον, ἔνθα ποταμὸς ἐκφυσᾷ μένος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:721.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:721.1.text#κροτάφων ἀπ' αὐτῶν. ἀστρογείτονας δὲ χρὴ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:722.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:722.1.text#κορυφὰς ὑπερβάλλουσαν ἐς μεσημβρινὴν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:723.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:723.1.text#βῆναι κέλευθον, ἔνθ', Ἀμαζόνων στρατὸν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:724.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:724.1.text#ἥξεις στυγάνορ', αἳ Θεμίσκυράν ποτε
urn:cts:greekLit:tlg0085.tlg003.fu.sp:725.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:725.1.text#κατοικιοῦσιν ἀμφὶ Θερμώδονθ', ἵνα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:726.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:726.1.text#τραχεῖα πόντου Σαλμυδησσία γνάθος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:727.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:727.1.text#ἐχθρόξενος ναύταισι, μητρυιὰ νεῶν·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:728.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:728.1.text#αὗταί σ' ὁδηγήσουσι καὶ μάλ' ἀσμένως.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:729.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:729.1.text#ἰσθμὸν δ' ἐπ' αὐταῖς στενοπόροις λίμνης πύλαις
urn:cts:greekLit:tlg0085.tlg003.fu.sp:730.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:730.1.text#Κιμμερικὸν ἥξεις, ὃν θρασυσπλάγχνως σε χρὴ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:731.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:731.1.text#λιποῦσαν αὐλῶν' ἐκπερᾶν Μαιωτικόν·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:732.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:732.1.text#ἔσται δὲ θνητοῖς εἰσαεὶ λόγος μέγας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:733.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:733.1.text#τῆς σῆς πορείας, Βόσπορος δ' ἐπώνυμος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:734.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:734.1.text#κεκλήσεται. λιποῦσα δ' Εὐρώπης πέδον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:735.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:735.1.text#ἤπειρον ἥξεις Ἀσιάδ'·. ἆρ', ὑμῖν δοκεῖ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:736.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:736.1.text#ὁ τῶν θεῶν τύραννος ἐς τὰ πάνθ' ὁμῶς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:737.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:737.1.text#βίαιος εἶναι; τῇδε γὰρ θνητῇ θεὸς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:738.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:738.1.text#χρῄζων μιγῆναι τάσδ' ἐπέρριψεν πλάνας.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:739.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:739.1.text#πικροῦ δ' ἔκυρσας, ὦ κόρη, τῶν σῶν γάμων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:740.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:740.1.text#μνηστῆρος. οὓς γὰρ νῦν ἀκήκοας λόγους,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:741.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:741.1.text#εἶναι δόκει σοι μηδέπω 'ν προοιμίοις.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:742.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:742.1.text#ἰώ μοί μοι, ἒ ἔ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:743.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:743.1.text#σὺ δ' αὖ κέκραγας κἀναμυχθίζῃ; τί που
urn:cts:greekLit:tlg0085.tlg003.fu.sp:744.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:744.1.text#δράσεις, ὅταν τὰ λοιπὰ πυνθάνῃ κακά;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:745.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:745.1.text#ἦ γάρ τι λοιπὸν τῇδε πημάτων ἐρεῖς;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:746.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:746.1.text#δυσχείμερόν γε πέλαγος ἀτηρᾶς δύης.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:747.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:747.1.text#τί δῆτ' ἐμοὶ ζῆν κέρδος, ἀλλ' οὐκ ἐν τάχει
urn:cts:greekLit:tlg0085.tlg003.fu.sp:748.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:748.1.text#ἔρριψ' ἐμαυτὴν τῆσδ' ἀπὸ στύφλου πέτρας,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:749.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:749.1.text#ὅπως πέδοι σκήψασα τῶν πάντων πόνων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:750.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:750.1.text#ἀπηλλάγην; κρεῖσσον γὰρ εἰσάπαξ θανεῖν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:751.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:751.1.text#ἢ τὰς ἁπάσας ἡμέρας πάσχειν κακῶς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:752.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:752.1.text#ἦ δυσπετῶς ἂν τοὺς ἐμοὺς ἄθλους φέροις,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:753.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:753.1.text#ὅτῳ θανεῖν μέν ἐστιν οὐ πεπρωμένον·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:754.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:754.1.text#αὕτη γὰρ ἦν ἂν πημάτων ἀπαλλαγή·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:755.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:755.1.text#νῦν δ' οὐδέν ἐστι τέρμα μοι προκείμενον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:756.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:756.1.text#μόχθων, πρὶν ἂν Ζεὺς ἐκπέσῃ τυραννίδος.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:757.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:757.1.text#ἦ γάρ ποτ' ἔστιν ἐκπεσεῖν ἀρχῆς Δία;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:758.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:758.1.text#ἥδοι' ἄν, οἶμαι, τήνδ' ἰδοῦσα συμφοράν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:759.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:759.1.text#πῶς δ' οὐκ ἄν, ἥτις ἐκ Διὸς πάσχω κακῶς;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:760.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:760.1.text#ὡς τοίνυν ὄντων τῶνδέ σοι μαθεῖν πάρα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:761.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:761.1.text#πρὸς τοῦ τύραννα σκῆπτρα συληθήσεται;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:762.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:762.1.text#πρὸς αὐτὸς αὑτοῦ κενοφρόνων βουλευμάτων.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:763.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:763.1.text#ποίῳ τρόπῳ; σήμηνον, εἰ μή τις βλάβη.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:764.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:764.1.text#γαμεῖ γάμον τοιοῦτον ᾧ ποτ' ἀσχαλᾷ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:765.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:765.1.text#θέορτον, ἢ βρότειον; εἰ ῥητόν, φράσον.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:766.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:766.1.text#τί δ' ὅντιν'·; οὐ γὰρ ῥητὸν αὐδᾶσθαι τόδε.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:767.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:767.1.text#ἦ πρὸς δάμαρτος ἐξανίσταται θρόνων;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:768.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:768.1.text#ἣ τέξεταί γε παῖδα φέρτερον πατρός.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:769.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:769.1.text#οὐδ' ἔστιν αὐτῷ τῆσδ' ἀποστροφὴ τύχης;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:770.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:770.1.text#οὐ δῆτα, πλὴν ἔγωγ' ἂν ἐκ δεσμῶν λυθείς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:771.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:771.1.text#τίς οὖν ὁ λύσων ἐστὶν ἄκοντος Διός;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:772.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:772.1.text#τῶν σῶν τιν' αὐτὸν ἐγγόνων εἶναι χρεών.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:773.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:773.1.text#πῶς εἶπας; ἦ 'μὸς παῖς σ' ἀπαλλάξει κακῶν;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:774.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:774.1.text#τρίτος γε γένναν πρὸς δέκ' ἄλλαισιν γοναῖς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:775.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:775.1.text#ἥδ' οὐκέτ' εὐξύμβλητος ἡ χρησμῳδία.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:776.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:776.1.text#καὶ μηδὲ σαυτῆς ἐκμαθεῖν ζήτει πόνους.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:777.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:777.1.text#μή μοι προτείνων κέρδος εἶτ' ἀποστέρει.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:778.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:778.1.text#δυοῖν λόγοιν σε θατέρῳ δωρήσομαι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:779.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:779.1.text#ποίοιν; πρόδειξον, αἵρεσίν τ' ἐμοὶ δίδου.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:780.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:780.1.text#δίδωμ'· ἑλοῦ γάρ, ἢ πόνων τὰ λοιπά σοι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:781.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:781.1.text#φράσω σαφηνῶς, ἢ τὸν ἐκλύσοντ' ἐμέ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:782.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:782.1.text#τούτων σὺ τὴν μὲν τῇδε, τὴν δ' ἐμοὶ χάριν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:783.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:783.1.text#θέσθαι θέλησον, μηδ' ἀτιμάσῃς λόγου·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:784.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:784.1.text#καὶ τῇδε μὲν γέγωνε τὴν λοιπὴν πλάνην,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:785.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:785.1.text#ἐμοὶ δὲ τὸν λύσοντα· τοῦτο γὰρ ποθῶ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:786.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:786.1.text#ἐπεὶ προθυμεῖσθ', οὐκ ἐναντιώσομαι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:787.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:787.1.text#τὸ μὴ οὐ γεγωνεῖν πᾶν ὅσον προσχρῄζετε.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:788.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:788.1.text#σοὶ πρῶτον, Ἰοῖ, πολύδονον πλάνην φράσω,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:789.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:789.1.text#ἣν ἐγγράφου σὺ μνήμοσιν δέλτοις φρενῶν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:790.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:790.1.text#ὅταν περάσῃς ῥεῖθρον ἠπείροιν ὅρον,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:791.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:791.1.text#πρὸς ἀντολὰς φλογῶπας ἡλιοστιβεῖς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:792.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:792.1.text#[ … ]
urn:cts:greekLit:tlg0085.tlg003.fu.sp:793.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:793.1.text#πόντου περῶσα φλοῖσβον, ἔστ' ἂν ἐξίκῃ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:794.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:794.1.text#πρὸς Γοργόνεια πεδία Κισθήνης, ἵνα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:795.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:795.1.text#αἱ Φορκίδες ναίουσι δηναιαὶ κόραι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:795a.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:795a.1.text#τρεῖς κυκνόμορφοι, κοινὸν ὄμμ' ἐκτημέναι,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:796.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:796.1.text#μονόδοντες, ἃς οὔθ' ἥλιος προσδέρκεται
urn:cts:greekLit:tlg0085.tlg003.fu.sp:797.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:797.1.text#ἀκτῖσιν οὔθ' ἡ νύκτερος μήνη ποτέ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:798.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:798.1.text#πέλας δ' ἀδελφαὶ τῶνδε τρεῖς κατάπτεροι,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:799.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:799.1.text#δρακοντόμαλλοι Γοργόνες βροτοστυγεῖς,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:800.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:800.1.text#ἃς θνητὸς οὐδεὶς εἰσιδὼν ἕξει πνοάς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:801.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:801.1.text#τοιοῦτο μέν σοι τοῦτο φρούριον λέγω·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:802.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:802.1.text#ἄλλην δ' ἄκουσον δυσχερῆ θεωρίαν·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:803.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:803.1.text#ὀξυστόμους γὰρ Ζηνὸς ἀκραγεῖς κύνας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:804.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:804.1.text#γρῦπας φύλαξαι, τόν τε μουνῶπα στρατὸν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:805.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:805.1.text#Ἀριμασπὸν ἱπποβάμον', οἳ χρυσόρρυτον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:806.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:806.1.text#οἰκοῦσιν ἀμφὶ νᾶμα Πλούτωνος πόρου·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:807.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:807.1.text#τούτοις σὺ μὴ πέλαζε. τηλουρὸν δὲ γῆν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:808.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:808.1.text#ἥξεις, κελαινὸν φῦλον, οἳ πρὸς ἡλίου
urn:cts:greekLit:tlg0085.tlg003.fu.sp:809.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:809.1.text#ναίουσι πηγαῖς, ἔνθα ποταμὸς Αἰθίοψ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:810.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:810.1.text#τούτου παρ' ὄχθας ἕρφ', ἕως ἂν ἐξίκῃ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:811.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:811.1.text#καταβασμόν, ἔνθα Βιβλίνων ὀρῶν ἄπο
urn:cts:greekLit:tlg0085.tlg003.fu.sp:812.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:812.1.text#ἵησι σεπτὸν Νεῖλος εὔποτον ῥέος.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:813.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:813.1.text#οὗτός σ' ὁδώσει τὴν τρίγωνον ἐς χθόνα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:814.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:814.1.text#Νειλῶτιν, οὗ δὴ τὴν μακρὰν ἀποικίαν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:815.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:815.1.text#Ἰοῖ, πέπρωται σοί τε καὶ τέκνοις κτίσαι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:816.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:816.1.text#τῶν δ' εἴ τί σοι ψελλόν τε καὶ δυσεύρετον,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:817.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:817.1.text#ἐπανδίπλαζε καὶ σαφῶς ἐκμάνθανε·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:818.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:818.1.text#σχολὴ δὲ πλείων ἢ θέλω πάρεστί μοι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:819.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:819.1.text#εἰ μέν τι τῇδε λοιπὸν ἢ παρειμένον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:820.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:820.1.text#ἔχεις γεγωνεῖν τῆς πολυφθόρου πλάνης,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:821.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:821.1.text#λέγ'· εἰ δὲ πάντ' εἴρηκας, ἡμῖν αὖ χάριν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:822.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:822.1.text#δὸς ἥνπερ αἰτούμεσθα, μέμνησαι δέ που.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:823.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:823.1.text#τὸ πᾶν πορείας ἥδε τέρμ' ἀκήκοεν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:824.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:824.1.text#ὅπως δ' ἂν εἰδῇ μὴ μάτην κλύουσά μου,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:825.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:825.1.text#ἃ πρὶν μολεῖν δεῦρ' ἐκμεμόχθηκεν φράσω,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:826.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:826.1.text#τεκμήριον τοῦτ' αὐτὸ δοὺς μύθων ἐμῶν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:827.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:827.1.text#ὄχλον μὲν οὖν τὸν πλεῖστον ἐκλείψω λόγων,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:828.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:828.1.text#πρὸς αὐτὸ δ' εἶμι τέρμα σῶν πλανημάτων.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:829.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:829.1.text#ἐπεὶ γὰρ ἦλθες πρὸς Μολοσσὰ γάπεδα,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:830.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:830.1.text#τὴν αἰπύνωτόν τ' ἀμφὶ Δωδώνην, ἵνα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:831.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:831.1.text#μαντεῖα θᾶκός τ' ἐστὶ Θεσπρωτοῦ Διός,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:832.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:832.1.text#τέρας τ' ἄπιστον, αἱ προσήγοροι δρύες,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:833.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:833.1.text#ὑφ' ὧν σὺ λαμπρῶς κοὐδὲν αἰνικτηρίως
urn:cts:greekLit:tlg0085.tlg003.fu.sp:834.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:834.1.text#προσηγορεύθης ἡ Διὸς κλεινὴ δάμαρ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:835.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:835.1.text#μέλλουσ' ἔσεσθαι. τῶνδε προσσαίνει σέ τι ;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:836.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:836.1.text#ἐντεῦθεν οἰστρήσασα τὴν παρακτίαν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:837.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:837.1.text#κέλευθον ᾖξας πρὸς μέγαν κόλπον Ῥέας,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:838.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:838.1.text#ἀφ' οὗ παλιμπλάγκτοισι χειμάζῃ δρόμοις·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:839.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:839.1.text#χρόνον δὲ τὸν μέλλοντα πόντιος μυχός,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:840.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:840.1.text#σαφῶς ἐπίστασ', Ἰόνιος κεκλήσεται,.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:841.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:841.1.text#τῆς σῆς πορείας μνῆμα τοῖς πᾶσιν βροτοῖς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:842.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:842.1.text#σημεῖά σοι τάδ' ἐστὶ τῆς ἐμῆς φρενός,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:843.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:843.1.text#ὡς δέρκεται πλέον τι τοῦ πεφασμένου.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:844.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:844.1.text#τὰ λοιπὰ δ' ὑμῖν τῇδέ τ' ἐς κοινὸν φράσω,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:845.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:845.1.text#ἐς ταὐτὸν ἐλθὼν τῶν πάλαι λόγων ἴχνος.
      urn:cts:greekLit:tlg0085.tlg003.fu.sp:846.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:846.1.text#ἔστιν πόλις Κάνωβος ἐσχάτη χθονός,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:847.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:847.1.text#Νείλου πρὸς αὐτῷ στόματι καὶ προσχώματι·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:848.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:848.1.text#ἐνταῦθα δή σε Ζεὺς τίθησιν ἔμφρονα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:849.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:849.1.text#ἐπαφῶν ἀταρβεῖ χειρὶ καὶ θιγὼν μόνον.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:850.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:850.1.text#ἐπώνυμον δὲ τῶν Διὸς γεννημάτων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:851.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:851.1.text#τέξεις κελαινὸν Ἔπαφον, ὃς καρπώσεται
urn:cts:greekLit:tlg0085.tlg003.fu.sp:852.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:852.1.text#ὅσην πλατύρρους Νεῖλος ἀρδεύει χθόνα·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:853.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:853.1.text#πέμπτη δ' ἀπ' αὐτοῦ γέννα πεντηκοντάπαις
urn:cts:greekLit:tlg0085.tlg003.fu.sp:854.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:854.1.text#πάλιν πρὸς Ἄργος οὐχ ἑκοῦσ' ἐλεύσεται
urn:cts:greekLit:tlg0085.tlg003.fu.sp:855.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:855.1.text#θηλύσπορος, φεύγουσα συγγενῆ γάμον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:856.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:856.1.text#ἀνεψιῶν· οἱ δ' ἐπτοημένοι φρένας,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:857.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:857.1.text#κίρκοι πελειῶν οὐ μακρὰν λελειμμένοι,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:858.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:858.1.text#ἥξουσι θηρεύοντες οὐ θηρασίμους
urn:cts:greekLit:tlg0085.tlg003.fu.sp:859.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:859.1.text#γάμους, φθόνον δὲ σωμάτων ἕξει θεός·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:860.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:860.1.text#Πελασγία δὲ δέξεται θηλυκτόνῳ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:861.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:861.1.text#Ἄρει, δαμέντων νυκτιφρουρήτῳ θράσει.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:862.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:862.1.text#γυνὴ γὰρ ἄνδρ' ἕκαστον αἰῶνος στερεῖ,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:863.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:863.1.text#δίθηκτον ἐν σφαγαῖσι βάψασα ξίφος·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:864.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:864.1.text#τοιάδ' ἐπ' ἐχθροὺς τοὺς ἐμοὺς ἔλθοι Κύπρις.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:865.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:865.1.text#μίαν δὲ παίδων ἵμερος θέλξει τὸ μὴ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:866.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:866.1.text#κτεῖναι σύνευνον, ἀλλ' ἀπαμβλυνθήσεται
urn:cts:greekLit:tlg0085.tlg003.fu.sp:867.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:867.1.text#γνώμην· δυοῖν δὲ θάτερον βουλήσεται,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:868.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:868.1.text#κλύειν ἄναλκις μᾶλλον ἢ μιαιφόνος·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:869.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:869.1.text#αὕτη κατ' Ἄργος βασιλικὸν τέξει γένος.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:870.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:870.1.text#μακροῦ λόγου δεῖ ταῦτ' ἐπεξελθεῖν τορῶς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:871.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:871.1.text#σπορᾶς γε μὴν ἐκ τῆσδε φύσεται θρασὺς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:872.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:872.1.text#τόξοισι κλεινός, ὃς πόνων ἐκ τῶνδ' ἐμὲ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:873.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:873.1.text#λύσει. τοιόνδε χρησμὸν ἡ παλαιγενὴς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:874.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:874.1.text#μήτηρ ἐμοὶ διῆλθε Τιτανὶς Θέμις·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:875.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:875.1.text#ὅπως δὲ χὤπη, ταῦτα δεῖ μακροῦ λόγου
urn:cts:greekLit:tlg0085.tlg003.fu.sp:876.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:876.1.text#εἰπεῖν, σύ τ' οὐδὲν ἐκμαθοῦσα κερδανεῖς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:877.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:877.1.text#ἐλελεῦ ἐλελεῦ,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:878.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:878.1.text#ὑπό μ' αὖ σφάκελος καὶ φρενοπληγεῖς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:879.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:879.1.text#μανίαι θάλπουσ', οἴστρου δ' ἄρδις
urn:cts:greekLit:tlg0085.tlg003.fu.sp:880.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:880.1.text#χρίει μ' ἄπυρος·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:881.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:881.1.text#κραδία δὲ φόβῳ φρένα λακτίζει.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:882.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:882.1.text#τροχοδινεῖται δ' ὄμμαθ' ἑλίγδην,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:883.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:883.1.text#ἔξω δὲ δρόμου φέρομαι λύσσης
urn:cts:greekLit:tlg0085.tlg003.fu.sp:884.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:884.1.text#πνεύματι μάργῳ, γλώσσης ἀκρατής·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:885.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:885.1.text#θολεροὶ δὲ λόγοι παίουσ' εἰκῆ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:886.1.speaker#Ἰώ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:886.1.text#στυγνῆς πρὸς κύμασιν ἄτης.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:887.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:887.1.text#ἦ σοφὸς ἦ σοφὸς [ ἦν ] ὃς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:888.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:888.1.text#πρῶτος ἐν γνώμᾳ τόδ' ἐβάστασε καὶ γλώσ-
urn:cts:greekLit:tlg0085.tlg003.fu.sp:889.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:889.1.text#σᾳ διεμυθολόγησεν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:890.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:890.1.text#ὡς τὸ κηδεῦσαι καθ' ἑαυτὸν ἀριστεύει μακρῷ,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:891.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:891.1.text#καὶ μήτε τῶν πλούτῳ διαθρυπτομένων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:892.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:892.1.text#μήτε τῶν γέννᾳ μεγαλυνομένων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:893.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:893.1.text#ὄντα χερνήταν ἐραστεῦσαι γάμων.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:894.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:894.1.text#μήποτε μήποτέ μ', ὦ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:895.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:895.1.text#πότνιαι Μοῖραι, λεχέων Διὸς εὐνά-
urn:cts:greekLit:tlg0085.tlg003.fu.sp:896.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:896.1.text#τειραν ἴδοισθε πέλουσαν·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:897.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:897.1.text#μηδὲ πλαθείην γαμέτᾳ τινὶ τῶν ἐξ οὐρανοῦ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:898.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:898.1.text#ταρβῶ γὰρ ἀστεργάνορα παρθενίαν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:899.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:899.1.text#εἰσορῶσ' Ἰοῦς ἀμαλαπτομέναν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:900.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:900.1.text#δυσπλάνοις Ἥρας ἀλατείαις πόνων.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:901.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:901.1.text#ἐμοὶ δ' ὅτε μὲν ὁμαλὸς ὁ γάμος,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:902.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:902.1.text#ἄφοβος· [ οὐ δέδια· ] μηδὲ κρεισσόνων θεῶν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:903.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:903.1.text#ἔρως ἄφυκτον ὄμμα προσδράκοι με.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:904.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:904.1.text#ἀπόλεμος ὅδε γ' ὁ πόλεμος, ἄπορα πόριμος·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:905.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:905.1.text#οὐδ' ἔχω τίς ἂν γενοίμαν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:906.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:906.1.text#τὰν Διὸς γὰρ οὐχ ὁρῶ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:906.2.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:906.2.text#μῆτιν ὅπα φύγοιμ' ἄν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:907.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:907.1.text#ἦ μὴν ἔτι Ζεύς, καίπερ αὐθάδης φρενῶν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:908.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:908.1.text#ἔσται ταπεινός, οἷον ἐξαρτύεται
urn:cts:greekLit:tlg0085.tlg003.fu.sp:909.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:909.1.text#γάμον γαμεῖν, ὃς αὐτὸν ἐκ τυραννίδος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:910.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:910.1.text#θρόνων τ' ἄιστον ἐκβαλεῖ· πατρὸς δ' ἀρὰ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:911.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:911.1.text#Κρόνου τότ' ἤδη παντελῶς κρανθήσεται,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:912.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:912.1.text#ἣν ἐκπίτνων ἠρᾶτο δηναιῶν θρόνων.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:913.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:913.1.text#τοιῶνδε μόχθων ἐκτροπὴν οὐδεὶς θεῶν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:914.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:914.1.text#δύναιτ' ἂν αὐτῷ πλὴν ἐμοῦ δεῖξαι σαφῶς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:915.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:915.1.text#ἐγὼ τάδ' οἶδα χᾦ τρόπῳ. πρὸς ταῦτά νυν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:916.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:916.1.text#θαρσῶν καθήσθω τοῖς πεδαρσίοις κτύποις
urn:cts:greekLit:tlg0085.tlg003.fu.sp:917.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:917.1.text#πιστός, τινάσσων τ' ἐν χεροῖν πύρπνουν βέλος.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:918.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:918.1.text#οὐδὲν γὰρ αὐτῷ ταῦτ' ἐπαρκέσει τὸ μὴ οὐ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:919.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:919.1.text#πεσεῖν ἀτίμως πτώματ' οὐκ ἀνασχετά·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:920.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:920.1.text#τοῖον παλαιστὴν νῦν παρασκευάζεται
urn:cts:greekLit:tlg0085.tlg003.fu.sp:921.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:921.1.text#ἐπ' αὐτὸς αὑτῷ, δυσμαχώτατον τέρας·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:922.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:922.1.text#ὃς δὴ κεραυνοῦ κρείσσον' εὑρήσει φλόγα,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:923.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:923.1.text#βροντῆς θ' ὑπερβάλλοντα καρτερὸν κτύπον·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:924.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:924.1.text#θαλασσίαν τε γῆς τινάκτειραν νόσον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:925.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:925.1.text#τρίαιναν, αἰχμὴν τὴν Ποσειδῶνος, σκεδᾷ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:926.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:926.1.text#πταίσας δὲ τῷδε πρὸς κακῷ μαθήσεται
urn:cts:greekLit:tlg0085.tlg003.fu.sp:927.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:927.1.text#ὅσον τό τ' ἄρχειν καὶ τὸ δουλεύειν δίχα.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:928.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:928.1.text#σύ θην ἃ χρῄζεις, ταῦτ' ἐπιγλωσσᾷ Διός.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:929.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:929.1.text#ἅπερ τελεῖται, πρὸς δ' ἃ βούλομαι λέγω.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:930.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:930.1.text#καὶ προσδοκᾶν χρὴ δεσπόσειν Ζηνός τινα;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:931.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:931.1.text#καὶ τῶνδέ γ', ἕξει δυσλοφωτέρους πόνους.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:932.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:932.1.text#πῶς δ' οὐχὶ ταρβεῖς τοιάδ' ἐκρίπτων ἔπη;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:933.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:933.1.text#τί δ' ἂν φοβοίμην ᾧ θανεῖν οὐ μόρσιμον;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:934.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:934.1.text#ἀλλ' ἆθλον ἄν σοι τοῦδ' ἔτ' ἀλγίω πόροι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:935.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:935.1.text#ὁ δ' οὖν ποιείτω· πάντα προσδοκητά μοι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:936.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:936.1.text#οἱ προσκυνοῦντες τὴν Ἀδράστειαν σοφοί.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:937.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:937.1.text#σέβου, προσεύχου, θῶπτε τὸν κρατοῦντ' ἀεί.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:938.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:938.1.text#ἐμοὶ δ' ἔλασσον Ζηνὸς ἢ μηδὲν μέλει.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:939.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:939.1.text#δράτω, κρατείτω τόνδε τὸν βραχὺν χρόνον,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:940.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:940.1.text#ὅπως θέλει· δαρὸν γὰρ οὐκ ἄρξει θεοῖς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:941.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:941.1.text#ἀλλ' εἰσορῶ γὰρ τόνδε τὸν Διὸς τρόχιν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:942.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:942.1.text#τὸν τοῦ τυράννου τοῦ νέου διάκονον·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:943.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:943.1.text#πάντως τι καινὸν ἀγγελῶν ἐλήλυθεν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:944.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:944.1.text#σὲ τὸν σοφιστήν, τὸν πικρῶς ὑπέρπικρον,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:945.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:945.1.text#τὸν ἐξαμαρτόντ' εἰς θεοὺς ἐφημέροις
urn:cts:greekLit:tlg0085.tlg003.fu.sp:946.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:946.1.text#πορόντα τιμάς, τὸν πυρὸς κλέπτην λέγω·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:947.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:947.1.text#πατὴρ ἄνωγέ σ' οὕστινας κομπεῖς γάμους
urn:cts:greekLit:tlg0085.tlg003.fu.sp:948.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:948.1.text#αὐδᾶν, πρὸς ὧν ἐκεῖνος ἐκπίπτει κράτους.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:949.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:949.1.text#καὶ ταῦτα μέντοι μηδὲν αἰνικτηρίως,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:950.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:950.1.text#ἀλλ' αὔθ' ἕκαστα φράζε· μηδέ μοι διπλᾶς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:951.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:951.1.text#ὁδούς, Προμηθεῦ, προσβάλῃς· ὁρᾷς δ' ὅτι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:952.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:952.1.text#Ζεὺς τοῖς τοιούτοις οὐχὶ μαλθακίζεται.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:953.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:953.1.text#σεμνόστομός γε καὶ φρονήματος πλέως
urn:cts:greekLit:tlg0085.tlg003.fu.sp:954.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:954.1.text#ὁ μῦθός ἐστιν, ὡς θεῶν ὑπηρέτου.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:955.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:955.1.text#νέον νέοι κρατεῖτε καὶ δοκεῖτε δὴ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:956.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:956.1.text#ναίειν ἀπενθῆ πέργαμ'· οὐκ ἐκ τῶνδ' ἐγὼ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:957.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:957.1.text#δισσοὺς τυράννους ἐκπεσόντας ᾐσθόμην;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:958.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:958.1.text#τρίτον δὲ τὸν νῦν κοιρανοῦντ' ἐπόψομαι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:959.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:959.1.text#αἴσχιστα καὶ τάχιστα. μή τί σοι δοκῶ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:960.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:960.1.text#ταρβεῖν ὑποπτήσσειν τε τε τοὺς νέους θεούς;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:961.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:961.1.text#πολλοῦ γε καὶ τοῦ παντὸς ἐλλείπω. σὺ δὲ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:962.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:962.1.text#κέλευθον ἥνπερ ἦλθες ἐγκόνει πάλιν·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:963.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:963.1.text#πεύσῃ γὰρ οὐδὲν ὧν ἀνιστορεῖς ἐμέ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:964.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:964.1.text#τοιοῖσδε μέντοι καὶ πρὶν αὐθαδίσμασιν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:965.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:965.1.text#ἐς τάσδε σαυτὸν πημονὰς καθώρμισας.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:966.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:966.1.text#τῆς σῆς λατρείας τὴν ἐμὴν δυσπραξίαν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:967.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:967.1.text#σαφῶς ἐπίστασ', οὐκ ἂν ἀλλάξαιμ' ἐγώ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:968.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:968.1.text#κρεῖσσον γὰρ οἶμαι τῇδε λατρεύειν πέτρᾳ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:969.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:969.1.text#ἢ πατρὶ φῦναι Ζηνὶ πιστὸν ἄγγελον.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:970.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:970.1.text#οὕτως ὑβρίζειν τοὺς ὑβρίζοντας χρεών.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:971.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:971.1.text#χλιδᾶν ἔοικας τοῖς παροῦσι πράγμασι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:972.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:972.1.text#χλιδῶ; χλιδῶντας ὧδε τοὺς ἐμοὺς ἐγὼ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:973.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:973.1.text#ἐχθροὺς ἴδοιμι· καὶ σὲ δ' ἐν τούτοις λέγω.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:974.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:974.1.text#ἦ κἀμὲ γάρ τι συμφοραῖς ἐπαιτιᾷ;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:975.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:975.1.text#ἁπλῷ λόγῳ τοὺς πάντας ἐχθαίρω θεούς,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:976.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:976.1.text#ὅσοι παθόντες εὖ κακοῦσί μ' ἐκδίκως.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:977.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:977.1.text#κλύω σ' ἐγὼ μεμηνότ' οὐ σμικρὰν νόσον.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:978.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:978.1.text#νοσοῖμ' ἄν, εἰ νόσημα τοὺς ἐχθροὺς στυγεῖν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:979.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:979.1.text#εἴης φορητὸς οὐκ ἄν, εἰ πράσσοις καλῶς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:980.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:980.1.text#ὤμοι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:980.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:980.2.text#ὤμοι; τόδε Ζεὺς τοὔπος οὐκ ἐπίσταται.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:981.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:981.1.text#ἀλλ' ἐκδιδάσκει πάνθ' ὁ γηράσκων χρόνος.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:982.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:982.1.text#καὶ μὴν σύ γ' οὔπω σωφρονεῖν ἐπίστασαι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:983.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:983.1.text#σὲ γὰρ προσηύδων οὐκ ἂν ὄνθ' ὑπηρέτην.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:984.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:984.1.text#ἐρεῖν ἔοικας οὐδὲν ὧν χρῄζει πατήρ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:985.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:985.1.text#καὶ μὴν ὀφείλων γ' ἂν τίνοιμ' αὐτῷ χάριν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:986.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:986.1.text#ἐκερτόμησας δῆθεν ὡς παῖδ' ὄντα με.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:987.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:987.1.text#οὐ γὰρ σὺ παῖς τε κἄτι τοῦδ' ἀνούστερος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:988.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:988.1.text#εἰ προσδοκᾷς ἐμοῦ τι πεύσεσθαι πάρα;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:989.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:989.1.text#οὐκ ἔστιν αἴκισμ' οὐδὲ μηχάνημ' ὅτῳ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:990.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:990.1.text#προτρέψεταί με Ζεὺς γεγωνῆσαι τάδε,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:991.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:991.1.text#πρὶν ἂν χαλασθῇ δεσμὰ λυμαντήρια.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:992.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:992.1.text#πρὸς ταῦτα ῥιπτέσθω μὲν αἰθαλοῦσσα φλόξ,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:993.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:993.1.text#λευκοπτέρῳ δὲ νιφάδι καὶ βροντήμασι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:994.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:994.1.text#χθονίοις κυκάτω πάντα καὶ ταρασσέτω.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:995.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:995.1.text#γνάμψει γὰρ οὐδὲν τῶνδέ μ' ὥστε καὶ φράσαι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:996.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:996.1.text#πρὸς οὗ χρεών νιν ἐκπεσεῖν τυραννίδος.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:997.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:997.1.text#ὅρα νυν εἴ σοι ταῦτ' ἀρωγὰ φαίνεται.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:998.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:998.1.text#ὦπται πάλαι δὴ καὶ βεβούλευται τάδε.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:999.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:999.1.text#τόλμησον, ὦ μάταιε, τόλμησόν ποτε
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1000.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1000.1.text#πρὸς τὰς παρούσας πημονὰς ὀρθῶς φρονεῖν,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1001.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1001.1.text#ὀχλεῖς μάτην με κῦμ' ὅπως παρηγορῶν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1002.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1002.1.text#εἰσελθέτω σε μήποθ' ὡς ἐγὼ Διὸς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1003.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1003.1.text#γνώμην φοβηθεὶς θηλύνους γενήσομαι,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1004.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1004.1.text#καὶ λιπαρήσω τὸν μέγα στυγούμενον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1005.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1005.1.text#γυναικομίμοις ὑπτιάσμασιν χερῶν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1006.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1006.1.text#λῦσαί με δεσμῶν τῶνδε· τοῦ παντὸς δέω.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1007.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1007.1.text#λέγων ἔοικα πολλὰ καὶ μάτην ἐρεῖν·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1008.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1008.1.text#τέγγῃ γὰρ οὐδὲν οὐδὲ μαλθάσσῃ λιταῖς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1009.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1009.1.text#ἐμαῖς· δακὼν δὲ στόμιον ὡς νεοζυγὴς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1010.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1010.1.text#πῶλος βιάζῃ καὶ πρὸς ἡνίας μάχῃ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1011.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1011.1.text#ἀτὰρ σφοδρύνῃ γ' ἀσθενεῖ σοφίσματι·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1012.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1012.1.text#αὐθαδία γὰρ τῷ φρονοῦντι μὴ καλῶς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1013.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1013.1.text#αὐτὴ καθ' αὑτὴν οὐδενὸς μεῖζον σθένει.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1014.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1014.1.text#σκέψαι δ', ἐὰν μὴ τοῖς ἐμοῖς πεισθῇς λόγοις,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1015.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1015.1.text#οἷός σε χειμὼν καὶ κακῶν τρικυμία
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1016.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1016.1.text#ἔπεισ' ἄφυκτος · πρῶτα μὲν γὰρ ὀκρίδα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1017.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1017.1.text#φάραγγα βροντῇ καὶ κεραυνίᾳ φλογὶ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1018.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1018.1.text#πατὴρ σπαράξει τήνδε, καὶ κρύψει δέμας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1019.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1019.1.text#τὸ σόν, πετραία δ' ἀγκάλη σε βαστάσει.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1020.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1020.1.text#μακρὸν δὲ μῆκος ἐκτελευτήσας χρόνου
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1021.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1021.1.text#ἄψορρον ἥξεις εἰς φάος· Διὸς δέ τοί
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1022.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1022.1.text#πτηνὸς κύων, δαφοινὸς αἰετός, λάβρως
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1023.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1023.1.text#διαρταμήσει σώματος μέγα ῥάκος,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1024.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1024.1.text#ἄκλητος ἕρπων δαιταλεὺς πανήμερος,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1025.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1025.1.text#κελαινόβρωτον δ' ἧπαρ ἐκθοινήσεται.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1026.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1026.1.text#τοιοῦδε μόχθου τέρμα μή τι προσδόκα,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1027.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1027.1.text#πρὶν ἂν θεῶν τις διάδοχος τῶν σῶν πόνων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1028.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1028.1.text#φανῇ, θελήσῃ τ' εἰς ἀναύγητον μολεῖν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1029.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1029.1.text#Ἅιδην κνεφαῖά τ' ἀμφὶ Ταρτάρου βάθη.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1030.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1030.1.text#πρὸς ταῦτα βούλευ'· ὡς ὅδ' οὐ πεπλασμένος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1031.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1031.1.text#ὁ κόμπος, ἀλλὰ καὶ λίαν εἰρημένος ·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1032.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1032.1.text#ψευδηγορεῖν γὰρ οὐκ ἐπίσταται στόμα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1033.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1033.1.text#τὸ Δῖον, ἀλλὰ πᾶν ἔπος τελεῖ· σὺ δὲ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1034.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1034.1.text#πάπταινε καὶ φρόντιζε, μηδ' αὐθαδίαν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1035.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1035.1.text#εὐβουλίας ἀμείνον' ἡγήσῃ ποτέ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1036.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1036.1.text#ἡμῖν μὲν Ἑρμῆς οὐκ ἄκαιρα φαίνεται
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1037.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1037.1.text#λέγειν. ἄνωγε γάρ σε τὴν αὐθαδίαν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1038.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1038.1.text#μεθέντ' ἐρευνᾶν τὴν σοφὴν εὐβουλίαν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1039.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1039.1.text#πιθοῦ· σοφῷ γὰρ αἰσχρὸν ἐξαμαρτάνειν.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1040.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1040.1.text#εἰδότι τοί μοι τάσδ' ἀγγελίας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1041.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1041.1.text#ὅδ' ἐθώυξεν· πάσχειν δὲ κακῶς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1042.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1042.1.text#ἐχθρὸν ὑπ' ἐχθρῶν οὐδὲν ἀεικές.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1043.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1043.1.text#πρὸς ταῦτ' ἐπ' ἐμοὶ ῥιπτέσθω μὲν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1044.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1044.1.text#πυρὸς ἀμφήκης βόστρυχος, αἰθὴρ δ'
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1045.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1045.1.text#ἐρεθιζέσθω βροντῇ σφακέλῳ τ'
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1046.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1046.1.text#ἀγρίων ἀνέμων· χθόνα δ' ἐκ πυθμένων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1047.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1047.1.text#αὐταῖς ῥίζαις πνεῦμα κραδαίνοι,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1048.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1048.1.text#κῦμα δὲ πόντου τραχεῖ ῥοθίῳ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1049.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1049.1.text#συγχώσειεν τῶν οὐρανίων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1050.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1050.1.text#ἄστρων διόδους· εἴς τε κελαινὸν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1051.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1051.1.text#Τάρταρον ἄρδην ῥίψειε δέμας
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1052.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1052.1.text#τοὐμὸν ἀνάγκης στερραῖς δίναις·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1053.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1053.1.text#πάντως ἐμέ γ' οὐ θανατώσει.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1054.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1054.1.text#τοιάδε μέντοι τῶν φρενοπλήκτων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1055.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1055.1.text#βουλεύματ' ἔπη τ' ἔστιν ἀκοῦσαι.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1056.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1056.1.text#τί γὰρ ἐλλείπει μὴ οὐ παραπαίειν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1057.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1057.1.text#ἡ τοῦδ' εὐχή; τί χαλᾷ μανιῶν;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1058.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1058.1.text#ἀλλ' οὖν ὑμεῖς γ' αἱ πημοσύναις
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1059.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1059.1.text#συγκάμνουσαι ταῖς τοῦδε τόπων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1060.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1060.1.text#μετά ποι χωρεῖτ' ἐκ τῶνδε θοῶς,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1061.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1061.1.text#μὴ φρένας ὑμῶν ἠλιθιώσῃ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1062.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1062.1.text#βροντῆς μύκημ' ἀτέραμνον.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1063.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1063.1.text#ἄλλο τι φώνει καὶ παραμυθοῦ μ'
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1064.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1064.1.text#ὅ τι καὶ πείσεις· οὐ γὰρ δή που
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1065.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1065.1.text#τοῦτό γε τλητὸν παρέσυρας ἔπος.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1066.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1066.1.text#πῶς με κελεύεις κακότητ' ἀσκεῖν;
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1067.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1067.1.text#μετὰ τοῦδ' ὅ τι χρὴ πάσχειν ἐθέλω·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1068.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1068.1.text#τοὺς προδότας γὰρ μισεῖν ἔμαθον,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1069.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1069.1.text#κοὐκ ἔστι νόσος
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1070.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1070.1.text#τῆσδ' ἥντιν' ἀπέπτυσα μᾶλλον.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1071.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1071.1.text#ἀλλ' οὖν μέμνησθ' ἁγὼ προλέγω
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1072.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1072.1.text#μηδὲ πρὸς ἄτης θηραθεῖσαι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1073.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1073.1.text#μέμψησθε τύχην, μηδέ ποτ' εἴπηθ'
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1074.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1074.1.text#ὡς Ζεὺς ὑμᾶς εἰς ἀπρόοπτον
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1075.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1075.1.text#πῆμ' εἰσέβαλεν· μὴ δῆτ' αὐταὶ δ'
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1076.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1076.1.text#ὑμᾶς αὐτάς. εἰδυῖαι γὰρ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1077.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1077.1.text#κοὐκ ἐξαίφνης οὐδὲ λαθραίως
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1078.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1078.1.text#εἰς ἀπέρατον δίκτυον ἄτης
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1079.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1079.1.text#ἐμπλεχθήσεσθ' ὑπ' ἀνοίας.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1080.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1080.1.text#καὶ μὴν ἔργῳ κοὐκέτι μύθῳ
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1081.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1081.1.text#χθὼν σεσάλευται·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1082.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1082.1.text#βρυχία δ' ἠχὼ παραμυκᾶται
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1083.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1083.1.text#βροντῆς, ἕλικες δ' ἐκλάμπουσι
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1084.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1084.1.text#στεροπῆς ζάπυροι, στρόμβοι δὲ κόνιν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1085.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1085.1.text#εἱλίσσουσι· σκιρτᾷ δ' ἀνέμων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1086.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1086.1.text#πνεύματα πάντων εἰς ἄλληλα
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1087.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1087.1.text#στάσιν ἀντίπνουν ἀποδεικνύμενα·
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1088.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1088.1.text#ξυντετάρακται δ' αἰθὴρ πόντῳ.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1089.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1089.1.text#τοιάδ' ἐπ' ἐμοὶ ῥιπὴ Διόθεν
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1090.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1090.1.text#τεύχουσα φόβον στείχει φανερῶς.
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1091.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1091.1.text#ὦ μητρὸς ἐμῆς σέβας, ὦ πάντων
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1092.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1092.1.text#αἰθὴρ κοινὸν φάος εἱλίσσων,
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1093.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0085.tlg003.fu.sp:1093.1.text#ἐσορᾷς μ' ὡς ἔκδικα πάσχω.
