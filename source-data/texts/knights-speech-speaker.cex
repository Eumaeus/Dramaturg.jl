#!ctsdata
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1.1.text#ἰατταταιὰξ τῶν κακῶν, ἰατταταῖ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:2.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:2.1.text#κακῶς Παφλαγόνα τὸν νεώνητον κακὸν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:3.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:3.1.text#αὐταῖσι βουλαῖς ἀπολέσειαν οἱ θεοί.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:4.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:4.1.text#ἐξ οὗ γὰρ εἰσήρρησεν ἐς τὴν οἰκίαν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:5.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:5.1.text#πληγὰς ἀεὶ προστρίβεται τοῖς οἰκέταις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:6.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:6.1.text#κάκιστα δῆθ' οὗτός γε πρῶτος Παφλαγόνων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:7.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:7.1.text#αὐταῖς διαβολαῖς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:7.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:7.2.text#ὦ κακόδαιμον πῶς ἔχεις;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:8.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:8.1.text#κακῶς καθάπερ σύ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:8.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:8.2.text#δεῦρο δὴ πρόσελθ', ἵνα
urn:cts:greekLit:tlg0019.tlg002.fu.sp:9.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:9.1.text#ξυναυλίαν κλαύσωμεν Οὐλύμπου νόμον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:10.1.speaker#Δημοσθένης καὶ Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:10.1.text#μυμῦ μυμῦ μυμῦ μυμῦ μυμῦ μυμῦ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:11.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:11.1.text#τί κινυρόμεθ' ἄλλως; οὐκ ἐχρῆν ζητεῖν τινα
urn:cts:greekLit:tlg0019.tlg002.fu.sp:12.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:12.1.text#σωτηρίαν νῷν, ἀλλὰ μὴ κλάειν ἔτι;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:13.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:13.1.text#τίς οὖν γένοιτ' ἄν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 13.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 13.2.text#λέγε σύ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 13.3.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 13.3.text#σὺ μὲν οὖν μοι λέγε,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:14.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:14.1.text#ἵνα μὴ μάχωμαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:14.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:14.2.text#μὰ τὸν Ἀπόλλω 'γὼ μὲν οὔ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:16.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:16.1.text#πῶς ἂν σύ μοι λέξειας ἁμὲ χρὴ λέγειν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:15.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:15.1.text#ἀλλ' εἰπὲ θαρρῶν, εἶτα κἀγὼ σοὶ φράσω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:17.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:17.1.text#ἀλλ' οὐκ ἔνι μοι τὸ θρέττε. πῶς ἂν οὖν ποτε
urn:cts:greekLit:tlg0019.tlg002.fu.sp:18.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:18.1.text#εἴποιμ' ἂν αὐτὸ δῆτα κομψευριπικῶς;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:19.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:19.1.text#μὴ 'μοί γε, μὴ 'μοί, μὴ διασκανδικίσῃς·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:20.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:20.1.text#ἀλλ' εὑρέ τιν' ἀπόκινον ἀπὸ τοῦ δεσπότου.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:21.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:21.1.text#λέγε δὴ μόλωμεν ξυνεχὲς ὡδὶ ξυλλαβών.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:22.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:22.1.text#καὶ δὴ λέγω μόλωμεν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:22.2.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:22.2.text#ἐξόπισθε νῦν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:23.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:23.1.text#αὐτὸ φάθι τοῦ μόλωμεν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 23.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 23.2.text#αὐτό.
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 23.3.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 23.3.text#πάνυ καλῶς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:24.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:24.1.text#ὥσπερ δεφόμενος νῦν ἀτρέμα πρῶτον λέγε
urn:cts:greekLit:tlg0019.tlg002.fu.sp:25.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:25.1.text#τὸ μόλωμεν, εἶτα δ' αὐτό, κᾆτ' ἐπάγων πυκνόν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:26.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:26.1.text#μόλωμεν αὐτὸ μόλωμεν αὐτομολῶμεν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:26.2.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:26.2.text#ἢν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:27.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:27.1.text#οὐχ ἡδύ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:27.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:27.2.text#νὴ Δία· πλήν γε περὶ τῷ δέρματι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:28.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:28.1.text#δέδοικα τουτονὶ τὸν οἰωνόν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:28.2.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:28.2.text#τί δαί;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:29.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:29.1.text#ὁτιὴ τὸ δέρμα δεφομένων ἀπέρχεται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:30.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:30.1.text#κράτιστα τοίνυν τῶν παρόντων ἐστὶ νῷν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:31.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:31.1.text#θεῶν ἰόντε προσπεσεῖν του πρὸς βρέτας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:32.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:32.1.text#† ποῖον βρέτας †; ἐτεὸν ἡγεῖ γὰρ θεούς;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:33.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:33.1.text#ἔγωγε.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:33.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:33.2.text#ποίῳ χρώμενος τεκμηρίῳ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:34.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:34.1.text#ὁτιὴ θεοῖσιν ἐχθρός εἰμ'. οὐκ εἰκότως;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:35.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:35.1.text#εὖ προσβιβάζεις μ'. ἀλλ' ἑτέρᾳ πῃ σκεπτέον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:36.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:36.1.text#βούλει τὸ πρᾶγμα τοῖς θεαταῖσιν φράσω;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:37.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:37.1.text#οὐ χεῖρον· ἓν δ' αὐτοὺς παραιτησώμεθα,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:38.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:38.1.text#ἐπίδηλον ἡμῖν τοῖς προσώποισιν ποιεῖν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:39.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:39.1.text#ἢν τοῖς ἔπεσι χαίρωσι καὶ τοῖς πράγμασιν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:40.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:40.1.text#λέγοιμ' ἂν ἤδη. νῷν γάρ ἐστι δεσπότης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:41.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:41.1.text#ἄγροικος ὀργὴν κυαμοτρὼξ ἀκράχολος,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:42.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:42.1.text#Δῆμος πυκνίτης, δύσκολον γερόντιον
urn:cts:greekLit:tlg0019.tlg002.fu.sp:43.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:43.1.text#ὑπόκωφον. οὗτος τῇ προτέρᾳ νουμηνίᾳ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:44.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:44.1.text#ἐπρίατο δοῦλον, βυρσοδέψην Παφλαγόνα,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:45.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:45.1.text#πανουργότατον καὶ διαβολώτατόν τινα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:46.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:46.1.text#οὗτος καταγνοὺς τοῦ γέροντος τοὺς τρόπους,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:47.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:47.1.text#ὁ βυρσοπαφλαγών, ὑποπεσὼν τὸν δεσπότην
urn:cts:greekLit:tlg0019.tlg002.fu.sp:48.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:48.1.text#ᾔκαλλ' ἐθώπευ' ἐκολάκευ' ἐξηπάτα
urn:cts:greekLit:tlg0019.tlg002.fu.sp:49.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:49.1.text#κοσκυλματίοις ἄκροισι τοιαυτὶ λέγων·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:50.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:50.1.text#ὦ Δῆμε λοῦσαι πρῶτον ἐκδικάσας μίαν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:51.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:51.1.text#ἐνθοῦ ῥόφησον ἔντραγ' ἔχε τριώβολον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:52.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:52.1.text#βούλει παραθῶ σοι δόρπον; εἶτ' ἀναρπάσας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:53.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:53.1.text#ὅ τι ἄν τις ἡμῶν σκευάσῃ, τῷ δεσπότῃ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:54.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:54.1.text#Παφλαγὼν κεχάρισται τοῦτο. καὶ πρώην γ' ἐμοῦ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:55.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:55.1.text#μᾶζαν μεμαχότος ἐν Πύλῳ Λακωνικήν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:56.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:56.1.text#πανουργότατά πως περιδραμὼν ὑφαρπάσας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:57.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:57.1.text#αὐτὸς παρέθηκε τὴν ὑπ' ἐμοῦ μεμαγμένην,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:58.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:58.1.text#ἡμᾶς δ' ἀπελαύνει κοὐκ ἐᾷ τὸν δεσπότην
urn:cts:greekLit:tlg0019.tlg002.fu.sp:59.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:59.1.text#ἄλλον θεραπεύειν, ἀλλὰ βυρσίνην ἔχων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:60.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:60.1.text#δειπνοῦντος ἑστὼς ἀποσοβεῖ τοὺς ῥήτορας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:61.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:61.1.text#ᾄδει δὲ χρησμούς· ὁ δὲ γέρων σιβυλλιᾷ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:62.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:62.1.text#ὁ δ' αὐτὸν ὡς ὁρᾷ μεμακκοακότα,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:63.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:63.1.text#τέχνην πεποίηται. τοὺς γὰρ ἔνδον ἄντικρυς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:64.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:64.1.text#ψευδῆ διαβάλλει· κᾆτα μαστιγούμεθα
urn:cts:greekLit:tlg0019.tlg002.fu.sp:65.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:65.1.text#ἡμεῖς· Παφλαγὼν δὲ περιθέων τοὺς οἰκέτας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:66.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:66.1.text#αἰτεῖ ταράττει δωροδοκεῖ λέγων τάδε·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:67.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:67.1.text#"ὁρᾶτε τὸν Ὕλαν δι' ἐμὲ μαστιγούμενον;"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:68.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:68.1.text#"εἰ μή μ' ἀναπείσετ', ἀποθανεῖσθε τήμερον."
urn:cts:greekLit:tlg0019.tlg002.fu.sp:69.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:69.1.text#ἡμεῖς δὲ δίδομεν· εἰ δὲ μή, πατούμενοι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:70.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:70.1.text#ὑπὸ τοῦ γέροντος ὀκταπλάσιον χέζομεν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:71.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:71.1.text#νῦν οὖν ἀνύσαντε φροντίσωμεν ὦγαθέ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:72.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:72.1.text#ποίαν ὁδὸν νὼ τρεπτέον καὶ πρὸς τίνα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:73.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:73.1.text#κράτιστ' ἐκείνην τὴν μόλωμεν ὦγαθέ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:74.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:74.1.text#ἀλλ' οὐχ οἷόν τε τὸν Παφλαγόν' οὐδὲν λαθεῖν·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:75.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:75.1.text#ἐφορᾷ γὰρ οὗτος πάντ'. ἔχει γὰρ τὸ σκέλος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:76.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:76.1.text#τὸ μὲν ἐν Πύλῳ, τὸ δ' ἓτερον ἐν τἠκκλησίᾳ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:77.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:77.1.text#τοσόνδε δ' αὐτοῦ βῆμα διαβεβηκότος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:78.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:78.1.text#ὁ πρωκτός ἐστιν αὐτόχρημ' ἐν Χάοσιν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:79.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:79.1.text#τὼ χεῖρ' ἐν Αἰτωλοῖς, ὁ νοῦς δ' ἐν Κλωπιδῶν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:80.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:80.1.text#κράτιστον οὖν νῷν ἀποθανεῖν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:80.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:80.2.text#ἀλλὰ σκόπει,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:81.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:81.1.text#ὅπως ἂν ἀποθάνοιμεν ἀνδρικώτατα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:82.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:82.1.text#πῶς δῆτα πῶς γένοιτ' ἂν ἀνδρικώτατα;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:83.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:83.1.text#βέλτιστον ἡμῖν αἷμα ταύρειον πιεῖν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:84.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:84.1.text#ὁ Θεμιστοκλέους γὰρ θάνατος αἱρετώτερος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:85.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:85.1.text#μὰ Δί' ἀλλ' ἄκρατον οἶνον ἀγαθοῦ δαίμονος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:86.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:86.1.text#ἴσως γὰρ ἂν χρηστόν τι βουλευσαίμεθα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:87.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:87.1.text#ἰδού γ' ἄκρατον. περὶ πότου γοῦν ἐστί σοι;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:88.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:88.1.text#πῶς δ' ἂν μεθύων χρηστόν τι βουλεύσαιτ' ἀνήρ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:89.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:89.1.text#ἄληθες οὗτος; κρουνοχυτρολήραιον εἶ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:90.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:90.1.text#οἶνον σὺ τολμᾷς εἰς ἐπίνοιαν λοιδορεῖν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:91.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:91.1.text#οἴνου γὰρ εὕροις ἄν τι πρακτικώτερον;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:92.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:92.1.text#ὁρᾷς, ὅταν πίνωσιν ἄνθρωποι τότε
urn:cts:greekLit:tlg0019.tlg002.fu.sp:93.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:93.1.text#πλουτοῦσι διαπράττουσι νικῶσιν δίκας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:94.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:94.1.text#εὐδαιμονοῦσιν ὠφελοῦσι τοὺς φίλους.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:95.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:95.1.text#ἀλλ' ἐξένεγκέ μοι ταχέως οἴνου χοᾶ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:96.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:96.1.text#τὸν νοῦν ἵν' ἄρδω καὶ λέγω τι δεξιόν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:97.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:97.1.text#οἴμοι τί ποθ' ἡμᾶς ἐργάσει τῷ σῷ πότῳ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:98.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:98.1.text#ἀγάθ'· ἀλλ' ἔνεγκ'· ἐγὼ δὲ κατακλινήσομαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:99.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:99.1.text#ἢν γὰρ μεθυσθῶ, πάντα ταυτὶ καταπάσω
urn:cts:greekLit:tlg0019.tlg002.fu.sp:100.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:100.1.text#βουλευματίων καὶ γνωμιδίων καὶ νοιδίων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:101.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:101.1.text#ὡς εὐτυχῶς ὅτι οὐκ ἐλήφθην ἔνδοθεν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:102.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:102.1.text#κλέπτων τὸν οἶνον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:102.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:102.2.text#εἰπέ μοι Παφλαγὼν τί δρᾷ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:103.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:103.1.text#ἐπίπαστα λείξας δημιόπραθ' ὁ βάσκανος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:104.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:104.1.text#ῥέγκει μεθύων ἐν ταῖσι βύρσαις ὕπτιος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:105.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:105.1.text#ἴθι νυν ἄκρατον ἐγκάναξόν μοι πολὺν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:106.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:106.1.text#σπονδήν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:106.2.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:106.2.text#λαβὲ δὴ καὶ σπεῖσον ἀγαθοῦ δαίμονος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:107.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:107.1.text#ἕλχ' ἕλκε τὴν τοῦ δαίμονος τοῦ Πραμνίου.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:108.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:108.1.text#ὦ δαῖμον ἀγαθὲ σὸν τὸ βούλευμ', οὐκ ἐμόν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:109.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:109.1.text#εἴπ', ἀντιβολῶ, τί ἔστι;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:109.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:109.2.text#τοὺς χρησμοὺς ταχὺ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:110.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:110.1.text#κλέψας ἔνεγκε τοῦ Παφλαγόνος ἔνδοθεν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:111.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:111.1.text#ἕως καθεύδει.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:111.2.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:111.2.text#ταῦτ'. ἀτὰρ τοῦ δαίμονος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:112.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:112.1.text#δέδοιχ' ὅπως μὴ τεύξομαι κακοδαίμονος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:113.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:113.1.text#φέρε νυν ἐγὼ μ' αὐτῷ προσαγάγω τὸν χοᾶ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:114.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:114.1.text#τὸν νοῦν ἵν' ἄρδω καὶ λέγω τι δεξιόν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:115.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:115.1.text#ὡς μεγάλ' ὁ Παφλαγὼν πέρδεται καὶ ῥέγκεται,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:116.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:116.1.text#ὥστ' ἔλαθον αὐτὸν τὸν ἱερὸν χρησμὸν λαβών,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:117.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:117.1.text#ὅνπερ μάλιστ' ἐφύλαττεν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:117.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:117.2.text#ὦ σοφώτατε.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:118.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:118.1.text#φέρ' αὐτὸν ἵν' ἀναγνῶ· σὺ δ' ἔγχεον πιεῖν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:119.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:119.1.text#ἀνύσας τι. φέρ' ἴδω τί ἄρ' ἔνεστιν αὐτόθι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:120.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:120.1.text#ὦ λόγια. δός μοι δὸς τὸ ποτήριον ταχύ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:121.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:121.1.text#ἰδού. τί φησ' ὁ χρησμός;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:121.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:121.2.text#ἑτέραν ἔγχεον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:122.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:122.1.text#ἐν τοῖς λογίοις ἔνεστιν "ἑτέραν ἔγχεον;"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:123.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:123.1.text#ὦ Βάκι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 123.2.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 123.2.text#τί ἔστι;
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 123.3.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 123.3.text#δὸς τὸ ποτήριον ταχύ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:124.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:124.1.text#πολλῷ γ' ὁ Βάκις ἐχρῆτο τῷ ποτηρίῳ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:125.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:125.1.text#ὦ μιαρὲ Παφλαγὼν ταῦτ' ἄρ' ἐφυλάττου πάλαι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:126.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:126.1.text#τὸν περὶ σεαυτοῦ χρησμὸν ὀρρωδῶν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:126.2.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:126.2.text#τιή;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:127.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:127.1.text#ἐνταῦθ' ἔνεστιν, αὐτὸς ὡς ἀπόλλυται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:128.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:128.1.text#καὶ πῶς;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:128.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:128.2.text#ὅπως; ὁ χρησμὸς ἄντικρυς λέγει
urn:cts:greekLit:tlg0019.tlg002.fu.sp:129.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:129.1.text#ὡς πρῶτα μὲν στυππειοπώλης γίγνεται,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:130.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:130.1.text#ὃς πρῶτος ἕξει τῆς πόλεως τὰ πράγματα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:131.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:131.1.text#εἷς οὑτοσὶ πώλης. τί τοὐντεῦθεν; λέγε.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:132.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:132.1.text#μετὰ τοῦτον αὖθις προβατοπώλης δεύτερος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:133.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:133.1.text#δύο τώδε πώλα. καὶ τί τόνδε χρὴ παθεῖν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:134.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:134.1.text#κρατεῖν, ἕως ἕτερος ἀνὴρ βδελυρώτερος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:135.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:135.1.text#αὐτοῦ γένοιτο· μετὰ δὲ ταῦτ' ἀπόλλυται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:136.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:136.1.text#ἐπιγίγνεται γὰρ βυρσοπώλης ὁ Παφλαγών,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:137.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:137.1.text#ἅρπαξ κεκράκτης Κυκλοβόρου φωνὴν ἔχων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:138.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:138.1.text#τὸν προβατοπώλην ἦν ἄρ' ἀπολέσθαι χρεὼν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:139.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:139.1.text#ὑπὸ βυρσοπώλου;
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 139.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 139.2.text#νὴ Δί'.
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 139.3.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 139.3.text#οἴμοι δείλαιος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:140.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:140.1.text#πόθεν οὖν ἂν ἔτι γένοιτο πώλης εἶς μόνος;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:141.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:141.1.text#ἔτ' ἐστὶν εἷς ὑπερφυᾶ τέχνην ἔχων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:142.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:142.1.text#εἴπ', ἀντιβολῶ, τίς ἐστιν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 142.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 142.2.text#εἴπω;
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 142.3.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 142.3.text#νὴ Δία.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:143.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:143.1.text#ἀλλαντοπώλης ἔσθ' ὁ τοῦτον ἐξολῶν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:144.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:144.1.text#ἀλλαντοπώλης; ὦ Πόσειδον τῆς τέχνης.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:145.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:145.1.text#φέρε ποῦ τὸν ἄνδρα τοῦτον ἐξευρήσομεν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:146.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:146.1.text#ζητῶμεν αὐτόν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:146.2.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:146.2.text#ἀλλ' ὁδὶ προσέρχεται
urn:cts:greekLit:tlg0019.tlg002.fu.sp:147.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:147.1.text#ὥσπερ κατὰ θεὸν εἰς ἀγοράν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:147.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:147.2.text#ὦ μακάριε
urn:cts:greekLit:tlg0019.tlg002.fu.sp:148.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:148.1.text#ἀλλαντοπῶλα, δεῦρο δεῦρ' ὦ φίλτατε
urn:cts:greekLit:tlg0019.tlg002.fu.sp:149.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:149.1.text#ἀνάβαινε σωτὴρ τῇ πόλει καὶ νῷν φανείς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:150.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:150.1.text#τί ἔστι; τί με καλεῖτε;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:150.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:150.2.text#δεῦρ' ἔλθ', ἵνα πύθῃ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:151.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:151.1.text#ὡς εὐτυχὴς εἶ καὶ μεγάλως εὐδαιμονεῖς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:152.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:152.1.text#ἴθι δὴ κάθελ' αὐτοῦ τοὐλεὸν καὶ τοῦ θεοῦ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:153.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:153.1.text#τὸν χρησμὸν ἀναδίδαξον αὐτὸν ὡς ἔχει·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:154.1.speaker#Νικίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:154.1.text#ἐγὼ δ' ἰὼν προσκέψομαι τὸν Παφλαγόνα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:155.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:155.1.text#ἄγε δὴ σὺ κατάθου πρῶτα τὰ σκεύη χαμαί·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:156.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:156.1.text#ἔπειτα τὴν γῆν πρόσκυσον καὶ τοὺς θεούς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:157.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:157.1.text#ἰδού· τί ἔστιν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:157.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:157.2.text#ὦ μακάρι' ὦ πλούσιε,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:158.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:158.1.text#ὦ νῦν μὲν οὐδεὶς αὔριον δ' ὑπέρμεγας,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:159.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:159.1.text#ὦ τῶν Ἀθηνῶν ταγὲ τῶν εὐδαιμόνων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:160.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:160.1.text#τί μ' ὦγάθ' οὐ πλύνειν ἐᾷς τὰς κοιλίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:161.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:161.1.text#πωλεῖν τε τοὺς ἀλλᾶντας, ἀλλὰ καταγελᾷς;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:162.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:162.1.text#ὦ μῶρε ποίας κοιλίας; δευρὶ βλέπε.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:163.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:163.1.text#τὰς στίχας ὁρᾷς τὰς τῶνδε τῶν λαῶν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:163.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:163.2.text#ὁρῶ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:164.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:164.1.text#τούτων ἁπάντων αὐτὸς ἀρχέλας ἔσει,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:165.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:165.1.text#καὶ τῆς ἀγορᾶς καὶ τῶν λιμένων καὶ τῆς πυκνός·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:166.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:166.1.text#βουλὴν πατήσεις καὶ στρατηγοὺς κλαστάσεις,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:167.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:167.1.text#δήσεις φυλάξεις, ἐν πρυτανείῳ λαικάσει.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:168.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:168.1.text#ἐγώ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:168.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:168.2.text#σὺ μέντοι· κοὐδέπω γε πάνθ' ὁρᾷς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:169.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:169.1.text#ἀλλ' ἐπανάβηθι κἀπὶ τοὐλεὸν τοδὶ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:170.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:170.1.text#καὶ κάτιδε τὰς νήσους ἁπάσας ἐν κύκλῳ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:171.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:171.1.text#καθορῶ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:171.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:171.2.text#τί δαί; τἀμπόρια καὶ τὰς ὁλκάδας;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:172.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:172.1.text#ἔγωγε.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:172.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:172.2.text#πῶς οὖν οὐ μεγάλως εὐδαιμονεῖς;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:173.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:173.1.text#ἔτι νῦν τὸν ὀφθαλμὸν παράβαλλ' ἐς Καρίαν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:174.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:174.1.text#τὸν δεξιόν, τὸν δ' ἕτερον ἐς Καρχηδόνα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:175.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:175.1.text#εὐδαιμονήσω δ' εἰ διαστραφήσομαι;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:176.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:176.1.text#οὐκ ἀλλὰ διὰ σοῦ ταῦτα πάντα πέρναται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:177.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:177.1.text#γίγνει γάρ, ὡς ὁ χρησμὸς οὑτοσὶ λέγει,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:178.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:178.1.text#ἀνὴρ μέγιστος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:178.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:178.2.text#εἰπέ μοι καὶ πῶς ἐγὼ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:179.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:179.1.text#ἀλλαντοπώλης ὢν ἀνὴρ γενήσομαι;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:180.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:180.1.text#δι' αὐτὸ γάρ τοι τοῦτο καὶ γίγνει μέγας,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:181.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:181.1.text#ὁτιὴ πονηρὸς κἀξ ἀγορᾶς εἶ καὶ θρασύς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:182.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:182.1.text#οὐκ ἀξιῶ 'γὼ 'μαυτὸν ἰσχύειν μέγα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:183.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:183.1.text#οἴμοι τί ποτ' ἔσθ' ὅτι σαυτὸν οὐ φῂς ἄξιον;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:184.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:184.1.text#ξυνειδέναι τί μοι δοκεῖς σαυτῷ καλόν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:185.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:185.1.text#μῶν ἐκ καλῶν εἶ κἀγαθῶν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:185.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:185.2.text#μὰ τοὺς θεοὺς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:186.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:186.1.text#εἰ μὴ 'κ πονηρῶν γ'.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:186.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:186.2.text#ὦ μακάριε τῆς τύχης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:187.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:187.1.text#ὅσον πέπονθας ἀγαθὸν ἐς τὰ πράγματα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:188.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:188.1.text#ἀλλ' ὦγάθ' οὐδὲ μουσικὴν ἐπίσταμαι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:189.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:189.1.text#πλὴν γραμμάτων, καὶ ταῦτα μέντοι κακὰ κακῶς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:190.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:190.1.text#τουτὶ μόνον σ' ἔβλαψεν, ὅτι καὶ κακὰ κακῶς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:191.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:191.1.text#ἡ δημαγωγία γὰρ οὐ πρὸς μουσικοῦ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:192.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:192.1.text#ἔτ' ἐστὶν ἀνδρὸς οὐδὲ χρηστοῦ τοὺς τρόπους,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:193.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:193.1.text#ἀλλ' εἰς ἀμαθῆ καὶ βδελυρόν. ἀλλὰ μὴ παρῇς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:194.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:194.1.text#ἅ σοι διδόασ' ἐν τοῖς λογίοισιν οἱ θεοί.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:195.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:195.1.text#πῶς δῆτά φησ' ὁ χρησμός;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:195.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:195.2.text#εὖ νὴ τοὺς θεοὺς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:196.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:196.1.text#καὶ ποικίλως πως καὶ σοφῶς ᾐνιγμένος·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:197.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:197.1.text#ἀλλ' ὁπόταν μάρψῃ βυρσαίετος ἀγκυλοχήλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:198.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:198.1.text#γαμφηλῇσι δράκοντα κοάλεμον αἱματοπώτην,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:199.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:199.1.text#δὴ τότε Παφλαγόνων μὲν ἀπόλλυται ἡ σκοροδάλμη,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:200.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:200.1.text#κοιλιοπώλῃσιν δὲ θεὸς μέγα κῦδος ὀπάζει,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:201.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:201.1.text#αἴ κεν μὴ πωλεῖν ἀλλᾶντας μᾶλλον ἕλωνται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:202.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:202.1.text#πῶς οὖν πρὸς ἐμὲ ταῦτ' ἐστίν; ἀναδίδασκέ με.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:203.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:203.1.text#βυρσαίετος μὲν ὁ Παφλαγών ἐσθ' οὑτοσί.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:204.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:204.1.text#τί δ' ἀγκυλοχήλης ἐστίν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:204.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:204.2.text#αὐτό που λέγει,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:205.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:205.1.text#ὅτι ἀγκύλαις ταῖς χερσὶν ἁρπάζων φέρει.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:206.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:206.1.text#ὁ δράκων δὲ πρὸς τί;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:206.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:206.2.text#τοῦτο περιφανέστατον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:207.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:207.1.text#ὁ δράκων γάρ ἐστι μακρὸν ὅ τ' ἀλλᾶς αὖ μακρόν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:208.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:208.1.text#εἶθ' αἱματοπώτης ἔσθ' ὅ τ' ἀλλᾶς χὠ δράκων·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:209.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:209.1.text#τὸν οὖν δράκοντά φησι τὸν βυρσαίετον
urn:cts:greekLit:tlg0019.tlg002.fu.sp:210.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:210.1.text#ἤδη κρατήσειν, αἴ κε μὴ θαλφθῇ λόγοις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:211.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:211.1.text#τὰ μὲν λόγι' αἰκάλλει με· θαυμάζω δ' ὅπως
urn:cts:greekLit:tlg0019.tlg002.fu.sp:212.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:212.1.text#τὸν δῆμον οἷός τ' ἐπιτροπεύειν εἴμ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:213.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:213.1.text#φαυλότατον ἔργον· ταῦθ' ἅπερ ποιεῖς ποίει·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:214.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:214.1.text#τάραττε καὶ χόρδευ' ὁμοῦ τὰ πράγματα
urn:cts:greekLit:tlg0019.tlg002.fu.sp:215.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:215.1.text#ἅπαντα, καὶ τὸν δῆμον ἀεὶ προσποιοῦ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:216.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:216.1.text#ὑπογλυκαίνων ῥηματίοις μαγειρικοῖς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:217.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:217.1.text#τὰ δ' ἄλλα σοι πρόσεστι δημαγωγικά,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:218.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:218.1.text#φωνὴ μιαρά, γέγονας κακῶς, ἀγοραῖος εἶ·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:219.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:219.1.text#ἔχεις ἅπαντα πρὸς πολιτείαν ἃ δεῖ·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:220.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:220.1.text#χρησμοί τε συμβαίνουσι καὶ τὸ Πυθικόν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:221.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:221.1.text#ἀλλὰ στεφανοῦ καὶ σπένδε τῷ Κοαλέμῳ·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:222.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:222.1.text#χὤπως ἀμυνεῖ τὸν ἄνδρα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:222.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:222.2.text#καὶ τίς ξύμμαχος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:223.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:223.1.text#γενήσεταί μοι; καὶ γὰρ οἵ τε πλούσιοι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:224.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:224.1.text#δεδίασιν αὐτὸν ὅ τε πένης βδύλλει λεώς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:225.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:225.1.text#ἀλλ' εἰσὶν ἱππῆς ἄνδρες ἀγαθοὶ χίλιοι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:226.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:226.1.text#μισοῦντες αὐτόν, οἳ βοηθήσουσί σοι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:227.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:227.1.text#καὶ τῶν πολιτῶν οἱ καλοί τε κἀγαθοί,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:228.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:228.1.text#καὶ τῶν θεατῶν ὅστις ἐστὶ δεξιός,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:229.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:229.1.text#κἀγὼ μετ' αὐτῶν χὠ θεὸς ξυλλήψεται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:230.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:230.1.text#καὶ μὴ δέδιθ'· οὐ γάρ ἐστιν ἐξῃκασμένος,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:231.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:231.1.text#ὑπὸ τοῦ δέους γὰρ αὐτὸν οὐδεὶς ἤθελεν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:232.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:232.1.text#τῶν σκευοποιῶν εἰκάσαι. πάντως γε μὴν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:233.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:233.1.text#γνωσθήσεται· τὸ γὰρ θέατρον δεξιόν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:234.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:234.1.text#οἴμοι κακοδαίμων ὁ Παφλαγὼν ἐξέρχεται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:235.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:235.1.text#οὔτοι μὰ τοὺς δώδεκα θεοὺς χαιρήσετον,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:236.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:236.1.text#ὁτιὴ 'πὶ τῷ δήμῳ ξυνόμνυτον πάλαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:237.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:237.1.text#τουτὶ τί δρᾷ τὸ Χαλκιδικὸν ποτήριον;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:238.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:238.1.text#οὐκ ἔσθ' ὅπως οὐ Χαλκιδέας ἀφίστατον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:239.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:239.1.text#ἀπολεῖσθον ἀποθανεῖσθον ὦ μιαρωτάτω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:240.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:240.1.text#οὗτος τί φεύγεις; οὐ μενεῖς; ὦ γεννάδα
urn:cts:greekLit:tlg0019.tlg002.fu.sp:241.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:241.1.text#ἀλλαντοπῶλα μὴ προδῷς τὰ πράγματα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:242.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:242.1.text#ἄνδρες ἱππῆς παραγένεσθε· νῦν ὁ καιρός. ὦ Σίμων,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:243.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:243.1.text#ὦ Παναίτι' οὐκ ἐλᾶτε πρὸς τὸ δεξιὸν κέρας;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:244.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:244.1.text#ἅνδρες ἐγγύς. ἀλλ' ἀμύνου κἀπαναστρέφου πάλιν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:245.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:245.1.text#ὁ κονιορτὸς δῆλος αὐτῶν ὡς ὁμοῦ προσκειμένων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:246.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:246.1.text#ἀλλ' ἀμύνου καὶ δίωκε καὶ τροπὴν αὐτοῦ ποιοῦ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:247.1.speaker#Χορός Ἱππεῶν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:247.1.text#παῖε παῖε τὸν πανοῦργον καὶ ταραξιππόστρατον
urn:cts:greekLit:tlg0019.tlg002.fu.sp:248.1.speaker#Χορός Ἱππεῶν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:248.1.text#καὶ τελώνην καὶ φάραγγα καὶ Χάρυβδιν ἁρπαγῆς,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:249.1.speaker#Χορός Ἱππεῶν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:249.1.text#καὶ πανοῦργον καὶ πανοῦργον· πολλάκις γὰρ αὔτ' ἐρῶ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:250.1.speaker#Χορός Ἱππεῶν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:250.1.text#καὶ γὰρ οὗτος ἦν πανοῦργος πολλάκις τῆς ἡμέρας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:251.1.speaker#Χορός Ἱππεῶν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:251.1.text#ἀλλὰ παῖε καὶ δίωκε καὶ τάραττε καὶ κύκα
urn:cts:greekLit:tlg0019.tlg002.fu.sp:252.1.speaker#Χορός Ἱππεῶν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:252.1.text#καὶ βδελύττου, καὶ γὰρ ἡμεῖς, κἀπικείμενος βόα·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:253.1.speaker#Χορός Ἱππεῶν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:253.1.text#εὐλαβοῦ δὲ μὴ 'κφύγῃ σε· καὶ γὰρ οἶδε τὰς ὁδούς,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:254.1.speaker#Χορός Ἱππεῶν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:254.1.text#ἅσπερ Εὐκράτης ἔφευγεν εὐθὺ τῶν κυρηβίων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:255.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:255.1.text#ὦ γέροντες ἡλιασταί, φράτερες τριωβόλου,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:256.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:256.1.text#οὓς ἐγὼ βόσκω κεκραγὼς καὶ δίκαια κἄδικα,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:257.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:257.1.text#παραβοηθεῖθ', ὡς ὑπ' ἀνδρῶν τύπτομαι ξυνωμοτῶν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:258.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:258.1.text#ἐν δίκῃ γ', ἐπεὶ τὰ κοινὰ πρὶν λαχεῖν κατεσθίεις,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:259.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:259.1.text#κἀποσυκάζεις πιέζων τοὺς ὑπευθύνους σκοπῶν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:260.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:260.1.text#ὅστις αὐτῶν ὠμός ἐστιν ἢ πέπων ἢ μὴ πέπων,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:261.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:261.1.text#κἄν τιν' αὐτῶν γνῷς ἀπράγμον' ὄντα καὶ κεχηνότα,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:262.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:262.1.text#καταγαγὼν ἐκ Χερρονήσου διαβαλὼν ἀγκυρίσας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:263.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:263.1.text#εἶτ' ἀποστρέψας τὸν ὦμον αὐτὸν ἐνεκολήβασας·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:264.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:264.1.text#καὶ σκοπεῖς γε τῶν πολιτῶν ὅστις ἐστὶν ἀμνοκῶν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:265.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:265.1.text#πλούσιος καὶ μὴ πονηρὸς καὶ τρέμων τὰ πράγματα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:266.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:266.1.text#ξυνεπίκεισθ' ὑμεῖς; ἐγὼ δ' ἄνδρες δι' ὑμᾶς τύπτομαι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:267.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:267.1.text#ὅτι λέγειν γνώμην ἔμελλον ὡς δίκαιον ἐν πόλει
urn:cts:greekLit:tlg0019.tlg002.fu.sp:268.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:268.1.text#ἑστάναι μνημεῖον ὑμῶν ἐστιν ἀνδρείας χάριν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:269.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:269.1.text#ὡς δ' ἀλαζών, ὡς δὲ μάσθλης· εἶδες οἷ' ὑπέρχεται
urn:cts:greekLit:tlg0019.tlg002.fu.sp:270.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:270.1.text#ὡσπερεὶ γέροντας ἡμᾶς καὶ κοβαλικεύεται;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:271.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:271.1.text#ἀλλ' ἐὰν ταύτῃ γε νικᾷ, ταυτῃὶ πεπλήξεται·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:272.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:272.1.text#ἢν δ' ὑπεκκλίνῃ γε δευρί, τὸ σκέλος κυρηβάσει.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:273.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:273.1.text#ὦ πόλις καὶ δῆμ' ὑφ' οἵων θηρίων γαστρίζομαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:274.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:274.1.text#καὶ κέκραγας, ὥσπερ ἀεὶ τὴν πόλιν καταστρέφει;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:275.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:275.1.text#ἀλλ' ἐγώ σε τῇ βοῇ ταύτῃ γε πρῶτα τρέψομαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:276.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:276.1.text#ἀλλ' ἐὰν μέντοι γε νικᾷς τῇ βοῇ, τήνελλος εἶ·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:277.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:277.1.text#ἢν δ' ἀναιδείᾳ παρέλθῃ σ', ἡμέτερος ὁ πυραμοῦς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:278.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:278.1.text#τουτονὶ τὸν ἄνδρ' ἐγὼ 'νδείκνυμι, καὶ φήμ' ἐξάγειν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:279.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:279.1.text#ταῖσι Πελοποννησίων τριήρεσι ζωμεύματα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:280.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:280.1.text#ναὶ μὰ Δία κἄγωγε τοῦτον, ὅτι κενῇ τῇ κοιλίᾳ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:281.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:281.1.text#ἐσδραμὼν ἐς τὸ πρυτανεῖον, εἶτα πάλιν ἐκθεῖ πλέᾳ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:282.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:282.1.text#νὴ Δί' ἐξάγων γε τἀπόρρηθ', ἅμ' ἄρτον καὶ κρέας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:283.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:283.1.text#καὶ τέμαχος, οὗ Περικλέης οὐκ ἠξιώθη πώποτε.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:284.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:284.1.text#ἀποθανεῖσθον αὐτίκα μάλα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:285.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:285.1.text#τριπλάσιον κεκράξομαί σου.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:286.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:286.1.text#καταβοήσομαι βοῶν σε.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:287.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:287.1.text#κατακεκράξομαί σε κράζων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:288.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:288.1.text#διαβαλῶ σ' ἐὰν στρατηγῇς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:289.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:289.1.text#κυνοκοπήσω σου τὸ νῶτον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:290.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:290.1.text#περιελῶ σ' ἀλαζονείαις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:291.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:291.1.text#ὑποτεμοῦμαι τὰς ὁδούς σου.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:292.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:292.1.text#βλέψον ἔς μ' ἀσκαρδάμυκτος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:293.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:293.1.text#ἐν ἀγορᾷ κἀγὼ τέθραμμαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:294.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:294.1.text#διαφορήσω σ' εἴ τι γρύξει.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:295.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:295.1.text#κοπροφορήσω σ' εἰ λαλήσεις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:296.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:296.1.text#ὁμολογῶ κλέπτειν· σὺ δ' οὐχί.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:297.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:297.1.text#νὴ τὸν Ἑρμῆν τὸν ἀγοραῖον,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:298.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:298.1.text#κἀπιορκῶ γε βλεπόντων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:299.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:299.1.text#ἀλλότρια τοίνυν σοφίζει,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:300.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:300.1.text#καὶ φανῶ σε τοῖς πρυτάνεσιν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:301.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:301.1.text#ἀδεκατεύτους τῶν θεῶν ἱερὰς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:302.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:302.1.text#ἔχοντα κοιλίας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:303.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:303.1.text#ὦ μιαρὲ καὶ βδελυρὲ † καὶ κεκράκτα †, τοῦ σοῦ θράσους
urn:cts:greekLit:tlg0019.tlg002.fu.sp:305.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:305.1.text#πᾶσα μὲν γῆ πλέα, πᾶσα δ' ἐκκλησία, καὶ τέλη
urn:cts:greekLit:tlg0019.tlg002.fu.sp:306.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:306.1.text#καὶ γραφαὶ καὶ δικαστήρι', ὦ βορβοροτάραξι καὶ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:310.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:310.1.text#τὴν πόλιν ἅπασαν ἡμῶν ἀνατετυρβακώς,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:311.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:311.1.text#ὅστις ἡμῶν τὰς Ἀθήνας ἐκκεκώφωκας βοῶν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:313.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:313.1.text#κἀπὸ τῶν πετρῶν ἄνωθεν τοὺς φόρους θυννοσκοπῶν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:314.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:314.1.text#οἶδ' ἐγὼ τὸ πρᾶγμα τοῦθ' ὅθεν πάλαι καττύεται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:315.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:315.1.text#εἰ δὲ μὴ σύ γ' οἶσθα κάττυμ', οὐδ' ἐγὼ χορδεύματα,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:316.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:316.1.text#ὅστις ὑποτέμνων ἐπώλεις δέρμα μοχθηροῦ βοὸς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:317.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:317.1.text#τοῖς ἀγροίκοισιν πανούργως, ὥστε φαίνεσθαι παχύ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:318.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:318.1.text#καὶ πρὶν ἡμέραν φορῆσαι μεῖζον ἦν δυοῖν δοχμαῖν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:319.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:319.1.text#νὴ Δία κἀμὲ τοῦτ' ἔδρασε ταὐτόν, ὥστε κατάγελων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:320.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:320.1.text#πάμπολυν τοῖς δημόταισι καὶ φίλοις παρασχεθεῖν·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:321.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:321.1.text#πρὶν γὰρ εἶναι Περγασῆσιν ἔνεον ἐν ταῖς ἐμβάσιν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:323.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:323.1.text#ἆρα δῆτ' οὐκ ἀπ' ἀρχῆς ἐδήλους ἀναίδειαν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:325.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:325.1.text#ἥπερ μόνη προστατεῖ ῥητόρων;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:326.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:326.1.text#ᾗ σὺ πιστεύων ἀμέλγεις τῶν ξένων τοὺς καρπίμους,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:327.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:327.1.text#πρῶτος ὤν· ὁ δ' Ἱπποδάμου λείβεται θεώμενος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:328.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:328.1.text#ἀλλ' ἐφάνη γὰρ ἀνὴρ ἕτερος πολὺ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:329.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:329.1.text#σοῦ μιαρώτερος, ὥστε με χαίρειν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:330.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:330.1.text#ὅς σε παύσει καὶ πάρεισι, δῆλός ἐστιν αὐτόθεν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:331.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:331.1.text#πανουργίᾳ τε καὶ θράσει
urn:cts:greekLit:tlg0019.tlg002.fu.sp:332.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:332.1.text#καὶ κοβαλικεύμασιν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:333.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:333.1.text#ἀλλ' ὦ τραφεὶς ὅθενπέρ εἰσιν ἄνδρες οἵπερ εἰσίν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:334.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:334.1.text#νῦν δεῖξον ὡς οὐδὲν λέγει τὸ σωφρόνως τραφῆναι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:335.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:335.1.text#καὶ μὴν ἀκούσαθ' οἷός ἐστιν οὑτοσὶ πολίτης.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:336.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:336.1.text#οὐκ αὖ μ' ἐάσεις;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:336.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:336.2.text#μὰ Δί' ἐπεὶ κἀγὼ πονηρός εἰμι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:337.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:337.1.text#ἐὰν δὲ μὴ ταύτῃ γ' ὑπείκῃ, λέγ' ὅτι κἀκ πονηρῶν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:338.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:338.1.text#οὐκ αὖ μ' ἐάσεις;
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 338.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 338.2.text#μὰ Δία.
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 338.3.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 338.3.text#ναὶ μὰ Δία.
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 338.4.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 338.4.text#μὰ τὸν Ποσειδῶ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:339.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:339.1.text#ἀλλ' αὐτὸ περὶ τοῦ πρότερος εἰπεῖν πρῶτα διαμαχοῦμαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:340.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:340.1.text#οἴμοι διαρραγήσομαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:340.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:340.2.text#καὶ μὴν ἐγὼ οὐ παρήσω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:341.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:341.1.text#πάρες πάρες πρὸς τῶν θεῶν αὐτῷ διαρραγῆναι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:342.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:342.1.text#τῷ καὶ πεποιθὼς ἀξιοῖς ἐμοῦ λέγειν ἔναντα;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:343.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:343.1.text#ὁτιὴ λέγειν οἷός τε κἀγὼ καὶ καρυκοποιεῖν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:344.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:344.1.text#ἰδοὺ λέγειν. καλῶς γ' ἂν οὖν σὺ πρᾶγμα προσπεσόν σοι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:345.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:345.1.text#ὠμοσπάρακτον παραλαβὼν μεταχειρίσαιο χρηστῶς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:346.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:346.1.text#ἀλλ' οἶσθ' ὅπερ πεπονθέναι δοκεῖς; ὅπερ τὸ πλῆθος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:347.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:347.1.text#εἴ που δικίδιον εἶπας εὖ κατὰ ξένου μετοίκου,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:348.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:348.1.text#τὴν νύκτα θρυλῶν καὶ λαλῶν ἐν ταῖς ὁδοῖς σεαυτῷ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:349.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:349.1.text#ὕδωρ τε πίνων κἀπιδεικνὺς τοὺς φίλους τ' ἀνιῶν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:350.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:350.1.text#ᾤου δυνατὸς εἶναι λέγειν. ὦ μῶρε τῆς ἀνοίας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:351.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:351.1.text#τί δαὶ σὺ πίνων τὴν πόλιν πεποίηκας, ὥστε νυνὶ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:352.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:352.1.text#ὑπὸ σοῦ μονωτάτου κατεγλωττισμένην σιωπᾶν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:353.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:353.1.text#ἐμοὶ γὰρ ἀντέθηκας ἀνθρώπων τίν'; ὅστις εὐθὺς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:354.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:354.1.text#θύννεια θερμὰ καταφαγών, κᾆτ' ἐπιπιὼν ἀκράτου
urn:cts:greekLit:tlg0019.tlg002.fu.sp:355.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:355.1.text#οἴνου χοᾶ κασαλβάσω τοὺς ἐν Πύλῳ στρατηγούς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:356.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:356.1.text#ἐγὼ δέ γ' ἤνυστρον βοὸς καὶ κοιλίαν ὑείαν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:357.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:357.1.text#καταβροχθίσας κᾆτ' ἐπιπιὼν τὸν ζωμὸν ἀναπόνιπτος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:358.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:358.1.text#λαρυγγιῶ τοὺς ῥήτορας καὶ Νικίαν ταράξω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:359.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:359.1.text#τὰ μὲν ἄλλα μ' ἤρεσας λέγων·. ἓν δ' οὐ προσίεταί με,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:360.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:360.1.text#τῶν πραγμάτων ὁτιὴ μόνος τὸν ζωμὸν ἐκροφήσει.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:361.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:361.1.text#ἀλλ' οὐ λάβρακας καταφαγὼν Μιλησίους κλονήσεις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:362.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:362.1.text#ἀλλὰ σχελίδας ἐδηδοκὼς ὠνήσομαι μέταλλα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:363.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:363.1.text#ἐγὼ δ' ἐπεσπηδῶν γε τὴν βουλὴν βίᾳ κυκήσω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:364.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:364.1.text#ἐγὼ δὲ κινήσω γέ σου τὸν πρωκτὸν ἀντὶ φύσκης.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:365.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:365.1.text#ἐγὼ δέ γ' ἐξέλξω σε τῆς πυγῆς θύραζε κύβδα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:366.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:366.1.text#νὴ τὸν Ποσειδῶ κἀμέ τἄρ', ἤνπερ γε τοῦτον ἕλκῃς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:367.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:367.1.text#οἷόν σε δήσω 'ν' τῷ ξύλῳ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:368.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:368.1.text#διώξομαί σε δειλίας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:369.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:369.1.text#ἡ βύρσα σου θρανεύσεται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:370.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:370.1.text#δερῶ σε θύλακον κλοπῆς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:371.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:371.1.text#διαπατταλευθήσει χαμαί.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:372.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:372.1.text#περικόμματ' ἔκ σου σκευάσω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:373.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:373.1.text#τὰς βλεφαρίδας σου παρατιλῶ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:374.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:374.1.text#τὸν πρηγορεῶνά σοὐκτεμῶ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:375.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:375.1.text#καὶ νὴ Δί' ἐμβαλόντες αὐτῷ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:376.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:376.1.text#πάτταλον μαγειρικῶς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:377.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:377.1.text#ἐς τὸ στόμ', εἶτα δ' ἔνδοθεν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:378.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:378.1.text#τὴν γλῶτταν ἐξείραντες αὐτοῦ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:379.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:379.1.text#σκεψόμεσθ' εὖ κἀνδρικῶς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:380.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:380.1.text#κεχηνότος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:381.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:381.1.text#τὸν πρωκτὸν εἰ χαλαζᾷ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:384.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:384.1.text#ἦν ἄρα πυρός γ' ἕτερα θερμότερα καὶ λόγων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:385.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:385.1.text#ἐν πόλει τῶν ἀναιδῶν ἀναιδέστεροι· καὶ τὸ πρᾶγμ'
urn:cts:greekLit:tlg0019.tlg002.fu.sp:386.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:386.1.text#ἦν ἄρ' οὐ φαῦλον ὧδ' […] ἀλλ' ἔπιθι καὶ στρόβει,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:387.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:387.1.text#μηδὲν ὀλίγον ποίει. νῦν γὰρ ἔχεται μέσος·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:388.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:388.1.text#ὡς ἐὰν νυνὶ μαλάξῃς αὐτὸν ἐν τῇ προσβολῇ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:390.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:390.1.text#δειλὸν εὑρήσεις· ἐγὼ γὰρ τοὺς τρόπους ἐπίσταμαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:391.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:391.1.text#ἀλλ' ὅμως οὗτος τοιοῦτος ὢν ἅπαντα τὸν βίον,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:392.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:392.1.text#κᾆτ' ἀνὴρ ἔδοξεν εἶναι, τἀλλότριον ἀμῶν θέρος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:393.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:393.1.text#νῦν δὲ τοὺς στάχυς ἐκείνους, οὓς ἐκεῖθεν ἤγαγεν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:394.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:394.1.text#ἐν ξύλῳ δήσας ἀφαύει κἀποδόσθαι βούλεται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:395.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:395.1.text#οὐ δέδοιχ' ὑμᾶς, ἕως ἂν ζῇ τὸ βουλευτήριον
urn:cts:greekLit:tlg0019.tlg002.fu.sp:396.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:396.1.text#καὶ τὸ τοῦ δήμου πρόσωπον μακκοᾷ καθήμενον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:398.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:398.1.text#ὡς δὲ πρὸς πᾶν ἀναιδεύεται κοὐ μεθίστησι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:399.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:399.1.text#τοῦ χρώματος τοῦ παρεστηκότος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:400.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:400.1.text#εἴ σε μὴ μισῶ, γενοίμην ἐν Κρατίνου κῴδιον,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:401.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:401.1.text#καὶ διδασκοίμην προσᾴδειν Μορσίμου τραγῳδίᾳ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:402.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:402.1.text#ὦ περὶ πάντ' ἐπὶ πᾶσί τε πράγμασι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:403.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:403.1.text#δωροδόκοισιν ἐπ' ἄνθεσιν ἵζων,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:404.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:404.1.text#εἴθε φαύλως ὥσπερ ηὗρες ἐκβάλοις τὴν ἔνθεσιν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:405.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:405.1.text#ᾄσαιμι γὰρ τότ' ἂν μόνον,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:406.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:406.1.text# "πῖνε πῖν' ἐπὶ συμφοραῖς."
urn:cts:greekLit:tlg0019.tlg002.fu.sp:407.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:407.1.text#τὸν Ἰουλίου τ' ἂν οἴομαι γέροντα πυροπίπην
urn:cts:greekLit:tlg0019.tlg002.fu.sp:408.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:408.1.text#ἡσθέντ' ἰηπαιωνίσαι καὶ βακχέβακχον ᾆσαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:409.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:409.1.text#οὔτοί μ' ὑπερβαλεῖσθ' ἀναιδείᾳ μὰ τὸν Ποσειδῶ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:410.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:410.1.text#ἢ μή ποτ' ἀγοραίου Διὸς σπλάλχνοισι παραγενοίμην.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:411.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:411.1.text#ἔγωγε νὴ τοὺς κονδύλους οὓς πολλὰ δὴ 'πὶ πολλοῖς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:412.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:412.1.text#ἠνεσχόμην ἐκ παιδίων, μαχαιρίδων τε πληγάς,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:413.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:413.1.text#ὑπερβαλεῖσθαί σ' οἴομαι τούτοισιν, ἢ μάτην γ' ἂν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:414.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:414.1.text#ἀπομαγδαλιὰς σιτούμενος τοσοῦτος ἐκτραφείην.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:415.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:415.1.text#ἀπομαγδαλιὰς ὥσπερ κύων; ὦ παμπόνηρε πῶς οὖν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:416.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:416.1.text#κυνὸς βορὰν σιτούμενος μαχεῖ σὺ κυνοκεφάλλῳ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:417.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:417.1.text#καὶ νὴ Δί' ἄλλα γ' ἐστί μου κόβαλα παιδὸς ὄντος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:418.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:418.1.text#ἐξηπάτων γὰρ τοὺς μαγείρους ἐπιλέγων τοιαυτί·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:419.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:419.1.text# "σκέψασθε παῖδες· οὐχ ὁρᾶθ'; ὥρα νέα, χελιδών."
urn:cts:greekLit:tlg0019.tlg002.fu.sp:420.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:420.1.text#οἱ δ' ἔβλεπον, κἀγὼ 'ν τοσούτῳ τῶν κρεῶν ἔκλεπτον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:421.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:421.1.text#ὦ δεξιώτατον κρέας σοφῶς γε προὐνοήσω·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:422.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:422.1.text#ὥσπερ ἀκαλήφας ἐσθίων πρὸ χελιδόνων ἔκλεπτες.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:423.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:423.1.text#καὶ ταῦτα δρῶν ἐλάνθανόν γ'· εἰ δ' οὖν ἴδοι τις αὐτῶν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:424.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:424.1.text#ἀποκρυπτόμενος ἐς τὼ κοχώνα τοὺς θεοὺς ἀπώμνυν·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:425.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:425.1.text#ὥστ' εἶπ' ἀνὴρ τῶν ῥητόρων ἰδών με τοῦτο δρῶντα·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:426.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:426.1.text# "οὐκ ἔσθ' ὅπως ὁ παῖς ὅδ' οὐ τὸν δῆμον ἐπιτροπεύσει."
urn:cts:greekLit:tlg0019.tlg002.fu.sp:427.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:427.1.text#εὖ γε ξυνέβαλεν αὔτ'· ἀτὰρ δῆλόν γ' ἀφ' οὗ ξυνέγνω·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:428.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:428.1.text#ὁτιὴ 'πιώρκεις θ' ἡρπακὼς καὶ κρέας ὁ πρωκτὸς εἶχεν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:429.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:429.1.text#ἐγώ σε παύσω τοῦ θράσους, οἶμαι δὲ μᾶλλον ἄμφω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:430.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:430.1.text#ἔξειμι γάρ σοι λαμπρὸς ἤδη καὶ μέγας καθιείς,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:431.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:431.1.text#ὁμοῦ ταράττων τήν τε γῆν καὶ τὴν θάλατταν εἰκῇ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:432.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:432.1.text#ἐγὼ δὲ συστείλας γε τοὺς ἀλλᾶντας εἶτ' ἀφήσω
urn:cts:greekLit:tlg0019.tlg002.fu.sp:433.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:433.1.text#κατὰ κῦμ' ἐμαυτὸν οὔριον, κλάειν σε μακρὰ κελεύσας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:434.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:434.1.text#κἄγωγ', ἐάν τι παραχαλᾷ, τὴν ἀντλίαν φυλάξω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:435.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:435.1.text#οὔτοι μὰ τὴν Δήμητρα καταπροίξει τάλαντα πολλὰ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:436.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:436.1.text#κλέψας Ἀθηναίων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:436.2.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:436.2.text#ἄθρει καὶ τοῦ ποδὸς παρίει·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:437.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:437.1.text#ὡς οὗτος ἤδη καικίας καὶ συκοφαντίας πνεῖ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:438.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:438.1.text#σὲ δ' ἐκ Ποτειδαίας ἔχοντ' εὖ οἶδα δέκα τάλαντα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:439.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:439.1.text#τί δῆτα; βούλει τῶν ταλάντων ἓν λαβὼν σιωπᾶν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:440.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:440.1.text#ἁνὴρ ἂν ἡδέως λάβοι. τοὺς τερθρίους παρίει·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:441.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:441.1.text#τὸ πνεῦμ' ἔλαττον γίγνεται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:442.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:442.1.text#φεύξει γραφὰς […]
urn:cts:greekLit:tlg0019.tlg002.fu.sp:442a.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:442a.text#ἑκατονταλάντους τέτταρας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:443.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:443.1.text#σὺ δ' ἀστρατείας γ' εἴκοσιν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:444.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:444.1.text#κλοπῆς δὲ πλεῖν ἢ χιλίας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:445.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:445.1.text#ἐκ τῶν ἀλιτηρίων σέ φημι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:446.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:446.1.text#γεγονέναι τῶν τῆς θεοῦ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:447.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:447.1.text#τὸν πάππον εἶναί φημί σου
urn:cts:greekLit:tlg0019.tlg002.fu.sp:448.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:448.1.text#τῶν δορυφόρων —
urn:cts:greekLit:tlg0019.tlg002.fu.sp:448.2.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:448.2.text#ποίων; φράσον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:449.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:449.1.text#τῶν Βυρσίνης τῆς Ἱππίου.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:450.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:450.1.text#κόβαλος εἶ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:450.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:450.2.text#πανοῦργος εἶ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:451.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:451.1.text#παῖ' ἀνδρικῶς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:451.2.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:451.2.text#ἰοὺ ἰού,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:452.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:452.1.text#τύπτουσί μ' οἱ ξυνωμόται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:453.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:453.1.text#παῖ' αὐτὸν ἀνδρειότατα, καὶ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:454.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:454.1.text#γάστριζε καὶ τοῖς ἐντέροις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:455.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:455.1.text#καὶ τοῖς κόλοις,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:456.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:456.1.text#χὤπως κολᾷ τὸν ἄνδρα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:457.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:457.1.text#ὦ γεννικώτατον κρέας ψυχήν τ' ἄριστε πάντων,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:458.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:458.1.text#καὶ τῇ πόλει σωτὴρ φανεὶς ἡμῖν τε τοῖς πολίταις,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:459.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:459.1.text#ὡς εὖ τὸν ἄνδρα ποικίλως θ' ὑπῆλθες ἐν λόγοισιν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:460.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:460.1.text#πῶς ἄν σ' ἐπαινέσαιμεν οὕτως ὥσπερ ἡδόμεσθα;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:461.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:461.1.text#ταυτὶ μὰ τὴν Δήμητρά μ' οὐκ ἐλάνθανεν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:462.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:462.1.text#τεκταινόμενα τὰ πράγματ', ἀλλ' ἠπιστάμην
urn:cts:greekLit:tlg0019.tlg002.fu.sp:463.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:463.1.text#γομφούμεν' αὐτὰ πάντα καὶ κολλώμενα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:464.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:464.1.text#οἴμοι σὺ δ' οὐδὲν ἐξ ἁμαξουργοῦ λέγεις;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:465.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:465.1.text#οὔκουν μ' ἐν Ἄργει γ' οἷα πράττεις λανθάνει.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:466.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:466.1.text#πρόφασιν μὲν Ἀργείους φίλους ἡμῖν ποιεῖ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:467.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:467.1.text#ἰδίᾳ δ' ἐκεῖ Λακεδαιμονίοις ξυγγίγνεται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:468.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:468.1.text#καὶ ταῦτ' ἐφ' οἷσίν ἐστι συμφυσώμενα
urn:cts:greekLit:tlg0019.tlg002.fu.sp:469.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:469.1.text#ἐγᾦδ'· ἐπὶ γὰρ τοῖς δεδεμένοις χαλκεύεται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:470.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:470.1.text#εὖ γ' εὖ γε, χάλκεὐ ἀντὶ τῶν κολλωμένων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:471.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:471.1.text#καὶ ξυγκροτοῦσιν ἄνδρες αὔτ' ἐκεῖθεν αὖ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:472.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:472.1.text#καὶ ταῦτά μ' οὔτ' ἀργύριον οὔτε χρυσίον
urn:cts:greekLit:tlg0019.tlg002.fu.sp:473.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:473.1.text#διδοὺς ἀναπείσεις οὔτε προσπέμπων φίλους,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:474.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:474.1.text#ὅπως ἐγὼ ταῦτ' οὐκ Ἀθηναίοις φράσω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:475.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:475.1.text#ἐγὼ μὲν οὖν αὐτίκα μάλ' ἐς βουλὴν ἰὼν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:476.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:476.1.text#ὑμῶν ἁπάντων τὰς ξυνωμοσίας ἐρῶ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:477.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:477.1.text#καὶ τὰς ξυνόδους τὰς νυκτερινὰς τὰς ἐν πόλει,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:478.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:478.1.text#καὶ πάνθ' ἃ Μήδοις καὶ βασιλεῖ ξυνόμνυτε,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:479.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:479.1.text#καὶ τἀκ Βοιωτῶν ταῦτα συντυρούμενα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:480.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:480.1.text#πῶς οὖν ὁ τυρὸς ἐν Βοιωτοῖς ὤνιος;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:481.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:481.1.text#ἐγώ σε νὴ τὸν Ἡρακλέα παραστορῶ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:482.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:482.1.text#ἄγε δὴ σὺ τίνα νοῦν ἢ τίνα ψυχὴν ἔχεις;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:483.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:483.1.text#νυνί γε δείξεις, εἴπερ ἀπεκρύψω τότε
urn:cts:greekLit:tlg0019.tlg002.fu.sp:484.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:484.1.text#ἐς τὼ κοχώνα τὸ κρέας, ὡς αὐτὸς λέγεις·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:485.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:485.1.text#θεύσει γὰρ ᾄξας ἐς τὸ βουλευτήριον,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:486.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:486.1.text#ὡς οὗτος ἐσπεσὼν ἐκεῖσε διαβαλεῖ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:487.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:487.1.text#ἡμᾶς ἅπαντας καὶ κράγον κεκράξεται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:488.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:488.1.text#ἀλλ' εἶμι· πρῶτον δ' ὡς ἔχω τὰς κοιλίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:489.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:489.1.text#καὶ τὰς μαχαίρας ἐνθαδὶ καταθήσομαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:490.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:490.1.text#ἔχε νυν, ἄλειψον τὸν τράχηλον τουτῳί,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:491.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:491.1.text#ἵν' ἐξολισθάνειν δύνῃ τὰς διαβολάς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:492.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:492.1.text#ἀλλ' εὖ λέγεις καὶ παιδοτριβικῶς ταυταγί.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:493.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:493.1.text#ἔχε νυν, ἐπέγκαψον λαβὼν ταδί.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:493.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:493.2.text#τί δαί;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:494.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:494.1.text#ἵν' ἄμεινον ὦ τᾶν ἐσκοροδισμένος μάχῃ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:495.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:495.1.text#καὶ σπεῦδε ταχέως.
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 495.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 495.2.text#ταῦτα δρῶ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 495.3.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 495.3.text#μέμνησό νυν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:496.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:496.1.text#δάκνειν διαβάλλειν, τοὺς λόφους κατεσθίειν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:497.1.speaker#Δημοσθένης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:497.1.text#χὤπως τὰ κάλλαἰ ἀποφαγὼν ἥξεις πάλιν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:498.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:498.1.text#ἄλλ' ἴθι χαίρων, καὶ πράξειας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:499.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:499.1.text#κατὰ νοῦν τὸν ἐμόν, καί σε φυλάττοι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:500.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:500.1.text#Ζεὺς ἀγοραῖος· καὶ νικήσας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:501.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:501.1.text#αὖθις ἐκεῖθεν πάλιν ὡς ἡμᾶς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:502.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:502.1.text#ἔλθοις στεφάνοις κατάπαστος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:503.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:503.1.text#ὑμεῖς δ' ἡμῖν προσέχετε τὸν νοῦν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:504.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:504.1.text#τοῖς ἀναπαίστοις,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:505.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:505.1.text#ὦ παντοίας ἤδη Μούσης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:506.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:506.1.text#πειραθέντες καθ' ἑαυτούς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:507.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:507.1.text#εἰ μέν τις ἀνὴρ τῶν ἀρχαίων κωμῳδοδιδάσκαλος ἡμᾶς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:508.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:508.1.text#ἠνάγκαζεν λέξοντας ἔπη πρὸς τὸ θέατρον παραβῆναι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:509.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:509.1.text#οὐκ ἂν φαύλως ἔτυχεν τούτου· νῦν δ' ἄξιός ἐσθ' ὁ ποιητής,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:510.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:510.1.text#ὅτι τοὺς αὐτοὺς ἡμῖν μισεῖ τολμᾷ τε λέγειν τὰ δίκαια,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:511.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:511.1.text#καὶ γενναίως πρὸς τὸν τυφῶ χωρεῖ καὶ τὴν ἐριώλην.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:512.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:512.1.text#ἃ δὲ θαυμάζειν ὑμῶν φησιν πολλοὺς αὐτῷ προσιόντας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:513.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:513.1.text#καὶ βασανίζειν ὡς οὐχὶ πάλαι χορὸν αἰτοίη καθ' ἑαυτόν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:514.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:514.1.text#ἡμᾶς ὑμῖν ἐκέλευε φράσαι περὶ τούτου. φησὶ γὰρ ἁνὴρ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:515.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:515.1.text#οὐχ ὑπ' ἀνοίας τοῦτο πεπονθὼς διατρίβειν, ἀλλὰ νομίζων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:516.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:516.1.text#κωμῳδοδιδασκαλίαν εἶναι χαλεπώτατον ἔργον ἁπάντων·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:517.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:517.1.text#πολλῶν γὰρ δὴ πειρασάντων αὐτὴν ὀλίγοις χαρίσασθαι·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:518.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:518.1.text#ὑμᾶς τε πάλαι διαγιγνώσκων ἐπετείους τὴν φύσιν ὄντας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:519.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:519.1.text#καὶ τοὺς προτέρους τῶν ποιητῶν ἅμα τῷ γήρᾳ προδιδόντας·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:520.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:520.1.text#τοῦτο μὲν εἰδὼς ἅπαθε Μάγνης ἅμα ταῖς πολιαῖς κατιούσαις,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:521.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:521.1.text#ὃς πλεῖστα χορῶν τῶν ἀντιπάλων νίκης ἔστησε τροπαῖα·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:522.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:522.1.text#πάσας δ' ὑμῖν φωνὰς ἱεὶς καὶ ψάλλων καὶ πτερυγίζων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:523.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:523.1.text#καὶ λυδίζων καὶ ψηνίζων καὶ βαπτόμενος βατραχείοις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:524.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:524.1.text#οὐκ ἐξήρκεσεν, ἀλλὰ τελευτῶν ἐπὶ γήρως, οὐ γὰρ ἐφ' ἥβης,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:525.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:525.1.text#ἐξεβλήθη πρεσβύτης ὤν, ὅτι τοῦ σκώπτειν ἀπελείφθη·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:526.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:526.1.text#εἶτα Κρατίνου μεμνημένος, ὃς πολλῷ ῥεύσας ποτ' ἐπαίνῳ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:527.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:527.1.text#διὰ τῶν ἀφελῶν πεδίων ἔρρει, καὶ τῆς στάσεως παρασύρων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:528.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:528.1.text#ἐφόρει τὰς δρῦς καὶ τὰς πλατάνους καὶ τοὺς ἐχθροὺς προθελύμνους·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:529.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:529.1.text#ᾆσαι δ' οὐκ ἦν ἐν ξυμποσίῳ πλὴν "Δωροῖ συκοπέδιλε,"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:530.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:530.1.text#καὶ "τέκτονες εὐπαλάμων ὕμνων·" οὕτως ἤνθησεν ἐκεῖνος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:531.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:531.1.text#νυνὶ δ' ὑμεῖς αὐτὸν ὁρῶντες παραληροῦντ' οὐκ ἐλεεῖτε,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:532.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:532.1.text#ἐκπιπτουσῶν τῶν ἠλέκτρων καὶ τοῦ τόνου οὐκέτ' ἐνόντος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:533.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:533.1.text#τῶν θ' ἁρμονιῶν διαχασκουσῶν· ἀλλὰ γέρων ὢν περιέρρει,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:534.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:534.1.text#ὥσπερ Κοννᾶς, στέφανον μὲν ἔχων αὖον δίψῃ δ' ἀπολωλώς,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:535.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:535.1.text#ὃν χρῆν διὰ τὰς προτέρας νίκας πίνειν ἐν τῷ πρυτανείῳ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:536.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:536.1.text#καὶ μὴ ληρεῖν ἀλλὰ θεᾶσθαι λιπαρὸν παρὰ τῷ Διονύσῳ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:537.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:537.1.text#οἵας δὲ Κράτης ὀργὰς ὑμῶν ἠνέσχετο καὶ στυφελιγμούς,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:538.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:538.1.text#ὃς ἀπὸ σμικρᾶς δαπάνης ὑμᾶς ἀριστίζων ἀπέπεμπεν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:539.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:539.1.text#ἀπὸ κραμβοτάτου στόματος μάττων ἀστειοτάτας ἐπινοίας·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:540.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:540.1.text#χοὖτος μέντοι μόνος ἀντήρκει, τοτὲ μὲν πίπτων τοτὲ δ' οὐχί.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:541.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:541.1.text#ταῦτ' ὀρρωδῶν διέτριβεν ἀεί, καὶ πρὸς τούτοισιν ἔφασκεν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:542.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:542.1.text#ἐρέτην χρῆναι πρῶτα γενέσθαι πρὶν πηδαλίοις ἐπιχειρεῖν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:543.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:543.1.text#κᾆτ' ἐντεῦθεν πρῳρατεῦσαι καὶ τοὺς ἀνέμους διαθρῆσαι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:544.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:544.1.text#κᾆτα κυβερνᾶν αὐτὸν ἑαυτῷ. τούτων οὖν οὕνεκα πάντων,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:545.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:545.1.text#ὅτι σωφρονικῶς κοὐκ ἀνοήτως ἐσπηδήσας ἐφλυάρει,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:546.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:546.1.text#αἴρεσθ' αὐτῷ πολὺ τὸ ῥόθιον, παραπέμψατ' ἐφ' ἕνδεκα κώπαις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:547.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:547.1.text#θόρυβον χρηστὸν ληναΐτην,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:548.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:548.1.text#ἵν' ὁ ποιητὴς ἀπίῃ χαίρων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:549.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:549.1.text#κατὰ νοῦν πράξας,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:550.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:550.1.text#φαιδρὸς λάμποντι μετώπῳ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:551.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:551.1.text#ἵππι' ἄναξ Πόσειδον, ᾧ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:552.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:552.1.text#χαλκοκρότων ἵππων κτύπος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:553.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:553.1.text#καὶ χρεμετισμὸς ἁνδάνει
urn:cts:greekLit:tlg0019.tlg002.fu.sp:554.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:554.1.text#καὶ κυανέμβολοι θοαὶ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:555.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:555.1.text#μισθοφόροι τριήρεις,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:556.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:556.1.text#μειρακίων θ' ἅμιλλα λαμπρυνομένων ἐν ἅρμασιν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:557.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:557.1.text#καὶ βαρυδαιμονούντων,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:558.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:558.1.text#δεῦρ' ἔλθ' ἐς χορὸν ὦ χρυσοτρίαιν' ὦ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:560.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:560.1.text#δελφίνων μεδέων Σουνιάρατε,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:561.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:561.1.text#ὦ Γεραίστιε παῖ Κρόνου,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:562.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:562.1.text#Φαρμίωνί τε φίλτατ' ἐκ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:563.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:563.1.text#τῶν ἄλλων τε θεῶν Ἀθηναίοις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:564.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:564.1.text#πρὸς τὸ παρεστός.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:565.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:565.1.text#εὐλογῆσαι βουλόμεσθα τοὺς πατέρας ἡμῶν, ὅτι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:566.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:566.1.text#ἄνδρες ἦσαν τῆσδε τῆς γῆς ἄξιοι καὶ τοῦ πέπλου,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:567.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:567.1.text#οἵτινες πεζαῖς μάχαισιν ἔν τε ναυφάρκτῳ στρατῷ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:568.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:568.1.text#πανταχοῦ νικῶντες ἀεὶ τήνδ' ἐκόσμησαν πόλιν·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:569.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:569.1.text#οὐ γὰρ οὐδεὶς πώποτ' αὐτῶν τοῦς ἐναντίους ἰδὼν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:570.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:570.1.text#ἠρίθμησεν, ἀλλ' ὁ θυμὸς εὐθὺς ἦν Ἀμυνίας·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:571.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:571.1.text#εἰ δέ που πέσοιεν ἐς τὸν ὦμον ἐν μάχῃ τινί,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:572.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:572.1.text#τοῦτ' ἀπεψήσαντ' ἄν, εἶτ' ἠρνοῦντο μὴ πεπτωκέναι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:573.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:573.1.text#ἀλλὰ διεπάλαιον αὖθις. καὶ στρατηγὸς οὐδ' ἂν εἷς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:574.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:574.1.text#τῶν πρὸ τοῦ σίτησιν ᾔτησ' ἐρόμενος Κλεαίνετον·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:575.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:575.1.text#νῦν δ' ἐὰν μὴ προεδρίαν φέρωσι καὶ τὰ σιτία,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:576.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:576.1.text#οὐ μαχεῖσθαί φασιν. ἡμεῖς δ' ἀξιοῦμεν τῇ πόλει
urn:cts:greekLit:tlg0019.tlg002.fu.sp:577.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:577.1.text#προῖκα γενναίως ἀμύνειν καὶ θεοῖς ἐγχωρίοις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:578.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:578.1.text#καὶ πρὸς οὐκ αἰτοῦμεν οὐδὲν πλὴν τοσουτονὶ μόνον·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:579.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:579.1.text#ἤν ποτ' εἰρήνη γένηται καὶ πόνων παυσώμεθα,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:580.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:580.1.text#μὴ φθονεῖθ' ἡμῖν κομῶσι μηδ' ἀπεστλεγγισμένοις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:581.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:581.1.text#Ὦ πολιοῦχε Παλλάς, ὦ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:582.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:582.1.text#τῆς ἱερωτάτης ἁπασῶν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:583.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:583.1.text#πολέμῳ τε καὶ ποιηταῖς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:584.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:584.1.text#δυνάμει θ' ὑπερφερούσης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:585.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:585.1.text#μεδέουσα χώρας,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:586.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:586.1.text#δεῦρ' ἀφικοῦ λαβοῦσα τὴν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:587.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:587.1.text#ἐν στρατιαῖς τε καὶ μάχαις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:588.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:588.1.text#ἡμετέραν ξυνεργὸν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:589.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:589.1.text#Νίκην, ἣ χορικῶν ἐστιν ἑταίρα
urn:cts:greekLit:tlg0019.tlg002.fu.sp:590.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:590.1.text#τοῖς τ' ἐχθροῖσι μεθ' ἡμῶν στασιάζει.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:591.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:591.1.text#νῦν οὖν δεῦρο φάνηθι· δεῖ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:592.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:592.1.text#γὰρ τοῖς ἀνδράσι τοῖσδε πάσῃ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:593.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:593.1.text#τέχνῃ πορίσαι σε νίκην
urn:cts:greekLit:tlg0019.tlg002.fu.sp:594.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:594.1.text#εἴπερ ποτὲ καὶ νῦν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:595.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:595.1.text#ἃ ξύνισμεν τοῖσιν ἵπποις, βουλόμεσθ' ἐπαινέσαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:596.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:596.1.text#ἄξιοι δ' εἴσ' εὐλογεῖσθαι· πολλὰ γὰρ δὴ πάγματα
urn:cts:greekLit:tlg0019.tlg002.fu.sp:597.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:597.1.text#ξυνδιήνεγκαν μεθ' ἡμῶν, ἐσβολάς τε καὶ μάχας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:598.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:598.1.text#ἀλλὰ τἀν τῇ μὲν αὐτῶν οὐκ ἄγαν θαυμάζομεν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:599.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:599.1.text#ὡς ὅτ' ἐς τὰς ἱππαγωγοὺς εἰσεπήδων ἀνδρικῶς,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:600.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:600.1.text#πριάμενοι κώθωνας, οἱ δὲ καὶ σκόροδα καὶ κρόμμυα·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:601.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:601.1.text#εἶτα τὰς κώπας λαβόντες ὥσπερ ἡμεῖς οἱ βροτοὶ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:602.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:602.1.text#ἐμβαλόντες ἀνεβρύαξαν, "ἱππαπαῖ, τίς ἐμβαλεῖ;"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:603.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:603.1.text#"ληπτέον μᾶλλον. τί δρῶμεν; οὐκ ἐλᾷς ὦ σαμφόρα;"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:604.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:604.1.text#ἐξεπήδων τ' ἐς Κόρινθον· εἶτα δ' οἱ νεώτεροι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:605.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:605.1.text#ταῖς ὁπλαῖς ὤρυττον εὐνὰς καὶ μετῇσαν στρώματα·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:606.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:606.1.text#ἤσθιον δὲ τοὺς παγούρους ἀντὶ ποίας Μηδικῆς,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:607.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:607.1.text#εἴ τις ἐξέρποι θύραζε κἀκ βυθοῦ θηρώμενοι·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:608.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:608.1.text#ὥστ' ἔφη Θέωρος εἰπεῖν καρκίνον Κορίνθιον,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:609.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:609.1.text#"δεινά γ' ὦ Πόσειδον εἰ μήτ' ἐν βυθῷ δυνήσομαι"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:610.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:610.1.text#"μήτε γῇ μήτ' ἐν θαλάττῃ διαφυγεῖν τοὺς ἱππέας."
urn:cts:greekLit:tlg0019.tlg002.fu.sp:611.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:611.1.text#ὦ φίλτατ' ἀνδρῶν καὶ νεανικώτατε.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:612.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:612.1.text#ὅσην ἀπὼν παρέσχες ἡμῖν φροντίδα·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:613.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:613.1.text#καὶ νῦν ἐπειδὴ σῶς ἐλήλυθας πάλιν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:614.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:614.1.text#ἄγγειλον ἡμῖν πῶς τὸ πρᾶγμ' ἠγωνίσω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:615.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:615.1.text#τί δ' ἄλλο γ' εἰ μὴ Νικόβουλος ἐγενόμην;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:616.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:616.1.text#νῦν ἄρ' ἄξιόν γε πᾶσίν ἐστιν ἐπολολύξαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:617.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:617.1.text#ὦ καλὰ λέγων πολὺ δ' ἀμείνον' ἔτι τῶν λόγων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:618.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:618.1.text#ἐργασάμεν', εἴθ' ἐπέλθοις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:619.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:619.1.text#ἅπαντά μοι σαφῶς·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:620.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:620.1.text#ὡς ἐγώ μοι δοκῶ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:621.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:621.1.text#κἂν μακρὰν ὁδὸν διελθεῖν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:622.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:622.1.text#ὥστ' ἀκοῦσαι. πρὸς τάδ' ὦ βέλτιστε
urn:cts:greekLit:tlg0019.tlg002.fu.sp:623.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:623.1.text#θαρρήσας λέγ', ὡς, ἅπαντες
urn:cts:greekLit:tlg0019.tlg002.fu.sp:623a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:623a.text#ἡδόμεσθά σοι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:624.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:624.1.text#καὶ μὴν ἀκοῦσαί γ' ἄξιον τῶν πραγμάτων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:625.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:625.1.text#εὐθὺς γὰρ αὐτοῦ κατόπιν ἐνθένδ' ἱέμην·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:626.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:626.1.text#ὁ δ' ἄρ' ἔνδον ἐλασίβροντ' ἀναρρηγνὺς ἔπη
urn:cts:greekLit:tlg0019.tlg002.fu.sp:627.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:627.1.text#τερατευόμενος ἤρειδε κατὰ τῶν ἱππέων,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:628.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:628.1.text#κρημνοὺς †ἐρείδων† καὶ ξυνωμότας λέγων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:629.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:629.1.text#πιθανώταθ'· ἡ βουλὴ δ' ἅπασ' ἀκροωμένη
urn:cts:greekLit:tlg0019.tlg002.fu.sp:630.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:630.1.text#ἐγένεθ' ὑπ' αὐτοῦ ψευδατραφάξυος πλέα,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:631.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:631.1.text#κἄβλεψε νᾶπυ καὶ τὰ μέτωπ' ἀνέσπασεν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:632.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:632.1.text#κἄγωγ' ὅτε δὴ γ'νων ἐνδεχομένην τοὺς λόγους
urn:cts:greekLit:tlg0019.tlg002.fu.sp:633.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:633.1.text#καὶ τοῖς φενακισμοῖσιν ἐξαπατωμένην,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:634.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:634.1.text#"ἄγε δὴ Σκίταλοι καὶ Φένακες," ἦν δ' ἐγώ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:635.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:635.1.text#"Βερέσχεθοί τε καὶ Κόβαλοι καὶ Μόθων,"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:636.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:636.1.text#"ἀγορά τ' ἐν ᾗ παῖς ὢν ἐπαιδεύθην ἐγώ,"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:637.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:637.1.text#"νῦν μοι φράσος καὶ γλῶτταν εὔπορον δότε"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:638.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:638.1.text#"φωνήν τ' ἀναιδῆ." ταῦτα φροντίζοντί μοι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:639.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:639.1.text#ἐκ δεξιᾶς ἀπέπαρδε καταπύγων ἀνήρ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:640.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:640.1.text#κἀγὼ προσέκυσα· κᾆτα τῷ πρωκτῷ θενὼν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:641.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:641.1.text#τὴν κιγκλίδ' ἐξήραξα κἀναχανὼν μέγα
urn:cts:greekLit:tlg0019.tlg002.fu.sp:642.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:642.1.text#ἀνέκραγον· "ὦ βουλὴ λόγους ἀγαθοὺς φέρων"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:643.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:643.1.text#"εὐαγγελίσασθαι πρῶτον ὑμῖν βούλομαι·"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:644.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:644.1.text#"ἐξ οὗ γὰρ ἡμῖν ὁ πόλεμος κατερράγη,"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:645.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:645.1.text#"οὐπώποτ' ἀφύας εἶδον ἀξιωτέρας."
urn:cts:greekLit:tlg0019.tlg002.fu.sp:646.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:646.1.text#τῶν δ' εὐθέως τὰ πρόσωπα διεγαλήνισεν·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:647.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:647.1.text#εἶτ' ἐστεφάνουν μ' εὐαγγέλια· κἀγὼ φρασα
urn:cts:greekLit:tlg0019.tlg002.fu.sp:648.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:648.1.text#αὐτοῖς ἀπόρρητον ποιησάμενος ταχύ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:649.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:649.1.text#ἵνα τὰς ἀφύας ὠνοῖντο πολλὰς τοὐβολοῦ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:650.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:650.1.text#τῶν δημιουργῶν ξυλλαβεῖν τὰ τρύβλια.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:651.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:651.1.text#οἱ δ' ἀνεκρότησαν καὶ πρὸς ἔμ' ἐκεχήνεσαν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:652.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:652.1.text#ὁ δ' ὑπονοήσας ὁ Παφλαγών, εἰδὼς ἄρα
urn:cts:greekLit:tlg0019.tlg002.fu.sp:653.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:653.1.text#οἶς ἥδεθ' ἡ βουλὴ μάλιστα ῥήμασιν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:654.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:654.1.text#γνώμην ἔλεξεν· "ἄνδρες, ἤδη μοι δοκεῖ"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:655.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:655.1.text#"ἐπὶ συμφοραῖς ἀγαθαῖσιν εἰσηγγελμέναις"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:656.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:656.1.text#"εὐαγγέλια θύειν ἑκατὸν βοῦς τῇ θεῷ."
urn:cts:greekLit:tlg0019.tlg002.fu.sp:657.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:657.1.text#ἐπένευσεν εἰς ἐκεῖνον ἡ βουλὴ πάλιν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:658.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:658.1.text#κἄγωγ' ὅτε δὴ γ'νων τοῖς βολίτοις ἡττημένος,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:659.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:659.1.text#διακοσίαισι βουσὶν ὑπερηκόντισα,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:660.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:660.1.text#τῇ δ' Ἀγροτέρᾳ κατὰ χιλιῶν παρῄνεσα
urn:cts:greekLit:tlg0019.tlg002.fu.sp:661.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:661.1.text#εὐχὴν ποιήσασθαι χιμάρων εἰς αὔριον,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:662.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:662.1.text#αἱ τριχίδες εἰ γενοίαθ' ἑκατὸν τοὐβολοῦ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:663.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:663.1.text#ἐκαραδόκησεν εἰς ἔμ' ἡ βουλὴ πάλιν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:664.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:664.1.text#ὁ δὲ ταῦτ' ἀκούσας ἐκπλαγεὶς ἐφληνάφα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:665.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:665.1.text#κᾆθ' εἷλκον αὐτὸν οἱ πρυτάνεις χοἰ τοξόται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:666.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:666.1.text#οἱ δ' ἐθορύβουν περὶ τῶν ἀφύων ἑστηκότες·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:667.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:667.1.text#ὁ δ' ἠντεβόλει γ' αὐτοὺς ὀλίγον μεῖναι χρόνον,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:668.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:668.1.text#"ἵν' ἅτθ' ὁ κῆρυξ οὑκ Λακεδαίμονος λέγει"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:669.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:669.1.text#"πύθησθ', ἀφῖκται γὰρ περὶ σπονδῶν," λέγων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:670.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:670.1.text#οἱ δ' ἐξ ἑνὸς στόματος ἅπαντες ἀνέκραγον·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:671.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:671.1.text#"νυνὶ περὶ σπονδῶν; ἐπειδή γ' ὦ μέλε"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:672.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:672.1.text#"ᾔσθοντο τὰς ἀφύας παρ' ἡμῖν ἀξίας."
urn:cts:greekLit:tlg0019.tlg002.fu.sp:673.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:673.1.text#"οὐ δεόμεθα σπονδῶν· ὁ πόλεμος ἑρπέτω."
urn:cts:greekLit:tlg0019.tlg002.fu.sp:674.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:674.1.text#ἐκεκράγεσάν τε τοὺς πρυτάνεις ἀφιέναι·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:675.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:675.1.text#εἶθ' ὑπερεπήδων τοὺς δρυφάκτους πανταχῇ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:676.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:676.1.text#ἐγὼ δὲ τὰ κορίανν' ἐπριάμην ὑποδραμὼν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:677.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:677.1.text#ἅπαντα τά τε γήτεἰ ὅσ' ἦν ἐν τἀγορᾷ·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:678.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:678.1.text#ἔπειτα ταῖς ἀφύαις ἐδίδουν ἡδύσματα
urn:cts:greekLit:tlg0019.tlg002.fu.sp:679.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:679.1.text#ἀποροῦσιν αὐτοῖς προῖκα κἀχαριζόμην.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:680.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:680.1.text#οἱ δ' ὑπερεπῄνουν ὑπερεπύππαζόν τέ με
urn:cts:greekLit:tlg0019.tlg002.fu.sp:681.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:681.1.text#ἅπαντες οὕτως ὥστε τὴν βουλὴν ὅλην
urn:cts:greekLit:tlg0019.tlg002.fu.sp:682.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:682.1.text#ὀβολοῦ κοριάννοις ἀναλαβὼν ἐλήλυθα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:683.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:683.1.text#πάντα τοι πέπραγας οἷα χρὴ τὸν εὐτυχοῦντα·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:684.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:684.1.text#ηὗρε δ' ὁ πανοῦργος ἕτερον πολὺ πανουργίαις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:685.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:685.1.text#μείζοσι κεκασμένον
urn:cts:greekLit:tlg0019.tlg002.fu.sp:686.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:686.1.text#καὶ δόλοισι ποικίλοις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:687.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:687.1.text#ῥήμασίν θ' αἱμύλοις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:688.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:688.1.text#ἀλλ' ὅπως ἀγωνιεῖ φρόντιζε
urn:cts:greekLit:tlg0019.tlg002.fu.sp:689.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:689.1.text#τἀπίλοιπ' ἄριστα·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:690.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:690.1.text#συμμάχους δ' ἡμᾶς ἔχων εὔνους
urn:cts:greekLit:tlg0019.tlg002.fu.sp:690a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:690a.text#ἐπίστασαι πάλαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:691.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:691.1.text#καὶ μὴν ὁ Παφλαγὼν οὑτοσὶ προσέρχεται,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:692.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:692.1.text#ὠθῶν κολόκυμα καὶ ταράττων καὶ κυκῶν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:693.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:693.1.text#ὡς δὴ καταπιόμενός με. μορμὼ τοῦ θράσους.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:694.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:694.1.text#εἰ μή σ' ἀπολέσαιμ', εἴ τι τῶν αὐτῶν ἐμοὶ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:695.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:695.1.text#ψευδῶν ἐνείη, διαπέσοιμι πανταχῇ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:696.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:696.1.text#ἥσθην ἀπειλαῖς, ἐγέλασα ψολοκομπίαις,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:697.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:697.1.text#ἀπεπυδάρισα μόθωνα, περιεκόκκασα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:698.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:698.1.text#οὔτοι μὰ τὴν Δήμητρ', ἐὰν μή σ' ἐκφάγω
urn:cts:greekLit:tlg0019.tlg002.fu.sp:699.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:699.1.text#ἐκ τῆσδε τῆς γῆς, οὐδέποτε βιώσομαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:700.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:700.1.text#ἣν μὴ κ'φάγῃς; ἐγὼ δέ γ', ἢν μή σ' ἐκπίω
urn:cts:greekLit:tlg0019.tlg002.fu.sp:701.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:701.1.text#κἀπεκροφήσας αὐτὸς ἐπιδιαρραγῶ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:702.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:702.1.text#ἀπολῶ σε νὴ τὴν προεδρίαν τὴν ἐκ Πύλου.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:703.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:703.1.text#ἰδοὺ προεδρίαν· οἷον ὅψομαί σ' ἐγὼ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:704.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:704.1.text#ἐκ τῆς προεδρίας ἔσχατον θεώμενον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:705.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:705.1.text#ἐν τῷ ξύλῳ δήσω σε νὴ τὸν οὐρανόν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:706.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:706.1.text#ὡς ὀξύθυμος. φέρε τί σοι δῶ καταφαγεῖν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:707.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:707.1.text#ἐπὶ τῷ φάγοις ἥδιστ' ἄν; ἐπὶ βαλλαντίῳ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:708.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:708.1.text#ἐξαρπάσομαί σου τοῖς ὄνυξι τἄντερα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:709.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:709.1.text#ἀπονυχιῶ σου τἀν πρυτανείῳ σιτία.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:710.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:710.1.text#ἕλξω σε πρὸς τὸν δῆμον, ἵνα δῷς μοι δίκην.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:711.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:711.1.text#κἀγὼ δέ σ' ἕλξω καὶ διαβαλῶ πλείονα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:712.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:712.1.text#ἀλλ' ὦ πόνηρε σοὶ μὲν οὐδὲν πείθεται·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:713.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:713.1.text#ἐγὼ δ' ἐκείνου καταγελῶ γ' ὅσον θέλω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:714.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:714.1.text#ὡς σφόδρα σὺ τὸν δῆμον σεαυτοῦ νενόμικας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:715.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:715.1.text#ἐπίσταμαι γὰρ αὐτὸν οἷς ψωμίζεται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:716.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:716.1.text#κᾆθ' ὥσπερ αἱ τίτθαι γε σιτίζεις κακῶς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:717.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:717.1.text#μασώμενος γὰρ τῷ μὲν ὀλίγον ἐντίθης,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:718.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:718.1.text#αὐτὸς δ' ἐκείνου τριπλάσιον κατέσπακας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:719.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:719.1.text#καὶ νὴ Δί' ὑπό γε δεξιότητος τῆς ἐμῆς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:720.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:720.1.text#δύναμαι ποιεῖν τὸν δῆμον εὐρὺν καὶ στενόν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:721.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:721.1.text#χὠ πρωκτὸς οὑμὸς τουτογὶ σοφίζεται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:722.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:722.1.text#οὐκ ὦγάθ' ἐν βουλῇ με δόξεις καθυβρίσαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:723.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:723.1.text#ἴωμεν ἐς τὸν δῆμον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:723.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:723.2.text#οὐδὲν κωλύει·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:724.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:724.1.text#ἰδοὺ βάδιζε, μηδὲν ἡμᾶς ἰσχέτω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:725.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:725.1.text#ὦ Δῆμε δεῦρ' ἔξελθε.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:725.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:725.2.text#νὴ Δί' ὦ πάτερ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:726.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:726.1.text#ἔξελθε δῆτ'.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:726.2.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:726.2.text#ὦ Δημίδιον ὦ φίλτατον
urn:cts:greekLit:tlg0019.tlg002.fu.sp:727.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:727.1.text#ἔξελθ', ἵν' εἰδῇς οἷα περιυβρίζομαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:728.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:728.1.text#τίνες οἱ βοῶντες; οὐκ ἄπιτ' ἀπὸ τῆς θύρας;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:729.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:729.1.text#τὴν εἰρεσιώνην μου κατεσπαράξατε.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:730.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:730.1.text#τίς ὦ Παφλαγὼν ἀδικεῖ σε;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:730.2.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:730.2.text#διὰ σὲ τύπτομαι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:731.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:731.1.text#ὑπὸ τουτουὶ καὶ τῶν νεανίσκων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:731.2.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:731.2.text#τιή;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:732.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:732.1.text#ὁτιὴ φιλῶ σ' ὦ Δῆμ' ἐραστής τ' εἰμὶ σός.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:733.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:733.1.text#σὺ δ' εἶ τίς ἐτεόν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:733.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:733.2.text#ἀντεραστὴς τουτουί,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:734.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:734.1.text#ἐρῶν πάλαι σου βουλόμενός τέ σ' εὖ ποιεῖν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:735.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:735.1.text#ἄλλοι τε πολλοὶ καὶ καλοί τε κἀγαθοί.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:736.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:736.1.text#ἀλλ' οὐχ οἷοί τ' ἐσμὲν διὰ τουτονί. σὺ γὰρ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:737.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:737.1.text#ὅμοιος εἶ τοῖς παισὶ τοῖς ἐρωμένοις·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:738.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:738.1.text#τοὺς μὲν καλούς τε κἀγαθοὺς οὐ προσδέχει,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:739.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:739.1.text#σαυτὸν δὲ λυχνοπώλαισι καὶ νευρορράφοις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:740.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:740.1.text#καὶ σκυτοτόμοις καὶ βυρσοπώλαισιν δίδως.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:741.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:741.1.text#εὖ γὰρ ποιῶ τὸν δῆμον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:741.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:741.2.text#εἰπέ νυν τί δρῶν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:742.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:742.1.text#ὅ τι; †τῶν στρατηγῶν ὑποδραμὼν τῶν ἐκ Πύλου, †
urn:cts:greekLit:tlg0019.tlg002.fu.sp:743.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:743.1.text#πλεύσας ἐκεῖσε, τοὺς Λάκωνας ἤγαγον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:744.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:744.1.text#ἐγὼ δὲ περιπατῶν γ' ἀπ' ἐργαστηρίου
urn:cts:greekLit:tlg0019.tlg002.fu.sp:745.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:745.1.text#ἕψοντος ἑτερου τὴν χύτραν ὑφειλόμην.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:746.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:746.1.text#καὶ μὴν ποιήσας αὐτίκα μάλ' ἐκκλησίαν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:747.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:747.1.text#ὦ Δῆμ' ἵν' εἰδῇς ὁπότερος νῷν ἐστί σοι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:748.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:748.1.text#εὐνούστερος, διάκρινον, ἵνα τοῦτον φιλῇς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:749.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:749.1.text#ναὶ ναὶ διάκρινον δῆτα, πλὴν μὴ 'ν τῇ πυκνί.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:750.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:750.1.text#οὐκ ἂν καθιζοίμην ἐν ἄλλῳ χωρίῳ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:751.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:751.1.text#ἀλλ' ἐς τὸ πρόσθε. χρὴ παρεῖν' ἐς τὴν πύκνα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:752.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:752.1.text#οἴμοι κακοδαίμων ὡς ἀπόλωλ'. ὁ γὰρ γέρων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:753.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:753.1.text#οἴκοι μὲν ἀνδρῶν ἐστι δεξιώτατος,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:754.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:754.1.text#ὅταν δ' ἐπὶ ταυτησὶ καθῆται τῆς πέτρας,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:755.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:755.1.text#κέχηνεν ὥσπερ ἐμποδίζων ἰσχάδας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:756.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:756.1.text#νῦν δή σε πάντα δεῖ κάλων ἐξιέναι σεαυτοῦ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:757.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:757.1.text#καὶ λῆμα θούριον φορεῖν καὶ λόγους ἀφύκτους
urn:cts:greekLit:tlg0019.tlg002.fu.sp:758.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:758.1.text#ὅτοισι τόνδ' ὑπερβαλεῖ. ποικίλος γὰρ ἁνὴρ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:759.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:759.1.text#κἀκ τῶν ἀμηχάνων πόρους εὐμήχανος πορίζειν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:760.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:760.1.text#πρὸς ταῦθ' ὅπως ἔξει πολὺς καὶ λαμπρὸς ἐς τὸν ἄνδρα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:761.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:761.1.text#ἀλλὰ φυλάττου καὶ πρὶν ἐκεῖνον προσκεῖσθαί σοι πρότερος σὺ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:762.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:762.1.text#τοὺς δελφῖνας μετεωρίζου καὶ τὴν ἄκατον παραβάλλου.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:763.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:763.1.text#τῇ μὲν δεσποίνῃ Ἀθηναίᾳ τῇ τῆς πόλεως μεδεούσῃ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:764.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:764.1.text#εὔχομαι, εἰ μὲν περὶ τὸν δῆμον τὸν Ἀθηναίων γεγένημαι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:765.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:765.1.text#βέλτιστος ἀνὴρ μετὰ Λυσικλέα καὶ Κύνναν καὶ Σαλαβακχώ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:766.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:766.1.text#ὥσπερ νυνὶ μηδὲν δράσας δειπνεῖν ἐν πρυτανείῳ·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:767.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:767.1.text#εἰ δέ σε μισῶ καὶ μὴ περὶ σοῦ μάχομαι μόνος ἀντιβεβηκώς,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:768.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:768.1.text#ἀπολοίμην καὶ διαπρισθείην κατατμηθείην τε λέπαδνα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:769.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:769.1.text#κἄγωγ' ὦ Δῆμ', εἰ μή σε φιλῶ καὶ μὴ στέργω, κατατμηθεὶς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:770.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:770.1.text#ἑψοίμην ἐν περικομματίοις· κεἰ μὴ τούτοισι πέποιθας,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:771.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:771.1.text#ἐπὶ ταυτησὶ κατακνησθείην ἐν μυττωτῷ μετὰ τυροῦ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:772.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:772.1.text#καὶ τῇ κρεάγρᾳ τῶν ὀρχιπέδων ἑλκοίμην ἐς Κεραμεικόν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:773.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:773.1.text#καὶ πῶς ἂν ἐμοῦ μᾶλλόν σε φιλῶν ὦ Δῆμε γένοιτο πολίτης;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:774.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:774.1.text#ὃς πρῶτα μὲν ἡνίκ' ἐβούλευον σοὶ χρήματα πλεῖστ' ἀπέδειξα
urn:cts:greekLit:tlg0019.tlg002.fu.sp:775.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:775.1.text#ἐν τῷ κοινῷ, τοὺς μὲν στρεβλῶν τοὺς δ' ἄγχων τοὺς δὲ μεταιτῶν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:776.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:776.1.text#οὐ φροντίζων τῶν ἰδιωτῶν οὐδενός, εἰ σοὶ χαριοίμην.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:777.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:777.1.text#τοῦτο μὲν ὦ Δῆμ' οὐδὲν σεμνόν· κἀγὼ γὰρ τοῦτό σε δράσω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:778.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:778.1.text#ἁρπάζων γὰρ τοὺς ἄρτους σοι τοὺς ἀλλοτρίους παραθήσω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:779.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:779.1.text#ὡς δ' οὐχὶ φιλεῖ σ' οὐδ' ἔστ' εὔνους, τοῦτ' αὐτό σε πρῶτα διδάξω,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:780.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:780.1.text#ἀλλ' ἢ διὰ τοῦτ' αὔθ' ὁτιή σου τῆς ἀνθρακιᾶς ἀπολαύει.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:781.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:781.1.text#σὲ γάρ, ὃς Μήδοισι διεξιφίσω περὶ τῆς χώρας Μαραθῶνι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:782.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:782.1.text#καὶ νικήσας ἡμῖν μεγάλως ἐγγλωττοτυπεῖν παρέδωκας,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:783.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:783.1.text#ἐπὶ ταῖσι πέτραις οὐ φροντίζει σκληρῶς σε καθήμενον οὕτως,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:784.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:784.1.text#οὐχ ὥσπερ ἐγὼ ῥαψάμενός σοι τουτὶ φέρω. ἀλλ' ἐπαναίρου,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:785.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:785.1.text#κᾆτα καθίζου μαλακῶς, ἵνα μὴ τρίβῃς τὴν ἐν Σαλαμῖνι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:786.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:786.1.text#ἄνθρωπε τίς εἶ; μῶν ἔκγονος εἶ τῶν Ἁρμοδίου τις ἐκείνων;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:787.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:787.1.text#τοῦτό γέ τοί σου τοὔργον ἀληθῶς γενναῖον καὶ φιλόδημον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:788.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:788.1.text#ὡς ἀπὸ μικρῶν εὔνους αὐτῷ θωπευματίων γεγένησαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:789.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:789.1.text#καὶ σὺ γὰρ αὐτὸν πολὺ μικροτέροις τούτων δελεάσμασιν εἷλες.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:790.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:790.1.text#καὶ μὴν εἴ πού τις ἀνὴρ ἐφάνη τῷ δήμῳ μᾶλλον ἀμύνων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:791.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:791.1.text#ἢ μᾶλλον ἐμοῦ σε φιλῶν, ἐθέλω περὶ τῆς κεφαλῆς περιδόσθαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:792.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:792.1.text#καὶ πῶς σὺ φιλεῖς, ὃς τοῦτον ὁρῶν οἰκοῦντ' ἐν ταῖς φιδάκναισι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:793.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:793.1.text#καὶ γυπαρίοις καὶ πυργιδίοις ἔτος ὄγδοον οὐκ ἐλεαίρεις,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:794.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:794.1.text#ἀλλὰ καθείρξας αὐτὸν βλίττεις; Ἀρχεπτολέμου δὲ φέροντος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:795.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:795.1.text#τὴν εἰρήνην ἐξεσκέδασας, τὰς πρεσβείας τ' ἀπελαύνεις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:796.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:796.1.text#ἐκ τῆς πόλεως ῥαθαπυγίζων, αἳ τὰς σπονδὰς προκαλοῦνται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:797.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:797.1.text#ἵνα γ' Ἑλλήνων ἄρξῃ πάντων. ἔστι γὰρ ἐν τοῖς λογίοισιν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:798.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:798.1.text#ὡς τοῦτον δεῖ ποτ' ἐν Ἀρκαδίᾳ πεντώβολον ἡλιάσασθαι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:799.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:799.1.text#ἢν ἀναμείνῃ· πάντως δ' αὐτὸν θρέψω γ'ὼ καὶ θεραπεύσω,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:800.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:800.1.text#ἐξευρίσκων εὖ καὶ μιαρῶς ὁπόθεν τὸ τριώβολον ἕξει.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:801.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:801.1.text#οὐχ ἵνα γ' ἄρξῃ μὰ Δί' Ἀρκαδίας προνοούμενος, ἀλλ' ἵνα μᾶλλον
urn:cts:greekLit:tlg0019.tlg002.fu.sp:802.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:802.1.text#σὺ μὲν ἁρπάζῃς καὶ δωροδοκῇς παρὰ τῶν πόλεων, ὁ δὲ δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:803.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:803.1.text#ὑπὸ τοῦ πολέμου καὶ τῆς ὁμίχλης ἃ πανουργεῖς μὴ καθορᾷ σου,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:804.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:804.1.text#ἀλλ' ὑπ' ἀνάγκης ἅμα καὶ χρείας καὶ μισθοῦ πρός σε κεχήνῃ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:805.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:805.1.text#ἢν δέ ποτ' εἰς ἀγρὸν οὗτος ἀπελθὼν εἰρηναῖος διατρίψῃ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:806.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:806.1.text#καὶ χῖδρα φαγὼν ἀναθαρρήσῃ καὶ στεμφύλῳ ἐς λόγον ἔλθῃ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:807.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:807.1.text#γνώσεται οἵων ἀγαθῶν αὐτὸν τῇ μισθοφορᾷ παρεκόπτου·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:808.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:808.1.text#εἶθ' ἥξει σοι δριμὺς ἄγροικος κατὰ σοῦ τὴν ψῆφον ἰχνεύων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:809.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:809.1.text#ἃ σὺ γιγνώσκων τόνδ' ἐξαπατᾷς καὶ ὀνειροπολεῖς περὶ σαυτοῦ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:810.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:810.1.text#οὔκουν δεινὸν ταυτί σε λέγειν δῆτ' ἔστ' ἐμὲ καὶ διαβάλλειν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:811.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:811.1.text#πρὸς Ἀθηναίους καὶ τὸν δῆμον, πεποιηκότα πλείονα χρηστὰ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:812.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:812.1.text#νὴ τὴν Δήμητρα Θεμιστοκλέους πολλῷ περὶ τὴν πόλιν ἤδη;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:813.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:813.1.text#ὦ πόλις Ἄργους κλύεθ' οἷα λέγει. σὺ Θεμιστοκλεῖ ἀντιφερίζεις;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:814.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:814.1.text#ὃς ἐποίησεν τὴν πόλιν ἡμῶν μεστὴν εὑρὼν ἐπιχειλῆ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:815.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:815.1.text#καὶ πρὸς τούτοις ἀριστώσῃ τὸν Πειραιᾶ προσέμαξεν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:816.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:816.1.text#ἀφελών τ' οὐδὲν τῶν ἀρχαίων ἰχθῦς καινοὺς παρέθηκεν·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:817.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:817.1.text#σὺ δ' Ἀθηναίους ἐζήτησας μικροπολίτας ἀποφῆναι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:818.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:818.1.text#διατειχίζων καὶ χρησμῳδῶν, ὁ Θεμιστοκλεῖ ἀντιφερίζων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:819.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:819.1.text#κἀκεῖνος μὲν φεύγει τὴν γῆν σὺ δ' Ἀχιλλείων ἀπομάττει.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:820.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:820.1.text#οὔκουν ταυτὶ δεινὸν ἀκούειν ὦ Δῆμ' ἐστίν μ' ὑπὸ τούτου,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:821.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:821.1.text#ὁτιή σε φιλῶ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:821.2.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:821.2.text#παὖ ὦ οὗτος, καὶ μὴ σκέρβολλε πονηρά.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:822.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:822.1.text#πολλοῦ δὲ πολύν με χρόνον καὶ νῦν ἐλελήθης ἐγκρυφιάζων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:823.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:823.1.text#μιαρώτατος, ὦ Δημακίδιον, καὶ πλεῖστα πανοῦργα δεδρακώς,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:824.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:824.1.text#ὁπόταν χασμᾷ, καὶ τοὺς καυλοὺς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:825.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:825.1.text#τῶν εὐθυνῶν ἐκκαυλίζων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:826.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:826.1.text#καταβροχθίζει, κἀμφοῖν χειροῖν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:827.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:827.1.text#μυστιλᾶται τῶν δημοσίων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:828.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:828.1.text#οὐ χαιρήσεις, ἀλλά σε κλέπτονθ'
urn:cts:greekLit:tlg0019.tlg002.fu.sp:829.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:829.1.text#αἱρήσω γ'ὼ τρεῖς μυριάδας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:830.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:830.1.text#τί θαλαττοκοπεῖς καὶ πλατυγίζεις,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:831.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:831.1.text#μιαρώτατος ὢν περὶ τὸν δῆμον
urn:cts:greekLit:tlg0019.tlg002.fu.sp:832.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:832.1.text#τὸν Ἀθηναίων; καί σ' ἐπιδείξω
urn:cts:greekLit:tlg0019.tlg002.fu.sp:833.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:833.1.text#νὴ τὴν Δήμητρ', ἢ μὴ ζῴην,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:834.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:834.1.text#δωροδοκήσαντ' ἐκ Μυτιλήνης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:835.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:835.1.text#πλεῖν ἢ μνᾶς τετταράκοντα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:836.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:836.1.text#ὦ πᾶσιν ἀνθρώποις φανεὶς μέγιστον ὠφέλημα,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:837.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:837.1.text#ζηλῶ σε τῆς εὐγλωττίας. εἰ γὰρ ὧδ' ἐποίσεις,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:838.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:838.1.text#μέγιστος Ἑλλήνων ἔσει, καὶ μόνος καθέξεις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:839.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:839.1.text#τἀν τῇ πόλει τῶν ξυμμάχων τ' ἄρξεις ἔχων τρίαιναν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:840.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:840.1.text#ᾗ πολλὰ χρήματ' ἐργάσει σείων τε καὶ ταράττων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:841.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:841.1.text#καὶ μὴ μεθῇς τὸν ἄνδρ', ἐπειδή σοι λαβὴν δέδωκεν·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:842.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:842.1.text#κατεργάσει γὰρ ῥᾳδίως πλευρὰς ἔχων τοιαύτας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:843.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:843.1.text#οὐκ ὦγαθοὶ ταῦτ' ἐστί πω ταύτῃ μὰ τὸν Ποσειδῶ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:844.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:844.1.text#ἐμοὶ γάρ ἐστ' εἰργασμένον τοιοῦτον ἔργον ὥστε
urn:cts:greekLit:tlg0019.tlg002.fu.sp:845.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:845.1.text#ἁπαξάπαντας τοὺς ἐμοὺς ἐχθροὺς ἐπιστομίζειν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:846.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:846.1.text#ἕως ἂν ᾖ τῶν ἀσπίδων τῶν ἐκ Πύλου τι λοιπόν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:847.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:847.1.text#ἐπίσχες ἐν ταῖς ἀσπίσιν· λαβὴν γὰρ ἐνδέδωκας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:848.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:848.1.text#οὐ γάρ σ' ἐχρῆν, εἴπερ φιλεῖς τὸν δῆμον, ἐκ προνοίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:849.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:849.1.text#ταύτας ἐᾶν αὐτοῖσι τοῖς πόρπαξιν ἀνατεθῆναι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:850.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:850.1.text#ἀλλ' ἐστὶ τοῦτ' ὦ Δῆμε μηχάνημ', ἵν' ἢν σὺ βούλῃ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:851.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:851.1.text#τὸν ἄνδρα κολάσαι τουτονί, σοὶ τοῦτο μὴ κ'γένηται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:852.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:852.1.text#ὁρᾷς γὰρ αὐτῷ στῖφος οἷόν ἐστι βυρσοπωλῶν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:853.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:853.1.text#νεανιῶν· τούτους δὲ περιοικοῦσι μελιτοπῶλαι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:854.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:854.1.text#καὶ τυροπῶλαι· τοῦτο δ' εἰς ἕν ἐστι συγκεκυφός,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:855.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:855.1.text#ὥστ' εἰ σὺ βριμήσαιο καὶ βλέψειας ὀστρακίνδα,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:856.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:856.1.text#νύκτωρ καθαρπάσαντες ἂν τὰς ἀσπίδας θέοντες
urn:cts:greekLit:tlg0019.tlg002.fu.sp:857.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:857.1.text#τὰς ἐσβολὰς τῶν ἀλφίτων ἂν καταλάβοιεν ἡμῶν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:858.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:858.1.text#οἴμοι τάλας· ἔχουσι γὰρ πόρπακας; ὦ πόνηρε
urn:cts:greekLit:tlg0019.tlg002.fu.sp:859.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:859.1.text#ὅσον με παρεκόπτου χρόνον τοιαῦτα κρουσιδημῶν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:860.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:860.1.text#ὦ δαιμόνιε μὴ τοῦ λέγοντος ἴσθι, μηδ' οἰηθῇς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:861.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:861.1.text#ἐμοῦ ποθ' εὑρήσειν φίλον βελτίον'· ὅστις εἷς ὢν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:862.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:862.1.text#ἔπαυσα τοὺς ξυνωμότας, καί μ' οὐ λέληθεν οὐδὲν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:863.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:863.1.text#ἐν τῇ πόλει ξυνιστάμενον, ἀλλ' εὐθέως κέκραγα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:864.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:864.1.text#ὅπερ γὰρ οἱ τὰς ἐγχέλεις θηρώμενοι πέπονθας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:865.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:865.1.text#ὅταν μὲν ἡ λίμνη καταστῇ, λαμβάνουσιν οὐδέν·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:866.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:866.1.text#ἐὰν δ' ἄνω τε καὶ κάτω τὸν βόρβορον κυκῶσιν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:867.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:867.1.text#αἱροῦσι· καὶ σὺ λαμβάνεις, ἢν τὴν πόλιν ταράττῃς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:868.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:868.1.text#ἓν δ' εἰπέ μοι τοσουτονί· σκύτη τοσαῦτα πωλῶν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:869.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:869.1.text#ἔδωκας ἤδη τουτῳὶ κάττυμα παρὰ σεαυτοῦ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:870.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:870.1.text#ταῖς ἐμβάσιν φάσκων φιλεῖν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:870.2.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:870.2.text#οὐ δῆτα μὰ τὸν Ἀπόλλω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:872.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:872.1.text#ἔγνωκας οὖν δῆτ' αὐτὸν οἷός ἐστιν; ἀλλ' ἐγώ σοι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:873.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:873.1.text#ζεῦγος πριάμενος ἐμβάδων τουτὶ φορεῖν δίδωμι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:874.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:874.1.text#κρίνω σ' ὅσων ἐγᾦδα περὶ τὸν δῆμον ἄνδρ' ἄριστον
urn:cts:greekLit:tlg0019.tlg002.fu.sp:875.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:875.1.text#εὐνούστατόν τε τῇ πόλει καὶ τοῖσι δακτύλοισιν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:875.2.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:875.2.text#οὐ δεινὸν οὖν δῆτ' ἐμβάδας τοσουτονὶ δύνασθαι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:876.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:876.1.text#ἐμοῦ δὲ μὴ μνείαν ἔχειν ὅσων πέπονθας; ὅστις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:877.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:877.1.text#ἔπαυσα τοὺς βινουμένους, τὸν Γρύττον ἐξαλείψας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:878.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:878.1.text#οὔκουν σε δῆτα ταῦτα δεινόν ἐστι πρωκτοτηρεῖν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:879.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:879.1.text#παῦσαί τε τοὺς βινουμένους; κοὐκ ἔσθ' ὅπως ἐκείνους
urn:cts:greekLit:tlg0019.tlg002.fu.sp:880.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:880.1.text#οὐχὶ φθονῶν ἔπαυσας, ἵνα μὴ ῥήτορες γένωνται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:881.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:881.1.text#τονδὶ δ' ὁρῶν ἄνευ χιτῶνος ὄντα τηλικοῦτον
urn:cts:greekLit:tlg0019.tlg002.fu.sp:882.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:882.1.text#οὐπώποτ' ἀμφιμασχάλου τὸν Δῆμον ἠξίωσας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:883.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:883.1.text#χειμῶνος ὄντος· ἀλλ' ἐγώ σοι τουτονὶ δίδωμι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:884.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:884.1.text#τοιουτονὶ Θεμιστοκλῆς οὐπώποτ' ἐπενόησεν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:885.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:885.1.text#καίτοι σοφὸν κἀκεῖν' ὁ Πειραιεύς· ἔμοιγε μέντοι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:886.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:886.1.text#οὐ μεῖζον εἶναι φαίνετ' ἐξεύρημα τοῦ χιτῶνος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:887.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:887.1.text#οἴμοι τάλας οἵοις πιθηκισμοῖς με περιελαύνεις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:888.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:888.1.text#οὔκ, ἀλλ' ὅπερ πίνων ἀνὴρ πέπονθ' ὅταν χεσείῃ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:889.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:889.1.text#τοῖσιν τρόποις τοῖς σοῖσιν ὥσπερ βλαυτίοισι χρῶμαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:890.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:890.1.text#ἀλλ' οὐχ ὑπερβαλεῖ με θωπείαις· ἐγὼ γὰρ αὐτὸν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:891.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:891.1.text#προσαμφιῶ τοδί· σὺ δ' οἴμωζ' ὦ πόνηρ'.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:891.2.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:891.2.text#ἰαιβοῖ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:892.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:892.1.text#οὐκ ἐς κόρακας ἀποφθερεῖ βύρσης κάκιστον ὄζων;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:893.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:893.1.text#καὶ τοῦτό γ' ἐπίτηδές σε περιήμπεσχ', ἵνα σ' ἀποπνίξῃ·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:894.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:894.1.text#καὶ πρότερον ἐπεβούλευσέ σοι. τὸν καυλὸν οἶσθ' ἐκεῖνον
urn:cts:greekLit:tlg0019.tlg002.fu.sp:895.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:895.1.text#τοῦ σιλφίου τὸν ἄξιον γενόμενον;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:895.2.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:895.2.text#οἶδα μέντοι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:896.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:896.1.text#ἐπίτηδες οὗτος αὐτὸν ἔσπευδ' ἄξιον γενέσθαι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:897.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:897.1.text#ἵν' ἐσθίοιτ' ὠνούμενοι, κἄπειτ' ἐν ἡλιαίᾳ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:898.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:898.1.text#βδέοντες ἀλλήλους ἀποκτείνειαν οἱ δικασταί.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:899.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:899.1.text#νὴ τὸν Ποσειδῶ καὶ πρὸς ἐμὲ τοῦτ' εἶπ' ἀνὴρ Κόπρειος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:900.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:900.1.text#οὐ γὰρ τόθ' ὑμεῖς βδεόμενοι δήπου 'γένεσθε πυρροί;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:901.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:901.1.text#καὶ νὴ Δί' ἦν γε τοῦτο Πυρράνδρου τὸ μηχάνημα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:902.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:902.1.text#οἵοισί μ' ὦ πανοῦργε βωμολοχεύμασιν ταράττεις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:903.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:903.1.text#ἡ γὰρ θεός μ' ἐκέλευσε νικῆσαί σ' ἀλαζονείαις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:904.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:904.1.text#ἀλλ' οὐχὶ νικήσεις. ἐγὼ γάρ φημί σοι παρέξειν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:905.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:905.1.text#ὦ Δῆμε μηδὲν δρῶντι μισθοῦ τρύβλιον ῥοφῆσαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:906.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:906.1.text#ἐγὼ δὲ κυλίχνιόν γέ σοι καὶ φάρμακον δίδωμι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:907.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:907.1.text#τἀν τοῖσιν ἀντικνημίοις ἑλκύδρια περιαλείφειν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:908.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:908.1.text#ἐγὼ δὲ τὰς πολιάς γέ σοὐκλέγων νέον ποιήσω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:909.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:909.1.text#ἰδοὺ δέχου κέρκον λαγῶ τὠφθαλμιδίω περιψῆν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:910.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:910.1.text#ἀπομυξάμενος ὦ Δῆμέ μου πρὸς τὴν κεφαλὴν ἀποψῶ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:911.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:911.1.text#ἐμοῦ μὲν οὖν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:911.2.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:911.2.text#ἐμοῦ μὲν οὖν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:912.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:912.1.text#ἐγώ σε ποιήσω τριηραρχεῖν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:913.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:913.1.text# ἀναλίσκοντα τῶν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:914.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:914.1.text#σαυτοῦ, παλαιὰν ναῦν ἔχοντ',
urn:cts:greekLit:tlg0019.tlg002.fu.sp:915.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:915.1.text#εἰς ἣν ἀναλῶν οὐκ ἐφέξεις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:916.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:916.1.text#οὐδὲ ναυπηγούμενος·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:917.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:917.1.text#διαμηχανήσομαί θ' ὅπως
urn:cts:greekLit:tlg0019.tlg002.fu.sp:918.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:918.1.text#ἂν ἱστίον σαπρὸν λάβῃς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:919.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:919.1.text#ἁνὴρ παφλάζει, παῦε παῦ',
urn:cts:greekLit:tlg0019.tlg002.fu.sp:920.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:920.1.text#ὑπερζέων· ὑφελκτέον
urn:cts:greekLit:tlg0019.tlg002.fu.sp:921.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:921.1.text#τῶν δᾳδίων ἀπαρυστέον
urn:cts:greekLit:tlg0019.tlg002.fu.sp:922.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:922.1.text#τε τῶν ἀπειλῶν ταυτῃί.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:923.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:923.1.text#δώσεις ἐμοὶ καλὴν δίκην
urn:cts:greekLit:tlg0019.tlg002.fu.sp:924.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:924.1.text#ἰπούμενος ταῖς ἐσφοραῖς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:925.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:925.1.text#ἐγὼ γὰρ ἐς τοὺς πλουσίους
urn:cts:greekLit:tlg0019.tlg002.fu.sp:926.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:926.1.text#σπεύσω σ' ὅπως ἂν ἐγγραφῇς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:927.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:927.1.text#ἐγὼ δ' ἀπειλήσω μὲν οὐδέν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:928.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:928.1.text#εὔχομαι δέ σοι ταδί·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:929.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:929.1.text#τὸ μὲν τάγηνον τευθίδων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:930.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:930.1.text#ἐφεστάναι σίζον· σὲ δὲ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:931.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:931.1.text#γνώμην ἐρεῖν μέλλοντα περὶ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:932.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:932.1.text#Μιλησίων καὶ κερδανεῖν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:933.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:933.1.text#τάλαντον, ἢν κατεργάσῃ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:934.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:934.1.text#σπεύδειν ὅπως τῶν τευθίδων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:935.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:935.1.text#ἐμπλήμενος φθαίης ἔτ' εἰς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:936.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:936.1.text#ἐκκλησίαν ἐλθών· ἔπειτα
urn:cts:greekLit:tlg0019.tlg002.fu.sp:937.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:937.1.text#πρὶν φαγεῖν ἀνὴρ μεθήκοι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:938.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:938.1.text#καὶ σὺ τὸ τάλαντον λαβεῖν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:939.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:939.1.text#βουλόμενος ἐσθίων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:940.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:940.1.text#ἐναποπνιγείης.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:941.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:941.1.text#εὖ γε νὴ τὸν Δία καὶ τὸν Ἀπόλλω καὶ τὴν Δήμητρα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:942.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:942.1.text#κἀμοὶ δοκεῖ· καὶ τἄλλα γ' εἶναι καταφανῶς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:943.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:943.1.text#ἀγαθὸς πολίτης, οἶος οὐδείς πω χρόνου 
urn:cts:greekLit:tlg0019.tlg002.fu.sp:945.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:945.1.text#ἀνὴρ γεγένηται τοῖσι πολλοῖς τοὐβολοῦ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:946.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:946.1.text#σὺ δ' ὦ Παφλαγὼν φάσκων φιλεῖν μ' ἐσκορόδισας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:947.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:947.1.text#καὶ νῦν ἀπόδος τὸν δακτύλιον, ὡς οὐκέτι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:948.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:948.1.text#ἐμοὶ ταμιεύσεις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:948.2.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:948.2.text#ἔχε· τοσοῦτον δ' ἴσθ' ὅτι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:949.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:949.1.text#εἰ μή μ' ἐάσεις ἐπιτροπεύειν, ἕτερος αὖ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:950.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:950.1.text#ἐμοῦ πανουργότερός τις ἀναφανήσεται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:951.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:951.1.text#οὐκ ἔσθ' ὅπως ὁ δακτύλιός ἐσθ' οὑτοσὶ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:952.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:952.1.text#οὑμός· τὸ γοῦν σημεῖον ἕτερον φαίνεται,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:953.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:953.1.text#ἀλλ' ἢ οὐ καθορῶ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:953.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:953.2.text#φέρ' ἴδω τί σοι σημεῖον ἦν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:954.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:954.1.text#δημοῦ βοείου θρῖον ἐξωπτημένον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:955.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:955.1.text#οὐ τοῦτ' ἔνεστιν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:955.2.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:955.2.text#οὐ τὸ θρῖον; ἀλλὰ τί;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:956.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:956.1.text#λάρος κεχηνὼς ἐπὶ πέτρας δημηγορῶν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:957.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:957.1.text#αἰβοῖ τάλας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 957.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 957.2.text#τί ἔστιν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 957.3.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 957.3.text#ἀπόφερ' ἐκποδών.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:958.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:958.1.text#οὐ τὸν ἐμὸν εἶχεν ἀλλὰ τὸν Κλεωνύμου.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:959.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:959.1.text#παρ' ἐμοῦ δὲ τουτονὶ λαβὼν ταμίευέ μοι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:960.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:960.1.text#μὴ δῆτά πώ γ' ὦ δέσποτ', ἀντιβολῶ σ' ἐγώ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:961.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:961.1.text#πρὶν ἄν γε τῶν χρησμῶν ἀκούσῃς τῶν ἐμῶν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:962.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:962.1.text#καὶ τῶν ἐμῶν νυν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:962.2.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:962.2.text#ἀλλ' ἐὰν τούτῳ πίθῃ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:963.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:963.1.text#μολγὸν γενέσθαι δεῖ σε.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:963.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:963.2.text#κἄν γε τουτῳί,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:964.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:964.1.text#ψωλὸν γενέσθαι δεῖ σε μέχρι τοῦ μυρρίνου.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:965.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:965.1.text#ἀλλ' οἵ γ' ἐμοὶ λέγουσιν ὡς ἄρξαι σε δεῖ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:966.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:966.1.text#χώρας ἁπάσης ἐστεφανωμένον ῥόδοις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:967.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:967.1.text#οὑμοὶ δέ γ' αὖ λέγουσιν ὡς ἁλουργίδα
urn:cts:greekLit:tlg0019.tlg002.fu.sp:968.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:968.1.text#ἔχων κατάπαστον καὶ στεφάνην ἐφ' ἅρματος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:969.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:969.1.text#χρυσοῦ διώξει Σμικύθην καὶ κύριον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:970.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:970.1.text#καὶ μὴν ἔνεγκ' αὐτοὺς ἰών, ἵν' οὑτοσὶ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:971.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:971.1.text#αὐτῶν ἀκούσῃ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:971.2.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:971.2.text#πάνυ γε. καὶ σύ νυν φέρε.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:972.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:972.1.text#ἰδού.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:972.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:972.2.text#ἰδοὺ νὴ τὸν Δί'· οὐδὲν κωλύει.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:973.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:973.1.text#ἥδιστον φάος ἡμέρας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:974.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:974.1.text#ἔσται τοῖσι παροῦσι καὶ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:975.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:975.1.text#τοῖσι δεῦρ' ἀφικνουμένοις,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:976.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:976.1.text#ἢν Κλέων ἀπόληται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:977.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:977.1.text#καίτοι πρεσβυτέρων τινῶν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:978.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:978.1.text#οἵων ἀργαλεωτάτων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:979.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:979.1.text#ἐν τῷ δείγματι τῶν δικῶν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:980.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:980.1.text#ἤκουσ' ἀντιλεγόντων,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:981.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:981.1.text#ὡς εἰ μὴ 'γένεθ' οὗτος ἐν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:982.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:982.1.text#τῇ πόλει μέγας, οὐκ ἂν ἤστην
urn:cts:greekLit:tlg0019.tlg002.fu.sp:983.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:983.1.text#σκεύη δύο χρησίμω,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:984.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:984.1.text#δοῖδυξ οὐδὲ τορύνη.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:985.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:985.1.text#ἀλλὰ καὶ τόδ' ἔγωγε θαυμάζω
urn:cts:greekLit:tlg0019.tlg002.fu.sp:986.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:986.1.text#τῆς ὑομουσίας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:987.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:987.1.text#αὐτοῦ· φασὶ γὰρ αὐτὸν οἱ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:988.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:988.1.text#παῖδες οἳ ξυνεφοίτων,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:989.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:989.1.text#τὴν Δωριστὶ μόνην ἂν ἁρμόττεσθαι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:990.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:990.1.text#θαμὰ τὴν λύραν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:991.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:991.1.text#ἄλλην δ' οὐκ ἐθέλειν μαθεῖν·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:992.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:992.1.text#κᾆτα τὸν κιθαριστὴν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:993.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:993.1.text#ὀργισθέντ' ἀπάγειν κελεύειν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:994.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:994.1.text#ὡς ἁρμονίαν ὁ παῖς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:995.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:995.1.text#οὗτος οὐ δύναται μαθεῖν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:996.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:996.1.text#ἢν μὴ Δωροδοκιστί.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:997.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:997.1.text#ἰδοὺ θέασαι, κοὐχ ἅπαντας ἐκφέρω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:998.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:998.1.text#οἴμ' ὡς χεσείω, κοὐχ ἅπαντας ἐκφέρω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:999.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:999.1.text#ταυτὶ τί ἔστι;
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 999.2.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 999.2.text#λόγια.
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 999.3.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 999.3.text#πάντ';
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 999.4.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 999.4.text#ἐθαύμασας;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1000.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1000.1.text#καὶ νὴ Δί' ἔτι γέ μοὔστι κιβωτὸς πλέα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1001.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1001.1.text#ἐμοὶ δ' ὑπερῷον καὶ ξυνοικία δύο.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1002.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1002.1.text#φέρ' ἴδω, τίνος γάρ εἰσιν οἱ χρησμοί ποτε;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1003.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1003.1.text#οὑμοὶ μέν εἰσι Βάκιδος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1003.2.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1003.2.text#οἱ δὲ σοὶ τίνος;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1004.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1004.1.text#Γλάνιδος, ἀδελφοῦ τοῦ Βάκιδος γεραιτέρου.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1005.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1005.1.text#εἰσὶν δὲ περὶ τοῦ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1005.2.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1005.2.text#περὶ Ἀθηνῶν, περὶ Πύλου,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1006.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1006.1.text#περὶ σοῦ, περὶ ἐμοῦ, περὶ ἁπάντων πραγμάτων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1007.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1007.1.text#οἱ σοὶ δὲ περὶ τοῦ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1007.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1007.2.text#περὶ Ἀθηνῶν, περὶ φακῆς,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1008.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1008.1.text#περὶ Λακεδαιμονίων, περὶ σκόμβρων νέων,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1009.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1009.1.text#περὶ τῶν μετρούντων τἄλφιτ' ἐν ἀγορᾷ κακῶς,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1010.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1010.1.text#περὶ σοῦ, περὶ ἐμοῦ, περὶ ἁπάντων πραγμάτων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1011.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1011.1.text#ἄγε νυν ὅπως αὐτοὺς ἀναγνώσεσθέ μοι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1012.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1012.1.text#καὶ τὸν περὶ ἐμοῦ 'κεῖνον ᾧπερ ἥδομαι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1013.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1013.1.text#ὡς ἐν νεφέλαισιν αἰετὸς γενήσομαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1014.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1014.1.text#ἄκουε δή νυν καὶ πρόσεχε τὸν νοῦν ἐμοί.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1015.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1015.1.text#φράζευ Ἐρεχθεΐδη λογίων ὁδόν, ἥν σοι Ἀπόλλων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1016.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1016.1.text#ἴαχεν ἐξ ἀδύτοιο διὰ τριπόδων ἐριτίμων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1017.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1017.1.text#σῴζεσθαί σ' ἐκέλευσ' ἱερὸν κύνα καρχαρόδοντα,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1018.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1018.1.text#ὃς πρὸ σέθεν λάσκων καὶ ὑπὲρ σοῦ δεινὰ κεκραγὼς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1019.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1019.1.text#σοὶ μισθὸν ποριεῖ, κἂν μὴ δρᾷ ταῦτ' ἀπολεῖται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1020.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1020.1.text#πολλοὶ γὰρ μίσει σφε κατακρώζουσι κολοιοί.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1021.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1021.1.text#ταυτὶ μὰ τὴν Δήμητρ' ἐγὼ οὐκ οἶδ' ὅ τι λέγει.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1022.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1022.1.text#τί γάρ ἐστ' Ἐρεχθεῖ καὶ κολοιοῖς καὶ κυνί;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1023.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1023.1.text#ἐγὼ μέν εἰμ' ὁ κύων· πρὸ σοῦ γὰρ ἀπύω·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1024.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1024.1.text#σοὶ δ' εἶπε σῴζεσθαί μ' ὁ Φοῖβος τὸν κύνα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1025.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1025.1.text#οὐ τοῦτό φησ' ὁ χρησμός, ἀλλ' ὁ κύων ὁδὶ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1026.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1026.1.text#ὥσπερ θύρας σοῦ τῶν λογίων παρεσθίει.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1027.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1027.1.text#ἐμοὶ γάρ ἐστ' ὀρθῶς περὶ τούτου τοῦ κυνός.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1028.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1028.1.text#λέγε νυν· ἐγὼ δὲ πρῶτα λήψομαι λίθον,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1029.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1029.1.text#ἵνα μή μ' ὁ χρησμὸς τὸ πέος οὑτοσὶ δάκῃ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1030.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1030.1.text#φράζευ Ἐρεχθεΐδη κύνα Κέρβερον ἀνδραποδιστήν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1031.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1031.1.text#ὃς κέρκῴ σαίνων σ' ὁπόταν δειπνῇς ἐπιτηρῶν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1032.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1032.1.text#ἐξέδεταί σου τοὔψον, ὅταν σύ ποι ἄλλοσε χάσκῃς·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1033.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1033.1.text#ἐσφοιτῶν τ' ἐς τοὐπτάνιον λήσει σε κυνηδὸν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1034.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1034.1.text#νύκτωρ τὰς λοπάδας καὶ τὰς νήσους διαλείχων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1035.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1035.1.text#νὴ τὸν Ποσειδῶ πολύ γ' ἄμεινον ὦ Γλάνι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1036.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1036.1.text#ὦ τᾶν ἄκουσον, εἶτα διάκρινον τόδε.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1037.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1037.1.text#ἔστι γυνή, τέξει δὲ λέονθ' ἱεραῖς ἐν Ἀθήναις,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1038.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1038.1.text#ὃς περὶ τοῦ δήμου πολλοῖς κώνωψι μαχεῖται
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1039.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1039.1.text#ὥστε περὶ σκύμνοισι βεβηκώς· τὸν σὺ φυλάξαι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1040.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1040.1.text#τεῖχος ποιήσας ξύλινον πύργους τε σιδηροῦς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1041.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1041.1.text#ταῦτ' οἶσθ' ὅ τι λέγει;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1041.2.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1041.2.text#μὰ τὸν Ἀπόλλω 'γὼ μὲν οὔ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1042.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1042.1.text#ἔφραζεν ὁ θεός σοι σαφῶς σῴζειν ἐμέ·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1043.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1043.1.text#ἐγὼ γὰρ ἀντὶ τοῦ λέοντός εἰμί σοι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1044.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1044.1.text#καὶ πῶς μ' ἐλελήθης Ἀντιλέων γεγενημένος;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1045.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1045.1.text#ἓν οὐκ ἀναδιδάσκει σε τῶν λογίων ἑκών,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1046.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1046.1.text#ὃ μόνον σιδηροῦν ἐστι τεῖχος καὶ ξύλον,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1047.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1047.1.text#ἐν ᾧ σε σῴζειν τόνδ' ἐκέλευσ' ὁ Λοξίας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1048.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1048.1.text#πῶς δῆτα τοῦτ' ἔφραζεν ὁ θεός;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1048.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1048.2.text#τουτονὶ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1049.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1049.1.text#δῆσαί σ' ἐκέλευ' ἐν πεντεσυρίγγῳ ξύλῳ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1050.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1050.1.text#ταυτὶ τελεῖσθαι τὰ λόγι' ἤδη μοι δοκεῖ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1051.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1051.1.text#μὴ πείθου· φθονεραὶ γὰρ ἐπικρώζουσι κορῶναι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1052.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1052.1.text#ἀλλ' ἱέρακα φίλει μεμνημένος ἐν φρεσὶν ὅς σοι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1053.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1053.1.text#ἤγαγε συνδήσας Λακεδαιμονίων κορακίνους.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1054.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1054.1.text#τοῦτό γέ τοι Παφλαγὼν παρεκινδύνευσε μεθυσθείς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1055.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1055.1.text#Κεκροπίδη κακόβουλε τί τοῦθ' ἡγεῖ μέγα τοὔργον;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1056.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1056.1.text#καί κε γυνὴ φέροι ἄχθος, ἐπεί κεν ἀνὴρ ἀναθείη·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1057.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1057.1.text#ἀλλ' οὐκ ἂν μαχέσαιτο· χέσαιτο γάρ, εἰ μαχέσαιτο.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1058.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1058.1.text#ἀλλὰ τόδε φράσσαι, πρὸ Πύλου Πύλον ἥν σοι ἔφραζεν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1059.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1059.1.text#ἔστι Πύλος πρὸ Πύλοιο—
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1059.2.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1059.2.text#τί τοῦτο λέγει, πρὸ Πύλοιο;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1060.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1060.1.text#τὰς πυέλους φησὶν καταλήψεσθ' ἐν βαλανείῳ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1061.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1061.1.text#ἐγὼ δ' ἄλουτος τήμερον γενήσομαι;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1062.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1062.1.text#οὗτος γὰρ ἡμῶν τὰς πυέλους ἀφήρπασεν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1063.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1063.1.text#ἀλλ' οὑτοσὶ γάρ ἐστι περὶ τοῦ ναυτικοῦ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1064.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1064.1.text#ὁ χρησμός, ᾧ σε δεῖ προσέχειν τὸν νοῦν πάνυ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1065.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1065.1.text#προσέχω· σὺ δ' ἀναγίγνωσκε, τοῖς ναύταισί μου
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1066.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1066.1.text#ὅπως ὁ μισθὸς πρῶτον ἀποδοθήσεται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1067.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1067.1.text#Αἰγεΐδη φράσσαι κυναλώπεκα, μή σε δολώσῃ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1068.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1068.1.text#λαίθαργον ταχύπουν, δολίαν κερδὼ πολύιδριν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1069.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1069.1.text#οἶσθ' ὅ τι ἐστὶν τοῦτο;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1069.2.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1069.2.text#Φιλόστρατος ἡ κυναλώπηξ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1070.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1070.1.text#οὐ τοῦτό φησιν, ἀλλὰ ναῦς ἑκάστοτε
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1071.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1071.1.text#αἰτεῖ ταχείας ἀργυρολόγους οὑτοσί·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1072.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1072.1.text#ταύτας ἀπαυδᾷ μὴ διδόναι σ' ὁ Λοξίας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1073.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1073.1.text#πῶς δὴ τριήρης ἐστὶ κυναλώπηξ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1073.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1073.2.text#ὅπως;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1074.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1074.1.text#ὅτι ἡ τριήρης ἐστὶ χὠ κύων ταχύ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1075.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1075.1.text#πῶς οὖν ἀλώπηξ προσετέθη πρὸς τῷ κυνί;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1076.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1076.1.text#ἀλωπεκίοισι τοὺς στρατιώτας ᾔκασεν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1077.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1077.1.text#ὁτιὴ βότρυς τρώγουσιν ἐν τοῖς χωρίοις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1078.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1078.1.text#εἶεν·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1078a.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1078a.text#τούτοις ὁ μισθὸς τοῖς ἀλωπεκίοισι ποῦ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1079.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1079.1.text#ἐγὼ ποριῶ, καὶ τοῦτον ἡμερῶν τριῶν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1080.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1080.1.text#ἀλλ' ἔτι τόνδ' ἐπάκουσον, ὃν εἶπέ σοι ἐξαλέασθαι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1081.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1081.1.text#χρησμὸν Λητοΐδης, Κυλλήνην, μή σε δολώσῃ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1082.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1082.1.text#ποίαν Κυλλήνην;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1082.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1082.2.text#τὴν τούτου χεῖρ' ἐποίησεν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1083.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1083.1.text#Κυλλήνην ὀρθῶς, ὁτιή φησ', "ἔμβαλε κυλλῇ."
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1084.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1084.1.text#οὐκ ὀρθῶς φράζει· τὴν Κυλλήνην γὰρ ὁ Φοῖβος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1085.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1085.1.text#ἐς τὴν χεῖρ' ὀρθῶς ᾐνίξατο τὴν Διοπείθους.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1086.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1086.1.text#ἀλλὰ γάρ ἐστιν ἐμοὶ χρησμὸς περὶ σοῦ πτερυγωτός,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1087.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1087.1.text#αἰετὸς ὡς γίγνει καὶ πάσης γῆς βασιλεύεις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1088.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1088.1.text#καὶ γὰρ ἐμοί· καὶ γῆς καὶ τῆς ἐρυθρᾶς γε θαλάσσης,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1089.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1089.1.text#χὤτι γ' ἐν Ἐκβατάνοις δικάσεις, λείχων ἐπίπαστα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1090.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1090.1.text#ἀλλ' ἐγὼ εἶδον ὄναρ, καί μοὐδόκει ἡ θεὸς αὐτὴ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1091.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1091.1.text#τοῦ δήμου καταχεῖν ἀρυταίνῃ πλουθυγίειαν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1092.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1092.1.text#νὴ Δία καὶ γὰρ ἐγώ· καί μοὐδόκει ἡ θεὸς αὐτὴ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1093.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1093.1.text#ἐκ πόλεως ἐλθεῖν καὶ γλαῦξ αὐτῇ 'πικαθῆσθαι·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1094.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1094.1.text#εἶτα κατασπένδειν κατὰ τῆς κεφαλῆς ἀρυβάλλῳ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1095.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1095.1.text#ἀμβροσίαν κατὰ σοῦ, κατὰ τούτου δὲ σκοροδάλμην.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1096.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1096.1.text#ἰοὺ ἰού.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1097.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1097.1.text#οὐκ ἦν ἄρ' οὐδεὶς τοῦ Γλάνιδος σοφώτερος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1098.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1098.1.text#καὶ νῦν ἐμαυτὸν ἐπιτρέπω σοι τουτονὶ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1099.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1099.1.text#γερονταγωγεῖν κἀναπαιδεύειν πάλιν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1100.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1100.1.text#μήπω γ', ἱκετεύω σ', ἀλλ' ἀνάμεινον, ὡς ἐγὼ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1101.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1101.1.text#κριθὰς ποριῶ σοι καὶ βίον καθ' ἡμέραν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1102.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1102.1.text#οὐκ ἀνέχομαι κριθῶν ἀκούων· πολλάκις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1103.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1103.1.text#ἐξηπατήθην ὑπό τε σοῦ καὶ Θουφάνους.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1104.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1104.1.text#ἀλλ' ἄλφιτ' ἤδη σοι ποριῶ 'σκευασμένα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1105.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1105.1.text#ἐγὼ δὲ μαζίσκας γε διαμεμαγμένας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1106.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1106.1.text#καὶ τοὔψον ὀπτόν· μηδὲν ἄλλ' εἰ μὴ 'σθιε.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1107.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1107.1.text#ἀνύσατέ νυν ὅ τι περ ποιήσεθ'· ὡς ἐγώ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1108.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1108.1.text#ὁπότερος ἂν σφῷν νῦν με μᾶλλον εὖ ποιῇ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1109.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1109.1.text#τούτῳ παραδώσω τῆς πυκνὸς τὰς ἡνίας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1110.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1110.1.text#τρέχοιμ' ἂν εἴσω πρότερος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1110.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1110.2.text#οὐ δῆτ' ἀλλ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1111.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1111.1.text#ὦ Δῆμε καλήν γ' ἔχεις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1112.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1112.1.text#ἀρχήν, ὅτε πάντες ἄνθρωποι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1113.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1113.1.text#δεδίασί σ' ὥσπερ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1114.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1114.1.text#ἄνδρα τύραννον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1115.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1115.1.text#ἀλλ' εὐπαράγωγος εἶ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1116.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1116.1.text#θωπευόμενός τε χαίρεις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1117.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1117.1.text#κἀξαπατώμενος,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1118.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1118.1.text#πρὸς τόν τε λέγοντ' ἀεὶ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1119.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1119.1.text#κέχηνας· ὁ νοῦς δέ σου
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1120.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1120.1.text#παρὼν ἀποδημεῖ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1121.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1121.1.text#νοῦς οὐκ ἔνι ταῖς κόμαις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1122.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1122.1.text#ὑμῶν, ὅτε μ' οὐ φρονεῖν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1123.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1123.1.text#νομίζετ'· ἐγὼ δ' ἑκὼν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1124.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1124.1.text#ταῦτ' ἠλιθιάζω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1125.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1125.1.text#αὐτός τε γὰρ ἥδομαι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1126.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1126.1.text#βρύλλων τὸ καθ' ἡμέραν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1127.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1127.1.text#κλέπτοντά τε βούλομαι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1128.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1128.1.text#τρέφειν ἕνα προστάτην·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1129.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1129.1.text#τοῦτον δ', ὅταν ᾖ πλέως,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1130.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1130.1.text#ἄρας ἐπάταξα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1131.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1131.1.text#χοὔτω μὲν ἂν εὖ ποιοῖς,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1132.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1132.1.text#εἴ σοι πυκνότης ἔνεστ'
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1133.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1133.1.text#ἐν τῷ τρόπῳ, ὡς λέγεις,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1134.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1134.1.text#τούτῳ πάνυ πολλή,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1135.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1135.1.text#εἰ τούσδ' ἐπίτηδες ὥσπερ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1136.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1136.1.text#δημοσίους τρέφεις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1137.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1137.1.text#ἐν τῇ πυκνί, κᾆθ' ὅταν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1138.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1138.1.text#μή σοι τύχῃ ὄψον ὄν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1139.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1139.1.text#τούτων ὃς ἂν ᾖ παχύς,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1140.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1140.1.text#θύσας ἐπιδειπνεῖς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1141.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1141.1.text#σκέψασθε δέ μ', εἰ σοφῶς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1142.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1142.1.text#αὐτοὺς περιέρχομαι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1143.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1143.1.text#τοὺς οἰομένους φρονεῖν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1144.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1144.1.text#κἄμ' ἐξαπατύλλειν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1145.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1145.1.text#τηρῶ γὰρ ἑκάστοτ' αὐτοὺς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1146.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1146.1.text#οὐδὲ δοκῶν ὁρᾶν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1147.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1147.1.text#κλέπτοντας· ἔπειτ' ἀναγκάζω
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1148.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1148.1.text#πάλιν ἐξεμεῖν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1149.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1149.1.text#ἅττ' ἂν κεκλόφωσί μου,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1150.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1150.1.text#κημὸν καταμηλῶν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1151.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1151.1.text#ἄπαγ' ἐς μακαρίαν ἐκποδών.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1151.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1151.2.text#σύ γ' ὦ φθόρε.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1152.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1152.1.text#ὦ Δῆμ' ἐγὼ μέντοι παρεσκευασμένος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1153.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1153.1.text#τρίπαλαι κάθημαι βουλόμενός σ' εὐεργετεῖν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1154.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1154.1.text#ἐγὼ δὲ δεκάπαλαί γε καὶ δωδεκάπαλαι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1155.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1155.1.text#καὶ χιλιόπαλαι καὶ προπαλαιπαλαίπαλαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1156.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1156.1.text#ἐγὼ δὲ προσδοκῶν γε τρισμυριόπαλαι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1157.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1157.1.text#βδελύττομαί σφω καὶ προπαλαιπαλαίπαλαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1158.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1158.1.text#οἶσθ' οὖν ὃ δρᾶσον;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1158.2.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1158.2.text#εἰ δὲ μή, φράσεις γε σύ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1159.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1159.1.text#ἄφες ἀπὸ βαλβίδων ἐμέ τε καὶ τουτονί,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1160.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1160.1.text#ἵνα σ' εὖ ποιῶμεν ἐξ ἴσου.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1160.2.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1160.2.text#δρᾶν ταῦτα χρή.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1161.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1161.1.text#ἄπιτον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 1161.2.speaker#Κλέων καὶ Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 1161.2.text#ἰδού.
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 1161.3.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 1161.3.text#θέοιτ' ἄν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 1161.4.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp: 1161.4.text#ὑποθεῖν οὐκ ἐῶ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1162.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1162.1.text#ἀλλ' ἢ μεγάλως εὐδαιμονήσω τήμερον
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1163.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1163.1.text#ὑπὸ τῶν ἐραστῶν νὴ Δί' ἢ 'γὼ θρύψομαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1164.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1164.1.text#ὁρᾷς; ἐγώ σοι πρότερος ἐκφέρω δίφρον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1165.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1165.1.text#ἀλλ' οὐ τράπεζαν, ἀλλ' ἐγὼ προτεραίτερος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1166.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1166.1.text#ἰδοὺ φέρω σοι τήνδε μαζίσκην ἐγὼ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1167.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1167.1.text#ἐκ τῶν ὀλῶν τῶν ἐκ Πύλου μεμαγμένην.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1168.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1168.1.text#ἐγὼ δὲ μυστίλας μεμυστιλημένας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1169.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1169.1.text#ὑπὸ τῆς θεοῦ τῇ χειρὶ τἠλεφαντίνῃ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1170.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1170.1.text#ὡς μέγαν ἄρ' εἶχες ὦ πότνια τὸν δάκτυλον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1171.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1171.1.text#ἐγὼ δ' ἔτνος γε πίσινον εὔχρων καὶ καλόν·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1172.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1172.1.text#ἐτόρυνε δ' αὔθ' ἡ Παλλὰς ἡ Πυλαιμάχος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1173.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1173.1.text#ὦ Δῆμ' ἐναργῶς ἡ θεός σ' ἐπισκοπεῖ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1174.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1174.1.text#καὶ νῦν ὑπερέχει σου χύτραν ζωμοῦ πλέαν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1175.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1175.1.text#οἴει γὰρ οἰκεῖσθ' ἂν ἔτι τήνδε τὴν πόλιν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1176.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1176.1.text#εἰ μὴ φανερῶς ἡμῶν ὑπερεῖχε τὴν χύτραν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1177.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1177.1.text#τουτὶ τέμαχός σοὔδωκεν ἡ Φοβεσιστράτη.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1178.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1178.1.text#ἡ δ' Ὀβριμοπάτρα γ' ἑφθὸν ἐκ ζωμοῦ κρέας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1179.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1179.1.text#καὶ χόλικος ἠνύστρου τε καὶ γαστρὸς τόμον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1180.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1180.1.text#καλῶς γ' ἐποίησε τοῦ πέπλου μεμνημένη.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1181.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1181.1.text#ἡ Γοργολόφα σ' ἐκέλευε τουτουὶ φαγεῖν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1182.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1182.1.text#ἐλατῆρος, ἵνα τὰς ναῦς ἐλαύνωμεν καλῶς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1183.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1183.1.text#λαβὲ καὶ ταδί νυν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1183.2.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1183.2.text#καὶ τί τούτοις χρήσομαι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1184.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1184.1.text#τοῖς ἐντέροις;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1184.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1184.2.text#ἐπίτηδες αὔτ' ἔπεμψέ σοι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1185.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1185.1.text#ἐς τὰς τριήρεις ἐντερόνειαν ἡ θεός·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1186.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1186.1.text#ἐπισκοπεῖ γὰρ περιφανῶς τὸ ναυτικόν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1187.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1187.1.text#ἔχε καὶ πιεῖν κεκραμένον τρία καὶ δύο.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1188.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1188.1.text#ὡς ἡδὺς ὦ Ζεῦ καὶ τὰ τρία φέρων καλῶς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1189.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1189.1.text#ἡ Τριτογενὴς γὰρ αὐτὸν ἐνετριτώνισεν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1190.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1190.1.text#λαβέ νυν πλακοῦντος πίονος παρ' ἐμοῦ τόμον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1191.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1191.1.text#παρ' ἐμοῦ δ' ὅλον γε τὸν πλακοῦντα τουτονί.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1192.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1192.1.text#ἀλλ' οὐ λαγῷ' ἕξεις ὁπόθεν δῷς, ἀλλ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1193.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1193.1.text#οἴμοι, πόθεν λαγῷά μοι γενήσεται;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1194.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1194.1.text#ὦ θυμὲ νυνὶ βωμολόχον ἔξευρέ τι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1195.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1195.1.text#ὁρᾷς τάδ' ὦ κακόδαιμον;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1195.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1195.2.text#ὀλίγον μοι μέλει·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1196.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1196.1.text#ἐκεινοιὶ γὰρ ὡς ἔμ' ἔρχονταί τινες
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1197.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1197.1.text#πρέσβεις ἔχοντες ἀργυρίου βαλλάντια.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1198.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1198.1.text#ποῦ ποῦ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1198.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1198.2.text#τί δέ σοι τοῦτ'; οὐκ ἐάσεις τοὺς ξένους;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1199.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1199.1.text#ὦ Δημίδιον ὁρᾷς τὰ λαγῷ' ἅ σοι φέρω;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1200.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1200.1.text#οἴμοι τάλας ἀδίκως γε τἄμ' ὑφήρπασας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1201.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1201.1.text#νὴ τὸν Ποσειδῶ καὶ σὺ γὰρ τοὺς ἐκ Πύλου.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1202.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1202.1.text#εἴπ', ἀντιβολῶ, πῶς ἐπενόησας ἁρπάσαι;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1203.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1203.1.text#τὸ μὲν νόημα τῆς θεοῦ, τὸ δὲ κλέμμ' ἐμόν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1204.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1204.1.text#ἐγὼ δ' ἐκινδύνευσ', ἐγὼ δ' ὤπτησά γε.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1205.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1205.1.text#ἄπιθ'· οὐ γὰρ ἀλλὰ τοῦ παραθέντος ἡ χάρις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1206.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1206.1.text#οἴμοι κακοδαίμων, ὑπεραναιδευθήσομαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1207.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1207.1.text#τί οὐ διακρίνεις Δῆμ' ὁπότερός ἐστι νῷν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1208.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1208.1.text#ἀνὴρ ἀμείνων περὶ σὲ καὶ τὴν γαστέρα;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1209.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1209.1.text#τῷ δῆτ' ἂν ὑμᾶς χρησάμενος τεκμηρίῳ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1210.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1210.1.text#δόξαιμι κρίνειν τοῖς θεαταῖσιν σοφῶς;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1211.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1211.1.text#ἐγὼ φράσω σοι. τὴν ἐμὴν κίστην ἰὼν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1212.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1212.1.text#ξύλλαβε σιωπῇ καὶ βασάνισον ἅττ' ἔνι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1213.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1213.1.text#καὶ τὴν Παφλαγόνος· κἀμέλει κρινεῖς καλῶς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1214.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1214.1.text#φέρ' ἴδω τί οὖν ἔνεστιν;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1214.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1214.2.text#οὐχ ὁρᾷς κενὴν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1215.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1215.1.text#ὦ παππίδιον; ἅπαντα γάρ σοι παρεφόρουν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1216.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1216.1.text#αὕτη μὲν ἡ κίστη τὰ τοῦ Δήμου φρονεῖ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1217.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1217.1.text#βάδιζέ νυν καὶ δεῦρο πρὸς τὴν Παφλαγόνος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1218.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1218.1.text#ὁρᾷς τάδ';
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1218.2.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1218.2.text#οἴμοι τῶν ἀγαθῶν ὅσων πλέα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1219.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1219.1.text#ὅσον τὸ χρῆμα τοῦ πλακοῦντος ἀπέθετο·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1220.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1220.1.text#ἐμοὶ δ' ἔδωκεν ἀποτεμὼν τυννουτονί.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1221.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1221.1.text#τοιαῦτα μέντοι καὶ πρότερόν σ' ἠργάζετο·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1222.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1222.1.text#σοὶ μὲν προσεδίδου μικρὸν ὧν ἐλάμβανεν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1223.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1223.1.text#αὐτὸς δ' ἑαυτῷ παρετίθει τὰ μείζονα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1224.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1224.1.text#ὦ μιαρὲ κλέπτων δή με ταῦτ' ἐξηπάτας;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1225.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1225.1.text#ἐγὼ δέ τυ ἐστεφάνιξα κἀδωρησάμαν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1226.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1226.1.text#ἐγὼ δ' ἔκλεπτον ἐπ' ἀγαθῷ γε τῇ πόλει.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1227.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1227.1.text#κατάθου ταχέως τὸν στέφανον, ἵν' ἐγὼ τουτῳὶ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1228.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1228.1.text#αὐτὸν περιθῶ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1228.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1228.2.text#κατάθου ταχέως μαστιγία.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1229.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1229.1.text#οὐ δῆτ', ἐπεί μοι χρησμός ἐστι Πυθικὸς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1230.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1230.1.text#φράζων ὑφ' οὗ †δεήσει μ'† ἡττᾶσθαι μόνου.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1231.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1231.1.text#τοὐμόν γε φράζων ὄνομα καὶ λίαν σαφῶς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1232.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1232.1.text#καὶ μήν σ' ἐλέγξαι βούλομαι τεκμηρίῳ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1233.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1233.1.text#εἴ τι ξυνοίσεις τοῦ θεοῦ τοῖς θεσφάτοις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1234.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1234.1.text#καί σου τοσοῦτον πρῶτον ἐκπειράσομαι·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1235.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1235.1.text#παῖς ὢν ἐφοίτας ἐς τίνος διδασκάλου;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1236.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1236.1.text#ἐν ταῖσιν εὕστραις κονδύλοις ἡρμοττόμην.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1237.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1237.1.text#πῶς εἶπας; ὥς μου χρησμὸς ἅπτεται φρενῶν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1238.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1238.1.text#εἶεν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1238a.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1238a.text#ἐν παιδοτρίβου δὲ τίνα πάλην ἐμάνθανες;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1239.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1239.1.text#κλέπτων ἐπιορκεῖν καὶ βλέπειν ἐναντίον·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1240.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1240.1.text#ὦ Φοῖβ' Ἄπολλον Λύκιε τί ποτέ μ' ἐργάσει;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1241.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1241.1.text#τέχνην δὲ τίνα ποτ' εἶχες ἐξανδρούμενος;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1242.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1242.1.text#ἠλλαντοπώλουν καί τι καὶ βινεσκόμην.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1243.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1243.1.text#οἴμοι κακοδαίμων· οὐκέτ' οὐδέν εἰμ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1244.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1244.1.text#λεπτή τις ἐλπίς ἐστ' ἐφ' ἧς ὀχούμεθα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1245.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1245.1.text#καί μοι τοσοῦτον εἰπέ· πότερον ἐν ἀγορᾷ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1246.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1246.1.text#ἠλλαντοπώλεις ἐτεὸν ἢ 'πὶ ταῖς πύλαις;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1247.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1247.1.text#ἐπὶ ταῖς πύλαισιν, οὗ τὸ τάριχος ὤνιον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1248.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1248.1.text#οἴμοι πέπρακται τοῦ θεοῦ τὸ θέσφατον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1249.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1249.1.text#κυλίνδετ' εἴσω τόνδε τὸν δυσδαίμονα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1250.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1250.1.text#ὦ στέφανε χαίρων ἄπιθι, κεἴ σ' ἄκων ἐγὼ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1251.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1251.1.text#λείπω· σὲ δ' ἄλλος τις λαβὼν κεκτήσεται,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1252.1.speaker#Κλέων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1252.1.text#κλέπτης μὲν οὐκ ἂν μᾶλλον, εὐτυχὴς δ' ἴσως.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1253.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1253.1.text#Ἑλλάνιε Ζεῦ σὸν τὸ νικητήριον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1254.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1254.1.text#ὦ χαῖρε καλλίνικε καὶ μέμνησ' ὅτι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1255.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1255.1.text#ἀνὴρ γεγένησαι δι' ἐμέ· καί σ' αἰτῶ βραχύ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1256.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1256.1.text#ὅπως ἔσομαί σοι Φανὸς ὑπογραφεὺς δικῶν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1257.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1257.1.text#ἐμοὶ δέ γ' ὅ τι σοι τοὔνομ' εἴπ'.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1257.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1257.2.text#Ἀγοράκριτος·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1258.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1258.1.text#ἐν τἀγορᾷ γὰρ κρινόμενος ἐβοσκόμην.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1259.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1259.1.text#Ἀγορακρίτῳ τοίνυν ἐμαυτὸν ἐπιτρέπω,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1260.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1260.1.text#καὶ τὸν Παφλαγόνα παραδίδωμι τουτονί.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1261.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1261.1.text#καὶ μὴν ἐγώ σ' ὦ Δῆμε θεραπεύσω καλῶς,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1262.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1262.1.text#ὥσθ' ὁμολογεῖν σε μηδέν' ἀνθρώπων ἐμοῦ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1263.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1263.1.text#ἰδεῖν ἀμείνω τῇ Κεχηναίων πόλει.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1264.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1264.1.text#τί κάλλιον ἀρχομένοισιν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1265.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1265.1.text#ἢ καταπαυομένοισιν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1266.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1266.1.text#ἢ θοᾶν ἵππων ἐλατῆρας ἀείδειν, †μηδὲν ἐσ† Λυσίστρατον,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1267.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1267.1.text#μηδὲ Θούμαντιν τὸν ἀνέστιον αὖ λυπεῖν ἑκούσῃ καρδίᾳ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1268.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1268.1.text#καὶ γὰρ οὗτος ὦ φίλ' Ἄπολλον ἀεὶ πεινῇ, θαλεροῖς δακρύοις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1273.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1273.1.text#σᾶς ἁπτόμενος φαρέτρας Πυθῶνι δίᾳ μὴ κακῶς πένεσθαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1274.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1274.1.text#λοιδορῆσαι τοὺς πονηροὺς οὐδέν ἐστ' ἐπίφθονον,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1275.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1275.1.text#ἀλλὰ τιμὴ τοῖσι χρηστοῖς, ὅστις εὖ λογίζεται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1276.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1276.1.text#εἰ μὲν οὖν ἄνθρωπος, ὃν δεῖ πόλλ' ἀκοῦσαι καὶ κακά,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1277.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1277.1.text#αὐτὸς ἦν ἔνδηλος, οὐκ ἂν ἀνδρὸς ἐμνήσθην φίλου.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1278.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1278.1.text#νῦν δ' Ἀρίγνωτον γὰρ οὐδεὶς ὅστις οὐκ ἐπίσταται,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1279.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1279.1.text#ὅστις ἢ τὸ λευκὸν οἶδεν ἢ τὸν ὄρθιον νόμον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1280.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1280.1.text#ἔστιν οὖν ἀδελφὸς αὐτῷ τοὺς τρόπους οὐ συγγενής,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1281.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1281.1.text#Ἀριφράδης πονηρός. ἀλλὰ τοῦτο μὲν καὶ βούλεται·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1282.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1282.1.text#ἔστι δ' οὐ μόνον πονηρός, οὐ γὰρ οὐδ' ἂν ᾐσθόμην,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1283.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1283.1.text#οὐδὲ παμπόνηρος, ἀλλὰ καὶ προσεξηύρηκέ τι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1284.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1284.1.text#τὴν γὰρ αὑτοῦ γλῶτταν αἰσχραῖς ἡδοναῖς λυμαίνεται,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1285.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1285.1.text#ἐν κασωρείοισι λείχων τὴν ἀπόπτυστον δρόσον,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1286.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1286.1.text#καὶ μολύνων τὴν ὑπήνην καὶ κυκῶν τὰς ἐσχάρας,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1287.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1287.1.text#καὶ Πολυμνήστεια ποιῶν καὶ ξυνὼν Οἰωνίχῳ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1288.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1288.1.text#ὅστις οὖν τοιοῦτον ἄνδρα μὴ σφόδρα βδελύττεται,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1289.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1289.1.text#οὔ ποτ' ἐκ ταὐτοῦ μεθ' ἡμῶν πίεται ποτηρίου.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1290.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1290.1.text#ἦ πολλάκις ἐννυχίαισι
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1291.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1291.1.text#φροντίσι συγγεγένημαι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1294.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1294.1.text#καὶ διεζήτηχ' ὁπόθεν ποτὲ φαύλως ἐσθίει Κλεώνυμος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1295.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1295.1.text#φασὶ μὲν γὰρ αὐτὸν ἐρεπτόμενον τὰ τῶν ἐχόντων ἀνέρων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1296.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1296.1.text#οὐκ ἂν ἐξελθεῖν ἀπὸ τῆς σιπύης· τοὺς δ' ἀντιβολεῖν ἂν ὅμως·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1297.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1297.1.text# "ἴθ' ὦ ἄνα πρὸς γονάτων, ἔξελθε καὶ σύγγνωθι τῇ τραπέζῃ."
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1300.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1300.1.text#φασὶν ἀλλήλαις ξυνελθεῖν τὰς τριήρεις ἐς λόγον,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1301.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1301.1.text#καὶ μίαν λέξαι τιν' αὐτῶν ἥτις ἦν γεραιτέρα·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1302.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1302.1.text#"οὐδὲ πυνθάνεσθε ταῦτ' ὦ παρθένοι τἀν τῇ πόλει;"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1303.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1303.1.text#"φασὶν αἰτεῖσθαί τιν' ἡμῶν ἑκατὸν ἐς Καρχηδόνα"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1304.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1304.1.text#"ἄνδρα μοχθηρὸν πολίτην ὀξίνην Ὑπέρβολον·"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1305.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1305.1.text#ταῖς δὲ δόξαι δεινὸν εἶναι τοῦτο κοὐκ ἀνασχετόν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1306.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1306.1.text#καί τιν' εἰπεῖν ἥτις ἀνδρῶν ἆσσον οὐκ ἐληλύθει·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1307.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1307.1.text#"ἀποτρόπαἰ οὐ δῆτ' ἐμοῦ γ' ἄρξει ποτ', ἀλλ' ἐάν με χρῇ,"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1308.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1308.1.text#"ὑπὸ τερηδόνων σαπεῖσ' ἐνταῦθα καταγηράσομαι·"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1309.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1309.1.text#"οὐδὲ Ναυφάντης γε τῆς Ναύσωνος, οὐ δῆτ' ὦ θεοί,"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1310.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1310.1.text#"εἴπερ ἐκ πεύκης γε κἀγὼ καὶ ξύλων ἐπηγνύμην."
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1311.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1311.1.text#"ἢν δ' ἀρέσκῃ ταῦτ' Ἀθηναίοις, καθῆσθαί μοι δοκεῖ"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1312.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1312.1.text#"ἐς τὸ Θησεῖον πλεούσαις ἢ 'πὶ τῶν σεμνῶν θεῶν."
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1313.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1313.1.text#"οὐ γὰρ ἡμῶν γε στρατηγῶν ἐγχανεῖται τῇ πόλει·"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1314.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1314.1.text#"ἀλλὰ πλείτω χωρὶς αὐτὸς ἐς κόρακας, εἰ βούλεται,"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1315.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1315.1.text#"τὰς σκάφας, ἐν αἷς ἐπώλει τοὺς λύχνους, καθελκύσας."
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1316.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1316.1.text#εὐφημεῖν χρὴ καὶ στόμα κλῄειν καὶ μαρτυριῶν ἀπέχεσθαι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1317.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1317.1.text#καὶ τὰ δικαστήρια συγκλῄειν οἷς ἡ πόλις ἥδε γέγηθεν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1318.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1318.1.text#ἐπὶ καιναῖσιν δ' εὐτυχίαισιν παιωνίζειν τὸ θέατρον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1319.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1319.1.text#ὦ ταῖς ἱεραῖς φέγγος Ἀθήναις καὶ ταῖς νήσοις ἐπίκουρε,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1320.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1320.1.text#τίν' ἔχων φήμην ἀγαθὴν ἥκεις, ἐφ' ὅτῳ κνισῶμεν ἀγυιάς;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1321.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1321.1.text#τὸν Δῆμον ἀφεψήσας ὑμῖν καλὸν ἐξ αἰσχροῦ πεποίηκα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1322.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1322.1.text#καὶ ποῦ 'στιν νῦν ὦ θαυμαστὰς ἐξευρίσκων ἐπινοίας;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1323.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1323.1.text#ἐν ταῖσιν ἰοστεφάνοις οἰκεῖ ταῖς ἀρχαίαισιν Ἀθήναις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1324.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1324.1.text#πῶς ἂν ἴδοιμεν; ποίαν τιν' ἔχει σκευήν; ποῖος γεγένηται;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1325.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1325.1.text#οἷός περ Ἀριστείδῃ πρότερον καὶ Μιλτιάδῃ ξυνεσίτει.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1326.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1326.1.text#ὄψεσθε δέ· καὶ γὰρ ἀνοιγνυμένων ψόφος ἤδη τῶν προπυλαίων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1327.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1327.1.text#ἀλλ' ὀλολύξατε φαινομέναισιν ταῖς ἀρχαίαισιν Ἀθήναις
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1328.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1328.1.text#καὶ θαυμασταῖς καὶ πολυύμνοις, ἵν' ὁ κλεινὸς Δῆμος ἐνοικεῖ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1329.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1329.1.text#ὦ ταὶ λιπαραὶ καὶ ἰοστέφανοι καὶ ἀριζήλωτοι Ἀθῆναι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1330.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1330.1.text#δείξατε τὸν τῆς Ἑλλάδος ὑμῖν καὶ τῆς γῆς τῆσδε μόναρχον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1331.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1331.1.text#ὅδ' ἐκεῖνος ὁρᾶν τεττιγοφόρας, ἀρχαίῳ σχήματι λαμπρός,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1332.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1332.1.text#οὐ χοιρινῶν ὄζων ἀλλὰ σπονδῶν, σμύρνῃ κατάλειπτος.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1333.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1333.1.text#χαῖρ' ὦ βασιλεῦ τῶν Ἑλλήνων· καί σοι ξυγχαίρομεν ἡμεῖς.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1334.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1334.1.text#τῆς γὰρ πόλεως ἄξια πράττεις καὶ τοῦ 'ν Μαραθῶνι τροπαίου.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1335.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1335.1.text#ὦ φίλτατ' ἀνδρῶν ἐλθὲ δεῦρ' Ἀγοράκριτε.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1336.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1336.1.text#ὅσα με δέδρακας ἀγάθ' ἀφεψήσας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1336.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1336.2.text#ἐγώ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1337.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1337.1.text#ἀλλ' ὦ μέλ' οὐκ οἶσθ' οἷος ἦσθ' αὐτὸς πάρος,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1338.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1338.1.text#οὐδ' οἷ' ἔδρας· ἐμὲ γὰρ νομίζοις ἂν θεόν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1339.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1339.1.text#τί δ' ἔδρων, κάτειπέ μοι, πρὸ τοῦ; ποῖός τις ἦ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1340.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1340.1.text#πρῶτον μέν, ὁπότ' εἴποι τις ἐν τἠκκλησίᾳ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1341.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1341.1.text#"ὦ Δῆμ' ἐραστής εἰμι σὸς φιλῶ τέ σε"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1342.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1342.1.text#"καὶ κήδομαί σου καὶ προβουλεύω μόνος,"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1343.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1343.1.text#τούτοις ὁπότε χρήσαιτό τις προοιμίοις,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1344.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1344.1.text#ἀνωρτάλιζες κἀκερουτίας.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1344.2.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1344.2.text#ἐγώ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1345.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1345.1.text#εἶτ' ἐξαπατήσας σ' ἀντὶ τούτων ᾤχετο.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1346.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1346.1.text#τί φῄς;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1346a.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1346a.text#ταυτί μ' ἔδρων, ἐγὼ δὲ τοῦτ' οὐκ ᾐσθόμην;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1347.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1347.1.text#τὰ δ' ὦτά γ' ἄν σου νὴ Δί' ἐξεπετάννυτο
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1348.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1348.1.text#ὥσπερ σκιάδειον καὶ πάλιν ξυνήγετο.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1349.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1349.1.text#οὕτως ἀνόητος ἐγεγενήμην καὶ γέρων;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1350.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1350.1.text#καὶ νὴ Δί' εἴ γε δύο λεγοίτην ῥήτορε,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1351.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1351.1.text#ὁ μὲν ποιεῖσθαι ναῦς μακρὰς ὁ δ' ἕτερος αὖ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1352.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1352.1.text#καταμισθοφορῆσαι τοῦθ', ὁ τὸν μισθὸν λέγων
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1353.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1353.1.text#τὸν τὰς τριήρεις παραδραμὼν ἂν ᾤχετο.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1354.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1354.1.text#οὗτος τί κύπτεις; οὐχὶ κατὰ χώραν μενεῖς;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1355.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1355.1.text#αἰσχύνομαί τοι ταῖς πρότερον ἁμαρτίαις.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1356.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1356.1.text#ἀλλ' οὐ σὺ τούτων αἴτιος, μὴ φροντίσῃς,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1357.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1357.1.text#ἀλλ' οἵ σε ταῦτ' ἐξηπάτων. νυνδὶ φράσον·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1358.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1358.1.text#ἐάν τις εἴπῃ βωμολόχος ξυνήγορος·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1359.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1359.1.text#"οὐκ ἔστιν ὑμῖν τοῖς δικασταῖς ἄλφιτα,"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1360.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1360.1.text#"εἰ μὴ καταγνώσεσθε ταύτην τὴν δίκην·"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1361.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1361.1.text#τοῦτον τί δράσεις, εἰπέ, τὸν ξυνήγορον;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1362.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1362.1.text#ἄρας μετέωρον ἐς τὸ βάραθρον ἐμβαλῶ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1363.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1363.1.text#ἐκ τοῦ λάρυγγος ἐκκρεμάσας Ὑπέρβολον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1364.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1364.1.text#τουτὶ μὲν ὀρθῶς καὶ φρονίμως ἤδη λέγεις·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1365.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1365.1.text#τὰ δ' ἄλλα, φέρ' ἴδω, πῶς πολιτεύσει φράσον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1366.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1366.1.text#πρῶτον μὲν ὁπόσοι ναῦς ἐλαύνουσιν μακράς,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1367.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1367.1.text#καταγομένοις τὸν μισθὸν ἀποδώσω 'ντελῆ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1368.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1368.1.text#πολλοῖς γ' ὑπολίσφοις πυγιδίοισιν ἐχαρίσω.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1369.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1369.1.text#ἔπειθ' ὁπλίτης ἐντεθεὶς ἐν καταλόγῳ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1370.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1370.1.text#οὐδεὶς κατὰ σπουδὰς μετεγγραφήσεται,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1371.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1371.1.text#ἀλλ' ὥσπερ ἦν τὸ πρῶτον ἐγγεγράψεται.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1372.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1372.1.text#τοῦτ' ἔδακε τὸν πόρπακα τὸν Κλεωνύμου.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1373.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1373.1.text#οὐδ' ἀγοράσει γ' ἀγένειος οὐδεὶς ἐν ἀγορᾷ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1374.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1374.1.text#ποῦ δῆτα Κλεισθένης ἀγοράσει καὶ Στράτων;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1375.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1375.1.text#τὰ μειράκια ταυτὶ λέγω τἀν τῷ μύρῳ,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1376.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1376.1.text#ἃ στωμυλεῖται τοιαδὶ καθήμενα·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1377.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1377.1.text#"σοφός γ' ὁ Φαίαξ δεξιῶς τ' οὐκ ἀπέθανεν."
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1378.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1378.1.text#"συνερτικὸς γάρ ἐστι καὶ περαντικός,"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1379.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1379.1.text#"καὶ γνωμοτυπικὸς καὶ σαφὴς καὶ κρουστικός,"
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1380.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1380.1.text#"καταληπτικός τ' ἄριστα τοῦ θορυβητικοῦ."
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1381.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1381.1.text#οὔκουν καταδακτυλικὸς σὺ τοῦ λαλητικοῦ;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1382.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1382.1.text#μὰ Δί' ἀλλ' ἀναγκάσω κυνηγετεῖν ἐγὼ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1383.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1383.1.text#τούτους ἅπαντας, παυσαμένους ψηφισμάτων.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1384.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1384.1.text#ἔχε νυν ἐπὶ τούτοις τουτονὶ τὸν ὀκλαδίαν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1385.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1385.1.text#καὶ παῖδ' ἐνόρχην, ὅσπερ οἴσει τόνδε σοι·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1386.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1386.1.text#κἄν που δοκῇ σοι, τοῦτον ὀκλαδίαν ποίει.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1387.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1387.1.text#μακάριος ἐς τἀρχαῖα δὴ καθίσταμαι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1388.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1388.1.text#φήσεις γ', ἐπειδὰν τὰς τριακοντούτιδας
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1389.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1389.1.text#σπονδὰς παραδῶ σοι. δεῦρ' ἴθ' αἱ Σπονδαὶ ταχύ.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1390.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1390.1.text#ὦ Ζεῦ πολυτίμηθ' ὡς καλαί· πρὸς τῶν θεῶν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1391.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1391.1.text#ἔξεστιν αὐτῶν κατατριακοντουτίσαι;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1392.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1392.1.text#πῶς ἔλαβες αὐτὰς ἐτέον;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1392.2.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1392.2.text#οὐ γὰρ ὁ Παφλαγὼν
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1393.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1393.1.text#ἀπέκρυπτε ταύτας ἔνδον, ἵνα σὺ μὴ λάβῃς;
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1394.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1394.1.text#νῦν οὖν ἐγώ σοι παραδίδωμ' ἐς τοὺς ἀγροὺς
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1395.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1395.1.text#αὐτὰς ἰέναι λαβόντα.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1395.2.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1395.2.text#τὸν δὲ Παφλαγόνα,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1396.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1396.1.text#ὃς ταῦτ' ἔδρασεν, εἴφ' ὅ τι ποιήσεις κακόν.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1397.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1397.1.text#οὐδὲν μέγ' ἀλλ' ἢ τὴν ἐμὴν ἕξει τέχνην·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1398.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1398.1.text#ἐπὶ ταῖς πύλαις ἀλλαντοπωλήσει μόνος,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1399.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1399.1.text#τὰ κύνεια μιγνὺς τοῖς ὀνείοις πράγμασιν,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1400.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1400.1.text#μεθύων τε ταῖς πόρναισι λοιδορήσεται,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1401.1.speaker#Ἀλλαντοπώλης
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1401.1.text#κἀκ τῶν βαλανείων πίεται τὸ λούτριον.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1402.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1402.1.text#εὖ γ' ἐπενόησας οὗπέρ ἐστιν ἄξιος,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1403.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1403.1.text#πόρναισι καὶ βαλανεῦσι διακεκραγέναι,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1404.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1404.1.text#καί σ' ἀντὶ τούτων ἐς τὸ πρυτανεῖον καλῶ
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1405.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1405.1.text#ἐς τὴν ἕδραν θ', ἵν' ἐκεῖνος ἦν ὁ φαρμακός.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1406.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1406.1.text#ἕπου δὲ ταυτηνὶ λαβὼν τὴν βατραχίδα·
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1407.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1407.1.text#κἀκεῖνον ἐκφερέτω τις ὡς ἐπὶ τὴν τέχνην,
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1408.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1408.1.text#ἵν' ἴδωσιν αὐτὸν οἷς ἐλωβᾶθ' οἱ ξένοι.
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1409.1.speaker#Δῆμος
urn:cts:greekLit:tlg0019.tlg002.fu.sp:1409.1.text#[…]
