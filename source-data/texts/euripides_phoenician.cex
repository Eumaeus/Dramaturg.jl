#!ctsdata
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1.1.text#ὦ τὴν ἐν ἄστροις οὐρανοῦ τέμνων ὁδὸν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:2.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:2.1.text#καὶ χρυσοκολλήτοισιν ἐμβεβὼς δίφροις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:3.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:3.1.text#Ἥλιε, θοαῖς ἵπποισιν εἱλίσσων φλόγα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:4.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:4.1.text#ὡς δυστυχῆ Θήβαισι τῇ τόθ' ἡμέρᾳ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:5.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:5.1.text#ἀκτῖν' ἐφῆκας, Κάδμος ἡνίκ' ἦλθε γῆν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:6.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:6.1.text#τήνδ', ἐκλιπὼν Φοίνισσαν ἐναλίαν χθόνα·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:7.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:7.1.text#ὃς παῖδα γήμας Κύπριδος Ἁρμονίαν ποτὲ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:8.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:8.1.text#Πολύδωρον ἐξέφυσε, τοῦ δὲ Λάβδακον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:9.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:9.1.text#φῦναι λέγουσιν, ἐκ δὲ τοῦδε Λάιον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:10.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:10.1.text#ἐγὼ δὲ παῖς μὲν κλῄζομαι Μενοικέως,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:11.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:11.1.text#— Κρέων τ' ἀδελφὸς μητρὸς ἐκ μιᾶς ἔφυ —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:12.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:12.1.text#καλοῦσι δ' Ἰοκάστην με· τοῦτο γὰρ πατὴρ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:13.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:13.1.text#ἔθετο. γαμεῖ δὲ Λάιός μ'· ἐπεὶ δ' ἄπαις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:14.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:14.1.text#ἦν χρόνια λέκτρα τἄμ' ἔχων ἐν δώμασιν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:15.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:15.1.text#ἐλθὼν ἐρωτᾷ Φοῖβον ἐξαιτεῖ θ' ἅμα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:16.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:16.1.text#παίδων ἐς οἴκους ἀρσένων κοινωνίαν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:17.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:17.1.text#ὃ δ' εἶπεν· ὦ Θήβαισιν εὐίπποις ἄναξ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:18.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:18.1.text#μὴ σπεῖρε τέκνων ἄλοκα δαιμόνων βίᾳ·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:19.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:19.1.text#εἰ γὰρ τεκνώσεις παῖδ', ἀποκτενεῖ σ' ὁ φύς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:20.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:20.1.text#καὶ πᾶς σὸς οἶκος βήσεται δι' αἵματος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:21.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:21.1.text#ὃ δ' ἡδονῇ δοὺς ἔς τε βακχείαν πεσὼν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:22.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:22.1.text#ἔσπειρεν ἡμῖν παῖδα· καὶ σπείρας, { βρέφος }
urn:cts:greekLit:tlg0006.tlg015.fu.sp:23.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:23.1.text#γνοὺς τἀμπλάκημα τοῦ θεοῦ τε τὴν φάτιν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:24.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:24.1.text#λειμῶν' ἐς Ἥρας καὶ Κιθαιρῶνος λέπας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:25.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:25.1.text#δίδωσι βουκόλοισιν ἐκθεῖναι βρέφος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:26.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:26.1.text#σφυρῶν σιδηρᾶ κέντρα διαπείρας μέσον·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:27.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:27.1.text#ὅθεν νιν Ἑλλὰς ὠνόμαζεν Οἰδίπουν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:28.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:28.1.text#Πολύβου δέ νιν λαβόντες ἱπποβουκόλοι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:29.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:29.1.text#φέρουσ' ἐς οἴκους ἔς τε δεσποίνης χέρας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:30.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:30.1.text#ἔθηκαν. ἣ δὲ τὸν ἐμὸν ὠδίνων πόνον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:31.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:31.1.text#μαστοῖς ὑφεῖτο καὶ πόσιν πείθει τεκεῖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:32.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:32.1.text#ἤδη δὲ πυρσαῖς γένυσιν ἐξανδρούμενος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:33.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:33.1.text#παῖς οὑμὸς ἢ γνοὺς ἤ τινος μαθὼν πάρα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:34.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:34.1.text#ἔστειχε τοὺς φύσαντας ἐκμαθεῖν θέλων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:35.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:35.1.text#πρὸς δῶμα Φοίβου, Λάιός θ', οὑμὸς πόσις,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:36.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:36.1.text#τὸν ἐκτεθέντα παῖδα μαστεύων μαθεῖν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:37.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:37.1.text#εἰ μηκέτ' εἴη. καὶ ξυνάπτετον πόδα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:38.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:38.1.text#ἐς ταὐτὸν ἄμφω Φωκίδος σχιστῆς ὁδοῦ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:39.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:39.1.text#καί νιν κελεύει Λαΐου τροχηλάτης·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:40.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:40.1.text#ὦ ξένε, τυράννοις ἐκποδὼν μεθίστασο.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:41.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:41.1.text#ὃ δ' εἷρπ' ἄναυδος, μέγα φρονῶν. πῶλοι δέ νιν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:42.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:42.1.text#χηλαῖς τένοντας ἐξεφοίνισσον ποδῶν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:43.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:43.1.text#ὅθεν — τί τἀκτὸς τῶν κακῶν με δεῖ λέγειν; —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:44.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:44.1.text#παῖς πατέρα καίνει καὶ λαβὼν ὀχήματα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:45.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:45.1.text#Πολύβῳ τροφεῖ δίδωσιν. ὡς δ' ἐπεζάρει
urn:cts:greekLit:tlg0006.tlg015.fu.sp:46.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:46.1.text#Σφὶγξ ἁρπαγαῖσι πόλιν ἐμός τ' οὐκ ἦν πόσις,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:47.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:47.1.text#Κρέων ἀδελφὸς τἀμὰ κηρύσσει λέχη,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:48.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:48.1.text#ὅστις σοφῆς αἴνιγμα παρθένου μάθοι,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:49.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:49.1.text#τούτῳ ξυνάψειν λέκτρα. τυγχάνει δέ πως
urn:cts:greekLit:tlg0006.tlg015.fu.sp:50.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:50.1.text#μούσας ἐμὸς παῖς Οἰδίπους Σφιγγὸς μαθών·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:51.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:51.1.text#[ ὅθεν τύραννος τῆσδε γῆς καθίσταται ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:52.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:52.1.text#καὶ σκῆπτρ' ἔπαθλα τῆσδε λαμβάνει χθονός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:53.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:53.1.text#γαμεῖ δὲ τὴν τεκοῦσαν οὐκ εἰδὼς τάλας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:54.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:54.1.text#οὐδ' ἡ τεκοῦσα παιδὶ συγκοιμωμένη.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:55.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:55.1.text#τίκτω δὲ παῖδας παιδὶ δύο μὲν ἄρσενας,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:56.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:56.1.text#Ἐτεοκλέα κλεινήν τε Πολυνείκους βίαν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:57.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:57.1.text#κόρας τε δισσάς· τὴν μὲν Ἰσμήνην πατὴρ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:58.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:58.1.text#ὠνόμασε, τὴν δὲ πρόσθεν Ἀντιγόνην ἐγώ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:59.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:59.1.text#μαθὼν δὲ τἀμὰ λέκτρα μητρῴων γάμων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:60.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:60.1.text#ὁ πάντ' ἀνατλὰς Οἰδίπους παθήματα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:61.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:61.1.text#ἐς ὄμμαθ' αὑτοῦ δεινὸν ἐμβάλλει φόνον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:62.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:62.1.text#χρυσηλάτοις πόρπαισιν αἱμάξας κόρας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:63.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:63.1.text#ἐπεὶ δὲ τέκνων γένυς ἐμῶν σκιάζεται,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:64.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:64.1.text#κλῄθροις ἔκρυψαν πατέρ', ἵν' ἀμνήμων τύχη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:65.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:65.1.text#γένοιτο πολλῶν δεομένη σοφισμάτων·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:66.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:66.1.text#ζῶν δ' ἔστ' ἐν οἴκοις. πρὸς δὲ τῆς τύχης νοσῶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:67.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:67.1.text#ἀρὰς ἀρᾶται παισὶν ἀνοσιωτάτας,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:68.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:68.1.text#θηκτῷ σιδήρῳ δῶμα διαλαχεῖν τόδε.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:69.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:69.1.text#τὼ δ' ἐς φόβον πεσόντε, μὴ τελεσφόρους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:70.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:70.1.text#εὐχὰς θεοὶ κραίνωσιν οἰκούντων ὁμοῦ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:71.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:71.1.text#ξυμβάντ' ἔταξαν τὸν νεώτερον πάρος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:72.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:72.1.text#φεύγειν ἑκόντα τήνδε Πολυνείκη χθόνα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:73.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:73.1.text#Ἐτεοκλέα δὲ σκῆπτρ' ἔχειν μένοντα γῆς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:74.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:74.1.text#ἐνιαυτὸν ἀλλάσσοντε. ἐπεὶ δ' ἐπὶ ζυγοῖς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:75.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:75.1.text#καθέζετ' ἀρχῆς, οὐ μεθίσταται θρόνων,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:76.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:76.1.text#φυγάδα δ' ἀπωθεῖ τῆσδε Πολυνείκη χθονός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:77.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:77.1.text#ὃ δ' Ἄργος ἐλθών, κῆδος Ἀδράστου λαβών,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:78.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:78.1.text#πολλὴν ἀθροίσας ἀσπίδ' Ἀργείων ἄγει·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:79.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:79.1.text#ἐπ' αὐτὰ δ' ἐλθὼν ἑπτάπυλα τείχη τάδε,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:80.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:80.1.text#πατρῷ' ἀπαιτεῖ σκῆπτρα καὶ μέρη χθονός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:81.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:81.1.text#ἐγὼ δ' ἔριν λύουσ' ὑπόσπονδον μολεῖν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:82.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:82.1.text#ἔπεισα παιδὶ παῖδα πρὶν ψαῦσαι δορός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:83.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:83.1.text#ἥξειν δ' ὁ πεμφθείς φησιν αὐτὸν ἄγγελος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:84.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:84.1.text#ἀλλ', ὦ φαεννὰς οὐρανοῦ ναίων πτυχὰς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:85.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:85.1.text#Ζεῦ, σῶσον ἡμᾶς, δὸς δὲ σύμβασιν τέκνοις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:86.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:86.1.text#χρὴ δ', εἰ σοφὸς πέφυκας, οὐκ ἐᾶν βροτὸν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:87.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:87.1.text#τὸν αὐτὸν αἰεὶ δυστυχῆ καθεστάναι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:88.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:88.1.text#ὦ κλεινὸν οἴκοις Ἀντιγόνη θάλος πατρί,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:89.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:89.1.text#ἐπεί σε μήτηρ παρθενῶνας ἐκλιπεῖν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:90.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:90.1.text#μεθῆκε μελάθρων ἐς διῆρες ἔσχατον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:91.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:91.1.text#στράτευμ' ἰδεῖν Ἀργεῖον ἱκεσίαισι σαῖς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:92.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:92.1.text#ἐπίσχες, ὡς ἂν προυξερευνήσω στίβον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:93.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:93.1.text#μή τις πολιτῶν ἐν τρίβῳ φαντάζεται,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:94.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:94.1.text#κἀμοὶ μὲν ἔλθῃ φαῦλος ὡς δούλῳ ψόγος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:95.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:95.1.text#σοὶ δ' ὡς ἀνάσσῃ· πάντα δ' ἐξειδὼς φράσω
urn:cts:greekLit:tlg0006.tlg015.fu.sp:96.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:96.1.text#ἅ τ' εἶδον εἰσήκουσά τ' Ἀργείων πάρα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:97.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:97.1.text#σπονδὰς ὅτ' ἦλθον σῷ κασιγνήτῳ φέρων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:98.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:98.1.text#ἐνθένδ' ἐκεῖσε, δεῦρό τ' αὖ κείνων πάρα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:99.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:99.1.text#ἀλλ' οὔτις ἀστῶν τοῖσδε χρίμπτεται δόμοις,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:100.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:100.1.text#κέδρου παλαιὰν κλίμακ' ἐκπέρα ποδί·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:101.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:101.1.text#σκόπει δὲ πεδία καὶ παρ' Ἰσμηνοῦ ῥοὰς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:102.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:102.1.text#Δίρκης τε νᾶμα πολεμίων στράτευμ' ὅσον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:103.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:103.1.text#ὄρεγέ νυν ὄρεγε γεραιὰν νέᾳ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:104.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:104.1.text#χεῖρ' ἀπὸ κλιμάκων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:105.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:105.1.text#ποδὸς ἴχνος ἐπαντέλλων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:106.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:106.1.text#ἰδοὺ ξύναψον, παρθέν'· ἐς καιρὸν δ' ἔβης·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:107.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:107.1.text#κινούμενον γὰρ τυγχάνει Πελασγικὸν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:108.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:108.1.text#στράτευμα, χωρίζουσι δ' ἀλλήλων λόχους.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:109.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:109.1.text#ἰὼ πότνια παῖ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:110.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:110.1.text#Λατοῦς Ἑκάτα, κατάχαλκον ἅπαν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:111.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:111.1.text#πεδίον ἀστράπτει.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:112.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:112.1.text#οὐ γάρ τι φαύλως ἦλθε Πολυνείκης χθόνα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:113.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:113.1.text#πολλοῖς μὲν ἵπποις, μυρίοις δ' ὅπλοις βρέμων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:114.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:114.1.text#ἆρα πύλαι κλῄθροις — χαλκόδετ' ἆρ' ἔμβολα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:115.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:115.1.text#λαϊνέοισιν Ἀμφίονος ὀργάνοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:116.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:116.1.text#τείχεος ἥρμοσται;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:117.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:117.1.text#θάρσει· τά γ' ἔνδον ἀσφαλῶς ἔχει πόλις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:118.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:118.1.text#ἀλλ' εἰσόρα τὸν πρῶτον, εἰ βούλῃ μαθεῖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:119.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:119.1.text#τίς οὗτος ὁ λευκολόφας,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:120.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:120.1.text#πρόπαρ ὃς ἁγεῖται στρατοῦ πάγχαλκον ἀσπίδ'
urn:cts:greekLit:tlg0006.tlg015.fu.sp:122.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:122.1.text#ἀμφὶ βραχίονι κουφίζων;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:123.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:123.1.text#λοχαγός, ὦ δέσποινα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:123.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:123.2.text#τίς, πόθεν γεγώς;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:124.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:124.1.text#αὔδασον, ὦ γεραιέ, τίς ὀνομάζεται;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:125.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:125.1.text#οὗτος Μυκηναῖος μὲν αὐδᾶται γένος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:126.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:126.1.text#Λερναῖα δ' οἰκεῖ νάμαθ', Ἱππομέδων ἄναξ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:127.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:127.1.text#ἒ ἒ ὡς γαῦρος, ὡς φοβερὸς εἰσιδεῖν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:128.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:128.1.text#γίγαντι γηγενέτᾳ προσόμοιος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:129.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:129.1.text#ἀστερωπὸς ἐν γραφαῖσιν, οὐχὶ πρόσφορος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:130.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:130.1.text#ἁμερίῳ γέννᾳ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:131.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:131.1.text#τὸν δ' ἐξαμείβοντ' οὐχ ὁρᾷς Δίρκης ὕδωρ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:132.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:132.1.text#ἄλλος ἄλλος ὅδε τευχέων τρόπος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:133.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:133.1.text#τίς δ' ἐστὶν οὗτος;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:133.2.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:133.2.text#παῖς μὲν Οἰνέως ἔφυ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:134.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:134.1.text#Τυδεύς, Ἄρη δ' Αἰτωλὸν ἐν στέρνοις ἔχει.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:135.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:135.1.text#οὗτος ὁ τᾶς Πολυνείκεος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:136.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:136.1.text#ὦ γέρον, αὐτοκασιγνήτᾳ νύμφας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:137.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:137.1.text#ὁμόγαμος κυρεῖ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:138.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:138.1.text#ὡς ἀλλόχρως ὅπλοισι, μειξοβάρβαρος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:139.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:139.1.text#σακεσφόροι γὰρ πάντες Αἰτωλοί, τέκνον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:140.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:140.1.text#λόγχαις τ' ἀκοντιστῆρες εὐστοχώτατοι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:141.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:141.1.text#σὺ δ', ὦ γέρον, πῶς αἰσθάνῃ σαφῶς τάδε;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:142.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:142.1.text#σημεῖ' ἰδὼν τότ' ἀσπίδων ἐγνώρισα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:143.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:143.1.text#σπονδὰς ὅτ' ἦλθον σῷ κασιγνήτῳ φέρων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:144.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:144.1.text#ἃ προσδεδορκὼς οἶδα τοὺς ὡπλισμένους.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:145.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:145.1.text#τίς δ' οὗτος ἀμφὶ μνῆμα τὸ Ζήθου περᾷ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:146.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:146.1.text#καταβόστρυχος, ὄμμασι γοργὸς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:147.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:147.1.text#εἰσιδεῖν νεανίας,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:148.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:148.1.text#λοχαγός, ὡς ὄχλος νιν ὑστέρῳ ποδὶ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:149.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:149.1.text#πάνοπλος ἀμφέπει;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:150.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:150.1.text#ὅδ' ἐστὶ Παρθενοπαῖος, Ἀταλάντης γόνος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:151.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:151.1.text#ἀλλά νιν ἁ κατ' ὄρη μετὰ ματέρος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:152.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:152.1.text#Ἄρτεμις ἱεμένα τόξοις δαμάσασ' ὀλέσειεν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:153.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:153.1.text#ὃς ἐπ' ἐμὰν πόλιν ἔβα πέρσων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:154.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:154.1.text#εἴη τάδ', ὦ παῖ. σὺν δίκῃ δ' ἥκουσι γῆν·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:155.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:155.1.text#ὃ καὶ δέδοικα μὴ σκοπῶσ' ὀρθῶς θεοί.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:156.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:156.1.text#ποῦ δ' ὃς ἐμοὶ μιᾶς ἐγένετ' ἐκ ματρὸς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:157.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:157.1.text#πολυπόνῳ μοίρᾳ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:158.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:158.1.text#ὦ φίλτατ', εἰπέ, ποῦ 'στι Πολυνείκης, γέρον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:159.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:159.1.text#ἐκεῖνος ἑπτὰ παρθένων τάφου πέλας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:160.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:160.1.text#Νιόβης Ἀδράστῳ πλησίον παραστατεῖ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:161.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:161.1.text#ὁρᾷς;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:161.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:161.2.text#ὁρῶ δῆτ' οὐ σαφῶς, ὁρῶ δέ πως
urn:cts:greekLit:tlg0006.tlg015.fu.sp:162.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:162.1.text#μορφῆς τύπωμα στέρνα τ' ἐξῃκασμένα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:163.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:163.1.text#ἀνεμώκεος εἴθε δρόμον νεφέλας ποσὶν ἐξανύσαιμι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:164.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:164.1.text#δι' αἰθέρος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:165.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:165.1.text#πρὸς ἐμὸν ὁμογενέτορα, περὶ δ' ὠλένας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:166.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:166.1.text#δέρᾳ φιλτάτᾳ βάλοιμ' { ἐν } χρόνῳ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:167.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:167.1.text#φυγάδα μέλεον. ὡς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:168.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:168.1.text#ὅπλοισι χρυσέοισιν ἐκπρεπής, γέρον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:169.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:169.1.text#ἑῴοις ὅμοια φλεγέθων βολαῖς [ ἀελίου ].
urn:cts:greekLit:tlg0006.tlg015.fu.sp:170.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:170.1.text#ἥξει δόμους τούσδ', ὥστε σ' ἐμπλῆσαι χαρᾶς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:171.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:171.1.text#ἔνσπονδος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:171.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:171.2.text#οὗτος δ', ὦ γεραιέ, τίς κυρεῖ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:172.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:172.1.text#ὃς ἅρμα λευκὸν ἡνιοστροφεῖ βεβώς;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:173.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:173.1.text#ὁ μάντις Ἀμφιάραος, ὦ δέσποιν', ὅδε·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:174.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:174.1.text#σφάγια δ' ἅμ' αὐτῷ, γῆς φιλαίματοι ῥοαί.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:175.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:175.1.text#ὦ λιπαροζώνου θύγατερ Ἀελίου
urn:cts:greekLit:tlg0006.tlg015.fu.sp:176.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:176.1.text#Σελαναία, χρυσεόκυκλον φέγγος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:177.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:177.1.text#ὡς ἀτρεμαῖα κέντρα καὶ σώφρονα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:178.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:178.1.text#πώλοις μεταφέρων ἰθύνει.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:179.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:179.1.text#ποῦ δ' ὃς τὰ δεινὰ τῇδ' ἐφυβρίζει πόλει;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:180.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:180.1.text#Καπανεύς; ἐκεῖνος προσβάσεις τεκμαίρεται
urn:cts:greekLit:tlg0006.tlg015.fu.sp:181.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:181.1.text#πύργων ἄνω τε καὶ κάτω τείχη μετρῶν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:182.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:182.1.text#ἰώ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:182.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:182.2.text#Νέμεσι καὶ Διὸς βαρύβρομοι βρονταί,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:183.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:183.1.text#κεραυνῶν τε φῶς αἰθαλόεν, σύ τοι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:184.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:184.1.text#μεγαλαγορίαν ὑπεράνορα κοιμίζεις·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:185.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:185.1.text#ὅδ' ἐστίν, αἰχμαλώτιδας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:186.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:186.1.text#ὃς δορὶ Θηβαίας Μυκηνηΐσιν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:187.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:187.1.text#Λερναίᾳ τε δώσειν τριαίνᾳ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:188.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:188.1.text#Ποσειδανίοις Ἀμυμωνίοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:189.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:189.1.text#ὕδασι δουλείαν περιβαλών —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:190.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:190.1.text#μήποτε μήποτε τάνδ', ὦ πότνια,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:191.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:191.1.text#χρυσεοβόστρυχον ὦ Διὸς ἔρνος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:192.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:192.1.text#Ἄρτεμι, δουλοσύναν τλαίην.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:193.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:193.1.text#ὦ τέκνον, ἔσβα δῶμα καὶ κατὰ στέγας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:194.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:194.1.text#ἐν παρθενῶσι μίμνε σοῖς, ἐπεὶ πόθου
urn:cts:greekLit:tlg0006.tlg015.fu.sp:195.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:195.1.text#ἐς τέρψιν ἦλθες ὧν ἔχρῃζες εἰσιδεῖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:196.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:196.1.text#ὄχλος γάρ, ὡς ταραγμὸς εἰσῆλθεν πόλιν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:197.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:197.1.text#χωρεῖ γυναικῶν πρὸς δόμους τυραννικούς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:198.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:198.1.text#φιλόψογον δὲ χρῆμα θηλειῶν ἔφυ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:199.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:199.1.text#σμικράς τ' ἀφορμὰς ἢν λάβωσι τῶν λόγων,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:200.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:200.1.text#πλείους ἐπεσφέρουσιν· ἡδονὴ δέ τις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:201.1.speaker#Παιδαγωγός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:201.1.text#γυναιξὶ μηδὲν ὑγιὲς ἀλλήλας λέγειν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:202.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:202.1.text#Τύριον οἶδμα λιποῦσ' ἔβαν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:203.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:203.1.text#ἀκροθίνια Λοξίᾳ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:204.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:204.1.text#Φοινίσσας ἀπὸ νάσου
urn:cts:greekLit:tlg0006.tlg015.fu.sp:205.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:205.1.text#Φοίβῳ δούλα μελάθρων,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:206.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:206.1.text#ἵν' ὑπὸ δειράσι νιφοβόλοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:207.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:207.1.text#Παρνασοῦ κατενάσθη,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:208.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:208.1.text#Ἰόνιον κατὰ πόντον ἐλάτᾳ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:209.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:209.1.text#πλεύσασα περιρρύτῳ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:210.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:210.1.text#ὑπὲρ ἀκαρπίστων πεδίων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:211.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:211.1.text#Σικελίας Ζεφύρου πνοαῖς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:212.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:212.1.text#ἱππεύσαντος, ἐν οὐρανῷ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:213.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:213.1.text#κάλλιστον κελάδημα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:214.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:214.1.text#πόλεος ἐκπροκριθεῖσ' ἐμᾶς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:215.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:215.1.text#καλλιστεύματα Λοξίᾳ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:216.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:216.1.text#Καδμείων ἔμολον γᾶν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:217.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:217.1.text#κλεινῶν Ἀγηνοριδᾶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:218.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:218.1.text#ὁμογενεῖς ἐπὶ Λαΐου
urn:cts:greekLit:tlg0006.tlg015.fu.sp:219.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:219.1.text#πεμφθεῖσ' ἐνθάδε πύργους.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:220.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:220.1.text#ἴσα δ' ἀγάλμασι χρυσοτεύκτοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:221.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:221.1.text#Φοίβῳ λάτρις ἐγενόμαν·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:222.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:222.1.text#ἔτι δὲ Κασταλίας ὕδωρ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:223.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:223.1.text#περιμένει με κόμας ἐμᾶς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:224.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:224.1.text#δεῦσαι παρθένιον χλιδὰν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:225.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:225.1.text#Φοιβείαισι λατρείαις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:226.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:226.1.text#ἰὼ λάμπουσα πέτρα πυρὸς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:227.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:227.1.text#δικόρυφον σέλας ὑπὲρ ἄκρων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:228.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:228.1.text#βακχειῶν Διονύσου,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:229.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:229.1.text#οἴνα θ' ἃ καθαμέριον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:230.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:230.1.text#στάζεις τὸν πολύκαρπον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:231.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:231.1.text#οἰνάνθας ἱεῖσα βότρυν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:232.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:232.1.text#ζάθεά τ' ἄντρα δράκοντος οὔρειαί
urn:cts:greekLit:tlg0006.tlg015.fu.sp:233.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:233.1.text#τε σκοπιαὶ θεῶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:234.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:234.1.text#νιφόβολόν τ' ὄρος ἱερόν, εἱλίσσων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:235.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:235.1.text#ἀθανάτας θεοῦ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:236.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:236.1.text#χορὸς γενοίμαν ἄφοβος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:237.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:237.1.text#παρὰ μεσόμφαλα γύαλα Φοίβου
urn:cts:greekLit:tlg0006.tlg015.fu.sp:238.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:238.1.text#Δίρκαν προλιποῦσα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:239.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:239.1.text#νῦν δέ μοι πρὸ τειχέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:240.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:240.1.text#θούριος μολὼν Ἄρης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:241.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:241.1.text#αἷμα δάιον φλέγει
urn:cts:greekLit:tlg0006.tlg015.fu.sp:242.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:242.1.text#τᾷδ', ὃ μὴ τύχοι, πόλει·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:243.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:243.1.text#κοινὰ γὰρ φίλων ἄχη,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:244.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:244.1.text#κοινὰ δ', εἴ τι πείσεται
urn:cts:greekLit:tlg0006.tlg015.fu.sp:245.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:245.1.text#ἑπτάπυργος ἅδε γᾶ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:246.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:246.1.text#Φοινίσσᾳ χώρᾳ. φεῦ φεῦ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:247.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:247.1.text#κοινὸν αἷμα, κοινὰ τέκεα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:248.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:248.1.text#τᾶς κερασφόρου πέφυκεν Ἰοῦς·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:249.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:249.1.text#ὧν μέτεστί μοι πόνων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:250.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:250.1.text#ἀμφὶ δὲ πτόλιν νέφος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:251.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:251.1.text#ἀσπίδων πυκνὸν φλέγει
urn:cts:greekLit:tlg0006.tlg015.fu.sp:252.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:252.1.text#σχῆμα φοινίου μάχης,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:253.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:253.1.text#ἃν Ἄρης τάχ' εἴσεται
urn:cts:greekLit:tlg0006.tlg015.fu.sp:254.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:254.1.text#παισὶν Οἰδίπου φέρων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:255.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:255.1.text#πημονὰν Ἐρινύων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:256.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:256.1.text#Ἄργος ὦ Πελασγικόν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:257.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:257.1.text#δειμαίνω τὰν σὰν ἀλκάν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:258.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:258.1.text#καὶ τὸ θεόθεν· οὐ γὰρ ἄδικον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:259.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:259.1.text#εἰς ἀγῶνα τόνδ' ἔνοπλος ὁρμᾷ [ παῖς ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:260.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:260.1.text#ὃς μετέρχεται δόμους.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:261.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:261.1.text#τὰ μὲν πυλωρῶν κλῇθρά μ' εἰσεδέξατο
urn:cts:greekLit:tlg0006.tlg015.fu.sp:262.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:262.1.text#δι' εὐπετείας τειχέων ἔσω μολεῖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:263.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:263.1.text#ὃ καὶ δέδοικα μή με δικτύων ἔσω
urn:cts:greekLit:tlg0006.tlg015.fu.sp:264.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:264.1.text#λαβόντες οὐκ ἐκφρῶσ' ἀναίμακτον χρόα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:265.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:265.1.text#ὧν οὕνεκ' ὄμμα πανταχῇ διοιστέον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:266.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:266.1.text#κἀκεῖσε καὶ τὸ δεῦρο, μὴ δόλος τις ᾖ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:267.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:267.1.text#ὡπλισμένος δὲ χεῖρα τῷδε φασγάνῳ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:268.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:268.1.text#τὰ πίστ' ἐμαυτῷ τοῦ θράσους παρέξομαι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:269.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:269.1.text#ὠή, τίς οὗτος; ἢ κτύπον φοβούμεθα;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:270.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:270.1.text#ἅπαντα γὰρ τολμῶσι δεινὰ φαίνεται,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:271.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:271.1.text#ὅταν δι' ἐχθρᾶς ποὺς ἀμείβηται χθονός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:272.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:272.1.text#πέποιθα μέντοι μητρί, κοὐ πέποιθ' ἅμα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:273.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:273.1.text#ἥτις μ' ἔπεισε δεῦρ' ὑπόσπονδον μολεῖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:274.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:274.1.text#ἀλλ' ἐγγὺς ἀλκή· βώμιοι γὰρ ἐσχάραι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:275.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:275.1.text#πέλας πάρεισι, κοὐκ ἔρημα δώματα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:276.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:276.1.text#φέρ' ἐς σκοτεινὰς περιβολὰς μεθῶ ξίφος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:277.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:277.1.text#καὶ τάσδ' ἔρωμαι, τίνες ἐφεστᾶσιν δόμοις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:278.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:278.1.text#ξέναι γυναῖκες, εἴπατ', ἐκ ποίας πάτρας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:279.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:279.1.text#Ἑλληνικοῖσι δώμασιν πελάζετε;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:280.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:280.1.text#Φοίνισσα μὲν γῆ πατρὶς ἡ θρέψασά με,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:281.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:281.1.text#Ἀγήνορος δὲ παῖδες ἐκ παίδων δορὸς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:282.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:282.1.text#Φοίβῳ μ' ἔπεμψαν ἐνθάδ' ἀκροθίνιον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:283.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:283.1.text#μέλλων δὲ πέμπειν μ' Οἰδίπου κλεινὸς γόνος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:284.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:284.1.text#μαντεῖα σεμνὰ Λοξίου τ' ἐπ' ἐσχάρας —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:285.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:285.1.text#ἐν τῷδ' ἐπεστράτευσαν Ἀργεῖοι πόλιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:286.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:286.1.text#σὺ δ' ἀντάμειψαί μ', ὅστις ὢν ἐλήλυθας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:287.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:287.1.text#ἑπτάστομον πύργωμα Θηβαίας χθονός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:288.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:288.1.text#πατὴρ μὲν ἡμῖν Οἰδίπους ὁ Λαΐου,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:289.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:289.1.text#ἔτικτε δ' Ἰοκάστη με, παῖς Μενοικέως·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:290.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:290.1.text#καλεῖ δὲ Πολυνείκη με Θηβαῖος λεώς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:291.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:291.1.text#ὦ συγγένεια τῶν Ἀγήνορος τέκνων,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:292.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:292.1.text#ἐμῶν τυράννων, ὧν ἀπεστάλην ὕπο —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:293.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:293.1.text#γονυπετεῖς ἕδρας προσπίτνω σ', ἄναξ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:294.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:294.1.text#τὸν οἴκοθεν νόμον σέβουσ' —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:295.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:295.1.text#ἔβας ὢ χρόνῳ γᾶν πατρῴαν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:296.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:296.1.text#ἰὼ ἰώ· πότνια, μόλε πρόδομος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:297.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:297.1.text#ἀμπέτασον πύλας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:298.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:298.1.text#κλύεις, ὦ τεκοῦσα τόνδε μᾶτερ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:299.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:299.1.text#τί μέλλεις ὑπώροφα μέλαθρα περᾶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:300.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:300.1.text#θιγεῖν τ' ὠλέναισιν τέκνου;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:301.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:301.1.text#Φοίνισσαν βοὰν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:302.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:302.1.text#κλύουσ', ὦ νεάνιδες, γηραιὸν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:303.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:303.1.text#πόδ' ἕλκω, τρομερὰν βάσιν· ἰὼ τέκνον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:305.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:305.1.text#χρόνῳ σὸν ὄμμα μυρίαις τ' ἐν ἁμέραις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:306.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:306.1.text#προσεῖδον· ἀμφίβαλλε μαστὸν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:307.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:307.1.text#ὠλέναισι ματέρος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:308.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:308.1.text#παρηίδων τ' ὄρεγμα βοστρύχων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:308.2.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:308.2.text#τε κυανόχρωτα χαίτας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:309.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:309.1.text#πλόκαμον, δέραν σκιάζων ἁμάν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:310.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:310.1.text#ἰὼ ἰώ, μόλις φανεὶς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:311.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:311.1.text#ἄελπτα κἀδόκητα ματρὸς ὠλέναις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:312.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:312.1.text#τί φῶ σε; πῶς ἅπαντα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:313.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:313.1.text#καὶ χερσὶ καὶ λόγοισι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:314.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:314.1.text#πολυέλικτον ἁδονὰν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:315.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:315.1.text#[ ἐκεῖσε καὶ τὸ δεῦρο ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:316.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:316.1.text#περιχορεύουσα τέρψιν παλαιᾶν λάβω
urn:cts:greekLit:tlg0006.tlg015.fu.sp:317.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:317.1.text#χαρμονᾶν; ἰὼ τέκος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:318.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:318.1.text#ἔρημον πατρῷον ἔλιπες δόμον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:319.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:319.1.text#φυγὰς ἀποσταλεὶς ὁμαίμου λώβᾳ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:320.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:320.1.text#ἦ ποθεινὸς φίλοις,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:321.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:321.1.text#ἦ ποθεινὸς Θήβαις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:322.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:322.1.text#ὅθεν ἐμάν τε λευκόχροα κείρομαι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:323.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:323.1.text#δακρυόεσσ' ἀνεῖσα πένθει κόμαν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:324.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:324.1.text#ἄπεπλος φαρέων λευκῶν, { ὦ } τέκνον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:325.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:325.1.text#δυσόρφναια δ' ἀμφὶ τρύχη τάδε
urn:cts:greekLit:tlg0006.tlg015.fu.sp:326.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:326.1.text#σκότι' ἀμείβομαι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:327.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:327.1.text#ὁ δ' ἐν δόμοισι πρέσβυς ὀμματοστερὴς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:328.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:328.1.text#ἀπήνας ὁμοπτέρου τᾶς ἀποζυγείσας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:329.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:329.1.text#δόμων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:330.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:330.1.text#πόθον ἀμφιδάκρυτον ἀεὶ κατέχων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:331.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:331.1.text#ἀνῇξε μὲν ξίφους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:332.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:332.1.text#ἐπ' αὐτόχειρά τε σφαγάν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:333.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:333.1.text#ὑπὲρ τέραμνά τ' ἀγχόνας,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:334.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:334.1.text#στενάζων ἀρὰς τέκνοις·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:335.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:335.1.text#σὺν ἀλαλαῖσι δ' αἰὲν αἰαγμάτων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:336.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:336.1.text#σκότια κρύπτεται.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:337.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:337.1.text#σὲ δ', ὦ τέκνον, [ καὶ ] γάμοισι δὴ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:338.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:338.1.text#κλύω ζυγέντα παιδοποιὸν ἁδονὰν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:339.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:339.1.text#ξένοισιν ἐν δόμοις ἔχειν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:340.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:340.1.text#ξένον τε κῆδος ἀμφέπειν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:341.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:341.1.text#ἄλαστα ματρὶ τᾷδε Λαίῳ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:342.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:342.1.text#τε τῷ παλαιγενεῖ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:343.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:343.1.text#γάμων ἐπακτὸν ἄταν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:344.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:344.1.text#ἐγὼ δ' οὔτε σοι πυρὸς ἀνῆψα φῶς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:345.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:345.1.text#νόμιμον ἐν γάμοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:346.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:346.1.text#[ ὡς πρέπει ] ματέρι μακαρίᾳ·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:347.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:347.1.text#ἀνυμέναια δ' Ἰσμηνὸς ἐκηδεύθη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:348.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:348.1.text#λουτροφόρου χλιδᾶς, ἀνὰ δὲ Θηβαίαν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:349.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:349.1.text#πόλιν ἐσιγάθη σᾶς ἔσοδοι νύμφας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:350.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:350.1.text#ὄλοιτο, τάδ' εἴτε σίδαρος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:351.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:351.1.text#εἴτ' ἔρις εἴτε πατὴρ ὁ σὸς αἴτιος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:352.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:352.1.text#εἴτε τὸ δαιμόνιον κατεκώμασε
urn:cts:greekLit:tlg0006.tlg015.fu.sp:353.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:353.1.text#δώμασιν Οἰδιπόδα·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:354.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:354.1.text#πρὸς ἐμὲ γὰρ κακῶν ἔμολε τῶνδ' ἄχη.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:355.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:355.1.text#δεινὸν γυναιξὶν αἱ δι' ὠδίνων γοναί,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:356.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:356.1.text#καὶ φιλότεκνόν πως πᾶν γυναικεῖον γένος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:357.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:357.1.text#μῆτερ, φρονῶν εὖ κοὐ φρονῶν ἀφικόμην
urn:cts:greekLit:tlg0006.tlg015.fu.sp:358.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:358.1.text#ἐχθροὺς ἐς ἄνδρας· ἀλλ' ἀναγκαίως ἔχει
urn:cts:greekLit:tlg0006.tlg015.fu.sp:359.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:359.1.text#πατρίδος ἐρᾶν ἅπαντας· ὃς δ' ἄλλως λέγει,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:360.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:360.1.text#λόγοισι χαίρει τὸν δὲ νοῦν ἐκεῖσ' ἔχει.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:361.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:361.1.text#οὕτω δ' ἐτάρβουν ἐς φόβον τ' ἀφικόμην,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:362.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:362.1.text#μή τις δόλος με πρὸς κασιγνήτου κτάνῃ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:363.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:363.1.text#ὥστε ξιφήρη χεῖρ' ἔχων δι' ἄστεως
urn:cts:greekLit:tlg0006.tlg015.fu.sp:364.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:364.1.text#κυκλῶν πρόσωπον ἦλθον. ἓν δέ μ' ὠφελεῖ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:365.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:365.1.text#σπονδαί τε καὶ σὴ πίστις, ἥ μ' ἐσήγαγε
urn:cts:greekLit:tlg0006.tlg015.fu.sp:366.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:366.1.text#τείχη πατρῷα· πολύδακρυς δ' ἀφικόμην,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:367.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:367.1.text#χρόνιος ἰδὼν μέλαθρα καὶ βωμοὺς θεῶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:368.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:368.1.text#γυμνάσιά θ' οἷσιν ἐνετράφην Δίρκης θ' ὕδωρ·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:369.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:369.1.text#ὧν οὐ δικαίως ἀπελαθεὶς ξένην πόλιν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:370.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:370.1.text#ναίω, δι' ὄσσων νᾶμ' ἔχων δακρύρροον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:371.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:371.1.text#ἀλλ' ἐκ γὰρ ἄλγους ἄλγος αὖ σὲ δέρκομαι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:372.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:372.1.text#[ κάρα ξυρῆκες καὶ πέπλους μελαγχίμους ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:373.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:373.1.text#ἔχουσαν, οἴμοι τῶν ἐμῶν ἐγὼ κακῶν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:374.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:374.1.text#ὡς δεινὸν ἔχθρα, μῆτερ, οἰκείων φίλων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:375.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:375.1.text#[ καὶ δυσλύτους ἔχουσα τὰς διαλλαγάς ].
urn:cts:greekLit:tlg0006.tlg015.fu.sp:376.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:376.1.text#τί γὰρ πατήρ μοι πρέσβυς ἐν δόμοισι δρᾷ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:377.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:377.1.text#σκότον δεδορκώς; τί δὲ κασίγνηται δύο;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:378.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:378.1.text#ἦ που στένουσι τλήμονες φυγὰς ἐμάς;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:379.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:379.1.text#κακῶς θεῶν τις Οἰδίπου φθείρει γένος·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:380.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:380.1.text#οὕτω γὰρ ἤρξατ', ἄνομα μὲν τεκεῖν ἐμέ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:381.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:381.1.text#κακῶς δὲ γῆμαι πατέρα σὸν φῦναί τε σέ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:382.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:382.1.text#ἀτὰρ τί ταῦτα; δεῖ φέρειν τὰ τῶν θεῶν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:383.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:383.1.text#ὅπως δ' ἔρωμαι, μή τι σὴν δάκω φρένα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:384.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:384.1.text#δέδοιχ', ἃ χρῄζω· διὰ πόθου δ' ἐλήλυθα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:385.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:385.1.text#ἀλλ' ἐξερώτα, μηδὲν ἐνδεὲς λίπῃς·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:386.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:386.1.text#ἃ γὰρ σὺ βούλῃ, ταὔτ' ἐμοί, μῆτερ, φίλα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:387.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:387.1.text#καὶ δή σ' ἐρωτῶ πρῶτον ὧν χρῄζω τυχεῖν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:388.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:388.1.text#τί τὸ στέρεσθαι πατρίδος; ἦ κακὸν μέγα;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:389.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:389.1.text#μέγιστον· ἔργῳ δ' ἐστὶ μεῖζον ἢ λόγῳ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:390.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:390.1.text#τίς ὁ τρόπος αὐτοῦ; τί φυγάσιν τὸ δυσχερές;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:391.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:391.1.text#ἓν μὲν μέγιστον, οὐκ ἔχει παρρησίαν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:392.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:392.1.text#δούλου τόδ' εἶπας, μὴ λέγειν ἅ τις φρονεῖ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:393.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:393.1.text#τὰς τῶν κρατούντων ἀμαθίας φέρειν χρεών.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:394.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:394.1.text#καὶ τοῦτο λυπρόν, συνασοφεῖν τοῖς μὴ σοφοῖς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:395.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:395.1.text#ἀλλ' ἐς τὸ κέρδος παρὰ φύσιν δουλευτέον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:396.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:396.1.text#αἱ δ' ἐλπίδες βόσκουσι φυγάδας, ὡς λόγος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:397.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:397.1.text#καλοῖς βλέπουσαί γ' ὄμμασιν, μέλλουσι δέ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:398.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:398.1.text#οὐδ' ὁ χρόνος αὐτὰς διεσάφησ' οὔσας κενάς;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:399.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:399.1.text#ἔχουσιν Ἀφροδίτην τιν' ἡδεῖαν κακῶν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:400.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:400.1.text#πόθεν δ' ἐβόσκου, πρὶν γάμοις εὑρεῖν βίον;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:401.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:401.1.text#ποτὲ μὲν ἐπ' ἦμαρ εἶχον, εἶτ' οὐκ εἶχον ἄν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:402.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:402.1.text#φίλοι δὲ πατρὸς καὶ ξένοι σ' οὐκ ὠφέλουν;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:403.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:403.1.text#εὖ πρᾶσσε· τὰ φίλων δ' οὐδέν, ἤν τι δυστυχῇς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:404.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:404.1.text#οὐδ' ηὑγένειά σ' ἦρεν εἰς ὕψος μέγαν;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:405.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:405.1.text#κακὸν τὸ μὴ ἔχειν· τὸ γένος οὐκ ἔβοσκέ με.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:406.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:406.1.text#ἡ πατρίς, ὡς ἔοικε, φίλτατον βροτοῖς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:407.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:407.1.text#οὐδ' ὀνομάσαι δύναι' ἂν ὡς ἐστὶν φίλον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:408.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:408.1.text#πῶς δ' ἦλθες Ἄργος; τίν' ἐπίνοιαν ἔσχεθες;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:409.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:409.1.text#ἔχρησ' Ἀδράστῳ Λοξίας χρησμόν τινα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:410.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:410.1.text#ποῖον; τί τοῦτ' ἔλεξας; οὐκ ἔχω μαθεῖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:411.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:411.1.text#κάπρῳ λέοντί θ' ἁρμόσαι παίδων γάμους.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:412.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:412.1.text#καὶ σοὶ τί θηρῶν ὀνόματος μετῆν, τέκνον;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:413.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:413.1.text#οὐκ οἶδ'· ὁ δαίμων μ' ἐκάλεσεν πρὸς τὴν τύχην.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:414.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:414.1.text#σοφὸς γὰρ ὁ θεός· τίνι τρόπῳ δ' ἔσχες λέχος;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:415.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:415.1.text#νὺξ ἦν, Ἀδράστου δ' ἦλθον ἐς παραστάδας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:416.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:416.1.text#κοίτας ματεύων, ᾗ φυγὰς πλανώμενος;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:417.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:417.1.text#ἦν ταῦτα· κᾆτά γ' ἦλθεν ἄλλος αὖ φυγάς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:418.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:418.1.text#τίς οὗτος; ὡς ἄρ' ἄθλιος κἀκεῖνος ἦν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:419.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:419.1.text#Τυδεύς, ὃν Οἰνέως φασὶν ἐκφῦναι πατρός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:420.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:420.1.text#τί θηρσὶν ὑμᾶς δῆτ' Ἄδραστος ᾔκασεν;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:421.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:421.1.text#στρωμνῆς ἐς ἀλκὴν οὕνεκ' ἤλθομεν πέρι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:422.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:422.1.text#ἐνταῦθα Ταλαοῦ παῖς συνῆκε θέσφατα;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:423.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:423.1.text#κἄδωκέ γ' ἡμῖν δύο δυοῖν νεάνιδας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:424.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:424.1.text#ἆρ' εὐτυχεῖς οὖν τοῖς γάμοις ἢ δυστυχεῖς;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:425.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:425.1.text#οὐ μεμπτὸς ἡμῖν ὁ γάμος ἐς τόδ' ἡμέρας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:426.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:426.1.text#πῶς δ' ἐξέπεισας δεῦρό σοι σπέσθαι στρατόν;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:427.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:427.1.text#δισσοῖς Ἄδραστος ὤμοσεν γαμβροῖς τόδε,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:428.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:428.1.text#[ Τυδεῖ τε κἀμοί· σύγγαμος γάρ ἐστ' ἐμός· ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:429.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:429.1.text#ἄμφω κατάξειν ἐς πάτραν, πρόσθεν δ' ἐμέ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:430.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:430.1.text#πολλοὶ δὲ Δαναῶν καὶ Μυκηναίων ἄκροι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:431.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:431.1.text#πάρεισι, λυπρὰν χάριν, ἀναγκαίαν δ', ἐμοὶ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:432.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:432.1.text#διδόντες· ἐπὶ γὰρ τὴν ἐμὴν στρατεύομαι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:433.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:433.1.text#πόλιν. θεοὺς δ' ἐπώμοσ' ὡς ἀκουσίως
urn:cts:greekLit:tlg0006.tlg015.fu.sp:434.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:434.1.text#τοῖς φιλτάτοις ἑκοῦσιν ἠράμην δόρυ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:435.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:435.1.text#ἀλλ' ἐς σὲ τείνει τῶνδε διάλυσις κακῶν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:436.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:436.1.text#μῆτερ, διαλλάξασαν ὁμογενεῖς φίλους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:437.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:437.1.text#παῦσαι πόνων με καὶ σὲ καὶ πᾶσαν πόλιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:438.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:438.1.text#πάλαι μὲν οὖν ὑμνηθέν, ἀλλ' ὅμως ἐρῶ·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:439.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:439.1.text#τὰ χρήματ' ἀνθρώποισι τιμιώτατα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:440.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:440.1.text#δύναμίν τε πλείστην τῶν ἐν ἀνθρώποις ἔχει.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:441.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:441.1.text#ἁγὼ μεθήκω δεῦρο μυρίαν ἄγων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:442.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:442.1.text#λόγχην· πένης γὰρ οὐδὲν εὐγενὴς ἀνήρ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:443.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:443.1.text#καὶ μὴν Ἐτεοκλῆς ἐς διαλλαγὰς ὅδε
urn:cts:greekLit:tlg0006.tlg015.fu.sp:444.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:444.1.text#χωρεῖ· σὸν ἔργον, μῆτερ Ἰοκάστη, λέγειν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:445.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:445.1.text#τοιούσδε μύθους οἷς διαλλάξεις τέκνα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:446.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:446.1.text#μῆτερ, πάρειμι· τὴν χάριν δὲ σοὶ διδοὺς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:447.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:447.1.text#ἦλθον. τί χρὴ δρᾶν; ἀρχέτω δέ τις λόγου·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:448.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:448.1.text#ὡς ἀμφὶ τείχη καὶ ξυνωρίδας λόχων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:449.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:449.1.text#τάσσων ἐπέσχον πόλιν, ὅπως κλύοιμί σου
urn:cts:greekLit:tlg0006.tlg015.fu.sp:450.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:450.1.text#κοινὰς βραβείας, αἷς ὑπόσπονδον μολεῖν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:451.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:451.1.text#τόνδ' εἰσεδέξω τειχέων πείσασά με.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:452.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:452.1.text#ἐπίσχες· οὔτοι τὸ ταχὺ τὴν δίκην ἔχει,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:453.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:453.1.text#βραδεῖς δὲ μῦθοι πλεῖστον ἀνύουσιν σοφόν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:454.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:454.1.text#σχάσον δὲ δεινὸν ὄμμα καὶ θυμοῦ πνοάς·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:455.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:455.1.text#οὐ γὰρ τὸ λαιμότμητον εἰσορᾷς κάρα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:456.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:456.1.text#Γοργόνος, ἀδελφὸν δ' εἰσορᾷς ἥκοντα σόν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:457.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:457.1.text#σύ τ' αὖ πρόσωπον πρὸς κασίγνητον στρέφε,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:458.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:458.1.text#Πολύνεικες· ἐς γὰρ ταὐτὸν ὄμμασιν βλέπων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:459.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:459.1.text#λέξεις τ' ἄμεινον τοῦδέ τ' ἐνδέξῃ λόγους.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:460.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:460.1.text#παραινέσαι δὲ σφῷν τι βούλομαι σοφόν·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:461.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:461.1.text#ὅταν φίλος τις ἀνδρὶ θυμωθεὶς φίλῳ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:462.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:462.1.text#ἐς ἓν συνελθὼν ὄμματ' ὄμμασιν διδῷ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:463.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:463.1.text#ἐφ' οἷσιν ἥκει, ταῦτα χρὴ μόνον σκοπεῖν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:464.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:464.1.text#κακῶν δὲ τῶν πρὶν μηδενὸς μνείαν ἔχειν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:465.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:465.1.text#λόγος μὲν οὖν σὸς πρόσθε, Πολύνεικες τέκνον·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:466.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:466.1.text#σὺ γὰρ στράτευμα Δαναϊδῶν ἥκεις ἄγων,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:467.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:467.1.text#ἄδικα πεπονθώς, ὡς σὺ φῄς· κριτὴς δέ τις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:468.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:468.1.text#θεῶν γένοιτο καὶ διαλλακτὴς κακῶν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:469.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:469.1.text#ἁπλοῦς ὁ μῦθος τῆς ἀληθείας ἔφυ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:470.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:470.1.text#κοὐ ποικίλων δεῖ τἄνδιχ' ἑρμηνευμάτων·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:471.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:471.1.text#ἔχει γὰρ αὐτὰ καιρόν· ὁ δ' ἄδικος λόγος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:472.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:472.1.text#νοσῶν ἐν αὑτῷ φαρμάκων δεῖται σοφῶν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:473.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:473.1.text#ἐγὼ δὲ πατρὸς δωμάτων προυσκεψάμην
urn:cts:greekLit:tlg0006.tlg015.fu.sp:474.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:474.1.text#τοὐμόν τε καὶ τοῦδ', ἐκφυγεῖν χρῄζων ἀρὰς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:475.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:475.1.text#ἃς Οἰδίπους ἐφθέγξατ' εἰς ἡμᾶς ποτε,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:476.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:476.1.text#ἐξῆλθον ἔξω τῆσδ' ἑκὼν αὐτὸς χθονός,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:477.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:477.1.text#δοὺς τῷδ' ἀνάσσειν πατρίδος ἐνιαυτοῦ κύκλον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:478.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:478.1.text#ὥστ' αὐτὸς ἄρχειν αὖθις ἀνὰ μέρος λαβὼν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:479.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:479.1.text#καὶ μὴ δι' ἔχθρας τῷδε καὶ φθόνου μολὼν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:480.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:480.1.text#κακόν τι δρᾶσαι καὶ παθεῖν, ἃ γίγνεται.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:481.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:481.1.text#ὃ δ' αἰνέσας ταῦθ' ὁρκίους τε δοὺς θεούς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:482.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:482.1.text#ἔδρασεν οὐδὲν ὧν ὑπέσχετ', ἀλλ' ἔχει
urn:cts:greekLit:tlg0006.tlg015.fu.sp:483.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:483.1.text#τυραννίδ' αὐτὸς καὶ δόμων ἐμῶν μέρος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:484.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:484.1.text#καὶ νῦν ἕτοιμός εἰμι τἀμαυτοῦ λαβὼν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:485.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:485.1.text#στρατὸν μὲν ἔξω τῆσδ' ἀποστεῖλαι χθονός,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:486.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:486.1.text#οἰκεῖν δὲ τὸν ἐμὸν οἶκον ἀνὰ μέρος λαβὼν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:487.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:487.1.text#καὶ τῷδ' ἀφεῖναι τὸν ἴσον αὖθις { αὖ } χρόνον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:488.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:488.1.text#καὶ μήτε πορθεῖν πατρίδα μήτε προσφέρειν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:489.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:489.1.text#πύργοισι πηκτῶν κλιμάκων προσαμβάσεις,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:490.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:490.1.text#ἃ μὴ κυρήσας τῆς δίκης πειράσομαι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:491.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:491.1.text#δρᾶν. μάρτυρας δὲ τῶνδε δαίμονας καλῶ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:492.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:492.1.text#ὡς πάντα πράσσων σὺν δίκῃ, δίκης ἄτερ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:493.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:493.1.text#ἀποστεροῦμαι πατρίδος ἀνοσιώτατα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:494.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:494.1.text#ταῦτ' αὔθ' ἕκαστα, μῆτερ, οὐχὶ περιπλοκὰς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:495.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:495.1.text#λόγων ἀθροίσας εἶπον, ἀλλὰ καὶ σοφοῖς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:496.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:496.1.text#καὶ τοῖσι φαύλοις ἔνδιχ', ὡς ἐμοὶ δοκεῖ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:497.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:497.1.text#ἐμοὶ μέν, εἰ καὶ μὴ καθ' Ἑλλήνων χθόνα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:498.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:498.1.text#τεθράμμεθ', ἀλλ' οὖν ξυνετά μοι δοκεῖς λέγειν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:499.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:499.1.text#εἰ πᾶσι ταὐτὸν καλὸν ἔφυ σοφόν θ' ἅμα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:500.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:500.1.text#οὐκ ἦν ἂν ἀμφίλεκτος ἀνθρώποις ἔρις·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:501.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:501.1.text#νῦν δ' οὔθ' ὅμοιον οὐδὲν οὔτ' ἴσον βροτοῖς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:502.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:502.1.text#πλὴν ὀνόμασαι· τὸ δ' ἔργον οὐκ ἔστιν τόδε.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:503.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:503.1.text#ἐγὼ γὰρ οὐδέν, μῆτερ, ἀποκρύψας ἐρῶ·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:504.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:504.1.text#ἄστρων ἂν ἔλθοιμ' ἡλίου πρὸς ἀντολὰς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:505.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:505.1.text#καὶ γῆς ἔνερθεν, δυνατὸς ὢν δρᾶσαι τάδε,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:506.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:506.1.text#τὴν θεῶν μεγίστην ὥστ' ἔχειν Τυραννίδα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:507.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:507.1.text#τοῦτ' οὖν τὸ χρηστόν, μῆτερ, οὐχὶ βούλομαι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:508.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:508.1.text#ἄλλῳ παρεῖναι μᾶλλον ἢ σῴζειν ἐμοί·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:509.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:509.1.text#ἀνανδρία γάρ, τὸ πλέον ὅστις ἀπολέσας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:510.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:510.1.text#τοὔλασσον ἔλαβε. πρὸς δὲ τοῖσδ' αἰσχύνομαι,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:511.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:511.1.text#ἐλθόντα σὺν ὅπλοις τόνδε καὶ πορθοῦντα γῆν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:512.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:512.1.text#τυχεῖν ἃ χρῄζει· ταῖς γὰρ ἂν Θήβαις τόδε
urn:cts:greekLit:tlg0006.tlg015.fu.sp:513.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:513.1.text#γένοιτ' ὄνειδος, εἰ Μυκηναίου δορὸς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:514.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:514.1.text#φόβῳ παρείην σκῆπτρα τἀμὰ τῷδ' ἔχειν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:515.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:515.1.text#χρῆν δ' αὐτὸν οὐχ ὅπλοισι τὰς διαλλαγάς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:516.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:516.1.text#μῆτερ, ποιεῖσθαι· πᾶν γὰρ ἐξαιρεῖ λόγος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:517.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:517.1.text#ὃ καὶ σίδηρος πολεμίων δράσειεν ἄν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:518.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:518.1.text#ἀλλ', εἰ μὲν ἄλλως τήνδε γῆν οἰκεῖν θέλει,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:519.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:519.1.text#ἔξεστ'· ἐκεῖνο δ' οὐχ ἑκὼν μεθήσομαι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:520.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:520.1.text#ἄρχειν παρόν μοι, τῷδε δουλεύσω ποτέ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:521.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:521.1.text#πρὸς ταῦτ' ἴτω μὲν πῦρ, ἴτω δὲ φάσγανα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:522.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:522.1.text#ζεύγνυσθε δ' ἵππους, πεδία πίμπλαθ' ἁρμάτων,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:523.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:523.1.text#ὡς οὐ παρήσω τῷδ' ἐμὴν τυραννίδα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:524.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:524.1.text#εἴπερ γὰρ ἀδικεῖν χρή, τυραννίδος πέρι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:525.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:525.1.text#κάλλιστον ἀδικεῖν, τἄλλα δ' εὐσεβεῖν χρεών.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:526.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:526.1.text#οὐκ εὖ λέγειν χρὴ μὴ 'πὶ τοῖς ἔργοις καλοῖς·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:527.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:527.1.text#οὐ γὰρ καλὸν τοῦτ', ἀλλὰ τῇ δίκῃ πικρόν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:528.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:528.1.text#ὦ τέκνον, οὐχ ἅπαντα τῷ γήρᾳ κακά,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:529.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:529.1.text#Ἐτεόκλεες, πρόσεστιν· ἀλλ' ἡμπειρία
urn:cts:greekLit:tlg0006.tlg015.fu.sp:530.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:530.1.text#ἔχει τι λέξαι τῶν νέων σοφώτερον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:531.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:531.1.text#τί τῆς κακίστης δαιμόνων ἐφίεσαι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:532.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:532.1.text#Φιλοτιμίας, παῖ; μὴ σύ γ'· ἄδικος ἡ θεός·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:533.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:533.1.text#πολλοὺς δ' ἐς οἴκους καὶ πόλεις εὐδαίμονας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:534.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:534.1.text#ἐσῆλθε κἀξῆλθ' ἐπ' ὀλέθρῳ τῶν χρωμένων·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:535.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:535.1.text#ἐφ' ᾗ σὺ μαίνῃ. κεῖνο κάλλιον, τέκνον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:536.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:536.1.text#Ἰσότητα τιμᾶν, ἣ φίλους ἀεὶ φίλοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:537.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:537.1.text#πόλεις τε πόλεσι συμμάχους τε συμμάχοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:538.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:538.1.text#συνδεῖ· τὸ γὰρ ἴσον μόνιμον ἀνθρώποις ἔφυ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:539.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:539.1.text#τῷ πλέονι δ' αἰεὶ πολέμιον καθίσταται
urn:cts:greekLit:tlg0006.tlg015.fu.sp:540.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:540.1.text#τοὔλασσον ἐχθρᾶς θ' ἡμέρας κατάρχεται.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:541.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:541.1.text#καὶ γὰρ μέτρ' ἀνθρώποισι καὶ μέρη σταθμῶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:542.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:542.1.text#Ἰσότης ἔταξε κἀριθμὸν διώρισε,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:543.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:543.1.text#νυκτός τ' ἀφεγγὲς βλέφαρον ἡλίου τε φῶς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:544.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:544.1.text#ἴσον βαδίζει τὸν ἐνιαύσιον κύκλον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:545.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:545.1.text#κοὐδέτερον αὐτῶν φθόνον ἔχει νικώμενον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:546.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:546.1.text#εἶθ' ἥλιος μὲν νύξ τε δουλεύει βροτοῖς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:547.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:547.1.text#σὺ δ' οὐκ ἀνέξῃ δωμάτων ἔχων ἴσον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:548.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:548.1.text#καὶ τῷδε νεῖμαι; κᾆτα ποῦ 'στιν ἡ δίκη;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:549.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:549.1.text#τί τὴν τυραννίδ', ἀδικίαν εὐδαίμονα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:550.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:550.1.text#τιμᾷς ὑπέρφευ καὶ μέγ' ἥγησαι τόδε;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:551.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:551.1.text#περιβλέπεσθαι τίμιον; κενὸν μὲν οὖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:552.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:552.1.text#ἢ πολλὰ μοχθεῖν πόλλ' ἔχων ἐν δώμασι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:553.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:553.1.text#βούλῃ; τί δ' ἔστι τὸ πλέον; ὄνομ' ἔχει μόνον·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:554.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:554.1.text#ἐπεὶ τά γ' ἀρκοῦνθ' ἱκανὰ τοῖς γε σώφροσιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:555.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:555.1.text#οὔτοι τὰ χρήματ' ἴδια κέκτηνται βροτοί,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:556.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:556.1.text#τὰ τῶν θεῶν δ' ἔχοντες ἐπιμελούμεθα·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:557.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:557.1.text#ὅταν δὲ χρῄζωσ', αὔτ' ἀφαιροῦνται πάλιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:558.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:558.1.text#[ ὁ δ' ὄλβος οὐ βέβαιος, ἀλλ' ἐφήμερος. ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:559.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:559.1.text#ἄγ', ἤν σ' ἔρωμαι δύο λόγω προθεῖσ' ἅμα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:560.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:560.1.text#πότερα τυραννεῖν ἢ πόλιν σῷσαι θέλεις,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:561.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:561.1.text#ἐρεῖς τυραννεῖν; ἢν δὲ νικήσῃ σ' ὅδε;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:562.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:562.1.text#[ Ἀργεῖά τ' ἔγχη δόρυ τὸ Καδμείων ἕλῃ, ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:563.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:563.1.text#ὄψῃ δαμασθὲν ἄστυ Θηβαῖον τόδε,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:564.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:564.1.text#ὄψῃ δὲ πολλὰς αἰχμαλωτίδας κόρας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:565.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:565.1.text#βίᾳ πρὸς ἀνδρῶν πολεμίων πορθουμένας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:566.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:566.1.text#ὀδυνηρὸς ἆρ' ὁ πλοῦτος, ὃν ζητεῖς ἔχειν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:567.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:567.1.text#γενήσεται Θήβαισι, φιλότιμος δὲ σύ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:568.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:568.1.text#σοὶ μὲν τάδ' αὐδῶ. σοὶ δέ, Πολύνεικες, λέγω·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:569.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:569.1.text#ἀμαθεῖς Ἄδραστος χάριτας ἔς σ' ἀνήψατο,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:570.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:570.1.text#ἀσύνετα δ' ἦλθες καὶ σὺ πορθήσων πόλιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:571.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:571.1.text#φέρ', ἢν ἕλῃς γῆν τήνδ' — ὃ μὴ τύχοι ποτέ —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:572.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:572.1.text#πρὸς θεῶν, τρόπαια πῶς ἀναστήσεις Διί;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:573.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:573.1.text#πῶς δ' αὖ κατάρξῃ θυμάτων, ἑλὼν πάτραν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:574.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:574.1.text#καὶ σκῦλα γράψεις πῶς ἐπ' Ἰνάχου ῥοαῖς;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:575.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:575.1.text#"Θήβας πυρώσας τάσδε Πολυνείκης θεοῖς"
urn:cts:greekLit:tlg0006.tlg015.fu.sp:576.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:576.1.text#"ἀσπίδας ἔθηκε;" μήποτ', ὦ τέκνον, κλέος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:577.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:577.1.text#τοιόνδε σοι γένοιθ' ὑφ' Ἑλλήνων λαβεῖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:578.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:578.1.text#ἢν δ' αὖ κρατηθῇς καὶ τὰ τοῦδ' ὑπερδράμῃ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:579.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:579.1.text#πῶς Ἄργος ἥξεις μυρίους λιπὼν νεκρούς;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:580.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:580.1.text#ἐρεῖ δὲ δή τις· ὦ κακὰ μνηστεύματα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:581.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:581.1.text#Ἄδραστε προσθείς, διὰ μιᾶς νύμφης γάμον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:582.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:582.1.text#ἀπωλόμεσθα. δύο κακὼ σπεύδεις, τέκνον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:583.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:583.1.text#κείνων στέρεσθαι τῶνδέ τ' ἐν μέσῳ πεσεῖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:584.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:584.1.text#μέθετον τὸ λίαν, μέθετον· ἀμαθία δυοῖν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:585.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:585.1.text#ἐς ταὔθ' ὅταν μόλητον, ἔχθιστον κακόν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:586.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:586.1.text#ὦ θεοί, γένοισθε τῶνδ' ἀπότροποι κακῶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:587.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:587.1.text#καὶ ξύμβασίν τιν' Οἰδίπου τέκνοις δότε.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:588.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:588.1.text#μῆτερ, οὐ λόγων ἔθ' ἁγών, ἀλλ' ἀναλοῦται χρόνος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:589.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:589.1.text#οὑν μέσῳ μάτην, περαίνει δ' οὐδὲν ἡ προθυμία·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:590.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:590.1.text#οὐ γὰρ ἂν ξυμβαῖμεν ἄλλως ἢ 'πὶ τοῖς εἰρημένοις,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:591.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:591.1.text#ὥστ' ἐμὲ σκήπτρων κρατοῦντα τῆσδ' ἄνακτ' εἶναι χθονός·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:592.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:592.1.text#τῶν μακρῶν δ' ἀπαλλαγεῖσα νουθετημάτων μ' ἔα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:593.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:593.1.text#καὶ σὺ τῶνδ' ἔξω κομίζου τειχέων, ἢ κατθανῇ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:594.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:594.1.text#πρὸς τίνος; τίς ὧδ' ἄτρωτος, ὅστις εἰς ἡμᾶς ξίφος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:595.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:595.1.text#φόνιον ἐμβαλὼν τὸν αὐτὸν οὐκ ἀποίσεται μόρον;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:596.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:596.1.text#ἐγγύς, οὐ πρόσω βέβηκεν· ἐς χέρας λεύσσεις ἐμάς;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:597.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:597.1.text#εἰσορῶ· δειλὸν δ' ὁ πλοῦτος καὶ φιλόψυχον κακόν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:598.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:598.1.text#κᾆτα σὺν πολλοῖσιν ἦλθες πρὸς τὸν οὐδὲν ἐς μάχην;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:599.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:599.1.text#ἀσφαλὴς γάρ ἐστ' ἀμείνων ἢ θρασὺς στρατηλάτης.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:600.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:600.1.text#κομπὸς εἶ σπονδαῖς πεποιθώς, αἵ σε σῴζουσιν θανεῖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:601.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:601.1.text#καὶ σέ· δεύτερον δ' ἀπαιτῶ σκῆπτρα καὶ μέρη χθονός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:602.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:602.1.text#οὐκ ἀπαιτούμεσθ'· ἐγὼ γὰρ τὸν ἐμὸν οἰκήσω δόμον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:603.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:603.1.text#τοῦ μέρους ἔχων τὸ πλεῖον;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:603.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:603.2.text#φήμ'· ἀπαλλάσσου δὲ γῆς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:604.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:604.1.text#ὦ θεῶν βωμοὶ πατρῴων —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:604.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:604.2.text#οὓς σὺ πορθήσων πάρει.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:605.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:605.1.text#κλύετέ μου —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:605.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:605.2.text#τίς δ' ἂν κλύοι σου πατρίδ' ἐπεστρατευμένου;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:606.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:606.1.text#καὶ θεῶν τῶν λευκοπώλων δώματα —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:606.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:606.2.text#οἳ στυγοῦσί σε.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:607.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:607.1.text#ἐξελαυνόμεσθα πατρίδος —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:607.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:607.2.text#καὶ γὰρ ἦλθες ἐξελῶν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:608.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:608.1.text#ἀδικίᾳ γ', ὦ θεοί.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:608.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:608.2.text#Μυκήναις, μὴ 'νθάδ' ἀνακάλει θεούς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:609.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:609.1.text#ἀνόσιος πέφυκας —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:609.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:609.2.text#ἀλλ' οὐ πατρίδος, ὡς σύ, πολέμιος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:610.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:610.1.text#ὅς μ' ἄμοιρον ἐξελαύνεις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:610.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:610.2.text#καὶ κατακτενῶ γε πρός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:611.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:611.1.text#ὦ πάτερ, κλύεις ἃ πάσχω;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:611.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:611.2.text#καὶ γὰρ οἷα δρᾷς κλύει.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:612.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:612.1.text#καὶ σύ, μῆτερ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:612.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:612.2.text#ἀθέμιτόν σοι μητρὸς ὀνομάζειν κάρα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:613.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:613.1.text#ὦ πόλις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:613.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:613.2.text#μολὼν ἐς Ἄργος ἀνακάλει Λέρνης ὕδωρ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:614.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:614.1.text#εἶμι, μὴ πόνει· σὲ δ' αἰνῶ, μῆτερ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:614.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:614.2.text#ἔξιθι χθονός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:615.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:615.1.text#ἔξιμεν· πατέρα δέ μοι δὸς εἰσιδεῖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:615.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:615.2.text#οὐκ ἂν τύχοις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:616.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:616.1.text#ἀλλὰ παρθένους ἀδελφάς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:616.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:616.2.text#οὐδὲ τάσδ' ὄψῃ ποτέ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:617.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:617.1.text#ὦ κασίγνηται.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:617.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:617.2.text#τί ταύτας ἀνακαλεῖς ἔχθιστος ὤν;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:618.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:618.1.text#μῆτερ, ἀλλά μοι σὺ χαῖρε.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:618.2.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:618.2.text#χαρτὰ γοῦν πάσχω, τέκνον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:619.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:619.1.text#οὐκέτ' εἰμὶ παῖς σός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:619.2.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:619.2.text#ἐς πόλλ' ἀθλία πέφυκ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:620.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:620.1.text#ὅδε γὰρ εἰς ἡμᾶς ὑβρίζει.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:620.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:620.2.text#καὶ γὰρ ἀνθυβρίζομαι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:621.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:621.1.text#ποῦ ποτε στήσῃ πρὸ πύργων;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:621.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:621.2.text#ὡς τί μ' ἱστορεῖς τόδε;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:622.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:622.1.text#ἀντιτάξομαι κτενῶν σε.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:622.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:622.2.text#κἀμὲ τοῦδ' ἔρως ἔχει.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:623.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:623.1.text#ὦ τάλαιν' ἐγώ· τί δράσετ', ὦ τέκνα;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:623.2.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:623.2.text#αὐτὸ σημανεῖ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:624.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:624.1.text#πατρὸς οὐ φεύξεσθ' Ἐρινῦς;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:624.2.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:624.2.text#ἐρρέτω πρόπας δόμος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:625.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:625.1.text#ὡς τάχ' οὐκέθ' αἱματηρὸν τοὐμὸν ἀργήσει ξίφος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:626.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:626.1.text#τὴν δὲ θρέψασάν με γαῖαν καὶ θεοὺς μαρτύρομαι,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:627.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:627.1.text#ὡς ἄτιμος οἰκτρὰ πάσχων ἐξελαύνομαι χθονός,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:628.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:628.1.text#δοῦλος ὥς, ἀλλ' οὐχὶ ταὐτοῦ πατρὸς Οἰδίπου γεγώς·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:629.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:629.1.text#κἄν τί σοι, πόλις, γένηται, μὴ ἐμέ, τόνδε δ' αἰτιῶ·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:630.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:630.1.text#οὐχ ἑκὼν γὰρ ἦλθον, ἄκων δ' ἐξελαύνομαι χθονός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:631.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:631.1.text#καὶ σύ, Φοῖβ' ἄναξ Ἀγυιεῦ, καὶ μέλαθρα, χαίρετε,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:632.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:632.1.text#ἥλικές θ' οὑμοί, θεῶν τε δεξίμηλ' ἀγάλματα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:633.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:633.1.text#οὐ γὰρ οἶδ' εἴ μοι προσειπεῖν αὖθις ἔσθ' ὑμᾶς ποτε·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:634.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:634.1.text#ἐλπίδες δ' οὔπω καθεύδουσ', αἷς πέποιθα σὺν θεοῖς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:635.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:635.1.text#τόνδ' ἀποκτείνας κρατήσειν τῆσδε Θηβαίας χθονός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:636.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:636.1.text#ἔξιθ' ἐκ χώρας· ἀληθῶς δ' ὄνομα Πολυνείκη πατὴρ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:637.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:637.1.text#ἔθετό σοι θείᾳ προνοίᾳ νεικέων ἐπώνυμον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:638.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:638.1.text#Κάδμος ἔμολε τάνδε γᾶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:639.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:639.1.text#Τύριος, ᾧ τετρασκελὴς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:640.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:640.1.text#μόσχος ἀδάματον πέσημα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:641.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:641.1.text#δίκε τελεσφόρον διδοῦσα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:642.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:642.1.text#χρησμόν, οὗ κατοικίσαι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:643.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:643.1.text#πεδία νιν τὸ θέσφατον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:644.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:644.1.text#πυροφόρα δόμων ἔχρη,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:645.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:645.1.text#καλλιπόταμος ὕδατος ἵνα τε
urn:cts:greekLit:tlg0006.tlg015.fu.sp:646.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:646.1.text#νοτὶς ἐπέρχεται γύας,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:647.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:647.1.text#Δίρκας χλοηφόρους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:648.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:648.1.text#καὶ βαθυσπόρους γύας·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:649.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:649.1.text#Βρόμιον ἔνθα τέκετο μάτηρ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:650.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:650.1.text#Διὸς γάμοισι,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:651.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:651.1.text#κισσὸς ὃν περιστεφὴς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:652.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:652.1.text#ἕλικος εὐθὺς ἔτι βρέφος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:653.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:653.1.text#χλοηφόροισιν ἔρνεσιν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:654.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:654.1.text#κατασκίοισιν ὀλβίσας ἐνώτισεν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:655.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:655.1.text#Βάκχιον χόρευμα παρθένοισι Θηβαΐαισι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:656.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:656.1.text#καὶ γυναιξὶν εὐίοις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:657.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:657.1.text#ἔνθα φόνιος ἦν δράκων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:658.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:658.1.text#Ἄρεος ὠμόφρων φύλαξ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:659.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:659.1.text#νάματ' ἔνυδρα καὶ ῥέεθρα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:660.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:660.1.text#χλοερὰ δεργμάτων κόραισι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:661.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:661.1.text#πολυπλάνοις ἐπισκοπῶν·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:662.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:662.1.text#ὃν ἐπὶ χέρνιβας μολὼν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:663.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:663.1.text#Κάδμος ὄλεσε μαρμάρῳ·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:664.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:664.1.text#κρᾶτα φόνιον ὀλεσίθηρος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:665.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:665.1.text#ὠλένας δικὼν βολαῖς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:666.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:666.1.text#δίας ἀμάτορος { δ' }
urn:cts:greekLit:tlg0006.tlg015.fu.sp:669.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:669.1.text#ἐς βαθυσπόρους γύας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:668.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:668.1.text#γαπετεῖς δικὼν ὀδόντας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:667.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:667.1.text#[ Παλλάδος ] φραδαῖσιν·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:670.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:670.1.text#ἔνθεν ἐξανῆκε γᾶ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:671.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:671.1.text#πάνοπλον ὄψιν ὑπὲρ ἄκρων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:672.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:672.1.text#ὅρων χθονός· σιδαρόφρων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:673.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:673.1.text#δέ νιν φόνος πάλιν ξυνῆψε γᾷ φίλᾳ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:674.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:674.1.text#αἵματος δ' ἔδευσε γαῖαν, ἅ νιν εὐηλίοισι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:675.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:675.1.text#δεῖξεν αἰθέρος πνοαῖς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:676.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:676.1.text#καὶ σέ, τὸν προμάτορος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:677.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:677.1.text#Ἰοῦς ποτ' ἔκγονον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:678.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:678.1.text#Ἔπαφον, ὦ Διὸς γένεθλον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:679.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:679.1.text#[ ἐκάλεσ' ] ἐκάλεσα βαρβάρῳ βοᾷ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:680.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:680.1.text#ἰώ, βαρβάροις λιταῖς·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:681.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:681.1.text#βᾶθι βᾶθι τάνδε γᾶν·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:682.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:682.1.text#— σοί νιν ἔκγονοι κτίσαν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:683.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:683.1.text#καὶ διώνυμοι θεαί,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:684.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:684.1.text#Περσέφασσα καὶ φίλα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:685.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:685.1.text#Δαμάτηρ θεά,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:686.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:686.1.text#πάντων ἄνασσα, πάντων δὲ Γᾶ τροφός,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:687.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:687.1.text#κτήσαντο — πέμπε πυρφόρους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:688.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:688.1.text#θεάς, ἄμυνε τᾷδε γᾷ·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:689.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:689.1.text#πάντα δ' εὐπετῆ θεοῖς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:690.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:690.1.text#χώρει σὺ καὶ κόμιζε τὸν Μενοικέως
urn:cts:greekLit:tlg0006.tlg015.fu.sp:691.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:691.1.text#Κρέοντ', ἀδελφὸν μητρὸς Ἰοκάστης ἐμῆς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:692.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:692.1.text#λέγων τάδ', ὡς οἰκεῖα καὶ κοινὰ χθονὸς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:693.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:693.1.text#θέλω πρὸς αὐτὸν συμβαλεῖν βουλεύματα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:694.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:694.1.text#πρὶν ἐς μάχην τε καὶ δορὸς τάξιν μολεῖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:695.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:695.1.text#καίτοι ποδῶν σῶν μόχθον ἐκλύει παρών·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:696.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:696.1.text#ὁρῶ γὰρ αὐτὸν πρὸς δόμους στείχοντ' ἐμούς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:697.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:697.1.text#ἦ πόλλ' ἐπῆλθον εἰσιδεῖν χρῄζων σ', ἄναξ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:698.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:698.1.text#Ἐτεόκλεες, πέριξ δὲ Καδμείων πύλας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:699.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:699.1.text#φυλακάς τ' ἐπῆλθον σὸν δέμας θηρώμενος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:700.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:700.1.text#καὶ μὴν ἐγὼ σ' ἔχρῃζον εἰσιδεῖν, Κρέον·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:701.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:701.1.text#πολλῷ γὰρ ηὗρον ἐνδεεῖς διαλλαγάς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:702.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:702.1.text#ὡς ἐς λόγους συνῆψα Πολυνείκει μολών.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:703.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:703.1.text#ἤκουσα μεῖζον αὐτὸν ἢ Θήβας φρονεῖν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:704.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:704.1.text#κήδει τ' Ἀδράστου καὶ στρατῷ πεποιθότα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:705.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:705.1.text#ἀλλ' ἐς θεοὺς χρὴ ταῦτ' ἀναρτήσαντ' ἔχειν·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:706.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:706.1.text#ἃ δ' ἐμποδὼν μάλιστα, ταῦθ' ἥκω φράσων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:707.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:707.1.text#τὰ ποῖα ταῦτα; τὸν λόγον γὰρ ἀγνοῶ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:708.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:708.1.text#ἥκει τις αἰχμάλωτος Ἀργείων πάρα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:709.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:709.1.text#λέγει δὲ δὴ τί τῶν ἐκεῖ νεώτερον;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:710.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:710.1.text#μέλλειν [ πέριξ πύργοισι Καδμείων πόλιν ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:711.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:711.1.text#[ ὅπλοις ] ἑλίξειν αὐτίκ' Ἀργείων στρατόν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:712.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:712.1.text#ἐξοιστέον τἄρ' ὅπλα Καδμείων πόλει.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:713.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:713.1.text#ποῖ; μῶν νεάζων οὐχ ὁρᾷς ἃ χρή σ' ὁρᾶν;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:714.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:714.1.text#ἐκτὸς τάφρων τῶνδ', ὡς μαχουμένους τάχα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:715.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:715.1.text#σμικρὸν τὸ πλῆθος τῆσδε γῆς, οἳ δ' ἄφθονοι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:716.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:716.1.text#ἐγᾦδα κείνους τοῖς λόγοις ὄντας θρασεῖς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:717.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:717.1.text#ἔχει τιν' ὄγκον τἄργος Ἑλλήνων πάρα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:718.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:718.1.text#θάρσει· τάχ' αὐτῶν πεδίον ἐμπλήσω φόνου.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:719.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:719.1.text#θέλοιμ' ἄν· ἀλλὰ τοῦθ' ὁρῶ πολλοῦ πόνου.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:720.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:720.1.text#ὡς οὐ καθέξω τειχέων ἔσω στρατόν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:721.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:721.1.text#καὶ μὴν τὸ νικᾶν ἐστι πᾶν εὐβουλία.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:722.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:722.1.text#βούλῃ τράπωμαι δῆθ' ὁδοὺς ἄλλας τινάς;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:723.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:723.1.text#πάσας γε, πρὶν κίνδυνον εἰς ἅπαξ μολεῖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:724.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:724.1.text#εἰ νυκτὸς αὐτοῖς προσβάλοιμεν ἐκ λόχου;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:725.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:725.1.text#εἴπερ σφαλείς γε δεῦρο σωθήσῃ πάλιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:726.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:726.1.text#ἴσον φέρει νύξ, τοῖς δὲ τολμῶσιν πλέον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:727.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:727.1.text#ἐνδυστυχῆσαι δεινὸν εὐφρόνης κνέφας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:728.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:728.1.text#ἀλλ' ἀμφὶ δεῖπνον οὖσι προσβάλω δόρυ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:729.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:729.1.text#ἔκπληξις ἂν γένοιτο· νικῆσαι δὲ δεῖ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:730.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:730.1.text#βαθύς γέ τοι Διρκαῖος ἀναχωρεῖν πόρος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:731.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:731.1.text#ἅπαν κάκιον τοῦ φυλάσσεσθαι καλῶς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:732.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:732.1.text#τί δ', εἰ καθιππεύσαιμεν Ἀργείων στρατόν;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:733.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:733.1.text#κἀκεῖ πέφρακται λαὸς ἅρμασιν πέριξ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:734.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:734.1.text#τί δῆτα δράσω; πολεμίοισι δῶ πόλιν;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:735.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:735.1.text#μὴ δῆτα· βουλεύου δ', ἐπείπερ εἶ σοφός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:736.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:736.1.text#τίς οὖν πρόνοια γίγνεται σοφωτέρα;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:737.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:737.1.text#ἕπτ' ἄνδρας αὐτοῖς φασιν, ὡς ἤκουσ' ἐγώ —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:738.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:738.1.text#τί προστετάχθαι δρᾶν; τὸ γὰρ σθένος βραχύ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:739.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:739.1.text#{ λόχων ἀνάσσειν } ἑπτὰ προσκεῖσθαι πύλαις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:740.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:740.1.text#τί δῆτα δρῶμεν; ἀπορίαν γὰρ οὐ μενῶ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:741.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:741.1.text#ἕπτ' ἄνδρας αὐτοῖς καὶ σὺ πρὸς πύλαις ἑλοῦ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:742.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:742.1.text#λόχων ἀνάσσειν ἢ μονοστόλου δορός;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:743.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:743.1.text#λόχων, προκρίνας οἵπερ ἀλκιμώτατοι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:744.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:744.1.text#ξυνῆκ'· ἀμύνειν τειχέων προσαμβάσεις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:745.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:745.1.text#καὶ ξυστρατήγους { γ' }· εἷς δ' ἀνὴρ οὐ πάνθ' ὁρᾷ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:746.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:746.1.text#θάρσει προκρίνας ἢ φρενῶν εὐβουλίᾳ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:747.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:747.1.text#ἀμφότερον· ἀπολειφθὲν γὰρ οὐδὲν θάτερον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:748.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:748.1.text#ἔσται τάδ'· ἐλθὼν ἑπτάπυργον ἐς πόλιν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:749.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:749.1.text#τάξω λοχαγοὺς πρὸς πύλαισιν, ὡς λέγεις,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:750.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:750.1.text#ἴσους ἴσοισι πολεμίοισιν ἀντιθείς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:751.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:751.1.text#ὄνομα δ' ἑκάστου διατριβὴ πολλὴ λέγειν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:752.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:752.1.text#ἐχθρῶν ὑπ' αὐτοῖς τείχεσιν καθημένων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:753.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:753.1.text#ἀλλ' εἶμ', ὅπως ἂν μὴ καταργῶμεν χέρα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:754.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:754.1.text#καί μοι γένοιτ' ἀδελφὸν ἀντήρη λαβεῖν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:755.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:755.1.text#καὶ ξυσταθέντα διὰ μάχης ἑλεῖν δορί.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:756.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:756.1.text#[ κτανεῖν θ', ὃς ἦλθε πατρίδα πορθήσων ἐμήν. ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:757.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:757.1.text#γάμους δ' ἀδελφῆς Ἀντιγόνης παιδός τε σοῦ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:758.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:758.1.text#Αἵμονος, ἐάν τι τῆς τύχης ἐγὼ σφαλῶ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:759.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:759.1.text#σοὶ χρὴ μέλεσθαι· τὴν δόσιν δ' ἐχέγγυον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:760.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:760.1.text#τὴν πρόσθε ποιῶ νῦν ἐπ' ἐξόδοις ἐμαῖς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:761.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:761.1.text#μητρὸς δ' ἀδελφὸς εἶ· τί δεῖ μακρηγορεῖν;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:762.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:762.1.text#τρέφ' ἀξίως νιν σοῦ τε τήν τ' ἐμὴν χάριν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:763.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:763.1.text#πατὴρ δ' ἐς αὑτὸν ἀμαθίαν ὀφλισκάνει,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:764.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:764.1.text#ὄψιν τυφλώσας· οὐκ ἄγαν σφ' ἐπῄνεσα·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:765.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:765.1.text#ἡμᾶς δ' ἀραῖσιν, ἢν τύχῃ, κατακτενεῖ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:766.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:766.1.text#ἓν δ' ἐστὶν ἡμῖν ἀργόν, εἴ τι θέσφατον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:767.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:767.1.text#οἰωνόμαντις Τειρεσίας ἔχει φράσαι,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:768.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:768.1.text#τοῦδ' ἐκπυθέσθαι ταῦτ'· ἐγὼ δὲ παῖδα σὸν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:769.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:769.1.text#Μενοικέα, σοῦ πατρὸς αὐτεπώνυμον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:770.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:770.1.text#λαβόντα πέμψω δεῦρο Τειρεσίαν, Κρέον·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:771.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:771.1.text#σοὶ μὲν γὰρ ἡδὺς ἐς λόγους ἀφίξεται,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:772.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:772.1.text#ἐγὼ δὲ τέχνην μαντικὴν ἐμεμψάμην
urn:cts:greekLit:tlg0006.tlg015.fu.sp:773.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:773.1.text#ἤδη πρὸς αὐτόν, ὥστε μοι μομφὰς ἔχειν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:774.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:774.1.text#πόλει δὲ καὶ σοὶ ταῦτ' ἐπισκήπτω, Κρέον·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:775.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:775.1.text#ἤνπερ κρατήσῃ τἀμά, Πολυνείκους νέκυν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:776.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:776.1.text#μήποτε ταφῆναι τῇδε Θηβαίᾳ χθονί,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:777.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:777.1.text#θνῄσκειν δὲ τὸν θάψαντα, κἂν φίλων τις ᾖ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:778.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:778.1.text#[ σοὶ μὲν τάδ' εἶπον· προσπόλοις δ' ἐμοῖς λέγω· ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:779.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:779.1.text#ἐκφέρετε τεύχη πάνοπλά τ' ἀμφιβλήματα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:780.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:780.1.text#ὡς εἰς ἀγῶνα τὸν προκείμενον δορὸς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:781.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:781.1.text#ὁρμώμεθ' ἤδη ξὺν δίκῃ νικηφόρῳ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:782.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:782.1.text#τῇ δ' Εὐλαβείᾳ, χρησιμωτάτῃ θεῶν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:783.1.speaker#Ἐτεοκλῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:783.1.text#προσευχόμεσθα τήνδε διασῷσαι πόλιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:784.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:784.1.text#ὦ πολύμοχθος Ἄρης, τί ποθ' αἵματι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:785.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:785.1.text#καὶ θανάτῳ κατέχῃ Βρομίου παράμουσος ἑορταῖς;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:786.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:786.1.text#οὐκ ἐπὶ καλλιχόροις στεφάνοισι νεάνιδος ὥρας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:787.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:787.1.text#βόστρυχον ἀμπετάσας λωτοῦ κατὰ πνεύματα μέλπῃ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:788.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:788.1.text#μοῦσαν, ἐν ᾇ χάριτες χοροποιοί,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:789.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:789.1.text#ἀλλὰ σὺν ὁπλοφόροις στρατὸν Ἀργείων ἐπιπνεύσας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:790.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:790.1.text#αἵματι Θήβας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:791.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:791.1.text#κῶμον ἀναυλότατον προχορεύεις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:792.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:792.1.text#οὐδ' ὑπὸ θυρσομανεῖ νεβρίδων μέτα δίνᾳ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:793.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:793.1.text#ἅρμασι καὶ ψαλίων τετραβάμοσι μωνυχοπώλων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:793.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:793.2.text#ἱππείαις ἐπὶ χεύμασι βαίνων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:794.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:794.1.text#Ἰσμηνοῖο θοάζεις, Ἀργείοις ἐπιπνεύσας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:795.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:795.1.text#Σπαρτῶν γένναν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:796.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:796.1.text#ἀσπιδοφέρμονα θίασον ἐνόπλιον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:797.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:797.1.text#ἀντίπαλον κατὰ λάινα τείχεα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:798.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:798.1.text#χαλκῷ κοσμήσας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:798.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:798.2.text#ἦ δεινά τις Ἔρις θεός, ἃ τάδε
urn:cts:greekLit:tlg0006.tlg015.fu.sp:799.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:799.1.text#μήσατο πήματα γᾶς βασιλεῦσιν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:800.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:800.1.text#Λαβδακίδαις πολυμόχθοις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:801.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:801.1.text#ὦ ζαθέων πετάλων πολυθηρότατον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:802.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:802.1.text#νάπος, Ἀρτέμιδος χιονοτρόφον ὄμμα Κιθαιρών,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:803.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:803.1.text#μήποτε τὸν θανάτῳ προτεθέντα, λόχευμ' Ἰοκάστας,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:804.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:804.1.text#ὤφελες Οἰδιπόδαν θρέψαι, βρέφος ἔκβολον οἴκων,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:805.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:805.1.text#χρυσοδέτοις περόναις ἐπίσαμον·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:806.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:806.1.text#μηδὲ τὸ παρθένιον πτερόν, οὔρειον τέρας, ἐλθεῖν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:807.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:807.1.text#πένθεα γαίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:807.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:807.2.text#Σφιγγὸς ἀμουσοτάταισι σὺν ᾠδαῖς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:808.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:808.1.text#ἅ ποτε Καδμογενῆ τετραβάμοσι χαλαῖς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:809.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:809.1.text#τείχεσι χριμπτομένα φέρεν αἰθέρος εἰς ἄβατον φῶς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:810.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:810.1.text#γένναν, ἃν ὁ κατὰ χθονὸς Ἅιδας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:811.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:811.1.text#Καδμείοις ἐπιπέμπει· δυσδαίμων δ' ἔρις ἄλλα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:812.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:812.1.text#θάλλει παίδων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:813.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:813.1.text#Οἰδιπόδα κατὰ δώματα καὶ πόλιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:814.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:814.1.text#οὐ γὰρ ὃ μὴ καλὸν οὔποτ' ἔφυ καλόν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:815.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:815.1.text#οὐδ' οἱ μὴ νόμιμοι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:816.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:816.1.text#{ παῖδες ματρὶ λόχευμα, μίασμα πατρός· }
urn:cts:greekLit:tlg0006.tlg015.fu.sp:817.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:817.1.text#{ ἣ δὲ συναίμονος ἐς λέχος ἦλθεν. }
urn:cts:greekLit:tlg0006.tlg015.fu.sp:818.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:818.1.text#ἔτεκες, ὦ Γαῖ', ἔτεκές ποτε,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:819.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:819.1.text#βάρβαρον ὡς ἀκοὰν ἐδάην ἐδάην ποτ' ἐν οἴκοις,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:820.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:820.1.text#τὰν ἀπὸ θηροτρόφου φοινικολόφοιο δράκοντος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:821.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:821.1.text#γένναν ὀδοντοφυῆ, Θήβαις κάλλιστον ὄνειδος·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:822.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:822.1.text#Ἁρμονίας δέ ποτ' εἰς ὑμεναίους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:823.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:823.1.text#ἤλυθον οὐρανίδαι, φόρμιγγί τε τείχεα Θήβας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:824.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:824.1.text#τᾶς Ἀμφιονίας τε λύρας ὕπο πύργος ἀνέστα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:825.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:825.1.text#διδύμων ποταμῶν πόρον ἀμφὶ μέσον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:826.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:826.1.text#Δίρκα χλοεροτρόφον ᾇ πεδίον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:827.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:827.1.text#πρόπαρ Ἰσμηνοῦ καταδεύει·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:828.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:828.1.text#Ἰώ θ', ἁ κερόεσσα προμάτωρ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:829.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:829.1.text#Καδμείων βασιλῆας ἐγείνατο,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:830.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:830.1.text#μυριάδας δ' ἀγαθῶν ἑτέροις ἑτέρας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:831.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:831.1.text#μεταμειβομένα πόλις ἅδ' ἐπ' ἄκροις ἕστακ'
urn:cts:greekLit:tlg0006.tlg015.fu.sp:832.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:832.1.text#Ἀρηΐοις στεφάνοισιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:834.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:834.1.text#ἡγοῦ πάροιθε, θύγατερ· ὡς τυφλῷ ποδὶ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:835.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:835.1.text#ὀφθαλμὸς εἶ σύ, ναυβάταισιν ἄστρον ὥς·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:836.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:836.1.text#δεῦρ' ἐς τὸ λευρὸν πέδον ἴχνος τιθεῖσ' ἐμόν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:837.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:837.1.text#πρόβαινε, μὴ σφαλῶμεν· ἀσθενὴς πατήρ·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:838.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:838.1.text#κλήρους τέ μοι φύλασσε παρθένῳ χερί,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:839.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:839.1.text#οὓς ἔλαβον οἰωνίσματ' ὀρνίθων μαθὼν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:840.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:840.1.text#θάκοισιν ἐν ἱεροῖσιν, οὗ μαντεύομαι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:841.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:841.1.text#τέκνον Μενοικεῦ, παῖ Κρέοντος, εἰπέ μοι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:842.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:842.1.text#πόση τις ἡ 'πίλοιπος ἄστεως ὁδὸς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:843.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:843.1.text#πρὸς πατέρα τὸν σόν· ὡς ἐμὸν κάμνει γόνυ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:844.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:844.1.text#πυκνὴν δὲ βαίνων ἤλυσιν μόλις περῶ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:845.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:845.1.text#θάρσει· πέλας γάρ, Τειρεσία, φίλοισι σοῖς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:846.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:846.1.text#ἐξώρμισαι σὸν πόδα· λαβοῦ δ' αὐτοῦ, τέκνον·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:847.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:847.1.text#ὡς πᾶσ' ἀπήνη πούς τε πρεσβύτου φιλεῖ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:848.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:848.1.text#χειρὸς θυραίας ἀναμένειν κουφίσματα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:849.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:849.1.text#εἶἑν, πάρεσμεν· τί με καλεῖς σπουδῇ, Κρέον;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:850.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:850.1.text#οὔπω λελήσμεθ'· ἀλλὰ σύλλεξαι σθένος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:851.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:851.1.text#καὶ πνεῦμ' ἄθροισον, αἶπος ἐκβαλὼν ὁδοῦ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:852.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:852.1.text#κόπῳ παρεῖμαι γοῦν Ἐρεχθειδῶν ἄπο
urn:cts:greekLit:tlg0006.tlg015.fu.sp:853.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:853.1.text#δεῦρ' ἐκκομισθεὶς τῆς πάροιθεν ἡμέρας·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:854.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:854.1.text#κἀκεῖ γὰρ ἦν τις πόλεμος Εὐμόλπου δορός,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:855.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:855.1.text#οὗ καλλινίκους Κεκροπίδας ἔθηκ' ἐγώ·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:856.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:856.1.text#καὶ τόνδε χρυσοῦν στέφανον, ὡς ὁρᾷς, ἔχω
urn:cts:greekLit:tlg0006.tlg015.fu.sp:857.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:857.1.text#λαβὼν ἀπαρχὰς πολεμίων σκυλευμάτων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:858.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:858.1.text#οἰωνὸν ἐθέμην καλλίνικα σὰ στέφη·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:859.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:859.1.text#ἐν γὰρ κλύδωνι κείμεθ', ὥσπερ οἶσθα σύ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:860.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:860.1.text#δορὸς Δαναϊδῶν, καὶ μέγας Θήβαις ἀγών.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:861.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:861.1.text#βασιλεὺς μὲν οὖν βέβηκε κοσμηθεὶς ὅπλοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:862.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:862.1.text#ἤδη πρὸς ἀλκὴν Ἐτεοκλῆς Μυκηνίδα·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:863.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:863.1.text#ἐμοὶ δ' ἐπέσταλκ' ἐκμαθεῖν σέθεν πάρα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:864.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:864.1.text#τί δρῶντες ἂν μάλιστα σώσαιμεν πόλιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:865.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:865.1.text#Ἐτεοκλέους μὲν οὕνεκ' ἂν κλῄσας στόμα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:866.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:866.1.text#χρησμοὺς ἐπέσχον· σοὶ δ', ἐπεὶ χρῄζεις μαθεῖν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:867.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:867.1.text#λέξω. νοσεῖ γὰρ ἥδε γῆ πάλαι, Κρέον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:868.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:868.1.text#ἐξ οὗ 'τεκνώθη Λάιος βίᾳ θεῶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:869.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:869.1.text#πόσιν τ' ἔφυσε μητρὶ μέλεον Οἰδίπουν·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:870.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:870.1.text#αἵ θ' αἱματωποὶ δεργμάτων διαφθοραὶ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:871.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:871.1.text#θεῶν σόφισμα κἀπίδειξις Ἑλλάδι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:872.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:872.1.text#ἃ συγκαλύψαι παῖδες Οἰδίπου χρόνῳ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:873.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:873.1.text#χρῄζοντες, ὡς δὴ θεοὺς ὑπεκδραμούμενοι,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:874.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:874.1.text#ἥμαρτον ἀμαθῶς· οὔτε γὰρ γέρα πατρὶ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:875.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:875.1.text#οὔτ' ἔξοδον διδόντες, ἄνδρα δυστυχῆ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:876.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:876.1.text#ἐξηγρίωσαν· ἐκ δ' ἔπνευσ' αὐτοῖς ἀρὰς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:877.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:877.1.text#δεινάς, νοσῶν τε καὶ πρὸς ἠτιμασμένος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:878.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:878.1.text#ἁγὼ τί { οὐ } δρῶν, ποῖα δ' οὐ λέγων ἔπη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:879.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:879.1.text#ἐς ἔχθος ἦλθον παισὶ τοῖσιν Οἰδίπου;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:880.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:880.1.text#ἐγγὺς δὲ θάνατος αὐτόχειρ αὐτοῖς, Κρέον·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:881.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:881.1.text#πολλοὶ δὲ νεκροὶ περὶ νεκροῖς πεπτωκότες
urn:cts:greekLit:tlg0006.tlg015.fu.sp:882.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:882.1.text#Ἀργεῖα καὶ Καδμεῖα μείξαντες βέλη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:883.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:883.1.text#πικροὺς γόους δώσουσι Θηβαίᾳ χθονί.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:884.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:884.1.text#σύ τ' ὦ τάλαινα συγκατασκάπτῃ πόλι,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:885.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:885.1.text#εἰ μὴ λόγοισι τοῖς ἐμοῖς τὶς πείσεται.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:886.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:886.1.text#ἐκεῖνο μὲν γὰρ πρῶτον ἦν, τῶν Οἰδίπου
urn:cts:greekLit:tlg0006.tlg015.fu.sp:887.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:887.1.text#μηδένα πολίτην μηδ' ἄνακτ' εἶναι χθονός,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:888.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:888.1.text#ὡς δαιμονῶντας κἀνατρέψοντας πόλιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:889.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:889.1.text#ἐπεὶ δὲ κρεῖσσον τὸ κακόν ἐστι τἀγαθοῦ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:890.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:890.1.text#μί' ἔστιν ἄλλη μηχανὴ σωτηρίας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:891.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:891.1.text#ἀλλ' — οὐ γὰρ εἰπεῖν οὔτ' ἐμοὶ τόδ' ἀσφαλὲς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:892.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:892.1.text#πικρόν τε τοῖσι τὴν τύχην κεκτημένοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:893.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:893.1.text#πόλει παρασχεῖν φάρμακον σωτηρίας —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:894.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:894.1.text#ἄπειμι. χαίρεθ'· εἷς γὰρ ὢν πολλῶν μέτα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:895.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:895.1.text#τὸ μέλλον, εἰ χρή, πείσομαι· τί γὰρ πάθω;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:896.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:896.1.text#ἐπίσχες αὐτοῦ, πρέσβυ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:896.2.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:896.2.text#μὴ 'πιλαμβάνου.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:897.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:897.1.text#μεῖνον, τί φεύγεις;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:897.2.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:897.2.text#ἡ τύχη σ', ἀλλ' οὐκ ἐγώ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:898.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:898.1.text#φράσον πολίταις καὶ πόλει σωτηρίαν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:899.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:899.1.text#βούλῃ σὺ μέντοι κοὐχὶ βουλήσῃ τάχα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:900.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:900.1.text#καὶ πῶς πατρῴαν γαῖαν οὐ σῷσαι θέλω;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:901.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:901.1.text#θέλεις ἀκοῦσαι δῆτα καὶ σπουδὴν ἔχεις;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:902.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:902.1.text#ἐς γὰρ τί μᾶλλον δεῖ προθυμίαν ἔχειν;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:903.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:903.1.text#κλύοις ἂν ἤδη τῶν ἐμῶν θεσπισμάτων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:904.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:904.1.text#πρῶτον δ' ἐκεῖνο βούλομαι σαφῶς μαθεῖν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:905.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:905.1.text#ποῦ 'στιν Μενοικεύς, ὅς με δεῦρ' ἐπήγαγεν;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:906.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:906.1.text#ὅδ' οὐ μακρὰν ἄπεστι, πλησίον δὲ σοῦ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:907.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:907.1.text#ἀπελθέτω νυν θεσφάτων ἐμῶν ἑκάς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:908.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:908.1.text#ἐμὸς πεφυκὼς παῖς ἃ δεῖ σιγήσεται.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:909.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:909.1.text#βούλῃ παρόντος δῆτά σοι τούτου φράσω;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:910.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:910.1.text#κλύων γὰρ ἂν τέρποιτο τῆς σωτηρίας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:911.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:911.1.text#ἄκουε δή νυν θεσφάτων ἐμῶν ὁδόν·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:912.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:912.1.text#[ ἃ δρῶντες ἂν σώσαιτε Καδμείων πόλιν ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:913.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:913.1.text#σφάξαι Μενοικέα τόνδε δεῖ σ' ὑπὲρ πάτρας,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:914.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:914.1.text#σὸν παῖδ', ἐπειδὴ τὴν τύχην αὐτὸς καλεῖς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:915.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:915.1.text#τί φῄς; τίν' εἶπας τόνδε μῦθον, ὦ γέρον;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:916.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:916.1.text#ἅπερ πέφυκε, ταῦτα κἀνάγκη σὲ δρᾶν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:917.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:917.1.text#ὦ πολλὰ λέξας ἐν βραχεῖ χρόνῳ κακά.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:918.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:918.1.text#σοί γ', ἀλλὰ πατρίδι μεγάλα καὶ σωτήρια.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:919.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:919.1.text#οὐκ ἔκλυον, οὐκ ἤκουσα· χαιρέτω πόλις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:920.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:920.1.text#ἁνὴρ ὅδ' οὐκέθ' αὑτός· ἐκνεύει πάλιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:921.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:921.1.text#χαίρων ἴθ'· οὐ γὰρ σῶν με δεῖ μαντευμάτων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:922.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:922.1.text#ἀπόλωλεν ἡ ἀλήθει', ἐπεὶ σὺ δυστυχεῖς;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:923.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:923.1.text#ὦ πρός σε γονάτων καὶ γερασμίου τριχὸς —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:924.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:924.1.text#τί προσπίτνεις με; δυσφύλακτ' αἰτῇ κακά.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:925.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:925.1.text#σίγα· πόλει δὲ τούσδε μὴ λέξῃς λόγους.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:926.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:926.1.text#ἀδικεῖν κελεύεις μ'· οὐ σιωπήσαιμεν ἄν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:927.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:927.1.text#τί δή με δράσεις; παῖδά μου κατακτενεῖς;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:928.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:928.1.text#ἄλλοις μελήσει ταῦτ', ἐμοὶ δ' εἰρήσεται.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:929.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:929.1.text#ἐκ τοῦ δ' ἐμοὶ τόδ' ἦλθε καὶ τέκνῳ κακόν;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:930.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:930.1.text#ὀρθῶς μ' ἐρωτᾷς κεἰς ἀγῶν' ἔρχῃ λόγων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:931.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:931.1.text#δεῖ τόνδε θαλάμαις, οὗ δράκων ὁ γηγενὴς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:932.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:932.1.text#ἐγένετο Δίρκης ναμάτων ἐπίσκοπος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:933.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:933.1.text#σφαγέντα φόνιον αἷμα γῇ δοῦναι χοὰς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:934.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:934.1.text#Κάδμου, παλαιῶν Ἄρεος ἐκ μηνιμάτων,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:935.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:935.1.text#ὃς γηγενεῖ δράκοντι τιμωρεῖ φόνον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:936.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:936.1.text#καὶ ταῦτα δρῶντες σύμμαχον κτήσεσθ' Ἄρη.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:937.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:937.1.text#χθὼν δ' ἀντὶ καρποῦ καρπὸν ἀντί θ' αἵματος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:938.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:938.1.text#αἷμ' ἢν λάβῃ βρότειον, ἕξετ' εὐμενῆ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:939.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:939.1.text#γῆν, ἥ ποθ' ἡμῖν χρυσοπήληκα στάχυν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:940.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:940.1.text#σπαρτῶν ἀνῆκεν· ἐκ γένους δὲ δεῖ θανεῖν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:941.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:941.1.text#τοῦδ', ὃς δράκοντος γένυος ἐκπέφυκε παῖς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:942.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:942.1.text#σὺ δ' ἐνθάδ' ἡμῖν λοιπὸς εἶ σπαρτῶν γένους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:943.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:943.1.text#ἀκέραιος, ἔκ τε μητρὸς ἀρσένων τ' ἄπο,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:944.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:944.1.text#οἱ σοί τε παῖδες. Αἵμονος μὲν οὖν γάμοι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:945.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:945.1.text#σφαγὰς ἀπείργουσ'. οὐ γάρ ἐστιν ᾔθεος·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:946.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:946.1.text#κεἰ μὴ γὰρ εὐνῆς ἥψατ', ἀλλ' ἔχει λέχος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:947.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:947.1.text#οὗτος δὲ πῶλος τῇδ' ἀνειμένος πόλει
urn:cts:greekLit:tlg0006.tlg015.fu.sp:948.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:948.1.text#θανὼν πατρῴαν γαῖαν ἐκσώσειεν ἄν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:949.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:949.1.text#πικρὸν δ' Ἀδράστῳ νόστον Ἀργείοισί τε
urn:cts:greekLit:tlg0006.tlg015.fu.sp:950.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:950.1.text#θήσει, μέλαιναν κῆρ' ἐπ' ὄμμασιν βαλών,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:951.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:951.1.text#κλεινάς τε Θήβας. τοῖνδ' ἑλοῦ δυοῖν πότμοιν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:952.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:952.1.text#τὸν ἕτερον· ἢ γὰρ παῖδα σῷσον ἢ πόλιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:953.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:953.1.text#τὰ μὲν παρ' ἡμῶν πάντ' ἔχεις· ἡγοῦ, τέκνον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:954.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:954.1.text#πρὸς οἶκον. ὅστις δ' ἐμπύρῳ χρῆται τέχνῃ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:955.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:955.1.text#μάταιος· ἢν μὲν ἐχθρὰ σημήνας τύχῃ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:956.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:956.1.text#πικρὸς καθέστηχ' οἷς ἂν οἰωνοσκοπῇ·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:957.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:957.1.text#ψευδῆ δ' ὑπ' οἴκτου τοῖσι χρωμένοις λέγων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:958.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:958.1.text#ἀδικεῖ τὰ τῶν θεῶν. Φοῖβον ἀνθρώποις μόνον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:959.1.speaker#Τειρεσίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:959.1.text#χρῆν θεσπιῳδεῖν, ὃς δέδοικεν οὐδένα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:960.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:960.1.text#Κρέον, τί σιγᾷς γῆρυν ἄφθογγον σχάσας;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:961.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:961.1.text#κἀμοὶ γὰρ οὐδὲν ἧσσον ἔκπληξις πάρα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:962.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:962.1.text#τί δ' ἄν τις εἴποι; δῆλον οἵ γ' ἐμοὶ λόγοι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:963.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:963.1.text#ἐγὼ γὰρ οὔποτ' ἐς τόδ' εἶμι συμφορᾶς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:964.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:964.1.text#ὥστε σφαγέντα παῖδα προσθεῖναι πόλει.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:965.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:965.1.text#πᾶσιν γὰρ ἀνθρώποισι φιλότεκνος βίος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:966.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:966.1.text#οὐδ' ἂν τὸν αὑτοῦ παῖδά τις δοίη κτανεῖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:967.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:967.1.text#μή μ' εὐλογείτω τἀμά τις κτείνων τέκνα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:968.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:968.1.text#αὐτὸς δ' — ἐν ὡραίῳ γὰρ ἕσταμεν βίου —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:969.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:969.1.text#θνῄσκειν ἕτοιμος πατρίδος ἐκλυτήριον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:970.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:970.1.text#ἀλλ' εἶα, τέκνον, πρὶν μαθεῖν πᾶσαν πόλιν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:971.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:971.1.text#ἀκόλαστ' ἐάσας μάντεων θεσπίσματα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:972.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:972.1.text#φεῦγ' ὡς τάχιστα τῆσδ' ἀπαλλαχθεὶς χθονός·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:973.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:973.1.text#λέξει γὰρ ἀρχαῖς καὶ στρατηλάταις τάδε,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:974.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:974.1.text#[ πύλας ἐφ' ἑπτὰ καὶ λοχαγέτας μολών· ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:975.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:975.1.text#κἂν μὲν φθάσωμεν, ἔστι σοι σωτηρία·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:976.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:976.1.text#ἢν δ' ὑστερήσῃς, οἰχόμεσθα, κατθανῇ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:977.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:977.1.text#ποῖ δῆτα φεύγω; τίνα πόλιν; τίνα ξένων;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:978.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:978.1.text#ὅπου χθονὸς τῆσδ' ἐκποδὼν μάλιστ' ἔσῃ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:979.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:979.1.text#οὐκοῦν σὲ φράζειν εἰκός, ἐκπονεῖν δ' ἐμέ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:980.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:980.1.text#Δελφοὺς περάσας —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:980.2.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:980.2.text#ποῖ με χρή, πάτερ, μολεῖν;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:981.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:981.1.text#Αἰτωλίδ' ἐς γῆν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:981.2.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:981.2.text#ἐκ δὲ τῆσδε ποῖ περῶ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:982.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:982.1.text#Θεσπρωτὸν οὖδας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:982.2.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:982.2.text#σεμνὰ Δωδώνης βάθρα;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:983.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:983.1.text#ἔγνως.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:983.2.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:983.2.text#τί δὴ τόδ' ἔρυμά μοι γενήσεται;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:984.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:984.1.text#πόμπιμος ὁ δαίμων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:984.2.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:984.2.text#χρημάτων δὲ τίς πόρος;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:985.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:985.1.text#ἐγὼ πορεύσω χρυσόν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:985.2.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:985.2.text#εὖ λέγεις, πάτερ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:986.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:986.1.text#χώρει νυν· ὡς σὴν πρὸς κασιγνήτην μολών,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:987.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:987.1.text#ἧς πρῶτα μαστὸν εἵλκυσ', Ἰοκάστην λέγω,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:988.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:988.1.text#μητρὸς στερηθεὶς ὀρφανός τ' ἀποζυγείς —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:989.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:989.1.text#[ προσηγορήσων εἶμι καὶ σῴσων βίον. ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:990.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:990.1.text#ἀλλ' εἶα, χώρει· μὴ τὸ σὸν κωλυέτω. —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:991.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:991.1.text#γυναῖκες, ὡς εὖ πατρὸς ἐξεῖλον φόβον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:992.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:992.1.text#κλέψας λόγοισιν, ὥσθ' ἃ βούλομαι τυχεῖν·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:993.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:993.1.text#ὅς μ' ἐκκομίζει, πόλιν ἀποστερῶν τύχης,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:994.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:994.1.text#καὶ δειλίᾳ δίδωσι. καὶ συγγνωστὰ μὲν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:995.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:995.1.text#γέροντι, τοὐμὸν δ' οὐχὶ συγγνώμην ἔχει,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:996.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:996.1.text#προδότην γενέσθαι πατρίδος ἥ μ' ἐγείνατο.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:997.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:997.1.text#ὡς οὖν ἂν εἰδῆτ', εἶμι καὶ σῴσω πόλιν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:998.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:998.1.text#ψυχήν τε δώσω τῆσδ' ὑπερθανεῖν χθονός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:999.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:999.1.text#αἰσχρὸν γάρ· οἱ μὲν θεσφάτων ἐλεύθεροι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1000.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1000.1.text#κοὐκ εἰς ἀνάγκην δαιμόνων ἀφιγμένοι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1001.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1001.1.text#στάντες παρ' ἀσπίδ' οὐκ ὀκνήσουσιν θανεῖν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1002.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1002.1.text#πύργων πάροιθε μαχόμενοι πάτρας ὕπερ·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1003.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1003.1.text#ἐγὼ δέ, πατέρα καὶ κασίγνητον προδοὺς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1004.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1004.1.text#πόλιν τ' ἐμαυτοῦ, δειλὸς ὣς ἔξω χθονὸς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1005.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1005.1.text#ἄπειμ'· ὅπου δ' ἂν ζῶ, κακὸς φανήσομαι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1006.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1006.1.text#μὰ τὸν μετ' ἄστρων Ζῆν' Ἄρη τε φοίνιον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1007.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1007.1.text#ὃς τοὺς ὑπερτείλαντας ἐκ γαίας ποτὲ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1008.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1008.1.text#Σπαρτοὺς ἄνακτας τῆσδε γῆς ἱδρύσατο.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1009.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1009.1.text#ἀλλ' εἶμι καὶ στὰς ἐξ ἐπάλξεων ἄκρων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1010.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1010.1.text#σφάξας ἐμαυτὸν σηκὸν ἐς μελαμβαθῆ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1011.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1011.1.text#δράκοντος, ἔνθ' ὁ μάντις ἐξηγήσατο,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1012.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1012.1.text#ἐλευθερώσω γαῖαν· εἴρηται λόγος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1013.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1013.1.text#στείχω δέ, θανάτου δῶρον οὐκ αἰσχρὸν πόλει
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1014.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1014.1.text#δώσων, νόσου δὲ τήνδ' ἀπαλλάξω χθόνα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1015.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1015.1.text#εἰ γὰρ λαβὼν ἕκαστος ὅ τι δύναιτό τις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1016.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1016.1.text#χρηστὸν διέλθοι τοῦτο κἀς κοινὸν φέροι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1017.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1017.1.text#πατρίδι, κακῶν ἂν αἱ πόλεις ἐλασσόνων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1018.1.speaker#Μενοικεύς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1018.1.text#πειρώμεναι τὸ λοιπὸν εὐτυχοῖεν ἄν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1019.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1019.1.text#ἔβας ἔβας,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1019.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1019.2.text#ὦ πτεροῦσσα, γᾶς λόχευμα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1020.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1020.1.text#νερτέρου τ' Ἐχίδνας,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1021.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1021.1.text#Καδμείων ἁρπαγά,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1022.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1022.1.text#πολύφθορος πολύστονος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1023.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1023.1.text#μειξοπάρθενος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1023.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1023.2.text#δάιον τέρας,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1024.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1024.1.text#φοιτάσι πτεροῖς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1025.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1025.1.text#χαλαῖσί τ' ὠμοσίτοις·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1026.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1026.1.text#Διρκαίων ἅ ποτ' ἐκ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1027.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1027.1.text#τόπων νέους πεδαίρουσ'
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1028.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1028.1.text#ἄλυρον ἀμφὶ μοῦσαν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1029.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1029.1.text#ὀλομέναν τ' Ἐρινὺν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1030.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1030.1.text#ἔφερες ἔφερες ἄχεα πατρίδι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1031.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1031.1.text#φόνια· φόνιος ἐκ θεῶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1032.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1032.1.text#ὃς τάδ' ἦν ὁ πράξας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1033.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1033.1.text#ἰάλεμοι δὲ ματέρων,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1034.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1034.1.text#ἰάλεμοι δὲ παρθένων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1035.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1035.1.text#ἐστέναζον οἴκοις·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1036.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1036.1.text#ἰηιήιον βοάν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1037.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1037.1.text#ἰηιήιον μέλος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1038.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1038.1.text#ἄλλος ἄλλ' ἐπωτότυζε
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1038.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1038.2.text#διαδοχαῖς ἀνὰ πτόλιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1039.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1039.1.text#βροντᾷ δὲ στεναγμὸς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1040.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1040.1.text#ἀχά τ' ἦν ὅμοιος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1041.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1041.1.text#ὁπότε πόλεος ἀφανίσειεν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1042.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1042.1.text#ἁ πτεροῦσσα παρθένος τιν' ἀνδρῶν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1043.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1043.1.text#χρόνῳ δ' ἔβα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1043.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1043.2.text#Πυθίαις ἀποστολαῖσιν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1044.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1044.1.text#Οἰδίπους ὁ τλάμων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1045.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1045.1.text#Θηβαίαν τάνδε γᾶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1046.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1046.1.text#τότ' ἀσμένοις, πάλιν δ' ἄχη·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1047.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1047.1.text#ματρὶ γὰρ γάμους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1048.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1048.1.text#δυσγάμους τάλας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1049.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1049.1.text#καλλίνικος ὢν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1049.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1049.2.text#αἰνιγμάτων συνάπτει,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1050.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1050.1.text#μιαίνει δὲ πτόλιν·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1051.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1051.1.text#δι' αἱμάτων δ' ἀμείβει
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1052.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1052.1.text#μυσαρὸν εἰς ἀγῶνα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1053.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1053.1.text#καταβαλὼν ἀραῖσι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1054.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1054.1.text#τέκεα μέλεος. ἀγάμεθ' ἀγάμεθ',
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1055.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1055.1.text#ὃς ἐπὶ θάνατον οἴχεται
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1056.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1056.1.text#γᾶς ὑπὲρ πατρῴας,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1057.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1057.1.text#Κρέοντι μὲν λιπὼν γόους,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1058.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1058.1.text#τὰ δ' ἑπτάπυργα κλῇθρα γᾶς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1059.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1059.1.text#καλλίνικα θήσων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1060.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1060.1.text#γενοίμεθ' ὧδε ματέρες
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1061.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1061.1.text#γενοίμεθ' εὔτεκνοι, φίλα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1062.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1062.1.text#Παλλάς, ἃ δράκοντος αἷμα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1063.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1063.1.text#λιθόβολον κατειργάσω,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1064.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1064.1.text#Καδμείαν μέριμναν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1064.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1064.2.text#ὁρμήσασ' ἐπ' ἔργον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1065.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1065.1.text#ὅθεν ἐπέσυτο τάνδε γαῖαν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1066.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1066.1.text#ἁρπαγαῖσι δαιμόνων τις ἄτα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1067.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1067.1.text#ὠή, τίς ἐν πύλαισι δωμάτων κυρεῖ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1068.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1068.1.text#ἀνοίγετ'· ἐκπορεύετ' Ἰοκάστην δόμων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1069.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1069.1.text#ὠὴ μάλ' αὖθις· διὰ μακροῦ μέν, ἀλλ' ὅμως
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1070.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1070.1.text#ἔξελθ', ἄκουσον, Οἰδίπου κλεινὴ δάμαρ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1071.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1071.1.text#λήξασ' ὀδυρμῶν πενθίμων τε δακρύων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1072.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1072.1.text#ὦ φίλτατ', οὔ που ξυμφορὰν ἥκεις φέρων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1073.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1073.1.text#Ἐτεοκλέους θανόντος, οὗ παρ' ἀσπίδα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1074.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1074.1.text#βέβηκας αἰεὶ πολεμίων εἴργων βέλη;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1075.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1075.1.text#[ τί μοί ποθ' ἥκεις καινὸν ἀγγελῶν ἔπος; ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1076.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1076.1.text#τέθνηκεν ἢ ζῇ παῖς ἐμός; σήμαινέ μοι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1077.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1077.1.text#ζῇ, μὴ τρέσῃς τόδ', ὥς { σ' } ἀπαλλάξω φόβου.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1078.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1078.1.text#τί δ'; ἑπτάπυργοι πῶς ἔχουσι περιβολαί;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1079.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1079.1.text#ἑστᾶσ' ἄθραυστοι, κοὐκ ἀνήρπασται πόλις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1080.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1080.1.text#ἦλθον δὲ πρὸς κίνδυνον Ἀργείου δορός;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1081.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1081.1.text#ἀκμήν γ' ἐπ' αὐτήν· ἀλλ' ὁ Καδμείων Ἄρης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1082.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1082.1.text#κρείσσων κατέστη τοῦ Μυκηναίου δορός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1083.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1083.1.text#ἓν εἰπὲ πρὸς θεῶν, εἴ τι Πολυνείκους πέρι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1084.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1084.1.text#οἶσθ'· ὡς μέλει μοι καὶ τόδ', εἰ λεύσσει φάος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1085.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1085.1.text#ζῇ σοι ξυνωρὶς ἐς τόδ' ἡμέρας τέκνων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1086.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1086.1.text#εὐδαιμονοίης. πῶς γὰρ Ἀργείων δόρυ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1087.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1087.1.text#πυλῶν ἀπεστήσασθε πυργηρούμενοι;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1088.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1088.1.text#λέξον, γέροντα τυφλὸν ὡς κατὰ στέγας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1089.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1089.1.text#ἐλθοῦσα τέρψω, τῆσδε γῆς σεσῳσμένης.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1090.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1090.1.text#ἐπεὶ Κρέοντος παῖς ὁ γῆς ὑπερθανὼν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1091.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1091.1.text#πύργων ἐπ' ἄκρων στὰς μελάνδετον ξίφος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1092.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1092.1.text#λαιμῶν διῆκε τῇδε γῇ σωτήριον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1093.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1093.1.text#λόχους ἔνειμεν ἑπτὰ καὶ λοχαγέτας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1094.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1094.1.text#πύλας ἐφ' ἑπτά, φύλακας Ἀργείου δορός,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1095.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1095.1.text#σὸς παῖς, ἐφέδρους { δ' } ἱππότας μὲν ἱππόταις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1096.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1096.1.text#ἔταξ', ὁπλίτας δ' ἀσπιδηφόροις ἔπι,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1097.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1097.1.text#ὡς τῷ νοσοῦντι τειχέων εἴη δορὸς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1098.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1098.1.text#ἀλκὴ δι' ὀλίγου. περγάμων δ' ἀπ' ὀρθίων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1099.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1099.1.text#λεύκασπιν εἰσορῶμεν Ἀργείων στρατὸν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1100.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1100.1.text#Τευμησὸν ἐκλιπόντα, καὶ τάφρου πέλας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1101.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1101.1.text#δρόμῳ ξυνῆψαν ἄστυ Καδμείας χθονός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1102.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1102.1.text#παιὰν δὲ καὶ σάλπιγγες ἐκελάδουν ὁμοῦ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1103.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1103.1.text#ἐκεῖθεν ἔκ τε τειχέων ἡμῶν πάρα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1104.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1104.1.text#καὶ πρῶτα μὲν προσῆγε Νηίταις πύλαις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1105.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1105.1.text#λόχον πυκναῖσιν ἀσπίσιν πεφρικότα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1106.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1106.1.text#ὁ τῆς κυναγοῦ Παρθενοπαῖος ἔκγονος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1107.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1107.1.text#ἐπίσημ' ἔχων οἰκεῖον ἐν μέσῳ σάκει,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1108.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1108.1.text#ἑκηβόλοις τόξοισιν Ἀταλάντην κάπρον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1109.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1109.1.text#χειρουμένην Αἰτωλόν. ἐς δὲ Προιτίδας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1110.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1110.1.text#πύλας ἐχώρει σφάγι' ἔχων ἐφ' ἅρματι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1111.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1111.1.text#ὁ μάντις Ἀμφιάραος, οὐ σημεῖ' ἔχων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1112.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1112.1.text#ὑβρισμέν', ἀλλὰ σωφρόνως ἄσημ' ὅπλα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1113.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1113.1.text#Ὠγύγια δ' ἐς πυλώμαθ' Ἱππομέδων ἄναξ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1114.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1114.1.text#ἔστειχ' ἔχων σημεῖον ἐν μέσῳ σάκει
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1115.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1115.1.text#στικτοῖς Πανόπτην ὄμμασιν δεδορκότα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1116.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1116.1.text#τὰ μὲν σὺν ἄστρων ἐπιτολαῖσιν ὄμματα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1117.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1117.1.text#βλέποντα, τὰ δὲ κρύπτοντα δυνόντων μέτα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1118.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1118.1.text#ὡς ὕστερον θανόντος εἰσορᾶν παρῆν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1119.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1119.1.text#Ὁμολωίσιν δὲ τάξιν εἶχε πρὸς πύλαις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1120.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1120.1.text#Τυδεύς, λέοντος δέρος ἔχων ἐπ' ἀσπίδι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1121.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1121.1.text#χαίτῃ πεφρικός· δεξιᾷ δὲ λαμπάδα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1122.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1122.1.text#Τιτὰν Προμηθεὺς ἔφερεν ὡς πρήσων πόλιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1123.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1123.1.text#ὁ σὸς δὲ Κρηναίαισι Πολυνείκης πύλαις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1124.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1124.1.text#Ἄρη προσῆγε· Ποτνιάδες δ' ἐπ' ἀσπίδι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1125.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1125.1.text#ἐπίσημα πῶλοι δρομάδες ἐσκίρτων φόβῳ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1126.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1126.1.text#εὖ πως στρόφιγξιν ἔνδοθεν κυκλούμεναι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1127.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1127.1.text#πόρπαχ' ὑπ' αὐτόν, ὥστε μαίνεσθαι δοκεῖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1128.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1128.1.text#ὁ δ' οὐκ ἔλασσον Ἄρεος ἐς μάχην φρονῶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1129.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1129.1.text#Καπανεὺς προσῆγε λόχον ἐπ' Ἠλέκτραις πύλαις·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1130.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1130.1.text#σιδηρονώτοις δ' ἀσπίδος τύποις ἐπῆν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1131.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1131.1.text#γίγας ἐπ' ὤμοις γηγενὴς ὅλην πόλιν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1132.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1132.1.text#φέρων μοχλοῖσιν ἐξανασπάσας βάθρων,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1133.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1133.1.text#ὑπόνοιαν ἡμῖν οἷα πείσεται πόλις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1134.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1134.1.text#ταῖς δ' ἑβδόμαις Ἄδραστος ἐν πύλαισιν ἦν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1135.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1135.1.text#ἑκατὸν ἐχίδναις ἀσπίδ' ἐκπληρῶν γραφῇ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1136.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1136.1.text#[ ὕδρας ἔχων λαιοῖσιν ἐν βραχίοσιν ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1137.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1137.1.text#Ἀργεῖον αὔχημ'· ἐκ δὲ τειχέων μέσων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1138.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1138.1.text#δράκοντες ἔφερον τέκνα Καδμείων γνάθοις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1139.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1139.1.text#παρῆν δ' ἑκάστου τῶνδέ μοι θεάματα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1140.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1140.1.text#ξύνθημα παρφέροντι ποιμέσιν λόχων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1141.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1141.1.text#καὶ πρῶτα μὲν τόξοισι καὶ μεσαγκύλοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1142.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1142.1.text#ἐμαρνάμεσθα σφενδόναις θ' ἑκηβόλοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1143.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1143.1.text#πετρῶν τ' ἀραγμοῖς· ὡς δ' ἐνικῶμεν μάχῃ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1144.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1144.1.text#ἔκλαγξε Τυδεὺς καὶ σὸς ἐξαίφνης γόνος·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1145.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1145.1.text#ὦ τέκνα Δαναῶν, πρὶν κατεξάνθαι βολαῖς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1146.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1146.1.text#τί μέλλετ' ἄρδην πάντες ἐμπίπτειν πύλαις,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1147.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1147.1.text#γυμνῆτες ἱππῆς ἁρμάτων τ' ἐπιστάται;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1148.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1148.1.text#ἠχῆς δ' ὅπως ἤκουσαν, οὔτις ἀργὸς ἦν·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1149.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1149.1.text#πολλοὶ δ' ἔπιπτον κρᾶτας αἱματούμενοι,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1150.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1150.1.text#ἡμῶν τ' ἐς οὖδας εἶδες ἂν πρὸ τειχέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1151.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1151.1.text#πυκνοὺς κυβιστητῆρας ἐκπεπνευκότας·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1152.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1152.1.text#ξηρὰν δ' ἔδευον γαῖαν αἵματος ῥοαῖς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1153.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1153.1.text#ὁ δ' Ἀρκάς, οὐκ Ἀργεῖος, Ἀταλάντης γόνος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1154.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1154.1.text#τυφὼς πύλαισιν ὥς τις ἐμπεσὼν βοᾷ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1155.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1155.1.text#πῦρ καὶ δικέλλας, ὡς κατασκάψων πόλιν·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1156.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1156.1.text#ἀλλ' ἔσχε μαργῶντ' αὐτὸν ἐναλίου θεοῦ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1157.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1157.1.text#Περικλύμενος παῖς λᾶαν ἐμβαλὼν κάρᾳ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1158.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1158.1.text#ἁμαξοπληθῆ, γεῖσ' ἐπάλξεων ἄπο·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1159.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1159.1.text#ξανθὸν δὲ κρᾶτα διεπάλυνε καὶ ῥαφὰς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1160.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1160.1.text#ἔρρηξεν ὀστέων, ἄρτι δ' οἰνωπὸν γένυν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1161.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1161.1.text#καθῃμάτωσεν· οὐδ' ἀποίσεται βίον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1162.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1162.1.text#τῇ καλλιτόξῳ μητρὶ Μαινάλου κόρῃ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1163.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1163.1.text#ἐπεὶ δὲ τάσδ' ἐσεῖδεν εὐτυχεῖς πύλας,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1164.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1164.1.text#ἄλλας ἐπῄει παῖς σός, εἱπόμην δ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1165.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1165.1.text#ὁρῶ δὲ Τυδέα καὶ παρασπιστὰς πυκνοὺς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1166.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1166.1.text#Αἰτωλίσιν λόγχαισιν εἰς ἄκρον στόμα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1167.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1167.1.text#πύργων ἀκοντίζοντας, ὥστ' ἐπάλξεων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1168.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1168.1.text#λιπεῖν ἐρίπνας φυγάδας· ἀλλά νιν πάλιν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1169.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1169.1.text#κυναγὸς ὡσεὶ παῖς σὸς ἐξαθροίζεται,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1170.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1170.1.text#πύργοις δ' ἐπέστησ' αὖθις. ἐς δ' ἄλλας πύλας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1171.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1171.1.text#ἠπειγόμεσθα, τοῦτο παύσαντες νοσοῦν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1172.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1172.1.text#Καπανεὺς δὲ πῶς εἴποιμ' ἂν ὡς ἐμαίνετο;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1173.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1173.1.text#μακραύχενος γὰρ κλίμακος προσαμβάσεις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1174.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1174.1.text#ἔχων ἐχώρει, καὶ τοσόνδ' ἐκόμπασε,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1175.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1175.1.text#μηδ' ἂν τὸ σεμνὸν πῦρ νιν εἰργαθεῖν Διὸς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1176.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1176.1.text#τὸ μὴ οὐ κατ' ἄκρων περγάμων ἑλεῖν πόλιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1177.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1177.1.text#καὶ ταῦθ' ἅμ' ἠγόρευε καὶ πετρούμενος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1178.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1178.1.text#ἀνεῖρφ' ὑπ' αὐτὴν ἀσπίδ' εἱλίξας δέμας,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1179.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1179.1.text#κλίμακος ἀμείβων ξέστ' ἐνηλάτων βάθρα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1180.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1180.1.text#ἤδη δ' ὑπερβαίνοντα γεῖσα τειχέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1181.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1181.1.text#βάλλει κεραυνῷ Ζεύς νιν· ἐκτύπησε δὲ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1182.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1182.1.text#χθών, ὥστε δεῖσαι πάντας· ἐκ δὲ κλιμάκων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1183.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1183.1.text#[ ἐσφενδονᾶτο χωρὶς ἀλλήλων μέλη, ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1184.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1184.1.text#[ κόμαι μὲν εἰς Ὄλυμπον, αἷμα δ' ἐς χθόνα, ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1185.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1185.1.text#[ χεῖρες δὲ καὶ κῶλ' ὡς κύκλωμ' Ἰξίονος ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1186.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1186.1.text#εἱλίσσετ'· ἐς γῆν δ' ἔμπυρος πίπτει νεκρός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1187.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1187.1.text#ὡς δ' εἶδ' Ἄδραστος Ζῆνα πολέμιον στρατῷ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1188.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1188.1.text#ἔξω τάφρου καθῖσεν Ἀργείων στρατόν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1189.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1189.1.text#οἱ δ' αὖ παρ' ἡμῶν δεξιὸν Διὸς τέρας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1190.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1190.1.text#ἰδόντες ἐξήλαυνον ἁρμάτων ὄχους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1191.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1191.1.text#ἱππῆς ὁπλῖται, κἀς μέσ' Ἀργείων ὅπλα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1192.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1192.1.text#συνῆψαν ἔγχη· πάντα δ' ἦν ὁμοῦ κακά·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1193.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1193.1.text#ἔθνῃσκον ἐξέπιπτον ἀντύγων ἄπο,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1194.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1194.1.text#τροχοί τ' ἐπήδων ἄξονές τ' ἐπ' ἄξοσι,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1195.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1195.1.text#νεκροὶ δὲ νεκροῖς ἐξεσωρεύονθ' ὁμοῦ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1196.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1196.1.text#πύργων μὲν οὖν γῆς ἔσχομεν κατασκαφὰς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1197.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1197.1.text#ἐς τὴν παροῦσαν ἡμέραν· εἰ δ' εὐτυχὴς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1198.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1198.1.text#ἔσται τὸ λοιπὸν ἥδε γῆ, θεοῖς μέλει·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1199.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1199.1.text#καὶ νῦν γὰρ αὐτὴν δαιμόνων ἔσῳσέ τις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1200.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1200.1.text#καλὸν τὸ νικᾶν· εἰ δ' ἀμείνον' οἱ θεοὶ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1201.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1201.1.text#γνώμην ἔχουσιν — εὐτυχὴς εἴην ἐγώ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1202.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1202.1.text#καλῶς τὰ τῶν θεῶν καὶ τὰ τῆς τύχης ἔχει·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1203.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1203.1.text#παῖδές τε γάρ μοι ζῶσι κἀκπέφευγε γῆ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1204.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1204.1.text#Κρέων δ' ἔοικε τῶν ἐμῶν νυμφευμάτων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1205.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1205.1.text#τῶν τ' Οἰδίπου δύστηνος ἀπολαῦσαι κακῶν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1206.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1206.1.text#παιδὸς στερηθείς, τῇ πόλει μὲν εὐτυχῶς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1207.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1207.1.text#ἰδίᾳ δὲ λυπρῶς. ἀλλ' ἄνελθέ μοι πάλιν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1208.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1208.1.text#τί τἀπὶ τούτοις παῖδ' ἐμὼ δρασείετον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1209.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1209.1.text#ἔα τὰ λοιπά· δεῦρ' ἀεὶ γὰρ εὐτυχεῖς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1210.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1210.1.text#τοῦτ' εἰς ὕποπτον εἶπας· οὐκ ἐατέον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1211.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1211.1.text#μεῖζον τί χρῄζεις παῖδας ἢ σεσῳσμένους;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1212.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1212.1.text#καὶ τἀπίλοιπά γ' εἰ καλῶς πράσσω κλύειν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1213.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1213.1.text#μέθες μ'· ἔρημος παῖς ὑπασπιστοῦ σέθεν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1214.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1214.1.text#κακόν τι κεύθεις καὶ στέγεις ὑπὸ σκότῳ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1215.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1215.1.text#κοὐκ ἄν γε λέξαιμ' ἐπ' ἀγαθοῖσι σοῖς κακά.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1216.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1216.1.text#ἢν μή γε φεύγων ἐκφύγῃς πρὸς αἰθέρα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1217.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1217.1.text#αἰαῖ· τί μ' οὐκ εἴασας ἐξ εὐαγγέλου
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1218.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1218.1.text#φήμης ἀπελθεῖν, ἀλλὰ μηνῦσαι κακά;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1219.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1219.1.text#τὼ παῖδε τὼ σὼ μέλλετον, τολμήματα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1220.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1220.1.text#αἴσχιστα, χωρὶς μονομαχεῖν παντὸς στρατοῦ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1221.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1221.1.text#λέξαντες Ἀργείοισι Καδμείοισί τε
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1222.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1222.1.text#ἐς κοινὸν οἷον μήποτ' ὤφελον λόγον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1223.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1223.1.text#Ἐτεοκλέης δ' ὑπῆρξ' ἀπ' ὀρθίου σταθεὶς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1224.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1224.1.text#πύργου, κελεύσας σῖγα κηρῦξαι στρατῷ·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1225.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1225.1.text#[ ἔλεξε δ'· ὦ γῆς Ἑλλάδος στρατηλάται ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1226.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1226.1.text#Δαναῶν ἀριστῆς, οἵπερ ἤλθετ' ἐνθάδε,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1227.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1227.1.text#Κάδμου τε λαός, μήτε Πολυνείκους χάριν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1228.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1228.1.text#ψυχὰς ἀπεμπολᾶτε μήθ' ἡμῶν ὕπερ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1229.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1229.1.text#ἐγὼ γὰρ αὐτὸς τόνδε κίνδυνον μεθεὶς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1230.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1230.1.text#μόνος συνάψω συγγόνῳ τὠμῷ μάχην·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1231.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1231.1.text#κἂν μὲν κτάνω τόνδ', οἶκον οἰκήσω μόνος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1232.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1232.1.text#ἡσσώμενος δὲ τῷδε παραδώσω μόνῳ·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1233.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1233.1.text#ὑμεῖς δ' ἀγῶν' ἀφέντες, Ἀργεῖοι, χθόνα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1234.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1234.1.text#νίσεσθε, βίοτον μὴ λιπόντες ἐνθάδε,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1235.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1235.1.text#Σπαρτῶν τε λαὸς ἅλις ὅσος κεῖται νεκρός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1236.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1236.1.text#τοσαῦτ' ἔλεξε· σὸς δὲ Πολυνείκης γόνος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1237.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1237.1.text#ἐκ τάξεων ὤρουσε κἀπῄνει λόγους.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1238.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1238.1.text#πάντες δ' ἐπερρόθησαν Ἀργεῖοι τάδε
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1239.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1239.1.text#Κάδμου τε λαὸς ὡς δίκαι' ἡγούμενοι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1240.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1240.1.text#ἐπὶ τοῖσδε δ' ἐσπείσαντο, κἀν μεταιχμίοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1241.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1241.1.text#ὅρκους συνῆψαν ἐμμενεῖν στρατηλάται.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1242.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1242.1.text#ἤδη δ' ἔκρυπτον σῶμα παγχάλκοις ὅπλοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1243.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1243.1.text#δισσοὶ γέροντος Οἰδίπου νεανίαι·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1244.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1244.1.text#φίλοι δ' ἐκόσμουν, τῆσδε μὲν πρόμον χθονὸς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1245.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1245.1.text#Σπαρτῶν ἀριστῆς, τὸν δὲ Δαναϊδῶν ἄκροι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1246.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1246.1.text#ἔσταν δὲ λαμπρὼ χρῶμά τ' οὐκ ἠλλαξάτην
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1247.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1247.1.text#μαργῶντ' ἐπ' ἀλλήλοισιν ἱέναι δόρυ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1248.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1248.1.text#παρεξιόντες δ' ἄλλος ἄλλοθεν φίλων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1249.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1249.1.text#λόγοις ἐθάρσυνόν τε κἀξηύδων τάδε·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1250.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1250.1.text#Πολύνεικες, ἐν σοὶ Ζηνὸς ὀρθῶσαι βρέτας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1251.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1251.1.text#τρόπαιον Ἄργει τ' εὐκλεᾶ δοῦναι λόγον·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1252.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1252.1.text#Ἐτεοκλέα δ' αὖ· νῦν πόλεως ὑπερμαχεῖς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1253.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1253.1.text#νῦν καλλίνικος γενόμενος σκήπτρων κρατεῖς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1254.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1254.1.text#τάδ' ἠγόρευον παρακαλοῦντες ἐς μάχην.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1255.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1255.1.text#μάντεις δὲ μῆλ' ἔσφαζον, ἐμπύρους τ' ἀκμὰς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1256.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1256.1.text#ῥήξεις τ' ἐνώμων ὑγρότητ' ἐναντίαν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1257.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1257.1.text#ἄκραν τε λαμπάδ', ἣ δυοῖν ὅρους ἔχει,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1258.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1258.1.text#νίκης τε σῆμα καὶ τὸ τῶν ἡσσωμένων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1259.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1259.1.text#ἀλλ', εἴ τιν' ἀλκὴν ἢ σοφοὺς ἔχεις λόγους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1260.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1260.1.text#ἢ φίλτρ' ἐπῳδῶν, στεῖχ', ἐρήτυσον τέκνα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1261.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1261.1.text#δεινῆς ἁμίλλης· ὡς ὁ κίνδυνος μέγας·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1262.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1262.1.text#κἄπαθλα δεινὰ δάκρυά σοι γενήσεται
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1263.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1263.1.text#δισσοῖν στερείσῃ τῇδ' ἐν ἡμέρᾳ τέκνοιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1264.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1264.1.text#ὦ τέκνον ἔξελθ' Ἀντιγόνη δόμων πάρος·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1265.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1265.1.text#οὐκ ἐν χορείαις οὐδὲ παρθενεύμασι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1266.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1266.1.text#νῦν σοι προχωρεῖ δαιμόνων κατάστασις,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1267.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1267.1.text#ἀλλ' ἄνδρ' ἀρίστω καὶ κασιγνήτω σέθεν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1268.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1268.1.text#ἐς θάνατον ἐκνεύοντε κωλῦσαί σε δεῖ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1269.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1269.1.text#ξὺν μητρὶ τῇ σῇ μὴ πρὸς ἀλλήλοιν θανεῖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1270.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1270.1.text#τίν', ὦ τεκοῦσα μῆτερ, ἔκπληξιν νέαν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1271.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1271.1.text#φίλοις ἀυτεῖς τῶνδε δωμάτων πάρος;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1272.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1272.1.text#ὦ θύγατερ, ἔρρει σῶν κασιγνήτων βίος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1273.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1273.1.text#πῶς εἶπας;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1273.2.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1273.2.text#αἰχμὴν ἐς μίαν καθέστατον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1274.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1274.1.text#οἲ 'γώ, τί λέξεις, μῆτερ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1274.2.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1274.2.text#οὐ φίλ', ἀλλ' ἕπου.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1275.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1275.1.text#ποῖ, παρθενῶνας ἐκλιποῦσ';
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1275.2.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1275.2.text#ἀνὰ στρατόν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1276.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1276.1.text#αἰδούμεθ' ὄχλον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1276.2.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1276.2.text#οὐκ ἐν αἰσχύνῃ τὰ σά.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1277.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1277.1.text#δράσω δὲ δὴ τί;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1277.2.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1277.2.text#συγγόνων λύσεις ἔριν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1278.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1278.1.text#τί δρῶσα, μῆτερ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1278.2.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1278.2.text#προσπίτνουσ' ἐμοῦ μέτα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1279.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1279.1.text#ἡγοῦ σὺ πρὸς μεταίχμι'· οὐ μελλητέον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1280.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1280.1.text#ἔπειγ' ἔπειγε, θύγατερ· ὡς, ἢν μὲν φθάσω
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1281.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1281.1.text#παῖδας πρὸ λόγχης, οὑμὸς ἐν φάει βίος·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1283.1.speaker#Ἰοκάστη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1283.1.text#θανοῦσι δ' αὐτοῖς συνθανοῦσα κείσομαι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1284.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1284.1.text#αἰαῖ αἰαῖ, τρομερὰν φρίκᾳ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1285.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1285.1.text#τρομερὰν φρέν' ἔχω· διὰ σάρκα δ' ἐμὰν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1286.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1286.1.text#ἔλεος ἔλεος ἔμολε ματέρος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1287.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1287.1.text#δειλαίας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1288.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1288.1.text#δίδυμα τέκεα πότερος ἄρα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1289.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1289.1.text#πότερον αἱμάξει —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1290.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1290.1.text#ἰώ μοι πόνων, ἰὼ Ζεῦ, ἰὼ γᾶ —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1291.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1291.1.text#ὁμογενῆ δέραν, ὁμογενῆ ψυχὰν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1292.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1292.1.text#δι' ἀσπίδων, δι' αἱμάτων;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1294.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1294.1.text#τάλαιν' ἐγὼ τάλαινα, πότερον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1295.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1295.1.text#ἄρα νέκυν ὀλόμενον ἰαχήσω;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1296.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1296.1.text#φεῦ δᾶ φεῦ δᾶ, δίδυμοι θῆρες,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1297.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1297.1.text#φόνιαι ψυχαὶ δορὶ παλλόμεναι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1298.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1298.1.text#πέσεα πέσεα δάι' αὐτίχ'
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1299.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1299.1.text#αἱμάξετον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1300.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1300.1.text#τάλανες, ὅ τι ποτὲ μονομάχον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1301.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1301.1.text#ἐπὶ φρέν' ἠλθέτην,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1302.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1302.1.text#βοᾷ βαρβάρῳ στενακτὰν ἰαχὰν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1303.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1303.1.text#μελομέναν νεκροῖς δάκρυσι θρηνήσω.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1304.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1304.1.text#σχεδὸν τύχα πέλας φόνου·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1305.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1305.1.text#κρινεῖ φάος τὸ μέλλον. ἄποτμος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1306.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1306.1.text#ἄποτμος ὁ φόνος ἕνεκ' Ἐρινύων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1307.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1307.1.text#ἀλλὰ γὰρ Κρέοντα λεύσσω τόνδε δεῦρο συννεφῆ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1308.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1308.1.text#πρὸς δόμους στείχοντα, παύσω τοὺς παρεστῶτας γόους.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1310.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1310.1.text#οἴμοι, τί δράσω; πότερ' ἐμαυτὸν ἢ πόλιν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1311.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1311.1.text#στένω δακρύσας, ἣν πέριξ ἔχει νέφος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1312.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1312.1.text#[ τοιοῦτον ὥστε δι' Ἀχέροντος ἱέναι; ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1313.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1313.1.text#ἐμός τε γὰρ παῖς γῆς ὄλωλ' ὑπερθανών,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1314.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1314.1.text#τοὔνομα λαβὼν γενναῖον, ἀνιαρὸν δ' ἐμοί·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1315.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1315.1.text#ὃν ἄρτι κρημνῶν ἐκ δρακοντείων ἑλὼν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1316.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1316.1.text#αὐτοσφαγῆ δύστηνος ἐκόμισ' ἐν χεροῖν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1317.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1317.1.text#βοᾷ δὲ δῶμα πᾶν· ἐγὼ δ' ἥκω μέτα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1318.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1318.1.text#γέρων ἀδελφὴν γραῖαν Ἰοκάστην, ὅπως
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1319.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1319.1.text#λούσῃ προθῆταί τ' οὐκέτ' ὄντα παῖδ' ἐμόν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1320.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1320.1.text#τοῖς γὰρ θανοῦσι χρὴ τὸν οὐ τεθνηκότα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1321.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1321.1.text#τιμὰς διδόντα χθόνιον εὐσεβεῖν θεόν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1322.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1322.1.text#βέβηκ' ἀδελφὴ σή, Κρέων, ἔξω δόμων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1323.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1323.1.text#κόρη τε μητρὸς Ἀντιγόνη κοινῷ ποδί.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1324.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1324.1.text#ποῖ; κἀπὶ ποίαν συμφοράν; σήμαινέ μοι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1325.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1325.1.text#ἤκουσε τέκνα μονομάχῳ μέλλειν δορὶ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1326.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1326.1.text#ἐς ἀσπίδ' ἥξειν βασιλικῶν δόμων ὕπερ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1327.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1327.1.text#πῶς φῄς; νέκυν τοι παιδὸς ἀγαπάζων ἐμοῦ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1328.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1328.1.text#οὐκ ἐς τόδ' ἦλθον ὥστε καὶ τάδ' εἰδέναι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1329.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1329.1.text#ἀλλ' οἴχεται μὲν σὴ κασιγνήτη πάλαι·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1330.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1330.1.text#δοκῶ δ' ἀγῶνα τὸν περὶ ψυχῆς, Κρέον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1331.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1331.1.text#ἤδη πεπρᾶχθαι παισὶ τοῖσιν Οἰδίπου.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1332.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1332.1.text#οἴμοι, τὸ μὲν σημεῖον εἰσορῶ τόδε,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1333.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1333.1.text#σκυθρωπὸν ὄμμα καὶ πρόσωπον ἀγγέλου
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1334.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1334.1.text#στείχοντος, ὃς πᾶν ἀγγελεῖ τὸ δρώμενον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1335.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1335.1.text#ὦ τάλας ἐγώ, τίν' εἴπω μῦθον ἢ τίνας γόους;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1336.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1336.1.text#οἰχόμεσθ'· οὐκ εὐπροσώποις φροιμίοις ἄρχῃ λόγου.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1337.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1337.1.text#ὦ τάλας, δισσῶς ἀυτῶ· μεγάλα γὰρ φέρω κακά.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1338.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1338.1.text#πρὸς πεπραγμένοισιν ἄλλοις πήμασιν. λέγεις δὲ τί;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1339.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1339.1.text#οὐκέτ' εἰσὶ σῆς ἀδελφῆς παῖδες ἐν φάει, Κρέον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1340.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1340.1.text#αἰαῖ·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1341.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1341.1.text#μεγάλα μοι θροεῖς πάθεα καὶ πόλει.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1342.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1342.1.text#ὦ δώματ' εἰσηκούσατ' Οἰδίπου τάδε
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1343.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1343.1.text#παίδων ὁμοίαις συμφοραῖς ὀλωλότων;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1344.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1344.1.text#ὥστ' ἂν δακρῦσαί γ', εἰ φρονοῦντ' ἐτύγχανεν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1345.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1345.1.text#οἴμοι ξυμφορᾶς βαρυποτμωτάτας,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1346.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1346.1.text#[ οἴμοι κακῶν δύστηνος· ὦ τάλας ἐγώ. ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1347.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1347.1.text#εἰ καὶ τὰ πρὸς τούτοισί γ' εἰδείης κακά.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1348.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1348.1.text#καὶ πῶς γένοιτ' ἂν τῶνδε δυσποτμώτερα;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1349.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1349.1.text#τέθνηκ' ἀδελφὴ σὴ δυοῖν παίδοιν μέτα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1350.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1350.1.text#ἀνάγετ' ἀνάγετε κωκυτόν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1351.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1351.1.text#ἐπὶ κάρα τε λευκοπήχεις κτύπους χεροῖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1352.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1352.1.text#ὦ τλῆμον, οἷον τέρμον', Ἰοκάστη, βίου
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1353.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1353.1.text#γάμων τε τῶν σῶν Σφιγγὸς αἰνιγμοὺς ἔτλης.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1354.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1354.1.text#πῶς καὶ πέπρακται διπτύχων παίδων φόνος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1355.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1355.1.text#ἀρᾶς τ' ἀγώνισμ' Οἰδίπου; σήμαινέ μοι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1356.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1356.1.text#τὰ μὲν πρὸ πύργων εὐτυχήματα χθονὸς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1357.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1357.1.text#οἶσθ'· οὐ μακρὰν γὰρ τειχέων περιπτυχαί.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1358.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1358.1.text#[ ὥστ' οὐχ ἅπαντά σ' εἰδέναι τὰ δρώμενα. ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1359.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1359.1.text#ἐπεὶ δὲ χαλκέοις σῶμ' ἐκοσμήσανθ' ὅπλοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1360.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1360.1.text#οἱ τοῦ γέροντος Οἰδίπου νεανίαι,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1361.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1361.1.text#ἔστησαν ἐλθόντ' ἐς μέσον μεταίχμιον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1362.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1362.1.text#[ δισσὼ στρατηγὼ καὶ διπλὼ στρατηλάτα ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1363.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1363.1.text#ὡς εἰς ἀγῶνα μονομάχου τ' ἀλκὴν δορός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1364.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1364.1.text#βλέψας δ' ἐπ' Ἄργος ἧκε Πολυνείκης ἀράς·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1365.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1365.1.text#ὦ πότνι' Ἥρα — σὸς γάρ εἰμ', ἐπεὶ γάμοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1366.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1366.1.text#ἔζευξ' Ἀδράστου παῖδα καὶ ναίω χθόνα —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1367.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1367.1.text#δός μοι κτανεῖν ἀδελφόν, ἀντήρη δ' ἐμὴν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1368.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1368.1.text#καθαιματῶσαι δεξιὰν νικηφόρον· —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1369.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1369.1.text#[ αἴσχιστον αἰτῶν στέφανον, ὁμογενῆ κτανεῖν. ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1370.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1370.1.text#[ πολλοῖς δ' ἐπῄει δάκρυα τῆς τύχης ὅση, ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1371.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1371.1.text#[ κἄβλεψαν ἀλλήλοισι διαδόντες κόρας. ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1372.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1372.1.text#Ἐτεοκλέης δὲ Παλλάδος χρυσάσπιδος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1373.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1373.1.text#βλέψας πρὸς οἶκον ηὔξατ'· ὦ Διὸς κόρη,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1374.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1374.1.text#δὸς ἔγχος ἡμῖν καλλίνικον ἐκ χερὸς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1375.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1375.1.text#ἐς στέρν' ἀδελφοῦ τῆσδ' ἀπ' ὠλένης βαλεῖν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1376.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1376.1.text#κτανεῖν θ' ὃς ἦλθε πατρίδα πορθήσων ἐμήν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1377.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1377.1.text#ἐπεὶ δ' ἀφείθη πυρσὸς ὣς Τυρσηνικῆς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1378.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1378.1.text#σάλπιγγος ἠχὴ σῆμα φοινίου μάχης,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1379.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1379.1.text#ᾖξαν δράμημα δεινὸν ἀλλήλοις ἔπι·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1380.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1380.1.text#κάπροι δ' ὅπως θήγοντες ἀγρίαν γένυν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1381.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1381.1.text#ξυνῆψαν, ἀφρῷ διάβροχοι γενειάδας·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1382.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1382.1.text#ᾖσσον δὲ λόγχαις· ἀλλ' ὑφίζανον κύκλοις,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1383.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1383.1.text#ὅπως σίδηρος ἐξολισθάνοι μάτην.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1384.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1384.1.text#εἰ δ' ὄμμ' ὑπερσχὸν ἴτυος ἅτερος μάθοι,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1385.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1385.1.text#λόγχην ἐνώμα, στόματι προφθῆναι θέλων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1386.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1386.1.text#ἀλλ' εὖ προσῆγον ἀσπίδων κεγχρώμασιν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1387.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1387.1.text#ὀφθαλμόν, ἀργὸν ὥστε γίγνεσθαι δόρυ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1388.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1388.1.text#πλείων δὲ τοῖς ὁρῶσιν ἐστάλασσ' ἱδρὼς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1389.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1389.1.text#ἢ τοῖσι δρῶσι, διὰ φίλων ὀρρωδίαν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1390.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1390.1.text#Ἐτεοκλέης δὲ ποδὶ μεταψαίρων πέτρον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1391.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1391.1.text#ἴχνους ὑπόδρομον, κῶλον ἐκτὸς ἀσπίδος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1392.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1392.1.text#τίθησι· Πολυνείκης δ' ἀπήντησεν δορί,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1393.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1393.1.text#πληγὴν σιδήρῳ παραδοθεῖσαν εἰσιδών,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1394.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1394.1.text#κνήμην τε διεπέρασεν Ἀργεῖον δόρυ·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1395.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1395.1.text#στρατὸς δ' ἀνηλάλαξε Δαναϊδῶν ἅπας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1396.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1396.1.text#κἀν τῷδε μόχθῳ γυμνὸν ὦμον εἰσιδὼν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1397.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1397.1.text#ὁ πρόσθε τρωθεὶς στέρνα Πολυνείκους βίᾳ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1398.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1398.1.text#διῆκε λόγχην, κἀπέδωκεν ἡδονὰς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1399.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1399.1.text#Κάδμου πολίταις, ἀπὸ δ' ἔθραυσ' ἄκρον δόρυ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1400.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1400.1.text#ἐς δ' ἄπορον ἥκων δορὸς ἐπὶ σκέλος πάλιν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1401.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1401.1.text#χωρεῖ, λαβὼν δ' ἀφῆκε μάρμαρον πέτρον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1402.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1402.1.text#μέσον δ' ἄκοντ' ἔθραυσεν· ἐξ ἴσου δ' Ἄρης
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1403.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1403.1.text#ἦν, κάμακος ἀμφοῖν χεῖρ' ἀπεστερημένοιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1404.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1404.1.text#ἔνθεν δὲ κώπας ἁρπάσαντε φασγάνων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1405.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1405.1.text#ἐς ταὐτὸν ἧκον, συμβαλόντε δ' ἀσπίδας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1406.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1406.1.text#πολὺν ταραγμὸν ἀμφιβάντ' εἶχον μάχης.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1407.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1407.1.text#καί πως νοήσας Ἐτεοκλῆς τὸ Θεσσαλὸν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1408.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1408.1.text#ἐσήγαγεν σόφισμ' ὁμιλίᾳ χθονός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1409.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1409.1.text#ἐξαλλαγεὶς γὰρ τοῦ παρεστῶτος πόνου,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1410.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1410.1.text#λαιὸν μὲν ἐς τοὔπισθεν ἀμφέρει πόδα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1411.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1411.1.text#πρόσω τὰ κοῖλα γαστρὸς εὐλαβούμενος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1412.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1412.1.text#προβὰς δὲ κῶλον δεξιὸν δι' ὀμφαλοῦ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1413.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1413.1.text#καθῆκεν ἔγχος σφονδύλοις τ' ἐνήρμοσεν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1414.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1414.1.text#ὁμοῦ δὲ κάμψας πλευρὰ καὶ νηδὺν τάλας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1415.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1415.1.text#σὺν αἱματηραῖς σταγόσι Πολυνείκης πίτνει.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1416.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1416.1.text#ὃ δ', ὡς κρατῶν δὴ καὶ νενικηκὼς μάχῃ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1417.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1417.1.text#ξίφος δικὼν ἐς γαῖαν ἐσκύλευέ νιν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1418.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1418.1.text#τὸν νοῦν πρὸς αὑτὸν οὐκ ἔχων, ἐκεῖσε δέ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1419.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1419.1.text#ὃ καί νιν ἔσφηλ'· ἔτι γὰρ ἐμπνέων βραχύ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1420.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1420.1.text#σῴζων σίδηρον ἐν λυγρῷ πεσήματι,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1421.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1421.1.text#μόλις μέν, ἐξέτεινε δ' εἰς ἧπαρ ξίφος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1422.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1422.1.text#Ἐτεοκλέους ὁ πρόσθε Πολυνείκης πεσών.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1423.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1423.1.text#γαῖαν δ' ὀδὰξ ἑλόντες ἀλλήλων πέλας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1424.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1424.1.text#πίπτουσιν ἄμφω κοὐ διώρισαν κράτος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1425.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1425.1.text#φεῦ φεῦ, κακῶν σῶν, Οἰδίπου, σ' ὅσον στένω·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1426.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1426.1.text#τὰς σὰς δ' ἀρὰς ἔοικεν ἐκπλῆσαι θεός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1427.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1427.1.text#ἄκουε δή νυν καὶ τὰ πρὸς τούτοις κακά.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1428.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1428.1.text#ἐπεὶ τέκνω πεσόντ' ἐλειπέτην βίον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1429.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1429.1.text#ἐν τῷδε μήτηρ ἡ τάλαινα προσπίτνει
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1430.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1430.1.text#σὺν παρθένῳ τε καὶ προθυμίᾳ ποδός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1431.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1431.1.text#τετρωμένους δ' ἰδοῦσα καιρίους σφαγὰς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1432.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1432.1.text#ᾤμωξεν· ὦ τέκν', ὑστέρα βοηδρόμος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1433.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1433.1.text#πάρειμι. προσπίτνουσα δ' ἐν μέρει τέκνα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1434.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1434.1.text#ἔκλαι', ἐθρήνει, τὸν πολὺν μαστῶν πόνον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1435.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1435.1.text#στένουσ', ἀδελφή θ' ἡ παρασπίζουσ' ὁμοῦ·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1436.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1436.1.text#ὦ γηροβοσκὼ μητρός, ὦ γάμους ἐμοὺς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1437.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1437.1.text#προδόντ' ἀδελφὼ φιλτάτω. στέρνων δ' ἄπο
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1438.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1438.1.text#φύσημ' ἀνεὶς δύσθνητον Ἐτεοκλῆς ἄναξ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1439.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1439.1.text#ἤκουσε μητρός, κἀπιθεὶς ὑγρὰν χέρα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1440.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1440.1.text#φωνὴν μὲν οὐκ ἀφῆκεν, ὀμμάτων δ' ἄπο
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1441.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1441.1.text#προσεῖπε δακρύοις, ὥστε σημῆναι φίλα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1442.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1442.1.text#ὃ δ' ἦν ἔτ' ἔμπνους, πρὸς κασιγνήτην δ' ἰδὼν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1443.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1443.1.text#γραῖάν τε μητέρ' εἶπε Πολυνείκης τάδε·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1444.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1444.1.text#Ἀπωλόμεσθα, μῆτερ· οἰκτίρω δὲ σὲ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1445.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1445.1.text#καὶ τήνδ' ἀδελφὴν καὶ κασίγνητον νεκρόν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1446.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1446.1.text#φίλος γὰρ ἐχθρὸς ἐγένετ', ἀλλ' ὅμως φίλος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1447.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1447.1.text#θάψον δέ μ', ὦ τεκοῦσα, καὶ σύ, σύγγονε,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1448.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1448.1.text#ἐν γῇ πατρῴᾳ, καὶ πόλιν θυμουμένην
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1449.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1449.1.text#παρηγορεῖτον, ὡς τοσόνδε γοῦν τύχω
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1450.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1450.1.text#χθονὸς πατρῴας, κεἰ δόμους ἀπώλεσα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1451.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1451.1.text#ξυνάρμοσον δὲ βλέφαρά μου τῇ σῇ χερί,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1452.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1452.1.text#μῆτερ — τίθησι δ' αὐτὸς ὀμμάτων ἔπι —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1453.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1453.1.text#καὶ χαίρετ'· ἤδη γάρ με περιβάλλει σκότος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1454.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1454.1.text#ἄμφω δ' ἅμ' ἐξέπνευσαν ἄθλιον βίον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1455.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1455.1.text#μήτηρ δ', ὅπως ἐσεῖδε τήνδε συμφοράν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1456.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1456.1.text#ὑπερπαθήσασ', ἥρπασ' ἐκ νεκρῶν ξίφος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1457.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1457.1.text#κἄπραξε δεινά· διὰ μέσου γὰρ αὐχένος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1458.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1458.1.text#ὠθεῖ σίδηρον, ἐν δὲ τοῖσι φιλτάτοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1459.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1459.1.text#θανοῦσα κεῖται περιβαλοῦσ' ἀμφοῖν χέρας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1460.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1460.1.text#ἀνῇξε δ' ὀρθὸς λαὸς εἰς ἔριν λόγων,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1461.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1461.1.text#ἡμεῖς μὲν ὡς νικῶντα δεσπότην ἐμόν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1462.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1462.1.text#οἳ δ' ὡς ἐκεῖνον. ἦν δ' ἔρις στρατηλάταις,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1463.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1463.1.text#οἳ μὲν πατάξαι πρόσθε Πολυνείκη δορί,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1464.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1464.1.text#οἳ δ' ὡς θανόντων οὐδαμοῦ νίκη πέλοι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1465.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1465.1.text#κἀν τῷδ' ὑπεξῆλθ' Ἀντιγόνη στρατοῦ δίχα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1466.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1466.1.text#οἳ δ' εἰς ὅπλ' ᾖσσον· εὖ δέ πως προμηθίᾳ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1467.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1467.1.text#καθῆστο Κάδμου λαὸς ἀσπίδων ἔπι·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1468.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1468.1.text#κἄφθημεν οὔπω τεύχεσιν πεφραγμένον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1469.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1469.1.text#Ἀργεῖον ἐσπεσόντες ἐξαίφνης στρατόν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1470.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1470.1.text#κοὐδεὶς ὑπέστη, πεδία δ' ἐξεπίμπλασαν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1471.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1471.1.text#φεύγοντες, ἔρρει δ' αἷμα μυρίων νεκρῶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1472.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1472.1.text#λόγχαις πιτνόντων. ὡς δ' ἐνικῶμεν μάχῃ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1473.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1473.1.text#οἳ μὲν Διὸς τροπαῖον ἵστασαν βρέτας,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1474.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1474.1.text#οἳ δ' ἀσπίδας συλῶντες Ἀργείων νεκρῶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1475.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1475.1.text#σκυλεύματ' εἴσω τειχέων ἐπέμπομεν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1476.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1476.1.text#ἄλλοι δὲ τοὺς θανόντας Ἀντιγόνης μέτα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1477.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1477.1.text#νεκροὺς φέρουσιν ἐνθάδ' οἰκτίσαι φίλοις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1478.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1478.1.text#πόλει δ' ἀγῶνες οἳ μὲν εὐτυχέστατοι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1479.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1479.1.text#τῇδ' ἐξέβησαν, οἳ δὲ δυστυχέστατοι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1480.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1480.1.text#οὐκ εἰς ἀκοὰς ἔτι δυστυχία
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1481.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1481.1.text#δώματος ἥκει· πάρα γὰρ λεύσσειν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1482.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1482.1.text#πτώματα νεκρῶν τρισσῶν ἤδη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1483.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1483.1.text#τάδε πρὸς μελάθροις κοινῷ θανάτῳ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1484.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1484.1.text#σκοτίαν αἰῶνα λαχόντων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1485.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1485.1.text#οὐ προκαλυπτομένα βοτρυχώδεος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1486.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1486.1.text#ἁβρὰ παρηίδος οὐδ' ὑπὸ παρθενίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1488.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1488.1.text#τὸν ὑπὸ βλεφάροις φοίνικ', ἐρύθημα προσώπου,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1489.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1489.1.text#αἰδομένα φέρομαι βάκχα νεκύων,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1490.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1490.1.text#κράδεμνα δικοῦσα κόμας ἀπ' ἐμᾶς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1491.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1491.1.text#στολίδος κροκόεσσαν ἀνεῖσα τρυφάν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1492.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1492.1.text#ἁγεμόνευμα νεκροῖσι πολύστονον. αἰαῖ, ἰώ μοι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1493.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1493.1.text#ὦ Πολύνεικες, ἔφυς ἄρ' ἐπώνυμος· ὤμοι μοι, Θῆβαι·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1495.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1495.1.text#σὰ δ' ἔρις — οὐκ ἔρις, ἀλλὰ φόνῳ φόνος —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1496.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1496.1.text#Οἰδιπόδα δόμον ὤλεσε κρανθεῖσ'
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1497.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1497.1.text#αἵματι δεινῷ, αἵματι λυγρῷ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1498.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1498.1.text#τίνα προσῳδὸν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1499.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1499.1.text#ἢ τίνα μουσοπόλον στοναχὰν ἐπὶ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1500.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1500.1.text#δάκρυσι δάκρυσιν, ὦ δόμος, ὦ δόμος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1501.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1501.1.text#ἀγκαλέσωμαι,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1502.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1502.1.text#τρισσὰ φέρουσα τάδ' αἵματα σύγγονα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1503.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1503.1.text#ματέρα καὶ τέκνα, χάρματ' Ἐρινύος;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1504.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1504.1.text#ἃ δόμον Οἰδιπόδα πρόπαν ὤλεσε,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1505.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1505.1.text#τᾶς ἀγρίας ὅτε
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1506.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1506.1.text#δυσξυνέτου ξυνετὸν μέλος ἔγνω
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1507.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1507.1.text#Σφιγγὸς ἀοιδοῦ σῶμα φονεύσας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1508.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1508.1.text#ἰώ μοί μοι, πάτερ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1509.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1509.1.text#τίς Ἑλλὰς ἢ βάρβαρος ἢ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1510.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1510.1.text#τῶν προπάροιθ' εὐγενετᾶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1511.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1511.1.text#ἕτερος ἔτλα κακῶν τοσῶνδ'
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1512.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1512.1.text#αἵματος ἁμερίου
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1513.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1513.1.text#τοιάδ' ἄχεα φανερά;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1514.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1514.1.text#τάλαιν', ὡς ἐλελίζει —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1515.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1515.1.text#τίς ἄρ' ὄρνις, ἢ δρυὸς ἢ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1516.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1516.1.text#ἐλάτας ἀκροκόμοις ἀμφὶ κλάδοις ἑζομένα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1517.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1517.1.text#μονομάτορσιν ὀδυρμοῖς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1518.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1518.1.text#ἐμοῖς ἄχεσι συνῳδός;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1519.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1519.1.text#αἴλινον αἰάγμασιν ἃ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1520.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1520.1.text#τοῖσδε προκλαίω μονάδ' αἰῶνα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1521.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1521.1.text#διάξουσα τὸν αἰεὶ χρόνον ἐν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1522.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1522.1.text#λειβομένοισιν δάκρυσιν [ ἰαχήσω ].
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1524.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1524.1.text#τίν' ἐπὶ πρῶτον ἀπὸ χαίτας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1525.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1525.1.text#σπαραγμοῖς ἀπαρχὰς βάλω;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1526.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1526.1.text#ματρὸς ἐμᾶς ἢ διδύμοισι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1527.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1527.1.text#γάλακτος παρὰ μαστοῖς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1528.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1528.1.text#ἢ πρὸς ἀδελφῶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1529.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1529.1.text#οὐλόμεν' αἰκίσματα νεκρῶν;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1530.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1530.1.text#ὀτοτοτοῖ λεῖπε σοὺς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1531.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1531.1.text#δόμους, ἀλαὸν ὄμμα φέρων,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1532.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1532.1.text#πάτερ γεραιέ, δεῖξον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1533.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1533.1.text#Οἰδιπόδα, σὸν αἰῶνα μέλεον, ὃς { ἐπὶ }
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1534.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1534.1.text#{ δώμασιν ἀέριον σκότον ὄμμασι }
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1535.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1535.1.text#σοῖσι βαλὼν ἕλκεις μακρόπνουν ζόαν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1536.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1536.1.text#κλύεις, ὦ κατ' αὐλὰν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1537.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1537.1.text#ἀλαίνων γεραιὸν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1538.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1538.1.text#πόδ' ἢ δεμνίοις δύστανος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1538.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1538.2.text#ἰαύων;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1539.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1539.1.text#τί μ', ὦ παρθένε, βακτρεύμασι τυφλοῦ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1540.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1540.1.text#ποδὸς ἐξάγαγες ἐς φῶς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1541.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1541.1.text#λεχήρη σκοτίων ἐκ θαλάμων οἰκτροτάτοισιν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1542.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1542.1.text#δακρύοισιν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1543.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1543.1.text#πολιὸν αἰθέρος ἀφανὲς εἴδωλον ἢ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1544.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1544.1.text#νέκυν ἔνερθεν ἢ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1545.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1545.1.text#πτανὸν ὄνειρον;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1546.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1546.1.text#δυστυχὲς ἀγγελίας ἔπος οἴσῃ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1547.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1547.1.text#πάτερ, οὐκέτι σοι τέκνα λεύσσει
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1548.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1548.1.text#φάος οὐδ' ἄλοχος, παραβάκτροις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1549.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1549.1.text#ἃ πόδα σὸν τυφλόπουν θεραπεύμασιν αἰὲν ἐμόχθει,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1550.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1550.1.text#{ ὦ } πάτερ, ὤμοι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1551.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1551.1.text#ὤμοι ἐμῶν παθέων· πάρα γὰρ στενάχειν τάδ', ἀυτεῖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1553.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1553.1.text#τρισσαὶ ψυχαί· ποίᾳ μοίρᾳ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1554.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1554.1.text#πῶς ἔλιπον φάος; ὦ τέκνον, αὔδα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1555.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1555.1.text#οὐκ ἐπ' ὀνείδεσιν οὐδ' ἐπιχάρμασιν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1556.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1556.1.text#ἀλλ' ὀδύναισι λέγω· σὸς ἀλάστωρ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1557.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1557.1.text#ξίφεσιν βρίθων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1558.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1558.1.text#καὶ πυρὶ καὶ σχετλίαισι μάχαις ἐπὶ παῖδας ἔβα σούς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1559.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1559.1.text#ὦ πάτερ, ὤ μοι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1560.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1560.1.text#αἰαῖ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1560.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1560.2.text#τί τάδε καταστένεις,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1561.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1561.1.text#τέκνα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1561.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1561.2.text#δι' ὀδύνας ἔβας·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1562.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1562.1.text#εἰ δὲ τέθριππά γ' ἔθ' ἅρματα λεύσσων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1563.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1563.1.text#ἀελίου τάδε σώματα νεκρῶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1564.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1564.1.text#ὄμματος αὐγαῖς σαῖς ἐπενώμας —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1565.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1565.1.text#τῶν μὲν ἐμῶν τεκέων φανερὸν κακόν·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1566.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1566.1.text#ἁ δὲ τάλαιν' ἄλοχος τίνι μοι, τέκνον, ὤλετο μοίρᾳ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1567.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1567.1.text#δάκρυα γοερὰ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1567.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1567.2.text#φανερὰ πᾶσι τιθεμένα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1568.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1568.1.text#τέκεσι μαστὸν ἔφερεν ἔφερεν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1569.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1569.1.text#ἱκέτις ἱκέτιν ὀρομένα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1570.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1570.1.text#ηὗρε δ' ἐν Ἠλέκτραισι πύλαις τέκνα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1571.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1571.1.text#λωτοτρόφον κατὰ λείμακα λόγχαις,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1572.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1572.1.text#κοινὸν ἐνυάλιον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1573.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1573.1.text#μάτηρ, ὥστε λέοντας ἐναύλους,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1574.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1574.1.text#μαρναμένους ἐπὶ τραύμασιν, αἵματος
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1575.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1575.1.text#ἤδη ψυχρὰν λοιβὰν φονίαν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1576.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1576.1.text#ἃν ἔλαχ' Ἅιδας, ὤπασε δ' Ἄρης·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1577.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1577.1.text#χαλκόκροτον δὲ λαβοῦσα νεκρῶν πάρα φάσγανον εἴσω
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1578.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1578.1.text#σαρκὸς ἔβαψεν, ἄχει δὲ τέκνων ἔπεσ' ἀμφὶ τέκνοισι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1579.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1579.1.text#πάντα δ' ἐν ἄματι τῷδε συνάγαγεν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1580.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1580.1.text#ὦ πάτερ, ἁμετέροισι δόμοισιν ἄχη θεὸς ὃς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1581.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1581.1.text#τάδε τελευτᾷ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1582.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1582.1.text#πολλῶν κακῶν κατῆρξεν Οἰδίπου δόμοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1583.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1583.1.text#τόδ' ἦμαρ· εἴη δ' εὐτυχέστερος βίος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1584.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1584.1.text#οἴκτων μὲν ἤδη λήγεθ', ὡς ὥρα τάφου
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1585.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1585.1.text#μνήμην τίθεσθαι· τόνδε δ', Οἰδίπου, λόγον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1586.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1586.1.text#ἄκουσον· ἀρχὰς τῆσδε γῆς ἔδωκέ μοι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1587.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1587.1.text#Ἐτεοκλέης παῖς σός, γάμων φερνὰς διδοὺς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1588.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1588.1.text#Αἵμονι κόρης τε λέκτρον Ἀντιγόνης σέθεν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1589.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1589.1.text#οὐκ οὖν σ' ἐάσω τήνδε γῆν οἰκεῖν ἔτι·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1590.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1590.1.text#σαφῶς γὰρ εἶπε Τειρεσίας οὐ μή ποτε
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1591.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1591.1.text#σοῦ τήνδε γῆν οἰκοῦντος εὖ πράξειν πόλιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1592.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1592.1.text#ἀλλ' ἐκκομίζου. καὶ τάδ' οὐχ ὕβρει λέγω
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1593.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1593.1.text#οὐδ' ἐχθρὸς ὢν σός, διὰ δὲ τοὺς ἀλάστορας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1594.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1594.1.text#τοὺς σοὺς δεδοικὼς μή τι γῆ πάθῃ κακόν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1595.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1595.1.text#ὦ μοῖρ', ἀπ' ἀρχῆς ὥς μ' ἔφυσας ἄθλιον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1596.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1596.1.text#καὶ τλήμον', εἴ τις ἄλλος ἀνθρώπων ἔφυ·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1597.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1597.1.text#ὃν καὶ πρὶν ἐς φῶς μητρὸς ἐκ γονῆς μολεῖν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1598.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1598.1.text#ἄγονον Ἀπόλλων Λαΐῳ μ' ἐθέσπισεν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1599.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1599.1.text#φονέα γενέσθαι πατρός· ὦ τάλας ἐγώ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1600.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1600.1.text#ἐπεὶ δ' ἐγενόμην, αὖθις ὁ σπείρας πατὴρ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1601.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1601.1.text#κτείνει με νομίσας πολέμιον πεφυκέναι·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1602.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1602.1.text#χρῆν γὰρ θανεῖν νιν ἐξ ἐμοῦ· πέμπει δέ με
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1603.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1603.1.text#μαστὸν ποθοῦντα θηρσὶν ἄθλιον βοράν·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1604.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1604.1.text#οὗ σῳζόμεσθα — Ταρτάρου γὰρ ὤφελεν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1605.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1605.1.text#ἐλθεῖν Κιθαιρὼν εἰς ἄβυσσα χάσματα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1606.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1606.1.text#ὅς μ' οὐ διώλεσ', ἀλλὰ [ … ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1606.2.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1606.2.text#[ … ] δουλεῦσαί τέ μοι
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1607.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1607.1.text#δαίμων ἔδωκε Πόλυβον ἀμφὶ δεσπότην.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1608.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1608.1.text#κτανὼν δ' ἐμαυτοῦ πατέρ' ὁ δυσδαίμων ἐγὼ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1609.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1609.1.text#ἐς μητρὸς ἦλθον τῆς ταλαιπώρου λέχος,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1610.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1610.1.text#παῖδάς τ' ἀδελφοὺς ἔτεκον, οὓς ἀπώλεσα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1611.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1611.1.text#ἀρὰς παραλαβὼν Λαΐου καὶ παισὶ δούς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1612.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1612.1.text#οὐ γὰρ τοσοῦτον ἀσύνετος πέφυκ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1613.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1613.1.text#ὥστ' εἰς ἔμ' ὄμματ' ἔς τ' ἐμῶν παίδων βίον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1614.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1614.1.text#ἄνευ θεῶν του ταῦτ' ἐμηχανησάμην.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1615.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1615.1.text#εἶἑν· τί δράσω δῆθ' ὁ δυσδαίμων ἐγώ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1616.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1616.1.text#τίς ἡγεμών μοι ποδὸς ὁμαρτήσει τυφλοῦ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1617.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1617.1.text#ἥδ' ἡ θανοῦσα; ζῶσά γ' ἂν σάφ' οἶδ' ὅτι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1618.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1618.1.text#ἀλλ' εὔτεκνος ξυνωρίς; ἀλλ' οὐκ ἔστι μοι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1619.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1619.1.text#ἀλλ' ἔτι νεάζων αὐτὸς εὕροιμ' ἂν βίον;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1620.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1620.1.text#πόθεν; τί μ' ἄρδην ὧδ' ἀποκτείνεις, Κρέον;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1621.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1621.1.text#ἀποκτενεῖς γάρ, εἴ με γῆς ἔξω βαλεῖς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1622.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1622.1.text#οὐ μὴν ἑλίξας γ' ἀμφὶ σὸν χεῖρας γόνυ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1623.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1623.1.text#κακὸς φανοῦμαι· τὸ γὰρ ἐμόν ποτ' εὐγενὲς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1624.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1624.1.text#οὐκ ἂν προδοίην, οὐδέ περ πράσσων κακῶς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1625.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1625.1.text#σοί τ' εὖ λέλεκται γόνατα μὴ χρῴζειν ἐμά,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1626.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1626.1.text#ἐγὼ δὲ ναίειν σ' οὐκ ἐάσαιμ' ἂν χθόνα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1627.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1627.1.text#νεκρῶν δὲ τῶνδε τὸν μὲν ἐς δόμους χρεὼν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1628.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1628.1.text#ἤδη κομίζειν, τόνδε δ', ὃς πέρσων πόλιν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1629.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1629.1.text#πατρίδα σὺν ἄλλοις ἦλθε, Πολυνείκους νέκυν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1630.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1630.1.text#ἐκβάλετ' ἄθαπτον τῆσδ' ὅρων ἔξω χθονός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1631.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1631.1.text#κηρύξεται δὲ πᾶσι Καδμείοις τάδε·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1632.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1632.1.text#ὃς ἂν νεκρὸν τόνδ' ἢ καταστέφων ἁλῷ
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1633.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1633.1.text#ἢ γῇ καλύπτων, θάνατον ἀνταλλάξεται.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1634.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1634.1.text#[ ἐᾶν δ' ἄκλαυτον, ἄταφον, οἰωνοῖς βοράν. ]
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1635.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1635.1.text#σὺ δ' ἐκλιποῦσα τριπτύχους θρήνους νεκρῶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1636.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1636.1.text#κόμιζε σαυτήν, Ἀντιγόνη, δόμων ἔσω
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1637.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1637.1.text#καὶ παρθενεύου τὴν ἰοῦσαν ἡμέραν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1638.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1638.1.text#μένουσ', ἐν ᾗ σε λέκτρον Αἵμονος μένει.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1639.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1639.1.text#ὦ πάτερ, ἐν οἵοις κείμεθ' ἄθλιοι κακοῖς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1640.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1640.1.text#ὥς σε στενάζω τῶν τεθνηκότων πλέον·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1641.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1641.1.text#οὐ γὰρ τὸ μέν σοι βαρὺ κακῶν, τὸ δ' οὐ βαρύ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1642.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1642.1.text#ἀλλ' εἰς ἅπαντα δυστυχὴς ἔφυς, πάτερ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1643.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1643.1.text#ἀτὰρ σ' ἐρωτῶ τὸν νεωστὶ κοίρανον·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1644.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1644.1.text#τί τόνδ' ὑβρίζεις πατέρ' ἀποστέλλων χθονός;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1645.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1645.1.text#τί θεσμοποιεῖς ἐπὶ ταλαιπώρῳ νεκρῷ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1646.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1646.1.text#Ἐτεοκλέους βουλεύματ', οὐχ ἡμῶν, τάδε.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1647.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1647.1.text#ἄφρονά γε, καὶ σὺ μῶρος ὃς ἐπίθου τάδε.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1648.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1648.1.text#πῶς; τἀντεταλμέν' οὐ δίκαιον ἐκπονεῖν;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1649.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1649.1.text#οὔκ, ἢν πονηρά γ' ᾖ κακῶς τ' εἰρημένα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1650.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1650.1.text#τί δ'; οὐ δικαίως ὅδε κυσὶν δοθήσεται;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1651.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1651.1.text#οὐκ ἔννομον γὰρ τὴν δίκην πράσσεσθέ νιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1652.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1652.1.text#εἴπερ γε πόλεως ἐχθρὸς ἦν οὐκ ἐχθρὸς ὤν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1653.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1653.1.text#οὐκοῦν ἔδωκε τῇ τύχῃ τὸν δαίμονα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1654.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1654.1.text#καὶ τῷ τάφῳ νυν τὴν δίκην παρασχέτω.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1655.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1655.1.text#τί πλημμελήσας, τὸ μέρος εἰ μετῆλθε γῆς;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1656.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1656.1.text#ἄταφος ὅδ' ἁνήρ, ὡς μάθῃς, γενήσεται.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1657.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1657.1.text#ἐγώ σφε θάψω, κἂν ἀπεννέπῃ πόλις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1658.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1658.1.text#σαυτὴν ἄρ' ἐγγὺς τῷδε συνθάψεις νεκρῷ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1659.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1659.1.text#ἀλλ' εὐκλεές τοι δύο φίλω κεῖσθαι πέλας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1660.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1660.1.text#λάζυσθε τήνδε κἀς δόμους κομίζετε.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1661.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1661.1.text#οὐ δῆτ', ἐπεὶ τοῦδ' οὐ μεθήσομαι νεκροῦ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1662.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1662.1.text#ἔκριν' ὁ δαίμων, παρθέν', οὐχ ἃ σοὶ δοκεῖ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1663.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1663.1.text#κἀκεῖνο κέκριται, μὴ ἐφυβρίζεσθαι νεκρούς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1664.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1664.1.text#ὡς οὔτις ἀμφὶ τῷδ' ὑγρὰν θήσει κόνιν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1665.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1665.1.text#ναὶ πρός σε τῆσδε μητρὸς Ἰοκάστης, Κρέον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1666.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1666.1.text#μάταια μοχθεῖς· οὐ γὰρ ἂν τύχοις τάδε.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1667.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1667.1.text#σὺ δ' ἀλλὰ νεκρῷ λουτρὰ περιβαλεῖν μ' ἔα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1668.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1668.1.text#ἓν τοῦτ' ἂν εἴη τῶν ἀπορρήτων πόλει.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1669.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1669.1.text#ἀλλ' ἀμφὶ τραύματ' ἄγρια τελαμῶνας βαλεῖν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1670.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1670.1.text#οὐκ ἔσθ' ὅπως σὺ τόνδε τιμήσεις νέκυν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1671.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1671.1.text#ὦ φίλτατ', ἀλλὰ στόμα γε σὸν προσπτύξομαι.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1672.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1672.1.text#οὐ μὴ ἐς γάμους σοὺς συμφορὰν κτήσῃ γόοις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1673.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1673.1.text#ἦ γὰρ γαμοῦμαι ζῶσα παιδὶ σῷ ποτε;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1674.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1674.1.text#πολλή σ' ἀνάγκη· ποῖ γὰρ ἐκφεύξῃ λέχος;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1675.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1675.1.text#νὺξ ἆρ' ἐκείνη Δαναΐδων μ' ἕξει μίαν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1676.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1676.1.text#εἶδες τὸ τόλμημ' οἷον ἐξωνείδισεν;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1677.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1677.1.text#ἴστω σίδηρος ὅρκιόν τέ μοι ξίφος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1678.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1678.1.text#τί δ' ἐκπροθυμῇ τῶνδ' ἀπηλλάχθαι γάμων;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1679.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1679.1.text#συμφεύξομαι τῷδ' ἀθλιωτάτῳ πατρί.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1680.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1680.1.text#γενναιότης σοι, μωρία δ' ἔνεστί τις.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1681.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1681.1.text#καὶ ξυνθανοῦμαί γ', ὡς μάθῃς περαιτέρω.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1682.1.speaker#Κρέων
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1682.1.text#ἴθ', οὐ φονεύσεις παῖδ' ἐμόν, λίπε χθόνα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1683.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1683.1.text#ὦ θύγατερ, αἰνῶ μέν σε τῆς προθυμίας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1684.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1684.1.text#ἀλλ' εἰ γαμοίμην, σὺ δὲ μόνος φεύγοις, πάτερ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1685.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1685.1.text#μέν' εὐτυχοῦσα, τἄμ' ἐγὼ στέρξω κακά.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1686.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1686.1.text#καὶ τίς σε τυφλὸν ὄντα θεραπεύσει, πάτερ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1687.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1687.1.text#πεσὼν ὅπου μοι μοῖρα κείσομαι πέδῳ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1688.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1688.1.text#ὁ δ' Οἰδίπους ποῦ καὶ τὰ κλείν' αἰνίγματα;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1689.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1689.1.text#ὄλωλ'· ἓν ἦμάρ μ' ὤλβισ', ἓν δ' ἀπώλεσεν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1690.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1690.1.text#οὔκουν μετασχεῖν κἀμὲ δεῖ τῶν σῶν κακῶν;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1691.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1691.1.text#αἰσχρὰ φυγὴ θυγατρὶ σὺν τυφλῷ πατρί.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1692.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1692.1.text#οὔ, σωφρονούσῃ γ', ἀλλὰ γενναία, πάτερ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1693.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1693.1.text#προσάγαγέ νύν με, μητρὸς ὡς ψαύσω σέθεν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1694.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1694.1.text#ἰδού, γεραιᾶς φιλτάτης ψαῦσον χερί.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1695.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1695.1.text#ὦ μῆτερ, ὦ ξυνάορ' ἀθλιωτάτη.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1696.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1696.1.text#οἰκτρὰ πρόκειται, πάντ' ἔχουσ' ὁμοῦ κακά.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1697.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1697.1.text#Ἐτεοκλέους δὲ πτῶμα Πολυνείκους τε ποῦ;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1698.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1698.1.text#τώδ' ἐκτάδην σοι κεῖσθον ἀλλήλοιν πέλας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1699.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1699.1.text#πρόσθες τυφλὴν χεῖρ' ἐπὶ πρόσωπα δυστυχῆ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1700.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1700.1.text#ἰδού, θανόντων σῶν τέκνων ἅπτου χερί.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1701.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1701.1.text#ὦ φίλα πεσήματ' ἄθλι' ἀθλίου πατρός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1702.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1702.1.text#ὦ φίλτατον δῆτ' ὄνομα Πολυνείκους ἐμοί.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1703.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1703.1.text#νῦν χρησμός, ὦ παῖ, Λοξίου περαίνεται.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1704.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1704.1.text#ὁ ποῖος; ἀλλ' ἦ πρὸς κακοῖς ἐρεῖς κακά;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1705.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1705.1.text#ἐν ταῖς Ἀθήναις κατθανεῖν μ' ἀλώμενον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1706.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1706.1.text#ποῦ; τίς σε πύργος Ἀτθίδος προσδέξεται;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1707.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1707.1.text#ἱερὸς Κολωνός, δώμαθ' ἱππίου θεοῦ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1708.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1708.1.text#ἀλλ' εἶα, τυφλῷ τῷδ' ὑπηρέτει πατρί,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1709.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1709.1.text#ἐπεὶ προθυμῇ τῆσδε κοινοῦσθαι φυγῆς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1710.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1710.1.text#ἴθ' ἐς φυγὰν τάλαιναν· ὄρεγε χέρα φίλαν,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1711.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1711.1.text#πάτερ γεραιέ, πομπίμαν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1712.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1712.1.text#ἔχων ἔμ' ὥστε ναυσίπομπον αὔραν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1713.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1713.1.text#{ ἰδοὺ } ἰδού, πορεύομαι·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1715.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1715.1.text#τέκνον, σύ μοι ποδαγὸς ἀθλία γενοῦ.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1716.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1716.1.text#γενόμεθα γενόμεθ', ἄθλιαί
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1717.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1717.1.text#γε δῆτα Θηβαιᾶν μάλιστα παρθένων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1718.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1718.1.text#πόθι γεραιὸν ἴχνος τίθημι;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1719.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1719.1.text#βάκτρα πρόσφερ', ὦ τέκνον.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1720.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1720.1.text#τᾷδε τᾷδε βᾶθί μοι,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1721.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1721.1.text#τᾷδε τᾷδε πόδα τιθείς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1722.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1722.1.text#ὥστ' ὄνειρον ἰσχύν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1723.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1723.1.text#ἰὼ ἰώ, δυστυχεστάτας φυγὰς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1724.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1724.1.text#ἐλαύνων τὸν γέροντά μ' ἐκ πάτρας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1725.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1725.1.text#ἰὼ ἰώ, δεινὰ δείν' ἐγὼ τλάς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1726.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1726.1.text#τί τλάς; τί τλάς; οὐχ ὁρᾷ Δίκα κακούς,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1727.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1727.1.text#οὐδ' ἀμείβεται βροτῶν ἀσυνεσίας.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1728.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1728.1.text#ὅδ' εἰμὶ μοῦσαν ὃς ἐπὶ καλλίνικον
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1729.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1729.1.text#οὐράνιον ἔβαν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1730.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1730.1.text#{ μειξο }παρθένου κόρας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1731.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1731.1.text#αἴνιγμ' ἀσύνετον εὑρών.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1732.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1732.1.text#Σφιγγὸς ἀναφέρεις ὄνειδος.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1733.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1733.1.text#ἄπαγε τὰ πάρος εὐτυχήματ' αὐδῶν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1734.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1734.1.text#τάδε σ' ἐπέμενε μέλεα πάθεα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1735.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1735.1.text#φυγάδα πατρίδος ἄπο γενόμενον,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1736.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1736.1.text#ὦ πάτερ, θανεῖν που.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1737.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1737.1.text#ποθεινὰ δάκρυα παρὰ φίλαισι παρθένοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1738.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1738.1.text#λιποῦσ' ἄπειμι πατρίδος ἀποπρὸ γαίας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1739.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1739.1.text#ἀπαρθένευτ' ἀλωμένα.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1740.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1740.1.text#φεῦ τὸ χρήσιμον φρενῶν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1741.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1741.1.text#ἐς πατρός γε συμφορὰς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1742.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1742.1.text#εὐκλεᾶ με θήσει·
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1743.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1743.1.text#τάλαιν' ἐγὼ { σῶν } συγγόνου θ' ὑβρισμάτων,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1744.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1744.1.text#ὃς ἐκ δόμων νέκυς ἄθαπτος οἴχεται
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1745.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1745.1.text#μέλεος, ὅν, εἴ με καὶ θανεῖν, πάτερ, χρεών,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1746.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1746.1.text#σκότια γᾷ καλύψω.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1747.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1747.1.text#πρὸς ἥλικας φάνηθι σάς.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1748.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1748.1.text#ἅλις ὀδυρμάτων ἐμῶν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1749.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1749.1.text#σὺ δ' ἀμφὶ βωμίους λιτὰς —
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1750.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1750.1.text#κόρον ἔχουσ' ἐμῶν κακῶν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1751.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1751.1.text#ἴθ' ἀλλὰ Βρόμιος ἵνα τε σηκὸς
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1752.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1752.1.text#ἄβατος ὄρεσι μαινάδων.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1753.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1753.1.text#Καδμείαν ᾧ νεβρίδα
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1755.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1755.1.text#στολιδωσαμένα ποτ' ἐγὼ Σεμέλας
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1756.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1756.1.text#θίασον ἱερὸν ὄρεσιν ἀνεχόρευσα,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1757.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1757.1.text#χάριν ἀχάριτον ἐς θεοὺς διδοῦσα;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1758.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1758.1.text#ὦ πάτρας κλεινῆς πολῖται, λεύσσετ', Οἰδίπους ὅδε,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1759.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1759.1.text#ὃς τὰ κλείν' αἰνίγματ' ἔγνω καὶ μέγιστος ἦν ἀνήρ,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1760.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1760.1.text#ὃς μόνος Σφιγγὸς κατέσχον τῆς μιαιφόνου κράτη,
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1761.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1761.1.text#νῦν ἄτιμος αὐτὸς οἰκτρὸς ἐξελαύνομαι χθονός.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1762.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1762.1.text#ἀλλὰ γὰρ τί ταῦτα θρηνῶ καὶ μάτην ὀδύρομαι;
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1763.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1763.1.text#τὰς γὰρ ἐκ θεῶν ἀνάγκας θνητὸν ὄντα δεῖ φέρειν.
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1764.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1764.1.text#ὦ μέγα σεμνὴ Νίκη, τὸν ἐμὸν
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1765.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1765.1.text#βίοτον κατέχοις
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1766.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg015.fu.sp:1766.1.text#καὶ μὴ λήγοις στεφανοῦσα.
