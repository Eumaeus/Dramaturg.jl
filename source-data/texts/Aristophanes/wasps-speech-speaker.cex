#!ctsdata
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1.1.text#Οὗτος τί πάσχεις ὦ κακόδαιμον Ξανθία;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:2.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:2.1.text#φυλακὴν καταλύειν νυκτερινὴν διδάσκομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:3.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:3.1.text#κακὸν ἆρα ταῖς πλευραῖς τι προὐφείλεις μέγα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:4.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:4.1.text#ἆρ' οἶσθά γ' οἷον κνώδαλον φυλάττομεν;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:5.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:5.1.text#οἶδ', ἀλλ' ἐπιθυμῶ σμικρὸν ἀπομερμηρίσαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:6.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:6.1.text#σὺ δ' οὖν παρακινδύνευ', ἐπεὶ καὐτοῦ γ' ἐμοῦ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:7.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:7.1.text#κατὰ τοῖν κόραιν ὕπνου τι καταχεῖται γλυκύ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:8.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:8.1.text#ἀλλ' ἦ παραφρονεῖς ἐτεὸν ἢ κορυβαντιᾷς;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:9.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:9.1.text#οὔκ, ἀλλ' ὕπνος μ' ἔχει τις ἐκ Σαβαζίου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:10.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:10.1.text#τὸν αὐτὸν ἄρ' ἐμοὶ βουκολεῖς Σαβάζιον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:11.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:11.1.text#κἀμοὶ γὰρ ἀρτίως ἐπεστρατεύσατο
urn:cts:greekLit:tlg0019.tlg004.fu.sp:12.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:12.1.text#Μῆδός τις ἐπὶ τὰ βλέφαρα νυστακτὴς ὕπνος·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:13.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:13.1.text#καὶ δῆτ' ὄναρ θαυμαστὸν εἶδον ἀρτίως.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:14.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:14.1.text#κἄγωγ' ἀληθῶς οἷον οὐδεπώποτε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:15.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:15.1.text#ἀτὰρ σὺ λέξον πρότερος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:15.2.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:15.2.text#ἐδόκουν αἰετὸν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:16.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:16.1.text#καταπτόμενον ἐς τὴν ἀγορὰν μέγαν πάνυ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:17.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:17.1.text#ἀναρπάσαντα τοῖς ὄνυξιν ἀσπίδα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:18.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:18.1.text#φέρειν ἐπίχαλκον ἀνεκὰς ἐς τὸν οὐρανόν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:19.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:19.1.text#κἄπειτα ταύτην ἀποβαλεῖν Κλεώνυμον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:20.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:20.1.text#οὐδὲν ἄρα γρίφου διαφέρει Κλεώνυμος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:21.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:21.1.textπῶς δή;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:21.2.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:21.2.text#προσερεῖ τις τοῖσι συμπόταις, λέγων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:22.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:22.1.text#"τί ταὐτὸν ἐν γῇ τ' ἀπέβαλεν κἀν οὐρανῷ"
urn:cts:greekLit:tlg0019.tlg004.fu.sp:23.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:23.1.text#"κἀν τῇ θαλάττῃ θηρίον τὴν ἀσπίδα;"
urn:cts:greekLit:tlg0019.tlg004.fu.sp:24.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:24.1.text#οἴμοι τί δῆτά μοι κακὸν γενήσεται
urn:cts:greekLit:tlg0019.tlg004.fu.sp:25.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:25.1.textἰδόντι τοιοῦτον ἐνύπνιον;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:25.2.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:25.2.text#μὴ φροντίσῃς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:26.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:26.1.text#οὐδὲν γὰρ ἔσται δεινὸν οὐ μὰ τοὺς θεούς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:27.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:27.1.text#δεινόν γέ ποὔστ' ἄνθρωπος ἀποβαλὼν ὅπλα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:28.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:28.1.textἀτὰρ σὺ τὸ σὸν αὖ λέξον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:28.2.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:28.2.text#ἀλλ' ἐστὶν μέγα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:29.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:29.1.text#περὶ τῆς πόλεως γάρ ἐστι τοῦ σκάφους ὅλου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:30.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:30.1.text#λέγε νυν ἀνύσας τι τὴν τρόπιν τοῦ πράγματος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:31.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:31.1.text#ἔδοξέ μοι περὶ πρῶτον ὕπνον ἐν τῇ πυκνὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:32.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:32.1.text#ἐκκλησιάζειν πρόβατα συγκαθήμενα,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:33.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:33.1.text#βακτηρίας ἔχοντα καὶ τριβώνια·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:34.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:34.1.text#κἄπειτα τούτοις τοῖς προβάτοισι μοὐδόκει
urn:cts:greekLit:tlg0019.tlg004.fu.sp:35.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:35.1.text#δημηγορεῖν φάλαινα πανδοκεύτρια,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:36.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:36.1.text#ἔχουσα φωνὴν ἐμπεπρησμένης ὑός.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:37.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:37.1.textαἰβοῖ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:37.2.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:37.2.text#τί ἔστι;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:37.3.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:37.3.text#παῦε παῦε, μὴ λέγε·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:38.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:38.1.text#ὄζει κάκιστον τοὐνύπνιον βύρσης σαπρᾶς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:39.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:39.1.text#εἶθ' ἡ μιαρὰ φάλαιν' ἔχουσα τρυτάνην
urn:cts:greekLit:tlg0019.tlg004.fu.sp:40.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:40.1.textἵστη βόειον δημόν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:40.2.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:40.2.text#οἴμοι δείλαιος·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:41.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:41.1.text#τὸν δῆμον ἡμῶν βούλεται διιστάναι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:42.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:42.1.text#ἐδόκει δέ μοι Θέωρος αὐτῆς πλησίον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:43.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:43.1.text#χαμαὶ καθῆσθαι τὴν κεφαλὴν κόρακος ἔχων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:44.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:44.1.text#εἶτ' Ἀλκιβιάδης εἶπε πρός με τραυλίσας,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:45.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:45.1.text# "ὁλᾷς; Θέωλος τὴν κεφαλὴν κόλακος ἔχει." 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:46.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:46.1.text#ὀρθῶς γε τοῦτ' Ἀλκιβιάδης ἐτραύλισεν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:47.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:47.1.text#οὔκουν ἐκεῖν' ἀλλόκοτον, ὁ Θέωρος κόραξ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:48.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:48.1.textγιγνόμενος;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:48.2.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:48.2.text#ἥκιστ', ἀλλ' ἄριστον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:48.3.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:48.3.text#πῶς;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:48.4.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:48.4.text#ὅπως;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:49.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:49.1.text#ἄνθρωπος ὢν εἶτ' ἐγένετ' ἐξαίφνης κόραξ·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:50.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:50.1.text#οὔκουν ἐναργὲς τοῦτο συμβαλεῖν, ὅτι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:51.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:51.1.text#ἀρθεὶς ἀφ' ἡμῶν ἐς κόρακας οἰχήσεται;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:52.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:52.1.text#εἶτ' οὐκ ἐγὼ δοὺς δύ' ὀβολὼ μισθώσομαι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:53.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:53.1.text#οὕτως ὑποκρινόμενον σοφῶς ὀνείρατα; 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:54.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:54.1.text#φέρε νυν κατείπω τοῖς θεαταῖς τὸν λόγον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:55.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:55.1.text#ὀλίγ' ἄτθ' ὑπειπὼν πρῶτον αὐτοῖσιν ταδί,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:56.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:56.1.text#μηδὲν παρ' ἡμῶν προσδοκᾶν λίαν μέγα,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:57.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:57.1.text#μηδ' αὖ γέλωτα Μεγαρόθεν κεκλεμμένον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:58.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:58.1.text#ἡμῖν γὰρ οὐκ ἔστ' οὔτε κάρυ' ἐκ φορμίδος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:59.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:59.1.text#δούλω διαρριπτοῦντε τοῖς θεωμένοις,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:60.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:60.1.text#οὔθ' Ἡρακλῆς τὸ δεῖπνον ἐξαπατώμενος,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:61.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:61.1.text#οὐδ' αὖθις ἀνασελγαινόμενος Εὐριπίδης·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:62.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:62.1.text#οὐδ' εἰ Κλέων γ' ἔλαμψε τῆς τύχης χάριν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:63.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:63.1.text#αὖθις τὸν αὐτὸν ἄνδρα μυττωτεύσομεν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:64.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:64.1.text#ἀλλ' ἔστιν ἡμῖν λογίδιον γνώμην ἔχον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:65.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:65.1.text#ὑμῶν μὲν αὐτῶν οὐχὶ δεξιώτερον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:66.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:66.1.text#κωμῳδίας δὲ φορτικῆς σοφώτερον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:67.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:67.1.text#ἔστιν γὰρ ἡμῖν δεσπότης ἐκεινοσὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:68.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:68.1.text#ἅνω καθεύδων, ὁ μέγας, οὑπὶ τοῦ τέγους.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:69.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:69.1.text#οὗτος φυλάττειν τὸν πατέρ' ἐπέταξε νῷν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:70.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:70.1.text#ἔνδον καθείρξας, ἵνα θύραζε μὴ 'ξίῃ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:71.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:71.1.text#νόσον γὰρ ὁ πατὴρ ἀλλόκοτον αὐτοῦ νοσεῖ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:72.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:72.1.text#ἣν οὐδ' ἂν εἷς γνοίη ποτ' οὐδ' ἂν ξυμβάλοι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:73.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:73.1.text#εἰ μὴ πύθοιθ' ἡμῶν· ἐπεὶ τοπάζετε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:74.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:74.1.text#Ἀμυνίας μὲν ὁ Προνάπους φήσ' οὑτοσὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:75.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:75.1.text#εἶναι φιλόκυβον αὐτόν· ἀλλ' οὐδὲν λέγει.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:76.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:76.1.text#μὰ Δί', ἀλλ' ἀφ' αὑτοῦ τὴν νόσον τεκμαίρεται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:77.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:77.1.text#οὔκ, ἀλλὰ "φιλο" μέν ἐστιν ἀρχὴ τοῦ κακοῦ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:78.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:78.1.text#ὁδὶ δέ φησι Σωσίας πρὸς Δερκύλον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:79.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:79.1.textεἶναι φιλοπότην αὐτόν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:79.2.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:79.2.text#οὐδαμῶς γ', ἐπεὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:80.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:80.1.text#αὕτη γε χρηστῶν ἐστιν ἀνδρῶν ἡ νόσος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:81.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:81.1.text#Νικόστρατος δ' αὖ φησιν ὁ Σκαμβωνίδης
urn:cts:greekLit:tlg0019.tlg004.fu.sp:82.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:82.1.text#εἶναι φιλοθύτην αὐτὸν ἢ φιλόξενον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:83.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:83.1.text#μὰ τὸν κύν' ὦ Νικόστρατ' οὐ φιλόξενος,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:84.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:84.1.text#ἐπεὶ καταπύγων ἐστὶν ὅ γε Φιλόξενος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:85.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:85.1.text#ἄλλως φλυαρεῖτ'· οὐ γὰρ ἐξευρήσετε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:86.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:86.1.text#εἰ δὴ 'πιθυμεῖτ' εἰδέναι, σιγᾶτε νῦν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:87.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:87.1.text#φράσω γὰρ ἤδη τὴν νόσον τοῦ δεσπότου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:88.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:88.1.text#φιληλιαστής ἐστιν ὡς οὐδεὶς ἀνήρ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:89.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:89.1.text#ἐρᾷ τε τούτου, τοῦ δικάζειν, καὶ στένει
urn:cts:greekLit:tlg0019.tlg004.fu.sp:90.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:90.1.text#ἢν μὴ 'πὶ τοῦ πρώτου καθίζηται ξύλου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:91.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:91.1.text#ὕπνου δ' ὁρᾷ τῆς νυκτὸς οὐδὲ πασπάλην.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:92.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:92.1.text#ἢν δ' οὖν καταμύσῃ κἂν ἄχνην, ὅμως ἐκεῖ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:93.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:93.1.text#ὁ νοῦς πέτεται τὴν νύκτα περὶ τὴν κλεψύδραν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:94.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:94.1.text#ὑπὸ τοῦ δὲ τὴν ψῆφόν γ' ἔχειν εἰωθέναι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:95.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:95.1.text#τοὺς τρεῖς ξυνέχων τῶν δακτύλων ἀνίσταται,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:96.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:96.1.text#ὥσπερ λιβανωτὸν ἐπιτιθεὶς νουμηνίᾳ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:97.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:97.1.text#καὶ νὴ Δί' ἢν ἴδῃ γέ που γεγραμμένον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:98.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:98.1.text#υἱὸν Πυριλάμπους ἐν θύρᾳ Δῆμον καλόν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:99.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:99.1.text#ἰὼν παρέγραψε πλησίον "κημὸς καλός." 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:100.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:100.1.text#τὸν ἀλεκτρυόνα δ', ὃς ᾖδ' ἀφ' ἑσπέρας, ἔφη
urn:cts:greekLit:tlg0019.tlg004.fu.sp:101.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:101.1.text#ὄψ' ἐξεγείρειν αὐτὸν ἀναπεπεισμένον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:102.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:102.1.text#παρὰ τῶν ὑπευθύνων ἔχοντα χρήματα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:103.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:103.1.text#εὐθὺς δ' ἀπὸ δορπηστοῦ κέκραγεν ἐμβάδας,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:104.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:104.1.text#κἄπειτ' ἐκεῖσ' ἐλθὼν προκαθεύδει πρῲ πάνυ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:105.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:105.1.text#ὥσπερ λεπὰς προσεχόμενος τῷ κίονι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:106.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:106.1.text#ὑπὸ δυσκολίας δ' ἅπασι τιμῶν τὴν μακρὰν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:107.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:107.1.text#ὥσπερ μέλιττ' ἢ βομβυλιὸς εἰσέρχεται
urn:cts:greekLit:tlg0019.tlg004.fu.sp:108.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:108.1.text#ὑπὸ τοῖς ὄνυξι κηρὸν ἀναπεπλασμένος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:109.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:109.1.text#ψήφων δὲ δείσας μὴ δεηθείη ποτέ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:110.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:110.1.text#ἵν' ἔχοι δικάζειν, αἰγιαλὸν ἔνδον τρέφει.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:111.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:111.1.text#τοιαῦτ' ἀλύει· νουθετούμενος δ' ἀεὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:112.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:112.1.text#μᾶλλον δικάζει. τοῦτον οὖν φυλάττομεν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:113.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:113.1.text#μοχλοῖσιν ἐνδήσαντες, ὡς ἂν μὴ 'ξίῃ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:114.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:114.1.text#ὁ γὰρ υἱὸς αὐτοῦ τὴν νόσον βαρέως φέρει.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:115.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:115.1.text#καὶ πρῶτα μὲν λόγοισι παραμυθούμενος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:116.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:116.1.text#ἀνέπειθεν αὐτὸν μὴ φορεῖν τριβώνιον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:117.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:117.1.text#μηδ' ἐξιέναι θύραζ', ὁ δ' οὐκ ἐπείθετο.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:118.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:118.1.text#εἶτ' αὐτὸν ἀπέλου κἀκάθαιρ', ὁ δ' οὐ μάλα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:119.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:119.1.text#μετὰ τοῦτ' ἐκορυβάντιζ', ὁ δ' αὐτῷ τυμπάνῳ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:120.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:120.1.text#ᾄξας ἐδίκαζεν ἐς τὸ καινὸν ἐμπεσών.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:121.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:121.1.text#ὅτε δῆτα ταύταις ταῖς τελεταῖς οὐκ ὠφέλει,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:122.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:122.1.text#διέπλευσεν εἰς Αἴγιναν, εἶτα ξυλλαβὼν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:123.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:123.1.text#νύκτωρ κατέκλινεν αὐτὸν εἰς Ἀσκληπιοῦ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:124.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:124.1.text#ὁ δ' ἀνεφάνη κνεφαῖος ἐπὶ τῇ κιγκλίδι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:125.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:125.1.text#ἐντεῦθεν οὐκέτ' αὐτὸν ἐξεφρίεμεν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:126.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:126.1.text#ὁ δ' ἐξεδίδρασκε διά τε τῶν ὑδρορροῶν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:127.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:127.1.text#καὶ τῶν ὀπῶν· ἡμεῖς δ' ὅσ' ἦν τετρημένα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:128.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:128.1.text#ἐνεβύσαμεν ῥακίοισι κἀπακτώσαμεν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:129.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:129.1.text#ὁ δ' ὡσπερεὶ κολοιὸς αὑτῷ παττάλους
urn:cts:greekLit:tlg0019.tlg004.fu.sp:130.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:130.1.text#ἐνέκρουεν ἐς τὸν τοῖχον, εἶτ' ἐξήλλετο.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:131.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:131.1.text#ἡμεῖς δὲ τὴν αὐλὴν ἅπασαν δικτύοις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:132.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:132.1.text#καταπετάσαντες ἐν κύκλῳ φυλάττομεν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:133.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:133.1.text#ἔστιν δ' ὄνομα τῷ μὲν γέροντι Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:134.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:134.1.text#ναὶ μὰ Δία, τῷ δ' υἱεῖ γε τῳδὶ Βδελυκλέων,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:135.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:135.1.text#ἔχων τρόπους φρυαγμοσεμνάκους τίνας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:136.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:136.1.text#ὦ Ξανθία καὶ Σωσία, καθεύδετε;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:137.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:137.1.textοἴμοι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:137.2.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:137.2.text#τί ἔστι;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:137.3.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:137.3.text#Βδελυκλέων ἀνίσταται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:138.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:138.1.text#οὐ περιδραμεῖται σφῷν ταχέως δεῦρ' ἅτερος;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:139.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:139.1.text#ὁ γὰρ πατὴρ ἐς τὸν ἰπνὸν εἰσελήλυθε
urn:cts:greekLit:tlg0019.tlg004.fu.sp:140.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:140.1.text#καὶ μυσπολεῖ τι καταδεδυκώς. ἀλλ' ἄθρει
urn:cts:greekLit:tlg0019.tlg004.fu.sp:141.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:141.1.text#κατὰ τῆς πυέλου τὸ τρῆμ' ὅπως μὴ 'κδύσεται·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:142.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:142.1.textσὺ δὲ τῇ θύρᾳ πρόσκεισο.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:142.2.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:142.2.text#ταῦτ' ὦ δέσποτα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:143.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:143.1.text#ἄναξ Πόσειδον τί ποτ' ἄρ' ἡ κάπνη ψοφεῖ;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:144.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:144.1.textοὗτος τίς εἶ σύ;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:144.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:144.2.text#καπνὸς ἔγωγ' ἐξέρχομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:145.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:145.1.textκαπνός; φέρ' ἴδω ξύλου τίνος σύ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:145.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:145.2.text#συκίνου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:146.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:146.1.text#νὴ τὸν Δί' ὅσπερ γ' ἐστὶ δριμύτατος καπνῶν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:147.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:147.1.text#ἀτὰρ οὐκέτ' ἐρρήσεις γε, ποῦ 'σθ' ἡ τηλία;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:148.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:148.1.text#δύου πάλιν· φέρ' ἐπαναθῶ σοι καὶ ξύλον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:149.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:149.1.text#ἐνταῦθά νυν ζήτει τιν' ἀλλην μηχανήν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:150.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:150.1.text#ἀτὰρ ἄθλιός γ' εἴιμ' ὡς ἕτερός γ' οὐδεὶς ἀνήρ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:151.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:151.1.text#ὅστις πατρὸς νυνὶ Καπνίου κεκλήσομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:152.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:152.1.textὅδε τὴν θύραν ὠθεῖ·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:152.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:152.2.text#πιέζέ νυν σφόδρα,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:153.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:153.1.text#εὖ κἀνδρικῶς· κἀγὼ γὰρ ἐνταῦθ' ἔρχομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:154.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:154.1.text#καὶ τῆς κατακλῇδος ἐπιμελοῦ, καὶ τοῦ μοχλοῦ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:155.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:155.1.text#φύλατθ' ὅπως μὴ τὴν βάλανον ἐκτρώξεται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:156.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:156.1.text#τί δράσετ'; οὐκ ἐκφρήσετ' ὦ μιαρώτατοι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:157.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:157.1.text#δικάσοντά μ', ἀλλ' ἐκφεύξεται Δρακοντίδης;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:158.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:158.1.textσὺ δὲ τοῦτο βαρέως ἂν φέροις;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:158.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:158.2.text#ὁ γὰρ θεὸς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:159.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:159.1.text#μαντευομένῳ μοὔχρησεν ἐν Δελφοῖς ποτέ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:160.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:160.1.text#ὅταν τις ἐκφύγῃ μ' ἀποσκλῆναι τότε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:161.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:161.1.text#Ἄπολλον ἀποτρόπαιε τοῦ μαντεύματος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:162.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:162.1.text#ἴθ' ἀντιβολῶ σ' ἔκφρες με, μὴ διαρραγῶ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:163.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:163.1.text#μὰ τὸν Ποσειδῶ Φιλοκλέων οὐδέποτέ γε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:164.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:164.1.text#διατρώξομαι τοίνυν ὀδὰξ τὸ δίκτυον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:165.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:165.1.textἀλλ' οὐκ ἔχεις ὀδόντας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:165.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:165.2.text#οἴμοι δείλαιος·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:166.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:166.1.text#τῶς ἄν σ' ἀποκτείναιμι; πῶς; δότε μοι ξίφος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:167.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:167.1.text#ὅπως τάχιστ', ἢ πινάκιον τιμητικόν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:168.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:168.1.text#ἅνθρωπος οὗτος μέγα τι δρασείει κακόν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:169.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:169.1.text#μὰ τὸν Δί' οὐ δῆτ', ἀλλ' ἀποδόσθαι βούλομαι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:170.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:170.1.text#τὸν ὄνον ἄγων αὐτοῖσι τοῖς κανθηλίοις·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:171.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:171.1.textνουμηνία γάρ ἐστιν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:171.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:171.2.text#οὔκουν κἂν ἐγὼ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:172.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:172.1.textαὐτὸν ἀποδοίμην δῆτ' ἄν;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:172.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:172.2.text#οὐχ ὥσπερ γ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:173.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:173.1.textμὰ Δί' ἀλλ' ἄμεινον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:173.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:173.2.text#ἀλλὰ τὸν ὄνον ἔξαγε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:174.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:174.1.text#οἵαν πρόφασιν καθῆκεν, ὡς εἰρωνικῶς,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:175.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:175.1.textἵν' αὐτὸν ἐκπέμψειας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:175.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:175.2.text#ἀλλ' οὐκ ἔσπασεν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:176.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:176.1.text#ταύτῃ γ'· ἐγὼ γὰρ ᾐσθόμην τεχνωμένου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:177.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:177.1.text#ἀλλ' εἰσιών μοι τὸν ὄνον ἐξάγειν δοκῶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:178.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:178.1.text#ὅπως ἂν ὁ γέρων μηδὲ παρακύψῃ πάλιν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:179.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:179.1.text#κάνθων τί κλάεις; ὅτι πεπράσει τήμερον;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:180.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:180.1.text#βάδιζε θᾶττον. τί στένεις, εἰ μὴ φέρεις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:181.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:181.1.textὈδυσσέα τιν';
urn:cts:greekLit:tlg0019.tlg004.fu.sp:181.2.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:181.2.text#ἀλλὰ ναὶ μὰ Δία φέρει
urn:cts:greekLit:tlg0019.tlg004.fu.sp:182.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:182.1.text#κάτω γε τουτονί τιν' ὑποδεδυκότα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:183.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:183.1.text#ποῖον; φέρ' ἴδωμαι τουτονί. τουτὶ τί ἦν;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:184.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:184.1.textτίς εἶ ποτ' ὦνθρωπ' ἐτεόν;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:184.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:184.2.text#Οὖτις νὴ Δία.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:185.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:185.1.textΟὖτις σύ; ποδαπός;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:185.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:185.2.text#Ἴθακος Ἀποδρασιππίδου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:186.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:186.1.text#Οὖτις μὰ τὸν Δί' οὔτι χαιρήσων γε σύ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:187.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:187.1.text#ὕφελκε θᾶττον αὐτόν. ὦ μιαρώτατος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:188.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:188.1.text#ἵν' ὑποδέδυκεν· ὥστ' ἔμοιγ' ἰνδάλλεται
urn:cts:greekLit:tlg0019.tlg004.fu.sp:189.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:189.1.text#ὁμοιότατος κλητῆρος εἶναι πωλίῳ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:190.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:190.1.text#εἰ μή μ' ἐάσεθ' ἥσυχον, μαχούμεθα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:191.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:191.1.textπερὶ τοῦ μαχεῖ νῷν δῆτα;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:191.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:191.2.text#περὶ ὄνου σκιᾶς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:192.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:192.1.text#πονηρὸς εἶ πόρρω τέχνης καὶ παράβολος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:193.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:193.1.text#ἐγὼ πονηρός; οὐ μὰ Δί' ἀλλ' οὐκ οἶσθα σὺ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:194.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:194.1.text#νῦν μ' ὄντ' ἄριστον· ἀλλ' ἴσως, ὅταν φάγῃς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:195.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:195.1.text#ὑπογάστριον γέροντος ἡλιαστικοῦ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:196.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:196.1.text#ὤθει τὸν ὄνον καὶ σαυτὸν ἐς τὴν οἰκίαν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:197.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:197.1.text#ὦ ξυνδικασταὶ καὶ Κλέων ἀμύνατε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:198.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:198.1.text#ἔνδον κέκραχθι τῆς θύρας κεκλῃμένης.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:199.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:199.1.text#ὤθει σὺ πολλοὺς τῶν λίθων πρὸς τὴν θύραν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:200.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:200.1.text#καὶ τὴν βάλανον ἔμβαλλε πάλιν ἐς τὸν μοχλόν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:201.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:201.1.text#καὶ τῇ δοκῷ προσθεὶς τὸν ὅλμον τὸν μέγαν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:202.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:202.1.textἀνύσας τι προσκύλισον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:202.2.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:202.2.text#οἴμοι δείλαιος·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:203.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:203.1.text#πόθεν ποτ' ἐμπέπτωκέ μοι τὸ βωλίον;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:204.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:204.1.text#ἴσως ἄνωθεν μῦς ἐνέβαλέ σοί ποθεν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:205.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:205.1.text#μῦς; οὐ μὰ Δί' ἀλλ' ὑποδυόμενός τις οὑτοσὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:206.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:206.1.text#ὑπὸ τῶν κεραμίδων ἡλιαστὴς ὀροφίας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:207.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:207.1.text#οἴμοι κακοδαίμων, στροῦθος ἁνὴρ γίγνεται·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:208.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:208.1.text#ἐκπτήσεται. ποῦ ποῦ 'στί μοι τὸ δίκτυον;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:209.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:209.1.text#σοῦ σοῦ, πάλιν σοῦ. νὴ Δί' ἦ μοι κρεῖττον ἦν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:210.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:210.1.text#τηρεῖν Σκιώνην ἀντὶ τούτου τοῦ πατρός.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:211.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:211.1.text#ἄγε νυν, ἐπειδὴ τουτονὶ σεσοβήκαμεν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:212.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:212.1.text#κοὐκ ἔσθ' ὅπως διαδὺς ἂν ἡμᾶς ἔτι λάθοι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:213.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:213.1.text#τί οὐκ ἀπεκοιμήθημεν ὅσον ὅσον στίλην;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:214.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:214.1.text#ἀλλ' ὦ πόνηρ' ἥξουσιν ὀλίγον ὕστερον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:215.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:215.1.text#οἱ ξυνδικασταὶ παρακαλοῦντες τουτονὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:216.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:216.1.textτὸν πατέρα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:216.2.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:216.2.text#τίλέγεις; ἀλλὰ νῦν γ' ὄρθρος βαθύς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:217.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:217.1.text#νὴ τὸν Δί', ὀψὲ γοῦν ἀνεστήκασι νῦν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:218.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:218.1.text#ὡς ἀπὸ μέσων νυκτῶν γε παρακαλοῦσ' ἀεί,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:219.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:219.1.text#λύχνους ἔχοντες καὶ μινυρίζοντες μέλη
urn:cts:greekLit:tlg0019.tlg004.fu.sp:220.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:220.1.text#ἀρχαῖα μελισιδωνοφρυνιχήρατα,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:221.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:221.1.textοἷς ἐκκαλοῦνται τοῦτον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:221.2.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:221.2.text#οὐκοῦν, ἢν δέῃ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:222.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:222.1.text#ἤδη ποτ' αὐτοὺς τοῖς λίθοις βαλλήσομεν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:223.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:223.1.text#ἀλλ' ὦ πόνηρε τὸ γένος ἤν τις ὀργίσῃ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:224.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:224.1.text#τὸ τῶν γερόντων, ἔσθ' ὅμοιον σφηκιᾷ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:225.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:225.1.text#ἔχουσι γὰρ καὶ κέντρον ἐκ τῆς ὀσφύος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:226.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:226.1.text#ὀξύτατον, ᾧ κεντοῦσι, καὶ κεκραγότες
urn:cts:greekLit:tlg0019.tlg004.fu.sp:227.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:227.1.text#πηδῶσι καὶ βάλλουσιν ὥσπερ φέψαλοι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:228.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:228.1.text#μὴ φροντίσῃς· ἐὰν ἐγὼ λίθους ἔχω,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:229.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:229.1.text#πολλῶν δικαστῶν σφηκιὰν διασκεδῶ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:230.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:230.1.text#χώρει πρόβαιν' ἐρρωμένως. ὦ Κωμία βραδύνεις.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:231.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:231.1.text#μὰ τὸν Δί' οὐ μέντοι πρὸ τοῦ γ', ἀλλ' ἦσθ' ἱμὰς κύνειος·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:232.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:232.1.text#νυνὶ δὲ κρείττων ἐστί σου Χαρινάδης βαδίζειν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:233.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:233.1.text#ὦ Στρυμόδωρε Κονθυλεῦ, βέλτιστε συνδικαστῶν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:234.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:234.1.text#Εὐεργίδης ἆρ' ἐστί που 'νταῦθ' ἢ Χάβης ὁ Φλυεύς;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:235.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:235.1.text#πάρεσθ' ὃ δὴ λοιπόν γ' ἔτ' ἐστίν, ἀππαπαῖ παπαιάξ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:236.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:236.1.text#ἥβης ἐκείνης ἡνίκ' ἐν Βυζαντίῳ ξυνῆμεν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:237.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:237.1.text#φρουροῦντ' ἐγώ τε καὶ σύ· κᾆτα περιπατοῦντε νύκτωρ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:238.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:238.1.text#τῆς ἀρτοπώλιδος λαθόντ' ἐκλέψαμεν τὸν ὅλμον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:239.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:239.1.text#κᾆθ' ἥψομεν τοῦ κορκόρου κατασχίσαντες αὐτόν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:240.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:240.1.text#ἀλλ' ἐγκονῶμεν ὦνδρες, ὡς ἔσται Λάχητι νυνί·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:241.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:241.1.text#σίμβλον δέ φασι χρημάτων ἔχειν ἅπαντες αὐτόν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:242.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:242.1.text#χθὲς οὖν Κλέων ὁ κηδεμὼν ἡμῖν ἐφεῖτ' ἐν ὥρᾳ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:243.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:243.1.text#ἥκειν ἔχοντας ἡμερῶν ὀργὴν τριῶν πονηρὰν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:244.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:244.1.text#ἐπ' αὐτόν, ὡς κολωμένους ὧν ἠδίκησεν. ἀλλὰ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:245.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:245.1.text#σπεύδωμεν ὦνδρες ἥλικες πρὶν ἡμέραν γενέσθαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:246.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:246.1.text#χωρῶμεν ἅμα τε τῷ λύχνῳ πάντῃ διασκοπῶμεν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:247.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:247.1.text#μή που λίθος τις ἐμποδὼν ἡμᾶς κακόν τι δράσῃ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:248.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:248.1.text#τὸν πηλὸν ὦ πάτερ πάτερ τουτονὶ φύλαξαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:249.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:249.1.text#κάρφος χαμᾶθέν νυν λαβὼν τὸν λύχνον πρόμυξον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:250.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:250.1.text#οὔκ, ἀλλὰ τῳδί μοι δοκῶ τὸν λύχνον προβύσειν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:251.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:251.1.text#τί δὴ μαθὼν τῷ δακτύλῳ τὴν θρυαλλίδ' ὠθεῖς,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:252.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:252.1.text#καὶ ταῦτα τοὐλαίου σπανίζοντος ὦνόητε;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:253.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:253.1.text#οὐ γὰρ δάκνει σ', ὅταν δέῃ τίμιον πρίασθαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:254.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:254.1.text#εἰ νὴ Δί' αὖθις κονδύλοις νουθετήσεθ' ἡμᾶς,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:255.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:255.1.text#ἀποσβέσαντες τοὺς λύχνους ἄπιμεν οἴκαδ' αὐτοί·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:256.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:256.1.text#κἄπειτ' ἴσως ἐν τῷ σκότῳ τουτουὶ στερηθεὶς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:257.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:257.1.text#τὸν πηλὸν ὥσπερ ἀτταγᾶς τυρβάσεις βαδίζων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:258.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:258.1.text#ἦ μὴν ἐγὼ σοῦ χἀτέρους μείζονας κολάζω.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:259.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:259.1.text#ἀλλ' οὑτοσί μοι βόρβορος φαίνεται πατοῦντι·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:260.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:260.1.text#κοὐκ ἔσθ' ὅπως οὐχ ἡμερῶν τεττάρων τὸ πλεῖστον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:261.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:261.1.text#ὕδωρ ἀναγκαίως ἔχει τὸν θεὸν ποιῆσαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:262.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:262.1.text#ἔπεισι γοῦν τοῖσιν λύχνοις οὑτοιὶ μύκητες·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:263.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:263.1.text#φιλεῖ δ', ὅταν τοῦτ' ᾖ, ποιεῖν ὑετὸν μάλιστα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:264.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:264.1.text#δεῖται δὲ καὶ τῶν καρπίμων ἅττα μή 'στι πρῷα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:265.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:265.1.text#ὕδωρ γενέσθαι κἀπιπνεῦσαι βόρειον αὐτοῖς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:266.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:266.1.text#τί χρῆμ' ἄρ' οὑκ τῆς οἰκίας τῆσδε συνδικαστὴς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:267.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:267.1.text#πέπονθεν, ὡς οὐ φαίνεται δεῦρο πρὸς τὸ πλῆθος;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:268.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:268.1.text#οὐ μὴν πρὸ τοῦ γ' ἐφολκὸς ἦν, ἀλλὰ πρῶτος ἡμῶν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:269.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:269.1.text#ἡγεῖτ' ἂν ᾄδων Φρυνίχου· καὶ γάρ ἐστιν ἁνὴρ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:270.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:270.1.text#φιλῳδός. ἀλλά μοι δοκεῖ στάντας ἐνθάδ' ὦνδρες
urn:cts:greekLit:tlg0019.tlg004.fu.sp:271.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:271.1.text#ᾄδοντας αὐτὸν ἐκκαλεῖν, ἤν τί πως ἀκούσας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:272.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:272.1.text#τοὐμοῦ μέλους ὑφ' ἡδονῆς ἑρπύσῃ θύραζε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:273.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:273.1.text#τί ποτ' οὐ πρὸ θυρῶν φαίνετ' ἄρ' ἡμῖν ὁ γέρων οὐδ' ὑπακούει;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:274.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:274.1.text#μῶν ἀπολώλεκε τὰς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:275.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:275.1.text#ἐμβάδας, ἢ προσέκοψ' ἐν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:275a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:275a.text#τῷ σκότῳ τὸν δάκτυλόν που,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:276.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:276.1.text#εἶτ' ἐφλέγμηνεν αὐτοῦ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:276a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:276a.text#τὸ σφυρὸν γέροντος ὄντος;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:277.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:277.1.text#καὶ τάχ' ἂν βουβωνιῴη.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:278.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:278.1.text#ἦ μὴν πολὺ δριμύτατός γ' ἦν τῶν παρ' ἡμῖν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:278a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:278a.text#καὶ μόνος οὐκ ἂν ἐπείθετ',
urn:cts:greekLit:tlg0019.tlg004.fu.sp:279.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:279.1.text#ἀλλ' ὁπότ' ἀντιβολοίη
urn:cts:greekLit:tlg0019.tlg004.fu.sp:279a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:279a.text#τις, κάτω κύπτων ἂν οὕτω
urn:cts:greekLit:tlg0019.tlg004.fu.sp:280.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:280.1.text#"λίθον ἕψεις," ἔλεγεν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:281.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:281.1.text#τάχα δ' ἂν διὰ τὸν χθιζινὸν ἄνθρωπον, ὃς ἡμᾶς διεδύετ'
urn:cts:greekLit:tlg0019.tlg004.fu.sp:282.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:282.1.text#ἐξαπατῶν καὶ λέγων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:282a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:282a.text#ὡς φιλαθήναιος ἦν καὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:283.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:283.1.text#τἀν Σάμῳ πρῶτος κατείποι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:283a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:283a.text#διὰ τοῦτ' ὀδυνηθεὶς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:284.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:284.1.text#εἶτ' ἴσως κεῖται πυρέττων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:285.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:285.1.text#ἔστι γὰρ τοιοῦτος ἁνήρ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:286.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:286.1.text#ἀλλ' ὦγάθ' ἀνίστασο μηδ' οὕτω σεαυτὸν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:287.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:287.1.text#ἔσθιε μηδ' ἀγανάκτει.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:287a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:287a.text#καὶ γὰρ ἀνὴρ παχὺς ἥκει
urn:cts:greekLit:tlg0019.tlg004.fu.sp:288.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:288.1.text#τῶν προδόντων τἀπὶ Θρᾴκης·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:289.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:289.1.text#ὃν ὅπως ἐγχυτριεῖς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:290.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:290.1.text#ὕπαγ' ὦ παῖ ὕπαγε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:291.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:291.1.text#ἐθελήσεις τί μοι οὖν ὦ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:292.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:292.1.text#πάτερ, ἤν σού τι δεηθῶ;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:293.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:293.1.text#πάνυ γ' ὦ παιδίον. ἀλλ' εἰπέ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:294.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:294.1.text#τί βούλει με πρίασθαι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:295.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:295.1.text#καλόν; οἶμαι δέ σ' ἐρεῖν ἀστραγάλους
urn:cts:greekLit:tlg0019.tlg004.fu.sp:295a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:295a.text#δήπουθεν ὦ παῖ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:296.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:296.1.text#μὰ Δί' ἀλλ' ἰσχάδας ὦ παππία·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:297.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:297.1.textἥδιον γάρ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:297.2.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:297.2.text#οὐκ ἂν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:298.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:298.1.text#μὰ Δί', εἰ κρέμαισθέ γ' ὑμεῖς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:299.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:299.1.text#μὰ Δί' οὔ τἄρα προπέμψω σε τὸ λοιπόν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:300.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:300.1.text#ἀπὸ γὰρ τοῦδέ με τοῦ μισθαρίου
urn:cts:greekLit:tlg0019.tlg004.fu.sp:301.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:301.1.text#τρίτον αὐτὸν ἔχειν ἄλφιτα δεῖ καὶ ξύλα κὤψον·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:302.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:302.1.text#ἒ ἔ. σὺ δὲ σῦκά μ' αἰτεῖς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:303.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:303.1.text#ἄγε νυν ὦ πάτερ ἢν μὴ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:304.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:304.1.text#τὸ δικαστήριον ἅρχων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:305.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:305.1.text#καθίσῃ νῦν, πόθεν ὠνησόμεθ'
urn:cts:greekLit:tlg0019.tlg004.fu.sp:306.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:306.1.text#ἄριστον; ἔχεις ἐλπίδα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:307.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:307.1.text#χρηστήν τινα νῷν ἢ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:308.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:308.1.text#πόρον Ἕλλας ἱρὸν εὑρεῖν;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:309.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:309.1.text#ἀπαπαῖ φεῦ, ἀπαπαῖ φεῦ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:310.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:310.1.textμὰ Δί' οὐκ ἔγωγε νῷν οἶδ'
urn:cts:greekLit:tlg0019.tlg004.fu.sp:311.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:311.1.textὁπόθεν γε δεῖπνον ἔσται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:312.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:312.1.text#τί με δῆτ' ὦ μελέα μῆτερ ἔτικτες;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:313.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:313.1.text#ἵν' ἐμοὶ πράγματα βόσκειν παρέχῃς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:314.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:314.1.text#ἀνόνητον ἄρ' ὦ θυλάκιόν σ' εἶχον ἄγαλμα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:315.1.speaker#Παίς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:315.1.text#ἒ ἔ. πάρα νῷν στενάζειν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:316.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:316.1.text#φίλοι, τήκομαι μὲν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:317.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:317.1.text#πάλαι διὰ τῆς ὀπῆς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:317a.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:317a.text#ὑμῶν ὑπακούων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:318.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:318.1.text#ἀλλὰ γὰρ οὐχ οἷός τ' εἴμ'
urn:cts:greekLit:tlg0019.tlg004.fu.sp:318a.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:318a.text#ᾄδειν. τί ποιήσω;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:319.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:319.1.text#τηροῦμαι δ' ὑπὸ τῶνδ', ἐπεὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:320.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:320.1.text#βούλομαί γε πάλαι μεθ' ὑμῶν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:321.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:321.1.text#ἐλθὼν ἐπὶ τοὺς καδίσκους
urn:cts:greekLit:tlg0019.tlg004.fu.sp:322.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:322.1.text#κακόν τι ποιῆσαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:323.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:323.1.text#ἀλλ' ὦ Ζεῦ Ζεῦ μέγα βροντήσας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:324.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:324.1.text#ἤ με ποίησον καπνὸν ἐξαίφνης
urn:cts:greekLit:tlg0019.tlg004.fu.sp:325.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:325.1.text#ἢ Προξενίδην ἢ τὸν Σέλλου
urn:cts:greekLit:tlg0019.tlg004.fu.sp:326.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:326.1.text#τοῦτον τὸν ψευδαμάμαξυν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:327.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:327.1.text#τόλμησον ἄναξ χαρίσασθαί μοι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:328.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:328.1.text#πάθος οἰκτίρας· ἤ με κεραυνῷ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:329.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:329.1.text#διατινθαλέῳ σπόδισον ταχέως,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:330.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:330.1.text#κἄπειτ' ἀνελών μ' ἀποφυσήσας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:331.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:331.1.text#εἰς ὀξάλμην ἔμβαλε θερμήν·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:332.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:332.1.text#ἢ δῆτα λίθον με ποίησον ἐφ' οὗ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:333.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:333.1.text#τὰς χοιρίνας ἀριθμοῦσι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:334.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:334.1.text#τίς γάρ ἐσθ' ὁ ταῦτά σ' εἵργων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:334a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:334a.text#κἀποκλῄων τῇ θύρᾳ; λέξον·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:335.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:335.1.text#πρὸς εὔνους γὰρ φράσεις.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:336.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:336.1.text#οὑμὸς υἱός. ἀλλὰ μὴ βοᾶτε· καὶ γὰρ τυγχάνει
urn:cts:greekLit:tlg0019.tlg004.fu.sp:337.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:337.1.text#οὑτοσὶ πρόσθεν καθεύδων. ἀλλ' ὕφεσθε τοῦ τόνου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:338.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:338.1.text#τοῦ δ' ἔφεξιν ὦ μάταιε ταῦτα δρᾶν σε βούλεται;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:339.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:339.1.text#καὶ τίνα πρόφασιν ἔχων;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:340.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:340.1.text#οὐκ ἐᾷ μ' ὦνδρες δικάζειν οὐδὲ δρᾶν οὐδὲν κακόν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:341.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:341.1.text#ἀλλά μ' εὐωχεῖν ἕτοιμός ἐστ'· ἐγὼ δ' οὐ βούλομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:342.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:342.1.text#τοῦτ' ἐτόλμησ' ὁ μιαρὸς χανεῖν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:342a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:342a.text#ὁ Δημολογοκλέων ὅδ', 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:343.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:343.1.text#ὅτι λέγεις σύ τι περὶ τῶν νεῶν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:343a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:343a.text#ἀληθές. οὐ γὰρ ἄν ποθ'
urn:cts:greekLit:tlg0019.tlg004.fu.sp:344.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:344.1.text#οὗτος ἁνὴρ τοῦτ' ἐτόλμησεν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:344a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:344a.text#λέγειν, εἰ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:345.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:345.1.text#μὴ ξυνωμότης τις ἦν. 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:346.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:346.1.text#ἀλλ' ἐκ τούτων ὥρα τινά σοι ζητεῖν καινὴν ἐπίνοιαν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:347.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:347.1.text#ἥτις σε λάθρᾳ τἀνδρὸς τουδὶ καταβῆναι δεῦρο ποιήσει. 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:348.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:348.1.text#τίς ἂν οὖν εἴη; ζητεῖθ' ὑμεῖς, ὡς πᾶν ἂν ἔγωγε ποιοίην·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:349.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:349.1.text#οὕτω κιττῶ διὰ τῶν σανίδων μετὰ χοιρίνης περιελθεῖν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:350.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:350.1.text#ἔστιν ὀπὴ δῆθ' ἥντιν' ἂν ἔνδοθεν οἷός τ' εἴης διορύξαι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:351.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:351.1.text#εἶτ' ἐκδῦναι ῥάκεσιν κρυφθεὶς ὥσπερ πολύμητις Ὀδυσσεύς;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:352.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:352.1.text#πάντα πέφαρκται κοὐκ ἔστιν ὀπῆς οὐδ' εἰ σέρφῳ διαδῦναι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:353.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:353.1.text#ἀλλ' ἄλλο τι δεῖ ζητεῖν ὑμᾶς· ὀπίαν δ' οὐκ ἔστι γενέσθαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:354.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:354.1.text#μέμνησαι δῆθ', ὅτ' ἐπὶ στρατιᾶς κλέψας ποτὲ τοὺς ὀβελίσκους
urn:cts:greekLit:tlg0019.tlg004.fu.sp:355.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:355.1.text#ἵεις σαυτὸν κατὰ τοῦ τείχους ταχέως, ὅτε Νάξος ἑάλω.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:356.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:356.1.text#οἶδ'· ἀλλὰ τί τοῦτ'; οὐδὲν γὰρ τοῦτ' ἐστὶν ἐκείνῳ προσόμοιον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:357.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:357.1.text#ἥβων γὰρ κἀδυνάμην κλέπτειν, ἴσχυόν τ' αὐτὸς ἐμαυτοῦ, 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:358.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:358.1.text#κοὐδείς μ' ἐφύλαττ', ἀλλ' ἐξῆν μοι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:359.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:359.1.text#φεύγειν ἀδεῶς. νῦν δὲ ξὺν ὅπλοις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:360.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:360.1.text#ἄνδρες ὁπλῖται διαταξάμενοι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:361.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:361.1.text#κατὰ τὰς διόδους σκοπιωροῦνται,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:362.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:362.1.text#τὼ δὲ δύ' αὐτῶν ἐπὶ ταῖσι θύραις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:363.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:363.1.text#ὥσπερ με γαλῆν κρέα κλέψασαν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:364.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:364.1.text#τηροῦσιν ἔχοντ' ὀβελίσκους.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:365.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:365.1.text#ἀλλὰ καὶ νῦν ἐκπόριζε
urn:cts:greekLit:tlg0019.tlg004.fu.sp:366.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:366.1.text#μηχανὴν ὅπως τάχισθ'· ἕως
urn:cts:greekLit:tlg0019.tlg004.fu.sp:366a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:366a.text#γάρ, ὦ μελίττιον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:367.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:367.1.text#διατραγεῖν τοίνυν κράτιστόν ἐστί μοι τὸ δίκτυον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:368.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:368.1.text#ἡ δέ μοι Δίκτυννα συγγνώμην ἔχοι τοῦ δικτύου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:369.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:369.1.text#ταῦτα μὲν πρὸς ἀνδρός ἐστ' ἄνοντος ἐς σωτηρίαν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:370.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:370.1.text#ἀλλ' ἔπαγε τὴν γνάθον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:371.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:371.1.text#διατέτρωκται τοῦτό γ'. ἀλλὰ μὴ βοᾶτε μηδαμῶς,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:372.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:372.1.text#ἀλλὰ τηρώμεσθ' ὅπως μὴ Βδελυκλέων αἰσθήσεται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:373.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:373.1.text#μηδὲν ὦ τᾶν δέδιθι, μηδέν·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:374.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:374.1.text#ὡς ἐγὼ τοῦτόν γ', ἐὰν γρύξῃ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:374a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:374a.text#τι, ποιήσω δακεῖν τὴν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:375.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:375.1.text#καρδίαν καὶ τὸν περὶ ψυχῆς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:376.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:376.1.text#δρόμον δραμεῖν, ἵν' εἰδῇ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:377.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:377.1.text#μὴ πατεῖν τὰ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:378.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:378.1.text#τοῖν θεοῖν ψηφίσματα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:379.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:379.1.text#ἀλλ' ἐξάψας διὰ τῆς θυρίδος τὸ καλῴδιον εἶτα καθίμα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:380.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:380.1.text#δήσας σαυτὸν καὶ τὴν ψυχὴν ἐμπλησάμενος Διοπείθους.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:381.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:381.1.text#ἄγε νυν, ἢν αἰσθομένω τούτω ζητῆτόν μ' ἐσκαλαμᾶσθαι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:382.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:382.1.text#κἀνασπαστὸν ποιεῖν εἴσω, τί ποιήσετε; φράζετε νυνί.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:383.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:383.1.text#ἀμυνοῦμέν σοι τὸν πρινώδη θυμὸν ἅπαντες καλέσαντες
urn:cts:greekLit:tlg0019.tlg004.fu.sp:384.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:384.1.text#ὥστ' οὐ δυνατόν σ' εἵργειν ἔσται· τοιαῦτα ποιήσομεν ἡμεῖς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:385.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:385.1.text#δράσω τοίνυν ὑμῖν πίσυνος, καὶ — μανθάνετ'; — ἤν τι πάθω 'γώ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:386.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:386.1.text#ἀνελόντες καὶ κατακλαύσαντες θεῖναί μ' ὑπὸ τοῖσι δρυφάκτοις.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:387.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:387.1.text#οὐδὲν πείσει· μηδὲν δείσῃς. ἀλλ' ὦ βέλτιστε καθίει
urn:cts:greekLit:tlg0019.tlg004.fu.sp:388.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:388.1.text#σαυτὸν θαρρῶν κἀπευξάμενος τοῖσι πατρῴοισι θεοῖσιν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:389.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:389.1.text#ὦ Λύκε δέσποτα, γείτων ἥρως· σὺ γὰρ οἷσπερ ἐγὼ κεχάρησαι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:390.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:390.1.text#τοῖς δακρύοισιν τῶν φευγόντων ἀεὶ καὶ τοῖς ὀλοφυρμοῖς·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:391.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:391.1.text#ᾤκησας γοῦν ἐπίτηδες ἰὼν ἐνταῦθ' ἵνα ταῦτ' ἀκροῷο,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:392.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:392.1.text#κἀβουλήθης μόνος ἡρώων παρὰ τὸν κλάοντα καθῆσθαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:393.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:393.1.text#ἐλέησον καὶ σῶσον νυνὶ τὸν σαυτοῦ πλησιόχωρον·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:394.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:394.1.text#κοὐ μή ποτέ σου παρὰ τὰς κάννας οὐρήσω μηδ' ἀποπάρδω.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:395.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:395.1.textοὗτος ἐγείρου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:395.2.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:395.2.text#τί τὸ πρᾶγμ';
urn:cts:greekLit:tlg0019.tlg004.fu.sp:395.3.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:395.3.text#ὥσπερ φωνή μέ τις ἐγκεκύκλωται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:396.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:396.1.textμῶν ὁ γέρων πῃ διαδύεται αὖ;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:396.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:396.2.text#μὰ Δί' οὐ δῆτ', ἀλλὰ καθιμᾷ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:397.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:397.1.textαὑτὸν δήσας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:397.2.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:397.2.text#ὦ μιαρώτατε τί ποιεῖς; οὐ μὴ καταβήσει;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:398.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:398.1.text#ἀνάβαιν' ἀνύσας κατὰ τὴν ἑτέραν καὶ ταῖσιν φυλλάσι παῖε,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:399.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:399.1.text#ἤν πως πρύμνην ἀνακρούσηται πληγεὶς ταῖς εἰρεσιώναις.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:400.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:400.1.text#οὐ ξυλλήψεσθ' ὁπόσοισι δίκαι τῆτες μέλλουσιν ἔσεσθαι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:401.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:401.1.text#ὦ Σμικυθίων καὶ Τεισιάδη καὶ Χρήμων καὶ Φερέδειπνε;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:402.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:402.1.text#πότε δ', εἰ μὴ νῦν, ἐπαρήξετέ μοι, πρίν μ' εἴσω μᾶλλον ἄγεσθαι; 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:403.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:403.1.text#εἰπέ μοι τί μέλλομεν κινεῖν ἐκείνην τὴν χολήν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:404.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:404.1.text#ἥνπερ, ἡνίκ' ἄν τις ἡμῶν ὀργίσῃ τὴν σφηκιάν;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:405.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:405.1.text#νῦν ἐκεῖνο νῦν ἐκεῖνο
urn:cts:greekLit:tlg0019.tlg004.fu.sp:406.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:406.1.text#τοὐξύθυμον, ᾧ κολαζόμεσθα,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:407.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:407.1.text#κέντρον †ἐντέτατ' ὀξύ†.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:408.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:408.1.text#ἀλλὰ θαἰμάτια βαλόντες ὡς τάχιστα, παιδία,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:409.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:409.1.text#θεῖτε καὶ βοᾶτε, καὶ Κλέωνι ταῦτ' ἀγγέλλετε,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:410.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:410.1.text#καὶ κελεύετ' αὐτὸν ἥκειν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:411.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:411.1.text#ὡς ἐπ' ἄνδρα μισόπολιν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:412.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:412.1.text#ὄντα κἀπολούμενον, ὅτι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:413.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:413.1.text#τόνδε λόγον ἐσφέρει,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:414.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:414.1.text#μὴ δικάζειν δίκας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:415.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:415.1.text#ὦγαθοὶ τὸ πρᾶγμ' ἀκούσατ', ἀλλὰ μὴ κεκράγετε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:416.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:416.1.textνὴ Δί' ἐς τὸν οὐρανόν γ'.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:416.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:416.2.text#ὡς τοῦδ' ἐγὼ οὐ μεθήσομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:417.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:417.1.text#ταῦτα δῆτ' οὐ δεινὰ καὶ τυραννίς ἐστιν ἐμφανής;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:418.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:418.1.text#ὦ πόλις καὶ Θεώρου θεοισεχθρία,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:419.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:419.1.text#κεἴ τις ἄλλος προέστηκεν ἡμῶν κόλαξ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:420.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:420.1.text#Ἡράκλεις καὶ κέντρ' ἔχουσιν. οὐχ ὁρᾷς ὦ δέσποτα;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:421.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:421.1.text#οἷς γ' ἀπώλεσαν Φίλιππον ἐν δίκῃ τὸν Γοργίου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:422.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:422.1.text#καὶ σέ γ' αὐτοῖς ἐξολοῦμεν· ἀλλὰ πᾶς ἐπίστρεφε
urn:cts:greekLit:tlg0019.tlg004.fu.sp:423.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:423.1.text#δεῦρο κἀξείρας τὸ κέντρον εἶτ' ἐπ' αὐτὸν ἵεσο,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:424.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:424.1.text#ξυσταλεὶς εὔτακτος ὀργῆς καὶ μένους ἐμπλήμενος,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:425.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:425.1.text#ὡς ἂν εὖ εἰδῇ τὸ λοιπὸν σμῆνος οἷον ὤργισεν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:426.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:426.1.text#τοῦτο μέντοι δεινὸν ἤδη νὴ Δί', εἰ μαχούμεθα·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:427.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:427.1.text#ὡς ἔγωγ' αὐτῶν ὁρῶν δέδοικα τὰς ἐγκεντρίδας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:428.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:428.1.text#ἀλλ' ἀφίει τὸν ἄνδρ'· εἰ δὲ μή, φήμ' ἐγὼ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:429.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:429.1.text#τὰς χελώνας μακαριεῖν σε τοῦ δέρματος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:430.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:430.1.text#εἶά νυν ὦ ξυνδικασταὶ σφῆκες ὀξυκάρδιοι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:431.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:431.1.text#οἱ μὲν ἐς τὸν πρωκτὸν αὐτῶν ἐσπέτεσθ' ὠργισμένοι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:432.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:432.1.text#οἱ δὲ τὠφθαλμὼ κύκλῳ κεντεῖτε καὶ τοὺς δακτύλους.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:433.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:433.1.text#ὦ Μίδα καὶ Φρὺξ βοήθει δεῦρο καὶ Μασιντύα,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:434.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:434.1.text#καὶ λάβεσθε τουτουὶ καὶ μὴ μεθῆσθε μηδενί·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:435.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:435.1.text#εἰ δὲ μή, 'ν πέδαις παχείαις οὐδὲν ἀριστήσετε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:436.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:436.1.text#ὡς ἐγὼ πολλῶν ἀκούσας οἶδα θρίων τὸν ψόφον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:437.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:437.1.text#εἰ δὲ μὴ τοῦτον μεθήσεις, ἔν τί σοι παγήσεται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:438.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:438.1.text#ὦ Κέκροψ ἥρως ἄναξ τὰ πρὸς ποδῶν Δρακοντίδη,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:439.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:439.1.text#περιορᾷς οὕτω μ' ὑπ' ἀνδρῶν βαρβάρων χειρούμενον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:440.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:440.1.text#οὓς ἐγὼ 'δίδαξα κλάειν τέτταρ' ἐς τὴν χοίνικα;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:441.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:441.1.text#εἶτα δῆτ' οὐ πόλλ' ἔνεστι δεινὰ τῷ γήρᾳ κακά;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:442.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:442.1.text#δηλαδή· καὶ νῦν γε τούτω τὸν παλαιὸν δεσπότην
urn:cts:greekLit:tlg0019.tlg004.fu.sp:443.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:443.1.text#πρὸς βίαν χειροῦσιν, οὐδὲν τῶν πάλαι μεμνημένοι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:444.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:444.1.text#διφθερῶν κἀξωμίδων, ἃς οὗτος αὐτοῖς ἠμπόλα,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:445.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:445.1.text#καὶ κυνᾶς· καὶ τοὺς πόδας χειμῶνος ὄντος ὠφέλει,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:446.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:446.1.text#ὥστε μὴ ῥιγῶν ἑκάστοτ'· ἀλλὰ τούτοις γ' οὐκ ἔνι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:447.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:447.1.text#οὐδ' ἐν ὀφθαλμοῖσιν αἰδὼς τῶν παλαιῶν ἐμβάδων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:448.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:448.1.text#οὐκ ἀφήσεις οὐδὲ νυνί μ' ὦ κάκιστον θηρίον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:449.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:449.1.text#οὐδ' ἀναμνησθεὶς ὅθ' εὑρὼν τοὺς βότρυς κλέπτοντά σε
urn:cts:greekLit:tlg0019.tlg004.fu.sp:450.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:450.1.text#προσαγαγὼν πρὸς τὴν ἐλάαν ἐξέδειρ' εὖ κἀνδρικῶς,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:451.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:451.1.text#ὥστε σε ζηλωτὸν εἶναι; σὺ δ' ἀχάριστος ἦσθ' ἄρα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:452.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:452.1.text#ἀλλ' ἄνες με καὶ σὺ καὶ σύ, πρὶν τὸν υἱὸν ἐκδραμεῖν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:453.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:453.1.text#ἀλλὰ τούτων μὲν τάχ' ἡμῖν δώσετον καλὴν δίκην,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:454.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:454.1.text#οὐκέτ' ἐς μακρὰν ἵν' εἰδῆθ' οἷός ἐστ' ἀνδρῶν τρόπος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:455.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:455.1.text#ὀξυθύμων καὶ δικαίων καὶ βλεπόντων κάρδαμα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:456.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:456.1.text#παῖε παἶ ὦ Ξανθία τοὺς σφῆκας ἀπὸ τῆς οἰκίας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:457.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:457.1.text#ἀλλὰ δρῶ τοῦτ'· ἀλλὰ καὶ σὺ τῦφε πολλῷ τῷ καπνῷ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:458.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:458.1.text#οὐχὶ σοῦσθ'; οὐκ ἐς κόρακας; οὐκ ἄπιτε; παῖε τῷ ξύλῳ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:459.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:459.1.text#καὶ σὺ προσθεὶς Αἰσχίνην ἔντυφε τὸν Σελλαρτίου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:460.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:460.1.text#ἆρ' ἐμέλλομέν ποθ' ὑμᾶς ἀποσοβήσειν τῷ χρόνῳ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:461.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:461.1.text#ἀλλὰ μὰ Δί' οὐ ῥᾳδίως οὕτως ἂν αὐτοὺς διέφυγες,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:462.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:462.1.text#εἴπερ ἔτυχον τῶν μελῶν τῶν Φιλοκλέους βεβρωκότες.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:463.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:463.1.text#ἆρα δῆτ' οὐκ αὐτὰ δῆλα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:464.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:464.1.text#τοῖς πένησιν, ἡ τυραννὶς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:465.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:465.1.text#†ὡς λάθρᾳ γ' ἐλάνθαν' ὑπιοῦσά με,†
urn:cts:greekLit:tlg0019.tlg004.fu.sp:466.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:466.1.text#εἰ σύ γ' ὦ πόνῳ πόνηρε καὶ κομηταμυνία
urn:cts:greekLit:tlg0019.tlg004.fu.sp:467.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:467.1.text#τῶν νόμων ἡμᾶς ἀπείργεις ὧν ἔθηκεν ἡ πόλις,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:468.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:468.1.text#οὔτε τιν' ἔχων πρόφασιν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:469.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:469.1.text#οὔτε λόγον εὐτράπελον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:470.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:470.1.text#αὐτὸς ἄρχων μόνος;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:471.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:471.1.text#ἔσθ' ὅπως ἄνευ μάχης καὶ τῆς κατοξείας βοῆς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:472.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:472.1.text#ἐς λόγους ἔλθοιμεν ἀλλήλοισι καὶ διαλλαγάς;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:473.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:473.1.text#σοὐς λόγους ὦ μισόδημε καὶ μοναρχίας ἐραστά,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:475.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:475.1.text#καὶ ξυνὼν Βρασίδᾳ καὶ φορῶν κράσπεδα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:476.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:476.1.text#στεμμάτων τήν θ' ὑπήνην ἄκουρον τρέφων;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:477.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:477.1.text#νὴ Δί' ἦ μοι κρεῖττον ἐκστῆναι τὸ παράπαν τοῦ πατρὸς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:478.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:478.1.text#μᾶλλον ἢ κακοῖς τοσούτοις ναυμαχεῖν ὁσημέραι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:480.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:480.1.text#οὐδὲ μὴν οὐδ' ἐν σελίνῳ σοὐστὶν οὐδ' ἐν πηγάνῳ·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:481.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:481.1.text#τοῦτο γὰρ παρεμβαλοῦμεν τῶν τριχοινίκων ἐπῶν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:482.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:482.1.text#ἀλλὰ νῦν μὲν οὐδὲν ἀλγεῖς, ἀλλ' ὅταν ξυνήγορος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:483.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:483.1.text#ταὐτὰ ταῦτα σου καταντλῇ καὶ ξυνωμότας καλῇ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:484.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:484.1.text#ἆρ' ἂν ὦ πρὸς τῶν θεῶν ὑμεῖς ἀπαλλαχθεῖτέ μου;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:485.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:485.1.text#ἢ δέδοκταί μοι δέρεσθαι καὶ δέρειν δι' ἡμέρας;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:486.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:486.1.text#οὐδέποτέ γ', οὐχ ἕως ἄν τί μου λοιπὸν ᾖ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:487.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:487.1.text#ὅστις ἡμῶν ἐπὶ τυραννίδ' ὧδ' ἐστάλης.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:488.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:488.1.text#ὡς ἅπανθ' ὑμῖν τυραννίς ἐστι καὶ ξυνωμόται,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:489.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:489.1.text#ἤν τε μεῖζον ἤν τ' ἔλαττον πρᾶγμά τις κατηγορῇ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:490.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:490.1.text#ἧς ἐγὼ οὐκ ἤκουσα τοὔνομ' οὐδὲ πεντήκοντ' ἐτῶν·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:491.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:491.1.text#νῦν δὲ πολλῷ τοῦ ταρίχους ἐστὶν ἀξιωτέρα,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:492.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:492.1.text#ὥστε καὶ δὴ τοὔνομ' αὐτῆς ἐν ἀγορᾷ κυλίνδεται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:493.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:493.1.text#ἢν μὲν ὠνῆταί τις ὀρφὼς μεμβράδας δὲ μὴ 'θέλῃ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:494.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:494.1.text#εὐθέως εἴρηχ' ὁ πωλῶν πλησίον τὰς μεμβράδας·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:495.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:495.1.text#'ο'ὗτος ὀψωνεῖν ἔοιχ' ἅνθρωπος ἐπὶ τυραννίδι.'
urn:cts:greekLit:tlg0019.tlg004.fu.sp:496.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:496.1.text#ἢν δὲ γήτειον προσαιτῇ ταῖς ἀφύαις ἥδυσμά τι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:497.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:497.1.text#ἡ λαχανόπωλις παραβλέψασά φησι θατέρῳ·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:498.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:498.1.text#"εἰπέ μοι, γήτειον αἰτεῖς· πότερον ἐπὶ τυραννίδι,"
urn:cts:greekLit:tlg0019.tlg004.fu.sp:499.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:499.1.text#"ἢ νομίζεις τὰς Ἀθήνας σοὶ φέρειν ἡδύσματα;"
urn:cts:greekLit:tlg0019.tlg004.fu.sp:500.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:500.1.text#κἀμέ γ' ἡ πόρνη χθὲς εἰσελθόντα τῆς μεσημβρίας,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:501.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:501.1.text#ὅτι κελητίσαι 'κέλευον, ὀξυθυμηθεῖσά μοι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:502.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:502.1.text#ἤρετ' εἰ τὴν Ἱππίου καθίσταμαι τυραννίδα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:503.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:503.1.text#ταῦτα γὰρ τούτοις ἀκούειν ἡδἔ, εἰ καὶ νῦν ἐγὼ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:504.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:504.1.text#τὸν πατέρ' ὅτι βούλομαι τούτων ἀπαλλαχθέντα τῶν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:505.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:505.1.text#ὀρθροφοιτοσυκοφαντοδικοταλαιπώρων τρόπων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:506.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:506.1.text#ζῆν βίον γενναῖον ὥσπερ Μόρυχος, αἰτίαν ἔχω
urn:cts:greekLit:tlg0019.tlg004.fu.sp:507.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:507.1.text#ταῦτα δρᾶν ξυνωμότης ὢν καὶ φρονῶν τυραννικά.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:508.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:508.1.text#νὴ Δί' ἐν δίκῃ γ'· ἐγὼ γὰρ οὐδ' ἂν ὀρνίθων γάλα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:509.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:509.1.text#ἀντὶ τοῦ βίου λάβοιμ' ἂν οὗ με νῦν ἀποστερεῖς·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:510.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:510.1.text#οὐδὲ χαίρω βατίσιν οὐδ' ἐγχέλεσιν, ἀλλ' ἥδιον ἄν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:511.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:511.1.text#δικίδιον σμικρὸν φάγοιμ' ἂν ἐν λοπάδι πεπνιγμένον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:512.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:512.1.text#νὴ Δί' εἰθίσθης γὰρ ἥδεσθαι τοιούτοις πράγμασιν·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:513.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:513.1.text#ἀλλ' ἐὰν σιγῶν ἀνάσχῃ καὶ μάθῃς ἁγὼ λέγω,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:514.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:514.1.text#ἀναδιδάξειν οἴομαί σ' ὡς πάντα ταῦθ' ἁμαρτάνεις.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:515.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:515.1.textἐξαμαρτάνω δικάζων;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:515.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:515.2.text#καταγελώμενος μὲν οὖν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:516.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:516.1.text#οὐκ ἐπαϊεις ὑπ' ἀνδρῶν, οὓς σὺ μόνον οὐ προσκυνεῖς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:517.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:517.1.textἀλλὰ δουλεύων λέληθας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:517.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:517.2.text#παῦε δουλείαν λέγων,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:518.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:518.1.textὅστις ἄρχω τῶν ἁπάντων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:518.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:518.2.text#οὐ σύ γ', ἀλλ' ὑπηρετεῖς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:519.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:519.1.text#οἰόμενος ἄρχειν· ἐπεὶ δίδαξον ἡμᾶς ὦ πάτερ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:520.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:520.1.text#ἥτις ἡ τιμή 'στί σοι καρπουμένῳ τὴν Ἑλλάδα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:521.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:521.1.textπάνυ γε, καὶ τούτοισί γ' ἐπιτρέψαι 'θέλω.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:521.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:521.2.text#καὶ μὴν ἐγώ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:522.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:522.1.textἄφετέ νυν ἅπαντες αὐτόν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:522.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:522.2.text#καὶ ξίφος γέ μοι δότε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:523.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:523.1.text#ἢν γὰρ ἡττηθῶ λέγων σου, περιπεσοῦμαι τῷ ξίφει.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:524.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:524.1.text#εἰπέ μοι, τί δ' ἤν, τὸ δεῖνα, τῇ διαίτῃ μὴ 'μμένῃς;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:525.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:525.1.text#μηδέποτε πίοιμ' ἀκράτου μισθὸν ἀγαθοῦ δαίμονος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:526.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:526.1.text#νῦν δὴ τὸν ἐκ θἠμετέρου
urn:cts:greekLit:tlg0019.tlg004.fu.sp:527.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:527.1.text#γυμνασίου δεῖ τι λέγειν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:528.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:528.1.text#καινόν, ὅπως φανήσει —
urn:cts:greekLit:tlg0019.tlg004.fu.sp:529.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:529.1.text#ἐνεγκάτω μοι δεῦρο τὴν κίστην τις ὡς τάχιστα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:530.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:530.1.text#ἀτὰρ φανεῖ ποῖός τις ὤν, ἢν ταῦτα παρακελεύῃ;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:531.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:531.1.text#μὴ κατὰ τὸν νεανίαν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:532.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:532.1.text#τονδὶ λέγων. ὁρᾷς γὰρ ὥς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:533.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:533.1.text#σοι μέγας ἐστὶν ἁγὼν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:534.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:534.1.text#καὶ περὶ τῶν ἁπάντων,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:535.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:535.1.text#εἴπερ, ὃ μὴ γένοιθ', οὗτός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:536.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:536.1.text#σ' ἐθέλει κρατῆσαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:537.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:537.1.text#καὶ μὴν ὅσ' ἂν λέξῃ γ' ἁπλῶς μνημόσυνα γράψομαι 'γώ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:538.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:538.1.text#τί γὰρ φάθ' ὑμεῖς, ἢν ὁδί με τῷ λόγῳ κρατήσῃ;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:540.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:540.1.text#οὐκέτι πρεσβυτῶν ὄχλος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:541.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:541.1.text#χρήσιμος ἔστ' οὐδ' ἀκαρῆ·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:542.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:542.1.text#σκωπτόμενοι δ' ἐν ταῖς ὁδοῖς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:543.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:543.1.text#θαλλοφόροι καλούμεθ', ἀντωμοσιῶν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:545.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:545.1.text#κελύφη.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:546.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:546.1.text#ἀλλ' ὦ περὶ τῆς πάσης μέλλων βασιλείας ἀντιλογήσειν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:547.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:547.1.text#τῆς ἡμετέρας, νυνὶ θαρρῶν πᾶσαν γλῶτταν βασάνιζε. 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:548.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:548.1.text#καὶ μὴν εὐθύς γ' ἀπὸ βαλβίδων περὶ τῆς ἀρχῆς ἀποδείξω
urn:cts:greekLit:tlg0019.tlg004.fu.sp:549.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:549.1.text#τῆς ἡμετέρας ὡς οὐδεμιᾶς ἥττων ἐστὶν βασιλείας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:550.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:550.1.text#τί γὰρ εὔδαιμον καὶ μακαριστὸν μᾶλλον νῦν ἐστὶ δικαστοῦ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:551.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:551.1.text#ἢ τρυφερώτερον ἢ δεινότερον ζῷον, καὶ ταῦτα γέροντος;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:552.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:552.1.text#ὃν πρῶτα μὲν ἕρποντ' ἐξ εὐνῆς τηροῦσ' ἐπὶ τοῖσι δρυφάκτοις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:553.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:553.1.text#ἄνδρες μεγάλοι καὶ τετραπήχεις· κἄπειτ' εὐθὺς προσιόντι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:554.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:554.1.text#ἐμβάλλει μοι τὴν χεῖρ' ἁπαλὴν τῶν δημοσίων κεκλοφυῖαν·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:555.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:555.1.text#ἱκετεύουσίν θ' ὑποκύπτοντες τὴν φωνὴν οἰκτροχοοῦντες·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:556.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:556.1.text#'ο'ἴκτιρόν μ' ὦ πάτερ, αἰτοῦμαί σ', εἰ καὐτὸς πώποθ' ὑφείλου
urn:cts:greekLit:tlg0019.tlg004.fu.sp:557.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:557.1.text#ἀρχὴν ἄρξας ἢ 'πὶ στρατιᾶς τοῖς ξυσσίτοις ἀγοράζων·'
urn:cts:greekLit:tlg0019.tlg004.fu.sp:558.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:558.1.text#ὃς ἔμ' οὐδ' ἂν ζῶντ' ᾔδειν εἰ μὴ διὰ τὴν προτέραν ἀπόφυξιν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:559.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:559.1.text#τουτὶ περὶ τῶν ἀντιβολούντων ἔστω τὸ μνημόσυνόν μοι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:560.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:560.1.text#εἶτ' εἰσελθὼν ἀντιβοληθεὶς καὶ τὴν ὀργὴν ἀπομορχθεὶς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:561.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:561.1.text#ἔνδον τούτων ὧν ἂν φάσκω πάντων οὐδὲν πεποίηκα,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:562.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:562.1.text#ἀλλ' ἀκροῶμαι πάσας φωνὰς ἱέντων εἰς ἀπόφυξιν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:563.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:563.1.text#φέρ' ἴδω, τί γὰρ οὐκ ἔστιν ἀκοῦσαι θώπευμ' ἐνταῦθα δικαστῇ;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:564.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:564.1.text#οἱ μέν γ' ἀποκλάονται πενίαν αὑτῶν καὶ προστιθέασι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:565.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:565.1.text#κακὰ πρὸς τοῖς οὖσιν, † ἕως ἀνιῶν ἂν ἰσώσῃ τοῖσιν ἐμοῖσιν· †
urn:cts:greekLit:tlg0019.tlg004.fu.sp:566.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:566.1.text#οἱ δὲ λέγουσιν μύθους ἡμῖν, οἱ δ' Αἰσώπου τι γέλοιον·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:567.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:567.1.text#οἱ δὲ σκώπτουσ', ἵν' ἐγὼ γελάσω καὶ τὸν θυμὸν καταθῶμαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:568.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:568.1.text#κἂν μὴ τούτοις ἀναπειθώμεσθα, τὰ παιδάρι' εὐθὺς ἀνέλκει
urn:cts:greekLit:tlg0019.tlg004.fu.sp:569.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:569.1.text#τὰς θηλείας καὶ τοὺς υἱεῖς τῆς χειρός, ἐγὼ δ' ἀκροῶμαι·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:570.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:570.1.text#τὰ δὲ συγκύψανθ' ἅμα βληχᾶται· κἄπειθ' ὁ πατὴρ ὑπὲρ αὐτῶν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:571.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:571.1.text#ὥσπερ θεὸν ἀντιβολεῖ με τρέμων τῆς εὐθύνης ἀπολῦσαι·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:572.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:572.1.text# "εἰ μὲν χαίρεις ἀρνὸς φωνῇ, παιδὸς φωνὴν ἐλεήσαις·" 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:573.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:573.1.text#εἰ δ' αὖ τοῖς χοιριδίοις χαίρω, θυγατρὸς φωνῇ με πιθέσθαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:574.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:574.1.text#χἠμεῖς αὐτῷ τότε τῆς ὀργῆς ὀλίγον τὸν κόλλοπ' ἀνεῖμεν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:575.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:575.1.text#ἆρ' οὐ μεγάλη τοῦτ' ἔστ' ἀρχὴ καὶ τοῦ πλούτου καταχήνη; 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:576.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:576.1.text#δεύτερον αὖ σου τουτὶ γράφομαι, τὴν τοῦ πλούτου καταχήνην·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:577.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:577.1.text#καὶ τἀγαθά μοι μέμνησ' ἅχεις φάσκων τῆς Ἑλλάδος ἄρχειν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:578.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:578.1.text#παίδων τοίνυν δοκιμαζομένων αἰδοῖα πάρεστι θεᾶσθαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:579.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:579.1.text#κἂν Οἴαγρος εἰσέλθῃ φεύγων, οὐκ ἀποφεύγει πρὶν ἂν ἡμῖν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:580.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:580.1.text#ἐκ τῆς Νιόβης εἴπῃ ῥῆσιν τὴν καλλίστην ἀπολέξας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:581.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:581.1.text#κἂν αὐλητής γε δίκην νικᾷ, ταύτης ἡμῖν ἐπίχειρα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:582.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:582.1.text#ἐν φορβειᾷ τοῖσι δικασταῖς ἔξοδον ηὔλησ' ἀπιοῦσι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:583.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:583.1.text#κἂν ἀποθνῄσκων ὁ πατήρ τῳ δῷ καταλείπων παῖδ' ἐπίκληρον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:584.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:584.1.text#κλάειν ἡμεῖς μακρὰ τὴν κεφαλὴν εἰπόντες τῇ διαθήκῃ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:585.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:585.1.text#καὶ τῇ κόγχῃ τῇ πάνυ σεμνῶς τοῖς σημείοισιν ἐπούσῃ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:586.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:586.1.text#ἔδομεν ταύτην ὅστις ἂν ἡμᾶς ἀντιβολήσας ἀναπείσῃ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:587.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:587.1.text#καὶ ταῦτ' ἀνυπεύθυνοι δρῶμεν, τῶν δ' ἄλλων οὐδεμἴ ἀρχή.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:588.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:588.1.text#τουτὶ γάρ τοι σεμνόν, τούτων ὧν εἴρηκας μακαρίζω·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:589.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:589.1.text#τῆς δ' ἐπικλήρου τὴν διαθήκην ἀδικεῖς ἀνακογχυλιάζων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:590.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:590.1.text#ἔτι δ' ἡ βουλὴ χὠ δῆμος ὅταν κρῖναι μέγα πρᾶγμ' ἀπορήσῃ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:591.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:591.1.text#ἐψήφισται τοὺς ἀδικοῦντας τοῖσι δικασταῖς παραδοῦναι·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:592.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:592.1.text#εἶτ' Εὔαθλος χὠ μέγας οὗτος Κολακώνυμος ἀσπιδαποβλὴς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:593.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:593.1.text#οὐχὶ προδώσειν ἡμᾶς φασίν, περὶ τοῦ πλήθους δὲ μαχεῖσθαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:594.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:594.1.text#κἀν τῷ δήμῳ γνώμην οὐδεὶς πώποτ' ἐνίκησεν, ἐὰν μὴ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:595.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:595.1.text#εἴπῃ τὰ δικαστήρι' ἀφεῖναι πρώτιστα μίαν δικάσαντας·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:596.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:596.1.text#αὐτὸς δὲ Κλέων ὁ κεκραξιδάμας μόνον ἡμᾶς οὐ περιτρώγει,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:597.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:597.1.text#ἀλλὰ φυλάττει διὰ χειρὸς ἔχων καὶ τὰς μυίας ἀπαμύνει.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:598.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:598.1.text#σὺ δὲ τὸν πατέρ' οὐδ' ὁτιοῦν τούτων τὸν σαυτοῦ πώποτ'
ἔδρασας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:599.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:599.1.text#ἀλλὰ Θέωρος, καίτοὐστὶν ἀνὴρ Εὐφημίου οὐδὲν ἐλάττων,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:600.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:600.1.text#τὸν σφόγγον ἔχων ἐκ τῆς λεκάνης τἀμβάδι' ἡμῶν περικωνεῖ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:601.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:601.1.text#σκέψαι μ' ἀπὸ τῶν ἀγαθῶν οἵων ἀποκλῄεις καὶ κατερύκεις,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:602.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:602.1.text#ἣν δουλείαν οὖσαν ἔφασκες καὶ ὑπηρεσίαν ἀποδείξειν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:603.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:603.1.text#ἔμπλησο λέγων· πάντως γάρ τοι παύσει ποτὲ κἀναφανήσει
urn:cts:greekLit:tlg0019.tlg004.fu.sp:604.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:604.1.text#πρωκτὸς λουτροῦ περιγιγνόμενος τῆς ἀρχῆς τῆς περισέμνου. 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:605.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:605.1.text#ὃ δέ γ' ἥδιστον τούτων ἐστὶν πάντων, οὗ 'γὼ 'πελελήσμην,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:606.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:606.1.text#ὅταν οἴκαδ' ἴω τὸν μισθὸν ἔχων, κἄπειθ' ἥκονθ' ἅμα πάντες
urn:cts:greekLit:tlg0019.tlg004.fu.sp:607.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:607.1.text#ἀσπάζωνται διὰ τἀργύριον, καὶ πρῶτα μὲν ἡ θυγάτηρ με
urn:cts:greekLit:tlg0019.tlg004.fu.sp:608.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:608.1.text#ἀπονίζῃ καὶ τὼ πόδ' ἀλείφῃ καὶ προσκύψασα φιλήσῃ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:609.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:609.1.text#καὶ παππίζουσ' ἅμα τῇ γλώττῃ τὸ τριώβολον ἐκκαλαμᾶται,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:610.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:610.1.text#καὶ τὸ γύναιόν μ' ὑποθωπεῦσαν φυστὴν μᾶζαν προσενέγκῃ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:611.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:611.1.text#κἄπειτα καθεζομένη παρ' ἐμοὶ προσαναγκάζῃ, "φάγε τουτί,"
urn:cts:greekLit:tlg0019.tlg004.fu.sp:612.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:612.1.text#"ἔντραγε τουτί·" τούτοισιν ἐγὼ γάνυμαι, κοὐ μή με δεήσῃ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:613.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:613.1.text#ἐς σὲ βλέψαι καὶ τὸν ταμίαν, ὁπότ' ἄριστον παραθήσει
urn:cts:greekLit:tlg0019.tlg004.fu.sp:614.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:614.1.text#καταρασάμενος καὶ τονθορύσας. ἀλλ' ἢν μή μοι ταχὺ μάξῃ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:615.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:615.1.text#τάδε κέκτημαι πρόβλημα κακῶν, σκευὴν βελέων ἀλεωρήν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:616.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:616.1.text#κἂν οἶνόν μοι μὴ 'γχῇς σὺ πιεῖν, τὸν ὄνον τόνδ' ἐσκεκόμισμαι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:617.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:617.1.text#οἴνου μεστόν, κᾆτ' ἐγχέομαι κλίνας· οὗτος δὲ κεχηνὼς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:618.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:618.1.text#βρωμησάμενος τοῦ σοῦ δίνου μέγα καὶ στράτιον κατέπαρδεν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:620.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:620.1.text#ἆρ' οὐ μεγάλην ἀρχὴν ἄρχω καὶ τοῦ Διὸς οὐδὲν ἐλάττω, 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:621.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:621.1.text#ὅστις ἀκούω ταὔθ' ἅπερ ὁ Ζεύς;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:622.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:622.1.text#ἢν γοῦν ἡμεῖς θορυβήσωμεν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:623.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:623.1.text#πᾶς τίς φησιν τῶν παριόντων,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:624.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:624.1.text#"οἷον βροντᾷ τὸ δικαστήριον,"
urn:cts:greekLit:tlg0019.tlg004.fu.sp:625.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:625.1.text#"ὦ Ζεῦ βασιλεῦ."
urn:cts:greekLit:tlg0019.tlg004.fu.sp:626.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:626.1.text#κἂν ἀστράψω, ποππύζουσιν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:627.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:627.1.text#κἀγκεχόδασίν μ' οἱ πλουτοῦντες
urn:cts:greekLit:tlg0019.tlg004.fu.sp:627a.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:627a.text#καὶ πάνυ σεμνοί.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:628.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:628.1.text#καὶ σὺ δέδοικάς με μάλιστ' αὐτός·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:629.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:629.1.text#νὴ τὴν Δήμητρα δέδοικας, ἐγὼ δ'
urn:cts:greekLit:tlg0019.tlg004.fu.sp:630.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:630.1.text#ἀπολοίμην εἴ σε δέδοικα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:631.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:631.1.text#οὐπώποθ' οὕτω καθαρῶς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:632.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:632.1.text#οὐδενὸς ἠκούσαμεν οὐδὲ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:633.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:633.1.text#ξυνετῶς λέγοντος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:634.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:634.1.text#οὔκ, ἀλλ' ἐρήμας ᾤεθ' οὕτω ῥᾳδίως τρυγήσειν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:635.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:635.1.text#καλῶς γὰρ ᾔδειν ὡς ἐγὼ ταύτῃ κράτιστός εἰμι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:636.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:636.1.text#ὡς δ' ἐπὶ πάντ' ἐλήλυθεν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:637.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:637.1.text#κοὐδὲν παρῆλθεν, ὥστ' ἔγωγ'
urn:cts:greekLit:tlg0019.tlg004.fu.sp:638.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:638.1.text#ηὐξανόμην ἀκούων,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:639.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:639.1.text#κἀν μακάρων δικάζειν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:640.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:640.1.text#αὐτὸς ἔδοξα νήσοις,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:641.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:641.1.text#ἡδόμενος λέγοντι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:642.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:642.1.text#ὡς οὗτος ἤδη σκορδινᾶται κἄστιν οὐκ ἐν αὑτοῦ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:643.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:643.1.text#ἦ μὴν ἐγώ σε τήμερον σκύτη βλέπειν ποιήσω.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:644.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:644.1.text#δεῖ δέ σε παντοίας πλέκειν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:645.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:645.1.text#εἰς ἀπόφυξιν παλάμας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:646.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:646.1.text#τὴν γὰρ ἐμὴν ὀργὴν πεπᾶναι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:646a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:646a.text#χαλεπὸν νεανίᾳ 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:647.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:647.1.text#μὴ πρὸς ἐμοῦ λέγοντι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:648.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:648.1.text#πρὸς ταῦτα μύλην ἀγαθὴν ὥρα ζητεῖν σοι καὶ νεόκοπτον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:649.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:649.1.text#ἢν μή τι λέγῃς, ἥτις δυνατὴ τὸν ἐμὸν θυμὸν κατερεῖξαι. 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:650.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:650.1.text#χαλεπὸν μὲν καὶ δεινῆς γνώμης καὶ μείζονος ἢ 'πὶ τρυγῳδοῖς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:651.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:651.1.text#ἰάσασθαι νόσον ἀρχαίαν ἐν τῇ πόλει ἐντετοκυῖαν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:652.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:652.1.textἀτὰρ ὦ πάτερ ἡμέτερε Κρονίδη —
urn:cts:greekLit:tlg0019.tlg004.fu.sp:652.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:652.2.text#παῦσαι καὶ μὴ πατέριζε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:653.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:653.1.text#εἰ μὴ γὰρ ὅπως δουλεύω 'γώ, τουτὶ ταχέως με διδάξεις,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:654.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:654.1.text#οὐκ ἔστιν ὅπως οὐχὶ τεθνήξεις, κἂν χρῇ σπλάγχνων μ' ἀπέχεσθαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:655.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:655.1.text#ἀκρόασαί νυν ὦ παππίδιον χαλάσας ὀλίγον τὸ μέτωπον·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:656.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:656.1.text#καὶ πρῶτον μὲν λόγισαι φαύλως, μὴ ψήφοις ἀλλ' ἀπὸ χειρός,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:657.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:657.1.text#τὸν φόρον ἡμῖν ἀπὸ τῶν πόλεων συλλήβδην τὸν προσιόντα·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:658.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:658.1.text#κἄξω τούτου τὰ τέλη χωρὶς καὶ τὰς πολλὰς ἑκατοστάς,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:659.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:659.1.text#πρυτανεῖα μέταλλ' ἀγορὰς λιμένας μεσθοὺς καὶ δημιόπρατα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:660.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:660.1.text#τούτων πλήρωμα τάλαντ' ἐγγὺς δισχίλια γίγνεται ἡμῖν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:661.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:661.1.text#ἀπὸ τούτου νυν κατάθες μισθὸν τοῖσι δικασταῖς ἐνιαυτοῦ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:662.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:662.1.text#ἓξ χιλιάσιν, κοὔπω πλείους ἐν τῇ χώρᾳ κατένασθεν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:663.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:663.1.text#γίγνεται ἡμῖν ἑκατὸν δήπου καὶ πεντήκοντα τάλαντα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:664.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:664.1.text#οὐδ' ἡ δεκάτη τῶν προσιόντων ἡμῖν ἄρ' ἐγίγνεθ' ὁ μισθός.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:665.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:665.1.textμὰ Δί' οὐ μέντοι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:665.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:665.2.text#καὶ ποῖ τρέπεται δὴ 'πειτα τὰ χρήματα τἄλλα;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:666.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:666.1.text#ἐς τούτους τοὺς "οὐχὶ προδώσω τὸν Ἀθηναίων κολοσυρτόν,"
urn:cts:greekLit:tlg0019.tlg004.fu.sp:667.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:667.1.text#"ἀλλὰ μαχοῦμαι περὶ τοῦ πλήθους ἀεί." σὺ γὰρ ὦ πάτερ αὐτοὺς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:668.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:668.1.text#ἄρχειν αἱρεῖ σαυτοῦ τούτοις τοῖς ῥηματίοις περιπεφθείς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:669.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:669.1.text#κᾆθ' οὗτοι μὲν δωροδοκοῦσιν κατὰ πεντήκοντα τάλαντα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:670.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:670.1.text#ἀπὸ τῶν πόλεων ἐπαπειλοῦντες τοιαυτὶ κἀναφοβοῦντες,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:671.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:671.1.text# "δώσετε τὸν φόρον, ἢ βροντήσας τὴν πόλιν ὑμῶν ἀνατρέψω." 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:672.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:672.1.text#σὺ δὲ τῆς ἀρχῆς ἀγαπᾷς τῆς σῆς τοὺς ἀργελόφους περιτρώγων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:673.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:673.1.text#οἱ δὲ ξύμμαχοι ὡς ᾔσθηνται τὸν μὲν σύρφακα τὸν ἄλλον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:674.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:674.1.text#ἐκ κηθαρίον λαγαριζόμενον καὶ τραγαλιζοντα τὸ μηδέν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:675.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:675.1.text#σὲ μὲν ἡγοῦνται Κόννου ψῆφον, τούτοισι δὲ δωροφοροῦσιν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:676.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:676.1.text#ὕρχας οἶνον δάπιδας τυρὸν μέλι σήσαμα προσκεφάλαια
urn:cts:greekLit:tlg0019.tlg004.fu.sp:677.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:677.1.text#φιάλας χλανίδας στεφάνους ὅρμους ἐκπώματα πλουθυγιείαν·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:678.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:678.1.text#σοὶ δ' ὧν ἄρχεις, πολλὰ μὲν ἐν γῇ πολλὰ δ' ἐφ' ὑγρᾷ πιτυλεύσας,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:679.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:679.1.text#οὐδεὶς οὐδὲ σκορόδου κεφαλὴν τοῖς ἑψητοῖσι δίδωσιν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:680.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:680.1.text#μὰ Δί' ἀλλὰ παρ' Εὐχαρίδου καὐτὸς τρεῖς γ' ἄγλιθας μετέπεμψα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:681.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:681.1.text#ἀλλ' αὐτήν μοι τὴν δουλείαν οὐκ ἀποφαίνων ἀποκναίεις.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:682.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:682.1.text#οὐ γὰρ μεγάλη δουλεία 'στὶν τούτους μὲν ἅπαντας ἐν ἀρχαῖς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:683.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:683.1.text#αὐτούς τ' εἶναι καὶ τοὺς κόλακας τοὺς τούτων μισθοφοροῦντας;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:684.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:684.1.text#σοὶ δ' ἤν τις δῷ τοὺς τρεῖς ὀβολούς, ἀγαπᾷς· οὓς αὐτὸς ἐλαύνων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:685.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:685.1.text#καὶ πεζομαχῶν καὶ πολιορκῶν ἐκτήσω πολλὰ πονήτας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:686.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:686.1.text#καὶ πρὸς τούτοις ἐπιταττόμενος φοιτᾷς, ὃ μάλιστά μ' ἀπάγχει,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:687.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:687.1.text#ὅταν εἰσελθὸν μειράκιόν σοι κατάπυγον, Χαιρέου υἱός,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:688.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:688.1.text#ὡδὶ διαβὰς διακινηθεὶς τῷ σώματι καὶ τρυφερανθείς,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:689.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:689.1.text#ἥκειν εἴπῃ πρῲ κἀν ὥρᾳ δικάσονθ', ὡς ὅστις ἂν ὑμῶν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:690.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:690.1.text#ὕστερος ἔλθῃ τοῦ σημείου, τὸ τριώβολον οὐ κομιεῖται·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:691.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:691.1.text#αὐτὸς δὲ φέρει τὸ συνηγορικὸν δραχμήν, κἂν ὕστερος ἔλθῃ·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:692.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:692.1.text#καὶ κοινωνῶν τῶν ἀρχόντων ἑτέρῳ τινὶ τῶν μεθ' ἑαυτοῦ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:693.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:693.1.text#ἤν τίς τι διδῷ τῶν φευγόντων, ξυνθέντε τὸ πρᾶγμα δύ' ὄντε
urn:cts:greekLit:tlg0019.tlg004.fu.sp:694.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:694.1.text#ἐσπουδάκατον, κᾆθ' ὡς πρίονθ' ὁ μὲν ἕλκει ὁ δ' ἀντενέδωκε·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:695.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:695.1.text#σὺ δὲ χασκάζεις τὸν κωλακρέτην, τὸ δὲ πραττόμενόν σε λέληθεν. 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:696.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:696.1.text#ταυτί με ποιοῦσ'; οἴμοι τί λέγεις; ὥς μου τὸν θῖνα ταράττεις,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:697.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:697.1.text#καὶ τὸν νοῦν μου προσάγεις μᾶλλον, κοὐκ οἶδ' ὅ τι χρῆμά με ποιεῖς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:698.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:698.1.text#σκέψαι τοίνυν ὡς ἐξόν σοι πλουτεῖν καὶ τοῖσιν ἅπασιν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:699.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:699.1.text#ὑπὸ τῶν ἀεὶ δημιζόντων οὐκ οἶδ' ὅπῃ ἐγκεκύκλησαι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:700.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:700.1.text#ὅστις πόλεων ἄρχων πλείστων ἀπὸ τοῦ Πόντου μέχρι Σαρδοῦς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:701.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:701.1.text#οὐκ ἀπολαύεις πλὴν τοῦθ' ὃ φέρεις ἀκαρῆ· καὶ τοῦτ' ἐρίῳ σοι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:702.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:702.1.text#ἐνστάζουσιν κατὰ μικρὸν ἀεὶ τοῦ ζῆν ἕνεχ' ὥσπερ ἔλαιον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:703.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:703.1.text#βούλονται γάρ σε πένητ' εἶναι· καὶ τοῦθ' ὧν οὕνεκ' ἐρῶ σοι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:704.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:704.1.text#ἵνα γιγνώσκῃς τὸν τιθασευτήν, κᾆθ' ὅταν οὗτός γ' ἐπισίξῃ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:705.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:705.1.text#ἐπὶ τῶν ἐχθρῶν τιν' ἐπιρρύξας, ἀγρίως αὐτοῖς ἐπιπηδᾷς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:706.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:706.1.text#εἰ γὰρ ἐβούλοντο βίον πορίσαι τῷ δήμῳ, ῥᾴδιον ἦν ἄν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:707.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:707.1.text#εἰσίν γε πόλεις χίλιαι αἳ νῦν τὸν φόρον ἡμῖν ἀπάγουσι·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:708.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:708.1.text#τούτων εἴκοσιν ἄνδρας βόσκειν εἴ τις προσέταξεν ἑκάστῃ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:709.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:709.1.text#δύο μυριάδ' ἂν τῶν δημοτικῶν ἔζων ἐν πᾶσι λαγῴοις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:710.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:710.1.text#καὶ στεφάνοισιν παντοδαποῖσιν καὶ πυριάτῃ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:711.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:711.1.text#ἄξια τῆς γῆς ἀπολαύοντες καὶ τοῦ 'ν Μαραθῶνι τροπαίου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:712.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:712.1.text#νῦν δ' ὥσπερ ἐλαολόγοι χωρεῖθ' ἅμα τῷ τὸν μισθὸν ἔχοντι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:713.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:713.1.text#οἴμοι τί πέπονθ'; ὡς νάρκη μου κατὰ τῆς χειρὸς καταχεῖται,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:714.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:714.1.text#καὶ τὸ ξίφος οὐ δύναμαι κατέχειν, ἀλλ' ἤδη μαλθακός εἰμι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:715.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:715.1.text#ἀλλ' ὁπόταν μὲν δείσωσ' αὐτοί, τὴν Εὔβοιαν διδόασιν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:716.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:716.1.text#ὑμῖν καὶ σῖτον ὑφίστανται κατὰ πεντήκοντα μεδίμνους
urn:cts:greekLit:tlg0019.tlg004.fu.sp:717.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:717.1.text#ποριεῖν· ἔδοσαν δ' οὐπώποτέ σοι πλὴν πρώην πέντε μεδίμνους,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:718.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:718.1.text#καὶ ταῦτα μόλις ξενίας φεύγων ἔλαβες κατὰ χοίνικα κριθῶν. 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:719.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:719.1.text#ὧν οὕνεκ' ἐγώ σ' ἀπέκλῃον ἀεὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:720.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:720.1.text#βόσκειν ἐθέλων καὶ μὴ τούτους
urn:cts:greekLit:tlg0019.tlg004.fu.sp:721.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:721.1.text#ἐγχάσκειν σοι στομφάζοντας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:722.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:722.1.text#καὶ νῦν ἀτεχνῶς ἐθέλω παρέχειν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:723.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:723.1.text#ὅ τι βούλει σοι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:724.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:724.1.text#πλὴν κωλακρέτου γάλα πίνειν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:725.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:725.1.text#ἦ που σοφὸς ἦν ὅστις ἔφασκεν, πρὶν ἂν ἀμφοῖν μῦθον ἀκούσῃς,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:726.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:726.1.text#οὐκ ἂν δικάσαις. σὺ γὰρ οὖν νῦν μοι νικᾶν πολλῷ δεδόκησαι·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:727.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:727.1.text#ὥστ' ἤδη τὴν ὀργὴν χαλάσας τοὺς σκίπωνας καταβάλλω.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:728.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:728.1.text#ἀλλ' ὦ τῆς ἡλικίας ἡμῖν τῆς αὐτῆς συνθιασῶτα,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:729.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:729.1.text#πιθοῦ πιθοῦ λόγοισι, μηδ' ἄφρων γένῃ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:730.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:730.1.text#μηδ' ἀτενὴς ἄγαν ἀτεράμων τ' ἀνήρ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:731.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:731.1.text#εἴθ' ὤφελέν μοι κηδεμὼν ἢ ξυγγενὴς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:732.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:732.1.text#εἶναί τις ὅστις τοιαῦτ' ἐνουθέτει.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:733.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:733.1.text#σοὶ δὲ νῦν τις θεῶν παρὼν ἐμφανὴς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:734.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:734.1.text#ξυλλαμβάνει τοῦ πράγματος,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:735.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:735.1.text#καὶ δῆλός ἐστιν εὖ ποιῶν·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:736.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:736.1.text#σὺ δὲ παρὼν δέχου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:737.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:737.1.text#καὶ μὴν θρέψω γ' αὐτὸν παρέχων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:738.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:738.1.text#ὅσα πρεσβύτῃ ξύμφορα, χόνδρον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:739.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:739.1.text#λείχειν, χλαῖναν μαλακήν, σισύραν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:740.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:740.1.text#πόρνην, ἥτις τὸ πέος τρίψει
urn:cts:greekLit:tlg0019.tlg004.fu.sp:740a.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:740a.text#καὶ τὴν ὀσφῦν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:741.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:741.1.text#ἀλλ' ὅτι σιγᾷ κοὐδὲν γρύζει,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:742.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:742.1.text#τοῦτ' οὐ δύναταί με προσέσθαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:743.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:743.1.text#νενουθέτηκεν αὑτὸν ἐς τὰ πράγμαθ', οἶς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:744.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:744.1.text#τότ' ἐπεμαίνετ'· ἔγνωκε γὰρ ἀρτίως,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:745.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:745.1.text#λογίζεταί τ' ἐκεῖνα πάνθ' ἁμαρτίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:746.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:746.1.text#ἃ σοῦ κελεύοντος οὐκ ἐπείθετο.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:747.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:747.1.text#νῦν δ' ἴσως τοῖσι σοῖς λόγοις πείθεται
urn:cts:greekLit:tlg0019.tlg004.fu.sp:748.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:748.1.text#καὶ σωφρονεῖ μέντοι μεθιστὰς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:748a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:748a.text#ἐς τὸ λοιπὸν τὸν τρόπον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:749.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:749.1.text#πιθόμενός τέ σοι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:750.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:750.1.textἰώ μοί μοι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:750.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:750.2.text#οὗτος τί βοᾷς;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:751.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:751.1.text#μή μοι τούτων μηδὲν ὑπισχνοῦ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:752.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:752.1.text#κείνων ἔραμαι, κεῖθι γενοίμαν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:753.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:753.1.text#ἵν' ὁ κῆρύξ φησι, 'τίς ἀψήφιστος; ἀνιστάσθω.'
urn:cts:greekLit:tlg0019.tlg004.fu.sp:754.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:754.1.text#κἀπισταίην ἐπὶ τοῖς κημοῖς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:755.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:755.1.text#ψηφιζομένων ὁ τελευταῖος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:756.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:756.1.text#σπεῦδ' ὦ ψυχή. ποῦ μοι ψυχή;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:757.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:757.1.text#πάρες ὦ σκιερά. μὰ τὸν Ἡρακλέα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:758.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:758.1.text#μή νυν ἔτ' ἐγὼ 'ν τοῖσι δικασταῖς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:759.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:759.1.text#κλέπτοντα Κλέωνα λάβοιμι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:760.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:760.1.text#ἴθ' ὦ πάτερ πρὸς τῶν θεῶν ἐμοὶ πιθοῦ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:761.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:761.1.text#τί σοι πίθωμαι; λέγ' ὅ τι βούλει πλὴν ἑνός.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:762.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:762.1.textποίου; φέρ' ἴδω.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:762.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:762.2.text#τοῦ μὴ δικάζειν. τοῦτο δὲ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:763.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:763.1.text#Ἅιδης διακρινεῖ πρότερον ἢ 'γὼ πείσομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:764.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:764.1.text#σὺ δ' οὖν, ἐπειδὴ τοῦτο κεχάρηκας ποιῶν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:765.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:765.1.text#ἐκεῖσε μὲν μηκέτι βάδιζ', ἀλλ' ἐνθάδε
urn:cts:greekLit:tlg0019.tlg004.fu.sp:766.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:766.1.text#αὐτοῦ μένων δίκαζε τοῖσιν οἰκέταις.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:767.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:767.1.textπερὶ τοῦ; τί ληρεῖς;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:767.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:767.2.text#ταὔθ' ἅπερ ἐκεῖ πράττεται·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:768.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:768.1.text#ὅτι τὴν θύραν ἀνέῳξεν ἡ σηκὶς λάθρᾳ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:769.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:769.1.text#ταύτης ἐπιβολὴν ψηφιεῖ μίαν μόνην.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:770.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:770.1.text#πάντως δὲ κἀκεῖ ταῦτ' ἔδρας ἑκάστοτε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:771.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:771.1.text#καὶ ταῦτα μέν νυν εὐλόγως, ἢν ἐξέχῃ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:772.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:772.1.text#ἕλη κατ' ὄρθρον, ἡλιάσει πρὸς ἥλιον·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:773.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:773.1.text#ἐὰν δὲ νείφῃ, πρὸς τὸ πῦρ καθήμενος·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:774.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:774.1.text#ὕοντος εἴσει· κἄν ἔγρῃ μεσημβρινός,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:775.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:775.1.text#οὐδείς σ' ἀποκλῄσει θεσμοθέτης τῇ κιγκλίδι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:776.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:776.1.textτουτί μ' ἀρέσκει.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:776.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:776.2.text#πρὸς δὲ τούτοις γ', ἢν δίκην
urn:cts:greekLit:tlg0019.tlg004.fu.sp:777.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:777.1.text#λέγῃ μακράν τις, οὐχὶ πεινῶν ἀναμενεῖς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:778.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:778.1.text#δάκνων σεαυτὸν καὶ τὸν ἀπολογούμενον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:779.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:779.1.text#πῶς οὖν διαγιγνώσκειν καλῶς δυνήσομαι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:780.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:780.1.text#ὥσπερ πρότερον τὰ πράγματ' ἔτι μασώμενος;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:781.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:781.1.text#πολλῷ γ' ἄμεινον· καὶ λέγεται γὰρ τουτογί,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:782.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:782.1.text#ὡς οἱ δικασταὶ ψευδομένων τῶν μαρτύρων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:783.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:783.1.text#μόλις τὸ πρᾶγμ' ἔγνωσαν ἀναμασώμενοι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:784.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:784.1.text#ἀνά τό με πείθεις. ἀλλ' ἐκεῖν' οὔπω λέγεις,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:785.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:785.1.textτὸν μισθὸν ὁπόθεν λήψομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:785.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:785.2.text#παρ' ἐμοῦ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:785.3.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:785.3.text#καλῶς,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:786.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:786.1.text#ὁτιὴ κατ' ἐμαυτὸν κοὐ μεθ' ἑτέρου λήψομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:787.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:787.1.text#αἴσχιστα γάρ τοί μ' ἠργάσατο Λυσίστρατος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:788.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:788.1.text#ὁ σκωπτόλης. δραχμὴν μετ' ἐμοῦ πρώην λαβὼν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:789.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:789.1.text#ἐλθὼν διεκερματίζετ' ἐν τοῖς ἰχθύσιν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:790.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:790.1.text#κἄπειτ' ἐνέθηκε τρεῖς λοπίδας μοι κεστρέων·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:791.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:791.1.text#κἀγὼ 'νέκαψ'· ὀβολοὺς γὰρ ᾠόμην λαβεῖν·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:792.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:792.1.text#κᾆτα βδελυχθεὶς ὀσφρόμενος ἐξέπτυσα·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:793.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:793.1.textκᾆθ' εἷλκον αὐτόν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:793.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:793.2.text#ὁ δὲ τί πρὸς ταῦτ' εἶφ';
urn:cts:greekLit:tlg0019.tlg004.fu.sp:793.3.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:793.3.text#ὅ τι;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:794.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:794.1.text#ἀλεκτρυόνος μ' ἔφασκε κοιλίαν ἔχειν·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:795.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:795.1.text#"ταχὺ γοῦν καθέψεις τἀργύριον," ἦ δ' ὃς λέγων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:796.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:796.1.text#ὁρᾷς ὅσον καὶ τοῦτο δῆτα κερδανεῖς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:797.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:797.1.text#οὐ πάνυ τι μικρόν. ἀλλ' ὅπερ μέλλεις ποίει.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:798.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:798.1.text#ἀνάμενέ νυν· ἐγὼ δὲ ταῦθ' ἥξω φέρων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:799.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:799.1.text#ὅρα τὸ χρῆμα, τὰ λόγι' ὡς περαίνεται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:800.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:800.1.text#ἠκηκόη γὰρ ὡς Ἀθηναῖοί ποτε
urn:cts:greekLit:tlg0019.tlg004.fu.sp:801.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:801.1.text#δικάσοιεν ἐπὶ ταῖς οἰκίαισι τὰς δίκας,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:802.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:802.1.text#κἀν τοῖς προθύροις ἐνοικοδομήσοι πᾶς ἀνὴρ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:803.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:803.1.text#αὑτῷ δικαστηρίδιον μικρὸν πάνυ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:804.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:804.1.text#ὥσπερ Ἑκάταιον, πανταχοῦ πρὸ τῶν θυρῶν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:805.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:805.1.text#ἰδού, τί ἔτ' ἐρεῖς; ὡς ἅπαντ' ἐγὼ φέρω
urn:cts:greekLit:tlg0019.tlg004.fu.sp:806.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:806.1.text#ὅσαπερ ἔφασκον, κἄτι πολλῷ πλείονα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:807.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:807.1.text#ἀμὶς μέν, ἢν οὐρητιάσῃς, αὑτηὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:808.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:808.1.text#παρά σοι κρεμήσετ' ἐγγὺς ἐπὶ τοῦ παττάλου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:809.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:809.1.text#σοφόν γε τουτὶ καὶ γέροντι πρόσφορον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:810.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:810.1.text#ἐξηῦρες ἀτεχνῶς φάρμακον στραγγουρίας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:811.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:811.1.text#καὶ πῦρ γε τουτί· καὶ προσέστηκεν φακῆ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:812.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:812.1.textῥοφεῖν, ἐὰν δέῃ τι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:812.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:812.2.text#τοῦτ' αὖ δεξιόν·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:813.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:813.1.text#κἂν γὰρ πυρέττω, τόν γε μισθὸν λήψομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:814.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:814.1.text#αὐτοῦ μένων γὰρ τὴν φακῆν ῥοφήσομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:815.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:815.1.text#ἀτὰρ τί τὸν ὄρνιν ὡς ἔμ' ἐξηνέγκατε;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:816.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:816.1.text#ἵνα γ', ἢν καθεύδῃς ἀπολογουμένου τινός,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:817.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:817.1.text#ᾄδων ἄνωθεν ἐξεγείρῃ σ' οὑτοσί.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:818.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:818.1.textἓν ἔτι ποθῶ, τὰ δ' ἄλλ' ἀρέσκει μοι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:818.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:818.2.text#τὸ τί;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:819.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:819.1.text#θἠρῷον εἴ πως ἐκκομίσαις τὸ τοῦ Λύκου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:820.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:820.1.text#πάρεστι τουτί, καὐτὸς ἅναξ οὑτοσί.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:821.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:821.1.text#ὦ δέσποθ' ἥρως ὡς χαλεπὸς ἄρ' ἦσθ' ἰδεῖν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:822.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:822.1.text#οἷόσπερ ἡμῖν φαίνεται Κλεώνυμος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:823.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:823.1.text#οὔκουν ἔχει γ' οὐδ' αὐτὸς ἥρως ὢν ὅπλα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:824.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:824.1.text#εἰ θᾶττον ἐκαθίζου σύ, θᾶττον ἂν δίκην
urn:cts:greekLit:tlg0019.tlg004.fu.sp:825.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:825.1.textἐκάλουν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:825.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:825.2.text#κάλει νυν, ὡς κάθημαι 'γὼ πάλαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:826.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:826.1.text#φέρε νυν τίν' αὐτῷ πρῶτον εἰσαγάγω δίκην;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:827.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:827.1.text#τί τίς κακὸν δέδρακε τῶν ἐν τᾠκίᾳ;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:828.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:828.1.text#ἡ Θρᾷττα προσκαύσασα πρώην τὴν χύτραν —
urn:cts:greekLit:tlg0019.tlg004.fu.sp:829.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:829.1.text#ἐπίσχες οὗτος· ὡς ὀλίγου μ' ἀπώλεσας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:830.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:830.1.text#ἄνευ δρυφάκτου τὴν δίκην μέλλεις καλεῖν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:831.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:831.1.text#ὃ πρῶτον ἡμῖν τῶν ἱερῶν ἐφαίνετο;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:832.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:832.1.textμὰ τὸν Δί' οὐ πάρεστιν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:832.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:832.2.text#ἀλλ' ἐγὼ δραμὼν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:833.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:833.1.text#αὐτὸς κομιοῦμαι τό γε παραυτίκ' ἔνδοθεν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:834.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:834.1.text#τί ποτε τὸ χρῆμ'; ὡς δεινὸν ἡ φιλοχωρία.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:835.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:835.1.text#βάλλ' ἐς κόρακας. τοιουτονὶ τρέφειν κύνα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:836.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:836.1.textτί δ' ἔστιν ἐτεόν;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:836.2.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:836.2.text#οὐ γὰρ ὁ Λάβης ἀρτίως
urn:cts:greekLit:tlg0019.tlg004.fu.sp:837.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:837.1.text#ὁ κύων παρᾴξας ἐς τὸν ἰπνὸν ὑφαρπάσας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:838.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:838.1.text#τροφαλίδα τυροῦ Σικελικὴν κατεδήδοκεν;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:839.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:839.1.text#τοῦτ' ἆρα πρῶτον τἀδίκημα τῷ πατρὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:840.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:840.1.text#εἰσακτέον μοι· σὺ δὲ κατηγόρει παρών.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:841.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:841.1.text#μὰ Δί' οὐκ ἔγωγ'· ἀλλ' ἅτερός φησιν κύων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:842.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:842.1.text#κατηγορήσειν, ἤν τις εἰσάγῃ γραφήν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:843.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:843.1.textἴθι νυν ἄγ' αὐτὼ δεῦρο.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:843.2.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:843.2.text#ταῦτα χρὴ ποιεῖν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:844.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:844.1.textτουτὶ τί ἔστι;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:844.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:844.2.text#χοιροκομεῖον Ἑστίας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:845.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:845.1.textεἶθ' ἱεροσυλήσας φέρεις;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:845.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:845.2.text#οὔκ, ἀλλ' ἵνα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:846.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:846.1.text#ἀφ' Ἑστίας ἀρχόμενος ἐπιτρίψω τινά.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:847.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:847.1.text#ἀλλ' εἴσαγ' ἀνύσας· ὡς ἐγὼ τιμᾶν βλέπω.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:848.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:848.1.text#φέρε νυν ἐνέγκω τὰς σανίδας καὶ τὰς γραφάς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:849.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:849.1.text#οἴμοι διατρίβεις κἀπολεῖς τριψημερῶν·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:850.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:850.1.text#ἐγὼ δ' ἀλοκίζειν ἐδεόμην τὸ χωρίον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:851.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:851.1.textἰδού.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:851.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:851.2.text#κάλει νυν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:851.3.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:851.3.text#ταῦτα δή. τίς οὑτοσὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:852.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:852.1.textὁ πρῶτός ἐστιν;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:852.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:852.2.text#ἐς κόρακας, ὡς ἄχθομαι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:853.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:853.1.text#ὁτιὴ 'πελαθόμην τοὺς καδίσκους ἐκφέρειν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:854.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:854.1.textοὗτος σὺ ποῖ θεῖς;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:854.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:854.2.text#ἐπὶ καδίσκους.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:854.3.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:854.3.text#μη δαμῶς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:855.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:855.1.text#ἐγὼ γὰρ εἶχον τούσδε τοὺς ἀρυστίχους.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:856.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:856.1.text#κάλλιστα τοίνυν· πάντα γὰρ πάρεστι νῷν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:857.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:857.1.text#ὅσων δεόμεθα, πλήν γε δὴ τῆς κλεψύδρας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:858.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:858.1.text#ἡδὶ δὲ δὴ τίς ἐστιν; οὐχὶ κλεψύδρα;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:859.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:859.1.text#εὖ γ' ἐκπορίζεις αὐτὰ κἀπιχωρίως.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:860.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:860.1.text#ἀλλ' ὡς τάχιστα πῦρ τις ἐξενεγκάτω
urn:cts:greekLit:tlg0019.tlg004.fu.sp:861.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:861.1.text#καὶ μυρρίνας καὶ τὸν λιβανωτὸν ἔνδοθεν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:862.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:862.1.text#ὅπως ἂν εὐξώμεσθα πρῶτα τοῖς θεοῖς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:863.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:863.1.text#καὶ μὴν ἡμεῖς ἐπὶ ταῖς σπονδαῖς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:864.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:864.1.text#καὶ ταῖς εὐχαῖς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:865.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:865.1.text#φήμην ἀγαθὴν λέξομεν ὑμῖν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:866.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:866.1.text#ὅτι γενναίως ἐκ τοῦ πολέμου
urn:cts:greekLit:tlg0019.tlg004.fu.sp:867.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:867.1.text#καὶ τοῦ νείκους ξυνεβήτην.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:868.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:868.1.text#εὐφημία μὲν πρῶτα νῦν ὑπαρχέτω.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:869.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:869.1.text#ὦ Φοῖβ' Ἄπολλον Πύθι' ἐπ' ἀγαθῇ τύχῃ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:870.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:870.1.text#τὸ πρᾶγμ' ὃ μηχανᾶται
urn:cts:greekLit:tlg0019.tlg004.fu.sp:871.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:871.1.text#ἔμπροσθεν οὗτος τῶν θυρῶν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:872.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:872.1.text#ἅπασιν ἡμῖν ἁρμόσαι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:873.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:873.1.text#παυσαμένοις πλάνων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:874.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:874.1.text#ἰήιε Παιάν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:875.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:875.1.text#ὦ δέσποτ' ἄναξ γεῖτον ἀγυιεῦ προθύρου προπύλαιε,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:876.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:876.1.text#δέξαι τελετὴν καινὴν ὦναξ, ἣν τῷ πατρὶ καινοτομοῦμεν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:877.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:877.1.text#παῦσόν τ' αὐτοῦ τοῦτο τὸ λίαν στρυφνὸν καὶ πρίνινον ἦθος,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:878.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:878.1.text#ἀντὶ σιραίου μέλιτος μικρὸν τῷ θυμιδίῳ παραμείξας·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:879.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:879.1.text#ἤδη δ' εἶναι τοῖς ἀνθρώποις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:879a.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:879a.text#ἤπιον αὐτόν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:880.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:880.1.text#τοὺς φεύγοντάς τ' ἐλεεῖν μᾶλλον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:881.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:881.1.text#τῶν γραψαμένων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:882.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:882.1.text#κἀπιδακρύειν ἀντιβολούντων,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:883.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:883.1.text#καὶ παυσάμενον τῆς δυσκολίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:883a.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:883a.text#ἀπὸ τῆς ὀργῆς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:884.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:884.1.text#τὴν ἀκαλήφην ἀφελέσθαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:885.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:885.1.text#ξυνευχόμεσθα ταὐτά σοι κἀπᾴδομεν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:886.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:886.1.text#νέαισιν ἀρχαῖς ἕνεκα τῶν προλελεγμένων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:887.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:887.1.text#εὖνοι γάρ ἐσμεν ἐξ οὗ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:888.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:888.1.text#τὸν δῆμον ᾐσθόμεσθά σου
urn:cts:greekLit:tlg0019.tlg004.fu.sp:889.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:889.1.text#φιλοῦντος ὡς οὐδεὶς ἀνὴρ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:890.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:890.1.text#τῶν γε νεωτέρων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:890a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:890a.text# ἰήιε Παιάν. 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:891.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:891.1.text#εἴ τις θύρασιν ἡλιαστής, εἰσίτω·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:892.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:892.1.text#ὡς ἡνίκ' ἂν λέγωσιν οὐκ ἐσφρήσομεν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:893.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:893.1.textτίς ἆρ' ὁ φεύγων;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:893.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:893.2.text#οὗτος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:893.3.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:893.3.text#ὅσον ἁλώσεται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:894.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:894.1.text#ἀκούετ' ἤδη τῆς γραφῆς. ἐγράψατο
urn:cts:greekLit:tlg0019.tlg004.fu.sp:895.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:895.1.text#κύων Κυδαθηναιεὺς Λάβητ' Αἰξωνέα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:896.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:896.1.text#τὸν τυρὸν ἀδικεῖν ὅτι μόνος κατήσθιεν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:897.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:897.1.text#τὸν Σικελικόν. τίμημα κλῳὸς σύκινος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:898.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:898.1.text#θάνατος μὲν οὖν κύνειος, ἢν ἅπαξ ἁλῷ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:899.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:899.1.text#καὶ μὴν ὁ φεύγων οὑτοσὶ Λάβης πάρα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:900.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:900.1.text#ὦ μιαρὸς οὗτος· ὡς δὲ καὶ κλέπτον βλέπει,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:901.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:901.1.text#οἷον σεσηρὼς ἐξαπατήσειν μ' οἴεται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:902.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:902.1.text#ποῦ δ' ἔσθ' ὁ διώκων, ὁ Κυδαθηναιεὺς κύων;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:902a.speaker#Κύων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:902a.text#αὗ αὗ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:903.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:903.1.textπάρεστιν οὗτος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:903.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:903.2.text#ἕτερος οὗτος αὖ Λάβης.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:904.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:904.1.text#ἀγαθός γ' ὑλακτεῖν καὶ διαλείχειν τὰς χύτρας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:905.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:905.1.text#σίγα, κάθιζε· σὺ δ' ἀναβὰς κατηγόρει.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:906.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:906.1.text#φέρε νυν ἅμα τήνδ' ἐγχεάμενος κἀγὼ ῥοφῶ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:907.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:907.1.text#τῆς μὲν γραφῆς ἠκούσαθ' ἣν ἐγραψάμην
urn:cts:greekLit:tlg0019.tlg004.fu.sp:908.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:908.1.text#ἄνδρες δικασταὶ τουτονί. δεινότατα γὰρ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:909.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:909.1.text#ἔργων δέδρακε κἀμὲ καὶ τὸ ῥυππαπαῖ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:910.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:910.1.text#ἀποδρὰς γὰρ ἐς τὴν γωνίαν τυρὸν πολὺν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:911.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:911.1.text#κατεσικέλιζε κἀνέπλητ' ἐν τῷ σκότῳ —
urn:cts:greekLit:tlg0019.tlg004.fu.sp:912.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:912.1.text#νὴ τὸν Δί' ἀλλὰ δῆλός ἐστ'· ἔμοιγέ τοι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:913.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:913.1.text#τυροῦ κάκιστον ἀρτίως ἐνήρυγεν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:914.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:914.1.textὁ βδελυρὸς οὗτος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:914.2.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:914.2.text#κοὐ μετέδωκ' αἰτοῦντί μοι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:915.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:915.1.text#καίτοι τίς ὑμᾶς εὖ ποιεῖν δυνήσεται,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:916.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:916.1.text#ἢν μή τι κἀμοί τις προβάλλῃ τῷ κυνί;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:917.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:917.1.text#οὐδὲν μετέδωκεν οὐδὲ τῷ κοινῷ γ' ἐμοί.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:918.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:918.1.text#θερμὸς γὰρ ἁνὴρ οὐδὲν ἧττον τῆς φακῆς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:919.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:919.1.text#πρὸς τῶν θεῶν μὴ προκαταγίγνωσκ' ὦ πάτερ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:920.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:920.1.textπρὶν ἄν γ' ἀκούσῃς ἀμφοτέρων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:920.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:920.2.text#ἀλλ' ὦγαθὲ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:921.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:921.1.text#τὸ πρᾶγμα φανερόν ἐστιν· αὐτὸ γὰρ βοᾷ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:922.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:922.1.text#μή νυν ἀφῆτέ γ' αὐτόν, ὡς ὄντ' αὖ πολὺ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:923.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:923.1.text#κυνῶν ἁπάντων ἄνδρα μονοφαγίστατον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:924.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:924.1.text#ὅστις περιπλεύσας τὴν θυείαν ἐν κύκλῳ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:925.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:925.1.text#ἐκ τῶν πόλεων τὸ σκῖρον ἐξεδήδοκεν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:926.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:926.1.text#ἐμοὶ δέ γ' οὐκ ἔστ' οὐδὲ τὴν ὑδρίαν πλάσαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:927.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:927.1.text#πρὸς ταῦτα τοῦτον κολάσατ'· οὐ γὰρ ἄν ποτε
urn:cts:greekLit:tlg0019.tlg004.fu.sp:928.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:928.1.text#τρέφειν δύναιτ' ἂν μία λόχμη κλέπτα δύο·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:929.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:929.1.text#ἵνα μὴ κεκλάγγω διὰ κενῆς ἄλλως ἐγώ·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:930.1.speaker#Σωσίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:930.1.text#ἐὰν δὲ μή, τὸ λοιπὸν οὐ κεκλάγξομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:931.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:931.1.text#ἰοὺ ἰού.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:932.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:932.1.text#ὅσας κατηγόρησε τὰς πανουργίας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:933.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:933.1.text#κλέπτον τὸ χρῆμα τἀνδρός· οὐ καὶ σοὶ δοκεῖ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:934.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:934.1.text#ὦλεκτρυόν; νὴ τὸν Δί' ἐπιμύει γέ τοι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:935.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:935.1.text#ὁ θεσμοθέτης· ποῦ 'σθ' οὗτος; ἀμίδα μοι δότω.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:936.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:936.1.text#αὐτὸς καθελοῦ· τοὺς μάρτυρας γὰρ ἐσκαλῶ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:937.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:937.1.text#Λάβητι μάρτυρας παρεῖναι τρύβλιον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:938.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:938.1.text#δοίδυκα τυρόκνηστιν ἐσχάραν χύτραν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:939.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:939.1.text#καὶ τἄλλα, τὰ σκεύη τὰ προσκεκαυμένα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:940.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:940.1.text#ἀλλ' ἔτι σύ γ' οὐρεῖς καὶ καθίζεις οὐδέπω;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:941.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:941.1.text#τοῦτον δέ γ' οἶμ' ἐγὼ χεσεῖσθαι τήμερον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:942.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:942.1.text#οὐκ αὖ σὺ παύσει χαλεπὸς ὢν καὶ δύσκολος,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:943.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:943.1.text#καὶ ταῦτα τοῖς φεύγουσιν, ἀλλ' ὀδὰξ ἔχει;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:944.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:944.1.text#ἀνάβαιν', ἀπολογοῦ. τί σεσιώπηκας; λέγε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:945.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:945.1.text#ἀλλ' οὐκ ἔχειν οὗτός γ' ἔοικεν ὅ τι λέγῃ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:946.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:946.1.text#οὔκ, ἀλλ' ἐκεῖνό μοι δοκεῖ πεπονθέναι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:947.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:947.1.text#ὅπερ ποτὲ φεύγων ἔπαθε καὶ Θουκυδίδης·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:948.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:948.1.text#ἀπόπληκτος ἐξαίφνης ἐγένετο τὰς γνάθους.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:949.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:949.1.text#πάρεχ' ἐκποδών. ἐγὼ γὰρ ἀπολογήσομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:950.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:950.1.text#χαλεπὸν μὲν ὦνδρες ἐστὶ διαβεβλημένου
urn:cts:greekLit:tlg0019.tlg004.fu.sp:951.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:951.1.text#ὑπεραποκρίνεσθαι κυνός, λέξω δ' ὅμως.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:952.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:952.1.text#ἀγαθὸς γάρ ἐστι καὶ διώκει τοὺς λύκους.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:953.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:953.1.text#κλέπτης μὲν οὖν οὗτός γε καὶ ξυνωμότης.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:954.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:954.1.text#μὰ Δί' ἀλλ' ἄριστός ἐστι τῶν νυνὶ κυνῶν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:955.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:955.1.text#οἷός τε πολλοῖς προβατίοις ἐφεστάναι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:956.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:956.1.text#τί οὖν ὄφελος, τὸν τυρὸν εἰ κατεσθίει;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:957.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:957.1.text#ὅ τι; σοῦ προμάχεται καὶ φυλάττει τὴν θύραν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:958.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:958.1.text#καὶ τἄλλ' ἄριστός ἐστιν· εἰ δ' ὑφείλετο,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:959.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:959.1.text#ξύγγνωθι. κιθαρίζειν γὰρ οὐκ ἐπίσταται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:960.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:960.1.text#ἐγὼ δ' ἐβουλόμην ἂν οὐδὲ γράμματα,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:961.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:961.1.text#ἵνα μὴ κακουργῶν ἐνέγραφ' ἡμῖν τὸν λόγον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:962.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:962.1.text#ἄκουσον ὦ δαιμόνιέ μου τῶν μαρτύρων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:963.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:963.1.text#ἀνάβηθι τυρόκνηστι καὶ λέξον μέγα·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:964.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:964.1.text#σὺ γὰρ ταμιεύουσ' ἔτυχες. ἀπόκριναι σαφῶς,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:965.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:965.1.text#εἰ μὴ κατέκνησας τοῖς στρατιώταις ἅλαβες.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:966.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:966.1.textφησὶ κατακνῆσαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:966.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:966.2.text#νὴ Δί' ἀλλὰ ψεύδεται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:967.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:967.1.text#ὦ δαιμόνι' ἐλέει ταλαιπωρουμένους.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:968.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:968.1.text#οὗτος γὰρ ὁ Λάβης καὶ τραχήλι' ἐσθίει
urn:cts:greekLit:tlg0019.tlg004.fu.sp:969.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:969.1.text#καὶ τὰς ἀκάνθας, κοὐδέποτ' ἐν ταὐτῷ μένει.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:970.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:970.1.text#ὁ δ' ἕτερος οἷός ἐστιν οἰκουρὸς μόνον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:971.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:971.1.text#αὐτοῦ μένων γὰρ ἅττ' ἂν εἴσω τις φέρῃ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:972.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:972.1.text#τούτων μεταιτεῖ τὸ μέρος· εἰ δὲ μή, δάκνει.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:973.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:973.1.text#αἰβοῖ. τί κακόν ποτ' ἔσθ' ὅτῳ μαλάττομαι;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:974.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:974.1.text#κακόν τι περιβαίνει με κἀναπείθομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:975.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:975.1.text#ἴθ' ἀντιβολῶ σ'· οἰκτίρατ' αὐτὸν ὦ πάτερ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:976.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:976.1.text#καὶ μὴ διαφθείρητε. ποῦ τὰ παιδία;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:977.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:977.1.text#ἀναβαίνετ' ὦ πόνηρα καὶ κνυζούμενα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:978.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:978.1.text#αἰτεῖτε κἀντιβολεῖτε καὶ δακρύετε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:979.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:979.1.textκατάβα κατάβα κατάβα κατάβα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:979.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:979.2.text#καταβήσομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:980.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:980.1.text#καίτοι τὸ κατάβα τοῦτο πολλοὺς δὴ πάνυ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:981.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:981.1.text#ἐξηπάτηκεν. ἀτὰρ ὅμως καταβήσομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:982.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:982.1.text#ἐς κόρακας. ὡς οὐκ ἀγαθόν ἐστι τὸ ῥοφεῖν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:983.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:983.1.text#ἐγὼ γὰρ ἀπεδάκρυσα νῦν γνώμην ἐμὴν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:984.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:984.1.text#οὐδέν ποτ' ἀλλ' ἢ τῆς φακῆς ἐμπλήμενος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:985.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:985.1.textοὔκουν ἀποφεύγει δῆτα;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:985.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:985.2.text#χαλεπὸν εἰδέναι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:986.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:986.1.text#ἴθ' ὦ πατρίδιον ἐπὶ τὰ βελτίω τρέπου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:987.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:987.1.text#τηνδὶ λαβὼν τὴν ψῆφον ἐπὶ τὸν ὕστερον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:988.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:988.1.text#μύσας παρᾷξον κἀπόλυσον ὦ πάτερ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:989.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:989.1.text#οὐ δῆτα· κιθαρίζειν γὰρ οὐκ ἐπίσταμαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:990.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:990.1.text#φέρε νύν σε τῃδὶ τὴν ταχίστην περιάγω.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:991.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:991.1.textὅδ' ἔσθ' ὁ πρότερος;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:991.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:991.2.text#οὗτος·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:991.3.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:991.3.text#αὕτη 'νταῦθ' ἔνι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:992.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:992.1.text#ἐξηπάτηται κἀπολέλυκεν οὐχ ἑκών.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:993.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:993.1.textφέρ' ἐξεράσω.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:993.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:993.2.text#πῶς ἄρ' ἠγωνίσμεθα;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:994.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:994.1.text#δείξειν ἔοικεν. ἐκπέφευγας ὦ Λάβης.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:995.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:995.1.text#πάτερ πάτερ τί πέπονθας; οἴμοι· ποῦ 'σθ' ὕδωρ;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:996.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:996.1.textἔπαιρε σαυτόν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:996.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:996.2.text#εἰπέ νυν ἐκεῖνό μοι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:997.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:997.1.textὄντως ἀπέφυγε;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:997.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:997.2.text#νὴ Δί'·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:997.3.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:997.3.text#οὐδέν εἰμ' ἄρα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:998.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:998.1.text#μὴ φροντίσῃς ὦ δαιμόνι'· ἀλλ' ἀνίστασο.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:999.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:999.1.text#πῶς οὖν ἐμαυτῷ τοῦτ' ἐγὼ ξυνείσομαι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1000.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1000.1.text#φεύγοντ' ἀπολύσας ἄνδρα; τί ποτε πείσομαι;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1001.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1001.1.text#ἀλλ' ὦ πολυτίμητοι θεοὶ ξύγγνωτέ μοι·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1002.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1002.1.text#ἄκων γὰρ αὔτ' ἔδρασα κοὐ τοὐμοῦ τρόπου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1003.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1003.1.text#καὶ μηδὲν ἀγανάκτει γ'. ἐγὼ γάρ σ' ὦ πάτερ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1004.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1004.1.text#θρέψω καλῶς, ἄγων μετ' ἐμαυτοῦ πανταχοῖ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1005.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1005.1.text#ἐπὶ δεῖπνον, ἐς ξυμπόσιον, ἐπὶ θεωρίαν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1006.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1006.1.text#ὥσθ' ἡδέως διάγειν σε τὸν λοιπὸν χρόνον·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1007.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1007.1.text#κοὐκ ἐγχανεῖταί σ' ἐξαπατῶν Ὑπέρβολος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1008.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1008.1.textἀλλ' εἰσίωμεν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1008.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1008.2.text#ταῦτά νυν, εἴπερ δοκεῖ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1009.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1009.1.text#ἀλλ' ἴτε χαίροντες ὅποι βούλεσθ'.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1010.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1010.1.text#ὑμεῖς δὲ τέως ὦ μυριάδες
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1010a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1010a.text#ἀναρίθμητοι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1011.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1011.1.text#νῦν τὰ μέλλοντ' εὖ λέγεσθαι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1012.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1012.1.text#μὴ πέσῃ φαύλως χαμᾶζ'
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1013.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1013.1.text#εὐλαβεῖσθε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1013a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1013a.text#τοῦτο γὰρ σκαιῶν θεατῶν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1014.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1014.1.text#ἐστὶ πάσχειν, κοὐ πρὸς ὑμῶν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1015.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1015.1.text#νῦν αὖτε λεῲ προσέχετε τὸν νοῦν, εἴπερ καθαρόν τι φιλεῖτε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1016.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1016.1.text#μέμψασθαι γὰρ τοῖσι θεαταῖς ὁ ποιητὴς νῦν ἐπιθυμεῖ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1017.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1017.1.text#ἀδικεῖσθαι γάρ φησιν πρότερος πόλλ' αὐτοὺς εὖ πεποιηκώς,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1018.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1018.1.text#τὰ μὲν οὐ φανερῶς ἀλλ' ἐπικουρῶν κρύβδην ἑτέροισι ποιηταῖς,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1019.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1019.1.text#μιμησάμενος τὴν Εὐρυκλέους μαντείαν καὶ διάνοιαν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1020.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1020.1.text#εἰς ἀλλοτρίας γαστέρας ἐνδὺς κωμῳδικὰ πολλὰ χέασθαι·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1021.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1021.1.text#μετὰ τοῦτο δὲ καὶ φανερῶς ἤδη κινδυνεύων καθ' ἑαυτόν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1022.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1022.1.text#οὐκ ἀλλοτρίων ἀλλ' οἰκείων Μουσῶν στόμαθ' ἡνιοχήσας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1023.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1023.1.text#ἀρθεὶς δὲ μέγας καὶ τιμηθεὶς ὡς οὐδεὶς πώποτ' ἐν ὑμῖν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1024.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1024.1.text#οὐκ † ἐκτελέσαι † φησὶν ἐπαρθεὶς οὐδ' ὀγκῶσαι τὸ φρόνημα,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1025.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1025.1.text#οὐδὲ παλαίστρας περικωμάζειν πειρῶν· οὐδ' εἴ τις ἐραστὴς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1026.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1026.1.text#κωμῳδεῖσθαι παιδίχ' ἑαυτοῦ μισῶν ἔσπευσε πρὸς αὐτόν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1027.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1027.1.text#οὐδενὶ πώποτέ φησι πιθέσθαι, γνώμην τιν' ἔχων ἐπιεικῆ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1028.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1028.1.text#ἵνα τὰς Μούσας αἷσιν χρῆται μὴ προαγωγοὺς ἀποφήνῃ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1029.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1029.1.text#οὐδ' ὅτε πρῶτόν γ' ἦρξε διδάσκειν, ἀνθρώποις φήσ' ἐπιθέσθαι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1030.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1030.1.text#ἀλλ' Ἡρακλέους ὀργήν τιν' ἔχων τοῖσι μεγίστοις ἐπιχειρεῖν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1031.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1031.1.text#θρασέως ξυστὰς εὐθὺς ἀπ' ἀρχῆς αὐτῷ τῷ καρχαρόδοντι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1032.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1032.1.text#οὗ δεινόταται μὲν ἀπ' ὀφθαλμῶν Κύννης ἀκτῖνες ἔλαμπον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1033.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1033.1.text#ἑκατὸν δὲ κύκλῳ κεφαλαὶ κολάκων οἰμωξομένων ἐλιχμῶντο
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1034.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1034.1.text#περὶ τὴν κεφαλήν, φωνὴν δ' εἶχεν χαράδρας ὄλεθρον τετοκυίας,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1035.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1035.1.text#φώκης δ' ὀσμήν, Λαμίας ὄρχεις ἀπλύτους, πρωκτὸν δὲ καμήλου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1036.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1036.1.text#τοιοῦτον ἰδὼν τέρας οὔ φησιν δείσας καταδωροδοκῆσαι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1037.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1037.1.text#ἀλλ' ὑπὲρ ὑμῶν ἔτι καὶ νυνὶ πολεμεῖ· φησίν τε μετ' αὐτὸν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1038.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1038.1.text#τοῖς ἠπιάλοις ἐπιχειρῆσαι πέρυσιν καὶ τοῖς πυρετοῖσιν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1039.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1039.1.text#οἳ τοὺς πατέρας τ' ἦγχον νύκτωρ καὶ τοὺς πάππους ἀπέπνιγον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1040.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1040.1.text#κατακλινόμενοί τ' ἐπὶ ταῖς κοίταις ἐπὶ τοῖσιν ἀπράγμοσιν ὑμῶν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1041.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1041.1.text#ἀντωμοσίας καὶ προσκλήσεις καὶ μαρτυρίας συνεκόλλων,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1042.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1042.1.text#ὥστ' ἀναπηδᾶν δειμαίνοντας πολλοὺς ὡς τὸν πολέμαρχον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1043.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1043.1.text#τοιόνδ' εὑρόντες ἀλεξίκακον τῆς χώρας τῆσδε καθαρτήν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1044.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1044.1.text#πέρυσιν καταπροὔδοτε καινοτάταις σπείραντ' αὐτὸν διανοίαις,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1045.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1045.1.text#ἃς ὑπὸ τοῦ μὴ γνῶναι καθαρῶς ὑμεῖς ἐποιήσατ' ἀναλδεῖς·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1046.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1046.1.text#καίτοι σπένδων πόλλ' ἐπὶ πολλοῖς ὄμνυσιν τὸν Διόνυσον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1047.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1047.1.text#μὴ πώποτ' ἀμείνον' ἔπη τούτων κωμῳδικὰ μηδέν' ἀκοῦσαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1048.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1048.1.text#τοῦτο μὲν οὖν ἔσθ' ὑμῖν αἰσχρὸν τοῖς μὴ γνοῦσιν παραχρῆμα,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1049.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1049.1.text#ὁ δὲ ποιητὴς οὐδὲν χείρων παρὰ τοῖσι σοφοῖς νενόμισται,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1050.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1050.1.text#εἰ παρελαύνων τοὺς ἀντιπάλους τὴν ἐπίνοιαν ξυνέτριψεν. 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1051.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1051.1.text#ἀλλὰ τὸ λοιπὸν τῶν ποιητῶν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1052.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1052.1.text#ὦ δαιμόνιοι τοὺς ζητοῦντας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1053.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1053.1.text#καινόν τι λέγειν κἀξευρίσκειν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1054.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1054.1.text#στέργετε μᾶλλον καὶ θεραπεύετε,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1055.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1055.1.text#καὶ τὰ νοήματα σῴζεσθ' αὐτῶν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1056.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1056.1.text#ἐσβάλλετέ τ' ἐς τὰς κιβωτοὺς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1057.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1057.1.text#μετὰ τῶν μήλων. κἂν ταῦτα ποιῆθ',
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1058.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1058.1.text#ὑμῖν δι' ἔτους τῶν ἱματίων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1059.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1059.1.text#ὀζήσει δεξιότητος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1060.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1060.1.text#ὦ πάλαι ποτ' ὄντες ἡμεῖς ἄλκιμοι μὲν ἐν χοροῖς,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1061.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1061.1.text#ἄλκιμοι δ' ἐν μάχαις,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1062.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1062.1.text#καὶ κατ' αὐτὸ δὴ τοῦτο μόνον ἄνδρες ἀλκιμώτατοι·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1063.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1063.1.text#πρίν ποτ' ἦν πρὶν ταῦτα, νῦν δ'
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1064.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1064.1.text#οἴχεται, κύκνου τ' ἔτι πολιώτεραι δὴ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1065.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1065.1.text#αἵδ' ἐπανθοῦσιν τρίχες.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1066.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1066.1.text#ἀλλὰ κἀκ τῶν λειψάνων δεῖ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1067.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1067.1.text#τῶνδε ῥώμην νεανικὴν σχεῖν·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1068.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1068.1.text#ὡς ἐγὼ τοὐμὸν νομίζω
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1069.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1069.1.text#γῆρας εἶναι κρεῖττον ἢ πολλῶν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1069a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1069a.text#κικίννους νεανιῶν καὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1070.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1070.1.text#σχῆμα κεὐρυπρωκτίαν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1071.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1071.1.text#εἴ τις ὑμῶν ὦ θεαταὶ τὴν ἐμὴν ἰδὼν φύσιν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1072.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1072.1.text#εἶτα θαυμάζει μ' ὁρῶν μέσον διεσφηκωμένον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1073.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1073.1.text#ἥτις ἡμῶν ἐστὶν ἡ 'πίνοια τῆς ἐγκεντρίδος,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1074.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1074.1.text#ῥᾳδίως ἐγὼ διδάξω, κἂν ἄμουσος ᾖ τὸ πρίν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1075.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1075.1.text#ἐσμὲν ἡμεῖς, οἷς πρόσεστι τοῦτο τοὐρροπύγιον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1076.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1076.1.text#Ἀττικοὶ μόνοι δικαίως ἐγγενεῖς αὐτόχθονες,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1077.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1077.1.text#ἀνδρικώτατον γένος καὶ πλεῖστα τήνδε τὴν πόλιν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1078.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1078.1.text#ὠφελῆσαν ἐν μάχαισιν, ἡνίκ' ἦλθ' ὁ βάρβαρος,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1079.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1079.1.text#τῷ καπνῷ τύφων ἅπασαν τὴν πόλιν καὶ πυρπολῶν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1080.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1080.1.text#ἐξελεῖν ἡμῶν μενοινῶν πρὸς βίαν τἀνθρήνια.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1081.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1081.1.text#εὐθέως γὰρ ἐκδραμόντες ξὺν δορὶ ξὺν ἀσπίδι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1082.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1082.1.text#ἐμαχόμεσθ' αὐτοῖσι, θυμὸν ὀξίνην πεπωκότες,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1083.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1083.1.text#στὰς ἀνὴρ παρ' ἄνδρ', ὑπ' ὀργῆς τὴν χελύνην ἐσθίων·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1084.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1084.1.text#ὑπὸ δὲ τῶν τοξευμάτων οὐκ ἦν ἰδεῖν τὸν οὐρανόν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1085.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1085.1.text#ἀλλ' ὅμως ἐωσάμεσθα ξὺν θεοῖς πρὸς ἑσπέραν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1086.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1086.1.text#γλαῦξ γὰρ ἡμῶν πρὶν μάχεσθαι τὸν στρατὸν διέπτετο·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1087.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1087.1.text#εἶτα δ' εἱπόμεσθα θυννάζοντες ἐς τοὺς θυλάκους,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1088.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1088.1.text#οἱ δ' ἔφευγον τὰς γνάθους καὶ τὰς ὀφρῦς κεντούμενοι·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1089.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1089.1.text#ὥστε παρὰ τοῖς βαρβάροισι πανταχοῦ καὶ νῦν ἔτι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1090.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1090.1.text#μηδὲν Ἀττικοῦ καλεῖσθαι σφηκὸς ἀνδρικώτερον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1091.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1091.1.text#ἆρα δεινὸς ἦ τόθ' ὥστε πάντα μὴ δεδοικέναι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1092.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1092.1.text#καὶ κατεστρεψάμην
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1093.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1093.1.text#τοὺς ἐναντίους, πλέων ἐκεῖσε ταῖς τριήρεσιν;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1094.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1094.1.text#οὐ γὰρ ἦν ἡμῖν ὅπως
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1095.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1095.1.text#ῥῆσιν εὖ λέξειν ἐμέλλομεν τότ', οὐδὲ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1096.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1096.1.text#συκοφαντήσειν τινὰ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1097.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1097.1.text#φροντίς, ἀλλ' ὅστις ἐρέτης ἔσοιτ'
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1097a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1097a.text#ἄριστος. τοιγαροῦν πολλὰς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1098.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1098.1.text#πόλεις Μήδων ἑλόντες
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1099.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1099.1.text#αἰτιώτατοι φέρεσθαι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1100.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1100.1.text#τὸν φόρον δεῦρ' ἐσμέν, ὃν κλέπτουσιν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1101.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1101.1.text#οἱ νεώτεροι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1102.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1102.1.text#πολλαχοῦ σκοποῦντες ἡμᾶς εἰς ἅπανθ' εὑρήσετε
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1103.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1103.1.text#τοὺς τρόπους καὶ τὴν δίαιταν σφηξὶν ἐμφερεστάτους.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1104.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1104.1.text#πρῶτα μὲν γὰρ οὐδὲν ἡμῶν ζῷον ἠρεθισμένον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1105.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1105.1.text#μᾶλλον ὀξύθυμόν ἐστιν οὐδὲ δυσκολώτερον·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1106.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1106.1.text#εἶτα τἄλλ' ὅμοια πάντα σφηξὶ μηχανώμεθα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1107.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1107.1.text#ξυλλεγέντες γὰρ καθ' ἑσμούς, ὡσπερεὶ τἀνθρήνια,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1108.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1108.1.text#οἱ μὲν ἡμῶν οὗπερ ἅρχων, οἱ δὲ παρὰ τοὺς ἕνδεκα,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1109.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1109.1.text#οἱ δ' ἐν ᾠδείῳ δικάζουσ', οἱ δὲ πρὸς τοῖς τειχίοις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1110.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1110.1.text#ξυμβεβυσμένοι πυκνόν, νεύοντες ἐς τὴν γῆν, μόλις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1111.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1111.1.text#ὥσπερ οἱ σκώληκες ἐν τοῖς κυττάροις κινούμενοι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1112.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1112.1.text#ἔς τε τὴν ἄλλην δίαιτάν ἐσμεν εὐπορώτατοι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1113.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1113.1.text#πάντα γὰρ κεντοῦμεν ἄνδρα κἀκπορίζομεν βίον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1114.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1114.1.text#ἀλλὰ γὰρ κηφῆνες ἡμῖν εἰσιν ἐγκαθήμενοι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1115.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1115.1.text#οὐκ ἔχοντες κέντρον, οἳ μένοντες ἡμῶν τοῦ φόρου
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1116.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1116.1.text#τὸν πόνον κατεσθίουσιν, οὐ ταλαιπωρούμενοι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1117.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1117.1.text#τοῦτο δ' ἔστ' ἄλγιστον ἡμῖν, ἤν τις ἀστράτευτος ὢν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1118.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1118.1.text#ἐκροφῇ τὸν μισθὸν ἡμῶν, τῆσδε τῆς χώρας ὕπερ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1119.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1119.1.text#μήτε κώπην μήτε λόγχην μήτε φλύκταιναν λαβών.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1120.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1120.1.text#ἀλλ' ἐμοὶ δοκεῖ τὸ λοιπὸν τῶν πολιτῶν ἔμβραχυ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1121.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1121.1.text#ὅστις ἂν μὴ 'χῃ τὸ κέντρον, μὴ φέρειν τριώβολον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1122.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1122.1.text#οὔτοι ποτὲ ζῶν τοῦτον ἀποδυθήσομαι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1123.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1123.1.text#ἐπεὶ μόνος μ' ἔσωσε παρατεταγμένον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1124.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1124.1.text#ὅθ' ὁ βορέας ὁ μέγας ἐπεστρατεύσατο.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1125.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1125.1.text#ἀγαθὸν ἔοικας οὐδὲν ἐπιθυμεῖν παθεῖν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1126.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1126.1.text#μὰ τὸν Δί' οὐ γὰρ οὐδαμῶς μοι ξύμφορον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1127.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1127.1.text#καὶ γὰρ πρότερον ἐπανθρακίδων ἐμπλήμενος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1128.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1128.1.text#ἀπέδωκ' ὀφείλων τῷ κναφεῖ τριώβολον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1129.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1129.1.text#ἀλλ' οὖν πεπειράσθω γ', ἐπειδήπερ γ' ἅπαξ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1130.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1130.1.text#ἐμοὶ σεαυτὸν παραδέδωκας εὖ ποιεῖν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1131.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1131.1.textτί οὖν κελεύεις δρᾶν με;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1131.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1131.2.text#τὸν τρίβων' ἄφες,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1132.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1132.1.text#τηνδὶ δὲ χλαῖναν ἀναβαλοῦ τριβωνικῶς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1133.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1133.1.text#ἔπειτα παῖδας χρὴ φυτεύειν καὶ τρέφειν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1134.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1134.1.text#ὅθ' οὑτοσί με νῦν ἀποπνῖξαι βούλεται;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1135.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1135.1.text#ἔχ' ἀναβαλοῦ τηνδὶ λαβὼν καὶ μὴ λάλει.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1136.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1136.1.text#τουτὶ τὸ κακὸν τί ἐστι πρὸς πάντων θεῶν;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1137.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1137.1.text#οἱ μὲν καλοῦσι Περσίδ' οἱ δὲ καυνάκην.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1138.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1138.1.text#ἐγὼ δὲ σισύραν ᾠόμην Θυμαιτίδα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1139.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1139.1.text#κοὐ θαῦμά γ'· ἐς Σάρδεις γὰρ οὐκ ἐλήλυθας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1140.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1140.1.textἔγνως γὰρ ἄν· νῦν δ' οὐχὶ γιγνώσκεις.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1140.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1140.2.text#ἐγώ;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1141.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1141.1.text#μὰ τὸν Δί' οὐ τοίνυν· ἀτὰρ δοκεῖ γέ μοι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1142.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1142.1.text#ἐοικέναι μάλιστα Μορύχου σάγματι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1143.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1143.1.text#οὔκ, ἀλλ' ἐν Ἐκβατάνοισι ταῦθ' ὑφαίνεται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1144.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1144.1.text#ἐν Ἐκβατάνοισι γίγνεται κρόκης χόλιξ;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1145.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1145.1.text#πόθεν ὦγάθ'; ἀλλὰ τοῦτο τοῖσι βαρβάροις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1146.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1146.1.text#ὑφαίνεται πολλαῖς δαπάναις. αὕτη γέ τοι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1147.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1147.1.text#ἐρίων τάλαντον καταπέπωκε ῥᾳδίως.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1148.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1148.1.text#οὔκουν ἐριώλην δῆτ' ἐχρῆν αὐτὴν καλεῖν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1149.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1149.1.textδικαιότερον ἢ καυνάκην;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1149.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1149.2.text#ἔχ' ὦγαθέ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1150.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1150.1.textκαὶ στῆθ' ἀναμπισχόμενος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1150.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1150.2.text#οἴμοι δείλαιος·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1151.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1151.1.text#ὡς θερμὸν ἡ μιαρά τί μου κατήρυγεν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1152.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1152.1.textοὐκ ἀναβαλεῖ;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1152.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1152.2.text#μὰ Δί' οὐκ ἔγωγ'. ἀλλ' ὦγαθέ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1153.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1153.1.text#εἴπερ γ' ἀνάγκη, κρίβανόν μ' ἀμπίσχετε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1154.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1154.1.text#φέρ' ἀλλ' ἐγώ σε περιβαλῶ· σὺ δ' οὖν ἴθι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1155.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1155.1.textπαράθου γε μέντοι καὶ κρεάγραν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1155.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1155.2.text#τιὴ τί δή;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1156.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1156.1.text#ἵν' ἐξέλῃς με πρὶν διερρυηκέναι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1157.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1157.1.text#ἄγε νυν ὑπολύου τὰς καταράτους ἐμβάδας,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1158.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1158.1.text#τασδὶ δ' ἀνύσας † ὑπόδυθι † τὰς Λακωνικάς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1159.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1159.1.text#ἐγὼ γὰρ ἂν τλαίην ὑποδήσασθαί ποτε
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1160.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1160.1.text#ἐχθρῶν παρ' ἀνδρῶν δυσμενῆ καττύματα;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1161.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1161.1.text#ἔνθες ποτ' ὦ τᾶν κἀπόβαιν' ἐρρωμένως
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1162.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1162.1.textἐς τὴν Λακωνικὴν ἀνύσας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1162.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1162.2.text#ἀκικεῖς γέ με
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1163.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1163.1.text#ἐς τὴν πολεμίαν ἀποβιβάζων τὸν πόδα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1164.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1164.1.textφέρε καὶ τὸν ἕτερον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1164.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1164.2.text#μηδαμῶς τοῦτόν γ', ἐπεὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1165.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1165.1.text#πάνυ μισολάκων αὐτοῦ 'στιν εἷς τῶν δακτύλων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1166.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1166.1.textοὐκ ἔστι παρὰ ταῦτ' ἄλλα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1166.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1166.2.text#κακοδαίμων ἐγώ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1167.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1167.1.text#ὅστις ἐπὶ γήρως χίμετλον οὐδὲν λήψομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1168.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1168.1.text#ἄνυσόν ποθ' ὑποδησάμενος· εἶτα πλουσίως
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1169.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1169.1.text#ὡδὶ προβὰς τρυφερόν τι διασαλακώνισον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1170.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1170.1.text#ἰδού. θεῶ τὸ σχῆμα, καὶ σκέψαι μ' ὅτῳ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1171.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1171.1.text#μάλιστ' ἔοικα τὴν βάδισιν τῶν πλουσίων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1172.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1172.1.text#ὅτῳ; Δοθιῆνι σκόροδον ἠμφιεσμένῳ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1173.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1173.1.text#καὶ μὴν προθυμοῦμαί γε σαυλοπρωκτιᾶν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1174.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1174.1.text#ἄγε νυν, ἐπιστήσει λόγους σεμνοὺς λέγειν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1175.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1175.1.text#ἀνδρῶν παρόντων πολυμαθῶν καὶ δεξιῶν;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1176.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1176.1.textἔγωγε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1176.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1176.2.text#τίνα δῆτ' ἂν λέγοις;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1176.3.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1176.3.text#πολλοὺς πάνυ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1177.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1177.1.text#πρῶτον μὲν ὡς ἡ Λάμι' ἁλοῦσ' ἐπέρδετο,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1178.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1178.1.text#ἔπειτα δ' ὡς ὁ Καρδοπίων τὴν μητέρα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1179.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1179.1.text#μή 'μοί γε μύθους, ἀλλὰ τῶν ἀνθρωπίνων,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1180.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1180.1.text#οἵους λέγομεν μάλιστα τοὺς κατ' οἰκίαν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1181.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1181.1.text#ἐγᾦδα τοίνυν τῶν γε πάνυ κατ' οἰκίαν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1182.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1182.1.text#ἐκεῖνον ὡς "οὕτω ποτ' ἦν μῦς καὶ γαλῆ."
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1183.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1183.1.text#ὦ σκαιὲ κἀπαίδευτε, Θεογένης ἔφη
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1184.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1184.1.text#τῷ κοπρολόγῳ καὶ ταῦτα λοιδορούμενος,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1185.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1185.1.text#μῦς καὶ γαλᾶς μέλλεις λέγειν ἐν ἀνδράσιν;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1186.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1186.1.textποίους τινὰς δὲ χρὴ λέγειν;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1186.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1186.2.text#μεγαλοπρεπεῖς,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1187.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1187.1.text#ὡς ξυνεθεώρεις Ἀνδροκλεῖ καὶ Κλεισθένει.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1188.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1188.1.text#ἐγὼ δὲ τεθεώρηκα ποώποτ' οὐδαμοῖ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1189.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1189.1.text#πλὴν ἐς Πάρον, καὶ ταῦτα δὔ ὀβολὼ φέρων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1190.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1190.1.text#ἀλλ' οὖν λέγειν χρή σ' ὡς ἐμάχετό γ' αὐτίκα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1191.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1191.1.text#Ἐφουδίων παγκράτιον Ἀσκώνδᾳ καλῶς,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1192.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1192.1.text#ἤδη γέρων ὢν καὶ πολιός, ἔχων δέ τοι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1193.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1193.1.text#πλευρὰν βαθυτάτην καὶ χέρας καὶ λαγόνα καὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1194.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1194.1.textθώρακ' ἄριστον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1194.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1194.2.text#παῦε παῦ', οὐδὲν λέγεις.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1195.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1195.1.text#πῶς ἂν μαχέσαιτο παγκράτιον θώρακ' ἔχων;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1196.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1196.1.text#οὕτω διηγεῖσθαι νομίζουσ' οἱ σοφοί.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1197.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1197.1.text#ἀλλ' ἕτερον εἰπέ μοι· παρ' ἀνδράσι ξένοις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1198.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1198.1.text#πίνων σεαυτοῦ ποῖον ἂν λέξαι δοκεῖς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1199.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1199.1.text#ἐπὶ νεότητος ἔργον ἀνδρικώτατον;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1200.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1200.1.text#ἐκεῖν' ἐκεῖν' ἀνδρειότατόν γε τῶν ἐμῶν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1201.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1201.1.text#ὅτ' Ἐργασίωνος τὰς χάρακας ὑφειλόμην.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1202.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1202.1.text#ἀπολεῖς με. ποίας χάρακας; ἀλλ' ὡς ἢ κάπρον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1203.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1203.1.text#ἐδιώκαθές ποτ' ἢ λαγών, ἢ λαμπάδα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1204.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1204.1.text#ἔδραμες, ἀνευρὼν ὅ τι νεανικώτατον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1205.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1205.1.text#ἐγᾦδα τοίνυν τό γε νεανικώτατον·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1206.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1206.1.text#ὅτε τὸν δρομέα Φάυλλον ὢν βούπαις ἔτι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1207.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1207.1.text#εἶλον διώκων λοιδορίας ψήφοιν δυοῖν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1208.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1208.1.text#παὖ· ἀλλὰ δευρὶ κατακλινεὶς προσμάνθανε
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1209.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1209.1.text#ξυμποτικὸς εἶναι καὶ ξυνουσιαστικός.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1210.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1210.1.textπῶς οὖν κατακλινῶ; φράζ' ἀνύσας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1210.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1210.2.text#εὐσχημόνως.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1211.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1211.1.textὡδὶ κελεύεις κατακλινῆναι;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1211.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1211.2.text#μηδαμῶς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1212.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1212.1.textπῶς δαί;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1212.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1212.2.text#τὰ γόνατ' ἔκτεινε καὶ γυμναστικῶς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1213.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1213.1.text#ὑγρὸν χύτλασον σεαυτὸν ἐν τοῖς στρώμασιν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1214.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1214.1.text#ἔπειτ' ἐπαίνεσόν τι τῶν χαλκωμάτων,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1215.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1215.1.text#ὀροφὴν θέασαι, κρεκάδι' αὐλῆς θαύμασον·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1216.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1216.1.text#ὕδωρ κατὰ χειρός· τὰς τραπέζας ἐσφέρειν·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1217.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1217.1.text#δειπνοῦμεν· ἀπονενίμμεθ'· ἤδη σπένδομεν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1218.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1218.1.text#πρὸς τῶν θεῶν ἐνύπνιον ἑστιώμεθα;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1219.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1219.1.text#αὑλητρὶς ἐνεφύσησεν· οἱ δὲ συμπόται
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1220.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1220.1.text#εἰσὶν Θέωρος Αἰσχίνης Φᾶνος Κλέων,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1221.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1221.1.text#ξένος τις ἕτερος πρὸς κεφαλῆς Ἀκέστορος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1222.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1222.1.text#τούτοις ξυνὼν τὰ σκόλι' ὅπως δέξει καλῶς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1223.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1223.1.text#ἄληθες; ὡς οὐδεὶς Διακρίων δέξεται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1224.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1224.1.text#ἐγὼ εἴσομαι· καὶ δὴ γάρ εἰμ' ἐγὼ Κλέων,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1225.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1225.1.text#ᾄδω δὲ πρῶτος Ἁρμοδίου· δέξαι δὲ σύ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1226.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1226.1.text#"οὐδεὶς πώποτ' ἀνὴρ ἔγεντ' Ἀθήναις"—
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1227.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1227.1.text#οὐχ οὕτω γε πανοῦργος οὐδὲ κλέπτης.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1228.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1228.1.text#τουτὶ σὺ δράσεις; παραπολεῖ βοώμενος·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1229.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1229.1.text#φήσει γὰρ ἐξολεῖν σε καὶ διαφθερεῖν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1230.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1230.1.textκαὶ τῆσδε τῆς γῆς ἐξελᾶν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1230.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1230.2.text#ἐγὼ δέ γε,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1231.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1231.1.text#ἐὰν ἀπειλῇ, νὴ Δί' ἕτερ' ἀντᾴσομαι·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1232.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1232.1.text#"ὦνθρωφ', οὖτος ὁ μαιόμενος τὸ μέγα κράτος,"
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1235.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1235.1.text#"ἀντρέψεις ἔτι τὰν πόλιν· ἁ δ' ἔχεται ῥοπᾶς."
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1236.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1236.1.text#τί δ' ὅταν Θέωρος πρὸς ποδῶν κατακείμενος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1237.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1237.1.text#ᾄδῃ Κλέωνος λαβόμενος τῆς δεξιᾶς·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1238.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1238.1.text# "Ἀδμήτου λόγον ὦταῖρε μαθὼν τοὺς ἀγαθοὺς φίλει." 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1239.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1239.1.textτούτῳ τί λέξεις σκόλιον;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1239.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1239.2.text#ᾠδικῶς ἐγώ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1240.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1240.1.text#"οὐκ ἔστιν ἀλωπεκίζειν,"
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1241.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1241.1.text#"οὐδ' ἀμφοτέροισι γίγνεσθαι φίλον."
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1242.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1242.1.text#μετὰ τοῦτον Αἰσχίνης ὁ Σέλλου δέξεται,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1244.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1244.1.text#ἀνὴρ σοφὸς καὶ μουσικός, κᾆτ' ᾄσεται·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1245.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1245.1.text#"χρήματα καὶ βίαν"
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1246.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1246.1.text#"Κλειταγόρᾳ τε κἀμοὶ"
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1247.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1247.1.text#"μετὰ Θετταλῶν"—
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1248.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1248.1.text#πολλὰ δὴ διεκόμπασας σὺ κἀγώ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1249.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1249.1.text#τουτὶ μὲν ἐπιεικῶς σύ γ' ἐξεπίστασαι·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1250.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1250.1.text#ὅπως δ' ἐπὶ δεῖπνον ἐς Φιλοκτήμονος ἴμεν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1251.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1251.1.text#παῖ παῖ, τὸ δεῖπνον Χρυσὲ συσκεύαζε νῷν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1252.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1252.1.textἵνα καὶ μεθυσθῶμεν διὰ χρόνου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1252.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1252.2.text#μηδαμῶς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1253.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1253.1.text#κακὸν τὸ πίνειν· ἀπὸ γὰρ οἴνου γίγνεται
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1254.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1254.1.text#καὶ θυροκοπῆσαι καὶ πατάξαι καὶ βαλεῖν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1255.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1255.1.text#κἄπειτ' ἀποτίνειν ἀργύριον ἐκ κραιπάλης.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1256.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1256.1.text#οὔκ, ἢν ξυνῇς γ' ἀνδράσι καλοῖς τε κἀγαθοῖς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1257.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1257.1.text#ἢ γὰρ παρῃτήσαντο τὸν πεπονθότα,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1258.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1258.1.text#ἢ λόγον ἔλεξας αὐτὸς ἀστεῖόν τινα,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1259.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1259.1.text#Αἰσωπικὸν γέλοιον ἢ Συβαριτικόν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1260.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1260.1.text#ὧν ἔμαθες ἐν τῷ συμποσίῳ· κᾆτ' ἐς γέλων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1261.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1261.1.text#τὸ πρᾶγμ' ἔτρεψας, ὥστ' ἀφείς σ' ἀποιχεται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1262.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1262.1.text#μαθητέον τἄρ' ἐστὶ πολλοὺς τῶν λόγων,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1263.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1263.1.text#εἴπερ ἀποτείσω μηδέν, ἤν τι δρῶ κακόν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1264.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1264.1.text#ἄγε νυν ἴωμεν· μηδὲν ἡμᾶς ἰσχέτω.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1265.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1265.1.text#πολλάκις δὴ 'δοξ' ἐμαυτῷ δεξειὸς πεφυκέναι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1266.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1266.1.text#καὶ σκαιὸς οὐδεπώποτε·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1267.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1267.1.text#ἀλλ' Ἀμυνίας ὁ Σέλλου μᾶλλον οὑκ τῶν Κρωβύλων,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1268.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1268.1.text#οὗτος ὅν γ' ἐγώ ποτ' εἶδον ἀντὶ μήλου καὶ ῥοᾶς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1269.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1269.1.text#δειπνοῦντα μετὰ Λεωγόρου·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1270.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1270.1.text#πεινῇ γὰρ ᾗπερ Ἀντιφῶν·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1271.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1271.1.text#ἀλλὰ πρεσβεύων γὰρ ἐς Φάρσαλον ᾤχετ', εἶτ' ἐκεῖ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1272.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1272.1.text#μόνος μόνοις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1273.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1273.1.text#τοῖς Πενέσταισι ξυνῆν τοῖς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1274.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1274.1.text#Θετταλῶν, αὐτὸς πενέστης ὢν ἔλαττων οὐδενός.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1275.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1275.1.text#ὦ μακάρι' Αὐτόμενες ὥς σε μακαρίζομεν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1276.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1276.1.text#παῖδας ἐφύτευσας ὅτι χειροτεχνικωτάτους·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1277.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1277.1.text#πρῶτα μὲν ἅπασι φίλον ἄνδρα τε σοφώτατον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1278.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1278.1.text#τὸν κιφαραοιδότατον, ᾧ χάρις ἐφέσπετο·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1279.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1279.1.text#τὸν δ' ὑποκριτὴν ἕτερον ἀργαλέον ὡς σοφόν·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1280.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1280.1.text#εἶτ' Ἀριφράδην πολύ τι θυμοσοφικώτατον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1281.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1281.1.text#ὅντινά ποτ' ὤμοσε μαθόντα παρὰ μηδενός,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1282.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1282.1.text#ἀλλ' ἀπὸ σοφῆς φύσεος αὐτόματον ἐκμαθεῖν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1283.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1283.1.text#γλωττοποιεῖν ἐς τὰ πορνεῖ' εἰσιόνθ' ἑκάστοτε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1283a.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1283a.text# […] 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1284.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1284.1.text#εἰσί τινες οἵ μ' ἔλεγον ὡς καταδιηλλάγην,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1285.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1285.1.text#ἡνίκα Κλέων μ' ὑπετάραττεν ἐπικείμενος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1286.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1286.1.text#† καί με κακίσταις † ἔκνισε· κᾆθ' ὅτ' ἀπεδειρόμην,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1287.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1287.1.text#οὑκτὸς ἐγέλων μέγα κεκραγότα θεώμενοι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1288.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1288.1.text#οὐδὲν ἄρ' ἐμοῦ μέλον, ὅσον δὲ μόνον εἰδέναι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1289.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1289.1.text#σκωμμάτιον εἴποτέ τι θλιβόμενος ἐκβαλῶ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1290.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1290.1.text#ταῦτα κατιδὼν ὑπό τι μικρὸν ἐπιθήκισα·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1291.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1291.1.text#εἶτα νῦν ἐξηπάτησεν ἡ χάραξ τὴν ἄμπελον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1292.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1292.1.text#ἰὼ χελῶναι μακάριαι τοῦ δέρματος,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1293.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1293.1.text#καὶ τρὶς μακάριαι τοῦ 'πὶ ταῖς πλευραῖς τέγους.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1294.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1294.1.text#ὡς εὖ κατηρέψασθε καὶ νουβυστικῶς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1295.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1295.1.text#κεράμῳ τὸ νῶτον ὥστε τὰς πληγὰς στέγειν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1296.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1296.1.text#ἐγὼ δ' ἀπόλωλα στιζόμενος βακτηρίᾳ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1297.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1297.1.text#τί δ' ἔστιν ὦ παῖ; παῖδα γάρ, κἂν ᾖ γέρων,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1298.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1298.1.text#καλεῖν δίκαιον ὅστις ἂν πληγὰς λάβῃ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1299.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1299.1.text#οὐ γὰρ ὁ γέρων ἀτηρότατον ἄρ' ἦν κακὸν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1300.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1300.1.text#καὶ τῶν ξυνόντων πολὺ παροινικώτατος;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1301.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1301.1.text#καίτοι παρῆν Ἵππυλλος Ἀντιφῶν Λύκων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1302.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1302.1.text#Λυσίστρατος Θούφραστος οἱ περὶ Φρύνιχον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1303.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1303.1.text#τούτων ἁπάντων ἦν ὑβριστότατος μακρῷ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1304.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1304.1.text#εὐθὺς γὰρ ὡς ἐνέπλητο πολλῶν κἀγαθῶν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1305.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1305.1.text#ἐνήλατ' ἐσκίρτα 'πεπόρδει κατεγέλα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1306.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1306.1.text#ὥσπερ καχρύων ὀνίδιον εὐωχημένον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1307.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1307.1.text#κἄτυπτεν ἐμὲ νεανικῶς "παῖ παῖ" καλῶν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1308.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1308.1.text#εἶτ' αὐτὸν ὡς εἶδ' ᾔκασεν Λυσίστρατος·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1309.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1309.1.text#"ἔοικας ὦ πρεσβῦτα νεοπλούτῳ τρυγὶ"
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1310.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1310.1.text#"κλητῆρί τ' εἰς ἀχυρμὸν ἀποδεδρακότι."
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1311.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1311.1.text#ὁ δ' ἀνακραγὼν ἀντῄκασ' αὐτὸν πάρνοπι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1312.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1312.1.text#τὰ θρῖα τοῦ τρίβωνος ἀποβεβληκότι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1313.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1313.1.text#Σθενέλῳ τε τὰ σκευάρια διακεκαρμένῳ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1314.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1314.1.text#οἱ δ' ἀνεκρότησαν, πλήν γε Θουφράστου μόνου·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1315.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1315.1.text#οὗτος δὲ διεμύλλαινεν ὡς δὴ δεξιός.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1316.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1316.1.text#ὁ γέρων δὲ τὸν Θούφραστον ἤρετ'· 'εἰπέ μοι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1317.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1317.1.text#ἐπὶ τῷ κομᾷς καὶ κομψὸς εἶναι προσποιεῖ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1318.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1318.1.text#κωμῳδολοιχῶν περὶ τὸν εὖ πράττοντ' ἀεί;'
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1319.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1319.1.text#τοιαῦτα περιύβριζεν αὐτοὺς ἐν μέρει,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1320.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1320.1.text#σκώπτων ἀγροίκως καὶ προσέτι λόγους λέγων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1321.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1321.1.text#ἀμαθέστατ' οὐδὲν εἰκότας τῷ πράγματι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1322.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1322.1.text#ἔπειτ' ἐπειδὴ 'μέθυεν, οἴκαδ' ἔρχεται
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1323.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1323.1.text#τύπτων ἅπαντας, ἤν τις αὐτῷ ξυντύχῃ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1324.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1324.1.text#ὁδὶ δὲ καὶ δὴ σφαλλόμενος προσέρχεται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1325.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1325.1.text#ἀλλ' ἐκποδὼν ἄπειμι πρὶν πληγὰς λαβεῖν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1326.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1326.1.text#ἄνεχε πάρεχε·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1327.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1327.1.text#κλαύσεταί τις τῶν ὄπισθεν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1328.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1328.1.text#ἐπακολουθούντων ἐμοί·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1329.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1329.1.text#οἷον, εἰ μὴ 'ρρήσεθ', ὑμᾶς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1330.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1330.1.text#ὦ πόνηροι ταυτῃὶ τῇ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1331.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1331.1.text#δᾳδὶ φρυκτοὺς σκευάσω.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1332.1.speaker#Ξυμότης τις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1332.1.text#ἦ μὴν σὺ δώσεις αὔριον τούτων δίκην
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1333.1.speaker#Ξυμότης τις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1333.1.text#ἡμῖν ἅπασι, κεἰ σφόδρ' εἶ νεανίας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1334.1.speaker#Ξυμότης τις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1334.1.text#ἁθρόοι γὰρ ἥξομέν σε προσκαλούμενοι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1335.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1335.1.text#ἰὴ ἰεῦ, καλούμενοι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1336.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1336.1.text#ἀρχαῖά γ' ὑμῶν· ἆρά γ' ἴσθ'
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1337.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1337.1.text#ὡς οὐδ' ἀκούων ἀνέχομαι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1338.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1338.1.text#δικῶν; ἰαιβοῖ, αἰβοῖ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1339.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1339.1.text#τάδε μ' ἀρέσκει· βάλλε κημούς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1340.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1340.1.text#οὐκ ἄπεισι; ποῦ 'στιν ἡμῖν 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1340a.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1340a.text#ἡλιαστής; ἐκποδών. 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1341.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1341.1.text#ἀνάβαινε δεῦρο χρυσομηλολόνθιον,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1342.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1342.1.text#τῇ χειρὶ τουδὶ λαβομένη τοῦ σχοινίου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1343.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1343.1.text#ἔχου· φυλάττου δ', ὡς σαπρὸν τὸ σχοινίον·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1344.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1344.1.text#ὅμως γε μέντοι τριβόμενον οὐκ ἄχθεται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1345.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1345.1.text#ὁρᾷς ἐγώ σ' ὡς δεξιῶς ὑφειλόμην
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1346.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1346.1.text#μέλλουσαν ἤδη λεσβιᾶν τοὺς ξυμπότας·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1347.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1347.1.text#ὧν οὕνεκ' ἀπόδος τῷ πέει τῳδὶ χάριν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1348.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1348.1.text#ἀλλ' οὐκ ἀποδώσεις οὐδ' ἐφιαλεῖς οἶδ' ὅτι,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1349.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1349.1.text#ἀλλ' ἐξαπατήσεις κἀγχανεῖ τούτῳ μέγα·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1350.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1350.1.text#πολλοῖς γὰρ ἤδη χἀτέροις αὔτ' ἠργάσω.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1351.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1351.1.text#ἐὰν γένῃ δὲ μὴ κακὴ νυνὶ γυνή,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1352.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1352.1.text#ἐγώ σ' ἐπειδὰν οὑμὸς υἱὸς ἀποθάνῃ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1353.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1353.1.text#λυσάμενος ἕξω παλλακὴν ὦ χοιρίον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1354.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1354.1.text#νῦν δ' οὐ κρατῶ 'γὼ τῶν ἐμαυτοῦ χρημάτων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1355.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1355.1.text#νέος γάρ εἰμι καὶ φυλάττομαι σφόδρα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1356.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1356.1.text#τὸ γὰρ υἵδιον τηρεῖ με, κἄστι δύσκολον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1357.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1357.1.text#κἄλλως κυμινοπριστοκαρδαμογλύφον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1358.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1358.1.text#ταῦτ' οὖν περί μου δέδοικε μὴ διαφθαρῶ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1359.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1359.1.text#πατὴρ γὰρ οὐδείς ἐστιν αὐτῷ πλὴν ἐμοῦ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1360.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1360.1.text#ὁδὶ δὲ καὐτὸς ἐπὶ σὲ κἄμ' ἔοικε θεῖν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1361.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1361.1.text#ἀλλ' ὡς τάχιστα στῆθι τάσδε τὰς δετὰς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1362.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1362.1.text#λαβοῦσ', ἵν' αὐτὸν τωθάσω νεανικῶς,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1363.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1363.1.text#οἵοις ποθ' οὗτος ἐμὲ πρὸ τῶν μυστηρίων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1364.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1364.1.text#ὦ οὗτος οὗτος τυφεδανὲ καὶ χοιρόθλιψ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1365.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1365.1.text#ποθεῖν ἐρᾶν τ' ἔοικας ὡραίας σοροῦ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1366.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1366.1.text#οὔτοι καταπροίξει μὰ τὸν Ἀπόλλω τοῦτο δρῶν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1367.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1367.1.text#ὡς ἡδέως φάγοις ἂν ἐξ ὄξους δίκην.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1368.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1368.1.text#οὐ δεινὰ τωθάζειν σε τὴν αὐλητρίδα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1369.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1369.1.textτῶν ξυμποτῶν κλέψαντα;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1369.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1369.2.text#ποίαν αὐλητρίδα;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1370.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1370.1.text#τί ταῦτα ληρεῖς ὥσπερ ἀπὸ τύμβου πεσών;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1371.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1371.1.text#νὴ τὸν Δί' αὕτη πού 'στί σοί γ' ἡ Δαρδανίς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1372.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1372.1.text#οὔκ, ἀλλ' ἐν ἀγορᾷ τοῖς θεοῖς δᾲς κάεται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1373.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1373.1.textδᾲς ἥδε;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1373.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1373.2.text#δᾲς δῆτ'. οὐχ ὁρᾷς ἐστιγμένην;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1374.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1374.1.text#τί δὲ τὸ μέλαν τοῦτ' ἐστὶν αὐτῆς τοὐν μέσῳ;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1375.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1375.1.text#ἡ πίττα δήπου καομένης ἐξέρχεται.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1376.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1376.1.text#ὁ δ' ὄπισθεν οὐχὶ πρωκτός ἐστιν οὑτοσί;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1377.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1377.1.text#ὄζος μὲν οὖν τῆς δᾳδὸς οὗτος ἐξέχει.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1378.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1378.1.text#τί λέγεις σύ; ποῖος ὄζος; οὐκ εἶ δεῦρο σύ;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1379.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1379.1.textἆ ἆ τί μέλλεις δρᾶν;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1379.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1379.2.text#ἄγειν ταύτην λαβὼν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1380.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1380.1.text#ἀφελόμενός σε καὶ νομίσας εἶναι σαπρὸν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1381.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1381.1.textκοὐδὲν δύνασθαι δρᾶν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1381.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1381.2.text#ἄκουσόν νυν ἐμοῦ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1382.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1382.1.text#Ὀλυμπίασιν, ἡνίκ' ἐθεώρουν ἐγώ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1383.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1383.1.text#Ἐφουδίων ἐμαχέσατ' Ἀσκώνδᾳ καλῶς
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1384.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1384.1.text#ἤδη γέρων ὤν· εἶτα τῇ πυγμῇ θενὼν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1385.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1385.1.text#ὁ πρεσβύτερος κατέβαλε τὸν νεώτερον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1386.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1386.1.text#πρὸς ταῦτα τηροῦ μὴ λάβῃς ὑπώπια.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1387.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1387.1.text#νὴ τὸν Δί' ἐξέμαθές γε τὴν Ὀλυμπίαν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1388.1.speaker#Αρτόπωλις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1388.1.text#ἴθι μοι παράστηθ', ἀντιβολῶ πρὸς τῶν θεῶν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1389.1.speaker#Αρτόπωλις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1389.1.text#ὁδὶ γὰρ ἁνήρ ἐστιν ὅς μ' ἀπώλεσεν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1390.1.speaker#Αρτόπωλις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1390.1.text#τῇ δᾳδὶ παίων, κἀξέβαλεν ἐντευθενὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1391.1.speaker#Αρτόπωλις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1391.1.text#ἄρτους δέκ' ὀβολῶν κἀπιθήκην τέτταρας.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1392.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1392.1.text#ὁρᾷς ἃ δέδρακας; πράγματ' αὖ δεῖ καὶ δίκας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1393.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1393.1.textἔχειν διὰ τὸν σὸν οἶνον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1393.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1393.2.text#οὐδαμῶς γ', ἐπεὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1394.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1394.1.text#λόγοι διαλλάξουσιν αὐτὰ δεξιοί·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1395.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1395.1.text#ὥστ' οἶδ' ὁτιὴ ταύτῃ διαλλαχθήσομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1396.1.speaker#Αρτόπωλις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1396.1.text#οὔτοι μὰ τὼ θεὼ καταπροίξει Μυρτίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1397.1.speaker#Αρτόπωλις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1397.1.text#τῆς Ἀγκυλίωνος θυγατέρος καὶ Σωστράτης,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1398.1.speaker#Αρτόπωλις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1398.1.text#οὕτω διαφθείρας ἐμοῦ τὰ φορτία.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1399.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1399.1.text#ἄκουσον ὦ γύναι· λόγον σοι βούλομαι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1400.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1400.1.textλέξαι χαρίεντα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1400.2.speaker#Αρτόπωλις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1400.2.text#μὰ Δία μὴ 'μοί γ' ὦ μέλε.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1401.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1401.1.text#Αἴσωπον ἀπὸ δείπνου βαδίζονθ' ἑσπέρας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1402.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1402.1.text#θρασεῖα καὶ μεθύση τις ὑλάκτει κύων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1403.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1403.1.text#κἄπειτ' ἐκεῖνος εἶπεν, "ὦ κύον κύον,"
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1404.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1404.1.text#"εἰ νὴ Δί' ἀντὶ τῆς κακῆς γλώττης ποθὲν"
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1405.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1405.1.text#"πυροὺς πρίαιο, σωφρονεῖν ἄν μοι δοκεῖς."
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1406.1.speaker#Αρτόπωλις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1406.1.text#καὶ καταγελᾷς μου; προσκαλοῦμαί σ' ὅστις εἶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1407.1.speaker#Αρτόπωλις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1407.1.text#πρὸς τοὺς ἀγορανόμους βλάβης τῶν φορτίων,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1408.1.speaker#Αρτόπωλις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1408.1.text#κλητῆρ' ἔχουσα Χαιρεφῶντα τουτονί.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1409.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1409.1.text#μὰ Δί' ἀλλ' ἄκουσον, ἤν τί σοι δόξω λέγειν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1410.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1410.1.text#Λᾶσός ποτ' ἀντεδίδασκε καὶ Σιμωνίδης·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1411.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1411.1.text#ἔπειθ' ὁ Λᾶσος εἶπεν, "ὀλίγον μοι μέλει."
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1412.1.speaker#Αρτόπωλις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1412.1.textἄληθες οὗτος;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1412.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1412.2.text#καὶ σὺ δή μοι Χαιρεφῶν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1413.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1413.1.text#γυναικὶ † κλητεύειν ἐοικὼς † θαψίνῃ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1414.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1414.1.text#Ἰνοῖ κρεμαμένῃ πρὸς ποδῶν Εὐριπίδου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1415.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1415.1.text#ὁδί τις ἕτερος, ὡς ἔοικεν, ἔρχεται
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1416.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1416.1.text#καλούμενός σε· τόν γέ τοι κλητῆρ' ἔχει.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1417.1.speaker#Κατήγορος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1417.1.text#οἴμοι κακοδαίμων. προσκαλοῦμαί σ' ὦ γέρον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1418.1.speaker#Κατήγορος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1418.1.textὕβρεως.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1418.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1418.2.text#ὕβρεως; μὴ μὴ καλέσῃ πρὸς τῶν θεῶν·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1419.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1419.1.text#ἐγὼ γὰρ ὑπὲρ αὐτοῦ δίκην δίδωμί σοι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1420.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1420.1.text#ἣν ἂν σὺ τάξῃς, καὶ χάριν προσείσομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1421.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1421.1.text#ἐγὼ μὲν οὖν αὐτῷ διαλλαχθήσομαι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1422.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1422.1.text#ἑκών· ὁμολογῶ γὰρ πατάξαι καὶ βαλεῖν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1423.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1423.1.text#ἀλλ' ἐλθὲ δευρί· πότερον ἐπιτρέπεις ἐμοί,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1424.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1424.1.text#ὅ τι χρή μ' ἀποτείσαντ' ἀργύριον τοῦ πράγματος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1425.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1425.1.text#εἶναι φίλον τὸ λοιπόν, ἢ σύ μοι φράσεις;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1426.1.speaker#Κατήγορος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1426.1.text#σὺ λέγε. δικῶν γὰρ οὐ δέομ' οὐδὲ πραγμάτων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1427.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1427.1.text#ἀνὴρ Συβαρίτης ἐξέπεσεν ἐξ ἅρματος,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1428.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1428.1.text#καί πως κατεάγη τῆς κεφαλῆς μέγα σφόδρα·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1429.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1429.1.text#ἐτύγχανεν γὰρ οὐ τρίβων ὢν ἱππικῆς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1430.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1430.1.text#κἄπειτ' ἐπιστὰς εἶπ' ἀνὴρ αὐτῷ φίλος·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1431.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1431.1.text#"ἔρδοι τις ἣν ἕκαστος εἰδείη τέχνην." 
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1432.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1432.1.text#οὕτω δὲ καὶ σὺ παράτρεχ' ἐς τὰ Πιττάλου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1433.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1433.1.text#οὕμοιά σου καὶ ταῦτα τοῖς ἄλλοις τρόποις.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1434.1.speaker#Κατήγορος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1434.1.text#ἀλλ' οὖν σὺ μέμνησ' αὐτὸς ἁπεκρίνατο.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1435.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1435.1.text#ἄκουε, μὴ φεῦγ'. ἐν Συβάρει γυνή ποτε
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1436.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1436.1.textκατέαξ' ἐχῖνον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1436.2.speaker#Κατήγορος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1436.2.text#ταῦτ' ἐγὼ μαρτύρομαι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1437.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1437.1.text#οὑχῖνος οὖν ἔχων τιν' ἐπεμαρτύρατο·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1438.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1438.1.text#εἶθ' ἡ Συβαρῖτις εἶπεν, "εἰ ναὶ τὰν κόραν"
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1439.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1439.1.text#"τὴν μαρτυρίαν ταύτην ἐάσας ἐν τάχει"
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1440.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1440.1.text#"ἐπίδεσμον ἐπρίω, νοῦν ἂν εἶχες πλείονα."
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1441.1.speaker#Κατήγορος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1441.1.text#ὕβριζ' ἕως ἂν τὴν δίκην ἅρχων καλῇ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1442.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1442.1.text#οὔτοι μὰ τὴν Δήμητρ' ἔτ' ἐνταυθοῖ μενεῖς,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1443.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1443.1.textἀλλ' ἀράμενος οἴσω σε —
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1443.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1443.2.text#τί ποιεῖς;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1443.3.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1443.3.text#ὅ τι ποιῶ;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1444.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1444.1.text#εἴσω φέρω σ' ἐντεῦθεν· εἰ δὲ μή, τάχα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1445.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1445.1.text#κλητῆρες ἐπιλείψουσι τοὺς καλουμένους.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1446.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1446.1.textΑἴσωπον οἱ Δελφοί ποτ' —
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1446.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1446.2.text#ὀλίγον μοι μέλει.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1447.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1447.1.text#φιάλην ἐπῃτιῶντο κλέψαι τοῦ θεοῦ·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1448.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1448.1.text#ὁ δ' ἔλεξεν αὐτοῖς, ὡς ὁ κάνθαρός ποτε —
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1449.1.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1449.1.text#οἴμ' ὡς ἀπολῶ σ' αὐτοῖσι τοῖσι κανθάροις.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1450.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1450.1.text#ζηλῶ γε τῆς εὐτυχίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1451.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1451.1.text#τὸν πρέσβυν οἷ μετέστη
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1452.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1452.1.text#ξηρῶν τρόπων καὶ βιοτῆς·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1453.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1453.1.text#ἕτερα δὲ νῦν ἀντιμαθὼν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1454.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1454.1.text#ἦ μέγα τι μεταπεσεῖται
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1455.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1455.1.text#ἐπὶ τὸ τρυφῶν καὶ μαλακόν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1456.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1456.1.text#τάχα δ' ἂν ἴσως οὐκ ἐθέλοι.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1457.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1457.1.text#τὸ γὰρ ἀποστῆναι χαλεπὸν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1458.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1458.1.text#φύσεος, ἣν ἔχοι τις ἀεί.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1459.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1459.1.text#καίτοι πολλοὶ ταῦτ' ἔπαθον·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1460.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1460.1.text#ξυνόντες γνώμαις ἑτέρων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1461.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1461.1.text#μετεβάλοντο τοὺς τρόπους.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1462.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1462.1.text#πολλοῦ δ' ἐπαίνου παρ' ἐμοὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1463.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1463.1.text#καὶ τοῖσιν εὖ φρονοῦσιν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1464.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1464.1.text#τυχὼν ἄπεισιν διὰ τὴν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1465.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1465.1.text#φιλοπατρίαν καὶ σοφίαν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1466.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1466.1.text#ὁ παῖς ὁ Φιλοκλέωνος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1467.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1467.1.text#οὐδενὶ γὰρ οὕτως ἀγανῷ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1468.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1468.1.text#ξυνεγενόμην, οὐδὲ τρόποις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1469.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1469.1.text#ἐπεμάνην οὐδ' ἐξεχύθην.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1470.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1470.1.text#τί γὰρ ἐκεῖνος ἀντιλέγων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1471.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1471.1.text#οὐ κρείττων ἦν, βουλόμενος
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1472.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1472.1.text#τὸν φύσαντα σεμνοτέροις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1473.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1473.1.text#κατακοσμῆσαι πράγμασιν;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1474.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1474.1.text#νὴ τὸν Διόνυσον ἄπορά γ' ἡμῖν πράγματα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1475.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1475.1.text#δαίμων τις ἐσκεκύκληκεν ἐς τὴν οἰκίαν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1476.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1476.1.text#ὁ γὰρ γέρων ὡς ἔπιε διὰ πολλοῦ χρόνου
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1477.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1477.1.text#ἤκουσέ τ' αὐλοῦ, περιχαρὴς τῷ πράγματι
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1478.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1478.1.text#ὀρχούμενος τῆς νυκτὸς οὐδὲν παύεται
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1479.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1479.1.text#τἀρχαἶ ἐκεῖν' οἷς Θέσπις ἠγωνίζετο·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1480.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1480.1.text#καὶ τοὺς τραγῳδούς φησιν ἀποδείξειν κρόνους
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1481.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1481.1.text#τοὺς νῦν διορχησάμενος ὀλίγον ὕστερον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1482.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1482.1.text#τίς ἐπ' αὐλείοισι θύραις θάσσει;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1483.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1483.1.text#τουτὶ καὶ δὴ χωρεῖ τὸ κακόν.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1484.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1484.1.text#κλῇθρα χαλάσθω τάδε. καὶ δὴ γὰρ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1485.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1485.1.text#σχήματος ἀρχὴ —
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1486.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1486.1.text#μᾶλλον δέ γ' ἴσως μανίας ἀρχή.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1487.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1487.1.text#πλευρὰν λυγίσαντος ὑπὸ ῥώμης·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1488.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1488.1.text#οἶον μυκτὴρ μυκᾶται καὶ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1489.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1489.1.textσφόνδυλος ἀχεῖ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1489.2.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1489.2.text#πῖθ' ἑλλέβορον.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1490.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1490.1.text#πτήσσει Φρύνιχος ὥς τις ἀλέκτωρ—
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1491.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1491.1.text#τάχα βαλλήσεις.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1492.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1492.1.text#σκέλος οὐράνιόν γ' ἐκλακτίζων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1493.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1493.1.textπρωκτὸς χάσκει.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1493.2.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1493.2.text#κατὰ σαυτὸν ὅρα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1494.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1494.1.text#νῦν γὰρ ἐν ἄρθροις τοῖς ἡμετέροις
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1495.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1495.1.text#στρέφεται χαλαρὰ κοτυληδών.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1496.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1496.1.textοὐκ εὖ;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1496.2.speaker#Βδελυκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1496.2.text#μὰ Δί' οὐ δῆτ', ἀλλὰ μανικὰ πράγματα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1497.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1497.1.text#θέρε νυν ἀνείπω κἀνταγωνιστὰς καλῶ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1498.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1498.1.text#εἴ τις τραγῳδός φησιν ὀρχεῖσθαι καλῶς,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1499.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1499.1.text#ἐμοὶ διορχησόμενος ἐνθάδ' εἰσίτω.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1500.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1500.1.textφησίν τις ἢ οὐδείς;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1500.2.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1500.2.text#εἶς γ' ἐκεινοσὶ μόνος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1501.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1501.1.textτίς ὁ κακοδαίμων ἐστίν;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1501.2.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1501.2.text#υἱὸς Καρκίνου
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1502.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1502.1.textὁ μέσατος.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1502.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1502.2.text#ἀλλ' οὗτός γε καταποθήσεται·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1503.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1503.1.text#ἀπολῶ γὰρ αὐτὸν ἐμμελείᾳ κονδύλου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1504.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1504.1.textἐν τῷ ῥυθμῷ γὰρ οὐδέν ἐστ'.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1504.2.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1504.2.text#ἀλλ' ᾠζυρὲ
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1505.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1505.1.text#ἕτερος τραγῳδὸς Καρκινίτης ἔρχεται,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1506.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1506.1.textἀδελφὸς αὐτοῦ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1506.2.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1506.2.text#νὴ Δί' ὠψώνηκ' ἄρα.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1507.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1507.1.text#μὰ τὸν Δί' οὐδέν γ' ἄλλο πλήν γε καρκίνους·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1508.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1508.1.text#προσέρχεται γὰρ ἕτερος αὖ τῶν Καρκίνου.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1509.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1509.1.text#τουτὶ τί ἦν τὸ προσέρπον; ὀξὶς ἢ φάλαγξ;
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1510.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1510.1.text#ὁ πινοτήρης οὗτός ἐστι τοῦ γένους,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1511.1.speaker#Ξανθίας
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1511.1.text#ὁ σμικρότατος, ὃς τὴν τραγῳδίαν ποιεῖ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1512.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1512.1.text#ὦ Καρκίν' ὦ μακάριε τῆς εὐπαιδίας,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1513.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1513.1.text#ὅσον τὸ πλῆθος κατέπεσεν τῶν ὀρχίλων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1514.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1514.1.text#ἀτὰρ καταβατέον γ' ἐπ' αὐτούς μ'· ᾠζυρέ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1515.1.speaker#Φιλοκλέων
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1515.1.text#ἅλμην κύκα τούτοισιν, ἢν ἐγὼ κρατῶ.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1516.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1516.1.text#φέρε νυν ἡμεῖς αὐτοῖς ὀλίγον ξυγχωρήσωμεν ἅπαντες,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1517.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1517.1.text#ἵν' ἐφ' ἡσυχίας ἡμῶν πρόσθεν βεμβικίζωσιν ἑαυτούς.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1518.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1518.1.text#ἄγ' ὦ μεγαλώνυμα τέκνα
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1519.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1519.1.text#τοῦ θαλασσίου θεοῦ,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1520.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1520.1.text#πηδᾶτε παρὰ ψάμαθον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1521.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1521.1.text#καὶ θῖν' ἁλὸς ἀτρυγέτου,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1522.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1522.1.text#καρίδων ἀδελφοί·
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1523.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1523.1.text#ταχὺν πόδα κυκλοσοβεῖτε,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1524.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1524.1.text#καὶ τὸ Φρυνίχειον
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1525.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1525.1.text#ἐκλακτισάτω τις, ὅπως
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1526.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1526.1.text#ἰδόντες ἄνω σκέλος ὤζωσιν
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1527.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1527.1.text#οἱ θεαταί.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1528.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1528.1.text#στρόβει, παράβαινε κύκλῳ καὶ γάστρισον σεαυτόν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1530.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1530.1.text#ῥῖπτε σκέλος οὐράνιον· βέμβικες ἐγγενέσθων.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1531.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1531.1.text#καὐτὸς γὰρ ὁ ποντομέδων ἄναξ πατὴρ προσέρπει
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1532.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1532.1.text#ἡσθεὶς ἐπὶ τοῖσιν ἑαυτοῦ παισὶ τοῖς τριόρχοις.
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1535.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1535.1.text#ἀλλ' ἐξάγετ', εἴ τι φιλεῖτ' ὀρχούμενοι, θύραζε
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1536.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1536.1.text#ἡμᾶς ταχύ· τοῦτο γὰρ οὐδείς πω πάρος δέδρακεν,
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1537.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg004.fu.sp:1537.1.text#ὀρχούμενον ὅστις ἀπήλλαξεν χορὸν τρυγῳδῶν.
