#!ctsdata
urn:cts:greekLit:tlg0019.tlg011.fucex:1.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1.1.text#ὡς ἀργαλέον πρᾶγμ' ἐστὶν ὦ Ζεῦ καὶ θεοὶ
urn:cts:greekLit:tlg0019.tlg011.fucex:2.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:2.1.text#δοῦλον γενέσθαι παραφρονοῦντος δεσπότου.
urn:cts:greekLit:tlg0019.tlg011.fucex:3.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:3.1.text#ἢν γὰρ τὰ βέλτισθ' ὁ θεράπων λέξας τύχῃ,
urn:cts:greekLit:tlg0019.tlg011.fucex:4.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:4.1.text#δόξῃ δὲ μὴ δρᾶν ταῦτα τῷ κεκτημένῳ,
urn:cts:greekLit:tlg0019.tlg011.fucex:5.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:5.1.text#μετέχειν ἀνάγκη τὸν θεράποντα τῶν κακῶν.
urn:cts:greekLit:tlg0019.tlg011.fucex:6.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:6.1.text#τοῦ σώματος γὰρ οὐκ ἐᾷ τὸν κύριον
urn:cts:greekLit:tlg0019.tlg011.fucex:7.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:7.1.text#κρατεῖν ὁ δαίμων, ἀλλὰ τὸν ἐωνημένον.
urn:cts:greekLit:tlg0019.tlg011.fucex:8.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:8.1.text#καὶ ταῦτα μὲν δὴ ταῦτα. τῷ δὲ Λοξίᾳ,
urn:cts:greekLit:tlg0019.tlg011.fucex:9.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:9.1.text#ὃς θεσπιῳδεῖ τρίποδος ἐκ χρυσηλάτου,
urn:cts:greekLit:tlg0019.tlg011.fucex:10.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:10.1.text#μέμψιν δικαίαν μέμφομαι ταύτην, ὅτι
urn:cts:greekLit:tlg0019.tlg011.fucex:11.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:11.1.text#ἰατρὸς ὢν καὶ μάντις, ὥς φασιν, σοφὸς
urn:cts:greekLit:tlg0019.tlg011.fucex:12.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:12.1.text#μελαγχολῶντ' ἀπέπεμψέ μου τὸν δεσπότην,
urn:cts:greekLit:tlg0019.tlg011.fucex:13.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:13.1.text#ὅστις ἀκολουθεῖ κατόπιν ἀνθρώπου τυφλοῦ,
urn:cts:greekLit:tlg0019.tlg011.fucex:14.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:14.1.text#τοὐναντίον δρῶν ἢ προσῆκ' αὐτῷ ποιεῖν.
urn:cts:greekLit:tlg0019.tlg011.fucex:15.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:15.1.text#οἱ γὰρ βλέποντες τοῖς τυφλοῖς ἡγούμεθα,
urn:cts:greekLit:tlg0019.tlg011.fucex:16.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:16.1.text#οὗτος δ' ἀκολουθεῖ, κἀμὲ προσβιάζεται,
urn:cts:greekLit:tlg0019.tlg011.fucex:17.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:17.1.text#καὶ ταῦτ' ἀποκρινομένῳ τὸ παράπαν οὐδὲ γρῦ.
urn:cts:greekLit:tlg0019.tlg011.fucex:18.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:18.1.text#ἐγὼ μὲν οὖν οὐκ ἔσθ' ὅπως σιγήσομαι,
urn:cts:greekLit:tlg0019.tlg011.fucex:19.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:19.1.text#ἢν μὴ φράσῃς ὅ τι τῷδ' ἀκολουθοῦμέν ποτε
urn:cts:greekLit:tlg0019.tlg011.fucex:20.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:20.1.text#ὦ δέσποτ', ἀλλά σοι παρέξω πράγματα.
urn:cts:greekLit:tlg0019.tlg011.fucex:21.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:21.1.text#οὐ γάρ με τυπτήσεις στέφανον ἔχοντά γε.
urn:cts:greekLit:tlg0019.tlg011.fucex:22.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:22.1.text#μὰ Δί' ἀλλ' ἀφελὼν τὸν στέφανον, ἢν λυπῇς τί με,
urn:cts:greekLit:tlg0019.tlg011.fucex:23.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:23.1.text#ἵνα μᾶλλον ἀλγῇς.
urn:cts:greekLit:tlg0019.tlg011.fucex:23.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:23.2.text#λῆρος· οὐ γὰρ παύσομαι
urn:cts:greekLit:tlg0019.tlg011.fucex:24.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:24.1.text#πρὶν ἂν φράσῃς μοι τίς ποτ' ἐστὶν οὑτοσί·
urn:cts:greekLit:tlg0019.tlg011.fucex:25.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:25.1.text#εὔνους γὰρ ὤν σοι πυνθάνομαι πάνυ σφόδρα.
urn:cts:greekLit:tlg0019.tlg011.fucex:26.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:26.1.text#ἀλλ' οὔ σε κρύψω· τῶν ἐμῶν γὰρ οἰκετῶν
urn:cts:greekLit:tlg0019.tlg011.fucex:27.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:27.1.text#πιστότατον ἡγοῦμαί σε καὶ κλεπτίστατον.
urn:cts:greekLit:tlg0019.tlg011.fucex:28.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:28.1.text#ἐγὼ θεοσεβὴς καὶ δίκαιος ὢν ἀνὴρ
urn:cts:greekLit:tlg0019.tlg011.fucex:29.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:29.1.text#κακῶς ἔπραττον καὶ πένης ἦν·
urn:cts:greekLit:tlg0019.tlg011.fucex:29.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:29.2.text#οἶδά τοι.
urn:cts:greekLit:tlg0019.tlg011.fucex:30.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:30.1.text#ἕτεροι δ' ἐπλούτουν ἱερόσυλοι ῥήτορες
urn:cts:greekLit:tlg0019.tlg011.fucex:31.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:31.1.text#καὶ συκοφάνται καὶ πονηροί·
urn:cts:greekLit:tlg0019.tlg011.fucex:31.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:31.2.text#πείθομαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:32.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:32.1.text#ἐπερησόμενος οὖν ᾠχόμην ὡς τὸν θεόν,
urn:cts:greekLit:tlg0019.tlg011.fucex:33.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:33.1.text#τὸν ἐμὸν μὲν αὐτοῦ τοῦ ταλαιπώρου σχεδὸν
urn:cts:greekLit:tlg0019.tlg011.fucex:34.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:34.1.text#ἤδη νομίζων ἐκτετοξεῦσθαι βίον,
urn:cts:greekLit:tlg0019.tlg011.fucex:35.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:35.1.text#τὸν δ' υἱόν, ὅσπερ ὢν μόνος μοι τυγχάνει,
urn:cts:greekLit:tlg0019.tlg011.fucex:36.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:36.1.text#πευσόμενος εἰ χρὴ μεταβαλόντα τοὺς τρόπους
urn:cts:greekLit:tlg0019.tlg011.fucex:37.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:37.1.text#εἶναι πανοῦργον, ἄδικον, ὑγιὲς μηδὲ ἕν,
urn:cts:greekLit:tlg0019.tlg011.fucex:38.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:38.1.text#ὡς τῷ βίῳ τοῦτ' αὐτὸ νομίσας συμφέρειν.
urn:cts:greekLit:tlg0019.tlg011.fucex:39.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:39.1.text#τί δῆτα Φοῖβος ἔλακεν ἐκ τῶν στεμμάτων;
urn:cts:greekLit:tlg0019.tlg011.fucex:40.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:40.1.text#πεύσει. σαφῶς γὰρ ὁ θεὸς εἶπέ μοι τοδί·
urn:cts:greekLit:tlg0019.tlg011.fucex:41.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:41.1.text#ὅτῳ ξυναντήσαιμι πρῶτον ἐξιών,
urn:cts:greekLit:tlg0019.tlg011.fucex:42.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:42.1.text#ἐκέλευε τούτου μὴ μεθίεσθαί μ' ἔτι,
urn:cts:greekLit:tlg0019.tlg011.fucex:43.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:43.1.text#πείθειν δ' ἐμαυτῷ ξυνακολουθεῖν οἴκαδε.
urn:cts:greekLit:tlg0019.tlg011.fucex:44.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:44.1.text#καὶ τῷ ξυναντᾷς δῆτα πρώτῳ;
urn:cts:greekLit:tlg0019.tlg011.fucex:44.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:44.2.text#τουτῳί.
urn:cts:greekLit:tlg0019.tlg011.fucex:45.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:45.1.text#εἶτ' οὐ ξυνίης τὴν ἐπίνοιαν τοῦ θεοῦ
urn:cts:greekLit:tlg0019.tlg011.fucex:46.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:46.1.text#φράζουσαν ὦ σκαιότατέ σοι σαφέστατα
urn:cts:greekLit:tlg0019.tlg011.fucex:47.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:47.1.text#ἀσκεῖν τὸν υἱὸν τὸν ἐπιχώριον τρόπον;
urn:cts:greekLit:tlg0019.tlg011.fucex:48.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:48.1.text#τῷ τοῦτο κρίνεις;
urn:cts:greekLit:tlg0019.tlg011.fucex:48.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:48.2.text#δῆλον ὁτιὴ καὶ τυφλῷ
urn:cts:greekLit:tlg0019.tlg011.fucex:49.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:49.1.text#γνῶναι δοκεῖ τοῦθ', ὡς σφόδρ' ἐστὶ συμφέρον
urn:cts:greekLit:tlg0019.tlg011.fucex:50.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:50.1.text#τὸ μηδὲν ἀσκεῖν ὑγιὲς ἐν τῷ νῦν χρόνῳ.
urn:cts:greekLit:tlg0019.tlg011.fucex:51.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:51.1.text#οὐκ ἔσθ' ὅπως ὁ χρησμὸς ἐς τοῦτο ῥέπει,
urn:cts:greekLit:tlg0019.tlg011.fucex:52.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:52.1.text#ἀλλ' εἰς ἕτερόν τι μεῖζον. ἢν δ' ἡμῖν φράσῃ
urn:cts:greekLit:tlg0019.tlg011.fucex:53.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:53.1.text#ὅστις ποτ' ἐστὶν οὑτοσὶ καὶ τοῦ χάριν
urn:cts:greekLit:tlg0019.tlg011.fucex:54.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:54.1.text#καὶ τοῦ δεόμενος ἦλθε μετὰ νῷν ἐνθαδί,
urn:cts:greekLit:tlg0019.tlg011.fucex:55.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:55.1.text#πυθοιμεθ' ἂν τὸν χρησμὸν ἡμῶν ὅ τι νοεῖ.
urn:cts:greekLit:tlg0019.tlg011.fucex:56.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:56.1.text#ἄγε δὴ σὺ πότερον σαυτὸν ὅστις εἶ φράσεις,
urn:cts:greekLit:tlg0019.tlg011.fucex:57.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:57.1.text#ἢ τἀπὶ τούτοις δρῶ; λέγειν χρὴ ταχὺ πάνυ.
urn:cts:greekLit:tlg0019.tlg011.fucex:58.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:58.1.text#ἐγὼ μὲν οἰμώζειν λέγω σοι.
urn:cts:greekLit:tlg0019.tlg011.fucex:58.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:58.2.text#μαναθάνεις
urn:cts:greekLit:tlg0019.tlg011.fucex:59.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:59.1.text#ὅς φησιν εἶναι;
urn:cts:greekLit:tlg0019.tlg011.fucex:59.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:59.2.text#σοὶ λέγει τοῦτ', οὐκ ἐμοί·
urn:cts:greekLit:tlg0019.tlg011.fucex:60.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:60.1.text#σκαιῶς γὰρ αὐτοῦ καὶ χαλεπῶς ἐκπυνθάνει.
urn:cts:greekLit:tlg0019.tlg011.fucex:61.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:61.1.text#ἀλλ' εἴ τι χαίρεις ἀνδρὸς εὐόρκου τρόποις,
urn:cts:greekLit:tlg0019.tlg011.fucex:62.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:62.1.text#ἐμοὶ φράσον.
urn:cts:greekLit:tlg0019.tlg011.fucex:62.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:62.2.text#κλάειν ἔγωγέ σοι λέγω.
urn:cts:greekLit:tlg0019.tlg011.fucex:63.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:63.1.text#δέχου τὸν ἄνδρα καὶ τὸν ὄρνιν τοῦ θεοῦ.
urn:cts:greekLit:tlg0019.tlg011.fucex:64.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:64.1.text#οὔ τοι μὰ τὴν Δήμητρα χαιρήσεις ἔτι.
urn:cts:greekLit:tlg0019.tlg011.fucex:65.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:65.1.text#εἰ μὴ φράσεις γάρ—
urn:cts:greekLit:tlg0019.tlg011.fucex:65.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:65.2.text#ἀπό σ' ὀλῶ κακὸν κακῶς.
urn:cts:greekLit:tlg0019.tlg011.fucex:66.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:66.1.text#ὦ τᾶν—
urn:cts:greekLit:tlg0019.tlg011.fucex:66.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:66.2.text#ἀπαλλάχθητον ἀπ' ἐμοῦ.
urn:cts:greekLit:tlg0019.tlg011.fucex:66.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:66.3.text#πώμαλα.
urn:cts:greekLit:tlg0019.tlg011.fucex:67.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:67.1.text#καὶ μὴν ὃ λέγω βέλτιστόν ἐστ' ὦ δέσποτα.
urn:cts:greekLit:tlg0019.tlg011.fucex:68.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:68.1.text#ἀπολῶ τὸν ἄνθρωπον κάκιστα τουτονί.
urn:cts:greekLit:tlg0019.tlg011.fucex:69.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:69.1.text#ἀναθεὶς γὰρ ἐπὶ κρημνόν τιν' αὐτὸν καταλιπων
urn:cts:greekLit:tlg0019.tlg011.fucex:70.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:70.1.text#ἄπειμ', ἵν' ἐκεῖθεν ἐκτραχηλισθῇ πεσών.
urn:cts:greekLit:tlg0019.tlg011.fucex:71.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:71.1.text#ἀλλ' αἶρε ταχέως.
urn:cts:greekLit:tlg0019.tlg011.fucex:71.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:71.2.text#μηδαμῶς.
urn:cts:greekLit:tlg0019.tlg011.fucex:71.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:71.3.text#οὔκουν ἐρεῖς;
urn:cts:greekLit:tlg0019.tlg011.fucex:72.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:72.1.text#ἀλλ' ἢν πύθησθέ μ' ὅστις εἴμ', εὖ οἶδ' ὅτι
urn:cts:greekLit:tlg0019.tlg011.fucex:73.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:73.1.text#κακόν τί μ' ἐργάσεσθε κοὐκ ἀφήσετον.
urn:cts:greekLit:tlg0019.tlg011.fucex:74.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:74.1.text#νὴ τοὺς θεοὺς ἡμεῖς γ', ἐὰν βούλῃ γε σύ.
urn:cts:greekLit:tlg0019.tlg011.fucex:75.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:75.1.text#μέθεσθε νῦν μου πρῶτον.
urn:cts:greekLit:tlg0019.tlg011.fucex:75.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:75.2.text#ἤν, μεθίεμεν.
urn:cts:greekLit:tlg0019.tlg011.fucex:76.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:76.1.text#ἀκούετον δή· δεῖ γὰρ ὡς ἔοικέ με
urn:cts:greekLit:tlg0019.tlg011.fucex:77.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:77.1.text#λέγειν ἃ κρύπτειν ἦν παρεσκευασμένος.
urn:cts:greekLit:tlg0019.tlg011.fucex:78.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:78.1.text#ἐγὼ γάρ εἰμι Πλοῦτος.
urn:cts:greekLit:tlg0019.tlg011.fucex:78.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:78.2.text#ὦ μιαρώτατε
urn:cts:greekLit:tlg0019.tlg011.fucex:79.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:79.1.text#ἀνδρῶν ἁπάντων, εἶτ' ἐσίγας Πλοῦτος ὤν;
urn:cts:greekLit:tlg0019.tlg011.fucex:80.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:80.1.text#σὺ Πλοῦτος, οὕτως ἀθλίως διακείμενος;
urn:cts:greekLit:tlg0019.tlg011.fucex:81.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:81.1.text#ὦ Φοῖβ' Ἄπολλον καὶ θεοὶ καὶ δαίμονες
urn:cts:greekLit:tlg0019.tlg011.fucex:82.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:82.1.text#καὶ Ζεῦ, τί φῄς; ἐκεῖνος ὄντως εἶ σύ;
urn:cts:greekLit:tlg0019.tlg011.fucex:82.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:82.2.text#ναί.
urn:cts:greekLit:tlg0019.tlg011.fucex:83.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:83.1.text#ἐκεῖνος αὐτός;
urn:cts:greekLit:tlg0019.tlg011.fucex:83.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:83.2.text#αὐτότατος.
urn:cts:greekLit:tlg0019.tlg011.fucex:83.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:83.3.text#πόθεν οὖν φράσον
urn:cts:greekLit:tlg0019.tlg011.fucex:84.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:84.1.text#αὐχμῶν βαδίζεις;
urn:cts:greekLit:tlg0019.tlg011.fucex:84.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:84.2.text#ἐκ Πατροκλέους ἔρχομαι,
urn:cts:greekLit:tlg0019.tlg011.fucex:85.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:85.1.text#ὃς οὐκ ἐλούσατ' ἐξ ὅτουπερ ἐγένετο.
urn:cts:greekLit:tlg0019.tlg011.fucex:86.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:86.1.text#τουτὶ δὲ τὸ κακὸν πῶς ἔπαθες; κάτειπέ μοι.
urn:cts:greekLit:tlg0019.tlg011.fucex:87.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:87.1.text#ὁ Ζεύς με ταῦτ' ἔδρασεν ἀνθρώποις φθονῶν.
urn:cts:greekLit:tlg0019.tlg011.fucex:88.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:88.1.text#ἐγὼ γὰρ ὢν μειράκιον ἠπείλησ' ὅτι
urn:cts:greekLit:tlg0019.tlg011.fucex:89.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:89.1.text#ὡς τοὺς δικαίους καὶ σοφοὺς καὶ κοσμίους
urn:cts:greekLit:tlg0019.tlg011.fucex:90.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:90.1.text#μόνους βαδιοίμην· ὁ δέ μ' ἐποίησεν τυφλόν,
urn:cts:greekLit:tlg0019.tlg011.fucex:91.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:91.1.text#ἵνα μὴ διαγιγνώσκοιμι τούτων μηδένα.
urn:cts:greekLit:tlg0019.tlg011.fucex:92.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:92.1.text#οὕτως ἐκεῖνος τοῖσι χρηστοῖσι φθονεῖ.
urn:cts:greekLit:tlg0019.tlg011.fucex:93.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:93.1.text#καὶ μὴν διὰ τοὺς χρηστούς γε τιμᾶται μόνους
urn:cts:greekLit:tlg0019.tlg011.fucex:94.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:94.1.text#καὶ τοὺς δικαίους.
urn:cts:greekLit:tlg0019.tlg011.fucex:94.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:94.2.text#ὁμολογῶ σοι.
urn:cts:greekLit:tlg0019.tlg011.fucex:94.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:94.3.text#φέρε τί οὖν;
urn:cts:greekLit:tlg0019.tlg011.fucex:95.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:95.1.text#εἰ πάλιν ἀναβλέψειας ὥσπερ καὶ πρὸ τοῦ,
urn:cts:greekLit:tlg0019.tlg011.fucex:96.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:96.1.text#φεύγοις ἂν ἤδη τοὺς πονηρούς;
urn:cts:greekLit:tlg0019.tlg011.fucex:96.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:96.2.text#φήμ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg011.fucex:97.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:97.1.text#ὡς τοὺς δικαίους δ' ἂν βαδίζοις;
urn:cts:greekLit:tlg0019.tlg011.fucex:97.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:97.2.text#πάνυ μὲν οὖν·
urn:cts:greekLit:tlg0019.tlg011.fucex:98.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:98.1.text#πολλοῦ γὰρ αὐτοὺς οὐχ ἑόρακά πω χρόνου.
urn:cts:greekLit:tlg0019.tlg011.fucex:99.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:99.1.text#καὶ θαῦμά γ' οὐδέν· οὐδ' ἐγὼ γὰρ ὁ βλέπων.
urn:cts:greekLit:tlg0019.tlg011.fucex:100.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:100.1.text#ἄφετόν με νῦν. ἴστον γὰρ ἤδη τἀπ' ἐμοῦ.
urn:cts:greekLit:tlg0019.tlg011.fucex:101.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:101.1.text#μὰ Δί' ἀλλὰ πολλῷ μᾶλλον ἑξόμεσθά σου.
urn:cts:greekLit:tlg0019.tlg011.fucex:102.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:102.1.text#οὐκ ἠγόρευον ὅτι παρέξειν πράγματα
urn:cts:greekLit:tlg0019.tlg011.fucex:103.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:103.1.text#ἐμέλλετόν μοι;
urn:cts:greekLit:tlg0019.tlg011.fucex:103.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:103.2.text#καὶ σύ γ' ἀντιβολῶ πιθοῦ,
urn:cts:greekLit:tlg0019.tlg011.fucex:104.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:104.1.text#καὶ μή μ' ἀπολίπῃς· οὐ γὰρ εὑρήσεις ἐμοῦ
urn:cts:greekLit:tlg0019.tlg011.fucex:105.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:105.1.text#ζητῶν ἔτ' ἄνδρα τοὺς τρόπους βελτίονα.
urn:cts:greekLit:tlg0019.tlg011.fucex:106.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:106.1.text#μὰ τὸν Δί' οὐ γὰρ ἔστιν ἄλλος πλὴν ἐγώ.
urn:cts:greekLit:tlg0019.tlg011.fucex:107.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:107.1.text#ταυτὶ λέγουσι πάντες· ἡνίκ' ἂν δέ μου
urn:cts:greekLit:tlg0019.tlg011.fucex:108.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:108.1.text#τύχωσ' ἀληθῶς καὶ γένωνται πλούσιοι,
urn:cts:greekLit:tlg0019.tlg011.fucex:109.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:109.1.text#ἀτεχνῶς ὑπερβάλλουσι τῇ μοχθηρίᾳ.
urn:cts:greekLit:tlg0019.tlg011.fucex:110.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:110.1.text#ἔχει μὲν οὕτως, εἰσὶ δ' οὐ πάντες κακοί.
urn:cts:greekLit:tlg0019.tlg011.fucex:111.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:111.1.text#μὰ Δί' ἀλλ' ἁπαξάπαντες.
urn:cts:greekLit:tlg0019.tlg011.fucex:111.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:111.2.text#οἰμώξει μακρά.
urn:cts:greekLit:tlg0019.tlg011.fucex:112.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:112.1.text#σοὶ δ' ὡς ἂν εἰδῇς ὅσα παρ' ἡμῖν ἢν μένῃς
urn:cts:greekLit:tlg0019.tlg011.fucex:113.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:113.1.text#γενήσετ' ἀγαθά, πρόσεχε τὸν νοῦν ἵνα πύθῃ.
urn:cts:greekLit:tlg0019.tlg011.fucex:114.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:114.1.text#οἶμαι γὰρ οἶμαι, σὺν θεῷ δ' εἰρήσεται,
urn:cts:greekLit:tlg0019.tlg011.fucex:115.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:115.1.text#ταύτης ἀπαλλάξειν σε τῆς ὀφθαλμίας
urn:cts:greekLit:tlg0019.tlg011.fucex:116.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:116.1.text#βλέψαι ποιήσας.
urn:cts:greekLit:tlg0019.tlg011.fucex:116.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:116.2.text#μηδαμῶς τοῦτ' ἐργάσῃ.
urn:cts:greekLit:tlg0019.tlg011.fucex:117.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:117.1.text#οὐ βούλομαι γὰρ πάλιν ἀναβλέψαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:117.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:117.2.text#τί φῄς;
urn:cts:greekLit:tlg0019.tlg011.fucex:118.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:118.1.text#ἅνθρωπος οὗτός ἐστιν ἄθλιος φύσει.
urn:cts:greekLit:tlg0019.tlg011.fucex:119.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:119.1.text#ὁ Ζεὺς † μὲν οὖν εἰδὼς τὰ τούτων μῶρ' ἔμ' εἰ†
urn:cts:greekLit:tlg0019.tlg011.fucex:120.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:120.1.text#πύθοιτ' ἂν ἐπιτρίψειε.
urn:cts:greekLit:tlg0019.tlg011.fucex:120.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:120.2.text#νῦν δ' οὐ τοῦτο δρᾷ,
urn:cts:greekLit:tlg0019.tlg011.fucex:121.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:121.1.text#ὅστις σε προσπταίοντα περινοστεῖν ἐᾷ;
urn:cts:greekLit:tlg0019.tlg011.fucex:122.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:122.1.text#οὐκ οἶδ'· ἐγὼ δ' ἐκεῖνον ὀρρωδῶ πάνυ.
urn:cts:greekLit:tlg0019.tlg011.fucex:123.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:123.1.text#ἄληθες ὦ δειλότατε πάντων δαιμόνων;
urn:cts:greekLit:tlg0019.tlg011.fucex:124.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:124.1.text#οἴει γὰρ εἶναι τὴν Διὸς τυραννίδα
urn:cts:greekLit:tlg0019.tlg011.fucex:125.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:125.1.text#καὶ τοὺς κεραυνοὺς ἀξίους τριωβόλου,
urn:cts:greekLit:tlg0019.tlg011.fucex:126.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:126.1.text#ἐὰν ἀναβλέψῃς σὺ κἂν σμικρὸν χρόνον;
urn:cts:greekLit:tlg0019.tlg011.fucex:127.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:127.1.text#ἆ μὴ λέγ' ὦ πόνηρε ταῦτ'.
urn:cts:greekLit:tlg0019.tlg011.fucex:127.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:127.2.text#ἔχ' ἥσυχος.
urn:cts:greekLit:tlg0019.tlg011.fucex:NaN.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:NaN.text#ἐγὼ γὰρ ἀποδείξω σε τοῦ Διὸς πολὺ
urn:cts:greekLit:tlg0019.tlg011.fucex:129.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:129.1.text#μεῖζον δυνάμενον.
urn:cts:greekLit:tlg0019.tlg011.fucex:129.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:129.2.text#ἐμὲ σύ;
urn:cts:greekLit:tlg0019.tlg011.fucex:129.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:129.3.text#νὴ τὸν οὐρανόν.
urn:cts:greekLit:tlg0019.tlg011.fucex:130.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:130.1.text#αὐτίκα γὰρ ἄρχει διὰ τίν' ὁ Ζεὺς τῶν θεῶν;
urn:cts:greekLit:tlg0019.tlg011.fucex:131.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:131.1.text#διὰ τἀργύριον· πλεῖστον γάρ ἐστ' αὐτῷ.
urn:cts:greekLit:tlg0019.tlg011.fucex:131.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:131.2.text#φέρε
urn:cts:greekLit:tlg0019.tlg011.fucex:132.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:132.1.text#τίς οὖν ὁ παρέχων ἐστὶν αὐτῷ τοῦθ';
urn:cts:greekLit:tlg0019.tlg011.fucex:132.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:132.2.text#ὁδί.
urn:cts:greekLit:tlg0019.tlg011.fucex:133.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:133.1.text#θύουσι δ' αὐτῷ διὰ τίν'; οὐ διὰ τουτονί;
urn:cts:greekLit:tlg0019.tlg011.fucex:134.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:134.1.text#καὶ νὴ Δί' εὔχονταί γε πλουτεῖν ἄντικρυς.
urn:cts:greekLit:tlg0019.tlg011.fucex:135.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:135.1.text#οὔκουν ὅδ' ἐστὶν αἴτιος καὶ ῥᾳδίως
urn:cts:greekLit:tlg0019.tlg011.fucex:136.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:136.1.text#παύσειεν, εἰ βούλοιτο, ταῦτ' ἄν;
urn:cts:greekLit:tlg0019.tlg011.fucex:136.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:136.2.text#ὅτι τί δή;
urn:cts:greekLit:tlg0019.tlg011.fucex:137.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:137.1.text#ὅτι οὐδ' ἂν εἷς θύσειεν ἀνθρώπων ἔτι,
urn:cts:greekLit:tlg0019.tlg011.fucex:138.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:138.1.text#οὐ βοῦν ἄν, οὐχὶ ψαιστόν, οὐκ ἄλλ' οὐδὲ ἕν,
urn:cts:greekLit:tlg0019.tlg011.fucex:139.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:139.1.text#μὴ βουλομένου σοῦ.
urn:cts:greekLit:tlg0019.tlg011.fucex:139.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:139.2.text#πῶς;
urn:cts:greekLit:tlg0019.tlg011.fucex:139.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:139.3.text#ὅπως; οὐκ ἔσθ' ὅπως
urn:cts:greekLit:tlg0019.tlg011.fucex:140.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:140.1.text#ὠνήσεται δήπουθεν, ἢν σὺ μὴ παρὼν
urn:cts:greekLit:tlg0019.tlg011.fucex:141.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:141.1.text#αὐτὸς διδῷς τἀργύριον· ὥστε τοῦ Διὸς
urn:cts:greekLit:tlg0019.tlg011.fucex:142.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:142.1.text#τὴν δύνομιν, ἢν λυπῇ τι, καταλύσεις μόνος.
urn:cts:greekLit:tlg0019.tlg011.fucex:143.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:143.1.text#τί λέγεις; δι' ἐμὲ θύουσιν αὐτῷ;
urn:cts:greekLit:tlg0019.tlg011.fucex:143.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:143.2.text#φήμ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg011.fucex:144.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:144.1.text#καὶ νὴ Δί' εἴ τί γ' ἔστι λαμπρὸν καὶ καλὸν
urn:cts:greekLit:tlg0019.tlg011.fucex:145.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:145.1.text#ἢ χαρίεν ἀνθρώποισι, διὰ σὲ γίγνεται.
urn:cts:greekLit:tlg0019.tlg011.fucex:146.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:146.1.text#ἅπαντα τῷ πλουτεῖν γάρ ἐσθ' ὑπήκοα.
urn:cts:greekLit:tlg0019.tlg011.fucex:147.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:147.1.text#ἔγωγέ τοι διὰ μικρὸν ἀργυρίδιον
urn:cts:greekLit:tlg0019.tlg011.fucex:148.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:148.1.text#δοῦλος γεγένημαι, διὰ τὸ μὴ πλουτεῖν ἴσως.
urn:cts:greekLit:tlg0019.tlg011.fucex:149.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:149.1.text#καὶ τάς γ' ἑταίρας φασὶ τὰς Κορινθίας,
urn:cts:greekLit:tlg0019.tlg011.fucex:150.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:150.1.text#ὅταν μὲν αὐτάς τις πένης πειρῶν τύχῃ,
urn:cts:greekLit:tlg0019.tlg011.fucex:151.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:151.1.text#οὐδὲ προσέχειν τὸν νοῦν, ἐὰν δὲ πλούσιος,
urn:cts:greekLit:tlg0019.tlg011.fucex:152.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:152.1.text#τὸν πρωκτὸν αὐτὰς εὐθὺς ὡς τοῦτον τρέπειν.
urn:cts:greekLit:tlg0019.tlg011.fucex:153.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:153.1.text#καὶ τούς γε παῖδάς φασι ταὐτὸ τοῦτο δρᾶν
urn:cts:greekLit:tlg0019.tlg011.fucex:154.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:154.1.text#οὐ τῶν ἐραστῶν ἀλλὰ τἀργυρίου χάριν.
urn:cts:greekLit:tlg0019.tlg011.fucex:155.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:155.1.text#οὐ τούς γε χρηστούς, ἀλλὰ τοὺς πόρνους· ἐπεὶ
urn:cts:greekLit:tlg0019.tlg011.fucex:156.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:156.1.text#αἰτοῦσιν οὐκ ἀργύριον οἱ χρηστοί.
urn:cts:greekLit:tlg0019.tlg011.fucex:156.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:156.2.text#τί δαί;
urn:cts:greekLit:tlg0019.tlg011.fucex:157.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:157.1.text#ὁ μὲν ἵππον ἀγαθόν, ὁ δὲ κύνας θηρευτικάς.
urn:cts:greekLit:tlg0019.tlg011.fucex:158.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:158.1.text#αἰσχυνόμενοι γὰρ ἀργύριον αἰτεῖν ἴσως
urn:cts:greekLit:tlg0019.tlg011.fucex:159.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:159.1.text#ὀνόματι περιπέττουσι τὴν μοχθηρίαν.
urn:cts:greekLit:tlg0019.tlg011.fucex:160.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:160.1.text#τέχναι δὲ πᾶσαι διὰ σὲ καὶ σοφίσματα
urn:cts:greekLit:tlg0019.tlg011.fucex:161.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:161.1.text#ἐν τοῖσιν ἀνθρώποισίν ἐσθ' ηὑρημένα.
urn:cts:greekLit:tlg0019.tlg011.fucex:162.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:162.1.text#ὁ μὲν γὰρ ἡμῶν σκυτοτομεῖ καθήμενος·
urn:cts:greekLit:tlg0019.tlg011.fucex:163.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:163.1.text#ἕτερος δὲ χαλκεύει τις, ὁ δὲ τεκταίνεται·
urn:cts:greekLit:tlg0019.tlg011.fucex:164.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:164.1.text#ὁ δὲ χρυσοχοεῖ γε χρυσίον παρὰ σοῦ λαβών·
urn:cts:greekLit:tlg0019.tlg011.fucex:165.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:165.1.text#ὁ δὲ λωποδυτεῖ γε νὴ Δί', ὁ δὲ τοιχωρυχεῖ·
urn:cts:greekLit:tlg0019.tlg011.fucex:166.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:166.1.text#ὁ δὲ γναφεύει γ'·
urn:cts:greekLit:tlg0019.tlg011.fucex:166.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:166.2.text#ὁ δέ γε πλύνει κῴδια·
urn:cts:greekLit:tlg0019.tlg011.fucex:167.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:167.1.text#ὁ δὲ βυρσοδεψεῖ γ'·
urn:cts:greekLit:tlg0019.tlg011.fucex:167.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:167.2.text#ὁ δέ γε πωλεῖ κρόμμυα·
urn:cts:greekLit:tlg0019.tlg011.fucex:168.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:168.1.text#ὁ δ' ἁλούς γε μοιχὸς διὰ σέ που παρατίλλεται.
urn:cts:greekLit:tlg0019.tlg011.fucex:169.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:169.1.text#οἴμοι τάλας ταυτί μ' ἐλάνθανεν πάλαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:170.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:170.1.text#μέγας δὲ βασιλεὺς οὐχὶ διὰ τοῦτον κομᾷ;
urn:cts:greekLit:tlg0019.tlg011.fucex:171.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:171.1.text#ἐκκλησία δ' οὐχὶ διὰ τοῦτον γίγνεται;
urn:cts:greekLit:tlg0019.tlg011.fucex:172.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:172.1.text#τί δέ; τὰς τριήρεις οὐ σὺ πληροῖς; εἰπέ μοι.
urn:cts:greekLit:tlg0019.tlg011.fucex:173.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:173.1.text#τὸ δ' ἐν Κορίνθῳ ξενικὸν οὐχ οὗτος τρέφει;
urn:cts:greekLit:tlg0019.tlg011.fucex:174.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:174.1.text#ὁ Πάμφιλος δ' οὐχι διὰ τοῦτον κλαύσεται;
urn:cts:greekLit:tlg0019.tlg011.fucex:175.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:175.1.text#ὁ βελονοπώλης δ' οὐχὶ μετὰ τοῦ Παμφίλου;
urn:cts:greekLit:tlg0019.tlg011.fucex:176.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:176.1.text#Ἀγύρριος δ' οὐχὶ διὰ τοῦτον πέρδεται;
urn:cts:greekLit:tlg0019.tlg011.fucex:177.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:177.1.text#Φιλέψιος δ' οὐχ ἕνεκα σοῦ μύθους λέγει;
urn:cts:greekLit:tlg0019.tlg011.fucex:178.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:178.1.text#ἡ ξυμμαχία δ' οὐ διὰ σὲ τοῖς Αἰγυπτίοις;
urn:cts:greekLit:tlg0019.tlg011.fucex:179.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:179.1.text#ἐρᾷ δὲ Λαῒς οὐ διὰ σὲ Φιλωνίδου;
urn:cts:greekLit:tlg0019.tlg011.fucex:180.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:180.1.text#ὁ Τιμοθέου δὲ πύργος—
urn:cts:greekLit:tlg0019.tlg011.fucex:180.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:180.2.text#ἐμπέσοι γέ σοι.
urn:cts:greekLit:tlg0019.tlg011.fucex:181.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:181.1.text#τὰ δὲ πράγματ' οὐχὶ διὰ σὲ πάντα πράττεται;
urn:cts:greekLit:tlg0019.tlg011.fucex:182.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:182.1.text#μονώτατος γὰρ εἶ σὺ πάντων αἴτιος
urn:cts:greekLit:tlg0019.tlg011.fucex:183.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:183.1.text#καὶ τῶν κακῶν καὶ τῶν ἀγαθῶν, εὖ ἴσθ' ὅτι.
urn:cts:greekLit:tlg0019.tlg011.fucex:184.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:184.1.text#κρατοῦσι γοῦν κἀν τοῖς πολέμοις ἑκάστοτε,
urn:cts:greekLit:tlg0019.tlg011.fucex:185.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:185.1.text#ἐφ' οἷς οὗτος ἐπικαθέζηται μόνον.
urn:cts:greekLit:tlg0019.tlg011.fucex:186.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:186.1.text#ἐγὼ τοσαῦτα δυνατός εἰμ' εἷς ὢν ποιεῖν;
urn:cts:greekLit:tlg0019.tlg011.fucex:187.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:187.1.text#καὶ ναὶ μὰ Δία τούτων γε πολλῷ πλείονα·
urn:cts:greekLit:tlg0019.tlg011.fucex:188.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:188.1.text#ὥστ' οὐδὲ μεστὸς σοῦ γέγον' οὐδεὶς πώποτε.
urn:cts:greekLit:tlg0019.tlg011.fucex:189.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:189.1.text#τῶν μὲν γὰρ ἄλλων ἐστὶ πάντων πλησμονή,
urn:cts:greekLit:tlg0019.tlg011.fucex:190.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:190.1.text#ἔρωτος
urn:cts:greekLit:tlg0019.tlg011.fucex:190.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:190.2.text#ἄρτων
urn:cts:greekLit:tlg0019.tlg011.fucex:190.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:190.3.text#μουσικῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:190.4.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:190.4.text#τραγημάτων
urn:cts:greekLit:tlg0019.tlg011.fucex:191.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:191.1.text#τιμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:191.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:191.2.text#πλακούντων
urn:cts:greekLit:tlg0019.tlg011.fucex:191.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:191.3.text#ἀνδραγαθίας
urn:cts:greekLit:tlg0019.tlg011.fucex:191.4.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:191.4.text#ἰσχάδων
urn:cts:greekLit:tlg0019.tlg011.fucex:192.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:192.1.text#φιλοτιμίας
urn:cts:greekLit:tlg0019.tlg011.fucex:192.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:192.2.text#μάζης
urn:cts:greekLit:tlg0019.tlg011.fucex:192.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:192.3.text#στρατηγίας
urn:cts:greekLit:tlg0019.tlg011.fucex:192.4.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:192.4.text#φακῆς·
urn:cts:greekLit:tlg0019.tlg011.fucex:193.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:193.1.text#σοῦ δ' ἐγένετ' οὐδεὶς μεστὸς οὐδεπώποτε.
urn:cts:greekLit:tlg0019.tlg011.fucex:194.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:194.1.text#ἀλλ' ἢν τάλαντά τις λάβῃ τριακαίδεκα,
urn:cts:greekLit:tlg0019.tlg011.fucex:195.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:195.1.text#πολὺ μᾶλλον ἐπιθυμεῖ λαβεῖν ἑκκαίδεκα·
urn:cts:greekLit:tlg0019.tlg011.fucex:196.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:196.1.text#κἂν ταῦτ' ἀνύσηται, τετταράκοντα βούλεται,
urn:cts:greekLit:tlg0019.tlg011.fucex:197.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:197.1.text#ἤ φησιν εἶν ἀβίωτον αὑτῷ τὸν βίον.
urn:cts:greekLit:tlg0019.tlg011.fucex:198.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:198.1.text#εὖ τοι λέγειν ἔμοιγε φαίνεσθον πάνυ·
urn:cts:greekLit:tlg0019.tlg011.fucex:199.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:199.1.text#πλὴν ἓν μόνον δέδοικα.
urn:cts:greekLit:tlg0019.tlg011.fucex:199.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:199.2.text#φράζε τοῦ πέρι;
urn:cts:greekLit:tlg0019.tlg011.fucex:200.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:200.1.text#ὅπως ἐγὼ τὴν δύναμιν ἣν ὑμεῖς φατε
urn:cts:greekLit:tlg0019.tlg011.fucex:201.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:201.1.text#ἔχειν με, ταύτης δεσπότης γενήσομαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:202.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:202.1.text#νὴ τὸν Δί' ἀλλὰ καὶ λέγουσι πάντες ὡς
urn:cts:greekLit:tlg0019.tlg011.fucex:203.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:203.1.text#δειλότατόν ἐσθ' ὁ Πλοῦτος.
urn:cts:greekLit:tlg0019.tlg011.fucex:203.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:203.2.text#ἥκιστ', ἀλλά με
urn:cts:greekLit:tlg0019.tlg011.fucex:204.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:204.1.text#τοιχωρύχος τις διέβαλ'. ἐσδὺς γάρ ποτε
urn:cts:greekLit:tlg0019.tlg011.fucex:205.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:205.1.text#οὐκ εἶχεν ἐς τὴν οἰκίαν οὐδὲν λαβεῖν,
urn:cts:greekLit:tlg0019.tlg011.fucex:206.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:206.1.text#εὑρὼν ἁπαξάπαντα κατακεκλῃμένα·
urn:cts:greekLit:tlg0019.tlg011.fucex:207.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:207.1.text#εἶτ' ὠνόμασέ μου τὴν πρόνοιαν δειλίαν.
urn:cts:greekLit:tlg0019.tlg011.fucex:208.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:208.1.text#μή νυν μελέτω σοι μηδέν· ὡς ἐὰν γένῃ
urn:cts:greekLit:tlg0019.tlg011.fucex:209.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:209.1.text#ἀνὴρ πρόθυμος αὐτὸς ἐς τὰ πράγματα,
urn:cts:greekLit:tlg0019.tlg011.fucex:210.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:210.1.text#βλέποντ' ἀποδείξω σ' ὀξύτερον τοῦ Λυγκέως.
urn:cts:greekLit:tlg0019.tlg011.fucex:211.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:211.1.text#πῶς οὖν δυνήσει τοῦτο δρᾶσαι θνητὸς ὤν;
urn:cts:greekLit:tlg0019.tlg011.fucex:212.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:212.1.text#ἔχω τιν' ἀγαθὴν ἐλπίδ' ἐξ ὧν εἶπέ μοι
urn:cts:greekLit:tlg0019.tlg011.fucex:213.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:213.1.text#ὁ Φοῖβος αὐτὸς Πυθικὴν σείσας δάφνην.
urn:cts:greekLit:tlg0019.tlg011.fucex:214.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:214.1.text#κἀκεῖνος οὖν σύνοιδε ταῦτα;
urn:cts:greekLit:tlg0019.tlg011.fucex:214.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:214.2.text#φήμ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg011.fucex:215.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:215.1.text#ὁρᾶτε.
urn:cts:greekLit:tlg0019.tlg011.fucex:215.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:215.2.text#μὴ φρόντιζε μηδὲν ὦγαθέ.
urn:cts:greekLit:tlg0019.tlg011.fucex:216.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:216.1.text#ἐγὼ γάρ, εὖ τοῦτ' ἴσθι, κεἰ δεῖ μ' ἀποθανεῖν,
urn:cts:greekLit:tlg0019.tlg011.fucex:217.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:217.1.text#αὐτὸς διαπράξω ταῦτα.
urn:cts:greekLit:tlg0019.tlg011.fucex:217.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:217.2.text#κἂν βούλῃ γ', ἐγώ.
urn:cts:greekLit:tlg0019.tlg011.fucex:218.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:218.1.text#πολλοὶ δ' ἔσονται χἄτεροι νῷν ξύμμαχοι,
urn:cts:greekLit:tlg0019.tlg011.fucex:219.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:219.1.text#ὅσοις δικαίοις οὖσιν οὐκ ἦν ἄλφιτα.
urn:cts:greekLit:tlg0019.tlg011.fucex:220.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:220.1.text#παπαῖ πονηρούς γ' εἶπας ἡμῖν συμμάχους.
urn:cts:greekLit:tlg0019.tlg011.fucex:221.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:221.1.text#οὐκ ἤν γε πλουτήσωσιν ἐξ ἀρχῆς πάλιν.
urn:cts:greekLit:tlg0019.tlg011.fucex:222.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:222.1.text#ἀλλ' ἴθι σὺ μὲν ταχέως δραμών—
urn:cts:greekLit:tlg0019.tlg011.fucex:222.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:222.2.text#τί δρῶ; λέγε.
urn:cts:greekLit:tlg0019.tlg011.fucex:223.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:223.1.text#τοὺς ξυγγεώργους κάλεσον, εὑρήσεις δ' ἴσως
urn:cts:greekLit:tlg0019.tlg011.fucex:224.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:224.1.text#ἐν τοῖς ἀγροῖς αὐτοὺς ταλαιπωρουμένους,
urn:cts:greekLit:tlg0019.tlg011.fucex:225.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:225.1.text#ὅπως ἂν ἴσον ἕκαστος ἐνταυθοῖ παρὼν
urn:cts:greekLit:tlg0019.tlg011.fucex:226.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:226.1.text#ἡμῖν μετάσχῃ τοῦδε τοῦ Πλούτου μέρος.
urn:cts:greekLit:tlg0019.tlg011.fucex:227.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:227.1.text#καὶ δὴ βαδίζω· τουτοδὶ τὸ κρεᾴδιον
urn:cts:greekLit:tlg0019.tlg011.fucex:228.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:228.1.text#τῶν ἔνδοθέν τις εἰσενεγκάτω λαβών.
urn:cts:greekLit:tlg0019.tlg011.fucex:229.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:229.1.text#ἐμοὶ μελήσει τοῦτό γ'· ἀλλ' ἀνύσας τρέχε.
urn:cts:greekLit:tlg0019.tlg011.fucex:230.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:230.1.text#σὺ δ' ὦ κράτιστε Πλοῦτε πάντων δαιμόνων
urn:cts:greekLit:tlg0019.tlg011.fucex:231.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:231.1.text#εἴσω μετ' ἐμοῦ δεῦρ' εἴσιθ'· ἡ γὰρ οἰκία
urn:cts:greekLit:tlg0019.tlg011.fucex:232.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:232.1.text#αὕτη 'στὶν ἣν δεῖ χρημάτων σε τήμερον
urn:cts:greekLit:tlg0019.tlg011.fucex:233.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:233.1.text#μεστὴν ποιῆσαι καὶ δικαίως κἀδίκως.
urn:cts:greekLit:tlg0019.tlg011.fucex:234.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:234.1.text#ἀλλ' ἄχθομαι μὲν εἰσιὼν νὴ τοὺς θεοὺς
urn:cts:greekLit:tlg0019.tlg011.fucex:235.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:235.1.text#εἰς οἰκίαν ἑκάστοτ' ἀλλοτρίαν πάνυ·
urn:cts:greekLit:tlg0019.tlg011.fucex:236.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:236.1.text#ἀγαθὸν γὰρ ἀπέλαυσ' οὐδὲν αὐτοῦ πώποτε.
urn:cts:greekLit:tlg0019.tlg011.fucex:237.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:237.1.text#ἢν μὲν γὰρ ὡς φειδωλὸν εἰσελθὼν τύχω,
urn:cts:greekLit:tlg0019.tlg011.fucex:238.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:238.1.text#εὐθὺς κατώρυξέν με κατὰ τῆς γῆς κάτω·
urn:cts:greekLit:tlg0019.tlg011.fucex:239.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:239.1.text#κἄν τις προσέλθῃ χρηστὸς ἄνθρωπος φίλος
urn:cts:greekLit:tlg0019.tlg011.fucex:240.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:240.1.text#αἰτῶν λαβεῖν τι σμικρὸν ἀργυρίδιον,
urn:cts:greekLit:tlg0019.tlg011.fucex:241.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:241.1.text#ἔξαρνός ἐστι μηδ' ἰδεῖν με πώποτε.
urn:cts:greekLit:tlg0019.tlg011.fucex:242.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:242.1.text#ἢν δ' ὡς παραπλῆγ' ἄνθρωπον εἰσελθὼν τύχω,
urn:cts:greekLit:tlg0019.tlg011.fucex:243.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:243.1.text#πόρναισι καὶ κύβοισι παραβεβλημένος
urn:cts:greekLit:tlg0019.tlg011.fucex:244.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:244.1.text#γυμνὸς θύραζ' ἐξέπεσον ἐν ἀκαρεῖ χρόνου.
urn:cts:greekLit:tlg0019.tlg011.fucex:245.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:245.1.text#μετρίου γὰρ ἀνδρὸς οὐκ ἐπέτυχες πώποτε.
urn:cts:greekLit:tlg0019.tlg011.fucex:246.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:246.1.text#ἐγὼ δὲ τούτου τοῦ τρόπου πώς εἰμ' ἀεί,
urn:cts:greekLit:tlg0019.tlg011.fucex:247.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:247.1.text#χαίρω τε γὰρ φειδόμενος ὡς οὐδεὶς ἀνὴρ
urn:cts:greekLit:tlg0019.tlg011.fucex:248.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:248.1.text#πάλιν τ' ἀναλῶν, ἡνίκ' ἂν τούτου δέῃ.
urn:cts:greekLit:tlg0019.tlg011.fucex:249.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:249.1.text#ἀλλ' εἰσίωμεν, ὡς ἰδεῖν σε βούλομαι
urn:cts:greekLit:tlg0019.tlg011.fucex:250.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:250.1.text#καὶ τὴν γυναῖκα καὶ τὸν υἱὸν τὸν μόνον,
urn:cts:greekLit:tlg0019.tlg011.fucex:251.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:251.1.text#ὃν ἑγὼ φιλῶ μάλιστα μετὰ σέ.
urn:cts:greekLit:tlg0019.tlg011.fucex:251.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:251.2.text#πείθομαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:252.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:252.1.text#τί γὰρ ἄν τις οὐχὶ πρὸς σὲ τἀληθῆ λέγοι;
urn:cts:greekLit:tlg0019.tlg011.fucex:253.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:253.1.text#ὦ πολλὰ δὴ τῷ δεσπότῃ ταὐτὸν θύμον φαγόντες,
urn:cts:greekLit:tlg0019.tlg011.fucex:254.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:254.1.text#ἄνδρες φίλοι καὶ δημόται καὶ τοῦ πονεῖν ἐρασταί,
urn:cts:greekLit:tlg0019.tlg011.fucex:255.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:255.1.text#ἴτ' ἐγκονεῖτε σπεύδεθ', ὡς ὁ καιρὸς οὐχὶ μέλλειν,
urn:cts:greekLit:tlg0019.tlg011.fucex:256.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:256.1.text#ἀλλ' ἔστ' ἐπ' αὐτῆς τῆς ἀκμῆς, ᾗ δεῖ παρόντ' ἀμύνειν.
urn:cts:greekLit:tlg0019.tlg011.fucex:257.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:257.1.text#οὔκουν ὁρᾷς ὁρμωμένους ἡμᾶς πάλαι προθύμως,
urn:cts:greekLit:tlg0019.tlg011.fucex:258.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:258.1.text#ὡς εἰκός ἐστιν ἀσθενεῖς γέροντας ἄνδρας ἤδη;
urn:cts:greekLit:tlg0019.tlg011.fucex:259.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:259.1.text#σὺ δ' ἀξιοῖς ἴσως με θεῖν, πρὶν ταῦτα καὶ φράσαι μοι
urn:cts:greekLit:tlg0019.tlg011.fucex:260.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:260.1.text#ὅτου χάριν μ' ὁ δεσπότης ὁ σὸς κέκληκε δῦρο.
urn:cts:greekLit:tlg0019.tlg011.fucex:261.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:261.1.text#οὔκουν πάλαι δήπου λέγω; σὺ δ' αὐτὸς οὐκ ἀκούεις.
urn:cts:greekLit:tlg0019.tlg011.fucex:262.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:262.1.text#ὁ δεσπότης γάρ φησιν ὑμᾶς ἡδέως ἅπαντας
urn:cts:greekLit:tlg0019.tlg011.fucex:263.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:263.1.text#ψυχροῦ βίου καὶ δυσκόλου ζήσειν ἀπαλλαγέντας.
urn:cts:greekLit:tlg0019.tlg011.fucex:264.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:264.1.text#ἔστιν δὲ δὴ τί καὶ πόθεν τὸ πρᾶγμα τοῦθ' ὅ φησιν;
urn:cts:greekLit:tlg0019.tlg011.fucex:265.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:265.1.text#ἔχων ἀφῖκται δεῦρο πρεσβύτην τιν' ὦ πόνηροι
urn:cts:greekLit:tlg0019.tlg011.fucex:266.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:266.1.text#ῥυπῶντα κυφὸν ἄθλιον ῥυσὸν μαδῶντα νωδόν·
urn:cts:greekLit:tlg0019.tlg011.fucex:267.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:267.1.text#οἶμαι δὲ νὴ τὸν οὐρανὸν καὶ ψωλὸν αὐτὸν εἶναι.
urn:cts:greekLit:tlg0019.tlg011.fucex:268.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:268.1.text#ὦ χρυσὸν ἀγγείλας ἐπῶν πῶς φῄς; πάλιν φράσον μοι.
urn:cts:greekLit:tlg0019.tlg011.fucex:269.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:269.1.text#δηλοῖς γὰρ αὐτὸν σωρὸν ἥκειν χρημάτων ἔχοντα.
urn:cts:greekLit:tlg0019.tlg011.fucex:270.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:270.1.text#πρεσβυτικῶν μὲν οὖν κακῶν ἔγωγ' ἔχοντα σωρόν.
urn:cts:greekLit:tlg0019.tlg011.fucex:271.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:271.1.text#μῶν ἀξιοῖς φενακίσας ἔπειτ' ἀπαλλαγῆναι
urn:cts:greekLit:tlg0019.tlg011.fucex:272.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:272.1.text#ἀζήμιος, καὶ ταῦτ' ἐμοῦ βακτηρίαν ἔχοντος;
urn:cts:greekLit:tlg0019.tlg011.fucex:273.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:273.1.text#πάντως γὰρ ἄνθρωπον φύσει τοιοῦτον ἐς τὰ πάντα
urn:cts:greekLit:tlg0019.tlg011.fucex:274.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:274.1.text#ἡγεῖσθέ μ' εἶναι κοὐδὲν ἂν νομίζεθ' ὑγιὲς εἰπεῖν;
urn:cts:greekLit:tlg0019.tlg011.fucex:275.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:275.1.text#ὡς σεμνὸς οὑπίτριπτος· αἱ κνῆμαι δέ σου βοῶσιν
urn:cts:greekLit:tlg0019.tlg011.fucex:276.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:276.1.text# "ἰοὺ ἰού," τὰς χοίνικας καὶ τὰς πέδας ποθοῦσαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:277.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:277.1.text#ἐν τῇ σορῷ νυνὶ λαχὸν τὸ γράμμα σου δικάζειν,
urn:cts:greekLit:tlg0019.tlg011.fucex:278.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:278.1.text#σὺ δ' οὐ βαδίζεις, ὁ δὲ Χάρων τὸ ξύμβολον δίδωσιν.
urn:cts:greekLit:tlg0019.tlg011.fucex:279.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:279.1.text#διαρραγείης, ὡς μόθων εἶ καὶ φύσει κόβαλος,
urn:cts:greekLit:tlg0019.tlg011.fucex:280.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:280.1.text#ὅστις φενακίζεις, φράσαι δ' οὔπω τέτληκας ἡμῖν,
urn:cts:greekLit:tlg0019.tlg011.fucex:281.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:281.1.text#οἳ πολλὰ μοχθήσαντες οὐκ οὔσης σχολῆς προθύμως
urn:cts:greekLit:tlg0019.tlg011.fucex:282.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:282.1.text#δεῦρ' ἤλθομεν, πολλῶν θύμων ῥίζας διεκπερῶντες.
urn:cts:greekLit:tlg0019.tlg011.fucex:283.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:283.1.text#ἀλλ' οὐκέτ' ἂν κρύψαιμι. τὸν Πλοῦτον γὰρ ὦνδρες ἥκει
urn:cts:greekLit:tlg0019.tlg011.fucex:285.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:285.1.text#ἄγων ὁ δεσπότης, ὃς ὑμᾶς πλουσίους ποιήσει.
urn:cts:greekLit:tlg0019.tlg011.fucex:286.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:286.1.text#ὄντως γὰρ ἔστι πλουσίοις ἡμῖν ἅπασιν εἶναι;
urn:cts:greekLit:tlg0019.tlg011.fucex:287.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:287.1.text#νὴ τοὺς θεοὺς Μίδαις μὲν οὖν, ἢν ὦτ' ὄνου λάβητε.
urn:cts:greekLit:tlg0019.tlg011.fucex:288.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:288.1.text#ὡς ἥδομαι καὶ τέρπομαι καὶ βούλομαι χορεῦσαι
urn:cts:greekLit:tlg0019.tlg011.fucex:289.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:289.1.text#ὑφ' ἡδονῆς, εἴπερ λέγεις ὄντως σὺ ταῦτ' ἀληθῆ.
urn:cts:greekLit:tlg0019.tlg011.fucex:290.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:290.1.text#καὶ μὴν ἐγὼ βουλήσομαι θρεττανελὸ τὸν Κύκλωπα
urn:cts:greekLit:tlg0019.tlg011.fucex:291.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:291.1.text#μιμούμενος καὶ τοῖν ποδοῖν ὡδὶ παρενσαλεύων
urn:cts:greekLit:tlg0019.tlg011.fucex:292.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:292.1.text#ὑμᾶς ἄγειν. ἀλλ' εἶα τέκεα θαμίν' ἐπαναβοῶντες
urn:cts:greekLit:tlg0019.tlg011.fucex:293.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:293.1.text#βληχώμενοί τε προβατίων
urn:cts:greekLit:tlg0019.tlg011.fucex:294.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:294.1.text#αἰγῶν τε κιναβρώντων μέλη
urn:cts:greekLit:tlg0019.tlg011.fucex:295.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:295.1.text#ἕπεσθ' ἀπεψωλημένοι· τράγοι δ' ἀκρατιεῖσθε.
urn:cts:greekLit:tlg0019.tlg011.fucex:296.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:296.1.text#ἡμεῖς δέ γ' αὖ ζητήσομεν θρεττανελὸ τὸν Κύκλωπα
urn:cts:greekLit:tlg0019.tlg011.fucex:297.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:297.1.text#βληχώμενοι, σὲ τουτονὶ πεινῶντα καταλαβόντες,
urn:cts:greekLit:tlg0019.tlg011.fucex:298.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:298.1.text#πήραν ἔχοντα λάχανά τ' ἄγρια δροσερά, κραιπαλῶντα
urn:cts:greekLit:tlg0019.tlg011.fucex:299.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:299.1.text#ἡγούμενον τοῖς προβατίοις,
urn:cts:greekLit:tlg0019.tlg011.fucex:300.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:300.1.text#εἰκῇ δὲ καταδαρθόντα που
urn:cts:greekLit:tlg0019.tlg011.fucex:301.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:301.1.text#μέγαν λαβόντες ἡμμένον σφηκίσκον ἐκτυφλῶσαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:302.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:302.1.text#ἐγὼ δὲ τὴν Κίρκην γε τὴν τὰ φάρμακ' ἀνακυκῶσαν,
urn:cts:greekLit:tlg0019.tlg011.fucex:303.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:303.1.text#ἣ τοὺς ἑταίρους τοῦ Φιλωνίδου ποτ' ἐν Κορίνθῳ
urn:cts:greekLit:tlg0019.tlg011.fucex:304.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:304.1.text#ἔπεισεν ὡς ὄντας κάπρους
urn:cts:greekLit:tlg0019.tlg011.fucex:305.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:305.1.text#μεμαγμένον σκῶρ ἐσθίειν, αὐτὴ δ' ἔματτεν αὐτοῖς,
urn:cts:greekLit:tlg0019.tlg011.fucex:306.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:306.1.text#μιμήσομαι πάντας τρόπους·
urn:cts:greekLit:tlg0019.tlg011.fucex:307.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:307.1.text#ὑμεῖς δὲ γρυλίζοντες ὑπὸ φιληδίας
urn:cts:greekLit:tlg0019.tlg011.fucex:308.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:308.1.text#ἕπεσθε μητρὶ χοῖροι.
urn:cts:greekLit:tlg0019.tlg011.fucex:309.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:309.1.text#οὐκοῦν σε τὴν Κίρκην γε τὴν τὰ φάρμακ' ἀνακυκῶσαν
urn:cts:greekLit:tlg0019.tlg011.fucex:310.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:310.1.text#καὶ μαγγανεύουσαν μολύνουσάν τε τοὺς ἑταίρους
urn:cts:greekLit:tlg0019.tlg011.fucex:311.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:311.1.text#λαβόντες ὑπὸ φιληδίας
urn:cts:greekLit:tlg0019.tlg011.fucex:312.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:312.1.text#τὸν Λαρτίου μιμούμενοι τῶν ὄρχεων κρεμῶμεν,
urn:cts:greekLit:tlg0019.tlg011.fucex:313.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:313.1.text#μινθώσομέν θ' ὥσπερ τράγου
urn:cts:greekLit:tlg0019.tlg011.fucex:314.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:314.1.text#τὴν ῥῖνα· σὺ δ' Ἀρίστυλλος ὑποχάσκων ἐρεῖς,
urn:cts:greekLit:tlg0019.tlg011.fucex:315.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:315.1.text#ἕπεσθε μητρὶ χοῖροι.
urn:cts:greekLit:tlg0019.tlg011.fucex:316.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:316.1.text#ἀλλ' εἶα νῦν τῶν σκωμμάτων ἀπαλλαγέντες ἤδη
urn:cts:greekLit:tlg0019.tlg011.fucex:317.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:317.1.text#ὑμεῖς ἐπ' ἄλλ' εἶδος τρέπεσθ',
urn:cts:greekLit:tlg0019.tlg011.fucex:318.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:318.1.text#ἐγὼ δ' ἰὼν ἤδη λάθρᾳ
urn:cts:greekLit:tlg0019.tlg011.fucex:319.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:319.1.text#βουλήσομαι τοῦ δεσπότου
urn:cts:greekLit:tlg0019.tlg011.fucex:320.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:320.1.text#λαβών τιν' ἄρτον καὶ κρέας
urn:cts:greekLit:tlg0019.tlg011.fucex:321.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:321.1.text#μασώμενος τὸ λοιπὸν οὕτω τῷ κόπῳ ξυνεῖναι.
urn:cts:greekLit:tlg0019.tlg011.fucex:322.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:322.1.text#χαίρειν μὲν ὑμᾶς ἐστιν ὦνδρες δημόται
urn:cts:greekLit:tlg0019.tlg011.fucex:323.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:323.1.text#ἀρχαῖον ἤδη προσαγορεύειν καὶ σαπρόν·
urn:cts:greekLit:tlg0019.tlg011.fucex:324.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:324.1.text#ἀσπάζομαι δ' ὁτιὴ προθύμως ἥκετε
urn:cts:greekLit:tlg0019.tlg011.fucex:325.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:325.1.text#καὶ συντεταμένως κοὐ κατεβλακευμένως.
urn:cts:greekLit:tlg0019.tlg011.fucex:326.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:326.1.text#ὅπως δέ μοι καὶ τἄλλα συμπαραστάται
urn:cts:greekLit:tlg0019.tlg011.fucex:327.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:327.1.text#ἔσεσθε καὶ σωτῆρες ὄντως τοῦ θεοῦ.
urn:cts:greekLit:tlg0019.tlg011.fucex:328.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:328.1.text#θάρρει· βλέπειν γὰρ ἄντικρυς δόξεις μ' Ἄρη.
urn:cts:greekLit:tlg0019.tlg011.fucex:329.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:329.1.text#δεινὸν γὰρ εἰ τριωβόλου μὲν οὕνεκα
urn:cts:greekLit:tlg0019.tlg011.fucex:330.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:330.1.text#ὠστιζόμεσθ' ἑκάστοτ' ἐν τἠκκλησίᾳ,
urn:cts:greekLit:tlg0019.tlg011.fucex:331.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:331.1.text#αὐτὸν δὲ τὸν Πλοῦτον παρείην τῳ λαβεῖν.
urn:cts:greekLit:tlg0019.tlg011.fucex:332.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:332.1.text#καὶ μὴν ὁρῶ καὶ Βλεψίδημον τουτονὶ
urn:cts:greekLit:tlg0019.tlg011.fucex:333.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:333.1.text#προσιόντα· δῆλος δ' ἐστὶν ὅτι τοῦ πράγματος
urn:cts:greekLit:tlg0019.tlg011.fucex:334.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:334.1.text#ἀκήκοέν τι τῇ βαδίσει καὶ τῷ τάχει.
urn:cts:greekLit:tlg0019.tlg011.fucex:335.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:335.1.text#τί ἂν οὖν τὸ πρᾶγμ' εἴη; πόθεν καὶ τίνι τρόπῳ
urn:cts:greekLit:tlg0019.tlg011.fucex:336.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:336.1.text#Χρεμύλος πεπλούτηκ' ἐξαπίνης; οὐ πείθομαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:337.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:337.1.text#καίτοι λόγος γ' ἦν νὴ τὸν Ἡρακλέα πολὺς
urn:cts:greekLit:tlg0019.tlg011.fucex:338.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:338.1.text#ἐπὶ τοῖσι κουρείοισι τῶν καθημένων,
urn:cts:greekLit:tlg0019.tlg011.fucex:339.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:339.1.text#ὡς ἐξαπίνης ἀνὴρ γεγένηται πλούσιος.
urn:cts:greekLit:tlg0019.tlg011.fucex:340.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:340.1.text#ἔστιν δέ μοι τοῦτ' αὐτὸ θαυμάσιον, ὅπως
urn:cts:greekLit:tlg0019.tlg011.fucex:341.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:341.1.text#χρηστόν τι πράττων τοὺς φίλους μεταπέμπεται.
urn:cts:greekLit:tlg0019.tlg011.fucex:342.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:342.1.text#οὔκουν ἐπιχώριόν γε πρᾶγμ' ἐργάζεται.
urn:cts:greekLit:tlg0019.tlg011.fucex:343.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:343.1.text#ἀλλ' οὐδὲν ἀποκρύψας ἐρῶ· νὴ τοὺς θεοὺς
urn:cts:greekLit:tlg0019.tlg011.fucex:344.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:344.1.text#ὦ Βλεψίδημ' ἄμεινον ἢ χθὲς πράττομεν,
urn:cts:greekLit:tlg0019.tlg011.fucex:345.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:345.1.text#ὥστε μετέχειν ἔξεστιν· εἶ γὰρ τῶν φίλων.
urn:cts:greekLit:tlg0019.tlg011.fucex:346.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:346.1.text#γέγονας δ' ἀληθῶς, ὡς λέγουσι, πλούσιος;
urn:cts:greekLit:tlg0019.tlg011.fucex:347.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:347.1.text#ἔσομαι μὲν οὖν αὐτίκα μάλ', ἢν θεὸς θέλῃ.
urn:cts:greekLit:tlg0019.tlg011.fucex:348.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:348.1.text#ἔνι γάρ τις ἔνι κίνδυνος ἐν τῷ πράγματι.
urn:cts:greekLit:tlg0019.tlg011.fucex:349.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:349.1.text#ποῖός τις;
urn:cts:greekLit:tlg0019.tlg011.fucex:349.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:349.2.text#οἷος;
urn:cts:greekLit:tlg0019.tlg011.fucex:349.3.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:349.3.text#λέγ' ἀνύσας ὅ τι φῄς ποτε.
urn:cts:greekLit:tlg0019.tlg011.fucex:350.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:350.1.text#ἢν μὲν κατορθώσωμεν, εὖ πράττειν ἀεί·
urn:cts:greekLit:tlg0019.tlg011.fucex:351.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:351.1.text#ἢν δὲ σφαλῶμεν, ἐπιτετρῖφθαι τὸ παράπαν.
urn:cts:greekLit:tlg0019.tlg011.fucex:352.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:352.1.text#τουτὶ πονηρὸν φαίνεται τὸ φορτίον
urn:cts:greekLit:tlg0019.tlg011.fucex:353.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:353.1.text#καί μ' οὐκ ἀρέσκει. τό τε γὰρ ἐξαίφνης ἄγαν
urn:cts:greekLit:tlg0019.tlg011.fucex:354.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:354.1.text#οὕτως ὑπερπλουτεῖν τό τ' αὖ δεδοικέναι
urn:cts:greekLit:tlg0019.tlg011.fucex:355.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:355.1.text#πρὸς ἀνδρὸς οὐδὲν ὑγιές ἐστ' εἰργασμένου.
urn:cts:greekLit:tlg0019.tlg011.fucex:356.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:356.1.text#πῶς οὐδὲν ὑγιές;
urn:cts:greekLit:tlg0019.tlg011.fucex:356.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:356.2.text#εἴ τι κεκλοφὼς νὴ Δία
urn:cts:greekLit:tlg0019.tlg011.fucex:357.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:357.1.text#ἐκεῖθεν ἥκεις ἀργύριον ἢ χρυσίον
urn:cts:greekLit:tlg0019.tlg011.fucex:358.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:358.1.text#παρὰ τοῦ θεοῦ, κἄπειτ' ἴσως σοι μεταμέλει.
urn:cts:greekLit:tlg0019.tlg011.fucex:359.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:359.1.text#Ἄπολλον ἀποτρόπαιε μὰ Δί' ἐγὼ μὲν οὔ.
urn:cts:greekLit:tlg0019.tlg011.fucex:360.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:360.1.text#παῦσαι φλυαρῶν ὦγάθ'· οῖδα γὰρ σαφῶς.
urn:cts:greekLit:tlg0019.tlg011.fucex:361.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:361.1.text#σὺ μηδὲν εἰς ἔμ' ὑπονόει τοιουτονί.
urn:cts:greekLit:tlg0019.tlg011.fucex:362.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:362.1.text#φεῦ,
urn:cts:greekLit:tlg0019.tlg011.fucex:362a.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:362a.1.text#ὡς οὐδὲν ἀτεχνῶς ὑγιές ἐστιν οὐδενός,
urn:cts:greekLit:tlg0019.tlg011.fucex:363.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:363.1.text#ἀλλ' εἰσὶ τοῦ κέρδους ἅπαντες ἥττονες.
urn:cts:greekLit:tlg0019.tlg011.fucex:364.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:364.1.text#οὔ τοι μὰ τὴν Δήμητρ' ὑγιαίνειν μοι δοκεῖς.
urn:cts:greekLit:tlg0019.tlg011.fucex:365.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:365.1.text#ὡς πολὺ μεθέστηχ' ὧν πρότερον εἶχεν τρόπων.
urn:cts:greekLit:tlg0019.tlg011.fucex:366.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:366.1.text#μελαγχολᾷς ὦνθρωπε νὴ τὸν οὐρανόν.
urn:cts:greekLit:tlg0019.tlg011.fucex:367.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:367.1.text#ἀλλ' οὐδὲ τὸ βλέμμ' αὐτὸ κατὰ χώραν ἔχει,
urn:cts:greekLit:tlg0019.tlg011.fucex:368.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:368.1.text#ἀλλ' ἐστὶν ἐπίδηλόν τι πεπανουργηκότι.
urn:cts:greekLit:tlg0019.tlg011.fucex:369.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:369.1.text#σὺ μὲν οἶδ' ὃ κρώζεις· ὡς ἐμοῦ τι κεκλοφότος
urn:cts:greekLit:tlg0019.tlg011.fucex:370.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:370.1.text#ζητεῖς μεταλαβεῖν.
urn:cts:greekLit:tlg0019.tlg011.fucex:370.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:370.2.text#μεταλαβεῖν ζητῶ; τίνος;
urn:cts:greekLit:tlg0019.tlg011.fucex:371.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:371.1.text#τὸ δ' ἐστὶν οὐ τοιοῦτον ἀλλ' ἑτέρως ἔχον.
urn:cts:greekLit:tlg0019.tlg011.fucex:372.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:372.1.text#μῶν οὐ κέκλοφας ἀλλ' ἥρπακας;
urn:cts:greekLit:tlg0019.tlg011.fucex:372.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:372.2.text#κακοδαιμονᾷς.
urn:cts:greekLit:tlg0019.tlg011.fucex:373.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:373.1.text#ἀλλ' οὐδὲ μὴν ἀπεστέρηκάς γ' οὐδένα;
urn:cts:greekLit:tlg0019.tlg011.fucex:374.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:374.1.text#ου' δῆτ' ἔγωγ'.
urn:cts:greekLit:tlg0019.tlg011.fucex:374.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:374.2.text#ὦ Ἡράκλεις, φέρε ποῖ τις ἂν
urn:cts:greekLit:tlg0019.tlg011.fucex:375.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:375.1.text#τράποιτο; τἀληθὲς γὰρ οὐκ ἐθέλει φράσαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:376.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:376.1.text#κατηγορεῖς γὰρ πρὶν μαθεῖν τὸ πρᾶγμά μου.
urn:cts:greekLit:tlg0019.tlg011.fucex:377.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:377.1.text#ὦ τᾶν ἐγώ τοι τοῦτ' ἀπὸ σμικροῦ πάνυ
urn:cts:greekLit:tlg0019.tlg011.fucex:378.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:378.1.text#ἐθέλω διαπρᾶξαι πρὶν πυθέσθαι τὴν πόλιν,
urn:cts:greekLit:tlg0019.tlg011.fucex:379.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:379.1.text#τὸ στόμ' ἐπιβύσας κέρμασιν τῶν ῥητόρων.
urn:cts:greekLit:tlg0019.tlg011.fucex:380.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:380.1.text#καὶ μὴν φίλως γ' ἄν μοι δοκεῖς νὴ τοὺς θεοὺς
urn:cts:greekLit:tlg0019.tlg011.fucex:381.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:381.1.text#τρεῖς μνᾶς ἀναλώσας λογίσασθαι δώδεκα.
urn:cts:greekLit:tlg0019.tlg011.fucex:382.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:382.1.text#ὁρῶ τιν' ἐπὶ τοῦ βήματος καθεδούμενον
urn:cts:greekLit:tlg0019.tlg011.fucex:383.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:383.1.text#ἱκετηρίαν ἔχοντα μετὰ τῶν παιδίων
urn:cts:greekLit:tlg0019.tlg011.fucex:384.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:384.1.text#καὶ τῆς γυναικός, κου' διοίσοντ' ἄντικρυς
urn:cts:greekLit:tlg0019.tlg011.fucex:385.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:385.1.text#τῶν Ἡρακλειδῶν οὐδ' ὁτιοῦν τῶν Παμφίλου.
urn:cts:greekLit:tlg0019.tlg011.fucex:386.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:386.1.text#οὒκ ὦ κακόδαιμον, ἀλλὰ τοὺς χρηστοὺς μόνους
urn:cts:greekLit:tlg0019.tlg011.fucex:387.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:387.1.text#ἔγωγε καὶ τοὺς δεξιοὺς καὶ σώφρονας
urn:cts:greekLit:tlg0019.tlg011.fucex:388.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:388.1.text#ἀπαρτὶ πλουτῆσαι ποιήσω.
urn:cts:greekLit:tlg0019.tlg011.fucex:388.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:388.2.text#τί σὺ λέγεις;
urn:cts:greekLit:tlg0019.tlg011.fucex:389.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:389.1.text#οὕτω πάνυ πολλὰ κέκλοφας;
urn:cts:greekLit:tlg0019.tlg011.fucex:389.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:389.2.text#οἴμοι τῶν κακῶν,
urn:cts:greekLit:tlg0019.tlg011.fucex:390.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:390.1.text#ἀπολεῖς.
urn:cts:greekLit:tlg0019.tlg011.fucex:390.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:390.2.text#σὺ μὲν οὖν σεαυτόν, ὥς γ' ἐμοὶ δοκεῖς.
urn:cts:greekLit:tlg0019.tlg011.fucex:391.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:391.1.text#ου' δῆτ', ἐπεὶ τὸν Πλοῦτον ὦ μόχθηρε σὺ
urn:cts:greekLit:tlg0019.tlg011.fucex:392.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:392.1.text#ἔχω.
urn:cts:greekLit:tlg0019.tlg011.fucex:392.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:392.2.text#σὺ Πλοῦτον; ποῖον;
urn:cts:greekLit:tlg0019.tlg011.fucex:392.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:392.3.text#αὐτὸν τὸν θεόν.
urn:cts:greekLit:tlg0019.tlg011.fucex:393.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:393.1.text#καὶ ποῦ 'στιν;
urn:cts:greekLit:tlg0019.tlg011.fucex:393.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:393.2.text#ἔνδον.
urn:cts:greekLit:tlg0019.tlg011.fucex:393.3.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:393.3.text#ποῦ;
urn:cts:greekLit:tlg0019.tlg011.fucex:393.4.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:393.4.text#παρ' ἐμοί.
urn:cts:greekLit:tlg0019.tlg011.fucex:393.5.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:393.5.text#παρὰ σοί;
urn:cts:greekLit:tlg0019.tlg011.fucex:393.6.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:393.6.text#πάνυ.
urn:cts:greekLit:tlg0019.tlg011.fucex:394.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:394.1.text#οὐκ ἐς κόρακας; Πλοῦτος παρὰ σοί;
urn:cts:greekLit:tlg0019.tlg011.fucex:394.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:394.2.text#νὴ τοὺς θεούς.
urn:cts:greekLit:tlg0019.tlg011.fucex:395.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:395.1.text#λὲγεις ἀληθῆ;
urn:cts:greekLit:tlg0019.tlg011.fucex:395.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:395.2.text#φημί.
urn:cts:greekLit:tlg0019.tlg011.fucex:395.3.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:395.3.text#πρὸς τῆς Ἑστίας;
urn:cts:greekLit:tlg0019.tlg011.fucex:396.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:396.1.text#νὴ τὸν Ποσειδῶ.
urn:cts:greekLit:tlg0019.tlg011.fucex:396.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:396.2.text#τὸν θαλάττιον λέγεις;
urn:cts:greekLit:tlg0019.tlg011.fucex:397.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:397.1.text#εἰ δ' ἔστιν ἕτερός τις Ποσειδῶν, τὸν ἕτερον.
urn:cts:greekLit:tlg0019.tlg011.fucex:398.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:398.1.text#εἶτ' οὐ διαπέμπεις καὶ πρὸς ἡμᾶς τοὺς φίλους;
urn:cts:greekLit:tlg0019.tlg011.fucex:399.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:399.1.text#οὐκ ἔστι πω τὰ πράγματ' ἐν τούτῳ.
urn:cts:greekLit:tlg0019.tlg011.fucex:399.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:399.2.text#τί φῄς;
urn:cts:greekLit:tlg0019.tlg011.fucex:400.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:400.1.text#οὐ τῷ μεταδοῦναι;
urn:cts:greekLit:tlg0019.tlg011.fucex:400.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:400.2.text#μὰ Δία. δεῖ γὰρ πρῶτα
urn:cts:greekLit:tlg0019.tlg011.fucex:400.3.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:400.3.text#τί;
urn:cts:greekLit:tlg0019.tlg011.fucex:401.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:401.1.text#βλέψαι ποιῆσαι νώ—
urn:cts:greekLit:tlg0019.tlg011.fucex:401.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:401.2.text#τίνα βλέψαι; φράσον.
urn:cts:greekLit:tlg0019.tlg011.fucex:402.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:402.1.text#τὸν Πλοῦτον ὥσπερ πρότερον ἑνί γέ τῳ τρόπῳ.
urn:cts:greekLit:tlg0019.tlg011.fucex:403.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:403.1.text#τυφλὸς γὰρ ὄντως ἐστί;
urn:cts:greekLit:tlg0019.tlg011.fucex:403.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:403.2.text#νὴ τὸν οὐρανόν.
urn:cts:greekLit:tlg0019.tlg011.fucex:404.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:404.1.text#οὐκ ἐτὸς ἄρ' ὡς ἔμ' ἦλθεν οὐδεπώποτε.
urn:cts:greekLit:tlg0019.tlg011.fucex:405.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:405.1.text#ἀλλ' ἢν θεοὶ θέλωσι, νῦν ἀφίξεται.
urn:cts:greekLit:tlg0019.tlg011.fucex:406.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:406.1.text#οὔκουν ἰατρὸν εἰσάγειν ἐχρῆν τινά;
urn:cts:greekLit:tlg0019.tlg011.fucex:407.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:407.1.text#τίς δῆτ' ἰατρός ἐστι νῦν ἐν τῇ πόλει;
urn:cts:greekLit:tlg0019.tlg011.fucex:408.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:408.1.text#οὔτε γὰρ ὁ μισθὸς οὐδὲν ἔστ' οὔθ' ἡ τέχνη.
urn:cts:greekLit:tlg0019.tlg011.fucex:409.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:409.1.text#σκοπῶμεν.
urn:cts:greekLit:tlg0019.tlg011.fucex:409.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:409.2.text#ἀλλ' οὐκ ἔστιν.
urn:cts:greekLit:tlg0019.tlg011.fucex:409.3.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:409.3.text#οὐδ ἐμοὶ δοκεῖ.
urn:cts:greekLit:tlg0019.tlg011.fucex:410.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:410.1.text#μὰ Δί' ἀλλ' ὅπερ πάλαι παρεσκευαζόμην
urn:cts:greekLit:tlg0019.tlg011.fucex:411.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:411.1.text#ἐγώ, κατακλίνειν αὐτὸν εἰς Ἀσκληπιοῦ
urn:cts:greekLit:tlg0019.tlg011.fucex:412.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:412.1.text#κράτιστόν ἐστι.
urn:cts:greekLit:tlg0019.tlg011.fucex:412.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:412.2.text#πολὺ μὲν οὖν νὴ τοὺς θεούς.
urn:cts:greekLit:tlg0019.tlg011.fucex:413.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:413.1.text#μή νυν διάτριβ' ἀλλ' ἄνυε πράττων ἕν γέ τι.
urn:cts:greekLit:tlg0019.tlg011.fucex:414.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:414.1.text#καὶ δὴ βαδίζω.
urn:cts:greekLit:tlg0019.tlg011.fucex:414.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:414.2.text#σπεῦδέ νυν.
urn:cts:greekLit:tlg0019.tlg011.fucex:414.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:414.3.text#τοῦτ' αὐτὸ δρῶ.
urn:cts:greekLit:tlg0019.tlg011.fucex:415.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:415.1.text#ὦ θερμὸν ἔργον κἀνόσιον καὶ παράνομον
urn:cts:greekLit:tlg0019.tlg011.fucex:416.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:416.1.text#τολμῶντε δρᾶν ἀνθρωπαρίω κακοδαίμονε—
urn:cts:greekLit:tlg0019.tlg011.fucex:417.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:417.1.text#ποῖ ποῖ; τί φεύγετον; οὐ μενεῖτον;
urn:cts:greekLit:tlg0019.tlg011.fucex:417.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:417.2.text#Ἡράκλεις.
urn:cts:greekLit:tlg0019.tlg011.fucex:418.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:418.1.text#ἐγὼ γὰρ ὑμᾶς ἐξολῶ κακοὺς κακῶς·
urn:cts:greekLit:tlg0019.tlg011.fucex:419.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:419.1.text#τόλμημα γὰρ τολμᾶτον οὐκ ἀνασχετόν,
urn:cts:greekLit:tlg0019.tlg011.fucex:420.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:420.1.text#ἀλλ' οἷον οὐδεὶς ἄλλος οὐδεπώποτε
urn:cts:greekLit:tlg0019.tlg011.fucex:421.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:421.1.text#οὔτε θεὸς οὔτ' ἄνθρωπος· ὥστ' ἀπολώλατον.
urn:cts:greekLit:tlg0019.tlg011.fucex:422.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:422.1.text#σὺ δ' εἶ τίς; ὠχρὰ μὲν γὰρ εἶναί μοι δοκεῖς.
urn:cts:greekLit:tlg0019.tlg011.fucex:423.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:423.1.text#ἴσως Ἐρινύς ἐστιν ἐκ τραγῳδίας·
urn:cts:greekLit:tlg0019.tlg011.fucex:424.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:424.1.text#βλέπει γέ τοι μανικόν τι καὶ τραγῳδικόν.
urn:cts:greekLit:tlg0019.tlg011.fucex:425.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:425.1.text#ἀλλ' οὐκ ἔχει γὰρ δᾷδας.
urn:cts:greekLit:tlg0019.tlg011.fucex:425.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:425.2.text#οὐκοῦν κλαύσεται.
urn:cts:greekLit:tlg0019.tlg011.fucex:426.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:426.1.text#ὄιεσθε δ' εἶναι τίνα με;
urn:cts:greekLit:tlg0019.tlg011.fucex:426.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:426.2.text#πανδοκεύτριαν
urn:cts:greekLit:tlg0019.tlg011.fucex:427.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:427.1.text#ἢ λεκιθόπωλιν. οὐ γὰρ ἂν τοσουτονὶ
urn:cts:greekLit:tlg0019.tlg011.fucex:428.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:428.1.text#ἀνέκραγες ἡμῖν οὐδὲν ἠδικημένη.
urn:cts:greekLit:tlg0019.tlg011.fucex:429.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:429.1.text#ἄληθες; οὐ γὰρ δεινότατα δεδράκατον
urn:cts:greekLit:tlg0019.tlg011.fucex:430.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:430.1.text#ζητοῦντες ἐκ πάσης με χώρας ἐκβαλεῖν;
urn:cts:greekLit:tlg0019.tlg011.fucex:431.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:431.1.text#οὔκουν ὑπόλοιπον τὸ βάραθρόν σοι γίγνεται;
urn:cts:greekLit:tlg0019.tlg011.fucex:432.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:432.1.text#ἀλλ' ἥτις εἶ λέγειν σ' ἐχρῆν αὐτίκα μάλα.
urn:cts:greekLit:tlg0019.tlg011.fucex:433.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:433.1.text#ἣ σφὼ ποιήσω τήμερον δοῦναι δίκην
urn:cts:greekLit:tlg0019.tlg011.fucex:434.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:434.1.text#ἀνθ' ὧν ἐμὲ ζητεῖτον ἐνθένδ' ἀφανίσαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:435.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:435.1.text#ἆρ' ἐστὶν ἡ καπηλὶς ἡκ τῶν γειτόνων,
urn:cts:greekLit:tlg0019.tlg011.fucex:436.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:436.1.text#ἣ ταῖς κοτύλαις ἀεί με διαλυμαίνεται;
urn:cts:greekLit:tlg0019.tlg011.fucex:437.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:437.1.text#Πενία μὲν οὖν, ἣ σφῷν ξυνοικῶ πόλλ' ἔτη.
urn:cts:greekLit:tlg0019.tlg011.fucex:438.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:438.1.text#ἄναξ Ἄπολλον καὶ θεοί, ποῖ τις φύγῃ;
urn:cts:greekLit:tlg0019.tlg011.fucex:439.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:439.1.text#οὗτος τί δρᾷς; ὦ δειλότατον σὺ θηρίον·
urn:cts:greekLit:tlg0019.tlg011.fucex:440.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:440.1.text#οὐ παραμενεῖς;
urn:cts:greekLit:tlg0019.tlg011.fucex:440.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:440.2.text#ἥκιστα πάντων.
urn:cts:greekLit:tlg0019.tlg011.fucex:440.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:440.3.text#οὐ μενεῖς;
urn:cts:greekLit:tlg0019.tlg011.fucex:441.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:441.1.text#ἀλλ' ἄνδρε δύο γυναῖκα φεύγομεν μίαν;
urn:cts:greekLit:tlg0019.tlg011.fucex:442.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:442.1.text#Πενία γάρ ἐστιν ὦ πόνηρ', ἧς οὐδαμοῦ
urn:cts:greekLit:tlg0019.tlg011.fucex:443.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:443.1.text#οὐδὲν πέφυκε ζῷον ἐξωλέστερον.
urn:cts:greekLit:tlg0019.tlg011.fucex:444.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:444.1.text#στῆθ', ἀντιβολῶ σε, στῆθι.
urn:cts:greekLit:tlg0019.tlg011.fucex:444.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:444.2.text#μὰ Δί' ἐγὼ μὲν οὔ.
urn:cts:greekLit:tlg0019.tlg011.fucex:445.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:445.1.text#καὶ μὴν λέγω, δεινότατον ἔργον παρὰ πολὺ
urn:cts:greekLit:tlg0019.tlg011.fucex:446.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:446.1.text#ἔργων ἁπάντων ἐργασόμεθ', εἰ τὸν θεὸν
urn:cts:greekLit:tlg0019.tlg011.fucex:447.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:447.1.text#ἔρημον ἀπολιπόντε ποι φευξούμεθα
urn:cts:greekLit:tlg0019.tlg011.fucex:448.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:448.1.text#τηνδὶ δεδιότε, μηδὲ διαμαχούμεθα.
urn:cts:greekLit:tlg0019.tlg011.fucex:449.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:449.1.text#ποίοις ὅπλοισιν ἢ δυνάμει πεποιθότες;
urn:cts:greekLit:tlg0019.tlg011.fucex:450.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:450.1.text#ποῖον γὰρ οὐ θώρακα, ποίαν δ' ἀσπίδα
urn:cts:greekLit:tlg0019.tlg011.fucex:451.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:451.1.text#οὐκ ἐνέχυρον τίθησιν ἡ μιαρωτάτη;
urn:cts:greekLit:tlg0019.tlg011.fucex:452.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:452.1.text#θάρρει· μόνος γὰρ ὁ θεὸς οὗτος οἶδ' ὅτι
urn:cts:greekLit:tlg0019.tlg011.fucex:453.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:453.1.text#τροπαῖον ἂν στήσαιτο τῶν ταύτης τρόπων.
urn:cts:greekLit:tlg0019.tlg011.fucex:454.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:454.1.text#γρύζειν δὲ καὶ τολμᾶτον ὦ καθάρματε,
urn:cts:greekLit:tlg0019.tlg011.fucex:455.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:455.1.text#ἐπ' αὐτοφώρῳ δεινὰ δρῶντ' εἰλημμένω;
urn:cts:greekLit:tlg0019.tlg011.fucex:456.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:456.1.text#σὺ δ' ὦ κάκιστ' ἀπολουμένη τί λοιδορεῖ
urn:cts:greekLit:tlg0019.tlg011.fucex:457.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:457.1.text#ἡμῖν προσελθοῦσ' οὐδ' ὁτιοῦν ἀδικουμένη;
urn:cts:greekLit:tlg0019.tlg011.fucex:458.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:458.1.text#οὐδὲν γὰρ ὦ πρὸς τῶν θεῶν νομίζετε
urn:cts:greekLit:tlg0019.tlg011.fucex:459.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:459.1.text#ἀδικεῖν με τὸν Πλοῦτον ποιεῖν πειρωμένω
urn:cts:greekLit:tlg0019.tlg011.fucex:460.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:460.1.text#βλέψαι πάλιν;
urn:cts:greekLit:tlg0019.tlg011.fucex:460.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:460.2.text#τί οὖν ἀδικοῦμεν τοῦτό σε,
urn:cts:greekLit:tlg0019.tlg011.fucex:461.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:461.1.text#εἰ πᾶσιν ἀνθρώποισιν ἐκπορίζομεν
urn:cts:greekLit:tlg0019.tlg011.fucex:462.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:462.1.text#ἀγαθόν;
urn:cts:greekLit:tlg0019.tlg011.fucex:462.2.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:462.2.text#τί δ' ἂν ὑμεῖς ἀγαθὸν ἐξεύροιθ';
urn:cts:greekLit:tlg0019.tlg011.fucex:462.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:462.3.text#ὅ τι;
urn:cts:greekLit:tlg0019.tlg011.fucex:463.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:463.1.text#σὲ πρῶτον ἐκβαλόντες ἐκ τῆς Ἑλλάδος.
urn:cts:greekLit:tlg0019.tlg011.fucex:464.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:464.1.text#ἔμ' ἐκβαλόντες; καὶ τί ἂν νομίζετον
urn:cts:greekLit:tlg0019.tlg011.fucex:465.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:465.1.text#κακὸν ἐργάσασθαι μεῖζον ἀνθρώπους;
urn:cts:greekLit:tlg0019.tlg011.fucex:465.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:465.2.text#ὅ τι;
urn:cts:greekLit:tlg0019.tlg011.fucex:466.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:466.1.text#εἰ τοῦτο δρᾶν μέλλοντες ἐπιλαθοίμεθα.
urn:cts:greekLit:tlg0019.tlg011.fucex:467.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:467.1.text#καὶ μὴν περὶ τούτου σφῷν ἐθέλω δοῦναι λόγον
urn:cts:greekLit:tlg0019.tlg011.fucex:468.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:468.1.text#τὸ πρῶτον αὐτοῦ· κἂν μὲν ἀποφήνω μόνην
urn:cts:greekLit:tlg0019.tlg011.fucex:469.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:469.1.text#ἀγαθῶν ἁπάντων οὖσαν αἰτίαν ἐμὲ
urn:cts:greekLit:tlg0019.tlg011.fucex:470.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:470.1.text#ὑμῖν δι' ἐμέ τε ζῶντας ὑμᾶς· εἰ δὲ μή,
urn:cts:greekLit:tlg0019.tlg011.fucex:471.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:471.1.text#ποιεῖτον ἤδη τοῦθ' ὅ τι ἂν ὑμῖν δοκῇ.
urn:cts:greekLit:tlg0019.tlg011.fucex:472.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:472.1.text#ταυτὶ σὺ τολμᾷς ὦ μιαρωτάτη λέγειν;
urn:cts:greekLit:tlg0019.tlg011.fucex:473.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:473.1.text#καὶ σύ γε διδάσκου· πάνυ γὰρ οἶμαι ῥᾳδίως
urn:cts:greekLit:tlg0019.tlg011.fucex:474.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:474.1.text#ἅπανθ' ἁμαρτάνοντά σ' ἀποδείξειν ἐγώ,
urn:cts:greekLit:tlg0019.tlg011.fucex:475.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:475.1.text#εἰ τοὺς δικαίους φῂς ποιήσειν πλουσίους.
urn:cts:greekLit:tlg0019.tlg011.fucex:476.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:476.1.text#ὦ τύμπανα καὶ κύφωνες οὐκ ἀρήξετε;
urn:cts:greekLit:tlg0019.tlg011.fucex:477.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:477.1.text#οὐ δεῖ σχετλιάζειν καὶ βοᾶν πρὶν ἂν μάθῃς.
urn:cts:greekLit:tlg0019.tlg011.fucex:478.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:478.1.text#καὶ τίς δύναιτ' ἂν μὴ βοᾶν "ἰοὺ ἰοὺ"
urn:cts:greekLit:tlg0019.tlg011.fucex:479.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:479.1.text#τοιαῦτ' ἀκούων;
urn:cts:greekLit:tlg0019.tlg011.fucex:479.2.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:479.2.text#ὅστις ἐστὶν εὖ φρονῶν.
urn:cts:greekLit:tlg0019.tlg011.fucex:480.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:480.1.text#τί δῆτά σοι τίμημ' ἐπιγράψω τῇ δίκῃ,
urn:cts:greekLit:tlg0019.tlg011.fucex:481.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:481.1.text#ἐὰν ἁλῷς;
urn:cts:greekLit:tlg0019.tlg011.fucex:481.2.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:481.2.text#ὅ τι σοι δοκεῖ.
urn:cts:greekLit:tlg0019.tlg011.fucex:481.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:481.3.text#καλῶς λέγεις.
urn:cts:greekLit:tlg0019.tlg011.fucex:482.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:482.1.text#τὸ γὰρ αὔτ', ἐὰν ἡττᾶσθε, καὶ σφὼ δεῖ παθεῖν.
urn:cts:greekLit:tlg0019.tlg011.fucex:483.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:483.1.text#ἱκανοὺς νομίζεις δῆτα θανάτους εἴκοσιν;
urn:cts:greekLit:tlg0019.tlg011.fucex:484.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:484.1.text#ταύτῃ γε· νῷν δὲ δὔ ἀποχρήσουσιν μόνω.
urn:cts:greekLit:tlg0019.tlg011.fucex:485.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:485.1.text#οὐκ ἂν φθάνοιτον τοῦτο πράττοντ', ἢ τί γ' ἂν
urn:cts:greekLit:tlg0019.tlg011.fucex:486.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:486.1.text#ἔχοι τις ἂν δίκαιον ἀντειπεῖν ἔτι;
urn:cts:greekLit:tlg0019.tlg011.fucex:487.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:487.1.text#ἀλλ' ἤδη χρῆν τι λέγειν ὑμᾶς σοφὸν ᾧ νικήσετε τηνδὶ
urn:cts:greekLit:tlg0019.tlg011.fucex:488.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:488.1.text#ἐν τοῖσι λόγοις ἀντιλέγοντες, μαλακὸν δ' ἐνδώσετε μηδέν.
urn:cts:greekLit:tlg0019.tlg011.fucex:489.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:489.1.text#φανερὸν μὲν ἔγωγ' οἶμαι γνῶναι τοῦτ' εἶναι πᾶσιν ὁμοίως,
urn:cts:greekLit:tlg0019.tlg011.fucex:490.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:490.1.text#ὅτι τοὺς χρηστοὺς τῶν ἀνθρώπων εὖ πράττειν ἐστὶ δίκαιον,
urn:cts:greekLit:tlg0019.tlg011.fucex:491.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:491.1.text#τοὺς δὲ πονηροὺς καὶ τοὺς ἀθέους τούτων τἀναντία δήπου.
urn:cts:greekLit:tlg0019.tlg011.fucex:492.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:492.1.text#τοῦτ' οὖν ἡμεῖς ἐπιθυμοῦντες μόλις ηὕρομεν, ὥστε γενέσθαι
urn:cts:greekLit:tlg0019.tlg011.fucex:493.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:493.1.text#βούλευμα καλὸν καὶ γενναῖον καὶ χρήσιμον εἰς ἅπαν ἔργον.
urn:cts:greekLit:tlg0019.tlg011.fucex:494.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:494.1.text#ἢν γὰρ ὁ Πλοῦτος νυνὶ βλέψῃ καὶ μὴ τυφλὸς ὢν περινοστῇ,
urn:cts:greekLit:tlg0019.tlg011.fucex:495.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:495.1.text#ὡς τοὺς ἀγαθοὺς τῶν ἀνθρώπων βαδιεῖται κοὐκ ἀπολείψει,
urn:cts:greekLit:tlg0019.tlg011.fucex:496.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:496.1.text#τοὺς δὲ πονηροὺς καὶ τοὺς ἀθέους φευξεῖται· κᾆτα ποιήσει
urn:cts:greekLit:tlg0019.tlg011.fucex:497.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:497.1.text#πάντας χρηστοὺς καὶ πλουτοῦντας δήπου τά τε θεῖα σέβοντας.
urn:cts:greekLit:tlg0019.tlg011.fucex:498.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:498.1.text#καίτοι τούτου τοῖς ἀνθρώποις τίς ἂν ἐξεύροι ποτ' ἄμεινον;
urn:cts:greekLit:tlg0019.tlg011.fucex:499.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:499.1.text#οὐδείς· τούτου μάρτυς ἐγώ σοι· μηδὲν ταύτην γ' ἀνερώτα.
urn:cts:greekLit:tlg0019.tlg011.fucex:500.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:500.1.text#ὡς μὲν γὰρ νῦν ἡμῖν ὁ βίος τοῖς ἀνθρώποις διάκειται,
urn:cts:greekLit:tlg0019.tlg011.fucex:501.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:501.1.text#τίς ἂν οὐχ ἡγοῖτ' εἶναι μανίαν κακοδαιμονίαν τ' ἔτι μᾶλλον;
urn:cts:greekLit:tlg0019.tlg011.fucex:502.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:502.1.text#πολλοὶ μὲν γὰρ τῶν ἀνθρώπων ὄντες πλουτοῦσι πονηροί,
urn:cts:greekLit:tlg0019.tlg011.fucex:503.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:503.1.text#ἀδίκως αὐτὰ ξυλλεξάμενοι· πολλοὶ δ' ὄντες πάνυ χρηστοὶ
urn:cts:greekLit:tlg0019.tlg011.fucex:504.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:504.1.text#πράττουσι κακῶς καὶ πεινῶσιν μετὰ σοῦ τε τὰ πλεῖστα σύνεισιν.
urn:cts:greekLit:tlg0019.tlg011.fucex:505.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:505.1.text#οὔκουν εἶναί φημ', εἰ παύσει ταύτην βλέψας ποθ' ὁ Πλοῦτος,
urn:cts:greekLit:tlg0019.tlg011.fucex:506.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:506.1.text#ὁδὸν ἥντιν' ἰὼν τοῖς ἀνθρώποις ἀγάθ' ἄν μείζω πορίσειεν.
urn:cts:greekLit:tlg0019.tlg011.fucex:507.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:507.1.text#ἀλλ' ὦ πάντων ῥᾷστ' ἀνθρώπων ἀναπεισθέντ' οὐχ ὑγιαίνειν
urn:cts:greekLit:tlg0019.tlg011.fucex:508.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:508.1.text#δύο πρεσβύτα, ξυνθιασώτα τοῦ ληρεῖν καὶ παραπαίειν,
urn:cts:greekLit:tlg0019.tlg011.fucex:509.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:509.1.text#εἰ τοῦτο γένοιθ' ὃ ποθεῖθ' ὑμεῖς, οὔ φημ' ἂν λυσιτελεῖν σφῷν.
urn:cts:greekLit:tlg0019.tlg011.fucex:510.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:510.1.text#εἰ γὰρ ὁ Πλοῦτος βλέψειε πάλιν διανείμειέν τ' ἴσον αὑτόν,
urn:cts:greekLit:tlg0019.tlg011.fucex:511.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:511.1.text#οὔτε τέχνην ἂν τῶν ἀνθρώπων οὔτ' ἂν σοφίαν μελετῴη
urn:cts:greekLit:tlg0019.tlg011.fucex:512.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:512.1.text#οὐδείς· ἀμφοῖν δ' ὑμῖν τούτοιν ἀφανισθέντοιν ἐθελήσει
urn:cts:greekLit:tlg0019.tlg011.fucex:513.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:513.1.text#τίς χαλκεύειν ἢ ναυπηγεῖν ἢ ῥάπτειν ἢ τροχοποιεῖν,
urn:cts:greekLit:tlg0019.tlg011.fucex:514.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:514.1.text#ἢ σκυτοτομεῖν ἢ πλινθουργεῖν ἢ πλύνειν ἢ σκυλοδεψεῖν,
urn:cts:greekLit:tlg0019.tlg011.fucex:515.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:515.1.text#ἢ γῆς ἀρότροις ῥήξας δάπεδον καρπὸν Δηοῦς θερίσασθαι,
urn:cts:greekLit:tlg0019.tlg011.fucex:516.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:516.1.text#ἢν ἐξῇ ζῆν ἀργοῖς ὑμῖν πάντων ἀμελοῦσιν;
urn:cts:greekLit:tlg0019.tlg011.fucex:517.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:517.1.text#λῆρον ληρεῖς. ταῦτα γὰρ ἡμῖν πάνθ' ὅσα νῦν δὴ κατέλεξας
urn:cts:greekLit:tlg0019.tlg011.fucex:518.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:518.1.text#οἱ θεράποντες μοχθήσουσιν.
urn:cts:greekLit:tlg0019.tlg011.fucex:518.2.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:518.2.text#πόθεν οὖν ἕξεις θεράποντας;
urn:cts:greekLit:tlg0019.tlg011.fucex:519.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:519.1.text#ὠνησόμεθ' ἀργυρίου δήπου.
urn:cts:greekLit:tlg0019.tlg011.fucex:519.2.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:519.2.text#τίς δ' ἔσται πρῶτον ὁ πωλῶν,
urn:cts:greekLit:tlg0019.tlg011.fucex:520.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:520.1.text#ὅταν ἀργύριον κἀκεῖνος ἔχῃ;
urn:cts:greekLit:tlg0019.tlg011.fucex:520.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:520.2.text#κερδαίνειν βουλόμενός τις
urn:cts:greekLit:tlg0019.tlg011.fucex:521.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:521.1.text#ἔμπορος ἥκων ἐκ Θετταλίας παρὰ πλείστων ἀνδραποδιστῶν.
urn:cts:greekLit:tlg0019.tlg011.fucex:522.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:522.1.text#ἀλλ' οὐδ' ἔσται πρῶτον ἁπάντων οὐδεὶς οὐδ' ἀνδραποδιστὴς
urn:cts:greekLit:tlg0019.tlg011.fucex:523.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:523.1.text#κατὰ τὸν λόγον ὃν σὺ λέγεις δήπου. τίς γὰρ πλουτῶν ἐθελήσει
urn:cts:greekLit:tlg0019.tlg011.fucex:524.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:524.1.text#κινδυνεύων περὶ τῆς ψυχῆς τῆς αὑτοῦ τοῦτο ποιῆσαι;
urn:cts:greekLit:tlg0019.tlg011.fucex:525.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:525.1.text#ὥστ' αὐτὸς ἀροῦν ἐπαναγκασθεὶς καὶ σκάπτειν τἄλλα τε μοχθεῖν
urn:cts:greekLit:tlg0019.tlg011.fucex:526.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:526.1.text#ὀδυνηρότερον τρίψεις βίοτον πολὺ τοῦ νῦν.
urn:cts:greekLit:tlg0019.tlg011.fucex:526.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:526.2.text#ἐς κεφαλὴν σοί.
urn:cts:greekLit:tlg0019.tlg011.fucex:527.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:527.1.text#ἔτι δ' οὐχ ἕξεις οὔτ' ἐν κλίνῃ καταδαρθεῖν, οὐ γὰρ ἔσονται,
urn:cts:greekLit:tlg0019.tlg011.fucex:528.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:528.1.text#οὔτ' ἐν δάπισιν· τίς γὰρ ὑφαίνειν ἐθελήσει χρυσίου ὄντος;
urn:cts:greekLit:tlg0019.tlg011.fucex:529.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:529.1.text#οὔτε μύροισιν μυρίσαι στακτοῖς ὁπόταν νύμφην ἀγάγησθον.
urn:cts:greekLit:tlg0019.tlg011.fucex:530.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:530.1.text#οὔθ' ἱματίων βαπτῶν δαπάναις κοσμῆσαι ποικιλομόρφων.
urn:cts:greekLit:tlg0019.tlg011.fucex:531.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:531.1.text#καίτοι τί πλέον πλουτεῖν ἐστιν τούτων πάντων ἀποροῦντας;
urn:cts:greekLit:tlg0019.tlg011.fucex:532.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:532.1.text#παρ' ἐμοῦ δ' ἔστιν ταῦτ' εὔπορα πάνθ' ὑμῖν ὧν δείσθον· ἐγὼ γὰρ
urn:cts:greekLit:tlg0019.tlg011.fucex:533.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:533.1.text#τὸν χειροτέχνην ὥσπερ δέσποιν' ἐπαναγκάζουσα κάθημαι
urn:cts:greekLit:tlg0019.tlg011.fucex:534.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:534.1.text#διὰ τὴν χρείαν καὶ τὴν πενίαν ζητεῖν ὁπόθεν βίον ἕξει.
urn:cts:greekLit:tlg0019.tlg011.fucex:535.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:535.1.text#σὺ γὰρ ἂν πορίσαι τί δύναι' ἀγαθὸν φῴδων ἐκ βαλανείου
urn:cts:greekLit:tlg0019.tlg011.fucex:536.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:536.1.text#καὶ παιδαρίων ὑποπεινώντων καὶ γραι·δίων κολοσυρτόν;
urn:cts:greekLit:tlg0019.tlg011.fucex:537.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:537.1.text#φθειρῶν τ' ἀριθμὸν καὶ κωνώπων καὶ ψυλλῶν οὐδὲ λέγω σοι
urn:cts:greekLit:tlg0019.tlg011.fucex:538.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:538.1.text#ὑπὸ τοῦ πλήθους, αἳ βομβοῦσαι περὶ τὴν κεφαλὴν ἀνιῶσιν,
urn:cts:greekLit:tlg0019.tlg011.fucex:539.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:539.1.text#ἐπεγείρουσαι καὶ φράζουσαι, "πεινήσεις, ἀλλ' ἐπανίστω."
urn:cts:greekLit:tlg0019.tlg011.fucex:540.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:540.1.text#πρὸς δέ γε τούτοις ἀνθ' ἱματίου μὲν ἔχειν ῥάκος· ἀντὶ δὲ κλίνης
urn:cts:greekLit:tlg0019.tlg011.fucex:541.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:541.1.text#στιβάδα σχοίνων κόρεων μεστήν, ἣ τοὺς εὕδοντας ἐγείρει·
urn:cts:greekLit:tlg0019.tlg011.fucex:542.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:542.1.text#καὶ φορμὸν ἔχειν ἀντὶ τάπητος σαπρόν· ἀντὶ δὲ προσκεφαλαίου
urn:cts:greekLit:tlg0019.tlg011.fucex:543.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:543.1.text#λίθον ἐυμεγέθη πρὸς τῇ κεφαλῇ· σιτεῖσθαι δ' ἀντὶ μὲν ἄρτων
urn:cts:greekLit:tlg0019.tlg011.fucex:544.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:544.1.text#μαλάχης πτόρθους, ἀντὶ δὲ μάζης φυλλεῖ' ἰσχνῶν ῥαφανίδων,
urn:cts:greekLit:tlg0019.tlg011.fucex:545.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:545.1.text#ἀντὶ δὲ θράνους στάμνου κεφαλὴν κατεαγότος, ἀντὶ δὲ μάκτρας
urn:cts:greekLit:tlg0019.tlg011.fucex:546.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:546.1.text#φιδάκνης πλευρὰν ἐρρωγυῖαν καὶ ταύτην. ἆρά γε πολλῶν
urn:cts:greekLit:tlg0019.tlg011.fucex:547.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:547.1.text#ἀγαθῶν πᾶσιν τοῖς ἀνθρὠποις ἀποφαίνω σ' αἴτιον οὖσαν;
urn:cts:greekLit:tlg0019.tlg011.fucex:548.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:548.1.text#σὺ μὲν οὐ τὸν ἐμὸν βίον εἴρηκας, τὸν τῶν πτωχῶν δ' ὑπεκρούσω.
urn:cts:greekLit:tlg0019.tlg011.fucex:549.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:549.1.text#οὐκοῦν δήπου τῆς Πτωχείας Πενίαν φαμὲν εἶναι ἀδελφήν.
urn:cts:greekLit:tlg0019.tlg011.fucex:550.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:550.1.text#ὑμεῖς γ' οἵπερ καὶ Θρασυβούλῳ Διονύσιον εἶναι ὅμοιον.
urn:cts:greekLit:tlg0019.tlg011.fucex:551.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:551.1.text#ἀλλ' οὐχ οὑμὸς τοῦτο πέπονθεν βίος οὐ μὰ Δί', οὐδέ γε μέλλει.
urn:cts:greekLit:tlg0019.tlg011.fucex:552.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:552.1.text#πτωχοῦ μὲν γὰρ βίος, ὃν σὺ λέγεις, ζῆν ἐστιν μηδὲν ἔχοντα·
urn:cts:greekLit:tlg0019.tlg011.fucex:553.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:553.1.text#τοῦ δὲ πένητος ζῆν φειδόμενον καὶ τοῖς ἔργοις προς έχοντα,
urn:cts:greekLit:tlg0019.tlg011.fucex:554.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:554.1.text#περιγίγνεσθαι δ' αὐτῷ μηδέν, μὴ μέντοι μηδ' ἐπιλείπειν.
urn:cts:greekLit:tlg0019.tlg011.fucex:555.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:555.1.text#ὡς μακαρίτην ὦ Δάματερ τὸν βίον αὐτοῦ κατέλεξας,
urn:cts:greekLit:tlg0019.tlg011.fucex:556.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:556.1.text#εἰ φεισάμενος καὶ μοχθήσας καταλείψει μηδὲ ταφῆναι.
urn:cts:greekLit:tlg0019.tlg011.fucex:557.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:557.1.text#σκώπτειν πειρᾷ καὶ κωμῳδεῖν τοῦ σπουδάζειν ἀμελήσας,
urn:cts:greekLit:tlg0019.tlg011.fucex:558.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:558.1.text#οὐ γιγνώσκων ὅτι τοῦ Πλούτου παρέχω βελτίονας ἄνδρας
urn:cts:greekLit:tlg0019.tlg011.fucex:559.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:559.1.text#καὶ τὴν γνώμην καὶ τὴν ἰδέαν. παρὰ τῷ μὲν γὰρ ποδαγρῶντες
urn:cts:greekLit:tlg0019.tlg011.fucex:560.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:560.1.text#καὶ γαστρώδεις καὶ παχύκνημοι καὶ πίονές εἰσιν ἀσελγῶς,
urn:cts:greekLit:tlg0019.tlg011.fucex:561.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:561.1.text#παρ' ἐμοὶ δ' ἰσχνοὶ καὶ σφηκώδεις καὶ τοῖς ἐχθροῖς ἀνιαροί.
urn:cts:greekLit:tlg0019.tlg011.fucex:562.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:562.1.text#ἀπὸ τοῦ λιμοῦ γὰρ ἴσως αὐτοῖς τὸ σφηκῶδες σὺ πορίζεις.
urn:cts:greekLit:tlg0019.tlg011.fucex:563.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:563.1.text#περὶ σωφροσύνης ἤδη τοίνυν περανῶ σφῷν κἀναδιδάξω
urn:cts:greekLit:tlg0019.tlg011.fucex:564.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:564.1.text#ὅτι κοσμιότης οἰκεῖ μετ' ἐμοῦ, τοῦ Πλούτου δ' ἐστὶι ὑβρίζειν.
urn:cts:greekLit:tlg0019.tlg011.fucex:565.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:565.1.text#πάνυ γοῦν κλέπτειν κόσμιόν ἐστιν καὶ τοὺς τοίχους διορύττειν.
urn:cts:greekLit:tlg0019.tlg011.fucex:566.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:566.1.text#†νὴ τὸν Δί', εἰ δεῖ λαθεῖν αὐτόν, πῶς οὐχὶ κόσμιόν ἐστι;†
urn:cts:greekLit:tlg0019.tlg011.fucex:567.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:567.1.text#σκέψαι τοίνυν ἐν ταῖς πόλεσιν τοὺς ῥήτορας, ὡς ὁπόταν μὲν
urn:cts:greekLit:tlg0019.tlg011.fucex:568.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:568.1.text#ὦσι πένητες, περὶ τὸν δῆμον καὶ τὴν πόλιν εἰσὶ δίκαιοι,
urn:cts:greekLit:tlg0019.tlg011.fucex:569.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:569.1.text#πλουτήσαντες δ' ἀπὸ τῶν κοινῶν παραχρῆμ' ἄδικοι γεγένηνται,
urn:cts:greekLit:tlg0019.tlg011.fucex:570.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:570.1.text#ἐπιβουλεύουσί τε τῷ πλήθει καὶ τῷ δήμῳ πολεμοῦσιν.
urn:cts:greekLit:tlg0019.tlg011.fucex:571.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:571.1.text#ἀλλ' οὐ ψεύδει τούτων γ' οὐδέν, καίπερ σφόδρα βάσκανος οὖσα.
urn:cts:greekLit:tlg0019.tlg011.fucex:572.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:572.1.text#ἀτὰρ οὐχ ἧττόν γ' οὐδὲν κλαύσει, μηδὲν ταύτῃ γε κομήσῃς,
urn:cts:greekLit:tlg0019.tlg011.fucex:573.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:573.1.text#ὁτιὴ ζητεῖς τοῦτ' ἀναπείθειν ἡμᾶς, ὡς ἔστιν ἄμεινον
urn:cts:greekLit:tlg0019.tlg011.fucex:574.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:574.1.text#Πενία Πλούτου.
urn:cts:greekLit:tlg0019.tlg011.fucex:574.2.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:574.2.text#καὶ σύ γ' ἐλέγξαι μ' οὔπω δύνασαι περὶ τούτου,
urn:cts:greekLit:tlg0019.tlg011.fucex:575.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:575.1.text#ἀλλὰ φλυαρεῖς καὶ πτερυγίζεις.
urn:cts:greekLit:tlg0019.tlg011.fucex:575.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:575.2.text#καὶ πῶς φεύγουσί σ' ἅπαντες;
urn:cts:greekLit:tlg0019.tlg011.fucex:576.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:576.1.text#ὅτι βελτίους αὐτοὺς ποιῶ. σκέψασθαι δ' ἔστι μάλιστα
urn:cts:greekLit:tlg0019.tlg011.fucex:577.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:577.1.text#ἀπὸ τῶν παίδων· τοὺς γὰρ πατέρας φεύγουσι φρονοῦντας ἄριστα
urn:cts:greekLit:tlg0019.tlg011.fucex:578.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:578.1.text#αὐτοῖς. οὕτω διαγιγνώσκειν χαλεπὸν πρᾶγμ' ἐστὶ δίκαιον.
urn:cts:greekLit:tlg0019.tlg011.fucex:579.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:579.1.text#τὸν Δία φήσεις ἆρ' οὐκ ὀρθῶς διαγιγνώσκειν τὸ κράτιστον·
urn:cts:greekLit:tlg0019.tlg011.fucex:580.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:580.1.text#κἀκεῖνος γὰρ τὸν Πλοῦτον ἔχει.
urn:cts:greekLit:tlg0019.tlg011.fucex:581.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:581.1.text#ταύτην δ' ἡμῖν ἀποπέμπει.
urn:cts:greekLit:tlg0019.tlg011.fucex:581.2.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:581.2.text#ἀλλ' ὦ Κρονικαῖς λήμαις ὄντως λημῶντες τὰς φρένας ἄμφω,
urn:cts:greekLit:tlg0019.tlg011.fucex:582.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:582.1.text#ὁ Ζεὺς δήπου πένεται, καὶ τοῦτ' ἤδη φανερῶς σε διδάξω.
urn:cts:greekLit:tlg0019.tlg011.fucex:583.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:583.1.text#εἰ γὰρ ἐπλούτει, πῶς ἂν ποιῶν τὸν Ὀλυμπικὸν αὐτὸς ἀγῶνα
urn:cts:greekLit:tlg0019.tlg011.fucex:584.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:584.1.text#ἵνα τοὺς Ἕλληνας ἅπαντας ἀεὶ δι' ἔτους πέμπτου ξυναγείρει,
urn:cts:greekLit:tlg0019.tlg011.fucex:585.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:585.1.text#ἀνεκήρυττεν τῶν ἀσκητῶν τοὺς νικῶντας στεφανώσας
urn:cts:greekLit:tlg0019.tlg011.fucex:586.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:586.1.text#κοτίνου στεφάνῳ; καίτοι χρυσῷ μᾶλλον ἐχρῆν, εἴπερ ἐπλούτει.
urn:cts:greekLit:tlg0019.tlg011.fucex:587.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:587.1.text#οὐκοῦν τούτῳ δήπου δηλοῖ τιμῶν τὸν Πλοῦτον ἐκεῖνος·
urn:cts:greekLit:tlg0019.tlg011.fucex:588.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:588.1.text#φειδόμενος γὰρ καὶ βουλόμενος τούτου μηδὲν δαπανᾶσθαι,
urn:cts:greekLit:tlg0019.tlg011.fucex:589.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:589.1.text#λήροις ἀναδῶν τοὺς νικῶντας τὸν Πλοῦτον ἐᾷ παρ' ἑαυτῷ.
urn:cts:greekLit:tlg0019.tlg011.fucex:590.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:590.1.text#πολὺ τῆς Πενίας πρᾶγμ' αἴσχιον ζητεῖς αὐτῷ περιάψαι,
urn:cts:greekLit:tlg0019.tlg011.fucex:591.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:591.1.text#εἰ πλούσιος ὢν ἀνελεύθερός ἐσθ' οὑτωσὶ καὶ φιλοκερδής.
urn:cts:greekLit:tlg0019.tlg011.fucex:592.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:592.1.text#ἀλλὰ σέ γ' ὁ Ζεὺς ἐξολέσειεν κοτίνου στεφάνῳ στεφανώσας.
urn:cts:greekLit:tlg0019.tlg011.fucex:593.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:593.1.text#τὸ γὰρ ἀντιλέγειν τολμᾶν ὑμᾶς ὡς οὐ πάντ' ἔστ' ἀγάθ' ὑμῖν
urn:cts:greekLit:tlg0019.tlg011.fucex:594.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:594.1.text#διὰ τὴν Πενίαν.
urn:cts:greekLit:tlg0019.tlg011.fucex:594.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:594.2.text#παρὰ τῆς Ἑκάτης ἔξεστιν τοῦτο πυθέσθαι,
urn:cts:greekLit:tlg0019.tlg011.fucex:595.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:595.1.text#εἴτε τὸ πλουτεῖν εἴτε τὸ πεινῆν βέλτιον. φησὶ γὰρ αὕτη
urn:cts:greekLit:tlg0019.tlg011.fucex:596.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:596.1.text#τοὺς μὲν ἔχοντας καὶ πλουτοῦντας δεῖπνον κατὰ μῆν' ἀποπέμπειν,
urn:cts:greekLit:tlg0019.tlg011.fucex:597.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:597.1.text#τοὺς δὲ πένητας τῶν ἀνθρώπων ἁρπάζειν πρὶν καταθεῖναι.
urn:cts:greekLit:tlg0019.tlg011.fucex:598.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:598.1.text#ἀλλὰ φθείρου καὶ μὴ γρύξῃς
urn:cts:greekLit:tlg0019.tlg011.fucex:599.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:599.1.text#ἔτι μηδ' ὁτιοῦν.
urn:cts:greekLit:tlg0019.tlg011.fucex:600.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:600.1.text#οὐ γὰρ πείσεις, οὐδ' ἢν πείσῃς.
urn:cts:greekLit:tlg0019.tlg011.fucex:601.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:601.1.text#ὦ πόλις Ἄργους, κλύεθ' οἷα λέγει.
urn:cts:greekLit:tlg0019.tlg011.fucex:602.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:602.1.text#Παύσωνα κάλει τὸν ξύσσιτον.
urn:cts:greekLit:tlg0019.tlg011.fucex:603.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:603.1.text#τί πάθω τλήμων;
urn:cts:greekLit:tlg0019.tlg011.fucex:604.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:604.1.text#ἔρρ' ἐς κόρακας θᾶττον ἀφ' ἡμῶν.
urn:cts:greekLit:tlg0019.tlg011.fucex:605.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:605.1.text#εἶμι δὲ ποῖ γῆς;
urn:cts:greekLit:tlg0019.tlg011.fucex:606.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:606.1.text#ἐς τὸν κύφων'· ἀλλ' οὐ μέλλειν
urn:cts:greekLit:tlg0019.tlg011.fucex:607.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:607.1.text#χρῆν σ', ἀλλ' ἀνύειν.
urn:cts:greekLit:tlg0019.tlg011.fucex:608.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:608.1.text#ἦ μὴν ὑμεῖς γ' ἔτι μ' ἐνταυθοῖ
urn:cts:greekLit:tlg0019.tlg011.fucex:609.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.fucex:609.1.text#μεταπέμψεσθον.
urn:cts:greekLit:tlg0019.tlg011.fucex:610.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:610.1.text#τότε νοστήσεις· νῦν δὲ φθείρου.
urn:cts:greekLit:tlg0019.tlg011.fucex:611.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:611.1.text#κρεῖττον γάρ μοι πλουτεῖν ἐστίν,
urn:cts:greekLit:tlg0019.tlg011.fucex:612.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:612.1.text#σὲ δ' ἐᾶν κλάειν μακρὰ τὴν κεφαλήν.
urn:cts:greekLit:tlg0019.tlg011.fucex:613.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:613.1.text#νὴ Δί' ἐγὼ γοῦν ἐθέλω πλουτῶν
urn:cts:greekLit:tlg0019.tlg011.fucex:614.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:614.1.text#εὐωχεῖσθαι μετὰ τῶν παίδων
urn:cts:greekLit:tlg0019.tlg011.fucex:615.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:615.1.text#τῆς τε γυναικός, καὶ λουσάμενος
urn:cts:greekLit:tlg0019.tlg011.fucex:616.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:616.1.text#λιπαρὸς χωρῶν ἐκ βαλανείου
urn:cts:greekLit:tlg0019.tlg011.fucex:617.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:617.1.text#τῶν χειροτεχνῶν
urn:cts:greekLit:tlg0019.tlg011.fucex:618.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:618.1.text#καὶ τῆς Πενίας καταπαρδεῖν.
urn:cts:greekLit:tlg0019.tlg011.fucex:619.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:619.1.text#αὕτη μὲν ἡμῖν ἡπίτριπτος οἴχεται.
urn:cts:greekLit:tlg0019.tlg011.fucex:620.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:620.1.text#ἐγὼ δὲ καὶ σύ γ' ὡς τάχιστα τὸν θεὸν
urn:cts:greekLit:tlg0019.tlg011.fucex:621.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:621.1.text#ἐγκατακλινοῦντ' ἄγωμεν εἰς Ἀσκληπιοῦ.
urn:cts:greekLit:tlg0019.tlg011.fucex:622.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:622.1.text#καὶ μὴ διατρίβωμέν γε, μὴ πάλιν τις αὖ
urn:cts:greekLit:tlg0019.tlg011.fucex:623.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.fucex:623.1.text#ἐλθὼν διακωλύσῃ τι τῶν προὔργου ποιεῖν.
urn:cts:greekLit:tlg0019.tlg011.fucex:624.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:624.1.text#παῖ Καρίων τὰ στρώματ' ἐκφέρειν σ' ἐχρῆν
urn:cts:greekLit:tlg0019.tlg011.fucex:625.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:625.1.text#αὐτόν τ' ἄγειν τὸν Πλοῦτον, ὡς νομίζεται,
urn:cts:greekLit:tlg0019.tlg011.fucex:626.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:626.1.text#καὶ τἄλλ' ὅσ' ἐστὶν ἔνδον ηὐτρεπισμένα.
urn:cts:greekLit:tlg0019.tlg011.fucex:627.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:627.1.text#ὦ πλεῖστα Θησείοις μεμυστιλημένοι
urn:cts:greekLit:tlg0019.tlg011.fucex:628.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:628.1.text#γέροντες ἄνδρες ἐπ' ὀλιγίστοις ἀλφίτοις,
urn:cts:greekLit:tlg0019.tlg011.fucex:629.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:629.1.text#ὡς εὐτυχεῖθ', ὡς μακαρίως πεπράγατε,
urn:cts:greekLit:tlg0019.tlg011.fucex:630.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:630.1.text#ἄλλοι θ' ὅσοις μέτεστι τοῦ χρηστοῦ τρόπου.
urn:cts:greekLit:tlg0019.tlg011.fucex:631.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:631.1.text#τί δ' ἔστιν ὦ βέλτιστε τῶν σαυτοῦ φίλων;
urn:cts:greekLit:tlg0019.tlg011.fucex:632.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:632.1.text#φαίνει γὰρ ἥκειν ἄγγελος χρηστοῦ τινος.
urn:cts:greekLit:tlg0019.tlg011.fucex:633.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:633.1.text#ὁ δεσπότης πέπραγεν εὐτυχέστατα,
urn:cts:greekLit:tlg0019.tlg011.fucex:634.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:634.1.text#μᾶλλον δ' ὁ Πλοῦτος αὐτός· ἀντὶ γὰρ τυφλοῦ
urn:cts:greekLit:tlg0019.tlg011.fucex:635.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:635.1.text#ἐξωμμάτωται καὶ λελάμπρυνται κόρας,
urn:cts:greekLit:tlg0019.tlg011.fucex:636.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:636.1.text#Ἀσκληπιοῦ παιῶνος εὐμενοῦς τυχών.
urn:cts:greekLit:tlg0019.tlg011.fucex:637.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:637.1.text#λέγεις μοι χαράν, λέγεις μοι βοάν.
urn:cts:greekLit:tlg0019.tlg011.fucex:638.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:638.1.text#πάρεστι χαίρειν, ἤν τε βούλησθ' ἤν τε μή.
urn:cts:greekLit:tlg0019.tlg011.fucex:639.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:639.1.text#ἀναβοάσομαι τὸν εὔπαιδα καὶ
urn:cts:greekLit:tlg0019.tlg011.fucex:640.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:640.1.text#μέγα βροτοῖσι φέγγος Ἀσκληπιόν.
urn:cts:greekLit:tlg0019.tlg011.fucex:641.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:641.1.text#τίς ἡ βοή ποτ' ἐστίν; ἆρ' ἀγγέλλεται
urn:cts:greekLit:tlg0019.tlg011.fucex:642.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:642.1.text#χρηστόν τι; τοῦτο γὰρ ποθοῦσ' ἐγὼ πάλαι
urn:cts:greekLit:tlg0019.tlg011.fucex:643.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:643.1.text#ἔνδον κάθημαι περιμένουσα τουτονί.
urn:cts:greekLit:tlg0019.tlg011.fucex:644.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:644.1.text#ταχέως ταχέως φέρ' οἶνον ὦ δέσποιν', ἵνα
urn:cts:greekLit:tlg0019.tlg011.fucex:645.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:645.1.text#καὐτὴ πίῃς· φιλεῖς δὲ δρῶσ' αὐτὸ σφόδρα·
urn:cts:greekLit:tlg0019.tlg011.fucex:646.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:646.1.text#ὡς ἀγαθὰ συλλήβδην ἅπαντά σοι φέρω.
urn:cts:greekLit:tlg0019.tlg011.fucex:647.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:647.1.text#καὶ ποῦ στιν;
urn:cts:greekLit:tlg0019.tlg011.fucex:647.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:647.2.text#ἐν τοῖς λεγομένοις εἴσει τάχα.
urn:cts:greekLit:tlg0019.tlg011.fucex:648.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:648.1.text#πέραινε τοίνυν ὅ τι λέγεις ἀνύσας ποτέ.
urn:cts:greekLit:tlg0019.tlg011.fucex:649.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:649.1.text#ἄκουε τοίνυν, ὡς ἐγὼ τὰ πράγματα
urn:cts:greekLit:tlg0019.tlg011.fucex:650.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:650.1.text#ἐκ τῶν ποδῶν ἐς τὴν κεφαλήν σοι πάντ' ἐρῶ.
urn:cts:greekLit:tlg0019.tlg011.fucex:651.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:651.1.text#μὴ δῆτ' ἔμοιγ' ἐς τὴν κεφαλήν.
urn:cts:greekLit:tlg0019.tlg011.fucex:651.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:651.2.text#μὴ τἀγαθὰ
urn:cts:greekLit:tlg0019.tlg011.fucex:652.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:652.1.text#ἃ νῦν γεγένηται;
urn:cts:greekLit:tlg0019.tlg011.fucex:652.2.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:652.2.text#μὴ μὲν οὖν τὰ πράγματα.
urn:cts:greekLit:tlg0019.tlg011.fucex:653.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:653.1.text#ὡς γὰρ τάχιστ' ἀφικόμεθα πρὸς τὸν θεὸν
urn:cts:greekLit:tlg0019.tlg011.fucex:654.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:654.1.text#ἄγοντες ἄνδρα τότε μὲν ἀθλιώτατον
urn:cts:greekLit:tlg0019.tlg011.fucex:655.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:655.1.text#νῦν δ' εἴ τιν' ἄλλον μακάριον κεὐδαίμονα,
urn:cts:greekLit:tlg0019.tlg011.fucex:656.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:656.1.text#πρῶτον μὲν αὐτὸν ἐπὶ θάλατταν ἤγομεν,
urn:cts:greekLit:tlg0019.tlg011.fucex:657.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:657.1.text#ἔπειτ' ἐλοῦμεν.
urn:cts:greekLit:tlg0019.tlg011.fucex:657.2.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:657.2.text#νὴ Δί' εὐδαίμων ἄρ' ἦν
urn:cts:greekLit:tlg0019.tlg011.fucex:658.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:658.1.text#ἀνὴρ γέρων ψυχρᾷ θαλάττῃ λούμενος.
urn:cts:greekLit:tlg0019.tlg011.fucex:659.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:659.1.text#ἔπειτα πρὸς τὸ τέμενος ᾖμεν τοῦ θεοῦ.
urn:cts:greekLit:tlg0019.tlg011.fucex:660.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:660.1.text#ἐπεὶ δὲ βωμῷ πόπανα καὶ προθύματα
urn:cts:greekLit:tlg0019.tlg011.fucex:661.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:661.1.text#καθωσιώθη πέλανος Ἡφαίστου φλογί,
urn:cts:greekLit:tlg0019.tlg011.fucex:662.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:662.1.text#κατεκλίναμεν τὸν Πλοῦτον, ὥσπερ εἰκὸς ἦν·
urn:cts:greekLit:tlg0019.tlg011.fucex:663.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:663.1.text#ἡμῶν δ' ἕκαστος στιβάδα παρεκαττύετο.
urn:cts:greekLit:tlg0019.tlg011.fucex:664.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:664.1.text#ἦσαν δέ τινες κἄλλοι δεόμενοι τοῦ θεοῦ;
urn:cts:greekLit:tlg0019.tlg011.fucex:665.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:665.1.text#εἷς μέν γε Νεοκλείδης, ὅς ἐστι μὲν τυφλός,
urn:cts:greekLit:tlg0019.tlg011.fucex:666.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:666.1.text#κλέπτων δὲ τοὺς βλέποντας ὑπερηκόντικεν·
urn:cts:greekLit:tlg0019.tlg011.fucex:667.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:667.1.text#ἕτεροί τε πολλοὶ παντοδαπὰ νοσήματα
urn:cts:greekLit:tlg0019.tlg011.fucex:668.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:668.1.text#ἔχοντες· ὡς δὲ τοὺς λύχνους ἀποσβέσας
urn:cts:greekLit:tlg0019.tlg011.fucex:669.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:669.1.text#ἡμῖν παρήγγειλεν καθεύδειν τοῦ θεοῦ
urn:cts:greekLit:tlg0019.tlg011.fucex:670.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:670.1.text#ὁ πρόπολος, εἰπών, ἤν τις αἴσθηται ψόφου
urn:cts:greekLit:tlg0019.tlg011.fucex:671.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:671.1.text#σιγᾶν, ἅπαντες κοσμίως κατεκείμεθα.
urn:cts:greekLit:tlg0019.tlg011.fucex:672.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:672.1.text#κἀγὼ καθεύδειν οὐκ ἐδυνάμην, ἀλλά με
urn:cts:greekLit:tlg0019.tlg011.fucex:673.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:673.1.text#ἀθάρης χύτρα τις ἐξέπληττε κειμένη
urn:cts:greekLit:tlg0019.tlg011.fucex:674.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:674.1.text#ὀλίγον ἄπωθεν τῆς κεφαλῆς του γρᾳδίου,
urn:cts:greekLit:tlg0019.tlg011.fucex:675.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:675.1.text#ἐφ' ἣν ἐπεθύμουν δαιμονίως ἐφερπύσαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:676.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:676.1.text#ἔπειτ' ἀναβλέψας ὁρῶ τὸν ἱερέα
urn:cts:greekLit:tlg0019.tlg011.fucex:677.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:677.1.text#τοὺς φθοῖς ἀφαρπάζοντα καὶ τὰς ἰσχάδας
urn:cts:greekLit:tlg0019.tlg011.fucex:678.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:678.1.text#ἀπὸ τῆς τραπέζης τῆς ἱερᾶς· μετὰ τοῦτο δὲ
urn:cts:greekLit:tlg0019.tlg011.fucex:679.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:679.1.text#περιῆλθε τοὺς βωμοὺς ἅπαντας ἐν κύκλῳ,
urn:cts:greekLit:tlg0019.tlg011.fucex:680.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:680.1.text#εἴ που πόπανον εἴη τι καταλελειμμένον·
urn:cts:greekLit:tlg0019.tlg011.fucex:681.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:681.1.text#ἔπειτα ταῦθ' ἥγιζεν ἐς σάκταν τινά.
urn:cts:greekLit:tlg0019.tlg011.fucex:682.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:682.1.text#κἀγὼ νομίσας πολλὴν ὁσίαν τοῦ πράγματος
urn:cts:greekLit:tlg0019.tlg011.fucex:683.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:683.1.text#ἐπὶ τὴν χύτραν τῆς ἀθάρης ἀνίσταμαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:684.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:684.1.text#ταλάντατ' ἀνδρῶν οὐκ ἐδεδοίκεις τὸν θεόν;
urn:cts:greekLit:tlg0019.tlg011.fucex:685.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:685.1.text#νὴ τοὺς θεοὺς ἔγωγε μὴ φθάσειέ με
urn:cts:greekLit:tlg0019.tlg011.fucex:686.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:686.1.text#ἐπὶ τὴν χύτραν ἐλθὼν ἔχων τὰ στέμματα·
urn:cts:greekLit:tlg0019.tlg011.fucex:687.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:687.1.text#ὁ γὰρ ἱερεὺς αὐτοῦ με προὐδιδάξατο.
urn:cts:greekLit:tlg0019.tlg011.fucex:688.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:688.1.text#τὸ γρᾴδιον δ' ὡς ᾔσθετο δή μου τὸν ψόφον,
urn:cts:greekLit:tlg0019.tlg011.fucex:689.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:689.1.text#ἄρασ' ὑφῄρει· κᾆτα συρίξας ἐγὼ
urn:cts:greekLit:tlg0019.tlg011.fucex:690.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:690.1.text#ὀδὰξ ἐλαβόμην ὡς παρείας ὢν ὄφις.
urn:cts:greekLit:tlg0019.tlg011.fucex:691.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:691.1.text#ἡ δ' εὐθέως τὴν χεῖρα πάλιν ἀνέσπασεν,
urn:cts:greekLit:tlg0019.tlg011.fucex:692.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:692.1.text#κατέκειτο δ' αὑτὴν ἐντυλίξασ' ἡσυχῇ
urn:cts:greekLit:tlg0019.tlg011.fucex:693.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:693.1.text#ὑπὸ τοῦ δέους βδέουσα δριμύτερον γαλῆς.
urn:cts:greekLit:tlg0019.tlg011.fucex:694.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:694.1.text#κἀγὼ τότ' ἤδη τῆς ἀθάρης πολλὴν ἔφλων·
urn:cts:greekLit:tlg0019.tlg011.fucex:695.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:695.1.text#ἔπειτ' ἐπειδὴ μεστὸς ἦν, ἀνεπαλλόμην.
urn:cts:greekLit:tlg0019.tlg011.fucex:696.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:696.1.text#ὁ δὲ θεὸς ὑμῖν οὐ προσῄειν;
urn:cts:greekLit:tlg0019.tlg011.fucex:696.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:696.2.text#οὐδέπω.
urn:cts:greekLit:tlg0019.tlg011.fucex:697.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:697.1.text#μετὰ τοῦτο δ' ἤδη καὶ γέλοιον δῆτά τι
urn:cts:greekLit:tlg0019.tlg011.fucex:698.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:698.1.text#ἐποίησα. προσιόντος γὰρ αὐτοῦ μέγα πάνυ
urn:cts:greekLit:tlg0019.tlg011.fucex:699.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:699.1.text#ἀπέπαρδον· ἡ γαστὴρ γὰρ ἐπεφύσητό μου.
urn:cts:greekLit:tlg0019.tlg011.fucex:700.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:700.1.text#ἦ πού σε διὰ τοῦτ' εὐθὺς ἐβδελύττετο.
urn:cts:greekLit:tlg0019.tlg011.fucex:701.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:701.1.text#οὔκ, ἀλλ' Ἰασὼ μέν τις ἀκολουθοῦσ' ἅμα
urn:cts:greekLit:tlg0019.tlg011.fucex:702.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:702.1.text#ὑπηρυθρίασε χἠ Πανάκει' ἀπεστράφη
urn:cts:greekLit:tlg0019.tlg011.fucex:703.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:703.1.text#τὴν ῥῖν' ἐπιλαβοῦσ'· οὐ λιβανωτὸν γὰρ βδέω.
urn:cts:greekLit:tlg0019.tlg011.fucex:704.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:704.1.text#αὐτὸς δ' ἐκεῖνος;
urn:cts:greekLit:tlg0019.tlg011.fucex:704.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:704.2.text#οὐ μὰ Δί' οὐδ' ἐφρόντισεν.
urn:cts:greekLit:tlg0019.tlg011.fucex:705.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:705.1.text#λέγεις ἄγροικον ἄρα σύ γ' εἶναι τὸν θεόν.
urn:cts:greekLit:tlg0019.tlg011.fucex:706.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:706.1.text#μὰ Δί' οὐκ ἔγωγ', ἀλλὰ σκατοφάγον.
urn:cts:greekLit:tlg0019.tlg011.fucex:706.2.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:706.2.text#αἲ τάλαν.
urn:cts:greekLit:tlg0019.tlg011.fucex:707.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:707.1.text#μετὰ ταῦτ' ἐγὼ μὲν εὐθὺς ἐνεκαλυψάμην
urn:cts:greekLit:tlg0019.tlg011.fucex:708.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:708.1.text#δείσας, ἐκεῖνος δ' ἐν κύκλῳ τὰ νοσήματα
urn:cts:greekLit:tlg0019.tlg011.fucex:709.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:709.1.text#σκοπῶν περιῄει πάντα κοσμίως πάνυ.
urn:cts:greekLit:tlg0019.tlg011.fucex:710.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:710.1.text#ἔπειτα παῖς αὐτῷ λίθινον θυείδιον
urn:cts:greekLit:tlg0019.tlg011.fucex:711.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:711.1.text#παρέθηκε καὶ δοίδυκα καὶ κιβώτιον.
urn:cts:greekLit:tlg0019.tlg011.fucex:712.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:712.1.text#λίθινον;
urn:cts:greekLit:tlg0019.tlg011.fucex:712.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:712.2.text#μὰ Δί' οὐ δῆτ' οὐχὶ τό γε κιβώτιον.
urn:cts:greekLit:tlg0019.tlg011.fucex:713.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:713.1.text#σὺ δὲ πῶς ἑώρας ὦ κάκιστ' ἀπολούμενε,
urn:cts:greekLit:tlg0019.tlg011.fucex:714.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:714.1.text#ὃς ἐγκεκαλύφθαι φῄς;
urn:cts:greekLit:tlg0019.tlg011.fucex:714.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:714.2.text#διὰ τοῦ τριβωνίου·
urn:cts:greekLit:tlg0019.tlg011.fucex:715.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:715.1.text#ὀπὰς γὰρ εἶχεν οὐκ ὀλίγας μὰ τὸν Δία.
urn:cts:greekLit:tlg0019.tlg011.fucex:716.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:716.1.text#πρῶτον δὲ πάντων τῷ Νεοκλείδῃ φάρμακον
urn:cts:greekLit:tlg0019.tlg011.fucex:717.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:717.1.text#καταπλαστὸν ἐνεχείρησε τρίβειν, ἐμβαλὼν
urn:cts:greekLit:tlg0019.tlg011.fucex:718.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:718.1.text#σκορόδων κεφαλὰς τρεῖς Τηνίων. ἔπειτ' ἔφλα
urn:cts:greekLit:tlg0019.tlg011.fucex:719.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:719.1.text#ἐν τῇ θυείᾳ συμπαραμιγνύων ὀπὸν
urn:cts:greekLit:tlg0019.tlg011.fucex:720.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:720.1.text#καὶ σχῖνον· εἶτ' ὄξει διέμενος Σφηττίῳ
urn:cts:greekLit:tlg0019.tlg011.fucex:721.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:721.1.text#κατέπλασεν αὐτοῦ τὰ βλέφαρ' ἐκστρέψας, ἵνα
urn:cts:greekLit:tlg0019.tlg011.fucex:722.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:722.1.text#ὀδυνῷτο μᾶλλον. ὁ δὲ κεκραγὼς καὶ βοῶν
urn:cts:greekLit:tlg0019.tlg011.fucex:723.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:723.1.text#ἔφευγ' ἀνᾴξας· ὁ δὲ θεὸς γελάσας ἔφη·
urn:cts:greekLit:tlg0019.tlg011.fucex:724.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:724.1.text#"ἐνταῦθα νῦν κάθησο καταπεπλασμένος,"
urn:cts:greekLit:tlg0019.tlg011.fucex:725.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:725.1.text#"ἵν' ὑπομνύμενον παύσω σε τὰς ἐκκλησίας."
urn:cts:greekLit:tlg0019.tlg011.fucex:726.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:726.1.text#ὡς φιλόπολίς τίς ἐσθ' ὁ δαίμων καὶ σοφός.
urn:cts:greekLit:tlg0019.tlg011.fucex:727.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:727.1.text#μετὰ τοῦτο τῷ Πλούτωνι παρεκαθέζετο,
urn:cts:greekLit:tlg0019.tlg011.fucex:728.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:728.1.text#καὶ πρῶτα μὲν δὴ τῆς κεφαλῆς ἐφήψατο,
urn:cts:greekLit:tlg0019.tlg011.fucex:729.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:729.1.text#ἔπειτα καθαρὸν ἡμιτύβιον λαβὼν
urn:cts:greekLit:tlg0019.tlg011.fucex:730.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:730.1.text#τὰ βλέφαρα περιέψησεν· ἡ Πανάκεια δὲ
urn:cts:greekLit:tlg0019.tlg011.fucex:731.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:731.1.text#κατεπέτασ' αὐτοῦ τὴν κεφαλὴν φοινικίδι
urn:cts:greekLit:tlg0019.tlg011.fucex:732.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:732.1.text#καὶ πᾶν τὸ πρόσωπον· εἶθ' ὁ θεὸς ἐπόππυσεν.
urn:cts:greekLit:tlg0019.tlg011.fucex:733.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:733.1.text#ἐξῃξάτην οὖν δύο δράκοντ' ἐκ τοῦ νεὼ
urn:cts:greekLit:tlg0019.tlg011.fucex:734.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:734.1.text#ὑπερφυεῖς τὸ μέγεθος.
urn:cts:greekLit:tlg0019.tlg011.fucex:734.2.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:734.2.text#ὦ φίλοι θεοί.
urn:cts:greekLit:tlg0019.tlg011.fucex:735.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:735.1.text#τούτω δ' ὑπὸ τὴν φοινικίδ' ὑποδύνθ' ἡσυχῇ
urn:cts:greekLit:tlg0019.tlg011.fucex:736.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:736.1.text#τὰ βλέφαρα περιέλειχον, ὥς γ' ἐμοὶ δοκεῖ·
urn:cts:greekLit:tlg0019.tlg011.fucex:737.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:737.1.text#καὶ πρίν σε κοτύλας ἐκπιεῖν οἴνου δέκα,
urn:cts:greekLit:tlg0019.tlg011.fucex:738.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:738.1.text#ὁ Πλοῦτος ὦ δέσποιν' ἀνειστήκει βλέπων·
urn:cts:greekLit:tlg0019.tlg011.fucex:739.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:739.1.text#ἐγὼ δὲ τὼ χεῖρ' ἀνεκρότησ' ὑφ' ἡδονῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:740.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:740.1.text#τὸν δεσπότην τ' ἤγειρον. ὁ θεὸς δ' εὐθέως
urn:cts:greekLit:tlg0019.tlg011.fucex:741.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:741.1.text#ἠφάνισεν αὑτὸν οἵ τ' ὄφεις ἐς τὸν νεών.
urn:cts:greekLit:tlg0019.tlg011.fucex:742.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:742.1.text#οἱ δ' ἐγκατακείμενοι παρ' αὐτῷ πῶς δοκεῖς
urn:cts:greekLit:tlg0019.tlg011.fucex:743.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:743.1.text#τὸν Πλοῦτον ἠσπάζοντο καὶ τὴν νύχθ' ὅλην
urn:cts:greekLit:tlg0019.tlg011.fucex:744.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:744.1.text#ἐγρηγόρεσαν, ἕως διέλαμψεν ἡμέρα.
urn:cts:greekLit:tlg0019.tlg011.fucex:745.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:745.1.text#ἐγὼ δ' ἐπῄνουν τὸν θεὸν πάνυ σφόδρα,
urn:cts:greekLit:tlg0019.tlg011.fucex:746.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:746.1.text#ὅτι βλέπειν ἐποίησε τὸν Πλοῦτον ταχύ,
urn:cts:greekLit:tlg0019.tlg011.fucex:747.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:747.1.text#τὸν δὲ Νεοκλείδην μᾶλλον ἐποίησεν τυφλόν.
urn:cts:greekLit:tlg0019.tlg011.fucex:748.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:748.1.text#ὅσην ἔχεις τὴν δύναμιν ὦναξ δέσποτα.
urn:cts:greekLit:tlg0019.tlg011.fucex:749.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:749.1.text#ἀτὰρ φράσον μοι, ποῦ' σθ' ὁ Πλοῦτος;
urn:cts:greekLit:tlg0019.tlg011.fucex:749.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:749.2.text#ἔρχεται.
urn:cts:greekLit:tlg0019.tlg011.fucex:750.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:750.1.text#ἀλλ' ἦν περὶ αὐτὸν ὄχλος ὑπερφυὴς ὅσος.
urn:cts:greekLit:tlg0019.tlg011.fucex:751.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:751.1.text#οἱ γὰρ δίκαιοι πρότερον ὄντες καὶ βίον
urn:cts:greekLit:tlg0019.tlg011.fucex:752.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:752.1.text#ἔχοντες ὀλίγον αὐτὸν ἠσπάζοντο καὶ
urn:cts:greekLit:tlg0019.tlg011.fucex:753.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:753.1.text#ἐδεξιοῦνθ' ἅπαντες ὑπὸ τῆς ἡδονῆς·
urn:cts:greekLit:tlg0019.tlg011.fucex:754.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:754.1.text#ὅσοι δ' ἐπλούτουν οὐσίαν τ' εἶχον συχνὴν
urn:cts:greekLit:tlg0019.tlg011.fucex:755.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:755.1.text#οὐκ ἐκ δικαίου τὸν βίον κεκτημένοι,
urn:cts:greekLit:tlg0019.tlg011.fucex:756.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:756.1.text#ὀφρῦς ξυνῆγον ἐσκυθρώπαζόν θ' ἅμα.
urn:cts:greekLit:tlg0019.tlg011.fucex:757.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:757.1.text#οἱ δ' ἠκολούθουν κατόπιν ἐστεφανωμένοι
urn:cts:greekLit:tlg0019.tlg011.fucex:758.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:758.1.text#γελῶντες εὐφημοῦντες· ἐκτυπεῖτο δὲ
urn:cts:greekLit:tlg0019.tlg011.fucex:759.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:759.1.text#ἐμβὰς γερόντων εὐρύθμοις προβήμασιν.
urn:cts:greekLit:tlg0019.tlg011.fucex:760.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:760.1.text#ἀλλ' εἶ' ἁπαξάπαντες ἐξ ἑνὸς λόγου
urn:cts:greekLit:tlg0019.tlg011.fucex:761.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:761.1.text#ὀρχεῖσθε καὶ σκιρτᾶτε καὶ χορεύετε·
urn:cts:greekLit:tlg0019.tlg011.fucex:762.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:762.1.text#οὐδεὶς γὰρ ὑμῖν εἰσιοῦσιν ἀγγελεῖ,
urn:cts:greekLit:tlg0019.tlg011.fucex:763.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:763.1.text#ὡς ἄλφιτ' οὐκ ἔνεστιν ἐν τῷ θυλάκῳ.
urn:cts:greekLit:tlg0019.tlg011.fucex:764.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:764.1.text#νὴ τὴν Ἑκάτην κἀγὼ δ' ἀναδῆσαι βούλομαι
urn:cts:greekLit:tlg0019.tlg011.fucex:765.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:765.1.text#εὐαγγέλιά σε κριβανωτῶν ὁρμαθῷ
urn:cts:greekLit:tlg0019.tlg011.fucex:766.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:766.1.text#τοιαῦτ' ἀπαγγείλαντα.
urn:cts:greekLit:tlg0019.tlg011.fucex:766.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:766.2.text#μή νυν μέλλ' ἔτι,
urn:cts:greekLit:tlg0019.tlg011.fucex:767.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:767.1.text#ὡς ἅνδρες ἐγγύς εἰσιν ἤδη τῶν θυρῶν.
urn:cts:greekLit:tlg0019.tlg011.fucex:768.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:768.1.text#φέρε νυν ἰοῦσ' εἴσω κομίσω καταχύσματα
urn:cts:greekLit:tlg0019.tlg011.fucex:769.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:769.1.text#ὥσπερ νεωνήτοισιν ὀφθαλμοῖς ἐγώ.
urn:cts:greekLit:tlg0019.tlg011.fucex:770.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:770.1.text#ἐγὼ δ' ἀπαντῆσαί γ' ἐκείνοις βούλομαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:771.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:771.1.text#καὶ προσκυνῶ γε πρῶτα μὲν τὸν ἥλιον,
urn:cts:greekLit:tlg0019.tlg011.fucex:772.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:772.1.text#ἔπειτα σεμνῆς Παλλάδος κλεινὸν πέδον
urn:cts:greekLit:tlg0019.tlg011.fucex:773.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:773.1.text#χώραν τε πᾶσαν Κέκροπος ἥ μ' ἐδέξατο.
urn:cts:greekLit:tlg0019.tlg011.fucex:774.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:774.1.text#αἰσχύνομαι δὲ τὰς ἐμαυτοῦ συμφοράς,
urn:cts:greekLit:tlg0019.tlg011.fucex:775.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:775.1.text#οἵοις ἄρ' ἀνθρώποις ξυνὼν ἐλάνθανον,
urn:cts:greekLit:tlg0019.tlg011.fucex:776.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:776.1.text#τοὺς ἀξίους δὲ τῆς ἐμῆς ὁμιλίας
urn:cts:greekLit:tlg0019.tlg011.fucex:777.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:777.1.text#ἔφευγον, εἰδὼς οὐδέν· ὦ τλήμων ἐγώ,
urn:cts:greekLit:tlg0019.tlg011.fucex:778.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:778.1.text#ὡς οὔτ' ἐκεῖν' ἄρ' οὔτε ταῦτ' ὀρθῶς ἔδρων·
urn:cts:greekLit:tlg0019.tlg011.fucex:779.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:779.1.text#ἀλλ' αὐτὰ πάντα πάλιν ἀναστρέψας ἐγὼ
urn:cts:greekLit:tlg0019.tlg011.fucex:780.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:780.1.text#δείξω τὸ λοιπὸν πᾶσιν ἀνθρώποις ὅτι
urn:cts:greekLit:tlg0019.tlg011.fucex:781.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:781.1.text#ἄκων ἐμαυτὸν τοῖς πονηροῖς ἐπεδίδουν.
urn:cts:greekLit:tlg0019.tlg011.fucex:782.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:782.1.text#βάλλ' ἐς κόρακας· ὡς χαλεπόν εἰσιν οἱ φίλοι
urn:cts:greekLit:tlg0019.tlg011.fucex:783.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:783.1.text#οἱ φαινόμενοι παραχρῆμ' ὅταν πράττῃ τις εὖ.
urn:cts:greekLit:tlg0019.tlg011.fucex:784.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:784.1.text#νύττουσι γὰρ καὶ φλῶσι τἀντικνήμια,
urn:cts:greekLit:tlg0019.tlg011.fucex:785.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:785.1.text#ἐνδεικνύμενος ἔκαστος εὔνοιάν τινα.
urn:cts:greekLit:tlg0019.tlg011.fucex:786.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:786.1.text#ἐμὲ γὰρ τίς οὐ προσεῖπε; ποῖος οὐκ ὄχλος
urn:cts:greekLit:tlg0019.tlg011.fucex:787.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:787.1.text#περιεστεφάνωσεν ἐν ἀγορᾷ πρεσβυτικός;
urn:cts:greekLit:tlg0019.tlg011.fucex:788.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:788.1.text#ὦ φίλτατ' ἀνδρῶν καὶ σὺ καὶ σὺ χαίρετε.
urn:cts:greekLit:tlg0019.tlg011.fucex:789.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:789.1.text#φέρε νυν, νόμος γάρ ἐστι, τὰ καταχύσματα
urn:cts:greekLit:tlg0019.tlg011.fucex:790.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:790.1.text#ταυτὶ καταχέω σου λαβοῦσα.
urn:cts:greekLit:tlg0019.tlg011.fucex:790.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:790.2.text#μηδαμῶς.
urn:cts:greekLit:tlg0019.tlg011.fucex:791.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:791.1.text#ἐμοῦ γὰρ εἰσιόντος ἐς τὴν οἰκίαν
urn:cts:greekLit:tlg0019.tlg011.fucex:792.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:792.1.text#πρώτιστα καὶ βλέψαντος οὐδὲν ἐκφέρειν
urn:cts:greekLit:tlg0019.tlg011.fucex:793.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:793.1.text#πρεπῶδές ἐστιν, ἀλλὰ μᾶλλον ἐσφέρειν.
urn:cts:greekLit:tlg0019.tlg011.fucex:794.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:794.1.text#εἶτ' οὐχὶ δέξει δῆτα τὰ καταχύσματα;
urn:cts:greekLit:tlg0019.tlg011.fucex:795.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:795.1.text#ἔνδον γε παρὰ τὴν ἑστίαν, ὥσπερ νόμος·
urn:cts:greekLit:tlg0019.tlg011.fucex:796.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:796.1.text#ἔπειτα καὶ τὸν φόρτον ἐκφύγοιμεν ἄν.
urn:cts:greekLit:tlg0019.tlg011.fucex:797.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:797.1.text#οὐ γὰρ πρεπῶδές ἐστι τῷ διδασκάλῳ
urn:cts:greekLit:tlg0019.tlg011.fucex:798.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:798.1.text#ἰσχάδια καὶ τρωγάλια τοῖς θεωμένοις
urn:cts:greekLit:tlg0019.tlg011.fucex:799.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.fucex:799.1.text#προβαλόντ' ἐπὶ τούτοις εἶτ' ἀναγκάζειν γελᾶν.
urn:cts:greekLit:tlg0019.tlg011.fucex:800.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:800.1.text#εὖ πάνυ λέγεις· ὡς Δεξίνικός γ' οὑτοσὶ
urn:cts:greekLit:tlg0019.tlg011.fucex:801.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.fucex:801.1.text#ἀνίσταθ' ὡς ἁρπασόμενος τὰς ἰσχάδας.
urn:cts:greekLit:tlg0019.tlg011.fucex:802.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:802.1.text#ὡς ἡδὺ πράττειν ὦνδρές ἐστ' εὐδαιμόνως,
urn:cts:greekLit:tlg0019.tlg011.fucex:803.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:803.1.text#καὶ ταῦτα μηδὲν ἐξενεγκόντ' οἴκοθεν.
urn:cts:greekLit:tlg0019.tlg011.fucex:804.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:804.1.text#ἡμῖν γὰρ ἀγαθῶν σωρὸς ἐς τὴν οἰκίαν
urn:cts:greekLit:tlg0019.tlg011.fucex:805.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:805.1.text#ἐπεσπέπαικεν οὐδὲν ἠδικηκόσιν.
urn:cts:greekLit:tlg0019.tlg011.fucex:805a.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:805a.1.text#[ οὕτω τὸ πλουτεῖν ἐστιν ἡδὺ πρᾶγμα δή. ]
urn:cts:greekLit:tlg0019.tlg011.fucex:806.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:806.1.text#ἡ μὲν σιπύη μεστή 'στι λευκῶν ἀλφίτων,
urn:cts:greekLit:tlg0019.tlg011.fucex:807.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:807.1.text#οἱ δ' ἀμφορῆς οἴνου μέλανος ἀνθοσμίου.
urn:cts:greekLit:tlg0019.tlg011.fucex:808.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:808.1.text#ἅπαντα δ' ἡμῖν ἀργυρίου καὶ χρυσίου
urn:cts:greekLit:tlg0019.tlg011.fucex:809.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:809.1.text#τὰ σκευάρια πλήρη 'στίν, ὥστε θαυμάσαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:810.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:810.1.text#τὸ φρέαρ δ' ἐλαίου μεστόν· αἱ δὲ λήκυθοι
urn:cts:greekLit:tlg0019.tlg011.fucex:811.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:811.1.text#μύρου γέμουσι, τὸ δ' ὑπερῷον ἰσχάδων.
urn:cts:greekLit:tlg0019.tlg011.fucex:812.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:812.1.text#ὀξὶς δὲ πᾶσα καὶ λοπάδιον καὶ χύτρα
urn:cts:greekLit:tlg0019.tlg011.fucex:813.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:813.1.text#χαλκῆ γέγονε· τοὺς δὲ πινακίσκους τοὺς σαπροὺς
urn:cts:greekLit:tlg0019.tlg011.fucex:814.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:814.1.text#τοὺς ἰχθυηροὺς ἀργυροῦς πάρεσθ' ὁρᾶν.
urn:cts:greekLit:tlg0019.tlg011.fucex:815.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:815.1.text#ὁ δ' ἰπνὸς γέγον' ἡμῖν ἐξαπίνης ἐλεφάντινος.
urn:cts:greekLit:tlg0019.tlg011.fucex:816.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:816.1.text#στατῆρσι δ' οἱ θεράποντες ἀρτιάζομεν
urn:cts:greekLit:tlg0019.tlg011.fucex:817.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:817.1.text#χρυσοῖς· ἀποψώμεσθα δ' οὐ λίθοις ἔτι,
urn:cts:greekLit:tlg0019.tlg011.fucex:818.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:818.1.text#ἀλλὰ σκοροδίοις ὑπὸ τρυφῆς ἑκάστοτε.
urn:cts:greekLit:tlg0019.tlg011.fucex:819.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:819.1.text#καὶ νῦν ὁ δεσπότης μὲν ἔνδον βουθυτεῖ
urn:cts:greekLit:tlg0019.tlg011.fucex:820.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:820.1.text#ὗν καὶ τράγον καὶ κριὸν ἐστεφανωμένος·
urn:cts:greekLit:tlg0019.tlg011.fucex:821.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:821.1.text#ἐμὲ δ' ἐξέπεμψεν ὁ καπνός. οὐχ οἷός τε γὰρ
urn:cts:greekLit:tlg0019.tlg011.fucex:822.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:822.1.text#ἔνδον μένειν ἦν. ἔδακνε γὰρ τὰ βλέφαρά μου.
urn:cts:greekLit:tlg0019.tlg011.fucex:823.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:823.1.text#ἕπου μετ' ἐμοῦ παιδάριον, ἵνα πρὸς τὸν θεὸν
urn:cts:greekLit:tlg0019.tlg011.fucex:824.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:824.1.text#ἴωμεν.
urn:cts:greekLit:tlg0019.tlg011.fucex:824.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:824.2.text#ἔα τίς ἔσθ' ὁ προσιὼν οὑτοσί;
urn:cts:greekLit:tlg0019.tlg011.fucex:825.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:825.1.text#ἀνὴρ πρότερον μὲν ἄθλιος, νῦν δ' εὐτυχής.
urn:cts:greekLit:tlg0019.tlg011.fucex:826.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:826.1.text#δῆλον ὅτι τῶν χρηστῶν τις, ὡς ἔοικας, εἶ.
urn:cts:greekLit:tlg0019.tlg011.fucex:827.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:827.1.text#μάλιστ'.
urn:cts:greekLit:tlg0019.tlg011.fucex:827.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:827.2.text#ἔπειτα τοῦ δέει;
urn:cts:greekLit:tlg0019.tlg011.fucex:827.3.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:827.3.text#πρὸς τὸν θεὸν
urn:cts:greekLit:tlg0019.tlg011.fucex:828.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:828.1.text#ἥκω· μεγάλων γάρ μοὐστὶν ἀγαθῶν αἴτιος.
urn:cts:greekLit:tlg0019.tlg011.fucex:829.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:829.1.text#ἐγὼ γὰρ ἱκανὴν οὐσίαν παρὰ τοῦ πατρὸς
urn:cts:greekLit:tlg0019.tlg011.fucex:830.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:830.1.text#λαβὼν ἐπήρκουν τοῖς δεομένοις τῶν φίλων,
urn:cts:greekLit:tlg0019.tlg011.fucex:831.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:831.1.text#εἶναι νομίζων χρήσιμον πρὸς τὸν βίον.
urn:cts:greekLit:tlg0019.tlg011.fucex:832.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:832.1.text#ἦ πού σε ταχέως ἐπέλιπεν τὰ χρήματα.
urn:cts:greekLit:tlg0019.tlg011.fucex:833.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:833.1.text#κομιδῇ μὲν οὖν.
urn:cts:greekLit:tlg0019.tlg011.fucex:833.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:833.2.text#οὐκοῦν μετὰ ταῦτ' ἦσθ' ἄθλιος.
urn:cts:greekLit:tlg0019.tlg011.fucex:834.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:834.1.text#κομιδῇ μὲν οὖν. κἀγὼ μὲν ᾤμην οὓς τέως
urn:cts:greekLit:tlg0019.tlg011.fucex:835.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:835.1.text#εὐηργέτησα δεομένους ἕξειν φίλους
urn:cts:greekLit:tlg0019.tlg011.fucex:836.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:836.1.text#ὄντως βεβαίους, εἰ δεηθείην ποτέ·
urn:cts:greekLit:tlg0019.tlg011.fucex:837.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:837.1.text#οἱ δ' ἐξετρέποντο κοὐκ ἐδόκουν ὁρᾶν μ' ἔτι.
urn:cts:greekLit:tlg0019.tlg011.fucex:838.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:838.1.text#καὶ κατεγέλων δ' εὖ οἶδ' ὅτι.
urn:cts:greekLit:tlg0019.tlg011.fucex:838.2.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:838.2.text#κομιδῇ μὲν οὖν·
urn:cts:greekLit:tlg0019.tlg011.fucex:839.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:839.1.text#αὐχμὸς γὰρ ὢν τῶν σκευαρίων μ' ἀπώλεσεν.
urn:cts:greekLit:tlg0019.tlg011.fucex:840.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:840.1.text#ἀλλ' οὐχὶ νῦν.
urn:cts:greekLit:tlg0019.tlg011.fucex:840.2.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:840.2.text#ἀνθ' ὧν ἐγὼ πρὸς τὸν θεὸν
urn:cts:greekLit:tlg0019.tlg011.fucex:841.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:841.1.text#προσευξόμενος ἥκω δικαίως ἐνθάδε.
urn:cts:greekLit:tlg0019.tlg011.fucex:842.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:842.1.text#τὸ τριβώνιον δὲ τί δύναται πρὸς τῶν θεῶν,
urn:cts:greekLit:tlg0019.tlg011.fucex:843.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:843.1.text#ὃ φέρει μετὰ σοῦ τὸ παιδάριον τουτί; φράσον.
urn:cts:greekLit:tlg0019.tlg011.fucex:844.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:844.1.text#καὶ τοῦτ' ἀναθήσων ἔρχομαι πρὸς τὸν θεόν.
urn:cts:greekLit:tlg0019.tlg011.fucex:845.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:845.1.text#μῶν οὖν ἐμυήθης δῆτ' ἐν αὐτῷ τὰ μεγάλα;
urn:cts:greekLit:tlg0019.tlg011.fucex:846.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:846.1.text#οὐκ ἀλλ' ἐνερρίγωσ' ἔτη τριακαίδεκα.
urn:cts:greekLit:tlg0019.tlg011.fucex:847.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:847.1.text#τὰ δ' ἐμβάδια;
urn:cts:greekLit:tlg0019.tlg011.fucex:847.2.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:847.2.text#καὶ ταῦτα συνεχειμάζετο.
urn:cts:greekLit:tlg0019.tlg011.fucex:848.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:848.1.text#καὶ ταῦτ' ἀναθήσων ἔφερες οὖν;
urn:cts:greekLit:tlg0019.tlg011.fucex:848.2.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:848.2.text#νὴ τὸν Δία.
urn:cts:greekLit:tlg0019.tlg011.fucex:849.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:849.1.text#χαρίεντά γ' ἥκεις δῶρα τῷ θεῷ φέρων.
urn:cts:greekLit:tlg0019.tlg011.fucex:850.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:850.1.text#οἴμοι κακοδαίμων, ὡς ἀπόλωλα δείλαιος,
urn:cts:greekLit:tlg0019.tlg011.fucex:851.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:851.1.text#καὶ κακοδαίμων καὶ τετράκις καὶ πεντάκις
urn:cts:greekLit:tlg0019.tlg011.fucex:852.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:852.1.text#καὶ δωδεκάκις καὶ μυριάκις· ἰοὺ ἰού.
urn:cts:greekLit:tlg0019.tlg011.fucex:853.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:853.1.text#οὕτω πολυφόρῳ συγκέκραμαι δαίμονι.
urn:cts:greekLit:tlg0019.tlg011.fucex:854.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:854.1.text#Ἄπολλον ἀποτρόπαιε καὶ θεοὶ φίλοι,
urn:cts:greekLit:tlg0019.tlg011.fucex:855.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:855.1.text#τί ποτ' ἐστὶν ὅ τι πέπονθεν ἅνθρωπος κακόν;
urn:cts:greekLit:tlg0019.tlg011.fucex:856.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:856.1.text#οὐ γὰρ σχέτλια πέπονθα νυνὶ πράγματα,
urn:cts:greekLit:tlg0019.tlg011.fucex:857.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:857.1.text#ἀπολωλεκὼς ἅπαντα τἀκ τῆς οἰκίας
urn:cts:greekLit:tlg0019.tlg011.fucex:858.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:858.1.text#διὰ τὸν θεὸν τοῦτον, τὸν ἐσόμενον τυφλὸν
urn:cts:greekLit:tlg0019.tlg011.fucex:859.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:859.1.text#πάλιν αὖθις, ἤνπερ μὴ 'λλίπωσιν αἱ δίκαι;
urn:cts:greekLit:tlg0019.tlg011.fucex:860.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:860.1.text#ἐγὼ σχεδὸν τὸ πρᾶγμα γιγνώσκειν δοκῶ.
urn:cts:greekLit:tlg0019.tlg011.fucex:861.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:861.1.text#προσέρχεται γάρ τις κακῶς πράττων ἀνήρ,
urn:cts:greekLit:tlg0019.tlg011.fucex:862.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:862.1.text#ἔοικε δ' εἶναι τοῦ πονηροῦ κόμματος.
urn:cts:greekLit:tlg0019.tlg011.fucex:863.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:863.1.text#νὴ Δία καλῶς τοίνυν ποιῶν ἀπόλλυται.
urn:cts:greekLit:tlg0019.tlg011.fucex:864.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:864.1.text#ποῦ ποῦ 'σθ' ὁ μόνος ἅπαντας ἡμᾶς πλουσίους
urn:cts:greekLit:tlg0019.tlg011.fucex:865.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:865.1.text#ὑποσχόμενος οὗτος ποιήσειν εὐθέως,
urn:cts:greekLit:tlg0019.tlg011.fucex:866.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:866.1.text#εἰ πάλιν ἀναβλέψειεν ἐξ ἀρχῆς; ὁ δὲ
urn:cts:greekLit:tlg0019.tlg011.fucex:867.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:867.1.text#πολὺ μᾶλλον ἐνίους ἐστὶν ἐξολωλεκώς.
urn:cts:greekLit:tlg0019.tlg011.fucex:868.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:868.1.text#καὶ τίνα δέδρακε δῆτα τοῦτ';
urn:cts:greekLit:tlg0019.tlg011.fucex:868.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:868.2.text#ἐμὲ τουτονί.
urn:cts:greekLit:tlg0019.tlg011.fucex:869.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:869.1.text#ἦ τῶν πονηρῶν ἦσθα καὶ τοιχωρύχων;
urn:cts:greekLit:tlg0019.tlg011.fucex:870.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:870.1.text#μὰ Δί' οὐ μὲν οὖν ἔσθ' ὑγιὲς ὑμῶν οὐδενός,
urn:cts:greekLit:tlg0019.tlg011.fucex:871.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:871.1.text#κοὐκ ἔσθ' ὅπως οὐκ ἔχετέ μου τὰ χρήματα.
urn:cts:greekLit:tlg0019.tlg011.fucex:872.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:872.1.text#ὡς σοβαρὸς ὦ Δάματερ εἰσελήλυθεν
urn:cts:greekLit:tlg0019.tlg011.fucex:873.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:873.1.text#ὁ συκοφάντης. δῆλον ὅτι βουλιμιᾷ.
urn:cts:greekLit:tlg0019.tlg011.fucex:874.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:874.1.text#σὺ μὲν εἰς ἀγορὰν ἰὼν ταχέως οὐκ ἂν φθάνοις·
urn:cts:greekLit:tlg0019.tlg011.fucex:875.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:875.1.text#ἐπὶ τοῦ τροχοῦ γὰρ δεῖ σ' ἐκεῖ στρεβλούμενον
urn:cts:greekLit:tlg0019.tlg011.fucex:876.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:876.1.text#εἰπεῖν ἃ πεπανούργηκας.
urn:cts:greekLit:tlg0019.tlg011.fucex:876.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:876.2.text#οἰμώξἄρα σύ.
urn:cts:greekLit:tlg0019.tlg011.fucex:877.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:877.1.text#νὴ τὸν Δία τὸν σωτῆρα πολλοῦ γ' ἄξιος
urn:cts:greekLit:tlg0019.tlg011.fucex:878.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:878.1.text#ἅπασι τοῖς Ἕλλησιν ὁ θεός ἐσθ' ὅτι
urn:cts:greekLit:tlg0019.tlg011.fucex:879.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:879.1.text#τοὺς συκοφάντας ἐξολεῖ κακοὺς κακῶς.
urn:cts:greekLit:tlg0019.tlg011.fucex:880.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:880.1.text#οἴμοι τάλας· μῶν καὶ σὺ μετέχων καταγελᾷς;
urn:cts:greekLit:tlg0019.tlg011.fucex:881.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:881.1.text#ἐπεὶ πόθεν θοἰμάτιον εἴληφας τοδί;
urn:cts:greekLit:tlg0019.tlg011.fucex:882.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:882.1.text#ἐχθὲς δ' ἔχοντ' εἶδόν σ' ἐγὼ τριβώνιον.
urn:cts:greekLit:tlg0019.tlg011.fucex:883.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:883.1.text#οὐδὲν προτιμῶ σου. φορῶ γὰρ πριάμενος
urn:cts:greekLit:tlg0019.tlg011.fucex:884.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:884.1.text#τὸν δακτύλιον τονδὶ παρ' Εὐδάμου δραχμῆς.
urn:cts:greekLit:tlg0019.tlg011.fucex:885.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:885.1.text#† ἀλλ' οὐκ ἔνεστι συκοφάντου δήγματος.†
urn:cts:greekLit:tlg0019.tlg011.fucex:886.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:886.1.text#ἆρ' οὐχ ὕβρις ταῦτ' ἐστὶ πολλή; σκώπτετον,
urn:cts:greekLit:tlg0019.tlg011.fucex:887.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:887.1.text#ὅ τι δὲ ποιεῖτον ἐνθάδ' οὐκ εἰρήκατον.
urn:cts:greekLit:tlg0019.tlg011.fucex:888.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:888.1.text#οὐκ ἐπ' ἀγαθῷ γὰρ ἐνθάδ' ἐστὸν οὐδενί.
urn:cts:greekLit:tlg0019.tlg011.fucex:889.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:889.1.text#μὰ τὸν Δί' οὔκουν τῷ γε σῷ, σάφ' ἴσθ' ὅτι.
urn:cts:greekLit:tlg0019.tlg011.fucex:890.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:890.1.text#ἀπὸ τῶν ἐμῶν γὰρ ναὶ μὰ Δία δειπνήσετον.
urn:cts:greekLit:tlg0019.tlg011.fucex:891.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:891.1.text#ὡς δὴ 'π' ἀληθείᾳ σὺ μετὰ τοῦ μάρτυρος
urn:cts:greekLit:tlg0019.tlg011.fucex:892.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:892.1.text#διαρραγείης μηδενός γ' ἐμπλήμενος.
urn:cts:greekLit:tlg0019.tlg011.fucex:893.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:893.1.text#ἀρνεῖσθον; ἔνδον ἐστὶν ὦ μιαρωτάτω
urn:cts:greekLit:tlg0019.tlg011.fucex:894.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:894.1.text#πολὺ χρῆμα τεμαχῶν καὶ κρεῶν ὠπτημένων.
urn:cts:greekLit:tlg0019.tlg011.fucex:895.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:895.1.text#ὓ ὗ ὓ ὗ ὓ ὗ ὓ ὗ ὓ ὗ ὓ ὗ.
urn:cts:greekLit:tlg0019.tlg011.fucex:896.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:896.1.text#κακόδαιμον ὀσφραίνει τι;
urn:cts:greekLit:tlg0019.tlg011.fucex:896.2.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:896.2.text#τοῦ ψύχους γ' ἴσως
urn:cts:greekLit:tlg0019.tlg011.fucex:897.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:897.1.text#ἐπεὶ τοιοῦτόν γ' ἀμπέχεται τριβώνιον.
urn:cts:greekLit:tlg0019.tlg011.fucex:898.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:898.1.text#ταῦτ' οὖν ἀνασχέτ' ἐστὶν ὦ Ζεῦ καὶ θεοί,
urn:cts:greekLit:tlg0019.tlg011.fucex:899.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:899.1.text#τούτους ὑβρίζειν εἰς ἔμ'; οἴμ' ὡς ἄχθομαι
urn:cts:greekLit:tlg0019.tlg011.fucex:900.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:900.1.text#ὅτι χρηστὸς ὢν καὶ φιλόπολις πάσχω κακῶς.
urn:cts:greekLit:tlg0019.tlg011.fucex:901.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:901.1.text#σὺ φιλόπολις καὶ χρηστός;
urn:cts:greekLit:tlg0019.tlg011.fucex:901.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:901.2.text#ὡς οὐδείς γ' ἀνήρ.
urn:cts:greekLit:tlg0019.tlg011.fucex:902.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:902.1.text#καὶ μὴν ἐπερωτηθεὶς ἀπόκριναί μοι.
urn:cts:greekLit:tlg0019.tlg011.fucex:902.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:902.2.text#τὸ τί;
urn:cts:greekLit:tlg0019.tlg011.fucex:903.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:903.1.text#γεωργὸς εἶ;
urn:cts:greekLit:tlg0019.tlg011.fucex:903.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:903.2.text#μελαγχολᾶν μ' οὕτως οἴει;
urn:cts:greekLit:tlg0019.tlg011.fucex:904.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:904.1.text#ἀλλ' ἔμπορος;
urn:cts:greekLit:tlg0019.tlg011.fucex:904.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:904.2.text#ναί, σκήπτομαί γ', ὅταν τύχω.
urn:cts:greekLit:tlg0019.tlg011.fucex:905.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:905.1.text#τί δαί; τέχνην τιν' ἔμαθες;
urn:cts:greekLit:tlg0019.tlg011.fucex:905.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:905.2.text#οὐ μὰ τὸν Δία.
urn:cts:greekLit:tlg0019.tlg011.fucex:906.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:906.1.text#πῶς οὖν διέζης ἢ πόθεν μηδὲν ποιῶν;
urn:cts:greekLit:tlg0019.tlg011.fucex:907.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:907.1.text#τῶν τῆς πόλεώς εἰμ' ἐπιμελητὴς πραγμάτων
urn:cts:greekLit:tlg0019.tlg011.fucex:908.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:908.1.text#καὶ τῶν ἰδίων πάντων.
urn:cts:greekLit:tlg0019.tlg011.fucex:908.2.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:908.2.text#σύ; τί μαθών;
urn:cts:greekLit:tlg0019.tlg011.fucex:908.3.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:908.3.text#βούλομαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:909.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:909.1.text#πῶς οὖν ἂν εἴης χρηστὸς ὦ τοιχωρύχε,
urn:cts:greekLit:tlg0019.tlg011.fucex:910.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:910.1.text#εἴ σοι προσῆκον μηδὲν εἶτ' ἀπεχθάνει;
urn:cts:greekLit:tlg0019.tlg011.fucex:911.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:911.1.text#οὐ γὰρ προσήκει τὴν ἐμαυτοῦ μοι πόλιν
urn:cts:greekLit:tlg0019.tlg011.fucex:912.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:912.1.text#εὐεργετεῖν ὦ κέπφε καθ' ὅσον ἂν σθένω;
urn:cts:greekLit:tlg0019.tlg011.fucex:913.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:913.1.text#εὐεργετεῖν οὖν ἐστι τὸ πολυπραγμονεῖν;
urn:cts:greekLit:tlg0019.tlg011.fucex:914.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:914.1.text#τὸ μὲν οὖν βοηθεῖν τοῖς νόμοις τοῖς κειμένοις
urn:cts:greekLit:tlg0019.tlg011.fucex:915.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:915.1.text#καὶ μὴ 'πιτρέπειν ἐάν τις ἐξαμαρτάνῃ.
urn:cts:greekLit:tlg0019.tlg011.fucex:916.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:916.1.text#οὔκουν δικαστὰς ἐξεπίτηδες ἡ πόλις
urn:cts:greekLit:tlg0019.tlg011.fucex:917.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:917.1.text#ἄρχειν καθίστησιν;
urn:cts:greekLit:tlg0019.tlg011.fucex:917.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:917.2.text#κατηγορεῖ δὲ τίς;
urn:cts:greekLit:tlg0019.tlg011.fucex:918.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:918.1.text#ὁ βουλόμενος.
urn:cts:greekLit:tlg0019.tlg011.fucex:918.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:918.2.text#οὐκοῦν ἐκεῖνός εἰμ' ἐγώ,
urn:cts:greekLit:tlg0019.tlg011.fucex:919.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:919.1.text#ὥστ' εἰς ἔμ' ἥκει τῆς πόλεως τὰ πράγματα.
urn:cts:greekLit:tlg0019.tlg011.fucex:920.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:920.1.text#νὴ Δία πονηρόν γ' ἆρα προστάτην ἔχει.
urn:cts:greekLit:tlg0019.tlg011.fucex:921.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:921.1.text#ἐκεῖνο δ' οὐ βούλοι' ἄν, ἡσυχίαν ἔχων
urn:cts:greekLit:tlg0019.tlg011.fucex:922.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:922.1.text#ζῆν ἀργός;
urn:cts:greekLit:tlg0019.tlg011.fucex:922.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:922.2.text#ἀλλὰ προβατίου βίον λέγεις,
urn:cts:greekLit:tlg0019.tlg011.fucex:923.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:923.1.text#εἰ μὴ φανεῖται διατριβή τις τῷ βίῳ.
urn:cts:greekLit:tlg0019.tlg011.fucex:924.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:924.1.text#οὐδ' ἂν μεταμάθοις;
urn:cts:greekLit:tlg0019.tlg011.fucex:924.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:924.2.text#οὐδ' ἂν εἰ δοίης γέ μοι
urn:cts:greekLit:tlg0019.tlg011.fucex:925.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:925.1.text#τὸν Πλοῦτον αὐτὸν καὶ τὸ Βάττου σίλφιον.
urn:cts:greekLit:tlg0019.tlg011.fucex:926.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:926.1.text#κατάθου ταχέως θοἰμάτιον.
urn:cts:greekLit:tlg0019.tlg011.fucex:926.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:926.2.text#οὗτος, σοὶ λέγει.
urn:cts:greekLit:tlg0019.tlg011.fucex:927.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:927.1.text#ἔπειθ' ὑπόλυσαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:927.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:927.2.text#ταῦτα πάντα σοὶ λέγει.
urn:cts:greekLit:tlg0019.tlg011.fucex:928.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:928.1.text#καὶ μὴν προσελθέτω πρὸς ἔμ' ὑμῶν ἐνθαδὶ
urn:cts:greekLit:tlg0019.tlg011.fucex:929.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:929.1.text#ὁ βουλόμενος.
urn:cts:greekLit:tlg0019.tlg011.fucex:929.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:929.2.text#οὐκοῦν ἐκεῖνός εἰμ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg011.fucex:930.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:930.1.text#οἴμοι τάλας ἀποδύομαι μεθ' ἡμέραν.
urn:cts:greekLit:tlg0019.tlg011.fucex:931.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:931.1.text#σὺ γὰρ ἀξιοῖς τἀλλότρια πράττων ἐσθίειν.
urn:cts:greekLit:tlg0019.tlg011.fucex:932.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:932.1.text#ὁρᾷς ἃ ποιεῖς; ταῦτ' ἐγὼ μαρτύρομαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:933.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:933.1.text#ἀλλ' οἴχεται φεύγων ὃν ἦγες μάρτυρα.
urn:cts:greekLit:tlg0019.tlg011.fucex:934.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:934.1.text#οἴμοι περιείλημμαι μόνος.
urn:cts:greekLit:tlg0019.tlg011.fucex:934.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:934.2.text#νυνὶ βοᾷς;
urn:cts:greekLit:tlg0019.tlg011.fucex:935.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:935.1.text#οἴμοι μάλ' αὖθις.
urn:cts:greekLit:tlg0019.tlg011.fucex:935.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:935.2.text#δὸς σύ μοι τὸ τριβώνιον,
urn:cts:greekLit:tlg0019.tlg011.fucex:936.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:936.1.text#ἵν' ἀμφιέσω τὸν συκοφάντην τουτονί.
urn:cts:greekLit:tlg0019.tlg011.fucex:937.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:937.1.text#μὴ δῆθ'· ἱερὸν γάρ ἐστι τοῦ Πλούτου πάλαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:938.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:938.1.text#ἔπειτα ποῦ κάλλιον ἀνατεθήσεται
urn:cts:greekLit:tlg0019.tlg011.fucex:939.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:939.1.text#ἢ περὶ πονηρὸν ἄνδρα καὶ τοιχωρύχον;
urn:cts:greekLit:tlg0019.tlg011.fucex:940.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:940.1.text#Πλοῦτον δὲ κοσμεῖν ἱματίοις σεμνοῖς πρέπει.
urn:cts:greekLit:tlg0019.tlg011.fucex:941.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:941.1.text#τοῖς δ' ἐμβαδίοις τί χρήσεταί τις; εἰπέ μοι.
urn:cts:greekLit:tlg0019.tlg011.fucex:942.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:942.1.text#καὶ ταῦτα πρὸς τὸ μέτωπον αὐτίκα δὴ μάλα
urn:cts:greekLit:tlg0019.tlg011.fucex:943.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:943.1.text#ὥσπερ κοτίνῳ προσπατταλεύσω τουτῳί.
urn:cts:greekLit:tlg0019.tlg011.fucex:944.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:944.1.text#ἄπειμι· γιγνώσκω γὰρ ἥττων ὢν πολὺ
urn:cts:greekLit:tlg0019.tlg011.fucex:945.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:945.1.text#ὑμῶν· ἐὰν δὲ σύζυγον λάβω τινὰ
urn:cts:greekLit:tlg0019.tlg011.fucex:946.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:946.1.text#καὶ σύκινον, τοῦτον τὸν ἰσχυρὸν θεὸν
urn:cts:greekLit:tlg0019.tlg011.fucex:947.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:947.1.text#ἐγὼ ποιήσω τήμερον δοῦναι δίκην,
urn:cts:greekLit:tlg0019.tlg011.fucex:948.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:948.1.text#ὁτιὴ καταλύει περιφανῶς εἶς ὢν μόνος
urn:cts:greekLit:tlg0019.tlg011.fucex:949.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:949.1.text#τὴν δημοκρατίαν, οὔτε τὴν βουλὴν πιθὼν
urn:cts:greekLit:tlg0019.tlg011.fucex:950.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.fucex:950.1.text#τὴν τῶν πολιτῶν οὔτε τὴν ἐκκλησίαν.
urn:cts:greekLit:tlg0019.tlg011.fucex:951.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:951.1.text#καὶ μὴν ἐπειδὴ τὴν πανοπλίαν τὴν ἐμὴν
urn:cts:greekLit:tlg0019.tlg011.fucex:952.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:952.1.text#ἔχων βαδίζεις, ἐς τὸ βαλανεῖον τρέχε·
urn:cts:greekLit:tlg0019.tlg011.fucex:953.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:953.1.text#ἔπειτ' ἐκεῖ κορυφαῖος ἑστηκὼς θέρου.
urn:cts:greekLit:tlg0019.tlg011.fucex:954.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.fucex:954.1.text#κἀγὼ γὰρ εἶχον τὴν στάσιν ταύτην ποτέ.
urn:cts:greekLit:tlg0019.tlg011.fucex:955.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:955.1.text#ἀλλ' ὁ βαλανεὺς ἕλξει θύραζ' αὐτὸν λαβὼν
urn:cts:greekLit:tlg0019.tlg011.fucex:956.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:956.1.text#τῶν ὀρχιπέδων· ἰδὼν γὰρ αὐτὸν γνώσεται
urn:cts:greekLit:tlg0019.tlg011.fucex:957.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:957.1.text#ὅτι ἔστ' ἐκείνου τοῦ πονηροῦ κόμματος.
urn:cts:greekLit:tlg0019.tlg011.fucex:958.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:958.1.text#νὼ δ' εἰσίωμεν, ἵνα προσεύξῃ τὸν θεόν.
urn:cts:greekLit:tlg0019.tlg011.fucex:959.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:959.1.text#ἆρ' ὦ φίλοι γέροντες ἐπὶ τὴν οἰκίαν
urn:cts:greekLit:tlg0019.tlg011.fucex:960.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:960.1.text#ἀφίγμεθ' ὄντως τοῦ νέου τούτου θεοῦ,
urn:cts:greekLit:tlg0019.tlg011.fucex:961.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:961.1.text#ἢ τῆς ὁδοῦ τὸ παράπαν ἡμαρτήκαμεν;
urn:cts:greekLit:tlg0019.tlg011.fucex:962.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:962.1.text#ἀλλ' ἴσθ' ἐπ' αὐτὰς τὰς θύρας ἀφιγμένη
urn:cts:greekLit:tlg0019.tlg011.fucex:963.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:963.1.text#ὦ μειρακίσκη· πυνθάνει γὰρ ὡρικῶς.
urn:cts:greekLit:tlg0019.tlg011.fucex:964.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:964.1.text#φέρε νυν ἐγὼ τῶν ἔνδοθεν καλέσω τινά.
urn:cts:greekLit:tlg0019.tlg011.fucex:965.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:965.1.text#μὴ δῆτ'· ἐγὼ γὰρ αὐτὸς ἐξελήλυθα.
urn:cts:greekLit:tlg0019.tlg011.fucex:966.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:966.1.text#ἀλλ' ὅ τι μάλιστ' ἐλήλυθας λέγειν σ' ἐχρῆν.
urn:cts:greekLit:tlg0019.tlg011.fucex:967.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:967.1.text#πέπονθα δεινὰ καὶ παράνομ' ὦ φίλτατε·
urn:cts:greekLit:tlg0019.tlg011.fucex:968.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:968.1.text#ἀφ' οὗ γὰρ ὁ θεὸς οὗτος ἤρξατο βλέπειν,
urn:cts:greekLit:tlg0019.tlg011.fucex:969.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:969.1.text#ἀβίωτον εἶναί μοι πεποίηκε τὸν βίον.
urn:cts:greekLit:tlg0019.tlg011.fucex:970.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:970.1.text#τί δ' ἔστιν; ἦ που καὶ σὺ συκοφάντρια
urn:cts:greekLit:tlg0019.tlg011.fucex:971.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:971.1.text#εν ταῖς γυναιξὶν ἦσθα;
urn:cts:greekLit:tlg0019.tlg011.fucex:971.2.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:971.2.text#μὰ Δί' ἐγὼ μὲν οὔ.
urn:cts:greekLit:tlg0019.tlg011.fucex:972.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:972.1.text#ἀλλ' οὐ λαχοῦσ' ἔπινες ἐν τῷ γράμματι;
urn:cts:greekLit:tlg0019.tlg011.fucex:973.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:973.1.text#σκώπτεις· ἐγὼ δὲ κατακέκνισμαι δειλάκρα.
urn:cts:greekLit:tlg0019.tlg011.fucex:974.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:974.1.text#οὔκουν ἐρεῖς ἀνύσασα τὸν κνισμὸν τίνα;
urn:cts:greekLit:tlg0019.tlg011.fucex:975.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:975.1.text#ἄκουέ νυν. ἦν μοί τι μειράκιον φίλον,
urn:cts:greekLit:tlg0019.tlg011.fucex:976.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:976.1.text#πενιχρὸν μέν, ἄλλως δ' εὐπρόσωπον καὶ καλὸν
urn:cts:greekLit:tlg0019.tlg011.fucex:977.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:977.1.text#καὶ χρηστόν· εἰ γάρ του δεηθείην ἐγώ,
urn:cts:greekLit:tlg0019.tlg011.fucex:978.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:978.1.text#ἅπαντ' ἐποίει κοσμίως μοι καὶ καλῶς·
urn:cts:greekLit:tlg0019.tlg011.fucex:979.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:979.1.text#ἐγὼ δ' ἐκείνῳ πάντα ταῦθ' ὑπηρέτουν.
urn:cts:greekLit:tlg0019.tlg011.fucex:980.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:980.1.text#τί δ' ἦν ὅ τι σου μάλιστ' ἐδεῖθ' ἑκάστοτε;
urn:cts:greekLit:tlg0019.tlg011.fucex:981.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:981.1.text#οὐ πολλά· καὶ γὰρ ἐκνομίως μ' ᾐσχύνετο.
urn:cts:greekLit:tlg0019.tlg011.fucex:982.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:982.1.text#ἀλλ' ἀργυρίου δραχμὰς ἂν ᾔτησ' εἴκοσιν
urn:cts:greekLit:tlg0019.tlg011.fucex:983.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:983.1.text#εἰς ἱμάτιον, ὀκτὼ δ' ἂν εἰς ὑποδήματα·
urn:cts:greekLit:tlg0019.tlg011.fucex:984.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:984.1.text#καὶ ταῖς ἀδελφαῖς ἀγοράσαι χιτώνιον
urn:cts:greekLit:tlg0019.tlg011.fucex:985.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:985.1.text#ἐκέλευσεν ἂν τῇ μητρί θ' ἱματίδιον·
urn:cts:greekLit:tlg0019.tlg011.fucex:986.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:986.1.text#πυρῶν τ' ἂν ἐδεήθη μεδίμνων τεττάρων.
urn:cts:greekLit:tlg0019.tlg011.fucex:987.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:987.1.text#οὐ πολλὰ τοίνυν μὰ τὸν Ἀπόλλω ταῦτά γε
urn:cts:greekLit:tlg0019.tlg011.fucex:988.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:988.1.text#εἴρηκας, ἀλλὰ δῆλον ὅτι σ' ᾐσχύνετο.
urn:cts:greekLit:tlg0019.tlg011.fucex:989.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:989.1.text#καὶ ταῦτα τοίνυν οὐχ ἕνεκα μισητίας
urn:cts:greekLit:tlg0019.tlg011.fucex:990.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:990.1.text#αἰτεῖν μ' ἔφασκεν, ἀλλὰ φιλίας οὕνεκα,
urn:cts:greekLit:tlg0019.tlg011.fucex:991.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:991.1.text#ἵνα τοὐμὸν ἱμάτιον φορῶν μεμνῇτό μου.
urn:cts:greekLit:tlg0019.tlg011.fucex:992.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:992.1.text#λέγεις ἐρῶντ' ἄνθρωπον ἐκνομιώτατα.
urn:cts:greekLit:tlg0019.tlg011.fucex:993.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:993.1.text#ἀλλ' οὐχὶ νῦν ὁ βδελυρὸς ἔτι τὸν νοῦν ἔχει
urn:cts:greekLit:tlg0019.tlg011.fucex:994.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:994.1.text#τὸν αὐτόν, ἀλλὰ πολὺ μεθέστηκεν πάνυ.
urn:cts:greekLit:tlg0019.tlg011.fucex:995.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:995.1.text#ἐμοῦ γὰρ αὐτῷ τὸν πλακοῦντα τουτονὶ
urn:cts:greekLit:tlg0019.tlg011.fucex:996.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:996.1.text#καὶ τἄλλα τἀπὶ τοῦ πίνακος τραγήματα
urn:cts:greekLit:tlg0019.tlg011.fucex:997.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:997.1.text#ἐπόντα πεμψάσης ὑπειπούσης θ' ὅτι
urn:cts:greekLit:tlg0019.tlg011.fucex:998.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:998.1.text#εἰς ἑσπέραν ἥξοιμι—
urn:cts:greekLit:tlg0019.tlg011.fucex:998.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:998.2.text#τί σ' ἔδρασ'; εἰπέ μοι.
urn:cts:greekLit:tlg0019.tlg011.fucex:999.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:999.1.text#ἄμητα προσαπέπεμψεν ἡμῖν τουτονί,
urn:cts:greekLit:tlg0019.tlg011.fucex:1000.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1000.1.text#ἐφ' ᾧ τ' ἐκεῖσε μηδέποτέ μ' ἐλθεῖν ἔτι,
urn:cts:greekLit:tlg0019.tlg011.fucex:1001.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1001.1.text#καὶ πρὸς ἐπὶ τούτοις εἶπεν ἀποπέμπων ὅτι
urn:cts:greekLit:tlg0019.tlg011.fucex:1002.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1002.1.text# " πάλαι ποτ' ἦσαν ἄλκιμοι Μιλήσιοι."
urn:cts:greekLit:tlg0019.tlg011.fucex:1003.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1003.1.text#δῆλον ὅτι τοὺς τρόπους τις οὐ μοχθηρὸς ἦν,
urn:cts:greekLit:tlg0019.tlg011.fucex:1004.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1004.1.text#ἔπειτα πλουτῶν οὐκέθ' ἥδεται φακῇ·
urn:cts:greekLit:tlg0019.tlg011.fucex:1005.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1005.1.text#πρὸ τοῦ δ' ὑπὸ τῆς πενίας ἅπανθ' ὑπήσθιεν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1006.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1006.1.text#καὶ μὴν πρὸ τοῦ γ' ὁσημέραι νὴ τὼ θεὼ
urn:cts:greekLit:tlg0019.tlg011.fucex:1007.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1007.1.text#ἐπὶ τὴν θύραν ἐβάδιζεν ἀεὶ τὴν ἐμήν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1008.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1008.1.text#ἐπ' ἐκφοράν;
urn:cts:greekLit:tlg0019.tlg011.fucex:1008.2.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1008.2.text#μὰ Δί' ἀλλὰ τῆς φωνῆς μόνον
urn:cts:greekLit:tlg0019.tlg011.fucex:1009.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1009.1.text#ἐρῶν ἀκοῦσαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:1009.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1009.2.text#τοῦ λαβεῖν μὲν οὖν χάριν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1010.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1010.1.text#καὶ νὴ Δί' εἰ λυπουμένην γ' αἴσθοιτό με,
urn:cts:greekLit:tlg0019.tlg011.fucex:1011.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1011.1.text#νηττάριον ἂν καὶ φάττιον ὑπεκορίζετο.
urn:cts:greekLit:tlg0019.tlg011.fucex:1012.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1012.1.text#ἔπειτ' ἴσως ᾔτει σ' ἂν εἰς ὑποδήματα.
urn:cts:greekLit:tlg0019.tlg011.fucex:1013.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1013.1.text#μυστηρίοις δὲ τοῖς μεγάλοις ὀχουμένην
urn:cts:greekLit:tlg0019.tlg011.fucex:1014.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1014.1.text#ἐπὶ τῆς ἁμάξης ὅτι προσέβλεψέν μέ τις,
urn:cts:greekLit:tlg0019.tlg011.fucex:1015.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1015.1.text#ἐτυπτόμην διὰ τοῦθ' ὅλην τὴν ἡμέραν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1016.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1016.1.text#οὕτω σφόδρα ζηλότυπος ὁ νεανίσκος ἦν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1017.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1017.1.text#μόνος γὰρ ἥδεθ', ὡς ἔοικεν, ἐσθίων.
urn:cts:greekLit:tlg0019.tlg011.fucex:1018.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1018.1.text#καὶ τάς γε χεῖρας παγκάλας ἔχειν μ' ἔθη.
urn:cts:greekLit:tlg0019.tlg011.fucex:1019.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1019.1.text#ὁπότε προτείνοιέν γε δραχμὰς εἴκοσιν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1020.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1020.1.text#ὄζειν τε τῆς χρόας ἔφασκεν ἡδύ μου.
urn:cts:greekLit:tlg0019.tlg011.fucex:1021.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1021.1.text#εἰ Θάσιον ἐνέχεις, εἰκότως γε νὴ Δία.
urn:cts:greekLit:tlg0019.tlg011.fucex:1022.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1022.1.text#τὸ βλέμμα θ' ὡς ἔχοιμι μαλακὸν καὶ καλόν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1023.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1023.1.text#οὐ σκαιὸς ἦν ἄνθρωπος, ἀλλ' ἠπίστατο
urn:cts:greekLit:tlg0019.tlg011.fucex:1024.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1024.1.text#γραὸς καπρώσης τἀφόδια κατεσθίειν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1025.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1025.1.text#ταῦτ' οὖν ὁ θεὸς ὦ φίλ' ἄνερ οὐκ ὀρθῶς ποιεῖ,
urn:cts:greekLit:tlg0019.tlg011.fucex:1026.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1026.1.text#φάσκων βοηθεῖν τοῖς ἀδικουμένοις ἀεί.
urn:cts:greekLit:tlg0019.tlg011.fucex:1027.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1027.1.text#τί γὰρ ποιήσει; φράζε, καὶ πεπράξεται.
urn:cts:greekLit:tlg0019.tlg011.fucex:1028.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1028.1.text#ἀναγκάσαι δίκαιόν ἐστι νὴ Δία
urn:cts:greekLit:tlg0019.tlg011.fucex:1029.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1029.1.text#τὸν εὖ παθόνθ' ὑπ' ἐμοῦ πάλιν μ' ἀντευποιεῖν,
urn:cts:greekLit:tlg0019.tlg011.fucex:1030.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1030.1.text#ἢ μηδ' ὁτιοῦν ἀγαθὸν δίκαιόν ἐστ' ἔχειν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1031.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1031.1.text#οὔκουν καθ' ἑκάστην ἀπεδίδου τὴν νύκτα σοι;
urn:cts:greekLit:tlg0019.tlg011.fucex:1032.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1032.1.text#ἀλλ' οὐδέποτέ με ζῶσαν ἀπολείψειν ἔφη.
urn:cts:greekLit:tlg0019.tlg011.fucex:1033.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1033.1.text#ὀρθῶς γε· νῦν δέ γ' οὐκέτι ζῆν σ' οἴεται.
urn:cts:greekLit:tlg0019.tlg011.fucex:1034.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1034.1.text#ὑπὸ τοῦ γὰρ ἄλγους κατατέτηκ' ὦ φίλτατε.
urn:cts:greekLit:tlg0019.tlg011.fucex:1035.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1035.1.text#οὐκ ἀλλὰ κατασέσηπας, ὥς γ' ἐμοὶ δοκεῖς.
urn:cts:greekLit:tlg0019.tlg011.fucex:1036.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1036.1.text#διὰ δακτυλίου μὲν οὖν ἔμεγ' ἂν διελκύσαις.
urn:cts:greekLit:tlg0019.tlg011.fucex:1037.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1037.1.text#εἰ τυγχάνοι γ' ὁ δακτύλιος ὢν τηλία.
urn:cts:greekLit:tlg0019.tlg011.fucex:1038.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1038.1.text#καὶ μὴν τὸ μειράκιον τοδὶ προσέρχεται,
urn:cts:greekLit:tlg0019.tlg011.fucex:1039.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1039.1.text#οὗπερ πάλαι κατηγοροῦσα τυγχάνω·
urn:cts:greekLit:tlg0019.tlg011.fucex:1040.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1040.1.text#ἔοικε δ' ἐπὶ κῶμον βαδίζειν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1040.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1040.2.text#φαίνεται.
urn:cts:greekLit:tlg0019.tlg011.fucex:1041.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1041.1.text#στέφανόν γέ τοι καὶ δᾷδ' ἔχων πορεύεται.
urn:cts:greekLit:tlg0019.tlg011.fucex:1042.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1042.1.text#ἀσπάζομαί σε.
urn:cts:greekLit:tlg0019.tlg011.fucex:1042.2.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1042.2.text#τί φησιν;
urn:cts:greekLit:tlg0019.tlg011.fucex:1042.3.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1042.3.text#ἀρχαία φίλη,
urn:cts:greekLit:tlg0019.tlg011.fucex:1043.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1043.1.text#πολιὰ γεγένησαι ταχύ γε νὴ τὸν οὐρανόν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1044.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1044.1.text#τάλαιν' ἐγὼ τῆς ὕβρεος ἧς ὑβρίζομαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:1045.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1045.1.text#ἔοικε διὰ πολλοῦ χρόνου σ' ἑορακέναι.
urn:cts:greekLit:tlg0019.tlg011.fucex:1046.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1046.1.text#ποίου χρόνου ταλάνταθ', ὃς παρ' ἐμοὶ χθὲς ἦν;
urn:cts:greekLit:tlg0019.tlg011.fucex:1047.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1047.1.text#τοὐναντίον πέπονθε τοῖς πολλοῖς ἄρα·
urn:cts:greekLit:tlg0019.tlg011.fucex:1048.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1048.1.text#μεθύων γάρ, ὡς ἔικεν, ὀξύτερον βλέπει.
urn:cts:greekLit:tlg0019.tlg011.fucex:1049.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1049.1.text#οὔκ, ἀλλ' ἀκόλαστός ἐστιν ἀεὶ τοὺς τρόπους.
urn:cts:greekLit:tlg0019.tlg011.fucex:1050.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1050.1.text#ὦ Ποντοπόσειδον καὶ θεοὶ πρεσβυτικοί,
urn:cts:greekLit:tlg0019.tlg011.fucex:1051.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1051.1.text#ἐν τῷ προσώπῳ τῶν ῥυτίδων ὅσας ἔχει.
urn:cts:greekLit:tlg0019.tlg011.fucex:1052.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1052.1.text#ἆ ἆ,
urn:cts:greekLit:tlg0019.tlg011.fucex:1052.2.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1052.2.text#τὴν δᾷδα μή μοι πρόσφερ'.
urn:cts:greekLit:tlg0019.tlg011.fucex:1052.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1052.3.text#εὖ μέντοι λέγει.
urn:cts:greekLit:tlg0019.tlg011.fucex:1053.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1053.1.text#ἐὰν γὰρ αὐτὴν εἷς μόνος σπινθὴρ λάβῃ
urn:cts:greekLit:tlg0019.tlg011.fucex:1054.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1054.1.text#ὥσπερ παλαιὰν εἰρεσιώνην καύσεται.
urn:cts:greekLit:tlg0019.tlg011.fucex:1055.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1055.1.text#βούλει διὰ χρόνου πρός με παῖσαι;
urn:cts:greekLit:tlg0019.tlg011.fucex:1055.2.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1055.2.text#ποῖ τάλαν;
urn:cts:greekLit:tlg0019.tlg011.fucex:1056.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1056.1.text#αὐτοῦ, λαβοῦσα κάρυα.
urn:cts:greekLit:tlg0019.tlg011.fucex:1056.2.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1056.2.text#παιδιὰν τίνα;
urn:cts:greekLit:tlg0019.tlg011.fucex:1057.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1057.1.text#πόσους ἔχεις ὀδόντας.
urn:cts:greekLit:tlg0019.tlg011.fucex:1057.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1057.2.text#ἀλλὰ γνώσομαι
urn:cts:greekLit:tlg0019.tlg011.fucex:1058.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1058.1.text#κἄγωγ'· ἔχει γὰρ τρεῖς ἴσως ἢ τέτταρας.
urn:cts:greekLit:tlg0019.tlg011.fucex:1059.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1059.1.text#ἀπότεισον· ἕνα γὰρ γόμφιον μόνον φορεῖ.
urn:cts:greekLit:tlg0019.tlg011.fucex:1060.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1060.1.text#ταλάντατ' ἀνδρῶν οὐχ ὑγιαίνειν μοι δοκεῖς,
urn:cts:greekLit:tlg0019.tlg011.fucex:1061.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1061.1.text#πλυνόν με ποιῶν ἐν τοσούτοις ἀνδράσιν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1062.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1062.1.text#ὄναιο μέντἄν, εἴ τις ἐκπλύνειέ σε.
urn:cts:greekLit:tlg0019.tlg011.fucex:1063.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1063.1.text#οὐ δῆτ', ἐπεὶ νῦν μὲν καπηλικῶς ἔχει,
urn:cts:greekLit:tlg0019.tlg011.fucex:1064.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1064.1.text#εἰ δ' ἐκπλυνεῖται τοῦτο τὸ ψιμύθιον,
urn:cts:greekLit:tlg0019.tlg011.fucex:1065.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1065.1.text#ὄψει κατάδηλα τοῦ προσώπου τὰ ῥάκη.
urn:cts:greekLit:tlg0019.tlg011.fucex:1066.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1066.1.text#γέρων ἀνὴρ ὢν οὐχ ὑγιαίνειν μοι δοκεῖς.
urn:cts:greekLit:tlg0019.tlg011.fucex:1067.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1067.1.text#πειρᾷ μὲν οὖν ἴσως σε καὶ τῶν τιτθίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1068.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1068.1.text#ἐφάπτεταί σου λανθάνειν δοκῶν ἐμέ.
urn:cts:greekLit:tlg0019.tlg011.fucex:1069.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1069.1.text#μὰ τὴν Ἀφροδίτην οὐκ ἐμοῦ γ' ὦ βδελυρὲ σύ.
urn:cts:greekLit:tlg0019.tlg011.fucex:1070.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1070.1.text#μὰ τὴν Ἑκάτην οὐ δῆτα· μαινοίμην γὰρ ἄν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1071.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1071.1.text#ἀλλ' ὦ νεανίσκ' οὐκ ἐῶ τὴν μείρακα
urn:cts:greekLit:tlg0019.tlg011.fucex:1072.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1072.1.text#μισεῖν σε ταύτην.
urn:cts:greekLit:tlg0019.tlg011.fucex:1072.2.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1072.2.text#ἀλλ' ἔγωγ' ὑπερφιλῶ.
urn:cts:greekLit:tlg0019.tlg011.fucex:1073.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1073.1.text#καὶ μὴν κατηγορεῖ γέ σου.
urn:cts:greekLit:tlg0019.tlg011.fucex:1073.2.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1073.2.text#τί κατηγορεῖ;
urn:cts:greekLit:tlg0019.tlg011.fucex:1074.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1074.1.text#εἶναί σ' ὑβριστήν φησι καὶ λέγειν ὅτι
urn:cts:greekLit:tlg0019.tlg011.fucex:1075.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1075.1.text# " πάλαι ποτ' ἦσαν ἄλκιμοι Μιλήσιοι."
urn:cts:greekLit:tlg0019.tlg011.fucex:1076.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1076.1.text#ἐγὼ περὶ ταύτης οὐ μαχοῦμαί σοι.
urn:cts:greekLit:tlg0019.tlg011.fucex:1076.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1076.2.text#τὸ τί;
urn:cts:greekLit:tlg0019.tlg011.fucex:1077.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1077.1.text#αἰσχυνόμενος τὴν ἡλικίαν τὴν σήν, ἐπεὶ
urn:cts:greekLit:tlg0019.tlg011.fucex:1078.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1078.1.text#οὐκ ἄν ποτ' ἄλλῳ τοῦτ' ἐπέτρεψ' ἐγὼ ποιεῖν·
urn:cts:greekLit:tlg0019.tlg011.fucex:1079.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1079.1.text#νῦν δ' ἄπιθι χαίρων συλλαβὼν τὴν μείρακα.
urn:cts:greekLit:tlg0019.tlg011.fucex:1080.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1080.1.text#οἶδ' οἶδα τὸν νοῦν· οὐκέτ' ἀξιοῖς ἴσως
urn:cts:greekLit:tlg0019.tlg011.fucex:1081.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1081.1.text#εἶναι μετ' αὐτῆς.
urn:cts:greekLit:tlg0019.tlg011.fucex:1081.2.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1081.2.text#ὁ δ' ἐπιτρέψων ἐστὶ τίς;
urn:cts:greekLit:tlg0019.tlg011.fucex:1082.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1082.1.text#οὐκ ἂν διαλεχθείην διεσπλεκωμένῃ
urn:cts:greekLit:tlg0019.tlg011.fucex:1083.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1083.1.text#ὑπὸ μυρίων ἐτῶν γε καὶ τρισχιλίων.
urn:cts:greekLit:tlg0019.tlg011.fucex:1084.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1084.1.text#ὅμως δ' ἐπειδὴ καὶ τὸν οἶνον ἠξίους
urn:cts:greekLit:tlg0019.tlg011.fucex:1085.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1085.1.text#πίνειν, συνεκποτέ' ἐστί σοι καὶ τὴν τρύγα.
urn:cts:greekLit:tlg0019.tlg011.fucex:1086.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1086.1.text#ἀλλ' ἔστι κομιδῇ τρὺξ παλαιὰ καὶ σαπρά.
urn:cts:greekLit:tlg0019.tlg011.fucex:1087.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1087.1.text#οὐκοῦν τρύγοιπος ταῦτα πάντ' ἰάσεται.
urn:cts:greekLit:tlg0019.tlg011.fucex:1088.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1088.1.text#ἀλλ' εἴσιθ' εἴσω· τῷ θεῷ γὰρ βούλομαι
urn:cts:greekLit:tlg0019.tlg011.fucex:1089.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1089.1.text#ἐλθὼν ἀναθεῖναι τοὺς στεφάνους τούσδ' οὓς ἔχω.
urn:cts:greekLit:tlg0019.tlg011.fucex:1090.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1090.1.text#ἐγὼ δέ γ' αὐτῷ καὶ φράσαι τι βούλομαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:1091.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1091.1.text#ἐγὼ δέ γ' οὐκ εἴσειμι.
urn:cts:greekLit:tlg0019.tlg011.fucex:1091.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1091.2.text#θάρρει, μὴ φοβοῦ.
urn:cts:greekLit:tlg0019.tlg011.fucex:1092.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1092.1.text#οὐ γὰρ βιάσεται.
urn:cts:greekLit:tlg0019.tlg011.fucex:1092.2.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1092.2.text#πάνυ καλῶς τοίνυν λέγεις.
urn:cts:greekLit:tlg0019.tlg011.fucex:1093.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.fucex:1093.1.text#ἱκανὸν γὰρ αὐτὴν πρότερον ὑπεπίττουν χρόνον.
urn:cts:greekLit:tlg0019.tlg011.fucex:1094.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1094.1.text#βάδιζ'· ἐγὼ δέ σου κατόπιν εἰσέρχομαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:1095.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1095.1.text#ὡς εὐτόνως ὦ Ζεῦ βασιλεῦ τὸ γρᾴδιον
urn:cts:greekLit:tlg0019.tlg011.fucex:1096.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1096.1.text#ὥσπερ λεπὰς τῷ μειρακίῳ προσείχετο.
urn:cts:greekLit:tlg0019.tlg011.fucex:1097.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1097.1.text#τίς ἔσθ' ὁ κόπτων τὴν θύραν; τουτὶ τί ἦν;
urn:cts:greekLit:tlg0019.tlg011.fucex:1098.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1098.1.text#οὐδεὶς ἔοικεν· ἀλλὰ δῆτα τὸ θύριον
urn:cts:greekLit:tlg0019.tlg011.fucex:1099.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1099.1.text#φθεγγόμενον ἄλλως κλαυσιᾷ.
urn:cts:greekLit:tlg0019.tlg011.fucex:1099.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1099.2.text#σέ τοι λέγω,
urn:cts:greekLit:tlg0019.tlg011.fucex:1100.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1100.1.text#ὁ Καρίων, ἀνάμεινον.
urn:cts:greekLit:tlg0019.tlg011.fucex:1100.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1100.2.text#οὗτος εἰπέ μοι,
urn:cts:greekLit:tlg0019.tlg011.fucex:1101.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1101.1.text#σὺ τὴν θύραν ἔκοπτες οὑτωσὶ σφόδρα;
urn:cts:greekLit:tlg0019.tlg011.fucex:1102.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1102.1.text#μὰ Δί' ἀλλ' ἔμελλον· εἶτ' ἀνέῳξάς με φθάσας.
urn:cts:greekLit:tlg0019.tlg011.fucex:1103.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1103.1.text#ἀλλ' ἐκκάλει τὸν δεσπότην τρέχων ταχύ,
urn:cts:greekLit:tlg0019.tlg011.fucex:1104.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1104.1.text#ἒπειτα τὴν γυναῖκα καὶ τὰ παιδία,
urn:cts:greekLit:tlg0019.tlg011.fucex:1105.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1105.1.text#ἔπειτα τοὺς θεράποντας, εἶτα τὴν κύνα,
urn:cts:greekLit:tlg0019.tlg011.fucex:1106.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1106.1.text#ἔπειτα σαυτόν, εἶτα τὴν ὗν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1106.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1106.2.text#εἰπέ μοι,
urn:cts:greekLit:tlg0019.tlg011.fucex:1107.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1107.1.text#τί δ' ἔστιν;
urn:cts:greekLit:tlg0019.tlg011.fucex:1107.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1107.2.text#ὁ Ζεὺς ὦ πόνηρε βούλεται
urn:cts:greekLit:tlg0019.tlg011.fucex:1108.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1108.1.text#ἐς ταὐτὸν ὑμᾶς συγκυκήσας τρύβλιον
urn:cts:greekLit:tlg0019.tlg011.fucex:1109.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1109.1.text#ἁπαξάπαντας ἐς τὸ βάραθρον ἐμβαλεῖν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1110.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1110.1.text#ἡ γλῶττα τῷ κήρυκι τούτων τέμνεται.
urn:cts:greekLit:tlg0019.tlg011.fucex:1111.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1111.1.text#ἀτὰρ διὰ τί δὴ ταῦτ' ἐπιβουλεύει ποιεῖν
urn:cts:greekLit:tlg0019.tlg011.fucex:1112.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1112.1.text#ἡμᾶς;
urn:cts:greekLit:tlg0019.tlg011.fucex:1112.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1112.2.text#ὁτιὴ δεινότατα πάντων πραγμάτων
urn:cts:greekLit:tlg0019.tlg011.fucex:1113.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1113.1.text#εἴργασθ'. ἀφ' οὗ γὰρ ἤρξατ' ἐξ ἀρχῆς βλέπειν
urn:cts:greekLit:tlg0019.tlg011.fucex:1114.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1114.1.text#ὁ Πλοῦτος, οὐδεὶς οὐ λιβανωτόν, οὐ δάφνην,
urn:cts:greekLit:tlg0019.tlg011.fucex:1115.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1115.1.text#οὐ ψαιστόν, οὐχ ἱερεῖον, οὐκ ἄλλ' οὐδὲ ἓν
urn:cts:greekLit:tlg0019.tlg011.fucex:1116.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1116.1.text#ἡμῖν ἔτι θύει τοῖς θεοῖς.
urn:cts:greekLit:tlg0019.tlg011.fucex:1116.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1116.2.text#μὰ Δί' οὐδέ γε
urn:cts:greekLit:tlg0019.tlg011.fucex:1117.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1117.1.text#θύσει. κακῶς γὰρ ἐπεμελεῖσθ' ἡμῶν τότε.
urn:cts:greekLit:tlg0019.tlg011.fucex:1118.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1118.1.text#καὶ τῶν μὲν ἄλλων μοι θεῶν ἧττον μέλει,
urn:cts:greekLit:tlg0019.tlg011.fucex:1119.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1119.1.text#ἐγὼ δ' ἀπόλωλα κἀπιτέτριμμαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:1119.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1119.2.text#σωφρονεῖς.
urn:cts:greekLit:tlg0019.tlg011.fucex:1120.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1120.1.text#πρότερον γὰρ εἶχον μὲν παρὰ ταῖς καπηλίσιν
urn:cts:greekLit:tlg0019.tlg011.fucex:1121.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1121.1.text#πάντ' ἀγάθ' ἕωθεν εὐθύς, οἰνοῦτταν μέλι
urn:cts:greekLit:tlg0019.tlg011.fucex:1122.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1122.1.text#ἰσχάδας, ὅσ' εἰκός ἐστιν Ἑρμῆν ἐσθίειν·
urn:cts:greekLit:tlg0019.tlg011.fucex:1123.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1123.1.text#νυνὶ δὲ πεινῶν ἀναβάδην ἀναπαύομαι.
urn:cts:greekLit:tlg0019.tlg011.fucex:1124.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1124.1.text#οὔκουν δικαίως, ὅστις ἐποίεις ζημίαν
urn:cts:greekLit:tlg0019.tlg011.fucex:1125.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1125.1.text#ἐνίοτε τοιαῦτ' ἀγάθ' ἔχων;
urn:cts:greekLit:tlg0019.tlg011.fucex:1125.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1125.2.text#οἴμοι τάλας,
urn:cts:greekLit:tlg0019.tlg011.fucex:1126.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1126.1.text#οἴμοι πλακοῦντος τοῦ ν' τετράδι πεπεμμένου.
urn:cts:greekLit:tlg0019.tlg011.fucex:1127.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1127.1.text#ποθεῖς τὸν οὐ παρόντα καὶ μάτην καλεῖς.
urn:cts:greekLit:tlg0019.tlg011.fucex:1128.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1128.1.text#οἴμοι δὲ κωλῆς ἣν ἐγὼ κατήσθιον.
urn:cts:greekLit:tlg0019.tlg011.fucex:1129.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1129.1.text#ἀσκωλίαζ' ἐνταῦθα πρὸς τὴν αἰθρίαν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1130.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1130.1.text#σπλάγχνων τε θερμῶν ὧν ἐγὼ κατήσθιον.
urn:cts:greekLit:tlg0019.tlg011.fucex:1131.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1131.1.text#ὀδύνη σε περὶ τὰ σπλάγχν' ἔοικέ τι στρέφειν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1132.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1132.1.text#οἴμοι δὲ κύλικος ἴσον ἴσῳ κεκραμένης.
urn:cts:greekLit:tlg0019.tlg011.fucex:1133.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1133.1.text#ταύτην ἐπιπιὼν ἀποτρέχων οὐκ ἂν φθάνοις.
urn:cts:greekLit:tlg0019.tlg011.fucex:1134.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1134.1.text#ἆρ' ὠφελήσαις ἄν τι τὸν σαυτοῦ φίλον;
urn:cts:greekLit:tlg0019.tlg011.fucex:1135.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1135.1.text#εἴ του δέει γ' ὧν δυνατός εἰμί σ' ὠφελεῖν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1136.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1136.1.text#εἴ μοι πορίσας ἄρτον τιν' εὖ πεπεμμένον
urn:cts:greekLit:tlg0019.tlg011.fucex:1137.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1137.1.text#δοίης καταφαγεῖν καὶ κρέας νεανικὸν
urn:cts:greekLit:tlg0019.tlg011.fucex:1138.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1138.1.text#ὧν θύεθ' ὑμεῖς ἔνδον.
urn:cts:greekLit:tlg0019.tlg011.fucex:1138.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1138.2.text#ἀλλ' οὐκ ἐκφορά.
urn:cts:greekLit:tlg0019.tlg011.fucex:1139.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1139.1.text#καὶ μὴν ὁπότε τι σκευάριον τοῦ δεσπότου
urn:cts:greekLit:tlg0019.tlg011.fucex:1140.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1140.1.text#ὑφέλοι', ἐγώ σε λανθάνειν ἐποίουν ἀεί.
urn:cts:greekLit:tlg0019.tlg011.fucex:1141.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1141.1.text#ἐφ' ᾧ τε μετέχειν καὐτὸς ὦ τοιχωρύχε.
urn:cts:greekLit:tlg0019.tlg011.fucex:1142.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1142.1.text#ἧκεν γὰρ ἄν σοι ναστὸς εὖ πεπεμμένος.
urn:cts:greekLit:tlg0019.tlg011.fucex:1143.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1143.1.text#ἔπειτα τοῦτόν γ' αὐτὸς ἂν κατήσθιες.
urn:cts:greekLit:tlg0019.tlg011.fucex:1144.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1144.1.text#οὐ γὰρ μετεῖχες τὰς ἴσας πληγὰς ἐμοί,
urn:cts:greekLit:tlg0019.tlg011.fucex:1145.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1145.1.text#ὁπότε τι ληφθείην πανουργήσας ἐγώ.
urn:cts:greekLit:tlg0019.tlg011.fucex:1146.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1146.1.text#μὴ μνησικακήσῃς, εἰ σὺ Φυλὴν κατέλαβες.
urn:cts:greekLit:tlg0019.tlg011.fucex:1147.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1147.1.text#ἀλλὰ ξύνοικον πρὸς θεῶν δέξασθέ με.
urn:cts:greekLit:tlg0019.tlg011.fucex:1148.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1148.1.text#ἔπειτ' ἀπολιπὼν τοὺς θεοὺς ἐνθάδε μενεῖς;
urn:cts:greekLit:tlg0019.tlg011.fucex:1149.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1149.1.text#τὰ γὰρ παρ' ὑμῖν ἐστι βελτίω πολύ.
urn:cts:greekLit:tlg0019.tlg011.fucex:1150.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1150.1.text#τί δέ; ταὐτομολεῖν ἀστεῖον εἶναί σοι δοκεῖ;
urn:cts:greekLit:tlg0019.tlg011.fucex:1151.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1151.1.text#πατρὶς γάρ ἐστι πᾶσ' ἵν' ἂν πράττῃ τις εὖ.
urn:cts:greekLit:tlg0019.tlg011.fucex:1152.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1152.1.text#τί δῆτ' ἂν εἴης ὄφελος ἡμῖν ἐνθάδ' ὤν;
urn:cts:greekLit:tlg0019.tlg011.fucex:1153.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1153.1.text#παρὰ τὴν θύραν στροφαῖον ἱδρύσασθέ με.
urn:cts:greekLit:tlg0019.tlg011.fucex:1154.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1154.1.text#στροφαῖον; ἀλλ' οὐκ ἔργον ἔστ' οὐδὲν στροφῶν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1155.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1155.1.text#ἀλλ' ἐμπολαῖον.
urn:cts:greekLit:tlg0019.tlg011.fucex:1155.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1155.2.text#ἀλλὰ πλουτοῦμεν· τί οὖν
urn:cts:greekLit:tlg0019.tlg011.fucex:1156.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1156.1.text#Ἑρμῆν παλιγκάπηλον ἡμᾶς δεῖ τρέφειν;
urn:cts:greekLit:tlg0019.tlg011.fucex:1157.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1157.1.text#ἀλλὰ δόλιον τοίνυν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1157.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1157.2.text#δόλιον; ἥκιστά γε·
urn:cts:greekLit:tlg0019.tlg011.fucex:1158.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1158.1.text#οὐ γὰρ δόλου νῦν ἔργον, ἀλλ' ἁπλῶν τρόπων.
urn:cts:greekLit:tlg0019.tlg011.fucex:1159.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1159.1.text#ἀλλ' ἡγεμόνιον.
urn:cts:greekLit:tlg0019.tlg011.fucex:1159.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1159.2.text#ἀλλ' ὁ θεὸς ἤδη βλέπει,
urn:cts:greekLit:tlg0019.tlg011.fucex:1160.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1160.1.text#ὥσθ' ἡγεμόνος οὐδὲν δεησόμεσθ' ἔτι.
urn:cts:greekLit:tlg0019.tlg011.fucex:1161.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1161.1.text#ἐναγώνιος τοίνυν ἔσομαι. τί δῆτ' ἐρεῖς;
urn:cts:greekLit:tlg0019.tlg011.fucex:1162.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1162.1.text#Πλούτῳ γάρ ἐστι τοῦτο συμφορώτατον
urn:cts:greekLit:tlg0019.tlg011.fucex:1163.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1163.1.text#ποιεῖν ἀγῶνας μουσικοὺς καὶ γυμνικούς.
urn:cts:greekLit:tlg0019.tlg011.fucex:1164.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1164.1.text#ὡς ἀγαθόν ἐστ' ἐπωνυμίας πολλὰς ἔχειν·
urn:cts:greekLit:tlg0019.tlg011.fucex:1165.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1165.1.text#οὗτος γὰρ ἐξηύρηκεν αὑτῷ βιότιον.
urn:cts:greekLit:tlg0019.tlg011.fucex:1166.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1166.1.text#οὐκ ἐτὸς ἅπαντες οἱ δικάζοντες θαμὰ
urn:cts:greekLit:tlg0019.tlg011.fucex:1167.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1167.1.text#σπεύδουσιν ἐν πολλοῖς γεγράφθαι γράμμασιν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1168.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.fucex:1168.1.text#οὐκοῦν ἐπὶ τούτοις εἰσίω;
urn:cts:greekLit:tlg0019.tlg011.fucex:1168.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1168.2.text#καὶ πλῦνέ γε
urn:cts:greekLit:tlg0019.tlg011.fucex:1169.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1169.1.text#αὐτὸς προσελθὼν πρὸς τὸ φρέαρ τὰς κοιλίας,
urn:cts:greekLit:tlg0019.tlg011.fucex:1170.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.fucex:1170.1.text#ἵν' εὐθέως διακονικὸς εἶναι δοκῇς.
urn:cts:greekLit:tlg0019.tlg011.fucex:1171.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.fucex:1171.1.text#τίς ἂν φράσειε ποῦ 'στι Χρεμύλος μοι σαφῶς;
urn:cts:greekLit:tlg0019.tlg011.fucex:1172.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1172.1.text#τί δ' ἔστιν ὦ βέλτιστε;
urn:cts:greekLit:tlg0019.tlg011.fucex:1172.2.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.fucex:1172.2.text#τί γὰρ ἀλλ' ἢ κακῶς;
urn:cts:greekLit:tlg0019.tlg011.fucex:1173.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.fucex:1173.1.text#ἀφ' οὗ γὰρ ὁ Πλοῦτος οὗτος ἤρξατο βλέπειν,
urn:cts:greekLit:tlg0019.tlg011.fucex:1174.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.fucex:1174.1.text#ἀπόλωλ' ὑπὸ λιμοῦ. καταφαγεῖν γὰρ οὐκ ἔχω,
urn:cts:greekLit:tlg0019.tlg011.fucex:1175.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.fucex:1175.1.text#καὶ ταῦτα τοῦ σωτῆρος ἱερεὺς ὢν Διός.
urn:cts:greekLit:tlg0019.tlg011.fucex:1176.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1176.1.text#ἡ δ' αἰτία τίς ἐστιν ὦ πρὸς τῶν θεῶν;
urn:cts:greekLit:tlg0019.tlg011.fucex:1177.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.fucex:1177.1.text#θύειν ἔτ' οὐδεὶς ἀξιοῖ.
urn:cts:greekLit:tlg0019.tlg011.fucex:1177.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1177.2.text#τίνος οὕνεκα;
urn:cts:greekLit:tlg0019.tlg011.fucex:1178.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.fucex:1178.1.text#ὅτι πάντες εἰσὶ πλούσιοι· καίτοι τότε,
urn:cts:greekLit:tlg0019.tlg011.fucex:1179.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.fucex:1179.1.text#ὅτ' εἶχον οὐδέν, ὁ μὲν ἂν ἥκων ἔμπορος
urn:cts:greekLit:tlg0019.tlg011.fucex:1180.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.fucex:1180.1.text#ἔθυσεν ἱερεῖόν τι σωθείς, ὁ δέ τις ἂν
urn:cts:greekLit:tlg0019.tlg011.fucex:1181.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.fucex:1181.1.text#δίκην ἀποφυγών, ὁ δ' ἂν ἐκαλλιερεῖτό τις
urn:cts:greekLit:tlg0019.tlg011.fucex:1182.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.fucex:1182.1.text#κἀμέ γ' ἐκάλει τὸν ἱερέα· νῦν δ' οὐδὲ εἷς
urn:cts:greekLit:tlg0019.tlg011.fucex:1183.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.fucex:1183.1.text#θύει τὸ παράπαν οὐδὲν οὐδ' εἰσέρχεται,
urn:cts:greekLit:tlg0019.tlg011.fucex:1184.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.fucex:1184.1.text#πλὴν ἀποπατησόμενοί γε πλεῖν ἢ μύριοι.
urn:cts:greekLit:tlg0019.tlg011.fucex:1185.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1185.1.text#οὔκουν τὰ νομιζόμενα σὺ τούτων λαμβάνεις;
urn:cts:greekLit:tlg0019.tlg011.fucex:1186.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.fucex:1186.1.text#τὸν οὖν Δία τὸν σωτῆρα καὐτός μοι δοκῶ
urn:cts:greekLit:tlg0019.tlg011.fucex:1187.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.fucex:1187.1.text#χαίρειν ἐάσας ἐνθάδ' αὐτοῦ καταμένειν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1188.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1188.1.text#θάρρει· καλῶς ἔσται γάρ, ἢν θεὸς θέλῃ.
urn:cts:greekLit:tlg0019.tlg011.fucex:1189.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1189.1.text#ὁ Ζεὺς ὁ σωτὴρ γὰρ πάρεστιν ἐνθάδε,
urn:cts:greekLit:tlg0019.tlg011.fucex:1190.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1190.1.text#αὐτόματος ἥκων.
urn:cts:greekLit:tlg0019.tlg011.fucex:1190.2.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.fucex:1190.2.text#πάντ' ἀγαθὰ τοίνυν λέγεις.
urn:cts:greekLit:tlg0019.tlg011.fucex:1191.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1191.1.text#ἱδρυσόμεθ' οὖν αὐτίκα μάλ', ἀλλὰ περίμενε
urn:cts:greekLit:tlg0019.tlg011.fucex:1192.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1192.1.text#τὸν Πλοῦτον, οὗπερ πρότερον ἦν ἱδρυμένος
urn:cts:greekLit:tlg0019.tlg011.fucex:1193.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1193.1.text#τὸν ὀπισθόδομον ἀεὶ φυλάττων τῆς θεοῦ.
urn:cts:greekLit:tlg0019.tlg011.fucex:1194.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1194.1.text#ἀλλ' ἐκδότω τις δεῦρο δᾷδας ἡμμένας,
urn:cts:greekLit:tlg0019.tlg011.fucex:1195.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1195.1.text#ἵν' ἔχων προηγῇ τῷ θεῷ σύ.
urn:cts:greekLit:tlg0019.tlg011.fucex:1195.2.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.fucex:1195.2.text#πάνυ μὲν οὖν
urn:cts:greekLit:tlg0019.tlg011.fucex:1196.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.fucex:1196.1.text#δρᾶν ταῦτα χρή.
urn:cts:greekLit:tlg0019.tlg011.fucex:1196.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1196.2.text#τὸν Πλοῦτον ἔξω τις κάλει.
urn:cts:greekLit:tlg0019.tlg011.fucex:1197.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1197.1.text#ἐγὼ δὲ τί ποιῶ;
urn:cts:greekLit:tlg0019.tlg011.fucex:1197.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1197.2.text#τὰς χύτρας, αἷς τὸν θεὸν
urn:cts:greekLit:tlg0019.tlg011.fucex:1198.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1198.1.text#ἱδρυσόμεθα, λαβοῦσ' ἐπὶ τῆς κεφαλῆς φέρε
urn:cts:greekLit:tlg0019.tlg011.fucex:1199.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1199.1.text#σεμνῶς· ἔχουσα δ' ἦλθες αὐτὴ ποικίλα.
urn:cts:greekLit:tlg0019.tlg011.fucex:1200.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1200.1.text#ὧν δ' οὕνεκ' ἦλθον;
urn:cts:greekLit:tlg0019.tlg011.fucex:1200.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1200.2.text#πάντα σοι πεπράξεται.
urn:cts:greekLit:tlg0019.tlg011.fucex:1201.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1201.1.text#ἥξει γὰρ ὁ νεανίσκος ὡς σ' εἰς ἑσπέραν.
urn:cts:greekLit:tlg0019.tlg011.fucex:1202.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1202.1.text#ἀλλ' εἴ γε μέντοι νὴ Δί' ἐγγυᾷ σύ μοι
urn:cts:greekLit:tlg0019.tlg011.fucex:1203.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.fucex:1203.1.text#ἥξειν ἐκεῖνον ὡς ἔμ', οἴσω τὰς χύτρας.
urn:cts:greekLit:tlg0019.tlg011.fucex:1204.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1204.1.text#καὶ μὴν πολὺ τῶν ἄλλων χυτρῶν τἀναντία
urn:cts:greekLit:tlg0019.tlg011.fucex:1205.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1205.1.text#αὗται ποιοῦσι· ταῖς μὲν ἄλλαις γὰρ χύτραις
urn:cts:greekLit:tlg0019.tlg011.fucex:1206.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1206.1.text#ἡ γραῦς ἔπεστ' ἀνωτάτω, ταύτης δὲ νῦν
urn:cts:greekLit:tlg0019.tlg011.fucex:1207.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.fucex:1207.1.text#τῆς γραὸς ἐπιπολῆς ἔπεισιν αἱ χύτραι.
urn:cts:greekLit:tlg0019.tlg011.fucex:1208.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:1208.1.text#οὐκ ἔτι τοίνυν εἰκὸς μέλλειν οὐδ' ἡμᾶς, ἀλλ' ἀναχωρεῖν
urn:cts:greekLit:tlg0019.tlg011.fucex:1209.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.fucex:1209.1.text#ἐς τοὔπισθεν· δεῖ γὰρ κατόπιν τούτων ᾄδοντας ἕπεσθαι.
