#!ctsdata
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1.1.text#αἶρ' αἶρε μᾶζαν ὡς τάχιστα κανθάρῳ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:2.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:2.1.text#ἰδού. δὸς αὐτῷ, τῷ κάκιστ' ἀπολουμένῳ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:3.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:3.1.text#καὶ μήποτ' αὐτῆς μᾶζαν ἡδίω φάγοι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:4.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:4.1.text#δὸς μᾶζαν ἑτέραν, ἐξ ὀνίδων πεπλασμένην.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:5.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:5.1.text#ἰδοὺ μάλ' αὖφις. ποῦ γὰρ ἣν νῦν δὴ 'φερες;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:6.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:6.1.text#κατέφαγεν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:6.2.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:6.2.text#οὐ μὰ τὸν Δί' ἀλλ' ἐξαρπάσας
urn:cts:greekLit:tlg0019.tlg005.fu.sp:7.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:7.1.text#ὅλην ἐνέκαψε περικυλίσας τοῖν ποδοῖν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:8.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:8.1.text#ἀλλ' ὡς τάχιστα τρῖβε πολλὰς καὶ πυκνάς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:9.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:9.1.text#ἄνδρες κοπρολόγοι προσλάβεσθε πρὸς θεῶν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:10.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:10.1.text#εἰ μή με βούλεσθ' ἀποπνιγέντα περιιδεῖν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:11.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:11.1.text#ἑτέραν ἑτέραν δός, παιδὸς ἡταιρηκότος·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:12.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:12.1.text#τετριμμένης γάρ φησιν ἐπιθυμεῖν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:12.2.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:12.2.text#ἰδού.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:13.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:13.1.text#ἑνὸς μὲν ὦνδρες ἀπολελύσθαι μοι δοκῶ·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:14.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:14.1.text#οὐδεὶς γὰρ ἂν φαίη με μάττοντ' ἐσθίειν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:15.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:15.1.text#αἰβοῖ, φέρ' ἄλλην χἀτέραν μοι χἀτέραν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:16.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:16.1.text#καὶ τρῖβ' ἔθ' ἑτέρας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:16.2.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:16.2.text#μὰ τὸν Ἀπόλλω 'γὼ μὲν οὔ·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:17.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:17.1.text#οὐ γὰρ ἔθ' οἶός τ' εἴμ' ὑπερέχειν τῆς ἀντλίας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:18.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:18.1.text#αὐτὴν ἄρ' οἴσω συλλαβὼν τὴν ἀντλίαν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:19.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:19.1.text#νὴ τὸν Δί' ἐς κόρακάς γε καὶ σαυτόν γε πρός.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:20.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:20.1.text#ὑμῶν δέ γ' εἴ τις οἶδ' ἐμοὶ κατειπάτω,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:21.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:21.1.text#πόθεν ἂν πριαίμην ῥῖνα μὴ τετρημένην.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:22.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:22.1.text#οὐδὲν γὰρ ἔργον ἦν ἄρ' ἀθλιώτερον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:23.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:23.1.text#ἢ κανθάρῳ μάττοντα παρέχειν ἐσθίειν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:24.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:24.1.text#ὗς μὲν γάρ, ὥσπερ ἂν χέσῃ τις, ἢ κύων
urn:cts:greekLit:tlg0019.tlg005.fu.sp:25.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:25.1.text#φαύλως ἐρείδει· τοῦτο δ' ὑπὸ φρονήματος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:26.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:26.1.text#βρενθύεταί τε καὶ φαγεῖν οὐκ ἀξιοῖ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:27.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:27.1.text#ἢν μὴ παραθῶ τρίψας δι' ἡμέρας ὅλης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:28.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:28.1.text#ὥσπερ γυναικὶ γογγύλην μεμαγμένην.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:29.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:29.1.text#ἀλλ' εἰ πέπαυται τῆς ἐδωδῆς σκέψομαι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:30.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:30.1.text#τῃδὶ παροίξας τῆς θύρας, ἵνα μή μ' ἴδῃ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:31.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:31.1.text#ἔρειδε, μὴ παύσαιο μηδέποτ' ἐσθίων
urn:cts:greekLit:tlg0019.tlg005.fu.sp:32.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:32.1.text#τέως ἕως σαυτὸν λάθοις διαρραγείς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:33.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:33.1.text#οἷον δὲ κύψας ὁ κατάρατος ἐσθίει,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:34.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:34.1.text#ὥσπερ παλαιστής, παραβαλὼν τοὺς γομφίους,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:35.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:35.1.text#καὶ ταῦτα τὴν κεφαλήν τε καὶ τὼ χεῖρέ πως
urn:cts:greekLit:tlg0019.tlg005.fu.sp:36.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:36.1.text#ὡδὶ περιάγων, ὥσπερ οἱ τὰ σχοινία
urn:cts:greekLit:tlg0019.tlg005.fu.sp:37.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:37.1.text#τὰ παχέα συμβάλλοντες ἐς τὰς ὁλκάδας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:38.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:38.1.text#μιαρὸν τὸ χρῆμα καὶ κάκοσμον καὶ βορόν·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:39.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:39.1.text#χὤτου ποτ' ἐστὶ δαιμόνων ἡ προσβολὴ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:40.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:40.1.text#οὐκ οἶδ'. Ἀφροδίτης μὲν γὰρ οὔ μοι φαίνεται,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:41.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:41.1.text#οὐ μὴν Χαρίτων γε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:41.2.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:41.2.text#τοῦ γάρ ἐστ';
urn:cts:greekLit:tlg0019.tlg005.fu.sp:41.3.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:41.3.text#οὐκ ἔσθ' ὅπως
urn:cts:greekLit:tlg0019.tlg005.fu.sp:42.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:42.1.text#τοῦτ' ἔστι τὸ τέρας οὐ Διὸς καταιβάτου.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:43.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:43.1.text#οὐκοῦν ἂν ἤδη τῶν θεατῶν τις λέγοι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:44.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:44.1.text#νεανίας δοκησίσοφος, "τὸ δὲ πρᾶγμα τί;"
urn:cts:greekLit:tlg0019.tlg005.fu.sp:45.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:45.1.text#"ὁ κάνθαρος δὲ πρὸς τί;" κᾆτ' αὐτῷ γ' ἀνὴρ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:46.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:46.1.text#Ἰωνικός τίς φησι παρακαθήμενος·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:47.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:47.1.text#"δοκέω μέν, ἐς Κλέωνα τοῦτ' αἰνίσσεται,"
urn:cts:greekLit:tlg0019.tlg005.fu.sp:48.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:48.1.text#"ὡς κεῖνος ἀναιδέως τὴν σπατίλην ἐσθίει."
urn:cts:greekLit:tlg0019.tlg005.fu.sp:49.1.speaker#Οἰκέτης Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:49.1.text#ἀλλ' εἰσιὼν τῷ κανθάρῳ δώσω πιεῖν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:50.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:50.1.text#ἐγὼ δὲ τὸν λόγον γε τοῖσι παιδίοις
urn:cts:greekLit:tlg0019.tlg005.fu.sp:51.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:51.1.text#καὶ τοῖσιν ἀνδρίοισι καὶ τοῖς ἀνδράσιν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:52.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:52.1.text#καὶ τοῖς ὑπερτάτοισιν ἀνδράσιν φράσω
urn:cts:greekLit:tlg0019.tlg005.fu.sp:53.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:53.1.text#καὶ τοῖς ὑπερηνορέουσιν ἔτι τούτοις μάλα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:54.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:54.1.text#ὁ δεσπότης μου μαίνεται καινὸν τρόπον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:55.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:55.1.text#οὐχ ὅνπερ ὑμεῖς, ἀλλ' ἕτερον καινὸν πάνυ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:56.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:56.1.text#δι' ἡμέρας γὰρ ἐς τὸν οὐρανὸν βλέπων
urn:cts:greekLit:tlg0019.tlg005.fu.sp:57.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:57.1.text#ὡδὶ κεχηνὼς λοιδορεῖται τῷ Διὶ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:58.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:58.1.text#καί φησιν, "ὦ Ζεῦ τί ποτε βουλεύει ποιεῖν;"
urn:cts:greekLit:tlg0019.tlg005.fu.sp:59.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:59.1.text#"κατάθου τὸ κόρημα· μὴ 'κκόρει τὴν Ἑλλάδα."
urn:cts:greekLit:tlg0019.tlg005.fu.sp:60.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:60.1.text#ἔα ἔα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:61.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:61.1.text#σιγήσαθ', ὡς φωνῆς ἀκούειν μοι δοκῶ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:62.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:62.1.text#ὦ Ζεῦ τί δρασείεις ποθ' ἡμῶν τὸν λεών;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:63.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:63.1.text#λήσεις σεαυτὸν τὰς πόλεις ἐκκοκκίσας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:64.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:64.1.text#τοῦτ' ἔστι τουτὶ τὸ κακὸν αὔθ' οὑγὼ 'λεγον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:65.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:65.1.text#τὸ γὰρ παράδειγμα τῶν μανιῶν ἀκούετε·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:66.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:66.1.text#ἃ δ' εἶπε πρῶτον ἡνίκ' ἤρχεθ' ἡ χολή,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:67.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:67.1.text#πεύσεσθ'. ἔφασκε γὰρ πρὸς αὑτὸν ἐνθαδί·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:68.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:68.1.text# "πῶς ἄν ποτ' ἀφικοίμην ἂν εὐθὺ τοῦ Διός;"
urn:cts:greekLit:tlg0019.tlg005.fu.sp:69.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:69.1.text#ἔπειτα λεπτὰ κλιμάκια ποιούμενος,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:70.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:70.1.text#πρὸς ταῦτ' ἀνηρριχᾶτ' ἂν ἐς τὸν οὐρανόν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:71.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:71.1.text#ἕως ξυνετρίβη τῆς κεφαλῆς καταρρυείς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:72.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:72.1.text#ἐχθὲς δὲ μετὰ ταῦτ' ἐκφθαρεὶς οὐκ οἶδ' ὅποι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:73.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:73.1.text#εἰσήγαγ' Αἰτναῖον μέγιστον κάνθαρον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:74.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:74.1.text#κἄπειτα τοῦτον ἱπποκομεῖν μ' ἠνάγκασεν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:75.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:75.1.text#καὐτὸς καταψῶν αὐτὸν ὥσπερ πωλίον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:76.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:76.1.text#"ὦ Πηγάσειον," φησί, "γενναῖον πτερόν,"
urn:cts:greekLit:tlg0019.tlg005.fu.sp:77.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:77.1.text#"ὅπως πετήσει μ' εὐθὺ τοῦ Διὸς λαβών."
urn:cts:greekLit:tlg0019.tlg005.fu.sp:78.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:78.1.text#ἀλλ' ὅ τι ποιεῖ τῃδὶ διακύψας ὄψομαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:79.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:79.1.text#οἴμοι τάλας· ἴτε δεῦρο δεῦρ ὦ γείτονες·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:80.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:80.1.text#ὁ δεσπότης γάρ μου μετέωρος αἴρεται
urn:cts:greekLit:tlg0019.tlg005.fu.sp:81.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:81.1.text#ἱππηδὸν ἐς τὸν ἀέρ' ἐπὶ τοῦ κανθάρου.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:82.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:82.1.text#ἥσυχος ἥσυχος, ἠρέμα, κάνθων·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:83.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:83.1.text#μή μοι σοβαρῶς χώρει λίαν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:84.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:84.1.text#εὐθὺς ἀπ' ἀρχῆς ῥώμῃ πίσυνος,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:85.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:85.1.text#πρὶν ἂν ἰδίῃς καὶ διαλύσῃς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:86.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:86.1.text#ἄρθρων ἶνας πτερύγων ῥύμῃ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:87.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:87.1.text#καὶ μὴ πνεῖ μοι κακόν, ἀντιβολῶ σ'·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:88.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:88.1.text#εἰ δὲ ποιήσεις τοῦτο, κατ' οἴκους
urn:cts:greekLit:tlg0019.tlg005.fu.sp:89.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:89.1.text#αὐτοῦ μεῖνον τοὺς ἡμετέρους.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:90.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:90.1.text#ὦ δέσποτ' ἄναξ ὡς παραπαίεις.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:91.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:91.1.text#σίγα σίγα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:92.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:92.1.text#ποῖ δῆτ' ἄλλως μετεωροκοπεῖς;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:93.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:93.1.text#ὑπὲρ Ἑλλήνων πάντων πέτομαι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:94.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:94.1.text#τόλμημα νέον παλαμησάμενος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:95.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:95.1.text#τί πέτει; τί μάτην οὐχ ὑγιαίνεις;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:96.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:96.1.text#εὐφημεῖν χρὴ καὶ μὴ φλαῦρον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:97.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:97.1.text#μηδὲν γρύζειν ἀλλ' ὀλολύζειν·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:98.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:98.1.text#τοῖς τ' ἀνθρώποισι φράσον σιγᾶν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:99.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:99.1.text#τοὺς τε κοπρῶνας καὶ τὰς λαύρας
urn:cts:greekLit:tlg0019.tlg005.fu.sp:100.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:100.1.text#καιναῖς πλίνθοισιν ἀνοικοδομεῖν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:101.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:101.1.text#καὶ τοὺς πρωκτοὺς ἐπικλῄειν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:102.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:102.1.text#οὐκ ἔσθ' ὅπως σιγήσομ', ἢν μή μοι φράσῃς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:103.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:103.1.text#ὅποι πέτεσθαι διανοεῖ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:103.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:103.2.text#τί δ' ἄλλο γ' ἢ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:104.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:104.1.text#ὡς τὸν Δί' ἐς τὸν οὐρανόν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:104.2.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:104.2.text#τίνα νοῦν ἔχων;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:105.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:105.1.text#ἐρησόμενος ἐκεῖνον Ἑλλήνων πέρι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:106.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:106.1.text#ἁπαξαπάντων ὅ τι ποιεῖν βουλεύεται.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:107.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:107.1.text#ἐὰν δὲ μή σοι καταγορεύῃ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:107.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:107.2.text#γράψομαι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:108.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:108.1.text#Μήδοισιν αὐτὸν προδιδόναι τὴν Ἑλλάδα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:109.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:109.1.text#μὰ τὸν Διόνυσον οὐδέποτε ζῶντός γ' ἐμοῦ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:110.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:110.1.text#οὐκ ἔστι παρὰ ταῦτ' ἄλλ'.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:110.2.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:110.2.text#ἰοὺ ἰοὺ ἰού·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:111.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:111.1.text#ὦ παιδί' ὁ πατὴρ ἀπολιπὼν ἀπέρχεται
urn:cts:greekLit:tlg0019.tlg005.fu.sp:112.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:112.1.text#ὑμᾶς ἐρήμους ἐς τὸν οὐρανὸν λάθρᾳ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:113.1.speaker#Οἰκέτης Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:113.1.text#ἀλλ' ἀντιβολεῖτε τὸν πατέρ ὦ κακοδαίμονα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:114.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:114.1.text#ὦ πάτερ ὦ πάτερ ἆρ' ἔτυμός γε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:115.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:115.1.text#δώμασιν ἡμετέροις φάτις ἥκει,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:116.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:116.1.text#ὡς σὺ μετ' ὀρνίθων προλιρὼν ἐμὲ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:117.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:117.1.text#ἐς κόρακας βαδιεῖ μεταμώνιος;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:118.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:118.1.text#ἔστι τι τῶνδ' ἐτύμως; εἴπ' ὦ πάτερ, εἴ τι φιλεῖς με.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:119.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:119.1.text#δοξάσαι ἔστι κόραι, τὸ δ' ἐτήτυμον ἄχθομαι ὑμῖν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:120.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:120.1.text#ἡνίκ' ἂν αἰτίζητ' ἄρτον πάππαν με καλοῦσαι,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:121.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:121.1.text#ἔνδον δ' ἀργυρίου μηδὲ ψακὰς ᾖ πάνυ πάμπαν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:122.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:122.1.text#ἢν δ' ἐγὼ εὖ πράξας ἔλθω πάλιν, ἕξετ' ἐν ὥρᾳ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:123.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:123.1.text#κολλύραν μεγάλην καὶ κόνδυλον ὄψον ἐρ' αὐτῇ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:124.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:124.1.text#καὶ τίς πόρος σοι τῆς ὁδοῦ γενήσεται;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:125.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:125.1.text#ναῦς μὲν γὰρ οὐκ ἄξει σε ταύτην τὴν ὁδόν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:126.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:126.1.text#πτηνὸς πορεύσει πῶλος· οὐ ναυσθλώσομαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:127.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:127.1.text#τίς δ' ἡ 'πίνοιά σοὐστὶν ὥστε κάνθαρον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:128.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:128.1.text#ζεύξαντ' ἐλαύνειν ἐς θεοὺς ὦ παππία;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:129.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:129.1.text#ἐν τοῖσιν Αἰσώπου λόγοις ἐξηυρέθη
urn:cts:greekLit:tlg0019.tlg005.fu.sp:130.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:130.1.text#μόνος πετεινῶν ἐς θεοὺς ἀφιγμένος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:131.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:131.1.text#ἄπιστον εἶπας μῦθον ὦ πάτερ πάτερ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:132.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:132.1.text#ὅπως κάκοσμον ζῷον ἦλθεν ἐς θεούς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:133.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:133.1.text#ἦλθεν κατ' ἔχθραν αἰετοῦ πάλαι ποτέ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:134.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:134.1.text#ᾤ' ἐκκυλίνδων κἀντιτιμωρούμενος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:135.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:135.1.text#οὐκοῦν ἐχρῆν σε Πηγάσου ζεῦξαι πτερόν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:136.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:136.1.text#ὅπως ἐφαίνου τοῖς θεοῖς τραγικώτερος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:137.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:137.1.text#ἀλλ' ὦ μέλ' ἄν μοι σιτίων διπλῶν ἔδει·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:138.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:138.1.text#νῦν δ' ἃττ' ἂν αὐτὸς καταφάγω τὰ σιτία,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:139.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:139.1.text#τούτοισι τοῖς αὐτοῖσι τοῦτον χορτάσω.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:140.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:140.1.text#τί δ' ἢν ἐς ὑγρὸν πόντιον πέσῃ βάθος;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:141.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:141.1.text#πῶς ἐξολισθεῖν πτηνὸς ὢν δυνήσεται;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:142.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:142.1.text#ἐπίτηδες εἶχον πηδάλιον, ᾧ χρήσομαι·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:143.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:143.1.text#τὸ δὲ πλοῖον ἔσται Ναξιουργὴς κάνθαρος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:144.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:144.1.text#λιμὴν δὲ τίς σε δέξεται φορούμενον;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:145.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:145.1.text#ἐν Πειραιεῖ δήπου 'στὶ Κανθάρου λιμήν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:146.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:146.1.text#ἐκεῖνο τήρει, μὴ σφαλεὶς καταρρυῇς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:147.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:147.1.text#ἐντεῦθεν, εἶτα χωλὸς ὢν Εὐριπίδῃ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:148.1.speaker#Παιδίον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:148.1.text#λόγον παράσχῃς καὶ τραγῳδία γένῃ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:149.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:149.1.text#ἐμοὶ μελήσει ταῦτά γ'. ἀλλὰ χαίρετε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:150.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:150.1.text#ὑμεῖς δέ γ', ὑπὲρ ὧν τοὺς πόνους ἐγὼ πονῶ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:151.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:151.1.text#μὴ βδεῖτε μηδὲ χέζεθ' ἡμερῶν τριῶν·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:152.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:152.1.text#ὡς εἰ μετέωρος οὗτος ὢν ὀσφρήσεται,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:153.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:153.1.text#κατωκάρα ῥίψας με βουκολήσεται.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:154.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:154.1.text#ἀλλ' ἄγε Πήγασε χώρει χαίρων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:155.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:155.1.text#χρυσοχάλινον πάταγον ψαλίων
urn:cts:greekLit:tlg0019.tlg005.fu.sp:156.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:156.1.text#διακινήσας φαιδροῖς ὠσίν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:157.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:157.1.text#τί ποιεῖς; τί ποιεῖς; ποῖ παρακλίνεις
urn:cts:greekLit:tlg0019.tlg005.fu.sp:158.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:158.1.text#τοὺς μυκτῆρας; πρὸς τὰς λαύρας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:159.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:159.1.text#ἵει σαυτὸν θαρρῶν ἀπὸ γῆς,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:160.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:160.1.text#κᾆτα δρομαίαν πτέρυγ' ἐκτείνων
urn:cts:greekLit:tlg0019.tlg005.fu.sp:161.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:161.1.text#ὀρθὸς χώρει Διὸς εἰς αὐλάς,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:162.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:162.1.text#ἀπὸ μὲν κάκκης τὴν ῥῖν' ἀπέχων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:163.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:163.1.text#ἀπὸ δ' ἡμερίων σίτων πάντων.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:164.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:164.1.text#ἄνθρωπε τί δρᾷς, οὗτος ὁ χέζων
urn:cts:greekLit:tlg0019.tlg005.fu.sp:165.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:165.1.text#ἐν Πειραιεῖ παρὰ ταῖς πόρναις;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:166.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:166.1.text#ἀπολεῖς μ' ἀπολεῖς. οὐ κατορύξεις
urn:cts:greekLit:tlg0019.tlg005.fu.sp:167.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:167.1.text#κἀπιφορήσεις τῆς γῆς πολλήν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:168.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:168.1.text#κἀπιφυτεύσεις ἕρπυλλον ἄνω
urn:cts:greekLit:tlg0019.tlg005.fu.sp:169.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:169.1.text#καὶ μύρον ἐπιχεῖς; ὡς ἤν τι πεσὼν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:170.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:170.1.text#ἐνθένδε πάθω, τοὐμοῦ θανάτου
urn:cts:greekLit:tlg0019.tlg005.fu.sp:171.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:171.1.text#πέντε τάλανθ' ἡ πόλις ἡ Χίων
urn:cts:greekLit:tlg0019.tlg005.fu.sp:172.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:172.1.text#διὰ τὸν σὸν πρωκτὸν ὀφλήσει.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:173.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:173.1.text#οἴμ' ὡς δέδοικα, κοὐκέτι σκώπτων λέγω.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:174.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:174.1.text#ὦ μηχανοποιὲ πρόσεχε τὸν νοῦν ὡς ἐμέ·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:175.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:175.1.text#ἤδη στρέφει τι πνεῦμα περὶ τὸν ὀμφαλόν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:176.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:176.1.text#κεἰ μὴ φυλάξει, χορτάσω τὸν κάνθαρον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:177.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:177.1.text#ἀτὰρ ἐγγὺς εἶναι τῶν θεῶν ἐμοὶ δοκῶ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:178.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:178.1.text#καὶ δὴ καθορῶ τὴν οἰκίαν τὴν τοῦ Διός.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:179.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:179.1.text#τίς ἐν Διὸς θύραισιν; οὐκ ἀνοίξετε;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:180.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:180.1.text#πόθεν βροτοῦ με προσέβαλ'; ὦναξ Ἡράκλεις
urn:cts:greekLit:tlg0019.tlg005.fu.sp:181.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:181.1.text#τουτὶ τί ἐστι τὸ κακόν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:181.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:181.2.text#ἱπποκάνθαρος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:182.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:182.1.text#ὦ βδελυρὲ καὶ τολμηρὲ κἀναίσχυντε σὺ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:183.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:183.1.text#καὶ μιαρὲ καὶ παμμίαρε καὶ μιαρώτατε,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:184.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:184.1.text#πῶς δεῦρ' ἀνῆλθες ὦ μιαρῶν μιαρώτατε;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:185.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:185.1.text#τί σοί ποτ' ἔστ' ὄνομ'; οὐκ ἐρεῖς;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:185.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:185.2.text#μιαρώτατος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:186.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:186.1.text#ποδαπὸς τὸ γένος δ' εἶ; φράζε μοι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:186.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:186.2.text#μιαρώτατος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:187.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:187.1.text#πατὴρ δέ σοι τίς ἐστ';
urn:cts:greekLit:tlg0019.tlg005.fu.sp:187.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:187.2.text#ἐμοί; μιαρώτατος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:188.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:188.1.text#οὔτοι μὰ τὴν γῆν ἔσθ' ὅπως οὐκ ἀποθανεῖ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:189.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:189.1.text#εἰ μὴ κατερεῖς μοι τοὔνομ' ὅ τι ποτ' ἔστι σοι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:190.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:190.1.text#Τρυγαῖος Ἀθμονεύς, ἀμπελουργὸς δεξιός,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:191.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:191.1.text#οὐ συκοφάντης οὐδ' ἐραστὴς πραγμάτων.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:192.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:192.1.text#ἥκεις δὲ κατὰ τί;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:192.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:192.2.text#τὰ κρέα ταυτί σοι φέρων.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:193.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:193.1.text#ὦ δειλακρίων πῶς ἦλθες;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:193.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:193.2.text#ὦ γλίσχρων ὁρᾷς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:194.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:194.1.text#ὡς οὐκέτ' εἶναί σοι δοκῶ μιαρώτατος;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:195.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:195.1.text#ἴθι νυν κάλεσόν μοι τὸν Δί'.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:195.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:195.2.text#ἰὴ ἰὴ ἰή,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:196.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:196.1.text#ὅτι οὐδὲ μέλλεις ἐγγὺς εἶναι τῶν θεῶν·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:197.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:197.1.text#φροῦδοι γὰρ ἐχθές εἰσιν ἐξῳκισμένοι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:198.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:198.1.text#ποῖ γῆς;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:198.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:198.2.text#ἰδοὺ γῆς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:198.3.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:198.3.text#ἀλλὰ ποῖ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:198.4.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:198.4.text#πόρρω πάνυ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:199.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:199.1.text#ὑπ' αὐτὸν ἀτεχνῶς τοὐρανοῦ τὸν κύτταρον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:200.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:200.1.text#πῶς οὖν σὺ δῆτ' ἐνταῦθα κατελείφθης μόνος;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:201.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:201.1.text#τὰ λοιπὰ τηρῶ σκευάρια τὰ τῶν θεῶν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:202.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:202.1.text#χυτρίδια καὶ σανίδια κἀμφορείδια.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:203.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:203.1.text#ἐξῳκίσαντο δ' οἱ θεοὶ τίνος οὕνεκα;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:204.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:204.1.text#Ἕλλησιν ὀργισθέντες. εἶτ' ἐνταῦθα μὲν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:205.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:205.1.text#ἵν' ἦσαν αὐτοὶ τὸν Πόλεμον κατῴκισαν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:206.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:206.1.text#ὑμᾶς παραδόντες δρᾶν ἀτεχνῶς ὅ τι βούλεται·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:207.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:207.1.text#αὐτοὶ δ' ἀνῳκίσανθ' ὅπως ἀνωτάτω,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:208.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:208.1.text#ἵνα μὴ βλέποιεν μαχομένους ὑμᾶς ἔτι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:209.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:209.1.text#μηδ' ἀντιβολούντων μηδὲν αἰσθανοίατο.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:210.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:210.1.text#τοῦ δ' οὕνεχ' ἡμᾶς ταῦτ' ἔδρασαν; εἰπέ μοι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:211.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:211.1.text#ὁτιὴ πολεμεῖν ᾑρεῖσθ' ἐκείνων πολλάκις
urn:cts:greekLit:tlg0019.tlg005.fu.sp:212.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:212.1.text#σπονδὰς ποιούντων· κεἰ μὲν οἱ Λακωνικοὶ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:213.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:213.1.text#ὑπερβάλοιντο μικρόν, ἔλεγον ἂν ταδί·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:214.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:214.1.text# "ναὶ τὼ σιὼ νῦν ὡττικίων δωσεῖ δίκαν."
urn:cts:greekLit:tlg0019.tlg005.fu.sp:215.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:215.1.text#εἰ δ' αὖ τι πράξαιτ' ἀγαθὸν ἁττικωνικοί
urn:cts:greekLit:tlg0019.tlg005.fu.sp:216.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:216.1.text#κἄλθοιεν οἱ Λάκωνες εἰρήνης πέρι,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:217.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:217.1.text#ἐλέγετ' ἂν ὑμεῖς εὐθύς· "ἐξαπατώμεθα"
urn:cts:greekLit:tlg0019.tlg005.fu.sp:218.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:218.1.text#"νὴ τὴν Ἀθηνᾶν, νὴ Δί', οὐχὶ πειστέον·"
urn:cts:greekLit:tlg0019.tlg005.fu.sp:219.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:219.1.text#"ἥξουσι καὖθις, ἢν ἔχωμεν τὴν Πύλον."’
urn:cts:greekLit:tlg0019.tlg005.fu.sp:220.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:220.1.text#ὁ γοῦν χαρακτὴρ ἡμεδαπὸς τῶν ῥημάτων.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:221.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:221.1.text#ὧν οὕνεκ' οὐκ οἶδ' εἴ ποτ' Εἰρήνην ἔτι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:222.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:222.1.text#τὸ λοιπὸν ὄψεσθ'.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:222.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:222.2.text#ἀλλὰ ποῖ γὰρ οἴχεται;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:223.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:223.1.text#ὁ Πόλεμος αὐτὴν ἐνέβαλ' εἰς ἄντρον βαθύ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:224.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:224.1.text#ἐς ποῖον;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:224.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:224.2.text#ἐς τουτὶ τὸ κάτω, κἄπειθ' ὁρᾷς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:225.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:225.1.text#ὅσους ἄνωθεν ἐπεφόρησε τῶν λίθων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:226.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:226.1.text#ἵνα μὴ λάβητε μηδέποτ' αὐτήν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:226.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:226.2.text#εἰπέ μοι,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:227.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:227.1.text#ἡμᾶς δὲ δὴ τί δρᾶν παρασκευάζεται;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:228.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:228.1.text#οὐκ οἶδα πλὴν ἕν, ὅτι θυείαν ἑσπέρας
urn:cts:greekLit:tlg0019.tlg005.fu.sp:229.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:229.1.text#ὑπερφυᾶ τὸ μέγεθος εἰσηνέγκατο.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:230.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:230.1.text#τί δῆτα ταύτῃ τῇ θυείᾳ χρήσεται;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:231.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:231.1.text#τρίβειν ἐν αὐτῇ τὰς πόλεις βουλεύεται.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:232.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:232.1.text#ἀλλ' εἶμι· καὶ γὰρ ἐξιέναι γνώμην ἐμὴν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:233.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:233.1.text#μέλλει· θορυβεῖ γοῦν ἔνδον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:233.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:233.2.text#οἴμοι δείλαιος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:234.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:234.1.text#φέρ' αὐτὸν ἀποδρῶ· καὶ γὰρ ὥσπερ ᾐσθόμην
urn:cts:greekLit:tlg0019.tlg005.fu.sp:235.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:235.1.text#καὐτὸς θυείας φθέγμα πολεμιστηρίας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:236.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:236.1.text#ἰὼ βροτοὶ βροτοὶ βροτοὶ πολυτλήμονες,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:237.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:237.1.text#ὡς αὐτίκα μάλα τὰς γνάθους ἀλγήσετε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:238.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:238.1.text#ὦναξ Ἄπολλον τῆς θυείας τοῦ πλάτους,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:239.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:239.1.text#ὅσον κακόν, καὶ τοῦ Πολέμου τοῦ βλέμματος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:240.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:240.1.text#ἆρ' οὗτός ἐστ' ἐκεῖνος ὃν καὶ φεύγομεν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:241.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:241.1.text#ὁ δεινός, ὁ ταλαύρινος, ὁ κατὰ τοῖν σκελοῖν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:242.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:242.1.text#ἰὼ Πρασιαὶ τρὶς ἄθλιαι καὶ πεντάκις
urn:cts:greekLit:tlg0019.tlg005.fu.sp:243.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:243.1.text#καὶ πολλοδεκάκις, ὡς ἀπολεῖσθε τήμερον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:244.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:244.1.text#τουτὶ μὲν ἄνδρες οὐδὲν ἡμῖν πρᾶγμά πω·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:245.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:245.1.text#τὸ γὰρ κακὸν τοῦτ' ἐστὶ τῆς Λακωνικῆς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:246.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:246.1.text#ὦ Μέγαρα Μέγαρ' ὡς ἐπιτετρίψεσθ' αὐτίκα
urn:cts:greekLit:tlg0019.tlg005.fu.sp:247.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:247.1.text#ἁπαξάπαντα καταμεμυττωτευμένα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:248.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:248.1.text#βαβαὶ βαβαιὰξ ὡς μεγάλα καὶ δριμέα
urn:cts:greekLit:tlg0019.tlg005.fu.sp:249.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:249.1.text#τοῖσι Μεγαρεῦσιν ἐνέβαλεν τὰ κλαύματα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:250.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:250.1.text#ἰὼ Σικελία καὶ σὺ δ' ὡς ἀπόλλυσαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:251.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:251.1.text#οἵα πόλις τάλαινα διακναισθήσεται.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:252.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:252.1.text#φέρ' ἐπιχέω καὶ τὸ μέλι τουτὶ τἀττικόν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:253.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:253.1.text#οὗτος παραινῶ σοι μέλιτι χρῆσθἀτέρῳ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:254.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:254.1.text#τετρώβολον τοῦτ' ἐστί· φείδου τἀττικοῦ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:255.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:255.1.text#παῖ παῖ Κυδοιμέ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:255.2.speaker#Κύδοιμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:255.2.text#τί με καλεῖς;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:255.3.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:255.3.text#κλαύσει μακρά.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:256.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:256.1.text#ἕστηκας ἀργός; οὑτοσί σοι κόνδυλος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:257.1.speaker#Κύδοιμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:257.1.text#ὡς δριμύς. οἴμοι μοι τάλας ὦ δέσποτα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:258.1.speaker#Κύδοιμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:258.1.text#μῶν τῶν σκορόδων ἐνέβαλες ἐς τὸν κόνδυλον;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:259.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:259.1.text#οἴσεις ἀλετρίβανον τρέχων;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:259.2.speaker#Κύδοιμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:259.2.text#ἀλλ' ὦ μέλε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:260.1.speaker#Κύδοιμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:260.1.text#οὐκ ἔστιν ἡμῖν· ἐχθὲς εἰσῳκίσμεθα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:261.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:261.1.text#οὔκουν παρ' Ἀθηναίων μεταθρέξει ταχὺ πάνυ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:262.1.speaker#Κύδοιμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:262.1.text#ἔγωγε νὴ Δί'· εἰ δὲ μή γε, κλαύσομαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:263.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:263.1.text#ἄγε δὴ τί δρῶμεν ὦ πόνηρ' ἀνθρώπια;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:264.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:264.1.text#ὁρᾶτε τὸν κίνδυνον ἡμῖν ὡς μέγας·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:265.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:265.1.text#εἴπερ γὰρ ἥξει τὸν ἀλετρίβανον φέρων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:266.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:266.1.text#τούτῳ ταράξει τὰς πόλεις καθήμενος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:267.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:267.1.text#ἀλλ' ὦ Διόνυσ' ἀπόλοιτο καὶ μὴ 'λθοι φέρων.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:268.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:268.1.text#οὗτος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:268.2.speaker#Κύδοιμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:268.2.text#τί ἔστιν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:268.3.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:268.3.text#οὐ φέρεις;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:268.4.speaker#Κύδοιμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:268.4.text#τὸ δεῖνα γὰρ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:269.1.speaker#Κύδοιμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:269.1.text#ἀπόλωλ' Ἀθηναίοισιν ἁλετρίβανος,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:270.1.speaker#Κύδοιμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:270.1.text#ὁ βυρσοπώλης, ὃς ἐκύκα τὴν Ἑλλάδα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:271.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:271.1.text#εὖ γ' ὦ πότνια δέσποιν' Ἀθηναία ποιῶν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:272.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:272.1.text#ἀπόλωλ' ἐκεῖνος κἀν δέοντι τῇ πόλει,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:273.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:273.1.text#ἢ πρίν γε τὸν μυττωτὸν ἡμῖν ἐγχέαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:274.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:274.1.text#οὔκουν ἕτερον δῆτ' ἐκ Λακεδαίμονος μέτει
urn:cts:greekLit:tlg0019.tlg005.fu.sp:275.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:275.1.text#ἀνύσας τι;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:275.2.speaker#Κύδοιμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:275.2.text#ταῦτ' ὦ δέσποθ'.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:275.3.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:275.3.text#ἧκέ νυν ταχύ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:276.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:276.1.text#ὦνδρες τί πεισόμεσθα; νῦν ἀγὼν μέγας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:277.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:277.1.text#ἀλλ' εἴ τις ὑμῶν ἐν Σαμοθρᾴκῃ τυγχάνει
urn:cts:greekLit:tlg0019.tlg005.fu.sp:278.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:278.1.text#μεμυημένος, νῦν ἐστιν εὔξασθαι καλὸν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:279.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:279.1.text#ἀποστραφῆναι τοῦ μετιόντος τὼ πόδε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:280.1.speaker#Κύδοιμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:280.1.text#οἴμοι τάλας, οἴμοι γε κἄτ' οἴμοι μάλα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:281.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:281.1.text#τί ἔστι; μῶν οὐκ αὖ φέρεις;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:281.2.speaker#Κύδοιμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:281.2.text#ἀπόλωλε γὰρ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:282.1.speaker#Κύδοιμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:282.1.text#καὶ τοῖς Λακεδαιμονίοισιν ἁλετρίβανος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:283.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:283.1.text#πῶς ὦ πανοῦργ';
urn:cts:greekLit:tlg0019.tlg005.fu.sp:283.2.speaker#Κύδοιμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:283.2.text#ἐς τἀπὶ Θρᾴκης χωρία
urn:cts:greekLit:tlg0019.tlg005.fu.sp:284.1.speaker#Κύδοιμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:284.1.text#χρήσαντες ἑτέροις αὐτὸν εἶτ' ἀπώλεσαν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:285.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:285.1.text#εὖ γ' εὖ γε ποιήσαντες ὦ Διοσκόρω.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:286.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:286.1.text#ἴσως ἂν εὖ γένοιτο· θαρρεῖτ' ὦ βροτοί.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:287.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:287.1.text#ἀπόφερε τὰ σκεύη λαβὼν ταυτὶ πάλιν·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:288.1.speaker#Πόλεμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:288.1.text#ἐγὼ δὲ δοίδυκ' εἰσιὼν ποιήσομαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:289.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:289.1.text#νῦν τοῦτ' ἐκεῖν' ἥκει τὸ Δάτιδος μέλος,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:290.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:290.1.text#ὃ δεφόμενός ποτ' ᾖδε τῆς μεσημβρίας,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:291.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:291.1.text# "ὡς ἥδομαι καὶ χαίρομαι κεὐφραίνομαι."
urn:cts:greekLit:tlg0019.tlg005.fu.sp:292.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:292.1.text#νῦν ἐστιν ἡμῖν ὦνδρες Ἕλληνες καλὸν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:293.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:293.1.text#ἀπαλλαγεῖσι πραγμάτων τε καὶ μαχῶν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:294.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:294.1.text#ἐξελκύσαι τὴν πᾶσιν Εἰρήνην φίλην,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:295.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:295.1.text#πρὶν ἕτερον αὖ δοίδυκα κωλῦσαί τινα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:296.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:296.1.text#ἀλλ' ὦ γεωργοὶ κἄμποροι καὶ τέκτονες
urn:cts:greekLit:tlg0019.tlg005.fu.sp:297.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:297.1.text#καὶ δημιουργοὶ καὶ μέτοικοι καὶ ξένοι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:298.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:298.1.text#καὶ νησιῶται, δεῦρ' ἴτ' ὦ πάντες λεῴ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:299.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:299.1.text#ὡς τάχιστ' ἄμας λαβόντες καὶ μοχλοὺς καὶ σχοινία·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:300.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:300.1.text#νῦν γὰρ ἡμῖν ἁρπάσαι πάρεστιν ἀγαθοῦ δαίμονος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:301.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:301.1.text#δεῦρο πᾶς χώρει προθύμως εὐθὺ τῆς σωτηρίας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:302.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:302.1.text#ὦ Πανέλληνες βοηθήσωμεν, εἴπερ πώποτε,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:303.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:303.1.text#τάξεων ἀπαλλαγέντες καὶ κακῶν φοινικικῶν·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:304.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:304.1.text#ἡμέρα γὰρ ἐξέλαμψεν ἥδε μισολάμαχος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:305.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:305.1.text#πρὸς τάδ' ἡμῖν, εἴ τι χρὴ δρᾶν, φράζε κἀρχιτεκτόνει·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:306.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:306.1.text#οὐ γὰρ ἔσθ' ὅπως ἀπειπεῖν ἂν δοκῶ μοι τήμερον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:307.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:307.1.text#πρὶν μοχλοῖς καὶ μηχαναῖσιν ἐς τὸ φῶς ἀνελκύσαι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:308.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:308.1.text#τὴν θεῶν πασῶν μεγίστην καὶ φιλαμπελωτάτην.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:309.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:309.1.text#οὐ σιωπήσεσθ', ὅπως μὴ περιχαρεῖς τῷ πράγματι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:310.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:310.1.text#τὸν Πόλεμον ἐκζωπυρήσετ' ἔνδοθεν κεκραγότες;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:311.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:311.1.text#ἀλλ' ἀκούσαντες τοιούτου χαίρομεν κηρύγματος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:312.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:312.1.text#οὐ γὰρ ἦν ἔχοντας ἥκειν σιτί' ἡμερῶν τριῶν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:313.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:313.1.text#εὐλαβεῖσθέ νυν ἐκεῖνον τὸν κάτωθεν Κέρβερον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:314.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:314.1.text#μὴ παφλάζων καὶ κεκραγὼς ὥσπερ ἡνίκ' ἐνθάδ' ἦν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:315.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:315.1.text#ἐμποδὼν ἡμῖν γένηται τὴν θεὸν μὴ 'ξελκύσαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:316.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:316.1.text#οὔτι καὶ νῦν ἔστιν αὐτὴν ὅστις ἐξαιρήσεται,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:317.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:317.1.text#ἢν ἅπαξ ἐς χεῖρας ἔλθῃ τὰς ἐμάς. ἰοῦ ἰοῦ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:318.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:318.1.text#ἐξολεῖτέ μ' ὦνδρες, εἰ μὴ τῆς βοῆς ἀνήσετε·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:319.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:319.1.text#ἐκδραμὼν γὰρ πάντα ταυτὶ συνταράξει τοῖν ποδοῖν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:320.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:320.1.text#ὡς κυκάτω καὶ πατείτω πάντα καὶ ταραττέτω,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:321.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:321.1.text#οὐ γὰρ ἂν χαίροντες ἡμεῖς τήμερον παυσαίμεθ' ἄν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:322.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:322.1.text#τί τὸ κακόν; τί πάσχετ' ὦνδρες; μηδαμῶς πρὸς τῶν θεῶν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:323.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:323.1.text#πρᾶγμα κάλλιστον διαφθείρητε διὰ τὰ σχήματα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:324.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:324.1.text#ἀλλ' ἔγωγ' οὐ σχηματίζειν βούλομ', ἀλλ' ὑφ' ἡδονῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:325.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:325.1.text#οὐκ ἐμοῦ κινοῦντος αὐτὼ τὼ σκέλει χορεύετον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:326.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:326.1.text#μή τι καὶ νυνί γ' ἔτ', ἀλλὰ παῦε παῦ' ὀρχούμενος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:327.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:327.1.text#ἢν ἰδοὺ καὶ δὴ πέπαυμαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:327.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:327.2.text#φῄς γε, παύει δ' οὐδέπω.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:328.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:328.1.text#ἓν μὲν οὖν τουτί μ' ἔασον ἑλκύσαι, καὶ μηκέτι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:329.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:329.1.text#τοῦτό νυν, καὶ μηκέτ' ἄλλο μηδὲν ὀρχήσησθ' ἔτι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:330.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:330.1.text#οὐκ ἂν ὀρχησαίμεθ', εἴπερ ὠφελήσαιμέν τί σε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:331.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:331.1.text#ἀλλ' ὁρᾶτ' οὔπω πέπαυσθε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:331.2.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:331.2.text#τουτογὶ νὴ τὸν Δία
urn:cts:greekLit:tlg0019.tlg005.fu.sp:332.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:332.1.text#τὸ σκέλος ῥίψαντες ἤδη λήγομεν τὸ δεξιόν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:333.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:333.1.text#ἐπιδίδωμι τοῦτό γ' ὑμῖν ὥστε μὴ λυπεῖν ἔτι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:334.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:334.1.text#ἀλλὰ καὶ τἀριστερόν τοί μ' ἐστ' ἀναγκαίως ἔχον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:335.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:335.1.text#ἥδομαι γὰρ καὶ γέγηθα καὶ πέπορδα καὶ γελῶ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:336.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:336.1.text#μᾶλλον ἢ τὸ γῆρας ἐκδὺς ἐκφυγὼν τὴν ἀσπίδα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:337.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:337.1.text#μή τι καὶ νυνί γε χαίρετ'· οὐ γὰρ ἴστε πω σαφῶς·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:338.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:338.1.text#ἀλλ' ὅταν λάβωμεν αὐτήν, τηνικαῦτα χαίρετε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:339.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:339.1.text#καὶ βοᾶτε καὶ γελᾶτ'· ἤδη
urn:cts:greekLit:tlg0019.tlg005.fu.sp:340.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:340.1.text#γὰρ ἐξέσται τόθ' ὑμῖν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:341.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:341.1.text#πλεῖν μένειν βινεῖν καθεύδειν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:342.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:342.1.text#ἐς πανηγύρεις θεωρεῖν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:343.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:343.1.text#ἑστιᾶσθαι κοτταβίζειν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:344.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:344.1.text#†συβαρίζειν†
urn:cts:greekLit:tlg0019.tlg005.fu.sp:345.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:345.1.text#ἰοῦ ἰοῦ κεκραγέναι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:346.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:346.1.text#εἰ γὰρ ἐκγένοιτ' ἰδεῖν ταύτην με τὴν ἡμέραν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:347.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:347.1.text#πολλὰ γὰρ ἀνεσχόμην πράγματά τε καὶ στιβάδας, ἃς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:348.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:348.1.text#ἔλαχε Φορμίων·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:349.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:349.1.text#κοὐκέτ' ἄν μ' εὕροις δικαστὴν δριμὺν οὐδὲ δύσκολον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:350.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:350.1.text#οὐδὲ τοὺς τρόπους γε δήπου σκληρὸν ὥσπερ καὶ πρὸ τοῦ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:351.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:351.1.text#ἀλλ' ἁπαλὸν ἄν μ' ἴδοις καὶ πολὺ νεώτερον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:352.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:352.1.text#ἀπαλλαγέντα πραγμάτων.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:355.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:355.1.text#καὶ γὰρ ἱκανὸν χρόνον ἀπολλύμεθα καὶ κατατετρίμμεθα πλανώμενοι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:356.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:356.1.text#ἐς Λύκειον κἀκ Λυκείου ξὺν δορὶ ξὺν ἀσπίδι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:357.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:357.1.text#ἀλλ' ὅ τι μάλιστα χαριούμεθα ποιοῦντες, ἄγε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:360.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:360.1.text#φράζε· σὲ γὰρ αὐτοκράτορ' εἵλετ' ἀγαθή τις ἡμῖν τύχη.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:361.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:361.1.text#φέρε δὴ κατίδω ποῖ τοὺς λίθους ἀφέλξομεν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:362.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:362.1.text#ὦ μιαρὲ καὶ τολμηρὲ τί ποιεῖν διανοεῖ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:363.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:363.1.text#οὐδὲν πονηρόν, ἀλλ' ὅπερ καὶ Κιλλικῶν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:364.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:364.1.text#ἀπόλωλας ὦ κακόδαιμον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:364.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:364.2.text#οὐκοῦν ἢν λάχω.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:365.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:365.1.text#Ἑρμῆς γὰρ ὢν κλήρῳ ποιήσεις οἶδ' ὅτι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:366.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:366.1.text#ἀπόλωλας, ἐξόλωλας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:366.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:366.2.text#ἐς τίν' ἡμέραν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:367.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:367.1.text#εἰς αὐτίκα μάλ'.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:367.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:367.2.text#ἀλλ' οὐδὲν ἠμπόληκά πω,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:368.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:368.1.text#οὔτ' ἄλφιτ' οὔτε τυρόν, ὡς ἀπολούμενος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:369.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:369.1.text#καὶ μὴν ἐπιτέτριψαί γε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:369.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:369.2.text#κᾆτα τῷ τρόπῳ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:370.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:370.1.text#οὐκ ᾐσθόμην ἀγαθὸν τοσουτονὶ λαβών;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:371.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:371.1.text#ἆρ' οἶσθα θάνατον ὅτι προεῖφ' ὁ Ζεὺς ὃς ἂν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:372.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:372.1.text#ταύτην ἀνορύττων εὑρεθῇ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:373.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:373.1.text#νῦν ἆρά με
urn:cts:greekLit:tlg0019.tlg005.fu.sp:373.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:373.2.text#ἅπασ' ἀνάγκη 'στ' ἀποθανεῖν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:374.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:374.1.text#εὖ ἴσθ' ὅτι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:374.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:374.2.text#ἐς χοιρίδιόν μοί νυν δάνεισον τρεῖς δραχμάς·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:375.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:375.1.text#δεῖ γὰρ μυηθῆναί με πρὶν τεθνηκέναι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:376.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:376.1.text#ὦ Ζεῦ κεραυνοβρόντα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:376.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:376.2.text#μὴ πρὸς τῶν θεῶν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:377.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:377.1.text#ἡμῶν κατείπῃς, ἀντιβολῶ σε δέσποτα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:378.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:378.1.text#οὐκ ἂν σιωπήσαιμι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:378.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:378.2.text#ναὶ πρὸς τῶν κρεῶν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:379.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:379.1.text#ἁγὼ προθύμως σοι φέρων ἀφικόμην.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:380.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:380.1.text#ἀλλ' ὦ μέλ' ὑπὸ τοῦ Διὸς ἀμαλδυνθήσομαι,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:381.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:381.1.text#εἰ μὴ τετορήσω ταῦτα καὶ λακήσομαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:382.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:382.1.text#μή νυν λακήσῃς, λίσσομαί σ' ὦρμῄδιον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:383.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:383.1.text#εἰπέ μοι, τί πάσχετ' ὦνδρες; ἕστατ' ἐκπεπληγμένοι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:384.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:384.1.text#ὦ πόνηροι μὴ σιωπᾶτ'· εἰ δὲ μή, λακήσεται.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:385.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:385.1.text#μηδαμῶς ὦ δέσποθ' Ἑρμῆ, μηδαμῶς, μηδαμῶς,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:386.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:386.1.text#εἴ τι κεχαρισμένον χοιρίδιον οἶσθα παρ' ἐμοῦ γε κατεδηδοκώς,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:387.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:387.1.text#τοῦτο μὴ φαῦλον νόμιζ' ἐν τῷδε τῷ νῦν πράγματι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:388.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:388.1.text#οὐκ ἀκούεις οἷα θωπεύουσί σ' ὦναξ δέσποτα;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:390.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:390.1.text#†μὴ γένῃ παλίγκοτος ἀντιβολοῦσιν ἡμῖν,†
urn:cts:greekLit:tlg0019.tlg005.fu.sp:391.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:391.1.text#ὥστε τήνδε μὴ λαβεῖν·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:392.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:392.1.text#ἀλλὰ χάρισ' ὦ φιλανθρωπότατε καὶ μεγαλοδωρότατε δαιμόνων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:395.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:395.1.text#εἴ τι Πεισάνδρου βδελύττει τοὺς λόφους καὶ τὰς ὀφρῦς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:396.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:396.1.text#καί σε θυσίαισιν ἱεραῖσι προσόδοις τε μεγάλαισι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:397.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:397.1.text#διὰ παντὸς ὦ δέσποτ' ἀγαλοῦμεν ἡμεῖς ἀεί.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:400.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:400.1.text#ἴθ', ἀντιβολῶ σ', ἐλέησον αὐτῶν τὴν ὄπα,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:401.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:401.1.text#ἐπεί σε καὶ τιμῶσι μᾶλλον ἢ πρὸ τοῦ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:402.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:402.1.text#κλέπται γάρ εἰσι νῦν γε μᾶλλον ἢ πρὸ τοῦ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:403.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:403.1.text#καί σοι φράσω τι πρᾶγμα δεινὸν καὶ μέγα,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:404.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:404.1.text#ὃ τοῖς θεοῖς ἅπασιν ἐπιβουλεύεται.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:405.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:405.1.text#ἴθι δὴ κάτειπ'· ἴσως γὰρ ἂν πείσαις ἐμέ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:406.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:406.1.text#ἡ γὰρ Σελήνη χὠ πανοῦργος Ἥλιος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:407.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:407.1.text#ὑμῖν ἐπιβουλεύοντε πολὺν ἤδη χρόνον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:408.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:408.1.text#τοῖς βαρβάροισι προδίδοτον τὴν Ἑλλάδα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:409.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:409.1.text#ἵνα δὴ τί τοῦτο δρᾶτον;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:409.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:409.2.text#ὁτιὴ νὴ Δία
urn:cts:greekLit:tlg0019.tlg005.fu.sp:410.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:410.1.text#ἡμεῖς μὲν ὑμῖν θύομεν, τούτοισι δὲ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:411.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:411.1.text#οἱ βάρβαροι θύουσι. διὰ τοῦτ' εἰκότως
urn:cts:greekLit:tlg0019.tlg005.fu.sp:412.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:412.1.text#βούλοιντ' ἂν ἡμᾶς πάντας ἐξολωλέναι,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:413.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:413.1.text#ἵνα τὰς τελετὰς λάβοιεν αὐτοὶ τῶν θεῶν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:414.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:414.1.text#ταῦτ' ἄρα πάλαι τῶν ἡμερῶν παρεκλεπτέτην
urn:cts:greekLit:tlg0019.tlg005.fu.sp:415.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:415.1.text#καὶ τοῦ κύκλου παρέτρωγον ὑφ' ἁμαρτωλίας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:416.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:416.1.text#ναὶ μὰ Δία. πρὸς ταῦτ' ὦ φίλ' Ἑρμῆ ξύλλαβε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:417.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:417.1.text#ἡμῖν προθύμως τήνδε καὶ ξυνέλκυσον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:418.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:418.1.text#καί σοι τὰ μεγάλ' ἡμεῖς Παναθήναι' ἄξομεν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:419.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:419.1.text#πάσας τε τὰς ἄλλας τελετὰς τὰς τῶν θεῶν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:420.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:420.1.text#μυστήρι' Ἑρμῇ, Διιπόλει', Ἀδώνια·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:421.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:421.1.text#ἄλλαι τέ σοι πόλεις πεπαυμέναι κακῶν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:422.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:422.1.text#ἀλεξικάκῳ θύσουσιν Ἑρμῇ πανταχοῦ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:423.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:423.1.text#χἄτερ' ἔτι πόλλ' ἕξεις ἀγαθά. πρῶτον δέ σοι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:424.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:424.1.text#δῶρον δίδωμι τήνδ', ἵνα σπένδειν ἔχῃς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:425.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:425.1.text#οἴμ' ὡς ἐλεήμων εἴμ' ἀεὶ τῶν χρυσίδων.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:426.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:426.1.text#ὑμέτερον ἐντεῦθεν ἔργον ὦνδρες. ἀλλὰ ταῖς ἄμαις
urn:cts:greekLit:tlg0019.tlg005.fu.sp:427.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:427.1.text#εἰσιόντες ὡς τάχιστα τοὺς λίθους ἀφέλκετε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:428.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:428.1.text#ταῦτα δράσομεν· σὺ δ' ἡμῖν ὦ θεῶν σοφώτατε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:429.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:429.1.text#ἅττα χρὴ ποιεῖν ἐφεστὼς φράζε δημιουργικῶς·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:430.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:430.1.text#τἄλλα δ' εὑρήσεις ὑπουργεῖν ὄντας ἡμᾶς οὐ κακούς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:431.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:431.1.text#ἄγε δὴ σὺ ταχέως ὕπεχε τὴν φιάλην, ὅπως
urn:cts:greekLit:tlg0019.tlg005.fu.sp:432.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:432.1.text#ἔργῳ 'φιαλοῦμεν εὐξάμενοι τοῖσιν θεοῖς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:433.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:433.1.text#σπονδὴ σπονδή·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:434.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:434.1.text#εὐφημεῖτε εὐφημεῖτε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:435.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:435.1.text#σπένδοντες εὐχόμεσθα τὴν νῦν ἡμέραν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:436.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:436.1.text#Ἕλλησιν ἄρξαι πᾶσι πολλῶν κἀγαθῶν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:437.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:437.1.text#χὤστις προθύμως ξυλλάβοι τῶν σχοινίων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:438.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:438.1.text#τοῦτον τὸν ἄνδρα μὴ λαβεῖν ποτ' ἀσπίδα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:439.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:439.1.text#μὰ Δί' ἀλλ' ἐν εἰρήνῃ διαγαγεῖν τὸν βίον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:440.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:440.1.text#ἔχονθ' ἑταίραν καὶ σκαλεύοντ' ἄνθρακας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:441.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:441.1.text#ὅστις δὲ πόλεμον μᾶλλον εἶναι βούλεται
urn:cts:greekLit:tlg0019.tlg005.fu.sp:442.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:442.1.text#μηδέποτε παύσασθ' αὐτὸν ὦ Διόνυσ' ἄναξ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:443.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:443.1.text#ἐκ τῶν ὀλεκράνων ἀκίδας ἐξαιρούμενον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:444.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:444.1.text#κεἴ τις ἐπιθυμῶν ταξιαρχεῖν σοὶ φθονεῖ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:445.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:445.1.text#ἐς φῶς ἀνελθεῖν ὦ πότνι', ἐν ταῖσιν μάχαις
urn:cts:greekLit:tlg0019.tlg005.fu.sp:446.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:446.1.text#πάσχοι γε τοιαῦθ' οἷάπερ Κλεώνυμος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:447.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:447.1.text#κεἴ τις δορυξὸς ἢ κάπηλος ἀσπίδων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:448.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:448.1.text#ἵν' ἐμπολᾷ βέλτιον, ἐπιθυμεῖ μαχῶν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:449.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:449.1.text#ληφθεὶς ὑπὸ λῃστῶν ἐσθίοι κριθὰς μόνας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:450.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:450.1.text#κεἴ τις στρατηγεῖν βουλόμενος μὴ ξυλλάβοι,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:451.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:451.1.text#ἢ δοῦλος αὐτομολεῖν παρεσκευασμένος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:452.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:452.1.text#ἐπὶ τοῦ τροχοῦ γ' ἕλκοιτο μαστιγούμενος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:453.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:453.1.text#ἡμῖν δ' ἀγαθὰ γένοιτ'. ἰὴ παιὼν ἰή.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:454.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:454.1.text#ἄφελε τὸ παίειν ἀλλ' ἰὴ μόνον λέγε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:455.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:455.1.text#ἰὴ ἰὴ τοίνυν, ἰὴ μόνον λέγω.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:456.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:456.1.text#Ἑρμῇ Χάρισιν Ὥραισιν Ἀφροδίτῃ Πόθῳ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:457.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:457.1.text#Ἄρει δέ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:457.2.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:457.2.text#μὴ μή.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:457.3.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:457.3.text#μηδ' Ἐνυαλίῳ γε;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:457.4.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:457.4.text#μή.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:458.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:458.1.text#ὑπότεινε δὴ πᾶς καὶ κάταγε τοῖσιν κάλῳς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:459.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:459.1.text#ὦ εἶα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:460.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:460.1.text#εἶα μάλα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:461.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:461.1.text#ὦ εἶα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:462.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:462.1.text#εἶα ἔτι μάλα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:463.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:463.1.text#ὦ εἶα, ὦ εἶα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:464.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:464.1.text#ἀλλ' οὐχ ἕλκουσ' ἅνδρες ὁμοίως.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:465.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:465.1.text#οὐ ξυλλήψεσθ'; οἷ' ὀγκύλλεσθ'·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:466.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:466.1.text#οἰμώξεσθ' οἱ Βοιωτοί.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:467.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:467.1.text#εἶά νυν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:468.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:468.1.text#εἶα ὦ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:469.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:469.1.text# ἀλλ' ἄγετε ξυνανέλκετε καὶ σφώ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:470.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:470.1.text#οὔκουν ἕλκω κἀξαρτῶμαι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:471.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:471.1.text#κἀπεμπίπτω καὶ σπουδάζω;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:472.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:472.1.text#πῶς οὖν οὐ χωρεῖ τοὔργον;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:473.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:473.1.text#ὦ Λάμαχ' ἀδικεῖς ἐμποδὼν καθήμενος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:474.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:474.1.text#οὐδὲν δεόμεθ' ὦνθρωπε τῆς σῆς μορμόνος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:475.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:475.1.text#οὐδ' οἵδε γ' εἷλκον οὐδὲν ἁργεῖοι πάλαι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:476.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:476.1.text#ἀλλ' ἢ κατεγέλων τῶν ταλαιπωρουμένων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:477.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:477.1.text#καὶ ταῦτα διχόθεν μισθοφοροῦντες ἄλφιτα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:478.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:478.1.text#ἀλλ' οἱ Λάκωνες ὦγάθ' ἕλκουσ' ἀνδρικῶς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:479.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:479.1.text#ἆρ' οἶσθ' ὅσοι γ' αὐτῶν ἔχονται τοῦ ξύλου,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:480.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:480.1.text#μόνοι προθυμοῦντ'· ἀλλ' ὁ χαλκεὺς οὐκ ἐᾷ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:481.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:481.1.text#οὐδ' οἱ Μεγαρῆς δρῶσ' οὐδέν· ἕλκουσιν δ' ὅμως
urn:cts:greekLit:tlg0019.tlg005.fu.sp:482.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:482.1.text#γλισχρότατα σαρκάζοντες ὥσπερ κυνίδια,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:483.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:483.1.text#ὑπὸ τοῦ γε λιμοῦ νὴ Δί' ἐξολωλότες.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:484.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:484.1.text#οὐδὲν ποιοῦμεν ὦνδρες· ἀλλ ὁμοθυμαδὸν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:485.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:485.1.text#ἅπασιν ἡμῖν αὖθις ἀντιληπτέον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:486.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:486.1.text#ὦ εἶα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:487.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:487.1.text#εἶα μάλα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:488.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:488.1.text#ὦ εἶα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:489.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:489.1.text#εἶα νὴ Δία.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:490.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:490.1.text#μικρόν γε κινοῦμεν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:491.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:491.1.text#οὔκουν δεινὸν […]
urn:cts:greekLit:tlg0019.tlg005.fu.sp:492.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:492.1.text#τοὺς μὲν τείνειν τοὺς δ' ἀντισπᾶν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:493.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:493.1.text#πληγὰς λήψεσθ' ὦργεῖοι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:494.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:494.1.text#εἶά νυν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:495.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:495.1.text#εἶα ὦ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:496.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:496.1.text#ὡς κακόνοι τινές εἰσιν ἐν ἡμῖν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:497.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:497.1.text#ὑμεῖς μὲν γοῦν οἱ κιττῶντες
urn:cts:greekLit:tlg0019.tlg005.fu.sp:498.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:498.1.text#τῆς εἰρήνης σπᾶτ' ἀνδρείως.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:499.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:499.1.text#ἀλλ' εἴσ' οἳ κωλύουσιν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:500.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:500.1.text#ἄνδρες Μεγαρῆς οὐκ ἐς κόρακας ἐρρήσετε;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:501.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:501.1.text#μισεῖ γὰρ ὑμᾶς ἡ θεὸς μεμνημένη·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:502.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:502.1.text#πρῶτοι γὰρ αὐτὴν τοῖς σκορόδοις ἠλείψατε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:503.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:503.1.text#καὶ τοῖς Ἀθηναίοισι παύσασθαι λέγω
urn:cts:greekLit:tlg0019.tlg005.fu.sp:504.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:504.1.text#ἐντεῦθεν ἐχομένοις ὅθεν νῦν ἕλκετε·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:505.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:505.1.text#οὐδὲν γὰρ ἄλλο δρᾶτε πλὴν δικάζετε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:506.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:506.1.text#ἀλλ' εἴπερ ἐπιθυμεῖτε τήνδ' ἐξελκύσαι,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:507.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:507.1.text#πρὸς τὴν θάλατταν ὀλίγον ὑποχωρήσατε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:508.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:508.1.text#ἄγ' ὦνδρες αὐτοὶ δὴ μόνοι λαβώμεθ' οἱ γεωργοί.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:509.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:509.1.text#χωρεῖ γέ τοι τὸ πρᾶγμα πολλῷ μᾶλλον ὦνδρες ὑμῖν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:510.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:510.1.text#χωρεῖν τὸ πρᾶγμά φησιν· ἀλλὰ πᾶς ἀνὴρ προθυμοῦ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:511.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:511.1.text#οἵ τοι γεωργοὶ τοὔργον ἐξέλκουσι κἄλλος οὐδείς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:512.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:512.1.text#ἄγε νυν ἄγε πᾶς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:513.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:513.1.text#καὶ μὴν ὁμοῦ 'στιν ἤδη.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:514.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:514.1.text#μή νυν ἀνῶμεν ἀλλ' ἐπεντείνωμεν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:515.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:515.1.text#ἀνδρικώτερον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:516.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:516.1.text#ἤδη 'στὶ τοῦτ' ἐκεῖνο.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:517.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:517.1.text#ὦ εἶα νῦν, ὦ εἶα πᾶς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:518.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:518.1.text#ὦ εἶα εἶα εἶα εἶα εἶα εἶα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:519.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:519.1.text#ὦ εἶα εἶα εἶα εἶα εἶα πᾶς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:520.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:520.1.text#ὦ πότνια βοτρυόδωρε τί προσείπω σ' ἔπος;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:521.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:521.1.text#πόθεν ἂν λάβοιμι ῥῆμα μυριάμφορον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:522.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:522.1.text#ὅτῳ προσείπω σ'; οὐ γὰρ εἶχον οἴκοθεν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:523.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:523.1.text#ὦ χαῖρ' Ὀπώρα, καὶ σὺ δ' ὦ Θεωρία.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:524.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:524.1.text#οἷον δ' ἔχεις τὸ πρόσωπον ὦ Θεωρία,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:525.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:525.1.text#οἷον δὲ πνεῖς, ὡς ἡδὺ κατὰ τῆς καρδίας,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:526.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:526.1.text#γλυκύτατον ὥσπερ ἀστρατείας καὶ μύρου.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:527.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:527.1.text#μῶν οὖν ὅμοιον καὶ γυλιοῦ στρατιωτικοῦ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:528.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:528.1.text#ἀπέπτυσ' ἐχθροῦ φωτὸς ἔχθιστον πλέκος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:529.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:529.1.text#τοῦ μὲν γὰρ ὄζει κρομμυοξυρεγμίας,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:530.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:530.1.text#ταύτης δ' ὀπώρας, ὑποδοχῆς, Διονυσίων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:531.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:531.1.text#αὐλῶν, τραγῳδῶν, Σοφοκλέους μελῶν, κιχλῶν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:532.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:532.1.text#ἐπυλλίων Εὐριπίδου—
urn:cts:greekLit:tlg0019.tlg005.fu.sp:532.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:532.2.text#κλαύσἄρα σὺ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:533.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:533.1.text#ταύτης καταψευδόμενος· οὐ γὰρ ἥδεται
urn:cts:greekLit:tlg0019.tlg005.fu.sp:534.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:534.1.text#αὕτη ποιητῇ ῥηματίων δικανικῶν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:535.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:535.1.text#κιττοῦ, τρυγοίπου, προβατίων βληχωμένων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:536.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:536.1.text#† κόλπου † γυναικῶν διατρεχουσῶν εἰς ἀγρόν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:537.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:537.1.text#δούλης μεθυούσης, ἀνατετραμμένου χοῶς,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:538.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:538.1.text#ἄλλων τε πολλῶν κἀγαθῶν—
urn:cts:greekLit:tlg0019.tlg005.fu.sp:539.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:539.1.text#ἴθι νυν ἄθρει
urn:cts:greekLit:tlg0019.tlg005.fu.sp:539.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:539.2.text#οἷον πρὸς ἀλλήλας λαλοῦσιν αἱ πόλεις
urn:cts:greekLit:tlg0019.tlg005.fu.sp:540.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:540.1.text#διαλλαγεῖσαι καὶ γελῶσιν ἄσμεναι,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:541.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:541.1.text#καὶ ταῦτα δαιμονίως ὑπωπιασμέναι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:542.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:542.1.text#ἁπαξάπασαι καὶ κυάθους προσκείμεναι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:543.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:543.1.text#καὶ τῶνδε τοίνυν τῶν θεωμένων σκόπει
urn:cts:greekLit:tlg0019.tlg005.fu.sp:544.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:544.1.text#τὰ πρόσωφ', ἵνα γνῷς τὰς τέχνας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:544.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:544.2.text#αἰβοῖ τάλας,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:545.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:545.1.text#ἐκεινονὶ γοῦν τὸν λοφοποιὸν οὐχ ὁρᾷς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:546.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:546.1.text#τίλλονθ' ἑαυτόν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:546.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:546.2.text#ὁ δέ γε τὰς σμινύας ποιῶν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:547.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:547.1.text#κατέπαρδεν ἄρτι τοῦ ξιφουργοῦ 'κεινουί.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:548.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:548.1.text#ὁ δὲ δρεπανουργὸς οὐχ ὁρᾷς ὡς ἥδεται,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:549.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:549.1.text#καὶ τὸν δορυξὸν οἷον ἐσκιμάλισεν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:550.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:550.1.text#ἴθι νυν ἄνειπε τοὺς γεωργοὺς ἀπιέναι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:551.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:551.1.text#ἀκούετε λεῴ· τοὺς γεωργοὺς ἀπιέναι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:552.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:552.1.text#τὰ γεωργικὰ σκεύη λαβόντας εἰς ἀγρὸν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:553.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:553.1.text#ὡς τάχιστ' ἄνευ δορατίου καὶ ξίφους κἀκοντίου·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:554.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:554.1.text#ὡς ἅπαντ' ἤδη 'στὶ μεστὰ τἀνθάδ' εἰρήνης σαπρᾶς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:555.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:555.1.text#ἀλλὰ πᾶς χώρει πρὸς ἔργον εἰς ἀγρὸν παιωνίσας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:556.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:556.1.text#ὦ ποθεινὴ τοῖς δικαίοις καὶ γεωργοῖς ἡμέρα,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:557.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:557.1.text#ἄσμενός σ' ἰδὼν προσειπεῖν βούλομαι τὰς ἀμπέλους,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:558.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:558.1.text#τάς τε συκᾶς, ἃς ἐγὼ 'φύτευον ὢν νεώτερος,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:559.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:559.1.text#ἀσπάσασθαι θυμὸς ἡμῖν ἐστι πολλοστῷ χρόνῳ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:560.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:560.1.text#νῦν μὲν οὖν ὦνδρες προσευξώμεσθα πρῶτον τῇ θεῷ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:561.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:561.1.text#ἥπερ ἡμῶν τοὺς λόφους ἀφεῖλε καὶ τὰς Γοργόνας·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:562.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:562.1.text#εἶθ' ὅπως Λιταργιοῦμεν οἴκαδ' ἐς τὰ χωρία,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:563.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:563.1.text#ἐμπολήσαντές τι χρηστὸν εἰς ἀγρὸν ταρίχιον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:564.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:564.1.text#ὦ Πόσειδον ὡς καλὸν τὸ στῖφος αὐτῶν φαίνεται
urn:cts:greekLit:tlg0019.tlg005.fu.sp:565.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:565.1.text#καὶ πυκνὸν καὶ γοργὸν ὥσπερ μᾶζα καὶ πανδαισία.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:566.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:566.1.text#νὴ Δί' ἡ γὰρ σφῦρα λαμπρὸν ἦν ἄρ' ἐξωπλισμένη,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:567.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:567.1.text#αἵ τε θρίνακες διαστίλβουσι πρὸς τὸν ἥλιον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:568.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:568.1.text#ἦ καλῶς αὐτῶν ἀπαλλάξειεν ἂν μετόρχιον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:569.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:569.1.text#ὥστ' ἔγωγ' ἤδη 'πιθυμῶ καὐτὸς ἐλθεῖν εἰς ἀγρὸν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:570.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:570.1.text#καὶ τριαινοῦν τῇ δικέλλῃ διὰ χρόνου τὸ γῄδιον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:571.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:571.1.text#ἀλλ' ἀναμνησθέντες ὦνδρες
urn:cts:greekLit:tlg0019.tlg005.fu.sp:572.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:572.1.text#τῆς διαίτης τῆς παλαιᾶς,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:573.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:573.1.text#ἣν παρεῖχ' αὕτη ποθ' ἡμῖν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:574.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:574.1.text#τῶν τε παλασίων ἐκείνων
urn:cts:greekLit:tlg0019.tlg005.fu.sp:575.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:575.1.text#τῶν τε σύκων τῶν τε μύρτων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:576.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:576.1.text#τῆς τρυγός τε τῆς γλυκείας
urn:cts:greekLit:tlg0019.tlg005.fu.sp:577.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:577.1.text#τῆς ἰωνιᾶς τε τῆς πρὸς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:578.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:578.1.text#τῷ φρέατι τῶν τ' ἐλαῶν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:579.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:579.1.text#ὧν ποθοῦμεν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:580.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:580.1.text#ἀντὶ τούτων τήνδε νυνὶ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:581.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:581.1.text#τὴν θεὸν προσείπατε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:582.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:582.1.text#χαῖρε χαῖρ', ὡς ἀσμένοισιν ἦλθες, ὦ φιλτάτη.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:585.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:585.1.text#σῷ γὰρ ἐδάμην πόθῳ, δαιμόνια βουλόμενος εἰς ἀγρὸν ἀνερπύσαι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:586.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:586.1.text# […]
urn:cts:greekLit:tlg0019.tlg005.fu.sp:587.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:587.1.text#ἦσθα γὰρ μέγιστον ἡμῖν κέρδος ὦ ποθουμένη
urn:cts:greekLit:tlg0019.tlg005.fu.sp:588.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:588.1.text#πᾶσιν ὁπόσοι γεωργὸν βίον ἐτρίβομεν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:590.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:590.1.text#μόνη γὰρ ἡμᾶς ὠφέλεις.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:591.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:591.1.text#πολλὰ γὰρ ἐπάσχομεν πρίν ποτ' ἐπὶ σοῦ γλυκέα κἀδάπανα καὶ φίλα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:595.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:595.1.text#τοῖς ἀγροίκοισιν γὰρ ἦσθα χῖδρα καὶ σωτηρία.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:596.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:596.1.text#ὥστε σὲ τά τ' ἀμπέλια καὶ τὰ νέα συκίδια
urn:cts:greekLit:tlg0019.tlg005.fu.sp:597.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:597.1.text#τἄλλα θ' ὁπόσ' ἔστι φυτὰ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:600.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:600.1.text#προσγελάσεται λαβόντ' ἄσμενα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:601.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:601.1.text#ἀλλὰ ποῦ ποτ' ἦν ἀφ' ἡμῶν τὸν πολὺν τοῦτον χρόνον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:602.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:602.1.text#ἥδε; τοῦθ' ἡμᾶς δίδαξον ὦ θεῶν εὐνούστατε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:603.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:603.1.text#ὦ σοφώτατοι γεωργοί, τἀμὰ δὴ ξυνίετε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:604.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:604.1.text#ῥήματ', εἰ βούλεσθ' ἀκοῦσαι τήνδ' ὅπως ἀπώλετο.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:605.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:605.1.text#πρῶτα μὲν γὰρ †αὐτῆς ἦρξεν† Φειδίας πράξας κακῶς·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:606.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:606.1.text#εἶτα Περικλέης φοβηθεὶς μὴ μετάσχοι τῆς τύχης,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:607.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:607.1.text#τὰς φύσεις ὑμῶν δεδοικὼς καὶ τὸν αὐτοδὰξ τρόπον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:608.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:608.1.text#πρὶν παθεῖν τι δεινὸν αὐτός, ἐξέφλεξε τὴν πόλιν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:609.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:609.1.text#ἐμβαλὼν σπινθῆρα μικρὸν Μεγαρικοῦ ψηφίσματος,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:610.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:610.1.text#ἐξεφύσησεν τοσοῦτον πόλεμον ὥστε τῷ καπνῷ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:611.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:611.1.text#πάντας Ἕλληνας δακρῦσαι, τούς τ' ἐκεῖ τούς τ' ἐνθάδε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:612.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:612.1.text#ὡς δ' ἅπαξ †τὸ πρῶτον ἄκουσ'† ἐψόφησεν ἄμπελος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:613.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:613.1.text#καὶ πίθος πληγεὶς ὑπ' ὀργῆς ἀντελάκτισεν πίθῳ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:614.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:614.1.text#οὐκέτ' ἦν οὐδεὶς ὁ παύσων, ἥδε δ' ἠφανίζετο.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:615.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:615.1.text#ταῦτα τοίνυν μὰ τὸν Ἀπόλλω 'γὼ 'πεπύσμην οὐδενός,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:616.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:616.1.text#οὐδ' ὅπως αὐτῇ προσήκοι Φειδίας ἠκηκόη.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:617.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:617.1.text#οὐδ' ἔγωγε πλήν γε νυνί. ταῦτ' ἄρ' εὐπρόσωπος ἦν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:618.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:618.1.text#οὖσα συγγενὴς ἐκείνου. πολλά γ' ἡμᾶς λανθάνει.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:619.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:619.1.text#κᾆτ' ἐπειδὴ 'γνωσαν ὑμᾶς αἱ πόλεις ὧν ἤρχετε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:620.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:620.1.text#ἠγριωμένους ἐπ' ἀλλήλοισι καὶ σεσηρότας,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:621.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:621.1.text#πάντ' ἐμηχανῶντ' ἐφ' ὑμῖν τοὺς φόρους φοβούμεναι,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:622.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:622.1.text#κἀνέπειθον τῶν Λακώνων τοὺς μεγίστους χρήμασιν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:623.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:623.1.text#οἱ δ' ἅτ' ὄντες αἰσχροκερδεῖς καὶ διειρωνόξενοι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:624.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:624.1.text#τήνδ' ἀπορρίψαντες αἰσχρῶς τὸν πόλεμον ἀνήρπασαν·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:625.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:625.1.text#κᾆτα τἀκείνων γε κέρδη τοῖς γεωργοῖς ἦν κακά·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:626.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:626.1.text#αἱ γὰρ ἐνθένδ' αὖ τριήρεις ἀντιτιμωρούμεναι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:627.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:627.1.text#οὐδὲν αἰτίων ἂν ἀνδρῶν τὰς κράδας κατήσθιον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:628.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:628.1.text#ἐν δίκῃ μὲν οὖν, ἐπεί τοι τὴν κορώνεών γέ μου
urn:cts:greekLit:tlg0019.tlg005.fu.sp:629.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:629.1.text#ἐξέκοψαν, ἣν ἐγὼ 'φύτευσα κἀξεθρεψάμην.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:630.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:630.1.text#νὴ Δί' ὦ μέλ' ἐνδίκως γε δῆτ', ἐπεὶ κἀμοῦ λίθον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:631.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:631.1.text#ἐμβαλόντες ἑξμέδιμνον κυψέλην ἀπώλεσαν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:632.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:632.1.text#κᾆτα δ' ὡς ἐκ τῶν ἀγρῶν ξυνῆλθεν οὑργάτης λεώς,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:633.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:633.1.text#τὸν τρόπον πωλούμενος τὸν αὐτὸν οὐκ ἐμάνθανεν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:634.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:634.1.text#ἀλλ' ἅτ' ὢν ἄνευ γιγάρτων καὶ φιλῶν τὰς ἰσχάδας
urn:cts:greekLit:tlg0019.tlg005.fu.sp:635.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:635.1.text#ἔβλεπεν πρὸς τοὺς λέγοντας· οἱ δὲ γιγνώσκοντες εὖ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:636.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:636.1.text#τοὺς πένητας ἀσθενοῦντας κἀποροῦντας ἀλφίτων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:637.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:637.1.text#τήνδε μὲν δικροῖς ἐώθουν τὴν θεὸν κεκράγμασιν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:638.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:638.1.text#πολλάκις φανεῖσαν αὐτὴν τῆσδε τῆς χώρας πόθῳ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:639.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:639.1.text#τῶν δὲ συμμάχων ἔσειον τοὺς παχεῖς καὶ πλουσίους,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:640.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:640.1.text#αἰτίας ἂν προστιθέντες, ὡς φρονεῖ τὰ Βρασίδου.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:641.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:641.1.text#εἶτ' ἂν ὑμεῖς τοῦτον ὥσπερ κυνίδι' ἐσπαράττετε·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:642.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:642.1.text#ἡ πόλις γὰρ ὠχριῶσα κἀν φόβῳ καθημένη,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:643.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:643.1.text#ἅττα διαβάλοι τις αὐτῇ, ταῦτ' ἂν ἥδιστ' ἤσθιεν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:644.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:644.1.text#οἳ δὲ τὰς πληγὰς ὁρῶντες ἃς ἐτύπτονθ' οἱ ξένοι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:645.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:645.1.text#χρυσίῳ τῶν ταῦτα ποιούντων ἐβύνουν τὸ στόμα,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:646.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:646.1.text#ὥστ' ἐκείνους μὲν ποιῆσαι πλουσίους, ἡ δ' Ἑλλὰς ἂν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:647.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:647.1.text#ἐξερημωθεῖσ' ἂν ὑμᾶς ἔλαθε. ταῦτα δ' ἦν ὁ δρῶν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:648.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:648.1.text#βυρσοπώλης.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:648.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:648.2.text#παῦε παῦ' ὦ δέσποθ' Ἑρμῆ, μὴ λέγε,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:649.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:649.1.text#ἀλλ' ἔα τὸν ἄνδρ' ἐκεῖνον οὗπερ ἔστ' εἶναι κάτω·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:650.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:650.1.text#οὐ γὰρ ἡμέτερος ἔτ' ἔστ' ἐκεῖνος ἁνὴρ ἀλλὰ σός.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:651.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:651.1.text#ἅττ' ἂν οὖν λέγῃς ἐκεῖνον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:652.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:652.1.text#κεἰ πανοῦργος ἦν, ὅτ' ἔζη,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:653.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:653.1.text#καὶ λάλος καὶ συκοφάντης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:654.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:654.1.text#καὶ κύκηθρον καὶ τάρακτρον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:655.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:655.1.text#ταῦθ' ἁπαξάπαντα νυνὶ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:656.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:656.1.text#τοὺς σεαυτοῦ λοιδορεῖς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:657.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:657.1.text#ἀλλ' ὅ τι σιωπᾷς ὦ πότνια κάτειπέ μοι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:658.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:658.1.text#ἀλλ' οὐκ ἂν εἴποι πρός γε τοὺς θεωμένους·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:659.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:659.1.text#ὀργὴν γὰρ αὐτοῖς ὧν ἔπαθε πολλὴν ἔχει.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:660.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:660.1.text#ἡ δ' ἀλλὰ πρὸς σὲ μικρὸν εἰπάτω μόνον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:661.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:661.1.text#εἴφ' ὅ τι νοεῖς αὐτοῖσι πρὸς ἔμ' ὦ φιλτάτη.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:662.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:662.1.text#ἴθ' ὦ γυναικῶν μισοπορπακιστάτη.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:663.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:663.1.text#εἶεν, ἀκούω. ταῦτ' ἐπικαλεῖς; μανθάνω.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:664.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:664.1.text#ἀκούσαθ' ὑμεῖς ὧν ἕνεκα μομφὴν ἔχει.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:665.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:665.1.text#ἐλθοῦσά φησιν αὐτομάτη μετὰ τἀν Πύλῳ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:666.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:666.1.text#σπονδῶν φέρουσα τῇ πόλει κίστην πλέαν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:667.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:667.1.text#ἀποχειροτονηθῆναι τρὶς ἐν τἠκκλησίᾳ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:668.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:668.1.text#ἡμάρτομεν ταῦτ'· ἀλλὰ συγγνώμην ἔχε·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:669.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:669.1.text#ὁ νοῦς γὰρ ἡμῶν ἦν τότ' ἐν τοῖς σκύτεσιν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:670.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:670.1.text#ἴθι νυν ἄκουσον οἷον ἄρτι μ' ἤρετο,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:671.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:671.1.text#ὅστις κακόνους αὐτῇ μάλιστ' ἦν ἐνθάδε,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:672.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:672.1.text#χὤστις φίλος κἄσπευδεν εἶναι μὴ μάχας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:673.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:673.1.text#εὐνούστατος μὲν ἦν μακρῷ Κλεώνυμος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:674.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:674.1.text#ποῖός τις οὖν εἶναι δοκεῖ τὰ πολεμικὰ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:675.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:675.1.text#ὁ Κλεώνυμος;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:675.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:675.2.text#ψυχήν γ' ἄριστος πλήν γ' ὅτι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:676.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:676.1.text#οὐκ ἦν ἄρ' οὗπέρ φησιν εἶναι τοῦ πατρός.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:677.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:677.1.text#εἰ γάρ ποτ' ἐξέλθοι στρατιώτης, εὐθέως
urn:cts:greekLit:tlg0019.tlg005.fu.sp:678.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:678.1.text#ἀποβολιμαῖος τῶν ὅπλων ἐγίγνετο.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:679.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:679.1.text#ἔτι νῦν ἄκουσον οἷον ἄρτι μ' ἤρετο,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:680.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:680.1.text#ὅστις κρατεῖ νῦν τοῦ λίθου τοῦ 'ν τῇ πυκνί.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:681.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:681.1.text#Ὑπέρβολος νῦν τοῦτ' ἔχει τὸ χωρίον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:682.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:682.1.text#αὕτη τί ποιεῖς; τὴν κεφαλὴν ποῖ περιάγεις;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:683.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:683.1.text#ἀποστρέφεται τὸν δῆμον ἀχθεσθεῖσ' ὅτι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:684.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:684.1.text#αὑτῷ πονηρὸν προστάτην ἐπεγράψατο.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:685.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:685.1.text#ἀλλ' οὐκέτ' αὐτῷ χρησόμεθ' οὐδέν, ἀλλὰ νῦν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:686.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:686.1.text#ἀπορῶν ὁ δῆμος ἐπιτρόπου καὶ γυμνὸς ὢν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:687.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:687.1.text#τοῦτον τέως τὸν ἄνδρα περιεζώσατο.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:688.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:688.1.text#πῶς οὖν ξυνοίσει ταῦτ' ἐρωτᾷ τῇ πόλει.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:689.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:689.1.text#εὐβουλότεροι γενησόμεθα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:689.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:689.2.text#τρόπῳ τίνι;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:690.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:690.1.text#ὅτι τυγχάνει λυχνοποιὸς ὤν. πρὸ τοῦ μὲν οὖν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:691.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:691.1.text#ἐψηλαφῶμεν ἐν σκότῳ τὰ πράγματα,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:692.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:692.1.text#νυνὶ δ' ἅπαντα πρὸς λύχνον βουλεύσομεν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:692.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:692.2.text#ὢ ὤ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:693.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:693.1.text#οἷά μ' ἐκέλευσεν ἀναπυθέσθαι σου.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:693.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:693.2.text#τὰ τί;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:694.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:694.1.text#πάμπολλα καὶ τἀρχαῖ' ἃ κατέλιπεν τότε·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:695.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:695.1.text#πρῶτον δ' ὅ τι πράττει Σοφοκλέης ἀνήρετο.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:696.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:696.1.text#εὐδαιμονεῖ, πάσχει δὲ θαυμαστόν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:696.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:696.2.text#τὸ τί;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:697.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:697.1.text#ἐκ τοῦ Σοφοκλέους γίγνεται Σιμωνίδης.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:698.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:698.1.text#Σιμωνίδης; πῶς;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:698.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:698.2.text#ὅτι γέρων ὢν καὶ σαπρὸς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:699.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:699.1.text#κέρδους ἕκατι κἂν ἐπὶ ῥιπὸς πλέοι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:700.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:700.1.text#τί δαί; Κρατῖνος ὁ σοφὸς ἔστιν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:700.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:700.2.text#ἀπέθανεν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:701.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:701.1.text#ὅθ' οἱ Λάκωνες ἐνέβαλον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:701.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:701.2.text#τί παθών;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:701.3.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:701.3.text#ὅ τι;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:702.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:702.1.text#ὼρακιάσας· οὐ γὰρ ἐξηνέσχετο
urn:cts:greekLit:tlg0019.tlg005.fu.sp:703.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:703.1.text#ἰδὼν πίθον καταγνύμενον οἴνου πλέων.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:704.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:704.1.text#χἄτερα πόσ' ἄττ' οἴει γεγενῆσθ' ἐν τῇ πόλει;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:705.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:705.1.text#ὥστ' οὐδέποτ' ὦ δέσποιν' ἀφησόμεσθά σου.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:706.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:706.1.text#ἴθι νυν ἐπὶ τούτοις τὴν Ὀπώραν λάμβανε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:707.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:707.1.text#γυναῖκα σαυτῷ τήνδε· κᾆτ' ἐν τοῖς ἀγροῖς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:708.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:708.1.text#ταύτῃ ξυνοικῶν ἐκποιοῦ σαυτῷ βότρυς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:709.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:709.1.text#ὦ φιλτάτη δεῦρ' ἐλθὲ καὶ δός μοι κύσαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:710.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:710.1.text#ἆρ' ἂν βλαβῆναι διὰ χρόνου τί σοι δοκῶ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:711.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:711.1.text#ὦ δέσποθ' Ἑρμῆ τῆς Ὀπώρας κατελάσας;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:712.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:712.1.text#οὐκ εἴ γε κυκεῶν' ἐπιπίοις βληχωνίαν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:713.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:713.1.text#ἀλλ' ὡς τάχιστα τήνδε τὴν Θεωρίαν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:714.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:714.1.text#ἀπάγαγε τῇ βουλῇ λαβών, ἧσπέρ ποτ' ἦν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:715.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:715.1.text#ὦ μακαρία βουλὴ σὺ τῆς Θεωρίας,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:716.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:716.1.text#ὅσον ῥοφήσει ζωμὸν ἡμερῶν τριῶν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:717.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:717.1.text#ὅσας δὲ κατέδει ξόλικας ἑφθὰς καὶ κρέα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:718.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:718.1.text#ἀλλ' ὦ φίλ' Ἑρμῆ χαῖρε πολλά.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:718.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:718.2.text#καὶ σύ γε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:719.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:719.1.text#ὦνθρωπε χαίρων ἄπιθι καὶ μέμνησό μου.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:720.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:720.1.text#ὦ κάνθαρ' οἴκαδ' οἴκαδ' ἀποπετώμεθα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:721.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:721.1.text#οὐκ ἐνθάδ' ὦ τᾶν ἔστι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:721.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:721.2.text#ποῖ γὰρ οἴχεται;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:722.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:722.1.text#ὑφ' ἅρματ' ἐλθὼν Ζηνὸς ἀστραπηφορεῖ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:723.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:723.1.text#πόθεν οὖν ὁ τλήμων ἐνθάδ' ἕξει σιτία;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:724.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:724.1.text#τὴν τοῦ Γανυμήδους ἀμβροσίαν σιτήσεται.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:725.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:725.1.text#πῶς δῆτ' ἐγὼ καταβήσομαι;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:725.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:725.2.text#θάρρει, καλῶς·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:726.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:726.1.text#τῃδὶ παρ' αὐτὴν τὴν θεόν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:726.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:726.2.text#δεῦρ' ὦ κόραι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:727.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:727.1.text#ἕπεσθον ἅμ' ἐμοὶ θᾶττον, ὡς πολλοὶ πάνυ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:728.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:728.1.text#ποθοῦντες ὑμᾶς ἀναμένουσ' ἐστυκότες.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:729.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:729.1.text#ἀλλ' ἴθι χαίρων· ἡμεῖς δὲ τέως τάδε τὰ σκεύη παραδόντες
urn:cts:greekLit:tlg0019.tlg005.fu.sp:730.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:730.1.text#τοῖς ἀκολούθοις δῶμεν σῴζειν, ὡς εἰώθασι μάλιστα
urn:cts:greekLit:tlg0019.tlg005.fu.sp:731.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:731.1.text#περὶ τὰς σκηνὰς πλεῖστοι κλέπται κυπτάζειν καὶ κακοποιεῖν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:732.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:732.1.text#ἀλλὰ φυλάττετε ταῦτ' ἀνδρείως· ἡμεῖς δ' αὖ τοῖσι θεαταῖς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:733.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:733.1.text#ἣν ἔχομεν ὁδὸν λόγων εἴπωμεν ὅσα τε νοῦς ἔχει.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:734.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:734.1.text#χρῆν μὲν τύπτειν τοὺς ῥαβδούχους, εἴ τις κωμῳδοποιητὴς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:735.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:735.1.text#αὑτὸν ἐπῄνει πρὸς τὸ θέατρον παραβὰς ἐν τοῖς ἀναπαίστοις·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:736.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:736.1.text#εἰ δ' οὖν εἰκός τινα τιμῆσαι, θύγατερ Διός, ὅστις ἄριστος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:737.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:737.1.text#κωμῳδοδιδάσκαλος ἀνθρώπων καὶ κλεινότατος γεγένηται,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:738.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:738.1.text#ἄξιος εἶναί φησ' εὐλογίας μεγάλης ὁ διδάσκαλος ἡμῶν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:739.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:739.1.text#πρῶτον μὲν γὰρ τοὺς ἀντιπάλους μόνος ἀνθρώπων κατέπαυσεν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:740.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:740.1.text#ἐς τὰ ῥάκια σκώπτοντας ἀεὶ καὶ τοῖς φθειρσὶν πολεμοῦντας,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:741.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:741.1.text#τούς θ' Ἡρακλέας τοὺς μάττοντας καὶ τοὺς πεινῶντας ἐκείνους
urn:cts:greekLit:tlg0019.tlg005.fu.sp:742.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:742.1.text#ἐξήλασ' ἀτιμώσας πρῶτος, καὶ τοὺς δούλους παρέλυσεν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:743.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:743.1.text#τοὺς φεύγοντας κἀξαπατῶντας καὶ τυπτομένους ἐπίτηδες,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:744.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:744.1.text#οὓς ἐξῆγον κλάοντας ἀεί, καὶ τούτους οὕνεκα τουδί,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:745.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:745.1.text#ἵν' ὁ σύνδουλος σκώψας αὐτοῦ τὰς πληγὰς εἶτ' ἀνέροιτο,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:746.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:746.1.text#"ὦ κακόδαιμον τί τὸ δέρμ' ἔπαθες; μῶν ὑστριχὶς εἰσέβαλέν σοι"
urn:cts:greekLit:tlg0019.tlg005.fu.sp:747.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:747.1.text#"ἐς τὰς πλευρὰς πολλῇ στρατιᾷ κἀδενδροτόμησε τὸ νῶτον;"
urn:cts:greekLit:tlg0019.tlg005.fu.sp:748.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:748.1.text#τοιαῦτ' ἀφελὼν κακὰ καὶ φόρτον καὶ βωμολοχεύματ' ἀγεννῆ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:749.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:749.1.text#ἐποίησε τέχνην μεγάλην ἡμῖν κἀπύργωσ' οἰκοδομήσας
urn:cts:greekLit:tlg0019.tlg005.fu.sp:750.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:750.1.text#ἔπεσιν μεγάλοις καὶ διανοίαις καὶ σκώμμασιν οὐκ ἀγοραίοις,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:751.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:751.1.text#οὐκ ἰδιώτας ἀνθρωπίσκους κωμῳδῶν οὐδὲ γυναῖκας,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:752.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:752.1.text#ἀλλ' Ἡρακλέους ὀργήν τιν' ἔχων τοῖσι μεγίστοις ἐπεχείρει,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:753.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:753.1.text#διαβὰς βυρσῶν ὀσμὰς δεινὰς κἀπειλὰς βορβοροθύμους,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:754.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:754.1.text#καὶ πρῶτον μὲν μάχομαι πάντων αὐτῷ τῷ καρχαρόδοντι,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:755.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:755.1.text#οὗ δεινόταται μὲν ἀπ' ὀφθαλμῶν Κύννης ἀκτῖνες ἔλαμπον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:756.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:756.1.text#ἑκατὸν δὲ κύκλῳ κεφαλαὶ κολάκων οἰμωξομένων ἐλιχμῶντο
urn:cts:greekLit:tlg0019.tlg005.fu.sp:757.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:757.1.text#περὶ τὴν κεφαλήν, φωνὴν δ' εἶχεν χαράδρας ὄλεθρον τετοκυίας,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:758.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:758.1.text#φώκης δ' ὀσμήν, Λαμίας ὄρχεις ἀπλύτους, πρωκτὸν δὲ καμήλου.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:759.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:759.1.text#τοιοῦτον ἰδὼν τέρας οὐ κατέδεισ', ἀλλ' ὑπὲρ ὑμῶν πολεμίζων
urn:cts:greekLit:tlg0019.tlg005.fu.sp:760.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:760.1.text#ἀντεῖχον ἀεὶ καὶ τῶν ἄλλων νήσων. ὧν οὕνεκα νυνὶ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:761.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:761.1.text#ἀποδοῦναί μοι τὴν χάριν ὑμᾶς εἰκὸς καὶ μνήμονας εἶναι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:762.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:762.1.text#καὶ γὰρ πρότερον πράξας κατὰ νοῦν οὐχὶ παλαίστρας περινοστῶν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:763.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:763.1.text#παῖδας ἐπείρων, ἀλλ' ἀράμενος τὴν σκευὴν εὐθὺς ἐχώρουν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:764.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:764.1.text#παῦρ' ἀνιάσας, πόλλ' εὐφράνας, πάντα παρασχὼν τὰ δέοντα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:765.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:765.1.text#πρὸς ταῦτα χρεὼν εἶναι μετ' ἐμοῦ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:766.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:766.1.text#καὶ τοὺς ἄνδρας καὶ τοὺς παῖδας·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:767.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:767.1.text#καὶ τοῖς φαλακροῖσι παραινοῦμεν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:768.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:768.1.text#ξυσπουδάζειν περὶ τῆς νίκης.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:769.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:769.1.text#πᾶς γάρ τις ἐρεῖ νικῶντος ἐμοῦ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:770.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:770.1.text#κἀπὶ τραπέζῃ καὶ ξυμποσίοις,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:771.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:771.1.text#"φέρε τῷ φαλακρῷ, δὸς τῷ φαλακρῷ"
urn:cts:greekLit:tlg0019.tlg005.fu.sp:772.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:772.1.text#"τῶν τρωγαλίων, καὶ μἀφαίρει"
urn:cts:greekLit:tlg0019.tlg005.fu.sp:773.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:773.1.text#"γενναιοτάτου τῶν ποιητῶν"
urn:cts:greekLit:tlg0019.tlg005.fu.sp:773b.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:773b.1.text#"ἀνδρὸς τὸ μέτωπον ἔχοντος".
urn:cts:greekLit:tlg0019.tlg005.fu.sp:775.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:775.1.text#Μοῦσα σὺ μὲν πολέμους ἀπωσαμένη μετ' ἐμοῦ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:776.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:776.1.text#τοῦ φίλου χόρευσον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:777.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:777.1.text#κλείουσα θεῶν τε γάμους ἀνδρῶν τε δαῖτας
urn:cts:greekLit:tlg0019.tlg005.fu.sp:780.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:780.1.text#καὶ θαλίας μακάρων· σοὶ γὰρ τάδ' ἐξ ἀρχῆς μέλει.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:781.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:781.1.text#ἢν δέ σε Καρκίνος ἐλθὼν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:782.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:782.1.text#ἀντιβολῇ μετὰ τῶν παίδων χορεῦσαι,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:785.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:785.1.text#μήθ' ὑπάκουε μήτ' ἔλθῃς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:786.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:786.1.text#συνέριθος αὐτοῖς,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:787.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:787.1.text#ἀλλὰ νόμιζε πάντας
urn:cts:greekLit:tlg0019.tlg005.fu.sp:788.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:788.1.text#ὄρτυγας οἰκογενεῖς γυλιαύχενας ὀρχηστὰς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:790.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:790.1.text#ναννοφυεῖς σφυράδων ἀποκνίσματα μηχανοδίφας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:791.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:791.1.text#καὶ γὰρ ἔφασχ' ὁ πατὴρ ὃ παρ' ἐλπίδας
urn:cts:greekLit:tlg0019.tlg005.fu.sp:795.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:795.1.text#εἶχε τὸ δρᾶμα γαλῆν τῆς ἑσπέρας ἀπάγξαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:797.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:797.1.text#τοιάδε χρὴ Χαρίτων δαμώματα καλλικόμων
urn:cts:greekLit:tlg0019.tlg005.fu.sp:798.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:798.1.text#τὸν σοφὸν ποιητὴν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:800.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:800.1.text#ὑμνεῖν, ὅταν ἠρινὰ μὲν φωνῇ χελιδὼν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:801.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:801.1.text#ἑζομένη κελαδῇ, χορὸν δὲ μὴ 'χῃ Μόρσιμος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:802.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:802.1.text#μηδὲ Μελάνθιος, οὗ δὴ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:805.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:805.1.text#πικροτάτην ὄπα γηρύσαντος ἤκουσ'
urn:cts:greekLit:tlg0019.tlg005.fu.sp:806.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:806.1.text#ἡνίκα τῶν τραγῳδῶν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:807.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:807.1.text#τὸν χορὸν εἶχον ἁδελφός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:808.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:808.1.text#τε και αὐτός, ἄμφω
urn:cts:greekLit:tlg0019.tlg005.fu.sp:810.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:810.1.text#Γοργόνες ὀψοφάγοι βατιδοσκόποι Ἅρπυιαι,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:811.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:811.1.text#γραοσόβαι μιαροὶ τραγομάσχαλοι ἰχθυολῦμαι·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:815.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:815.1.text#ὧν καταχρεμψαμένη μέγα καὶ πλατὺ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:816.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:816.1.text#Μοῦσα θεὰ μετ' ἐμοῦ ξύμπαιζε τὴν ἑορτήν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:819.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:819.1.text#ὡς χαλεπὸν ἐλθεῖν ἦν ἄρ' εὐθὺ τῶν θεῶν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:820.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:820.1.text#ἔγωγέ τοι πεπόνηκα κομιδῇ τὼ σκέλει.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:821.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:821.1.text#μικροὶ δ' ὁρᾶν ἄνωθεν ἦστ'. ἔμοιγέ τοι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:822.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:822.1.text#ἀπὸ τοὐρανοῦ 'φαίνεσθε κακοήθεις πάνυ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:823.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:823.1.text#ἐντευθενὶ δὲ πολύ τι κακοηθέστεροι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:824.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:824.1.text#ὦ δέσποθ' ἥκεις;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:824.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:824.2.text#ὡς ἐγὼ 'πυθόμην τινός.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:825.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:825.1.text#τί δ' ἔπαθες;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:825.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:825.2.text#ἤλγουν τὼ σκέλει μακρὰν ὁδὸν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:826.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:826.1.text#διεληλυθώς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:826.2.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:826.2.text#ἴθι νυν κάτειπέ μοι—
urn:cts:greekLit:tlg0019.tlg005.fu.sp:826.3.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:826.3.text#τὸ τί;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:827.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:827.1.text#ἄλλον τιν' εἶδες ἄνδρα κατὰ τὸν ἀέρα
urn:cts:greekLit:tlg0019.tlg005.fu.sp:828.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:828.1.text#πλανώμενον πλὴν σαυτόν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:828.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:828.2.text#οὔκ, εἰ μή γέ που
urn:cts:greekLit:tlg0019.tlg005.fu.sp:829.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:829.1.text# ψυχὰς δύ' ἢ τρεῖς διθυραμβοδιδασκάλων.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:830.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:830.1.text#τί δ' ἔδρων;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:830.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:830.2.text#ξυνελέγοντ' ἀναβολὰς ποτώμεναι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:831.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:831.1.text#τὰς ἐνδιαεριαυερινηχέτους τινάς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:832.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:832.1.text#οὐκ ἦν ἄρ' οὐδ' ἃ λέγουσι, κατὰ τὸν ἀέρα
urn:cts:greekLit:tlg0019.tlg005.fu.sp:833.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:833.1.text#ὡς ἀστέρες γιγνόμεθ', ὅταν τις ἀποθάνῃ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:834.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:834.1.text#μάλιστα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:834.2.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:834.2.text#καὶ τίς ἐστιν ἀστὴρ νῦν ἐκεῖ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:835.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:835.1.text#Ἴων ὁ Χῖος, ὅσπερ ἐποίησεν πάλαι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:836.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:836.1.text#ἐνθάδε τὸν ἀοῖόν ποθ'· ὡς δ' ἦλθ', εὐθέως
urn:cts:greekLit:tlg0019.tlg005.fu.sp:837.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:837.1.text#ἀοῖον αὐτὸν πάντες ἐκάλουν ἀστέρα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:838.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:838.1.text#τίνες γάρ εἰσ' οἱ διατρέχοντες ἀστέρες,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:839.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:839.1.text#οἳ καόμενοι θέουσιν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:839.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:839.2.text#ἀπὸ δείπνου τινὲς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:840.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:840.1.text#τῶν πλουσίων οὗτοι βαδίζουσ' ἀστέρων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:841.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:841.1.text#ἰπνοὺς ἔχοντες, ἐν δὲ τοῖς ἰπνοῖσι πῦρ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:842.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:842.1.text#ἀλλ' εἴσαγ' ὡς τάχιστα ταυτηνὶ λαβών,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:843.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:843.1.text#καὶ τὴν πύελον κατάκλυζε καὶ θέρμαιν' ὕδωρ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:844.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:844.1.text#στόρνυ τ' ἐμοὶ καὶ τῇδε κουρίδιον λέχος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:845.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:845.1.text#καὶ ταῦτα δράσας ἧκε δεῦρ' αὖθις πάλιν·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:846.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:846.1.text#ἐγὼ δ' ἀποδώσω τήνδε τῇ βουλῇ τέως.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:847.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:847.1.text#πόθεν δ' ἔλαβες ταύτας;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:847.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:847.2.text#ὁπόθεν; ἐκ τοὐρανοῦ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:848.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:848.1.text#οὐκ ἂν ἔτι δοίην τῶν θεῶν τριώβολον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:849.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:849.1.text#εἰ πορνοβοσκοῦσ' ὥσπερ ἡμεῖς οἱ βροτοί.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:850.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:850.1.text#οὔκ, ἀλλὰ κἀκεῖ ζῶσιν ἀπὸ τούτων τινές.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:851.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:851.1.text#ἄγε νυν ἴωμεν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:851.2.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:851.2.text#εἰπέ μοι, δῶ καταφαγεῖν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:852.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:852.1.text#ταύτῃ τι;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:852.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:852.2.text#μηδέν· οὐ γὰρ ἐθελήσει θαγεῖν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:853.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:853.1.text#οὔτ' ἄρτον οὔτε μᾶζαν, εἰωθυῖ' ἀεὶ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:854.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:854.1.text#παρὰ τοῖς θεοῖσιν ἀμβροσίαν λείχειν ἄνω.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:855.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:855.1.text#λείχειν ἄρ' αὐτῇ κἀνθάδε σκευαστέον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:856.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:856.1.text#εὐδαιμονικῶς γ' ὁ πρεσβύτης,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:857.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:857.1.text#ὅσα γ' ὧδ' ἰδεῖν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:858.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:858.1.text#τὰ νῦν τάδε πράττει.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:859.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:859.1.text#τί δῆτ' ἐπειδὰν νυμφίον μ' ὁρᾶτε λαμπρὸν ὄντα;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:860.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:860.1.text#ζηλωτὸς ἔσει, γέρον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:861.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:861.1.text#αὖθις νέος ὢν πάλιν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:862.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:862.1.text#μύρῳ κατάλειπτος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:863.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:863.1.text#οἶμαι. τί δῆθ' ὅταν ξυνὼν τῶν τιτθίων ἔχωμαι;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:864.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:864.1.text#εὐδαιμονέστερος φανεῖ τῶν Καρκίνου στροβίλων.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:865.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:865.1.text#οὔκουν δικαίως; ὅστις εἰς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:865a.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:865a.1.text#ὄχημα κανθάρου 'πιβὰς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:866.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:866.1.text#ἔσωσα τοὺς Ἕλληνας, ὥστ'
urn:cts:greekLit:tlg0019.tlg005.fu.sp:866a.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:866a.1.text#ἐν τοῖς ἀγροῖσιν αὐτοὺς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:867.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:867.1.text#ἅπαντας ὄντας ἀσφαλῶς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:867a.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:867a.1.text#βινεῖν τε καὶ καθεύδειν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:868.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:868.1.text#ἡ παῖς λέλουται καὶ τὰ τῆς πυγῆς καλά·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:869.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:869.1.text#ὁ πλακοῦς πέπεπται, σησαμῆ ξυμπλάττεται.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:870.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:870.1.text#καὶ τἄλλ' ἁπαξάπαντα· τοῦ πέους δὲ δεῖ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:871.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:871.1.text#ἴθι νυν ἀποδῶμεν τήνδε τὴν Θεωρίαν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:872.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:872.1.text#ἀνύσαντε τῇ βουλῇ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:872.2.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:872.2.text#τίς αὑτηί;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:872.3.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:872.3.text#τί φῄς;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:873.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:873.1.text#αὕτη Θεωρία 'στίν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:873.2.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:873.2.text#ἣν ἡμεῖς ποτε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:874.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:874.1.text#ἐπαίομεν Βραυρωνάδ' ὑποπεπωκότες;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:875.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:875.1.text#σάφ' ἴσθι, κἀλήφθη γε μόλις.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:875.2.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:875.2.text#ὦ δέσποτα
urn:cts:greekLit:tlg0019.tlg005.fu.sp:876.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:876.1.text#ὅσην ἔχει τὴν πρωκτοπεντετηρίδα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:877.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:877.1.text#εἶεν, τίς ἐσθ' ὑμῶν δίκαιος, τίς ποτε;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:878.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:878.1.text#τίς διαφυλάξει τήνδε τῇ βουλῇ λαβών;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:879.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:879.1.text#οὗτος τί περιγράφεις;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:879.2.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:879.2.text#τὸ δεῖν' εἰς Ἴσθμια
urn:cts:greekLit:tlg0019.tlg005.fu.sp:880.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:880.1.text#σκηνὴν ἐμαυτοῦ τῷ πέει καταλαμβάνω.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:881.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:881.1.text#οὔπω λέγεθ' ὑμεῖς τίς ὁ φυλάξων. δεῦρο σύ·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:882.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:882.1.text#καταθήσομαι γὰρ αὐτὸς ἐς μέσους ἄγων.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:883.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:883.1.text#ἐκεινοσὶ νεύει.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:883.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:883.2.text#τίς;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:883.3.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:883.3.text#ὅστις; Ἀριφράδης,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:884.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:884.1.text#ἄγειν παρ' αὑτὸν ἀντιβολῶν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:884.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:884.2.text#ἀλλ' ὦ μέλε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:885.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:885.1.text#τὸν ζωμὸν αὐτῆς προσπεσὼν ἐκλάψεται.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:886.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:886.1.text#ἄγε δὴ σὺ κατάθου πρῶτα τὰ σκεύη χαμαί.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:887.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:887.1.text#βουλή, πρυτάνεις, ὁρᾶτε τὴν Θεωρίαν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:888.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:888.1.text#σκέψασθ' ὅσ' ὑμῖν ἀγαθὰ παραδώσω φέρων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:889.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:889.1.text#ὥστ' εὐθέως ἄραντας ὑμᾶς τὼ σκέλει
urn:cts:greekLit:tlg0019.tlg005.fu.sp:890.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:890.1.text#ταύτης μετέωρα καταγαγεῖν ἀνάρρυσιν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:891.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:891.1.text#τουτὶ δ' ὁρᾶτ' ὀπτάνιον ἡμῖν ὡς καλόν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:892.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:892.1.text#διὰ ταῦτα καὶ κεκάπνικ' ἄρ'· ἐνταυθοῖ γὰρ οὖν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:893.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:893.1.text#πρὸ τοῦ πολέμου τὰ λάσανα τῇ βουλῇ ποτ' ἦν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:894.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:894.1.text#ἔπειτ' ἀγῶνά γ' εὐθὺς ἐξέσται ποιεῖν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:895.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:895.1.text#ταύτην ἔχουσιν αὔριον καλὸν πάνυ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:896.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:896.1.text#ἐπὶ γῆς παλαίειν, τετραποδηδὸν ἑστάναι,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:897.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:897.1.text#πλαγίαν καταβάλλειν, ἐς γόνατα κύβδ' ἑστάναι,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:898.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:898.1.text#καὶ παγκράτιόν γ' ὑπαλειψαμένοις νεανικῶς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:899.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:899.1.text#παίειν ὀρύττειν πὺξ ὁμοῦ καὶ τῷ πέει·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:900.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:900.1.text#τρίτῃ δὲ μετὰ ταῦθ' ἱπποδρομίαν ἄξετε,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:901.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:901.1.text#ἵνα δὴ κέλης κέλητα παρακελητιεῖ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:902.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:902.1.text#ἅρματα δ' ἐπ' ἀλλήλοισιν ἀνατετραμμένα
urn:cts:greekLit:tlg0019.tlg005.fu.sp:903.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:903.1.text#φυσῶντα καὶ πνέοντα προσκινήσεται·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:904.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:904.1.text#ἕτεροι δὲ κείσονταί γ' ἀπεψωλημένοι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:905.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:905.1.text#περὶ ταῖσι καμπαῖς ἡνίοχοι πεπτωκότες.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:906.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:906.1.text#ἀλλ' ὦ πρυτάνεις δέχεσθε τὴν Θεωρίαν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:907.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:907.1.text#θέασ' ὡς προθύμως ὁ πρύτανις παρεδέξατο.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:908.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:908.1.text#ἀλλ' οὐκ ἂν εἴ τι προῖκα προσαγαγεῖν σ' ἔδει,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:909.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:909.1.text#ἀλλ' ηὗρον ἄν σ' ὑπέχοντα τὴν ἐκεχειρίαν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:910.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:910.1.text#ἦ χρηστὸς ἀνὴρ πολίτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:911.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:911.1.text#ἐστὶν ἅπασιν ὅστις
urn:cts:greekLit:tlg0019.tlg005.fu.sp:911a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:911a.1.text#γ' ἐστὶ τοιοῦτος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:912.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:912.1.text#ὅταν τρυγᾶτ', εἴσεσθε πολλῷ μᾶλλον οἷός εἰμι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:913.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:913.1.text#καὶ νῦν σύ γε δῆλος εἶ·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:914.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:914.1.text#σωτὴρ γὰρ ἅπασιν ἀνθρώποις
urn:cts:greekLit:tlg0019.tlg005.fu.sp:915.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:915.1.text#γεγένησαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:916.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:916.1.text#φήσεις ἐπειδὰν ἐκπίῃς οἴνου νέου λεπαστήν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:917.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:917.1.text#καὶ πλήν γε τῶν θεῶν ἀεί σ' ἡγησόμεσθα πρῶτον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:918.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:918.1.text#πολλῶν γὰρ ὑμῖν ἄξιος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:919.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:919.1.text#Τρυγαῖος ἁθμονεὺς ἐγώ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:920.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:920.1.text#δεινῶν ἀπαλλάξας πόνων
urn:cts:greekLit:tlg0019.tlg005.fu.sp:920a.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:920a.1.text#τὸν δημότην ὅμιλον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:921.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:921.1.text#καὶ τὸν γεωργικὸν λεὼν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:921a.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:921a.1.text#Ὑπέρβολόν τε παύσας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:922.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:922.1.text#ἄγε δὴ τί νῷν ἐντευθενὶ ποιητέον;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:923.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:923.1.text#τί δ' ἄλλο γ' ἢ ταύτην χύτραις ἱδρυτέον;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:924.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:924.1.text#χύτραισιν, ὥσπερ μεμφόμενον Ἑρμῄδιον;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:925.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:925.1.text#τί δαὶ δοκεῖ; βούλεσθε λαρινῷ βοΐ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:926.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:926.1.text#βοΐ; μηδαμῶς, ἵνα μὴ βοηθεῖν ποι δέῃ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:927.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:927.1.text#ἀλλ' ὑὶ παχείᾳ καὶ μεγάλῃ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:927.2.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:927.2.text#μὴ μή.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:927.3.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:927.3.text#τιή;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:928.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:928.1.text#ἵνα μὴ γένηται Θεογένους ὑηνία.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:929.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:929.1.text#τῷ δὴ δοκεῖ σοι δῆτα τῶν λοιπῶν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:929.2.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:929.2.text#ὀί.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:930.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:930.1.text#ὀί;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:930.2.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:930.2.text#ναὶ μὰ Δί'.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:930.3.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:930.3.text#ἀλλὰ τοῦτό γ' ἔστ' Ἰωνικὸν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:931.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:931.1.text#τὸ ῥῆμ'.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:931.2.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:931.2.text#ἐπίτηδές γ', ἵν' ὅταν ἐν τἠκκλησίᾳ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:932.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:932.1.text#ὡς χρὴ πολεμεῖν λέγῃ τις, οἱ καθήμενοι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:933.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:933.1.text#ὑπὸ τοῦ δέους λέγωσ' Ἰωνικῶς ὀὶ—
urn:cts:greekLit:tlg0019.tlg005.fu.sp:934.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:934.1.text#εὖ τοι λέγεις.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:934.2.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:934.2.text#καὶ τἄλλα γ' ὦσιν ἤπιοι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:935.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:935.1.text#ὥστ' ἐσόμεθ' ἀλλήλοισιν ἀμνοὶ τοὺς τρόπους
urn:cts:greekLit:tlg0019.tlg005.fu.sp:936.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:936.1.text#καὶ τοῖσι συμμάχοισι πρᾳότεροι πολύ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:937.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:937.1.text#ἴθι νυν ἄγ' ὡς τάχιστα τὸ πρόβατον λαβών·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:938.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:938.1.text#ἐγὼ δὲ ποριῶ βωμὸν ἐφ' ὅτου θύσομεν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:939.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:939.1.text#ὡς πάνθ' ὅσ' ἂν θεὸς θέλῃ χἠ τύχη κατορθοῖ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:940.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:940.1.text#χωρεῖ κατὰ νοῦν, ἕτερον δ' ἑτέρῳ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:941.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:941.1.text#τούτων κατὰ καιρὸν ἀπαντᾷ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:942.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:942.1.text#ὡς ταῦτα δῆλά γ' ἔσθ'· ὁ γὰρ βωμὸς θύρασι καὶ δή.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:943.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:943.1.text#ἐπείγετέ νυν ἐν ὅσῳ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:944.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:944.1.text#σοβαρὰ θεόθεν κατέχει
urn:cts:greekLit:tlg0019.tlg005.fu.sp:945.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:945.1.text#πολέμου μετάτροπος αὔρα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:946.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:946.1.text#νῦν γὰρ δαίμων φανερῶς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:947.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:947.1.text#εἰς ἀγαθὰ μεταβιβάζει.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:948.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:948.1.text#τὸ κανοῦν πάρεστ' ὀλὰς ἔχον καὶ στέμμα καὶ μάχαιραν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:949.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:949.1.text#καὶ πῦρ γε τουτί, κοὐδὲν ἴσχει πλὴν τὸ πρόβατον ὑμᾶς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:950.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:950.1.text#οὔκουν ἁμιλλήσεσθον; ὡς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:951.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:951.1.text#ἢν Χαῖρις ὑμᾶς ἴδῃ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:952.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:952.1.text#πρόσεισιν αὐλήσων ἄκλητος,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:953.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:953.1.text#κᾆτα τοῦτ' εὖ οἶδ' ὅτι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:954.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:954.1.text#φυσῶντι καὶ πονουμένῳ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:955.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:955.1.text#προσδώσετε δήπου.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:956.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:956.1.text#ἄγε δὴ τὸ κανοῦν λαβὼν σὺ καὶ τὴν χέρνιβα
urn:cts:greekLit:tlg0019.tlg005.fu.sp:957.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:957.1.text#περίιθι τὸν βωμὸν ταχέως ἐπιδέξια.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:958.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:958.1.text#ἰδού· λεγοις ἂν ἄλλο· περιελήλυθα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:959.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:959.1.text#φέρε δὴ τὸ δαλίον τόδ' ἐμβάψω λαβών,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:960.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:960.1.text#σείου σὺ ταχέως· σὺ δὲ πρότεινε τῶν ὀλῶν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:961.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:961.1.text#καὐτός γε χερνίπτου παραδοὺς ταύτην ἐμοί,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:962.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:962.1.text#καὶ τοῖς θεαταῖς ῥῖπτε τῶν κριθῶν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:962.2.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:962.2.text#ἰδού.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:963.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:963.1.text#ἔδωκας ἤδη;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:963.2.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:963.2.text#νὴ τὸν Ἑρμῆν ὥστε γε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:964.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:964.1.text#τούτων ὅσοιπέρ εἰσι τῶν θεωμένων
urn:cts:greekLit:tlg0019.tlg005.fu.sp:965.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:965.1.text#οὐκ ἔστιν οὐδεὶς ὅστις οὐ κριθὴν ἔχει.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:966.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:966.1.text#οὐχ αἱ γυναῖκές γ' ἔλαβον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:966.2.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:966.2.text#ἀλλ' εἰς ἑσπέραν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:967.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:967.1.text#δώσουσιν αὐταῖς ἅνδρες.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:967.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:967.2.text#ἀλλ' εὐχώμεθα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:968.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:968.1.text#τίς τῇδε; ποῦ ποτ' εἰσὶ πολλοὶ κἀγαθοί;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:969.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:969.1.text#τοισδὶ φέρε δῶ· πολλοὶ γάρ εἰσι κἀγαθοί.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:970.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:970.1.text#τούτους ἀγαθοὺς ἐνόμισας;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:970.2.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:970.2.text#οὐ γάρ, οἵτινες
urn:cts:greekLit:tlg0019.tlg005.fu.sp:971.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:971.1.text#ἡμῶν καταχεόντων ὕδωρ τοσουτονὶ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:972.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:972.1.text#ἐς ταὐτὸ τοῦθ' ἑστᾶσ' ἰόντες χωρίον;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:973.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:973.1.text#ἀλλ' ὡς τάχιστ' εὐχώμεθ'.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:973.2.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:973.2.text#εὐχώμεσθα δή.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:974.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:974.1.text#ὦ σεμνοτάτη βασίλεια θεὰ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:975.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:975.1.text#πότνι' Εἰρήνη,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:976.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:976.1.text#δέσποινα χορῶν, δέσποινα γάμων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:977.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:977.1.text#δέξαι θυσίαν τὴν ἡμετέραν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:978.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:978.1.text#δέξαι δῆτ' ὦ πολυτιμήτη
urn:cts:greekLit:tlg0019.tlg005.fu.sp:979.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:979.1.text#νὴ Δία, καὶ μὴ ποίει γ' ἅπερ αἱ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:980.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:980.1.text#μοιχευόμεναι δρῶσι γυναῖκες.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:981.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:981.1.text#καὶ γὰρ ἐκεῖναι παρακλίνασαι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:982.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:982.1.text#τῆς αὐλείας παρακύπτουσιν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:983.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:983.1.text#κἄν τις προσέχῃ τὸν νοῦν αὐταῖς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:984.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:984.1.text#ἀναχωροῦσιν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:985.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:985.1.text#κᾆτ' ἢν ἀπίῃ παρακύπτουσιν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:986.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:986.1.text#τούτων σὺ ποίει μηδὲν ἔθ' ἡμᾶς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:987.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:987.1.text#μὰ Δί' ἀλλ' ἀπόφηνον ὅλην σαυτὴν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:988.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:988.1.text#γενναιοπρεπῶς τοῖσιν ἐρασταῖς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:989.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:989.1.text#ἡμῖν, οἵ σου τρυχόμεθ' ἤδη
urn:cts:greekLit:tlg0019.tlg005.fu.sp:990.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:990.1.text#τρία καὶ δέκ' ἔτη,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:991.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:991.1.text#λῦσον δὲ μάχας καὶ κορκορυγάς,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:992.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:992.1.text#ἵνα Λυσιμάχην σε καλῶμεν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:993.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:993.1.text#παῦσον δ' ἡμῶν τὰς ὑπονοίας
urn:cts:greekLit:tlg0019.tlg005.fu.sp:994.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:994.1.text#τὰς περικόμψους,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:995.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:995.1.text#αἷς στωμυλλόμεθ' εἰς ἀλλήλους·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:996.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:996.1.text#μεῖξον δ' ἡμᾶς τοὺς Ἕλληνας
urn:cts:greekLit:tlg0019.tlg005.fu.sp:997.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:997.1.text#πάλιν ἐξ ἀρχῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:998.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:998.1.text#φιλίας χυλῷ καὶ συγγνώμῃ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:999.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:999.1.text#τινὶ πρᾳοτέρᾳ κέρασον τὸν νοῦν·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:999a.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:999a.1.text#καὶ τὴν ἀγορὰν ἡμῖν ἀγαθῶν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1000.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1000.1.text#ἐμπλησθῆναι, μεγάλων σκορόδων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1001.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1001.1.text#σικύων πρῴων, μήλων, ῥοιῶν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1002.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1002.1.text#δούλοισι χλανισκιδίων μικρῶν·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1003.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1003.1.text#κἀκ Βοιωτῶν γε φέροντας ἰδεῖν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1004.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1004.1.text#χῆνας νήττας φάττας τροχίλους·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1005.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1005.1.text#καὶ Κωπᾴδων ἐλθεῖν σπυρίδας,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1006.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1006.1.text#καὶ περὶ ταύτας ἡμᾶς ἁθρόους
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1007.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1007.1.text#ὀψωνοῦντας τυρβάζεσθαι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1008.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1008.1.text#Μορύχῳ Τελέᾳ Γλαυκέτῃ, ἄλλοις
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1009.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1009.1.text#τένθαις πολλοῖς· κᾆτα Μελάνθιον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1010.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1010.1.text#ἥκειν ὕστερον ἐς τὴν ἀγοράν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1011.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1011.1.text#τὰς δὲ πεπρᾶσθαι, τὸν δ' ὀτοτύζειν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1012.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1012.1.text#εἶτα μονῳδεῖν ἐκ Μηδείας,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1013.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1013.1.text#"ὀλόμαν ὀλόμαν, ἀποχηρωθεὶς"
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1014.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1014.1.text#"τᾶς ἐν τεύτλοισι λοχευομένας·"
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1015.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1015.1.text#τοὺς δ' ἀνθρώπους ἐπιχαίρειν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1016.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1016.1.text#ταῦτ' ὦ πολυτίμητ' εὐχομένοις ἡμῖν δίδου.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1017.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1017.1.text#λαβὲ τὴν μάχαιραν· εἶθ' ὅπως μαγειρικῶς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1018.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1018.1.text#σφάξεις τὸν οἶν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1018.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1018.2.text#ἀλλ' οὐ θέμις.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1018.3.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1018.3.text#τιὴ τί δή;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1019.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1019.1.text#οὐχ ἥδεται δήπουθεν Εἰρήνη σφαγαῖς,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1020.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1020.1.text#οὐδ' αἱματοῦται βωμός. ἀλλ' εἴσω φέρων
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1021.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1021.1.text#θύσας τὰ μηρἴ ἐξελὼν δεῦρ' ἔκφερε,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1022.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1022.1.text#χοὔτω τὸ πρόβατον τῷ χορηγῷ σῴζεται.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1023.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1023.1.text#σέ τοι θύρασι χρὴ […] μένοντα τοίνυν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1024.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1024.1.text#σχίζας δευρὶ τιθέναι ταχέως
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1025.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1025.1.text#τά τε πρόσφορα πάντ' ἐπὶ τούτοις.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1026.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1026.1.text#οὔκουν δοκῶ σοι μαντικῶς τὸ φρύγανον τίθεσθαι;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1027.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1027.1.text#πῶς δ' οὐχί; τί γάρ σε πέφευγ'
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1028.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1028.1.text#ὅσα χρὴ σοφὸν ἄνδρα; τί δ' οὐ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1029.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1029.1.text#σὺ φρονεῖς ὁπόσα χρεών ἐστιν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1030.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1030.1.text#τόν γε σοφῇ δόκιμον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1031.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1031.1.text#φρενὶ πορίμῳ τε τόλμῃ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1032.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1032.1.text#ἡ σχίζα γοῦν ἐνημμένη τὸν Στιλβίδην πιέζει,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1033.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1033.1.text#καὶ τὴν τράπεζαν οἴσομαι, καὶ παιδὸς οὐ δεήσει.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1034.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1034.1.text#τίς οὖν ἂν οὐκ ἐπαινέσειεν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1035.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1035.1.text#ἄνδρα τοιοῦτον, ὅστις
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1035a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1035a.1.text#πόλλ' ἀνατλὰς ἔσωσε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1036.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1036.1.text#τὴν ἱερὰν πόλιν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1037.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1037.1.text#ὥστ' οὐχὶ μὴ παύσῃ ποτ' ὢν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1038.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1038.1.text#ζηλωτὸς ἅπασιν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1039.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1039.1.text#ταυτὶ δέδραται. τίθεσο τὼ μηρὼ λαβών.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1040.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1040.1.text#ἐγὼ δ' ἐπὶ σπλάγχν' εἶμι καὶ θυλήματα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1041.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1041.1.text#ἐμοὶ μελήσει ταῦτά γ'· ἀλλ' ἥκειν ἐχρῆν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1042.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1042.1.text#ἰδοὺ πάρειμι. μῶν ἐπισχεῖν σοι δοκῶ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1043.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1043.1.text#ὄπτα καλῶς νυν αὐτά· καὶ γὰρ οὑτοσὶ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1044.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1044.1.text#προσέρχεται δάφνῃ τις ἐστεφανωμένος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1045.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1045.1.text#τίς ἄρα ποτ' ἐστίν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1045.2.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1045.2.text#ὡς ἀλαζὼν φαίνεται·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1046.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1046.1.text#μάντις τίς ἐστιν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1046.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1046.2.text#οὐ μὰ Δί' ἀλλ' Ἱεροκλέης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1047.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1047.1.text#οὗτός γέ πού 'σθ' ὁ χρησμολόγος οὑξ Ὠρεοῦ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1048.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1048.1.text#τί ποτ' ἄρα λέξει;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1048.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1048.2.text#δῆλός ἐσθ' οὗτός γ' ὅτι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1049.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1049.1.text#ἐναντιώσεταί τι ταῖς διαλλαγαῖς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1050.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1050.1.text#οὔκ, ἀλλὰ κατὰ τὴν κνῖσαν εἰσελήλυθεν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1051.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1051.1.text#μή νυν ὁρᾶν δοκῶμεν αὐτόν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1051.2.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1051.2.text#εὖ λέγεις.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1052.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1052.1.text#τίς ἡ θυσία ποθ' αὑτηὶ καὶ τῷ θεῶν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1053.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1053.1.text#ὀπτα σὺ σιγῇ κἄπαγ' ἀπὸ τῆς ὀσφύος.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1054.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1054.1.text#ὅτῳ δὲ θύετ' οὐ φράσεθ';
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1054.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1054.2.text#ἡ κέρκος ποιεῖ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1055.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1055.1.text#καλῶς;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1055.2.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1055.2.text#καλῶς δῆτ' ὦ πότνι' Εἰρήνη φίλη.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1056.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1056.1.text#ἄγε νυν ἀπάρχου κᾆτα δὸς τἀπάργματα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1057.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1057.1.text#ὀπτᾶν ἄμεινον πρῶτον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1057.2.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1057.2.text#ἀλλὰ ταυταγὶ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1058.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1058.1.text#ἤδη 'στὶν ὀπτά.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1058.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1058.2.text#πολλὰ πράττεις, ὅστις εἶ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1059.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1059.1.text#κατάτεμνε. ποῦ τράπεζα; τὴν σπονδὴν φέρε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1060.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1060.1.text#ἡ γλῶττα χωρὶς τέμνεται.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1060.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1060.2.text#μεμνήμεθα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1061.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1061.1.text#ἀλλ' οἶσθ' ὃ δρᾶσον;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1061.2.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1061.2.text#ἢν φράσῃς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1061.3.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1061.3.text#μὴ διαλέγου
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1062.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1062.1.text#νῷν μηδέν· Εἰρήνῃ γὰρ ἱερὰ θύομεν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1063.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1063.1.text#ὦ μέλεοι θνητοὶ καὶ νήπιοι,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1063.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1063.2.text#ἐς κεφαλὴν σοί.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1064.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1064.1.text#οἵτινες ἀφραδίῃσι θεῶν νόον οὐκ ἀίοντες
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1065.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1065.1.text#συνθήκας πεποίησθ' ἄνδρες χαροποῖσι πιθήκοις,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1066.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1066.1.text#αἰβοιβοῖ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1066.2.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1066.2.text#τί γελᾷς;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1066.3.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1066.3.text#ἥσθην χαροποῖσι πιθήκοις.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1067.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1067.1.text#καὶ κέπφοι τρήρωνες ἀλωπεκιδεῦσι πέπεισθε,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1068.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1068.1.text#ὧν δόλιαι ψυχαί, δόλιαι φρένες.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1068.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1068.2.text#εἴθε σου εἶναι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1069.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1069.1.text#ὤφελεν ὦλαζὼν οὑτωσὶ θερμὸς ὁ πλεύμων.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1070.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1070.1.text#εἰ γὰρ μὴ νύμφαι γε θεαὶ Βάκιν ἐξαπάτασκον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1071.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1071.1.text#μηδὲ Βάκις θνητούς, μηδ' αὖ νύμφαι Βάκιν αὐτὸν—
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1072.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1072.1.text#ἐξώλης ἀπόλοι', εἰ μὴ παύσαιο βακίζων.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1073.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1073.1.text#οὔπω θέσφατον ἦν Εἰρήνης δέσμ' ἀναλῦσαι,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1074.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1074.1.text#ἀλλὰ τόδε πρότερον—
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1074.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1074.2.text#τοῖσδ' ἁλσί γε παστέα ταυτί.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1075.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1075.1.text#οὐ γάρ πω τοῦτ' ἐστὶ φίλον μακάρεσσι θεοῖσιν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1076.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1076.1.text#φυλόπιδος λῆξαι, πρίν κεν λύκος οἶν ὑμεναιοῖ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1077.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1077.1.text#καὶ πῶς ὦ κατάρατε λύκος ποτ' ἂν οἶν ὑμεναιοῖ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1078.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1078.1.text#ὡς ἡ σφονδύλη φεύγουσα πονηρότατον βδεῖ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1078a.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1078a.1.text#†χἠ κώδων† ἀκαλανθὶς ἐπειγομένη τυφλὰ τίκτει,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1079.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1079.1.text#τουτάκις οὔπω χρῆν τὴν εἰρήνην πεποιῆσθαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1080.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1080.1.text#ἀλλὰ τί χρῆν ἡμᾶς; οὐ παύσασθαι πολεμοῦντας,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1081.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1081.1.text#ἢ διακαυνιάσαι πότεροι κλαυσούμεθα μεῖζον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1082.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1082.1.text#ἐξὸν σπεισαμένοις κοινῇ τῆς Ἑλλάδος ἄρχειν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1083.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1083.1.text#οὔποτε ποιήσεις τὸν καρκίνον ὀρθὰ βαδίζειν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1084.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1084.1.text#οὔποτε δειπνήσεις ἔτι τοῦ λοιποῦ ν' πρυτανείῳ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1085.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1085.1.text#οὐδ' ἐπὶ τῷ πραχθέντι ποιήσεις ὕστερον οὐδέν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1086.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1086.1.text#οὐδέποτ' ἂν θείης λεῖον τὸν τραχὺν ἐχῖνον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1087.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1087.1.text#ἆρα φενακίζων ποτ' Ἀθηναίους ἔτι παύσει;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1088.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1088.1.text#ποῖον γὰρ κατὰ χρησμὸν ἐκαύσατε μῆρα θεοῖσιν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1089.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1089.1.text#ὅνπερ κάλλιστον δήπου πεποίηκεν Ὅμηρος·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1090.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1090.1.text#"ὣς οἱ μὲν νέφος ἐχθρὸν ἀπωσάμενοι πολέμοιο"
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1091.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1091.1.text#"Εἰρήνην εἵλοντο καὶ ἱδρύσανθ' ἱερείῳ."
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1092.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1092.1.text#"αὐτὰρ ἐπεὶ κατὰ μῆρ' ἐκάη καὶ σπλάγχν' ἐπάσαντο,"
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1093.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1093.1.text#"ἔσπενδον δεπάεσσιν· ἐγὼ δ' ὁδὸν ἡγεμόνευον·"
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1094.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1094.1.text#χρησμολόγῳ δ' οὐδεὶς ἐδίδου κώθωνα φαεινόν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1095.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1095.1.text#οὐ μετέχω τούτων· οὐ γὰρ ταῦτ' εἶπε Σίβυλλα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1096.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1096.1.text#ἀλλ' ὁ σοφός τοι νὴ Δί' Ὅμηρος δεξιὸν εἶπεν·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1097.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1097.1.text#"ἀφρήτωρ ἀθέμιστος ἀνέστιός ἐστιν ἐκεῖνος,"
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1098.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1098.1.text#"ὃς πολέμου ἔραται ἐπιδημίου ὀκρυόεντος."
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1099.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1099.1.text#φράζεο δὴ μή πώς σε δόλῳ φρένας ἐξαπατήσας
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1100.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1100.1.text#ἰκτῖνος μάρψῃ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1100.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1100.2.text#τουτὶ μέντοι σὺ φυλάττου,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1101.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1101.1.text#ὡς οὗτος φοβερὸς τοῖς σπλάγχνοις ἐστὶν ὁ χρησμός.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1102.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1102.1.text#ἔγχει δὴ σπονδὴν καὶ τῶν σπλάγχνων φέρε δευρί.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1103.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1103.1.text#ἀλλ' εἰ ταῦτα δοκεῖ, κἀγὼ 'μαυτῷ βαλανεύσω.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1104.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1104.1.text#σπονδὴ σπονδή.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1105.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1105.1.text#ἔγχει δὴ κἀμοὶ καὶ σπλάγχνων μοῖραν ὄρεξον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1106.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1106.1.text#ἀλλ' οὔπω τοῦτ' ἐστὶ φίλον μακάρεσσι θεοῖσιν·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1107.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1107.1.text#ἀλλὰ τόδε πρότερον, σπένδειν ἡμᾶς, σὲ δ' ἀπελθεῖν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1108.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1108.1.text#ὦ πότνι' Εἰρήνη παράμεινον τὸν βίον ἡμῖν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1109.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1109.1.text#πρόσφερε τὴν γλῶτταν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1109.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1109.2.text#σὺ δὲ τὴν σαυτοῦ γ' ἀπένεγκε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1110.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1110.1.text#σπονδή.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1110.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1110.2.text#καὶ ταυτὶ μετὰ τῆς σπονδῆς λαβὲ θᾶττον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1111.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1111.1.text#οὐδεὶς προσδώσει τῶν σπλάγχνων;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1111.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1111.2.text#οὐ γὰρ οἷόν τε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1112.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1112.1.text#ἡμῖν προσδιδόναι, πρίν κεν λύκος οἶν ὑμεναιοῖ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1113.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1113.1.text#ναὶ πρὸς τῶν γονάτων.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1113.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1113.2.text#ἄλλως ὦ τᾶν ἱκετεύεις·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1114.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1114.1.text#οὐ γὰρ ποιήσεις λεῖον τὸν τραχὺν ἐχῖνον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1115.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1115.1.text#ἄγε δὴ θεαταὶ δεῦρο συσπλαγχνεύετε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1116.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1116.1.text#μετὰ νῷν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1116.2.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1116.2.text#τί δὴ 'γώ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1116.3.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1116.3.text#τὴν Σίβυλλαν ἔσθιε.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1117.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1117.1.text#οὔτοι μὰ τὴν γῆν ταῦτα κατέδεσθον μόνω,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1118.1.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1118.1.text#ἀλλ' ἁρπάσομαι σφῷν αὐτά· κεῖται δ' ἐν μέσῳ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1119.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1119.1.text#ὦ παῖε τὸν Βάκιν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1119.2.speaker#Ἱεροκλῆς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1119.2.text#μαρτύρομαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1120.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1120.1.text#κἄγωγ' ὅτι τένθης εἶ σὺ κἀλαζὼν ἀνήρ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1121.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1121.1.text#παἶ αὐτὸν ἐπέχων τῷ ξύλῳ τὸν ἀλαζόνα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1122.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1122.1.text#σὺ μὲν οὖν· ἐγὼ δὲ τουτονὶ τῶν κῳδίων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1123.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1123.1.text#ἁλάμβαν' αὐτὸς ἐξαπατῶν, ἐκβολβιῶ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1124.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1124.1.text#οὐ καταβαλεῖς τὰ κῴδι' ὦ θυηπόλε;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1125.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1125.1.text#ἤκουσας; ὁ κόραξ οἷος ἦλθ' ἐξ Ὠρεοῦ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1126.1.speaker#Οἰκέτης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1126.1.text#οὐκ ἀποπετήσει θᾶττον εἰς Ἐλύμνιον;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1127.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1127.1.text#ἥδομαί γ' ἥδομαι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1128.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1128.1.text#κράνους ἀπηλλαγμένος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1129.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1129.1.text#τυροῦ τε καὶ κρομμύων.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1130.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1130.1.text#οὐ γὰρ φιληδῶ μάχαις,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1131.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1131.1.text#ἀλλὰ πρὸς πῦρ διέλκων
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1132.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1132.1.text#μετ' ἀνδρῶν ἑταίρων φίλων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1133.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1133.1.text#ἐκκέας τῶν ξύλων ἅττ' ἂν ᾖ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1134.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1134.1.text#δανότατα τοῦ θέρους
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1135.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1135.1.text#†ἐκπεπρισμένα†,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1136.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1136.1.text#κἀνθρακίζων τοὐρεβίνθου
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1137.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1137.1.text#τήν τε φηγὸν ἐμπυρεύων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1138.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1138.1.text#χἄμα τὴν Θρᾷτταν κυνῶν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1139.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1139.1.text#τῆς γυναικὸς λουμένης.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1140.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1140.1.text#οὐ γὰρ ἔσθ' ἥδιον ἢ τυχεῖν μὲν ἤδη 'σπαρμένα,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1141.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1141.1.text#τὸν θεὸν δ' ἐπιψακάζειν, καὶ τιν' εἰπεῖν γείτονα,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1142.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1142.1.text#εἰπέ μοι τί τηνικαῦτα δρῶμεν ὦ Κωμαρχίδη;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1143.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1143.1.text#ἐμπιεῖν ἔμοιγ' ἀρέσκει τοῦ θεοῦ δρῶντος καλῶς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1144.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1144.1.text#ἀλλ' ἄφευε τῶν φασήλων ὦ γύναι τρεῖς χοίνικας,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1145.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1145.1.text#τῶν τε πυρῶν μεῖξον αὐτοῖς, τῶν τε σύκων ἔξελε,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1146.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1146.1.text#τόν τε Μανῆν ἡ Σύρα βωστρησάτω κ' τοῦ χωρίου.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1147.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1147.1.text#οὐ γὰρ οἷόν τ' ἐστὶ πάντως οἰναρίζειν τήμερον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1148.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1148.1.text#οὐδὲ τυντλάζειν, ἐπειδὴ παρδακὸν τὸ χωρίον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1149.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1149.1.text#κἀξ ἐμοῦ δ' ἐνεγκάτω τις τὴν κίχλην καὶ τὼ σπίνω·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1150.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1150.1.text#ἦν δὲ καὶ πυός τις ἔνδον καὶ λαγῷα τέτταρα,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1151.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1151.1.text#εἴ τι μὴ 'ξήνεγκεν αὐτῶν ἡ γαλῆ τῆς ἑσπέρας·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1152.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1152.1.text#ἐψόφει γοῦν ἔνδον οὐκ οἶδ' ἅττα κἀκυδοιδόπα·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1153.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1153.1.text#ὧν ἔνεγκ' ὦ παῖ τρἴ ἡμῖν, ἓν δὲ δοῦναι τῷ πατρί·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1154.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1154.1.text#μυρρίνας τ' αἴτησον ἐξ Αἰσχινάδου τῶν καρπίμων·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1155.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1155.1.text#χἄμα τῆς αὐτῆς ὁδοῦ Χαρινάδην τις βωσάτω,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1156.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1156.1.text#ὡς ἂν ἐμπίῃ μεθ' ἡμῶν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1157.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1157.1.text#εὖ ποιοῦντος κὠφελοῦντος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1158.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1158.1.text#τοῦ φεοῦ τἀρώματα.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1159.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1159.1.text#ἡνίκ' ἂν δ' ἀχέτας
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1160.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1160.1.text#ᾄδῃ τὸν ἡδὺν νόμον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1161.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1161.1.text#διασκοπῶν ἥδομαι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1162.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1162.1.text#τὰς Λημυνίας ἀμπέλους,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1163.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1163.1.text#εἰ πεπαίνουσιν ἤ-
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1164.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1164.1.text#δη ʽτὸ γὰρ φῖτυ πρῷον φύσεἰ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1165.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1165.1.text#τόν τε φήληχ' ὁρῶν οἰδάνοντ'·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1166.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1166.1.text#εἶθ' ὁπόταν ᾖ πέπων,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1167.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1167.1.text#ἐσθίω κἀπέχω
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1168.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1168.1.text#χἄμα φήμ', "ὧραι φίλαι·" καὶ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1169.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1169.1.text#τοῦ θύμου τρίβων κυκῶμαι·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1170.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1170.1.text#κᾆτα γίγνομαι παχὺς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1171.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1171.1.text#τηνικαῦτα τοῦ θέρους
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1172.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1172.1.text#μᾶλλον ἢ θεοῖσιν ἐχθρὸν ταξίαρχον προσβλέπων
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1173.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1173.1.text#τρεῖς λόφους ἔχοντα καὶ φοινικίδ' ὀξεῖαν πάνυ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1174.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1174.1.text#ἣν ἐκεῖνός φησιν εἶναι βάμμα Σαρδιανικόν·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1175.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1175.1.text#ἢν δέ που δέῃ μάχεσθ' ἔχοντα τὴν φοινικίδα,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1176.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1176.1.text#τηνικαῦτ' αὐτὸς βέβαπται βάμμα Κυζικηνικόν·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1177.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1177.1.text#κᾆτα φεύγει πρῶτος ὥσπερ ξουθὸς ἱππαλεκτρυὼν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1178.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1178.1.text#τοὺς λόφους σείων· ἐγὼ δ' ἕστηκα †λινοπτώμενος.†
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1179.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1179.1.text#ἡνίκ' ἂν δ' οἴκοι γένωνται, δρῶσιν οὐκ ἀνασχετά,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1180.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1180.1.text#τοὺς μὲν ἐγγράφοντες ἡμῶν τοὺς δ' ἄνω τε καὶ κάτω
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1181.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1181.1.text#ἐξαλείφοντες δὶς ἢ τρίς. αὔριον δ' ἔσθ' ἡ 'ξοδος·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1182.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1182.1.text#τῷ δὲ σιτί' οὐκ ἐώνητ'· οὐ γὰρ ᾔδειν ἐξιών·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1183.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1183.1.text#εἶτα προστὰς πρὸς τὸν ἀνδριάντα τὸν Πανδίονος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1184.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1184.1.text#εἶδεν αὑτόν, κἀπορῶν θεῖ τῷ κακῷ βλέπων ὀπόν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1185.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1185.1.text#ταῦτα δ' ἡμᾶς τοὺς ἀγροίκους δρῶσι, τοὺς δ' ἐξ ἄστεως
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1186.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1186.1.text#ἧττον, οἱ θεοῖσιν οὗτοι κἀνδράσιν ῥιψάσπιδες.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1187.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1187.1.text#ὧν ἔτ' εὐθύνας ἐμοὶ δώσουσιν, ἢν θεὸς θέλῃ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1188.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1188.1.text#πολλὰ γὰρ δή μ' ἠδίκησαν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1189.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1189.1.text#ὄντες οἴκοι μὲν λέοντες
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1190.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1190.1.text#ἐν μάχῃ δ' ἀλώπεκες.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1191.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1191.1.text#ἰοὺ ἰού.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1192.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1192.1.text#ὅσον τὸ χρῆμ' ἐπὶ δεῖπνον ἦλθ' ἐς τοὺς γάμους.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1193.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1193.1.text#ἔχ' ἀποκάθαιρε τὰς τραπέζας ταυτῃί·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1194.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1194.1.text#πάντως γὰρ οὐδὲν ὄφελός ἐστ' αὐτῆς ἔτι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1195.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1195.1.text#ἔπειτ' ἐπιφόρει τοὺς ἀμύλους καὶ τὰς κίχλας
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1196.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1196.1.text#καὶ τῶν λαγῴων πολλὰ καὶ τοὺς κολλάβους.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1197.1.speaker#Δρεπανουργός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1197.1.text#ποῦ ποῦ Τρυγαῖός ἐστιν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1197.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1197.2.text#ἀναβράττω κίχλας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1198.1.speaker#Δρεπανουργός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1198.1.text#ὦ φίλτατ' ὦ Τρυγαἶ ὅσ' ἡμᾶς τἀγαθὰ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1199.1.speaker#Δρεπανουργός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1199.1.text#δέδρακας εἰρήνην ποιήσας· ὡς πρὸ τοῦ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1200.1.speaker#Δρεπανουργός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1200.1.text#οὐδεὶς ἐπρίατ' ἂν δρέπανον οὐδὲ κολλύβου,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1201.1.speaker#Δρεπανουργός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1201.1.text#νυνὶ δὲ πεντήκοντα δραχμῶν ἐμπολῶ·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1202.1.speaker#Δρεπανουργός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1202.1.text#ὁδὶ δὲ τριδράχμους τοὺς κάδους ἐς τοὺς ἀγρούς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1203.1.speaker#Δρεπανουργός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1203.1.text#ἀλλ' ὦ Τρυγαῖε τῶν δρεπάνων τε λάμβανε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1204.1.speaker#Δρεπανουργός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1204.1.text#καὶ τῶνδ' ὅ τι βούλει προῖκα· καὶ ταυτὶ δέχου·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1205.1.speaker#Δρεπανουργός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1205.1.text#ἀφ' ὧν γὰρ ἀπεδόμεσθα κἀκερδήναμεν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1206.1.speaker#Δρεπανουργός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1206.1.text#τὰ δῶρα ταυτί σοι φέρομεν ἐς τοὺς γάμους.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1207.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1207.1.text#ἴθι νυν καταθέμενοι παρ' ἐμοὶ ταῦτ' εἴσιτε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1208.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1208.1.text#ἐπὶ δεῖπνον ὡς τάχιστα· καὶ γὰρ οὑτοσὶ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1209.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1209.1.text#ὅπλων κάπηλος ἀχθόμενος προσέρχεται.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1210.1.speaker#Λοφοποιός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1210.1.text#οἴμ' ὡς προθέλυμνόν μ' ὦ Τρυγαἶ ἀπώλεσας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1211.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1211.1.text#τί δ' ἔστιν ὦ κακόδαιμον; οὔτι που λοφᾷς;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1212.1.speaker#Λοφοποιός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1212.1.text#ἀπώλεσάς μου τὴν τέχνην καὶ τὸν βίον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1213.1.speaker#Λοφοποιός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1213.1.text#καὶ τουτουὶ καὶ τοῦ δορυξοῦ 'κεινονί.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1214.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1214.1.text#τί δῆτα τουτοινὶ καταθῶ σοι τοῖν λόφοιν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1215.1.speaker#Λοφοποιός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1215.1.text#αὐτὸς σὺ τί δίδως;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1215.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1215.2.text#ὅ τι δίδωμ'; αἰσχύνομαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1216.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1216.1.text#ὅμως δ' ὅτι τὸ σφήκωμ' ἔχει πόνον πολύν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1217.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1217.1.text#δοίην ἂν αὐτοῖν ἰσχάδων τρεῖς χοίνικας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1218.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1218.1.text#ἵν' ἀποκαθαίρω τὴν τράπεζαν τουτῳί.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1219.1.speaker#Λοφοποιός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1219.1.text#ἔνεγκε τοίνυν εἰσιὼν τὰς ἰσχάδας·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1220.1.speaker#Λοφοποιός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1220.1.text#κρεῖττον γὰρ ὦ τᾶν ἐστιν ἢ μηδὲν λαβεῖν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1221.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1221.1.text#ἀπόφερ' ἀπόφερ' ἐς κόρακας ἀπὸ τῆς οἰκίας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1222.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1222.1.text#τριχορρυεῖτον, οὐδέν ἐστον τὼ λόφω.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1223.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1223.1.text#οὐκ ἂν πριαίμην οὐδ' ἂν ἰσχάδος μιᾶς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1224.1.speaker#Θωρακόπωλης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1224.1.text#τί δαὶ δεκάμνῳ τῷδε θώρηκος κύτει
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1225.1.speaker#Θωρακόπωλης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1225.1.text#ἐνημμένῳ κάλλιστα χρήσομαι τάλας;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1226.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1226.1.text#οὗτος μὲν οὐ μή σοι ποιήσει ζημίαν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1227.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1227.1.text#ἀλλ' αἶρέ μοι τοῦτόν γε τῆς ἰσωνίας·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1228.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1228.1.text#ἐναποπατεῖν γάρ ἐστ' ἐπιτήδειος πάνυ—
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1229.1.speaker#Θωρακοπώλης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1229.1.text#παῦσαί μ' ὑβρίζων τοῖς ἐμοῖσι χρήμασιν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1230.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1230.1.text#ὡδὶ παραθέντι τρεῖς λίθους. οὐ δεξιῶς;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1231.1.speaker#Θωρακοπώλης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1231.1.text#ποίᾳ δ' ἀποψήσει ποτ' ὦμαθέστατε;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1232.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1232.1.text#τῃδὶ διεὶς τὴν χεῖρα διὰ τῆς θαλαμιᾶς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1233.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1233.1.text#καὶ τῇδ'.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1233.2.speaker#Θωρακοπώλης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1233.2.text#ἅμ' ἀμφοῖν δῆτ';
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1233.3.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1233.3.text#ἔγωγε νὴ Δία,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1234.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1234.1.text#ἵνα μή γ' ἁλῶ τρύπημα κλέπτων τῆς νεώς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1235.1.speaker#Θωρακοπώλης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1235.1.text#ἔπειτ' ἐπὶ δεκάμνῳ χεσεῖ καθήμενος;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1236.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1236.1.text#ἔγωγε νὴ Δί' ὦπίτριπτ'. οἴει γὰρ ἂν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1237.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1237.1.text#τὸν πρωκτὸν ἀποδόσθαι με χιλιῶν δραχμῶν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1238.1.speaker#Θωρακοπώλης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1238.1.text#ἴθι δὴ 'ξένεγκε τἀργύριον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1238.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1238.2.text#ἀλλ' ὦγαθὲ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1239.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1239.1.text#θλίβει τὸν ὄρρον. ἀπόφερ', οὐκ ὠνήσομαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1240.1.speaker#Σαλπιγγοποιός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1240.1.text#τί δ' ἆρα τῇ σάλπιγγι τῇδε χρήσομαι,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1241.1.speaker#Σαλπιγγοποιός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1241.1.text#ἣν ἐπριάμην δραχμῶν ποθ' ἑξήκοντ' ἐγώ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1242.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1242.1.text#μόλυβδον ἐς τουτὶ τὸ κοῖλον ἐγχέας
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1243.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1243.1.text#ἔπειτ' ἄνωθεν ῥάβδον ἐνθεὶς ὑπόμακρον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1244.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1244.1.text#γενήσεταί σοι τῶν κατακτῶν κοττάβων.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1245.1.speaker#Σαλπιγγοποιός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1245.1.text#οἴμοι καταγελᾷς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1245.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1245.2.text#ἀλλ' ἕτερον παραινέσω.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1246.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1246.1.text#τὸν μὲν μόλυβδον, ὥσπερ εἶπον, ἔγχεον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1247.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1247.1.text#ἐντευθενὶ δὲ σπαρτίοις ἠρτημένην
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1248.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1248.1.text#πλάστιγγα πρόσθες, καὐτό σοι γενήσεται
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1249.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1249.1.text#τὰ σῦκ' ἐν ἀγρῷ τοῖς οἰκέταισιν ἱστάναι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1250.1.speaker#Κρανοποιός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1250.1.text#ὦ δυσκάθαρτε δαῖμον ὥς μ' ἀπώλεσας,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1251.1.speaker#Κρανοποιός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1251.1.text#ὅτ' ἀντέδωκά γ' ἀντὶ τῶνδε μνᾶν ποτέ·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1252.1.speaker#Κρανοποιός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1252.1.text#καὶ νῦν τί δράσω; τίς γὰρ αὔτ' ὠνήσεται;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1253.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1253.1.text#πώλει βαδίζων αὐτὰ τοῖς Αἰγυπτίοις·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1254.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1254.1.text#ἔστιν γὰρ ἐπιτήδεια συρμαίαν μετρεῖν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1255.1.speaker#Δορυξός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1255.1.text#οἴμ' ὦ κρανοποί' ὡς ἀθλίως πεπράγαμεν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1256.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1256.1.text#οὗτος μὲν οὐ πέπονθεν οὐδέν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1256.2.speaker#Δορυξός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1256.2.text#ἀλλὰ τί
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1257.1.speaker#Δορυξός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1257.1.text#ἔτ' ἐστὶ τοῖσι κράνεσιν ὅ τι τις χρήσεται;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1258.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1258.1.text#ἐὰν τοιαυτασὶ μάθῃ λαβὰς ποιεῖν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1259.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1259.1.text#ἄμεινον ἢ νῦν αὔτ' ἀποδώσεται πολύ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1260.1.speaker#Κρανοποιός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1260.1.text#ἀπίωμεν ὦ δορυξέ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1260.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1260.2.text#μηδαμῶς γ', ἐπεὶ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1261.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1261.1.text#τούτῳ γ' ἐγὼ τὰ δόρατα ταῦτ' ὠνήσομαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1262.1.speaker#Δορυξός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1262.1.text#πόσον δίδως δῆτ';
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1262.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1262.2.text#εἰ διαπρισθεῖεν δίχα,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1263.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1263.1.text#λάβοιμ' ἂν αὔτ' ἐς χάρακας ἑκατὸν τῆς δραχμῆς.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1264.1.speaker#Δορυξός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1264.1.text#ὑβριζόμεθα. χωρῶμεν ὦ τᾶν ἐκποδών.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1265.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1265.1.text#νὴ τὸν Δί', ὡς τὰ παιδί' ἤδη 'ξέρχεται
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1266.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1266.1.text#οὐρησόμενα τὰ τῶν ἐπικλήτων δεῦρ', ἵνα
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1267.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1267.1.text#ἅττ' ᾄσεται προαναβάληταί μοι δοκεῖ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1268.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1268.1.text#ἀλλ' ὅ τι περ ᾄδειν ἐπινοεῖς ὦ παιδίον,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1269.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1269.1.text#αὐτοῦ παρ' ἐμὲ στὰν πρότερον ἀναβαλοῦ 'νθαδί.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1270.1.speaker#Παῖς Λαμάχου 
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1270.1.text#νῦν αὖθ' ὁπλοτέρων ἀνδρῶν ἀρχώμεθα—
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1270.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1270.2.text#παῦσαι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1271.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1271.1.text#ὁπλοτέρους ᾆδον, καὶ ταῦτ ὦ τρισκακόδαιμον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1272.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1272.1.text#εἰρήνης οὔσης· ἀμαθές γ' εἶ καὶ κατάρατον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1273.1.speaker#Παῖς Λαμάχου 
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1273.1.text#οἱ δ' ὅτε δὴ σχεδὸν ἦσαν ἐπ' ἀλλήλοισιν ἰόντες,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1274.1.speaker#Παῖς Λαμάχου 
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1274.1.text#σύν ῥ' ἔβαλον ῥινούς τε καὶ ἀσπίδας ὀμφαλοέσσας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1275.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1275.1.text#ἀσπίδας; οὐ παύσει μεμνημένος ἀσπίδος ἡμῖν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1276.1.speaker#Παῖς Λαμάχου 
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1276.1.text#ἔνθα δ' ἅμ' οἰμωγή τε καὶ εὐχωλὴ πέλεν ἀνδρῶν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1277.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1277.1.text#ἀνδρῶν οἰμωγή; κλαύσει νὴ τὸν Διόνυσον
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1278.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1278.1.text#οἰμωγὰς ᾄδων, καὶ ταύτας ὀμφαλοέσσας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1279.1.speaker#Παῖς Λαμάχου 
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1279.1.text#ἀλλὰ τί δῆτ' ᾄδω; σὺ γὰρ εἰπέ μοι οἷστισι χαίρεις.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1280.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1280.1.text#ὣς οἱ μὲν δαίνυντο βοῶν κρέα, καὶ τὰ τοιαυτί·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1281.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1281.1.text#ἄριστον προτίθεντο καὶ ἅτθ' ἥδιστα πάσασθαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1282.1.speaker#Παῖς Λαμάχου 
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1282.1.text#ὣς οἱ μὲν δαίνυντο βοῶν κρέα, καὐχένας ἵππων
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1283.1.speaker#Παῖς Λαμάχου 
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1283.1.text#ἔκλυον ἱδρώοντας, ἐπεὶ πολέμου ἐκόρεσθεν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1284.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1284.1.text#εἶεν; ἐκόρεσθεν τοῦ πολέμου κᾆτ' ἤσθιον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1285.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1285.1.text#ταῦτ' ᾆδε, ταῦθ', ὡς ἤσθιον κεκορημένοι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1286.1.speaker#Παῖς Λαμάχου 
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1286.1.text#θωρήσσοντ' ἄρ' ὄτειτα πεπαυμένοι—
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1286.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1286.2.text#ἄσμενοι, οἶμαι.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1287.1.speaker#Παῖς Λαμάχου 
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1287.1.text#πύργων δ' ἐξεχέοντο, βοὴ δ' ἄσβεστος ὀρώρει.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1288.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1288.1.text#κάκιστ' ἀπόλοιο παιδάριον αὐταῖς μάχαις·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1289.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1289.1.text#οὐδὲν γὰρ ᾄδεις πλὴν πολέμους. τοῦ καί ποτ' εἶ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1290.1.speaker#Παῖς Λαμάχου 
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1290.1.text#ἐγώ;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1290.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1290.2.text#σὺ μέντοι νὴ Δί'.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1290.3.speaker#Παῖς Λαμάχου 
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1290.3.text#υἱὸς Λαμάχου.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1291.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1291.1.text#αἰβοῖ·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1292.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1292.1.text#ἦ γὰρ ἐγὼ θαύμαζον ἀκούων, εἰ σὺ μὴ εἴης
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1293.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1293.1.text#ἀνδρὸς βουλομάχου καὶ κλαυσιμάχου τινὸς υἱός.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1294.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1294.1.text#ἄπερρε καὶ τοῖς λογχοφόροισιν ᾆδ' ἰών.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1295.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1295.1.text#ποῦ μοι τὸ τοῦ Κλεωνύμου 'στὶ παιδίον;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1296.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1296.1.text#ᾆσον πρὶν εἰσιέναι τι· σὺ γὰρ εὖ οἶδ' ὅτι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1297.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1297.1.text#οὐ πράγματ' ᾄσει· σώφρονος γὰρ εἶ πατρός.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1298.1.speaker#Παῖς Κλεωνύμου 
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1298.1.text#ἀσπίδι μὲν Σαΐων τις ἀγάλλεται, ἣν παρὰ θάμνῳ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1299.1.speaker#Παῖς Κλεωνύμου 
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1299.1.text#ἔντος ἀμώμητον κάλλιπον οὐκ ἐθέλων.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1300.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1300.1.text#εἰπέ μοι ὦ πόσθων, ἐς τὸν σαυτοῦ πατέρ' ᾄδεις;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1301.1.speaker#Παῖς Κλεωνύμου 
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1301.1.text#ψυχὴν δ' ἐξεσάωσα—
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1301.2.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1301.2.text#κατῄσχυνας δὲ τοκῆας.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1302.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1302.1.text#ἀλλ' εἰσίωμεν. εὖ γὰρ οἶδ' ἐγὼ σαφῶς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1303.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1303.1.text#ὅτι ταῦθ' ὅσ' ᾖσας ἄρτι περὶ τῆς ἀσπίδος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1304.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1304.1.text#οὐ μὴ 'πιλάθῃ ποτ' ὢν ἐκείνου τοῦ πατρός.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1305.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1305.1.text#ὑμῶν τὸ λοιπὸν ἔργον ἤδη 'νταῦθα τῶν μενόντων
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1306.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1306.1.text#φλᾶν ταῦτα πάντα καὶ σποδεῖν, καὶ μὴ κενὰς παρέλκειν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1307.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1307.1.text#ἀλλ' ἀνδρικῶς ἐμβάλλετε
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1308.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1308.1.text#καὶ σμώχετ' ἀμφοῖν τοῖν γνάθοιν· οὐδὲν γὰρ ὦ πόνηροι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1310.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1310.1.text#λευκῶν ὀδόντων ἔργον ἐστ', ἢν μή τι καὶ μασῶνται.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1311.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1311.1.text#ἡμῖν μελήσει ταῦτά γ'· εὖ ποιεῖς δὲ καὶ σὺ φράζων.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1312.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1312.1.text#ἀλλ' ὦ πρὸ τοῦ πεινῶντες ἐμβάλλεσθε τῶν λαγῴων·
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1313.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1313.1.text#ὡς οὐχὶ πᾶσαν ἡμέραν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1314.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1314.1.text#πλακοῦσιν ἔστιν ἐντυχεῖν πλανωμένοις ἐρήμοις.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1315.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1315.1.text#πρὸς ταῦτα βρύκετ' ἢ τάχ' ἡμῖν φημι μεταμελήσειν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1316.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1316.1.text#εὐφημεῖν χρὴ καὶ τὴν νύμφην ἔξω τινὰ δεῦρο κομίζειν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1317.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1317.1.text#δᾷδάς τε φέρειν, καὶ πάντα λεὼν συγχαίρειν κἀπιχορεύειν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1318.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1318.1.text#καὶ τὰ σκεύη πάλιν ἐς τὸν ἀγρὸν νυνὶ χρὴ πάντα κομίζειν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1319.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1319.1.text#ὀρχησαμένους καὶ σπείσαντας καὶ Ὑπέρβολον ἐξελάσαντας,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1320.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1320.1.text#κἀπευξαμένους τοῖσι θεοῖσιν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1321.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1321.1.text#διδόναι πλοῦτον τοῖς Ἕλλησιν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1322.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1322.1.text#κριθάς τε ποιεῖν ἡμᾶς πολλὰς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1323.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1323.1.text#πάντας ὁμοίως οἶνόν τε πολύν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1324.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1324.1.text#σῦκά τε τρώγειν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1325.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1325.1.text#τάς τε γυναῖκας τίκτειν ἡμῖν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1326.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1326.1.text#καὶ τἀγαθὰ πάνθ' ὅσ' ἀπωλέσαμεν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1327.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1327.1.text#συλλέξασθαι πάλιν ἐξ ἀρχῆς,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1328.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1328.1.text#λῆξαί τ' αἴθωνα σίδηρον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1329.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1329.1.text#δεῦρ' ὦ γύναι εἰς ἀγρόν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1330.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1330.1.text#χὤπως μετ' ἐμοῦ καλὴ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1331.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1331.1.text#καλῶς κατακείσει.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1332.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1332.1.text#Ὑμὴν Ὑμέναι' ὦ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1333.1.speaker#Ἡμιχόριον Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1333.1.text#ὦ τρὶς μάκαρ ὡς δικαίως
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1334.1.speaker#Ἡμιχόριον Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1334.1.text#τἀγαθὰ νῦν ἔχεις.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1335.1.speaker#Ἡμιχόριον Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1335.1.text#Ὑμὴν Ὑμέναι' ὦ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1335.2.speaker#Ἡμιχόριον Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1335.2.text#Ὑμὴν Ὑμέναι' ὦ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1336.1.speaker#Ἡμιχόριον Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1336.1.text#τί δράσομεν αὐτήν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1337.1.speaker#Ἡμιχόριον Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1337.1.text#τί δράσομεν αὐτήν;
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1338.1.speaker#Ἡμιχόριον Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1338.1.text#τρυγήσομεν αὐτήν,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1339.1.speaker#Ἡμιχόριον Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1339.1.text#τρυγήσομεν αὐτήν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1340.1.speaker#Ἡμιχόριον Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1340.1.text#ἀλλ' ἀράμενοι φέρωμεν
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1340.2.speaker#Ἡμιχόριον Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1340.2.text#οἱ προτεταγμένοι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1341.1.speaker#Ἡμιχόριον Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1341.1.text#τὸν νυμφίον ὦνδρες.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1342.1.speaker#Ἡμιχόριον Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1342.1.text#Ὑμὴν Ὑμέναι' ὦ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1343.1.speaker#Ἡμιχόριον Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1343.1.text#Ὑμὴν Ὑμέναι' ὦ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1344.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1344.1.text#οἰκήσετε γοῦν καλῶς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1345.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1345.1.text#οὐ πράγματ' ἔχοντες, ἀλλὰ
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1346.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1346.1.text#συκολογοῦντες.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1347.1.speaker#Ἡμιχόριον Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1347.1.text#Ὑμὴν Ὑμέναι' ὦ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1348.1.speaker#Ἡμιχόριον Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1348.1.text#Ὑμὴν Ὑμέναι' ὦ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1349.1.speaker#Ἡμιχόριον Β
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1349.1.text#τοῦ μὲν μέγα καὶ παχύ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1350.1.speaker#Ἡμιχόριον Α
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1350.1.text#τῆς δ' ἡδὺ τὸ σῦκον.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1351.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1351.1.text#φήσεις γ' ὅταν ἐσθίῃς
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1352.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1352.1.text#οἶνόν τε πίῃς πολύν.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1353.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1353.1.text#Ὑμὴν Ὑμέναι' ὦ,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1354.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1354.1.text#Ὑμὴν Ὑμέναι' ὦ.
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1355.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1355.1.text#ὦ χαίρετε χαίρετ' ἄνδρες,
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1356.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1356.1.text#κἂν ξυνέπησθέ μοι
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1357.1.speaker#Τρυγαῖος
urn:cts:greekLit:tlg0019.tlg005.fu.sp:1357.1.text#πλακοῦντας ἔδεσθε.
