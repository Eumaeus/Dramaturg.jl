#!ctsdata
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1.1.text#ὀρθὴν κελεύεις, ᾗ τὸ δένδρον φαίνεται;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:2.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:2.1.text#διαρραγείης· ἥδε δ' αὖ κρώζει πάλιν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:3.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:3.1.text#τί ὦ πόνηρ' ἄνω κάτω πλανύττομεν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:4.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:4.1.text#ἀπολούμεθ' ἄλλως τὴν ὁδὸν προφορουμένω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:5.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:5.1.text#τὸ δ' ἐμὲ κορώνῃ πειθόμενον τὸν ἄθλιον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:6.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:6.1.text#ὁδοῦ περιελθεῖν στάδια πλεῖν ἢ χίλια.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:7.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:7.1.text#τὸ δ' ἐμὲ κολοιῷ πειθόμενον τὸν δύσμορον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:8.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:8.1.text#ἀποσποδῆσαι τοὺς ὄνυχας τῶν δακτύλων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:9.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:9.1.text#ἀλλ' οὐδ' ὅπου γῆς ἐσμὲν οἶδ' ἔγωγ' ἔτι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:10.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:10.1.text#ἐντευθενὶ τὴν πατρίδ' ἂν ἐξεύροις σύ που;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:11.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:11.1.text#οὐδ' ἂν μὰ Δία γ' ἐντεῦθεν Ἐξηκεστίδης.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:12.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:12.1.text#οἴμοι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:12.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:12.2.text#σὺ μὲν ὦ τᾶν τὴν ὁδὸν ταύτην ἴθι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:13.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:13.1.text#ἦ δεινὰ νὼ δέδρακεν οὑκ τῶν ὀρνέων,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:14.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:14.1.text#ὁ πινακοπώλης φιλοκράτης μελαγχολῶν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:15.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:15.1.text#ὃς τώδ' ἔφασκε νῷν φράσειν τὸν Τηρέα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:16.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:16.1.text#τὸν ἔποφ' ὃς ὄρνις ἐγένετ' ἐκ τῶν ὀρνέων·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:17.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:17.1.text#κἀπέδοτο τὸν μὲν Θαρρελείδου τουτονὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:18.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:18.1.text#κολοιὸν ὀβολοῦ, τηνδεδὶ τριωβόλου.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:19.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:19.1.text#τὼ δ' οὐκ ἄρ' ᾔστην οὐδὲν ἄλλο πλὴν δάκνειν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:20.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:20.1.text#καὶ νῦν τί κέχηνας; ἔσθ' ὅποι κατὰ τῶν πετρῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:21.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:21.1.text#ἡμᾶς ἔτ' ἔξεις. οὐ γάρ ἐστ' ἐνταῦθά τις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:22.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:22.1.text#ὁδός.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:22.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:22.2.text#οὐδὲ μὰ Δί' ἐνταῦθά γ' ἀτραπὸς οὐδαμοῦ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:23.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:23.1.text#οὐδ' ἡ κορώνη τῆς ὁδοῦ τι λέγει πέρι;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:24.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:24.1.text#οὐ ταὐτὰ κρώζει μὰ Δία νῦν τε καὶ τότε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:25.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:25.1.text#τί δὴ λέγει περὶ τῆς ὁδοῦ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:25.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:25.2.text#τί δ' ἄλλο γ' ἢ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:26.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:26.1.text#βρύκουσ' ἀπέδεσθαί φησί μου τοὺς δακτύλους;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:27.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:27.1.text#οὐ δεινὸν οὖν δῆτ' ἐστὶν ἡμᾶς δεομένους
urn:cts:greekLit:tlg0019.tlg006.fu-sp:28.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:28.1.text#ἐς κόρακας ἐλθεῖν καὶ παρεσκευασμένους
urn:cts:greekLit:tlg0019.tlg006.fu-sp:29.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:29.1.text#ἔπειτα μὴ 'ξευρεῖν δύνασθαι τὴν ὁδόν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:30.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:30.1.text#ἡμεῖς γάρ, ὦνδρες οἱ παρόντες ἐν λόγῳ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:31.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:31.1.text#νόσον νοσοῦμεν τὴν ἐναντίαν Σάκᾳ·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:32.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:32.1.text#ὁ μὲν γὰρ ὢν οὐκ ἀστὸς ἐσβιάζεται,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:33.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:33.1.text#ἡμεῖς δὲ φυλῇ καὶ γένει τιμώμενοι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:34.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:34.1.text#ἀστοὶ μετ' ἀστῶν, οὐ σοβοῦντος οὐδενὸς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:35.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:35.1.text#ἀνεπτόμεσθ' ἐκ τῆς πατρίδος ἀμφοῖν ποδοῖν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:36.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:36.1.text#αὐτὴν μὲν οὐ μισοῦντ' ἐκείνην τὴν πόλιν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:37.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:37.1.text#τὸ μὴ οὐ μεγάλην εἶναι φύσει κεὐδαίμονα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:38.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:38.1.text#καὶ πᾶσι κοινὴν ἐναποτεῖσαι χρήματα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:39.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:39.1.text#οἱ μὲν γὰρ οὖν τέττιγες ἕνα μῆν' ἢ δύο
urn:cts:greekLit:tlg0019.tlg006.fu-sp:40.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:40.1.text#ἐπὶ τῶν κραδῶν ᾄδουσ', Ἀθηναῖοι δ' ἀεὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:41.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:41.1.text#ἐπὶ τῶν δικῶν ᾄδουσι πάντα τὸν βίον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:42.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:42.1.text#διὰ ταῦτα τόνδε τὸν βάδον βαδίζομεν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:43.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:43.1.text#κανοῦν δ' ἔχοντε καὶ χύτραν καὶ μυρρίνας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:44.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:44.1.text#πλανώμεθα ζητοῦντε τόπον ἀπράγμονα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:45.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:45.1.text#ὅποι καθιδρυθέντε διαγενοίμεθ' ἄν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:46.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:46.1.text#ὁ δὲ στόλος νῷν ἐστι παρὰ τὸν Τηρέα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:47.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:47.1.text#τὸν ἔποπα, παρ' ἐκείνου πυθέσθαι δεομἐνω,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:48.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:48.1.text#εἴ που τοιαύτην εἶδε πόλιν ᾗ 'πέπτετο.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:49.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:49.1.text#οὗτος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:49.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:49.2.text#τί ἔστιν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:49.3.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:49.3.text#ἡ κορώνη μοι πάλαι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:50.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:50.1.text#ἄνω τι φράζει.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:50.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:50.2.text#χὠ κολοιὸς οὑτοσὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:51.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:51.1.text#ἄνω κέχηνεν ὡσπερεὶ δεικνύς τί μοι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:52.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:52.1.text#κοὐκ ἔσθ' ὅπως οὐκ ἔστιν ἐνταῦθ' ὄρνεα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:53.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:53.1.text#εἰσόμεθα δ' αὐτίκ', ἢν ποιήσωμεν ψόφον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:54.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:54.1.text#ἀλλ' οἶσθ' ὃ δρᾶσον; τῷ σκέλει θένε τὴν πέτραν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:55.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:55.1.text#σὺ δὲ τῇ κεφαλῇ γ', ἵν' ᾖ διπλάσιος ὁ ψόφος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:56.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:56.1.text#σὺ δ' οὖν λίθῳ κόψον λαβών.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:56.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:56.2.text#πάνυ γ', εἰ δοκεῖ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:57.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:57.1.text#παῖ παῖ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:57.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:57.2.text#τί λέγεις οὗτος; τὸν ἔποπα παῖ καλεῖς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:58.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:58.1.text#οὐκ ἀντὶ τοῦ παιδός σ' ἐχρῆν ἐποποῖ καλεῖν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:59.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:59.1.text#ἐποποῖ. ποιήσεις ἔτι με κόπτειν αὖθις αὖ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:60.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:60.1.text#ἐποποῖ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:60.2.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:60.2.text#τίνες οὗτοι; τίς ὁ βοῶν τὸν δεσπότην;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:61.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:61.1.text#Ἄπολλον ἀποτρόπαιε τοῦ χασμήματος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:62.1.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:62.1.text#οἴμοι τάλας ὀρνιθοθήρα τουτωί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:63.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:63.1.text#οὕτως τι δεινὸν οὐδὲ κάλλιον λέγειν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:64.1.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:64.1.text#ἀπολεῖσθον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:64.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:64.2.text#ἀλλ' οὐκ ἐσμὲν ἀνθρώπω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:64.3.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:64.3.text#τί δαί;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:65.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:65.1.text#Ὑποδεδιὼς ἔγωγε Λιβυκὸν ὄρνεον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:66.1.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:66.1.text#οὐδὲν λέγεις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:66.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:66.2.text#καὶ μὴν ἐροῦ τὰ πρὸς ποδῶν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:67.1.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:67.1.text#ὁδὶ δὲ δὴ τίς ἐστιν ὄρνις; οὐκ ἐρεῖς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:68.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:68.1.text#Ἐπικεχοδὼς ἔγωγε Φασιανικός.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:69.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:69.1.text#ἀτὰρ σὺ τί θηρίον ποτ' εἶ πρὸς τῶν θεῶν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:70.1.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:70.1.text#ὄρνις ἔγωγε δοῦλος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:70.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:70.2.text#ἡττήθης τινὸς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:71.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:71.1.text#ἀλεκτρυόνος;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:71.2.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:71.2.text#οὐκ ἀλλ' ὅτε περ ὁ δεσπότης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:72.1.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:72.1.text#ἔποψ ἐγένετο, τότε γενέσθαι μ' ηὔξατο
urn:cts:greekLit:tlg0019.tlg006.fu-sp:73.1.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:73.1.text#ὄρνιν, ἵν' ἀκόλουθον διάκονόν τ' ἔχῃ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:74.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:74.1.text#δεῖται γὰρ ὄρνις καὶ διακόνου τινός;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:75.1.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:75.1.text#οὗτός γ', ἅτ' οἶμαι πρότερον ἄνθρωπός ποτ' ὤν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:76.1.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:76.1.text#τοτὲ μὲν ἐρᾷ φαγεῖν ἀφύας Φαληρικάς·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:77.1.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:77.1.text#τρέχω 'π' ἀφύας λαβὼν ἐγὼ τὸ τρύβλιον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:78.1.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:78.1.text#ἔτνους δ' ἐπιθυμεῖ, δεῖ τορύνης καὶ χύτρας·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:79.1.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:79.1.text#τρέχω 'πὶ τορύνην.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:79.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:79.2.text#τροχίλος ὄρνις οὑτοσί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:80.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:80.1.text#οἶσθ' οὖν ὃ δρᾶσον ὦ τροχίλε; τὸν δεσπότην
urn:cts:greekLit:tlg0019.tlg006.fu-sp:81.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:81.1.text#ἡμῖν κάλεσον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:81.2.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:81.2.text#ἀλλ' ἀρτίως νὴ τὸν Δία
urn:cts:greekLit:tlg0019.tlg006.fu-sp:82.1.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:82.1.text#εὕδει καταφαγὼν μύρτα καὶ σέρφους τινάς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:83.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:83.1.text#ὅμως ἐπέγειρον αὐτόν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:83.2.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:83.2.text#οἶδα μὲν σαφῶς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:84.1.speaker#Θεράπων Ἔποπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:84.1.text#ὅτι ἀχθέσεται, σφῷν δ' αὐτὸν οὕνεκ' ἐπεγερῶ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:85.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:85.1.text#κακῶς σύ γ' ἀπόλοι', ὥς μ' ἀπέκτεινας δέει.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:86.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:86.1.text#οἴμοι κακοδαίμων χὠ κολοιός μοἴχεται
urn:cts:greekLit:tlg0019.tlg006.fu-sp:87.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:87.1.text#ὑπὸ τοῦ δέους.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:87.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:87.2.text#ὦ δειλότατον σὺ θηρίον,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:88.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:88.1.text#δείσας ἀφῆκας τὸν κολοιόν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:88.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:88.2.text#εἰπέ μοι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:89.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:89.1.text#σὺ δὲ τὴν κορώνην οὐκ ἀφῆκας καταπεσών;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:90.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:90.1.text#μὰ Δί' οὐκ ἔγωγε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:90.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:90.2.text#ποῦ γάρ ἐστ';
urn:cts:greekLit:tlg0019.tlg006.fu-sp:90.3.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:90.3.text#ἀπέπτετο.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:91.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:91.1.text#οὐκ ἆρ' ἀφῆκας; ὦγάθ' ὡς ἀνδρεῖος εἶ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:92.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:92.1.text#ἄνοιγε τὴν ὕλην, ἵν' ἐξέλθω ποτέ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:93.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:93.1.text#ὦ Ἡράκλεις τουτὶ τί ποτ' ἐστὶ τὸ θηρίον;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:94.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:94.1.text#τίς ἡ πτέρωσις; τίς ὁ τρόπος τῆς τριλοφίας;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:95.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:95.1.text#τίνες εἰσί μ' οἱ ζητοῦντες;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:95.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:95.2.text#οἱ δώδεκα θεοὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:96.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:96.1.text#εἴξασιν ἐπιτρῖψαί σε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:96.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:96.2.text#μῶν με σκώπτετον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:97.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:97.1.text#ὁρῶντε τὴν πτέρωσιν; ἦν γὰρ ὦ ξένοι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:98.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:98.1.text#ἄνθρωπος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:98.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:98.2.text#οὐ σοῦ καταγελῶμεν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:98.3.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:98.3.text#ἀλλὰ τοῦ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:99.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:99.1.text#τὸ ῥάμφος ἡμῖν σου γέλοιον φαίνεται.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:100.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:100.1.text#τοιαῦτα μέντοι Σοφοκλέης λυμαίνεται
urn:cts:greekLit:tlg0019.tlg006.fu-sp:101.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:101.1.text#ἐν ταῖς τραγῳδίαισιν ἐμὲ τὸν Τηρέα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:102.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:102.1.text#Τηρεὺς γὰρ εἶ σύ; πότερον ὄρνις ἢ ταὧς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:103.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:103.1.text#ὄρνις ἔγωγε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:103.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:103.2.text#κᾆτά σοι ποῦ τὰ πτερά;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:104.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:104.1.text#ἐξερρύηκε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:104.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:104.2.text#πότερον ὑπὸ νόσου τινός;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:105.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:105.1.text#οὔκ, ἀλλὰ τὸν χειμῶνα πάντα τὤρνεα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:106.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:106.1.text#πτερορρυεῖ τε καὖθις ἕτερα φύομεν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:107.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:107.1.text#ἀλλ' εἴπατόν μοι σφὼ τίν' ἐστόν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:107.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:107.2.text#νώ; βροτώ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:108.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:108.1.text#ποδαπὼ τὸ γένος;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:108.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:108.2.text#ὅθεν αἱ τριήρεις αἱ καλαί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:109.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:109.1.text#μῶν ἡλιαστά;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:109.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:109.2.text#μἀλλὰ θατέρου τρόπου,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:110.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:110.1.text#ἀπηλιαστά.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:110.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:110.2.text#σπείρεται γὰρ τοῦτ' ἐκεῖ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:111.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:111.1.text#τὸ σπέρμ';
urn:cts:greekLit:tlg0019.tlg006.fu-sp:111.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:111.2.text#ὀλίγον ζητῶν ἂν ἐξ ἀγροῦ λάβοις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:112.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:112.1.text#πράγους δὲ δὴ τοῦ δεομένω δεῦρ' ἤλθετον;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:113.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:113.1.text#σοὶ ξυγγενέσθαι βουλομένω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:114.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:114.1.text#τίνος πέρι;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:114.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:114.2.text#ὅτι πρῶτα μὲν ἦσθ' ἄνθρωπος ὥσπερ νὼ ποτέ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:115.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:115.1.text#κἀργύριον ὠφείλησας ὥσπερ νὼ ποτέ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:116.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:116.1.text#κοὐκ ἀποδιδοὺς ἔχαιρες ὥσπερ νὼ ποτέ·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:117.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:117.1.text#εἶτ' αὖθις ὀρνίθων μεταλλάξας φύσιν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:118.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:118.1.text#καὶ γῆν ἐπέπτου καὶ θάλατταν ἐν κύκλῳ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:119.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:119.1.text#καὶ πάνθ' ὅσαπερ ἄνθρωπος ὅσα τ' ὄρνις φρονεῖς·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:120.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:120.1.text#ταῦτ οὖν ἱκέται νὼ πρὸς σὲ δεῦρ' ἀφίγμεθα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:121.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:121.1.text#εἴ τινα πόλιν φράσειας ἡμῖν εὔερον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:122.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:122.1.text#ὥσπερ σισύραν ἐγκατακλινῆναι μαλθακήν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:123.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:123.1.text#ἔμειτα μείζω τῶν Κραναῶν ζητεῖς πόλιν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:124.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:124.1.text#μείζω μὲν οὐδέν, προσφορωτέραν δὲ νῷν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:125.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:125.1.text#ἀριστοκρατεῖσθαι δῆλος εἶ ζητῶν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:125.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:125.2.text#ἐγώ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:126.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:126.1.text#ἥκιστα· καὶ γὰρ τὸν Σκελίου βδελύττομαι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:127.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:127.1.text#ποίαν τιν' οὖν ἥδιστ' ἂν οἰκοῖτ' ἂν πόλιν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:128.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:128.1.text#ὅπου τὰ μέγιστα πράγματ' εἴη τοιάδε·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:129.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:129.1.text#ἐπὶ τὴν θύραν μου πρῴ τις ἐλθὼν τῶν φίλων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:130.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:130.1.text#λέγοι ταδί· "πρὸς τοῦ Διὸς τοὐλυμπίου"
urn:cts:greekLit:tlg0019.tlg006.fu-sp:131.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:131.1.text#"ὅπως παρέσει μοι καὶ σὺ καὶ τὰ παιδία"
urn:cts:greekLit:tlg0019.tlg006.fu-sp:132.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:132.1.text#"λουσάμενα πρῴ· μέλλω γὰρ ἑστιᾶν γάμους·"
urn:cts:greekLit:tlg0019.tlg006.fu-sp:133.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:133.1.text#"καὶ μηδαμῶς ἄλλως ποιήσῃς· εἰ δὲ μή,"
urn:cts:greekLit:tlg0019.tlg006.fu-sp:134.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:134.1.text#"μή μοι τότε γ' ἔλθῃς, ὅταν ἐγὼ πράττω κακῶς".
urn:cts:greekLit:tlg0019.tlg006.fu-sp:135.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:135.1.text#νὴ Δία ταλαιπώρων γε πραγμάτων ἐρᾷς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:136.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:136.1.text#τί δαὶ σύ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:136.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:136.2.text#τοιούτων ἐρῶ κἀγώ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:136.3.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:136.3.text#τίνων;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:137.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:137.1.text#ὅπου ξυναντῶν μοι ταδί τις μέμψεται
urn:cts:greekLit:tlg0019.tlg006.fu-sp:138.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:138.1.text#ὥσπερ ἀδικηθεὶς παιδὸς ὡραίου πατήρ·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:139.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:139.1.text#"καλῶς γέ μου τὸν υἱὸν ὦ Στιλβωνίδη"
urn:cts:greekLit:tlg0019.tlg006.fu-sp:140.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:140.1.text#"εὑρὼν ἀπιόντ' ἀπὸ γυμνασίου λελουμένον"
urn:cts:greekLit:tlg0019.tlg006.fu-sp:141.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:141.1.text#"οὐκ ἔκυσας, οὐ προσεῖπας, οὐ προσηγάγου,"
urn:cts:greekLit:tlg0019.tlg006.fu-sp:142.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:142.1.text#"οὐκ ὠρχιπέδισας, ὢν ἐμοὶ πατρικὸς φίλος."
urn:cts:greekLit:tlg0019.tlg006.fu-sp:143.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:143.1.text#ὦ δειλακρίων σὺ τῶν κακῶν οἵων ἐρᾷς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:144.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:144.1.text#ἀτὰρ ἔστι γ' ὁποίαν λέγετον εὐδαίμων πόλις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:145.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:145.1.text#παρὰ τὴν ἐρυθρὰν θάλατταν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:145.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:145.2.text#οἴμοι μηδαμῶς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:146.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:146.1.text#ἡμῖν παρὰ τὴν θάλατταν, ἵν' ἀνακύψεται
urn:cts:greekLit:tlg0019.tlg006.fu-sp:147.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:147.1.text#κλητῆρ' ἄγουσ' ἕωθεν ἡ Σαλαμινία.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:148.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:148.1.text#Ἑλληνικὴν δὲ πόλιν ἔχεις ἡμῖν φράσαι;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:149.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:149.1.text#τί οὐ τὸν Ἠλεῖον Λέπρεον οἰκίζετον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:150.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:150.1.text#ἐλθόνθ';
urn:cts:greekLit:tlg0019.tlg006.fu-sp:150.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:150.2.text#ὁτιὴ νὴ τοὺς θεοὺς ὅσ' οὐκ ἰδὼν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:151.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:151.1.text#βδελύττομαι τὸν Λέπρεον ἀπὸ Μελανθίου.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:152.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:152.1.text#ἀλλ' εἰσὶν ἕτεροι τῆς Λοκρίδος Ὀπούντιοι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:153.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:153.1.text#ἵνα χρὴ κατοικεῖν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:153.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:153.2.text#ἀλλ' ἔγωγ' Ὀπούντιος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:154.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:154.1.text#οὐκ ἂν γενοίμην ἐπὶ ταλάντῳ χρυσίου.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:155.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:155.1.text#οὗτος δὲ δὴ τίς ἔσθ' ὁ μετ' ὀρνίθων βίος;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:156.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:156.1.text#σὺ γὰρ οἶσθ' ἀκριβῶς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:156.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:156.2.text#οὐκ ἄχαρις ἐς τὴν τριβήν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:157.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:157.1.text#οὗ πρῶτα μὲν δεῖ ζῆν ἄνευ βαλλαντίου.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:158.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:158.1.text#πολλήν γ' ἀφεῖλες τοῦ βίου κιβδηλίαν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:159.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:159.1.text#νεμόμεσθα δ' ἐν κήποις τὰ λευκὰ σήσαμα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:160.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:160.1.text#καὶ μύρτα καὶ μήκωνα καὶ σισύμβρια.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:161.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:161.1.text#ὑμεῖς μὲν ἆρα ζῆτε νυμφίων βίον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:161.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:161.2.text#φεῦ φεῦ·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:162a.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:162a.1.text#ἦ μέγ' ἐνορῶ βούλευμ' ἐν ὀρνίθων γένει,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:163.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:163.1.text#καὶ δύναμιν ἣ γένοιτ' ἄν, εἰ πίθοισθέ μοι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:164.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:164.1.text#τί σοι πιθώμεσθ';
urn:cts:greekLit:tlg0019.tlg006.fu-sp:164.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:164.2.text#ὅ τι πίθησθε; πρῶτα μὲν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:165.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:165.1.text#μὴ περιπέτεσθε πανταχῇ κεχηνότες·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:166.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:166.1.text#ὡς τοῦτ' ἄτιμον τοὔργον ἐστίν. αὐτίκα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:167.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:167.1.text#ἐκεῖ παρ' ἡμῖν τοὺς πετομένους ἢν ἔρῃ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:168.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:168.1.text# "τίς ὄρνις οὗτος;" ὁ Τελέας ἐρεῖ ταδί·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:169.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:169.1.text#"ἅνθρωπος ὄρνις ἀστάθμητος πετόμενος,"
urn:cts:greekLit:tlg0019.tlg006.fu-sp:170.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:170.1.text#"ἀτέκμαρτος, οὐδὲν οὐδέποτ' ἐν ταὐτῷ μένων."
urn:cts:greekLit:tlg0019.tlg006.fu-sp:171.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:171.1.text#νὴ τὸν Διόνυσον εὖ γε μωμᾷ ταυταγί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:172.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:172.1.text#τί ἂν οὖν ποιοῖμεν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:172.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:172.2.text#οἰκίσατε μίαν πόλιν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:173.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:173.1.text#ποίαν δ' ἂν οἰκίσαιμεν ὄρνιθες πόλιν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:174.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:174.1.text#ἄληθες; ὦ σκαιότατον εἰρηκὼς ἔπος,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:175.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:175.1.text#βλέψον κάτω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:175.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:175.2.text#καὶ δὴ βλέπω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:175.3.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:175.3.text#βλέπε νῦν ἄνω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:176.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:176.1.text#βλέπω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:176.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:176.2.text#περίαγε τὸν τράχηλον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:176.3.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:176.3.text#νὴ Δία
urn:cts:greekLit:tlg0019.tlg006.fu-sp:177.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:177.1.text#ἀπολαύσομαί τί γ', εἰ διαστραφήσομαι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:178.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:178.1.text#εἶδές τι;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:178.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:178.2.text#τὰς νεφέλας γε καὶ τὸν οὐρανόν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:179.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:179.1.text#οὐχ οὗτος οὖν δήπου 'στὶν ὀρνίθων πόλος;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:180.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:180.1.text#πόλος; τίνα τρόπον;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:180.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:180.2.text#ὥσπερ ἂν εἴποι τις τόπος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:181.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:181.1.text#ὅτι δὲ πολεῖται τοῦτο καὶ διέρχεται
urn:cts:greekLit:tlg0019.tlg006.fu-sp:182.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:182.1.text#ἅπαντα διὰ τούτου, καλεῖται νῦν πόλος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:183.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:183.1.text#ἢν δ' οἰκίσητε τοῦτο καὶ φάρξηθ' ἅπαξ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:184.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:184.1.text#ἐκ τοῦ πόλου τούτου κεκλήσεται πόλις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:185.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:185.1.text#ὥστ' ἄρξετ' ἀνθρώπων μὲν ὥσπερ παρνόπων,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:186.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:186.1.text#τοὺς δ' αὖ θεοὺς ἀπολεῖτε λιμῷ Μηλίῳ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:187.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:187.1.text#πῶς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:187.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:187.2.text#ἐν μέσῳ δήπουθεν ἀήρ ἐστι γῆς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:188.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:188.1.text#εἶθ' ὥσπερ ἡμεῖς, ἢν ἰέναι βουλώμεθα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:189.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:189.1.text#Πυθώδε, Βοιωτοὺς δίοδον αἰτούμεθα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:190.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:190.1.text#οὕτως, ὅταν θύσωσιν ἄνθρωποι θεοῖς,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:191.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:191.1.text#ἢν μὴ φόρον φέρωσιν οἱ ὑμῖν οἱ θεοί,
<l speaker="Πισθέταιρος" xml:base="urn:cts:greekLit:tlg0019.tlg006.fu-sp:" n="192.1">
urn:cts:greekLit:tlg0019.tlg006.fu-sp:193.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:193.1.text#τῶν μηρίων τὴν κνῖσαν οὐ διαφρήσετε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:194.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:194.1.text#ἰοὺ ἰού·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:194a.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:194a.1.text#μὰ γῆν μὰ παγίδας μὰ νεφέλας μὰ δίκτυα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:195.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:195.1.text#μὴ 'γὼ νόημα κομψότερον ἤκουσά πω·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:196.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:196.1.text#ὥστ' ἂν κατοικίζοιμι μετὰ σοῦ τὴν πόλιν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:197.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:197.1.text#εἰ ξυνδοκοίη τοῖσιν ἄλλοις ὀρνέοις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:198.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:198.1.text#τίς ἂν οὖν τὸ πρᾶγμ' αὐτοῖς διηγήσαιτο;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:198.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:198.2.text#σύ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:199.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:199.1.text#ἐγὼ γὰρ αὐτοὺς βαρβάρους ὄντας πρὸ τοῦ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:200.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:200.1.text#ἐδίδαξα τὴν φωνήν, ξυνὼν πολὺν χρόνον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:201.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:201.1.text#πῶς δῆτ' ἂν αὐτοὺς ξυγκαλέσειας;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:201.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:201.2.text#ῥᾳδίως.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:202.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:202.1.text#δευρὶ γὰρ ἐσβὰς αὐτίκα μάλ' ἐς τὴν λόχμην,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:203.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:203.1.text#ἔπειτ' ἀνεγείρας τὴν ἐμὴν ἀηδόνα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:204.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:204.1.text#καλοῦμεν αὐτούς· οἱ δὲ νῷν τοῦ φθέγματος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:205.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:205.1.text#ἐάνπερ ἐπακούσωσι θεύσονται δρόμῳ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:206.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:206.1.text#ὦ φίλτατ' ὀρνίθων σὺ μή νυν ἕσταθι·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:207.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:207.1.text#ἀλλ' ἀντιβολῶ σ' ἄγ' ὡς τάχιστ' ἐς τὴν λόχμην
urn:cts:greekLit:tlg0019.tlg006.fu-sp:208.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:208.1.text#ἔσβαινε κἀνέγειρε τὴν ἀηδόνα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:209.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:209.1.text#ἄγε σύννομέ μοι παῦσαι μὲν ὕπνου,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:210.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:210.1.text#λῦσον δὲ νόμους ἱερῶν ὕμνων,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:211.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:211.1.text#οὓς διὰ θείου στόματος θρηνεῖς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:212.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:212.1.text#τὸν ἐμὸν καὶ σὸν πολύδακρυν Ἴτυν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:213.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:213.1.text#ἐλελιζομένης δ' ἱεροῖς μέλεσιν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:214.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:214.1.text#γένυος ξουθῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:215.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:215.1.text#καθαρὰ χωρεῖ διὰ φυλλοκόμου
urn:cts:greekLit:tlg0019.tlg006.fu-sp:216.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:216.1.text#μίλακος ἠχὼ πρὸς Διὸς ἕδρας,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:217.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:217.1.text#ἵν' ὁ χρυσοκόμας Φοῖβος ἀκούων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:218.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:218.1.text#τοῖς σοῖς ἐλέγοις ἀντιψάλλων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:219.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:219.1.text#ἐλεφαντόδετον φόρμιγγα θεῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:220.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:220.1.text#ἵστησι χορούς· διὰ δ' ἀθανάτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:221.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:221.1.text#στομάτων χωρεῖ ξύμφωνος ὁμοῦ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:222.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:222.1.text#θεία μακάρων ὀλολυγή.
<stage>(ἁὐλεἶ)</stage>
urn:cts:greekLit:tlg0019.tlg006.fu-sp:223.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:223.1.text#ὦ Ζεῦ βασιλεῦ τοῦ φθέγματος τοὐρνιθίου·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:224.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:224.1.text#οἶον κατεμελίτωσε τὴν λόχμην ὃλην.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:225.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:225.1.text#οὗτος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:225.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:225.2.text#τί ἔστιν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:225.3.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:225.3.text#οὐ σιωπήσει;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:225.4.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:225.4.text#τί δαί;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:226.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:226.1.text#οὕποψ μελῳδεῖν αὖ παρασκευάζεται.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:227.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:227.1.text#ἐποποῖ ποποποποποποποῖ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:228.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:228.1.text#ἰὼ ἰὼ ἰτὼ ἰτὼ ἰτὼ ἰτὼ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:229.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:229.1.text#ἴτω τις ὧδε τῶν ἐμῶν ὁμοπτέρων·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:230.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:230.1.text#ὅσοι τ' εὐσπόρους ἀγροίκων γύας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:231.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:231.1.text#νέμεσθε, φῦλα μυρία κριθοτράγων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:232.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:232.1.text#σπερμολόγων τε γένη
urn:cts:greekLit:tlg0019.tlg006.fu-sp:233.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:233.1.text#ταχὺ πετόμενα, μαλθακὴν ἱέντα γῆρυν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:234.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:234.1.text#ὅσα τ' ἐν ἄλοκι θαμὰ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:235.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:235.1.text#βῶλον ἀμφιτιττυβίζεθ' ὧδε λεπτὸν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:236.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:236.1.text#ἡδομένᾳ φωνᾷ·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:237.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:237.1.text#τιὸ τιὸ τιὸ τιὸ τιὸ τιὸ τιὸ τιό.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:238.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:238.1.text#ὅσα θ' ὑμῶν κατὰ κήπους ἐπὶ κισσοῦ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:239.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:239.1.text#κλάδεσι νομὸν ἔχει,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:240.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:240.1.text#τά τε κατ' ὄρεα τά τε κοτινοτράγα τά τε κομαροφάγα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:242.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:242.1.text#ἀνύσατε πετόμενα πρὸς ἐμὰν αὐδάν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:243.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:243.1.text#τριοτὸ τριοτὸ τοτοβρίξ·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:244.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:244.1.text#οἵ θ' ἑλείας παρ' αὐλῶνας ὀξυστόμους
urn:cts:greekLit:tlg0019.tlg006.fu-sp:245.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:245.1.text#ἐμπίδας κάπτεθ', ὅσα τ' εὐδρόσους γῆς τόπους
urn:cts:greekLit:tlg0019.tlg006.fu-sp:246.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:246.1.text#ἔχετε λειμῶνά τ' ἐρόεντα Μαραθῶνος, ὄρνις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:248.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:248.1.text#πτερυγοποίκιλός τ' ἀτταγᾶς ἀτταγᾶς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:250.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:250.1.text#ὧν τ' ἐπὶ πόντιον οἶδμα θαλάσσης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:251.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:251.1.text#φῦλα μετ' ἀλκυόνεσσι ποτῆται,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:252.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:252.1.text#δεῦρ' ἴτε πευσόμενοι τὰ νεώτερα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:253.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:253.1.text#πάντα γὰρ ἐνθάδε φῦλ' ἀθροΐζομεν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:254.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:254.1.text#οἰωνῶν ταναοδείρων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:255.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:255.1.text#ἥκει γὰρ τις δριμὺς πρέσβυς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:256.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:256.1.text#καινὸς γνώμην
urn:cts:greekLit:tlg0019.tlg006.fu-sp:257.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:257.1.text#καινῶν τ' ἔργων ἐγχειρητής.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:258.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:258.1.text#ἀλλ' ἴτ' ἐς λόγους ἅπαντα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:259.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:259.1.text#δεῦρο δεῦρο δεῦρο δεῦρο.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:260.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:260.1.text#τοροτοροτοροτοροτίξ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:261.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:261.1.text#κικκαβαῦ κικκαβαῦ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:262.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:262.1.text#τοροτοροτοροτορολιλιλίξ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:263.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:263.1.text#ὁρᾷς τιν' ὄρνιν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:263.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:263.2.text#μὰ τὸν Ἀπόλλω 'γὼ μὲν οὔ·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:264.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:264.1.text#καίτοι κέχηνά γ' ἐς τὸν οὐρανὸν βλέπων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:265.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:265.1.text#ἄλλως ἄρ' οὕποψ, ὡς ἔοικ', ἐς τὴν λόχμην
urn:cts:greekLit:tlg0019.tlg006.fu-sp:266.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:266.1.text#ἐσβὰς ἐπῷζε χαραδριὸν μιμούμενος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:267.1.speaker#Ὄρνις Τις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:267.1.text#τοροτὶξ τοροτίξ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:268.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:268.1.text#ὦγάθ' ἀλλ' εἶς οὑτοσὶ καὶ δή τις ὄρνις ἔρχεται.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:269.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:269.1.text#νὴ Δί' ὄρνις δῆτα. τίς ποτ' ἐστίν; οὐ δήπου ταὧς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:270.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:270.1.text#οὗτος αὐτὸς νῷν φράσει· τίς ἐστιν ὄρνις οὑτοσί;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:271.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:271.1.text#οὗτος οὐ τῶν ἠθάδων τῶνδ' ὧν ὁρᾶθ' ὑμεῖς ἀεί,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:272.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:272.1.text#ἀλλὰ λιμναῖος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:272.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:272.2.text#βαβαὶ καλός γε καὶ φοινικιοῦς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:273.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:273.1.text#εἰκότως γε· καὶ γὰρ ὄνομ' αὐτῷ 'στὶ φοινικόπτερος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:274.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:274.1.text#οὗτος ὦ σέ τοι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:274.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:274.2.text#τί βωστρεῖς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:274.3.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:274.3.text#ἕτερος ὄρνις οὑτοσί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:275.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:275.1.text#νὴ Δί' ἕτερος δῆτα χοὖτος ἔξεδρον χρόαν ἔχων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:276.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:276.1.text#τίς ποτ' ἔσθ' ὁ μουσόμαντις ἄτοπος ὄρνις ὀρειβάτης;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:277.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:277.1.text#ὄνομα τούτῳ Μῆδός ἐστο.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:277.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:277.2.text#Μῆδος; ὦναξ Ἡράκλεις·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:278.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:278.1.text#εἶτα πῶς ἄνευ καμήλου Μῆδος ὤν εἰσέπτετο;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:279.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:279.1.text#ἕτερος αὖ λόφον κατειληφώς τις ὄρνις οὑτοσί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:280.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:280.1.text#τί τὸ τέρας τουτί ποτ' ἐστίν; οὐ σὺ μόνος ἄρ' ἦσθ' ἔποψ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:281.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:281.1.text#ἀλλὰ χοὖτος ἕτερος;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:281.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:281.2.text#οὑτοσὶ μέν ἐστι Φιλοκλέους
urn:cts:greekLit:tlg0019.tlg006.fu-sp:282.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:282.1.text#ἐξ ἔποπος, ἐγὼ δὲ τούτου πάππος, ὥσπερ εἰ λέγοις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:283.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:283.1.text#Ἱππόνικος Καλλίου κἀξ Ἱππονίκου Καλλίας.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:284.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:284.1.text#Καλλίας ἄρ' οὗτος οὕρνις ἐστίν· ὡς πτερορρυεῖ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:285.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:285.1.text#ἅτε γὰρ ὢν γενναῖος ὑπό τε συκοφαντῶν τίλλεται,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:286.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:286.1.text#αἵ τε θήλειαι προσεκτίλλουσιν αὐτοῦ τὰ πτερά.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:287.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:287.1.text#ὦ Πόσειδον ἕτερος αὖ τις βαπτὸς ὄρνις οὑτοσί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:288.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:288.1.text#τίς ὀνομάξεταί ποθ' οὗτος;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:288.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:288.2.text#οὑτοσὶ κατωφαγᾶς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:289.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:289.1.text#ἔστι γὰρ κατωφαγᾶς τις ἄλλος ἢ Κλεώνυμος;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:290.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:290.1.text#πῶς ἂν οὖν Κλεώνυμός γ' ὢν οὐκ ἀπέβαλε τὸν λόφον;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:291.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:291.1.text#ἀλλὰ μέντοι τίς ποθ' ἡ λόφωσις ἡ τῶν ὀρνέων;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:292.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:292.1.text#ἦ 'πὶ τὸν δίαυλον ἦλθον;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:292.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:292.2.text#ὥσπερ οἱ Κᾶρες μὲν οὖν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:293.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:293.1.text#ἐπὶ λόφων οἰκοῦσιν ὦγάθ' ἀσφαλείας οὔνεκα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:294.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:294.1.text#ὦ Πόσειδον οὐχ ὁρᾷς ὅσον συνείλεκται κακὸν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:295.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:295.1.text#ὀρνέων;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:295.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:295.2.text#ὦναξ Ἄπολλον τοῦ νέφους. ἰοὺ ἰού,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:296.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:296.1.text#οὐδ' ἰδεῖν ἔτ' ἔσθ' ὑπ' αὐτῶν πετομένων τὴν εἴσοδον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:297.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:297.1.text#οὑτοσὶ πέρδιξ, ἐκεινοσί γε νὴ Δί' ἀτταγᾶς,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:298.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:298.1.text#οὑτοσὶ δὲ πηνέλοψ, ἐκεινηὶ δέ γ' ἀλκυών.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:299.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:299.1.text#τίς γάρ ἐσθ' οὕπισθεν αὐτῆς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:299.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:299.2.text#ὅστις ἐστί; κειρύλος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:300.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:300.1.text#κειρύλος γάρ ἐστιν ὄρνις;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:300.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:300.2.text#οὐ γάρ ἐστι Σποργίλος;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:301.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:301.1.text#χαὐτηί γε γλαῦξ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:301.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:301.2.text#τί φῄς; τίς γλαῦκ' Ἀθήναζ' ἤγαγεν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:302.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:302.1.text#κίττα τρυγὼν κορυδὸς ἐλεᾶς ὑποθυμὶς περιστερὰ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:303.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:303.1.text#νέρτος ἱέραξ φάττα κόκκυξ ἐρυθρόπους κεβλήπυρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:304.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:304.1.text#πορφυρὶς κερχνῂς κολυμβὶς ἀμπελὶς φήνη δρύοψ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:305.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:305.1.text#ἰοὺ ἰοὺ τῶν ὀρνέων, ἰοὺ ἰοὺ τῶν κοψίχων·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:306.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:306.1.text#οἶα πιππίζουσι καὶ τρέχουσι διακεκραγότες.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:307.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:307.1.text#ἆρ' ἀπειλοῦσίν γε νῷν; οἴμοι, κεχήνασίν γέ τοι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:308.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:308.1.text#καὶ βλέπουσιν ἐς σὲ κἀμέ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:308.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:308.2.text#τοῦτο μὲν κἀμοὶ δοκεῖ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:310.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:310.1.text#ποποποποποποποποποποῖ ποῦ μ' ἄρ' ὃς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:311.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:311.1.text#ἐκάλεσε; τίνα τόπον ἄρα ποτὲ νέμεται;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:312.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:312.1.text#οὑτοσὶ πάλαι πάρειμι κοὐκ ἀποστατῶ φίλων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:313.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:313.1.text#τί τί τί τί τί τί τί τί· τίνα λόγον ἄρα ποτὲ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:315.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:315.1.text#πρὸς ἐμὲ φίλον ἔχων;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:316.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:316.1.text#κοινὸν ἀσφαλῆ δίκαιον ἡδὺν ὠφελήσιμον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:317.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:317.1.text#ἄνδρε γὰρ λεπτὼ λογιστὰ δεῦρ' ἀφῖχθον ὡς ἐμέ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:318.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:318.1.text#ποῦ; πᾷ; πῶς φῄς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:320.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:320.1.text#φήμ' ἀπ' ἀνθρώπων ἀφῖχθαι δεῦρο πρεσβύτα δύο·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:321.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:321.1.text#ἥκετον δ' ἔχοντε πρέμνον πράγματος πελωρίου.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:322.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:322.1.text#ὦ μέγιστον ἐξαμαρτὼν ἐξ ὅτου 'τράφην ἐγώ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:323.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:323.1.text#πῶς λέγεις;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:323.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:323.2.text#μήπω φοβηθῇς τὸν λόγον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:323.3.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:323.3.text#τί μ' ἠργάσω;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:324.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:324.1.text#ἄνδρ' ἐδεξάμην ἐραστὰ τῆσδε τῆς ξυνουσίας.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:325.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:325.1.text#καὶ δέδρακας τοῦτο τοὔργον;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:325.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:325.2.text#καὶ δεδρακώς γ' ἥδομαι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:326.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:326.1.text#κἀστὸν ἤδη που παρ' ἡμῖν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:326.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:326.2.text#εἰ παρ' ὑμῖν εἴμ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:327.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:327.1.text#ἔα ἔα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:328.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:328.1.text#προδεδόμεθ' ἀνόσιά τ' ἐπάθομεν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:329.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:329.1.text#ὃς γὰρ φίλος ἦν ὁμότροφά θ' ἡμῖν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:330.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:330.1.text#ἐνέμετο πεδία παρ' ἡμῖν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:331.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:331.1.text#παρέβη μὲν θεσμοὺς ἀρχαίους,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:332.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:332.1.text#παρέβη δ' ὅρκους ὀρνίθων·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:333.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:333.1.text#ἐς δὲ δόλον ἐκάλεσε, παρέβαλέ τ' ἐμὲ παρὰ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:334.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:334.1.text#γένος ἀνόσιον, ὅπερ ἐξότ' ἐγένετ' ἐπ' ἐμοὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:335.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:335.1.text#πολέμιον ἐτράφη.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:336.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:336.1.text#ἀλλὰ πρὸς τοῦτον μὲν ἡμῖν ἐστιν ὕστερος λόγος·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:337.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:337.1.text#τὼ δὲ πρεσβύτα δοκεῖ μοι τώδε δοῦναι τὴν δίκην
urn:cts:greekLit:tlg0019.tlg006.fu-sp:338.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:338.1.text#διαφορηθῆναί θ' ὑφ' ἡμῶν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:338.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:338.2.text#ὡς ἀπωλόμεσθ' ἄρα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:339.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:339.1.text#αἴτιος μέντοι σὺ νῷν εἶ τῶν κακῶν τούτων μόνος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:340.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:340.1.text#ἐπὶ τί γάρ μ' ἐκεῖθεν ἦγες;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:340.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:340.2.text#ἵν' ἀκολουθοίης ἐμοί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:341.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:341.1.text#ἵνα μὲν οὖν κλάοιμι μεγάλα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:341.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:341.2.text#τοῦτο μὲν ληρεῖς ἔχων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:342.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:342.1.text#κάρτα· πῶς κλαύσει γάρ, ἢν ἅπαξ γε τὠφθαλμὼ 'κκοπῇς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:343.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:343.1.text#ἰὼ ἰώ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:344.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:344.1.text#ἔπαγ' ἔπιθ' ἐπίφερε πολέμιον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:345.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:345.1.text#ὁρμὰν φονίαν, πτέρυγά τε παντᾷ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:346.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:346.1.text#ἐπίβαλε περί τε κύκλωσαι·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:347.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:347.1.text#ὡς δεῖ τώδ' οἰμώζειν ἄμφω
urn:cts:greekLit:tlg0019.tlg006.fu-sp:348.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:348.1.text#καὶ δοῦναι ῥύγχει φορβάν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:349.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:349.1.text#οὔτε γὰρ ὄρος σκιερὸν οὔτε νέφος αἰθέριον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:350.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:350.1.text#οὔτε πολιὸν πέλαγος ἔστιν ὅ τι δέξεται
urn:cts:greekLit:tlg0019.tlg006.fu-sp:351.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:351.1.text#τώδ' ἀποφυγόντε με.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:352.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:352.1.text#ἀλλὰ μὴ μέλλωμεν ἤδη τώδε τίλλειν καὶ δάκνειν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:353.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:353.1.text#ποῦ 'σθ' ὁ ταξίαρχος; ἐπαγέτω τὸ δεξιὸν κέρας.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:354.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:354.1.text#τοῦτ' ἐκεῖνο· ποῖφύγω δύστηνος;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:354.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:354.2.text#οὗτος οὐ μενεῖς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:355.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:355.1.text#ἵν' ὑπὸ τούτων διαφορηθῶ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:355.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:355.2.text#πῶς γὰρ ἂν τούτους δοκεῖς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:356.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:356.1.text#ἐκφυγεῖν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:356.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:356.2.text#οὐκ οἶδ' ὅπως ἄν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:356.3.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:356.3.text#ἀλλ' ἐγώ τοί σοι λέγω,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:357.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:357.1.text#ὅτι μένοντε δεῖ μάχεσθαι λαμβάνειν τε τῶν χυτρῶν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:358.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:358.1.text#τί δὲ χύτρα νώ γ' ὠφελήσει;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:358.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:358.2.text#γλαῦξ μὲν οὐ πρόσεισι νῷν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:359.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:359.1.text#τοῖς δὲ γαμψώνυξι τοισδί;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:359.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:359.2.text#τὸν ὀβελίσκον ἁρπάσας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:360.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:360.1.text#εἶτα κατάπηξον πρὸ σαυτοῦ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:360.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:360.2.text#τοῖσι δ' ὀφθαλμοῖσι τί;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:361.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:361.1.text#ὀξύβαφον ἐντευθενὶ προσδοῦ λαβὼν ἢ τρύβλιον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:362.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:362.1.text#ὦ σοφώτατ', εὖ γ' ἀνηῦρες αὐτὸ καὶ στρατηγικῶς·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:363.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:363.1.text#ὑπερακοντίζεις σύ γ' ἤδη Νικίαν ταῖς μηχαναῖς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:364.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:364.1.text#ἐλελελεῦ χώρει κάθες τὸ ῥύγχος· οὐ μέλλειν ἐχρῆν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:365.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:365.1.text#ἕλκε τίλλε παῖε δεῖρε, κόπτε πρώτην τὴν χύτραν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:366.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:366.1.text#εἰπέ μοι τί μέλλετ' ὦ πάντων κάκιστα θηρίων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:367.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:367.1.text#ἀπολέσαι παθόντες οὐδὲν ἄνδρε καὶ διασπάσαι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:368.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:368.1.text#τῆς ἐμῆς γυναικὸς ὄντε ξυγγενεῖ καὶ φυλέτα;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:369.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:369.1.text#φεισόμεσθα γάρ τι τῶνδε μᾶλλον ἡμεῖς ἢ λύκων;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:370.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:370.1.text#ἢ τίνας τεισαίμεθ' ἄλλους τῶνδ' ἂν ἐχθίους ἔτι;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:371.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:371.1.text#εἰ δὲ τὴν φύσιν μὲν ἐχθροὶ τὸν δὲ νοῦν εἰσιν φίλοι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:372.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:372.1.text#καὶ διδάξοντές τι δεῦρ' ἥκουσιν ὑμᾶς χρήσιμον;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:373.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:373.1.text#πῶς δ' ἂν οἵδ' ἡμᾶς τι χρήσιμον διδάξειάν ποτε
urn:cts:greekLit:tlg0019.tlg006.fu-sp:374.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:374.1.text#ἢ φράσειαν, ὄντες ἐχθροὶ τοῖσι πάπποις τοῖς ἐμοῖς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:375.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:375.1.text#ἀλλ' ἀπ' ἐχθρῶν δῆτα πολλὰ μανθάνουσιν οἱ σοφοί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:376.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:376.1.text#ἡ γὰρ εὐλάβεια σῴζει πάντα. παρὰ μὲν οὖν φίλου
urn:cts:greekLit:tlg0019.tlg006.fu-sp:377.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:377.1.text#οὐ μάθοις ἂν τοῦθ', ὁ δ' ἐχθρὸς εὐθὺς ἐξηνάγκασεν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:378.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:378.1.text#αὐτίχ' αἱ πόλεις παρ' ἀνδρῶν γ' ἔμαθον ἐχθρῶν κοὐ φίλων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:379.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:379.1.text#ἐκπονεῖν θ' ὑψηλὰ τείχη ναῦς τε κεκτῆσθαι μακράς·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:380.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:380.1.text#τὸ δὲ μάθημα τοῦτο σῴζει παῖδας οἶκον χρήματα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:381.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:381.1.text#ἔστι μὲν λόγων ἀκοῦσαι πρῶτον, ὡς ἡμῖν δοκεῖ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:382.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:382.1.text#χρήσιμον· μάθοι γὰρ ἄν τις κἀπὸ τῶν ἐχθρῶν σοφόν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:383.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:383.1.text#οἵδε τῆς ὀργῆς χαλᾶν εἴξασιν. ἄναγ' ἐπὶ σκέλος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:384.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:384.1.text#καὶ δίκαιόν γ' ἐστὶ κἀμοὶ δεῖ νέμειν ὑμᾶς χάριν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:385.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:385.1.text#ἀλλὰ μὴν οὐδ' ἄλλο σοί πω πρᾶγμ' ἐνηντιώμεθα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:386.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:386.1.text#μᾶλλον εἰρήνην ἄγουσι νὴ Δί', ὥστε τὴν χύτραν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:387.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:387.1.text#τώ τε τρυβλίω καθίει·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:388.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:388.1.text#καὶ τὸ δόρυ χρή, τὸν ὀβελίσκον,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:389.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:389.1.text#περιπατεῖν ἔχοντας ἡμᾶς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:390.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:390.1.text#τῶν ὅπλων ἐντός, παρ' αὐτὴν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:391.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:391.1.text#τὴν χύτραν ἄκραν ὁρῶντας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:392.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:392.1.text#ἐγγύς· ὡς οὐ φευκτέον νῷν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:393.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:393.1.text#ἐτεὸν ἢν δ' ἄρ' ἀποθάνωμεν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:394.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:394.1.text#κατορυχθησόμεσθα ποῦ γῆς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:395.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:395.1.text#ὁ Κεραμεικὸς δέξεται νώ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:396.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:396.1.text#δημοσίᾳ γὰρ ἵνα ταφῶμεν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:397.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:397.1.text#φήσομεν πρὸς τοὺς στρατηγοὺς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:398.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:398.1.text#μαχομένω τοῖς πολεμίοισιν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:399.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:399.1.text#ἀποθανεῖν ἐν Ὀρνεαῖς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:400.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:400.1.text#ἄναγ' ἐς τάξιν πάλιν ἐς ταὐτόν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:401.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:401.1.text#καὶ τὸν θυμὸν κατάθου κύψας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:402.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:402.1.text#παρὰ τὴν ὀργὴν ὥσπερ ὁπλίτης·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:403.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:403.1.text#κἀναπυθώμεθα τούσδε τίνες ποτὲ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:404.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:404.1.text#καὶ πόθεν ἔμολον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:405.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:405.1.text#† ἐπὶ τίνα τ' ἐπίνοιαν. †
urn:cts:greekLit:tlg0019.tlg006.fu-sp:406.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:406.1.text#ἰὼ ἔποψ σέ τοι καλῶ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:407.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:407.1.text#καλεῖς δὲ τοῦ κλύειν θέλων;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:408.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:408.1.text#τίνες ποθ' οἵδε καὶ πόθεν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:409.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:409.1.text#ξείνω σοφῆς ἀφ' Ἑλλάδος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:410.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:410.1.text#τύχη δὲ ποία κομίζει
urn:cts:greekLit:tlg0019.tlg006.fu-sp:411.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:411.1.text#ποτ' αὐτὼ πρὸς ὄρνιθας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:412.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:412.1.text#ἐλθεῖν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:412.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:412.2.text#ἔρως
urn:cts:greekLit:tlg0019.tlg006.fu-sp:413.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:413.1.text#βίου διαίτης τε καὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:414.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:414.1.text#σοῦ ξυνοικεῖν τέ σοι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:415.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:415.1.text#καὶ ξυνεῖναι τὸ πᾶν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:416.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:416.1.text#τί φῄς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:416a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:416a.1.text#λέγουσι δὴ τίνας λόγους;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:417.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:417.1.text#ἄπιστα καὶ πέρα κλύειν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:418.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:418.1.text#ὁρᾷ τι κέρδος ἐνθάδ' ἄξιον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:419.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:419.1.text#μονῆς, ὅτῳ πέποιθ'
urn:cts:greekLit:tlg0019.tlg006.fu-sp:419a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:419a.1.text#ἐμοὶ ξυνὼν […]
urn:cts:greekLit:tlg0019.tlg006.fu-sp:420.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:420.1.text#κρατεῖν ἂν ἢ τὸν ἐχθρὸν ἢ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:421.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:421.1.text#φίλοισιν ὠφελεῖν ἔχειν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:422.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:422.1.text#λέγει μέγαν τιν' ὄλβον οὔτε
urn:cts:greekLit:tlg0019.tlg006.fu-sp:423.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:423.1.text#λεκτὸν οὔτε πιστόν· ὡς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:424.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:424.1.text#σὰ γὰρ τὰ πάντα ταῦτα καὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:425.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:425.1.text#τὸ τῇδε καὶ τὸ κεῖσε καὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:426.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:426.1.text#τὸ δεῦρο προσβιβᾷ λέγων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:427.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:427.1.text#πότερα μαινόμενος;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:428.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:428.1.text#ἄφατον ὡς φρόνιμος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:429.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:429.1.text#ἔνι σοφόν τι φρενί;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:430.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:430.1.text#πυκνότατον κίναδος,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:431.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:431.1.text#σόφισμα κύρμα τρῖμμα παιπάλημ' ὅλον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:432.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:432.1.text#λέγειν λέγειν κέλευέ μοι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:433.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:433.1.text#κλύων γὰρ ὧν σύ μοι λέγεις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:434.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:434.1.text#λόγων ἀνεπτέρωμαι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:435.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:435.1.text#ἄγε δὴ σὺ καὶ σὺ τὴν πανοπλίαν μὲν πάλιν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:436.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:436.1.text#ταύτην λαβόντε κρεμάσατον τύχἀγαθῇ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:437.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:437.1.text#ἐς τὸν ἰπνὸν εἴσω πλησίον τοὐπιστάτου·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:438.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:438.1.text#σὺ δὲ τούσδ' ἐφ' οἷσπερ τοῖς λόγοις συνέλεξ' ἐγὼ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:439.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:439.1.text#φράσον, δίδαξον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:439.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:439.2.text#μὰ τὸν Ἀπόλλω 'γὼ μὲν οὔ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:440.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:440.1.text#ἢν μὴ διάθωνταί γ' οἵδε διαθήκην ἐμοὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:441.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:441.1.text#ἥνπερ ὁ πίθηκος τῇ γυναικὶ διέθετο,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:441a.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:441a.1.text#ὁ μαχαιροποιός, μήτε δάκνειν τούτους ἐμὲ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:442.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:442.1.text#μήτ' ὀρχίπεδ' ἕλκειν μήτ' ὀρύττειν —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:442.2.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:442.2.text#οὔτι που
urn:cts:greekLit:tlg0019.tlg006.fu-sp:443.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:443.1.text#τόν —; οὐδαμῶς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:443.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:443.2.text#οὔκ, ἀλλὰ τὠφθαλμὼ λέγω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:444.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:444.1.text#διατίθεμαι 'γώ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:444.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:444.2.text#κατόμοσόν νυν ταῦτά μοι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:445.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:445.1.text#ὄμνυμ' ἐπὶ τούτοις, πᾶσι νικᾶν τοῖς κριταῖς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:446.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:446.1.text#καὶ τοῖς θεαταῖς πᾶσιν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:446.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:446.2.text#ἔσται ταυταγί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:447.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:447.1.text#εἰ δὲ παραβαίην, ἑνὶ κριτῇ νικᾶν μόνον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:448.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:448.1.text#ἀκούετε λεῴ· τοὺς ὁπλίτας νυνμενὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:449.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:449.1.text#ἀνελομένους θὤπλ' ἀπιέναι πάλιν οἴκαδε,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:450.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:450.1.text#σκοπεῖν δ' ὅ τι ἂν προγράφωμεν ἐν τοῖς πινακίοις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:451.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:451.1.text#δολερὸν μὲν ἀεὶ κατὰ πάντα δὴ τρόπον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:452.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:452.1.text#πέφυκεν ἄνθρωπος· σὺ δ' ὅμως λέγε μοι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:453.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:453.1.text#τάχα γὰρ τύχοις ἂν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:454.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:454.1.text#χρηστὸν ἐξειπὼν ὅ τι μοι παρορᾷς, ἢ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:455.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:455.1.text#δύναμίν τινα μείζω
urn:cts:greekLit:tlg0019.tlg006.fu-sp:456.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:456.1.text#παραλειπομένην ὑπ' ἐμῆς φρενὸς ἀξυνέτου·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:457.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:457.1.text#σὺ δὲ τοῦθ' οὑρᾷς λέγ' ἐς κοινόν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:458.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:458.1.text#ὃ γὰρ ἂν σὺ τύχῃς μοι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:459.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:459.1.text#ἀγαθὸν πορίσας, τοῦτο κοινὸν ἔσται.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:460.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:460.1.text#ἀλλ' ἐφ' ὅτῳπερ πράγματι τὴν σὴν ἥκεις γνώμην ἀναπείσας,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:461.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:461.1.text#λέγε θαρρήσας· ὡς τὰς σπονδὰς οὐ μὴ πρότεροι παραβῶμεν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:462.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:462.1.text#καὶ μὴν ὀργῶ νὴ τὸν Δία καὶ προπεφύραται λόγος εἷς μοι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:463.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:463.1.text#ὃν διαμάττειν οὐ κωλύει· φέρε παῖ στέφανον· καταχεῖσθαι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:464.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:464.1.text#κατὰ χειρὸς ὕδωρ φερέτω ταχύ τις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:464.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:464.2.text#δειπνήσειν μέλλομεν; ἢ τί;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:465.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:465.1.text#μὰ Δί' ἀλλὰ λέγειν ζητῶ τι πάλαι μέγα καὶ λαρινὸν ἔπος τι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:466.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:466.1.text#ὅ το τὴν τούτων θραύσει ψυχήν· οὕτως ὑμῶν ὑπεραλγῶ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:467.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:467.1.text#οἵτινες ὄντες πρότερον βασιλῆς —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:467.2.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:467.2.text#ἡμεῖς βασιλῆς; τίνος;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:467.3.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:467.3.text#ὑμεῖς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:468.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:468.1.text#πάντων ὁπόσ' ἔστιν, ἐμοῦ πρῶτον, τουδί, καὶ τοῦ Διὸς αὐτοῦ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:469.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:469.1.text#ἀρχαιότεροι πρότεροί τε Κρόνου καὶ Τιτάνων ἐγένεσθε,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:470.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:470.1.text#καὶ γῆς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:470.2.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:470.2.text#καὶ γῆς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:470.3.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:470.3.text#νὴ τὸν Ἀπόλλω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:470.4.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:470.4.text#τουτὶ μὰ Δί' οὐκ ἐπεπύσμην.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:471.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:471.1.text#ἀμαθὴς γὰρ ἔφυς κοὐ πολυπράγμων, οὐδ' Αἴσωπον πεπάτηκας,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:472.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:472.1.text#ὃς ἔφασκε λέγων κορυδὸν πάντων πρώτην ὄρνιθα γενέσθαι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:473.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:473.1.text#προτέραν τῆς γῆς, κἄπειτα νόσῳ τὸν πατέρ' αὐτῆς ἀποθνῄσκειν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:474.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:474.1.text#γῆν δ' οὐκ εἶναι, τὸν δὲ προκεῖσθαι πεμπταῖον· τὴν δ' ἀποροῦσαν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:475.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:475.1.text#ὑπ' ἀμηχανίας τὸν πατέρ' αὑτῆς ἐν τῇ κεφαλῇ κατορύξαι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:476.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:476.1.text#ὁ πατὴρ ἄρα τῆς κορυδοῦ νυνὶ κεῖται τεθνεὼς Κεφαλῆσιν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:477.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:477.1.text#οὔκουν δῆτ' εἰ πρότεροι μὲν γῆς πρότεροι δὲ θεῶν ἐγένοντο,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:478.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:478.1.text#ὡς πρεσβυτάτων αὐτῶν ὄντῶν ὀρθῶς ἐσθ' ἡ βασιλεία;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:479.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:479.1.text#νὴ τὸν Ἀπόλλω· πάνυ τοίνυν χρὴ ῥύγχος βόσκειν σε τὸ λοιπόν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:480.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:480.1.text#οὐκ ἀποδώσει ταχέως ὁ Ζεὺς τὸ σκῆπτρον τῷ δρυκολάπτῃ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:481.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:481.1.text#ὡς δ' οὐχὶ θεοὶ τοίνυν ἦρχον τῶν ἀνθρώπων τὸ παλαιόν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:482.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:482.1.text#ἀλλ' ὄρνιθες, κἀβασίλευον, πόλλ' ἐστὶ τεκμήρια τούτων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:483.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:483.1.text#αὐτίκα δ' ὑμῖν πρῶτ' ἐπιδείξω τὸν ἀλεκτρυόν', ὡς ἐτυράννει
urn:cts:greekLit:tlg0019.tlg006.fu-sp:484.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:484.1.text#ἦρχέ τε Περσῶν πρῶτον πάντων Δαρείου καὶ Μεγαβάζου,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:485.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:485.1.text#ὥστε καλεῖται Περσικὸς ὄρνις ἀπὸ τῆς ἀρχῆς ἔτ' ἐκείνης.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:486.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:486.1.text#διὰ ταῦτ' ἄρ' ἔχων καὶ νῦν ὥσπερ βασιλεὺς ὁ μέγας διαβάσκει
urn:cts:greekLit:tlg0019.tlg006.fu-sp:487.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:487.1.text#ἐπὶ τῆς κεφαλῆς τὴν κυρβασίαν τῶν ὀρνίθων μόνος ὀρθήν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:488.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:488.1.text#οὕτω δ' ἴσχυσέ τε καὶ μέγας ἦν τότε καὶ πολύς, ὥστ' ἔτι καὶ νῦν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:489.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:489.1.text#ὑπὸ τῆς ῥώμης τῆς τότ' ἐκείνης, ὁπόταν μόνον ὄρθριον ᾄσῃ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:490.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:490.1.text#ἀναπηδῶσιν πάντες ἐπ' ἔργον χαλκῆς κεραμῆς σκυλοδέψαι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:491.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:491.1.text#σκυτῆς βαλανῆς ἀλφιταμοιβοὶ τορνευτολυρασπιδοπηγοί·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:492.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:492.1.text#οἱ δὲ βαδίζουσ' ὑποδησάμενοι νύκτωρ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:492.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:492.2.text#ἐμὲ τοῦτό γ' ἐρώτα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:493.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:493.1.text#χλαῖναν γὰρ ἀπώλεσ' ὁ μοχθηρὸς Φρυγίων ἐρίων διὰ τοῦτον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:494.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:494.1.text#ἐς δεκάτην γάρ ποτε παιδαρίου κληθεὶς ὑπέπινον ἐν ἄστει,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:495.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:495.1.text#κἄρτι καθηῦδον, καὶ πρὶν δειπνεῖν τοὺς ἄλλους οὗτος ἄρ' ᾖσεν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:496.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:496.1.text#κἀγὼ νομίσας ὄρθρον ἐχώρουν Ἀλιμουντάδε, κἄρτι προκύπτω
urn:cts:greekLit:tlg0019.tlg006.fu-sp:497.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:497.1.text#ἔξω τείχους καὶ λωποδύτης παίει ῥοπάλῳ με τὸ νῶτον·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:498.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:498.1.text#κἀγὼ πίπτω μέλλω τε βοᾶν, ὁ δ' ἀπέβλισε θοἰμάτιόν μου.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:499.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:499.1.text#ἰκτῖνος δ' οὖν τῶν Ἑλλήνων ἦρχεν τότε κἀβασίλευεν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:500.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:500.1.text#τῶν Ἑλλήνων;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:500.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:500.2.text#καὶ κατέδειξέν γ' οὗτος πρῶτος βασιλεύων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:501.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:501.1.text#προκυλινδεῖσθαι τοῖς ἰκτίνοις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:501.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:501.2.text#νὴ τὸν Διόνυσον, ἐγὼ γοῦν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:502.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:502.1.text#ἐκυλινδούμην ἰκτῖνον ἰδών· κᾆθ' ὕπτιος ὢν ἀναχάσκων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:503.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:503.1.text#ὀβολὸν κατεβρόχθισα· κᾆτα κενὸν τὸν θύλακον οἴκαδ' ἀφεῖλκον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:504.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:504.1.text#Αἰγύπτου δ' αὖ καὶ Φοινίκης πάσης κόκκυξ βασιλεὺς ἦν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:505.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:505.1.text#χὠπόθ' ὁ κόκκυξ εἴποι "κόκκυ," τότ' ἂν οἱ Φοίνικες ἅπαντες
urn:cts:greekLit:tlg0019.tlg006.fu-sp:506.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:506.1.text#τοὺς πυροὺς ἂν καὶ τὰς κριθὰς ἐν τοῖς πεδίοις ἐθέριζον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:507.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:507.1.text#τοῦτ' ἄρ' ἐκεῖν' ἦν τοὔπος ἀληθῶς· "κόκκυψωλοὶ πεδίονδε."
urn:cts:greekLit:tlg0019.tlg006.fu-sp:508.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:508.1.text#ἦρχον δ' οὕτω σφόδρα τὴν ἀρχήν, ὥστ' εἴ τις καὶ βασιλεύοι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:509.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:509.1.text#ἐν ταῖς πόλεσιν τῶν Ἑλλήνων Ἀγαμέμνων ἢ Μενέλαος,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:510.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:510.1.text#ἐπὶ τῶν σκήπτρων ἐκάθητ' ὄρνις μετέχων ὅ τι δωροδοκοίη.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:511.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:511.1.text#τουτὶ τοίνυν οὐκ ᾔδη 'γώ· καὶ δῆτά μ' ἐλάμβανε θαῦμα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:512.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:512.1.text#ὁπότ' ἐξέλθοι Πρίαμός τις ἔχων ὄρνιν ἐν τοῖσι τραγῳδοῖς,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:513.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:513.1.text#ὁ δ' ἄρ' εἱστήκει τὸν Λυσικράτη τηρῶν ὅ τι δωροδοκοίη.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:514.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:514.1.text#ὃ δὲ δεινότατόν γ' ἐστὶν ἁπάντων, ὁ Ζεὺς γὰρ ὁ νῦν βασιλεύων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:515.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:515.1.text#αἰετὸν ὄρνιν ἕστηκεν ἔχων ἐπὶ τῆς κεφαλῆς βασιλεὺς ὤν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:516.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:516.1.text#ἡ δ' αὖ θυγάτηρ γλαῦχ', ὁ δ' Ἀπόλλων ὥσπερ θεράπων ἱέρακα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:517.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:517.1.text#νὴ τὴν Δήμητρ' εὖ ταῦτα λέγεις. τίνος οὕνεκα ταῦτ' ἄρ' ἔχουσιν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:518.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:518.1.text#ἵν' ὅταν θύων τις ἔπειτ' αὐτοῖς ἐς τὴν χεῖρ', ὡς νόμος ἐστίν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:519.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:519.1.text#τὰ σπλάγχνα διδῷ, τοῦ Διὸς αὐτοὶ πρότεροι τὰ σπλάγχνα λάβωσιν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:520.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:520.1.text#ὤμνυ τ' οὐδεὶς τότ' ἂν ἀνθρώπων θεόν, ἀλλ' ὄρνιθας ἅπαντες·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:521.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:521.1.text#Λάμπων δ' ὄμνυσ' ἔτι καὶ νυνὶ τὸν χῆν', ὅταν ἐξαπατᾷ τι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:522.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:522.1.text#οὕτως ὑμᾶς πάντες πρότερον μεγάλους ἁγίους τ' ἐνόμιζον,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:523.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:523.1.text#νῦν δ' ἀνδράποδ' ἠλιθίους Μανᾶς·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:524.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:524.1.text#ὥσπερ δ' ἤδη τοὺς μαινομένους
urn:cts:greekLit:tlg0019.tlg006.fu-sp:525.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:525.1.text#βάλλουσ' ὑμᾶς, κἀν τοῖς ἱεροῖς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:526.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:526.1.text#πᾶς τις ἐφ' ὑμῖν ὀρνιθευτὴς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:527.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:527.1.text#ἵστησι βρόχους παγίδας ῥάβδους
urn:cts:greekLit:tlg0019.tlg006.fu-sp:528.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:528.1.text#ἕρκη νεφέλας δίκτυα πηκτάς·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:529.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:529.1.text#εἶτα λαβόντες πωλοῦσ' ἁθρόους·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:530.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:530.1.text#οἱ δ' ὠνοῦνται βλιμάζοντες·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:531.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:531.1.text#κοὐδ' οὖν, εἴπερ ταῦτα δοκεῖ δρᾶν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:532.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:532.1.text#ὀπτησάμενοι παρέθενθ' ὑμᾶς,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:533.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:533.1.text#ἀλλ' ἐπικνῶσιν τυρὸν ἔλαιον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:534.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:534.1.text#σίλφιον ὄξος καὶ τρίψαντες
urn:cts:greekLit:tlg0019.tlg006.fu-sp:535.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:535.1.text#κατάχυσμ' ἕτερον γλυκὺ καὶ λιπαρόν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:536.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:536.1.text#κἄπειτα κατεσκέδασαν θερμὸν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:537.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:537.1.text#τοῦτο καθ' ὑμῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:538.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:538.1.text#αὐτῶν ὥσπερ κενεβρείων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:539.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:539.1.text#πολὺ δὴ πολὺ δὴ χαλεπωτάτους λόγους
urn:cts:greekLit:tlg0019.tlg006.fu-sp:540.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:540.1.text#ἤνεγκας ἄνθρωφ'. ὡς ἐδάκρυσά γ' ἐμῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:541.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:541.1.text#πατέρων κάκην, οἳ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:542.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:542.1.text#τάσδε τὰς τιμὰς προγόνων παραδόντων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:543.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:543.1.text#ἐπ' ἐμοῦ κατέλυσαν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:544.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:544.1.text#σὺ δέ μοι κατὰ δαίμονα καί τινα συντυχίαν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:545.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:545.1.text#ἀγαθὴν ἥκεις ἐμοὶ σωτήρ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:546.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:546.1.text#ἀναθεὶς γὰρ ἐγώ σοι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:547.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:547.1.text#τὰ νεοττία κἀμαυτὸν οἰκήσω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:548.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:548.1.text#ἀλλ' ὅ τι χρὴ δρᾶν, σὺ δίδασκε παρών· ὡς ζῆν οὐκ ἄξιον ἡμῖν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:549.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:549.1.text#εἰ μὴ κομιούμεθα παντὶ τρόπῳ τὴν ἡμετέραν βασιλείαν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:550.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:550.1.text#καὶ δὴ τοίνυν πρῶτα διδάσκω μίαν ὀρνίθων πόλιν εἶναι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:551.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:551.1.text#κἄπειτα τὸν ἀέρα πάντα κύκλῳ καὶ πᾶν τουτὶ τὸ μεταξὺ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:552.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:552.1.text#περιτειχίζειν μεγάλαις πλίνθοις ὀπταῖς ὥσπερ Βαβυλῶνα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:553.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:553.1.text#ὦ Κεβριόνη καὶ Πορφυρίων ὡς σμερδαλέον τὸ πόλισμα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:554.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:554.1.text#κἄπειτ' ἢν τοῦτ' ἐπανεστήκῃ, τὴν ἀρχὴν τὸν Δί' ἀπαιτεῖν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:555.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:555.1.text#κἂν μὲν μὴ φῇ μηδ' ἐθελήσῃ μηδ' εὐθὺς γνωσιμαχήσῃ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:556.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:556.1.text#ἱερὸν πόλεμον πρωὐδᾶν αὐτῷ, καὶ τοῖσι θεοῖσιν ἀπειπεῖν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:557.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:557.1.text#διὰ τῆς χώρας τῆς ὑμετέρας ἐστυκόσι μὴ διαφοιτᾶν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:558.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:558.1.text#ὥσπερ πρότερον μοιχεύσοντες τὰς Ἀλκμήνας κατέβαινον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:559.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:559.1.text#καὶ τὰς Ἀλόπας καὶ τὰς Σεμέλας· ἤνπερ δ' ἐπίωσ', ἐπιβάλλειν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:560.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:560.1.text#σφραγῖδ' αὐτοῖς ἐπὶ τὴν ψωλήν, ἵνα μὴ βινῶσ' ἔτ' ἐκείνας.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:561.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:561.1.text#τοῖς δ' ἀνθρώποις ὄρνιν ἕτερον πέμψαι κήρυκα κελεύω,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:562.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:562.1.text#ὡς ὀρνίθων βασιλευόντων θύειν ὄρνισι τὸ λοιπόν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:563.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:563.1.text#κἄπειτα θεοῖς ὕστερον αὖθις· προσνείμασθαι δὲ πρεπόντως
urn:cts:greekLit:tlg0019.tlg006.fu-sp:564.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:564.1.text#τοῖσι θεοῖσιν τῶν ὀρνίθων ὃς ἂν ἁρμόττῃ καθ' ἕκαστον·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:565.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:565.1.text#ἢν Ἀφροδίτῃ θύῃ, πυροὺς ὄρνιθι φαληρίδι θύειν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:566.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:566.1.text#ἢν δὲ Ποσειδῶνί τις οἶν θύῃ, νήττῃ πυροὺς καθαγίζειν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:567.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:567.1.text#ἢν δ' Ἡρακλέει θύῃ τι, λάρῳ ναστοὺς θύειν μελιτοῦντας·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:568.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:568.1.text#κἂν Διὶ θύῃ βασιλεῖ κριόν, βασιλεύς ἐστ' ὀρχίλος ὄρνις,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:569.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:569.1.text#ᾧ προτέρῳ δεῖ τοῦ Διὸς αὐτοῦ σέρφον ἐνόρχην σφαγιάζειν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:570.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:570.1.text#ἥσθην σέρφῳ σφαγιαζομένῳ. βροντάτω νῦν ὁ μέγας Ζάν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:571.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:571.1.text#καὶ πῶς ἡμᾶς νομιοῦσι θεοὺς ἄνθρωποι κοὐχὶ κολοιούς,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:572.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:572.1.text#οἳ πετόμεσθα πτέρυγάς τ' ἔχομεν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:572.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:572.2.text#ληρεῖς· καὶ νὴ Δί' ὅ γ' Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:573.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:573.1.text#πέτεται θεὸς ὢν πτέρυγάς τε φορεῖ, κἄλλοι γε θεοὶ πάνυ πολλοί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:574.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:574.1.text#αὐτίκα Νίκη πέτεται πτερύγοιν χρυσαῖν καὶ νὴ Δί' Ἔρως γε·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:575.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:575.1.text#Ἥρην δέ γ' Ὅμηρος ἔφασκ' ἰκέλην εἶναι τρήρωνι πελείῃ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:576.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:576.1.text#ὁ Ζεὺς δ' ἡμῖν οὐ βροντήσας πέμψει πτερόεντα κεραυνόν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:577.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:577.1.text#ἢν δ' οὖν ὑμᾶς μὲν ὑπ' ἀγνοίας εἶναι νομίσωσι τὸ μηδέν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:578.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:578.1.text#τούτους δὲ θεοὺς τοὺς ἐν Ὀλύμπῳ τότε χρὴ στρούθων νέφος ἀρθὲν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:579.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:579.1.text#καὶ σπερμολόγων ἐκ τῶν ἀγρῶν τὸ σπέρμ' αὐτῶν ἀνακάψαι·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:580.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:580.1.text#κἄπειτ' αὐτοῖς ἡ Δημήτηρ πυροὺς πεινῶσι μετρείτω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:581.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:581.1.text#οὐκ ἐθελήσει μὰ Δί', ἀλλ' ὄψει προφάσεις αὐτὴν παρέχουσαν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:582.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:582.1.text#οἱ δ' αὖ κόρακες τῶν ζευγαρίων, οἷσιν τὴν γῆν καταροῦσιν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:583.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:583.1.text#καὶ τῶν προβάτων τοὺς ὀφθαλμοὺς ἐκκοψάντων ἐπὶ πείρᾳ·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:584.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:584.1.text#εἶθ' ὅ γ' Ἀπόλλων ἰατρός γ' ὢν ἰάσθω· μισθοφορεῖ δέ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:585.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:585.1.text#μὴ πρίν γ' ἂν ἐγὼ τὼ βοιδαρίω τὠμὼ πρώτιστ' ἀποδῶμαι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:586.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:586.1.text#ἢν δ' ἡγῶνται σὲ θεὸν σὲ βίον σὲ δὲ γῆν σὲ Κρόνον σὲ Ποσειδῶ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:587.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:587.1.text#ἀγάθ' αὐτοῖσιν πάντα παρέσται.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:587.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:587.2.text#λέγε δή μοι τῶν ἀγαθῶν ἕν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:588.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:588.1.text#πρῶτα μὲν αὐτῶν τὰς οἰνάνθας οἱ πάρνοπες οὐ κατέδονται,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:589.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:589.1.text#ἀλλὰ γλαυκῶν λόχος εἷς αὐτοὺς καὶ κερχνῄδων ἐπιτρίψει.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:590.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:590.1.text#εἶθ' οἱ κνῖπες καὶ ψῆνες ἀεὶ τὰς συκᾶς οὐ κατέδονται,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:591.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:591.1.text#ἀλλ' ἀναλέξει πάντας καθαρῶς αὐτοὺς ἀγέλη μία κιχλῶν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:592.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:592.1.text#πλουτεῖν δὲ πόθεν δώσομεν αὐτοῖς; καὶ γὰρ τούτου σφόδρ' ἐρῶσιν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:593.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:593.1.text#τὰ μέταλλ' αὐτοῖς μαντευομένοις οὗτοι δώσουσι τὰ χρηστά,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:594.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:594.1.text#τάς τ' ἐμπορίας τὰς κερδαλέας πρὸς τὸν μάντιν κατεροῦσιν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:595.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:595.1.text#ὥστ' ἀπολεῖται τῶν ναυκλήρων οὐδείς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:595.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:595.2.text#πῶς οὐκ ἀπολεῖται;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:596.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:596.1.text#προερεῖ τις ἀεὶ τῶν ὀρνίθων μαντευομένῳ περὶ τοῦ πλοῦ·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:597.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:597.1.text# "νυνὶ μὴ πλεῖ, χειμὼν ἔσται·" "νυνὶ πλεῖ, κέρδος ἐπέσται."
urn:cts:greekLit:tlg0019.tlg006.fu-sp:598.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:598.1.text#γαῦλον κτῶμαι καὶ ναυκληρῶ, κοὐκ ἂν μείναιμι παρ' ὑμῖν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:599.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:599.1.text#τοὺς θησαυρούς τ' αὐτοῖς δείξουσ' οὓς οἱ πρότεροι κατέθεντο
urn:cts:greekLit:tlg0019.tlg006.fu-sp:600.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:600.1.text#τῶν ἀργυρίων· οὗτοι γὰρ ἴσασι· λέγουσι δέ τοι τάδε πάντες,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:601.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:601.1.text# "οὐδεὶς οἶδεν τὸν θησαυρὸν τὸν ἐμὸν πλὴν εἴ τις ἄρ' ὄρνις."
urn:cts:greekLit:tlg0019.tlg006.fu-sp:602.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:602.1.text#πωλῶ γαῦλον, κτῶμαι σμινύην, καὶ τὰς ὑδρίας ἀνορύττω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:603.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:603.1.text#πῶς δ' ὑγιείαν δώσουσ' αὐτοῖς, οὖσαν παρὰ τοῖσι θεοῖσιν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:604.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:604.1.text#ἢν εὖ πράττωσ', οὐχ ὑγιεία μεγάλη τοῦτ' ἐστί; σάφ' ἴσθι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:605.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:605.1.text#ὡς ἄνθρωπός γε κακῶς πράττων ἀτεχνῶς οὐδεὶς ὑγιαίνει.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:606.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:606.1.text#πῶς δ' ἐς γῆράς ποτ' ἀφίξονται; καὶ γὰρ τοῦτ' ἔστ' ἐν Ὀλύμπῳ·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:607.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:607.1.text#ἢ παιδάρι' ὄντ' ἀποθνῄσκειν δεῖ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:607.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:607.2.text#μὰ Δί' ἀλλὰ τριακόσι' αὐτοῖς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:608.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:608.1.text#ἔτι προσθήσουσ' ὄρνιθες ἔτη.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:608.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:608.2.text#παρὰ τοῦ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:608.3.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:608.3.text#παρ' ὅτου; παρ' ἑαυτῶν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:609.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:609.1.text#οὐκ οἶσθ' ὅτι πέντ' ἀνδρῶν γενεὰς ζώει λακέρυζα κορώνη;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:610.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:610.1.text#αἰβοῖ πολλῷ κρείττους οὗτοι τοῦ Διὸς ἡμῖν βασιλεύειν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:611.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:611.1.text#οὐ γὰρ πολλῷ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:612.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:612.1.text#πρῶτον μέν γ' οὐχὶ νεὼς ἡμᾶς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:613.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:613.1.text#οἰκοδομεῖν δεῖ λιθίνους αὐτοῖς,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:614.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:614.1.text#οὐδὲ θυρῶσαι χρυσαῖσι θύραις,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:615.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:615.1.text#ἀλλ' ὑπὸ θάμνοις καὶ πρινιδίοις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:616.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:616.1.text#οἰκήσουσιν. τοῖς δ' αὖ σεμνοῖς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:617.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:617.1.text#τῶν ὀρνίθων δένδρον ἐλάας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:618.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:618.1.text#ὁ νεὼς ἔσται· κοὐκ ἐς Δελφοὺς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:619.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:619.1.text#οὐδ' εἰς Ἄμμων' ἐλθόντες ἐκεῖ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:620.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:620.1.text#θύσομεν, ἀλλ' ἐν ταῖσιν κομάροις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:621.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:621.1.text#καὶ τοῖς κοτίνοις στάντες ἔχοντες
urn:cts:greekLit:tlg0019.tlg006.fu-sp:622.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:622.1.text#κριθὰς πυροὺς εὐξόμεθ' αὐτοῖς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:623.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:623.1.text#ἀνατείνοντες τὼ χεῖρ' ἀγαθῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:624.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:624.1.text#διδόναι τι μέρος· καὶ ταῦθ' ἡμῖν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:625.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:625.1.text#παραχρῆμ' ἔσται
urn:cts:greekLit:tlg0019.tlg006.fu-sp:626.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:626.1.text#πυροὺς ὀλίγους προβαλοῦσιν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:627.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:627.1.text#ὦ φίλτατ' ἐμοὶ πολὺ πρεσβυτῶν ἐξ ἐχθίστου μεταπίπτων,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:628.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:628.1.text#οὐκ ἔστιν ὅπως ἂν ἐγώ ποθ' ἑκὼν τῆς σῆς γνώμης ἔτ' ἀφείμην.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:629.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:629.1.text#ἐπαυχήσας δὲ τοῖσι σοῖς λόγοις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:630.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:630.1.text#ἐπηπείλησα καὶ κατώμοσα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:631.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:631.1.text#ἢν σὺ παρ' ἐμὲ θέμενος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:632.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:632.1.text#ὁμόφρονας λόγους δικαίους
urn:cts:greekLit:tlg0019.tlg006.fu-sp:633.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:633.1.text#ἀδόλους ὁσίους
urn:cts:greekLit:tlg0019.tlg006.fu-sp:634.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:634.1.text#ἐπὶ θεοὺς ἴῃς, ἐμοὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:635.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:635.1.text#φρονῶν ξυνῳδά, μὴ πολὺν χρόνον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:636.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:636.1.text#θεοὺς ἔτι σκῆπτρα τἀμὰ τρίψειν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:637.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:637.1.text#ἀλλ' ὅσα μὲν δεῖ ῥώμῃ πράττειν, ἐπὶ ταῦτα τεταξόμεθ' ἡμεῖς·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:638.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:638.1.text#ὅσα δὲ γνώμῃ δεῖ βουλεύειν, ἐπὶ σοὶ τάδε πάντ' ἀνάκειται.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:639.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:639.1.text#καὶ μὴν μὰ τὸν Δί' οὐχὶ νυστάζειν ἔτι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:640.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:640.1.text#ὥρα 'στὶν ἡμῖν οὐδὲ μελλονικιᾶν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:641.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:641.1.text#ἀλλ' ὡς τάχιστα δεῖ τι δρᾶν· πρῶτον δέ γε
urn:cts:greekLit:tlg0019.tlg006.fu-sp:641a.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:641a.1.text#εἰσέλθετ' ἐς νεοττιάν γε τὴν ἐμὴν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:642.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:642.1.text#καὶ τἀμὰ κάρφη καὶ τὰ παρόντα φρύγανα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:643.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:643.1.text#καὶ τοὔνομ' ἡμῖν φράσατον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:643.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:643.2.text#ἀλλὰ ῥᾴδιον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:644.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:644.1.text#ἐμοὶ μὲν ὄνομα Πισθέταιρος, τῳδεδὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:645.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:645.1.text#Εὐελπίδης Κριῶθεν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:645.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:645.2.text#ἀλλὰ χαίρετον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:646.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:646.1.text#ἄμφω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:646.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:646.2.text#δεχόμεθα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:646.3.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:646.3.text#δεῦρο τοίνυν εἴσιτον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:647.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:647.1.text#ἴωμεν· εἰσηγοῦ σὺ λαβὼν ἡμᾶς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:647.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:647.2.text#ἴθι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:648.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:648.1.text#ἀτὰρ τὸ δεῖνα, δεῦρ' ἐπανάκρουσαι πάλιν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:649.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:649.1.text#φέρ' ἴδω, φράσον νῷν, πῶς ἐγώ τε χοὐτοσὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:650.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:650.1.text#ξυνεσόμεθ' ὑμῖν πετομένοις οὐ πετομένω;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:651.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:651.1.text#καλῶς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:651.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:651.2.text#ὅρα νυν, ὡς ἐν Αἰσώπου λόγοις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:652.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:652.1.text#ἐστὶν λεγόμενον δή τι, τὴν ἀλώπεχ', ὡς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:653.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:653.1.text#φλαύρως ἐκοινώνησεν αἰετῷ ποτέ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:654.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:654.1.text#μηδὲν φοβηθῇς· ἔστι γάρ τι ῥιζίον,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:655.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:655.1.text#ὃ διατραγόντ' ἔσεσθον ἐπτερωμένω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:656.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:656.1.text#οὕτω μὲν εἰσίωμεν. ἄγε δὴ Ξανθία
urn:cts:greekLit:tlg0019.tlg006.fu-sp:657.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:657.1.text#καὶ Μανόδωρε λαμβάνετε τὰ στρώματα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:658.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:658.1.text#οὗτος σὲ καλῶ, σὲ λέγω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:658.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:658.2.text#τί καλεῖς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:658.3.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:658.3.text#τούτους μὲν ἄγων μετὰ σαυτοῦ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:659.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:659.1.text#ἀρίστισον εὖ· τὴν δ' ἡδυμελῆ ξύμφωνον ἀηδόνα Μούσαις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:660.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:660.1.text#κατάλειφ' ἡμῖν δεῦρ' ἐκβιβάσας, ἵνα παίσωμεν μετ' ἐκείνης.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:661.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:661.1.text#ὦ τοῦτο μεντοι νὴ Δί' αὐτοῖσιν πιθοῦ·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:662.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:662.1.text#ἐκβίβασον ἐκ τοῦ βουτόμου τοὐρνίθιον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:663.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:663.1.text#ἐκβίβασον αὐτοῦ πρὸς θεῶν αὐτήν, ἵνα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:664.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:664.1.text#καὶ νὼ θεασώμεσθα τὴν ἀηδόνα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:665.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:665.1.text#ἀλλ' εἰ δοκεῖ σφῷν, ταῦτα χρὴ δρᾶν. ἡ Πρόκνη
urn:cts:greekLit:tlg0019.tlg006.fu-sp:666.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:666.1.text#ἔκβαινε καὶ σαυτὴν ἐπιδείκνυ τοῖς ξένοις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:667.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:667.1.text#ὦ Ζεῦ πολυτίμηθ' ὡς καλὸν τοὐρνίθιον,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:668.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:668.1.text#ὡς δ' ἁπαλόν, ὡς δὲ λευκόν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:668.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:668.2.text#ἆρά γ' οἶσθ' ὅτι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:669.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:669.1.text#ἐγὼ διαμηρίζοιμ' ἂν αὐτὴν ἡδέως;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:670.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:670.1.text#ὅσον δ' ἔχει τὸν χρυσόν, ὥσπερ παρθένος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:671.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:671.1.text#ἐγὼ μὲν αὐτὴν κἂν φιλῆσαί μοι δοκῶ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:672.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:672.1.text#ἀλλ' ὦ κακόδαιμον ῥύγχος ὀβελίσκοιν ἔχει.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:673.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:673.1.text#ἀλλ' ὥσπερ ᾠὸν νὴ Δί' ἀπολέψαντα χρὴ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:674.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:674.1.text#ἀπὸ τῆς κεφαλῆς τὸ λέμμα κᾆθ' οὕτω φιλεῖν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:675.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:675.1.text#ἴωμεν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:675.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:675.2.text#ἡγοῦ δὴ σὺ νῷν τύχἀγαθῇ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:676.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:676.1.text#ὦ φίλη, ὦ ξουθή,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:677.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:677.1.text#ὦ φίλτατον ὀρνέων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:678.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:678.1.text#πάντων, ξύννομε τῶν ἐμῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:679.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:679.1.text#ὕμνων, ξύντροφ' ἀηδοῖ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:680.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:680.1.text#ἦλθες ἦλθες ὤφθης,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:681.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:681.1.text#ἡδὺν φθόγγον ἐμοὶ φέρουσ'.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:682.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:682.1.text#ἀλλ' ὦ καλλιβόαν κρέκουσ'
urn:cts:greekLit:tlg0019.tlg006.fu-sp:683.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:683.1.text#αὐλὸν φθέγμασιν ἠρινοῖς,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:684.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:684.1.text#ἄρχου τῶν ἀναπαίστων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:685.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:685.1.text#ἄγε δὴ φύσιν ἄνδρες ἀμαυρόβιοι, φύλλων γενεᾷ προσόμοιοι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:686.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:686.1.text#ὀλιγοδρανέες, πλάσματα πηλοῦ, σκιοειδέα φῦλ' ἀμενηνά,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:687.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:687.1.text#ἀπτῆνες ἐφημέριοι ταλαοὶ βροτοὶ ἀνέρες εἰκελόνειροι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:688.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:688.1.text#προσέχετε τὸν νοῦν τοῖς ἀθανάτοις ἡμῖν τοῖς αἰὲν ἐοῦσιν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:689.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:689.1.text#τοῖς αἰθερίοις τοῖσιν ἀγήρῳς τοῖς ἄφθιτα μηδομένοισιν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:690.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:690.1.text#ἵν' ἀκούσαντες πάντα παρ' ἡμῶν ὀρθῶς περὶ τῶν μετεώρων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:691.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:691.1.text#φύσιν οἰωνῶν γένεσίν τε θεῶν ποταμῶν τ' Ἐρέβους τε Χάους τε
urn:cts:greekLit:tlg0019.tlg006.fu-sp:692.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:692.1.text#εἰδότες ὀρθῶς, Προδίκῳ παρ' ἐμοῦ κλάειν εἴπητε τὸ λοιπόν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:693.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:693.1.text#Χάος ἦν καὶ Νὺξ Ἔρεβός τε μέλαν πρῶτον καὶ Τάρταρος εὐρύς,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:694.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:694.1.text#γῆ δ' οὐδ' ἀὴρ οὐδ' οὐρανὸς ἦν· Ἐρέβους δ' ἐν ἀπείροσι κόλποις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:695.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:695.1.text#τίκτει πρώτιστον ὑπηνέμιον Νὺξ ἡ μελανόπτερος ᾠόν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:696.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:696.1.text#ἐξ οὖ περιτελλομέναις ὥραις ἔβλαστεν Ἔρως ὁ ποθεινός,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:697.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:697.1.text#στίλβων νῶτον πτερύγοιν χρυσαῖν, εἰκὼς ἀνεμώκεσι δίναις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:698.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:698.1.text#οὗτος δὲ Χάει πτερόεντι μιγεὶς νυχίῳ κατὰ Τάρταρον εὐρὺν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:699.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:699.1.text#ἐνεόττευσεν γένος ἡμέτερον, καὶ πρῶτον ἀνήγαγεν ἐς φῶς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:700.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:700.1.text#πρότερον δ' οὐκ ἦν γένος ἀθανάτων, πρὶν Ἔρως ξυνέμειξεν ἅπαντα·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:701.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:701.1.text#ξυμμιγνυμένων δ' ἑτέρων ἑτέροις γένετ' οὐρανὸς ὠκεανός τε
urn:cts:greekLit:tlg0019.tlg006.fu-sp:702.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:702.1.text#καὶ γῆ πάντων τε θεῶν μακάρων γένος ἄφθιτον. ὦδε μέν ἐσμεν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:703.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:703.1.text#πολὺ πρεσβύτατοι πάντων μακάρων. ἡμεῖς δ' ὡς ἐσμὲν Ἔρωτος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:704.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:704.1.text#πολλοῖς δῆλον· πετόμεσθά τε γὰρ καὶ τοῖσιν ἐρῶσι σύνεσμεν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:705.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:705.1.text#πολλοὺς δὲ καλοὺς ἀπομωμοκότας παῖδας πρὸς τέρμασιν ὥρας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:706.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:706.1.text#διὰ τὴν ἰσχὺν τὴν ἡμετέραν διεμήρισαν ἄνδρες ἐρασταί,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:707.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:707.1.text#ὁ μὲν ὄρτυγα δοὺς ὁ δὲ πορφυρίων' ὁ δὲ χῆν' ὁ δὲ Περσικὸν ὄρνιν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:708.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:708.1.text#πάντα δὲ θνητοῖς ἐστὶν ἀφ' ἡμῶν τῶν ὀρνίθων τὰ μέγιστα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:709.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:709.1.text#πρῶτα μὲν ὥρας φαίνομεν ἡμεῖς ἦρος χειμῶνος ὀπώρας·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:710.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:710.1.text#σπείρειν μέν, ὅταν γέρανος κρώζουσ' ἐς τὴν Λιβύην μεταχωρῇ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:711.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:711.1.text#καὶ πηδάλιον τότε ναυκλήρῳ φράζει κρεμάσαντι καθεύδειν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:712.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:712.1.text#εἶτα δ' Ὀρέστῃ χλαῖναν ὑφαίνειν, ἵνα μὴ ῥιγῶν ἀποδύῃ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:713.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:713.1.text#ἰκτῖνος δ' αὖ μετὰ ταῦτα φανεὶς ἑτέραν ὥραν ἀποφαίνει,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:714.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:714.1.text#ἡνίκα πεκτεῖν ὥρα προβάτων πόκον ἠρινόν· εἶτα χελιδών,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:715.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:715.1.text#ὅτε χρὴ χλαῖναν πωλεῖν ἤδη καὶ ληδάριόν τι πρίασθαι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:716.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:716.1.text#ἐσμὲν δ' ὑμῖν Ἄμμων Δελφοὶ Δωδώνη Φοῖβος Ἀπόλλων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:717.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:717.1.text#ἐλθόντες γὰρ πρῶτον ἐπ' ὄρνις οὕτω πρὸς ἅπαντα τρέπεσθε,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:718.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:718.1.text#πρός τ' ἐμπορίαν, καὶ πρὸς βιότου κτῆσιν, καὶ πρὸς γάμον ἀνδρός.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:719.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:719.1.text#ὄρνιν τε νομίζετε πάνθ' ὅσαπερ περὶ μαντείας διακρίνει·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:720.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:720.1.text#φήμη γ' ὑμῖν ὄρνις ἐστί, πταρμόν τ' ὄρνιθα καλεῖτε,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:721.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:721.1.text#ξύμβολον ὄρνιν, φωνὴν ὄρνιν, θεράποντ' ὄρνιν, ὄνον ὄρνιν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:722.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:722.1.text#ἆρ' οὐ φανερῶς ἡμεῖς ὑμῖν ἐσμὲν μαντεῖος Ἀπόλλων;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:723.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:723.1.text#ἢν οὖν ἡμᾶς νομίσητε θεούς,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:724.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:724.1.text#ἕξετε χρῆσθαι μάντεσι Μούσαις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:725.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:725.1.text#αὔραις ὥραις χειμῶνι θέρει
urn:cts:greekLit:tlg0019.tlg006.fu-sp:726.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:726.1.text#μετρίῳ πνίγει· κοὐκ ἀποδράντες
urn:cts:greekLit:tlg0019.tlg006.fu-sp:727.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:727.1.text#καθεδούμεθ' ἄνω σεμνυνόμενοι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:728.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:728.1.text#παρὰ ταῖς νεφέλαις ὥσπερ χὠ Ζεύς·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:729.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:729.1.text#ἀλλὰ παρόντες δώσομεν ὑμῖν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:730.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:730.1.text#αὐτοῖς, παισίν, παίδων παισίν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:731.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:731.1.text#πλουθυγιείαν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:732.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:732.1.text#εὐδαιμονίαν βίον εἰρήνην
urn:cts:greekLit:tlg0019.tlg006.fu-sp:733.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:733.1.text#νεότητα γέλωτα χοροὺς θαλίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:734.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:734.1.text#γάλα τ' ὀρνίθων. ὥστε παρέσται
urn:cts:greekLit:tlg0019.tlg006.fu-sp:735.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:735.1.text#κοπιᾶν ὑμῖν ὑπὸ τῶν ἀγαθῶν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:736.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:736.1.text#οὕτω πλουτήσετε πάντες.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:737.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:737.1.text#Μοῦσα λοχμαία,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:738.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:738.1.text#τιὸ τιὸ τιὸ τιὸ τιὸ τιὸ τιοτίγξ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:739.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:739.1.text#ποικίλη, μεθ' ἧς ἐγὼ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:740.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:740.1.text#νάπαισι καὶ κορυφαῖς ἐν ὀρείαις,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:741.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:741.1.text#τιὸ τιὸ τιὸ τιοτίγξ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:742.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:742.1.text#ἱζόμενος μελίας ἐπὶ φυλλοκόμου,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:743.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:743.1.text#τιὸ τιὸ τιὸ τιοτίγξ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:744.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:744.1.text#δι' ἐμῆς γένυος ξουθῆς μελέων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:745.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:745.1.text#Πανὶ νόμους ἱεροὺς ἀναφαίνω
urn:cts:greekLit:tlg0019.tlg006.fu-sp:746.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:746.1.text#σεμνά τε μητρὶ χορεύματ' ὀρείᾳ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:747.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:747.1.text#τοτοτοτοτοτοτοτοτοτίγξ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:748.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:748.1.text#ἔνθεν ὡστερεὶ μέλιττα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:749.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:749.1.text#Φρύνιχος ἀμβροσίων μελέων ἀπεβόσκετο καρπὸν ἀεὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:750.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:750.1.text#φέρων γλυκεῖαν ᾠδάν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:751.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:751.1.text#τιὸ τιὸ τιὸ τιοτίγξ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:752.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:752.1.text#εἰ μετ' ὀρνίθων τις ὑμῶν ὦ θεαταὶ βούλεται
urn:cts:greekLit:tlg0019.tlg006.fu-sp:753.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:753.1.text#διαπλέκειν ζῶν ἡδέως τὸ λοιπόν, ὡς ἡμᾶς ἴτω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:755.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:755.1.text#ὅσα γάρ ἐστιν ἐνθάδ' αἰσχρὰ τῷ νόμῳ κρατούμενα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:756.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:756.1.text#ταῦτα πάντ' ἐστὶν παρ' ἡμῖν τοῖσιν ὄρνισιν καλά.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:757.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:757.1.text#εἰ γὰρ ἐνθάδ' ἐστὶν αἰσχρὸν τὸν πατέρα τύπτειν νόμῳ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:758.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:758.1.text#τοῦτ' ἐκεῖ καλὸν παρ' ἡμῖν ἐστιν, ἤν τις τῷ πατρὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:759.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:759.1.text#προσδραμὼν εἴπῃ πατάξας, "αἶρε πλῆκτρον, εἰ μαχεῖ."
urn:cts:greekLit:tlg0019.tlg006.fu-sp:760.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:760.1.text#εἰ δὲ τυγχάνει τις ὑμῶν δραπέτης ἐστιγμένος,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:761.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:761.1.text#ἀτταγᾶς οὗτος παρ' ἡμῖν ποικίλος κεκλήσεται.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:762.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:762.1.text#εἰ δὲ τυγχάνει τις ὢν Φρὺξ μηδὲν ἦττον Σπινθάρου,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:763.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:763.1.text#φρυγίλος ὄρνις ἐνθάδ' ἔσται, τοῦ Φιλήμονος γένους.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:764.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:764.1.text#εἰ δὲ δοῦλός ἐστι καὶ Κὰρ ὥσπερ Ἐξηκεστίδης,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:765.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:765.1.text#φυσάτω πάππους παρ' ἡμῖν, καὶ φανοῦνται φράτερες.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:766.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:766.1.text#εἰ δ' ὁ Πεισίου προδοῦναι τοῖς ἀτίμοις τὰς πύλας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:767.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:767.1.text#βούλεται, πέρδιξ γενέσθω, τοῦ πατρὸς νεοττίον·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:768.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:768.1.text#ὡς παρ' ἡμῖν οὐδὲν αἰσχρόν ἐστιν ἐκπερδικίσαι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:769.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:769.1.text#τοιάδε κύκνοι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:770.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:770.1.text#τιὸ τιὸ τιὰ τιὸ τιὸ τιοτίγξ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:771.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:771.1.text#συμμιγῆ βοὴν ὁμοῦ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:772.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:772.1.text#πτεροῖς κρέκοντες ἴακχον Ἀπόλλω,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:773.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:773.1.text#τιὸ τιὸ τιὸ τιοτίγξ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:774.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:774.1.text#ὄχθῳ ἐφεζόμενοι παρ' Ἕβρον ποταμόν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:775.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:775.1.text#τιὸ τιὸ τιὸ τιοτίγξ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:776.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:776.1.text#διὰ δ' αἰθέριον νέφος ἦλθε βοά·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:777.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:777.1.text#πτῆξε δὲ φῦλά τε ποικίλα θηρῶν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:778.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:778.1.text#κύματά τ' ἔσβεσε νήνεμος αἴθρη,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:779.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:779.1.text#τοτοτοτοτοτοτοτοτοτίγξ·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:780.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:780.1.text#πᾶς δ' ἐπεκτύπησ' Ὄλυμπος·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:781.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:781.1.text#εἷλε δὲ θάμβος ἄνακτας· Ὀλυμπιάδες δὲ μέλος Χάριτες
urn:cts:greekLit:tlg0019.tlg006.fu-sp:782.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:782.1.text#Μοῦσαί τ' ἐπωλόλυξαν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:783.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:783.1.text#τιὸ τιὸ τιὸ τιοτίγξ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:785.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:785.1.text#οὐδέν ἐστ' ἄμεινον οὐδ' ἥδιον ἢ φῦσαι πτερά.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:786.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:786.1.text#αὐτίχ' ὑμῶν τῶν θεατῶν εἴ τις ἧν ὑπόπτερος,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:787.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:787.1.text#εἶτα πεινῶν τοῖς χοροῖσι τῶν τραγῳδῶν ἤχθετο,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:788.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:788.1.text#ἐκπτόμενος ἂν οὗτος ἠρίστησεν ἐλθὼν οἴκαδε,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:789.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:789.1.text#κᾆτ' ἂν ἐμπλησθεὶς ἐφ' ἡμᾶς αὖθις αὖ κατέπτετο.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:790.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:790.1.text#εἴ τε Πατροκλείδης τις ὑμῶν τυγχάνει χεζητιῶν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:791.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:791.1.text#οὐκ ἂν ἐξίδισεν ἐς θοἰμάτιον, ἀλλ' ἀνέπτετο,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:792.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:792.1.text#κἀποπαρδὼν κἀναπνεύσας αὖθις αὖ κατέπτετο·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:793.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:793.1.text#εἴ τε μοιχεύων τις ὑμῶν ἐστιν ὅστις τυγχάνει,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:794.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:794.1.text#κᾆθ' ὁρᾷ τὸν ἄνδρα τῆς γυναικὸς ἐν βουλευτικῷ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:795.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:795.1.text#οὗτος ἂν πάλιν παρ' ὑμῶν πτερυγίσας ἀνέπτετο,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:796.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:796.1.text#εἶτα βινήσας ἐκεῖθεν αὖθις αὖ κατέπτετο.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:797.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:797.1.text#ἆρ' ὑπόπτερον γενέσθαι παντός ἐστιν ἄξιον;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:798.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:798.1.text#ὡς Διειτρέφης γε πυτιναῖα μόνον ἔχων πτερὰ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:799.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:799.1.text#ᾑρέθη φύλαρχος, εἶθ' ἵππαρχος, εἶτ' ἐξ οὐδενὸς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:800.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:800.1.text#μεγάλα πράττει κἀστὶ νυνὶ ξουθὸς ἱππαλεκτρυών.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:801.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:801.1.text#ταυτὶ τοιαυτί· μὰ Δί' ἐγὼ μὲν πρᾶγμά πω
urn:cts:greekLit:tlg0019.tlg006.fu-sp:802.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:802.1.text#γελοιότερον οὐκ εἶδον οὐδεπώποτε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:803.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:803.1.text#ἐπὶ τῷ γελᾷς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:803.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:803.2.text#ἐπὶ τοῖσι σοῖς ὠκυπτέροις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:804.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:804.1.text#οἶσθ' ᾧ μάλιστ' ἔοικας ἐπτερωμένος;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:805.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:805.1.text#εἰς εὐτέλειαν χηνὶ συγγεγραμμένῳ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:806.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:806.1.text#σὺ δὲ κοψίχῳ γε σκάφιον ἀποτετιλμένῳ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:807.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:807.1.text#ταυτὶ μὲν ᾐκάσμεσθα κατὰ τὸν Αἰσχύλον·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:808.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:808.1.text#τάδ' οὐχ ὑπ' ἄλλων ἀλλὰ τοῖς αὑτῶν πτεροῖς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:809.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:809.1.text#ἄγε δὴ τί χρὴ δρᾶν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:809.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:809.2.text#πρῶτον ὄνομα τῇ πόλει
urn:cts:greekLit:tlg0019.tlg006.fu-sp:810.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:810.1.text#θέσθαι τι μέγα καὶ κλεινόν, εἶτα τοῖς θεοῖς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:811.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:811.1.text#θῦσαι μετὰ τοῦτο.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:811.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:811.2.text#ταῦτα κἀμοὶ συνδοκεῖ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:812.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:812.1.text#φέρ' ἴδω, τί δ' ἡμῖν τοὔνομ' ἔσται τῇ πόλει;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:813.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:813.1.text#βούλεσθε τὸ μέγα τοῦτο τοὐκ Λακεδαίμονος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:814.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:814.1.text#Σπάρτην ὄνομα καλῶμεν αὐτήν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:814.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:814.2.text#Ἡράκλεις·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:815.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:815.1.text#Σπάρτην γὰρ ἂν θείμην ἐγὼ τἠμῇ πόλει;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:816.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:816.1.text#οὐδ' ἂν χαμεύνῃ πάνυ γε κειρίαν γ' ἔχων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:817.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:817.1.text#τί δῆτ' ὄνομ' αὐτῇ θησόμεσθ';
urn:cts:greekLit:tlg0019.tlg006.fu-sp:817.2.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:817.2.text#ἐντευθενὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:818.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:818.1.text#ἐκ τῶν νεφελῶν καὶ τῶν μετεώρων χωρίων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:819.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:819.1.text#χαῦνόν τι πάνυ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:819.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:819.2.text#βούλει Νεφελοκοκκυγίαν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:820.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:820.1.text#ἰοὺ ἰού·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:820a.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:820a.1.text#καλόν γ' ἀτεχνῶς σὺ καὶ μέγ' ηὗρες τοὔνομα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:821.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:821.1.text#ἆρ' ἐστὶν αὑτηγὶ Νεφελοκοκκυγία,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:822.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:822.1.text#ἵνα καὶ τὰ Θεογένους τὰ πολλὰ χρήματα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:822.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:822.2.text#τά τ' Αἰσχίνου γ' ἅπαντα;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:823.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:823.1.text#καὶ λῷστον μὲν οὖν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:824.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:824.1.text#τὸ Φλέγρας πεδίον, ἵν' οἱ θεοὶ τοὺς γηγενεῖς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:825.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:825.1.text#ἀλαζονευόμενοι καθυπερηκόντισαν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:826.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:826.1.text#λιπαρὸν τὸ χρῆμα τῆς πόλεως. τίς δαὶ θεὸς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:827.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:827.1.text#πολιοῦχος ἔσται; τῷ ξανοῦμεν τὸν πέπλον;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:828.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:828.1.text#τί δ' οὐκ Ἀθηναίαν ἐῶμεν Πολιάδα;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:829.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:829.1.text#καὶ πῶς ἂν ἔτι γένοιτ' ἂν εὔτακτος πόλις,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:830.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:830.1.text#ὅπου θεὸς γυνὴ γεγονυῖα πανοπλίαν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:831.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:831.1.text#ἕστηκ' ἔχουσα, Κλεισθένης δὲ κερκίδα;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:832.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:832.1.text#τίς δαὶ καθέξει τῆς πόλεως τὸ Πελαργικόν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:833.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:833.1.text#ὄρνις ἀφ' ἡμῶν τοῦ γένους τοῦ Περσικοῦ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:834.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:834.1.text#ὅσπερ λέγεται δεινότατος εἶναι πανταχοῦ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:835.1.speaker#Ἔποψ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:835.1.text#Ἄρεως νεοττός.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:835.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:835.2.text#ὦ νεοττὲ δέσποτα·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:836.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:836.1.text#ὡς δ' ὁ θεὸς ἐπιτήδειος οἰκεῖν ἐπὶ πετρῶν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:837.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:837.1.text#ἄγε νυν σὺ μὲν βάδιζε πρὸς τὸν ἀέρα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:838.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:838.1.text#καὶ τοῖσι τειχίζουσι παραδιακόνει,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:839.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:839.1.text#χάλικας παραφόρει, πηλὸν ἀποδὺς ὄργασον,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:840.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:840.1.text#λεκάνην ἀνένεγκε, κατάπεσ' ἀπὸ τῆς κλίμακος,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:841.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:841.1.text#φύλακας κατάστησαι, τὸ πῦρ ἔγκρυπτ' ἀεί,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:842.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:842.1.text#κωδωνοφορῶν περίτρεχε καὶ κάθευδ' ἐκεῖ·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:843.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:843.1.text#κήρυκα δὲ πέμψον τὸν μὲν ἐς θεοὺς ἄνω,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:844.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:844.1.text#ἕτερον δ' ἄνωθεν ἆυ παρ' ἀνθρώπους κάτω,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:845.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:845.1.text#κἀκεῖθεν αὖθις παρ' ἐμέ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:845.2.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:845.2.text#σὺ δέ γ' αὐτοῦ μένων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:846.1.speaker#Ἐυελπίδης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:846.1.text#οἴμωζε παρ' ἔμ'.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:846.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:846.2.text#ἴθ' ὦγάθ' οἷ πέμπω σ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:847.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:847.1.text#οὐδὲν γὰρ ἄνευ σοῦ τῶνδ' ἃ λέγω πεπράξεται.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:848.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:848.1.text#ἐγὼ δ' ἵνα θύσω τοῖσι καινοῖσιν θεοῖς,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:849.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:849.1.text#τὸν ἱερέα πέμψοντα τὴν πομπὴν καλῶ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:850.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:850.1.text#παῖ παῖ, τὸ κανοῦν αἴρεσθε καὶ τὴν χέρνιβα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:851.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:851.1.text#ὁμορροθῶ, συνθέλω,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:852.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:852.1.text#συμπαραινέσας ἔχω
urn:cts:greekLit:tlg0019.tlg006.fu-sp:853.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:853.1.text#προσόδια μεγάλα σεμνὰ προσιέναι θεοῖσιν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:855.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:855.1.text#ἅμα δὲ προσέτι χάριτος ἕνεκα προβάτιόν τι θύειν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:856.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:856.1.text#ἴτω ἴτω δὲ Πυθιὰς βοὰ θεῷ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:857.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:857.1.text#συνᾳδέτω δὲ Χαῖρις ᾠδάν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:859.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:859.1.text#παῦσαι σὺ φυσῶν. Ἡράκλεις τουτὶ τί ἦν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:860.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:860.1.text#τουτὶ μὰ Δί' ἐγὼ πολλὰ δὴ καὶ δείν' ἰδὼν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:861.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:861.1.text#οὔπω κόρακ' εἶδον ἐμπεφορβειωμένον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:862.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:862.1.text#ἱερεῦ σὸν ἔργον, θῦε τοῖς καινοῖς θεοῖς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:864.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:864.1.text#δράσω τάδ'. ἀλλὰ ποῦ 'στιν ὁ τὸ κανοῦν ἔχων;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:865.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:865.1.text#εὔχεσθε τῇ Ἑστίᾳ τῇ ὀρνιθείῳ καὶ τῷ ἰκτίνῳ τῷ ἑστιούχῳ καὶ ὄρνισιν Ὀλυμπίοις καὶ Ὀλυμπίῃσι πᾶσι καὶ πάσῃσιν —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:866.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:866.1.text#ὦ Σουνιέρακε χαῖρ' ἄναξ Πελαργικέ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:867.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:867.1.text#καὶ κύκνῳ Πυθίῳ καὶ Δηλίῳ καὶ Λητοῖ Ὀρτυγομήτρᾳ καὶ Ἀρτέμιδι Ἀκαλανθίδι —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:868.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:868.1.text#οὐκέτι Κολαινὶς ἀλλ' Ἀκαλανθὶς Ἄρτεμις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:876.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:876.1.text#καὶ φρυγίλῳ Σαβαζίῳ καὶ στρούθῳ μεγάλῃ μητρὶ θεῶν καὶ ἀνθρώπων —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:877.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:877.1.text#δέσποινα Κυβέλη, στροῦθε, μῆτερ Κλεοκρίτου.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:878.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:878.1.text#διδόναι Νεφελοκοκκυγιεῦσιν ὑγιείαν καὶ σωτηρίαν αὐτοῖσι καὶ Χίοισι —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:880.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:880.1.text#Χίοισιν ἥσθην πανταχοῦ προσκειμένοις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:881.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:881.1.text#καὶ ἥρωσιν ὄρνισι καὶ ἡρώων παισί, πορφυρίωνι καὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:886.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:886.1.text#πελεκᾶντι καὶ πελεκίνῳ καὶ φλέξιδι καὶ τέτρακι καὶ ταὧνι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:887.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:887.1.text#καὶ ἐλεᾷ καὶ βασκᾷ καὶ ἐλασᾷ καὶ ἐρωδιῷ καὶ καταρράκτῃ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:888.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:888.1.text#καὶ μελαγκορύφῳ καὶ αἰγιθάλλῳ —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:889.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:889.1.text#παῦ' ἐς κόρακας, παῦσαι καλῶν. ἰοὺ ἰού,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:890.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:890.1.text#ἐπὶ ποῖον ὦ κακόδαιμον ἱερεῖον καλεῖς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:891.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:891.1.text#ἁλιαιέτους καὶ γῦπας; οὐχ ὁρᾷς ὅτι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:892.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:892.1.text#ἰκτῖνος εἷς ἂν τοῦτό γ' οἴχοιθ' ἁρπάσας;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:893.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:893.1.text#ἄπελθ' ἀφ' ἡμῶν καὶ σὺ καὶ τὰ στέμματα·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:894.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:894.1.text#ἐγὼ γὰρ αὐτὸς τουτογὶ θύσω μόνος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:895.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:895.1.text#εἶτ' αὖθις αὖ τἄρα σοι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:896.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:896.1.text#δεῖ με δεύτερον μέλος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:899.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:899.1.text#χέρνιβι θεοσεβὲς ὅσιον ἐπιβοᾶν, καλεῖν δὲ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:900.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:900.1.text#μάκαρας, ἕνα τινὰ μόνον, εἴπερ ἱκανὸν ἕξετ' ὄψον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:901.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:901.1.text#τὰ γὰρ παρόντα θύματ' οὐδὲν ἄλλο πλὴν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:902.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:902.1.text#γένειόν ἐστι καὶ κέρατα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:903.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:903.1.text#θύοντες εὐξώμεσθα τοῖς πτερίνοις θεοῖς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:904.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:904.1.text#Νεφελοκοκκυγίαν τὰν εὐδαίμονα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:905.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:905.1.text#κλῇσον ὦ Μοῦσα τεαῖς ἐν ὓμνων ἀοιδαῖς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:906.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:906.1.text#τουτὶ τὸ πρᾶγμα ποδαπόν; εἰπέ μοι τίς εἶ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:907.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:907.1.text#ἐγὼ μελιγλώσσων ἐπέων ἱεὶς ἀοιδὰν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:908.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:908.1.text#Μουσάων θεράπων ὀτρηρός,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:910.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:910.1.text#κατὰ τὸν Ὅμηρον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:911.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:911.1.text#ἔπειτα δῆτα δοῦλος ὢν κόμην ἔχεις;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:912.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:912.1.text#οὔκ, ἀλλὰ πάντες ἐσμὲν οἱ διδάσκαλοι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:913.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:913.1.text#Μουσάων θεράποντες ὀτρηροί,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:914.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:914.1.text#κατὰ τὸν Ὅμηρον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:915.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:915.1.text#οὐκ ἐτὸς ὀτρηρὸν καὶ τὸ ληδάριον ἔχεις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:916.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:916.1.text#ἀτὰρ ὦ ποιητὰ κατὰ τί δεῦρ' ἀνεφθάρης;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:917.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:917.1.text#μέλη πεποίηκ' ἐς τὰς Νεφελοκοκκυγίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:918.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:918.1.text#τὰς ὑμετέρας κύκλιά τε πολλὰ καὶ καλὰ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:919.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:919.1.text#καὶ παρθένεια καὶ κατὰ τὰ Σιμωνίδου.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:920.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:920.1.text#ταυτὶ σὺ πότ' ἐποίησας; ἀπὸ ποίου χρόνου;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:921.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:921.1.text#πάλαι πάλαι δὴ τήνδ' ἐγὼ κλῄζω πόλιν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:922.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:922.1.text#οὐκ ἄρτι θύω τὴν δεκάτην ταύτης ἐγώ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:923.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:923.1.text#καὶ τοὔνομ' ὥσπερ παιδίῳ νῦν δὴ 'θέμην;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:924.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:924.1.text#ἀλλά τις ὠκεῖα Μουσάων φάτις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:925.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:925.1.text#οἷάπερ ἵππων ἀμαρυγά.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:926.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:926.1.text#σὺ δὲ πάτερ κτίστορ Αἴτνας,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:927.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:927.1.text#ζαθέων ἱερῶν ὁμώνυμε,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:928.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:928.1.text#δὸς ἐμὶν ὅ τι περ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:929.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:929.1.text#τεᾷ κεφαλᾷ θέλῃς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:930.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:930.1.text#πρόφρων δόμεν ἐμὶν τείν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:931.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:931.1.text#τουτὶ παρέξει τὸ κακὸν ἡμῖν πράγματα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:932.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:932.1.text#εἰ μή τι τούτῳ δόντες ἀποφευξούμεθα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:933.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:933.1.text#οὗτος, σὺ μέντοι σπολάδα καὶ χιτῶν' ἔχεις,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:934.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:934.1.text#ἀπόδυθι καὶ δὸς τῷ ποιητῇ τῷ σοφῷ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:935.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:935.1.text#ἔχε τὴν σπολάδα· πάντως δέ μοι ῥιγῶν δοκεῖς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:936.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:936.1.text#τόδε μὲν οὐκ ἀέκουσα φίλα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:937.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:937.1.text#Μοῦσα δῶρον δέχεται·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:938.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:938.1.text#τὺ δὲ τεᾷ φρενὶ μάθε Πινδάρειον ἔπος —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:940.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:940.1.text#ἅνθρωπος ἡμῶν οὐκ ἀπαλλαχθήσεται.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:941.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:941.1.text#νομάδεσσι γὰρ ἐν Σκύθαις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:942.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:942.1.text#ἀλᾶται Στράτων,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:943.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:943.1.text#ὃς ὑφαντοδόνατον ἔσθος οὐ πέπαται·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:944.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:944.1.text#ἀκλεὴς δ' ἔβα σπολὰς ἄνευ χιτῶνος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:945.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:945.1.text#ξύνες ὅ τοι λέγω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:946.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:946.1.text#ξυνῆχ' ὅτι βούλει τὸν χιτωνίσκον λαβεῖν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:947.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:947.1.text#ἀπόδυθι· δεῖ γὰρ τὸν ποιητὴν ὠφελεῖν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:948.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:948.1.text#ἄπελθε τουτονὶ λαβών.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:948.2.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:948.2.text#ἀπέρχομαι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:949.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:949.1.text#κἀς τὴν πόλιν γ' ἐλθὼν ποιήσω τοιαδί·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:950.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:950.1.text#"κλῇσον ὦ χρυσόθρονε τὰν τρομερὰν κρυεράν·"
urn:cts:greekLit:tlg0019.tlg006.fu-sp:951.1.speaker#Ποιητής
urn:cts:greekLit:tlg0019.tlg006.fu-sp:951.1.text#"νιφόβολα πεδία πολύπορά τ' ἤλυθον ἀλαλάν."
urn:cts:greekLit:tlg0019.tlg006.fu-sp:952.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:952.1.text#νὴ τὸν Δί' ἀλλ' ἤδη πέφευγας ταυταγὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:955.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:955.1.text#τὰ κρυερὰ τονδὶ τὸν χιτωνίσκον λαβών.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:956.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:956.1.text#τουτὶ μὰ Δί' ἐγὼ τὸ κακὸν οὐδέποτ' ἤλπισα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:957.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:957.1.text#οὕτω ταχέως τοῦτον πεπύσθαι τὴν πόλιν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:958.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:958.1.text#αὖθις σὺ περιχώρει λαβὼν τὴν χέρνιβα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:959.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:959.1.text#εὐφημία 'στω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:959.2.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:959.2.text#μὴ κατάρξῃ τοῦ τράγου.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:960.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:960.1.text#σὺ δ' εἶ τίς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:960.2.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:960.2.text#ὅστις; χρησμολόγος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:960.3.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:960.3.text#οἴμωζέ νυν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:961.1.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:961.1.text#ὦ δαιμόνιε τὰ θεῖα μὴ φαύλως φέρε·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:962.1.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:962.1.text#ὡς ἔστι Βάκιδος χρησμὸς ἄντικρυς λέγων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:963.1.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:963.1.text#ἐς τὰς Νεφελοκοκκυγίας.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:963.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:963.2.text#κὔπειτα πῶς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:964.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:964.1.text#ταῦτ' οὐκ ἐχρησμολόγεις σὺ πρὶν ἐμὲ τὴν πόλιν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:965.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:965.1.text#τήνδ' οἰκίσαι;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:965.2.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:965.2.text#τὸ θεῖον ἐνεπόδιζέ με.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:966.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:966.1.text#ἀλλ' οὐδὲν οἷόν ἐστ' ἀκοῦσαι τῶν ἐπῶν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:967.1.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:967.1.text#ἀλλ' ὅταν οἰκήσωσι λύκοι πολιαί τε κορῶναι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:968.1.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:968.1.text#ἐν ταὐτῷ τὸ μεταξὺ Κορίνθου καὶ Σικυῶνος, —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:969.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:969.1.text#τί οὖν προσήκει δῆτ' ἐμοὶ Κορινθίων;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:970.1.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:970.1.text#ᾐνίξαθ' ὁ Βάκις τοῦτο πρὸς τὸν ἀέρα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:971.1.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:971.1.text#πρῶτον Πανδώρᾳ θῦσαι λευκότριχα κριόν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:972.1.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:972.1.text#ὃς δέ κ' ἐμῶν ἐπέων ἔλθῃ πρώτιστα προφήτης,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:973.1.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:973.1.text#τῷ δόμεν ἱμάτιον καθαρὸν καὶ καινὰ πέδιλα —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:974.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:974.1.text#ἔνεστι καὶ τὰ πέδιλα;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:974.2.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:974.2.text#λαβὲ τὸ βιβλίον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:975.1.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:975.1.text#καὶ φιάλην δοῦναι, καὶ σπλάγχνων χεῖρ' ἐπιπλῆσαι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:976.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:976.1.text#καὶ σπλάγχνα διδόν' ἔνεστι;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:976.2.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:976.2.text#λαβὲ τὸ βιβλίον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:977.1.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:977.1.text#κἂν μὲν θέσπιε κοῦρε ποιῇς ταῦθ' ὡς ἐπιτέλλω,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:978.1.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:978.1.text#αἰετὸς ἐν νεφέλῃσι γενήσεαι· αι' δέ κε μὴ δῷς,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:979.1.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:979.1.text#οὐκ ἔσει οὐ τρυγὼν οὐδ' αἰετὸς οὐ δρυκολάπτης.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:980.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:980.1.text#καὶ ταῦτ' ἔνεστ' ἐνταῦθα;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:980.2.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:980.2.text#λαβὲ τὸ βιβλίον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:981.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:981.1.text#οὐδὲν ἄρ' ὅμοιός ἐσθ' ὁ χρησμὸς τουτῳί,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:982.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:982.1.text#ὃν ἐγὼ παρὰ τἀπόλλωνος ἐξεγραψάμην·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:983.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:983.1.text#αὐτὰρ ἐπὴν ἄκλητος ἰὼν ἄνθρωπος ἀλαζὼν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:984.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:984.1.text#λυπῇ θύοντας καὶ σπλαγχνεύειν ἐπιθυμῇ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:985.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:985.1.text#δὴ τότε χρὴ τύπτειν αὐτὸν πλευρῶν τὸ μεταξὺ —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:986.1.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:986.1.text#οὐδὲν λέγειν οἶμαί σε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:986.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:986.2.text#λαβὲ τὸ βιβλίον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:987.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:987.1.text#καὶ φείδου μηδὲν μηδ' αἰετοῦ ἐν νεφέλῃσιν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:988.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:988.1.text#μήτ' ἢν Λάμπων ᾖ μήτ' ἢν ὁ μέγας Διοπείθης.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:989.1.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:989.1.text#καὶ ταῦτ' ἔνεστ' ἐνταῦθα;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:989.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:989.2.text#λαβὲ τὸ βιβλίον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:990.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:990.1.text#οὐκ εἶ θύραζ'; ἐς κόρακας.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:990.2.speaker#Χρησμολόγος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:990.2.text#οἴμοι δείλαιος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:991.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:991.1.text#οὔκουν ἑτέρωσε χρησμολογήσεις ἐκτρέχων;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:992.1.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:992.1.text#ἥκω παρ' ὑμᾶς —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:992.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:992.2.text#ἕτερον αὖ τουτὶ κακόν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:993.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:993.1.text#τί δ' αὖ σὺ δράσων; τίς δ' ἰδέα βουλεύματος;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:994.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:994.1.text#τίς ἡ 'πίνοια, τίς ὁ κόθορνος τῆς ὁδοῦ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:995.1.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:995.1.text#γεωμετρῆσαι βούλομαι τὸν ἀέρα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:996.1.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:996.1.text#ὑμῖν διελεῖν τε κατὰ γύας.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:996.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:996.2.text#πρὸς τῶν θεῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:997.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:997.1.text#σὺ δ' εἶ τίς ἀνδρῶν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:997.2.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:997.2.text#ὅστις εἴμ' ἐγώ; Μέτων,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:998.1.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:998.1.text#ὃν οἶδεν Ἑλλὰς χὠ Κολωνός.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:998.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:998.2.text#εἰπέ μοι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:999.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:999.1.text#ταυτὶ δέ σοι τί ἔστι;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:999.2.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:999.2.text#κανόνες ἀέρος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1000.1.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1000.1.text#αὐτίκα γὰρ ἀήρ ἐστι τὴν ἰδέαν ὅλος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1001.1.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1001.1.text#κατὰ πνιγέα μάλιστα. προσθεὶς οὖν ἐγὼ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1002.1.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1002.1.text#τὸν κανόν', ἄνωθεν τουτονὶ τὸν καμπύλον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1003.1.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1003.1.text#ἐνθεὶς διαβήτην — μανθάνεις;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1004.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1004.1.text#οὐ μανθάνω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1004.2.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1004.2.text#ὀρθῷ μετρήσω κανόνι προστιθείς, ἵνα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1005.1.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1005.1.text#ὁ κύκλος γένηται σοι τετράγωνος κἀν μέσῳ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1006.1.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1006.1.text#ἀγορά, φέρουσαι δ' ὦσιν εἰς αὐτὴν ὁδοὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1007.1.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1007.1.text#ὀρθαὶ πρὸς αὐτὸ τὸ μέσον, ὥσπερ δ' ἀστέρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1008.1.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1008.1.text#αὐτοῦ κυκλοτεροῦς ὄντος ὀρθαὶ πανταχῇ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1009.1.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1009.1.text#ἀκτῖνες ἀπολάμπωσιν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1009.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1009.2.text#ἅνθρωπος Θαλῆς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1010.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1010.1.text#Μέτων —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1010.2.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1010.2.text#τί ἔστιν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1010.3.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1010.3.text#οἶσθ' ὁτιὴ φιλῶ σ' ἐγώ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1011.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1011.1.text#κἀμοὶ πιθόμενος ὑπαποκίνει τῆς ὁδοῦ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1012.1.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1012.1.text#τί δ' ἐστὶ δεινόν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1012.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1012.2.text#ὥσπερ ἐν Λακεδαίμονι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1013.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1013.1.text#ξενηλατοῦνται καὶ κεκίνηνταί τινες·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1014.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1014.1.text#πληγαὶ συχναὶ κατ' ἄστυ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1014.2.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1014.2.text#μῶν στασιάζετε;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1015.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1015.1.text#μὰ τὸν Δί' οὐ δῆτ'.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1015.2.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1015.2.text#ἀλλὰ πῶς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1015.3.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1015.3.text#ὁμοθυμαδὸν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1016.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1016.1.text#σποδεῖν ἅπαντας τοὺς ἀλαζόνας δοκεῖ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1017.1.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1017.1.text#ὑπάγοιμί τἄρ' ἄν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1017.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1017.2.text#νὴ Δί' ὡς οὐκ οἶδ' ἂν εἰ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1018.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1018.1.text#φθαίης ἄν· ἐπίκεινται γὰρ ἐγγὺς αὑταιί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1019.1.speaker#Μέτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1019.1.text#οἴμοι κακοδαίμων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1019.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1019.2.text#οὐκ ἔλεγον ἐγὼ πάλαι;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1020.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1020.1.text#οὐκ ἀναμετρήσεις σαυτὸν ἀπιὼν ἀλλαχῇ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1021.1.speaker#Ἐπίσκοπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1021.1.text#ποῦ πρόξενοι;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1021.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1021.2.text#τίς ὁ Σαρδανάπαλλος οὑτοσί;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1022.1.speaker#Ἐπίσκοπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1022.1.text#ἐπίσκοπος ἥκω δεῦρο τῷ κυάμῳ λαχὼν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1023.1.speaker#Ἐπίσκοπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1023.1.text#ἐς τὰς Νεφελοκοκκυγίας.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1023.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1023.2.text#ἐπίσκοπος;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1024.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1024.1.text#ἔπεμψε δὲ τίς σε δεῦρο;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1024.2.speaker#Ἐπίσκοπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1024.2.text#φαῦλον βιβλίον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1025.1.speaker#Ἐπίσκοπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1025.1.text#Τελέου.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1025.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1025.2.text#τί; βούλει δῆτα τὸν μισθὸν λαβὼν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1026.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1026.1.text#μὴ πράγματ' ἔχειν ἀλλ' ἀπιέναι;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1026.2.speaker#Ἐπίσκοπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1026.2.text#νὴ τοὺς θεούς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1027.1.speaker#Ἐπίσκοπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1027.1.text#ἐκκλησιάσαι δ' οὖν ἐδεόμην οἴκοι μένων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1028.1.speaker#Ἐπίσκοπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1028.1.text#ἔστιν γὰρ ἃ δι' ἐμοῦ πέπρακται Φαρνάκῃ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1029.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1029.1.text#ἄπιθι λαβών· ἔστιν δ' ὁ μισθὸς οὑτοσί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1030.1.speaker#Ἐπίσκοπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1030.1.text#τουτὶ τί ἦν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1030.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1030.2.text#ἐκκλησία περὶ Φαρνάκου.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1031.1.speaker#Ἐπίσκοπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1031.1.text#μαρτύρομαι τυπτόμενος ὢν ἐπίσκοπος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1032.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1032.1.text#οὐκ ἀποσοβήσεις; οὐκ ἀποίσεις τὼ κάδω;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1033.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1033.1.text#οὐ δεινά; καὶ πέμπουσιν ἤδη 'πισκόπους
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1034.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1034.1.text#ἐς τὴν πόλιν, πρὶν καὶ τεθύσθαι τοῖς θεοῖς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1035.1.speaker#Ψηφισματοπώλης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1035.1.text#ἐὰν δ' ὁ Νεφελοκοκκυγιεὺς τὸν Ἀθηναῖον ἀδικῇ —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1036.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1036.1.text#τουτὶ τί ἔστιν αὖ κακὸν τὸ βιβλίον;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1037.1.speaker#Ψηφισματοπώλης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1037.1.text#ψηφισματοπώλης εἰμὶ καὶ νόμους νέους
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1038.1.speaker#Ψηφισματοπώλης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1038.1.text#ἥκω παρ' ὑμᾶς δεῦρο πωλήσων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1038.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1038.2.text#τὸ τί;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1040.1.speaker#Ψηφισματοπώλης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1040.1.text#χρῆσθαι Νεφελοκοκκυγιᾶς τοῖσδε τοῖς μέτροισι καὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1041.1.speaker#Ψηφισματοπώλης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1041.1.text#σταθμοῖσι καὶ ψηφίσμασι καθάπερ Ὀλοφύξιοι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1042.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1042.1.text#σὺ δέ γ' οἷσπερ ὡτοτύξιοι χρήσει τάχα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1043.1.speaker#Ψηφισματοπώλης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1043.1.text#οὗτος τί πάσχεις;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1044.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1044.1.text#οὐκ ἀποίσεις τοὺς νόμους;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1045.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1045.1.text#πικροὺς ἐγώ σοι τήμερον δείξω νόμους.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1046.1.speaker#Ἐπίσκοπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1046.1.text#καλοῦμαι Πισθέταιρον ὕβρεως ἐς τὸν Μουνιχιῶνα μῆνα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1047.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1047.1.text#ἄληθες οὗτος; ἔτι γὰρ ἐνταῦθ' ἦσθα σύ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1050.1.speaker#Ψηφισματοπώλης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1050.1.text#ἐὰν δέ τις ἐξελαύνῃ τοὺς ἄρχοντας καὶ μὴ δέχηται
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1051.1.speaker#Ψηφισματοπώλης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1051.1.text#κατὰ τὴν στήλην —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1052.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1052.1.text#οἴμοι κακοδαίμων, καὶ σὺ γὰρ ἐνταῦθ' ἦσθ' ἔτι;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1052a.1.speaker#Ἐπίσκοπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1052a.1.text#ἀπολῶ σε καὶ γράφω σε μυρίας δραχμάς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1053.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1053.1.text#ἐγὼ δὲ σοῦ γε τὼ κάδω διασκεδῶ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1054.1.speaker#Ψηφισματοπώλης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1054.1.text#μέμνησ' ὅτε τῆς στήλης κατετίλας ἑσπέρας;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1055.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1055.1.text#αἰβοῖ· λαβέτω τις αὐτόν. οὗτος οὐ μενεῖς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1056.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1056.1.text#ἀπίωμεν ἡμεῖς ὡς τάχιστ' ἐντευθενὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1057.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1057.1.text#θύσοντες εἴσω τοῖς θεοῖσι τὸν τράγον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1058.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1058.1.text#ἤδη 'μοὶ τῷ παντόπτᾳ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1059.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1059.1.text#καὶ παντάρχᾳ θνητοὶ πάντες
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1060.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1060.1.text#θύσουσ' εὐκταίαις εὐχαῖς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1061.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1061.1.text#πᾶσαν μὲν γὰρ γᾶν ὀπτεύω,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1062.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1062.1.text#σῴζω δ' εὐθαλεῖς καρποὺς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1063.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1063.1.text#κτείνων παμφύλων γένναν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1064.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1064.1.text#θηρῶν, ἂ πάντ' ἐν γαίᾳ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1065.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1065.1.text#ἐκ κάλυκος αὐξανόμενον γένυσι παμφάγοις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1066.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1066.1.text#δένδρεσί τ' ἐφημένα καρπὸν ἀποβόσκεται·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1067.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1067.1.text#κτείνω δ' οἳ κήπους εὐώδεις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1068.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1068.1.text#φθείρουσιν λύμαις ἐχθίσταις,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1069.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1069.1.text#ἑρπετά τε καὶ δάκετα πάνθ' ὅσαπερ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1070.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1070.1.text#ἔστιν ὑπ' ἐμᾶς πτέρυγος ἐν φοναῖς ὄλλυται.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1072.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1072.1.text#τῇδε μέντοι θἠμέρᾳ μάλιστ' ἐπαναγορεύεται,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1073.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1073.1.text#ἢν ἀποκτείνῃ τις ὑμῶν Διαγόραν τὸν Μήλιον,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1074.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1074.1.text#λαμβάνειν τάλαντον, ἤν τε τῶν τυράννων τίς τινα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1075.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1075.1.text#τῶν τεθνηκότων ἀποκτείνῃ, τάλαντον λαμβάνειν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1076.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1076.1.text#βουλόμεσθ' οὖν νυν ἀνειπεῖν ταὐτὰ χἠμεῖς ἐνθάδε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1077.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1077.1.text#ἢν ἀποκτείνῃ τις ὑμῶν Φιλοκράτη τὸν Στρούθιον,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1078.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1078.1.text#λήψεται τάλαντον, ἢν δὲ ζῶντά γ' ἀγάγῃ, τέτταρα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1079.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1079.1.text#ὅτι συνείρων τοὺς σπίνους πωλεῖ καθ' ἑπτὰ τοὐβολοῦ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1080.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1080.1.text#εἶτα φυσῶν τὰς κίχλας δείκνυσι καὶ λυμαίνεται,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1081.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1081.1.text#τοῖς τε κοψίχοισιν ἐς τὰς ῥῖνας ἐγχεῖ τὰ πτερά,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1082.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1082.1.text#τὰς περιστεράς θ' ὁμοίως ξυλλαβὼν εἵρξας ἔχει,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1083.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1083.1.text#κἀπαναγκάζει παλεύειν δεδεμένας ἐν δικτύῳ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1084.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1084.1.text#ταῦτα βουλόμεσθ' ἀνειπεῖν· κεἴ τις ὄρνιθας τρέφει
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1085.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1085.1.text#εἱργμένους ὑμῶν ἐν αὐλῇ, φράζομεν μεθιέναι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1086.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1086.1.text#ἢν δὲ μὴ πίθησθε, συλληφθέντες ὑπὸ τῶν ὀρνέων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1087.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1087.1.text#αὖθις ὑμεῖς αὖ παρ' ἡμῖν δεδεμένοι παλεύσετε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1088.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1088.1.text#εὔδαιμον φῦλον πτηνῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1089.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1089.1.text#οἰωνῶν, οἳ χειμῶνος μὲν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1090.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1090.1.text#χλαίνας οὐκ ἀμπισχνοῦνται·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1091.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1091.1.text#οὐδ' αὖ θερμὴ πνίγους ἡμᾶς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1092.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1092.1.text#ἀκτὶς τηλαυγὴς θάλπει·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1093.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1093.1.text#ἀλλ' ἀνθηρῶν λειμώνων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1094.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1094.1.text#φύλλων τ' ἐν κόλποις ναίω,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1095.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1095.1.text#ἡνίκ' ἂν ὁ θεσπέσιος ὀξὺ μέλος ἀχέτας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1096.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1096.1.text#θάλπεσι μεσημβρινοῖς ἡλιομανὴς βοᾷ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1097.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1097.1.text#χειμάζω δ' ἐν κοίλοις ἄντροις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1098.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1098.1.text#νύμφαοις οὐρείαις ξυμπαίζων·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1099.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1099.1.text#ἠρινά τε βοσκόμεθα παρθένια
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1100.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1100.1.text#λευκότροφα μύρτα Χαρίτων τε κηπεύματα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1102.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1102.1.text#τοῖς κριταῖς εἰπεῖν τι βουλόμεσθα τῆς νίκης πέρι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1103.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1103.1.text#ὅσ' ἀγάθ', ἢν κρίνωσιν ἡμᾶς, πᾶσιν αὐτοῖς δώσομεν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1104.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1104.1.text#ὥστε κρείττω δῶρα πολλῷ τῶν Ἀλεξάνδρου λαβεῖν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1105.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1105.1.text#πρῶτα μὲν γὰρ οὗ μάλιστα πᾶς κριτὴς ἐφίεται,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1106.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1106.1.text#γλαῦκες ὑμᾶς οὔποτ' ἐπιλείψουσι Λαυρειωτικαί·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1107.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1107.1.text#ἀλλ' ἐνοικήσουσιν ἔνδον, ἔν τε τοῖς βαλλαντίοις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1108.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1108.1.text#ἐννεοττεύσουσι κἀκλέψουσι μικρὰ κέρματα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1109.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1109.1.text#εἶτα πρὸς τούτοισιν ὥσπερ ἐν ἱεροῖς οἰκήσετε·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1110.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1110.1.text#τὰς γὰρ ὑμῶν οἰκίας ἐρέψομεν πρὸς αἰετόν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1111.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1111.1.text#κἂν λαχόντες ἀρχίδιον εἶθ' ἁρπάσαι βούλησθέ τι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1112.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1112.1.text#ὀξὺν ἱερακίσκον ἐς τὰς χεῖρας ὑμῖν δώσομεν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1113.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1113.1.text#ἢν δέ που δειπνῆτε, πρηγορεῶνας ὑμῖν πέμψομεν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1114.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1114.1.text#ἢν δὲ μὴ κρίνητε, χαλκεύεσθε μηνίσκους φορεῖν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1115.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1115.1.text#ὥσπερ ἀνδριάντες· ὡς ὑμῶν ὃς ἂν μὴ μῆν' ἔχῃ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1116.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1116.1.text#ὅταν ἔχητε χλανίδα λευκήν, τότε μάλισθ' οὕτω δίκην
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1117.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1117.1.text#δώσεθ' ἡμῖν, πᾶσι τοῖς ὄρνισι κατατιλώμενοι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1118.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1118.1.text#τὰ μὲν ἱέρ' ἡμῖν ἐστιν ὦρνιθες καλά·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1119.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1119.1.text#ἀλλ' ὡς ἀπὸ τοῦ τείχους πάρεστιν ἄγγελος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1120.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1120.1.text#οὐδείς, ὅτου πευσόμεθα τἀκεῖ πράγματα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1121.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1121.1.text#ἀλλ' οὑτοσὶ τρέχει τις Ἀλφειὸν πνέων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1122.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1122.1.text#ποῦ ποῦ 'στι, ποῦ ποῦ ποῦ 'στι, ποῦ ποῦ ποῦ 'στι ποῦ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1123.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1123.1.text#ποῦ Πισθέταιρός ἐστιν ἅρχων;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1123.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1123.2.text#οὑτοσί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1124.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1124.1.text#ἐξῳκοδόμηταί σοι τὸ τεῖχος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1124.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1124.2.text#εὖ λέγεις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1125.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1125.1.text#κάλλιστον ἔργον καὶ μεγαλοπρεπέστατον·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1126.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1126.1.text#ὥστ' ἂν ἐπάνω μὲν Προξενίδης ὁ Κομπασεὺς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1127.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1127.1.text#καὶ Θεογένης ἐναντίω δύ' ἅρματε,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1128.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1128.1.text#ἵππων ὑπόντων μέγεθος ὅσον ὁ δούριος,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1129.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1129.1.text#ὑπὸ τοῦ πλάτους ἂν παρελασαίτην.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1129.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1129.2.text#Ἡράκλεις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1130.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1130.1.text#τὸ δὲ μῆκός ἐστι, καὶ γὰρ ἐμέτρησ' αὔτ' ἐγώ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1131.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1131.1.text#ἑκατοντορόγυιον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1131.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1131.2.text#ὦ Πόσειδον τοῦ μάκρους.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1132.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1132.1.text#τίνες ᾠκοδόμησαν αὐτὸ τηλικουτονί;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1133.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1133.1.text#ὄρνιθες, οὐδεὶς ἄλλος, οὐκ Αἰγύπτιος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1134.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1134.1.text#πλινθοφόρος, οὐ λιθουργός, οὐ τέκτων παρῆν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1135.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1135.1.text#ἀλλ' αὐτόχειρες, ὥστε θαυμάζειν ἐμέ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1136.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1136.1.text#ἐκ μέν γε Λιβύης ἧκον ὡς τρισμύριαι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1137.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1137.1.text#γέρανοι θεμελίους καταπεπωκυῖαι λίθους.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1138.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1138.1.text#τούτους δ' ἐτύκιζον αἱ κρέκες τοῖς ῥύγχεσιν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1139.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1139.1.text#ἕτεροι δ' ἐπλινθοφόρουν πελαργοὶ μύριοι·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1140.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1140.1.text#ὕδωρ δ' ἐφόρουν κάτωθεν ἐς τὸν ἀέρα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1141.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1141.1.text#οἱ χαραδριοὶ καὶ τἄλλα ποτόμι' ὄρνεα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1142.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1142.1.text#ἐπηλοφόρουν δ' αὐτοῖσι τίνες;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1142.2.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1142.2.text#ἐρωδιοὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1143.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1143.1.text#λεκάναισι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1143.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1143.2.text#τὸν δὲ πηλὸν ἐνεβάλλοντο πῶς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1144.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1144.1.text#τοῦτ' ὦγάθ' ἐξηύρητο καὶ σοφώτατα·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1145.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1145.1.text#οἱ χῆνες ὑποτύπτοντες ὥσπερ ταῖς ἄμαις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1146.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1146.1.text#ἐς τὰς λεκάνας ἐνέβαλλον αὐτοῖς τοῖν ποδοῖν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1147.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1147.1.text#τί δῆτα πόδες ἂν οὐκ ἂν ἐργασαίατο;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1148.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1148.1.text#καὶ νὴ Δί' αἱ νῆτταί γε περιεζωσμέναι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1149.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1149.1.text#ἐπλινθοφόρουν· ἄνω δὲ τὸν ὑπαγωγέα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1150.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1150.1.text#ἐπέτοντ' ἔχουσαι κατόπιν †ὥσπερ παιδία
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1151.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1151.1.text#τὸν πηλὸν ἐν τοῖς στόμασιν† αἱ χελιδόνες.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1152.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1152.1.text#τί δῆτα μισθωτοὺς ἂν ἔτι μισθοῖτό τις;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1153.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1153.1.text#φέρ' ἴδω, τί δαί; τὰ ξύλινα τοῦ τείχους τίνες
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1154.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1154.1.text#ἀπηργάσαντ';
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1154.2.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1154.2.text#ὄρνιθες ἦσαν τέκτονες
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1155.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1155.1.text#σοφώτατοι πελεκᾶντες, οἳ τοῖς ῥύγχεσιν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1156.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1156.1.text#ἀπεπελέκησαν τὰς πύλας· ἦν δ' ὁ κτύπος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1157.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1157.1.text#αὐτῶν πελεκώντων ὥσπερ ἐν ναυπηγίῳ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1158.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1158.1.text#καὶ νῦν ἅπαντ' ἐκεῖνα πεπύλωται πύλαις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1159.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1159.1.text#καὶ βεβαλάνωται καὶ φυλάττεται κύκλῳ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1160.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1160.1.text#ἐφοδεύεται, κωδωνοφορεῖται, πανταχῇ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1161.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1161.1.text#φυλακαὶ καθεστήκασι καὶ φρυκτωρίαι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1162.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1162.1.text#ἐν τοῖσι πύργοις. ἀλλ' ἐγὼ μὲν ἀποτρέχων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1163.1.speaker#Ἄγγελος Α
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1163.1.text#ἀπονίψομαι· σὺ δ' αὐτὸς ἤδη τἄλλα δρᾶ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1164.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1164.1.text#οὗτος τί ποιεῖς; ἆρα θαυμάζεις ὅτι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1165.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1165.1.text#οὕτω τὸ τεῖχος ἐκτετείχισται ταχύ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1166.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1166.1.text#νὴ τοὺς θεοὺς ἔγωγε· καὶ γὰρ ἄξιον·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1167.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1167.1.text#ἴσα γὰρ ἀληθῶς φαίνεταί μοι ψεύδεσιν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1168.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1168.1.text#ἀλλ' ὅδε φύλαξ γὰρ τῶν ἐκεῖθεν ἄγγελος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1169.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1169.1.text#ἐσθεῖ πρὸς ἡμᾶς δεῦρο πυρρίχην βλέπων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1170.1.speaker#Ἄγγελος Β
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1170.1.text#ἰοὺ ἰού, ἰοὺ ἰού, ἰοὺ ἰού.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1171.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1171.1.text#τί τὸ πρᾶγμα τουτί;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1171.2.speaker#Ἄγγελος Β.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1171.2.text#δεινότατα πεπόνθαμεν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1172.1.speaker#Ἄγγελος Β.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1172.1.text#τῶν γὰρ θεῶν τις ἄρτι τῶν παρὰ τοῦ Διὸς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1173.1.speaker#Ἄγγελος Β.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1173.1.text#διὰ τῶν πυλῶν εἰσέπτετ' ἐς τὸν ἀέρα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1174.1.speaker#Ἄγγελος Β.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1174.1.text#λαθὼν κολοιοὺς φύλακας ἡμεροσκόπους.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1175.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1175.1.text#ὦ δεινὸν ἔργον καὶ σχέτλιον εἰργασμένος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1176.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1176.1.text#τίς τῶν θεῶν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1176.2.speaker#Ἄγγελος Β.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1176.2.text#οὐκ ἴσμεν· ὅτι δ' εἶχε πτερά,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1177.1.speaker#Ἄγγελος Β.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1177.1.text#τοῦτ' ἴσμεν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1177.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1177.2.text#οὔκουν δῆτα περιπόλους ἐχρῆν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1178.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1178.1.text#πέμψαι κατ' αὐτὸν εὐθύς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1178.2.speaker#Ἄγγελος Β.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1178.2.text#ἀλλ' ἐπέμψαμεν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1179.1.speaker#Ἄγγελος Β.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1179.1.text#τρισμυρίους ἱέρακας ἱπποτοξότας,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1180.1.speaker#Ἄγγελος Β.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1180.1.text#χωρεῖ δὲ πᾶς τις ὄνυχας ἠγκυλωμένος,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1181.1.speaker#Ἄγγελος Β.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1181.1.text#κερχνῂς τριόρχης γὺψ κύμινδις αἰετός·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1182.1.speaker#Ἄγγελος Β.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1182.1.text#ῥύμῃ τε καὶ πτεροῖσι καὶ ῥοιζήμασιν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1183.1.speaker#Ἄγγελος Β.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1183.1.text#αἰθὴρ δονεῖται τοῦ θεοῦ ζητουμένου·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1184.1.speaker#Ἄγγελος Β.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1184.1.text#κἄστ' οὐ μακρὰν ἄπωθεν, ἀλλ' ἐνταῦθά που
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1185.1.speaker#Ἄγγελος Β.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1185.1.text#ἤδη 'στίν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1185.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1185.2.text#οὔκουν σφενδόνας δεῖ λαμβάνειν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1186.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1186.1.text#καὶ τόξα; χώρει δεῦρο πᾶς ὑπηρέτης·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1187.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1187.1.text#τόξευε παῖε, σφενδόνην τίς μοι δότω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1189.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1189.1.text#πόλεμος αἴρεται, πόλεμος οὐ φατὸς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1190.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1190.1.text#πρὸς ἐμὲ καὶ θεούς. ἀλλὰ φύλαττε πᾶς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1191.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1191.1.text#ἀέρα περινέφελον, ὃν ἔρεβος ἐτέκετο,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1195.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1195.1.text#μή σε λάθῃ θεῶν τις ταύτῃ περῶν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1196.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1196.1.text# […] ἄθρει δὲ πᾶς κύκλῳ σκοπῶν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1197.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1197.1.text#ὡς ἐγγὺς ἤδη δαίμονος πεδαρσίου
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1198.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1198.1.text#δίνης πτερωτὸς φθόγγος ἐξακούεται.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1199.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1199.1.text#αὕτη σύ, ποῖ ποῖ ποῖ πέτει; μέν' ἥσυχος,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1200.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1200.1.text#ἔχ' ἀτρέμας· αὐτοῦ στῆθ'· ἐπίσχες τοῦ δρόμου.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1201.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1201.1.text#τίς εἶ; ποδαπή; λέγειν ἐχρῆν ὁπόθεν πότ' εἶ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1202.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1202.1.text#παρὰ τῶν θεῶν ἔγωγε τῶν Ὀλυμπίων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1203.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1203.1.text#ὄνομα δέ σο. τί ἐστι; πλοῖον ἢ κυνῆ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1204.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1204.1.text#Ἶρις ταχεῖα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1204.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1204.2.text#Πάραλος ἢ Σαλαμινία;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1205.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1205.1.text#τί δὲ τοῦτο;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1205.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1205.2.text#ταυτηνί τις οὐ συλλήψεται
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1206.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1206.1.text#ἀναπτόμενος τρίορχος;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1206.2.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1206.2.text#ἐμὲ συλλήψεται;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1207.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1207.1.text#τί ποτ' ἐστὶ τουτὶ τὸ κακόν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1207.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1207.2.text#οἰμώξει μακρά.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1208.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1208.1.text#ἄτοπόν γε τουτὶ πρᾶγμα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1208.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1208.2.text#κατὰ ποίας πύλας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1209.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1209.1.text#εἰσῆλθες ἐς τὸ τεῖχος ὦ μιαρωτάτη;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1210.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1210.1.text#οὐκ οἶδα μὰ Δί' ἔγωγε κατὰ ποίας πύλας.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1211.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1211.1.text#ἤκουσας αὐτῆς οἷον εἰρωνεύεται;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1212.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1212.1.text#πρὸς τοὺς κολοιάρχας προσῆλθες; οὐ λέγεις;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1213.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1213.1.text#σφραγῖδ' ἔχεις παρὰ τῶν πελαργῶν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1213.2.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1213.2.text#τί τὸ κακόν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1214.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1214.1.text#οὐκ ἔλαβες;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1214.2.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1214.2.text#ὑγιαίνεις μέν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1214.3.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1214.3.text#οὐδὲ σύμβολον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1215.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1215.1.text#ἐπέβαλεν ὀρνίθαρχος οὐδείς σοι παρών;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1216.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1216.1.text#μὰ Δί' οὐκ ἔμοιγ' ἐπέβαλεν οὐδεὶς ὦ μέλε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1217.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1217.1.text#κἄπειτα δῆθ' οὕτω σιωπῇ διαπέτει
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1218.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1218.1.text#διὰ τῆς πόλεως τῆς ἀλλοτρίας καὶ τοῦ χάους;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1219.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1219.1.text#ποίᾳ γὰρ ἄλλῃ χρὴ πέτεσθαι τοὺς θεούς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1220.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1220.1.text#οὐκ οἶδα μὰ Δί' ἔγωγε· τῇδε μὲν γὰρ οὔ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1221.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1221.1.text#ἀδικεῖς δὲ καὶ νῦν. ἆρά γ' οἶσθα τοῦθ' ὅτι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1222.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1222.1.text#δικαιότατ' ἂν ληφθεῖσα πασῶν Ἰρίδων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1223.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1223.1.text#ἀπέθανες, εἰ τῆς ἀξίας ἐτύγχανες;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1224.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1224.1.text#ἀλλ' ἀθάνατός εἰμ'.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1224.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1224.2.text#ἀλλ' ὅμως ἂν ἀπέθανες.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1225.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1225.1.text#δεινότατα γάρ τοι πεισόμεσθ', ἐμοὶ δοκεῖ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1226.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1226.1.text#εἰ τῶν μὲν ἄλλων ἄρχομεν, ὑμεῖς δ' οἱ θεοὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1227.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1227.1.text#ἀκολαστανεῖτε, κοὐδέπω γνώσεσθ' ὅτι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1228.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1228.1.text#ἀκροατέον ὑμῖν ἐν μέρει τῶν κρειττόνων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1229.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1229.1.text#φράσον δέ τοί μοι τὼ πτέρυγε ποῖ ναυστολεῖς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1230.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1230.1.text#ἐγώ; πρὸς ἀνθρώπους πέτομαι παρὰ τοῦ πατρὸς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1231.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1231.1.text#φράσουσα θύειν τοῖς Ὀλυμπίοις θεοῖς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1232.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1232.1.text#μηλοσφαγεῖν τε βουθύτοις ἐπ' ἐσχάραις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1233.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1233.1.text#κνισᾶν τ' ἀγυιάς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1233.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1233.2.text#τί σὺ λέγεις; ποίοις θεοῖς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1234.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1234.1.text#ποίοισιν; ἡμῖν τοῖς ἐν οὐρανῷ θεοῖς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1235.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1235.1.text#θεοὶ γὰρ ὑμεῖς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1235.2.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1235.2.text#τίς γάρ ἐστ' ἄλλος θεός;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1236.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1236.1.text#ὄρνιθες ἀνθρώποισι νῦν εἰσιν θεοί,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1237.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1237.1.text#οἷς θυτέον αὐτούς, ἀλλὰ μὰ Δί' οὐ τῷ Διί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1238.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1238.1.text#ὦ μῶρε μῶρε μὴ θεῶν κίνει φρένας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1239.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1239.1.text#δεινάς, ὅπως μή σου γένος πανώλεθρον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1240.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1240.1.text#Διὸς μακέλλῃ πᾶν ἀναστρέψῃ Δίκη,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1241.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1241.1.text#λιγνὺς δὲ σῶμα καὶ δόμων περιπτυχὰς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1242.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1242.1.text#καταιθαλώσῃ σου Λικυμνίαις βολαῖς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1243.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1243.1.text#ἄκουσον αὕτη· παῦε τῶν παφλασμάτων·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1244.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1244.1.text#ἔχ' ἀτρέμα. φέρ' ἴδω, πότερα Λυδὸν ἢ Φρύγα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1245.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1245.1.text#ταυτὶ λέγουσα μορμολύττεσθαι δοκεῖς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1246.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1246.1.text#ἆρ' οἶσθ' ὅτι Ζεὺς εἴ με λυπήσει πέρα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1247.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1247.1.text#μέλαθρα μὲν αὐτοῦ καὶ δόμους Ἀμφίονος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1248.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1248.1.text#καταιθαλώσω πυρφόροισιν αἰετοῖς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1249.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1249.1.text#πέμψω δὲ πορφυρίωνας ἐς τὸν οὐρανὸν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1250.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1250.1.text#ὄρνις ἐπ' αὐτὸν παρδαλᾶς ἐνημμένους
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1251.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1251.1.text#πλεῖν ἑξακοσίους τὸν ἀριθμόν. καὶ δή ποτε
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1252.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1252.1.text#εἷς Πορφυρίων αὐτῷ παρέσχε πράγματα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1253.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1253.1.text#σὺ δ' εἴ με λυπήσεις τι, τῆς διακόνου
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1254.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1254.1.text#πρώτης ἀνατείνας τὼ σκέλει διαμηριῶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1255.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1255.1.text#τὴν Ἶριν αὐτήν, ὥστε θαυμάζειν ὅπως
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1256.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1256.1.text#οὕτω γέρων ὢν στύομαι τριέμβολον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1257.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1257.1.text#διαρραγείης ὦ μέλ' αὐτοῖς ῥήμασιν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1258.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1258.1.text#οὐκ ἀποσοβήσεις; οὐ ταχέως; εὐρὰξ πατάξ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1259.1.speaker#Ἶρις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1259.1.text#ἦ μήν σε παύσει τῆς ὕβρεως οὑμὸς πατήρ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1260.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1260.1.text#οἴμοι τάλας. οὔκουν ἑτέρωσε πετομένη
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1261.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1261.1.text#καταιθαλώσεις τῶν νεωτέρων τινά;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1263.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1263.1.text#ἀποκεκλῄκαμεν διογενεῖς θεοὺς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1264.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1264.1.text#μηκέτι τὴν ἐμὴν διαπερᾶν πόλιν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1265.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1265.1.text#μηδέ γέ τιν' ἱερόθυτον ἀνὰ δάπεδον ἔτι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1266.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1266.1.text#τῇδε βροτῶν θεοῖσι πέμπειν καπνόν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1269.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1269.1.text#δεινόν γε τὸν κήρυκα τὸν παρὰ τοὺς βροτοὺς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1270.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1270.1.text#οἰχόμενον, εἰ μηδέποτε νοστήσει πάλιν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1271.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1271.1.text#ὦ Πισθέταιρ' ὦ μακάρι' ὦ σοφώτατε,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1272.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1272.1.text#ὦ κλεινότατ' ὦ σοφώτατ' ὦ γλαφυρώτατε,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1273.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1273.1.text#ὦ τρισμακάρι' ὦ κατακέλευσον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1273.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1273.2.text#τί σὺ λέγεις;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1274.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1274.1.text#στεφάνῳ σε χρυσῷ τῷδε σοφίας οὕνεκα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1275.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1275.1.text#στεφανοῦσι καὶ τιμῶσιν οἱ πάντες λεῴ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1276.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1276.1.text#δέχομαι. τί δ' οὕτως οἱ λεῲ τιμῶσί με;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1277.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1277.1.text#ὦ κλεινοτάτην αἰθέριον οἰκίσας πόλιν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1278.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1278.1.text#οὐκ οἷσθ' ὅσην τιμὴν παρ' ἀνθρώποις φέρει,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1279.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1279.1.text#ὅσους τ' ἐραστὰς τῆσδε τῆς χώρας ἔχεις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1280.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1280.1.text#πρὶν μὲν γὰρ οἰκίσαι σε τήνδε τὴν πόλιν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1281.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1281.1.text#ἐλακωνομάνουν ἅπαντες ἄνθρωποι τότε,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1282.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1282.1.text#ἐκόμων ἐπείνων ἐρρύπων ἐσωκράτουν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1283.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1283.1.text#σκυτάλι' ἐφόρουν, νυνὶ δ' ὑποστρέψαντες αὖ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1284.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1284.1.text#ὀρνιθομανοῦσι, πάντα δ' ὑπὸ τῆς ἡδονῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1285.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1285.1.text#ποιοῦσιν ἅπερ ὄρνιθες ἐκμιμούμενοι·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1286.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1286.1.text#πρῶτον μὲν εὐθὺς πάντες ἐξ εὐνῆς ἅμα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1287.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1287.1.text#ἐπέτονθ' ἕωθεν ὥσπερ ἡμεῖς ἐπὶ νομόν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1288.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1288.1.text#κἄπειτ' ἂν ἅμα κατῆραν ἐς τὰ βιβλία·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1289.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1289.1.text#εἶτ' ἀπενέμοντ' ἐνταῦθα τὰ ψηφίσματα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1290.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1290.1.text#ὠρνιθομάνουν δ' οὕτω περιφανῶς ὥστε καὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1291.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1291.1.text#πολλοῖσιν ὀρνίθων ὀνόματ' ἦν κείμενα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1292.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1292.1.text#πέρδιξ μὲν εἷς κάπηλος ὠνομάζετο
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1293.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1293.1.text#χωλός, Μενίππῳ δ' ἦν χελιδὼν τοὔνομα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1294.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1294.1.text#Ὀπουντίῳ δ' ὀφθαλμὸν οὐκ ἔχων κόραξ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1295.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1295.1.text#κορυδὸς Φιλοκλέει, χηναλώπηξ Θεογένει,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1296.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1296.1.text#ἶβις Λυκούργῳ, Χαιρεφῶντι νυκτερίς,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1297.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1297.1.text#Συρακοσίῳ δὲ κίττα· Μειδίας δ' ἐκεῖ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1298.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1298.1.text#ὄρτυξ ἐκαλεῖτο· καὶ γὰρ ᾔκειν ὄρτυγι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1299.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1299.1.text#ὑπὸ στυφοκόπου τὴν κεφαλὴν πεπληγμένῳ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1300.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1300.1.text#ᾖδον δ' ὑπὸ φιλορνιθίας πάντες μέλη,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1301.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1301.1.text#ὅπου χελιδὼν ἦν τις ἐμπεποιημένη
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1302.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1302.1.text#ἢ πηνέλοψ ἢ χήν τις ἢ περιστερὰ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1303.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1303.1.text#ἢ πτέρυγες, ἢ πτεροῦ τι καὶ σμικρὸν προσῆν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1304.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1304.1.text#τοιαῦτα μὲν τἀκεῖθεν. ἓν δέ σοι λέγω·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1305.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1305.1.text#ἥξουσ' ἐκεῖθεν δεῦρο πλεῖν ἢ μύριοι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1306.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1306.1.text#πτερῶν δεόμενοι καὶ τρόπων γαμψωνύχων·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1307.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1307.1.text#ὥστε πτερῶν σοι τοῖς ἐποίκοις δεῖ ποθέν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1308.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1308.1.text#οὐκ ἆρα μὰ Δί' ἡμῖν ἔτ' ἔργον ἑστάναι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1309.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1309.1.text#ἀλλ' ὡς τάχιστα σὺ μὲν ἰὼν τὰς ἀρρίχους
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1310.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1310.1.text#καὶ τοὺς κοφίνους ἅπαντας ἐμπίμπλη πτερῶν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1311.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1311.1.text#Μανῆς δὲ φερέτω μοι θύραζε τὰ πτερά·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1312.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1312.1.text#ἐγὼ δ' ἐκείνων τοὺς προσιόντας δέξομαι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1313.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1313.1.text#ταχὺ δὴ πολυάνορα τάνδε πόλιν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1314.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1314.1.text#καλεῖ τις ἀνθρώπων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1315.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1315.1.text#τύχη μόνον προσείη.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1316.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1316.1.text#κατέχουσι δ' ἔρωτες ἐμᾶς πόλεως.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1317.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1317.1.text#θάττον φέρειν κελεύω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1318.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1318.1.text#τί γὰρ οὐκ ἔνι ταύτῃ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1319.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1319.1.text#καλὸν ἀνδρὶ μετοικεῖν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1320.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1320.1.text#Σοφία Πόθος Ἀμβροσία Χάριτες
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1321.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1321.1.text#τό τε τῆς ἀγανόφρονος Ἡσυχίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1322.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1322.1.text#εὐήμερον πρόσωπον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1323.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1323.1.text#ὡς βλακικῶς διακονεῖς·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1324.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1324.1.text#οὐ θᾶττον ἐγκονήσεις;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1325.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1325.1.text#φερέτω κάλαθον ταχύ τις πτερύγων,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1326.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1326.1.text#σὺ δ' αὖθις ἐξόρμα —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1327.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1327.1.text#τύπτων γε τοῦτον ὡδί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1328.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1328.1.text#πάνυ γὰρ βραδύς ἐστί τις ὥσπερ ὄνος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1329.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1329.1.text#Μανῆς γάρ ἐστι δειλός.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1330.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1330.1.text#σὺ δὲ τὰ πτερὰ πρῶτον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1331.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1331.1.text#διάθες τάδε κόσμῳ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1332.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1332.1.text#τά τε μουσίχ' ὁμοῦ τά τε μαντικὰ καὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1333.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1333.1.text#τὰ θαλάττι'. ἔπειτα δ' ὅπως φρονίμως
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1334.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1334.1.text#πρὸς ἄνδρ' ὁρῶν πτερώσεις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1335.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1335.1.text#οὔ τοι μὰ τὰς κερχνῇδας ἔτι σοῦ σχήσομαι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1336.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1336.1.text#οὕτως ὁρῶν σε δειλὸν ὄντα καὶ βραδύν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1337.1.speaker#Πατραλοίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1337.1.text#γενοίμαν αἰετὸς ὑψιπέτας,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1338.1.speaker#Πατραλοίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1338.1.text#ὡς ἀμποταθείην ὑπὲρ ἀτρυγέτου
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1339.1.speaker#Πατραλοίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1339.1.text#γλαυκᾶς ἐπ' οἶδμα λίμνας.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1340.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1340.1.text#ἔοικεν οὐ ψευδαγγελήσειν ἅγγελος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1341.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1341.1.text#ᾄδων γὰρ ὅδε τις αἰετοὺς προσέρχεται.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1342.1.speaker#Πατραλοίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1342.1.text#αἰβοῖ·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1343.1.speaker#Πατραλοίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1343.1.text#οὐκ ἔστιν οὐδὲν τοῦ πέτεσθαι γλυκύτερον·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1344.1.speaker#Πατραλοίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1344.1.text#ὀρνιθομανῶ γὰρ καὶ πέτομαι καὶ βούλομαι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1345.1.speaker#Πατραλοίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1345.1.text#οἰκεῖν μεθ' ὑμῶν κἀπιθυμῶ τῶν νόμων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1346.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1346.1.text#ποίων νόμων; πολλοὶ γὰρ ὀρνίθων νόμοι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1347.1.speaker#Πατραλοίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1347.1.text#πάντων· μάλιστα δ' ὅτι καλὸν νομίζεται
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1348.1.speaker#Πατραλοίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1348.1.text#τὸν πατέρα τοῖς ὄρνισιν ἄγχειν καὶ δάκνειν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1349.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1349.1.text#καὶ νὴ Δί' ἀνδρεῖόν γε πάνυ νομιζομεν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1350.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1350.1.text#ὃς ἂν πεπλήγῃ τὸν πατέρα νεοττὸς ὤν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1351.1.speaker#Πατραλοίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1351.1.text#διὰ ταῦτα μέντοι δεῦρ' ἀνοικισθεὶς ἐγὼ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1352.1.speaker#Πατραλοίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1352.1.text#ἄγχειν ἐπιθυμῶ τὸν πατέρα καὶ πάντ' ἔχειν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1353.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1353.1.text#ἀλλ' ἔστιν ἡμῖν τοῖσιν ὄρνισιν νόμος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1354.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1354.1.text#παλαιὸς ἐν ταῖς τῶν πελαργῶν κύρβεσιν·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1355.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1355.1.text#ἐπὴν ὁ πατὴρ ὁ πελαργὸς ἐκπετησίμους
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1356.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1356.1.text#πάντας ποιήσῃ τοὺς πελαργιδέας τρέφων,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1357.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1357.1.text#δεῖ τοὺς νεοττοὺς τὸν πατέρα πάλιν τρέφειν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1358.1.speaker#Πατραλοίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1358.1.text#ἀπέλαυσά τἄρα νὴ Δί' ἐλθὼν ἐνθαδί,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1359.1.speaker#Πατραλοίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1359.1.text#εἴπερ γέ μοι καὶ τὸν πατέρα βοσκητέον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1360.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1360.1.text#οὐδέν γ'. ἐπειδήπερ γὰρ ἦλθες ὦ μέλε
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1361.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1361.1.text#εὔνους, πτερώσω σ' ὥσπερ ὄρνιν ὀρφανόν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1362.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1362.1.text#σοὶ δ' ὦ νεανίσκ' οὐ κακῶς ὑποθήσομαι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1363.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1363.1.text#ἀλλ' οἷάπερ αὐτὸς ἔμαθον ὅτε παῖς ἦ. σὺ γὰρ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1364.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1364.1.text#τὸν μὲν πατέρα μὴ τύπτε· ταυτηνδὶ λαβὼν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1365.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1365.1.text#τὴν πτέρυγα καὶ τουτὶ τὸ πλῆκτρον θἀτέρᾳ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1366.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1366.1.text#νομίσας ἀλεκτρυόνος ἔχειν τονδὶ λόφον,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1367.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1367.1.text#φρούρει στρατεύου μισθοφορῶν σαυτὸν τρέφε,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1368.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1368.1.text#τὸν πατέρ ἔα ζῆν· ἀλλ' ἐπειδὴ μάχιμος εἶ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1369.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1369.1.text#ἐς τἀπὶ Θρᾴκης ἀποπέτου κἀκεῖ μάχου.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1370.1.speaker#Πατραλοίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1370.1.text#νὴ τὸν Διόνυσον εὖ γέ μοι δοκεῖς λέγειν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1371.1.speaker#Πατραλοίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1371.1.text#καὶ πείσομαί σοι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1371.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1371.2.text#νοῦν ἄρ' ἔξεις νὴ Δία.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1373.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1373.1.text#ἀναπέτομαι δὴ πρὸς Ὄλυμπον πτερύγεσσι κούφαις·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1374.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1374.1.text#πέτομαι δ' ὁδὸν ἄλλοτ' ἐπ' ἄλλαν μελέων —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1375.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1375.1.text#τουτὶ τὸ πρᾶγμα φορτίου δεῖται πτερῶν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1376.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1376.1.text#ἀφόβῳ φρενὶ σώματί τε νέαν ἐφέπων —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1377.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1377.1.text#ἀσπαζόμεσθα φιλύρινον Κινησίαν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1378.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1378.1.text#τί δεῦρο πόδα σὺ κυλλὸν ἀνὰ κύκλον κυκλεῖς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1380.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1380.1.text#ὄρνις γενέσθαι βούλομαι λιγύφθογγος ἀηδών.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1381.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1381.1.text#παῦσαι μελῳδῶν, ἀλλ' ὅ τι λέγεις εἰπέ μοι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1382.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1382.1.text#ὑπὸ σοῦ πτερωθεὶς βούλομαι μετάρσιος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1383.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1383.1.text#ἀναπτόμενος ἐκ τῶν νεφελῶν καινὰς λαβεῖν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1385.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1385.1.text#ἀεροδονήτους καὶ νιφοβόλους ἀναβολάς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1386.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1386.1.text#ἐκ τῶν νεφελῶν γὰρ ἄν τις ἀναβολὰς λάβοι;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1387.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1387.1.text#κρέμαται μὲν οὖν ἐντεῦθεν ἡμῶν ἡ τέχνη.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1388.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1388.1.text#τῶν διθυράμβων γὰρ τὰ λαμπρὰ γίγνεται
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1389.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1389.1.text#ἀέρια καὶ σκότιά γε καὶ κυαναυγέα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1390.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1390.1.text#καὶ πτεροδόνητα· σὺ δὲ κλύων εἴσει τάχα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1391.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1391.1.text#οὐ δῆτ' ἔγωγε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1391.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1391.2.text#νὴ τὸν Ἡρακλέα σύ γε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1392.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1392.1.text#ἅπαντα γὰρ δίειμί σοι τὸν ἀέρα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1393.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1393.1.text#εἴδωλα πετεινῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1394.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1394.1.text#αἰθεροδρόμων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1395.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1395.1.text#οἰωνῶν ταναοδείρων —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1395.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1395.2.text#ὠόπ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1396.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1396.1.text#τὸν ἁλάδρομον ἁλάμενος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1397.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1397.1.text#ἅμ' ἀνεμων πνοαῖσι βαίην.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1398.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1398.1.text#νὴ τὸν Δί' ἦ 'γώ σου καταπαύσω τὰς πνοάς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1399.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1399.1.text#τοτὲ μὲν νοτίαν στείχων πρὸς ὁδόν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1400.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1400.1.text#τοτὲ δ' αὖ βορέᾳ σῶμα πελάζων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1400a.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1400a.1.text#ἀλίμενον αἰθέρος αὔλακα τέμνων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1401.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1401.1.text#χαρίεντά γ' ὦ πρεσβῦτ' ἐσοφίσω καὶ σοφά.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1402.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1402.1.text#οὐ γὰρ σὺ χαίρεις πτεροδόνητος γενόμενος;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1403.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1403.1.text#ταυτὶ πεποίηκας τὸν κυκλιοδιδάσκαλον,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1404.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1404.1.text#ὂς ταῖσι φυλαῖς περιμάχητός εἰμ' ἀεί;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1405.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1405.1.text#βούλει διδάσκειν καὶ παρ' ἡμῖν οὖν μένων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1406.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1406.1.text#Λεωτροφίδῃ χορὸν πετομένων ὀρνέων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1407.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1407.1.text#Κεκροπίδα φυλήν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1407.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1407.2.text#καταγελᾷς μου, δῆλος εἶ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1408.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1408.1.text#ἀλλ' οὖν ἔγωγ' οὐ παύσομαι, τοῦτ' ἴσθ' ὅτι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1409.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1409.1.text#πρὶν ἂν πτερωθεὶς διαδράμω τὸν ἀέρα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1410.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1410.1.text#ὄρνιθες τίνες οὐδὲν ἔχοντες πτεροποίκιλοι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1411.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1411.1.text#τανυσίπτερε ποικίλα χελιδοῖ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1412.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1412.1.text#τουτὶ τὸ κακὸν οὐ φαῦλον ἐξεγρήγορεν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1413.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1413.1.text#ὅδ' αὖ μινυρίζων δεῦρό τις προσέρχεται.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1415.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1415.1.text#τανυσίπτερε ποικίλα μάλ' αὖθις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1416.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1416.1.text#ἐς θοἰμάτιον τὸ σκόλιον ᾄδειν μοι δοκεῖ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1417.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1417.1.text#δεῖσθαι δ' ἔοικεν οὐκ ὀλίγων χελιδόνων.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1418.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1418.1.text#τίς ὁ πτερῶν δεῦρ' ἐστὶ τοὺς ἀφικνουμένους;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1419.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1419.1.text#ὁδὶ πάρεστιν· ἀλλ' ὅτου δεῖ χρὴ λέγειν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1420.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1420.1.text#πτερῶν πτερῶν δεῖ· μὴ πύθῃ τὸ δεύτερον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1421.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1421.1.text#μῶν εὐθὺ Πελλήνης πέτεσθαι διανοεῖ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1422.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1422.1.text#μὰ Δί' ἀλλὰ κλητήρ εἰμι νησιωτικὸς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1423.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1423.1.text#καὶ συκοφάντης —
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1423.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1423.2.text#ὦ μακάριε τῆς τέχνης.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1424.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1424.1.text#καὶ πραγματοδίφης. εἶτα δέομαι πτερὰ λαβὼν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1425.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1425.1.text#κύκλῳ περισοβεῖν τὰς πόλεις καλούμενος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1426.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1426.1.text#ὑπὸ πτερύγων τι προσκαλεῖ σοφώτερον;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1427.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1427.1.text#μὰ Δί' ἀλλ' ἵν' οἱ λῃσταί τε μὴ λυπῶσί με,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1428.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1428.1.text#μετὰ τῶν γεράνων τ' ἐκεῖθεν ἀναχωρῶ πάλιν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1429.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1429.1.text#ἀνθ' ἕρματος πολλὰς καταπεπωκὼς δίκας.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1430.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1430.1.text#τουτὶ γὰρ ἐργάζει σὺ τοὔργον; εἰπέ μοι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1431.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1431.1.text#νεανίας ὢν συκοφαντεῖς τοὺς ξένους;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1432.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1432.1.text#τί γὰρ πάθω; σκάπτειν γὰρ οὐκ ἐπίσταμαι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1433.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1433.1.text#ἀλλ' ἔστιν ἕτερα νὴ Δί' ἔργα σώφρονα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1434.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1434.1.text#ἀφ' ὧν διαζῆν ἄνδρα χρῆν τοσουτονὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1435.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1435.1.text#ἐκ τοῦ δικαίου μᾶλλον ἢ δικορραφεῖν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1436.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1436.1.text#ὦ δαιμόνιε μὴ νουθέτει μ' ἀλλὰ πτέρου.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1437.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1437.1.text#νῦν τοι λέγων πτερῶ σε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1437.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1437.2.text#καὶ πῶς ἂν λόγοις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1438.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1438.1.text#ἄνδρα πτερώσειας σύ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1438.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1438.2.text#πάντες τοῖς λόγοις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1439.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1439.1.text#ἀναπτεροῦνται.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1439.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1439.2.text#πάντες;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1439.3.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1439.3.text#οὐκ ἀκήκοας,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1440.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1440.1.text#ὅταν λέγωσιν οἱ πατέρες ἑκάστοτε
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1441.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1441.1.text#τοῖς μειρακίοις ἐν τοῖσι κουρείοις ταδί;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1442.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1442.1.text#"δεινῶς γέ μου τὸ μειράκιον Διειτρέφης"
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1443.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1443.1.text#"λέγων ἀνεπτέρωκεν ὥσθ' ἱππηλατεῖν."
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1444.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1444.1.text#ὁ δέ τις τὸν αὑτοῦ φησιν ἐπὶ τραγῳδίᾳ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1445.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1445.1.text#ἀνεπτερῶσθαι καὶ πεποτῆσθαι τὰς φρένας.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1446.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1446.1.text#λόγοισί τἄρα καὶ πτεροῦνται;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1446.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1446.2.text#φήμ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1447.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1447.1.text#ὑπὸ γὰρ λόγων ὁ νοῦς τε μετεωρίζεται
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1448.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1448.1.text#ἐπαίρεταί τ' ἄνθρωπος. οὕτω καί σ' ἐγὼ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1449.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1449.1.text#ἀναπτερώσας βούλομαι χρηστοῖς λόγοις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1450.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1450.1.text#τρέψαι πρὸς ἔργον νόμιμον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1450.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1450.2.text#ἀλλ' οὐ βούλομαι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1451.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1451.1.text#τί δαὶ ποιήσεις;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1451.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1451.2.text#τὸ γένος οὐ καταισχυνῶ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1452.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1452.1.text#παππῷος ὁ βίος συκοφαντεῖν ἐστί μοι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1453.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1453.1.text#ἀλλὰ πτέρου με ταχέσι καὶ κούφοις πτεροῖς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1454.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1454.1.text#ἱέρακος ἢ κερχνῇδος, ὡς ἂν τοὺς ξένους
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1455.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1455.1.text#καλεσάμενος κᾆτ' ἐγκεκληκὼς ἐνθαδὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1456.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1456.1.text#κατ' αὖ πέτωμαι πάλιν ἐκεῖσε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1456.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1456.2.text#μανθάνω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1457.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1457.1.text#ὡδὶ λέγεις· ὅπως ἂν ὠφλήκῃ δίκην
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1458.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1458.1.text#ἐνθάδε πρὶν ἥκειν ὁ ξένος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1458.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1458.2.text#πάνυ μανθάνεις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1459.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1459.1.text#κἄπειθ' ὁ μὲν πλεῖ δεῦρο, σὺ δ' ἐκεῖσ' αὖ πέτει
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1460.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1460.1.text#ἁρπασόμενος τὰ χρήματ' αὐτοῦ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1460.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1460.2.text#πάντ' ἔχεις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1461.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1461.1.text#βέμβικος οὐδὲν διαφέρειν δεῖ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1461.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1461.2.text#μανθάνω
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1462.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1462.1.text#βέμβικα· καὶ μὴν ἔστι μοι νὴ τὸν Δία
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1463.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1463.1.text#κάλλιστα Κορκυραῖα τοιαυτὶ πτερά.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1464.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1464.1.text#οἴμοι τάλας μάστιγ' ἔχεις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1464.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1464.2.text#πτερὼ μὲν οὖν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1465.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1465.1.text#οἷσί σε ποιήσω τήμερον βεμβικιᾶν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1466.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1466.1.text#οἴμοι τάλας.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1466.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1466.2.text#οὐ πτερυγιεῖς ἐντευθενί;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1467.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1467.1.text#οὐκ ἀπολιβάξεις ὦ κάκιστ' ἀπολούμενος;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1468.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1468.1.text#πικρὰν τάχ' ὄψει στρεψοδικοπανουργίαν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1469.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1469.1.text#ἀπίωμεν ἡμεῖς ξυλλαβόντες τὰ πτερά.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1470.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1470.1.text#πολλὰ δὴ καὶ καινὰ καὶ θαυμάστ'
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1471.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1471.1.text#ἐπεπτόμεσθα καὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1472.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1472.1.text#δεινὰ πράγματ' εἴδομεν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1473.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1473.1.text#ἔστι γὰρ δένδρον πεφυκὸς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1474.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1474.1.text#ἔκτοπόν τι Καρδίας ἀ-
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1475.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1475.1.text#πωτέρω Κλεώνυμος,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1476.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1476.1.text#χρήσιμον μὲν οὐδέν, ἄλλως
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1477.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1477.1.text#δὲ δειλὸν καὶ μέγα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1478.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1478.1.text#τοῦτο τοῦ μὲν ἦρος ἀεὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1479.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1479.1.text#βλαστάνει καὶ συκοφαντεῖ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1480.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1480.1.text#τοῦ δὲ χειμῶνος πάλιν τὰς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1481.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1481.1.text#ἀσπίδας φυλλορροεῖ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1482.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1482.1.text#ἔστι δ' αὗ χώρα πρὸς αὐτῷ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1483.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1483.1.text#τῷ σκότῳ πόρρω τις ἐν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1484.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1484.1.text#τῇ λύχνων ἐρημίᾳ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1485.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1485.1.text#ἔνθα τοῖς ἥρωσιν ἄνθρωποι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1486.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1486.1.text#ξυναριστῶσι καὶ ξύν-
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1487.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1487.1.text#εισι πλὴν τῆς ἑσπέρας.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1488.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1488.1.text#τηνικαῦτα δ' οὐκέτ' ἦν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1489.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1489.1.text#ἀσφαλὲς ξυντυγχάνειν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1490.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1490.1.text#εἰ γὰρ ἐντύχοι τις ἥρῳ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1491.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1491.1.text#τῶν βροτῶν νύκτωρ Ὀρέστῃ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1492.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1492.1.text#γυμνὸς ἦν πληγεὶς ὑπ' αὐτοῦ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1493.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1493.1.text#πάντα τἀπιδέξια.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1494.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1494.1.text#οἴμοι τάλας, ὁ Ζεὺς ὅπως μή μ' ὄψεται.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1495.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1495.1.text#ποῦ Πισθέταιρός ἐστ';
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1495.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1495.2.text#ἔα τουτὶ τί ἦν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1496.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1496.1.text#τίς ὁ συγκαλυμμός;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1496.2.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1496.2.text#τῶν θεῶν ὁρᾷς τινα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1497.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1497.1.text#ἐμοῦ κατόπιν ἐνταῦθα;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1497.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1497.2.text#μὰ Δί' ἐγὼ μὲν οὔ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1498.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1498.1.text#τίς δ' εἶ σύ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1498.2.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1498.2.text#πηνίκ' ἐστὶν ἄρα τῆς ἡμέρας;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1499.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1499.1.text#ὁπηνίκα; σμικρόν τι μετὰ μεσημβρίαν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1500.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1500.1.text#ἀλλὰ σὺ τίς εἶ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1500.2.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1500.2.text#βουλυτὸς ἢ περαιτέρω;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1501.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1501.1.text#οἴμ' ὡς βδελύττομαί σε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1501.2.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1501.2.text#τί γὰρ ὁ Ζεὺς ποιεῖ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1502.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1502.1.text#ἀπαιθριάζει τὰς νεφέλας ἢ ξυννέφει;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1503.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1503.1.text#οἴμωζε μεγάλ'.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1503.2.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1503.2.text#οὕτω μὲν ἐκκεκαλύψομαι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1504.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1504.1.text#ὦ φίλε Προμηθεῦ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1504.2.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1504.2.text#παῦε παῦε, μὴ βόα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1505.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1505.1.text#τί γὰρ ἔστι;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1505.2.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1505.2.text#σίγα, μὴ κάλει μου τοὔνομα·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1506.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1506.1.text#ἀπὸ γάρ μ' ὀλεῖς, εἴ μ' ἐνθάδ' ὁ Ζεὺς ὄψεται.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1507.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1507.1.text#ἀλλ' ἵνα φράσω σοι πάντα τἄνω πράγματα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1508.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1508.1.text#τουτὶ λαβών μου τὸ σκιάδειον ὑπέρεχε
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1509.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1509.1.text#ἄνωθεν, ὡς ἂν μή μ' ὁρῶσιν οἱ θεοί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1510.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1510.1.text#ἰοὺ ἰού·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1511.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1511.1.text#εὖ γ' ἐπενόησας αὐτὸ καὶ προμηθικῶς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1512.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1512.1.text#ὑπόδυθι ταχὺ δὴ κᾆτα θαρρήσας λέγε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1513.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1513.1.text#ἄκουε δή νυν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1513.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1513.2.text#ὡς ἀκούοντος λέγε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1514.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1514.1.text#ἀπόλωλεν ὁ Ζεύς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1514.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1514.2.text#πηνίκ' ἄττ' ἀπώλετο;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1515.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1515.1.text#ἐξ οὗπερ ὑμεῖς ᾠκίσατε τὸν ἀέρα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1516.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1516.1.text#θύει γὰρ οὐδεὶς οὐδὲν ἀνθρώπων ἔτι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1517.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1517.1.text#θεοῖσιν, οὐδὲ κνῖσα μηρίων ἄπο
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1518.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1518.1.text#ἀνῆλθεν ὡς ἡμᾶς ἀπ' ἐκείνου τοῦ χρόνου,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1519.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1519.1.text#ἀλλ' ὡσπερεὶ Θεσμοφορίοις νηστεύομεν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1520.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1520.1.text#ἄνευ θυηλῶν· οἱ δὲ βάρβαροι θεοὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1521.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1521.1.text#πεινῶντες ὥσπερ Ἰλλυριοὶ κεκριγότες
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1522.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1522.1.text#ἐπιστρατεύσειν φάσ' ἄνωθεν τῷ Διί,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1523.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1523.1.text#εἰ μὴ παρέξει τἀμπόρι' ἀνεῳγμένα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1524.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1524.1.text#ἵν' εἰσάγοιτο σπλάγχνα κατατετμημένα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1525.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1525.1.text#εἰσὶν γὰρ ἕτεροι βάρβαροι θεοί τινες
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1526.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1526.1.text#ἄνωθεν ὑμῶν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1526.2.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1526.2.text#οὐ γάρ εἰσι βάρβαροι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1527.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1527.1.text#ὅθεν ὁ πατρῷός ἐστιν Ἐξηκεστίδῃ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1528.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1528.1.text#ὄνομα δὲ τούτοις τοῖς θεοῖς τοῖς βαρβάροις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1529.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1529.1.text#τί ἔστιν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1529.2.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1529.2.text#ὅ τι ἔστιν; Τριβαλλοί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1529.3.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1529.3.text#μανθάνω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1530.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1530.1.text#ἐντεῦθεν ἆρα τοὐπιτριβείης ἐγένετο;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1531.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1531.1.text#μάλιστα πάντων. ἓν δέ σοι λέγω σαφές·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1532.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1532.1.text#ἥξουσι πρέσβεις δεῦρο περὶ διαλλαγῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1533.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1533.1.text#παρὰ τοῦ Διὸς καὶ τῶν Τριβαλλῶν τῶν ἄνω·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1534.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1534.1.text#ὑμεῖς δὲ μὴ σπένδεσθ', ἐὰν μὴ παραδιδῷ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1535.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1535.1.text#τὸ σκῆπτρον ὁ Ζεὺς τοῖσιν ὄρνισιν πάλιν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1536.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1536.1.text#καὶ τὴν Βασίλειάν σοι γυναῖκ' ἔχειν διδῷ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1537.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1537.1.text#τίς ἐστιν ἡ Βασίλεια;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1537.2.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1537.2.text#καλλίστη κόρη,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1538.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1538.1.text#ἥπερ ταμιεύει τὸν κεραυνὸν τοῦ Διὸς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1539.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1539.1.text#καὶ τἄλλ' ἁπαξάπαντα, τὴν εὐβουλίαν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1540.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1540.1.text#τὴν εὐνομίαν τὴν σωφροσύνην τὰ νεώρια,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1541.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1541.1.text#τὴν λοιδορίαν τὸν κωλακρέτην τὰ τριώβολα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1542.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1542.1.text#ἅπαντά γ' ἆρ' αὐτῷ ταμιεύει;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1542.2.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1542.2.text#φήμ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1543.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1543.1.text#ἥν γ' ἢν σὺ παρ' ἐκείνου παραλάβῃς, πάντ' ἔχεις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1544.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1544.1.text#τούτων ἕνεκα δεῦρ' ἦλθον, ἵνα φράσαιμί σοι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1545.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1545.1.text#ἀεί ποτ' ἀνθρώποις γὰρ εὔνους εἴμ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1546.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1546.1.text#μόνον θεῶν γὰρ διὰ σ' ἀπανθρακίζομεν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1547.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1547.1.text#μισῶ δ' ἅπαντας τοὺς θεούς, ὡς οἶσθα σύ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1548.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1548.1.text#νὴ τὸν Δί' ἀεὶ δῆτα θεομισὴς ἔφυς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1549.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1549.1.text#Τίμων καθαρός. ἀλλ' ὡς ἂν ἀποτρέχω πάλιν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1550.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1550.1.text#φέρε τὸ σκιάδειον, ἵνα με κἂν ὁ Ζεὺς ἴδῃ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1551.1.speaker#Προμηθεύς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1551.1.text#ἄνωθεν, ἀκολουθεῖν δοκῶ κανηφόρῳ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1552.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1552.1.text#καὶ τὸν δίφρον γε διφροφόρει τονδὶ λαβών.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1553.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1553.1.text#πρὸς δὲ τοῖς Σκιάποσιν λίμνη
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1554.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1554.1.text#τις ἔστ' ἄλουτος οὗ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1555.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1555.1.text#ψυχαγωγεῖ Σωκράτης·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1556.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1556.1.text#ἔνθα καὶ Πείσανδρος ἦλθε
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1557.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1557.1.text#δεόμενος ψυχὴν ἰδεῖν ἣ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1558.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1558.1.text#ζῶντ' ἐκεῖνον προὔλιπε,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1559.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1559.1.text#σφάγι' ἔχων κάμηλον ἀμνόν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1560.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1560.1.text#τιν', ἧς λαιμοὺς τεμὼν ὥσπερ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1561.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1561.1.text# ποθ' οὑδυσσεὺς ἀπῆλθε,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1562.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1562.1.text#κᾆτ' ἀνῆλθ' αὐτῷ κάτωθεν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1563.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1563.1.text#πρὸς τὸ λαῖτμα τῆς καμήλου
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1564.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1564.1.text#Χαιρεφῶν ἡ νυκτερίς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1565.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1565.1.text#τὸ μὲν πόλισμα τῆς Νεφελοκοκκυγίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1566.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1566.1.text#ὁρᾶν τοδὶ πάρεστιν, οἷ πρεσβεύομεν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1567.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1567.1.text#οὗτος τί δρᾷς; ἐπ' ἀριστέρ' οὕτως ἀμπέχει;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1568.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1568.1.text#οὐ μεταβαλεῖς θοἰμάτιον ὧδ' ἐπιδέξια;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1569.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1569.1.text#τί ὦ κακόδαιμον; Λαισποδίας εἶ τὴν φύσιν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1570.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1570.1.text#ὦ δημοκρατία ποῖ προβιβᾷς ἡμᾶς ποτε,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1571.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1571.1.text#εἰ τουτονί γ' ἐχειροτόνησαν οἱ θεοί;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1572.1.speaker#Τριβαλλός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1572.1.text#ἕξεις ἀτρέμας;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1572.2.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1572.2.text#οἴμωζε· πολὺ γὰρ δή σ' ἐγὼ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1573.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1573.1.text#ἑόρακα πάντων βαρβαρώτατον θεῶν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1574.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1574.1.text#ἄγε δὴ τί δρῶμεν Ἡράκλεις;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1574.2.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1574.2.text#ἀκήκοας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1575.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1575.1.text#ἐμοῦ γ' ὅτι τὸν ἄνθρωπον ἄγχειν βούλομαι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1576.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1576.1.text#ὅστις ποτ' ἔσθ' ὁ τοὺς θεοὺς ἀποτειχίσας.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1577.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1577.1.text#ἀλλ' ὦγάθ' ᾑρήμεσθα περὶ διαλλαγῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1578.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1578.1.text#πρέσβεις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1578.2.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1578.2.text#διπλασίως μᾶλλον ἄγχειν μοι δοκεῖ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1579.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1579.1.text#τὴν τυρόκνηστίν τις δότω· φέρε σίλφιον·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1580.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1580.1.text#τυρὸν φερέτω τις· πυρπόλει τοὺς ἄνθρακας.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1581.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1581.1.text#τὸν ἄνδρα χαίρειν οἱ θεοὶ κελεύομεν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1582.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1582.1.text#τρεῖς ὄντες ἡμεῖς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1582.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1582.2.text#ἀλλ' ἐπικνῶ τὸ σίλφιον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1583.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1583.1.text#τὰ δὲ κρέα τοῦ ταῦτ' ἐστίν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1583.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1583.2.text#ὄρνιθές τινες
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1584.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1584.1.text#ἐπανιστάμενοι τοῖς δημοτικοῖσιν ὀρνέοις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1585.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1585.1.text#ἔδοξαν ἀδικεῖν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1585.2.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1585.2.text#εἶτα δῆτα σίλφιον
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1586.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1586.1.text#εἴπικνῇς πρότερον αὐτοῖσιν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1586.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1586.2.text#ὦ χαῖρ' Ἡράκλεις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1587.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1587.1.text#τί ἔστι;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1587.2.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1587.2.text#πρεσβεύοντες ἡμεῖς ἥκομεν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1588.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1588.1.text#παρὰ τῶν θεῶν περὶ πολέμου καταλλαγῆς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1589.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1589.1.text#ἔλαιον οὐκ ἔνεστιν ἐν τῇ ληκύθῳ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1590.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1590.1.text#καὶ μὴν τά γ' ὀρνίθεια λιπάρ' εἶναι πρέπει.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1591.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1591.1.text#ἡμεῖς τε γὰρ πολεμοῦντες οὐ κερδαίνομεν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1592.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1592.1.text#ὑμεῖς τ' ἂν ἡμῖν τοῖς θεοῖς ὄντες φίλοι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1593.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1593.1.text#ὄμβριον ὕδωρ ἂν εἴχετ' ἐν τοῖς τέλμασιν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1594.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1594.1.text#ἀλκυονίδας τ' ἂν ἤγεθ' ἡμέρας ἀεί.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1595.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1595.1.text#τούτων περὶ πάντων αὐτοκράτορες ἥκομεν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1596.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1596.1.text#ἀλλ' οὔτε πρότερον πώποθ' ἡμεῖς ἤρξαμεν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1597.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1597.1.text#πολέμου πρὸς ὑμᾶς, νῦν τ' ἐθέλομεν, εἰ δοκεῖ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1598.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1598.1.text#ἐάν τι δίκαιον ἀλλὰ νῦν ἐθέλητε δρᾶν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1599.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1599.1.text#σπονδὰς ποιεῖσθαι. τὰ δὲ δίκαι' ἐστὶν ταδί,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1600.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1600.1.text#τὸ σκῆπτρον ἡμῖν τοῖσιν ὄρνισιν πάλιν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1601.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1601.1.text#τὸν Δί' ἀποδοῦναι· κἂν διαλλαττώμεθα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1602.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1602.1.text#ἐπὶ τοῖσδε, τοὺς πρέσβεις ἐπ' ἄριστον καλῶ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1603.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1603.1.text#ἐμοὶ μὲν ἀπόχρη ταῦτα καὶ ψηφίζομαι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1604.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1604.1.text#τί ὦ κακόδαιμον; ἠλίθιος καὶ γάστρις εἶ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1605.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1605.1.text#ἀποστερεῖς τὸν πατέρα τῆς τυραννίδος;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1606.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1606.1.text#ἄληθες; οὐ γὰρ μεῖζον ὑμεῖς οἱ θεοὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1607.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1607.1.text#ἰσχύσετ', ἢν ὄρνιθες ἄρξωσιν κάτω;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1608.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1608.1.text#νῦν μέν γ' ὑπὸ ταῖς νεφέλαισιν ἐγκεκρυμμένοι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1609.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1609.1.text#κύψαντες ἐπιορκοῦσιν ὑμᾶς οἱ βροτοί·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1610.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1610.1.text#ἐὰν δὲ τοὺς ὄρνις ἔχητε συμμάχους,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1611.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1611.1.text#ὅταν ὀμνύῃ τις τὸν κόρακα καὶ τὸν Δία,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1612.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1612.1.text#ὁ κόραξ παρελθὼν τοὐπιορκοῦντος λάθρᾳ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1613.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1613.1.text#προσπτόμενος ἐκκόψει τὸν ὀφθαλμὸν θενών.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1614.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1614.1.text#νὴ τὸν Ποσειδῶ ταῦτά γέ τοι καλῶς λέγεις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1615.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1615.1.text#κἀμοὶ δοκεῖ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1615.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1615.2.text#τί δαὶ σὺ φῄς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1615.3.speaker#Τριβαλλός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1615.3.text#ναβαισατρεῦ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1616.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1616.1.text#ὁρᾷς; ἐπαινεῖ χοὖτος. ἕτερόν νυν ἔτι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1617.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1617.1.text#ἀκούσαθ' ὅσον ὑμᾶς ἀγαθὸν ποιήσομεν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1618.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1618.1.text#ἐάν τις ἀνθρώπων ἱερεῖόν τῳ θεῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1619.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1619.1.text#εὐξάμενος εἶτα διασοφίζηται λέγων,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1620.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1620.1.text# "μενετοὶ θεοί," καὶ μἀποδιδῷ μισητίᾳ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1621.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1621.1.text#ἀναπράξομεν καὶ ταῦτα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1621.2.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1621.2.text#φέρ' ἴδω τῷ τρόπῳ;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1622.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1622.1.text#ὅταν διαριθμῶν ἀργυρίδιον τύχῃ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1623.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1623.1.text#ἅνθρωπος οὗτος, ἢ καθῆται λούμενος,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1624.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1624.1.text#καταπτόμενος ἰκτῖνος ἁρπάσας λάθρᾳ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1625.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1625.1.text#προβάτοιν δυοῖν τιμὴν ἀνοίσει τῷ θεῷ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1626.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1626.1.text#τὸ σκῆπτρον ἀποδοῦναι πάλιν ψηφίζομαι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1627.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1627.1.text#τούτοις ἐγώ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1627.2.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1627.2.text#καὶ τὸν Τριβαλλόν νυν ἐροῦ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1628.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1628.1.text#ὁ Τριβαλλός, οἰμώζειν δοκεῖ σοι;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1628.2.speaker#Τριβαλλός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1628.2.text#σαυνάκα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1629.1.speaker#Τριβαλλός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1629.1.text#βακταρικροῦσα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1629.2.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1629.2.text#φησί μ' εὖ λέγειν πάνυ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1630.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1630.1.text#εἴ τοι δοκεῖ σφῷν ταῦτα, κἀμοὶ συνδοκεῖ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1631.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1631.1.text#οὗτος, δοκεῖ δρᾶν ταῦτα τοῦ σκήπτρου πέρι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1632.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1632.1.text#καὶ νὴ Δί' ἕτερόν γ' ἐστὶν οὗ 'μνήσθην ἐγώ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1633.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1633.1.text#τὴν μὲν γὰρ Ἥραν παραδίδωμι τῷ Διί,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1634.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1634.1.text#τὴν δὲ Βασίλειαν τὴν κόρην γυναῖκ' ἐμοὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1635.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1635.1.text#ἐκδοτέον ἐστίν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1635.2.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1635.2.text#οὐ διαλλαγῶν ἐρᾷς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1636.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1636.1.text#ἀπίωμεν οἴκαδ' αὖθις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1636.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1636.2.text#ὀλίγον μοι μέλει.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1637.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1637.1.text#μάγειρε τὸ κατάχυσμα χρὴ ποιεῖν γλυκύ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1638.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1638.1.text#ὦ δαιμόνι' ἀνθρώπων Πόσειδον ποῖ φέρει;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1639.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1639.1.text#ἡμεῖς περὶ γυναικὸς μιᾶς πολεμήσομεν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1640.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1640.1.text#τί δαὶ ποιῶμεν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1640.2.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1640.2.text#ὅ τι; διαλλαττώμεθα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1641.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1641.1.text#τί δ' ᾠζύρ'; οὐκ οἶσθ' ἐξαπατώμενος πάλαι;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1642.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1642.1.text#βλάπτεις δέ τοι σὺ σαυτόν. ἢν γὰρ ἀποθάνῃ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1643.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1643.1.text#ὁ Ζεὺς παραδοὺς τούτοισι τὴν τυραννίδα,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1644.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1644.1.text#πένης ἔσει σύ. σοῦ γὰρ ἅπαντα γίγνεται
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1645.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1645.1.text#τὰ χρήμαθ', ὅσ' ἂν ὁ Ζεὺς ἀποθνῄσκων καταλίπῃ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1646.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1646.1.text#οἴμοι τάλας οἷόν σε περισοφίζεται.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1647.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1647.1.text#δεῦρ' ὡς ἔμ' ἀποχώρησον, ἵνα τί σοι φράσω.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1648.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1648.1.text#διαβάλλεταί σ' ὁ θεῖος ὦ πόνηρε σύ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1649.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1649.1.text#τῶν γὰρ πατρῴων οὐδ' ἀκαρῆ μέτεστί σοι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1650.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1650.1.text#κατὰ τοὺς νόμους· νόθος γὰρ εἶ κοὐ γνήσιος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1651.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1651.1.text#ἐγὼ νόθος; τί λέγεις;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1651.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1651.2.text#σὺ μέντοι νὴ Δία
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1652.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1652.1.text#ὤν γε ξένης γυναικός. ἢ πῶς ἄν ποτε
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1653.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1653.1.text#ἐπίκληρον εἶναι τὴν Ἀθηναίαν δοκεῖς,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1654.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1654.1.text#οὖσαν θυγατέρ', ὄντων ἀδελφῶν γνησίων;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1655.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1655.1.text#τί δ' ἢν ὁ πατὴρ ἐμοὶ διδῷ τὰ χρήματα
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1656.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1656.1.text#νοθεἶ ἀποθνῄσκων;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1656.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1656.2.text#ὁ νόμος αὐτὸν οὐκ ἐᾷ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1657.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1657.1.text#οὗτος ὁ Ποσειδῶν πρῶτος, ὃς ἐπαίρει σε νῦν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1658.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1658.1.text#ἀνθέξεταί σου τῶν πατρῴων χρημάτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1659.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1659.1.text#φάσκων ἀδελφὸς αὐτὸς εἶναι γνήσιος.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1660.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1660.1.text#ἐρῶ δὲ δὴ καὶ τὸν Σόλωνός σοι νόμον·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1661.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1661.1.text#"νόθῳ δὲ μὴ εἶναι ἀγχιστείαν παίδων ὄντων"
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1665.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1665.1.text#"γνησίων. ἐὰν δὲ παῖδες μὴ ὦσι γνήσιοι, τοῖς"
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1666.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1666.1.text#"ἐγγυτάτω γένους μετεῖναι τῶν χρημάτων."
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1667.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1667.1.text#ἐμοὶ δ' ἄρ' οὐδὲν τῶν πατρῴων χρημάτων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1668.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1668.1.text#μέτεστιν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1668.2.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1668.2.text#οὐ μέντοι μὰ Δία. λέξον δέ μοι,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1669.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1669.1.text#ἤδη σ' ὁ πατὴρ εἰσήγαγ' ἐς τοὺς φράτερας;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1670.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1670.1.text#οὐ δῆτ' ἐμέ γε. καὶ δῆτ' ἐθαύμαζον πάλαι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1671.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1671.1.text#τί δῆτ' ἄνω κέχηνας αἴκειαν βλέπων;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1672.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1672.1.text#ἀλλ' ἢν μεθ' ἡμῶν ᾖς, καταστήσας σ' ἐγὼ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1673.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1673.1.text#τύραννον ὀρνίθων παρέξω σοι γάλα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1674.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1674.1.text#δίκαι' ἔμοιγε καὶ πάλαι δοκεῖς λέγειν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1675.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1675.1.text#περὶ τῆς κόρης, κἄγωγε παραδίδωμί σοι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1676.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1676.1.text#τί δαὶ σὺ φῄς;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1676.2.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1676.2.text#τἀναντία ψηφίζομαι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1677.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1677.1.text#ἐν τῷ Τριβαλλῷ πᾶν τὸ πρᾶγμα. τί σὺ λέγεις;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1678.1.speaker#Τριβαλλός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1678.1.text#καλάνι κόραυνα καὶ μεγάλα βασιλιναῦ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1679.1.speaker#Τριβαλλός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1679.1.text#ὄρνιτο παραδίδωμι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1679.2.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1679.2.text#παραδοῦναι λέγει.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1680.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1680.1.text#μὰ τὸν Δί' οὐχ οὗτός γε παραδοῦναι λέγει,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1681.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1681.1.text#εἰ μὴ † βαδίζειν † ωἅσπερ αἱ χελιδόσιν λέγει.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1682.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1682.1.text#οὐκοῦν παραδοῦναι ταῖς χελιδόσιν λέγει.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1683.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1683.1.text#σφὼ νῦν διαλλάττεσθε καὶ ξυμβαίνετε·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1684.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1684.1.text#ἐγὼ δ', ἐπειδὴ σφῷν δοκεῖ, σιγήσομαι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1685.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1685.1.text#ἡμῖν ἃ λέγεις σὺ πάντα συγχωρεῖν δοκεῖ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1686.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1686.1.text#ἀλλ' ἴθι μεθ' ἡμῶν αὐτὸς ἐς τὸν οὐρανόν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1687.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1687.1.text#ἵνα τὴν Βασίλειαν καὶ τὰ πάντ' ἐκεῖ λάβῃς.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1688.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1688.1.text#ἐς καιρὸν ἆρα κατεκόπησαν οὑτοιὶ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1689.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1689.1.text#ἐς τοὺς γάμους.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1689.2.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1689.2.text#βούλεσθε δῆτ' ἐγὼ τέως
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1690.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1690.1.text#ὀπτῶ τὰ κρέα ταυτὶ μένων; ὑμεῖς δ' ἴτε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1691.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1691.1.text#ὀπτᾷς τὰ κρέα; πολλήν γε τενθείαν λέγεις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1692.1.speaker#Ποσειδῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1692.1.text#οὐκ εἶ μεθ' ἡμῶν;
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1692.2.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1692.2.text#εὖ γε μέντἂν διετέθην.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1693.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1693.1.text#ἀλλὰ γαμικὴν χλανίδα δότω τις δεῦρό μοι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1694.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1694.1.text#ἔστι δ' ἐν Φαναῖσι πρὸς τῇ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1695.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1695.1.text#Κλεψύδρᾳ πανοῦργον ἐγ-
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1696.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1696.1.text#γλωττογαστόρων γένος,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1697.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1697.1.text#οἳ θερίζουσίν τε καὶ σπείρουσι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1698.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1698.1.text#καὶ τρυγῶσι ταῖς γλώτταισι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1699.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1699.1.text#συκάζουσί τε·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1700.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1700.1.text#βάρβαροι δ' εἰσὶν γένος,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1701.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1701.1.text#Γοργίαι τε καὶ Φίλιπποι.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1702.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1702.1.text#κἀπὸ τῶν ἐγγλωττογαστόρων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1703.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1703.1.text#ἐκείνων τῶν Φιλίππων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1704.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1704.1.text#πανταχοῦ τῆς Ἀττικῆς ἡ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1705.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1705.1.text#γλῶττα χωρὶς τέμνεται.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1706.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1706.1.text#ὦ πάντ' ἀγαθὰ πράττοντες, ὦ μείζω λόγου,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1707.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1707.1.text#ὦ τρισμακάριον πτηνὸν ὀρνίθων γένος,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1708.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1708.1.text#δέχεσθε τὸν τύραννον ὀλβίοις δόμοις.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1709.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1709.1.text#προσέρχεται γὰρ οἷς οὔτε παμφαὴς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1710.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1710.1.text#ἀστὴρ ἰδεῖν ἔλαμψε χρυσαυγεῖ δόμῳ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1711.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1711.1.text#οὔθ' ἡλίου τηλαυγὲς ἀκτίνων σέλας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1712.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1712.1.text#τοιοῦτον ἐξέλαμψεν, οἶον ἔρχεται
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1713.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1713.1.text#ἔχων γυναικὸς κάλλος οὐ φατὸν λέγειν,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1714.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1714.1.text#πάλλων κεραυνόν, πτεροφόρον Διὸς βέλος·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1715.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1715.1.text#ὀσμὴ δ' ἀνωνόμαστος ἐς βάθος κύκλου
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1716.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1716.1.text#χωρεῖ, καλὸν θέαμα· θυμιαμάτων δ'
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1717.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1717.1.text#αὖραι διαψαίρουσι πλεκτάνην καπνοῦ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1718.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1718.1.text#ὁδὶ δὲ καὐτός ἐστιν. ἀλλὰ χρὴ θεᾶς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1719.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1719.1.text#Μούσης ἀνοίγειν ἱερὸν εὔφημον στόμα.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1720.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1720.1.text#ἄναγε δίεχε πάραγε πάρεχε.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1721.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1721.1.text#περιπέτεσθε
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1722.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1722.1.text#τὸν μάκαρα μάκαρι σὺν τύχᾳ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1723.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1723.1.text#ὦ φεῦ φεῦ τῆς ὥρας τοῦ κάλλους.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1725.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1725.1.text#ὦ μακαριστὸν σὺ γάμον τῇδε πόλει γημας.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1726.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1726.1.text#μεγάλαι μεγάλαι κατέχουσι τύχαι
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1727.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1727.1.text#γένος ὀρνίθων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1728.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1728.1.text#διὰ τόνδε τὸν ἄνδρ'. ἀλλ' ὑμεναίοις
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1729.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1729.1.text#καὶ νυμφιδίοισι δέχεσθ' ᾠδαῖς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1730.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1730.1.text#αὐτὸν καὶ τὴν Βασίλειαν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1731.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1731.1.text#Ἥρᾳ ποτ' Ὀλυμπίᾳ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1732.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1732.1.text#τῶν ἠλιβάτων θρόνων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1733.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1733.1.text#ἄρχοντα θεοῖς μέγαν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1734.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1734.1.text#Μοῖραι ξυνεκοίμισαν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1735.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1735.1.text#ἐν τοιῷδ' ὑμεναίῳ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1736.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1736.1.text#Ὑμὴν ὦ Ὑμέναι' ὦ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1736a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1736a.1.text# Ὑμὴν ὦ Ὑμέναι' ὦ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1737.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1737.1.text#ὁ δ' ἀμφιθαλὴς Ἔρως
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1738.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1738.1.text#χρυσόπτερος ἡνίας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1739.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1739.1.text#ηὔθυνε παλιντόνους,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1740.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1740.1.text#Ζηνὸς πάροχος γάμων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1741.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1741.1.text#τῆς τ' εὐδαίμονος Ἥρας.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1742.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1742.1.text#Ὑμὴν ὦ Ὑμέναι' ὦ,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1742a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1742a.1.text#Ὑμὴν ὦ Ὑμέναι' ὦ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1743.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1743.1.text#ἐχάρην ὕμνοις, ἐχάρην ᾠδαῖς·
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1744.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1744.1.text#ἄγαμαι δὲ λόγων. ἄγε νυν αὐτοῦ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1745.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1745.1.text#καὶ τὰς χθονίας κλῄσατε βροντὰς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1746.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1746.1.text#τάς τε πυρώδεις Διὸς ἀστεροπὰς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1747.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1747.1.text#δεινόν τ' ἀργῆτα κεραυνόν.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1748.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1748.1.text#ὦ μέγα χρύσεον ἀστεροπῆς φάος,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1749.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1749.1.text#ὦ Διὸς ἄμβροτον ἔγχος πυρφόρον,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1750.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1750.1.text#ὦ χθόνιαι βαρυαχέες
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1751.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1751.1.text#ὀμβροφόροι θ' ἅμα βρονταί,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1752.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1752.1.text#αἷς ὅδε νῦν χθόνα σείει.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1753.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1753.1.text#διὰ σὲ τὰ πάντα κρατήσας
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1754.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1754.1.text#καὶ πάρεδρον Βασίλειαν ἔχει Διός.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1754a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1754a.1.text#Ὑμὴν ὦ Ὑμέναι' ὦ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1755.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1755.1.text#ἔπεσθε νῦν γάμοισιν ὦ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1756.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1756.1.text#φῦλα πάντα συννόμων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1757.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1757.1.text#πτεροφόρ' ἐπὶ δάπεδον Διὸς
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1758.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1758.1.text#καὶ λέχος γαμήλιον.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1759.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1759.1.text#ὄρεξον ὦ μάκαιρα σὴν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1760.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1760.1.text#χεῖρα καὶ πτερῶν ἐμῶν
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1761.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1761.1.text#λαβοῦσα συγχόρευσον· αἴρων
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1762.1.speaker#Πισθέταιρος
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1762.1.text#δὲ κουφιῶ σ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1763.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1763.1.text#ἀλαλαλαὶ ἰὴ παιών,
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1764.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1764.1.text#τήνελλα καλλίνικος, ὦ
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1765.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg006.fu-sp:1765.1.text#δαιμόνων ὑπέρτατε.
