#!ctsdata
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1.1.text#ἀλλ' εἴ τις ἐς Βακχεῖον αὐτὰς ἐκάλεσεν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:2.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:2.1.text#ἢ 'ς Πανὸς ἢ 'πὶ Κωλιάδ' ἢ 'ς Γενετυλλίδος,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:3.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:3.1.text#οὐδ' ἂν διελθεῖν ἦν ἂν ὑπὸ τῶν τυμπάνων.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:4.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:4.1.text#νῦν δ' οὐδεμία πάρεστιν ἐνταυθοῖ γυνή·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:5.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:5.1.text#πλὴν ἥ γ' ἐμὴ κωμῆτις ἥδ' ἐξέρχεται.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:6.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:6.1.text#χαῖρ' ὦ Καλονίκη.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:6.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:6.2.text#καὶ σύ γ' ὦ Λυσιστράτη.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:7.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:7.1.text#τί συντετάραξαι; μὴ σκυθρώπαζ' ὦ τέκνον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:8.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:8.1.text#οὐ γὰρ πρέπει σοι τοξοποιεῖν τὰς ὀφρῦς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:9.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:9.1.text#ἀλλ' ὦ Καλονίκη κάομαι τὴν καρδίαν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:10.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:10.1.text#καὶ πόλλ' ὑπὲρ ἡμῶν τῶν γυναικῶν ἄχθομαι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:11.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:11.1.text#ὁτιὴ παρὰ μὲν τοῖς ἀνδράσιν νενομίσμεθα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:12.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:12.1.text#εἶναι πανοῦργοι—
urn:cts:greekLit:tlg0019.tlg007.fu.sp:12.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:12.2.text#καὶ γάρ ἐσμεν νὴ Δία.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:13.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:13.1.text#εἰρημένον δ' αὐταῖς ἀπαντᾶν ἐνθάδε
urn:cts:greekLit:tlg0019.tlg007.fu.sp:14.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:14.1.text#βουλευσομέναισιν οὐ περὶ φαύλου πράγματος,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:15.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:15.1.text#εὕδουσι κοὐχ ἥκουσιν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:15.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:15.2.text#ἀλλ' ὦ φιλτάτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:16.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:16.1.text#ἥξουσι· χαλεπή τοι γυναικῶν ἔξοδος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:17.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:17.1.text#ἡ μὲν γὰρ ἡμῶν περὶ τὸν ἄνδρ' ἐκύπτασεν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:18.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:18.1.text#ἡ δ' οἰκέτην ἤγειρεν, ἡ δὲ παιδίον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:19.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:19.1.text#κατέκλινεν, ἡ δ' ἔλουσεν, ἡ δ' ἐψώμισεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:20.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:20.1.text#ἀλλ' ἕτερά τἄρ' ἦν τῶνδε προὐργιαίτερα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:21.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:21.1.text#αὐταῖς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:21.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:21.2.text#τί δ' ἐστὶν ὦ φίλη Λυσιστράτη,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:22.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:22.1.text#ἐφ' ὅ τι ποθ' ἡμᾶς τὰς γυναῖκας συγκαλεῖς;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:23.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:23.1.text#τί τὸ πρᾶγμα; πηλίκον τι;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:23.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:23.2.text#μέγα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:23.3.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:23.3.text#μῶν καὶ παχύ;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:24.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:24.1.text#καὶ νὴ Δία παχύ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:24.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:24.2.text#κᾆτα πῶς οὐχ ἥκομεν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:25.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:25.1.text#οὐχ οὗτος ὁ τρόπος· ταχὺ γὰρ ἂν ξυνήλθομεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:26.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:26.1.text#ἀλλ' ἔστιν ὑπ' ἐμοῦ πρᾶγμ' ἀνεζητημένον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:27.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:27.1.text#πολλαῖσί τ' ἀγρυπνίαισιν ἐρριπτασμένον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:28.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:28.1.text#ἦ πού τι λεπτόν ἐστι τοὐρριπτασμένον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:29.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:29.1.text#οὕτω γε λεπτὸν ὥσθ' ὅλης τῆς Ἑλλάδος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:30.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:30.1.text#ἐν ταῖς γυναιξίν ἐστιν ἡ σωτηρία.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:31.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:31.1.text#ἐν ταῖς γυναιξίν; ἐπ' ὀλίγου γ' ὠχεῖτ' ἄρα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:32.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:32.1.text#ὡς ἔστ' ἐν ἡμῖν τῆς πόλεως τὰ πράγματα,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:33.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:33.1.text#ἢ μηκέτ' εἶναι μήτε Πελοποννησίους—
urn:cts:greekLit:tlg0019.tlg007.fu.sp:34.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:34.1.text#βέλτιστα τοίνυν μηκέτ' εἶναι νὴ Δία.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:35.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:35.1.text#Βοιωτίους τε πάντας ἐξολωλέναι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:36.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:36.1.text#μὴ δῆτα πάντας γ', ἀλλ' ἄφελε τὰς ἐγχέλεις.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:37.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:37.1.text#περὶ τῶν Ἀθηνῶν δ' οὐκ ἐπιγλωττήσομαι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:38.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:38.1.text#τοιοῦτον οὐδέν· ἀλλ' ὑπονόησον σύ μοι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:39.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:39.1.text#ἢν δὲ ξυνέλθωσ' αἱ γυναῖκες ἐνθάδε
urn:cts:greekLit:tlg0019.tlg007.fu.sp:40.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:40.1.text#αἵ τ' ἐκ Βοιωτῶν αἵ τε Πελοποννησίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:41.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:41.1.text#ἡμεῖς τε, κοινῇ σώσομεν τὴν Ἑλλάδα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:42.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:42.1.text#τί δ' ἂν γυναῖκες φρόνιμον ἐργασαίατο
urn:cts:greekLit:tlg0019.tlg007.fu.sp:43.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:43.1.text#ἢ λαμπρόν, αἳ καθήμεθ' ἐξηνθισμέναι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:44.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:44.1.text#κροκωτοφοροῦσαι καὶ κεκαλλωπισμέναι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:45.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:45.1.text#καὶ Κιμμερίκ' ὀρθοστάδια καὶ περιβαρίδας;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:46.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:46.1.text#ταῦτ' αὐτὰ γάρ τοι κἄσθ' ἃ σώσειν προσδοκῶ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:47.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:47.1.text#τὰ κροκωτίδια καὶ τὰ μύρα χαἰ περιβαρίδες
urn:cts:greekLit:tlg0019.tlg007.fu.sp:48.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:48.1.text#χἤγχουσα καὶ τὰ διαφανῆ χιτώνια.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:49.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:49.1.text#τίνα δὴ τρόπον ποθ';
urn:cts:greekLit:tlg0019.tlg007.fu.sp:49.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:49.2.text#ὥστε τῶν νῦν μηδένα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:50.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:50.1.text#ἀνδρῶν ἐπ' ἀλλήλοισιν ἄρεσθαι δόρυ—
urn:cts:greekLit:tlg0019.tlg007.fu.sp:51.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:51.1.text#κροκωτὸν ἄρα νὴ τὼ θεὼ 'γὼ βάψομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:52.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:52.1.text#μηδ' ἀσπίδα λαβεῖν—
urn:cts:greekLit:tlg0019.tlg007.fu.sp:52.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:52.2.text#Κιμμερικὸν ἐνδύσομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:53.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:53.1.text#μηδὲ ξιφίδιον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:53.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:53.2.text#κτήσομαι περιβαρίδας.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:54.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:54.1.text#ἆρ' οὐ παρεῖναι τὰς γυναῖκας δῆτ' ἐχρῆν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:55.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:55.1.text#οὐ γὰρ μὰ Δί' ἀλλὰ πετομένας ἥκειν πάλαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:56.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:56.1.text#ἀλλ' ὦ μέλ' ὄψει τοι σφόδρ' αὐτὰς Ἀττικάς,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:57.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:57.1.text#ἅπαντα δρώσας τοῦ δέοντος ὕστερον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:58.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:58.1.text#ἀλλ' οὐδὲ Παράλων οὐδεμία γυνὴ πάρα,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:59.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:59.1.text#οὐδ' ἐκ Σαλαμῖνος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:59.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:59.2.text#ἀλλ' ἐκεῖναί γ' οἶδ' ὅτι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:60.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:60.1.text#ἐπὶ τῶν κελήτων διαβεβήκασ' ὄρθριαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:61.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:61.1.text#οὐδ' ἃς προσεδόκων κἀλογιζόμην ἐγὼ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:62.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:62.1.text#πρώτας παρέσεσθαι δεῦρο τὰς Ἀχαρνέων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:63.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:63.1.text#γυναῖκας, οὐχ ἥκουσιν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:63.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:63.2.text#ἡ γοῦν Θεογένους
urn:cts:greekLit:tlg0019.tlg007.fu.sp:64.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:64.1.text#ὡς δεῦρ' ἰοῦσα θοὐκάταιον ἤρετο.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:65.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:65.1.text#ἀτὰρ αἵδε καὶ δή σοι προσέρχονταί τινες.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:66.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:66.1.text#αἱδί θ' ἕτεραι χωροῦσί τινες. ἰοὺ ἰού,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:67.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:67.1.text#πόθεν εἰσίν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:67.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:67.2.text#Ἀναγυρουντόθεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:67.3.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:67.3.text#νὴ τὸν Δία·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:68.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:68.1.text#ὁ γοῦν ἀνάγυρός μοι κεκινῆσθαι δοκεῖ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:69.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:69.1.text#μῶν ὕστεραι πάρεσμεν ὦ Λυσιστράτη;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:70.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:70.1.text#τί φῄς; τί σιγᾷς;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:70.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:70.2.text#οὔ σ' ἐπαινῶ Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:71.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:71.1.text#ἥκουσαν ἄρτι περὶ τοιούτου πράγματος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:72.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:72.1.text#μόλις γὰρ ηὗρον ἐν σκότῳ τὸ ζώνιον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:73.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:73.1.text#ἀλλ' εἴ τι πάνυ δεῖ, ταῖς παρούσαισιν λέγε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:74.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:74.1.text#μὰ Δί' ἀλλ' ἐπαναμείνωμεν ὀλίγου γ' οὕνεκα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:75.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:75.1.text#τάς τ' ἐκ Βοιωτῶν τάς τε Πελοποννησίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:76.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:76.1.text#γυναῖκας ἐλθεῖν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:76.2.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:76.2.text#πολὺ σὺ κάλλιον λέγεις.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:77.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:77.1.text#ἡδὶ δὲ καὶ δὴ Λαμπιτὼ προσέρχεται.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:78.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:78.1.text#ὦ φιλτάτη Λάκαινα χαῖρε Λαμπιτοῖ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:79.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:79.1.text#οἷον τὸ κάλλος γλυκυτάτη σου φαίνεται.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:80.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:80.1.text#ὡς δ' εὐχροεῖς, ὡς δὲ σφριγᾷ τὸ σῶμά σου.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:81.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:81.1.text#κἂν ταῦρον ἄγχοις.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:81.2.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:81.2.text#μάλα γ' οἰῶ ναὶ τὼ σιώ·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:82.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:82.1.text#γυμνάδδομαι γὰρ καὶ ποτὶ πυγὰν ἅλλομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:83.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:83.1.text#ὡς δὴ καλὸν τὸ χρῆμα τιτθίων ἔχεις.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:84.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:84.1.text#ᾇπερ ἱερεῖόν τοί μ' ὑποψαλάσσετε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:85.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:85.1.text#ἡδὶ δὲ ποδαπή 'σθ' ἡ νεᾶνις ἡτέρα;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:86.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:86.1.text#πρέσβειρά τοι ναὶ τὼ σιὼ Βοιωτία
urn:cts:greekLit:tlg0019.tlg007.fu.sp:87.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:87.1.text#ἵκει ποθ' ὑμέ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:87.2.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:87.2.text#νὴ μὰ Δία Βοιωτία,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:88.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:88.1.text#καλόν γ' ἔχουσα τὸ πεδίον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:88.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:88.2.text#καὶ νὴ Δία
urn:cts:greekLit:tlg0019.tlg007.fu.sp:89.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:89.1.text#κομψότατα τὴν βληχώ γε παρατετιλμένη.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:90.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:90.1.text#τίς δ' ἡτέρα παῖς;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:90.2.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:90.2.text#χαΐα ναὶ τὼ σιώ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:91.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:91.1.text#Κορινθία δ' αὖ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:91.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:91.2.text#χαΐα νὴ τὸν Δία
urn:cts:greekLit:tlg0019.tlg007.fu.sp:92.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:92.1.text#δήλη 'στὶν οὖσα ταυταγὶ τἀντευθενί.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:93.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:93.1.text#τίς δ' αὖ ξυναλίαξε τόνδε τὸν στόλον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:94.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:94.1.text#τὸν τᾶν γυναικῶν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:94.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:94.2.text#ἥδ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:94.3.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:94.3.text#μύσιδδέ τοι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:95.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:95.1.text#ὅ τι λῇς ποθ' ἁμέ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:95.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:95.2.text#νὴ Δί' ὦ φίλη γύναι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:96.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:96.1.text#λέγε δῆτα τὸ σπουδαῖον ὅ τι τοῦτ' ἐστί σοι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:97.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:97.1.text#λέγοιμ' ἂν ἤδη. πρὶν λέγειν δ', ὑμᾶς τοδὶ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:98.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:98.1.text#ἐπερήσομαί τι μικρόν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:98.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:98.2.text#ὅ τι βούλει γε σύ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:99.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:99.1.text#τοὺς πατέρας οὐ ποθεῖτε τοὺς τῶν παιδίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:100.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:100.1.text#ἐπὶ στρατιᾶς ἀπόντας; εὖ γὰρ οἶδ' ὅτι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:101.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:101.1.text#πάσαισιν ὑμῖν ἐστιν ἀποδημῶν ἀνήρ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:102.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:102.1.text#ὁ γοῦν ἐμὸς ἀνὴρ πέντε μῆνας ὦ τάλαν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:103.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:103.1.text#ἄπεστιν ἐπὶ Θρᾴκης φυλάττων Εὐκράτη.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:104.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:104.1.text#ὁ δ' ἐμός γε τελέους ἑπτὰ μῆνας ἐν Πύλῳ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:105.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:105.1.text#ὁ δ' ἐμός γα καἴ κ' ἐκ τᾶς ταγᾶς ἔλσῃ ποκά,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:106.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:106.1.text#πορπακισάμενος φροῦδος ἀμπτάμενος ἔβα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:107.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:107.1.text#ἀλλ' οὐδὲ μοιχοῦ καταλέλειπται φεψάλυξ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:108.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:108.1.text#ἐξ οὗ γὰρ ἡμᾶς προὔδοσαν Μιλήσιοι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:109.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:109.1.text#οὐκ εἶδον οὐδ' ὄλισβον ὀκτωδάκτυλον,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:110.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:110.1.text#ὃς ἦν ἂν ἡμῖν σκυτίνη 'πικουρία.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:111.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:111.1.text#ἐθέλοιτ' ἂν οὖν, εἰ μηχανὴν εὕροιμ' ἐγώ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:112.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:112.1.text#μετ' ἐμοῦ καταλῦσαι τὸν πόλεμον;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:112.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:112.2.text#νὴ τὼ θεώ·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:113.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:113.1.text#ἔγωγ' ἂν οὖν κἂν εἴ με χρείη τοὔγκυκλον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:114.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:114.1.text#τουτὶ καταθεῖσαν ἐκπιεῖν αὐθημερόν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:115.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:115.1.text#ἐγὼ δέ γ' ἂν κἂν ὡσπερεὶ ψῆτταν δοκῶ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:116.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:116.1.text#δοῦναι ἂν ἐμαυτῆς παρατεμοῦσα θἤμισυ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:117.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:117.1.text#ἐγὼ δὲ καί κα ποττὸ Ταΰγετόν γ' ἄνω
urn:cts:greekLit:tlg0019.tlg007.fu.sp:118.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:118.1.text#ἔλσοιμ' ὅπᾳ μέλλοιμί γ' εἰράναν ἰδεῖν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:119.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:119.1.text#λέγοιμ' ἄν· οὐ δεῖ γὰρ κεκρύφθαι τὸν λόγον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:120.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:120.1.text#ἡμῖν γὰρ ὦ γυναῖκες, εἴπερ μέλλομεν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:121.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:121.1.text#ἀναγκάσειν τοὺς ἄνδρας εἰρήνην ἄγειν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:122.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:122.1.text#ἀφεκτέ' ἐστὶ—
urn:cts:greekLit:tlg0019.tlg007.fu.sp:122.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:122.2.text#τοῦ; φράσον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:122.3.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:122.3.text#ποιήσετ' οὖν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:123.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:123.1.text#ποιήσομεν, κἂν ἀποθανεῖν ἡμᾶς δέῃ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:124.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:124.1.text#ἀφεκτέα τοίνυν ἐστὶν ἡμῖν τοῦ πέους.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:125.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:125.1.text#τί μοι μεταστρέφεσθε; ποῖ βαδίζετε;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:126.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:126.1.text#αὗται τί μοιμυᾶτε κἀνανεύετε;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:127.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:127.1.text#τί χρὼς τέτραπται; τί δάκρυον κατείβεται;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:128.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:128.1.text#ποιήσετ' ἢ οὐ ποιήσετ'; ἢ τί μέλλετε;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:129.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:129.1.text#οὐκ ἂν ποιήσαιμ', ἀλλ' ὁ πόλεμος ἑρπέτω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:130.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:130.1.text#μὰ Δί' οὐδ' ἐγὼ γάρ, ἀλλ' ὁ πόλεμος ἑρπέτω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:131.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:131.1.text#ταυτὶ σὺ λέγεις ὦ ψῆττα; καὶ μὴν ἄρτι γε
urn:cts:greekLit:tlg0019.tlg007.fu.sp:132.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:132.1.text#ἔφησθα σαυτῆς κἂν παρατεμεῖν θἤμισυ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:133.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:133.1.text#ἄλλ' ἄλλ' ὅ τι βούλει· κἄν με χρῇ διὰ τοῦ πυρὸς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:134.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:134.1.text#ἐθέλω βαδίζειν· τοῦτο μᾶλλον τοῦ πέους.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:135.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:135.1.text#οὐδὲν γὰρ οἷον ὦ φίλη Λυσιστράτη.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:136.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:136.1.text#τί δαὶ σύ;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:136.2.speaker#Ἄλλη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:136.2.text#κἀγὼ βούλομαι διὰ τοῦ πυρός.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:137.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:137.1.text#ὦ παγκατάπυγον θἠμέτερον ἅπαν γένος,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:138.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:138.1.text#οὐκ ἐτὸς ἀφ' ἡμῶν εἰσιν αἱ τραγῳδίαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:139.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:139.1.text#οὐδὲν γάρ ἐσμεν πλὴν Ποσειδῶν καὶ σκάφη.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:140.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:140.1.text#ἀλλ' ὦ φίλη Λάκαινα, σὺ γὰρ ἐὰν γένῃ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:141.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:141.1.text#μόνη μετ' ἐμοῦ, τὸ πρᾶγμ' ἀνασωσαίμεσθ' ἔτ' ἄν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:142.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:142.1.text#ξυμψήφισαί μοι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:142.2.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:142.2.text#χαλεπὰ μὲν ναὶ τὼ σιὼ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:143.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:143.1.text#γυναῖκάς ἐσθ' ὑπνῶν ἄνευ ψωλᾶς μόνας.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:144.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:144.1.text#ὅμως γα μάν· δεῖ τᾶς γὰρ εἰράνας μάλ' αὖ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:145.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:145.1.text#ὦ φιλτάτη σὺ καὶ μόνη τούτων γυνή.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:146.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:146.1.text#εἰ δ' ὡς μάλιστ' ἀπεχοίμεθ' οὗ σὺ δὴ λέγεις,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:147.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:147.1.text#ὃ μὴ γένοιτο, μᾶλλον ἂν διὰ τουτογὶ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:148.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:148.1.text#γένοιτ' ἂν εἰρήνη;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:148.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:148.2.text#πολύ γε νὴ τὼ θεώ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:149.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:149.1.text#εἰ γὰρ καθοίμεθ' ἔνδον ἐντετριμμέναι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:150.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:150.1.text#κἀν τοῖς χιτωνίοισι τοῖς Ἀμοργίνοις
urn:cts:greekLit:tlg0019.tlg007.fu.sp:151.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:151.1.text#γυμναὶ παρίοιμεν δέλτα παρατετιλμέναι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:152.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:152.1.text#στύοιντο δ' ἅνδρες κἀπιθυμοῖεν σπλεκοῦν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:153.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:153.1.text#ἡμεῖς δὲ μὴ προσίοιμεν ἀλλ' ἀπεχοίμεθα,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:154.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:154.1.text#σπονδὰς ποιήσαιντ' ἂν ταχέως, εὖ οἶδ' ὅτι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:155.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:155.1.text#ὁ γῶν Μενέλαος τᾶς Ἑλένας τὰ μᾶλά πᾳ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:156.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:156.1.text#γυμνᾶς παραϊδὼν ἐξέβαλ', οἰῶ, τὸ ξίφος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:157.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:157.1.text#τί δ' ἢν ἀφιῶσ' ἅνδρες ἡμᾶς ὦ μέλε;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:158.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:158.1.text#τὸ τοῦ Φερεκράτους, κύνα δέρειν δεδαρμένην.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:159.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:159.1.text#φλυαρία ταῦτ' ἐστὶ τὰ μεμιμημένα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:160.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:160.1.text#ἐὰν λαβόντες δ' ἐς τὸ δωμάτιον βίᾳ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:161.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:161.1.text#ἕλκωσιν ἡμᾶς;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:161.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:161.2.text#ἀντέχου σὺ τῶν θυρῶν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:162.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:162.1.text#ἐὰν δὲ τύπτωσιν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:162.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:162.2.text#παρέχειν χρὴ κακὰ κακῶς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:163.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:163.1.text#οὐ γὰρ ἔνι τούτοις ἡδονὴ τοῖς πρὸς βίαν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:164.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:164.1.text#κἄλλως ὀδυνᾶν χρή· κἀμέλει ταχέως πάνυ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:165.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:165.1.text#ἀπεροῦσιν. οὐ γὰρ οὐδέποτ' εὐφρανθήσεται
urn:cts:greekLit:tlg0019.tlg007.fu.sp:166.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:166.1.text#ἀνήρ, ἐὰν μὴ τῇ γυναικὶ συμφέρῃ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:167.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:167.1.text#εἴ τοι δοκεῖ σφῷν ταῦτα, χἠμῖν ξυνδοκεῖ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:168.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:168.1.text#καὶ τὼς μὲν ἁμῶν ἄνδρας ἁμὲς πείσομες
urn:cts:greekLit:tlg0019.tlg007.fu.sp:169.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:169.1.text#παντᾷ δικαίως ἄδολον εἰράναν ἄγειν·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:170.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:170.1.text#τὸν τῶν Ἀσαναίων γα μὰν ῥυάχετον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:171.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:171.1.text#πᾷ κά τις ἀμπείσειεν αὖ μὴ πλαδδιῆν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:172.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:172.1.text#ἡμεῖς ἀμέλει σοι τά γε παρ' ἡμῖν πείσομεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:173.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:173.1.text#οὐχ ἇς πόδας κ' ἔχωντι ταὶ τριήρεες,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:174.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:174.1.text#καὶ τὠργύριον τὤβυσσον ᾖ πὰρ τᾷ σιῷ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:175.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:175.1.text#ἀλλ' ἔστι καὶ τοῦτ' εὖ παρεσκευασμένον·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:176.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:176.1.text#καταληψόμεθα γὰρ τὴν ἀκρόπολιν τήμερον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:177.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:177.1.text#ταῖς πρεσβυτάταις γὰρ προστέτακται τοῦτο δρᾶν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:178.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:178.1.text#ἕως ἂν ἡμεῖς ταῦτα συντιθώμεθα,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:179.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:179.1.text#θύειν δοκούσαις καταλαβεῖν τὴν ἀκρόπολιν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:180.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:180.1.text#παντᾷ κ' ἔχοι, καὶ τᾷδε γὰρ λέγεις καλῶς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:181.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:181.1.text#τί δῆτα ταῦτ' οὐχ ὡς τάχιστ' ὦ Λαμπιτοῖ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:182.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:182.1.text#ξυνωμόσαμεν, ὅπως ἂν ἀρρήκτως ἔχῃ;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:183.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:183.1.text#πάρφαινε μὰν τὸν ὅρκον, ὡς ὀμιόμεθα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:184.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:184.1.text#καλῶς λέγεις. ποῦ 'σθ' ἡ Σκύθαινα; ποῖ βλέπεις;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:185.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:185.1.text#θὲς ἐς τὸ πρόσθεν ὑπτίαν τὴν ἀσπίδα,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:186.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:186.1.text#καί μοι δότω τὰ τόμιά τις.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:186.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:186.2.text#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:187.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:187.1.text#τίν' ὅρκον ὁρκώσεις ποθ' ἡμᾶς;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:187.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:187.2.text#ὅντινα;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:188.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:188.1.text#εἰς ἀσπίδ', ὥσπερ φάσ' ἐν Αἰσχύλῳ ποτέ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:189.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:189.1.text#μηλοσφαγούσας.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:189.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:189.2.text#μὴ σύ γ' ὦ Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:190.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:190.1.text#εἰς ἀσπίδ' ὀμόσῃς μηδὲν εἰρήνης πέρι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:191.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:191.1.text#τίς ἂν οὖν γένοιτ' ἂν ὅρκος;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:191.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:191.2.text#εἰ λευκόν ποθεν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:192.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:192.1.text#ἵππον λαβοῦσαι τόμιον ἐντεμοίμεθα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:193.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:193.1.text#ποῖ λευκὸν ἵππον;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:193.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:193.2.text#ἀλλὰ πῶς ὀμούμεθα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:194.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:194.1.text#ἡμεῖς;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:194.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:194.2.text#ἐγώ σοι νὴ Δί', ἢν βούλῃ, φράσω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:195.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:195.1.text#θεῖσαι μέλαιναν κύλικα μεγάλην ὑπτίαν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:196.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:196.1.text#μηλοσφαγοῦσαι Θάσιον οἴνου σταμνίον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:197.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:197.1.text#ὀμόσωμεν ἐς τὴν κύλικα μὴ 'πιχεῖν ὕδωρ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:198.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:198.1.text#φεῦ δᾶ τὸν ὅρκον ἄφατον ὡς ἐπαινίω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:199.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:199.1.text#φερέτω κύλικά τις ἔνδοθεν καὶ σταμνίον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:200.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:200.1.text#ὦ φίλταται γυναῖκες, ὁ κεραμεὼν ὅσος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:201.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:201.1.text#ταύτην μὲν ἄν τις εὐθὺς ἡσθείη λαβών.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:202.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:202.1.text#καταθεῖσα ταύτην προσλαβοῦ μοι τοῦ κάπρου.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:203.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:203.1.text#δέσποινα Πειθοῖ καὶ κύλιξ φιλοτησία,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:204.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:204.1.text#τὰ σφάγια δέξαι ταῖς γυναιξὶν εὐμενής.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:205.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:205.1.text#εὔχρων γε θαἶμα κἀποπυτίζει καλῶς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:206.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:206.1.text#καὶ μὰν ποτόδδει γ' ἁδὺ ναὶ τὸν Κάστορα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:207.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:207.1.text#ἐᾶτε πρώτην μ' ὦ γυναῖκες ὀμνύναι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:208.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:208.1.text#μὰ τὴν Ἀφροδίτην οὔκ, ἐάν γε μὴ λάχῃς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:209.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:209.1.text#λάζυσθε πᾶσαι τῆς κύλικος ὦ Λαμπιτοῖ·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:210.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:210.1.text#λεγέτω δ' ὑπὲρ ὑμῶν μί' ἅπερ ἂν κἀγὼ λέγω·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:211.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:211.1.text#ὑμεῖς δ' ἐπομεῖσθε ταὐτὰ κἀμπεδώσετε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:212.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:212.1.text#οὐκ ἔστιν οὐδεὶς οὔτε μοιχὸς οὔτ' ἀνήρ—
urn:cts:greekLit:tlg0019.tlg007.fu.sp:213.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:213.1.text#οὐκ ἔστιν οὐδεὶς οὔτε μοιχὸς οὔτ' ἀνήρ—
urn:cts:greekLit:tlg0019.tlg007.fu.sp:214.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:214.1.text#ὅστις πρὸς ἐμὲ πρόσεισιν ἐστυκώς. λέγε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:215.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:215.1.text#ὅστις πρὸς ἐμὲ πρόσεισιν ἐστυκώς. παπαῖ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:216.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:216.1.text#ὑπολύεταί μου τὰ γόνατ' ὦ Λυσιστράτη.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:217.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:217.1.text#οἴκοι δ' ἀταυρώτη διάξω τὸν βίον—
urn:cts:greekLit:tlg0019.tlg007.fu.sp:218.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:218.1.text#οἴκοι δ' ἀταυρώτη διάξω τὸν βίον—
urn:cts:greekLit:tlg0019.tlg007.fu.sp:219.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:219.1.text#κροκωτοφοροῦσα καὶ κεκαλλωπισμένη,—
urn:cts:greekLit:tlg0019.tlg007.fu.sp:220.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:220.1.text#κροκωτοφοροῦσα καὶ κεκαλλωπισμένη,—
urn:cts:greekLit:tlg0019.tlg007.fu.sp:221.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:221.1.text#ὅπως ἂν ἁνὴρ ἐπιτυφῇ μάλιστά μου·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:222.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:222.1.text#ὅπως ἂν ἁνὴρ ἐπιτυφῇ μάλιστά μου·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:223.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:223.1.text#κοὐδέποθ' ἑκοῦσα τἀνδρὶ τὠμῷ πείσομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:224.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:224.1.text#κοὐδέποθ' ἑκοῦσα τἀνδρὶ τὠμῷ πείσομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:225.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:225.1.text#ἐὰν δέ μ' ἄκουσαν βιάζηται βίᾳ,—
urn:cts:greekLit:tlg0019.tlg007.fu.sp:226.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:226.1.text#ἐὰν δέ μ' ἄκουσαν βιάζηται βίᾳ,—
urn:cts:greekLit:tlg0019.tlg007.fu.sp:227.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:227.1.text#κακῶς παρέξω κοὐχὶ προσκινήσομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:228.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:228.1.text#κακῶς παρέξω κοὐχὶ προσκινήσομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:229.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:229.1.text#οὐ πρὸς τὸν ὄροφον ἀνατενῶ τὼ Περσικά.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:230.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:230.1.text#οὐ πρὸς τὸν ὄροφον ἀνατενῶ τὼ Περσικά.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:231.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:231.1.text#οὐ στήσομαι λέαιν' ἐπὶ τυροκνήστιδος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:232.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:232.1.text#οὐ στήσομαι λέαιν' ἐπὶ τυροκνήστιδος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:233.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:233.1.text#ταῦτ' ἐμπεδοῦσα μὲν πίοιμ' ἐντευθενί·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:234.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:234.1.text#ταῦτ' ἐμπεδοῦσα μὲν πίοιμ' ἐντευθενί·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:235.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:235.1.text#εἰ δὲ παραβαίην, ὕδατος ἐμπλῇθ' ἡ κύλιξ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:236.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:236.1.text#εἰ δὲ παραβαίην, ὕδατος ἐμπλῇθ' ἡ κύλιξ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:237.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:237.1.text#συνεπόμνυθ' ὑμεῖς ταῦτα πᾶσαι;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:237.2.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:237.2.text#νὴ Δία.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:238.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:238.1.text#φέρ' ἐγὼ καθαγίσω τήνδε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:238.2.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:238.2.text#τὸ μέρος γ' ὦ φίλη,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:239.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:239.1.text#ὅπως ἂν ὦμεν εὐθὺς ἀλλήλων φίλαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:240.1.speaker#Λαμπιτώ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:240.1.text#τίς ὡλολυγά;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:240.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:240.2.text#τοῦτ' ἐκεῖν' οὑγὼ 'λεγον·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:241.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:241.1.text#αἱ γὰρ γυναῖκες τὴν ἀκρόπολιν τῆς θεοῦ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:242.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:242.1.text#ἤδη κατειλήφασιν. ἀλλ' ὦ Λαμπιτοῖ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:243.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:243.1.text#σὺ μὲν βάδιζε καὶ τὰ παρ' ὑμῶν εὖ τίθει,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:244.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:244.1.text#τασδὶ δ' ὁμήρους κατάλιφ' ἡμῖν ἐνθάδε·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:245.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:245.1.text#ἡμεῖς δὲ ταῖς ἄλλαισι ταῖσιν ἐν πόλει
urn:cts:greekLit:tlg0019.tlg007.fu.sp:246.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:246.1.text#ξυνεμβάλωμεν εἰσιοῦσαι τοὺς μοχλούς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:247.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:247.1.text#οὔκουν ἐφ' ἡμᾶς ξυμβοηθήσειν οἴει
urn:cts:greekLit:tlg0019.tlg007.fu.sp:248.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:248.1.text#τοὺς ἄνδρας εὐθύς;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:248.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:248.2.text#ὀλίγον αὐτῶν μοι μέλει.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:249.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:249.1.text#οὐ γὰρ τοσαύτας οὔτ' ἀπειλὰς οὔτε πῦρ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:250.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:250.1.text#ἥξουσ' ἔχοντες ὥστ' ἀνοῖξαι τὰς πύλας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:251.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:251.1.text#ταύτας, ἐὰν μὴ 'φ' οἷσιν ἡμεῖς εἴπομεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:252.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:252.1.text#μὰ τὴν Ἀφροδίτην οὐδέποτέ γ'· ἄλλως γὰρ ἂν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:253.1.speaker#Καλονίκη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:253.1.text#ἄμαχοι γυναῖκες καὶ μιαραὶ κεκλῄμεθ' ἄν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:254.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:254.1.text#χώρει Δράκης, ἡγοῦ βάδην, εἰ καὶ τὸν ὦμον ἀλγεῖς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:255.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:255.1.text#κορμοῦ τοσουτονὶ βάρος χλωρᾶς φέρων ἐλάας.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:256.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:256.1.text#ἦ πόλλ' ἄελπτ' ἔνεστιν ἐν τῷ μακρῷ βίῳ φεῦ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:259.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:259.1.text#ἐπεὶ τίς ἄν ποτ' ἤλπισ' ὦ Στρυμόδωρ' ἀκοῦσαι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:260.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:260.1.text#γυναῖκας, ἃς ἐβόσκομεν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:261.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:261.1.text#κατ' οἶκον ἐμφανὲς κακόν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:262.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:262.1.text#κατὰ μὲν ἅγιον ἔχειν βρέτας,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:263.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:263.1.text#κατὰ δ' ἀκρόπολιν ἐμὰν λαβεῖν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:264.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:264.1.text#μοχλοῖς δὲ καὶ κλῄθροισι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:265.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:265.1.text#τὰ προπύλαια πακτοῦν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:266.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:266.1.text#ἀλλ' ὡς τάχιστα πρὸς πόλιν σπεύσωμεν ὦ Φιλοῦργε,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:267.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:267.1.text#ὅπως ἄν, αὐταῖς ἐν κύκλῳ θέντες τὰ πρέμνα ταυτί,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:268.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:268.1.text#ὅσαι τὸ πρᾶγμα τοῦτ' ἐνεστήσαντο καὶ μετῆλθον,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:269.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:269.1.text#μίαν πυρὰν νήσαντες ἐμπρήσωμεν αὐτόχειρες
urn:cts:greekLit:tlg0019.tlg007.fu.sp:270.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:270.1.text#πάσας, ὑπὸ ψήφου μιᾶς, πρώτην δὲ τὴν Λύκωνος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:273.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:273.1.text#οὐ γὰρ μὰ τὴν Δήμητρ' ἐμοῦ ζῶντος ἐγχανοῦνται·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:274.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:274.1.text#ἐπεὶ οὐδὲ Κλεομένης, ὃς αὐτὴν κατέσχε πρῶτος,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:275.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:275.1.text#ἀπῆθεν ἀψάλακτος, ἀλλ'
urn:cts:greekLit:tlg0019.tlg007.fu.sp:276.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:276.1.text#ὅμως Λακωνικὸν πνέων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:277.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:277.1.text#ᾤχετο θὤπλα παραδοὺς ἐμοί,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:278.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:278.1.text#σμικρὸν ἔχων πάνυ τριβώνιον,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:279.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:279.1.text#πινῶν ῥυπῶν ἀπαράτιλτος,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:280.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:280.1.text#ἓξ ἐτῶν ἄλουτος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:281.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:281.1.text#οὕτως ἐπολιόρκησ' ἐγὼ τὸν ἄνδρ' ἐκεῖνον ὠμῶς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:282.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:282.1.text#ἐφ' ἑπτακαίδεκ' ἀσπίδων πρὸς ταῖς πύλαις καθεύδων.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:283.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:283.1.text#τασδὶ δὲ τὰς Εὐριπίδῃ θεοῖς τε πᾶσιν ἐχθρὰς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:284.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:284.1.text#ἐγὼ οὐκ ἄρα σχήσω παρὼν τολμήματος τοσούτου;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:285.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:285.1.text#μή νυν ἔτ' ἐν τῇ τετραπόλει τοὐμὸν τροπαῖον εἴη.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:286.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:286.1.text#ἀλλ' αὐτὸ γάρ μοι τῆς ὁδοῦ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:287.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:287.1.text#λοιπόν ἐστι χωρίον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:288.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:288.1.text#τὸ πρὸς πόλιν τὸ σιμόν, οἷ σπουδὴν ἔχω·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:289.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:289.1.text#χὤπως ποτ' ἐξαμπρεύσομεν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:290.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:290.1.text#τοῦτ' ἄνευ κανθηλίου.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:291.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:291.1.text#ὡς ἐμοῦ γε τὼ ξύλω τὸν ὦμον ἐξιπώκατον·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:292.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:292.1.text#ἀλλ' ὅμως βαδιστέον,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:293.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:293.1.text#καὶ τὸ πῦρ φυσητέον,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:294.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:294.1.text#μή μ' ἀποσβεσθὲν λάθῃ πρὸς τῇ τελευτῇ τῆς ὁδοῦ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:295.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:295.1.text#φῦ φῦ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:295a.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:295a.1.text#ἰοὺ ἰοὺ τοῦ καπνοῦ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:296.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:296.1.text#ὡς δεινὸν ὦναξ Ἡράκλεις
urn:cts:greekLit:tlg0019.tlg007.fu.sp:297.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:297.1.text#προσπεσόν μ' ἐκ τῆς χύτρας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:298.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:298.1.text#ὥσπερ κύων λυττῶσα τὠφθαλμὼ δάκνει·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:299.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:299.1.text#κἄστιν γε Λήμνιον τὸ πῦρ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:300.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:300.1.text#τοῦτο πάσῃ μηχανῇ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:301.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:301.1.text#οὐ γὰρ ἄν ποθ' ὧδ' ὀδὰξ ἔβρυκε τὰς λήμας ἐμοῦ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:302.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:302.1.text#σπεῦδε πρόσθεν ἐς πόλιν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:303.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:303.1.text#καὶ βοήθει τῇ θεῷ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:304.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:304.1.text#ἢ πότ' αὐτῇ μᾶλλον ἢ νῦν ὦ Λάχης ἀρήξομεν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:305.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:305.1.text#φῦ φῦ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:305a.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:305a.1.text#ἰοὺ ἰοὺ τοῦ καπνοῦ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:306.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:306.1.text#τουτὶ τὸ πῦρ ἐγρήγορεν θεῶν ἕκατι καὶ ζῇ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:307.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:307.1.text#οὔκουν ἄν, εἰ τὼ μὲν ξύλω θείμεσθα πρῶτον αὐτοῦ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:308.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:308.1.text#τῆς ἀμπέλου δ' ἐς τὴν χύτραν τὸν φανὸν ἐγκαθέντες
urn:cts:greekLit:tlg0019.tlg007.fu.sp:309.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:309.1.text#ἅψαντες εἶτ' ἐς τὴν θύραν κριηδὸν ἐμπέσοιμεν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:310.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:310.1.text#κἂν μὴ καλούντων τοὺς μοχλοὺς χαλῶσιν αἱ γυναῖκες,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:311.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:311.1.text#ἐμπιμπράναι χρὴ τὰς θύρας καὶ τῷ καπνῷ πιέζειν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:312.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:312.1.text#θώμεσθα δὴ τὸ φορτίον. φεῦ τοῦ καπνοῦ βαβαιάξ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:313.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:313.1.text#τίς ξυλλάβοιτ' ἂν τοῦ ξύλου τῶν ἐν Σάμῳ στρατη γῶν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:314.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:314.1.text#ταυτὶ μὲν ἤδη τὴν ῥάχιν θλίβοντά μου πέπαυται.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:315.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:315.1.text#σὸν δ' ἔργον ἐστὶν ὦ χύτρα τὸν ἄνθρακ' ἐξεγείρειν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:316.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:316.1.text#τὴν λαμπάδ' ἡμμένην ὅπως πρώτιστ' ἐμοὶ προσοίσεις.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:317.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:317.1.text#δέσποινα Νίκη ξυγγενοῦ τῶν τ' ἐν πόλει γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:318.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:318.1.text#τοῦ νῦν παρεστῶτος θράσους θέσθαι τροπαῖον ἡμᾶς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:319.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:319.1.text#λιγνὺν δοκῶ μοι καθορᾶν καὶ καπνὸν ὦ γυναῖκες
urn:cts:greekLit:tlg0019.tlg007.fu.sp:320.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:320.1.text#ὥσπερ πυρὸς καομένου· σπευστέον ἐστὶ θᾶττον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:321.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:321.1.text#πέτου πέτου Νικοδίκη,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:322.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:322.1.text#πρὶν ἐμπεπρῆσθαι Καλύκην
urn:cts:greekLit:tlg0019.tlg007.fu.sp:323.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:323.1.text#τε καὶ Κρίτυλλαν περιφυσήτω
urn:cts:greekLit:tlg0019.tlg007.fu.sp:324.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:324.1.text#†ὑπό τε νόμων † ἀργαλέων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:325.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:325.1.text#ὑπό τε γερόντων ὀλέθρων.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:326.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:326.1.text#ἀλλὰ φοβοῦμαι τόδε, μῶν ὑστερόπους βοηθῶ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:327.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:327.1.text#νῦν δὴ γὰρ ἐμπλησαμένη τὴν ὑδρίαν κνεφαία
urn:cts:greekLit:tlg0019.tlg007.fu.sp:328.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:328.1.text#μόλις ἀπὸ κρήνης ὑπ' ὄχλου καὶ θορύβου καὶ πατάγου
urn:cts:greekLit:tlg0019.tlg007.fu.sp:329.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:329.1.text#χυτρείου,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:330.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:330.1.text#δούλαισιν ὠστιζομένη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:330a.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:330a.1.text#[…]
urn:cts:greekLit:tlg0019.tlg007.fu.sp:331.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:331.1.text#στιγματίαις θ', ἁρπαλέως
urn:cts:greekLit:tlg0019.tlg007.fu.sp:332.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:332.1.text#ἀραμένη ταῖσιν ἐμαῖς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:333.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:333.1.text#δημότισιν καομέναις
urn:cts:greekLit:tlg0019.tlg007.fu.sp:334.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:334.1.text#φέρουσ' ὕδωρ βοηθῶ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:335.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:335.1.text#ἤκουσα γὰρ τυφογέροντας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:336.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:336.1.text#ἄνδρας ἔρρειν, στελέχη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:337.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:337.1.text#φέροντας ὥσπερ βαλανεύσοντας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:338.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:338.1.text#ἐς πόλιν ὡς τριτάλαντον βάρος,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:339.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:339.1.text#δεινότατ' ἀπειλοῦντας ἐπῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:340.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:340.1.text#ὡς πυρὶ χρὴ τὰς μυσαρὰς γυναῖκας ἀνθρακεύειν·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:341.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:341.1.text#ἃς ὦ θεὰ μή ποτ' ἐγὼ πιμπραμένας ἴδοιμι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:342.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:342.1.text#ἀλλὰ πολέμου καὶ μανιῶν ῥυσαμένας Ἑλλάδα καὶ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:343.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:343.1.text#πολίτας,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:344.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:344.1.text#ἐφ' οἷσπερ ὦ χρυσολόφα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:345.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:345.1.text#πολιοῦχε σὰς ἔσχον ἕδρας.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:346.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:346.1.text#καί σε καλῶ ξύμμαχον ὦ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:347.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:347.1.text#Τριτογένει', εἴ τις ἐκείνας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:348.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:348.1.text#ὑποπίμπρησιν ἀνήρ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:349.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:349.1.text#φέρειν ὕδωρ μεθ' ἡμῶν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:350.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:350.1.text#ἔασον ὦ. τουτὶ τί ἦν; ὦνδρες πόνῳ πόνηροι·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:351.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:351.1.text#οὐ γάρ ποτ' ἂν χρηστοί γ' ἔδρων οὐδ' εὐσεβεῖς τάδ' ἄνδρες.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:352.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:352.1.text#τουτὶ τὸ πρᾶγμ' ἡμῖν ἰδεῖν ἀπροσδόκητον ἥκει·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:353.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:353.1.text#ἑσμὸς γυναικῶν οὑτοσὶ θύρασιν αὖ βοηθεῖ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:354.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:354.1.text#τί βδύλλεθ' ἡμᾶς; οὔ τί που πολλαὶ δοκοῦμεν εἶναι;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:355.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:355.1.text#καὶ μὴν μέρος γ' ἡμῶν ὁρᾶτ' οὔπω τὸ μυριοστόν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:356.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:356.1.text#ὦ Φαιδρία ταύτας λαλεῖν ἐάσομεν τοσαυτί;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:357.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:357.1.text#οὐ περικατᾶξαι τὸ ξύλον τύπτοντ' ἐχρῆν τιν' αὐταῖς;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:358.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:358.1.text#θώμεσθα δὴ τὰς κάλπιδας χἠμεῖς χαμᾶζ', ὅπως ἂν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:359.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:359.1.text#ἢν προσφέρῃ τὴν χεῖρά τις μὴ τοῦτό μ' ἐμποδίζῃ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:360.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:360.1.text#εἰ νὴ Δί' ἤδη τὰς γνάθους τούτων τις ἢ δὶς ἢ τρὶς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:361.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:361.1.text#ἔκοψεν ὥσπερ Βουπάλου, φωνὴν ἂν οὐκ ἂν εἶχον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:362.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:362.1.text#καὶ μὴν ἰδοὺ παταξάτω τις· στᾶσ' ἐγὼ παρέξω,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:363.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:363.1.text#κοὐ μή ποτ' ἄλλη σου κύων τῶν ὄρχεων λάβηται.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:364.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:364.1.text#εἰ μὴ σιωπήσει, θενών σου 'κκοκκιῶ τὸ γῆρας.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:365.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:365.1.text#ἅψαι μόνον Στρατυλλίδος τῷ δακτύλῳ προσελθών.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:366.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:366.1.text#τί δ' ἢν σποδῶ τοῖς κονδύλοις; τί μ' ἐργάσει τὸ δεινόν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:367.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:367.1.text#βρύκουσά σου τοὺς πλεύμονας καὶ τἄντερ' ἐξαμήσω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:368.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:368.1.text#οὐκ ἔστ' ἀνὴρ Εὐριπίδου σοφώτερος ποιητής·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:369.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:369.1.text#οὐδὲν γὰρ οὕτω θρέμμ' ἀναιδές ἐστιν ὡς γυναῖκες.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:370.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:370.1.text#αἰρώμεθ' ἡμεῖς θοὔδατος τὴν κάλπιν ὦ Ῥοδίππη.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:371.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:371.1.text#τί δ' ὦ θεοῖς ἐχθρὰ σὺ δεῦρ' ὕδωρ ἔχουσ' ἀφίκου;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:372.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:372.1.text#τί δαὶ σὺ πῦρ ὦ τύμβ' ἔχων; ὡς σαυτὸν ἐμπυρεύσων;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:373.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:373.1.text#ἐγὼ μὲν ἵνα νήσας πυρὰν τὰς σὰς φίλας ὑφάψω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:374.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:374.1.text#ἐγὼ δέ γ' ἵνα τὴν σὴν πυρὰν τούτῳ κατασβέσαιμι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:375.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:375.1.text#τοὐμὸν σὺ πῦρ κατασβέσεις;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:375.2.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:375.2.text#τοὔργον τάχ' αὐτὸ δείξει.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:376.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:376.1.text#οὐκ οἶδά σ' εἰ τῇδ' ὡς ἔχω τῇ λαμπάδι σταθεύσω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:377.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:377.1.text#εἰ ῥύμμα τυγχάνεις ἔχων, λουτρόν γ' ἐγὼ παρέξω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:378.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:378.1.text#ἐμοὶ σὺ λουτρὸν ὦ σαπρά;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:378.2.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:378.2.text#καὶ ταῦτα νυμφικόν γε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:379.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:379.1.text#ἤκουσας αὐτῆς τοῦ θράσους;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:379.2.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:379.2.text#ἐλευθέρα γάρ εἰμι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:380.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:380.1.text#σχήσω σ' ἐγὼ τῆς νῦν βοῆς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:380.2.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:380.2.text#ἀλλ' οὐκέθ' ἡλιάζει.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:381.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:381.1.text#ἔμπρησον αὐτῆς τὰς κόμας.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:381.2.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:381.2.text#σὸν ἔργον ὦχελῷε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:382.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:382.1.text#οἴμοι τάλας.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:382.2.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:382.2.text#μῶν θερμὸν ἦν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:383.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:383.1.text#ποῖ θερμόν; οὐ παύσει; τί δρᾷς;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:384.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:384.1.text#ἄρδω σ' ὅπως ἂν βλαστάνῃς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:385.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:385.1.text#ἀλλ' αὖός εἰμ' ἤδη τρέμων.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:386.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:386.1.text#οὐκοῦν ἐπειδὴ πῦρ ἔχεις, σὺ χλιανεῖς σεαυτόν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:387.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:387.1.text#ἆρ' ἐξέλαμψε τῶν γυναικῶν ἡ τρυφὴ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:388.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:388.1.text#χὠ τυμπανισμὸς χοἰ πυκνοὶ Σαβάζιοι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:389.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:389.1.text#ὅ τ' Ἀδωνιασμὸς οὗτος οὑπὶ τῶν τεγῶν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:390.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:390.1.text#οὗ 'γώ ποτ' ὢν ἤκουον ἐν τἠκκλησίᾳ;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:391.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:391.1.text#ἔλεγε δ' ὁ μὴ ὥρασι μὲν Δημόστρατος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:392.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:392.1.text#πλεῖν ἐς Σικελίαν, ἡ γυνὴ δ' ὀρχουμένη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:393.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:393.1.text# "αἰαῖ Ἄδωνιν" φησίν, ὁ δὲ Δημόστρατος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:394.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:394.1.text#ἔλεγεν ὁπλίτας καταλέγειν Ζακυνθίων·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:395.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:395.1.text#ἡ δ' ὑποπεπωκυῖ' ἡ γυνὴ 'πὶ τοῦ τέγους
urn:cts:greekLit:tlg0019.tlg007.fu.sp:396.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:396.1.text# "κόπτεσθ' Ἄδωνιν" φησίν· ὁ δ' ἐβιάζετο
urn:cts:greekLit:tlg0019.tlg007.fu.sp:397.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:397.1.text#ὁ θεοῖσιν ἐχθρὸς καὶ μιαρὸς Χολοζύγης.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:398.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:398.1.text#τοιαῦτ' ἀπ' αὐτῶν ἐστιν ἀκόλαστ' ᾄσματα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:399.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:399.1.text#τί δῆτ' ἂν εἰ πύθοιο καὶ τὴν τῶνδ' ὕβριν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:400.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:400.1.text#αἳ τἄλλα θ' ὑβρίκασι κἀκ τῶν καλπίδων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:401.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:401.1.text#ἔλουσαν ἡμᾶς, ὥστε θαἰματίδια
urn:cts:greekLit:tlg0019.tlg007.fu.sp:402.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:402.1.text#σείειν πάρεστιν ὥσπερ ἐνεουρηκότας.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:403.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:403.1.text#νὴ τὸν Ποσειδῶ τὸν ἁλυκὸν δίκαιά γε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:404.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:404.1.text#ὅταν γὰρ αὐτοὶ ξυμπονηρευώμεθα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:405.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:405.1.text#ταῖσιν γυναιξὶ καὶ διδάσκωμεν τρυφᾶν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:406.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:406.1.text#τοιαῦτ' ἀπ' αὐτῶν βλαστάνει βουλεύματα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:407.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:407.1.text#οἳ λέγομεν ἐν τῶν δημιουργῶν τοιαδί·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:408.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:408.1.text#"ὦ χρυσοχόε τὸν ορμον ὃν ἐπεσκεύασας,"
urn:cts:greekLit:tlg0019.tlg007.fu.sp:409.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:409.1.text#"ὀρχουμένης μου τῆς γυναικὸς ἑσπέρας"
urn:cts:greekLit:tlg0019.tlg007.fu.sp:410.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:410.1.text#"ἡ βάλανος ἐκπέπτωκεν ἐκ τοῦ τρήματος."
urn:cts:greekLit:tlg0019.tlg007.fu.sp:411.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:411.1.text#"ἐμοὶ μὲν οὖν ἔστ' ἐς Σαλαμῖνα πλευστέα·"
urn:cts:greekLit:tlg0019.tlg007.fu.sp:412.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:412.1.text#"σὺ δ' ἢν σχολάσῃς, πάσῃ τέχνῃ πρὸς ἑσπέραν"
urn:cts:greekLit:tlg0019.tlg007.fu.sp:413.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:413.1.text#"ἐλθὼν ἐκείνῃ τὴν βάλανον ἐνάρμοσον."
urn:cts:greekLit:tlg0019.tlg007.fu.sp:414.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:414.1.text#ἕτερος δέ τις πρὸς σκυτοτόμον ταδὶ λέγει
urn:cts:greekLit:tlg0019.tlg007.fu.sp:415.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:415.1.text#νεανίαν καὶ πέος ἔχοντ' οὐ παιδικόν·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:416.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:416.1.text#"ὦ σκυτοτόμε μου τῆς γυναικὸς τοῦ ποδὸς"
urn:cts:greekLit:tlg0019.tlg007.fu.sp:417.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:417.1.text#"τὸ δακτυλίδιον ξυμπιέζει τὸ ζυγὸν"
urn:cts:greekLit:tlg0019.tlg007.fu.sp:418.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:418.1.text#"ἅθ' ἁπαλὸν ὄν· τοῦτ' οὖν σὺ τῆς μεσημβρίας"
urn:cts:greekLit:tlg0019.tlg007.fu.sp:419.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:419.1.text#"ἐλθὼν χάλασον, ὅπως ἂν εὐρυτέρως ἔχῃ."
urn:cts:greekLit:tlg0019.tlg007.fu.sp:420.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:420.1.text#τοιαῦτ' ἀπήντηκ' ἐς τοιαυτὶ πράγματα,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:421.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:421.1.text#ὅτε γ' ὢν ἐγὼ πρόβουλος, ἐκπορίσας ὅπως
urn:cts:greekLit:tlg0019.tlg007.fu.sp:422.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:422.1.text#κωπῆς ἔσονται, τἀργυρίου νυνὶ δέον,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:423.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:423.1.text#ὑπὸ τῶν γυναικῶν ἀποκέκλῃμαι ταῖς πύλαις.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:424.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:424.1.text#ἀλλ' οὐδὲν ἔργον ἑστάναι. φέρε τοὺς μοχλούς,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:425.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:425.1.text#ὅπως ἂν αὐτὰς τῆς ὕβρεως ἐγὼ σχέθω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:426.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:426.1.text#τί κέχηνας ὦ δύστηνε; ποῖ δ' αὖ σὺ βλέπεις,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:427.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:427.1.text#οὐδὲν ποιῶν ἀλλ' ἢ καπηλεῖον σκοπῶν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:428.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:428.1.text#οὐχ ὑποβαλόντες τοὺς μοχλοὺς ὑπὸ τὰς πύλας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:429.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:429.1.text#ἐντεῦθεν ἐκμοχλεύσετ'; ἐνθενδὶ δ' ἐγὼ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:430.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:430.1.text#ξυνεκμοχλεύσω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:430.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:430.2.text#μηδὲν ἐκμοχλεύετε·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:431.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:431.1.text#ἐξέρχομαι γὰρ αὐτομάτη. τί δεῖ μοχλῶν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:432.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:432.1.text#οὐ γὰρ μοχλῶν δεῖ μᾶλλον ἢ νοῦ καὶ φρενῶν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:433.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:433.1.text#ἄληθες ὦ μιαρὰ σύ; ποῦ 'σθ' ὁ τοξότης;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:434.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:434.1.text#ξυλλάμβαν' αὐτὴν κὠπίσω τὼ χεῖρε δεῖ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:435.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:435.1.text#εἴ τἄρα νὴ τὴν Ἄρτεμιν τὴν χεῖρά μοι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:436.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:436.1.text#ἄκραν προσοίσει δημόσιος ὤν, κλαύσεται.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:437.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:437.1.text#ἔδεισας οὗτος; οὐ ξυναρπάσει μέσην
urn:cts:greekLit:tlg0019.tlg007.fu.sp:438.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:438.1.text#καὶ σὺ μετὰ τούτου κἀνύσαντε δήσετον;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:439.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:439.1.text#εἴ τἄρα νὴ τὴν Πάνδροσον ταύτῃ μόνον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:440.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:440.1.text#τὴν χεῖρ' ἐπιβαλεῖς, ἐπιχεσεῖ πατούμενος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:441.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:441.1.text#ἰδού γ'ἐπιχεσεῖ. ποῦ 'στιν ἕτερος τοξότης;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:442.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:442.1.text#ταύτην προτέραν ξύνδησον, ὁτιὴ καὶ λαλεῖ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:443.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg007.fu.sp:443.1.text#εἴ τἄρα νὴ τὴν Φωσφόρον τὴν χεῖρ' ἄκραν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:444.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg007.fu.sp:444.1.text#ταύτῃ προσοίσεις, κύαθον αἰτήσεις τάχα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:445.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:445.1.text#τουτὶ τί ἦν; ποῦ τοξότης; ταύτης ἔχου.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:446.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:446.1.text#παύσω τιν' ὑμῶν τῆσδ' ἐγὼ τῆς ἐξόδου.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:447.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:447.1.text#εἴ τἄρα νὴ τὴν Ταυροπόλον ταύτῃ πρόσει,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:448.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:448.1.text#ἐκκοκκιῶ σου τὰς στενοκωκύτους τρίχας.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:449.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:449.1.text#οἴμοι κακοδαίμων· ἐπιλέλοιφ' ὁ τοξότης.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:450.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:450.1.text#ἀτὰρ οὐ γυναικῶν οὐδέποτ' ἔσθ' ἡττητέα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:451.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:451.1.text#ἡμῖν· ὁμόσε χωρῶμεν αὐταῖς ὦ Σκύθαι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:452.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:452.1.text#ξυνταξάμενοι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:452.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:452.2.text#νὴ τὼ θεὼ γνώσεσθ' ἄρα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:453.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:453.1.text#ὅτι καὶ παρ' ἡμῖν εἰσι τέτταρες λόχοι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:454.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:454.1.text#μαχίμων γυναικῶν ἔνδον ἐξωπλισμένων.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:455.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:455.1.text#ἀποστρέφετε τὰς χεῖρας αὐτῶν ὦ Σκύθαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:456.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:456.1.text#ὦ ξύμμαχοι γυναῖκες ἐκθεῖτ' ἔνδοθεν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:457.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:457.1.text#ὦ σπερμαγοραιολεκιθολαχανοπώλιδες,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:458.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:458.1.text#ὦ σκοροδοπανδοκευτριαρτοπώλιδες,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:459.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:459.1.text#οὐχ ἕλξετ', οὐ παιήσετ', οὐκ ἀράξετε;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:460.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:460.1.text#οὐ λοιδορήσετ', οὐκ ἀναισχυντήσετε;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:461.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:461.1.text#παύσασθ', ἐπαναχωρεῖτε, μὴ σκυλεύετε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:462.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:462.1.text#οἴμ' ὡς κακῶς πέπραγέ μου τὸ τοξικόν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:463.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:463.1.text#ἀλλὰ τί γὰρ ᾤου; πότερον ἐπὶ δούλας τινὰς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:464.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:464.1.text#ἥκειν ἐνόμισας, ἢ γυναιξὶν οὐκ οἴει
urn:cts:greekLit:tlg0019.tlg007.fu.sp:465.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:465.1.text#χολὴν ἐνεῖναι;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:465.2.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:465.2.text#νὴ τὸν Ἀπόλλω καὶ μάλα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:466.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:466.1.text#πολλήν γ', ἐάνπερ πλησίον κάπηλος ᾖ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:467.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:467.1.text#ὦ πόλλ' ἀναλώσας ἔπη πρόβουλε τῆσδε τῆς γῆς,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:468.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:468.1.text#τί τοῖσδε σαυτὸν ἐς λόγους τοῖς θηρίοις συνάπτεις;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:469.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:469.1.text#οὐκ οἶσθα λουτρὸν οἷον αἵδ' ἡμᾶς ἔλουσαν ἄρτι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:470.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:470.1.text#ἐν τοῖσιν ἱματιδίοις, καὶ ταῦτ' ἄνευ κονίας;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:471.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:471.1.text#ἀλλ' ὦ μέλ' οὐ χρὴ προσφέρειν τοῖς πλησίοισιν εἰκῇ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:472.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:472.1.text#τὴν χεῖρ'· ἐὰν δὲ τοῦτο δρᾷς, κυλοιδιᾶν ἀνάγκη.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:473.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:473.1.text#ἐπεὶ 'θέλω 'γὼ σωφρόνως ὥσπερ κόρη καθῆσθαι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:474.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:474.1.text#λυποῦσα μηδέν' ἐνθαδί, κινοῦσα μηδὲ κάρφος,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:475.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:475.1.text#ἢν μή τις ὥσπερ σφηκιὰν βλίττῃ με κἀρεθίζῃ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:476.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:476.1.text#ὦ Ζεῦ τί ποτε χρησόμεθα τοῖσδε τοῖς κνωδάλοις;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:477.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:477.1.text#ου' γὰρ ἔτ' ἀνεκτὰ τάδε γ', ἀλλὰ βασανιστέον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:478.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:478.1.text#τόδε σοι τὸ πάθος μετ' ἐμοῦ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:480.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:480.1.text#ὅ τι βουλόμεναί ποτε τὴν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:481.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:481.1.text#Κραναὰν κατέλαβον, ἐφ' ὅ τι τε
urn:cts:greekLit:tlg0019.tlg007.fu.sp:482.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:482.1.text#μεγαλόπετρον ἄβατον ἀκρόπολιν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:483.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:483.1.text#ἱερὸν τέμενος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:484.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:484.1.text#ἀλλ' ἀνερώτα καὶ μὴ πείθου καὶ πρόσφερε πάντας ἐλέγχους,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:485.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:485.1.text#ὡς αἰσχρὸν ἀκωδώνιστον ἐᾶν τὸ τοιοῦτον πρᾶγμα μεθέντας.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:486.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:486.1.text#καὶ μὴν αὐτῶν τοῦτ' ἐπιθυμῶ νὴ τὸν Δία πρῶτα πυθέσθαι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:487.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:487.1.text#ὅ τι βουλόμεναι τὴν πόλιν ἡμῶν ἀπεκλῄσατε τοῖσι μοχλοῖσιν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:488.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:488.1.text#ἵνα τἀργύριον σῶν παρέχοιμεν καὶ μὴ πολεμοῖτε δι' αὐτό.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:489.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:489.1.text#διὰ τἀργύριον πολεμοῦμεν γάρ;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:489.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:489.2.text#καὶ τἄλλα γε πάντ' ἐκυκήθη.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:490.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:490.1.text#ἵνα γὰρ Πείσανδρος ἔχοι κλέπτειν χοἰ ταῖς ἀρχαῖς ἐπέχοντες,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:491.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:491.1.text#ἀεί τινα κορκορυγὴν ἐκύκων. οἱ δ' οὖν τοῦδ' οὕνεκα δρώντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:492.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:492.1.text#ὅ τι βούλονται· τὸ γὰρ ἀργύριον τοῦτ' οὐκέτι μὴ καθέλωσιν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:493.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:493.1.text#ἀλλὰ τί δράσεις;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:493.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:493.2.text#τοῦτό μ' ἐρωτᾷς; ἡμεῖς ταμιεύσομεν αὐτό.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:494.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:494.1.text#ὑμεῖς ταμιεύσετε τἀργύριον;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:494.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:494.2.text#τί δὲ δεινὸν τοῦτο νομίζεις;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:495.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:495.1.text#οὐ καὶ τἄνδον χρήματα πάντως ἡμεῖς ταμιεύομεν ὑμῖν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:496.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:496.1.text#ἀλλ' οὐ ταὐτόν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:496.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:496.2.text#πῶς οὐ ταὐτόν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:496.3.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:496.3.text#πολεμητέον ἔστ' ἀπὸ τούτου.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:497.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:497.1.text#ἀλλ' οὐδὲν δεῖ πρῶτον πολεμεῖν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:497.2.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:497.2.text#πῶς γὰρ σωθησόμεθ' ἄλλως;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:498.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:498.1.text#ἡμεῖς ὑμᾶς σώσομεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:498.2.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:498.2.text#ὑμεῖς;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:498.3.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:498.3.text#ἡμεῖς μέντοι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:498.4.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:498.4.text#σχέτλιόν γε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:499.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:499.1.text#ὡς σωθήσει, κἂν μὴ βούλῃ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:499.2.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:499.2.text#δεινόν γε λέγεις.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:499.3.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:499.3.text#ἀγανακτεῖς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:500.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:500.1.text#ἀλλὰ ποιητέα ταῦτ' ἐστὶν ὅμως.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:500.2.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:500.2.text#νὴ τὴν Δήμητρ' ἄδικόν γε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:501.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:501.1.text#σωστέον ὦ τᾶν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:501.2.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:501.2.text#κεἰ μὴ δέομαι;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:501.3.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:501.3.text#τοῦδ' οὕνεκα καὶ πολὺ μᾶλλον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:502.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:502.1.text#ὑμῖν δὲ πόθεν περὶ τοῦ πολέμου τῆς τ' εἰρήνης ἐμέλησεν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:503.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:503.1.text#ἡμεῖς φράσομεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:503.2.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:503.2.text#λέγε δὴ ταχέως, ἵνα μὴ κλάῃς,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:503.3.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:503.3.text#ἀκροῶ δή,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:504.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:504.1.text#καὶ τὰς χεῖρας πειρῶ κατέχειν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:504.2.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:504.2.text#ἀλλ' οὐ δύναμαι· χαλεπὸν γὰρ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:505.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:505.1.text#ὑπὸ τῆς ὀργῆς αὐτὰς ἴσχειν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:505.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:505.2.text#κλαύσει τοίνυν πολὺ μᾶλλον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:506.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:506.1.text#τοῦτο μὲν ὦ γραῦ σαυτῇ κρώξαις· σὺ δέ μοι λέγε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:506.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:506.2.text#ταῦτα ποιήσω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:507.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:507.1.text#ἡμεῖς τὸν μὲν πρότερον πόλεμον † καὶ τὸν χρόνον ἠνεσχόμεθα †
urn:cts:greekLit:tlg0019.tlg007.fu.sp:508.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:508.1.text#ὑπὸ σωφροσύνης τῆς ἡμετέρας τῶν ἀνδρῶν ἅττ' ἐποιεῖτε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:509.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:509.1.text#οὐ γὰρ γρύζειν εἰᾶθ' ἡμᾶς. καίτοὐκ ἠρέσκετέ γ' ἡμᾶς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:510.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:510.1.text#ἀλλ' ᾐσθανόμεσθα καλῶς ὑμῶν, καὶ πολλάκις ἔνδον ἂν οὖσαι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:511.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:511.1.text#ἠκούσαμεν ἄν τι κακῶς ὑμᾶς βουλευσαμένους μέγα πρᾶγμα·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:512.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:512.1.text#εἶτ' ἀλγοῦσαι τἄνδοθεν ὑμᾶς ἐπανηρόμεθ' ἂν γελάσασαι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:513.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:513.1.text#"τί βεβούλευται περὶ τῶν σπονδῶν ἐν τῇ στήλῃ παραγράψαι"
urn:cts:greekLit:tlg0019.tlg007.fu.sp:514.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:514.1.text#"ἐν τῷ δήμῳ τήμερονὑμῖν;" "τίδὲ σοὶ ταῦτ';" ἦ δ' ὃς ἂν ἁνήρ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:515.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:515.1.text# "οὐ σιγήσει;" κἀγὼ ἐσίγων.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:515.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:515.2.text#ἀλλ' οὐκ ἂν ἐγώ ποτ' ἐσίγων.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:516.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:516.1.text#κἂν ᾤμωζές γ', εἰ μὴ 'σίγας.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:516.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:516.2.text#τοιγὰρ ἔγωγ' ἔνδον ἐσίγων.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:517.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:517.1.text# […] ἔτερόν τι πονηρότερον βούλευμ' ἐπεπύσμεθ' ἂν ὑμῶν·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:518.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:518.1.text#εἶτ' ἠρόμεθ' ἄν· "πῶς ταῦτ' ὦνερ διαπράττεσθ' ὧδ' ἀνοήτως;"
urn:cts:greekLit:tlg0019.tlg007.fu.sp:519.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:519.1.text#ὁ δέ μ' εὐθὺς ὑποβλέψας ἂν ἔφασκ', εἰ μὴ τὸν στήμονα νήσω,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:520.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:520.1.text#ὀτοτύξεσθαι μακρὰ τὴν κεφαλήν· "πόλεμος δ' ἄνδρεσσι μελήσει."
urn:cts:greekLit:tlg0019.tlg007.fu.sp:521.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:521.1.text#ὀρθῶς γε λέγων νὴ Δί' ἐκεῖνος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:521.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:521.2.text#πῶς ὀρθῶς ὦ κακόδαιμον,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:522.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:522.1.text#εἰ μηδὲ κακῶς βουλευομένοις ἐξῆν ὑμῖν ὑποθέσθαι;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:523.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:523.1.text#ὅτε δὴ δ' ὑμῶν ἐν ταῖσιν ὁδοῖς φανερῶς ἠκούομεν ἤδη,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:524.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:524.1.text# "οὐκ ἔστιν ἀνὴρ ἐν τῇ χώρᾳ;" "μὰ Δί' οὐ δῆτ'," εἶφ' ἕτερός τις·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:525.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:525.1.text#μετὰ ταῦθ' ἡμῖν εὐθὺς ἔδοξεν σῶσαι τὴν Ἑλλάδα κοινῇ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:526.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:526.1.text#ταῖσι γυναιξὶν συλλεχθείσαις. ποῖ γὰρ καὶ χρῆν ἀναμεῖναι;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:527.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:527.1.text#ἢν οὖν ἡμῶν χρηστὰ λεγουσῶν ἐθελήσητ' ἀντακροᾶσθαι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:528.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:528.1.text#κἀντισιωπᾶθ' ὥσπερ χἠμεῖς, ἐπανορθώσαιμεν ἂν ὑμᾶς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:529.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:529.1.text#ὑμεῖς ἡμᾶς; δεινόν γε λέγεις κοὐ τλητὸν ἔμοιγε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:529.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:529.2.text#σιώπα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:530.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:530.1.text#σοί γ' ὦ κατάρατε σιωπῶ 'γώ, καὶ ταῦτα κάλυμμα φορούσῃ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:531.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:531.1.text#περὶ τὴν κεφαλήν; μή νυν ζῴην.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:531.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:531.2.text#ἀλλ' εἰ τοῦτ' ἐμπόδιόν σοι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:532.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:532.1.text#παρ' ἐμοῦ τουτὶ τὸ κάλυμμα λαβὼν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:533.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:533.1.text#ἔχε καὶ περίθου περὶ τὴν κεφαλήν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:534.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:534.1.text#κᾆτα σιώπα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:535.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:535.1.text#καὶ τοῦτον τὸν καλαθίσκον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:536.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:536.1.text#κᾆτα ξαίνειν ξυζωσάμενος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:537.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:537.1.text#κυάμους τρώγων·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:538.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:538.1.text#πόλεμος δὲ γυναιξὶ μελήσει.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:539.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:539.1.text#αἰρώμεθ' ὦ γυναῖκες ἀπὸ τῶν καλπίδων, ὅπως ἂν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:540.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:540.1.text#ἐν τῷ μέρει χἠμεῖς τι ταῖς φίλαισι συλλάβωμεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:541.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:541.1.text#ἔγωγε γὰρ ἂν οὔποτε κάμοιμ' ἂν ὀρχουμένη,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:542.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:542.1.text#†οὐδὲ τὰ γόνατα κόπος ἕλοι μου καματηρόσ†·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:543.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:543.1.text#ἐθέλω δ' ἐπὶ πᾶν ἰέναι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:544.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:544.1.text#μετὰ τῶνδ' ἀρετῆς ἕνεχ', αἷς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:545.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:545.1.text#ἔνι φύσις, ἔνι χάρις, ἔνι θράσος,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:546.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:546.1.text#ἔνι δὲ σοφόν, ἔνι δὲ φιλόπολις
urn:cts:greekLit:tlg0019.tlg007.fu.sp:547.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:547.1.text#ἀρετὴ φρόνιμος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:549.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:549.1.text#ἀλλ' ὦ τηθῶν ἀνδρειοτάτων καὶ μητριδίων ἀκαληφῶν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:550.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:550.1.text#χωρεῖτ' ὀργῇ καὶ μὴ τέγγεσθ'· ἔτι γὰρ νῦν οὔρια θεῖτε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:551.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:551.1.text#ἀλλ' ἤνπερ ὅ τε γλυκύθυμος Ἔρως χἠ Κυπρογένει' Ἀφροδίτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:552.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:552.1.text#ἵμερον ἡμῶν κατὰ τῶν κόλπων καὶ τῶν μηρῶν καταπνεύσῃ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:553.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:553.1.text#κᾆτ' ἐντήξῃ τέτανον τερπνὸν τοῖς ἀνδράσι καὶ ῥοπαλισμούς,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:554.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:554.1.text#οἶμαί ποτε Λυσιμάχας ἡμᾶς ἐν τοῖς Ἕλλησι καλεῖσθαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:555.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:555.1.text#τί ποιησάσας;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:555.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:555.2.text#ἢν παύσωμεν πρώτιστον μὲν ξὺν ὅπλοισιν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:556.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:556.1.text#ἀγοράζοντας καὶ μαινομένους.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:556.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:556.2.text#νὴ τὴν Παφίαν Ἀφροδίτην.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:557.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:557.1.text#νῦν μὲν γὰρ δὴ κἀν ταῖσι χύτραις κἀν τοῖς λαχάνοισιν ὁμοίως
urn:cts:greekLit:tlg0019.tlg007.fu.sp:558.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:558.1.text#περιέρχονται κατὰ τὴν ἀγορὰν ξὺν ὅπλοις ὥσπερ Κορύβαντες.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:559.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:559.1.text#νὴ Δία· χρὴ γὰρ τοὺς ἀνδρείους.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:559.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:559.2.text#καὶ μὴν τό γε πρᾶγμα γέλοιον,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:560.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:560.1.text#ὅταν ἀσπίδ' ἔχων καὶ Γοργόνα τις κᾆτ' ὠνῆται κορακίνους.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:561.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:561.1.text#νὴ Δί' ἐγὼ γοῦν ἄνδρα κομήτην φυλαρχοῦντ' εἶδον ἐφ' ἵππου
urn:cts:greekLit:tlg0019.tlg007.fu.sp:562.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:562.1.text#ἐς τὸν χαλκοῦν ἐμβαλλόμενον πῖλον λέκιθον παρὰ γραός·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:563.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:563.1.text#ἕτερος δ' αὖ Θρᾷξ πέλτην σείων κἀκόντιον ὥσπερ ὁ Τηρεύς,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:564.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:564.1.text#ἐδεδίσκετο τὴν ἰσχαδόπωλιν καὶ τὰς δρυπεπεῖς κατέπινεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:565.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:565.1.text#πῶς οὖν ὑμεῖς δυναταὶ παῦσαι τεταραγμένα πράγματα πολλὰ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:566.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:566.1.text#ἐν ταῖς χώραις καὶ διαλῦσαι;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:566.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:566.2.text#φαύλως πάνυ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:566.3.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:566.3.text#πῶς; ἀπόδειξον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:567.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:567.1.text#ὥσπερ κλωστῆρ', ὅταν ἡμῖν ᾖ τεταραγμένος, ὧδε λαβοῦσαι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:568.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:568.1.text#ὑπενεγκοῦσαι τοῖσιν ἀτράκτοις τὸ μὲν ἐνταυθοῖ τὸ δ' ἐκεῖσε,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:569.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:569.1.text#οὕτως καὶ τὸν πόλεμον τοῦτον διαλύσομεν, ἤν τις ἐάσῃ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:570.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:570.1.text#διενεγκοῦσαι διὰ πρεσβειῶν τὸ μὲν ἐνταυθοῖ τὸ δ' ἐκεῖσε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:571.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:571.1.text#ἐξ ἐρίων δὴ καὶ κλωστήρων καὶ ἀτράκτων πράγματα δεινὰ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:572.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:572.1.text#παύσειν οἴεσθ' ὦ ἀνόητοι;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:572.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:572.2.text#κἂν ὑμῖν γ' εἴ τις ἐνῆν νοῦς,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:573.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:573.1.text#ἐκ τῶν ἐρίων τῶν ἡμετέρων ἐπολιτεύεσθ' ἂν ἅπαντα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:574.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:574.1.text#πῶς δή; φέρ' ἴδω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:574.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:574.2.text#πρῶτον μὲν ἐχρῆν, ὥσπερ πόκου ἐν βαλανείῳ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:575.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:575.1.text#ἐκπλύναντας τὴν οἰσπώτην, ἐκ τῆς πόλεως ἐπὶ κλίνης
urn:cts:greekLit:tlg0019.tlg007.fu.sp:576.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:576.1.text#ἐκραβδίζειν τοὺς μοχθηροὺς καὶ τοὺς τριβόλους ἀπολέξαι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:577.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:577.1.text#καὶ τούς γε συνισταμένους τούτους καὶ τοὺς πιλοῦντας ἑαυτοὺς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:578.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:578.1.text#ἐπὶ ταῖς ἀρχαῖσι διαξῆναι καὶ τὰς κεφαλὰς ἀποτῖλαι·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:579.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:579.1.text#εἶτα ξαίνειν ἐς καλαθίσκον κοινὴν εὔνοιαν, ἅπαντας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:580.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:580.1.text#καταμιγνύντας τούς τε μετοίκους κεἴ τις ξένος ἢ φίλος ὑμῖν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:581.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:581.1.text#κεἴ τις ὀφείλει τῷ δημοσίῳ, καὶ τούτους ἐγκαταμεῖξαι·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:582.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:582.1.text#καὶ νὴ Δία τάς γε πόλεις, ὁπόσαι τῆς γῆς τῆσδ' εἰσὶν ἄποικοι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:583.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:583.1.text#διαγιγνώσκειν ὅτι ταῦθ' ἡμῖν ὥσπερ τὰ κατάγματα κεῖται
urn:cts:greekLit:tlg0019.tlg007.fu.sp:584.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:584.1.text#χωρὶς ἕκαστον· κᾆτ' ἀπὸ τούτων πάντων τὸ κάταγμα λαβόντας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:585.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:585.1.text#δεῦρο ξυνάγειν καὶ συναθροίξειν εἰς ἕν, κἄπειτα ποιῆσαι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:586.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:586.1.text#τολύπην μεγάλην κᾆτ' ἐκ ταύτης τῷ δήμῳ χλαῖναν ὑφῆναι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:587.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:587.1.text#οὔκουν δεινὸν ταυτὶ ταύτας ῥαβδίξειν καὶ τολυπεύειν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:588.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:588.1.text#αἶς οὐδὲ μετῆν πάνυ τοῦ πολέμου;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:588.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:588.2.text#καὶ μὴν ὦ παγκατάρατε
urn:cts:greekLit:tlg0019.tlg007.fu.sp:589.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:589.1.text#πλεῖν ἤ γε διπλοῦν αὐτὸν φέρομεν, πρώτιστον μέν γε τεκοῦσαι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:590.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:590.1.text#κἀκπέμψασαι παῖδας ὁπλίτας.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:590.2.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:590.2.text#σίγα, μὴ μνησικακήσῃς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:591.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:591.1.text#εἶθ' ἡνίκα χρῆν εὐφρανθῆναι καὶ τῆς ἥβης ἀπολαῦσαι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:592.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:592.1.text#μονοκοιτοῦμεν διὰ τὰς στρατιάς. καὶ θἠμέτερον μὲν ἐᾶτε,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:593.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:593.1.text#περὶ τῶν δὲ κορῶν ἐν τοῖς θαλάμοις γηρασκουσῶν ἀνιῶμαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:594.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:594.1.text#οὔκουν χἄνδρες γηράσκουσιν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:594.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:594.2.text#μὰ Δί' ἀλλ' οὐκ εἶπας ὅμοιον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:595.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:595.1.text#ὁ μὲν ἥκων γάρ, κἂν ᾖ πολιός, ταχὺ παῖδα κόρην γεγάμηκεν·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:596.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:596.1.text#τῆς δὲ γυναικὸς σμικρὸς ὁ καιρός, κἂν τούτου μὴ 'πιλάβηται,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:597.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:597.1.text#οὐδεὶς ἐθέλει γῆμαι ταύτην, ὀττευομένη δὲ κάθηται.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:598.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:598.1.text#ἀλλ' ὅστις ἔτι στῦσαι δυνατὸς—
urn:cts:greekLit:tlg0019.tlg007.fu.sp:599.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:599.1.text#σὺ δὲ δὴ τί μαθὼν οὐκ ἀποθνῄσκεις;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:600.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:600.1.text#†χωρίον ἐστί·† σορὸν ὠνήσει·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:601.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:601.1.text#μελιτοῦτταν ἐγὼ καὶ δὴ μάξω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:602.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:602.1.text#λαβὲ ταυτὶ καὶ στεφάνωσαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:603.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:603.1.text#καὶ ταυτασὶ δέξαι παρ' ἐμοῦ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:604.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg007.fu.sp:604.1.text#καὶ τουτονγὶ λαβὲ τὸν στέφανον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:605.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:605.1.text#τοῦ δεῖ; τί ποθεῖς; χώρει 'ς τὴν ναῦν·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:606.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:606.1.text#ὁ Χάρων σε καλεῖ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:607.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:607.1.text#σὺ δὲ κωλύεις ἀνάγεσθαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:608.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:608.1.text#εἶτ' οὐχὶ ταῦτα δεινὰ πάσχειν ἔστ' ἐμέ;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:609.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:609.1.text#νὴ τὸν Δί' ἀλλὰ τοῖς προβούλοις ἄντικρυς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:610.1.speaker#Πρόβουλος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:610.1.text#ἐμαυτὸν ἐπιδείξω βαδίζων ὡς ἔχω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:611.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:611.1.text#μῶν ἐγκαλεῖς ὅτι οὐχὶ προὐθέμεσθά σε;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:612.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:612.1.text#ἀλλ' ἐς τρίτην γοῦν ἡμέραν σοὶ πρῲ πάνυ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:613.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:613.1.text#ἥξει παρ' ἡμῶν τὰ τρίτ' ἐπεσκευασμένα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:614.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:614.1.text#οὐκέτ' ἔργον ἐγκαθεύδειν ὅστις ἔστ' ἐλεύθερος,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:615.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:615.1.text#ἀλλ' ἐπαποδυώμεθ' ἄνδρες τουτῳὶ τῷ πράγματι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:616.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:616.1.text#ἤδη γὰρ ὄζειν ταδὶ πλειόνων καὶ μειζόνων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:617.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:617.1.text#πραγμάτων μοι δοκεῖ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:618.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:618.1.text#καὶ μάλιστ' ὀσφραίνομαι τῆς Ἱππίου τυραννίδος·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:620.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:620.1.text#καὶ πάνυ δέδοικα μὴ τῶν Λακώνων τινὲς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:621.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:621.1.text#δεῦρο συνεληλυθότες ἄνδρες ἐς Κλεισθένους
urn:cts:greekLit:tlg0019.tlg007.fu.sp:622.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:622.1.text#τὰς θεοῖς ἐχθρὰς γυναῖκας ἐξεπαίρωσιν δόλῳ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:623.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:623.1.text#καταλαβεῖν τὰ χρήμαθ' ἡμῶν τόν τε μισθόν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:625.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:625.1.text#ἔνθεν ἔζων ἐγώ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:626.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:626.1.text#δεινὰ γάρ τοι τάσδε γ' ἤδη τοὺς πολίτας νουθετεῖν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:627.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:627.1.text#καὶ λαλεῖν γυναῖκας οὔσας ἀσπίδος χαλκῆς πέρι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:628.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:628.1.text#καὶ διαλλάττειν πρὸς ἡμᾶς ἀνδράσιν Λακωνικοῖς,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:629.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:629.1.text#οἷσι πιστὸν οὐδὲν εἰ μή περ λύκῳ κεχηνότι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:630.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:630.1.text#ἀλλὰ ταῦθ' ὕφηναν ἡμῖν ἄνδρες ἐπὶ τυραννίδι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:631.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:631.1.text#ἀλλ' ἐμοῦ μὲν οὐ τυραννεύσουσ', ἐπεὶ φυλάξομαι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:632.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:632.1.text#καὶ φορήσω τὸ ξίφος τὸ λοιπὸν ἐν μύρτου κλαδί,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:633.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:633.1.text#ἀγοράσω τ' ἐν τοῖς ὅπλοις ἑξῆς Ἀριστογείτονι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:634.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:634.1.text#ὧδέ θ' ἑστήξω παρ' αὐτόν· †αὐτὸσ† γάρ μοι γίγνεται
urn:cts:greekLit:tlg0019.tlg007.fu.sp:635.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:635.1.text#τῆς θεοῖς ἐχθρᾶς πατάξαι τῆσδε γραὸς τὴν γνάθον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:636.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:636.1.text#οὐκ ἄρ' εἰσιόντα σ' οἴκαδ' ἡ τεκοῦσα γνώσεται.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:637.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:637.1.text#ἀλλὰ θώμεσθ' ὦ φίλαι γρᾶες ταδί πρῶτον χαμαί.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:638.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:638.1.text#ἡμεῖς γὰρ ὦ πάντες ἀστοὶ λόγων κατάρχομεν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:639.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:639.1.text#τῇ πόλει χρησίμων·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:640.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:640.1.text#εἰκότως, ἐπεὶ χλιδῶσαν ἀγλαῶς ἔθρεψέ με.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:641.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:641.1.text#ἑπτὰ μὲν ἔτη γεγῶσ' εὐθὺς ἠρρηφόρουν·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:642.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:642.1.text#εἶτ' ἀλετρὶς ἦ δεκέτις οὖσα τἀρχηγέτι·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:645.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:645.1.text#κᾆτ' ἔχουσα τὸν κροκωτὸν ἄρκτος ἦ Βραυρωνίοις·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:646.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:646.1.text#κἀκανηφόρουν ποτ' οὖσα παῖς καλὴ 'χουσ'
urn:cts:greekLit:tlg0019.tlg007.fu.sp:647.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:647.1.text#ἰσχάδων ὁρμαθόν·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:648.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:648.1.text#ἆρα προὐφείλω τι χρηστὸν τῇ πόλει παραινέσαι;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:649.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:649.1.text#εἰ δ' ἐγὼ γυνὴ πέφυκα, τοῦτο μὴ φθονεῖτέ μοι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:650.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:650.1.text#ἢν ἀμείνω γ' εἰσενέγκω τῶν παρόντων πραγμάτων.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:651.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:651.1.text#τοὐράνου γάρ μοι μέτεστι· καὶ γὰρ ἄνδρας ἐσφέρω,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:652.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:652.1.text#τοῖς δὲ δυστήνοις γέρουσιν οὐ μέτεσθ' ὑμῖν, ἐπεὶ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:653.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:653.1.text#τὸν ἔρανον τὸν λεγόμενον παππῷον ἐκ τῶν Μηδικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:654.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:654.1.text#εἶτ' ἀναλώσαντες οὐκ ἀντεσφέρετε τὰς ἐσφοράς,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:655.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:655.1.text#ἀλλ' ὑφ' ὑμῶν διαλυθῆναι προσέτι κινδυνεύομεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:656.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:656.1.text#ἆρα γρυκτόν ἐστιν ὑμῖν; εἰ δὲ λυπήσεις τί με,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:657.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:657.1.text#τῷδέ γ' ἀψήκτῳ πατάξω τῷ κοθόρνῳ τὴν γνάθον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:658.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:658.1.text#ταῦτ' οὖν οὐχ ὕβρις τὰ πράγματ' ἐστὶ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:660.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:660.1.text#πολλή; κἀπιδώσειν μοι δοκεῖ τὸ χρῆμα μᾶλλον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:661.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:661.1.text#ἀλλ' ἀμυντέον τὸ πρᾶγμ' ὅστις γ' ἐνόρχης ἔστ' ἀνήρ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:662.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:662.1.text#ἀλλὰ τὴν ἐξωμίδ' ἐκδυώμεθ', ὡς τὸν ἄνδρα δεῖ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:663.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:663.1.text#ἀνδρὸς ὄζειν εὐθύς, ἀλλ' οὐν ἐντεθριῶσθαι πρέπει.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:665.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:665.1.text#ἀλλ' ἄγετε λευκόποδες, οἵπερ επὶ Λείψύδριον ἤλθομεν ὅτ' ἦμεν ἔτι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:666.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:666.1.text#νῦν δεῖ νῦν ἀνηβῆσαι πάλιν κἀναπτερῶσαι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:670.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:670.1.text#πᾶν τὸ σῶμα κἀποσείσασθαι τὸ γῆρας τόδε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:672.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:672.1.text#εἰ γὰρ ἐνδώσει τις ἡμῶν ταῖσδε κἂν σμικρὰν λαβήν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:673.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:673.1.text#οὐδὲν ἐλλείψουσιν αὗται λιπαροῦς χειρουργίας,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:674.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:674.1.text#ἀλλὰ καὶ ναῦς τεκτανοῦνται, κἀπιχειρήσουσ' ἔτι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:675.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:675.1.text#ναυμαχεῖν καὶ πλεῖν ἐφ' ἡμἁς ὥσπε, Ἀρτεμισία.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:676.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:676.1.text#ἢν δ' ἐφ' ἱππικὴν τράπωνται, διαγράφω τοὺς ἱππέας.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:677.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:677.1.text#ἱππικώτατον γάρ ἐστι χρῆμα κἄποχον γυνή,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:678.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:678.1.text#κοὐκ ἂν ἀπολίσθοι τρέχοντος· τὰς δ' Ἀμαζόνας σκόπει,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:679.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:679.1.text#ἃς Μίκων ἔγραψ' ἐφ' ἵππων μαχομένας τοῖς ἀνδράσιν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:680.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:680.1.text#ἀλλὰ τούτων χρῆν ἁπασῶν ἐς τετρημένον ξύλον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:681.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:681.1.text#ἐγκαθαρμόσαι λαβόντας τουτονὶ τὸν αὐχένα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:683.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:683.1.text#εἰ νὴ τὼ θεώ με ζωπυρήσεις,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:684.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:684.1.text#λύσω τὴν ἐμαυτῆς ὗν ἐγὼ δή, καὶ ποιήσω
urn:cts:greekLit:tlg0019.tlg007.fu.sp:685.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:685.1.text#τήμερον τοὺς δημότας βωστρεῖν σ' ἐγὼ πεκτούμενον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:686.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:686.1.text#ἀλλὰ χἠμεῖς ὦ γυναῖκες θᾶττον ἐκδυώμεθα,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:687.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:687.1.text#ὡς ἂν ὄζωμεν γυναικῶν αὐτοδὰξ ὠργισμένων.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:688.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:688.1.text#νῦν πρὸς ἔμ' ἴτω τις, ἵνα μή ποτε φάγῃ σκόροδα, μηδὲ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:690.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:690.1.text#κυάμους μέλανας.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:691.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:691.1.text#ὡς εἰ καὶ μόνον κακῶς ἐρεῖς, ὑπερχολῶ γάρ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:695.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:695.1.text#αἰετὸν τίκτοντα κάνθαρός σε μαιεύσομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:696.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:696.1.text#οὐ γὰρ ὑμῶν φροντίσαιμ' ἄν, ἢν ἐμοὶ ζῇ Λαμπιτὼ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:697.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:697.1.text#ἥ τε Θηβαία φίλη παῖς εὐγενὴς Ἰσμηνία.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:698.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:698.1.text#οὐ γὰρ ἔσται δύναμις, οὐδ' ἢν ἑπτάκις σὺ ψηφίσῃ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:699.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:699.1.text#ὅστις ὦ δύστην' ἀπήχθου πᾶσι καὶ τοῖς γείτοσιν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:700.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:700.1.text#ὥστε κἀχθὲς θἠκάτῃ ποιοῦσα παιγνίαν ἐγὼ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:701.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:701.1.text#τοῖσι παισὶ τὴν ἑταίραν ἐκάλεσ' ἐκ τῶν γειτόνων,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:702.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:702.1.text#παῖδα χρηστὴν κἀγαπητὴν ἐκ Βοιωτῶν ἔγχελυν·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:703.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:703.1.text#οἱ δὲ πέμψειν οὐκ ἔφασκον διὰ τὰ σὰ ψηφίσματα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:704.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:704.1.text#κοὐχὶ μὴ παύσησθε τῶν ψηφισμάτων τούτων, πρὶν ἂν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:705.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:705.1.text#τοῦ σκέλους ὑμᾶς λαβών τις ἐκτραχηλίσῃ φέρων.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:706.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:706.1.text#ἄνασσα πράγους τοῦδε καὶ βουλεύματος,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:707.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:707.1.text#τί μοι σκυθρωπὸς ἐξελήλυθας δόμων;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:708.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:708.1.text#κακῶν γυναικῶν ἔργα καὶ θήλεια φρὴν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:709.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:709.1.text#ποιεῖ μ' ἄθυμον περιπατεῖν τ' ἄνω κάτω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:710.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:710.1.text#τί φῄς; τί φῄς;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:711.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:711.1.text#ἀληθῆ, ἀληθῆ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:712.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:712.1.text#τί δ' ἐστὶ δεινόν; φράζε ταῖς σαυτῆς φίλαις.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:713.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:713.1.text#ἀλλ' αἰσχρὸν εἰπεῖν καὶ σιωπῆσαι βαρύ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:714.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:714.1.text#μή νύν με κρύψῃς ὅ τι πεπόνθαμεν κακόν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:715.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:715.1.text#βινητιῶμεν, ᾗ βράχιστον τοῦ λόγου.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:716.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:716.1.text#ἰὼ Ζεῦ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:717.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:717.1.text#τί Ζῆν' ἀυτεῖς; ταῦτα δ' οὖν οὕτως ἔχει.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:718.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:718.1.text#ἐγὼ μὲν οὖν αὐτὰς ἀποσχεῖν οὐκέτι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:719.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:719.1.text#οἵα τ' ἀπὸ τῶν ἀνδρῶν· διαδιδράσκουσι γάρ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:720.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:720.1.text#τὴν μέν γε πρώτην διαλέγουσαν τὴν ὀπὴν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:721.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:721.1.text#κατέλαβον ᾗ τοῦ Πανός ἐστι ταὐλίον,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:722.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:722.1.text#τὴν δ' ἐκ τροχιλείας αὖ κατειλυσπωμένην,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:723.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:723.1.text#τὴν δ' αὐτομολοῦσαν, τὴν δ' ἐπὶ στρούθου †μίαν†
urn:cts:greekLit:tlg0019.tlg007.fu.sp:724.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:724.1.text#ἤδη πέτεσθαι διανοουμένην κάτω
urn:cts:greekLit:tlg0019.tlg007.fu.sp:725.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:725.1.text#ἐς Ὀρσιλόχου χθὲς τῶν τριχῶν κατέσπασα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:726.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:726.1.text#πάσας τε προφάσεις ὥστ' ἀπελθεῖν οἴκαδε
urn:cts:greekLit:tlg0019.tlg007.fu.sp:727.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:727.1.text#ἕλκουσιν. ἤδη γοῦν τις αὐτῶν ἔρχεται.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:728.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:728.1.text#αὕτη σὺ ποῖ θεῖς;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:728.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:728.2.text#οἴκαδ' ἐλθεῖν βούλομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:729.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:729.1.text#οἴκοι γάρ ἐστιν ἔριά μοι Μιλήσια
urn:cts:greekLit:tlg0019.tlg007.fu.sp:730.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:730.1.text#ὑπὸ τῶν σέων κατακοπτόμενα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:730.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:730.2.text#ποίων σέων;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:731.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:731.1.text#οὐκ εἶ πάλιν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:731.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:731.2.text#ἀλλ' ἥξω ταχέως νὴ τὼ θεὼ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:732.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:732.1.text#ὅσον διαπετάσασ' ἐπὶ τῆς κλίνης μόνον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:733.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:733.1.text#μὴ διαπετάννυ, μηδ' ἀπέλθῃς μηδαμῇ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:734.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:734.1.text#ἀλλ' ἐῶ 'πολέσθαι τἄρι';
urn:cts:greekLit:tlg0019.tlg007.fu.sp:734.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:734.2.text#ἢν τούτου δέῃ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:735.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg007.fu.sp:735.1.text#τάλαιν' ἐγώ, τάλαινα τῆς Ἀμοργίδος,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:736.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg007.fu.sp:736.1.text#ἣν ἄλοπον οἴκοι καταλέλοιφ'.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:736.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:736.2.text#αὕθἠτέρα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:737.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:737.1.text#ἐπὶ τὴν Ἄμοργιν τὴν ἄλοπον ἐξέρχεται.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:738.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:738.1.text#χώρει πάλιν δεῦρ'.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:738.2.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg007.fu.sp:738.2.text#ἀλλὰ νὴ τὴν Φωσφόρον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:739.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg007.fu.sp:739.1.text#ἔγωγ' ἀποδείρασ' αὐτίκα μάλ' ἀνέρχομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:740.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:740.1.text#μή μἀποδείρῃς. ἢν γὰρ ἄρξῃς τοῦτο σύ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:741.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:741.1.text#ἑτέρα γυνὴ ταὐτὸν ποιεῖν βουλήσεται.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:742.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:742.1.text#ὦ πότνι' Εἰλείθυι' ἐπίσχες τοῦ τόκου,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:743.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:743.1.text#ἕως ἂν εἰς ὅσιον μόλω 'γὼ χωρίον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:744.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:744.1.text#τί ταῦτα ληρεῖς;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:744.2.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:744.2.text#αὐτίκα μάλα τέξομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:745.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:745.1.text#ἀλλ' οὐκ ἐκύεις σύ γ' ἐχθές.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:745.2.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:745.2.text#ἀλλὰ τήμερον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:746.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:746.1.text#ἀλλ' οἴκαδέ μ' ὡς τὴν μαῖαν ὦ Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:747.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:747.1.text#ἀπόπεμψον ὡς τάχιστα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:747.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:747.2.text#τίνα λόγον λέγεις;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:748.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:748.1.text#τί τοῦτ' ἔχεις τὸ σκληρόν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:748.2.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:748.2.text#ἄρρεν παιδίον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:749.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:749.1.text#μὰ τὴν Ἀφροδίτην οὐ σύ γ', ἀλλ' ἢ χαλκίον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:750.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:750.1.text#ἔχειν τι φαίνει κοῖλον· εἴσομαι δ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:751.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:751.1.text#ὦ καταγέλαστ' ἔχουσα τὴν ἱερὰν κυνῆν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:752.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:752.1.text#κυεῖν ἔφασκες;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:752.2.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:752.2.text#καὶ κυῶ γε νὴ Δία.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:753.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:753.1.text#τί δῆτα ταύτην εἶχες;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:753.2.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:753.2.text#ἵνα μ' εἰ καταλάβοι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:754.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:754.1.text#ὁ τόκος ἔτ' ἐν πόλει, τέκοιμ' ἐς τὴν κυνῆν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:755.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:755.1.text#ἐσβᾶσα ταύτην, ὥσπερ αἱ περιστεραί.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:756.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:756.1.text#τί λέγεις; προφασίζει· περιφανῆ τὰ πράγματα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:757.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:757.1.text#οὐ τἀμφιδρόμια τῆς κυνῆς αὐτοῦ μενεῖς;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:758.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:758.1.text#ἀλλ' οὐ δύναμαι 'γωγ' οὐδὲ κοιμᾶσθ' ἐν πόλει,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:759.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:759.1.text#ἐξ οὗ τὸν ὄφιν εἶδον τὸν οἰκουρόν ποτε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:760.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:760.1.text#ἐγὼ δ' ὑπὸ τῶν γλαυκῶν γε τάλαιν' ἀπόλλυμαι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:761.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:761.1.text#ταῖς ἀγρυπνίαισι κακκαβαζουσῶν ἀεί.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:762.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:762.1.text#ὦ δαιμόνιαι παύσασθε τῶν τερατευμάτων.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:763.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:763.1.text#ποθεῖτ' ἴσως τοὺς ἄνδρας· ἡμᾶς δ' οὐκ οἴει
urn:cts:greekLit:tlg0019.tlg007.fu.sp:764.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:764.1.text#ποθεῖν ἐκείνους; ἀργαλέας γ' εὖ οἶδ' ὅτι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:765.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:765.1.text#ἄγουσι νύκτας. ἀλλ' ἀνάσχεσθ' ὦγαθαί,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:766.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:766.1.text#καὶ προσταλαιπωρήσατ' ἔτ' ὀλίγον χρόνον,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:767.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:767.1.text#ὡς χρησμὸς ἡμῖν ἐστιν ἐπικρατεῖν, ἐὰν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:768.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:768.1.text#μὴ στασιάσωμεν· ἔστι δ' ὁ χρησμὸς οὑτοσί.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:769.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:769.1.text#λέγ' αὐτὸν ἡμῖν ὅ τι λέγει.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:769.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:769.2.text#σιγᾶτε δή.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:770.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:770.1.text#ἀλλ' ὁπόταν πτήξωσι χελιδόνες εἰς ἕνα χῶρον,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:771.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:771.1.text#τοὺς ἔποπας φεύγουσαι, ἀπόσχωνταί τε φαλήτων,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:772.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:772.1.text#παῦλα κακῶν ἔσται, τὰ δ' ὑπέρτερα νέρτερα θήσει
urn:cts:greekLit:tlg0019.tlg007.fu.sp:773.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:773.1.text#Ζεὺς ὑψιβρεμέτης—
urn:cts:greekLit:tlg0019.tlg007.fu.sp:773.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:773.2.text#ἐπάνω κατακεισόμεθ' ἡμεῖς;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:774.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:774.1.text#ἢν δὲ διαστῶσιν καὶ ἀναπτῶνται πτερύγεσσιν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:775.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:775.1.text#ἐξ ἱεροῦ ναοῖο χελιδόνες, οὐκέτι δόξει
urn:cts:greekLit:tlg0019.tlg007.fu.sp:776.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:776.1.text#ὄρνεον οὐδ' ὁτιοῦν καταπυγωνέστερον εἶναι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:777.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg007.fu.sp:777.1.text#σαφής γ' ὁ χρησμὸς νὴ Δί'.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:777.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:777.2.text#ὦ πάντες θεοί,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:778.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:778.1.text#μή νυν ἀπείπωμεν ταλαιπωρούμεναι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:779.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:779.1.text#ἀλλ' εἰσίωμεν. καὶ γὰρ αἰσχρὸν τουτογὶ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:780.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:780.1.text#ὦ φίλταται, τὸν χρησμὸν εἰ προδώσομεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:781.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:781.1.text#μῦθον βούλομαι λέξαι τιν' ὑμῖν, ὅν ποτ' ἤκουσ'
urn:cts:greekLit:tlg0019.tlg007.fu.sp:782.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:782.1.text#αὐτὸς ἔτι παῖς ὤν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:785.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:785.1.text#οὕτως ἦν νεανίσκος Μελανίων τις,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:786.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:786.1.text#ὃς φεύγων γάμον ἀφίκετ' ἐς ἐρημίαν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:787.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:787.1.text#κἀν τοῖς ὄρεσιν ᾤκει·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:788.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:788.1.text#κᾆτ' ἐλαγοθήρει
urn:cts:greekLit:tlg0019.tlg007.fu.sp:790.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:790.1.text#πλεξάμενος ἄρκυς,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:791.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:791.1.text#καὶ κύνα τιν' εἶχεν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:792.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:792.1.text#κοὐκέτι κατῆλθε πάλιν οἴκαδ' ὑπὸ μίσους.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:793.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:793.1.text#οὕτω τὰς γυναῖκας ἐβδελύχθη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:795.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:795.1.text#'κ'εῖνος, ἡμεῖς τ' οὐδὲν ἧττον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:796.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:796.1.text#τοῦ Μελανίωνος οἱ σώφρονες.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:797.1.speaker#γέρων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:797.1.text#βούλομαί σε γραῦ κύσαι—
urn:cts:greekLit:tlg0019.tlg007.fu.sp:798.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg007.fu.sp:798.1.text#κρόμμυόν τἄρ' οὐκ ἔδει.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:799.1.speaker#γέρων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:799.1.text#κἀνατείνας λακτίσαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:800.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg007.fu.sp:800.1.text#τὴν λόχμην πολλὴν φορεῖς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:801.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:801.1.text#καὶ Μυρωνίδης γὰρ ἦν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:802.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:802.1.text#τραχὺς ἐντεῦθεν μελάμπυγός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:803.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:803.1.text#τε τοῖς ἐχθροῖς ἅπασιν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:804.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:804.1.text#ὥς δὲ καὶ Φορμίων.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:805.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:805.1.text#κἀγὼ βούλομαι μῦθόν τιν' ὑμῖν ἀντιλέξαι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:806.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:806.1.text#τῷ Μελανίωνι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:807.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:807.1.text#Τίμων ἦν ἀίδρυτός τις ἀβάτοισιν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:810.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:810.1.text#ἐν σκώλοισι τὸ πρόσωπον περιειργμένος,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:811.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:811.1.text#Ἐρινύων ἀπορρώξ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:812.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:812.1.text#οὗτος οὖν ὁ Τίμων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:813.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:813.1.text# […]
urn:cts:greekLit:tlg0019.tlg007.fu.sp:814.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:814.1.text#ᾤχεθ' ὑπὸ μίσους
urn:cts:greekLit:tlg0019.tlg007.fu.sp:815.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:815.1.text#πολλὰ καταρασάμενος ἀνδράσι πονηροῖς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:816.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:816.1.text#οὕτω 'κεῖνος ὑμῶν ἀντεμίσει
urn:cts:greekLit:tlg0019.tlg007.fu.sp:817.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:817.1.text#τοὺς πονηροὺς ἄνδρας ἀεί,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:820.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:820.1.text#ταῖσι δὲ γυναιξὶν ἦν φίλτατος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:821.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg007.fu.sp:821.1.text#τὴν γνάθον βούλει θένω;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:822.1.speaker#γέρων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:822.1.text#μηδαμῶς· †ἔδεισά γε.†
urn:cts:greekLit:tlg0019.tlg007.fu.sp:823.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg007.fu.sp:823.1.text#ἀλλὰ κρούσω τῷ σκέλει;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:824.1.speaker#γέρων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:824.1.text#τὸν σάκανδρον ἐκφανεῖς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:825.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:825.1.text#ἀλλ' ὅμως ἂν οὐκ ἴδοις
urn:cts:greekLit:tlg0019.tlg007.fu.sp:826.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:826.1.text#καίπερ οὔσης γραὸς ὄντ' αὐτὸν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:827.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:827.1.text#κομήτην, ἀλλ' ἀπεψιλωμένον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:828.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:828.1.text#τῷ λύχνῳ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:829.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:829.1.text#ἰοὺ ἰοὺ γυναῖκες ἴτε δεῦρ' ὡς ἐμὲ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:830.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:830.1.text#ταχέως.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:830.2.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg007.fu.sp:830.2.text#τί δ' ἔστιν; εἰπέ μοι τίς ἡ βοή;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:831.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:831.1.text#ἄνδρ' ἄνδρ' ὁρῶ προσιόντα παραπεπληγμένον,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:832.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:832.1.text#τοῖς τῆς Ἀφροδίτης ὀργίοις εἰλημμένον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:833.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:833.1.text#ὦ πότνια Κύπρου καὶ Κυθήρων καὶ Πάφου
urn:cts:greekLit:tlg0019.tlg007.fu.sp:834.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:834.1.text#μεδέουσ', ἴθ' ὀρθὴν ἥνπερ ἔρχι τὴν ὁδόν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:835.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg007.fu.sp:835.1.text#ποῦ δ' ἐστὶν ὅστις ἐστί;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:835.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:835.2.text#παρὰ τὸ τῆς Χλόης.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:836.1.speaker#Γυνὴ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:836.1.text#ὢ νὴ Δί' ἔστι δῆτα. τίς κἀστίν ποτε;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:837.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:837.1.text#ὁρᾶτε· γιγνώσκει τις ὑμῶν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:837.2.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:837.2.text#νὴ Δία
urn:cts:greekLit:tlg0019.tlg007.fu.sp:838.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:838.1.text#ἔγωγε· κἀστὶν οὑμὸς ἀνὴρ Κινησίας.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:839.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:839.1.text#σὸν ἔργον ἤδη τοῦτον ὀπτᾶν καὶ στρέφειν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:840.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:840.1.text#κἀξηπεροπεύειν καὶ φιλεῖν καὶ μὴ φιλεῖν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:841.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:841.1.text#καὶ πάνθ' ὑπέχειν πλὴν ὧν σύνοιδεν ἡ κύλιξ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:842.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:842.1.text#ἀμέλει ποιήσω ταῦτ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:842.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:842.2.text#καὶ μὴν ἐγὼ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:843.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:843.1.text#ξυνηπεροπεύσω σοι παραμένουσ' ἐνθαδί,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:844.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:844.1.text#καὶ ξυσταθεύσω τοῦτον. ἀλλ' ἀπέλθετε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:845.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:845.1.text#οἴμοι κακοδαίμων, οἷος ὁ σπασμός μ' ἔχει
urn:cts:greekLit:tlg0019.tlg007.fu.sp:846.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:846.1.text#χὠ τέτανος ὥσπερ ἐπὶ τροχοῦ στρεβλούμενον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:847.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:847.1.text#τίς οὗτος οὑντὸς τῶν φυλάκων ἑστώς;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:847.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:847.2.text#ἐγώ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:848.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:848.1.text#ἀνήρ;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:848.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:848.2.text#ἀνὴρ δῆτ'.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:848.3.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:848.3.text#οὐκ ἄπει δῆτ' ἐκποδών;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:849.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:849.1.text#σὺ δ' εἶ τίς ἡκβάλλουσά μ';
urn:cts:greekLit:tlg0019.tlg007.fu.sp:849.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:849.2.text#ἡμεροσκόπος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:850.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:850.1.text#πρὸς τῶν θεῶν νυν ἐκκάλεσόν μοι Μυρρίνην.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:851.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:851.1.text#ἰδοὺ καλέσω 'γὼ Μυρρίνην σοι; σὺ δὲ τίς εἶ;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:852.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:852.1.text#ἀνὴρ ἐκείνης, Παιονίδης Κινησίας.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:853.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:853.1.text#ὦ χαῖρε φίλτατ'· οὐ γὰρ ἀκλεὲς τοὔνομ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:854.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:854.1.text#τὸ σὸν παρ' ἡμῖν ἐστιν οὐδ' ἀνώνυμον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:855.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:855.1.text#ἀεὶ γὰρ ἡ γυνή σ' ἔχει διὰ στόμα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:856.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:856.1.text#κἂν ᾠὸν ἢ μῆλον λάβῃ, "Κινησίᾳ"
urn:cts:greekLit:tlg0019.tlg007.fu.sp:857.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:857.1.text#"τουτὶ γένοιτο," φησίν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:857.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:857.2.text#ὢ πρὸς τῶν θεῶν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:858.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:858.1.text#νὴ τὴν Ἀφροδίτην· κἂν περὶ ἀνδρῶν γ' ἐμπέσῃ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:859.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:859.1.text#λόγος τις, εἴρηκ' εὐθέως ἡ σὴ γυνὴ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:860.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:860.1.text#ὅτι λῆρός ἐστι τἄλλα πρὸς Κινησίαν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:861.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:861.1.text#ἴθι νυν κάλεσον αὐτήν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:861.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:861.2.text#τί οὖν; δώσεις τί μοι;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:862.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:862.1.text#ἔγωγέ σοι νὴ τὸν Δί', ἢν βούλῃ γε σύ·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:863.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:863.1.text#ἔχω δὲ τοῦθ'· ὅπερ οὖν ἔχω, δίδωμί σοι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:864.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:864.1.text#φέρε νυν καλέσω καταβᾶσά σοι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:864.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:864.2.text#ταχύ νυν πάνυ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:865.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:865.1.text#ὡς οὐδεμίαν ἔχω γε τῷ βίῳ χάριν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:866.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:866.1.text#ἐξ οὗπερ αὕτη 'ξῆλθεν ἐκ τῆς οἰκίας·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:867.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:867.1.text#ἀλλ' ἄχθομαι μὲν εἰσιών, ἔρημα δὲ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:868.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:868.1.text#εἶναι δοκεῖ μοι πάντα, τοῖς δὲ σιτίοις
urn:cts:greekLit:tlg0019.tlg007.fu.sp:869.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:869.1.text#χάριν οὐδεμίαν οἶδ' ἐσθίων· ἔστυκα γάρ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:870.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:870.1.text#φιλῶ φιλῶ 'γὼ τοῦτον· ἀλλ' οὐ βούλεται
urn:cts:greekLit:tlg0019.tlg007.fu.sp:871.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:871.1.text#ὑπ' ἐμοῦ φιλεῖσθαι. σὺ δ' ἐμὲ τούτῳ μὴ κάλει.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:872.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:872.1.text#ὦ γλυκύτατον Μυρρινίδιον τί ταῦτα δρᾷς;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:873.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:873.1.text#κατάβηθι δεῦρο.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:873.2.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:873.2.text#μὰ Δί' ἐγὼ μὲν αὐτόσ' οὔ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:874.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:874.1.text#ἐμοῦ καλοῦντος οὐ καταβήσει Μυρρίνη;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:875.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:875.1.text#οὐ γὰρ δεόμενος οὐδὲν ἐκκαλεῖς ἐμέ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:876.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:876.1.text#ἐγὼ οὐ δεόμενος; ἐπιτετριμμένος μὲν οὖν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:877.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:877.1.text#ἄπειμι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:877.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:877.2.text#μὴ δῆτ', ἀλλὰ τῷ γοῦν παιδίῳ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:878.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:878.1.text#ὑπάκουσον· οὗτος οὐ καλεῖς τὴν μαμμίαν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:879.1.speaker#Παῖς Κινησίου
urn:cts:greekLit:tlg0019.tlg007.fu.sp:879.1.text#μαμμία, μαμμία, μαμμία.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:880.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:880.1.text#αὕτη τί πάσχεις; οὐδ' ἐλεεῖς τὸ παιδίον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:881.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:881.1.text#ἄλουτον ὂν κἄθηλον ἕκτην ἡμέραν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:882.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:882.1.text#ἔγωγ' ἐλεῶ δῆτ'· ἀλλ' ἀμελὴς αὐτῷ πατὴρ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:883.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:883.1.text#ἔστιν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:883.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:883.2.text#κατάβηθ' ὦ δαιμονία τῷ παιδίῳ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:884.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:884.1.text#οἷον τὸ τεκεῖν· καταβατέον. τί γὰρ πάθω;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:885.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:885.1.text#ἐμοὶ γὰρ αὕτη καὶ νεωτέρα δοκεῖ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:886.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:886.1.text#πολλῷ γεγενῆσθαι κἀγανώτερον βλέπειν·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:887.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:887.1.text#χἂ δυσκολαίνει πρὸς ἐμὲ καὶ βρενθύεται,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:888.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:888.1.text#ταῦτ' αὐτὰ δή 'σθ' ἃ κἄμ' ἐπιτρίβει τῷ πόθῳ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:889.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:889.1.text#ὦ γλυκύτατον σὺ τεκνίδιον κακοῦ πατρός,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:890.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:890.1.text#φέρε σε φιλήσω γλυκύτατον τῇ μαμμίᾳ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:891.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:891.1.text#τί ὦ πονήρα ταῦτα ποιεῖς χἀτέραις
urn:cts:greekLit:tlg0019.tlg007.fu.sp:892.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:892.1.text#πείθει γυναιξί, κἀμέ τ' ἄχθεσθαι ποιεῖς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:893.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:893.1.text#αὐτή τε λυπεῖ;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:893.2.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:893.2.text#μὴ πρόσαγε τὴν χεῖρά μοι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:894.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:894.1.text#τὰ δ' ἔνδον ὄντα τἀμὰ καὶ σὰ χρήματα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:895.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:895.1.text#χεῖρον διατίθης.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:895.2.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:895.2.text#ὀλίγον αὐτῶν μοι μέλει.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:896.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:896.1.text#ὀλίγον μέλει σοι τῆς κρόκης φορουμένης
urn:cts:greekLit:tlg0019.tlg007.fu.sp:897.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:897.1.text#ὑπὸ τῶν ἀλεκτρυόνων;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:897.2.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:897.2.text#ἔμοιγε νὴ Δία.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:898.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:898.1.text#τὰ δὲ τῆς Ἀφροδίτης ἱέρ' ἀνοργίαστά σοι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:899.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:899.1.text#χρόνον τοσοῦτόν ἐστιν. οὐ βαδιεῖ πάλιν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:900.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:900.1.text#μὰ Δί' οὐκ ἔγωγ', ἢν μὴ διαλλαχθῆτέ γε
urn:cts:greekLit:tlg0019.tlg007.fu.sp:901.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:901.1.text#καὶ τοῦ πολέμου παύσησθε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:901.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:901.2.text#τοιγάρ, ἢν δοκῇ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:902.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:902.1.text#ποιήσομεν καὶ ταῦτα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:902.2.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:902.2.text#τοιγάρ, ἢν δοκῇ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:903.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:903.1.text#κἄγωγ' ἄπειμ' ἐκεῖσε· νῦν δ' ἀπομώμοκα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:904.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:904.1.text#σὺ δ' ἀλλὰ κατακλίνηθι μετ' ἐμοῦ διὰ χρόνου.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:905.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:905.1.text#οὐ δῆτα· καίτοι σ' οὐκ ἐρῶ γ' ὡς οὐ φιλῶ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:906.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:906.1.text#φιλεῖς; τί οὖν οὐ κατεκλίνης ὦ Μύρριον;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:907.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:907.1.text#ὦ καταγέλαστ' ἐναντίον τοῦ παιδίου;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:908.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:908.1.text#μὰ Δί' ἀλλὰ τοῦτό γ' οἴκαδ' ὦ Μανῆ φέρε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:909.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:909.1.text#ἰδοὺ τὸ μέν σοι παιδίον καὶ δὴ 'κποδών,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:910.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:910.1.text#σὺ δ' οὐ κατακλίνει.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:910.2.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:910.2.text#ποῦ γὰρ ἄν τις καὶ τάλαν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:911.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:911.1.text#δράσειε τοῦθ';
urn:cts:greekLit:tlg0019.tlg007.fu.sp:911.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:911.2.text#ὅπου; τὸ τοῦ Πανὸς καλόν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:912.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:912.1.text#καὶ πῶς ἔθ' ἁγνὴ δῆτ' ἂν ἔλθοιμ' ἐς πόλιν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:913.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:913.1.text#κάλλιστα δήπου λουσαμένη τῇ Κλεψύδρᾳ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:914.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:914.1.text#ἔπειτ' ὀμόσασα δῆτ' ἐπιορκήσω τάλαν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:915.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:915.1.text#εἰς ἐμὲ τράποιτο· μηδὲν ὅρκου φροντίσῃς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:916.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:916.1.text#φέρε νυν ἐνέγκω κλινίδιον νῷν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:916.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:916.2.text#μηδαμῶς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:917.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:917.1.text#ἀρκεῖ χαμαὶ νῷν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:917.2.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:917.2.text#μὰ τὸν Ἀπόλλω μή σ' ἐγὼ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:918.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:918.1.text#καίπερ τοιοῦτον ὄντα κατακλινῶ χαμαί.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:919.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:919.1.text#ἥ τοι γυνὴ φιλεῖ με, δήλη 'στὶν καλῶς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:920.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:920.1.text#ἰδοὺ κατάκεισ' ἀνύσας τι, κἀγὼ 'κδύομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:921.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:921.1.text#καίτοι, τὸ δεῖνα, ψίαθός ἐστ' ἐξοιστέα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:922.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:922.1.text#ποία ψίαθος; μὴ μοί γε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:922.2.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:922.2.text#νὴ τὴν Ἄρτεμιν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:923.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:923.1.text#αἰσχρὸν γὰρ ἐπὶ τόνου γε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:923.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:923.2.text#δός μοί νυν κύσαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:924.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:924.1.text#ἰδού.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:924.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:924.2.text#παπαιάξ· ἧκέ νυν ταχέως πάνυ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:925.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:925.1.text#ἰδοὺ ψίαθος· κατάκεισο, καὶ δὴ 'κδύομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:926.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:926.1.text#καίτοι, τὸ δεῖνα, προσκεφάλαιον οὐκ ἔχεις.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:927.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:927.1.text#ἀλλ' οὐδὲ δέομ' ἔγωγε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:927.2.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:927.2.text#νὴ Δί' ἀλλ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:928.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:928.1.text#ἀλλ' ἢ τὸ πέος τόδ' Ἡρακλῆς ξενίζεται.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:929.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:929.1.text#ἀνίστασ', ἀναπήδησον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:929.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:929.2.text#ἤδη πάντ' ἔχω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:930.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:930.1.text#ἅπαντα δῆτα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:930.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:930.2.text#δεῦρό νυν ὦ χρύσιον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:931.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:931.1.text#τὸ στρόφιον ἤδη λύομαι. μέμνησό νυν·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:932.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:932.1.text#μή μ' ἐξαπατήσῃς τὰ περὶ τῶν διαλλαγῶν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:933.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:933.1.text#νὴ Δί' ἀπολοίμην ἆρα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:933.2.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:933.2.text#σισύραν οὐκ ἔχεις.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:934.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:934.1.text#μὰ Δί' οὐδὲ δέομαί γ', ἀλλὰ βινεῖν βούλομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:935.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:935.1.text#ἀμέλει ποιήσεις τοῦτο· ταχὺ γὰρ ἔρχομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:936.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:936.1.text#ἅνθρωπος ἐπιτρίψει με διὰ τὰ στρώματα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:937.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:937.1.text#ἔπαιρε σαυτόν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:937.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:937.2.text#ἀλλ' ἐπῆρται τοῦτό γε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:938.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:938.1.text#βούλει μυρίσω σε;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:938.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:938.2.text#μὰ τὸν Ἀπόλλω μὴ μέ γε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:939.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:939.1.text#νὴ τὴν Ἀφροδίτην ἤν τε βούλῃ γ' ἤν τε μή.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:940.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:940.1.text#εἴθ' ἐκχυθείη τὸ μύρον ὦ Ζεῦ δέσποτα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:941.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:941.1.text#πρότεινέ νυν τὴν χεῖρα κἀλείφου λαβών.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:942.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:942.1.text#οὐχ ἡδὺ τὸ μύρον μὰ τὸν Ἀπόλλω τουτογί,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:943.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:943.1.text#εἰ μὴ διατριπτικόν γε κοὐκ ὄζον γάμων.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:944.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:944.1.text#τάλαιν' ἐγὼ τὸ Ῥόδιον ἤνεγκον μύρον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:945.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:945.1.text#ἀγαθόν· ἔα αὔτ' ὦ δαιμονία.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:945.2.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:945.2.text#ληρεῖς ἔχων.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:946.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:946.1.text#κάκιστ' ἀπόλοιθ' ὁ πρῶτος ἑψήσας μύρον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:947.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:947.1.text#λαβὲ τόνδε τὸν ἀλάβαστον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:947.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:947.2.text#ἀλλ' ἕτερον ἔχω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:948.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:948.1.text#ἀλλ' ᾠζυρὰ κατάκεισο καὶ μή μοι φέρε
urn:cts:greekLit:tlg0019.tlg007.fu.sp:949.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:949.1.text#μηδέν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:949.2.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:949.2.text#ποιήσω ταῦτα νὴ τὴν Ἄρτεμιν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:950.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:950.1.text#ὑπολύομαι γοῦν. ἀλλ' ὅπως ὦ φίλτατε
urn:cts:greekLit:tlg0019.tlg007.fu.sp:951.1.speaker#Μυρρίνη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:951.1.text#σπονδὰς ποιεῖσθαι ψηφιεῖ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:951.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:951.2.text#βουλεύσομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:952.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:952.1.text#ἀπολώλεκέν με κἀπιτέτριφεν ἡ γυνὴ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:953.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:953.1.text#τά τ' ἄλλα πάντα κἀποδείρασ' οἴχεται.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:954.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:954.1.text#οἴμοι τί πάθω; τίνα βινήσω
urn:cts:greekLit:tlg0019.tlg007.fu.sp:955.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:955.1.text#τῆς καλλίστης πασῶν ψευσθείς;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:956.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:956.1.text#πῶς ταυτηνὶ παιδοτροφήσω;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:957.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:957.1.text#ποῦ Κυναλώπηξ;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:958.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:958.1.text#μίσθωσόν μοι τὴν τίτθην.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:959.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:959.1.text#ἐν δεινῷ γ' ὦ δύστηνε κακῷ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:960.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:960.1.text#τείρει ψυχὴν ἐξαπατηθείς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:961.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:961.1.text#κἄγωγ' οἰκτίρω σ' αἰαῖ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:962.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:962.1.text#ποῖος γὰρ ἂν ἢ νέφρος ἀντίσχοι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:963.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:963.1.text#ποία ψυχή, ποῖοι δ' ὄρχεις,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:964.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:964.1.text#ποία δ' ὀσφῦς, ποῖος δ' ὄρρος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:965.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:965.1.text#κατατεινόμενος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:966.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:966.1.text#καὶ μὴ βινῶν τοὺς ὄρθρους;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:967.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:967.1.text#ὦ Ζεῦ δεινῶν ἀντισπασμῶν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:968.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:968.1.text#ταυτὶ μέντοι νυνί σ' ἐποίησ'
urn:cts:greekLit:tlg0019.tlg007.fu.sp:969.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:969.1.text#ἡ παμβδελυρὰ καὶ παμμυσαρά.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:970.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:970.1.text#μὰ Δί' ἀλλὰ φίλη καὶ παγγλυκερά.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:971.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:971.1.text#ποία γλυκερά; μιαρὰ μιαρά.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:972.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:972.1.text# μιαρὰ δῆτ' ὦ Ζεῦ ὦ Ζεῦ·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:973.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:973.1.text#εἴθ' αὐτὴν ὥσπερ τοὺς θωμοὺς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:974.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:974.1.text#μεγάλῳ τυφῷ καὶ πρηστῆρι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:975.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:975.1.text#ξυστρέψας καὶ ξυγγογγύλας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:976.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:976.1.text#οἴχοιο φέρων, εἶτα μεθείης,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:977.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:977.1.text#ἡ δὲ φέροιτ' αὖ πάλιν ἐς τὴν γῆν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:978.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:978.1.text#κᾆτ' ἐξαίφνης
urn:cts:greekLit:tlg0019.tlg007.fu.sp:979.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:979.1.text#περὶ τὴν ψωλὴν περιβαίη.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:980.1.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:980.1.text#πᾷ τᾶν Ἀσανᾶν ἐστιν ἁ γερωχία
urn:cts:greekLit:tlg0019.tlg007.fu.sp:981.1.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:981.1.text#ἢ τοὶ πρυτάνιες; λῶ τι μυσίξαι νέον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:982.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:982.1.text#σὺ δ' εἶ πότερον ἄνθρωπος ἢ κονίσαλος;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:983.1.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:983.1.text#κᾶρυξ ἐγὼν ὦ κυρσάνιε ναὶ τὼ σιὼ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:984.1.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:984.1.text#ἔμολον ἀπὸ Σπάρτας περὶ τᾶν διαλλαγᾶν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:985.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:985.1.text#κἄπειτα δόρυ δῆθ' ὑπὸ μάλης ἥκεις ἔχων;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:986.1.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:986.1.text#οὐ τὸν Δί' οὐκ ἐγών γα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:986.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:986.2.text#ποῖ μεταστρέφει;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:987.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:987.1.text#τί δὴ προβάλλει τὴν χλαμύδ'; ἢ βουβωνιᾷς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:988.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:988.1.text#ὑπὸ τῆς ὁδοῦ;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:988.2.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:988.2.text#παλαιόρ γα ναὶ τὸν Κάστορα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:989.1.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:989.1.text#ὥνθρωπος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:989.2.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:989.2.text#ἀλλ' ἔστυκας ὦ μιαρώτατε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:990.1.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:990.1.text#οὐ τὸν Δί' οὐκ ἐγών γα· μηδ' αὖ πλαδδίη.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:991.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:991.1.text#τί δ' ἐστί σοι τοδί;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:991.2.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:991.2.text#σκυτάλα Λακωνικά.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:992.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:992.1.text#εἴπερ γε χαὔτη 'στὶ σκυτάλη Λακωνική.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:993.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:993.1.text#ἀλλ' ὡς πρὸς εἰδότ' ἐμὲ σὺ τἀληθῆ λέγε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:994.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:994.1.text#τί τὰ πράγμαθ' ὑμῖν ἐστι τἀν Λακεδαίμονι;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:995.1.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:995.1.text#ὀρσὰ Λακεδαίμων πᾶα καὶ τοὶ σύμμαχοι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:996.1.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:996.1.text#ἅπαντες ἐστύκαντι· Πελλάνας δὲ δεῖ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:997.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:997.1.text#ἀπὸ τοῦ δὲ τουτὶ τὸ κακὸν ὑμῖν ἐνέπεσεν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:998.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:998.1.text#ἀπὸ Πανός;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:998.2.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:998.2.text#οὔκ, ἀλλ' ἆρχεν οἰῶ Λαμπιτώ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:999.1.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:999.1.text#ἔπειτα τἄλλαι ταὶ κατὰ Σπάρταν ἅμα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1000.1.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1000.1.text#γυναῖκες ᾇπερ ἀπὸ μιᾶς ὑσπλαγίδος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1001.1.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1001.1.text#ἀπήλααν τὼς ἄνδρας ἀπὸ τῶν ὑσσάκων.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1002.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1002.1.text#πῶς οὖν ἔχετε;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1002.2.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1002.2.text#μογίομες. ἂν γὰρ τὰν πόλιν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1003.1.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1003.1.text#ᾇπερ λυχνοφορίοντες ἐπικεκύφαμες.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1004.1.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1004.1.text#ταὶ γὰρ γυναῖκες οὐδὲ τῶ μύρτω σιγεῖν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1005.1.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1005.1.text#ἐῶντι, πρίν γ' ἅπαντες ἐξ ἑνὸς λόγω
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1006.1.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1006.1.text#σπονδὰς ποιησώμεσθα ποττὰν Ἑλλάδα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1007.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1007.1.text#τουτὶ τὸ πρᾶγμα πανταχόθεν ξυνομώμοται
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1008.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1008.1.text#ὑπὸ τῶν γυναικῶν· ἄρτι νυνὶ μανθάνω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1009.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1009.1.text#ἀλλ' ὡς τάχιστα φράζε περὶ διαλλαγῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1010.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1010.1.text#αὐτοκράτορας πρέσβεις ἀποπέμπειν ἐνθαδί.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1011.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1011.1.text#ἐγὼ δ' ἑτέρους ἐνθένδε τῇ βουλῇ φράσω
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1012.1.speaker#Κινησίας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1012.1.text#πρέσβεις ἑλέσθαι τὸ πέος ἐπιδείξας τοδί.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1013.1.speaker#Κῆρυξ Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1013.1.text#ποτάομαι· κράτιστα γὰρ παντᾷ λέγεις.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1014.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1014.1.text#οὐδέν ἐστι θηρίον γυναικὸς ἀμαχώτερον,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1015.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1015.1.text#οὐδὲ πῦρ, οὐδ' ὧδ' ἀναιδὴς οὐδεμία πόρδαλις.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1016.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1016.1.text#ταῦτα μέντοι σὺ ξυνιεὶς εἶτα πολεμεῖς ἐμοί,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1017.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1017.1.text#ἐξὸν ὦ πόνηρε σοὶ βέβαιον ἔμ' ἔχειν φίλην;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1018.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1018.1.text#ὡς ἐγὼ μισῶν γυναῖκας οὐδέποτε παύσομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1019.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1019.1.text#ἀλλ' ὅταν βούλῃ σύ· νῦν δ' οὖν οὔ σε περιόψομαι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1020.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1020.1.text#γυμνὸν ὄνθ' οὕτως. ὁρῶ γὰρ ὡς καταγέλαστος εἶ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1021.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1021.1.text#ἀλλὰ τὴν ἐξωμίδ' ἐνδύσω σε προσιοῦσ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1022.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1022.1.text#τοῦτο μὲν μὰ τὸν Δί' οὐ πονηρὸν ἐποιήσατε·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1023.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1023.1.text#ἀλλ' ὑπ' ὀργῆς γὰρ πονηρᾶς καὶ τότ' ἀπέδυν ἐγώ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1024.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1024.1.text#πρῶτα μὲν φαίνει γ' ἀνήρ, εἶτ' οὐ καταγέλαστος εἶ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1025.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1025.1.text#κεἴ με μὴ 'λύπεις, ἐγώ σου κἂν τόδε τὸ θηρίον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1026.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1026.1.text#τοὐπὶ τὠφθαλμῷ λαβοῦσ' ἐξεῖλον ἂν ὃ νῦν ἔνι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1027.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1027.1.text#τοῦτ' ἄρ' ἦν με τοὐπιτρῖβον, δακτύλιος οὑτοσί·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1028.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1028.1.text#ἐκσκάλευσον αὐτό, κᾆτα δεῖξον ἀφελοῦσά μοι·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1029.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1029.1.text#ὡς τὸν ὀφθαλμόν γέ μου νὴ τὸν Δία πάλαι δάκνει.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1030.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1030.1.text#ἀλλὰ δράσω ταῦτα· καίτοι δύσκολος ἔφυς ἀνήρ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1031.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1031.1.text#ἦ μέγ' ὦ Ζεῦ χρῆμ' ἰδεῖν τῆς ἐμπίδος ἔνεστί σοι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1032.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1032.1.text#οὐχ ὁρᾷς; οὐκ ἐμπίς ἐστιν ἥδε Τρικορυσία;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1033.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1033.1.text#νὴ Δί' ὤνησάς γέ μ', ὡς πάλαι γέ μ' ἐφρεωρύχει,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1034.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1034.1.text#ὥστ' ἐπειδὴ 'ξῃρέθη, ῥεῖ μου τὸ δάκρυον πολύ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1035.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1035.1.text#ἀλλ' ἀποψήσω σ' ἐγώ, καίτοι πάνυ πονηρὸς εἶ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1036.1.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1036.1.text#καὶ φιλήσω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1036.2.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1036.2.text#μὴ φιλήσῃς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1036.3.speaker#Χορὸς Γυναικῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1036.3.text#ἤν τε βούλῃ γ' ἤν τε μή.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1037.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1037.1.text#ἀλλὰ μὴ ὥρασ' ἵκοισθ'· ὡς ἐστὲ θωπικαὶ φύσει,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1038.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1038.1.text#κἄστ' ἐκεῖνο τοὔπος ὀρθῶς κοὐ κακῶς εἰρημένον,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1039.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1039.1.text#οὔτε σὺν πανωλέθροισιν οὔτ' ἄνευ πανωλέθρων.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1040.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1040.1.text#ἀλλὰ νυνὶ σπένδομαί σοι, καὶ τὸ λοιπὸν οὐκέτι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1041.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1041.1.text#οὔτε δράσω φλαῦρον οὐδὲν οὔθ' ὑφ' ὑμῶν πείσομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1042.1.speaker#Χορὸς γερόντων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1042.1.text#ἀλλὰ κοινῇ συσταλέντες τοῦ μέλους ἀρξώμεθα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1043.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1043.1.text#οὐ παρασκευαζόμεσθα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1044.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1044.1.text#τῶν πολιτῶν οὐδέν' ὦνδρες
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1045.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1045.1.text#φλαῦρον εἰπεῖν οὐδὲ ἕν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1046.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1046.1.text#ἀλλὰ πολὺ τοὔμπαλιν πάντ' ἀγαθὰ καὶ λέγειν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1047.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1047.1.text#καὶ δρᾶν· ἱκανὰ γὰρ τὰ κακὰ καὶ τὰ παρακείμενα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1048.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1048.1.text#ἀλλ' ἐπαγγελλέτω πᾶς ἀνὴρ καὶ γυνή,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1050.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1050.1.text#εἴ τις ἀργυρίδιον δεῖται
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1051.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1051.1.text#λαβεῖν μνᾶς ἢ δύ' ἢ τρεῖς,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1052.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1052.1.text#ὡς † πόλλ' ἔσω 'στὶν†
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1053.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1053.1.text#κἄχομεν βαλλάντια.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1054.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1054.1.text#κἄν ποτ' εἰρήνη φανῇ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1055.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1055.1.text#ὅστις ἂν νυνὶ δανείσηται
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1056.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1056.1.text#παρ' ἡμῶν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1057.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1057.1.text#ἃν λάβῃ μηκέτ' ἀποδῷ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1058.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1058.1.text#ἑστιᾶν δὲ μέλλομεν ξένους
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1059.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1059.1.text#τινὰς Καρυστίους, ἄν-
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1060.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1060.1.text#δρας καλούς τε κἀγαθούς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1061.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1061.1.text#κἄστιν ἔτ' ἔτνος τι· καὶ δελφάκιον ἦν τί μοι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1062.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1062.1.text#καὶ τοῦτο τέθυχ', ὡς τὰ κρέ' ἔδεσθ' ἁπαλὰ καὶ καλά.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1063.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1063.1.text#ἥκετ' οὖν εἰς ἐμοῦ τήμερον· πρῲ δὲ χρὴ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1064.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1064.1.text#τοῦτο δρᾶν λελουμένους αὔ-
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1065.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1065.1.text#τούς τε καὶ τὰ παιδί', εἶτ' εἴσω βαδίζειν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1066.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1066.1.text#μηδ' ἐρέσθαι μηδένα,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1067.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1067.1.text#ἀλλὰ χωρεῖν ἄντικρυς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1068.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1068.1.text#ὥσπερ οἴκαδ' εἰς ἑαυτῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1070.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1070.1.text#γεννικῶς, ὡς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1071.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1071.1.text#ἡ θύρα κεκλῄσεται.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1072.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1072.1.text#καὶ μὴν ἀπὸ τῆς Σπάρτης οἱδὶ πρέσβεις ἕλκοντες ὑπήνας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1073.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1073.1.text#χωροῦσ', ὥσπερ χοιροκομεῖον περὶ τοῖς μηροῖσιν ἔχοντες.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1074.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1074.1.text#ἄνδρες Λάκωνες πρῶτα μέν μοι χαίρετε,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1075.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1075.1.text#εἶτ' εἴπαθ' ἡμῖν πῶς ἔχοντες ἥκετε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1076.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1076.1.text#τί δεῖ ποθ' ὑμὲ πολλὰ μυσίδδειν ἔπη;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1077.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1077.1.text#ὁρῆν γὰρ ἔξεσθ' ὡς ἔχοντες ἵκομες.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1078.1.speaker#Χορός 
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1078.1.text#βαβαί· νενεύρωται μὲν ἥδε συμφορὰ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1079.1.speaker#Χορός 
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1079.1.text#δεινῶς, †τεθερμῶσθαί γε† χεῖρον φαίνεται.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1080.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1080.1.text#ἄφατα. τί κα λέγοι τις; ἀλλ' ὅπᾳ σέλει
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1081.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1081.1.text#παντᾷ τις ἐλσὼν ἁμὶν εἰράναν σέτω.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1082.1.speaker#Χορός 
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1082.1.text#καὶ μὴν ὁρῶ καὶ τούσδε τοὺς αὐτόχθονας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1083.1.speaker#Χορός 
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1083.1.text#ὥσπερ παλαιστὰς ἄνδρας ἀπὸ τῶν γαστέρων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1084.1.speaker#Χορός 
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1084.1.text#θαἰμάτι' ἀποστέλλοντας· ὥστε φαίνεται
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1085.1.speaker#Χορός 
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1085.1.text#ἀσκητικὸν τὸ χρῆμα τοῦ νοσήματος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1086.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1086.1.text#τίς ἂν φράσεις ποῦ' στιν ἡ Λυσιστράτη;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1087.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1087.1.text#ὡς ἄνδρες ἡμεῖς οὑτοιὶ τοιουτοιί.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1088.1.speaker#Χορός 
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1088.1.text#χαὔτη ξυνᾴδει χἠτέρα ταύτῃ νόσῳ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1089.1.speaker#Χορός 
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1089.1.text#ἦ που πρὸς ὄρθρον σπασμὸς ὑμᾶς λαμβάνει;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1090.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1090.1.text#μὰ Δί' ἀλλὰ ταυτὶ δρῶντες ἐπιτετρίμμεθα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1091.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1091.1.text#ὥστ' εἴ τις ἡμᾶς μὴ διαλλάξει ταχύ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1092.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1092.1.text#οὐκ ἔσθ' ὅπως οὐ Κλεισθένη βινήσομεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1093.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1093.1.text#εἰ σωφρονεῖτε, θαἰμάτια λήψεσθ', ὅπως
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1094.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1094.1.text#τῶν Ἑρμοκοπιδῶν μή τις ὑμᾶς ὄψεται.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1095.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1095.1.text#νὴ τὸν Δί' εὖ μέντοι λέγεις.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1095.2.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1095.2.text#ναὶ τὼ σιὼ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1096.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1096.1.text#παντᾷ γα. φέρε τὸ ἔσθος ἀμβαλώμεθα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1097.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1097.1.text#ὢ χαίρετ' ὦ Λάκωνες· αἰσχρά γ' ἐπάθομεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1098.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1098.1.text#ὦ Πολυχαρείδα δεινά κ' αὖ 'πεπόνθεμες,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1099.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1099.1.text#αἰ εἶδον ἁμὲ τὤνδρες ἀμπεφλασμένως.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1100.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1100.1.text#ἄγε δὴ Λάκωνες αὔθ' ἕκαστα χρὴ λέγειν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1101.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1101.1.text#ἐπὶ τί πάρεστε δεῦρο;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1101.2.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1101.2.text#περὶ διαλλαγᾶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1102.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1102.1.text#πρέσβεις.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1102.2.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1102.2.text#καλῶς δὴ λέγετε· χἠμεῖς τουτογί.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1103.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1103.1.text#τί οὐ καλοῦμεν δῆτα τὴν Λυσιστράην,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1104.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1104.1.text#ἥπερ διαλλάξειεν ἡμᾶς ἂν μόνη;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1105.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1105.1.text#ναὶ τὼ σιὼ κἂν λῆτε τὸν Λυσίστρατον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1106.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1106.1.text#ἀλλ' οὐδὲν ἡμᾶς, ὡς ἔοικε, δεῖ καλεῖν·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1107.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1107.1.text#αὐτὴ γάρ, ὡς ἤκουσεν, ἥδ' ἐξέρχεται.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1108.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1108.1.text#χαῖρ' ὦ πασῶν ἀνδρειοτάτη· δεῖ δὴ νυνί σε γενέσθαι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1109.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1109.1.text#δεινὴν δειλὴν ἀγαθὴν φαύλην σεμνὴν ἀγανὴν πολύπειρον·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1110.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1110.1.text#ὡς οἱ πρῶτοι τῶν Ἑλλήνων τῇ σῇ ληφθέντες ἴυγγι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1111.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1111.1.text#συνεχώρησάν σοι καὶ κοινῇ τἀγκλήματα πάντ' ἐπέτρεψαν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1112.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1112.1.text#ἀλλ' οὐχὶ χαλεπὸν τοὔργον, εἰ λάβοι γέ τις
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1113.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1113.1.text#ὀργῶντας ἀλλήλων τε μὴ 'κπειρωμένους.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1114.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1114.1.text#τάχα δ' εἴσομαι 'γώ. ποῦ 'στιν ἡ Διαλλαγή;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1115.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1115.1.text#πρόσαγε λαβοῦσα πρῶτα τοὺς Λακωνικούς,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1116.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1116.1.text#καὶ μὴ χαλεπῇ τῇ χειρὶ μηδ' αὐθαδικῇ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1117.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1117.1.text#μηδ' ὥσπερ ἡμῶν ἅνδρες ἀμαθῶς τοῦτ' ἔδρων,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1118.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1118.1.text#ἀλλ' ὡς γυναῖκας εἰκός, οἰκείως πάνυ,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1119.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1119.1.text#ἢν μὴ διδῷ τὴν χεῖρα, τῆς σάθης ἄγε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1120.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1120.1.text#ἴθι καὶ σὺ τούτους τοὺς Ἀθηναίους ἄγε,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1121.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1121.1.text#οὗ δ' ἂν διδῶσι πρόσαγε τούτους λαβομένη.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1122.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1122.1.text#ἄνδρες Λάκωνες στῆτε παρ' ἐμὲ πλησίον,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1123.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1123.1.text#ἐνθένδε δ' ὑμεῖς, καὶ λόγων ἀκούσατε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1124.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1124.1.text#ἐγὼ γυνὴ μέν εἰμι, νοῦς δ' ἔνεστί μοι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1125.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1125.1.text#αὐτὴ δ' ἐμαυτῆς οὐ κακῶς γνώμης ἔχω,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1126.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1126.1.text#τοὺς δ' ἐκ πατρός τε καὶ γεραιτέρων λόγους
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1127.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1127.1.text#πολλοὺς ἀκούσασ' οὐ μεμούσωμαι κακῶς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1128.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1128.1.text#λαβοῦσα δ' ὑμᾶς λοιδορῆσαι βούλομαι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1129.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1129.1.text#κοινῇ δικαίως, οἳ μιᾶς ἐκ χέρνιβος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1130.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1130.1.text#βωμοὺς περιρραίνοντες ὥσπερ ξυγγενεῖς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1131.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1131.1.text#Ὀλυμπίασιν, ἐν Πύλαις, Πυθοῖ "πόσους"
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1132.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1132.1.text#"εἴποιμ' ἂν ἄλλους, εἴ με μηκύνειν δέοι;"
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1133.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1133.1.text#ἐχθρῶν παρόντων βαρβάρων στρατεύματι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1134.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1134.1.text#Ἕλληνας ἄνδρας καὶ πόλεις ἀπόλλυτε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1135.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1135.1.text#εἷς μὲν λόγος μοι δεῦρ' ἀεὶ περαίνεται.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1136.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1136.1.text#ἐγὼ δ' ἀπόλλυμαί γ' ἀπεψωλημένος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1137.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1137.1.text#εἶτ' ὦ Λάκωνες, πρὸς γὰρ ὑμᾶς τρέψομαι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1138.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1138.1.text#οὐκ ἴσθ' ὅτ' ἐλθὼν δεῦρο Περικλείδας ποτὲ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1139.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1139.1.text#ὁ Λάκων Ἀθηναίων ἱκέτης καθέζετο
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1140.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1140.1.text#ἐπὶ τοῖσι βωμοῖς ὠχρὸς ἐν φοινικίδι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1141.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1141.1.text#στρατιὰν προσαιτῶν; ἡ δὲ Μεσσήνη τότε
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1142.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1142.1.text#ὑμῖν ἐπέκειτο χὠ θεὸς σείων ἅμα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1143.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1143.1.text#ἐλθὼν δὲ σὺν ὁπλίταισι τετρακισχιλίοις
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1144.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1144.1.text#Κίμων ὅλην ἔσωσε τὴν Λακεδαίμονα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1145.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1145.1.text#ταυτὶ παθόντες τῶν Ἀθηναίων ὕπο
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1146.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1146.1.text#δῃοῦτε χώραν, ἧς ὑπ' εὖ πεπόνθατε;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1147.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1147.1.text#ἀδικοῦσιν οὗτοι νὴ Δί' ὦ Λυσιστράτη.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1148.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1148.1.text#ἀδικίομες· ἀλλ' ὁ πρωκτὸς ἄφατον ὡς καλός.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1149.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1149.1.text#ὑμᾶς δ' ἀφήσειν τοὺς Ἀθηναίους μ' οἴει;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1150.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1150.1.text#οὐκ ἴσθ' ὅθ' ὑμᾶς οἱ Λάκωνες αὖθις αὖ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1151.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1151.1.text#κατωνάκας φοροῦντας ἐλθόντες δορὶ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1152.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1152.1.text#πολλοὺς μὲν ἄνδρας Θετταλῶν ἀπώλεσαν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1153.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1153.1.text#πολλοὺς δ' ἑταίρους Ἱππίου καὶ ξυμμάχους,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1154.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1154.1.text#ξυνεκμαχοῦντες τῇ τόθ' ἡμέρᾳ μόνοι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1155.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1155.1.text#κἠλευθέρωσαν κἀντὶ τῆς κατωνάκης
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1156.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1156.1.text#τὸν δῆμον ὑμῶν χλαῖναν ἠμπέσχον πάλιν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1157.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1157.1.text#οὔπα γυναῖκ' ὄπωπα χαϊωτεραν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1158.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1158.1.text#ἐγὼ δὲ κύσθον γ' οὐδέπω καλλίονα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1159.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1159.1.text#τί δῆθ' υπηργμένων γε πολλῶν κἀγαθῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1160.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1160.1.text#μάχεσθε κοὐ παύεσθε τῆς μοχθηρίας;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1161.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1161.1.text#τί δ' οὐ διηλλάγητε; φέρε τί τοὐμποδών;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1162.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1162.1.text#ἁμές γε λῶμες, αἴ τις ἁμὶν τὤγκυκλον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1163.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1163.1.text#λῇ τοῦτ' ἀποδόμεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1163.2.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1163.2.text#ποῖον ὦ τᾶν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1163.3.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1163.3.text#τὰν Πύλον,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1164.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1164.1.text#ἇσπερ πάλαι δεόμεθα καὶ βλιμάττομες.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1165.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1165.1.text#μὰ τὸν Ποσειδῶ τοῦτο μέν γ' οὐ δράσετε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1166.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1166.1.text#ἄφετ' ὦγάθ' αὐτοῖς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1166.2.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1166.2.text#κᾆτα τίνα κινήσομεν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1167.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1167.1.text#ἕτερόν γ' ἀπαιτεῖτ' ἀντὶ τούτου χωρίον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1168.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1168.1.text#τὸ δεῖνα τοίνυν παράδοθ' ἡμῖν τουτονὶ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1169.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1169.1.text#πρώτιστα τὸν Ἐχινοῦντα καὶ τὸν Μηλιᾶ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1170.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1170.1.text#κόλπον τὸν ὄπισθεν καὶ τὰ Μεγαρικὰ σκέλη.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1171.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1171.1.text#οὐ τὼ σιὼ οὐχὶ πάντα γ' ὦ λισσάνιε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1172.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1172.1.text#ἐᾶτε, μηδὲν διαφέρου περὶ σκελοῖν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1173.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1173.1.text#ἤδη γεωργεῖν γυμνὸς ἀποδὺς βούλομαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1174.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1174.1.text#ἐγὼ δὲ κοπραγωγεῖν γα †πρῶτα† ναὶ τὼ σιώ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1175.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1175.1.text#ἐπὴν διαλλαγῆτε, ταῦτα δράσετε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1176.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1176.1.text#ἀλλ' εἰ δοκεῖ δρᾶν ταῦτα, βουλεύσασθε καὶ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1177.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1177.1.text#τοῖς ξυμμάχοις ἐλθόντες ἀνακοινώσατε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1178.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1178.1.text#ποίοισιν ὦ τᾶν ξυμμάχοις; ἐστύκαμεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1179.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1179.1.text#οὐ ταὐτὰ δόξει τοῖσι συμμάχοισι νῷν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1180.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1180.1.text#βινεῖν ἅπασιν;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1180.2.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1180.2.text#τοῖσι γῶν ναὶ τὼ σιὼ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1181.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1181.1.text#ἁμοῖσι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1181.2.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1181.2.text#καὶ γὰρ ναὶ μὰ Δία Καρυστίοις.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1182.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1182.1.text#καλῶς λέγετε. νῦν οὖν ὅπως ἁγνεύσετε,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1183.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1183.1.text#ὅπως ἂν αἱ γυναῖκες ὑμᾶς ἐν πόλει
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1184.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1184.1.text#ξενίσωμεν ὧν ἐν ταῖσι κίσταις εἴχομεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1185.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1185.1.text#ὅρκους δ' ἐκεῖ καὶ πίστιν ἀλλήλοις δότε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1186.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1186.1.text#κἄπειτα τὴν αὑτοῦ γυναῖχ' ὑμῶν λαβὼν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1187.1.speaker#Λυσιστράτη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1187.1.text#ἄπεισ' ἕκαστος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1187.2.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1187.2.text#ἀλλ' ἴωμεν ὡς τάχος.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1188.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1188.1.text#ἄγ' ὅπᾳ τυ λῇς.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1188.2.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1188.2.text#νὴ τὸν Δί' ὡς τάχιστ' ἄγε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1189.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1189.1.text#στρωμάτων δὲ ποικίλων καὶ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1190.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1190.1.text#χλανιδίων καὶ ξυστίδων καὶ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1191.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1191.1.text#χρυσίων, ὅσ' ἐστί μοι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1192.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1192.1.text#οὐ φθόνος ἔνεστί μοι πᾶσι παρέχειν φέρειν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1193.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1193.1.text#τοῖς παισίν, ὁπόταν τε θυγάτηρ τινὶ κανηφορῇ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1194.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1194.1.text#πᾶσιν ὑμῖν λέγω λαμβάνειν τῶν ἐμῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1195.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1195.1.text#χρημάτων νῦν ἔνδοθεν, καὶ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1196.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1196.1.text#μηδὲν οὕτως εὖ σεσημάν-
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1197.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1197.1.text#θαι τὸ μὴ οὐχὶ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1198.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1198.1.text#τοὺς ῥύπους ἀνασπάσαι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1199.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1199.1.text#χἄττ' ἂν ἔνδον ᾖ φορεῖν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1200.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1200.1.text#ὄψεται δ' οὐδὲν σκοπῶν, εἰ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1201.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1201.1.text#μή τις ὑμῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1202.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1202.1.text#ὀξύτερον ἐμοῦ βλέπει.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1203.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1203.1.text#εἰ δέ τῳ μὴ σῖτος ὑμῶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1204.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1204.1.text#ἔστι, βόσκει δ' οἰκέτας καὶ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1205.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1205.1.text#σμικρὰ πολλὰ παιδία,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1206.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1206.1.text#ἔστι παρ' ἐμοῦ λαβεῖν πυρίδια λεπτὰ μέν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1207.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1207.1.text#ὁ δ' ἄρτος ἀπὸ χοίνικος ἰδεῖν μάλα νεανίας.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1208.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1208.1.text#ὅστις οὖν βούλεται τῶν πενήτων ἴτω
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1209.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1209.1.text#εἰς ἐμοῦ σάκκους ἔχων καὶ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1210.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1210.1.text#κωρύκους, ὡς λήψεται πυ-
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1211.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1211.1.text#ρούς· ὁ Μανῆς δ'
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1212.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1212.1.text#οὑμὸς αὐτοῖς ἐμβαλεῖ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1213.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1213.1.text#πρός γε μέντοι τὴν θύραν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1214.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1214.1.text#προαγορεύω μὴ βαδίζειν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1215.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1215.1.text#τὴν ἐμήν, ἀλλ'
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1215a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1215a.1.text#εὐλαβεῖσθαι τὴν κύνα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1216.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1216.1.text#ἄνοιγε τὴν θύραν· παραχωρεῖν οὐ θέλεις;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1217.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1217.1.text#ὑμεῖς τί κάθησθε; μῶν ἐγὼ τῇ λαμπάδι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1218.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1218.1.text#ὑμᾶς κατακαύσω; φορτικὸν τὸ χωρίον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1219.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1219.1.text#οὐκ ἂν ποιήσαιμ'. εἰ δὲ πάνυ δεῖ τοῦτο δρᾶν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1220.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1220.1.text#ὑμῖν χαρίσασθαι, προσταλαιπωρήσομεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1221.1.speaker#Ἀθηναῖος Β
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1221.1.text#χἠμεῖς γε μετὰ σοῦ ξυνταλαιπωρήσομεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1222.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1222.1.text#οὐκ ἄπιτε; κωκύσεσθε τὰς τρίχας μακρά.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1223.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1223.1.text#οὐκ ἄπιθ', ὅπως ἂν οἱ Λάκωνες ἔνδοθεν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1224.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1224.1.text#καθ' ἡσυχίαν ἀπίωσιν εὐωχημένοι;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1225.1.speaker#Ἀθηναῖος Β.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1225.1.text#οὔπω τοιοῦτον συμπόσιον ὄπωπ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1226.1.speaker#Ἀθηναῖος Β.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1226.1.text#ἦ καὶ χαρίεντες ἦσαν οἱ Λακωνικοί·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1227.1.speaker#Ἀθηναῖος Β.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1227.1.text#ἡμεῖς δ' ἐν οἴνῳ συμπόται σοφώτατοι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1228.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1228.1.text#ὀρθῶς γ', ὁτιὴ νήφοντες οὐχ ὑγιαίνομεν·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1229.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1229.1.text#ἢν τοὺς Ἀθηναίους ἐγὼ πείσω λέγων,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1230.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1230.1.text#μεθύοντες ἀεὶ πανταχοῖ πρεσβεύσομεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1231.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1231.1.text#νῦν μὲν γὰρ ὅταν ἔλθωμεν ἐς Λακεδαίμονα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1232.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1232.1.text#νήφοντες, εὐθὺς βλέπομεν ὅ τι ταράξομεν·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1233.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1233.1.text#ὥσθ' ὅ τι μὲν ἂν λέγωσιν οὐκ ἀκούομεν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1234.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1234.1.text#ἃ δ' οὐ λέγουσι, ταῦθ' ὑπονενοήκαμεν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1235.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1235.1.text#ἀγγέλλομεν δ' οὐ ταὐτὰ τῶν αὐτῶν πέρι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1236.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1236.1.text#νυνὶ δ' ἅπαντ' ἤρεσκεν· ὥστ' εἰ μέν γέ τις
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1237.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1237.1.text#ᾄδοι Τελαμῶνος, Κλειταγόρας ᾄδειν δέον,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1238.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1238.1.text#ἐπῃνέσαμεν ἂν καὶ προσεπιωρκήσαμεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1239.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1239.1.text#ἀλλ' οὑτοιὶ γὰρ αὖθις ἔρχονται πάλιν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1240.1.speaker#Ἀθηναῖος Α.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1240.1.text#ἐς ταὐτόν. οὐκ ἐρρήσετ' ὦ μαστιγίαι;
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1241.1.speaker#Ἀθηναῖος Β.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1241.1.text#νὴ τὸν Δί' ὡς ἤδη γε χωροῦσ' ἔνδοθεν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1242.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1242.1.text#ὦ Πολυχαρείδα λαβὲ τὰ φυσατήρια,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1243.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1243.1.text#ἵν' ἐγὼ διποδιάξω τε κἀείσω καλὸν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1244.1.speaker#Λάκων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1244.1.text#ἐς τὼς Ἀσαναίως τε † καὶ ἐς ἡμᾶς ἅμα †.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1245.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1245.1.text#λαβὲ δῆτα τὰς φυσαλλίδας πρὸς τῶν θεῶν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1246.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1246.1.text#ὡς ἥδομαί γ' ὑμᾶς ὁρῶν ὀρχουμένους.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1247.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1247.1.text#ὅρμαον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1248.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1248.1.text#τὼς κυρσανίως ὦ Μναμοΰνα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1249.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1249.1.text#τάν τ' ἐμὰν Μῶαν, ἅτις
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1250.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1250.1.text#οἶδεν ἁμὲ τώς τ' Ἀσαναίως,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1251.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1251.1.text#ὅκα τοὶ μὲν ἐπ' Ἀρταμιτίῳ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1252.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1252.1.text#πρὤκροον σιοείκελοι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1253.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1253.1.text#ποττὰ κᾶλα τὼς Μήδως τ' ἐνίκων,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1254.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1254.1.text#ἁμὲ δ' αὖ Λεωνίδας
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1255.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1255.1.text#ἆγεν ᾇπερ τὼς κάπρως
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1256.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1256.1.text#θάγοντας οἰῶ τὸν ὀδόντα·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1257.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1257.1.text#πολὺς δ' ἀμφὶ τὰς γένυας ἀφρὸς † ἤνσει †,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1258.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1258.1.text#πολὺς δ' ἁμᾷ καττῶν σκελῶν ἀφρὸς ἵετο.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1260.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1260.1.text#ἦν γὰρ τὤνδρες οὐκ ἐλάσσως
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1261.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1261.1.text#τᾶς ψάμμας τοὶ Πέρσαι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1262.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1262.1.text#ἀγροτέρα σηροκτόνε
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1263.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1263.1.text#μόλε δεῦρο παρσένε σιὰ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1264.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1264.1.text#ποττὰς σπονδάς,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1265.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1265.1.text#ὡς συνέχῃς πολὺν ἁμὲ χρόνον.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1266.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1266.1.text#νῦν δ' αὖ φιλία τ' αἰὲς εὔπορος εἴη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1267.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1267.1.text#ταῖς συνθήκαις,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1268.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1268.1.text#καὶ τᾶν αἱμυλᾶν ἀλωπέκων παυσαίμεθα.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1269.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1269.1.text#ὢ δεῦρ' ἴθι δεῦρ' ὦ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1270.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1270.1.text#κυναγὲ παρσένε.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1273.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1273.1.text#ἄγε νυν ἐπειδὴ τἄλλα πεποίηται καλῶς,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1274.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1274.1.text#ἀπάγεσθε ταύτας ὦ Λάκωνες, τάσδε τε
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1275.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1275.1.text#ὑμεῖς· ἀνὴρ δὲ παρὰ γυναῖκα καὶ γυνὴ
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1276.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1276.1.text#στήτω παρ' ἄνδρα, κᾆτ' ἐπ' ἀγαθαῖς συμφοραῖς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1277.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1277.1.text#ὀρχησάμενοι θεοῖσιν εὐλαβώμεθα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1278.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1278.1.text#τὸ λοιπὸν αὖθις μὴ 'ξαμαρτάνειν ἔτι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1279.1.speaker#Χορὸς Ἀθηναίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1279.1.text#πρόσαγε χορόν, ἔπαγε δὲ Χάριτας,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1280.1.speaker#Χορὸς Ἀθηναίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1280.1.text#ἐπὶ δὲ κάλεσον Ἄρτεμιν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1281.1.speaker#Χορὸς Ἀθηναίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1281.1.text#ἐπὶ δὲ δίδυμον ἀγέχορον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1282.1.speaker#Χορὸς Ἀθηναίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1282.1.text#Ἰήιον
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1283.1.speaker#Χορὸς Ἀθηναίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1283.1.text#εὔφρον', ἐπὶ δὲ Νύσιον,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1284.1.speaker#Χορὸς Ἀθηναίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1284.1.text#ὃς μετὰ μαινάσι Βάκχιος ὄμμασι δαίεται,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1285.1.speaker#Χορὸς Ἀθηναίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1285.1.text#Δία τε πυρὶ φλεγόμενον, ἐπί τε
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1286.1.speaker#Χορὸς Ἀθηναίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1286.1.text#πότνιαν ἄλοχον ὀλβίαν·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1287.1.speaker#Χορὸς Ἀθηναίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1287.1.text#εἶτα δὲ δαίμονας, οἷς ἐπιμάρτυσι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1288.1.speaker#Χορὸς Ἀθηναίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1288.1.text#χρησόμεθ' οὐκ ἐπιλήσμοσιν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1289.1.speaker#Χορὸς Ἀθηναίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1289.1.text#Ἡσυχίας πέρι τῆς ἀγανόφρονος,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1290.1.speaker#Χορὸς Ἀθηναίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1290.1.text#ἣν ἐποίησε θεὰ Κύπρις.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1291.1.speaker#Χορὸς Ἀθηναίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1291.1.text#ἀλαλαὶ ἰὴ παιήων·
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1292.1.speaker#Χορὸς Ἀθηναίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1292.1.text#αἴρεσθ' ἄνω ἰαί,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1293.1.speaker#Χορὸς Ἀθηναίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1293.1.text#ὡς ἐπὶ νίκῃ ἰαί.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1294.1.speaker#Χορὸς Ἀθηναίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1294.1.text#εὐοῖ εὐοῖ, εὐαί εὐαί.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1295.1.speaker#Ἀθηναῖος
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1295.1.text#πρόφαινε δὴ σὺ Μοῦσαν ἐπὶ νέᾳ νέαν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1296.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1296.1.text#Ταΰγετον αὖτ' ἐραννὸν ἐκλιπῶα
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1297.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1297.1.text#Μῶα μόλε Λάκαινα πρεπτὸν ἁμὶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1298.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1298.1.text#κλέωα τὸν Ἀμύκλαις σιὸν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1300.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1300.1.text#καὶ χαλκίοικον Ἀσάναν,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1301.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1301.1.text#Τυνδαρίδας τ' ἀγασώς,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1302.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1302.1.text#τοὶ δὴ πὰρ Εὐρώταν ψιάδδοντι.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1303.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1303.1.text#εἶα μάλ' ἔμβη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1304.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1304.1.text#ὢ εἶα κοῦφα πάλλων,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1305.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1305.1.text#ὡς Σπάρταν ὑμνίωμες,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1306.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1306.1.text#τᾷ σιῶν χοροὶ μέλοντι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1307.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1307.1.text#καὶ ποδῶν κτύπος,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1308.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1308.1.text#ᾇ τε πῶλοι ταὶ κόραι
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1309.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1309.1.text#πὰρ τὸν Εὐρωταν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1310.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1310.1.text#ἀμπάλλοντι πυκνὰ ποδοῖν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1311.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1311.1.text#ἀγκονίωαι,
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1312.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1312.1.text#ταὶ δὲ κόμαι σείονθ' ᾇπερ Βακχᾶν
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1313.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1313.1.text#θυρσαδδωᾶν καὶ παιδδωᾶν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1314.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1314.1.text#ἁγεῖται δ' ἁ Λήδας παῖς
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1315.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1315.1.text#ἁγνὰ χοραγὸς εὐπρεπής.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1316.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1316.1.text#ἀλλ' ἄγε κόμαν παραμπύκιδδε χερί, ποδοῖν τε πάδη
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1319.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1319.1.text#ᾇ τις ἔλαφος· κρότον δ' ἁμᾷ ποίει χορωφελήταν.
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1320.1.speaker#Χορὸς Λακεδαιμονίων
urn:cts:greekLit:tlg0019.tlg007.fu.sp:1320.1.text#καὶ τὰν σιὰν δ' αὖ τὰν κρατίσταν Χαλκίοικον ὕμνει τὰν πάμμαχον.
</div> </div> </body>
</text>
</TEI>
