#!ctsdata
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1.1.text#θεοὺς μὲν αἰτῶ τῶνδ' ἀπαλλαγὴν πόνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:2.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:2.1.text#φρουρᾶς ἐτείας μῆκος, ἣν κοιμώμενος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:3.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:3.1.text#στέγαις Ἀτρειδῶν ἄγκαθεν, κυνὸς δίκην,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:4.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:4.1.text#ἄστρων κάτοιδα νυκτέρων ὁμήγυριν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:5.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:5.1.text#καὶ τοὺς φέροντας χεῖμα καὶ θέρος βροτοῖς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:6.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:6.1.text#λαμπροὺς δυνάστας, ἐμπρέποντας αἰθέρι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:7.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:7.1.text#[ ἀστέρας, ὅταν φθίνωσιν, ἀντολάς τε τῶν ].
urn:cts:greekLit:tlg0085.tlg005.fu.sp:8.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:8.1.text#καὶ νῦν φυλάσσω λαμπάδος τό σύμβολον,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:9.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:9.1.text#αὐγὴν πυρὸς φέρουσαν ἐκ Τροίας φάτιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:10.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:10.1.text#ἁλώσιμόν τε βάξιν· ὧδε γὰρ κρατεῖ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:11.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:11.1.text#γυναικὸς ἀνδρόβουλον ἐλπίζον κέαρ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:12.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:12.1.text#εὖτ' ἂν δὲ νυκτίπλαγκτον ἔνδροσόν τ' ἔχω
urn:cts:greekLit:tlg0085.tlg005.fu.sp:13.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:13.1.text#εὐνὴν ὀνείροις οὐκ ἐπισκοπουμένην
urn:cts:greekLit:tlg0085.tlg005.fu.sp:14.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:14.1.text#ἐμήν· φόβος γὰρ ἀνθ' ὕπνου παραστατεῖ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:15.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:15.1.text#τὸ μὴ βεβαίως βλέφαρα συμβαλεῖν ὕπνῳ·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:16.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:16.1.text#ὅταν δ' ἀείδειν ἢ μινύρεσθαι δοκῶ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:17.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:17.1.text#ὕπνου τόδ' ἀντίμολπον ἐντέμνων ἄκος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:18.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:18.1.text#κλαίω τότ' οἴκου τοῦδε συμφορὰν στένων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:19.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:19.1.text#οὐχ ὡς τὰ πρόσθ' ἄριστα διαπονουμένου.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:20.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:20.1.text#νῦν δ' εὐτυχὴς γένοιτ' ἀπαλλαγὴ πόνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:21.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:21.1.text#εὐαγγέλου φανέντος ὀρφναίου πυρός.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:22.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:22.1.text#ὦ χαῖρε λαμπτὴρ νυκτός, ἡμερήσιον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:23.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:23.1.text#φάος πιφαύσκων καὶ χορῶν κατάστασιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:24.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:24.1.text#πολλῶν ἐν Ἄργει, τῆσδε συμφορᾶς χάριν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:25.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:25.1.text#ἰοὺ ἰού.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:26.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:26.1.text#Ἀγαμέμνονος γυναικὶ σημαίνω τορῶς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:27.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:27.1.text#εὐνῆς ἐπαντείλασαν ὡς τάχος δόμοις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:28.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:28.1.text#ὀλολυγμὸν εὐφημοῦντα τῇδε λαμπάδι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:29.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:29.1.text#ἐπορθιάζειν, εἴπερ Ἰλίου πόλις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:30.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:30.1.text#ἑάλωκεν, ὡς ὁ φρυκτὸς ἀγγέλλων πρέπει·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:31.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:31.1.text#αὐτός τ' ἔγωγε φροίμιον χορεύσομαι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:32.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:32.1.text#τὰ δεσποτῶν γὰρ εὖ πεσόντα θήσομαι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:33.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:33.1.text#τρὶς ἓξ βαλούσης τῆσδέ μοι φρυκτωρίας.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:34.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:34.1.text#γένοιτο δ' οὖν μολόντος εὐφιλῆ χέρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:35.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:35.1.text#ἄνακτος οἴκων τῇδε βαστάσαι χερί.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:36.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:36.1.text#τὰ δ' ἄλλα σιγῶ· βοῦς ἐπὶ γλώσσῃ μέγας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:37.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:37.1.text#βέβηκεν· οἶκος δ' αὐτός, εἰ φθογγὴν λάβοι,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:38.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:38.1.text#σαφέστατ' ἂν λέξειεν· ὡς ἑκὼν ἐγὼ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:39.1.speaker#Φύλαξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:39.1.text#μαθοῦσιν αὐδῶ κοὐ μαθοῦσι λήθομαι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:40.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:40.1.text#δέκατον μὲν ἔτος τόδ' ἐπεὶ Πριάμου
urn:cts:greekLit:tlg0085.tlg005.fu.sp:41.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:41.1.text#μέγας ἀντίδικος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:42.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:42.1.text#Μενέλαος ἄναξ ἠδ' Ἀγαμέμνων,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:43.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:43.1.text#διθρόνου Διόθεν καὶ δισκήπτρου
urn:cts:greekLit:tlg0085.tlg005.fu.sp:44.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:44.1.text#τιμῆς ὀχυρὸν ζεῦγος Ἀτρειδᾶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:45.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:45.1.text#στόλον Ἀργείων χιλιοναύτην,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:46.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:46.1.text#τῆσδ' ἀπὸ χώρας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:47.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:47.1.text#ἦραν, στρατιῶτιν ἀρωγὰν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:48.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:48.1.text#μέγαν ἐκ θυμοῦ κλάζοντες Ἄρη
urn:cts:greekLit:tlg0085.tlg005.fu.sp:49.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:49.1.text#τρόπον αἰγυπιῶν, οἵτ' ἐκπατίοις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:50.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:50.1.text#ἄλγεσι παίδων ὕπατοι λεχέων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:51.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:51.1.text#στροφοδινοῦνται
urn:cts:greekLit:tlg0085.tlg005.fu.sp:52.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:52.1.text#πτερύγων ἐρετμοῖσιν ἐρεσσόμενοι,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:53.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:53.1.text#δεμνιοτήρη
urn:cts:greekLit:tlg0085.tlg005.fu.sp:54.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:54.1.text#πόνον ὀρταλίχων ὀλέσαντες·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:55.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:55.1.text#ὕπατος δ' ἀίων ἤ τις Ἀπόλλων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:56.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:56.1.text#ἢ Πὰν ἢ Ζεὺς οἰωνόθροον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:57.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:57.1.text#γόον ὀξυβόαν τῶνδε μετοίκων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:58.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:58.1.text#ὑστερόποινον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:59.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:59.1.text#πέμπει παραβᾶσιν Ἐρινύν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:60.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:60.1.text#οὕτω δ' Ἀτρέως παῖδας ὁ κρείσσων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:61.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:61.1.text#ἐπ' Ἀλεξάνδρῳ πέμπει ξένιος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:62.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:62.1.text#Ζεὺς πολυάνορος ἀμφὶ γυναικὸς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:63.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:63.1.text#πολλὰ παλαίσματα καὶ γυιοβαρῆ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:64.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:64.1.text#γόνατος κονίαισιν ἐρειδομένου
urn:cts:greekLit:tlg0085.tlg005.fu.sp:65.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:65.1.text#διακναιομένης τ' ἐν προτελείοις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:66.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:66.1.text#κάμακος θήσων Δαναοῖσι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:67.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:67.1.text#Τρωσί θ' ὁμοίως. ἔστι δ' ὅπη νῦν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:68.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:68.1.text#ἔστι· τελεῖται δ' ἐς τὸ πεπρωμένον·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:69.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:69.1.text#οὔθ' ὑποκαίων οὔθ' ὑπολείβων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:70.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:70.1.text#οὔτε δακρύων ἀπύρων ἱερῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:71.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:71.1.text#ὀργὰς ἀτενεῖς παραθέλξει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:72.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:72.1.text#ἡμεῖς δ' ἀτίται σαρκὶ παλαιᾷ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:73.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:73.1.text#τῆς τότ' ἀρωγῆς ὑπολειφθέντες
urn:cts:greekLit:tlg0085.tlg005.fu.sp:74.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:74.1.text#μίμνομεν ἰσχὺν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:75.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:75.1.text#ἰσόπαιδα νέμοντες ἐπὶ σκήπτροις.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:76.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:76.1.text#ὅ τε γὰρ νεαρὸς μυελὸς στέρνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:77.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:77.1.text#ἐντὸς ἀνᾴσσων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:78.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:78.1.text#ἰσόπρεσβυς, Ἄρης δ' οὐκ ἔνι χώρᾳ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:79.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:79.1.text#τό θ' ὑπέργηρων φυλλάδος ἤδη
urn:cts:greekLit:tlg0085.tlg005.fu.sp:80.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:80.1.text#κατακαρφομένης τρίποδας μὲν ὁδοὺς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:81.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:81.1.text#στείχει, παιδὸς δ' οὐδὲν ἀρείων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:82.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:82.1.text#ὄναρ ἡμερόφαντον ἀλαίνει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:83.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:83.1.text#σὺ δέ, Τυνδάρεω
urn:cts:greekLit:tlg0085.tlg005.fu.sp:84.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:84.1.text#θύγατερ, βασίλεια Κλυταιμήστρα,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:85.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:85.1.text#τί χρέος; τί νέον; τί δ' ἐπαισθομένη,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:86.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:86.1.text#τίνος ἀγγελίας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:87.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:87.1.text#πειθοῖ περίπεμπτα θυοσκεῖς;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:88.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:88.1.text#πάντων δὲ θεῶν τῶν ἀστυνόμων,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:89.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:89.1.text#ὑπάτων, χθονίων,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:90.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:90.1.text#τῶν τ' οὐρανίων τῶν τ' ἀγοραίων,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:91.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:91.1.text#βωμοὶ δώροισι φλέγονται·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:92.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:92.1.text#ἄλλη δ' ἄλλοθεν οὐρανομήκης
urn:cts:greekLit:tlg0085.tlg005.fu.sp:93.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:93.1.text#λαμπὰς ἀνίσχει,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:94.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:94.1.text#φαρμασσομένη χρίματος ἁγνοῦ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:95.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:95.1.text#μαλακαῖς ἀδόλοισι παρηγορίαις,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:96.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:96.1.text#πελάνῳ μυχόθεν βασιλείῳ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:97.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:97.1.text#τούτων λέξασ' ὅ τι καὶ δυνατὸν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:98.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:98.1.text#καὶ θέμις αἰνεῖν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:99.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:99.1.text#παιών τε γενοῦ τῆσδε μερίμνης,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:100.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:100.1.text#ἣ νῦν τοτὲ μὲν κακόφρων τελέθει,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:101.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:101.1.text#τοτὲ δ' ἐκ θυσιῶν ἀγανὴ φαίνουσ'
urn:cts:greekLit:tlg0085.tlg005.fu.sp:102.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:102.1.text#ἐλπὶς ἀμύνει φροντίδ' ἄπληστον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:103.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:103.1.text#τῆς θυμοβόρου φρένα λύπης.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:104.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:104.1.text#κύριός εἰμι θροεῖν ὅδιον κράτος αἴσιον ἀνδρῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:105.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:105.1.text#ἐκτελέων· ἔτι γὰρ θεόθεν καταπνεύει
urn:cts:greekLit:tlg0085.tlg005.fu.sp:106.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:106.1.text#πειθὼ μολπᾶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:107.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:107.1.text#ἀλκὰν σύμφυτος αἰών·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:108.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:108.1.text#ὅπως Ἀχαι-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:109.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:109.1.text#ῶν δίθρονον κράτος, Ἑλλάδος ἥβας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:110.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:110.1.text#ξύμφρονα ταγάν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:111.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:111.1.text#πέμπει σὺν δορὶ καὶ χερὶ πράκτορι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:112.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:112.1.text#θούριος ὄρνις Τευκρίδ' ἐπ' αἶαν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:113.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:113.1.text#οἰωνῶν βασιλεὺς βασιλεῦσι νε-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:115.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:115.1.text#ῶν ὁ κελαινός, ὅ τ' ἐξόπιν ἀργᾶς,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:116.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:116.1.text#φανέντες ἴ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:117.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:117.1.text#κταρ μελάθρων χερὸς ἐκ δοριπάλτου
urn:cts:greekLit:tlg0085.tlg005.fu.sp:118.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:118.1.text#παμπρέπτοις ἐν ἕδραισιν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:119.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:119.1.text#βοσκόμενοι λαγίναν, ἐρικύμονα φέρματι γένναν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:120.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:120.1.text#βλαβέντα λοισθίων δρόμων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:121.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:121.1.text#αἴλινον αἴλινον εἰπέ, τὸ δ' εὖ νικάτω.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:122.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:122.1.text#κεδνὸς δὲ στρατόμαντις ἰδὼν δύο λήμασι δισσοὺς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:123.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:123.1.text#Ἀτρεΐδας μαχίμους ἐδάη λαγοδαίτας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:124.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:124.1.text#πομπούς τ' ἀρχάς·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:125.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:125.1.text#οὕτω δ' εἶπε τερᾴζων·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:126.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:126.1.text#"χρόνῳ μὲν ἀγρεῖ"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:127.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:127.1.text#"Πριάμου πόλιν ἅδε κέλευθος,"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:128.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:128.1.text#"πάντα δὲ πύργων"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:129.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:129.1.text#"κτήνη πρόσθε τὰ δημιοπληθῆ"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:130.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:130.1.text#"Μοῖρ' ἀλαπάξει πρὸς τὸ βίαιον·"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:131.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:131.1.text#"οἶον μή τις ἄγα θεόθεν κνεφά-"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:132.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:132.1.text#"σῃ προτυπὲν στόμιον μέγα Τροίας"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:133.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:133.1.text#"στρατωθέν.οἴκτῳ γὰρ ἐπί-"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:135.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:135.1.text#"φθονος Ἄρτεμις ἁγνὰ"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:136.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:136.1.text#"πτανοῖσιν κυσὶ πατρὸς"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:137.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:137.1.text#"αὐτότοκον πρὸ λόχου μογερὰν πτάκα θυομένοισιν"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:138.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:138.1.text#"στυγεῖ δὲ δεῖπνον αἰετῶν."
urn:cts:greekLit:tlg0085.tlg005.fu.sp:139.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:139.1.text#αἴλινον αἴλινον εἰπέ, τὸ δ' εὖ νικάτω.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:140.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:140.1.text#"τόσον περ εὔφρων, καλά,"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:141.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:141.1.text#"δρόσοισι λεπτοῖς μαλερῶν λεόντων"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:142.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:142.1.text#"πάντων τ' ἀγρονόμων φιλομάστοις"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:143.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:143.1.text#"θηρῶν ὀβρικάλοισι τερπνά,"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:144.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:144.1.text#"τούτων αἴνει ξύμβολα κρᾶναι,"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:145.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:145.1.text#"δεξιὰ μέν, κατάμομφα δὲ φάσματα [ στρουθῶν ]."
urn:cts:greekLit:tlg0085.tlg005.fu.sp:146.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:146.1.text#"ἰήιον δὲ καλέω Παιᾶνα,"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:147.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:147.1.text#"μή τινας ἀντιπνόους Δανα-"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:148.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:148.1.text#"οῖς χρονίας ἐχενῇδας ἀ-"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:150.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:150.1.text#"πλοίας τεύξῃ,"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:151.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:151.1.text#"σπευδομένα θυσίαν ἑτέραν ἄνομόν τιν', ἄδαιτον"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:152.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:152.1.text#"νεικέων τέκτονα σύμφυτον,"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:153.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:153.1.text#"οὐ δεισήνορα. μίμνει γὰρ φοβερὰ παλίνορτος"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:155.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:155.1.text#"οἰκονόμος δολία μνάμων μῆνις τεκνόποινος."
urn:cts:greekLit:tlg0085.tlg005.fu.sp:156.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:156.1.text#τοιάδε Κάλχας ξὺν μεγάλοις ἀγαθοῖς ἀπέκλαγξεν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:157.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:157.1.text#μόρσιμ' ἀπ' ὀρνίθων ὁδίων οἴκοις βασιλείοις·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:158.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:158.1.text#τοῖς δ' ὁμόφωνον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:159.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:159.1.text#αἴλινον αἴλινον εἰπέ, τὸ δ' εὖ νικάτω.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:160.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:160.1.text#Ζεύς, ὅστις ποτ' ἐστίν, εἰ τόδ' αὐ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:161.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:161.1.text#τῷ φίλον κεκλημένῳ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:162.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:162.1.text#τοῦτό νιν προσεννέπω.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:163.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:163.1.text#οὐκ ἔχω προσεικάσαι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:164.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:164.1.text#πάντ' ἐπισταθμώμενος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:165.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:165.1.text#πλὴν Διός, εἰ τὸ μάταν ἀπὸ φροντίδος ἄχθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:166.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:166.1.text#χρὴ βαλεῖν ἐτητύμως.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:167.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:167.1.text#οὐδ' ὅστις πάροιθεν ἦν μέγας,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:168.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:168.1.text#παμμάχῳ θράσει βρύων,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:170.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:170.1.text#οὐδὲ λέξεται πρὶν ὤν·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:171.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:171.1.text#ὃς δ' ἔπειτ' ἔφυ, τρια-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:172.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:172.1.text#κτῆρος οἴχεται τυχών.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:173.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:173.1.text#Ζῆνα δέ τις προφρόνως ἐπινίκια κλάζων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:175.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:175.1.text#τεύξεται φρενῶν τὸ πᾶν·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:176.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:176.1.text#τὸν φρονεῖν βροτοὺς ὁδώ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:177.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:177.1.text#σαντα, τὸν πάθει μάθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:178.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:178.1.text#θέντα κυρίως ἔχειν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:179.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:179.1.text#στάζει δ' ἔν θ' ὕπνῳ πρὸ καρδίας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:180.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:180.1.text#μνησιπήμων πόνος· καὶ παρ' ἄ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:181.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:181.1.text#κοντας ἦλθε σωφρονεῖν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:182.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:182.1.text#δαιμόνων δέ που χάρις βίαιος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:183.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:183.1.text#σέλμα σεμνὸν ἡμένων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:184.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:184.1.text#καὶ τόθ' ἡγεμὼν ὁ πρέ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:185.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:185.1.text#σβυς νεῶν Ἀχαιικῶν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:186.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:186.1.text#μάντιν οὔτινα ψέγων,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:187.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:187.1.text#ἐμπαίοις τύχαισι συμπνέων,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:188.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:188.1.text#εὖτ' ἀπλοίᾳ κεναγγεῖ βαρύ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:189.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:189.1.text#νοντ' Ἀχαιικὸς λεώς,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:190.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:190.1.text#Χαλκίδος πέραν ἔχων παλιρρόχ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:191.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:191.1.text#θοις ἐν Αὐλίδος τόποις·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:192.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:192.1.text#πνοαὶ δ' ἀπὸ Στρυμόνος μολοῦσαι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:193.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:193.1.text#κακόσχολοι νήστιδες δύσορμοι,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:194.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:194.1.text#βροτῶν ἄλαι, ναῶν { τε } καὶ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:195.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:195.1.text#πεισμάτων ἀφειδεῖς,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:196.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:196.1.text#παλιμμήκη χρόνον τιθεῖσαι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:197.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:197.1.text#τρίβῳ κατέξαινον ἄν-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:198.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:198.1.text#θος Ἀργείων· ἐπεὶ δὲ καὶ πικροῦ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:199.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:199.1.text#χείματος ἄλλο μῆχαρ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:200.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:200.1.text#βριθύτερον πρόμοισιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:201.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:201.1.text#μάντις ἔκλαγξεν προφέρων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:202.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:202.1.text#Ἄρτεμιν, ὥστε χθόνα βάκ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:203.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:203.1.text#τροις ἐπικρούσαντας Ἀτρεί-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:204.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:204.1.text#δας δάκρυ μὴ κατασχεῖν·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:205.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:205.1.text#ἄναξ δ' ὁ πρέσβυς τότ' εἶπε φωνῶν·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:206.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:206.1.text#"βαρεῖα μὲν κὴρ τὸ μὴ πιθέσθαι,"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:207.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:207.1.text#"βαρεῖα δ', εἰ τέκνον δαΐ-"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:208.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:208.1.text#"ξω, δόμων ἄγαλμα,"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:209.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:209.1.text#"μιαίνων παρθενοσφάγοισιν"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:210.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:210.1.text#"ῥείθροις πατρῴους χέρας"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:211.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:211.1.text#"πέλας βωμοῦ· τί τῶνδ' ἄνευ κακῶν,"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:212.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:212.1.text#"πῶς λιπόναυς γένωμαι"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:213.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:213.1.text#"ξυμμαχίας ἁμαρτών;"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:214.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:214.1.text#"παυσανέμου γὰρ θυσίας"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:215.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:215.1.text#"παρθενίου θ' αἵματος ὀρ-"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:216.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:216.1.text#"γᾷ περιόργως ἐπιθυ-"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:217.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:217.1.text#"μεῖν θέμις. εὖ γὰρ εἴη."
urn:cts:greekLit:tlg0085.tlg005.fu.sp:218.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:218.1.text#ἐπεὶ δ' ἀνάγκας ἔδυ λέπαδνον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:219.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:219.1.text#φρενὸς πνέων δυσσεβῆ τροπαίαν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:220.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:220.1.text#ἄναγνον ἀνίερον, τόθεν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:221.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:221.1.text#τὸ παντότολμον φρονεῖν μετέγνω.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:222.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:222.1.text#βροτοὺς θρασύνει γὰρ αἰσχρόμητις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:223.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:223.1.text#τάλαινα παρακοπὰ πρωτοπήμων. ἔτλα δ' οὖν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:225.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:225.1.text#θυτὴρ γενέσθαι θυγατρός,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:226.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:226.1.text#γυναικοποίνων πολέμων ἀρωγὰν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:227.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:227.1.text#καὶ προτέλεια ναῶν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:228.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:228.1.text#λιτὰς δὲ καὶ κληδόνας πατρῴους
urn:cts:greekLit:tlg0085.tlg005.fu.sp:229.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:229.1.text#παρ' οὐδὲν αἰῶ τε παρθένειον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:230.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:230.1.text#ἔθεντο φιλόμαχοι βραβῆς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:231.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:231.1.text#φράσεν δ' ἀόζοις πατὴρ μετ' εὐχὰν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:232.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:232.1.text#δίκαν χιμαίρας ὕπερθε βωμοῦ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:233.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:233.1.text#πέπλοισι περιπετῆ παντὶ θυμῷ προνωπῆ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:235.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:235.1.text#λαβεῖν ἀέρδην, στόματός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:236.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:236.1.text#τε καλλιπρῴρου φυλακᾷ κατασχεῖν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:237.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:237.1.text#φθόγγον ἀραῖον οἴκοις,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:238.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:238.1.text#βίᾳ χαλινῶν τ' ἀναύδῳ μένει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:239.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:239.1.text#κρόκου βαφὰς δ' ἐς πέδον χέουσα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:240.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:240.1.text#ἔβαλλ' ἕκαστον θυτήρ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:241.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:241.1.text#ων ἀπ' ὄμματος βέλει
urn:cts:greekLit:tlg0085.tlg005.fu.sp:242.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:242.1.text#φιλοίκτῳ, πρέπουσά θ' ὡς ἐν γραφαῖς, προσεννέπειν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:243.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:243.1.text#θέλουσ', ἐπεὶ πολλάκις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:244.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:244.1.text#πατρὸς κατ' ἀνδρῶνας εὐτραπέζους
urn:cts:greekLit:tlg0085.tlg005.fu.sp:245.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:245.1.text#ἔμελψεν, ἁγνᾷ δ' ἀταύρωτος αὐδᾷ πατρὸς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:246.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:246.1.text#φίλου τριτόσπονδον εὔ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:247.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:247.1.text#ποτμον παιῶνα φίλως ἐτίμα—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:248.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:248.1.text#τὰ δ' ἔνθεν οὔτ' εἶδον οὔτ' ἐννέπω·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:249.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:249.1.text#τέχναι δὲ Κάλχαντος οὐκ ἄκραντοι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:250.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:250.1.text#Δίκα δὲ τοῖς μὲν παθοῦσ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:251.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:251.1.text#ιν μαθεῖν ἐπιρρέπει·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:252.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:252.1.text#τὸ μέλλον { δ' }, ἐπεὶ γένοιτ', ἂν κλύοις· πρὸ χαιρέτω·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:253.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:253.1.text#ἴσον δὲ τῷ προστένειν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:254.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:254.1.text#τορὸν γὰρ ἥξει σύνορθρον αὐγαῖς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:255.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:255.1.text#πέλοιτο δ' οὖν τἀπὶ τούτοισιν εὖ πρᾶξις, ὡς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:256.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:256.1.text#θέλει τόδ' ἄγχιστον Ἀ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:257.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:257.1.text#πίας γαίας μονόφρουρον ἕρκος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:258.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:258.1.text#ἥκω σεβίζων σόν, Κλυταιμήστρα, κράτος·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:259.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:259.1.text#δίκη γάρ ἐστι φωτὸς ἀρχηγοῦ τίειν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:260.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:260.1.text#γυναῖκ' ἐρημωθέντος ἄρσενος θρόνου.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:261.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:261.1.text#σὺ δ' εἴ τι κεδνὸν εἴτε μὴ πεπυσμένη
urn:cts:greekLit:tlg0085.tlg005.fu.sp:262.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:262.1.text#εὐαγγέλοισιν ἐλπίσιν θυηπολεῖς,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:263.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:263.1.text#κλύοιμ' ἂν εὔφρων· οὐδὲ σιγώσῃ φθόνος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:264.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:264.1.text#εὐάγγελος μέν, ὥσπερ ἡ παροιμία,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:265.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:265.1.text#ἕως γένοιτο μητρὸς εὐφρόνης πάρα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:266.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:266.1.text#πεύσῃ δὲ χάρμα μεῖζον ἐλπίδος κλύειν·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:267.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:267.1.text#Πριάμου γὰρ ᾑρήκασιν Ἀργεῖοι πόλιν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:268.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:268.1.text#πῶς φής; πέφευγε τοὔπος ἐξ ἀπιστίας.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:269.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:269.1.text#Τροίαν Ἀχαιῶν οὖσαν· ἦ τορῶς λέγω;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:270.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:270.1.text#χαρά μ' ὑφέρπει δάκρυον ἐκκαλουμένη.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:271.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:271.1.text#εὖ γὰρ φρονοῦντος ὄμμα σοῦ κατηγορεῖ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:272.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:272.1.text#τί γὰρ τὸ πιστόν; ἔστι τῶνδέ σοι τέκμαρ;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:273.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:273.1.text#ἔστιν· τί δ' οὐχί; μὴ δολώσαντος θεοῦ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:274.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:274.1.text#πότερα δ' ὀνείρων φάσματ' εὐπιθῆ σέβεις;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:275.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:275.1.text#οὐ δόξαν ἂν λάβοιμι βριζούσης φρενός.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:276.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:276.1.text#ἀλλ' ἦ σ' ἐπίανέν τις ἄπτερος φάτις;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:277.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:277.1.text#παιδὸς νέας ὣς κάρτ' ἐμωμήσω φρένας.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:278.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:278.1.text#ποίου χρόνου δὲ καὶ πεπόρθηται πόλις;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:279.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:279.1.text#τῆς νῦν τεκούσης φῶς τόδ' εὐφρόνης λέγω.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:280.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:280.1.text#καὶ τίς τόδ' ἐξίκοιτ' ἂν ἀγγέλων τάχος;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:281.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:281.1.text#Ἥφαιστος Ἴδης λαμπρὸν ἐκπέμπων σέλας.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:282.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:282.1.text#φρυκτὸς δὲ φρυκτὸν δεῦρ' ἀπ' ἀγγάρου πυρὸς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:283.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:283.1.text#ἔπεμπεν· Ἴδη μὲν πρὸς Ἑρμαῖον λέπας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:284.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:284.1.text#Λήμνου· μέγαν δὲ πανὸν ἐκ νήσου τρίτον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:285.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:285.1.text#Ἀθῷον αἶπος Ζηνὸς ἐξεδέξατο,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:286.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:286.1.text#ὑπερτελής τε, πόντον ὥστε νωτίσαι,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:287.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:287.1.text#ἰσχὺς πορευτοῦ λαμπάδος πρὸς ἡδονὴν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:288.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:288.1.text#[ … ] { πεύκη } τὸ χρυσοφεγγές, ὥς τις ἥλιος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:289.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:289.1.text#σέλας παραγγείλασα Μακίστου σκοπαῖς·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:290.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:290.1.text#ὁ δ' οὔτι μέλλων οὐδ' ἀφρασμόνως ὕπνῳ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:291.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:291.1.text#νικώμενος παρῆκεν ἀγγέλου μέρος·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:292.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:292.1.text#ἑκὰς δὲ φρυκτοῦ φῶς ἐπ' Εὐρίπου ῥοὰς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:293.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:293.1.text#Μεσσαπίου φύλαξι σημαίνει μολόν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:294.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:294.1.text#οἱ δ' ἀντέλαμψαν καὶ παρήγγειλαν πρόσω
urn:cts:greekLit:tlg0085.tlg005.fu.sp:295.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:295.1.text#γραίας ἐρείκης θωμὸν ἅψαντες πυρί.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:296.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:296.1.text#σθένουσα λαμπὰς δ' οὐδέπω μαυρουμένη,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:297.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:297.1.text#ὑπερθοροῦσα πεδίον Ἀσωποῦ, δίκην
urn:cts:greekLit:tlg0085.tlg005.fu.sp:298.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:298.1.text#φαιδρᾶς σελήνης, πρὸς Κιθαιρῶνος λέπας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:299.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:299.1.text#ἤγειρεν ἄλλην ἐκδοχὴν πομποῦ πυρός.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:300.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:300.1.text#φάος δὲ τηλέπομπον οὐκ ἠναίνετο
urn:cts:greekLit:tlg0085.tlg005.fu.sp:301.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:301.1.text#φρουρὰ πλέον καίουσα τῶν εἰρημένων·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:302.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:302.1.text#λίμνην δ' ὑπὲρ Γοργῶπιν ἔσκηψεν φάος·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:303.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:303.1.text#ὄρος τ' ἐπ' Αἰγίπλαγκτον ἐξικνούμενον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:304.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:304.1.text#ὤτρυνε θεσμὸν μὴ χρονίζεσθαι πυρός.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:305.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:305.1.text#πέμπουσι δ' ἀνδαίοντες ἀφθόνῳ μένει
urn:cts:greekLit:tlg0085.tlg005.fu.sp:306.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:306.1.text#φλογὸς μέγαν πώγωνα, καὶ Σαρωνικοῦ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:307.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:307.1.text#πορθμοῦ κάτοπτον πρῶν' ὑπερβάλλειν πρόσω
urn:cts:greekLit:tlg0085.tlg005.fu.sp:308.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:308.1.text#φλέγουσαν· ἔστ' ἔσκηψεν εὖτ' ἀφίκετο
urn:cts:greekLit:tlg0085.tlg005.fu.sp:309.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:309.1.text#Ἀραχναῖον αἶπος, ἀστυγείτονας σκοπάς·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:310.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:310.1.text#κἄπειτ' Ἀτρειδῶν ἐς τόδε σκήπτει στέγος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:311.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:311.1.text#φάος τόδ' οὐκ ἄπαππον Ἰδαίου πυρός.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:312.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:312.1.text#τοιοίδε τοί μοι λαμπαδηφόρων νόμοι,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:313.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:313.1.text#ἄλλος παρ' ἄλλου διαδοχαῖς πληρούμενοι·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:314.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:314.1.text#νικᾷ δ' ὁ πρῶτος καὶ τελευταῖος δραμών.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:315.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:315.1.text#τέκμαρ τοιοῦτον σύμβολόν τέ σοι λέγω
urn:cts:greekLit:tlg0085.tlg005.fu.sp:316.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:316.1.text#ἀνδρὸς παραγγείλαντος ἐκ Τροίας ἐμοί.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:317.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:317.1.text#θεοῖς μὲν αὖθις, ὦ γύναι, προσεύξομαι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:318.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:318.1.text#λόγους δ' ἀκοῦσαι τούσδε κἀποθαυμάσαι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:319.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:319.1.text#διηνεκῶς θέλοιμ' ἂν ὡς λέγοις πάλιν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:320.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:320.1.text#Τροίαν Ἀχαιοὶ τῇδ' ἔχουσ' ἐν ἡμέρᾳ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:321.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:321.1.text#οἶμαι βοὴν ἄμεικτον ἐν πόλει πρέπειν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:322.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:322.1.text#ὄξος τ' ἄλειφά τ' ἐγχέας ταὐτῷ κύτει
urn:cts:greekLit:tlg0085.tlg005.fu.sp:323.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:323.1.text#διχοστατοῦντ' ἄν, οὐ φίλω, προσεννέποις.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:324.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:324.1.text#καὶ τῶν ἁλόντων καὶ κρατησάντων δίχα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:325.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:325.1.text#φθογγὰς ἀκούειν ἔστι συμφορᾶς διπλῆς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:326.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:326.1.text#οἱ μὲν γὰρ ἀμφὶ σώμασιν πεπτωκότες
urn:cts:greekLit:tlg0085.tlg005.fu.sp:327.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:327.1.text#ἀνδρῶν κασιγνήτων τε καὶ φυταλμίων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:328.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:328.1.text#παῖδες γερόντων οὐκέτ' ἐξ ἐλευθέρου
urn:cts:greekLit:tlg0085.tlg005.fu.sp:329.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:329.1.text#δέρης ἀποιμώζουσι φιλτάτων μόρον·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:330.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:330.1.text#τοὺς δ' αὖτε νυκτίπλαγκτος ἐκ μάχης πόνος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:331.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:331.1.text#νήστεις πρὸς ἀρίστοισιν ὧν ἔχει πόλις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:332.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:332.1.text#τάσσει, πρὸς οὐδὲν ἐν μέρει τεκμήριον,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:333.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:333.1.text#ἀλλ' ὡς ἕκαστος ἔσπασεν τύχης πάλον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:334.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:334.1.text#ἐν { δ' } αἰχμαλώτοις Τρωικοῖς οἰκήμασιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:335.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:335.1.text#ναίουσιν ἤδη, τῶν ὑπαιθρίων πάγων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:336.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:336.1.text#δρόσων τ' ἀπαλλαγέντες, ὡς δ' εὐδαίμονες
urn:cts:greekLit:tlg0085.tlg005.fu.sp:337.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:337.1.text#ἀφύλακτον εὑδήσουσι πᾶσαν εὐφρόνην.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:338.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:338.1.text#εἰ δ' εὖ σέβουσι τοὺς πολισσούχους θεοὺς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:339.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:339.1.text#τοὺς τῆς ἁλούσης γῆς θεῶν θ' ἱδρύματα,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:340.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:340.1.text#οὔ τἂν ἑλόντες αὖθις ἀνθαλοῖεν ἄν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:341.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:341.1.text#ἔρως δὲ μή τις πρότερον ἐμπίπτῃ στρατῷ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:342.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:342.1.text#πορθεῖν ἃ μὴ χρή, κέρδεσιν νικωμένους.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:343.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:343.1.text#δεῖ γὰρ πρὸς οἴκους νοστίμου σωτηρίας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:344.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:344.1.text#κάμψαι διαύλου θάτερον κῶλον πάλιν·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:345.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:345.1.text#θεοῖς δ' ἀναμπλάκητος εἰ μόλοι στρατός,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:346.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:346.1.text#ἐγρηγορὸς τὸ πῆμα τῶν ὀλωλότων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:347.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:347.1.text#γένοιτ' ἄν, εἰ πρόσπαια μὴ τύχοι κακά.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:348.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:348.1.text#τοιαῦτά τοι γυναικὸς ἐξ ἐμοῦ κλύεις·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:349.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:349.1.text#τὸ δ' εὖ κρατοίη μὴ διχορρόπως ἰδεῖν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:350.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:350.1.text#πολλῶν γὰρ ἐσθλῶν τήνδ' ὄνησιν εἱλόμην.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:351.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:351.1.text#γύναι, κατ' ἄνδρα σώφρον' εὐφρόνως λέγεις.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:352.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:352.1.text#ἐγὼ δ' ἀκούσας πιστά σου τεκμήρια
urn:cts:greekLit:tlg0085.tlg005.fu.sp:353.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:353.1.text#θεοὺς προσειπεῖν εὖ παρασκευάζομαι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:354.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:354.1.text#χάρις γὰρ οὐκ ἄτιμος εἴργασται πόνων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:355.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:355.1.text#ὦ Ζεῦ βασιλεῦ καὶ νὺξ φιλία
urn:cts:greekLit:tlg0085.tlg005.fu.sp:356.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:356.1.text#μεγάλων κόσμων κτεάτειρα,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:357.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:357.1.text#ἥτ' ἐπὶ Τροίας πύργοις ἔβαλες
urn:cts:greekLit:tlg0085.tlg005.fu.sp:358.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:358.1.text#στεγανὸν δίκτυον, ὡς μήτε μέγαν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:359.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:359.1.text#μήτ' οὖν νεαρῶν τιν' ὑπερτελέσαι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:360.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:360.1.text#μέγα δουλείας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:361.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:361.1.text#γάγγαμον, ἄτης παναλώτου.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:362.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:362.1.text#Δία τοι ξένιον μέγαν αἰδοῦμαι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:363.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:363.1.text#τὸν τάδε πράξαντ' ἐπ' Ἀλεξάνδρῳ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:364.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:364.1.text#τείνοντα πάλαι τόξον, ὅπως ἂν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:365.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:365.1.text#μήτε πρὸ καιροῦ μήθ' ὑπὲρ ἄστρων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:366.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:366.1.text#βέλος ἠλίθιον σκήψειεν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:367.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:367.1.text#Διὸς πλαγὰν ἔχουσιν εἰπεῖν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:368.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:368.1.text#πάρεστιν τοῦτό γ' ἐξιχνεῦσαι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:369.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:369.1.text#[ ὡς ] ἔπραξεν ὡς ἔκρανεν. οὐκ ἔφα τις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:370.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:370.1.text#θεοὺς βροτῶν ἀξιοῦσθαι μέλειν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:371.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:371.1.text#ὅσοις ἀθίκτων χάρις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:372.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:372.1.text#πατοῖθ'· ὁ δ' οὐκ εὐσεβής.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:373.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:373.1.text#πέφανται δ' ἐκτίνουσ'
urn:cts:greekLit:tlg0085.tlg005.fu.sp:375.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:375.1.text#ἀτολμήτων ἀρὴ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:376.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:376.1.text#πνεόντων μεῖζον ἢ δικαίως,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:377.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:377.1.text#φλεόντων δωμάτων ὑπέρφευ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:378.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:378.1.text#ὑπὲρ τὸ βέλτιστον. ἔστω δ' ἀπή-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:379.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:379.1.text#μαντον, ὥστ' ἀπαρκεῖν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:380.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:380.1.text#εὖ πραπίδων λαχόντα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:381.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:381.1.text#οὐ γὰρ ἔστιν ἔπαλξις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:382.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:382.1.text#πλούτου πρὸς κόρον ἀνδρὶ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:383.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:383.1.text#λακτίσαντι μέγαν Δίκας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:384.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:384.1.text#βωμὸν εἰς ἀφάνειαν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:385.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:385.1.text#βιᾶται δ' ἁ τάλαινα πειθώ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:386.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:386.1.text#προβούλου παῖς ἄφερτος ἄτας.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:387.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:387.1.text#ἄκος δὲ πᾶν μάταιον. οὐκ ἐκρύφθη,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:388.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:388.1.text#πρέπει δέ, φῶς αἰνολαμπές, σίνος·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:390.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:390.1.text#κακοῦ δὲ χαλκοῦ τρόπον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:391.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:391.1.text#τρίβῳ τε καὶ προσβολαῖς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:392.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:392.1.text#μελαμπαγὴς πέλει
urn:cts:greekLit:tlg0085.tlg005.fu.sp:393.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:393.1.text#δικαιωθείς, ἐπεὶ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:394.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:394.1.text#διώκει παῖς ποτανὸν ὄρνιν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:395.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:395.1.text#πόλει πρόστριμμ' ἄφερτον ἐνθείς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:396.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:396.1.text#λιτᾶν δ' ἀκούει μὲν οὔτις θεῶν·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:397.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:397.1.text#τὸν δ' ἐπίστροφον τῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:398.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:398.1.text#φῶτ' ἄδικον καθαιρεῖ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:399.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:399.1.text#οἷος καὶ Πάρις ἐλθὼν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:400.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:400.1.text#ἐς δόμον τὸν Ἀτρειδᾶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:401.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:401.1.text#ᾔσχυνε ξενίαν τράπε-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:402.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:402.1.text#ζαν κλοπαῖσι γυναικός.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:403.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:403.1.text#λιποῦσα δ' ἀστοῖσιν ἀσπίστοράς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:404.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:404.1.text#τε καὶ κλόνους λογχίμους
urn:cts:greekLit:tlg0085.tlg005.fu.sp:405.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:405.1.text#ναυβάτας { θ' } ὁπλισμούς,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:406.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:406.1.text#ἄγουσά τ' ἀντίφερνον Ἰλίῳ φθορὰν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:407.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:407.1.text#βέβακεν ῥίμφα διὰ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:408.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:408.1.text#πυλᾶν ἄτλητα τλᾶσα· πολλὰ δ' ἔστενον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:409.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:409.1.text#τόδ' ἐννέποντες δόμων προφῆται·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:410.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:410.1.text#"ἰὼ ἰὼ δῶμα δῶμα καὶ πρόμοι,"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:411.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:411.1.text#"ἰὼ λέχος καὶ στίβοι φιλάνορες."
urn:cts:greekLit:tlg0085.tlg005.fu.sp:412.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:412.1.text#"πάρεστι σιγὰς ἀτίμους ἀλοιδόρους"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:413.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:413.1.text#"ἄλγιστ' ἀφημένων ἰδεῖν."
urn:cts:greekLit:tlg0085.tlg005.fu.sp:414.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:414.1.text#"πόθῳ δ' ὑπερποντίας"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:415.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:415.1.text#"φάσμα δόξει δόμων ἀνάσσειν."
urn:cts:greekLit:tlg0085.tlg005.fu.sp:416.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:416.1.text#"εὐμόρφων δὲ κολοσσῶν"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:417.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:417.1.text#"ἔχθεται χάρις ἀνδρί·"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:418.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:418.1.text#"ὀμμάτων δ' ἐν ἀχηνίαις"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:419.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:419.1.text#"ἔρρει πᾶσ' Ἀφροδίτα."
urn:cts:greekLit:tlg0085.tlg005.fu.sp:420.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:420.1.text#"ὀνειρόφαντοι δὲ πενθήμονες"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:421.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:421.1.text#"πάρεισι δόξαι φέρου-"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:422.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:422.1.text#"σαι χάριν ματαίαν."
urn:cts:greekLit:tlg0085.tlg005.fu.sp:423.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:423.1.text#"μάταν γάρ, εὖτ' ἂν ἐσθλά τις δοκῶν ὁρᾷ,"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:424.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:424.1.text#"παραλλάξασα διὰ"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:425.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:425.1.text#"χερῶν βέβακεν ὄψις οὐ μεθύστερον"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:426.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:426.1.text#"πτεροῖς ὀπαδοῦσ' ὕπνου κελεύθοις."
urn:cts:greekLit:tlg0085.tlg005.fu.sp:427.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:427.1.text#τὰ μὲν κατ' οἴκους ἐφ' ἑστίας ἄχη
urn:cts:greekLit:tlg0085.tlg005.fu.sp:428.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:428.1.text#τάδ' ἐστὶ καὶ τῶνδ' ὑπερβατώτερα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:429.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:429.1.text#τὸ πᾶν δ' ἀφ' Ἕλλανος αἴας συνορμένοις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:430.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:430.1.text#πένθει' ἀτλησικάρδιος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:431.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:431.1.text#δόμων ἑκάστου πρέπει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:432.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:432.1.text#πολλὰ γοῦν θιγγάνει πρὸς ἧπαρ·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:433.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:433.1.text#οὓς μὲν γάρ { τις } ἔπεμψεν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:434.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:434.1.text#οἶδεν, ἀντὶ δὲ φωτῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:435.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:435.1.text#τεύχη καὶ σποδὸς εἰς ἑκά-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:436.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:436.1.text#στου δόμους ἀφικνεῖται.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:437.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:437.1.text#ὁ χρυσαμοιβὸς δ' Ἄρης σωμάτων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:438.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:438.1.text#καὶ ταλαντοῦχος ἐν μάχῃ δορὸς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:440.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:440.1.text#πυρωθὲν ἐξ Ἰλίου
urn:cts:greekLit:tlg0085.tlg005.fu.sp:441.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:441.1.text#φίλοισι πέμπει βαρὺ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:442.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:442.1.text#ψῆγμα δυσδάκρυτον ἀν-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:443.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:443.1.text#τήνορος σποδοῦ γεμί-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:444.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:444.1.text#ζων λέβητας εὐθέτους.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:445.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:445.1.text#στένουσι δ' εὖ λέγοντες ἄν-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:446.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:446.1.text#δρα τὸν μὲν ὡς μάχης ἴδρις,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:447.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:447.1.text#τὸν δ' ἐν φοναῖς καλῶς πεσόντ'—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:448.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:448.1.text#ἀλλοτρίας διαὶ γυναι-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:449.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:449.1.text#κός· τάδε σῖγά τις βαΰ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:450.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:450.1.text#ζει, φθονερὸν δ' ὑπ' ἄλγος ἕρ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:451.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:451.1.text#πει προδίκοις Ἀτρείδαις.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:452.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:452.1.text#οἱ δ' αὐτοῦ περὶ τεῖχος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:453.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:453.1.text#θήκας Ἰλιάδος γᾶς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:454.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:454.1.text#εὔμορφοι κατέχουσιν· ἐχ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:455.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:455.1.text#θρὰ δ' ἔχοντας ἔκρυψεν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:456.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:456.1.text#βαρεῖα δ' ἀστῶν φάτις ξὺν κότῳ·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:457.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:457.1.text#δημοκράντου δ' ἀρᾶς τίνει χρέος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:458.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:458.1.text#μένει δ' ἀκοῦσαί τί μου
urn:cts:greekLit:tlg0085.tlg005.fu.sp:460.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:460.1.text#μέριμνα νυκτηρεφές.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:461.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:461.1.text#τῶν πολυκτόνων γὰρ οὐκ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:462.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:462.1.text#ἄσκοποι θεοί. κελαι-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:463.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:463.1.text#ναὶ δ' Ἐρινύες χρόνῳ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:464.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:464.1.text#τυχηρὸν ὄντ' ἄνευ δίκας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:465.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:465.1.text#παλιντυχεῖ τριβᾷ βίου
urn:cts:greekLit:tlg0085.tlg005.fu.sp:466.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:466.1.text#τιθεῖσ' ἀμαυρόν, ἐν δ' ἀί-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:467.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:467.1.text#στοις τελέθοντος οὔτις ἀλ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:468.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:468.1.text#κά· τὸ δ' ὑπερκόπως κλύειν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:469.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:469.1.text#εὖ βαρύ· βάλλεται γὰρ ὄσ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:470.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:470.1.text#σοις Διόθεν κάρανα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:471.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:471.1.text#κρίνω δ' ἄφθονον ὄλβον·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:472.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:472.1.text#μήτ' εἴην πτολιπόρθης
urn:cts:greekLit:tlg0085.tlg005.fu.sp:473.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:473.1.text#μήτ' οὖν αὐτὸς ἁλοὺς ὑπ' ἄλ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:474.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:474.1.text#λων βίον κατίδοιμι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:475.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:475.1.text#πυρὸς δ' ὑπ' εὐαγγέλου
urn:cts:greekLit:tlg0085.tlg005.fu.sp:476.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:476.1.text#πόλιν διήκει θοὰ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:477.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:477.1.text#βάξις· εἰ δ' ἐτήτυμος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:478.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:478.1.text#τίς οἶδεν, ἤ τι θεῖόν ἐστί πῃ ψύθος.—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:479.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:479.1.text#τίς ὧδε παιδνὸς ἢ φρενῶν κεκομμένος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:480.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:480.1.text#φλογὸς παραγγέλμασιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:481.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:481.1.text#νέοις πυρωθέντα καρδίαν ἔπειτ'
urn:cts:greekLit:tlg0085.tlg005.fu.sp:482.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:482.1.text#ἀλλαγᾷ λόγου καμεῖν;—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:483.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:483.1.text#[ ἐν ] γυναικὸς αἰχμᾷ πρέπει
urn:cts:greekLit:tlg0085.tlg005.fu.sp:484.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:484.1.text#πρὸ τοῦ φανέντος χάριν ξυναινέσαι.—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:485.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:485.1.text#πιθανὸς ἄγαν ὁ θῆλυς ὅρος ἐπινέμεται
urn:cts:greekLit:tlg0085.tlg005.fu.sp:486.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:486.1.text#ταχύπορος· ἀλλὰ ταχύμορον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:487.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:487.1.text#γυναικογήρυτον ὄλλυται κλέος.—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:488.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:488.1.text#τάχ' εἰσόμεσθα λαμπάδων φαεσφόρων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:490.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:490.1.text#φρυκτωριῶν τε καὶ πυρὸς παραλλαγάς,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:491.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:491.1.text#εἴτ' οὖν ἀληθεῖς εἶτ' ὀνειράτων δίκην
urn:cts:greekLit:tlg0085.tlg005.fu.sp:492.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:492.1.text#τερπνὸν τόδ' ἐλθὸν φῶς ἐφήλωσεν φρένας.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:493.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:493.1.text#κήρυκ' ἀπ' ἀκτῆς τόνδ' ὁρῶ κατάσκιον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:494.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:494.1.text#κλάδοις ἐλαίας· μαρτυρεῖ δέ μοι κάσις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:495.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:495.1.text#πηλοῦ ξύνουρος διψία κόνις τάδε,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:496.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:496.1.text#ὡς οὔτ' ἄναυδος οὔτε σοι δαίων φλόγα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:497.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:497.1.text#ὕλης ὀρείας σημανεῖ καπνῷ πυρός,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:498.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:498.1.text#ἀλλ' ἢ τὸ χαίρειν μᾶλλον ἐκβάξει λέγων—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:499.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:499.1.text#τὸν ἀντίον δὲ τοῖσδ' ἀποστέργω λόγον·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:500.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:500.1.text#εὖ γὰρ πρὸς εὖ φανεῖσι προσθήκη πέλοι.—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:501.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:501.1.text#ὅστις τάδ' ἄλλως τῇδ' ἐπεύχεται πόλει,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:502.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:502.1.text#αὐτὸς φρενῶν καρποῖτο τὴν ἁμαρτίαν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:503.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:503.1.text#ἰὼ πατρῷον οὖδας Ἀργείας χθονός,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:504.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:504.1.text#δεκάτου σε φέγγει τῷδ' ἀφικόμην ἔτους,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:505.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:505.1.text#πολλῶν ῥαγεισῶν ἐλπίδων μιᾶς τυχών.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:506.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:506.1.text#οὐ γάρ ποτ' ηὔχουν τῇδ' ἐν Ἀργείᾳ χθονὶ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:507.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:507.1.text#θανὼν μεθέξειν φιλτάτου τάφου μέρος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:508.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:508.1.text#νῦν χαῖρε μὲν χθών, χαῖρε δ' ἡλίου φάος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:509.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:509.1.text#ὕπατός τε χώρας Ζεύς, ὁ Πύθιός τ' ἄναξ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:510.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:510.1.text#τόξοις ἰάπτων μηκέτ' εἰς ἡμᾶς βέλη·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:511.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:511.1.text#ἅλις παρὰ Σκάμανδρον ἦσθ' ἀνάρσιος·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:512.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:512.1.text#νῦν δ' αὖτε σωτὴρ ἴσθι καὶ παιώνιος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:513.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:513.1.text#ἄναξ Ἄπολλον. τούς τ' ἀγωνίους θεοὺς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:514.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:514.1.text#πάντας προσαυδῶ, τόν τ' ἐμὸν τιμάορον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:515.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:515.1.text#Ἑρμῆν, φίλον κήρυκα, κηρύκων σέβας,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:516.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:516.1.text#ἥρως τε τοὺς πέμψαντας, εὐμενεῖς πάλιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:517.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:517.1.text#στρατὸν δέχεσθαι τὸν λελειμμένον δορός.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:518.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:518.1.text#ἰὼ μέλαθρα βασιλέων, φίλαι στέγαι,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:519.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:519.1.text#σεμνοί τε θᾶκοι, δαίμονές τ' ἀντήλιοι,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:520.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:520.1.text#εἴ που πάλαι, φαιδροῖσι τοισίδ' ὄμμασι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:521.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:521.1.text#δέξασθε κόσμῳ βασιλέα πολλῷ χρόνῳ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:522.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:522.1.text#ἥκει γὰρ ὑμῖν φῶς ἐν εὐφρόνῃ φέρων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:523.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:523.1.text#καὶ τοῖσδ' ἅπασι κοινὸν Ἀγαμέμνων ἄναξ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:524.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:524.1.text#ἀλλ' εὖ νιν ἀσπάσασθε, καὶ γὰρ οὖν πρέπει
urn:cts:greekLit:tlg0085.tlg005.fu.sp:525.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:525.1.text#Τροίαν κατασκάψαντα τοῦ δικηφόρου
urn:cts:greekLit:tlg0085.tlg005.fu.sp:526.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:526.1.text#Διὸς μακέλλῃ, τῇ κατείργασται πέδον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:527.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:527.1.text#βωμοὶ δ' ἄιστοι καὶ θεῶν ἱδρύματα,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:528.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:528.1.text#καὶ σπέρμα πάσης ἐξαπόλλυται χθονός.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:529.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:529.1.text#τοιόνδε Τροίᾳ περιβαλὼν ζευκτήριον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:530.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:530.1.text#ἄναξ Ἀτρείδης πρέσβυς εὐδαίμων ἀνὴρ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:531.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:531.1.text#ἥκει, τίεσθαι δ' ἀξιώτατος βροτῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:532.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:532.1.text#τῶν νῦν· Πάρις γὰρ οὔτε συντελὴς πόλις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:533.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:533.1.text#ἐξεύχεται τὸ δρᾶμα τοῦ πάθους πλέον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:534.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:534.1.text#ὀφλὼν γὰρ ἁρπαγῆς τε καὶ κλοπῆς δίκην
urn:cts:greekLit:tlg0085.tlg005.fu.sp:535.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:535.1.text#τοῦ ῥυσίου θ' ἥμαρτε καὶ πανώλεθρον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:536.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:536.1.text#αὐτόχθονον πατρῷον ἔθρισεν δόμον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:537.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:537.1.text#διπλᾶ δ' ἔτεισαν Πριαμίδαι θἀμάρτια.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:538.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:538.1.text#κῆρυξ Ἀχαιῶν χαῖρε τῶν ἀπὸ στρατοῦ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:539.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:539.1.text#χαίρω { γε }· τεθνάναι δ' οὐκέτ' ἀντερῶ θεοῖς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:540.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:540.1.text#ἔρως πατρῴας τῆσδε γῆς σ' ἐγύμνασεν;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:541.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:541.1.text#ὥστ' ἐνδακρύειν γ' ὄμμασιν χαρᾶς ὕπο.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:542.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:542.1.text#τερπνῆς ἄρ' ἦτε τῆσδ' ἐπήβολοι νόσου.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:543.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:543.1.text#πῶς δή; διδαχθεὶς τοῦδε δεσπόσω λόγου.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:544.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:544.1.text#τῶν ἀντερώντων ἱμέρῳ πεπληγμένοι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:545.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:545.1.text#ποθεῖν ποθοῦντα τήνδε γῆν στρατὸν λέγεις;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:546.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:546.1.text#ὡς πόλλ' ἀμαυρᾶς ἐκ φρενός { μ' } ἀναστένειν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:547.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:547.1.text#πόθεν τὸ δύσφρον τοῦτ' ἐπῆν θυμῷ στύγος;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:548.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:548.1.text#πάλαι τὸ σιγᾶν φάρμακον βλάβης ἔχω.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:549.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:549.1.text#καὶ πῶς; ἀπόντων κοιράνων ἔτρεις τινάς;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:550.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:550.1.text#ὡς νῦν, τὸ σὸν δή, καὶ θανεῖν πολλὴ χάρις.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:551.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:551.1.text#εὖ γὰρ πέπρακται. ταῦτα δ' ἐν πολλῷ χρόνῳ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:552.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:552.1.text#τὰ μέν τις ἂν λέξειεν εὐπετῶς ἔχειν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:553.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:553.1.text#τὰ δ' αὖτε κἀπίμομφα. τίς δὲ πλὴν θεῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:554.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:554.1.text#ἅπαντ' ἀπήμων τὸν δι' αἰῶνος χρόνον;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:555.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:555.1.text#μόχθους γὰρ εἰ λέγοιμι καὶ δυσαυλίας,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:556.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:556.1.text#σπαρνὰς παρήξεις καὶ κακοστρώτους, τί δ' οὐ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:557.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:557.1.text#στένοντες, { οὐ λαχόντες } ἤματος μέρος;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:558.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:558.1.text#τὰ δ' αὖτε χέρσῳ καὶ προσῆν πλέον στύγος·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:559.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:559.1.text#εὐναὶ γὰρ ἦσαν δηΐων πρὸς τείχεσιν·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:560.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:560.1.text#ἐξ οὐρανοῦ δὲ κἀπὸ γῆς λειμώνιαι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:561.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:561.1.text#δρόσοι κατεψάκαζον, ἔμπεδον σίνος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:562.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:562.1.text#ἐσθημάτων, τιθέντες ἔνθηρον τρίχα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:563.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:563.1.text#χειμῶνα δ' εἰ λέγοι τις οἰωνοκτόνον,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:564.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:564.1.text#οἷον παρεῖχ' ἄφερτον Ἰδαία χιών,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:565.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:565.1.text#ἢ θάλπος, εὖτε πόντος ἐν μεσημβριναῖς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:566.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:566.1.text#κοίταις ἀκύμων νηνέμοις εὕδοι πεσών
urn:cts:greekLit:tlg0085.tlg005.fu.sp:567.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:567.1.text#τί ταῦτα πενθεῖν δεῖ; παροίχεται πόνος·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:568.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:568.1.text#παροίχεται δέ, τοῖσι μὲν τεθνηκόσιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:569.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:569.1.text#τὸ μήποτ' αὖθις μηδ' ἀναστῆναι μέλειν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:570.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:570.1.text#τί τοὺς ἀναλωθέντας ἐν ψήφῳ λέγειν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:571.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:571.1.text#τὸν ζῶντα δ' ἀλγεῖν χρὴ τύχης παλιγκότου;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:572.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:572.1.text#καὶ πολλὰ χαίρειν ξυμφορὰς καταξιῶ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:573.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:573.1.text#ἡμῖν δὲ τοῖς λοιποῖσιν Ἀργείων στρατοῦ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:574.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:574.1.text#νικᾷ τὸ κέρδος, πῆμα δ' οὐκ ἀντιρρέπει·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:575.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:575.1.text#ὡς κομπάσαι τῷδ' εἰκὸς ἡλίου φάει
urn:cts:greekLit:tlg0085.tlg005.fu.sp:576.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:576.1.text#ὑπὲρ θαλάσσης καὶ χθονὸς ποτωμένοις·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:577.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:577.1.text#"Τροίαν ἑλόντες δή ποτ' Ἀργείων στόλος"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:578.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:578.1.text#"θεοῖς λάφυρα ταῦτα τοῖς καθ' Ἑλλάδα"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:579.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:579.1.text#"δόμοις ἐπασσάλευσαν ἀρχαῖον γάνος."
urn:cts:greekLit:tlg0085.tlg005.fu.sp:580.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:580.1.text#τοιαῦτα χρὴ κλύοντας εὐλογεῖν πόλιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:581.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:581.1.text#καὶ τοὺς στρατηγούς· καὶ χάρις τιμήσεται
urn:cts:greekLit:tlg0085.tlg005.fu.sp:582.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:582.1.text#Διὸς τόδ' ἐκπράξασα.πάντ' ἔχεις λόγον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:583.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:583.1.text#νικώμενος λόγοισιν οὐκ ἀναίνομαι·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:584.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:584.1.text#ἀεὶ γὰρ ἥβη τοῖς γέρουσιν εὖ μαθεῖν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:585.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:585.1.text#δόμοις δὲ ταῦτα καὶ Κλυταιμήστρᾳ μέλειν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:586.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:586.1.text#εἰκὸς μάλιστα, σὺν δὲ πλουτίζειν ἐμέ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:587.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:587.1.text#ἀνωλόλυξα μὲν πάλαι χαρᾶς ὕπο,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:588.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:588.1.text#ὅτ' ἦλθ' ὁ πρῶτος νύχιος ἄγγελος πυρός,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:589.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:589.1.text#φράζων ἅλωσιν Ἰλίου τ' ἀνάστασιν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:590.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:590.1.text#καί τίς μ' ἐνίπτων εἶπε, "φρυκτωρῶν δία"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:591.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:591.1.text#"πεισθεῖσα Τροίαν νῦν πεπορθῆσθαι δοκεῖς;"
urn:cts:greekLit:tlg0085.tlg005.fu.sp:592.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:592.1.text#"ἦ κάρτα πρὸς γυναικὸς αἴρεσθαι κέαρ."
urn:cts:greekLit:tlg0085.tlg005.fu.sp:593.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:593.1.text#λόγοις τοιούτοις πλαγκτὸς οὖσ' ἐφαινόμην.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:594.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:594.1.text#ὅμως δ' ἔθυον, καὶ γυναικείῳ νόμῳ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:595.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:595.1.text#ὀλολυγμὸν ἄλλος ἄλλοθεν κατὰ πτόλιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:596.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:596.1.text#ἔλασκον εὐφημοῦντες ἐν θεῶν ἕδραις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:597.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:597.1.text#θυηφάγον κοιμῶντες εὐώδη φλόγα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:598.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:598.1.text#καὶ νῦν τὰ μάσσω μὲν τί δεῖ σέ μοι λέγειν;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:599.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:599.1.text#ἄνακτος αὐτοῦ πάντα πεύσομαι λόγον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:600.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:600.1.text#ὅπως δ' ἄριστα τὸν ἐμὸν αἰδοῖον πόσιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:601.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:601.1.text#σπεύσω πάλιν μολόντα δέξασθαι·—τί γὰρ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:602.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:602.1.text#γυναικὶ τούτου φέγγος ἥδιον δρακεῖν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:603.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:603.1.text#ἀπὸ στρατείας ἀνδρὶ σώσαντος θεοῦ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:604.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:604.1.text#πύλας ἀνοῖξαι;—ταῦτ' ἀπάγγειλον πόσει·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:605.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:605.1.text#ἥκειν ὅπως τάχιστ' ἐράσμιον πόλει·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:606.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:606.1.text#γυναῖκα πιστὴν δ' ἐν δόμοις εὕροι μολὼν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:607.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:607.1.text#οἵαν περ οὖν ἔλειπε, δωμάτων κύνα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:608.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:608.1.text#ἐσθλὴν ἐκείνῳ, πολεμίαν τοῖς δύσφροσιν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:609.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:609.1.text#καὶ τἄλλ' ὁμοίαν πάντα, σημαντήριον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:610.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:610.1.text#οὐδὲν διαφθείρασαν ἐν μήκει χρόνου.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:611.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:611.1.text#οὐδ' οἶδα τέρψιν οὐδ' ἐπίψογον φάτιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:612.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:612.1.text#ἄλλου πρὸς ἀνδρὸς μᾶλλον ἢ χαλκοῦ βαφάς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:613.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:613.1.text#τοιόσδ' ὁ κόμπος τῆς ἀληθείας γέμων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:614.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:614.1.text#οὐκ αἰσχρὸς ὡς γυναικὶ γενναίᾳ λακεῖν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:615.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:615.1.text#αὕτη μὲν οὕτως εἶπε μανθάνοντί σοι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:616.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:616.1.text#τοροῖσιν ἑρμηνεῦσιν εὐπρεπῶς λόγον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:617.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:617.1.text#σὺ δ' εἰπέ, κῆρυξ, Μενέλεων δὲ πεύθομαι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:618.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:618.1.text#εἰ νόστιμός τε καὶ σεσωσμένος πάλιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:619.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:619.1.text#ἥκει σὺν ὑμῖν, τῆσδε γῆς φίλον κράτος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:620.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:620.1.text#οὐκ ἔσθ' ὅπως λέξαιμι τὰ ψευδῆ καλὰ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:621.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:621.1.text#ἐς τὸν πολὺν φίλοισι καρποῦσθαι χρόνον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:622.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:622.1.text#πῶς δῆτ' ἂν εἰπὼν κεδνὰ τἀληθῆ τύχοις;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:623.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:623.1.text#σχισθέντα δ' οὐκ εὔκρυπτα γίγνεται τάδε.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:624.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:624.1.text#ἁνὴρ ἄφαντος ἐξ Ἀχαιικοῦ στρατοῦ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:625.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:625.1.text#αὐτός τε καὶ τὸ πλοῖον. οὐ ψευδῆ λέγω.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:626.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:626.1.text#πότερον ἀναχθεὶς ἐμφανῶς ἐξ Ἰλίου,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:627.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:627.1.text#ἢ χεῖμα, κοινὸν ἄχθος, ἥρπασε στρατοῦ;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:628.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:628.1.text#ἔκυρσας ὥστε τοξότης ἄκρος σκοποῦ·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:629.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:629.1.text#μακρὸν δὲ πῆμα συντόμως ἐφημίσω.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:630.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:630.1.text#πότερα γὰρ αὐτοῦ ζῶντος ἢ τεθνηκότος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:631.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:631.1.text#φάτις πρὸς ἄλλων ναυτίλων ἐκλῄζετο;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:632.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:632.1.text#οὐκ οἶδεν οὐδεὶς ὥστ' ἀπαγγεῖλαι τορῶς,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:633.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:633.1.text#πλὴν τοῦ τρέφοντος Ἡλίου χθονὸς φύσιν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:634.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:634.1.text#πῶς γὰρ λέγεις χειμῶνα ναυτικῷ στρατῷ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:635.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:635.1.text#ἐλθεῖν τελευτῆσαί τε δαιμόνων κότῳ;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:636.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:636.1.text#εὔφημον ἦμαρ οὐ πρέπει κακαγγέλῳ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:637.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:637.1.text#γλώσσῃ μιαίνειν· χωρὶς ἡ τιμὴ θεῶν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:638.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:638.1.text#ὅταν δ' ἀπευκτὰ πήματ' ἄγγελος πόλει
urn:cts:greekLit:tlg0085.tlg005.fu.sp:639.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:639.1.text#στυγνῷ προσώπῳ πτωσίμου στρατοῦ φέρῃ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:640.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:640.1.text#πόλει μὲν ἕλκος ἓν τὸ δήμιον τυχεῖν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:641.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:641.1.text#πολλοὺς δὲ πολλῶν ἐξαγισθέντας δόμων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:642.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:642.1.text#ἄνδρας διπλῇ μάστιγι, τὴν Ἄρης φιλεῖ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:643.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:643.1.text#δίλογχον ἄτην, φοινίαν ξυνωρίδα·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:644.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:644.1.text#τοιῶνδε μέντοι πημάτων σεσαγμένον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:645.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:645.1.text#πρέπει λέγειν παιᾶνα τόνδ' Ἐρινύων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:646.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:646.1.text#σωτηρίων δὲ πραγμάτων εὐάγγελον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:647.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:647.1.text#ἥκοντα πρὸς χαίρουσαν εὐεστοῖ πόλιν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:648.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:648.1.text#πῶς κεδνὰ τοῖς κακοῖσι συμμείξω, λέγων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:649.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:649.1.text#χειμῶν' Ἀχαιοῖς οὐκ ἀμήνιτον θεῶν;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:650.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:650.1.text#ξυνώμοσαν γάρ, ὄντες ἔχθιστοι τὸ πρίν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:651.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:651.1.text#πῦρ καὶ θάλασσα, καὶ τὰ πίστ' ἐδειξάτην
urn:cts:greekLit:tlg0085.tlg005.fu.sp:652.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:652.1.text#φθείροντε τὸν δύστηνον Ἀργείων στρατόν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:653.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:653.1.text#ἐν νυκτὶ δυσκύμαντα δ' ὠρώρει κακά.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:654.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:654.1.text#ναῦς γὰρ πρὸς ἀλλήλαισι Θρῄκιαι πνοαὶ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:655.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:655.1.text#ἤρεικον· αἱ δὲ κεροτυπούμεναι βίᾳ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:656.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:656.1.text#χειμῶνι τυφῶ σὺν ζάλῃ τ' ὀμβροκτύπῳ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:657.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:657.1.text#ᾤχοντ' ἄφαντοι ποιμένος κακοῦ στρόβῳ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:658.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:658.1.text#ἐπεὶ δ' ἀνῆλθε λαμπρὸν ἡλίου φάος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:659.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:659.1.text#ὁρῶμεν ἀνθοῦν πέλαγος Αἰγαῖον νεκροῖς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:660.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:660.1.text#ἀνδρῶν Ἀχαιῶν ναυτικοῖς τ' ἐρειπίοις.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:661.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:661.1.text#ἡμᾶς γε μὲν δὴ ναῦν τ' ἀκήρατον σκάφος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:662.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:662.1.text#ἤτοι τις ἐξέκλεψεν ἢ 'ξῃτήσατο
urn:cts:greekLit:tlg0085.tlg005.fu.sp:663.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:663.1.text#θεός τις, οὐκ ἄνθρωπος, οἴακος θιγών.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:664.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:664.1.text#τύχη δὲ σωτὴρ ναῦν θέλουσ' ἐφέζετο,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:665.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:665.1.text#ὡς μήτ' ἐν ὅρμῳ κύματος ζάλην ἔχειν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:666.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:666.1.text#μήτ' ἐξοκεῖλαι πρὸς κραταίλεων χθόνα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:667.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:667.1.text#ἔπειτα δ' Ἅιδην πόντιον πεφευγότες,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:668.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:668.1.text#λευκὸν κατ' ἦμαρ, οὐ πεποιθότες τύχῃ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:669.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:669.1.text#ἐβουκολοῦμεν φροντίσιν νέον πάθος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:670.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:670.1.text#στρατοῦ καμόντος καὶ κακῶς σποδουμένου.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:671.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:671.1.text#καὶ νῦν ἐκείνων εἴ τίς ἐστιν ἐμπνέων,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:672.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:672.1.text#λέγουσιν ἡμᾶς ὡς ὀλωλότας, τί μή;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:673.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:673.1.text#ἡμεῖς τ' ἐκείνους ταὔτ' ἔχειν δοξάζομεν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:674.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:674.1.text#γένοιτο δ' ὡς ἄριστα. Μενέλεων γὰρ οὖν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:675.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:675.1.text#πρῶτόν τε καὶ μάλιστα προσδόκα μολεῖν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:676.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:676.1.text#εἰ γοῦν τις ἀκτὶς ἡλίου νιν ἱστορεῖ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:677.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:677.1.text#καὶ ζῶντα καὶ βλέποντα, μηχαναῖς Διός,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:678.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:678.1.text#οὔπω θέλοντος ἐξαναλῶσαι γένος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:679.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:679.1.text#ἐλπίς τις αὐτὸν πρὸς δόμους ἥξειν πάλιν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:680.1.speaker#Κῆρυξ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:680.1.text#τοσαῦτ' ἀκούσας ἴσθι τἀληθῆ κλύων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:681.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:681.1.text#τίς ποτ' ὠνόμαζεν ὧδ'
urn:cts:greekLit:tlg0085.tlg005.fu.sp:682.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:682.1.text#ἐς τὸ πᾶν ἐτητύμως—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:683.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:683.1.text#μή τις ὅντιν' οὐχ ὁρῶμεν προνοί-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:684.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:684.1.text#αισι τοῦ πεπρωμένου
urn:cts:greekLit:tlg0085.tlg005.fu.sp:685.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:685.1.text#γλῶσσαν ἐν τύχᾳ νέμων;—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:686.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:686.1.text#τὰν δορίγαμβρον ἀμφινει-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:687.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:687.1.text#κῆ θ' Ἑλέναν; ἐπεὶ πρεπόντως
urn:cts:greekLit:tlg0085.tlg005.fu.sp:688.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:688.1.text#ἑλένας, ἕλανδρος, ἑλέ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:690.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:690.1.text#πτολις, ἐκ τῶν ἁβροτίμων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:691.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:691.1.text#προκαλυμμάτων ἔπλευσε
urn:cts:greekLit:tlg0085.tlg005.fu.sp:692.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:692.1.text#ζεφύρου γίγαντος αὔρᾳ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:693.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:693.1.text#πολύανδροί τε φεράσπιδες κυναγοὶ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:695.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:695.1.text#κατ' ἴχνος πλατᾶν ἄφαντον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:696.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:696.1.text#κελσάντων Σιμόεντος ἀ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:697.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:697.1.text#κτὰς ἐπ' ἀεξιφύλλους
urn:cts:greekLit:tlg0085.tlg005.fu.sp:698.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:698.1.text#δι' ἔριν αἱματόεσσαν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:699.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:699.1.text#Ἰλίῳ δὲ κῆδος ὀρθ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:700.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:700.1.text#ώνυμον τελεσσίφρων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:701.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:701.1.text#μῆνις ἤλασεν, τραπέζας ἀτί-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:702.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:702.1.text#μωσιν ὑστέρῳ χρόνῳ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:703.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:703.1.text#καὶ ξυνεστίου Διὸς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:704.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:704.1.text#πρασσομένα τὸ νυμφότι-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:706.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:706.1.text#μον μέλος ἐκφάτως τίοντας,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:707.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:707.1.text#ὑμέναιον, ὃς τότ' ἐπέρ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:708.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:708.1.text#ρεπεν γαμβροῖσιν ἀείδειν·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:709.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:709.1.text#μεταμανθάνουσα δ' ὕμνον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:710.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:710.1.text#Πριάμου πόλις γεραιὰ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:711.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:711.1.text#πολύθρηνον μέγα που στένει κικλήσκου-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:712.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:712.1.text#σα Πάριν τὸν αἰνόλεκτρον,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:713.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:713.1.text#παμπορθῆ πολύθρηνον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:714.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:714.1.text#αἰῶνα διαὶ πολιτᾶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:715.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:715.1.text#μέλεον αἷμ' ἀνατλᾶσα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:716.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:716.1.text#ἔθρεψεν δὲ λέοντος ἶ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:717.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:717.1.text#νιν δόμοις ἀγάλακτον οὕ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:718.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:718.1.text#τως ἀνὴρ φιλόμαστον,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:720.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:720.1.text#ἐν βιότου προτελείοις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:721.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:721.1.text#ἅμερον, εὐφιλόπαιδα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:722.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:722.1.text#καὶ γεραροῖς ἐπίχαρτον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:723.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:723.1.text#πολέα δ' ἔσχ' ἐν ἀγκάλαις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:724.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:724.1.text#νεοτρόφου τέκνου δίκαν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:725.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:725.1.text#φαιδρωπὸς ποτὶ χεῖρα σαί-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:726.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:726.1.text#νων τε γαστρὸς ἀνάγκαις.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:727.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:727.1.text#χρονισθεὶς δ' ἀπέδειξεν ἦ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:728.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:728.1.text#θος τὸ πρὸς τοκέων· χάριν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:729.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:729.1.text#γὰρ τροφεῦσιν ἀμείβων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:730.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:730.1.text#μηλοφόνοισιν { ἐν } ἄταις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:731.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:731.1.text#δαῖτ' ἀκέλευστος ἔτευξεν·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:732.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:732.1.text#αἵματι δ' οἶκος ἐφύρθη,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:733.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:733.1.text#ἄμαχον ἄλγος οἰκέταις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:734.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:734.1.text#μέγα σίνος πολυκτόνον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:735.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:735.1.text#ἐκ θεοῦ δ' ἱερεύς τις ἄ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:736.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:736.1.text#τας δόμοις προσεθρέφθη.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:737.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:737.1.text#πάραυτα δ' ἐλθεῖν ἐς Ἰλίου πόλιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:738.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:738.1.text#λέγοιμ' ἂν φρόνημα μὲν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:739.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:739.1.text#νηνέμου γαλάνας,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:740.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:740.1.text#ἀκασκαῖον { δ' } ἄγαλμα πλούτου,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:741.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:741.1.text#μαλθακὸν ὀμμάτων βέλος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:742.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:742.1.text#δηξίθυμον ἔρωτος ἄνθος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:743.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:743.1.text#παρακλίνασ' ἐπέκρανεν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:745.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:745.1.text#δὲ γάμου πικρὰς τελευτάς,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:746.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:746.1.text#δύσεδρος καὶ δυσόμιλος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:747.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:747.1.text#συμένα Πριαμίδαισιν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:748.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:748.1.text#πομπᾷ Διὸς ξενίου,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:749.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:749.1.text#νυμφόκλαυτος Ἐρινύς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:750.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:750.1.text#παλαίφατος δ' ἐν βροτοῖς γέρων λόγος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:751.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:751.1.text#τέτυκται, μέγαν τελε-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:752.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:752.1.text#σθέντα φωτὸς ὄλβον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:753.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:753.1.text#τεκνοῦσθαι μηδ' ἄπαιδα θνῄσκειν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:755.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:755.1.text#ἐκ δ' ἀγαθᾶς τύχας γένει
urn:cts:greekLit:tlg0085.tlg005.fu.sp:756.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:756.1.text#βλαστάνειν ἀκόρεστον οἰζύν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:757.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:757.1.text#δίχα δ' ἄλλων μονόφρων εἰ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:758.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:758.1.text#μί· τὸ δυσσεβὲς γὰρ ἔργον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:759.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:759.1.text#μετὰ μὲν πλείονα τίκτει,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:760.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:760.1.text#σφετέρᾳ δ' εἰκότα γέννᾳ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:761.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:761.1.text#οἴκων δ' ἄρ' εὐθυδίκων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:762.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:762.1.text#καλλίπαις πότμος αἰεί.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:763.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:763.1.text#φιλεῖ δὲ τίκτειν Ὕβρις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:764.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:764.1.text#μὲν παλαιὰ νεά-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:765.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:765.1.text#ζουσαν ἐν κακοῖς βροτῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:766.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:766.1.text#ὕβριν τότ' ἢ τόθ', ὅτε τὸ κύρ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:767.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:767.1.text#ιον μόλῃ φάος τόκου,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:768.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:768.1.text#δαίμονά τε τὰν ἄμαχον ἀπόλεμ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:769.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:769.1.text#ον, ἀνίερον Θράσος, μελαί-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:770.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:770.1.text#νας μελάθροισιν Ἄτας,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:771.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:771.1.text#εἰδομένας τοκεῦσιν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:772.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:772.1.text#Δίκα δὲ λάμπει μὲν ἐν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:773.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:773.1.text#δυσκάπνοις δώμασιν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:775.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:775.1.text#τὸν δ' ἐναίσιμον τίει [ βίον ].
urn:cts:greekLit:tlg0085.tlg005.fu.sp:776.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:776.1.text#τὰ χρυσόπαστα δ' ἔδεθλα σὺν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:777.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:777.1.text#πίνῳ χερῶν παλιντρόποις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:778.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:778.1.text#ὄμμασι λιποῦσ', ὅσια προσέμολ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:779.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:779.1.text#ε, δύναμιν οὐ σέβουσα πλού-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:780.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:780.1.text#του παράσημον αἴνῳ·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:781.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:781.1.text#πᾶν δ' ἐπὶ τέρμα νωμᾷ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:782.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:782.1.text#ἄγε δή, βασιλεῦ, Τροίας πτολίπορθ',
urn:cts:greekLit:tlg0085.tlg005.fu.sp:783.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:783.1.text#Ἀτρέως γένεθλον,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:785.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:785.1.text#πῶς σε προσείπω; πῶς σε σεβίζω
urn:cts:greekLit:tlg0085.tlg005.fu.sp:786.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:786.1.text#μήθ' ὑπεράρας μήθ' ὑποκάμψας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:787.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:787.1.text#καιρὸν χάριτος;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:788.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:788.1.text#πολλοὶ δὲ βροτῶν τὸ δοκεῖν εἶναι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:789.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:789.1.text#προτίουσι δίκην παραβάντες.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:790.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:790.1.text#τῷ δυσπραγοῦντι δ' ἐπιστενάχειν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:791.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:791.1.text#πᾶς τις ἕτοιμος· δῆγμα δὲ λύπης
urn:cts:greekLit:tlg0085.tlg005.fu.sp:792.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:792.1.text#οὐδὲν ἐφ' ἧπαρ προσικνεῖται·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:793.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:793.1.text#καὶ ξυγχαίρουσιν ὁμοιοπρεπεῖς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:794.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:794.1.text#ἀγέλαστα πρόσωπα βιαζόμενοι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:795.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:795.1.text#ὅστις δ' ἀγαθὸς προβατογνώμων,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:796.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:796.1.text#οὐκ ἔστι λαθεῖν ὄμματα φωτός,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:797.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:797.1.text#τὰ δοκοῦντ' εὔφρονος ἐκ διανοίας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:798.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:798.1.text#ὑδαρεῖ σαίνειν φιλότητι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:799.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:799.1.text#σὺ δέ μοι τότε μὲν στέλλων στρατιὰν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:800.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:800.1.text#Ἑλένης ἕνεκ', οὐ γάρ { σ' } ἐπικεύσω,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:801.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:801.1.text#κάρτ' ἀπομούσως ἦσθα γεγραμμένος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:802.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:802.1.text#οὐδ' εὖ πραπίδων οἴακα νέμων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:803.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:803.1.text#θράσος ἐκ θυσιῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:804.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:804.1.text#ἀνδράσι θνῄσκουσι κομίζων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:805.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:805.1.text#νῦν δ' οὐκ ἀπ' ἄκρας φρενὸς οὐδ' ἀφίλως
urn:cts:greekLit:tlg0085.tlg005.fu.sp:806.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:806.1.text#[ … ]
urn:cts:greekLit:tlg0085.tlg005.fu.sp:807.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:807.1.text#εὔφρων πόνος εὖ τελέσασιν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:808.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:808.1.text#γνώσῃ δὲ χρόνῳ διαπευθόμενος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:809.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:809.1.text#τόν τε δικαίως καὶ τὸν ἀκαίρως πόλιν οἰκουροῦντα πολιτῶν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:810.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:810.1.text#πρῶτον μὲν Ἄργος καὶ θεοὺς ἐγχωρίους
urn:cts:greekLit:tlg0085.tlg005.fu.sp:811.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:811.1.text#δίκη προσειπεῖν, τοὺς ἐμοὶ μεταιτίους
urn:cts:greekLit:tlg0085.tlg005.fu.sp:812.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:812.1.text#νόστου δικαίων θ' ὧν ἐπραξάμην πόλιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:813.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:813.1.text#Πριάμου· δίκας γὰρ οὐκ ἀπὸ γλώσσης θεοὶ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:814.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:814.1.text#κλύοντες ἀνδροθνῆτας Ἰλίου φθορὰς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:815.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:815.1.text#ἐς αἱματηρὸν τεῦχος οὐ διχορρόπως
urn:cts:greekLit:tlg0085.tlg005.fu.sp:816.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:816.1.text#ψήφους ἔθεντο· τῷ δ' ἐναντίῳ κύτει
urn:cts:greekLit:tlg0085.tlg005.fu.sp:817.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:817.1.text#ἐλπὶς προσῄει χειρὸς οὐ πληρουμένῳ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:818.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:818.1.text#καπνῷ δ' ἁλοῦσα νῦν ἔτ' εὔσημος πόλις.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:819.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:819.1.text#ἄτης θύελλαι ζῶσι· συνθνῄσκουσα δὲ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:820.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:820.1.text#σποδὸς προπέμπει πίονας πλούτου πνοάς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:821.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:821.1.text#τούτων θεοῖσι χρὴ πολύμνηστον χάριν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:822.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:822.1.text#τίνειν, ἐπείπερ καὶ πάγας ὑπερκότους
urn:cts:greekLit:tlg0085.tlg005.fu.sp:823.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:823.1.text#ἐφραξάμεσθα καὶ γυναικὸς οὕνεκα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:824.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:824.1.text#πόλιν διημάθυνεν Ἀργεῖον δάκος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:825.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:825.1.text#ἵππου νεοσσός, ἀσπιδηφόρος λεώς,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:826.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:826.1.text#πήδημ' ὀρούσας ἀμφὶ Πλειάδων δύσιν·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:827.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:827.1.text#ὑπερθορὼν δὲ πύργον ὠμηστὴς λέων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:828.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:828.1.text#ἄδην ἔλειξεν αἵματος τυραννικοῦ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:829.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:829.1.text#θεοῖς μὲν ἐξέτεινα φροίμιον τόδε·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:830.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:830.1.text#τὰ δ' ἐς τὸ σὸν φρόνημα, μέμνημαι κλύων,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:831.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:831.1.text#καὶ φημὶ ταὐτὰ καὶ συνήγορόν μ' ἔχεις.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:832.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:832.1.text#παύροις γὰρ ἀνδρῶν ἐστι συγγενὲς τόδε,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:833.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:833.1.text#φίλον τὸν εὐτυχοῦντ' ἄνευ φθόνου σέβειν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:834.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:834.1.text#δύσφρων γὰρ ἰὸς καρδίαν προσήμενος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:835.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:835.1.text#ἄχθος διπλοίζει τῷ πεπαμένῳ νόσον,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:836.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:836.1.text#τοῖς τ' αὐτὸς αὑτοῦ πήμασιν βαρύνεται
urn:cts:greekLit:tlg0085.tlg005.fu.sp:837.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:837.1.text#καὶ τὸν θυραῖον ὄλβον εἰσορῶν στένει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:838.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:838.1.text#εἰδὼς λέγοιμ' ἄν, εὖ γὰρ ἐξεπίσταμαι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:839.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:839.1.text#ὁμιλίας κάτοπτρον, εἴδωλον σκιᾶς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:840.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:840.1.text#δοκοῦντας εἶναι κάρτα πρευμενεῖς ἐμοί.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:841.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:841.1.text#μόνος δ' Ὀδυσσεύς, ὅσπερ οὐχ ἑκὼν ἔπλει,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:842.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:842.1.text#ζευχθεὶς ἕτοιμος ἦν ἐμοὶ σειραφόρος·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:843.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:843.1.text#εἴτ' οὖν θανόντος εἴτε καὶ ζῶντος πέρι λέγω.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:844.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:844.1.text#τὰ δ' ἄλλα πρὸς πόλιν τε καὶ θεοὺς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:845.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:845.1.text#κοινοὺς ἀγῶνας θέντες ἐν πανηγύρει
urn:cts:greekLit:tlg0085.tlg005.fu.sp:846.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:846.1.text#βουλευσόμεσθα. καὶ τὸ μὲν καλῶς ἔχον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:847.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:847.1.text#ὅπως χρονίζον εὖ μενεῖ βουλευτέον·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:848.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:848.1.text#ὅτῳ δὲ καὶ δεῖ φαρμάκων παιωνίων,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:849.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:849.1.text#ἤτοι κέαντες ἢ τεμόντες εὐφρόνως
urn:cts:greekLit:tlg0085.tlg005.fu.sp:850.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:850.1.text#πειρασόμεσθα πῆμ' ἀποστρέψαι νόσου.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:851.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:851.1.text#νῦν δ' ἐς μέλαθρα καὶ δόμους ἐφεστίους
urn:cts:greekLit:tlg0085.tlg005.fu.sp:852.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:852.1.text#ἐλθὼν θεοῖσι πρῶτα δεξιώσομαι,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:853.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:853.1.text#οἵπερ πρόσω πέμψαντες ἤγαγον πάλιν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:854.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:854.1.text#νίκη δ' ἐπείπερ ἕσπετ', ἐμπέδως μένοι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:855.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:855.1.text#ἄνδρες πολῖται, πρέσβος Ἀργείων τόδε,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:856.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:856.1.text#οὐκ αἰσχυνοῦμαι τοὺς φιλάνορας τρόπους
urn:cts:greekLit:tlg0085.tlg005.fu.sp:857.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:857.1.text#λέξαι πρὸς ὑμᾶς· ἐν χρόνῳ δ' ἀποφθίνει
urn:cts:greekLit:tlg0085.tlg005.fu.sp:858.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:858.1.text#τὸ τάρβος ἀνθρώποισιν. οὐκ ἄλλων πάρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:859.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:859.1.text#μαθοῦσ', ἐμαυτῆς δύσφορον λέξω βίον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:860.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:860.1.text#τοσόνδ' ὅσον περ οὗτος ἦν ὑπ' Ἰλίῳ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:861.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:861.1.text#τὸ μὲν γυναῖκα πρῶτον ἄρσενος δίχα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:862.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:862.1.text#ἧσθαι δόμοις ἔρημον ἔκπαγλον κακόν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:863.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:863.1.text#πολλὰς κλύουσαν κληδόνας παλιγκότους·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:864.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:864.1.text#καὶ τὸν μὲν ἥκειν, τὸν δ' ἐπεσφέρειν κακοῦ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:865.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:865.1.text#κάκιον ἄλλο πῆμα, λάσκοντας δόμοις.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:866.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:866.1.text#καὶ τραυμάτων μὲν εἰ τόσων ἐτύγχανεν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:867.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:867.1.text#ἀνὴρ ὅδ', ὡς πρὸς οἶκον ὠχετεύετο
urn:cts:greekLit:tlg0085.tlg005.fu.sp:868.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:868.1.text#φάτις, τέτρηται δικτύου πλέον λέγειν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:869.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:869.1.text#εἰ δ' ἦν τεθνηκώς, ὡς ἐπλήθυον λόγοι,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:870.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:870.1.text#τρισώματός τἂν Γηρυὼν ὁ δεύτερος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:871.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:871.1.text#[  πολλὴν ἄνωθεν, τὴν κάτω γὰρ οὐ λέγω,  ]
urn:cts:greekLit:tlg0085.tlg005.fu.sp:872.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:872.1.text#χθονὸς τρίμοιρον χλαῖναν ἐξηύχει λαβεῖν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:873.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:873.1.text#ἅπαξ ἑκάστῳ κατθανὼν μορφώματι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:874.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:874.1.text#τοιῶνδ' ἕκατι κληδόνων παλιγκότων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:875.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:875.1.text#πολλὰς ἄνωθεν ἀρτάνας ἐμῆς δέρης
urn:cts:greekLit:tlg0085.tlg005.fu.sp:876.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:876.1.text#ἔλυσαν ἄλλοι πρὸς βίαν λελημμένης.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:877.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:877.1.text#ἐκ τῶνδέ τοι παῖς ἐνθάδ' οὐ παραστατεῖ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:878.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:878.1.text#ἐμῶν τε καὶ σῶν κύριος πιστωμάτων,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:879.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:879.1.text#ὡς χρῆν, Ὀρέστης· μηδὲ θαυμάσῃς τόδε.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:880.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:880.1.text#τρέφει γὰρ αὐτὸν εὐμενὴς δορύξενος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:881.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:881.1.text#Στρόφιος ὁ Φωκεύς, ἀμφίλεκτα πήματα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:882.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:882.1.text#ἐμοὶ προφωνῶν, τόν θ' ὑπ' Ἰλίῳ σέθεν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:883.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:883.1.text#κίνδυνον, εἴ τε δημόθρους ἀναρχία
urn:cts:greekLit:tlg0085.tlg005.fu.sp:884.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:884.1.text#βουλὴν καταρρίψειεν, ὥστε σύγγονον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:885.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:885.1.text#βροτοῖσι τὸν πεσόντα λακτίσαι πλέον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:886.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:886.1.text#τοιάδε μέντοι σκῆψις οὐ δόλον φέρει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:887.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:887.1.text#ἔμοιγε μὲν δὴ κλαυμάτων ἐπίσσυτοι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:888.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:888.1.text#πηγαὶ κατεσβήκασιν, οὐδ' ἔνι σταγών.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:889.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:889.1.text#ἐν ὀψικοίτοις δ' ὄμμασιν βλάβας ἔχω
urn:cts:greekLit:tlg0085.tlg005.fu.sp:890.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:890.1.text#τὰς ἀμφί σοι κλαίουσα λαμπτηρουχίας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:891.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:891.1.text#ἀτημελήτους αἰέν. ἐν δ' ὀνείρασιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:892.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:892.1.text#λεπταῖς ὑπαὶ κώνωπος ἐξηγειρόμην
urn:cts:greekLit:tlg0085.tlg005.fu.sp:893.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:893.1.text#ῥιπαῖσι θωύσσοντος, ἀμφί σοι πάθη
urn:cts:greekLit:tlg0085.tlg005.fu.sp:894.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:894.1.text#ὁρῶσα πλείω τοῦ ξυνεύδοντος χρόνου.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:895.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:895.1.text#νῦν ταῦτα πάντα τλᾶσ' ἀπενθήτῳ φρενὶ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:896.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:896.1.text#λέγοιμ' ἂν ἄνδρα τόνδε τῶν σταθμῶν κύνα,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:897.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:897.1.text#σωτῆρα ναὸς πρότονον, ὑψηλῆς στέγης
urn:cts:greekLit:tlg0085.tlg005.fu.sp:898.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:898.1.text#στῦλον ποδήρη, μονογενὲς τέκνον πατρί,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:899.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:899.1.text#καὶ γῆν φανεῖσαν ναυτίλοις παρ' ἐλπίδα,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:900.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:900.1.text#κάλλιστον ἦμαρ εἰσιδεῖν ἐκ χείματος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:901.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:901.1.text#ὁδοιπόρῳ διψῶντι πηγαῖον ῥέος·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:902.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:902.1.text#τερπνὸν δὲ τἀναγκαῖον ἐκφυγεῖν ἅπαν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:903.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:903.1.text#τοιοῖσδέ τοί νιν ἀξιῶ προσφθέγμασιν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:904.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:904.1.text#φθόνος δ' ἀπέστω· πολλὰ γὰρ τὰ πρὶν κακὰ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:905.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:905.1.text#ἠνειχόμεσθα. νῦν δέ μοι, φίλον κάρα,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:906.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:906.1.text#ἔκβαιν' ἀπήνης τῆσδε, μὴ χαμαὶ τιθεὶς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:907.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:907.1.text#τὸν σὸν πόδ', ὦναξ, Ἰλίου πορθήτορα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:908.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:908.1.text#δμῳαί, τί μέλλεθ', αἷς ἐπέσταλται τέλος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:909.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:909.1.text#πέδον κελεύθου στρωννύναι πετάσμασιν;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:910.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:910.1.text#εὐθὺς γενέσθω πορφυρόστρωτος πόρος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:911.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:911.1.text#ἐς δῶμ' ἄελπτον ὡς ἂν ἡγῆται δίκη.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:912.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:912.1.text#τὰ δ' ἄλλα φροντὶς οὐχ ὕπνῳ νικωμένη
urn:cts:greekLit:tlg0085.tlg005.fu.sp:913.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:913.1.text#θήσει δικαίως σὺν θεοῖς εἱμαρμένα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:914.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:914.1.text#Λήδας γένεθλον, δωμάτων ἐμῶν φύλαξ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:915.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:915.1.text#ἀπουσίᾳ μὲν εἶπας εἰκότως ἐμῇ·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:916.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:916.1.text#μακρὰν γὰρ ἐξέτεινας· ἀλλ' ἐναισίμως
urn:cts:greekLit:tlg0085.tlg005.fu.sp:917.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:917.1.text#αἰνεῖν, παρ' ἄλλων χρὴ τόδ' ἔρχεσθαι γέρας·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:918.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:918.1.text#καὶ τἄλλα μὴ γυναικὸς ἐν τρόποις ἐμὲ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:919.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:919.1.text#ἅβρυνε, μηδὲ βαρβάρου φωτὸς δίκην
urn:cts:greekLit:tlg0085.tlg005.fu.sp:920.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:920.1.text#χαμαιπετὲς βόαμα προσχάνῃς ἐμοί,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:921.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:921.1.text#μηδ' εἵμασι στρώσασ' ἐπίφθονον πόρον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:922.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:922.1.text#τίθει· θεούς τοι τοῖσδε τιμαλφεῖν χρεών·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:923.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:923.1.text#ἐν ποικίλοις δὲ θνητὸν ὄντα κάλλεσιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:924.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:924.1.text#βαίνειν ἐμοὶ μὲν οὐδαμῶς ἄνευ φόβου.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:925.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:925.1.text#λέγω κατ' ἄνδρα, μὴ θεόν, σέβειν ἐμέ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:926.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:926.1.text#χωρὶς ποδοψήστρων τε καὶ τῶν ποικίλων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:927.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:927.1.text#κληδὼν ἀυτεῖ· καὶ τὸ μὴ κακῶς φρονεῖν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:928.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:928.1.text#θεοῦ μέγιστον δῶρον. ὀλβίσαι δὲ χρὴ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:929.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:929.1.text#βίον τελευτήσαντ' ἐν εὐεστοῖ φίλῃ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:930.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:930.1.text#εἰ πάντα δ' ὣς πράσσοιμ' ἄν, εὐθαρσὴς ἐγώ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:931.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:931.1.text#καὶ μὴν τόδ' εἰπὲ μὴ παρὰ γνώμην ἐμοί.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:932.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:932.1.text#γνώμην μὲν ἴσθι μὴ διαφθεροῦντ' ἐμέ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:933.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:933.1.text#ηὔξω θεοῖς δείσας ἂν ὧδ' ἔρδειν τάδε.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:934.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:934.1.text#εἴπερ τις, εἰδώς γ' εὖ τόδ' ἐξεῖπον τέλος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:935.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:935.1.text#τί δ' ἂν δοκεῖ σοι Πρίαμος, εἰ τάδ' ἤνυσεν;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:936.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:936.1.text#ἐν ποικίλοις ἂν κάρτα μοι βῆναι δοκεῖ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:937.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:937.1.text#μή νυν τὸν ἀνθρώπειον αἰδεσθῇς ψόγον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:938.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:938.1.text#φήμη γε μέντοι δημόθρους μέγα σθένει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:939.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:939.1.text#ὁ δ' ἀφθόνητός γ' οὐκ ἐπίζηλος πέλει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:940.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:940.1.text#οὔτοι γυναικός ἐστιν ἱμείρειν μάχης.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:941.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:941.1.text#τοῖς δ' ὀλβίοις γε καὶ τὸ νικᾶσθαι πρέπει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:942.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:942.1.text#ἦ καὶ σὺ νίκην τήνδε δήριος τίεις;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:943.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:943.1.text#πιθοῦ· κράτος μέντοι πάρες γ' ἑκὼν ἐμοί.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:944.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:944.1.text#ἀλλ' εἰ δοκεῖ σοι ταῦθ', ὑπαί τις ἀρβύλας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:945.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:945.1.text#λύοι τάχος, πρόδουλον ἔμβασιν ποδός.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:946.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:946.1.text#καὶ τοῖσδέ μ' ἐμβαίνονθ' ἁλουργέσιν θεῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:947.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:947.1.text#μή τις πρόσωθεν ὄμματος βάλοι φθόνος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:948.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:948.1.text#πολλὴ γὰρ αἰδὼς δωματοφθορεῖν ποσὶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:949.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:949.1.text#φθείροντα πλοῦτον ἀργυρωνήτους θ' ὑφάς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:950.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:950.1.text#τούτων μὲν οὕτω· τὴν ξένην δὲ πρευμενῶς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:951.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:951.1.text#τήνδ' ἐσκόμιζε· τὸν κρατοῦντα μαλθακῶς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:952.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:952.1.text#θεὸς πρόσωθεν εὐμενῶς προσδέρκεται.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:953.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:953.1.text#ἑκὼν γὰρ οὐδεὶς δουλίῳ χρῆται ζυγῷ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:954.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:954.1.text#αὕτη δὲ πολλῶν χρημάτων ἐξαίρετον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:955.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:955.1.text#ἄνθος, στρατοῦ δώρημ', ἐμοὶ ξυνέσπετο.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:956.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:956.1.text#ἐπεὶ δ' ἀκούειν σοῦ κατέστραμμαι τάδε,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:957.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:957.1.text#εἶμ' ἐς δόμων μέλαθρα πορφύρας πατῶν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:958.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:958.1.text#ἔστιν θάλασσα, τίς δέ νιν κατασβέσει;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:959.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:959.1.text#τρέφουσα πολλῆς πορφύρας ἰσάργυρον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:960.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:960.1.text#κηκῖδα παγκαίνιστον, εἱμάτων βαφάς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:961.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:961.1.text#οἶκος δ' ὑπάρχει τῶνδε σὺν θεοῖς ἅλις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:962.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:962.1.text#ἔχειν· πένεσθαι δ' οὐκ ἐπίσταται δόμος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:963.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:963.1.text#πολλῶν πατησμὸν δ' εἱμάτων ἂν ηὐξάμην,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:964.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:964.1.text#δόμοισι προυνεχθέντος ἐν χρηστηρίοις,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:965.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:965.1.text#ψυχῆς κόμιστρα τῆσδε μηχανωμένῃ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:966.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:966.1.text#ῥίζης γὰρ οὔσης φυλλὰς ἵκετ' ἐς δόμους,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:967.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:967.1.text#σκιὰν ὑπερτείνασα σειρίου κυνός.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:968.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:968.1.text#καὶ σοῦ μολόντος δωματῖτιν ἑστίαν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:969.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:969.1.text#θάλπος μὲν ἐν χειμῶνι σημαίνεις μολόν·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:970.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:970.1.text#ὅταν δὲ τεύχῃ Ζεὺς ἀπ' ὄμφακος πικρᾶς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:971.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:971.1.text#οἶνον, τότ' ἤδη ψῦχος ἐν δόμοις πέλει,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:972.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:972.1.text#ἀνδρὸς τελείου δῶμ' ἐπιστρωφωμένου.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:973.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:973.1.text#Ζεῦ, Ζεῦ τέλειε, τὰς ἐμὰς εὐχὰς τέλει·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:974.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:974.1.text#μέλοι δέ τοι σοὶ τῶν περ ἂν μέλλῃς τελεῖν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:975.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:975.1.text#τίπτε μοι τόδ' ἐμπέδως
urn:cts:greekLit:tlg0085.tlg005.fu.sp:976.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:976.1.text#δεῖμα προστατήριον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:977.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:977.1.text#καρδίας τερασκόπου ποτᾶται,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:978.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:978.1.text#μαντιπολεῖ δ' ἀκέλευστος ἄμισθος ἀοιδά,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:980.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:980.1.text#οὐδ' ἀποπτύσαι δίκαν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:981.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:981.1.text#δυσκρίτων ὀνειράτων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:982.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:982.1.text#θάρσος εὐπειθὲς ἵ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:983.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:983.1.text#ζει φρενὸς φίλον θρόνον;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:984.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:984.1.text#χρόνος δ' ἐπὶ πρυμνησίων ξυνεμβολαῖς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:985.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:985.1.text#ψαμμί' ἀκτᾶς παρή-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:986.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:986.1.text#μησεν, εὖθ' ὑπ' Ἴλιον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:987.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:987.1.text#ὦρτο ναυβάτας στρατός.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:988.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:988.1.text#πεύθομαι δ' ἀπ' ὀμμάτων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:989.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:989.1.text#νόστον, αὐτόμαρτυς ὤν·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:990.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:990.1.text#τὸν δ' ἄνευ λύρας ὅμως ὑμνῳδεῖ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:991.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:991.1.text#θρῆνον Ἐρινύος αὐτοδίδακτος ἔσωθεν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:992.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:992.1.text#θυμός, οὐ τὸ πᾶν ἔχων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:993.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:993.1.text#ἐλπίδος φίλον θράσος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:995.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:995.1.text#σπλάγχνα δ' οὔτοι ματᾴ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:996.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:996.1.text#ζει πρὸς ἐνδίκοις φρεσὶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:997.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:997.1.text#τελεσφόροις δίναις κυκώμενον κέαρ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:998.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:998.1.text#εὔχομαι δ' ἐξ ἐμᾶς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:999.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:999.1.text#ἐλπίδος ψύθη πεσεῖν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1000.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1000.1.text#ἐς τὸ μὴ τελεσφόρον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1001.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1001.1.text#μάλα γέ τοι τὸ μεγάλας ὑγιείας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1002.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1002.1.text#ἀκόρεστον τέρμα· νόσος γάρ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1003.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1003.1.text#γείτων ὁμότοιχος ἐρείδει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1005.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1005.1.text#καὶ πότμος εὐθυπορῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1006.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1006.1.text#[ … ]
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1007.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1007.1.text#ἀνδρὸς ἔπαισεν ἄφαντον ἕρμα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1008.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1008.1.text#καὶ πρὸ μέν τι χρημάτων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1009.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1009.1.text#κτησίων ὄκνος βαλὼν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1010.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1010.1.text#σφενδόνας ἀπ' εὐμέτρου,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1011.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1011.1.text#οὐκ ἔδυ πρόπας δόμος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1012.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1012.1.text#πημονᾶς γέμων ἄγαν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1013.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1013.1.text#οὐδ' ἐπόντισε σκάφος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1014.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1014.1.text#πολλά τοι δόσις ἐκ Διὸς ἀμφιλα-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1015.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1015.1.text#φής τε καὶ ἐξ ἀλόκων ἐπετειᾶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1016.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1016.1.text#νῆστιν ὤλεσεν νόσον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1017.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1017.1.text#τὸ δ' ἐπὶ γᾶν πεσὸν ἅπαξ θανάσιμον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1020.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1020.1.text#πρόπαρ ἀνδρὸς μέλαν αἷμα τίς ἂν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1021.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1021.1.text#πάλιν ἀγκαλέσαιτ' ἐπαείδων;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1022.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1022.1.text#οὐδὲ τὸν ὀρθοδαῆ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1023.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1023.1.text#τῶν φθιμένων ἀνάγειν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1024.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1024.1.text#Ζεὺς ἀπέπαυσεν ἐπ' εὐλαβείᾳ;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1025.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1025.1.text#εἰ δὲ μὴ τεταγμένα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1026.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1026.1.text#μοῖρα μοῖραν ἐκ θεῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1027.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1027.1.text#εἶργε μὴ πλέον φέρειν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1028.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1028.1.text#προφθάσασα καρδία
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1029.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1029.1.text#γλῶσσαν ἂν τάδ' ἐξέχει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1030.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1030.1.text#νῦν δ' ὑπὸ σκότῳ βρέμει
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1031.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1031.1.text#θυμαλγής τε καὶ οὐδὲν ἐπελπομέν-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1032.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1032.1.text#α ποτὲ καίριον ἐκτολυπεύσειν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1033.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1033.1.text#ζωπυρουμένας φρενός.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1035.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1035.1.text#εἴσω κομίζου καὶ σύ, Κασάνδραν λέγω,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1036.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1036.1.text#ἐπεί σ' ἔθηκε Ζεὺς ἀμηνίτως δόμοις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1037.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1037.1.text#κοινωνὸν εἶναι χερνίβων, πολλῶν μέτα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1038.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1038.1.text#δούλων σταθεῖσαν κτησίου βωμοῦ πέλας·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1039.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1039.1.text#ἔκβαιν' ἀπήνης τῆσδε, μηδ' ὑπερφρόνει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1040.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1040.1.text#καὶ παῖδα γάρ τοί φασιν Ἀλκμήνης ποτὲ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1041.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1041.1.text#πραθέντα τλῆναι δουλίας μάζης τυχεῖν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1042.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1042.1.text#εἰ δ' οὖν ἀνάγκη τῆσδ' ἐπιρρέποι τύχης,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1043.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1043.1.text#ἀρχαιοπλούτων δεσποτῶν πολλὴ χάρις.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1044.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1044.1.text#οἳ δ' οὔποτ' ἐλπίσαντες ἤμησαν καλῶς,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1045.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1045.1.text#ὠμοί τε δούλοις πάντα καὶ παρὰ στάθμην.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1046.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1046.1.text#ἔχεις παρ' ἡμῶν οἷά περ νομίζεται.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1047.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1047.1.text#σοί τοι λέγουσα παύεται σαφῆ λόγον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1048.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1048.1.text#ἐντός δ' ἂν οὖσα μορσίμων ἀγρευμάτων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1049.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1049.1.text#πείθοι' ἄν, εἰ πείθοι'· ἀπειθοίης δ' ἴσως.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1050.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1050.1.text#ἀλλ' εἴπερ ἐστι μὴ χελιδόνος δίκην
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1051.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1051.1.text#ἀγνῶτα φωνὴν βάρβαρον κεκτημένη,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1052.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1052.1.text#ἔσω φρενῶν λέγουσα πείθω νιν λόγῳ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1053.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1053.1.text#ἕπου. τὰ λῷστα τῶν παρεστώτων λέγει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1054.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1054.1.text#πιθοῦ λιποῦσα τόνδ' ἁμαξήρη θρόνον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1055.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1055.1.text#οὔτοι θυραίᾳ τῇδ' ἐμοὶ σχολὴ πάρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1056.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1056.1.text#τρίβειν· τὰ μὲν γὰρ ἑστίας μεσομφάλου
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1057.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1057.1.text#ἕστηκεν ἤδη μῆλα πρὸς σφαγὰς πάρος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1058.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1058.1.text#ὡς οὔποτ' ἐλπίσασι τήνδ' ἕξειν χάριν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1059.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1059.1.text#σὺ δ' εἴ τι δράσεις τῶνδε, μὴ σχολὴν τίθει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1060.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1060.1.text#εἰ δ' ἀξυνήμων οὖσα μὴ δέχῃ λόγον,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1061.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1061.1.text#σὺ δ' ἀντὶ φωνῆς φράζε καρβάνῳ χερί.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1062.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1062.1.text#ἑρμηνέως ἔοικεν ἡ ξένη τοροῦ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1063.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1063.1.text#δεῖσθαι· τρόπος δὲ θηρὸς ὡς νεαιρέτου.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1064.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1064.1.text#ἦ μαίνεταί γε καὶ κακῶν κλύει φρενῶν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1065.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1065.1.text#ἥτις λιποῦσα μὲν πόλιν νεαίρετον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1066.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1066.1.text#ἥκει, χαλινὸν δ' οὐκ ἐπίσταται φέρειν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1067.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1067.1.text#πρὶν αἱματηρὸν ἐξαφρίζεσθαι μένος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1068.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1068.1.text#οὐ μὴν πλέω ῥίψασ' ἀτιμασθήσομαι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1069.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1069.1.text#ἐγὼ δ', ἐποικτίρω γάρ, οὐ θυμώσομαι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1070.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1070.1.text#ἴθ', ὦ τάλαινα, τόνδ' ἐρημώσασ' ὄχον,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1071.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1071.1.text#εἴκουσ' ἀνάγκῃ τῇδε καίνισον ζυγόν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1072.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1072.1.text#ὀτοτοτοῖ πόποι δᾶ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1073.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1073.1.text#Ὦπολλον Ὦπολλον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1074.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1074.1.text#τί ταῦτ' ἀνωτότυξας ἀμφὶ Λοξίου;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1075.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1075.1.text#οὐ γὰρ τοιοῦτος ὥστε θρηνητοῦ τυχεῖν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1076.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1076.1.text#ὀτοτοτοῖ πόποι δᾶ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1077.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1077.1.text#Ὦπολλον Ὦπολλον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1078.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1078.1.text#ἡ δ' αὖτε δυσφημοῦσα τὸν θεὸν καλεῖ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1079.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1079.1.text#οὐδὲν προσήκοντ' ἐν γόοις παραστατεῖν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1080.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1080.1.text#Ἄπολλον Ἄπολλον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1081.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1081.1.text#ἀγυιᾶτ', ἀπόλλων ἐμός.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1082.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1082.1.text#ἀπώλεσας γὰρ οὐ μόλις τὸ δεύτερον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1083.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1083.1.text#χρήσειν ἔοικεν ἀμφὶ τῶν αὑτῆς κακῶν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1084.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1084.1.text#μένει τὸ θεῖον δουλίᾳ περ ἐν φρενί.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1085.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1085.1.text#Ἄπολλον Ἄπολλον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1086.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1086.1.text#ἀγυιᾶτ', ἀπόλλων ἐμός.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1087.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1087.1.text#ἆ ποῖ ποτ' ἤγαγές με; πρὸς ποίαν στέγην;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1088.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1088.1.text#πρὸς τὴν Ἀτρειδῶν· εἰ σὺ μὴ τόδ' ἐννοεῖς,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1089.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1089.1.text#ἐγὼ λέγω σοι· καὶ τάδ' οὐκ ἐρεῖς ψύθη.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1090.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1090.1.text#μισόθεον μὲν οὖν, πολλὰ συνίστορα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1091.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1091.1.text#αὐτόφονα κακὰ καρατόμα,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1092.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1092.1.text#ἀνδροσφαγεῖον καὶ πεδορραντήριον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1093.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1093.1.text#ἔοικεν εὔρις ἡ ξένη κυνὸς δίκην
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1094.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1094.1.text#εἶναι, ματεύει δ' ὧν ἀνευρήσει φόνον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1095.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1095.1.text#μαρτυρίοισι γὰρ τοῖσδ' ἐπιπείθομαι·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1096.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1096.1.text#κλαιόμενα τάδε βρέφη σφαγάς,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1097.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1097.1.text#ὀπτάς τε σάρκας πρὸς πατρὸς βεβρωμένας.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1098.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1098.1.text#τὸ μὲν κλέος σοῦ μαντικὸν πεπυσμένοι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1099.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1099.1.text#ἦμεν· προφήτας δ' οὔτινας ματεύομεν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1100.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1100.1.text#ἰὼ πόποι, τί ποτε μήδεται;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1101.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1101.1.text#τί τόδε νέον ἄχος μέγα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1102.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1102.1.text#μέγ' ἐν δόμοισι τοῖσδε μήδεται κακὸν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1103.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1103.1.text#ἄφερτον φίλοισιν, δυσίατον; ἀλκὰ δ'
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1104.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1104.1.text#ἑκὰς ἀποστατεῖ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1105.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1105.1.text#τούτων ἄιδρίς εἰμι τῶν μαντευμάτων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1106.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1106.1.text#ἐκεῖνα δ' ἔγνων· πᾶσα γὰρ πόλις βοᾷ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1107.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1107.1.text#ἰὼ τάλαινα, τόδε γὰρ τελεῖς,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1108.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1108.1.text#τὸν ὁμοδέμνιον πόσιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1109.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1109.1.text#λουτροῖσι φαιδρύνασα—πῶς φράσω τέλος;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1110.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1110.1.text#τάχος γὰρ τόδ' ἔσται· προτείνει δὲ χεὶρ ἐκ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1111.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1111.1.text#χερὸς ὀρέγματα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1112.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1112.1.text#οὔπω ξυνῆκα· νῦν γὰρ ἐξ αἰνιγμάτων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1113.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1113.1.text#ἐπαργέμοισι θεσφάτοις ἀμηχανῶ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1114.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1114.1.text#ἒ ἔ, παπαῖ παπαῖ, τί τόδε φαίνεται;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1115.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1115.1.text#ἦ δίκτυόν τί γ' Ἅιδου;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1116.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1116.1.text#ἀλλ' ἄρκυς ἡ ξύνευνος, ἡ ξυναιτία
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1117.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1117.1.text#φόνου. στάσις δ' ἀκόρετος γένει
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1118.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1118.1.text#κατολολυξάτω θύματος λευσίμου.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1119.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1119.1.text#ποίαν Ἐρινὺν τήνδε δώμασιν κέλῃ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1120.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1120.1.text#ἐπορθιάζειν; οὔ με φαιδρύνει λόγος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1121.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1121.1.text#ἐπὶ δὲ καρδίαν ἔδραμε κροκοβαφὴς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1122.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1122.1.text#σταγών, ἅτε καιρία πτώσιμος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1123.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1123.1.text#ξυνανύτει βίου δύντος αὐγαῖς·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1124.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1124.1.text#ταχεῖα δ' ἄτα πέλει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1125.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1125.1.text#ἆ ἆ, ἰδοὺ ἰδού· ἄπεχε τῆς βοὸς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1126.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1126.1.text#τὸν ταῦρον· ἐν πέπλοισι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1127.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1127.1.text#μελαγκέρῳ λαβοῦσα μηχανήματι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1128.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1128.1.text#τύπτει· πίτνει δ' { ἐν } ἐνύδρῳ τεύχει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1129.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1129.1.text#δολοφόνου λέβητος τύχαν σοι λέγω.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1130.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1130.1.text#οὐ κομπάσαιμ' ἂν θεσφάτων γνώμων ἄκρος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1131.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1131.1.text#εἶναι, κακῷ δέ τῳ προσεικάζω τάδε.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1132.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1132.1.text#ἀπὸ δὲ θεσφάτων τίς ἀγαθὰ φάτις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1133.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1133.1.text#βροτοῖς τέλλεται; κακῶν γὰρ διαὶ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1134.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1134.1.text#πολυεπεῖς τέχναι θεσπιῳδὸν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1135.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1135.1.text#φόβον φέρουσιν μαθεῖν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1136.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1136.1.text#ἰὼ ἰὼ ταλαίνας κακόποτμοι τύχαι·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1137.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1137.1.text#τὸ γὰρ ἐμὸν θροῶ πάθος ἐπεγχύδαν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1138.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1138.1.text#ποῖ δή με δεῦρο τὴν τάλαιναν ἤγαγες;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1139.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1139.1.text#οὐδέν ποτ' εἰ μὴ ξυνθανουμένην. τί γάρ;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1140.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1140.1.text#φρενομανής τις εἶ θεοφόρητος, ἀμ-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1141.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1141.1.text#φὶ δ' αὑτᾶς θροεῖς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1142.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1142.1.text#νόμον ἄνομον, οἷά τις ξουθὰ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1143.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1143.1.text#ἀκόρετος βοᾶς, φεῦ, ταλαίναις φρεσίν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1144.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1144.1.text#Ἴτυν Ἴτυν στένουσ' ἀμφιθαλῆ κακοῖς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1145.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1145.1.text#ἀηδὼν βίον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1146.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1146.1.text#ἰὼ ἰὼ λιγείας μόρον ἀηδόνος·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1147.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1147.1.text#περέβαλον γάρ οἱ πτεροφόρον δέμας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1148.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1148.1.text#θεοὶ γλυκύν τ' αἰῶνα κλαυμάτων ἄτερ·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1149.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1149.1.text#ἐμοὶ δὲ μίμνει σχισμὸς ἀμφήκει δορί.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1150.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1150.1.text#πόθεν ἐπισσύτους θεοφόρους [ τ' ] ἔχεις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1151.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1151.1.text#ματαίους δύας,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1152.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1152.1.text#τὰ δ' ἐπίφοβα δυσφάτῳ κλαγγᾷ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1153.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1153.1.text#μελοτυπεῖς ὁμοῦ τ' ὀρθίοις ἐν νόμοις;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1154.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1154.1.text#πόθεν ὅρους ἔχεις θεσπεσίας ὁδοῦ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1155.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1155.1.text#κακορρήμονας;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1156.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1156.1.text#ἰὼ γάμοι γάμοι Πάριδος ὀλέθριοι φίλων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1157.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1157.1.text#ἰὼ Σκαμάνδρου πάτριον ποτόν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1158.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1158.1.text#τότε μὲν ἀμφὶ σὰς ἀϊόνας τάλαιν'
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1159.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1159.1.text#ἠνυτόμαν τροφαῖς·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1160.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1160.1.text#νῦν δ' ἀμφὶ Κωκυτόν τε κἀχερουσίους
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1161.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1161.1.text#ὄχθας ἔοικα θεσπιῳδήσειν τάχα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1162.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1162.1.text#τί τόδε τορὸν ἄγαν ἔπος ἐφημίσω;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1163.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1163.1.text#νεόγονος ἂν ἀΐων μάθοι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1164.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1164.1.text#πέπληγμαι δ' ὑπαὶ δάκει φοινίῳ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1165.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1165.1.text#δυσαλγεῖ τύχᾳ μινυρὰ [ κακὰ ] θρεομένας,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1166.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1166.1.text#θραύματ' ἐμοὶ κλύειν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1167.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1167.1.text#ἰὼ πόνοι πόνοι πόλεος ὀλομένας τὸ πᾶν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1168.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1168.1.text#ἰὼ πρόπυργοι θυσίαι πατρὸς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1169.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1169.1.text#πολυκανεῖς βοτῶν ποιονόμων· ἄκος δ'
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1170.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1170.1.text#οὐδὲν ἐπήρκεσαν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1171.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1171.1.text#τὸ μὴ πόλιν μὲν ὥσπερ οὖν ἔχει παθεῖν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1172.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1172.1.text#ἐγὼ δὲ θερμόνους τάχ' ἐν πέδῳ βαλῶ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1173.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1173.1.text#ἑπόμενα προτέροισι τάδ' ἐφημίσω.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1174.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1174.1.text#καί τίς σε κακοφρονῶν τίθη-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1175.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1175.1.text#σι δαίμων ὑπερβαρὴς ἐμπίτνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1176.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1176.1.text#μελίζειν πάθη γοερὰ θανατοφόρα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1177.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1177.1.text#τέρμα δ' ἀμηχανῶ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1178.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1178.1.text#καὶ μὴν ὁ χρησμὸς οὐκέτ' ἐκ καλυμμάτων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1179.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1179.1.text#ἔσται δεδορκὼς νεογάμου νύμφης δίκην·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1180.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1180.1.text#λαμπρὸς δ' ἔοικεν ἡλίου πρὸς ἀντολὰς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1181.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1181.1.text#πνέων ἐσᾴξειν, ὥστε κύματος δίκην
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1182.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1182.1.text#κλύζειν πρὸς αὐγὰς τοῦδε πήματος πολὺ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1183.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1183.1.text#μεῖζον· φρενώσω δ' οὐκέτ' ἐξ αἰνιγμάτων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1184.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1184.1.text#καὶ μαρτυρεῖτε συνδρόμως ἴχνος κακῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1185.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1185.1.text#ῥινηλατούσῃ τῶν πάλαι πεπραγμένων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1186.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1186.1.text#τὴν γὰρ στέγην τήνδ' οὔποτ' ἐκλείπει χορὸς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1187.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1187.1.text#ξύμφθογγος οὐκ εὔφωνος· οὐ γὰρ εὖ λέγει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1188.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1188.1.text#καὶ μὴν πεπωκώς γ', ὡς θρασύνεσθαι πλέον,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1189.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1189.1.text#βρότειον αἷμα κῶμος ἐν δόμοις μένει,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1190.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1190.1.text#δύσπεμπτος ἔξω, συγγόνων Ἐρινύων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1191.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1191.1.text#ὑμνοῦσι δ' ὕμνον δώμασιν προσήμεναι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1192.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1192.1.text#πρώταρχον ἄτην· ἐν μέρει δ' ἀπέπτυσαν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1193.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1193.1.text#εὐνὰς ἀδελφοῦ τῷ πατοῦντι δυσμενεῖς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1194.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1194.1.text#ἥμαρτον, ἢ θηρῶ τι τοξότης τις ὥς;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1195.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1195.1.text#ἢ ψευδόμαντίς εἰμι θυροκόπος φλέδων;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1196.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1196.1.text#ἐκμαρτύρησον προυμόσας τό μ' εἰδέναι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1197.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1197.1.text#λόγῳ παλαιὰς τῶνδ' ἁμαρτίας δόμων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1198.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1198.1.text#καὶ πῶς ἂν ὅρκος, πῆγμα γενναίως παγέν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1199.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1199.1.text#παιώνιον γένοιτο; θαυμάζω δέ σου,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1200.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1200.1.text#πόντου πέραν τραφεῖσαν ἀλλόθρουν πόλιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1201.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1201.1.text#κυρεῖν λέγουσαν, ὥσπερ εἰ παρεστάτεις.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1202.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1202.1.text#μάντις μ' Ἀπόλλων τῷδ' ἐπέστησεν τέλει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1204.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1204.1.text#μῶν καὶ θεός περ ἱμέρῳ πεπληγμένος;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1203.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1203.1.text#προτοῦ μὲν αἰδὼς ἦν ἐμοὶ λέγειν τάδε.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1205.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1205.1.text#ἁβρύνεται γὰρ πᾶς τις εὖ πράσσων πλέον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1206.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1206.1.text#ἀλλ' ἦν παλαιστὴς κάρτ' ἐμοὶ πνέων χάριν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1207.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1207.1.text#ἦ καὶ τέκνων εἰς ἔργον ἤλθετον νόμῳ;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1208.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1208.1.text#ξυναινέσασα Λοξίαν ἐψευσάμην.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1209.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1209.1.text#ἤδη τέχναισιν ἐνθέοις ᾑρημένη;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1210.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1210.1.text#ἤδη πολίταις πάντ' ἐθέσπιζον πάθη.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1211.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1211.1.text#πῶς δῆτ' ἄνατος ἦσθα Λοξίου κότῳ;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1212.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1212.1.text#ἔπειθον οὐδέν' οὐδέν, ὡς τάδ' ἤμπλακον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1213.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1213.1.text#ἡμῖν γε μὲν δὴ πιστὰ θεσπίζειν δοκεῖς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1214.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1214.1.text#ἰοὺ ἰού, ὢ ὢ κακά.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1215.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1215.1.text#ὑπ' αὖ με δεινὸς ὀρθομαντείας πόνος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1216.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1216.1.text#στροβεῖ ταράσσων φροιμίοις { δυσφροιμίοις }.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1217.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1217.1.text#ὁρᾶτε τούσδε τοὺς δόμοις ἐφημένους
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1218.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1218.1.text#νέους, ὀνείρων προσφερεῖς μορφώμασιν;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1219.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1219.1.text#παῖδες θανόντες ὡσπερεὶ πρὸς τῶν φίλων,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1220.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1220.1.text#χεῖρας κρεῶν πλήθοντες οἰκείας βορᾶς,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1221.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1221.1.text#σὺν ἐντέροις τε σπλάγχν', ἐποίκτιστον γέμος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1222.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1222.1.text#πρέπουσ' ἔχοντες, ὧν πατὴρ ἐγεύσατο.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1223.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1223.1.text#ἐκ τῶνδε ποινὰς φημὶ βουλεύειν τινὰ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1224.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1224.1.text#λέοντ' ἄναλκιν ἐν λέχει στρωφώμενον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1225.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1225.1.text#οἰκουρόν, οἴμοι, τῷ μολόντι δεσπότῃ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1226.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1226.1.text#ἐμῷ· φέρειν γὰρ χρὴ τὸ δούλιον ζυγόν·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1227.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1227.1.text#νεῶν τ' ἄπαρχος Ἰλίου τ' ἀναστάτης
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1228.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1228.1.text#οὐκ οἶδεν οἷα γλῶσσα μισητῆς κυνὸς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1229.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1229.1.text#λείξασα κἀκτείνασα φαιδρὸν οὖς, δίκην
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1230.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1230.1.text#Ἄτης λαθραίου, τεύξεται κακῇ τύχῃ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1231.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1231.1.text#τοιάδε τόλμα· θῆλυς ἄρσενος φονεὺς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1232.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1232.1.text#ἔστιν. τί νιν καλοῦσα δυσφιλὲς δάκος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1233.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1233.1.text#τύχοιμ' ἄν; ἀμφίσβαιναν, ἢ Σκύλλαν τινὰ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1234.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1234.1.text#οἰκοῦσαν ἐν πέτραισι, ναυτίλων βλάβην,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1235.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1235.1.text#θύουσαν Ἅιδου μητέρ' ἄσπονδόν τ' Ἄρη
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1236.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1236.1.text#φίλοις πνέουσαν; ὡς δ' ἐπωλολύξατο
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1237.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1237.1.text#ἡ παντότολμος, ὥσπερ ἐν μάχης τροπῇ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1238.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1238.1.text#δοκεῖ δὲ χαίρειν νοστίμῳ σωτηρίᾳ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1239.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1239.1.text#καὶ τῶνδ' ὅμοιον εἴ τι μὴ πείθω· τί γάρ;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1240.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1240.1.text#τὸ μέλλον ἥξει. καὶ σύ μ' ἐν τάχει παρὼν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1241.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1241.1.text#ἄγαν γ' ἀληθόμαντιν οἰκτίρας ἐρεῖς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1242.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1242.1.text#τὴν μὲν Θυέστου δαῖτα παιδείων κρεῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1243.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1243.1.text#ξυνῆκα καὶ πέφρικα, καὶ φόβος μ' ἔχει
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1244.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1244.1.text#κλύοντ' ἀληθῶς οὐδὲν ἐξῃκασμένα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1245.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1245.1.text#τὰ δ' ἄλλ' ἀκούσας ἐκ δρόμου πεσὼν τρέχω.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1246.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1246.1.text#Ἀγαμέμνονός σέ φημ' ἐπόψεσθαι μόρον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1247.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1247.1.text#εὔφημον, ὦ τάλαινα, κοίμησον στόμα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1248.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1248.1.text#ἀλλ' οὔτι παιὼν τῷδ' ἐπιστατεῖ λόγῳ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1249.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1249.1.text#οὔκ, εἴπερ ἔσται γ'· ἀλλὰ μὴ γένοιτό πως.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1250.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1250.1.text#σὺ μὲν κατεύχῃ, τοῖς δ' ἀποκτείνειν μέλει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1251.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1251.1.text#τίνος πρὸς ἀνδρὸς τοῦτ' ἄγος πορσύνεται;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1252.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1252.1.text#ἦ κάρτα τἄρ' ἂν παρεκόπης χρησμῶν ἐμῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1253.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1253.1.text#τοῦ γὰρ τελοῦντος οὐ ξυνῆκα μηχανήν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1254.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1254.1.text#καὶ μὴν ἄγαν γ' Ἕλλην' ἐπίσταμαι φάτιν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1255.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1255.1.text#καὶ γὰρ τὰ πυθόκραντα· δυσμαθῆ δ' ὅμως.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1256.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1256.1.text#παπαῖ, οἷον τὸ πῦρ· ἐπέρχεται δέ μοι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1257.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1257.1.text#ὀτοτοῖ, Λύκει' Ἄπολλον, οἲ ἐγὼ ἐγώ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1258.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1258.1.text#αὕτη δίπους λέαινα συγκοιμωμένη
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1259.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1259.1.text#λύκῳ, λέοντος εὐγενοῦς ἀπουσίᾳ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1260.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1260.1.text#κτενεῖ με τὴν τάλαιναν· ὡς δὲ φάρμακον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1261.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1261.1.text#τεύχουσα κἀμοῦ μισθὸν ἐνθήσειν κότῳ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1262.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1262.1.text#ἐπεύχεται, θήγουσα φωτὶ φάσγανον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1263.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1263.1.text#ἐμῆς ἀγωγῆς ἀντιτείσασθαι φόνον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1264.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1264.1.text#τί δῆτ' ἐμαυτῆς καταγέλωτ' ἔχω τάδε,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1265.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1265.1.text#καὶ σκῆπτρα καὶ μαντεῖα περὶ δέρῃ στέφη;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1266.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1266.1.text#σὲ μὲν πρὸ μοίρας τῆς ἐμῆς διαφθερῶ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1267.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1267.1.text#ἴτ' ἐς φθόρον· πεσόντα γ' ὧδ' ἀμείβομαι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1268.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1268.1.text#ἄλλην τιν' ἄτης ἀντ' ἐμοῦ πλουτίζετε.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1269.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1269.1.text#ἰδοὺ δ' Ἀπόλλων αὐτὸς ἐκδύων ἐμὲ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1270.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1270.1.text#χρηστηρίαν ἐσθῆτ', ἐποπτεύσας δέ με
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1271.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1271.1.text#κἀν τοῖσδε κόσμοις καταγελωμένην μέγα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1272.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1272.1.text#φίλων ὑπ' ἐχθρῶν οὐ διχορρόπως, μάτην—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1273.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1273.1.text#καλουμένη δὲ φοιτὰς ὡς ἀγύρτρια
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1274.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1274.1.text#πτωχὸς τάλαινα λιμοθνὴς ἠνεσχόμην—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1275.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1275.1.text#καὶ νῦν ὁ μάντις μάντιν ἐκπράξας ἐμὲ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1276.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1276.1.text#ἀπήγαγ' ἐς τοιάσδε θανασίμους τύχας.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1277.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1277.1.text#βωμοῦ πατρῴου δ' ἀντ' ἐπίξηνον μένει,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1278.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1278.1.text#θερμῷ κοπείσης φοινίῳ προσφάγματι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1279.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1279.1.text#οὐ μὴν ἄτιμοί γ' ἐκ θεῶν τεθνήξομεν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1280.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1280.1.text#ἥξει γὰρ ἡμῶν ἄλλος αὖ τιμάορος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1281.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1281.1.text#μητροκτόνον φίτυμα, ποινάτωρ πατρός·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1282.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1282.1.text#φυγὰς δ' ἀλήτης τῆσδε γῆς ἀπόξενος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1283.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1283.1.text#κάτεισιν, ἄτας τάσδε θριγκώσων φίλοις·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1284.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1284.1.text#ὀμώμοται γὰρ ὅρκος ἐκ θεῶν μέγας,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1285.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1285.1.text#ἄξειν νιν ὑπτίασμα κειμένου πατρός.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1286.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1286.1.text#τί δῆτ' ἐγὼ κάτοικτος ὧδ' ἀναστένω;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1287.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1287.1.text#ἐπεὶ τὸ πρῶτον εἶδον Ἰλίου πόλιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1288.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1288.1.text#πράξασαν ὡς ἔπραξεν, οἳ δ' εἷλον πόλιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1289.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1289.1.text#οὕτως ἀπαλλάσσουσιν ἐν θεῶν κρίσει,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1290.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1290.1.text#ἰοῦσα πράξω· τλήσομαι τὸ κατθανεῖν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1291.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1291.1.text#Ἅιδου πύλας δὲ τάσδ' ἐγὼ προσεννέπω·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1292.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1292.1.text#ἐπεύχομαι δὲ καιρίας πληγῆς τυχεῖν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1293.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1293.1.text#ὡς ἀσφάδαστος, αἱμάτων εὐθνησίμων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1294.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1294.1.text#ἀπορρυέντων, ὄμμα συμβάλω τόδε.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1295.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1295.1.text#ὦ πολλὰ μὲν τάλαινα, πολλὰ δ' αὖ σοφὴ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1296.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1296.1.text#γύναι, μακρὰν ἔτεινας. εἰ δ' ἐτητύμως
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1297.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1297.1.text#μόρον τὸν αὑτῆς οἶσθα, πῶς θεηλάτου
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1298.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1298.1.text#βοὸς δίκην πρὸς βωμὸν εὐτόλμως πατεῖς;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1299.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1299.1.text#οὐκ ἔστ' ἄλυξις, οὔ, ξένοι, χρόνον πλέω.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1300.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1300.1.text#ὁ δ' ὕστατός γε τοῦ χρόνου πρεσβεύεται,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1301.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1301.1.text#ἥκει τόδ' ἦμαρ· σμικρὰ κερδανῶ φυγῇ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1302.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1302.1.text#ἀλλ' ἴσθι τλήμων οὖσ' ἀπ' εὐτόλμου φρενός.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1303.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1303.1.text#οὐδεὶς ἀκούει ταῦτα τῶν εὐδαιμόνων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1304.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1304.1.text#ἀλλ' εὐκλεῶς τοι κατθανεῖν χάρις βροτῷ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1305.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1305.1.text#ἰὼ πάτερ σοῦ σῶν τε γενναίων τέκνων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1306.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1306.1.text#τί δ' ἐστὶ χρῆμα; τίς σ' ἀποστρέφει φόβος;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1307.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1307.1.text#φεῦ φεῦ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1308.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1308.1.text#τί τοῦτ' ἔφευξας; εἴ τι μὴ φρενῶν στύγος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1309.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1309.1.text#φόνον δόμοι πνέουσιν αἱματοσταγῆ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1310.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1310.1.text#καί πῶς;τόδ' ὄζει θυμάτων ἐφεστίων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1311.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1311.1.text#ὅμοιος ἀτμὸς ὥσπερ ἐκ τάφου πρέπει,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1312.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1312.1.text#οὐ Σύριον ἀγλάισμα δώμασιν λέγεις.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1313.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1313.1.text#ἀλλ' εἶμι κἀν δόμοισι κωκύσουσ' ἐμὴν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1314.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1314.1.text#Ἀγαμέμνονός τε μοῖραν. ἀρκείτω βίος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1315.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1315.1.text#ἰὼ ξένοι,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1316.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1316.1.text#οὔτοι δυσοίζω θάμνον ὡς ὄρνις φόβῳ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1317.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1317.1.text#ἄλλως· θανούσῃ μαρτυρεῖτέ μοι τόδε,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1318.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1318.1.text#ὅταν γυνὴ γυναικὸς ἀντ' ἐμοῦ θάνῃ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1319.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1319.1.text#ἀνήρ τε δυσδάμαρτος ἀντ' ἀνδρὸς πέσῃ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1320.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1320.1.text#ἐπιξενοῦμαι ταῦτα δ' ὡς θανουμένη.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1321.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1321.1.text#ὦ τλῆμον, οἰκτίρω σε θεσφάτου μόρου.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1322.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1322.1.text#ἅπαξ ἔτ' εἰπεῖν ῥῆσιν οὐ θρῆνον θέλω
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1323.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1323.1.text#ἐμὸν τὸν αὐτῆς. ἡλίῳ δ' ἐπεύχομαι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1324.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1324.1.text#πρὸς ὕστατον φῶς { τοῖς ἐμοῖς τιμαόροις }
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1325.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1325.1.text#{ ἐχθροῖς φονεῦσι τοῖς ἐμοῖς τίνειν ὁμοῦ, }
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1326.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1326.1.text#δούλης θανούσης, εὐμαροῦς χειρώματος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1327.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1327.1.text#ἰὼ βρότεια πράγματ'· εὐτυχοῦντα μὲν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1328.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1328.1.text#σκιά τις ἂν τρέψειεν· εἰ δὲ δυστυχῇ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1329.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1329.1.text#βολαῖς ὑγρώσσων σπόγγος ὤλεσεν γραφήν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1330.1.speaker#Κασάνδρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1330.1.text#καὶ ταῦτ' ἐκείνων μᾶλλον οἰκτίρω πολύ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1331.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1331.1.text#τὸ μὲν εὖ πράσσειν ἀκόρεστον ἔφυ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1332.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1332.1.text#πᾶσι βροτοῖσιν· δακτυλοδείκτων δ'
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1333.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1333.1.text#οὔτις ἀπειπὼν εἴργει μελάθρων,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1334.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1334.1.text#μηκέτ' ἐσέλθῃς, τάδε φωνῶν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1335.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1335.1.text#καὶ τῷδε πόλιν μὲν ἑλεῖν ἔδοσαν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1336.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1336.1.text#μάκαρες Πριάμου·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1337.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1337.1.text#θεοτίμητος δ' οἴκαδ' ἱκάνει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1338.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1338.1.text#νῦν δ' εἰ προτέρων αἷμ' ἀποτείσῃ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1339.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1339.1.text#καὶ τοῖσι θανοῦσι θανὼν ἄλλων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1340.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1340.1.text#ποινὰς θανάτων ἐπικράνῃ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1341.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1341.1.text#τίς ἂν { ἐξ }εύξαιτο βροτῶν ἀσινεῖ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1342.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1342.1.text#δαίμονι φῦναι τάδ' ἀκούων;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1343.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1343.1.text#ὤμοι, πέπληγμαι καιρίαν πληγὴν ἔσω.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1344.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1344.1.text#σῖγα· τίς πληγὴν ἀυτεῖ καιρίως οὐτασμένος;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1345.1.speaker#Ἀγαμέμνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1345.1.text#ὤμοι μάλ' αὖθις, δευτέραν πεπληγμένος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1346.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1346.1.text#τοὔργον εἰργάσθαι δοκεῖ μοι βασιλέως οἰμώγμασιν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1347.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1347.1.text#ἀλλὰ κοινωσώμεθ' ἤν πως ἀσφαλῆ βουλεύματα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1348.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1348.1.text#—ἐγὼ μὲν ὑμῖν τὴν ἐμὴν γνώμην λέγω,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1349.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1349.1.text#πρὸς δῶμα δεῦρ' ἀστοῖσι κηρύσσειν βοήν.—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1350.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1350.1.text#—ἐμοὶ δ' ὅπως τάχιστά γ' ἐμπεσεῖν δοκεῖ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1351.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1351.1.text#καὶ πρᾶγμ' ἐλέγχειν σὺν νεορρύτῳ ξίφει.—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1352.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1352.1.text#—κἀγὼ τοιούτου γνώματος κοινωνὸς ὢν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1353.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1353.1.text#ψηφίζομαί τι δρᾶν· τὸ μὴ μέλλειν δ' ἀκμή.—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1354.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1354.1.text#—ὁρᾶν πάρεστι· φροιμιάζονται γὰρ ὡς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1355.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1355.1.text#τυραννίδος σημεῖα πράσσοντες πόλει.—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1356.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1356.1.text#—χρονίζομεν γάρ. οἱ δὲ τῆς μελλοῦς κλέος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1357.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1357.1.text#πέδοι πατοῦντες οὐ καθεύδουσιν χερί.—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1358.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1358.1.text#—οὐκ οἶδα βουλῆς ἧστινος τυχὼν λέγω.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1359.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1359.1.text#τοῦ δρῶντός ἐστι καὶ τὸ βουλεῦσαι πέρι.—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1360.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1360.1.text#—κἀγὼ τοιοῦτός εἰμ', ἐπεὶ δυσμηχανῶ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1361.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1361.1.text#λόγοισι τὸν θανόντ' ἀνιστάναι πάλιν.—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1362.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1362.1.text#—ἦ καὶ βίον τείνοντες ὧδ' ὑπείξομεν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1363.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1363.1.text#δόμων καταισχυντῆρσι τοῖσδ' ἡγουμένοις;—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1364.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1364.1.text#—ἀλλ' οὐκ ἀνεκτόν,ἀλλὰ κατθανεῖν κρατεῖ·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1365.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1365.1.text#πεπαιτέρα γὰρ μοῖρα τῆς τυραννίδος.—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1366.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1366.1.text#—ἦ γὰρ τεκμηρίοισιν ἐξ οἰμωγμάτων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1367.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1367.1.text#μαντευσόμεσθα τἀνδρὸς ὡς ὀλωλότος;—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1368.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1368.1.text#—σάφ' εἰδότας χρὴ τῶνδε θυμοῦσθαι πέρι·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1369.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1369.1.text#τὸ γὰρ τοπάζειν τοῦ σάφ' εἰδέναι δίχα.—
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1370.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1370.1.text#—ταύτην ἐπαινεῖν πάντοθεν πληθύνομαι,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1371.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1371.1.text#τρανῶς Ἀτρείδην εἰδέναι κυροῦνθ' ὅπως.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1372.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1372.1.text#πολλῶν πάροιθεν καιρίως εἰρημένων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1373.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1373.1.text#τἀναντί' εἰπεῖν οὐκ ἐπαισχυνθήσομαι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1374.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1374.1.text#πῶς γάρ τις ἐχθροῖς ἐχθρὰ πορσύνων, φίλοις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1375.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1375.1.text#δοκοῦσιν εἶναι, πημονῆς ἀρκύστατ' ἂν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1376.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1376.1.text#φράξειεν, ὕψος κρεῖσσον ἐκπηδήματος;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1377.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1377.1.text#ἐμοὶ δ' ἀγὼν ὅδ' οὐκ ἀφρόντιστος πάλαι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1378.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1378.1.text#νείκης παλαιᾶς ἦλθε, σὺν χρόνῳ γε μήν·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1379.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1379.1.text#ἕστηκα δ' ἔνθ' ἔπαισ' ἐπ' ἐξειργασμένοις.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1380.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1380.1.text#οὕτω δ' ἔπραξα, καὶ τάδ' οὐκ ἀρνήσομαι·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1381.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1381.1.text#ὡς μήτε φεύγειν μήτ' ἀμύνεσθαι μόρον,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1382.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1382.1.text#ἄπειρον ἀμφίβληστρον, ὥσπερ ἰχθύων,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1383.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1383.1.text#περιστιχίζω, πλοῦτον εἵματος κακόν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1384.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1384.1.text#παίω δέ νιν δίς· κἀν δυοῖν οἰμωγμάτοιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1385.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1385.1.text#μεθῆκεν αὑτοῦ κῶλα· καὶ πεπτωκότι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1386.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1386.1.text#τρίτην ἐπενδίδωμι, τοῦ κατὰ χθονὸς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1387.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1387.1.text#Διὸς νεκρῶν σωτῆρος εὐκταίαν χάριν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1388.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1388.1.text#οὕτω τὸν αὑτοῦ θυμὸν ὁρμαίνει πεσών·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1389.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1389.1.text#κἀκφυσιῶν ὀξεῖαν αἵματος σφαγὴν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1390.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1390.1.text#βάλλει μ' ἐρεμνῇ ψακάδι φοινίας δρόσου,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1391.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1391.1.text#χαίρουσαν οὐδὲν ἧσσον ἢ διοσδότῳ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1392.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1392.1.text#γάνει σπορητὸς κάλυκος ἐν λοχεύμασιν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1393.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1393.1.text#ὡς ὧδ' ἐχόντων, πρέσβος Ἀργείων τόδε,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1394.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1394.1.text#χαίροιτ' ἄν, εἰ χαίροιτ', ἐγὼ δ' ἐπεύχομαι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1395.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1395.1.text#εἰ δ' ἦν πρεπόντων ὥστ' ἐπισπένδειν νεκρῷ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1396.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1396.1.text#τῷδ' ἂν δικαίως ἦν, ὑπερδίκως μὲν οὖν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1397.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1397.1.text#τοσῶνδε κρατῆρ' ἐν δόμοις κακῶν ὅδε
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1398.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1398.1.text#πλήσας ἀραίων αὐτὸς ἐκπίνει μολών.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1399.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1399.1.text#θαυμάζομέν σου γλῶσσαν, ὡς θρασύστομος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1400.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1400.1.text#ἥτις τοιόνδ' ἐπ' ἀνδρὶ κομπάζεις λόγον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1401.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1401.1.text#πειρᾶσθέ μου γυναικὸς ὡς ἀφράσμονος·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1402.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1402.1.text#ἐγὼ δ' ἀτρέστῳ καρδίᾳ πρὸς εἰδότας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1403.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1403.1.text#λέγω· σὺ δ' αἰνεῖν εἴτε με ψέγειν θέλεις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1404.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1404.1.text#ὅμοιον. οὗτός ἐστιν Ἀγαμέμνων, ἐμὸς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1405.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1405.1.text#πόσις, νεκρὸς δέ, τῆσδε δεξιᾶς χερὸς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1406.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1406.1.text#ἔργον, δικαίας τέκτονος. τάδ' ὧδ' ἔχει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1407.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1407.1.text#τί κακόν, ὦ γύναι,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1407.2.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1407.2.text#χθονοτρεφὲς ἐδανὸν ἢ ποτὸν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1408.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1408.1.text#πασαμένα ῥυτᾶς ἐξ ἁλὸς ὀρόμενον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1409.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1409.1.text#τόδ' ἐπέθου θύος, δημοθρόους τ' ἀράς;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1410.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1410.1.text#ἀπέδικες ἀπέταμες· ἀπόπολις δ' ἔσῃ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1411.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1411.1.text#μῖσος ὄβριμον ἀστοῖς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1412.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1412.1.text#νῦν μὲν δικάζεις ἐκ πόλεως φυγὴν ἐμοὶ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1413.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1413.1.text#καὶ μῖσος ἀστῶν δημόθρους τ' ἔχειν ἀράς,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1414.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1414.1.text#οὐδὲν τότ' ἀνδρὶ τῷδ' ἐναντίον φέρων·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1415.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1415.1.text#ὃς οὐ προτιμῶν, ὡσπερεὶ βοτοῦ μόρον,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1416.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1416.1.text#μήλων φλεόντων εὐπόκοις νομεύμασιν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1417.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1417.1.text#ἔθυσεν αὑτοῦ παῖδα, φιλτάτην ἐμοὶ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1418.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1418.1.text#ὠδῖν', ἐπῳδὸν Θρῃκίων ἀημάτων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1419.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1419.1.text#οὐ τοῦτον ἐκ γῆς τῆσδε χρῆν σ' ἀνδρηλατεῖν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1420.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1420.1.text#μιασμάτων ἄποιν'; ἐπήκοος δ' ἐμῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1421.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1421.1.text#ἔργων δικαστὴς τραχὺς εἶ. λέγω δέ σοι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1422.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1422.1.text#τοιαῦτ' ἀπειλεῖν, ὡς παρεσκευασμένης
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1423.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1423.1.text#ἐκ τῶν ὁμοίων χειρὶ νικήσαντ' ἐμοῦ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1424.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1424.1.text#ἄρχειν· ἐὰν δὲ τοὔμπαλιν κραίνῃ θεός,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1425.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1425.1.text#γνώσῃ διδαχθεὶς ὀψὲ γοῦν τὸ σωφρονεῖν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1426.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1426.1.text#μεγαλόμητις εἶ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1426.2.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1426.2.text#περίφρονα δ' ἔλακες. ὥσπερ οὖν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1427.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1427.1.text#φονολιβεῖ τύχᾳ φρὴν ἐπιμαίνεται,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1428.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1428.1.text#λίπος ἐπ' ὀμμάτων αἵματος εὖ πρέπει·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1429.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1429.1.text#ἀτίετον ἔτι σὲ χρὴ στερομέναν φίλων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1430.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1430.1.text#τύμμα τύμματι τεῖσαι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1431.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1431.1.text#καὶ τήνδ' ἀκούεις ὁρκίων ἐμῶν θέμιν·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1432.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1432.1.text#μὰ τὴν τέλειον τῆς ἐμῆς παιδὸς Δίκην,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1433.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1433.1.text#Ἄτην Ἐρινύν θ', αἷσι τόνδ' ἔσφαξ' ἐγώ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1434.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1434.1.text#οὔ μοι φόβου μέλαθρον ἐλπὶς ἐμπατεῖ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1435.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1435.1.text#ἕως ἂν αἴθῃ πῦρ ἐφ' ἑστίας ἐμῆς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1436.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1436.1.text#Αἴγισθος, ὡς τὸ πρόσθεν εὖ φρονῶν ἐμοί.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1437.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1437.1.text#οὗτος γὰρ ἡμῖν ἀσπὶς οὐ σμικρὰ θράσους.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1438.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1438.1.text#κεῖται γυναικὸς τῆσδε λυμαντήριος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1439.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1439.1.text#Χρυσηίδων μείλιγμα τῶν ὑπ' Ἰλίῳ·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1440.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1440.1.text#ἥ τ' αἰχμάλωτος ἥδε καὶ τερασκόπος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1441.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1441.1.text#καὶ κοινόλεκτρος τοῦδε, θεσφατηλόγος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1442.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1442.1.text#πιστὴ ξύνευνος, ναυτίλων δὲ σελμάτων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1443.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1443.1.text#ἰσοτριβής. ἄτιμα δ' οὐκ ἐπραξάτην.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1444.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1444.1.text#ὁ μὲν γὰρ οὕτως, ἡ δέ τοι κύκνου δίκην
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1445.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1445.1.text#τὸν ὕστατον μέλψασα θανάσιμον γόον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1446.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1446.1.text#κεῖται, φιλήτωρ τοῦδ'· ἐμοὶ δ' ἐπήγαγεν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1447.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1447.1.text#εὐνῆς παροψώνημα τῆς ἐμῆς χλιδῆς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1448.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1448.1.text#φεῦ, τίς ἂν ἐν τάχει, μὴ περιώδυνος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1449.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1449.1.text#μηδὲ δεμνιοτήρης,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1450.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1450.1.text#μόλοι τὸν αἰεὶ φέρουσ' ἐν ἡμῖν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1451.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1451.1.text#Μοῖρ' ἀτέλευτον ὕπνον, δαμέντος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1452.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1452.1.text#φύλακος εὐμενεστάτου [ καὶ ]
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1453.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1453.1.text#πολλὰ τλάντος γυναικὸς διαί·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1454.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1454.1.text#πρὸς γυναικὸς δ' ἀπέφθισεν βίον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1455.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1455.1.text#ἰὼ { ἰὼ } παράνους Ἑλένα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1456.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1456.1.text#μία τὰς πολλάς, τάς πάνυ πολλὰς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1457.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1457.1.text#ψυχὰς ὀλέσασ' ὑπὸ Τροίᾳ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1458.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1458.1.text#νῦν [ δὲ ] τελέαν πολύμναστον ἐπηνθίσω
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1460.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1460.1.text#δι' αἷμ' ἄνιπτον. ἦ τις ἦν τότ' ἐν δόμοις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1461.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1461.1.text#ἔρις ἐρίδματος ἀνδρὸς οἰζύς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1462.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1462.1.text#μηδὲν θανάτου μοῖραν ἐπεύχου
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1463.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1463.1.text#τοῖσδε βαρυνθείς·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1464.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1464.1.text#μηδ' εἰς Ἑλένην κότον ἐκτρέψῃς,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1465.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1465.1.text#ὡς ἀνδρολέτειρ', ὡς μία πολλῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1466.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1466.1.text#ἀνδρῶν ψυχὰς Δαναῶν ὀλέσασ'
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1467.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1467.1.text#ἀξύστατον ἄλγος ἔπραξεν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1468.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1468.1.text#δαῖμον, ὃς ἐμπίτνεις δώμασι καὶ διφυί-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1469.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1469.1.text#οισι Τανταλίδαισιν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1470.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1470.1.text#κράτος { τ' } ἰσόψυχον ἐκ γυναικῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1471.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1471.1.text#καρδιόδηκτον ἐμοὶ κρατύνεις.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1472.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1472.1.text#ἐπὶ δὲ σώματος δίκαν [ μοι ]
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1473.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1473.1.text#κόρακος ἐχθροῦ σταθεῖσ' ἐκνόμως
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1474.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1474.1.text#ὕμνον ὑμνεῖν ἐπεύχεται { ˘¯ }
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1475.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1475.1.text#νῦν δ' ὤρθωσας στόματος γνώμην,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1476.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1476.1.text#τὸν τριπάχυντον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1477.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1477.1.text#δαίμονα γέννης τῆσδε κικλήσκων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1478.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1478.1.text#ἐκ τοῦ γὰρ ἔρως αἱματολοιχὸς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1479.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1479.1.text#νείρᾳ τρέφεται, πρὶν καταλῆξαι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1480.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1480.1.text#τὸ παλαιὸν ἄχος, νέος ἰχώρ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1481.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1481.1.text#ἦ μέγαν οἰκονόμον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1482.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1482.1.text#δαίμονα καὶ βαρύμηνιν αἰνεῖς,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1483.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1483.1.text#φεῦ φεῦ, κακὸν αἶνον ἀτη-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1484.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1484.1.text#ρᾶς τύχας ἀκορέστου·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1485.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1485.1.text#ἰὴ ἰή, διαὶ Διὸς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1486.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1486.1.text#παναιτίου πανεργέτα·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1487.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1487.1.text#τί γὰρ βροτοῖς ἄνευ Διὸς τελεῖται;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1488.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1488.1.text#τί τῶνδ' οὐ θεόκραντόν ἐστιν;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1489.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1489.1.text#ἰὼ ἰὼ βασιλεῦ βασιλεῦ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1490.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1490.1.text#πῶς σε δακρύσω;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1491.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1491.1.text#φρενὸς ἐκ φιλίας τί ποτ' εἴπω;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1492.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1492.1.text#κεῖσαι δ' ἀράχνης ἐν ὑφάσματι τῷδ'
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1493.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1493.1.text#ἀσεβεῖ θανάτῳ βίον ἐκπνέων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1494.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1494.1.text#ὤμοι μοι κοίταν τάνδ' ἀνελεύθερον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1495.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1495.1.text#δολίῳ μόρῳ δαμεὶς { δάμαρτος }
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1496.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1496.1.text#ἐκ χερὸς ἀμφιτόμῳ βελέμνῳ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1497.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1497.1.text#αὐχεῖς εἶναι τόδε τοὔργον ἐμόν;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1498.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1498.1.text#μηδ' ἐπιλεχθῇς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1499.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1499.1.text#Ἀγαμεμνονίαν εἶναί μ' ἄλοχον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1500.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1500.1.text#φανταζόμενος δὲ γυναικὶ νεκροῦ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1501.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1501.1.text#τοῦδ' ὁ παλαιὸς δριμὺς ἀλάστωρ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1502.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1502.1.text#Ἀτρέως χαλεποῦ θοινατῆρος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1503.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1503.1.text#τόνδ' ἀπέτεισεν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1504.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1504.1.text#τέλεον νεαροῖς ἐπιθύσας.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1505.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1505.1.text#ὡς μὲν ἀναίτιος εἶ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1506.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1506.1.text#τοῦδε φόνου τίς ὁ μαρτυρήσων;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1507.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1507.1.text#πῶς πῶς; πατρόθεν δὲ συλλή-
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1508.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1508.1.text#πτωρ γένοιτ' ἂν ἀλάστωρ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1509.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1509.1.text#βιάζεται δ' ὁμοσπόροις
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1510.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1510.1.text#ἐπιρροαῖσιν αἱμάτων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1511.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1511.1.text#μέλας Ἄρης, ὅποι δίκαν προβαίνων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1512.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1512.1.text#πάχνᾳ κουροβόρῳ παρέξει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1513.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1513.1.text#ἰὼ ἰὼ βασιλεῦ βασιλεῦ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1514.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1514.1.text#πῶς σε δακρύσω;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1515.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1515.1.text#φρενὸς ἐκ φιλίας τί ποτ' εἴπω;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1516.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1516.1.text#κεῖσαι δ' ἀράχνης ἐν ὑφάσματι τῷδ'
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1517.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1517.1.text#ἀσεβεῖ θανάτῳ βίον ἐκπνέων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1518.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1518.1.text#ὤμοι μοι κοίταν τάνδ' ἀνελεύθερον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1519.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1519.1.text#δολίῳ μόρῳ δαμεὶς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1520.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1520.1.text#ἐκ χερὸς ἀμφιτόμῳ βελέμνῳ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1521.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1521.1.text#[  οὔτ' ἀνελεύθερον οἶμαι θάνατον ]
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1522.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1522.1.text#[ τῷδε γενέσθαι. ]
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1523.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1523.1.text#οὐδὲ γὰρ οὗτος δολίαν ἄτην
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1524.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1524.1.text#οἴκοισιν ἔθηκ';
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1525.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1525.1.text#ἀλλ' ἐμὸν ἐκ τοῦδ' ἔρνος ἀερθέν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1526.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1526.1.text#τὴν πολυκλαύτην Ἰφιγενείαν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1527.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1527.1.text#ἄξια δράσας ἄξια πάσχων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1528.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1528.1.text#μηδὲν ἐν Ἅιδου μεγαλαυχείτω,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1529.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1529.1.text#ξιφοδηλήτῳ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1529.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1529.2.text#θανάτῳ τείσας ἅπερ ἦρξεν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1530.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1530.1.text#ἀμηχανῶ φροντίδος στερηθεὶς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1531.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1531.1.text#εὐπάλαμον μέριμναν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1532.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1532.1.text#ὅπα τράπωμαι, πίτνοντος οἴκου.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1533.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1533.1.text#δέδοικα δ' ὄμβρου κτύπον δομοσφαλῆ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1534.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1534.1.text#τὸν αἱματηρόν· ψακὰς δὲ λήγει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1535.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1535.1.text#δίκην δ' ἐπ' ἄλλο πρᾶγμα θηγάνει βλάβης
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1536.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1536.1.text#πρὸς ἄλλαις θηγάναισι μοῖρα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1537.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1537.1.text#ἰὼ γᾶ γᾶ, εἴθ' ἔμ' ἐδέξω,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1538.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1538.1.text#πρὶν τόνδ' ἐπιδεῖν ἀργυροτοίχου
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1540.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1540.1.text#δροίτης κατέχοντα χάμευναν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1541.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1541.1.text#τίς ὁ θάψων νιν; τίς ὁ θρηνήσων;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1542.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1542.1.text#ἦ σὺ τόδ' ἔρξαι τλήσῃ, κτείνασ'
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1543.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1543.1.text#ἄνδρα τὸν αὑτῆς ἀποκωκῦσαι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1545.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1545.1.text#ψυχῇ τ' ἄχαριν χάριν ἀντ' ἔργων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1546.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1546.1.text#μεγάλων ἀδίκως ἐπικρᾶναι;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1547.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1547.1.text#τίς δ' ἐπιτύμβιον αἶνον ἐπ' ἀνδρὶ θείῳ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1548.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1548.1.text#σὺν δακρύοις ἰάπτων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1550.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1550.1.text#ἀληθείᾳ φρενῶν πονήσει;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1551.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1551.1.text#οὐ σὲ προσήκει τὸ μέλημ' ἀλέγειν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1552.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1552.1.text#τοῦτο· πρὸς ἡμῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1553.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1553.1.text#κάππεσε, κάτθανε, καὶ καταθάψομεν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1554.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1554.1.text#οὐχ ὑπὸ κλαυθμῶν τῶν ἐξ οἴκων,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1555.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1555.1.text#ἀλλ' Ἰφιγένειά νιν ἀσπασίως
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1556.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1556.1.text#θυγάτηρ, ὡς χρή,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1557.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1557.1.text#πατέρ' ἀντιάσασα πρὸς ὠκύπορον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1558.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1558.1.text#πόρθμευμ' ἀχέων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1559.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1559.1.text#περὶ χεῖρε βαλοῦσα φιλήσει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1560.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1560.1.text#ὄνειδος ἥκει τόδ' ἀντ' ὀνείδους.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1561.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1561.1.text#δύσμαχα δ' ἔστι κρῖναι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1562.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1562.1.text#φέρει φέροντ', ἐκτίνει δ' ὁ καίνων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1563.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1563.1.text#μίμνει δὲ μίμνοντος ἐν θρόνῳ Διὸς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1564.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1564.1.text#παθεῖν τὸν ἔρξαντα· θέσμιον γάρ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1565.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1565.1.text#τίς ἂν γονὰν ἀραῖον ἐκβάλοι δόμων;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1566.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1566.1.text#κεκόλληται γένος πρὸς ἄτᾳ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1567.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1567.1.text#ἐς τόνδ' ἐνέβης ξὺν ἀληθείᾳ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1568.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1568.1.text#χρησμόν. ἐγὼ δ' οὖν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1569.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1569.1.text#ἐθέλω δαίμονι τῷ Πλεισθενιδῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1570.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1570.1.text#ὅρκους θεμένη τάδε μὲν στέργειν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1571.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1571.1.text#δύστλητά περ ὄνθ'· ὃ δὲ λοιπόν, ἰόντ'
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1572.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1572.1.text#ἐκ τῶνδε δόμων ἄλλην γενεὰν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1573.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1573.1.text#τρίβειν θανάτοις αὐθένταισι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1574.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1574.1.text#κτεάνων τε μέρος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1575.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1575.1.text#βαιὸν ἐχούσῃ πᾶν ἀπόχρη μοι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1575.2.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1575.2.text#μανίας μελάθρων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1576.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1576.1.text#ἀλληλοφόνους ἀφελούσῃ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1577.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1577.1.text#ὦ φέγγος εὖφρον ἡμέρας δικηφόρου.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1578.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1578.1.text#φαίην ἂν ἤδη νῦν βροτῶν τιμαόρους
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1579.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1579.1.text#θεοὺς ἄνωθεν γῆς ἐποπτεύειν ἄχη,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1580.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1580.1.text#ἰδὼν ὑφαντοῖς ἐν πέπλοις, Ἐρινύων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1581.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1581.1.text#τὸν ἄνδρα τόνδε κείμενον φίλως ἐμοί,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1582.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1582.1.text#χερὸς πατρῴας ἐκτίνοντα μηχανάς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1583.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1583.1.text#Ἀτρεὺς γὰρ ἄρχων τῆσδε γῆς, τούτου πατήρ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1584.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1584.1.text#πατέρα Θυέστην τὸν ἐμόν, ὡς τορῶς φράσαι,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1585.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1585.1.text#αὑτοῦ δ' ἀδελφόν, ἀμφίλεκτος ὢν κράτει,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1586.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1586.1.text#ἠνδρηλάτησεν ἐκ πόλεώς τε καὶ δόμων.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1587.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1587.1.text#καὶ προστρόπαιος ἑστίας μολὼν πάλιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1588.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1588.1.text#τλήμων Θυέστης μοῖραν ηὕρετ' ἀσφαλῆ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1589.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1589.1.text#τὸ μὴ θανὼν πατρῷον αἱμάξαι πέδον,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1590.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1590.1.text#αὐτός· ξένια δὲ τοῦδε δύσθεος πατὴρ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1591.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1591.1.text#Ἀτρεύς, προθύμως μᾶλλον ἢ φίλως, πατρὶ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1592.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1592.1.text#τὠμῷ, κρεουργὸν ἦμαρ εὐθύμως ἄγειν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1593.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1593.1.text#δοκῶν, παρέσχε δαῖτα παιδείων κρεῶν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1594.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1594.1.text#τὰ μὲν ποδήρη καὶ χερῶν ἄκρους κτένας
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1595.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1595.1.text#ἔθρυπτ', ἄνωθεν [ … ]
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1595.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1595.1.text#[ … ]
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1595.2.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1595.2.text#[ … ]ἀνδρακὰς καθήμενος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1596.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1596.1.text#ἄσημα δ' αὐτῶν αὐτίκ' ἀγνοίᾳ λαβὼν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1597.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1597.1.text#ἔσθει βορὰν ἄσωτον, ὡς ὁρᾷς, γένει.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1598.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1598.1.text#κἄπειτ' ἐπιγνοὺς ἔργον οὐ καταίσιον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1599.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1599.1.text#ᾤμωξεν, ἀμπίπτει δ' ἀπὸ σφαγὴν ἐρῶν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1600.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1600.1.text#μόρον δ' ἄφερτον Πελοπίδαις ἐπεύχεται,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1601.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1601.1.text#λάκτισμα δείπνου ξυνδίκως τιθεὶς ἀρᾷ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1602.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1602.1.text#οὕτως ὀλέσθαι πᾶν τὸ Πλεισθένους γένος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1603.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1603.1.text#ἐκ τῶνδέ σοι πεσόντα τόνδ' ἰδεῖν πάρα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1604.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1604.1.text#κἀγὼ δίκαιος τοῦδε τοῦ φόνου ῥαφεύς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1605.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1605.1.text#τρίτον γὰρ ὄντα μ' ἐπὶ δυσαθλίῳ πατρὶ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1606.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1606.1.text#συνεξελαύνει τυτθὸν ὄντ' ἐν σπαργάνοις·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1607.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1607.1.text#τραφέντα δ' αὖθις ἡ δίκη κατήγαγεν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1608.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1608.1.text#καὶ τοῦδε τἀνδρὸς ἡψάμην θυραῖος ὤν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1609.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1609.1.text#πᾶσαν συνάψας μηχανὴν δυσβουλίας.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1610.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1610.1.text#οὕτω καλὸν δὴ καὶ τὸ κατθανεῖν ἐμοί,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1611.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1611.1.text#ἰδόντα τοῦτον τῆς δίκης ἐν ἕρκεσιν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1612.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1612.1.text#Αἴγισθ', ὑβρίζειν ἐν κακοῖσιν οὐ σέβω.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1613.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1613.1.text#σὺ δ' ἄνδρα τόνδε φὴς ἑκὼν κατακτανεῖν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1614.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1614.1.text#μόνος δ' ἔποικτον τόνδε βουλεῦσαι φόνον·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1615.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1615.1.text#οὔ φημ' ἀλύξειν ἐν δίκῃ τὸ σὸν κάρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1616.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1616.1.text#δημορριφεῖς, σάφ' ἴσθι, λευσίμους ἀράς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1617.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1617.1.text#σὺ ταῦτα φωνεῖς νερτέρᾳ προσήμενος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1618.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1618.1.text#κώπῃ, κρατούντων τῶν ἐπὶ ζυγῷ δορός;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1619.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1619.1.text#γνώσῃ γέρων ὢν ὡς διδάσκεσθαι βαρὺ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1620.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1620.1.text#τῷ τηλικούτῳ, σωφρονεῖν εἰρημένον.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1621.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1621.1.text#δεσμὸς δὲ καὶ τὸ γῆρας αἵ τε νήστιδες
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1622.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1622.1.text#δύαι διδάσκειν ἐξοχώταται φρενῶν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1623.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1623.1.text#ἰατρομάντεις. οὐχ ὁρᾷς ὁρῶν τάδε;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1624.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1624.1.text#πρὸς κέντρα μὴ λάκτιζε, μὴ παίσας μογῇς.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1625.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1625.1.text#γύναι, σὺ τοὺς ἥκοντας ἐκ μάχης μένων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1626.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1626.1.text#οἰκουρὸς εὐνὴν ἀνδρὸς αἰσχύνων ἅμα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1627.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1627.1.text#ἀνδρὶ στρατηγῷ τόνδ' ἐβούλευσας μόρον;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1628.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1628.1.text#καὶ ταῦτα τἄπη κλαυμάτων ἀρχηγενῆ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1629.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1629.1.text#Ὀρφεῖ δὲ γλῶσσαν τὴν ἐναντίαν ἔχεις.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1630.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1630.1.text#ὁ μὲν γὰρ ἦγε πάντ' ἀπὸ φθογγῆς χαρᾷ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1631.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1631.1.text#σὺ δ' ἐξορίνας νηπίοις ὑλάγμασιν
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1632.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1632.1.text#ἄξῃ· κρατηθεὶς δ' ἡμερώτερος φανῇ.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1633.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1633.1.text#ὡς δὴ σύ μοι τύραννος Ἀργείων ἔσῃ,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1634.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1634.1.text#ὃς οὐκ, ἐπειδὴ τῷδ' ἐβούλευσας μόρον,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1635.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1635.1.text#δρᾶσαι τόδ' ἔργον οὐκ ἔτλης αὐτοκτόνως.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1636.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1636.1.text#τὸ γὰρ δολῶσαι πρὸς γυναικὸς ἦν σαφῶς·
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1637.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1637.1.text#ἐγὼ δ' ὕποπτος ἐχθρὸς ἦ παλαιγενής.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1638.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1638.1.text#ἐκ τῶν δὲ τοῦδε χρημάτων πειράσομαι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1639.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1639.1.text#ἄρχειν πολιτῶν· τὸν δὲ μὴ πειθάνορα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1640.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1640.1.text#ζεύξω βαρείαις οὔτι μοι σειραφόρον
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1641.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1641.1.text#κριθῶντα πῶλον· ἀλλ' ὁ δυσφιλὴς σκότῳ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1642.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1642.1.text#λιμὸς ξύνοικος μαλθακόν σφ' ἐπόψεται.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1643.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1643.1.text#τί δὴ τὸν ἄνδρα τόνδ' ἀπὸ ψυχῆς κακῆς
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1644.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1644.1.text#οὐκ αὐτὸς ἠνάριζες, ἀλλά νιν γυνὴ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1645.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1645.1.text#χώρας μίασμα καὶ θεῶν ἐγχωρίων
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1646.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1646.1.text#ἔκτειν';Ὀρέστης ἆρά που βλέπει φάος,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1647.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1647.1.text#ὅπως κατελθὼν δεῦρο πρευμενεῖ τύχῃ
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1648.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1648.1.text#ἀμφοῖν γένηται τοῖνδε παγκρατὴς φονεύς;
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1649.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1649.1.text#ἀλλ' ἐπεὶ δοκεῖς τάδ' ἔρδειν καὶ λέγειν, γνώσῃ τάχα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1650.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1650.1.text#εἶα δή, φίλοι λοχῖται, τοὔργον οὐχ ἑκὰς τόδε.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1651.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1651.1.text#εἶα δή, ξίφος πρόκωπον πᾶς τις εὐτρεπιζέτω.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1652.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1652.1.text#ἀλλὰ κἀγὼ μὴν πρόκωπος οὐκ ἀναίνομαι θανεῖν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1653.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1653.1.text#δεχομένοις λέγεις θανεῖν σε· τὴν τύχην δ' αἱρούμεθα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1654.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1654.1.text#μηδαμῶς, ὦ φίλτατ' ἀνδρῶν, ἄλλα δράσωμεν κακά.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1655.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1655.1.text#ἀλλὰ καὶ τάδ' ἐξαμῆσαι πολλά, δύστηνον θέρος.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1656.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1656.1.text#πημονῆς δ' ἅλις γ' ὑπάρχει· μηδὲν αἱματώμεθα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1657.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1657.1.text#στείχετ' αἰδοῖοι γέροντες πρὸς δόμους, πεπρωμένοις [ τούσδε ]
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1658.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1658.1.text#πρὶν παθεῖν εἴξαντες ὥρᾳ· χρῆν τάδ' ὡς ἐπράξαμεν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1659.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1659.1.text#εἰ δέ τοι μόχθων γένοιτο τῶνδ' ἅλις, δεχοίμεθ' ἄν,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1660.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1660.1.text#δαίμονος χηλῇ βαρείᾳ δυστυχῶς πεπληγμένοι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1661.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1661.1.text#ὧδ' ἔχει λόγος γυναικός, εἴ τις ἀξιοῖ μαθεῖν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1662.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1662.1.text#ἀλλὰ τούσδ' ἐμοὶ ματαίαν γλῶσσαν ὧδ' ἀπανθίσαι
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1663.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1663.1.text#κἀκβαλεῖν ἔπη τοιαῦτα δαίμονος πειρωμένους,
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1664.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1664.1.text#σώφρονος γνώμης θ' ἁμαρτεῖν τὸν κρατοῦντά { θ' ὑβρίσαι }.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1665.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1665.1.text#οὐκ ἂν Ἀργείων τόδ' εἴη, φῶτα προσσαίνειν κακόν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1666.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1666.1.text#ἀλλ' ἐγώ σ' ἐν ὑστέραισιν ἡμέραις μέτειμ' ἔτι.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1667.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1667.1.text#οὔκ, ἐὰν δαίμων, Ὀρέστην δεῦρ' ἀπευθύνῃ μολεῖν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1668.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1668.1.text#οἶδ' ἐγὼ φεύγοντας ἄνδρας ἐλπίδας σιτουμένους.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1669.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1669.1.text#πρᾶσσε, πιαίνου, μιαίνων τὴν δίκην, ἐπεὶ πάρα.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1670.1.speaker#Αἴγισθος
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1670.1.text#ἴσθι μοι δώσων ἄποινα τῆσδε μωρίας χάριν.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1671.1.speaker#Χορός
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1671.1.text#κόμπασον θαρσῶν, ἀλέκτωρ ὥστε θηλείας πέλας.
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1672.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1672.1.text#μὴ προτιμήσῃς ματαίων τῶνδ' ὑλαγμάτων· { ἐγὼ }
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1673.1.speaker#Κλυταιμήστρα
urn:cts:greekLit:tlg0085.tlg005.fu.sp:1673.1.text#καὶ σὺ θήσομεν κρατοῦντε τῶνδε δωμάτων { καλῶς }.
