#!ctsdata
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1.1.text#Τίς τὸν Διὸς σύλλεκτρον οὐκ οἶδεν βροτῶν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:2.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:2.1.text#Ἀργεῖον Ἀμφιτρύων', ὃν Ἀλκαῖός ποτε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:3.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:3.1.text#ἔτιχθ' ὁ Περσέως, πατέρα τόνδ' Ἡρακλέους;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:4.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:4.1.text#ὃς τάσδε Θήβας ἔσχον, ἔνθ' ὁ γηγενὴς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:5.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:5.1.text#σπαρτῶν στάχυς ἔβλαστεν, ὧν γένους Ἄρης
urn:cts:greekLit:tlg0006.tlg009.fu.sp:6.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:6.1.text#ἔσωσ' ἀριθμὸν ὀλίγον, οἳ Κάδμου πόλιν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:7.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:7.1.text#τεκνοῦσι παίδων παισίν. ἔνθεν ἐξέφυ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:8.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:8.1.text#Κρέων Μενοικέως παῖς, ἄναξ τῆσδε χθονός.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:9.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:9.1.text#Κρέων δὲ Μεγάρας τῆσδε γίγνεται πατήρ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:10.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:10.1.text#ἣν πάντες ὑμεναίοισι Καδμεῖοί ποτε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:11.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:11.1.text#λωτῷ συνηλάλαξαν, ἡνίκ' εἰς ἐμοὺς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:12.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:12.1.text#δόμους ὁ κλεινὸς Ἡρακλῆς νιν ἤγετο.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:13.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:13.1.text#λιπὼν δὲ Θήβας, οὗ κατῳκίσθην ἐγώ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:14.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:14.1.text#Μεγάραν τε τήνδε πενθερούς τε παῖς ἐμὸς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:15.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:15.1.text#Ἀργεῖα τείχη καὶ Κυκλωπίαν πόλιν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:16.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:16.1.text#ὠρέξατ' οἰκεῖν, ἣν ἐγὼ φεύγω κτανὼν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:17.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:17.1.text#Ἠλεκτρύωνα· συμφορὰς δὲ τὰς ἐμὰς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:18.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:18.1.text#ἐξευμαρίζων καὶ πάτραν οἰκεῖν θέλων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:19.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:19.1.text#καθόδου δίδωσι μισθὸν Εὐρυσθεῖ μέγαν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:20.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:20.1.text#ἐξημερῶσαι γαῖαν, εἴθ' Ἥρας ὕπο
urn:cts:greekLit:tlg0006.tlg009.fu.sp:21.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:21.1.text#κέντροις δαμασθεὶς εἴτε τοῦ χρεὼν μέτα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:22.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:22.1.text#καὶ τοὺς μὲν ἄλλους ἐξεμόχθησεν πόνους,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:23.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:23.1.text#τὸ λοίσθιον δὲ Ταινάρου διὰ στόμα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:24.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:24.1.text#βέβηκ' ἐς Ἅιδου, τὸν τρισώματον κύνα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:25.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:25.1.text#ἐς φῶς ἀνάξων, ἔνθεν οὐχ ἥκει πάλιν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:26.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:26.1.text#γέρων δὲ δή τις ἔστι Καδμείων λόγος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:27.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:27.1.text#ὡς ἦν πάρος Δίρκης τις εὐνήτωρ Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:28.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:28.1.text#τὴν ἑπτάπυργον τήνδε δεσπόζων πόλιν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:29.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:29.1.text#τὼ λευκοπώλω πρὶν τυραννῆσαι χθονὸς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:30.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:30.1.text#Ἀμφίον' ἠδὲ Ζῆθον, ἐκγόνω Διός.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:31.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:31.1.text#οὗ ταὐτὸν ὄνομα παῖς πατρὸς κεκλημένος,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:32.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:32.1.text#Καδμεῖος οὐκ ὤν, ἀλλ' ἀπ' Εὐβοίας μολών,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:33.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:33.1.text#κτείνει Κρέοντα καὶ κτανὼν ἄρχει χθονός,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:34.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:34.1.text#στάσει νοσοῦσαν τήνδ' ἐπεσπεσὼν πόλιν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:35.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:35.1.text#ἡμῖν δὲ κῆδος ἐς Κρέοντ' ἀνημμένον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:36.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:36.1.text#κακὸν μέγιστον, ὡς ἔοικε, γίγνεται.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:37.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:37.1.text#τοὐμοῦ γὰρ ὄντος παιδὸς ἐν μυχοῖς χθονὸς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:38.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:38.1.text#ὁ καινὸς οὗτος τῆσδε γῆς ἄρχων Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:39.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:39.1.text#τοὺς Ἡρακλείους παῖδας ἐξελεῖν θέλει
urn:cts:greekLit:tlg0006.tlg009.fu.sp:40.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:40.1.text#κτανὼν δάμαρτά { θ' }, ὡς φόνῳ σβέσῃ φόνον,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:41.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:41.1.text#κἄμ' — εἴ τι δὴ χρὴ κἄμ' ἐν ἀνδράσιν λέγειν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:42.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:42.1.text#γέροντ' ἀχρεῖον — μή ποθ' οἵδ' ἠνδρωμένοι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:43.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:43.1.text#μήτρωσιν ἐκπράξωσιν αἵματος δίκην.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:44.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:44.1.text#ἐγὼ δέ — λείπει γάρ με τοῖσδ' ἐν δώμασιν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:45.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:45.1.text#τροφὸν τέκνων οἰκουρόν, ἡνίκα χθονὸς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:46.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:46.1.text#μέλαιναν ὄρφνην εἰσέβαινε, παῖς ἐμός —
urn:cts:greekLit:tlg0006.tlg009.fu.sp:47.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:47.1.text#σὺν μητρί, τέκνα μὴ θάνωσ' Ἡρακλέους,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:48.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:48.1.text#βωμὸν καθίζω τόνδε σωτῆρος Διός,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:49.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:49.1.text#ὃν καλλινίκου δορὸς ἄγαλμ' ἱδρύσατο
urn:cts:greekLit:tlg0006.tlg009.fu.sp:50.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:50.1.text#Μινύας κρατήσας οὑμὸς εὐγενὴς τόκος.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:51.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:51.1.text#πάντων δὲ χρεῖοι τάσδ' ἕδρας φυλάσσομεν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:52.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:52.1.text#σίτων ποτῶν ἐσθῆτος, ἀστρώτῳ πέδῳ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:53.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:53.1.text#πλευρὰς τιθέντες· ἐκ γὰρ ἐσφραγισμένοι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:54.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:54.1.text#δόμων καθήμεθ' ἀπορίᾳ σωτηρίας.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:55.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:55.1.text#φίλων δὲ τοὺς μὲν οὐ σαφεῖς ὁρῶ φίλους,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:56.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:56.1.text#οἳ δ' ὄντες ὀρθῶς ἀδύνατοι προσωφελεῖν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:57.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:57.1.text#τοιοῦτον ἀνθρώποισιν ἡ δυσπραξία·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:58.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:58.1.text#ἧς μήποθ' ὅστις καὶ μέσως εὔνους ἐμοὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:59.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:59.1.text#τύχοι, φίλων ἔλεγχον ἀψευδέστατον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:60.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:60.1.text#ὦ πρέσβυ, Ταφίων ὅς ποτ' ἐξεῖλες πόλιν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:61.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:61.1.text#στρατηλατήσας κλεινὰ Καδμείων δορός,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:62.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:62.1.text#ὡς οὐδὲν ἀνθρώποισι τῶν θείων σαφές.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:63.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:63.1.text#ἐγὼ γὰρ οὔτ' ἐς πατέρ' ἀπηλάθην τύχης,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:64.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:64.1.text#ὃς οὕνεκ' ὄλβου μέγας ἐκομπάσθη ποτέ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:65.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:65.1.text#ἔχων τυραννίδ', ἧς μακραὶ λόγχαι πέρι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:66.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:66.1.text#πηδῶσ' ἔρωτι σώματ' εἰς εὐδαίμονα,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:67.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:67.1.text#ἔχων δὲ τέκνα· κἄμ' ἔδωκε παιδὶ σῷ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:68.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:68.1.text#ἐπίσημον εὐνὴν Ἡρακλεῖ συνοικίσας.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:69.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:69.1.text#καὶ νῦν ἐκεῖνα μὲν θανόντ' ἀνέπτατο,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:70.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:70.1.text#ἐγὼ δὲ καὶ σὺ μέλλομεν θνῄσκειν, γέρον,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:71.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:71.1.text#οἵ θ' Ἡράκλειοι παῖδες, οὓς ὑπὸ πτεροῖς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:72.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:72.1.text#σῴζω νεοσσοὺς ὄρνις ὣς ὑφειμένη.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:73.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:73.1.text#οἳ δ' εἰς ἔλεγχον ἄλλος ἄλλοθεν πίτνων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:74.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:74.1.text#Ὦ μῆτερ, αὐδᾷ, ποῖ πατὴρ ἄπεστι γῆς;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:75.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:75.1.text#τί δρᾷ, πόθ' ἥξει; τῷ νέῳ δ' ἐσφαλμένοι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:76.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:76.1.text#ζητοῦσι τὸν τεκόντ'· ἐγὼ δὲ διαφέρω
urn:cts:greekLit:tlg0006.tlg009.fu.sp:77.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:77.1.text#λόγοισι, μυθεύουσα. θαυμάζων δ' ὅταν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:78.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:78.1.text#πύλαι ψοφῶσι, πᾶς ἀνίστησιν πόδα,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:79.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:79.1.text#ὡς πρὸς πατρῷον προσπεσούμενοι γόνυ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:80.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:80.1.text#νῦν οὖν τίν' ἐλπίδ' ἢ πέδον σωτηρίας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:81.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:81.1.text#ἐξευμαρίζῃ, πρέσβυ; πρὸς σὲ γὰρ βλέπω.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:82.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:82.1.text#ὡς οὔτε γαίας ὅρι' ἂν ἐκβαῖμεν λάθρᾳ·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:83.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:83.1.text#φυλακαὶ γὰρ ἡμῶν κρείσσονες κατ' ἐξόδους·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:84.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:84.1.text#οὔτ' ἐν φίλοισιν ἐλπίδες σωτηρίας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:85.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:85.1.text#ἔτ' εἰσὶν ἡμῖν. ἥντιν' οὖν γνώμην ἔχεις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:86.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:86.1.text#λέγ' ἐς τὸ κοινόν, μὴ θανεῖν ἕτοιμον ᾖ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:88.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:88.1.text#ὦ θύγατερ, οὔτοι ῥᾴδιον τὰ τοιάδε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:89.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:89.1.text#φαύλως παραινεῖν, σπουδάσαντ' ἄνευ πόνου·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:87.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:87.1.text#χρόνον δὲ μηκύνωμεν ὄντες ἀσθενεῖς.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:90.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:90.1.text#λύπης τι προσδεῖς ἢ φιλεῖς οὕτω φάος;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:91.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:91.1.text#καὶ τῷδε χαίρω καὶ φιλῶ τὰς ἐλπίδας.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:92.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:92.1.text#κἀγώ· δοκεῖν δὲ τἀδόκητ' οὐ χρή, γέρον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:93.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:93.1.text#ἐν ταῖς ἀναβολαῖς τῶν κακῶν ἔνεστ' ἄκη.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:94.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:94.1.text#ὁ δ' ἐν μέσῳ με λυπρὸς ὢν δάκνει χρόνος.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:95.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:95.1.text#ἔτ' ἂν γένοιτ', ὦ θύγατερ, οὔριος δρόμος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:96.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:96.1.text#ἐκ τῶν παρόντων τῶνδ' ἐμοὶ καὶ σοὶ κακῶν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:97.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:97.1.text#ἔλθοι τ' ἔτ' ἂν παῖς οὑμός, εὐνήτωρ δὲ σός.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:98.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:98.1.text#ἀλλ' ἡσύχαζε καὶ δακρυρρόους τέκνων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:99.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:99.1.text#πηγὰς ἀφαίρει καὶ παρευκήλει λόγοις,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:100.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:100.1.text#κλέπτουσα μύθοις ἀθλίους κλοπὰς ὅμως.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:101.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:101.1.text#κάμνουσι γάρ τοι καὶ βροτῶν αἱ συμφοραί,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:102.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:102.1.text#καὶ πνεύματ' ἀνέμων οὐκ ἀεὶ ῥώμην ἔχει·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:103.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:103.1.text#οἵ τ' εὐτυχοῦντες διὰ τέλους οὐκ εὐτυχεῖς.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:104.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:104.1.text#ἐξίσταται γὰρ πάντ' ἀπ' ἀλλήλων δίχα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:105.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:105.1.text#οὗτος δ' ἀνὴρ ἄριστος ὅστις ἐλπίσι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:106.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:106.1.text#πέποιθεν αἰεί· τὸ δ' ἀπορεῖν ἀνδρὸς κακοῦ.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:107.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:107.1.text#—ὑπώροφα μέλαθρα καὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:108.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:108.1.text#γεραιὰ δέμνι', ἀμφὶ βάκτροις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:109.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:109.1.text#ἔρεισμα θέμενος, ἐστάλην
urn:cts:greekLit:tlg0006.tlg009.fu.sp:110.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:110.1.text#ἰηλέμων γόων ἀοιδὸς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:110.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:110.2.text#ὥστε πολιὸς ὄρνις,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:111.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:111.1.text#ἔπεα μόνον καὶ δόκημα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:112.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:112.1.text#νυκτερωπὸν ἐννύχων ὀνείρων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:113.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:113.1.text#τρομερὰ μέν, ἀλλ' ὅμως πρόθυμ'.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:114.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:114.1.text#ὦ τέκεα, τέκεα πατρὸς ἀπάτορ',
urn:cts:greekLit:tlg0006.tlg009.fu.sp:115.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:115.1.text#ὦ γεραιὲ σύ τε τάλαινα μᾶτερ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:116.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:116.1.text#ἃ τὸν Ἀίδα δόμοις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:117.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:117.1.text#πόσιν ἀναστενάζεις. [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:119.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:119.1.text#—μὴ προκάμητε πόδα βαρύ τε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:120.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:120.1.text#κῶλον ὥστε πρὸς πετραῖον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:121.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:121.1.text#λέπας { ζυγηφόρον πῶλον }
urn:cts:greekLit:tlg0006.tlg009.fu.sp:122.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:122.1.text#{ ἀνέντες ὡς βάρος φέρον }
urn:cts:greekLit:tlg0006.tlg009.fu.sp:122.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:122.2.text#{ τροχηλάτοιο πώλου  }.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:123.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:123.1.text#λαβοῦ χερῶν καὶ πέπλων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:124.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:124.1.text#ὅτου λέλοιπε ποδὸς ἀμαυρὸν ἴχνος·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:125.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:125.1.text#γέρων γέροντα παρακόμιζ',
urn:cts:greekLit:tlg0006.tlg009.fu.sp:127.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:127.1.text#ᾧ ξύνοπλα δόρατα νέα νέῳ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:126.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:126.1.text#τὸ πάρος ἐν ἡλίκων πόνοις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:128.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:128.1.text#ξυνῆν ποτ', εὐκλεεστάτας [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:130.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:130.1.text#—ἴδετε, πατέρος ὡς γοργῶπες
urn:cts:greekLit:tlg0006.tlg009.fu.sp:131.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:131.1.text#αἵδε προσφερεῖς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:132.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:132.1.text#ὀμμάτων αὐγαί,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:133.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:133.1.text#τὸ δὲ κακοτυχὲς οὐ λέλοιπεν ἐκ τέκνων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:134.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:134.1.text#οὐδ' ἀποίχεται χάρις.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:135.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:135.1.text#Ἑλλὰς ὦ ξυμμάχους
urn:cts:greekLit:tlg0006.tlg009.fu.sp:136.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:136.1.text#οἵους οἵους ὀλέσασα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:137.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:137.1.text#τούσδ' ἀποστερήσῃ. [ … ][ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:138.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:138.1.text#—ἀλλ' εἰσορῶ γὰρ τῆσδε κοίρανον χθονὸς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:139.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:139.1.text#Λύκον περῶντα τῶνδε δωμάτων πέλας.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:140.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:140.1.text#τὸν Ἡράκλειον πατέρα καὶ ξυνάορον,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:141.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:141.1.text#εἰ χρή μ', ἐρωτῶ· χρὴ δ', ἐπεί γε δεσπότης
urn:cts:greekLit:tlg0006.tlg009.fu.sp:142.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:142.1.text#ὑμῶν καθέστηχ', ἱστορεῖν ἃ βούλομαι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:143.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:143.1.text#τίν' ἐς χρόνον ζητεῖτε μηκῦναι βίον;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:144.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:144.1.text#τίν' ἐλπίδ' ἀλκήν τ' εἰσορᾶτε μὴ θανεῖν;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:145.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:145.1.text#ἢ τὸν παρ' Ἅιδῃ πατέρα τῶνδε κείμενον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:146.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:146.1.text#πιστεύεθ' ἥξειν; ὡς ὑπὲρ τὴν ἀξίαν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:147.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:147.1.text#τὸ πένθος αἴρεσθ', εἰ θανεῖν ὑμᾶς χρεών,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:148.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:148.1.text#σὺ μὲν καθ' Ἑλλάδ' ἐκβαλὼν κόμπους κενούς,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:149.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:149.1.text#ὡς σύγγαμός σοι Ζεὺς τέκ{ νου τε κ }οινεών,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:150.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:150.1.text#σὺ δ' ὡς ἀρίστου φωτὸς ἐκλήθης δάμαρ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:151.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:151.1.text#τί δὴ τὸ σεμνὸν σῷ κατείργασται πόσει,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:152.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:152.1.text#ὕδραν ἕλειον εἰ διώλεσε κτανὼν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:153.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:153.1.text#ἢ τὸν Νέμειον θῆρα; ὃν ἐν βρόχοις ἑλὼν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:154.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:154.1.text#βραχίονός φησ' ἀγχόναισιν ἐξελεῖν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:155.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:155.1.text#τοῖσδ' ἐξαγωνίζεσθε; τῶνδ' ἄρ' οὕνεκα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:156.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:156.1.text#τοὺς Ἡρακλείους παῖδας οὐ θνῄσκειν χρεών;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:157.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:157.1.text#ὃς ἔσχε δόξαν οὐδὲν ὢν εὐψυχίας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:158.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:158.1.text#θηρῶν ἐν αἰχμῇ, τἄλλα δ' οὐδὲν ἄλκιμος,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:159.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:159.1.text#ὃς οὔποτ' ἀσπίδ' ἔσχε πρὸς λαιᾷ χερὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:160.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:160.1.text#οὐδ' ἦλθε λόγχης ἐγγύς, ἀλλὰ τόξ' ἔχων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:161.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:161.1.text#κάκιστον ὅπλον, τῇ φυγῇ πρόχειρος ἦν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:162.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:162.1.text#ἀνδρὸς δ' ἔλεγχος οὐχὶ τόξ' εὐψυχίας,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:163.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:163.1.text#ἀλλ' ὃς μένων βλέπει τε κἀντιδέρκεται
urn:cts:greekLit:tlg0006.tlg009.fu.sp:164.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:164.1.text#δορὸς ταχεῖαν ἄλοκα τάξιν ἐμβεβώς.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:165.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:165.1.text#ἔχει δὲ τοὐμὸν οὐκ ἀναίδειαν, γέρον,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:166.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:166.1.text#ἀλλ' εὐλάβειαν· οἶδα γὰρ κατακτανὼν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:167.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:167.1.text#Κρέοντα πατέρα τῆσδε καὶ θρόνους ἔχων.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:168.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:168.1.text#οὔκουν τραφέντων τῶνδε τιμωροὺς ἐμοὺς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:169.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:169.1.text#χρῄζω λιπέσθαι τῶν δεδραμένων δίκην.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:170.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:170.1.text#τῷ τοῦ Διὸς μὲν Ζεὺς ἀμυνέτω μέρει
urn:cts:greekLit:tlg0006.tlg009.fu.sp:171.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:171.1.text#παιδός· τὸ δ' εἰς ἔμ', Ἡράκλεις, ἐμοὶ μέλει
urn:cts:greekLit:tlg0006.tlg009.fu.sp:172.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:172.1.text#λόγοισι τὴν τοῦδ' ἀμαθίαν ὑπὲρ σέθεν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:173.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:173.1.text#δεῖξαι· κακῶς γάρ σ' οὐκ ἐατέον κλύειν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:174.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:174.1.text#πρῶτον μὲν οὖν τἄρρητ' — ἐν ἀρρήτοισι γὰρ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:175.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:175.1.text#τὴν σὴν νομίζω δειλίαν, Ἡράκλεες —
urn:cts:greekLit:tlg0006.tlg009.fu.sp:176.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:176.1.text#σὺν μάρτυσιν θεοῖς δεῖ μ' ἀπαλλάξαι σέθεν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:177.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:177.1.text#Διὸς κεραυνόν τ' ἠρόμην τέθριππά τε,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:178.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:178.1.text#ἐν οἷς βεβηκὼς τοῖσι γῆς βλαστήμασιν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:179.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:179.1.text#Γίγασι πλευροῖς πτήν' ἐναρμόσας βέλη
urn:cts:greekLit:tlg0006.tlg009.fu.sp:180.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:180.1.text#τὸν καλλίνικον μετὰ θεῶν ἐκώμασεν·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:181.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:181.1.text#τετρασκελές θ' ὕβρισμα, Κενταύρων γένος,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:182.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:182.1.text#Φολόην ἐπελθών, ὦ κάκιστε βασιλέων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:183.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:183.1.text#ἐροῦ τίν' ἄνδρ' ἄριστον ἐγκρίνειαν ἄν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:184.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:184.1.text#ἢ οὐ παῖδα τὸν ἐμόν, ὃν σὺ φῂς εἶναι δοκεῖν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:185.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:185.1.text#Δίρφυν τ' ἐρωτῶν ἥ σ' ἔθρεψ' Ἀβαντίδα [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:186.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:186.1.text#οὐκ ἄν σ' ἐπαινέσειεν· οὐ γὰρ ἔσθ' ὅπου
urn:cts:greekLit:tlg0006.tlg009.fu.sp:187.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:187.1.text#ἐσθλόν τι δράσας μάρτυρ' ἂν λάβοις πάτραν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:188.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:188.1.text#τὸ πάνσοφον δ' εὕρημα, τοξήρη σαγήν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:189.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:189.1.text#μέμφῃ· κλύων νῦν τἀπ' ἐμοῦ σοφὸς γενοῦ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:190.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:190.1.text#ἀνὴρ ὁπλίτης δοῦλός ἐστι τῶν ὅπλων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:191.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:191.1.text#καὶ τοῖσι συνταχθεῖσιν οὖσι μὴ ἀγαθοῖς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:192.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:192.1.text#αὐτὸς τέθνηκε δειλίᾳ τῇ τῶν πέλας,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:193.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:193.1.text#θραύσας τε λόγχην οὐκ ἔχει τῷ σώματι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:194.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:194.1.text#θάνατον ἀμῦναι, μίαν ἔχων ἀλκὴν μόνον·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:195.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:195.1.text#ὅσοι δὲ τόξοις χεῖρ' ἔχουσιν εὔστοχον,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:196.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:196.1.text#ἓν μὲν τὸ λῷστον, μυρίους οἰστοὺς ἀφεὶς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:197.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:197.1.text#ἄλλοις τὸ σῶμα ῥύεται μὴ κατθανεῖν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:198.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:198.1.text#ἑκὰς δ' ἀφεστὼς πολεμίους ἀμύνεται
urn:cts:greekLit:tlg0006.tlg009.fu.sp:199.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:199.1.text#τυφλοῖς ὁρῶντας οὐτάσας τοξεύμασιν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:200.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:200.1.text#τὸ σῶμά τ' οὐ δίδωσι τοῖς ἐναντίοις,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:201.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:201.1.text#ἐν εὐφυλάκτῳ δ' ἐστί· τοῦτο δ' ἐν μάχῃ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:202.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:202.1.text#σοφὸν μάλιστα, δρῶντα πολεμίους κακῶς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:203.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:203.1.text#σῴζειν τὸ σῶμα, μὴ 'κ τύχης ὡρμισμένον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:204.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:204.1.text#λόγοι μὲν οἵδε τοῖσι σοῖς ἐναντίαν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:205.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:205.1.text#γνώμην ἔχουσι τῶν καθεστώτων πέρι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:206.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:206.1.text#παῖδας δὲ δὴ τί τούσδ' ἀποκτεῖναι θέλεις;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:207.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:207.1.text#τί σ' οἵδ' ἔδρασαν; ἕν τί σ' ἡγοῦμαι σοφόν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:208.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:208.1.text#εἰ τῶν ἀρίστων τἄκγον' αὐτὸς ὢν κακὸς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:209.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:209.1.text#δέδοικας. ἀλλὰ τοῦθ' ὅμως ἡμῖν βαρύ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:210.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:210.1.text#εἰ δειλίας σῆς κατθανούμεθ' εἵνεκα,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:211.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:211.1.text#ὃ χρῆν σ' ὑφ' ἡμῶν τῶν ἀμεινόνων παθεῖν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:212.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:212.1.text#εἰ Ζεὺς δικαίας εἶχεν εἰς ἡμᾶς φρένας.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:213.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:213.1.text#εἰ δ' οὖν ἔχειν γῆς σκῆπτρα τῆσδ' αὐτὸς θέλεις,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:214.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:214.1.text#ἔασον ἡμᾶς φυγάδας ἐξελθεῖν χθονός·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:215.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:215.1.text#βίᾳ δὲ δράσῃς μηδέν, ἢ πείσῃ βίαν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:216.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:216.1.text#ὅταν θεοῦ σοι πνεῦμα μεταβαλὸν τύχῃ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:217.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:217.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:217.2.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:217.2.text#ὦ γαῖα Κάδμου· καὶ γὰρ ἐς σὲ ἀφίξομαι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:218.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:218.1.text#λόγους ὀνειδιστῆρας ἐνδατούμενος·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:219.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:219.1.text#τοιαῦτ' ἀμύνεθ' Ἡρακλεῖ τέκνοισί τε;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:220.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:220.1.text#ὃς εἷς Μινύαισι πᾶσι διὰ μάχης μολὼν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:221.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:221.1.text#Θήβαις ἔθηκεν ὄμμ' ἐλεύθερον βλέπειν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:222.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:222.1.text#οὐδ' Ἑλλάδ' ᾔνεσ' — οὐδ' ἀνέξομαί ποτε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:223.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:223.1.text#σιγῶν — κακίστην λαμβάνων ἐς παῖδ' ἐμόν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:224.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:224.1.text#ἣν χρῆν νεοσσοῖς τοῖσδε πῦρ λόγχας ὅπλα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:225.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:225.1.text#φέρουσαν ἐλθεῖν, ποντίων καθαρμάτων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:226.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:226.1.text#χέρσου τ' ἀμοιβάς — ὧν ἐμόχθησας χάριν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:227.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:227.1.text#τὰ δ', ὦ τέκν', ὑμῖν οὔτε Θηβαίων πόλις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:228.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:228.1.text#οὔθ' Ἑλλὰς ἀρκεῖ· πρὸς δ' ἔμ' ἀσθενῆ φίλον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:229.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:229.1.text#δεδόρκατ', οὐδὲν ὄντα πλὴν γλώσσης ψόφον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:230.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:230.1.text#ῥώμη γὰρ ἐκλέλοιπεν ἣν πρὶν εἴχομεν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:231.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:231.1.text#γήρᾳ δὲ τρομερὰ γυῖα κἀμαυρὸν σθένος.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:232.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:232.1.text#εἰ δ' ἦ νέος τε κἄτι σώματος κρατῶν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:233.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:233.1.text#λαβὼν ἂν ἔγχος τοῦδε τοὺς ξανθοὺς πλόκους
urn:cts:greekLit:tlg0006.tlg009.fu.sp:234.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:234.1.text#καθῃμάτωσ' ἄν, ὥστ' Ἀτλαντικῶν πέραν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:235.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:235.1.text#φεύγειν ὅρων ἂν δειλίᾳ τοὐμὸν δόρυ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:236.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:236.1.text#ἆρ' οὐκ ἀφορμὰς τοῖς λόγοισιν ἁγαθοὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:237.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:237.1.text#θνητῶν ἔχουσι, κἂν βραδύς τις ᾖ λέγειν;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:238.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:238.1.text#σὺ μὲν λέγ' ἡμᾶς οἷς πεπύργωσαι λόγοις,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:239.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:239.1.text#ἐγὼ δὲ δράσω σ' ἀντὶ τῶν λόγων κακῶς.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:240.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:240.1.text#ἄγ', οἳ μὲν Ἑλικῶν', οἳ δὲ Παρνασοῦ πτυχὰς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:241.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:241.1.text#τέμνειν ἄνωχθ' ἐλθόντες ὑλουργοὺς δρυὸς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:242.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:242.1.text#κορμούς· ἐπειδὰν δ' ἐσκομισθῶσιν πόλει,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:243.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:243.1.text#βωμὸν πέριξ νήσαντες ἀμφήρη ξύλα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:244.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:244.1.text#ἐμπίμπρατ' αὐτῶν καὶ πυροῦτε σώματα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:245.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:245.1.text#πάντων, ἵν' εἰδῶσ' οὕνεκ' οὐχ ὁ κατθανὼν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:246.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:246.1.text#κρατεῖ χθονὸς τῆσδ', ἀλλ' ἐγὼ τὰ νῦν τάδε.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:247.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:247.1.text#ὑμεῖς δέ, πρέσβεις, ταῖς ἐμαῖς ἐναντίοι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:248.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:248.1.text#γνώμαισιν ὄντες, οὐ μόνον στενάξετε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:249.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:249.1.text#τοὺς Ἡρακλείους παῖδας, ἀλλὰ καὶ δόμου
urn:cts:greekLit:tlg0006.tlg009.fu.sp:250.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:250.1.text#τύχας, ὅταν πάσχῃ τι, μεμνήσεσθε δὲ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:251.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:251.1.text#δοῦλοι γεγῶτες τῆς ἐμῆς τυραννίδος.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:252.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:252.1.text#— ὦ γῆς λοχεύμαθ', οὓς Ἄρης σπείρει ποτὲ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:253.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:253.1.text#λάβρον δράκοντος ἐξερημώσας γένυν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:254.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:254.1.text#οὐ σκῆπτρα, χειρὸς δεξιᾶς ἐρείσματα,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:255.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:255.1.text#ἀρεῖτε καὶ τοῦδ' ἀνδρὸς ἀνόσιον κάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:256.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:256.1.text#καθαιματώσεθ', ὅστις οὐ Καδμεῖος ὢν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:257.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:257.1.text#ἄρχει κάκιστος τῶν νέων ἔπηλυς ὤν;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:258.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:258.1.text#ἀλλ' οὐκ ἐμοῦ γε δεσπόσεις χαίρων ποτέ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:259.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:259.1.text#— οὐδ' ἁπόνησα πόλλ' ἐγὼ καμὼν χερὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:260.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:260.1.text#ἕξεις. ἀπέρρων δ' ἔνθεν ἦλθες ἐνθάδε,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:261.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:261.1.text#ὕβριζ'. ἐμοῦ γὰρ ζῶντος οὐ κτενεῖς ποτε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:262.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:262.1.text#τοὺς Ἡρακλείους παῖδας. οὐ τοσόνδε γῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:263.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:263.1.text#ἔνερθ' ἐκεῖνος κρύπτεται λιπὼν τέκνα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:264.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:264.1.text#— ἐπεὶ σὺ μὲν γῆν τήνδε διολέσας ἔχεις,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:265.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:265.1.text#ὃ δ' ὠφελήσας ἀξίων οὐ τυγχάνει.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:266.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:266.1.text#— κἄπειτα πράσσω πόλλ' ἐγώ, φίλους ἐμοὺς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:267.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:267.1.text#θανόντας εὖ δρῶν, οὗ φίλων μάλιστα δεῖ;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:268.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:268.1.text#— ὦ δεξιὰ χείρ, ὡς ποθεῖς λαβεῖν δόρυ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:269.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:269.1.text#ἐν δ' ἀσθενείᾳ τὸν πόθον διώλεσας.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:270.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:270.1.text#ἐπεί σ' ἔπαυσ' ἂν δοῦλον ἐννέποντά με
urn:cts:greekLit:tlg0006.tlg009.fu.sp:271.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:271.1.text#καὶ τάσδε Θήβας εὐκλεῶς ᾠκήσαμεν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:272.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:272.1.text#ἐν αἷς σὺ χαίρεις· οὐ γὰρ εὖ φρονεῖ πόλις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:273.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:273.1.text#στάσει νοσοῦσα καὶ κακοῖς βουλεύμασιν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:274.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:274.1.text#οὐ γάρ ποτ' ἂν σὲ δεσπότην ἐκτήσατο.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:275.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:275.1.text#γέροντες, αἰνῶ· τῶν φίλων γὰρ οὕνεκα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:276.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:276.1.text#ὀργὰς δικαίας τοὺς φίλους ἔχειν χρεών·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:277.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:277.1.text#ἡμῶν δ' ἕκατι δεσπόταις θυμούμενοι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:278.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:278.1.text#πάθητε μηδέν. τῆς δ' ἐμῆς, Ἀμφιτρύων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:279.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:279.1.text#γνώμης ἄκουσον, ἤν τί σοι δοκῶ λέγειν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:280.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:280.1.text#ἐγὼ φιλῶ μὲν τέκνα· πῶς γὰρ οὐ φιλῶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:281.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:281.1.text#ἅτικτον, ἁμόχθησα; καὶ τὸ κατθανεῖν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:282.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:282.1.text#δεινὸν νομίζω· τῷ δ' ἀναγκαίῳ τρόπῳ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:283.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:283.1.text#ὃς ἀντιτείνει σκαιὸν ἡγοῦμαι βροτόν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:284.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:284.1.text#ἡμᾶς δ', ἐπειδὴ δεῖ θανεῖν, θνῄσκειν χρεὼν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:285.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:285.1.text#μὴ πυρὶ καταξανθέντας, ἐχθροῖσιν γέλων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:286.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:286.1.text#διδόντας, οὑμοὶ τοῦ θανεῖν μεῖζον κακόν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:287.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:287.1.text#ὀφείλομεν γὰρ πολλὰ δώμασιν καλά·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:288.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:288.1.text#σὲ μὲν δόκησις ἔλαβεν εὐκλεὴς δορός,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:289.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:289.1.text#ὥστ' οὐκ ἀνεκτὸν δειλίας θανεῖν σ' ὕπο·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:290.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:290.1.text#οὑμὸς δ' ἀμαρτύρητος εὐκλεὴς πόσις,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:291.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:291.1.text#ὡς τούσδε παῖδας οὐκ ἂν ἐκσῶσαι θέλοι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:292.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:292.1.text#δόξαν κακὴν λαβόντας· οἱ γὰρ εὐγενεῖς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:293.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:293.1.text#κάμνουσι τοῖς αἰσχροῖσι τῶν τέκνων ὕπερ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:294.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:294.1.text#ἐμοί τε μίμημ' ἀνδρὸς οὐκ ἀπωστέον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:295.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:295.1.text#σκέψαι δὲ τὴν σὴν ἐλπίδ' ᾗ λογίζομαι·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:296.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:296.1.text#ἥξειν νομίζεις παῖδα σὸν γαίας ὕπο;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:297.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:297.1.text#καὶ τίς θανόντων ἦλθεν ἐξ Ἅιδου πάλιν;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:298.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:298.1.text#ἀλλ' ὡς λόγοισι τόνδε μαλθάξαιμεν ἄν;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:299.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:299.1.text#ἥκιστα· φεύγειν σκαιὸν ἄνδρ' ἐχθρὸν χρεών,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:300.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:300.1.text#σοφοῖσι δ' εἴκειν καὶ τεθραμμένοις καλῶς·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:301.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:301.1.text#ῥᾷον γὰρ αἰδοῦς ὑπολαβὼν φίλ' ἂν τέμοις.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:302.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:302.1.text#ἤδη δ' ἐσῆλθέ μ' εἰ παραιτησαίμεθα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:303.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:303.1.text#φυγὰς τέκνων τῶνδ'· ἀλλὰ καὶ τόδ' ἄθλιον,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:304.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:304.1.text#πενίᾳ σὺν οἰκτρᾷ περιβαλεῖν σωτηρίαν·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:305.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:305.1.text#ὡς τὰ ξένων πρόσωπα φεύγουσιν φίλοις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:306.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:306.1.text#ἓν ἦμαρ ἡδὺ βλέμμ' ἔχειν φασὶν μόνον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:307.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:307.1.text#τόλμα μεθ' ἡμῶν θάνατον, ὃς μένει σ' ὅμως.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:308.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:308.1.text#προκαλούμεθ' εὐγένειαν, ὦ γέρον, σέθεν·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:309.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:309.1.text#τὰς τῶν θεῶν γὰρ ὅστις ἐκμοχθεῖ τύχας,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:310.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:310.1.text#πρόθυμός ἐστιν, ἡ προθυμία δ' ἄφρων·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:311.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:311.1.text#ὃ χρὴ γὰρ οὐδεὶς μὴ χρεὼν θήσει ποτέ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:312.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:312.1.text#εἰ μὲν σθενόντων τῶν ἐμῶν βραχιόνων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:313.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:313.1.text#ἦν τίς σ' ὑβρίζων, ῥᾳδίως ἐπαύσατ' ἄν·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:314.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:314.1.text#νῦν δ' οὐδέν ἐσμεν. σὸν δὲ τοὐντεῦθεν σκοπεῖν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:315.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:315.1.text#ὅπως διώσῃ τὰς τύχας, Ἀμφιτρύων.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:316.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:316.1.text#οὔτοι τὸ δειλὸν οὐδὲ τοῦ βίου πόθος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:317.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:317.1.text#θανεῖν ἐρύκει μ', ἀλλὰ παιδὶ βούλομαι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:318.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:318.1.text#σῷσαι τέκν'· ἄλλως δ' ἀδυνάτων ἔοικ' ἐρᾶν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:319.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:319.1.text#ἰδοὺ πάρεστιν ἥδε φασγάνῳ δέρη
urn:cts:greekLit:tlg0006.tlg009.fu.sp:320.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:320.1.text#κεντεῖν φονεύειν, ἱέναι πέτρας ἄπο.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:321.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:321.1.text#μίαν δὲ νῷν δὸς χάριν, ἄναξ, ἱκνούμεθα·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:322.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:322.1.text#κτεῖνόν με καὶ τήνδ' ἀθλίαν παίδων πάρος,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:323.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:323.1.text#ὡς μὴ τέκν' εἰσίδωμεν, ἀνόσιον θέαν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:324.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:324.1.text#ψυχορραγοῦντα καὶ καλοῦντα μητέρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:325.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:325.1.text#πατρός τε πατέρα. τἄλλα δ', εἰ πρόθυμος εἶ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:326.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:326.1.text#πρᾶσσ'· οὐ γὰρ ἀλκὴν ἔχομεν ὥστε μὴ θανεῖν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:327.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:327.1.text#κἀγώ σ' ἱκνοῦμαι χάριτι προσθεῖναι χάριν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:328.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:328.1.text# { ἡμῖν } ἵν' ἀμφοῖν εἷς ὑπουργήσῃς διπλᾶ·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:329.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:329.1.text#κόσμον πάρες μοι παισὶ προσθεῖναι νεκρῶν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:330.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:330.1.text#δόμους ἀνοίξας — νῦν γὰρ ἐκκεκλῄμεθα —
urn:cts:greekLit:tlg0006.tlg009.fu.sp:331.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:331.1.text#ὡς ἀλλὰ ταῦτά γ' ἀπολάχωσ' οἴκων πατρός.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:332.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:332.1.text#ἔσται τάδ'· οἴγειν κλῇθρα προσπόλοις λέγω.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:333.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:333.1.text#κοσμεῖσθ' ἔσω μολόντες· οὐ φθονῶ πέπλων.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:334.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:334.1.text#ὅταν δὲ κόσμον περιβάλησθε σώμασιν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:335.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:335.1.text#ἥξω πρὸς ὑμᾶς νερτέρᾳ δώσων χθονί.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:336.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:336.1.text#ὦ τέκν', ὁμαρτεῖτ' ἀθλίῳ μητρὸς ποδὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:337.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:337.1.text#πατρῷον ἐς μέλαθρον, οὗ τῆς οὐσίας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:338.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:338.1.text#ἄλλοι κρατοῦσι, τὸ δ' ὄνομ' ἔσθ' ἡμῶν ἔτι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:339.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:339.1.text#ὦ Ζεῦ, μάτην ἄρ' ὁμόγαμόν σ' ἐκτησάμην,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:340.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:340.1.text#μάτην δὲ παιδὸς κοινεῶν' ἐκλῄζομεν·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:341.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:341.1.text#σὺ δ' ἦσθ' ἄρ' ἥσσων ἢ 'δόκεις εἶναι φίλος.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:342.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:342.1.text#ἀρετῇ σε νικῶ θνητὸς ὢν θεὸν μέγαν·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:343.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:343.1.text#παῖδας γὰρ οὐ προύδωκα τοὺς Ἡρακλέους.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:344.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:344.1.text#σὺ δ' ἐς μὲν εὐνὰς κρύφιος ἠπίστω μολεῖν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:345.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:345.1.text#τἀλλότρια λέκτρα δόντος οὐδενὸς λαβών,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:346.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:346.1.text#σῴζειν δὲ τοὺς σοὺς οὐκ ἐπίστασαι φίλους.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:347.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:347.1.text#ἀμαθής τις εἶ θεός, ἢ δίκαιος οὐκ ἔφυς.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:348.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:348.1.text#—αἲ Λίνον μὲν ἐπ' εὐτυχεῖ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:349.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:349.1.text#μολπᾷ Φοῖβος ἰαχεῖ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:350.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:350.1.text#τὸν κάλλει φθιτόν, κιθάραν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:351.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:351.1.text#ἐλαύνων πλήκτρῳ χρυσέῳ·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:351.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:351.2.text#ἐγὼ δὲ τὸν γᾶς ἐνέρων τ'
urn:cts:greekLit:tlg0006.tlg009.fu.sp:352.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:352.1.text#ἐς ὄρφναν μολόντα, παῖδ'
urn:cts:greekLit:tlg0006.tlg009.fu.sp:353.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:353.1.text#εἴτε Διός νιν εἴπω,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:354.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:354.1.text#εἴτ' Ἀμφιτρύωνος ἶνιν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:355.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:355.1.text#ὑμνῆσαι στεφάνωμα μόχθων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:356.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:356.1.text#δι' εὐλογίας θέλω.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:357.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:357.1.text#γενναίων δ' ἀρεταὶ πόνων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:358.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:358.1.text#τοῖς θανοῦσιν ἄγαλμα. [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:359.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:359.1.text#—πρῶτον μὲν Διὸς ἄλσος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:360.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:360.1.text#ἠρήμωσε λέοντος,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:361.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:361.1.text#πυρσῷ δ' ἀμφεκαλύφθη
urn:cts:greekLit:tlg0006.tlg009.fu.sp:362.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:362.1.text#ξανθὸν κρᾶτ' ἐπινωτίσας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:363.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:363.1.text#δεινῷ χάσματι θηρός· [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:364.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:364.1.text#—τάν τ' ὀρεινόμον ἀγρίων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:365.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:365.1.text#Κενταύρων ποτὲ γένναν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:366.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:366.1.text#ἔστρωσεν τόξοις φονίοις,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:367.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:367.1.text#ἐναίρων πτανοῖς βέλεσιν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:368.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:368.1.text#ξύνοιδε Πηνειὸς ὁ καλλιδίνας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:369.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:369.1.text#μακραί τ' ἄρουραι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:369.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:369.2.text#πεδίων ἄκαρποι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:370.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:370.1.text#καὶ Πηλιάδες θεράπναι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:371.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:371.1.text#σύγχορτοί τ' Ὀμόλας ἔναυλοι,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:372.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:372.1.text#πεύκαισιν ὅθεν χέρας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:373.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:373.1.text#πληροῦντες χθόνα Θεσσαλῶν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:374.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:374.1.text#ἱππείαις ἐδάμαζον· [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:375.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:375.1.text#—τάν τε χρυσοκάρανον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:376.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:376.1.text#δόρκαν ποικιλόνωτον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:377.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:377.1.text#συλήτειραν ἀγρωστᾶν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:378.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:378.1.text#κτείνας, θηροφόνον θεὰν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:379.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:379.1.text#Οἰνωᾶτιν ἀγάλλει· [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:380.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:380.1.text#—τεθρίππων τ' ἐπέβα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:381.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:381.1.text#καὶ ψαλίοις ἐδάμασε πώλους
urn:cts:greekLit:tlg0006.tlg009.fu.sp:382.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:382.1.text#Διομήδεος, αἳ φονίαισι φάτναις ἀχάλιν' ἐθόαζον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:383.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:383.1.text#κάθαιμα σῖτα γένυσι,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:384.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:384.1.text#χαρμοναῖσιν ἀνδροβρῶσι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:385.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:385.1.text#δυστράπεζοι· πέραν δ'
urn:cts:greekLit:tlg0006.tlg009.fu.sp:386.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:386.1.text#ἀργυρορρύτων Ἕβρου
urn:cts:greekLit:tlg0006.tlg009.fu.sp:387.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:387.1.text#διεπέρασεν ὄχθων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:388.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:388.1.text#Μυκηναίῳ πονῶν τυράννῳ. [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:389.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:389.1.text#—ἄν τε Πηλιάδ' ἀκτὰν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:390.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:390.1.text#Ἀναύρου παρὰ πηγὰς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:391.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:391.1.text#Κύκνον ξεινοδαΐκταν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:392.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:392.1.text#τόξοις ὤλεσεν, Ἀμφαναίας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:393.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:393.1.text#οἰκήτορ' ἄμεικτον· [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:394.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:394.1.text#—ὑμνῳδούς τε κόρας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:395.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:395.1.text#ἤλυθεν ἑσπέριον ἐς αὐλάν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:396.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:396.1.text#χρυσέων πετάλων ἄπο μηλοφόρον χερὶ καρπὸν ἀμέρξων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:397.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:397.1.text#δράκοντα πυρσόνωτον,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:398.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:398.1.text#ὅς { σφ' } ἄπλατον ἀμφελικτὸς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:399.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:399.1.text#ἕλικ' ἐφρούρει, κτανών·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:400.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:400.1.text#ποντίας θ' ἁλὸς μυχοὺς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:401.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:401.1.text#εἰσέβαινε, θνατοῖς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:402.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:402.1.text#γαλανείας τιθεὶς ἐρετμοῖς· [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:403.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:403.1.text#—οὐρανοῦ θ' ὑπὸ μέσσαν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:404.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:404.1.text#ἐλαύνει χέρας ἕδραν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:405.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:405.1.text#Ἄτλαντος δόμον ἐλθών,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:406.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:406.1.text#ἀστρωπούς τε κατέσχεν οἴκους
urn:cts:greekLit:tlg0006.tlg009.fu.sp:407.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:407.1.text#εὐανορίᾳ θεῶν· [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:408.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:408.1.text#—τὸν ἱππευτάν τ' Ἀμαζόνων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:409.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:409.1.text#στρατὸν Μαιῶτιν ἀμφὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:410.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:410.1.text#πολυπόταμον ἔβα δι' Ἄξεινον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:410.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:410.2.text#οἶδμα λίμνας,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:411.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:411.1.text#τίν' οὐκ ἀφ' Ἑλλανίας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:412.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:412.1.text#ἄγορον ἁλίσας φίλων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:413.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:413.1.text#{ κόρας Ἀρείας πέπλων }
urn:cts:greekLit:tlg0006.tlg009.fu.sp:414.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:414.1.text#{ χρυσεόστολον φάρος, }
urn:cts:greekLit:tlg0006.tlg009.fu.sp:415.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:415.1.text#ζωστῆρος ὀλεθρίους ἄγρας.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:416.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:416.1.text#τὰ κλεινὰ δ' Ἑλλὰς ἔλαβε βαρβάρου
urn:cts:greekLit:tlg0006.tlg009.fu.sp:417.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:417.1.text#κόρας λάφυρα, καὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:418.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:418.1.text#σῴζεται Μυκήναις. [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:419.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:419.1.text#—τάν τε μυριόκρανον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:420.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:420.1.text#πολύφονον κύνα Λέρνας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:421.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:421.1.text#ὕδραν ἐξεπύρωσεν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:422.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:422.1.text#βέλεσί τ' ἀμφέβαλ' { ἰόν },
urn:cts:greekLit:tlg0006.tlg009.fu.sp:423.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:423.1.text#τὸν τρισώματον οἷσιν ἔκτα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:424.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:424.1.text#βοτῆρ' Ἐρυθείας. [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:425.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:425.1.text#—δρόμων τ' ἄλλων ἀγάλματ'
urn:cts:greekLit:tlg0006.tlg009.fu.sp:426.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:426.1.text#εὐτυχῆ διῆλθε· τόν τε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:427.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:427.1.text#πολυδάκρυον ἔπλευσ' ἐς Ἅιδαν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:427.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:427.2.text#πόνων τελευτάν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:428.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:428.1.text#ἵν' ἐκπεραίνει τάλας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:429.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:429.1.text#βίοτον, οὐδ' ἔβα πάλιν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:430.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:430.1.text#στέγαι δ' ἔρημοι φίλων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:431.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:431.1.text#τὰν δ' ἀνόστιμον τέκνων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:432.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:432.1.text#Χάρωνος ἐπιμένει πλάτα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:433.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:433.1.text#βίου κέλευθον ἄθεον ἄδικον·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:434.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:434.1.text#ἐς δὲ σὰς χέρας βλέπει
urn:cts:greekLit:tlg0006.tlg009.fu.sp:435.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:435.1.text#δώματ' οὐ παρόντος. [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:436.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:436.1.text#—εἰ δ' ἐγὼ σθένος ἥβων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:437.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:437.1.text#δόρυ τ' ἔπαλλον ἐν αἰχμᾷ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:438.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:438.1.text#Καδμείων τε σύνηβοι,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:439.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:439.1.text#τέκεσιν ἂν προπαρέσταν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:440.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:440.1.text#ἀλκᾷ· νῦν δ' ἀπολείπομαι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:441.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:441.1.text#τᾶς εὐδαίμονος ἥβας. [ … ][ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:442.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:442.1.text#—ἀλλ' ἐσορῶ γὰρ τούσδε φθιμένων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:443.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:443.1.text#ἔνδυτ' ἔχοντας, τοὺς τοῦ μεγάλου
urn:cts:greekLit:tlg0006.tlg009.fu.sp:444.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:444.1.text#δή ποτε παῖδας τὸ πρὶν Ἡρακλέους,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:445.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:445.1.text#ἄλοχόν τε φίλην ὑπὸ σειραίοις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:446.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:446.1.text#ποσὶν ἕλκουσαν τέκνα, καὶ γεραιὸν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:447.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:447.1.text#πατέρ' Ἡρακλέους. δύστηνος ἐγώ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:448.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:448.1.text#δακρύων ὡς οὐ δύναμαι κατέχειν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:450.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:450.1.text#γραίας ὄσσων ἔτι πηγάς.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:451.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:451.1.text#εἶἑν· τίς ἱερεύς, τίς σφαγεὺς τῶν δυσπότμων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:452.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:452.1.text# [ ἢ τῆς ταλαίνης τῆς ἐμῆς ψυχῆς φονεύς; ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:453.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:453.1.text#ἕτοιμ' ἄγειν τὰ θύματ' εἰς Ἅιδου τάδε.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:454.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:454.1.text#ὦ τέκν', ἀγόμεθα ζεῦγος οὐ καλὸν νεκρῶν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:455.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:455.1.text#ὁμοῦ γέροντες καὶ νέοι καὶ μητέρες.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:456.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:456.1.text#ὦ μοῖρα δυστάλαιν' ἐμή τε καὶ τέκνων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:457.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:457.1.text#τῶνδ', οὓς πανύστατ' ὄμμασιν προσδέρκομαι [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:458.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:458.1.text#ἔτεκον μὲν ὑμᾶς, πολεμίοις δ' ἐθρεψάμην
urn:cts:greekLit:tlg0006.tlg009.fu.sp:459.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:459.1.text#ὕβρισμα κἀπίχαρμα καὶ διαφθοράν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:460.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:460.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:460.2.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:460.2.text#ἦ πολύ με δόξης ἐξέπαισαν ἐλπίδες,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:461.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:461.1.text#ἣν πατρὸς ὑμῶν ἐκ λόγων ποτ' ἤλπισα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:462.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:462.1.text#σοὶ μὲν γὰρ Ἄργος ἔνεμ' ὁ κατθανὼν πατήρ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:463.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:463.1.text#Εὐρυσθέως δ' ἔμελλες οἰκήσειν δόμους
urn:cts:greekLit:tlg0006.tlg009.fu.sp:464.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:464.1.text#τῆς καλλικάρπου κράτος ἔχων Πελασγίας,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:465.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:465.1.text#στολήν τε θηρὸς ἀμφέβαλλε σῷ κάρᾳ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:466.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:466.1.text#λέοντος, ᾗπερ αὐτὸς ἐξωπλίζετο·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:467.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:467.1.text#σὺ δ' ἦσθα Θηβῶν τῶν φιλαρμάτων ἄναξ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:468.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:468.1.text#ἔγκληρα πεδία τἀμὰ γῆς κεκτημένος,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:469.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:469.1.text#ὡς ἐξέπειθες τὸν κατασπείραντά σε·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:470.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:470.1.text#ἐς δεξιάν τε σὴν ἀλεξητήριον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:471.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:471.1.text#ξύλον καθίει δαίδαλον, ψευδῆ δόσιν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:472.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:472.1.text#σοὶ δ' ἣν ἔπερσε τοῖς ἑκηβόλοις ποτὲ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:473.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:473.1.text#τόξοισι δώσειν Οἰχαλίαν ὑπέσχετο.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:474.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:474.1.text#τρεῖς δ' ὄντας { ὑμᾶς } τριπτύχοις τυραννίσι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:475.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:475.1.text#πατὴρ ἐπύργου, μέγα φρονῶν εὐανδρίᾳ·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:476.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:476.1.text#ἐγὼ δὲ νύμφας ἠκροθινιαζόμην,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:477.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:477.1.text#κήδη συνάψουσ', ἔκ τ' Ἀθηναίων χθονὸς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:478.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:478.1.text#Σπάρτης τε Θηβῶν θ', ὡς ἀνημμένοι κάλῳς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:479.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:479.1.text#πρυμνησίοισι βίον ἔχοιτ' εὐδαίμονα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:480.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:480.1.text#καὶ ταῦτα φροῦδα· μεταβαλοῦσα δ' ἡ τύχη
urn:cts:greekLit:tlg0006.tlg009.fu.sp:481.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:481.1.text#νύμφας μὲν ὑμῖν Κῆρας ἀντέδωκ' ἔχειν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:482.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:482.1.text#ἐμοὶ δὲ δάκρυα λουτρά — δύστηνος φρενῶν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:483.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:483.1.text#πατὴρ δὲ πατρὸς ἑστιᾷ γάμους ὅδε,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:484.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:484.1.text#Ἅιδην νομίζων πενθερόν, κῆδος πατρός.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:485.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:485.1.text#ὤμοι, τίν' ὑμῶν πρῶτον ἢ τίν' ὕστατον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:486.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:486.1.text#πρὸς στέρνα θῶμαι; τῷ προσαρμόσω στόμα;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:487.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:487.1.text#τίνος λάβωμαι; πῶς ἂν ὡς ξουθόπτερος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:488.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:488.1.text#μέλισσα συνενέγκαιμ' ἂν ἐκ πάντων γόους,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:489.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:489.1.text#ἐς ἓν δ' ἐνεγκοῦσ' ἀθρόον ἀποδοίην δάκρυ;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:490.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:490.1.text#ὦ φίλτατ', εἴ τις φθόγγος εἰσακούεται
urn:cts:greekLit:tlg0006.tlg009.fu.sp:491.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:491.1.text#θνητῶν παρ' Ἅιδῃ, σοὶ τάδ', Ἡράκλεις, λέγω·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:492.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:492.1.text#θνῄσκει πατὴρ σὸς καὶ τέκν', ὄλλυμαι δ' ἐγώ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:493.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:493.1.text#ἣ πρὶν μακαρία διὰ σ' ἐκλῃζόμην βροτοῖς.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:494.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:494.1.text#ἄρηξον, ἐλθέ· καὶ σκιὰ φάνηθί μοι·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:495.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:495.1.text#ἅλις γὰρ ἐλθὼν κἂν ὄναρ γένοιο σύ·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:496.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:496.1.text#κακοὶ γάρ εἰσιν οἳ τέκνα κτείνουσι σά.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:497.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:497.1.text#σὺ μὲν τὰ νέρθεν εὐτρεπῆ ποιοῦ, γύναι·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:498.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:498.1.text#ἐγὼ δὲ σέ, ὦ Ζεῦ, χεῖρ' ἐς οὐρανὸν δικὼν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:499.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:499.1.text#αὐδῶ, τέκνοισιν εἴ τι τοισίδ' ὠφελεῖν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:500.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:500.1.text#μέλλεις, ἀμύνειν, ὡς τάχ' οὐδὲν ἀρκέσεις.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:501.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:501.1.text#καίτοι κέκλησαι πολλάκις· μάτην πονῶ·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:502.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:502.1.text#θανεῖν γάρ, ὡς ἔοικ', ἀναγκαίως ἔχει.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:503.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:503.1.text#ἀλλ', ὦ γέροντες, μικρὰ μὲν τὰ τοῦ βίου,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:504.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:504.1.text#τοῦτον δ' ὅπως ἥδιστα διαπεράσετε,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:505.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:505.1.text#ἐξ ἡμέρας ἐς νύκτα μὴ λυπούμενοι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:506.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:506.1.text#ὡς ἐλπίδας μὲν ὁ χρόνος οὐκ ἐπίσταται
urn:cts:greekLit:tlg0006.tlg009.fu.sp:507.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:507.1.text#σῴζειν, τὸ δ' αὑτοῦ σπουδάσας διέπτατο.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:508.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:508.1.text#ὁρᾶτ' ἔμ' ὅσπερ ἦ περίβλεπτος βροτοῖς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:509.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:509.1.text#ὀνομαστὰ πράσσων, καί μ' ἀφείλεθ' ἡ τύχη
urn:cts:greekLit:tlg0006.tlg009.fu.sp:510.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:510.1.text#ὥσπερ πτερὸν πρὸς αἰθέρ' ἡμέρᾳ μιᾷ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:511.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:511.1.text#ὁ δ' ὄλβος ὁ μέγας ἥ τε δόξ' οὐκ οἶδ' ὅτῳ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:512.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:512.1.text#βέβαιός ἐστι. χαίρετ'· ἄνδρα γὰρ φίλον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:513.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:513.1.text#πανύστατον νῦν, ἥλικες, δεδόρκατε.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:514.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:514.1.text#ἔα·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:514.2.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:514.2.text#ὦ πρέσβυ, λεύσσω τἀμὰ φίλτατ'· ἢ τί φῶ;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:515.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:515.1.text#οὐκ οἶδα, θύγατερ· ἀφασία δὲ κἄμ' ἔχει.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:516.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:516.1.text#ὅδ' ἐστὶν ὃν γῆς νέρθεν εἰσηκούομεν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:517.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:517.1.text#εἰ μή γ' ὄνειρον ἐν φάει τι λεύσσομεν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:518.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:518.1.text#τί φημί; ποῖ' ὄνειρα κηραίνουσ' ὁρῶ;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:519.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:519.1.text#οὐκ ἔσθ' ὅδ' ἄλλος ἀντὶ σοῦ παιδός, γέρον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:520.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:520.1.text#δεῦρ', ὦ τέκν', ἐκκρίμνασθε πατρῴων πέπλων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:521.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:521.1.text#ἴτ' ἐγκονεῖτε, μὴ μεθῆτ', ἐπεὶ Διὸς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:522.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:522.1.text#σωτῆρος ὑμῖν οὐδέν ἐσθ' ὅδ' ὕστερος.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:523.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:523.1.text#ὦ χαῖρε, μέλαθρον πρόπυλά θ' ἑστίας ἐμῆς,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:524.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:524.1.text#ὡς ἄσμενός σ' ἐσεῖδον ἐς φάος μολών.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:525.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:525.1.text#ἔα· τί χρῆμα; τέκν' ὁρῶ πρὸ δωμάτων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:526.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:526.1.text#στολμοῖσι νεκρῶν κρᾶτας ἐξεστεμμένα,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:527.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:527.1.text#ὄχλῳ τ' ἐν ἀνδρῶν τὴν ἐμὴν ξυνάορον,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:528.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:528.1.text#πατέρα τε δακρύοντα — συμφορὰς τίνας;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:529.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:529.1.text#φέρ' ἐκπύθωμαι τῶνδε πλησίον σταθείς·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:530.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:530.1.text#γύναι, τί καινὸν ἦλθε δώμασιν χρέος;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:531.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:531.1.text#ὦ φίλτατ' ἀνδρῶν [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:531.2.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:531.2.text#ὦ φάος μολὼν πατρί [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:532.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:532.1.text#ἥκεις, ἐσώθης εἰς ἀκμὴν ἐλθὼν φίλοις;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:533.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:533.1.text#τί φῄς; τίν' ἐς ταραγμὸν ἥκομεν, πάτερ;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:534.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:534.1.text#διολλύμεσθα· σὺ δέ, γέρον, σύγγνωθί μοι,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:535.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:535.1.text#εἰ πρόσθεν ἥρπασ' ἃ σὲ λέγειν πρὸς τόνδ' ἐχρῆν·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:536.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:536.1.text#τὸ θῆλυ γάρ πως μᾶλλον οἰκτρὸν ἀρσένων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:537.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:537.1.text#καὶ τἄμ' ἔθνῃσκε τέκν', ἀπωλλύμην δ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:538.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:538.1.text#Ἄπολλον, οἵοις φροιμίοις ἄρχῃ λόγου.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:539.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:539.1.text#τεθνᾶσ' ἀδελφοὶ καὶ πατὴρ οὑμὸς γέρων.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:540.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:540.1.text#πῶς φῄς; τί δράσας ἢ δορὸς ποίου τυχών;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:541.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:541.1.text#Λύκος σφ' ὁ καινὸς γῆς ἄναξ διώλεσεν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:542.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:542.1.text#ὅπλοις ἀπαντῶν ἢ νοσησάσης χθονός;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:543.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:543.1.text#στάσει· τὸ Κάδμου δ' ἑπτάπυλον ἔχει κράτος.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:544.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:544.1.text#τί δῆτα πρὸς σὲ καὶ γέροντ' ἦλθεν φόβος;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:545.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:545.1.text#κτείνειν ἔμελλε πατέρα κἀμὲ καὶ τέκνα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:546.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:546.1.text#τί φῄς; τί ταρβῶν ὀρφάνευμ' ἐμῶν τέκνων;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:547.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:547.1.text#μή ποτε Κρέοντος θάνατον ἐκτεισαίατο.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:548.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:548.1.text#κόσμος δὲ παίδων τίς ὅδε νερτέροις πρέπων;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:549.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:549.1.text#θανάτου τάδ' ἤδη περιβόλαι' ἀνήμμεθα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:550.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:550.1.text#καὶ πρὸς βίαν ἐθνῄσκετ'; ὦ τλήμων ἐγώ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:551.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:551.1.text#φίλων { γ' } ἔρημοι· σὲ δὲ θανόντ' ἠκούομεν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:552.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:552.1.text#πόθεν δ' ἐς ὑμᾶς ἥδ' ἐσῆλθ' ἀθυμία;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:553.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:553.1.text#Εὐρυσθέως κήρυκες ἤγγελλον τάδε.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:554.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:554.1.text#τί δ' ἐξελείπετ' οἶκον ἑστίαν τ' ἐμήν;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:555.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:555.1.text#βίᾳ, πατὴρ μὲν ἐκπεσὼν στρωτοῦ λέχους [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:556.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:556.1.text#κοὐκ ἔσχεν αἰδῶ τὸν γέροντ' ἀτιμάσαι;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:557.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:557.1.text#αἰδώς γ' ἀποικεῖ τῆσδε τῆς θεοῦ πρόσω.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:558.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:558.1.text#οὕτω δ' ἀπόντες ἐσπανίζομεν φίλων;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:559.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:559.1.text#φίλοι γάρ εἰσιν ἀνδρὶ δυστυχεῖ τίνες;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:560.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:560.1.text#μάχας δὲ Μινυῶν ἃς ἔτλην ἀπέπτυσαν;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:561.1.speaker#Μεγάρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:561.1.text#ἄφιλον, ἵν' αὖθίς σοι λέγω, τὸ δυστυχές.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:562.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:562.1.text#οὐ ῥίψεθ' Ἅιδου τάσδε περιβολὰς κόμης
urn:cts:greekLit:tlg0006.tlg009.fu.sp:563.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:563.1.text#καὶ φῶς ἀναβλέψεσθε, τοῦ κάτω σκότου
urn:cts:greekLit:tlg0006.tlg009.fu.sp:564.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:564.1.text#φίλας ἀμοιβὰς ὄμμασιν δεδορκότες;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:565.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:565.1.text#ἐγὼ δέ — νῦν γὰρ τῆς ἐμῆς ἔργον χερός —
urn:cts:greekLit:tlg0006.tlg009.fu.sp:566.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:566.1.text#πρῶτον μὲν εἶμι καὶ κατασκάψω δόμους
urn:cts:greekLit:tlg0006.tlg009.fu.sp:567.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:567.1.text#καινῶν τυράννων, κρᾶτα δ' ἀνόσιον τεμὼν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:568.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:568.1.text#ῥίψω κυνῶν ἕλκημα· Καδμείων δ' ὅσους
urn:cts:greekLit:tlg0006.tlg009.fu.sp:569.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:569.1.text#κακοὺς ἐφηῦρον εὖ παθόντας ἐξ ἐμοῦ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:570.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:570.1.text#τῷ καλλινίκῳ τῷδ' ὅπλῳ χειρώσομαι·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:571.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:571.1.text#τοὺς δὲ πτερωτοῖς διαφορῶν τοξεύμασι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:572.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:572.1.text#νεκρῶν ἅπαντ' Ἰσμηνὸν ἐμπλήσω φόνου,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:573.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:573.1.text#Δίρκης τε νᾶμα λευκὸν αἱμαχθήσεται.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:574.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:574.1.text#τῷ γάρ μ' ἀμύνειν μᾶλλον ἢ δάμαρτι χρὴ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:575.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:575.1.text#καὶ παισὶ καὶ [ … ] γέροντι; χαιρόντων πόνοι·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:576.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:576.1.text#μάτην γὰρ αὐτοὺς τῶνδε μᾶλλον ἤνυσα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:577.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:577.1.text#καὶ δεῖ μ' ὑπὲρ τῶνδ', εἴπερ οἵδ' ὑπὲρ πατρός,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:578.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:578.1.text#θνῄσκειν ἀμύνοντ'· ἢ τί φήσομεν καλὸν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:579.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:579.1.text#ὕδρᾳ μὲν ἐλθεῖν ἐς μάχην λέοντί τε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:580.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:580.1.text#Εὐρυσθέως πομπαῖσι, τῶν δ' ἐμῶν τέκνων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:581.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:581.1.text#οὐκ ἐκπονήσω θάνατον; οὐκ ἄρ' Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:582.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:582.1.text#ὁ καλλίνικος ὡς πάροιθε λέξομαι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:583.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:583.1.text#δίκαια τοὺς τεκόντας ὠφελεῖν τέκνα,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:584.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:584.1.text#πατέρα τε πρέσβυν τήν τε κοινωνὸν γάμων.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:585.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:585.1.text#πρὸς σοῦ μέν, ὦ παῖ, τοῖς φίλοις { τ' } εἶναι φίλον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:586.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:586.1.text#τά τ' ἐχθρὰ μισεῖν· ἀλλὰ μὴ 'πείγου λίαν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:587.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:587.1.text#τί δ' ἐστὶ τῶνδε θᾶσσον ἢ χρεών, πάτερ;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:588.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:588.1.text#πολλοὺς πένητας, ὀλβίους δὲ τῷ λόγῳ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:589.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:589.1.text#δοκοῦντας εἶναι συμμάχους ἄναξ ἔχει,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:590.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:590.1.text#οἳ στάσιν ἔθηκαν καὶ διώλεσαν πόλιν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:591.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:591.1.text#ἐφ' ἁρπαγαῖσι τῶν πέλας, τὰ δ' ἐν δόμοις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:592.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:592.1.text#δαπάναισι φροῦδα διαφυγόνθ' ὑπ' ἀργίας.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:593.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:593.1.text#ὤφθης ἐσελθὼν πόλιν· ἐπεὶ δ' ὤφθης, ὅρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:594.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:594.1.text#ἐχθροὺς ἀθροίσας μὴ παρὰ γνώμην πέσῃς.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:595.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:595.1.text#μέλει μὲν οὐδὲν εἴ με πᾶσ' εἶδεν πόλις·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:596.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:596.1.text#ὄρνιν δ' ἰδών τιν' οὐκ ἐν αἰσίοις ἕδραις,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:597.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:597.1.text#ἔγνων πόνον τιν' ἐς δόμους πεπτωκότα·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:598.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:598.1.text#ὥστ' ἐκ προνοίας κρύφιος εἰσῆλθον χθόνα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:599.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:599.1.text#καλῶς· παρελθὼν νῦν πρόσειπέ θ' ἑστίαν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:600.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:600.1.text#καὶ δὸς πατρῴοις δώμασιν σὸν ὄμμ' ἰδεῖν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:601.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:601.1.text#ἥξει γὰρ αὐτὸς σὴν δάμαρτα καὶ τέκνα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:602.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:602.1.text#ἕλξων φονεύσων κἄμ' ἐπισφάξων ἄναξ·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:603.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:603.1.text#μένοντι δ' αὐτοῦ πάντα σοι γενήσεται
urn:cts:greekLit:tlg0006.tlg009.fu.sp:604.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:604.1.text#τῇ τ' ἀσφαλείᾳ κερδανεῖς· πόλιν δὲ σὴν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:605.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:605.1.text#μὴ πρὶν ταράξῃς πρὶν τόδ' εὖ θέσθαι, τέκνον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:606.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:606.1.text#δράσω τάδ'· εὖ γὰρ εἶπας· εἶμ' ἔσω δόμων.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:607.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:607.1.text#χρόνῳ δ' ἀνελθὼν ἐξ ἀνηλίων μυχῶν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:608.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:608.1.text#Ἅιδου Κόρης { τ' } ἔνερθεν, οὐκ ἀτιμάσω
urn:cts:greekLit:tlg0006.tlg009.fu.sp:609.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:609.1.text#θεοὺς προσειπεῖν πρῶτα τοὺς κατὰ στέγας.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:610.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:610.1.text#ἦλθες γὰρ ὄντως δώματ' εἰς Ἅιδου, τέκνον;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:611.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:611.1.text#καὶ θῆρά γ' ἐς φῶς τὸν τρίκρανον ἤγαγον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:612.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:612.1.text#μάχῃ κρατήσας ἢ θεᾶς δωρήμασιν;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:613.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:613.1.text#μάχῃ· τὰ μυστῶν δ' ὄργι' εὐτύχησ' ἰδών.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:614.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:614.1.text#ἦ καὶ κατ' οἴκους ἐστὶν Εὐρυσθέως ὁ θήρ;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:615.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:615.1.text#Χθονίας νιν ἄλσος Ἑρμιών τ' ἔχει πόλις.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:616.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:616.1.text#οὐδ' οἶδεν Εὐρυσθεύς σε γῆς ἥκοντ' ἄνω;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:617.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:617.1.text#οὐκ οἶδ'· ἵν' ἐλθὼν τἀνθάδ' εἰδείην πάρος.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:618.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:618.1.text#χρόνον δὲ πῶς τοσοῦτον ἦσθ' ὑπὸ χθονί;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:619.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:619.1.text#Θησέα κομίζων ἐχρόνισ' { ἐξ } Ἅιδου, πάτερ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:620.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:620.1.text#καὶ ποῦ 'στιν; ἢ γῆς πατρίδος οἴχεται πέδον;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:621.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:621.1.text#βέβηκ' Ἀθήνας νέρθεν ἄσμενος φυγών.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:622.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:622.1.text#ἀλλ' εἶ', ὁμαρτεῖτ', ὦ τέκν', ἐς δόμους πατρί·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:623.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:623.1.text#καλλίονές τἄρ' εἴσοδοι τῶν ἐξόδων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:624.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:624.1.text#πάρεισιν ὑμῖν. ἀλλὰ θάρσος ἴσχετε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:625.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:625.1.text#καὶ νάματ' ὄσσων μηκέτ' ἐξανίετε·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:626.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:626.1.text#σύ τ', ὦ γύναι μοι, σύλλογον ψυχῆς λαβὲ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:627.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:627.1.text#τρόμου τε παῦσαι, καὶ μέθεσθ' ἐμῶν πέπλων·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:628.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:628.1.text#οὐ γὰρ πτερωτὸς οὐδὲ φευξείω φίλους.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:629.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:629.1.text#ἆ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:629.2.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:629.2.text#οἵδ' οὐκ ἀφιᾶσ', ἀλλ' ἀνάπτονται πέπλων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:630.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:630.1.text#τοσῷδε μᾶλλον· ὧδ' ἔβητ' ἐπὶ ξυροῦ;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:631.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:631.1.text#ἄξω λαβών γε τούσδ' ἐφολκίδας χεροῖν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:632.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:632.1.text#ναῦς δ' ὣς ἐφέλξω· καὶ γὰρ οὐκ ἀναίνομαι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:633.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:633.1.text#θεράπευμα τέκνων. πάντα τἀνθρώπων ἴσα·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:634.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:634.1.text#φιλοῦσι παῖδας οἵ τ' ἀμείνονες βροτῶν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:635.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:635.1.text#οἵ τ' οὐδὲν ὄντες· χρήμασιν δὲ διάφοροι·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:636.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:636.1.text#ἔχουσιν, οἳ δ' οὔ· πᾶν δὲ φιλότεκνον γένος.  [ … ][ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:637.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:637.1.text#ἁ νεότας μοι φίλον αἰεί·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:638.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:638.1.text#τὸ δὲ γῆρας ἄχθος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:639.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:639.1.text#βαρύτερον Αἴτνας σκοπέλων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:640.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:640.1.text#ἐπὶ κρατὶ κεῖται, βλεφάρων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:642.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:642.1.text#σκοτεινὸν φάος ἐπικαλύψαν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:643.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:643.1.text#μή μοι μήτ' Ἀσιήτιδος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:644.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:644.1.text#τυραννίδος ὄλβος εἴη,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:645.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:645.1.text#μὴ χρυσοῦ δώματα πλήρη
urn:cts:greekLit:tlg0006.tlg009.fu.sp:646.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:646.1.text#τᾶς ἥβας ἀντιλαβεῖν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:647.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:647.1.text#ἃ καλλίστα μὲν ἐν ὄλβῳ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:648.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:648.1.text#καλλίστα δ' ἐν πενίᾳ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:649.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:649.1.text#τὸ δὲ λυγρὸν φόνιόν τε γῆρας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:650.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:650.1.text#μισῶ· κατὰ κυμάτων δ'
urn:cts:greekLit:tlg0006.tlg009.fu.sp:651.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:651.1.text#ἔρροι, μηδέ ποτ' ὤφελεν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:652.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:652.1.text#θνατῶν δώματα καὶ πόλεις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:653.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:653.1.text#ἐλθεῖν, ἀλλὰ κατ' αἰθέρ' αἰεὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:654.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:654.1.text#πτεροῖσι φορείσθω. [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:655.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:655.1.text#εἰ δὲ θεοῖς ἦν ξύνεσις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:656.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:656.1.text#καὶ σοφία κατ' ἄνδρας,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:657.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:657.1.text#δίδυμον ἂν ἥβαν ἔφερον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:659.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:659.1.text#φανερὸν χαρακτῆρ' ἀρετᾶς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:660.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:660.1.text#ὅσοισιν μέτα, κατθανόντες τ'
urn:cts:greekLit:tlg0006.tlg009.fu.sp:661.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:661.1.text#εἰς αὐγὰς πάλιν ἁλίου
urn:cts:greekLit:tlg0006.tlg009.fu.sp:662.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:662.1.text#δισσοὺς ἂν ἔβαν διαύλους,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:663.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:663.1.text#ἁ δυσγένεια δ' ἁπλοῦν ἂν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:664.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:664.1.text#εἶχεν ζόας βίοτον,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:665.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:665.1.text#καὶ τῷδ' ἦν τούς τε κακοὺς ἂν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:666.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:666.1.text#γνῶναι καὶ τοὺς ἀγαθούς,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:667.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:667.1.text#ἴσον ἅτ' ἐν νεφέλαισιν ἄστρων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:668.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:668.1.text#ναύταις ἀριθμὸς πέλει.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:669.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:669.1.text#νῦν δ' οὐδεὶς ὅρος ἐκ θεῶν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:670.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:670.1.text#χρηστοῖς οὐδὲ κακοῖς σαφής,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:671.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:671.1.text#ἀλλ' εἱλισσόμενός τις αἰὼν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:672.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:672.1.text#πλοῦτον μόνον αὔξει. [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:673.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:673.1.text#οὐ παύσομαι τὰς Χάριτας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:674.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:674.1.text#Μούσαις συγκαταμειγνύς,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:675.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:675.1.text#ἁδίσταν συζυγίαν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:676.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:676.1.text#μὴ ζῴην μετ' ἀμουσίας,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:677.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:677.1.text#αἰεὶ δ' ἐν στεφάνοισιν εἴην·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:678.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:678.1.text#ἔτι τοι γέρων ἀοιδὸς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:679.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:679.1.text#κελαδεῖ Μναμοσύναν·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:680.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:680.1.text#ἔτι τὰν Ἡρακλέους
urn:cts:greekLit:tlg0006.tlg009.fu.sp:681.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:681.1.text#καλλίνικον ἀείδω
urn:cts:greekLit:tlg0006.tlg009.fu.sp:682.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:682.1.text#παρά τε Βρόμιον οἰνοδόταν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:683.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:683.1.text#παρά τε χέλυος ἑπτατόνου
urn:cts:greekLit:tlg0006.tlg009.fu.sp:684.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:684.1.text#μολπὰν καὶ Λίβυν αὐλόν·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:685.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:685.1.text#οὔπω καταπαύσομεν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:686.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:686.1.text#Μούσας, αἵ μ' ἐχόρευσαν. [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:687.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:687.1.text#παιᾶνα μὲν Δηλιάδες
urn:cts:greekLit:tlg0006.tlg009.fu.sp:688.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:688.1.text#ὑμνοῦσ' ἀμφὶ πύλας τὸν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:689.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:689.1.text#Λατοῦς εὔπαιδα γόνον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:690.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:690.1.text#εἱλίσσουσαι καλλίχορον·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:691.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:691.1.text#παιᾶνας δ' ἐπὶ σοῖς μελάθροις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:692.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:692.1.text#κύκνος ὣς γέρων ἀοιδὸς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:693.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:693.1.text#πολιᾶν ἐκ γενύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:694.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:694.1.text#κελαδήσω· τὸ γὰρ εὖ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:695.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:695.1.text#τοῖς ὕμνοισιν ὑπάρχει·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:696.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:696.1.text#Διὸς ὁ παῖς· τᾶς δ' εὐγενίας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:697.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:697.1.text#πλέον ὑπερβάλλων { ἀρετᾷ }
urn:cts:greekLit:tlg0006.tlg009.fu.sp:698.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:698.1.text#μοχθήσας τὸν ἄκυμον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:699.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:699.1.text#θῆκεν βίοτον βροτοῖς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:700.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:700.1.text#πέρσας δείματα θηρῶν. [ … ][ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:701.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:701.1.text#ἐς καιρὸν οἴκων Ἀμφιτρύων ἔξω περᾷ·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:702.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:702.1.text#χρόνος γὰρ ἤδη δαρὸς ἐξ ὅτου πέπλοις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:703.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:703.1.text#κοσμεῖσθε σῶμα καὶ νεκρῶν ἀγάλμασιν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:704.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:704.1.text#ἀλλ' εἶα, παῖδας καὶ δάμαρθ' Ἡρακλέους
urn:cts:greekLit:tlg0006.tlg009.fu.sp:705.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:705.1.text#ἔξω κέλευε τῶνδε φαίνεσθαι δόμων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:706.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:706.1.text#ἐφ' οἷς ὑπέστητ' αὐτεπάγγελτοι θανεῖν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:707.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:707.1.text#ἄναξ, διώκεις μ' ἀθλίως πεπραγότα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:708.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:708.1.text#ὕβριν θ' ὑβρίζεις ἐπὶ θανοῦσι τοῖς ἐμοῖς·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:709.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:709.1.text#ἃ χρῆν σε μετρίως, κεἰ κρατεῖς, σπουδὴν ἔχειν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:710.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:710.1.text#ἐπεὶ δ' ἀνάγκην προστίθης ἡμῖν θανεῖν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:711.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:711.1.text#στέργειν ἀνάγκη· δραστέον δ' ἃ σοὶ δοκεῖ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:712.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:712.1.text#ποῦ δῆτα Μεγάρα; ποῦ τέκν' Ἀλκμήνης γόνου;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:713.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:713.1.text#δοκῶ μὲν αὐτήν, ὡς θύραθεν εἰκάσαι —
urn:cts:greekLit:tlg0006.tlg009.fu.sp:714.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:714.1.text#τί χρῆμα δόξης; τοῦ δ' ἔχεις τεκμήριον;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:715.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:715.1.text#ἱκέτιν πρὸς ἁγνοῖς Ἑστίας θάσσειν βάθροις [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:716.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:716.1.text#ἀνόνητά γ' ἱκετεύουσαν ἐκσῷσαι βίον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:717.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:717.1.text#καὶ τὸν θανόντα γ' ἀνακαλεῖν μάτην πόσιν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:718.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:718.1.text#ὃ δ' οὐ πάρεστιν οὐδὲ μὴ μόλῃ ποτέ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:719.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:719.1.text#οὔκ, εἴ γε μή τις θεῶν ἀναστήσειέ νιν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:720.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:720.1.text#χώρει πρὸς αὐτὴν κἀκκόμιζε δωμάτων.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:721.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:721.1.text#μέτοχος ἂν εἴην τοῦ φόνου δράσας τόδε.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:722.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:722.1.text#ἡμεῖς, ἐπειδὴ σοὶ τόδ' ἔστ' ἐνθύμιον,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:723.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:723.1.text#οἱ δειμάτων ἔξωθεν ἐκπορεύσομεν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:724.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:724.1.text#σὺν μητρὶ παῖδας. δεῦρ' ἕπεσθε, πρόσπολοι,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:725.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:725.1.text#ὡς ἂν σχολὴν λύσωμεν ἄσμενοι πόνων.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:726.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:726.1.text#σὺ δ' οὖν ἴθ', ἔρχῃ δ' οἷ χρεών· τὰ δ' ἄλλ' ἴσως
urn:cts:greekLit:tlg0006.tlg009.fu.sp:727.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:727.1.text#ἄλλῳ μελήσει. προσδόκα δὲ δρῶν κακῶς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:728.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:728.1.text#κακόν τι πράξειν. ὦ γέροντες, ἐς καλὸν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:729.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:729.1.text#στείχει, βρόχοισι δ' ἀρκύων γενήσεται
urn:cts:greekLit:tlg0006.tlg009.fu.sp:730.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:730.1.text#ξιφηφόροισι, τοὺς πέλας δοκῶν κτενεῖν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:731.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:731.1.text#ὁ παγκάκιστος. εἶμι δ', ὡς ἴδω νεκρὸν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:732.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:732.1.text#πίπτοντ'· ἔχει γὰρ ἡδονὰς θνῄσκων ἀνὴρ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:733.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:733.1.text#ἐχθρὸς τίνων τε τῶν δεδραμένων δίκην.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:735.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:735.1.text#—μεταβολὰ κακῶν· μέγας ὁ πρόσθ' ἄναξ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:736.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:736.1.text#πάλιν ὑποστρέφει βίοτον ἐξ Ἅιδα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:737.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:737.1.text#ἰώ·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:737.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:737.2.text#δίκα καὶ θεῶν παλίρρους πότμος.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:740.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:740.1.text#—ἦλθες χρόνῳ μὲν οὗ δίκην δώσεις θανών,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:741.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:741.1.text#ὕβρεις ὑβρίζων εἰς ἀμείνονας σέθεν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:742.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:742.1.text#—χαρμοναὶ δακρύων ἔδοσαν ἐκβολάς·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:744.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:744.1.text#πάλιν ἔμολεν —
urn:cts:greekLit:tlg0006.tlg009.fu.sp:745.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:745.1.text#ἃ πάρος οὔποτε διὰ φρενὸς ἤλπισ' ἂν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:746.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:746.1.text#παθεῖν — γᾶς ἄναξ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:747.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:747.1.text#—ἀλλ', ὦ γεραιοί, καὶ τὰ δωμάτων ἔσω
urn:cts:greekLit:tlg0006.tlg009.fu.sp:748.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:748.1.text#σκοπῶμεν, εἰ πράσσει τις ὡς ἐγὼ θέλω.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:750.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:750.1.text#ἰώ μοί μοι.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:751.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:751.1.text#—τόδε κατάρχεται μέλος ἐμοὶ κλύειν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:752.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:752.1.text#φίλιον ἐν δόμοις· θάνατος οὐ πόρσω.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:753.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:753.1.text#βοᾷ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:753.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:753.2.text#φόνου φροίμιον στενάζων ἄναξ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:754.1.speaker#Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:754.1.text#ὦ πᾶσα Κάδμου γαῖ', ἀπόλλυμαι δόλῳ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:755.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:755.1.text#—καὶ γὰρ διώλλυς· ἀντίποινα δ' ἐκτίνων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:756.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:756.1.text#τόλμα, διδούς γε τῶν δεδραμένων δίκην.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:757.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:757.1.text#—τίς ὁ θεοὺς ἀνομίᾳ χραίνων, θνητὸς ὤν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:757.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:757.2.text#ἄφρονα λόγον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:758.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:758.1.text#οὐρανίων μακάρων κατέβαλ', ὡς ἄρ' οὐ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:759.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:759.1.text#σθένουσιν θεοί;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:760.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:760.1.text#— γέροντες, οὐκέτ' ἔστι δυσσεβὴς ἀνήρ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:761.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:761.1.text#— σιγᾷ μέλαθρα· πρὸς χοροὺς τραπώμεθα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:762.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:762.1.text#— φίλοι γὰρ εὐτυχοῦσιν οὓς ἐγὼ θέλω. [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:763.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:763.1.text#—χοροὶ χοροὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:764.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:764.1.text#καὶ θαλίαι μέλουσι Θήβας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:764.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:764.2.text#ἱερὸν κατ' ἄστυ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:765.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:765.1.text#μεταλλαγαὶ γὰρ δακρύων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:766.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:766.1.text#μεταλλαγαὶ συντυχίας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:767.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:767.1.text# { νέας } ἔτεκον ἀοιδάς.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:768.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:768.1.text#βέβακ' ἄναξ ὁ καινός, ὁ δὲ παλαίτερος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:770.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:770.1.text#κρατεῖ, λιμένα λιπών γε τὸν Ἀχερόντιον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:771.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:771.1.text#δοκημάτων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:771.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:771.2.text#ἐκτὸς ἦλθεν ἐλπίς.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:772.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:772.1.text#θεοὶ θεοὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:772.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:772.2.text#τῶν ἀδίκων μέλουσι καὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:773.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:773.1.text#τῶν ὁσίων ἐπᾴειν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:774.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:774.1.text#ὁ χρυσὸς ἅ τ' εὐτυχία
urn:cts:greekLit:tlg0006.tlg009.fu.sp:775.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:775.1.text#φρενῶν βροτοὺς ἐξάγεται,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:776.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:776.1.text#δύνασιν ἄδικον ἐφέλκων.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:777.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:777.1.text#Χρόνου γὰρ οὔτις τὸ πάλιν εἰσορᾶν ἔτλα·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:778.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:778.1.text#νόμον παρέμενος, ἀνομίᾳ χάριν διδοὺς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:779.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:779.1.text#ἔθραυσεν ὄλβου
urn:cts:greekLit:tlg0006.tlg009.fu.sp:780.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:780.1.text#κελαινὸν ἅρμα. [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:781.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:781.1.text#Ἰσμήν' ὦ στεφαναφόρει,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:782.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:782.1.text#ξεσταί θ' ἑπταπύλου πόλεως
urn:cts:greekLit:tlg0006.tlg009.fu.sp:783.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:783.1.text#ἀναχορεύσατ' ἀγυιαί,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:784.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:784.1.text#Δίρκα θ' ἁ καλλιρρέεθρος,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:785.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:785.1.text#σύν τ' Ἀσωπιάδες κόραι,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:786.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:786.1.text#πατρὸς ὕδωρ βᾶτε λιποῦσαι συναοιδοί,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:788.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:788.1.text#Νύμφαι, τὸν Ἡρακλέους
urn:cts:greekLit:tlg0006.tlg009.fu.sp:789.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:789.1.text#καλλίνικον ἀγῶνα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:790.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:790.1.text#Πυθίου δενδρῶτι πέτρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:791.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:791.1.text#Μουσῶν θ' Ἑλικωνιάδων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:791.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:791.2.text#δώματ', ὤ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:792.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:792.1.text#ἥξετ' εὐγαθεῖ κελάδῳ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:793.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:793.1.text#ἐμὰν πόλιν, ἐμὰ τείχη,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:794.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:794.1.text#Σπαρτῶν ἵνα γένος ἔφανε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:795.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:795.1.text#χαλκασπίδων λόχος, ὃς γᾶν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:796.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:796.1.text#τέκνων τέκνοις μεταμείβει,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:797.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:797.1.text#Θήβαις ἱερὸν φῶς. [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:798.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:798.1.text#ὦ λέκτρων δύο συγγενεῖς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:799.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:799.1.text#εὐναί, θνατογενοῦς τε καὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:800.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:800.1.text#Διός, ὃς ἦλθεν ἐς εὐνὰν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:801.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:801.1.text#Νύμφας τᾶς Περσηίδος· ὡς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:802.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:802.1.text#πιστόν μοι τὸ παλαιὸν ἤδη
urn:cts:greekLit:tlg0006.tlg009.fu.sp:803.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:803.1.text#λέχος, ὦ Ζεῦ, σὸν ἐπ' οὐκ ἐλπίδι φάνθη,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:805.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:805.1.text#λαμπρὰν δ' ἔδειξ' ὁ χρόνος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:806.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:806.1.text#τὰν Ἡρακλέος ἀλκάν·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:807.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:807.1.text#γᾶς ὃς ἐξέβα θαλάμων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:808.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:808.1.text#Πλούτωνος δῶμα λιπὼν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:808.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:808.2.text#νέρτερον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:809.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:809.1.text#κρείσσων μοι τύραννος ἔφυς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:810.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:810.1.text#ἢ δυσγένει' ἀνάκτων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:811.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:811.1.text#ἃ νῦν ἐσορᾶν ἔφανε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:812.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:812.1.text#ξιφηφόρων ἐς ἀγώνων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:813.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:813.1.text#ἅμιλλαν, εἰ τὸ δίκαιον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:814.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:814.1.text#θεοῖς ἔτ' ἀρέσκει. [ … ][ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:815.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:815.1.text#— ἔα ἔα·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:816.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:816.1.text#ἆρ' ἐς τὸν αὐτὸν πίτυλον ἥκομεν φόβου,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:817.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:817.1.text#γέροντες, οἷον φάσμ' ὑπὲρ δόμων ὁρῶ;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:818.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:818.1.text#— φυγῇ φυγῇ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:819.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:819.1.text#νωθὲς πέδαιρε κῶλον, ἐκποδὼν ἔλα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:820.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:820.1.text#— ὦναξ Παιάν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:821.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:821.1.text#ἀπότροπος γένοιό μοι πημάτων.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:822.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:822.1.text#θαρσεῖτε Νυκτὸς τήνδ' ὁρῶντες ἔκγονον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:823.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:823.1.text#Λύσσαν, γέροντες, κἀμὲ τὴν θεῶν λάτριν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:824.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:824.1.text#Ἶριν· πόλει γὰρ οὐδὲν ἥκομεν βλάβος,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:825.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:825.1.text#ἑνὸς δ' ἐπ' ἀνδρὸς σῶμα συστρατεύομεν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:826.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:826.1.text#ὅν φασιν εἶναι Ζηνὸς Ἀλκμήνης τ' ἄπο.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:827.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:827.1.text#πρὶν μὲν γὰρ ἄθλους ἐκτελευτῆσαι πικρούς,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:828.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:828.1.text#τὸ χρή νιν ἐξέσῳζεν, οὐδ' εἴα πατὴρ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:829.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:829.1.text#Ζεύς νιν κακῶς δρᾶν οὔτ' ἔμ' οὔθ' Ἥραν ποτέ·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:830.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:830.1.text#ἐπεὶ δὲ μόχθους διεπέρασ' Εὐρυσθέως,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:831.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:831.1.text#Ἥρα προσάψαι καινὸν αἷμ' αὐτῷ θέλει
urn:cts:greekLit:tlg0006.tlg009.fu.sp:832.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:832.1.text#παῖδας κατακτείναντι, συνθέλω δ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:833.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:833.1.text#ἀλλ' εἶ', ἄτεγκτον συλλαβοῦσα καρδίαν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:834.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:834.1.text#Νυκτὸς κελαινῆς ἀνυμέναιε παρθένε,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:835.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:835.1.text#μανίας τ' ἐπ' ἀνδρὶ τῷδε καὶ παιδοκτόνους
urn:cts:greekLit:tlg0006.tlg009.fu.sp:836.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:836.1.text#φρενῶν ταραγμοὺς καὶ ποδῶν σκιρτήματα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:837.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:837.1.text#ἔλαυνε, κίνει, φόνιον ἐξίει κάλων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:838.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:838.1.text#ὡς ἂν πορεύσας δι' Ἀχερούσιον πόρον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:839.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:839.1.text#τὸν καλλίπαιδα στέφανον αὐθέντῃ φόνῳ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:840.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:840.1.text#γνῷ μὲν τὸν Ἥρας οἷός ἐστ' αὐτῷ χόλος,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:841.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:841.1.text#μάθῃ δὲ τὸν ἐμόν· ἢ θεοὶ μὲν οὐδαμοῦ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:842.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:842.1.text#τὰ θνητὰ δ' ἔσται μεγάλα, μὴ δόντος δίκην.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:843.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:843.1.text#ἐξ εὐγενοῦς μὲν πατρὸς ἔκ τε μητέρος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:844.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:844.1.text#πέφυκα, Νυκτὸς Οὐρανοῦ τ' ἀφ' αἵματος·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:845.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:845.1.text#{ τιμάς τ' ἔχω τάσδ' οὐκ ἀγασθῆναι φίλοις }
urn:cts:greekLit:tlg0006.tlg009.fu.sp:846.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:846.1.text#οὐδ' ἥδομαι φοιτῶσ' ἐπ' ἀνθρώπων φίλους,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:847.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:847.1.text#παραινέσαι δέ, πρὶν σφαλεῖσαν εἰσιδεῖν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:848.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:848.1.text#Ἥρᾳ θέλω σοί τ', ἢν πίθησθ' ἐμοῖς λόγοις.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:849.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:849.1.text#ἀνὴρ ὅδ' οὐκ ἄσημος οὔτ' ἐπὶ χθονὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:850.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:850.1.text#οὔτ' ἐν θεοῖσιν, οὗ σύ μ' ἐσπέμπεις δόμους·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:851.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:851.1.text#ἄβατον δὲ χώραν καὶ θάλασσαν ἀγρίαν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:852.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:852.1.text#ἐξημερώσας, θεῶν ἀνέστησεν μόνος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:853.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:853.1.text#τιμὰς πιτνούσας ἀνοσίων ἀνδρῶν ὕπο·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:853.2.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:853.2.text# [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:854.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:854.1.text#σοί τ' οὐ παραινῶ μεγάλα βούλεσθαι κακά.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:855.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:855.1.text#μὴ σὺ νουθέτει τά θ' Ἥρας κἀμὰ μηχανήματα.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:856.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:856.1.text#ἐς τὸ λῷον ἐμβιβάζω σ' ἴχνος ἀντὶ τοῦ κακοῦ.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:857.1.speaker#Ἶρις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:857.1.text#οὐχὶ σωφρονεῖν γ' ἔπεμψε δεῦρό σ' ἡ Διὸς δάμαρ.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:858.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:858.1.text#Ἥλιον μαρτυρόμεσθα δρῶσ' ἃ δρᾶν οὐ βούλομαι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:859.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:859.1.text#εἰ δὲ δή μ' Ἥρᾳ θ' ὑπουργεῖν σοί τ' ἀναγκαίως ἔχει
urn:cts:greekLit:tlg0006.tlg009.fu.sp:860.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:860.1.text#τάχος ἐπιρροίβδην θ' ὁμαρτεῖν ὡς κυνηγέτῃ κύνας,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:861.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:861.1.text#εἶμί γ'· οὔτε πόντος οὕτως κύμασιν στένων λάβρως
urn:cts:greekLit:tlg0006.tlg009.fu.sp:862.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:862.1.text#οὔτε γῆς σεισμὸς κεραυνοῦ τ' οἶστρος ὠδῖνας πνέων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:863.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:863.1.text#οἷ' ἐγὼ στάδια δραμοῦμαι στέρνον εἰς Ἡρακλέους·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:864.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:864.1.text#καὶ καταρρήξω μέλαθρα καὶ δόμους ἐπεμβαλῶ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:865.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:865.1.text#τέκν' ἀποκτείνασα πρῶτον· ὁ δὲ κανὼν οὐκ εἴσεται
urn:cts:greekLit:tlg0006.tlg009.fu.sp:866.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:866.1.text#παῖδας οὓς ἔτικτ' ἐναίρων, πρὶν ἂν ἐμὰς λύσσας ἀφῇ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:867.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:867.1.text#ἢν ἰδού· καὶ δὴ τινάσσει κρᾶτα βαλβίδων ἄπο
urn:cts:greekLit:tlg0006.tlg009.fu.sp:868.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:868.1.text#καὶ διαστρόφους ἑλίσσει σῖγα γοργωποὺς κόρας.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:869.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:869.1.text#ἀμπνοὰς δ' οὐ σωφρονίζει, ταῦρος ὣς ἐς ἐμβολὴν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:870.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:870.1.text#{ δεινός· μυκᾶται } δὲ Κῆρας ἀνακαλῶν τὰς Ταρτάρου.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:871.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:871.1.text#τάχα σ' ἐγὼ μᾶλλον χορεύσω καὶ καταυλήσω φόβῳ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:872.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:872.1.text#στεῖχ' ἐς Οὔλυμπον πεδαίρουσ', Ἶρι, γενναῖον πόδα·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:873.1.speaker#Λύσσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:873.1.text#ἐς δόμους δ' ἡμεῖς ἄφαντοι δυσόμεσθ' Ἡρακλέους.  [ … ] [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:875.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:875.1.text#—ὀτοτοτοτοτοῖ, στέναξον· ἀποκείρεται
urn:cts:greekLit:tlg0006.tlg009.fu.sp:876.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:876.1.text#σὸν ἄνθος πόλεος, ὁ Διὸς ἔκγονος·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:877.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:877.1.text#μέλεος Ἑλλάς, ἃ τὸν εὐεργέταν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:878.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:878.1.text#ἀποβαλεῖς, ὀλεῖς μανίαισιν Λύσσας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:879.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:879.1.text#χορευθέντ' ἐναύλοις.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:880.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:880.1.text#—βέβακεν ἐν δίφροισιν ἁ πολύστονος,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:881.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:881.1.text#ἅρμασι δ' ἐνδίδωσι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:882.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:882.1.text#κέντρον ὡς ἐπὶ λώβᾳ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:883.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:883.1.text#Νυκτὸς Γοργὼν ἑκατογκεφάλοις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:884.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:884.1.text#ὄφεων ἰαχήμασι, Λύσσα μαρμαρωπός.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:885.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:885.1.text#—ταχὺ τὸν εὐτυχῆ μετέβαλεν δαίμων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:886.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:886.1.text#ταχὺ δὲ πρὸς πατρὸς τέκν' ἐκπνεύσεται.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:887.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:887.1.text#ἰώ μοι μέλεος.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:888.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:888.1.text#—ἰὼ Ζεῦ, τὸ σὸν γένος ἄγονον αὐτίκα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:889.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:889.1.text#λυσσάδες ὠμοβρῶτες ἄδικοι Ποιναὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:890.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:890.1.text#κακοῖσιν ἐκπετάσουσιν.[ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:890.2.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:890.2.text#ἰὼ στέγαι.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:891.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:891.1.text#—κατάρχεται χόρευμα τυμπάνων ἄτερ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:892.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:892.1.text#οὐ βρομίῳ κεχαρισμένα θύρσῳ [ … ]   [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:893.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:893.1.text#ἰὼ δόμοι.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:894.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:894.1.text#πρὸς αἵματ', οὐχὶ τᾶς Διονυσιάδος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:895.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:895.1.text#βοτρύων ἐπὶ χεύμασι λοιβᾶς.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:896.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:896.1.text#φυγῇ, τέκν', ἐξορμᾶτε.[ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:896.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:896.2.text#—δάιον τόδε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:897.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:897.1.text#δάιον μέλος ἐπαυλεῖται.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:898.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:898.1.text#κυναγετεῖ τέκνων διωγμόν· οὔποτ' ἄκραντα δόμοισι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:899.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:899.1.text#Λύσσα βακχεύσει.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:900.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:900.1.text#αἰαῖ κακῶν.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:901.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:901.1.text#—αἰαῖ δῆτα τὸν γεραιὸν ὡς στένω
urn:cts:greekLit:tlg0006.tlg009.fu.sp:902.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:902.1.text#πατέρα τάν τε παιδοτρόφον, { ᾇ } μάταν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:903.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:903.1.text#τέκεα γεννᾶται.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:904.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:904.1.text#—ἰδοὺ ἰδού,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:905.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:905.1.text#θύελλα σείει δῶμα, συμπίπτει στέγη.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:906.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:906.1.text#ἢ ἤ· τί δρᾷς, ὦ Διὸς παῖ, μελάθρῳ;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:908.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:908.1.text#τάραγμα ταρτάρειον, ὡς ἐπ' Ἐγκελάδῳ ποτέ, Παλλάς,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:909.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:909.1.text#ἐς δόμους πέμπεις.  [ … ] [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:910.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:910.1.text#ὦ λευκὰ γήρᾳ σώματ' [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:910.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:910.2.text#ἀνακαλεῖς με τίνα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:911.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:911.1.text#βοάν;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:911.2.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:911.2.text#ἄλαστα τἀν δόμοισι. [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:911.3.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:911.3.text#μάντιν οὐχ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:912.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:912.1.text#ἕτερον ἄξομαι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:913.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:913.1.text#τεθνᾶσι παῖδες.[ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:913.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:913.2.text#αἰαῖ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:914.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:914.1.text#στενάζεθ', ὡς στενακτά. [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:914.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:914.2.text#δάιοι φόνοι,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:915.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:915.1.text#δάιοι δὲ τοκέων χέρες· ὤ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:916.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:916.1.text#οὐκ ἄν τις εἴποι μᾶλλον ἢ πεπόνθαμεν.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:917.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:917.1.text#πῶς παισὶ στενακτὰν ἄταν ἄταν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:918.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:918.1.text#πατέρος ἀμφαίνεις;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:919.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:919.1.text#λέγε, τίνα τρόπον ἔσυτο θεόθεν ἐπὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:920.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:920.1.text#μέλαθρα κακὰ τάδε,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:921.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:921.1.text#τλήμονάς τε παίδων τύχας;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:922.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:922.1.text#ἱερὰ μὲν ἦν πάροιθεν ἐσχάρας Διὸς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:923.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:923.1.text#καθάρσι' οἴκων, γῆς ἄνακτ' ἐπεὶ κτανὼν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:924.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:924.1.text#ἐξέβαλε τῶνδε δωμάτων Ἡρακλέης·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:925.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:925.1.text#χορὸς δὲ καλλίμορφος εἱστήκει τέκνων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:926.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:926.1.text#πατήρ τε Μεγάρα τ'· ἐν κύκλῳ δ' ἤδη κανοῦν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:927.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:927.1.text#εἵλικτο βωμοῦ, φθέγμα δ' ὅσιον εἴχομεν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:928.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:928.1.text#μέλλων δὲ δαλὸν χειρὶ δεξιᾷ φέρειν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:929.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:929.1.text#ἐς χέρνιβ' ὡς βάψειεν, Ἀλκμήνης τόκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:930.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:930.1.text#ἔστη σιωπῇ. καὶ χρονίζοντος πατρὸς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:931.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:931.1.text#παῖδες προσέσχον ὄμμ'· ὁ δ' οὐκέθ' αὑτὸς ἦν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:932.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:932.1.text#ἀλλ' ἐν στροφαῖσιν ὀμμάτων ἐφθαρμένος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:933.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:933.1.text#ῥίζας τ' ἐν ὄσσοις αἱματῶπας ἐκβαλὼν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:934.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:934.1.text#ἀφρὸν κατέσταζ' εὐτρίχου γενειάδος.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:935.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:935.1.text#ἔλεξε δ' ἅμα γέλωτι παραπεπληγμένῳ·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:936.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:936.1.text#Πάτερ, τί θύω πρὶν κτανεῖν Εὐρυσθέα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:937.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:937.1.text#καθάρσιον πῦρ, καὶ πόνους διπλοῦς ἔχω;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:938.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:938.1.text#ἔργον μιᾶς μοι χειρὸς εὖ θέσθαι τάδε·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:939.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:939.1.text#ὅταν δ' ἐνέγκω δεῦρο κρᾶτ' Εὐρυσθέως,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:940.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:940.1.text#ἐπὶ τοῖσι νῦν θανοῦσιν ἁγνιῶ χέρας.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:941.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:941.1.text#ἐκχεῖτε πηγάς, ῥίπτετ' ἐκ χειρῶν κανᾶ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:942.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:942.1.text#τίς μοι δίδωσι τόξα; τίς { δ' } ὅπλον χερός;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:943.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:943.1.text#πρὸς τὰς Μυκήνας εἶμι· λάζυσθαι χρεὼν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:944.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:944.1.text#μοχλοὺς δικέλλας θ', ὥστε Κυκλώπων βάθρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:945.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:945.1.text#φοίνικι κανόνι καὶ τύκοις ἡρμοσμένα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:946.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:946.1.text#στρεπτῷ σιδήρῳ συντριαινῶσαι πάλιν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:947.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:947.1.text#αὐτοῦ δὲ βαίνων ἅρματ' οὐκ ἔχων ἔχειν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:948.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:948.1.text#ἔφασκε, δίφρου δ' εἰσέβαινεν ἄντυγας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:949.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:949.1.text#κἄθεινε, κέντρον δῆθεν ὡς ἔχων, χερί.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:950.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:950.1.text#διπλοῦς δ' ὀπαδοῖς ἦν γέλως φόβος θ' ὁμοῦ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:951.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:951.1.text#καί τις τόδ' εἶπεν, ἄλλος εἰς ἄλλον δρακών·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:952.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:952.1.text#Παίζει πρὸς ἡμᾶς δεσπότης ἢ μαίνεται;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:953.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:953.1.text#ὁ δ' εἷρπ' ἄνω τε καὶ κάτω κατὰ στέγας,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:954.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:954.1.text#μέσον δ' ἐς ἀνδρῶν' ἐσπεσὼν Νίσου πόλιν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:955.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:955.1.text#ἥκειν ἔφασκε· δωμάτων τ' ἔσω βεβώς,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:956.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:956.1.text#κλιθεὶς ἐς οὖδας, ὡς ἔχει, σκευάζεται
urn:cts:greekLit:tlg0006.tlg009.fu.sp:957.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:957.1.text#θοίνην. διελθὼν δ' ὡς βραχὺν χρόνον μονῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:958.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:958.1.text#Ἰσθμοῦ ναπαίας ἔλεγε προσβαίνειν πλάκας.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:959.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:959.1.text#κἀνταῦθα γυμνὸν σῶμα θεὶς πορπαμάτων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:960.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:960.1.text#πρὸς οὐδέν' ἡμιλλᾶτο κἀκηρύσσετο
urn:cts:greekLit:tlg0006.tlg009.fu.sp:961.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:961.1.text#αὐτὸς πρὸς αὑτοῦ καλλίνικος οὐδενός,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:962.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:962.1.text#ἀκοὴν ὑπειπών. δεινὰ δ' Εὐρυσθεῖ βρέμων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:963.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:963.1.text#ἦν ἐν Μυκήναις τῷ λόγῳ. πατὴρ δέ νιν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:964.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:964.1.text#θιγὼν κραταιᾶς χειρὸς ἐννέπει τάδε·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:965.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:965.1.text#Ὦ παῖ, τί πάσχεις; τίς ὁ τρόπος ξενώσεως
urn:cts:greekLit:tlg0006.tlg009.fu.sp:966.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:966.1.text#τῆσδ'; οὔ τί που φόνος σ' ἐβάκχευσεν νεκρῶν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:967.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:967.1.text#οὓς ἄρτι καίνεις; ὁ δέ νιν Εὐρυσθέως δοκῶν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:968.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:968.1.text#πατέρα προταρβοῦνθ' ἱκέσιον ψαύειν χερός,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:969.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:969.1.text#ὠθεῖ, φαρέτραν δ' εὐτρεπῆ σκευάζεται
urn:cts:greekLit:tlg0006.tlg009.fu.sp:970.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:970.1.text#καὶ τόξ' ἑαυτοῦ παισί, τοὺς Εὐρυσθέως
urn:cts:greekLit:tlg0006.tlg009.fu.sp:971.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:971.1.text#δοκῶν φονεύειν. οἳ δὲ ταρβοῦντες φόβῳ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:972.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:972.1.text#ὤρουον ἄλλος ἄλλοσ', ἐς πέπλους ὁ μὲν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:973.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:973.1.text#μητρὸς ταλαίνης, ὁ δ' ὑπὸ κίονος σκιάν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:974.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:974.1.text#ἄλλος δὲ βωμὸν ὄρνις ὣς ἔπτηξ' ὕπο.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:975.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:975.1.text#βοᾷ δὲ μήτηρ· Ὦ τεκών, τί δρᾷς; τέκνα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:976.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:976.1.text#κτείνεις; βοᾷ δὲ πρέσβυς οἰκετῶν τ' ὄχλος.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:977.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:977.1.text#ὁ δ' ἐξελίσσων παῖδα κίονος κύκλῳ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:978.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:978.1.text#τόρνευμα δεινὸν ποδός, ἐναντίον σταθεὶς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:979.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:979.1.text#βάλλει πρὸς ἧπαρ· ὕπτιος δὲ λαΐνους
urn:cts:greekLit:tlg0006.tlg009.fu.sp:980.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:980.1.text#ὀρθοστάτας ἔδευσεν ἐκπνέων βίον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:981.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:981.1.text#ὁ δ' ἠλάλαξε κἀπεκόμπασεν τάδε·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:982.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:982.1.text#Εἷς μὲν νεοσσὸς ὅδε θανὼν Εὐρυσθέως
urn:cts:greekLit:tlg0006.tlg009.fu.sp:983.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:983.1.text#ἔχθραν πατρῴαν ἐκτίνων πέπτωκέ μοι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:984.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:984.1.text#ἄλλῳ δ' ἐπεῖχε τόξ', ὃς ἀμφὶ βωμίαν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:985.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:985.1.text#ἔπτηξε κρηπῖδ' ὡς λεληθέναι δοκῶν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:986.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:986.1.text#φθάνει δ' ὁ τλήμων γόνασι προσπεσὼν πατρός,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:987.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:987.1.text#καὶ πρὸς γένειον χεῖρα καὶ δέρην βαλών,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:988.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:988.1.text#Ὦ φίλτατ', αὐδᾷ, μή μ' ἀποκτείνῃς, πάτερ·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:989.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:989.1.text#σός εἰμι, σὸς παῖς· οὐ τὸν Εὐρυσθέως ὀλεῖς.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:990.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:990.1.text#ὁ δ' ἀγριωπὸν ὄμμα Γοργόνος στρέφων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:991.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:991.1.text#ὡς ἐντὸς ἔστη παῖς λυγροῦ τοξεύματος,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:992.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:992.1.text#μυδροκτύπον μίμημ', ὑπὲρ κάρα βαλὼν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:993.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:993.1.text#ξύλον καθῆκε παιδὸς ἐς ξανθὸν κάρα,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:994.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:994.1.text#ἔρρηξε δ' ὀστᾶ. δεύτερον δὲ παῖδ' ἑλών,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:995.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:995.1.text#χωρεῖ τρίτον θῦμ' ὡς ἐπισφάξων δυοῖν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:996.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:996.1.text#ἀλλὰ φθάνει νιν ἡ τάλαιν' ἔσω δόμων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:997.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:997.1.text#μήτηρ ὑπεκλαβοῦσα, καὶ κλῄει πύλας.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:998.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:998.1.text#ὁ δ' ὡς ἐπ' αὐτοῖς δὴ Κυκλωπίοισιν ὢν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:999.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:999.1.text#σκάπτει μοχλεύει θύρετρα, κἀκβαλὼν σταθμὰ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1000.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1000.1.text#δάμαρτα καὶ παῖδ' ἑνὶ κατέστρωσεν βέλει.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1001.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1001.1.text#κἀνθένδε πρὸς γέροντος ἱππεύει φόνον·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1002.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1002.1.text#ἀλλ' ἦλθεν εἰκών, ὡς ὁρᾶν ἐφαίνετο,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1003.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1003.1.text#Παλλὰς κραδαίνουσ' ἔγχος { ἐπὶ λόφῳ κέαρ },
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1004.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1004.1.text#κἄρριψε πέτρον στέρνον εἰς Ἡρακλέους,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1005.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1005.1.text#ὅς νιν φόνου μαργῶντος ἔσχε, κεἰς ὕπνον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1006.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1006.1.text#καθῆκε· πίτνει δ' ἐς πέδον, πρὸς κίονα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1007.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1007.1.text#νῶτον πατάξας, ὃς πεσήμασι στέγης
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1008.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1008.1.text#διχορραγὴς ἔκειτο κρηπίδων ἔπι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1010.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1010.1.text#ἡμεῖς δ' ἐλευθεροῦντες ἐκ δρασμῶν πόδα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1009.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1009.1.text#σὺν τῷ γέροντι δεσμὰ σειραίων βρόχων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1011.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1011.1.text#ἀνήπτομεν πρὸς κίον', ὡς λήξας ὕπνου
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1012.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1012.1.text#μηδὲν προσεργάσαιτο τοῖς δεδραμένοις.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1013.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1013.1.text#εὕδει δ' ὁ τλήμων ὕπνον οὐκ εὐδαίμονα,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1014.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1014.1.text#παῖδας φονεύσας καὶ δάμαρτ'. ἐγὼ μὲν οὖν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1015.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1015.1.text#οὐκ οἶδα θνητῶν ὅστις ἀθλιώτερος.  [ … ] [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1016.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1016.1.text#—ὁ φόνος ἦν ὃν Ἀργολὶς ἔχει πέτρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1017.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1017.1.text#τότε μὲν περισαμότατος καὶ ἄπιστος Ἑλλάδι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1018.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1018.1.text#τῶν Δαναοῦ παίδων· τάδε δ' ὑπερέβαλε, παρέδραμε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1020.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1020.1.text#τὰ τότε κακὰ [ … ] τάλανι διογενεῖ κόρῳ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1021.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1021.1.text#—μονοτέκνου Πρόκνης φόνον ἔχω λέξαι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1023.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1023.1.text#θυόμενον Μούσαις· σὺ δὲ τέκνα τρίγον', ὦ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1024.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1024.1.text#δάιε, τεκόμενος, λυσσάδι συγκατειργάσω μοίρᾳ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1025.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1025.1.text#—αἰαῖ, τίνα στεναγμὸν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1026.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1026.1.text#ἢ γόον ἢ φθιτῶν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1027.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1027.1.text#ᾠδάν, ἢ τὸν Ἅιδα χορὸν ἀχήσω;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1028.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1028.1.text#—φεῦ φεῦ·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1029.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1029.1.text#ἴδεσθε, διάνδιχα κλῇθρα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1030.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1030.1.text#κλίνεται ὑψιπύλων δόμων.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1031.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1031.1.text#—ἰώ μοι·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1032.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1032.1.text#ἴδεσθε δὲ τέκνα πρὸ πατρὸς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1033.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1033.1.text#ἄθλια κείμενα δυστάνου,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1034.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1034.1.text#εὕδοντος ὕπνον δεινὸν ἐκ παίδων φόνου.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1035.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1035.1.text#—περὶ δὲ δεσμὰ καὶ πολύβροχ' ἁμμάτων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1036.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1036.1.text#ἐρείσμαθ' Ἡράκλειον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1037.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1037.1.text#ἀμφὶ δέμας τάδε λαΐνοις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1038.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1038.1.text#ἀνημμένα κίοσιν οἴκων.  [ … ] [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1039.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1039.1.text#—ὁ δ' ὥς τις ὄρνις ἄπτερον καταστένων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1040.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1040.1.text#ὠδῖνα τέκνων, πρέσβυς ὑστέρῳ ποδὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1041.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1041.1.text#πικρὰν διώκων ἤλυσιν πάρεσθ' ὅδε.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1042.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1042.1.text#Καδμεῖοι γέροντες, οὐ σῖγα σῖγα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1043.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1043.1.text#τὸν ὕπνῳ παρειμένον ἐάσετ' ἐκλαθέσθαι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1044.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1044.1.text#κακῶν; [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1045.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1045.1.text#κατὰ σὲ δακρύοις στένω, πρέσβυ, καὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1046.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1046.1.text#τέκεα καὶ τὸ καλλίνικον κάρα.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1047.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1047.1.text#ἑκαστέρω πρόβατε, μὴ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1048.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1048.1.text#κτυπεῖτε, μὴ βοᾶτε, μὴ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1049.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1049.1.text#τὸν εὔδι' ἰαύονθ'
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1049.2.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1049.2.text#ὑπνώδεά τ' εὐνᾶς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1050.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1050.1.text#ἐγείρετε.[ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1050.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1050.2.text#οἴμοι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1051.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1051.1.text#φόνος ὅσος ὅδ' [ … ] [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1051.2.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1051.2.text#ἆ ἆ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1052.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1052.1.text#διά μ' ὀλεῖτε.[ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1052.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1052.2.text#κεχυμένος ἐπαντέλλει.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1053.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1053.1.text#οὐκ ἀτρεμαῖα θρῆνον αἰάξετ',
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1054.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1054.1.text#ὦ γέροντες;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1055.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1055.1.text#ἢ δέσμ' ἀνεγειρόμενος χαλάσας ἀπολεῖ πόλιν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1056.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1056.1.text#ἀπὸ δὲ πατέρα, μέλαθρά τε καταράξει.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1057.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1057.1.text#ἀδύνατ' ἀδύνατά μοι.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1057.2.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1057.2.text#σῖγα, πνοὰς μάθω·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1060.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1060.1.text#φέρε πρὸς οὖς βάλω.[ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1060.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1060.2.text#εὕδει;[ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1060.3.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1060.3.text#ναί, εὕδει
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1061.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1061.1.text#ὕπνον γ' ἄυπνον ὀλόμενον, ὃς ἔκανεν ἄλοχον,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1064.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1064.1.text#ἔκανε δὲ τέκεα, τοξήρει ψαλμῷ [ τοξεύσας ].  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1065.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1065.1.text#στέναζέ νυν — [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1065.2.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1065.2.text#στενάζω.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1066.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1066.1.text#τέκνων ὄλεθρον — [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1066.2.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1066.2.text#ὤμοι.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1067.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1067.1.text#σέθεν τε παιδὸς — [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1067.2.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1067.2.text#αἰαῖ.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1068.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1068.1.text#ὦ πρέσβυ [ … ] [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1068.2.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1068.2.text#σῖγα σῖγα·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1069.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1069.1.text#παλίντροπος ἐξεγειρόμενος στρέφεται· φέρε,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1070.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1070.1.text#ἀπόκρυφον δέμας ὑπὸ μέλαθρον κρύψω.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1071.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1071.1.text#θάρσει· νὺξ ἔχει βλέφαρα παιδὶ σῷ.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1072.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1072.1.text#ὁρᾶθ' ὁρᾶτε. τὸ φάος ἐκλιπεῖν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1073.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1073.1.text#μὲν ἐπὶ κακοῖσιν οὐ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1074.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1074.1.text#φεύγω τάλας, ἀλλ' εἴ με κανεῖ πατέρ' ὄντα,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1075.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1075.1.text#πρὸς δὲ κακοῖς κακὰ μήσεται
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1076.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1076.1.text#πρὸς Ἐρινύσι θ' αἷμα σύγγονον ἕξει.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1078.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1078.1.text#τότε θανεῖν σ' ἐχρῆν, ὅτε δάμαρτι σᾷ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1079.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1079.1.text#φόνον ὁμοσπόρων ἔμολες ἐκπράξας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1080.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1080.1.text#Ταφίων περίκλυστον ἄστυ πέρσας.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1081.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1081.1.text#φυγὰν φυγάν, γέροντες, ἀποπρὸ δωμάτων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1082.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1082.1.text#διώκετε· φεύγετε μάργον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1083.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1083.1.text#ἄνδρ' ἐπεγειρόμενον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1084.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1084.1.text# { ἢ } τάχα φόνον ἕτερον ἐπὶ φόνῳ βαλὼν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1085.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1085.1.text#ἀν' αὖ βακχεύσει Καδμείων πόλιν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1086.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1086.1.text#ὦ Ζεῦ, τί παῖδ' ἤχθηρας ὧδ' ὑπερκότως
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1087.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1087.1.text#τὸν σόν, κακῶν δὲ πέλαγος ἐς τόδ' ἤγαγες;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1088.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1088.1.text#ἔα·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1089.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1089.1.text#ἔμπνους μέν εἰμι καὶ δέδορχ' ἅπερ με δεῖ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1090.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1090.1.text#αἰθέρα τε καὶ γῆν τόξα θ' Ἡλίου τάδε [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1091.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1091.1.text#ὡς ἐν κλύδωνι καὶ φρενῶν ταράγματι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1092.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1092.1.text#πέπτωκα δεινῷ καὶ πνοὰς θερμὰς πνέω
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1093.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1093.1.text#μετάρσι', οὐ βέβαια, πνευμόνων ἄπο.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1094.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1094.1.text#ἰδού, τί δεσμοῖς ναῦς ὅπως ὡρμισμένος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1095.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1095.1.text#νεανίαν θώρακα καὶ βραχίονα,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1096.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1096.1.text#πρὸς ἡμιθραύστῳ λαΐνῳ τυκίσματι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1097.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1097.1.text#ἧμαι, νεκροῖσι γείτονας θάκους ἔχων;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1098.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1098.1.text#πτερωτά τ' ἔγχη· τόξα δ' ἔσπαρται πέδῳ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1099.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1099.1.text#ἃ πρὶν παρασπίζοντ' ἐμοῖς βραχίοσιν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1100.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1100.1.text#ἔσῳζε πλευρὰς ἐξ ἐμοῦ τ' ἐσῴζετο.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1101.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1101.1.text#οὔ που κατῆλθον αὖθις εἰς Ἅιδου πάλιν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1102.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1102.1.text#Εὐρυσθέως δίαυλον; εἰς Ἅιδου; πόθεν;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1103.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1103.1.text#ἀλλ' οὔτε Σισύφειον εἰσορῶ πέτρον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1104.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1104.1.text#Πλούτωνά τ', οὐδὲ σκῆπτρα Δήμητρος κόρης.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1105.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1105.1.text#ἔκ τοι πέπληγμαι· ποῦ ποτ' ὢν ἀμηχανῶ;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1106.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1106.1.text#ὠή, τίς ἐγγὺς ἢ πρόσω φίλων ἐμῶν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1107.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1107.1.text#δύσγνοιαν ὅστις τὴν ἐμὴν ἰάσεται;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1108.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1108.1.text#σαφῶς γὰρ οὐδὲν οἶδα τῶν εἰωθότων.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1109.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1109.1.text#γέροντες, ἔλθω τῶν ἐμῶν κακῶν πέλας;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1110.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1110.1.text#κἀγώ γε σὺν σοί, μὴ προδοὺς τὰς συμφοράς.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1111.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1111.1.text#πάτερ, τί κλαίεις καὶ συναμπίσχῃ κόρας,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1112.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1112.1.text#τοῦ φιλτάτου σοι τηλόθεν παιδὸς βεβώς;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1113.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1113.1.text#ὦ τέκνον· εἶ γὰρ καὶ κακῶς πράσσων ἐμός.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1114.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1114.1.text#πράσσω δ' ἐγὼ τί λυπρόν, οὗ δακρυρροεῖς;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1115.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1115.1.text#ἃ κἂν θεῶν τις, εἰ μάθοι, καταστένοι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1116.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1116.1.text#μέγας γ' ὁ κόμπος, τὴν τύχην δ' οὔπω λέγεις.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1117.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1117.1.text#ὁρᾷς γὰρ αὐτός, εἰ φρονῶν ἤδη κυρεῖς.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1118.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1118.1.text#εἴπ', εἴ τι καινὸν ὑπογράφῃ τὠμῷ βίῳ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1119.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1119.1.text#εἰ μηκέθ' Ἅιδου βάκχος εἶ, φράσαιμεν ἄν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1120.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1120.1.text#παπαῖ, τόδ' ὡς ὕποπτον ᾐνίξω πάλιν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1121.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1121.1.text#καί σ' εἰ βεβαίως εὖ φρονεῖς ἤδη σκοπῶ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1122.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1122.1.text#οὐ γάρ τι βακχεύσας γε μέμνημαι φρένας.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1123.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1123.1.text#λύσω, γέροντες, δεσμὰ παιδός; ἢ τί δρῶ;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1124.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1124.1.text#καὶ τόν γε δήσαντ' εἴπ'· ἀναινόμεσθα γάρ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1125.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1125.1.text#τοσοῦτον ἴσθι τῶν κακῶν· τὰ δ' ἄλλ' ἔα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1126.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1126.1.text#ἀρκεῖ σιωπὴ γὰρ μαθεῖν ὃ βούλομαι;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1127.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1127.1.text#ὦ Ζεῦ, παρ' Ἥρας ἆρ' ὁρᾷς θρόνων τάδε;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1128.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1128.1.text#ἀλλ' ἦ τι κεῖθεν πολέμιον πεπόνθαμεν;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1129.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1129.1.text#τὴν θεὸν ἐάσας τὰ σὰ περιστέλλου κακά.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1130.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1130.1.text#ἀπωλόμεσθα· συμφορὰν λέξεις τινά.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1131.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1131.1.text#ἰδού, θέασαι τάδε τέκνων πεσήματα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1132.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1132.1.text#οἴμοι· τίν' ὄψιν τήνδε δέρκομαι τάλας;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1133.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1133.1.text#ἀπόλεμον, ὦ παῖ, πόλεμον ἔσπευσας τέκνοις.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1134.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1134.1.text#τί πόλεμον εἶπας; τούσδε τίς διώλεσε;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1135.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1135.1.text#σὺ καὶ σὰ τόξα καὶ θεῶν ὃς αἴτιος.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1136.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1136.1.text#τί φῄς; τί δράσας; ὦ κάκ' ἀγγέλλων πάτερ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1137.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1137.1.text#μανείς· ἐρωτᾷς δ' ἄθλι' ἑρμηνεύματα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1138.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1138.1.text#ἦ καὶ δάμαρτός εἰμ' ἐγὼ φονεὺς ἐμῆς;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1139.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1139.1.text#μιᾶς ἅπαντα χειρὸς ἔργα σῆς τάδε.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1140.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1140.1.text#αἰαῖ· στεναγμῶν γάρ με περιβάλλει νέφος.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1141.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1141.1.text#τούτων ἕκατι σὰς καταστένω τύχας.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1142.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1142.1.text#{ ἦ γὰρ συνήραξ' οἶκον ἢ βάκχευσ' ἐμόν; }
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1143.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1143.1.text#οὐκ οἶδα πλὴν ἕν· πάντα δυστυχεῖ τὰ σά.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1144.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1144.1.text#ποῦ δ' οἶστρος ἡμᾶς ἔλαβε; ποῦ διώλεσεν;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1145.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1145.1.text#ὅτ' ἀμφὶ βωμὸν χεῖρας ἡγνίζου πυρί.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1146.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1146.1.text#οἴμοι· τί δῆτα φείδομαι ψυχῆς ἐμῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1147.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1147.1.text#τῶν φιλτάτων μοι γενόμενος παίδων φονεύς;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1148.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1148.1.text#κοὐκ εἶμι πέτρας λισσάδος πρὸς ἅλματα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1149.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1149.1.text#ἢ φάσγανον πρὸς ἧπαρ ἐξακοντίσας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1150.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1150.1.text#τέκνοις δικαστὴς αἵματος γενήσομαι;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1151.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1151.1.text#ἢ σάρκα τὴν ἔμηνεν ἐμπρήσας πυρί,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1152.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1152.1.text#δύσκλειαν ἣ μένει μ' ἀπώσομαι βίου;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1153.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1153.1.text#ἀλλ' ἐμποδών μοι θανασίμων βουλευμάτων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1154.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1154.1.text#Θησεὺς ὅδ' ἕρπει συγγενὴς φίλος τ' ἐμός.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1155.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1155.1.text#ὀφθησόμεσθα, καὶ τεκνοκτόνον μύσος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1156.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1156.1.text#ἐς ὄμμαθ' ἥξει φιλτάτῳ ξένων ἐμῶν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1157.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1157.1.text#οἴμοι, τί δράσω; ποῖ κακῶν ἐρημίαν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1158.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1158.1.text#εὕρω, πτερωτὸς ἢ κατὰ χθονὸς μολών;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1159.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1159.1.text#{ φέρ' [ … ] ἄν τι } κρατὶ περιβάλω σκότον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1160.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1160.1.text#αἰσχύνομαι γὰρ τοῖς δεδραμένοις κακοῖς·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1161.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1161.1.text#καὶ τῶνδε προστρόπαιον αἷμα προσλαβὼν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1162.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1162.1.text#οὐδὲν κακῶσαι τοὺς ἀναιτίους θέλω.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1163.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1163.1.text#ἥκω σὺν ἄλλοις, οἳ παρ' Ἀσωποῦ ῥοὰς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1164.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1164.1.text#μένουσιν, ἔνοπλοι γῆς Ἀθηναίων κόροι,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1165.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1165.1.text#σῷ παιδί, πρέσβυ, σύμμαχον φέρων δόρυ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1166.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1166.1.text#κληδὼν γὰρ ἦλθεν εἰς Ἐρεχθειδῶν πόλιν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1167.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1167.1.text#ὡς σκῆπτρα χώρας τῆσδ' ἀναρπάσας Λύκος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1168.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1168.1.text#ἐς πόλεμον ὑμῖν καὶ μάχην καθίσταται.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1169.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1169.1.text#τίνων δ' ἀμοιβὰς ὧν ὑπῆρξεν Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1170.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1170.1.text#σῴσας με νέρθεν, ἦλθον, εἴ τι δεῖ, γέρον,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1171.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1171.1.text#ἢ χειρὸς ὑμᾶς τῆς ἐμῆς ἢ συμμάχων.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1172.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1172.1.text#ἔα·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1172.2.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1172.2.text#τί νεκρῶν τῶνδε πληθύει πέδον;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1173.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1173.1.text#οὔ που λέλειμμαι καὶ νεωτέρων κακῶν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1174.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1174.1.text#ὕστερος ἀφῖγμαι; τίς τάδ' ἔκτεινεν τέκνα;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1175.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1175.1.text#τίνος γεγῶσαν τήνδ' ὁρῶ ξυνάορον;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1176.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1176.1.text#οὐ γὰρ δορός γε παῖδες ἵστανται πέλας,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1177.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1177.1.text#ἀλλ' ἄλλο πού τι καινὸν εὑρίσκω κακόν.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1178.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1178.1.text#ὦ τὸν ἐλαιοφόρον ὄχθον ἔχων { ἄναξ } [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1179.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1179.1.text#τί χρῆμά μ' οἰκτροῖς ἐκάλεσας προοιμίοις;  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1180.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1180.1.text#ἐπάθομεν πάθεα μέλεα πρὸς θεῶν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1181.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1181.1.text#οἱ παῖδες οἵδε τίνες, ἐφ' οἷς δακρυρροεῖς;  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1182.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1182.1.text#ἔτεκε μέν { νιν } οὑμὸς ἶνις τάλας,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1183.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1183.1.text#τεκόμενος δ' ἔκανε, φόνιον αἷμα τλάς.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1184.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1184.1.text#εὔφημα φώνει.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1185.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1185.1.text#βουλομένοισιν ἐπαγγέλλῃ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1186.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1186.1.text#ὦ δεινὰ λέξας.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1187.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1187.1.text#οἰχόμεθ' οἰχόμεθα πτανοί.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1188.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1188.1.text#τί φῄς; τί δράσας;  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1189.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1189.1.text#μαινομένῳ πιτύλῳ πλαγχθεὶς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1190.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1190.1.text#ἑκατογκεφάλου { τε } βαφαῖς ὕδρας.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1191.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1191.1.text#Ἥρας ὅδ' ἁγών· τίς δ' ὅδ' οὑν νεκροῖς, γέρον;  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1192.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1192.1.text#ἐμὸς ἐμὸς ὅδε γόνος ὁ πολύπονος, { ὃς } ἐπὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1193.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1193.1.text#δόρυ γιγαντοφόνον ἦλθεν σὺν θεοῖσι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1194.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1194.1.text#Φλεγραῖον ἐς πεδίον ἀσπιστάς.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1195.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1195.1.text#φεῦ φεῦ· τίς ἀνδρῶν ὧδε δυσδαίμων ἔφυ;  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1196.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1196.1.text#οὐκ ἂν εἰδείης ἕτερον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1197.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1197.1.text#πολυμοχθότερον πολυπλαγκτότερόν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1197.2.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1197.2.text#τε θνατῶν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1198.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1198.1.text#τί γὰρ πέπλοισιν ἄθλιον κρύπτει κάρα;  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1199.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1199.1.text#αἰδόμενος τὸ σὸν ὄμμα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1200.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1200.1.text#καὶ φιλίαν ὁμόφυλον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1201.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1201.1.text#αἷμά τε παιδοφόνον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1202.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1202.1.text#ἀλλ', εἰ συναλγῶν γ' ἦλθον, ἐκκάλυπτέ νιν.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1204.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1204.1.text#ὦ τέκνον· πάρες ἀπ' ὀμμάτων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1205.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1205.1.text#πέπλον, ἀπόδικε, ῥέθος ἀελίῳ δεῖξον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1206.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1206.1.text#βάρος ἀντίπαλον, δακρύοις συναμιλλαταί,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1207.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1207.1.text#ἱκετεύομεν ἀμφὶ γενειάδα καὶ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1209.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1209.1.text#γόνυ καὶ χέρα σὰν προπίτνων, πολιόν τε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1210.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1210.1.text#δάκρυον ἐκβάλλων· ἰὼ παῖ, κατάσχεθε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1211.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1211.1.text#λέοντος ἀγρίου θυμόν, ὡς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1212.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1212.1.text#βρόμον ἐπὶ φόνιον ἀνόσιον ἐξάγῃ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1213.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1213.1.text#κακὰ θέλων κακοῖς συνάψαι, τέκνον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1214.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1214.1.text#εἶἑν· σὲ τὸν θάσσοντα δυστήνους ἕδρας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1215.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1215.1.text#αὐδῶ, φίλοισιν ὄμμα δεικνύναι τὸ σόν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1216.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1216.1.text#οὐδεὶς σκότος γὰρ ὧδ' ἔχει μέλαν νέφος,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1217.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1217.1.text#ὅστις κακῶν σῶν συμφορὰν κρύψειεν ἄν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1218.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1218.1.text#τί μοι προσείων χεῖρα σημαίνεις φόνον;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1219.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1219.1.text#ὡς μὴ μύσος με σῶν βάλῃ προσφθεγμάτων;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1220.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1220.1.text#οὐδὲν μέλει μοι σύν γε σοὶ πράσσειν κακῶς·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1221.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1221.1.text#καὶ γάρ ποτ' εὐτύχησα. ἐκεῖσ' ἀνοιστέον,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1222.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1222.1.text#ὅτ' ἐξέσῳσάς μ' ἐς φάος νεκρῶν πάρα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1223.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1223.1.text#χάριν δὲ γηράσκουσαν ἐχθαίρω φίλων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1224.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1224.1.text#καὶ τῶν καλῶν μὲν ὅστις ἀπολαύειν θέλει,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1225.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1225.1.text#συμπλεῖν δὲ τοῖς φίλοισι δυστυχοῦσιν οὔ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1226.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1226.1.text#ἀνίστασ', ἐκκάλυψον ἄθλιον κάρα,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1227.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1227.1.text#βλέψον πρὸς ἡμᾶς. ὅστις εὐγενὴς βροτῶν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1228.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1228.1.text#φέρει τά γ' ἐκ θεῶν πτώματ' οὐδ' ἀναίνεται.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1229.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1229.1.text#Θησεῦ, δέδορκας τόνδ' ἀγῶν' ἐμῶν τέκνων;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1230.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1230.1.text#ἤκουσα, καὶ βλέποντι σημαίνεις κακά.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1231.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1231.1.text#τί δῆτά μου κρᾶτ' ἀνεκάλυψας ἡλίῳ;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1232.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1232.1.text#τί δ'; οὐ μιαίνεις θνητὸς ὢν τὰ τῶν θεῶν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1233.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1233.1.text#φεῦγ', ὦ ταλαίπωρ', ἀνόσιον μίασμ' ἐμόν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1234.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1234.1.text#οὐδεὶς ἀλάστωρ τοῖς φίλοις ἐκ τῶν φίλων.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1235.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1235.1.text#ἐπῄνεσ'· εὖ δράσας δέ σ' οὐκ ἀναίνομαι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1236.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1236.1.text#ἐγὼ δὲ πάσχων εὖ τότ' οἰκτίρω σε νῦν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1237.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1237.1.text#οἰκτρὸς γάρ εἰμι τἄμ' ἀποκτείνας τέκνα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1238.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1238.1.text#κλαίω χάριν σὴν ἐφ' ἑτέραισι συμφοραῖς.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1239.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1239.1.text#ηὗρες δέ γ' ἄλλους ἐν κακοῖσι μείζοσιν;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1240.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1240.1.text#ἅπτῃ κάτωθεν οὐρανοῦ δυσπραξίᾳ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1241.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1241.1.text#τοιγὰρ παρεσκευάσμεθ' ὥστε κατθανεῖν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1242.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1242.1.text#δοκεῖς ἀπειλῶν σῶν μέλειν τι δαίμοσιν;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1243.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1243.1.text#αὔθαδες ὁ θεός, πρὸς δὲ τοὺς θεοὺς ἐγώ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1244.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1244.1.text#ἴσχε στόμ', ὡς μὴ μέγα λέγων μεῖζον πάθῃς.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1245.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1245.1.text#γέμω κακῶν δή, κοὐκέτ' ἔσθ' ὅπῃ τεθῇ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1246.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1246.1.text#δράσεις δὲ δὴ τί; ποῖ φέρῃ θυμούμενος;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1247.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1247.1.text#θανών, ὅθενπερ ἦλθον, εἶμι γῆς ὕπο.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1248.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1248.1.text#εἴρηκας ἐπιτυχόντος ἀνθρώπου λόγους.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1249.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1249.1.text#σὺ δ' ἐκτὸς ὤν γε συμφορᾶς με νουθετεῖς.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1250.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1250.1.text#ὁ πολλὰ δὴ τλὰς Ἡρακλῆς λέγει τάδε;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1251.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1251.1.text#οὐκ οὖν τοσαῦτά γ', εἰ μέτρῳ μοχθητέον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1252.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1252.1.text#εὐεργέτης βροτοῖσι καὶ μέγας φίλος;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1253.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1253.1.text#οἱ δ' οὐδὲν ὠφελοῦσί μ', ἀλλ' Ἥρα κρατεῖ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1254.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1254.1.text#οὐκ ἄν { σ' } ἀνάσχοιθ' Ἑλλὰς ἀμαθίᾳ θανεῖν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1255.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1255.1.text#ἄκουε δή νυν, ὡς ἁμιλληθῶ λόγοις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1256.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1256.1.text#πρὸς νουθετήσεις σάς· ἀναπτύξω δέ σοι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1257.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1257.1.text#ἀβίωτον ἡμῖν νῦν τε καὶ πάροιθεν ὄν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1258.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1258.1.text#πρῶτον μὲν ἐκ τοῦδ' ἐγενόμην, ὅστις κτανὼν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1259.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1259.1.text#μητρὸς γεραιὸν πατέρα προστρόπαιος ὢν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1260.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1260.1.text#ἔγημε τὴν τεκοῦσαν Ἀλκμήνην ἐμέ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1261.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1261.1.text#ὅταν δὲ κρηπὶς μὴ καταβληθῇ γένους
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1262.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1262.1.text#ὀρθῶς, ἀνάγκη δυστυχεῖν τοὺς ἐκγόνους.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1263.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1263.1.text#Ζεὺς δ' — ὅστις ὁ Ζεύς — πολέμιόν μ' ἐγείνατο
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1264.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1264.1.text#Ἥρᾳ — σὺ μέντοι μηδὲν ἀχθεσθῇς, γέρον·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1265.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1265.1.text#πατέρα γὰρ ἀντὶ Ζηνὸς ἡγοῦμαι σὲ ἐγώ·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1266.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1266.1.text#ἔτ' ἐν γάλακτί τ' ὄντι γοργωποὺς ὄφεις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1267.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1267.1.text#ἐπεισέφρησε σπαργάνοισι τοῖς ἐμοῖς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1268.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1268.1.text#ἡ τοῦ Διὸς σύλλεκτρος, ὡς ὀλοίμεθα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1269.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1269.1.text#ἐπεὶ δὲ σαρκὸς περιβόλαι' ἐκτησάμην
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1270.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1270.1.text#ἡβῶντα, μόχθους οὓς ἔτλην τί δεῖ λέγειν;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1271.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1271.1.text#ποίους ποτ' ἢ λέοντας ἢ τρισωμάτους
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1272.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1272.1.text#Τυφῶνας ἢ Γίγαντας ἢ τετρασκελῆ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1273.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1273.1.text#κενταυροπληθῆ πόλεμον οὐκ ἐξήνυσα;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1274.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1274.1.text#τήν τ' ἀμφίκρανον καὶ παλιμβλαστῆ κύνα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1275.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1275.1.text#ὕδραν φονεύσας μυρίων τ' ἄλλων πόνων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1276.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1276.1.text#διῆλθον ἀγέλας κἀς νεκροὺς ἀφικόμην,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1277.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1277.1.text#Ἅιδου πυλωρὸν κύνα τρίκρανον ἐς φάος
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1278.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1278.1.text#ὅπως πορεύσαιμ' ἐντολαῖς Εὐρυσθέως.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1279.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1279.1.text#τὸν λοίσθιον δὲ τόνδ' ἔτλην τάλας πόνον,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1280.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1280.1.text#παιδοκτονήσας δῶμα θριγκῶσαι κακοῖς.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1281.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1281.1.text#ἥκω δ' ἀνάγκης ἐς τόδ'· οὔτ' ἐμαῖς φίλαις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1282.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1282.1.text#Θήβαις ἐνοικεῖν ὅσιον· ἢν δὲ καὶ μένω,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1283.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1283.1.text#ἐς ποῖον ἱερὸν ἢ πανήγυριν φίλων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1284.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1284.1.text#εἶμ'; οὐ γὰρ ἄτας εὐπροσηγόρους ἔχω.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1285.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1285.1.text#ἀλλ' Ἄργος ἔλθω; πῶς, ἐπεὶ φεύγω πάτραν;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1286.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1286.1.text#φέρ' ἀλλ' ἐς ἄλλην δή τιν' ὁρμήσω πόλιν;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1287.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1287.1.text#κἄπειθ' ὑποβλεπώμεθ' ὡς ἐγνωσμένοι,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1288.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1288.1.text#γλώσσης πικροῖς κέντροισι κλῃδουχούμενοι·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1289.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1289.1.text#Οὐχ οὗτος ὁ Διός, ὃς τέκν' ἔκτεινέν ποτε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1290.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1290.1.text#δάμαρτά τ'; οὐ γῆς τῆσδ' ἀποφθαρήσεται;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1291.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1291.1.text#κεκλημένῳ δὲ φωτὶ μακαρίῳ ποτὲ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1292.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1292.1.text#αἱ μεταβολαὶ λυπηρόν· ᾧ δ' ἀεὶ κακῶς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1293.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1293.1.text#ἔστ', οὐδὲν ἀλγεῖ συγγενῶς δύστηνος ὤν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1294.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1294.1.text#ἐς τοῦτο δ' ἥξειν συμφορᾶς οἶμαί ποτε·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1295.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1295.1.text#φωνὴν γὰρ ἥσει χθὼν ἀπεννέπουσά με
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1296.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1296.1.text#μὴ θιγγάνειν γῆς καὶ θάλασσα μὴ περᾶν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1297.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1297.1.text#πηγαί τε ποταμῶν, καὶ τὸν ἁρματήλατον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1298.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1298.1.text#Ἰξίον' ἐν δεσμοῖσιν ἐκμιμήσομαι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1299.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1299.1.text#καὶ ταῦτ' ἄριστα μηδέν' Ἑλλήνων μ' ὁρᾶν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1300.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1300.1.text#ἐν οἷσιν εὐτυχοῦντες ἦμεν ὄλβιοι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1301.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1301.1.text#τί δῆτά με ζῆν δεῖ; τί κέρδος ἕξομεν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1302.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1302.1.text#βίον γ' ἀχρεῖον ἀνόσιον κεκτημένοι;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1303.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1303.1.text#χορευέτω δὴ Ζηνὸς ἡ κλεινὴ δάμαρ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1304.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1304.1.text#{ κρόουσ' Ὀλυμπίου } Ζηνὸς ἀρβύλῃ πόδα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1305.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1305.1.text#ἔπραξε γὰρ βούλησιν ἣν ἐβούλετο,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1306.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1306.1.text#ἄνδρ' Ἑλλάδος τὸν πρῶτον αὐτοῖσιν βάθροις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1307.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1307.1.text#ἄνω κάτω στρέψασα. — τοιαύτῃ θεῷ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1308.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1308.1.text#τίς ἂν προσεύχοιθ'; ἣ γυναικὸς οὕνεκα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1309.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1309.1.text#λέκτρων φθονοῦσα Ζηνὶ τοὺς εὐεργέτας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1310.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1310.1.text#Ἑλλάδος ἀπώλεσ' οὐδὲν ὄντας αἰτίους.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1311.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1311.1.text#οὐκ ἔστιν ἄλλου δαιμόνων ἀγὼν ὅδε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1312.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1312.1.text#ἢ τῆς Διὸς δάμαρτος· εὖ τόδ' αἰσθάνῃ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1313.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1313.1.text# [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1313.2.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1313.2.text#παραινέσαιμ' ἂν μᾶλλον ἢ πάσχειν κακῶς.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1314.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1314.1.text#οὐδεὶς δὲ θνητῶν ταῖς τύχαις ἀκήρατος,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1315.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1315.1.text#οὐ θεῶν, ἀοιδῶν εἴπερ οὐ ψευδεῖς λόγοι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1316.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1316.1.text#οὐ λέκτρ' ἐν ἀλλήλοισιν, ὧν οὐδεὶς νόμος,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1317.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1317.1.text#συνῆψαν; οὐ δεσμοῖσι διὰ τυραννίδας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1318.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1318.1.text#πατέρας ἐκηλίδωσαν; ἀλλ' οἰκοῦσ' ὅμως
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1319.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1319.1.text#Ὄλυμπον ἠνέσχοντό θ' ἡμαρτηκότες.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1320.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1320.1.text#καίτοι τί φήσεις, εἰ σὺ μὲν θνητὸς γεγὼς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1321.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1321.1.text#φέρεις ὑπέρφευ τὰς τύχας, θεοὶ δὲ μή;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1322.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1322.1.text#Θήβας μὲν οὖν ἔκλειπε τοῦ νόμου χάριν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1323.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1323.1.text#ἕπου δ' ἅμ' ἡμῖν πρὸς πόλισμα Παλλάδος.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1324.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1324.1.text#ἐκεῖ χέρας σὰς ἁγνίσας μιάσματος,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1325.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1325.1.text#δόμους τε δώσω χρημάτων τ' ἐμῶν μέρος.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1326.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1326.1.text#ἃ δ' ἐκ πολιτῶν δῶρ' ἔχω σώσας κόρους
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1327.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1327.1.text#δὶς ἑπτά, ταῦρον Κνώσιον κατακτανών,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1328.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1328.1.text#σοὶ ταῦτα δώσω. πανταχοῦ δέ μοι χθονὸς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1329.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1329.1.text#τεμένη δέδασται· ταῦτ' ἐπωνομασμένα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1330.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1330.1.text#σέθεν τὸ λοιπὸν ἐκ βροτῶν κεκλήσεται
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1331.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1331.1.text#ζῶντος· θανόντα δ', εὖτ' ἂν εἰς Ἅιδου μόλῃς,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1332.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1332.1.text#θυσίαισι λαΐνοισί τ' ἐξογκώμασι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1333.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1333.1.text#τίμιον ἀνάξει πᾶσ' Ἀθηναίων πόλις.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1334.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1334.1.text#καλὸς γὰρ ἀστοῖς στέφανος Ἑλλήνων ὕπο
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1335.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1335.1.text#ἄνδρ' ἐσθλὸν ὠφελοῦντας εὐκλείας τυχεῖν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1336.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1336.1.text#κἀγὼ χάριν σοι τῆς ἐμῆς σωτηρίας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1337.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1337.1.text#τήνδ' ἀντιδώσω· νῦν γὰρ εἶ χρεῖος φίλων.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1338.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1338.1.text#θεοὶ δ' ὅταν τιμῶσιν, οὐδὲν δεῖ φίλων·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1339.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1339.1.text#ἅλις γὰρ ὁ θεὸς ὠφελῶν, ὅταν θέλῃ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1340.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1340.1.text#οἴμοι· πάρεργα { μὲν } τάδ' ἔστ' ἐμῶν κακῶν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1341.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1341.1.text#ἐγὼ δὲ τοὺς θεοὺς οὔτε λέκτρ' ἃ μὴ θέμις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1342.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1342.1.text#στέργειν νομίζω, δεσμά τ' ἐξάπτειν χεροῖν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1343.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1343.1.text#οὔτ' ἠξίωσα πώποτ' οὔτε πείσομαι,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1344.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1344.1.text#οὐδ' ἄλλον ἄλλου δεσπότην πεφυκέναι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1345.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1345.1.text#δεῖται γὰρ ὁ θεός, εἴπερ ἔστ' ὀρθῶς θεός,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1346.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1346.1.text#οὐδενός· ἀοιδῶν οἵδε δύστηνοι λόγοι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1347.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1347.1.text#ἐσκεψάμην δὲ καίπερ ἐν κακοῖσιν ὤν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1348.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1348.1.text#μὴ δειλίαν ὄφλω τιν' ἐκλιπὼν φάος·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1349.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1349.1.text#ταῖς συμφοραῖς γὰρ ὅστις οὐχ ὑφίσταται,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1350.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1350.1.text#οὐδ' ἀνδρὸς ἂν δύναιθ' ὑποστῆναι βέλος.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1351.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1351.1.text#ἐγκαρτερήσω βίοτον· εἶμι δ' ἐς πόλιν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1352.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1352.1.text#τὴν σήν, χάριν τε μυρίων δώρων ἔχω.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1353.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1353.1.text#ἀτὰρ πόνων δὴ μυρίων ἐγευσάμην·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1354.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1354.1.text#ὧν οὔτ' ἀπεῖπον οὐδέν' οὔτ' ἀπ' ὀμμάτων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1355.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1355.1.text#ἔσταξα πηγάς, οὐδ' ἂν ᾠόμην ποτὲ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1356.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1356.1.text#ἐς τοῦθ' ἱκέσθαι, δάκρυ' ἀπ' ὀμμάτων βαλεῖν·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1357.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1357.1.text#νῦν δ', ὡς ἔοικε, τῇ τύχῃ δουλευτέον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1358.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1358.1.text#εἶἑν· γεραιέ, τὰς ἐμὰς φυγὰς ὁρᾷς,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1359.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1359.1.text#ὁρᾷς δὲ παίδων ὄντα μ' αὐθέντην ἐμῶν·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1360.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1360.1.text#δὸς τούσδε τύμβῳ καὶ περίστειλον νεκροὺς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1361.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1361.1.text#δακρύοισι τιμῶν — ἐμὲ γὰρ οὐκ ἐᾷ νόμος —
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1362.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1362.1.text#πρὸς στέρν' ἐρείσας μητρὶ δούς τ' ἐς ἀγκάλας,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1363.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1363.1.text#κοινωνίαν δύστηνον, ἣν ἐγὼ τάλας
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1364.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1364.1.text#διώλεσ' ἄκων. γῇ δ' ἐπὴν κρύψῃς νεκρούς,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1365.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1365.1.text#οἴκει πόλιν τήνδ', ἀθλίως μέν, ἀλλ' ὅμως
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1366.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1366.1.text#ψυχὴν βιάζου τἀμὰ συμφέρειν κακά.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1367.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1367.1.text#ὦ τέκν', ὁ φύσας καὶ τεκὼν ὑμᾶς πατὴρ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1368.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1368.1.text#ἀπώλεσ', οὐδ' ὤνασθε τῶν ἐμῶν καλῶν,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1369.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1369.1.text#ἁγὼ παρεσκεύαζον ἐκμοχθῶν βίᾳ
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1370.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1370.1.text#εὔκλειαν ὑμῖν, πατρὸς ἀπόλαυσιν καλήν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1371.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1371.1.text#σέ τ' οὐχ ὁμοίως, ὦ τάλαιν', ἀπώλεσα
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1372.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1372.1.text#ὥσπερ σὺ τἀμὰ λέκτρ' ἔσῳζες ἀσφαλῶς,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1373.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1373.1.text#μακρὰς διαντλοῦσ' ἐν δόμοις οἰκουρίας.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1374.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1374.1.text#οἴμοι δάμαρτος καὶ τέκνων, οἴμοι δ' ἐμοῦ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1375.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1375.1.text#ὡς ἀθλίως πέπραγα κἀποζεύγνυμαι
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1376.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1376.1.text#τέκνων γυναικός τ'· ὦ λυγραὶ φιλημάτων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1377.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1377.1.text#τέρψεις, λυγραὶ δὲ τῶνδ' ὅπλων κοινωνίαι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1378.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1378.1.text#ἀμηχανῶ γὰρ πότερ' ἔχω τάδ' ἢ μεθῶ,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1379.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1379.1.text#ἃ πλευρὰ τἀμὰ προσπίτνοντ' ἐρεῖ τάδε·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1380.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1380.1.text#Ἡμῖν τέκν' εἷλες καὶ δάμαρθ'· ἡμᾶς ἔχεις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1381.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1381.1.text#παιδοκτόνους σούς. εἶτ' ἐγὼ τάδ' ὠλέναις
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1382.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1382.1.text#οἴσω; τί φάσκων; ἀλλὰ γυμνωθεὶς ὅπλων,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1383.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1383.1.text#ξὺν οἷς τὰ κάλλιστ' ἐξέπραξ' ἐν Ἑλλάδι,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1384.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1384.1.text#ἐχθροῖς ἐμαυτὸν ὑποβαλὼν αἰσχρῶς θάνω;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1385.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1385.1.text#οὐ λειπτέον τάδ', ἀθλίως δὲ σῳστέον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1386.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1386.1.text#ἕν μοί τι, Θησεῦ, σύγκαμ'· ἀθλίου κυνὸς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1387.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1387.1.text#κόμιστρ' ἐς Ἄργος συγκατάστησον μολών,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1388.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1388.1.text#λύπῃ τι παίδων μὴ πάθω μονούμενος.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1389.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1389.1.text#ὦ γαῖα Κάδμου πᾶς τε Θηβαῖος λεώς,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1390.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1390.1.text#κείρασθε, συμπενθήσατ', ἔλθετ' ἐς τάφον
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1391.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1391.1.text#παίδων· ἅπαντας δ' ἑνὶ λόγῳ πενθήσετε
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1392.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1392.1.text#νεκρούς τε κἀμέ· πάντες ἐξολώλαμεν
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1393.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1393.1.text#Ἥρας μιᾷ πληγέντες ἄθλιοι τύχῃ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1394.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1394.1.text#ἀνίστασ', ὦ δύστηνε· δακρύων δ' ἅλις.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1395.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1395.1.text#οὐκ ἂν δυναίμην· ἄρθρα γὰρ πέπηγέ μου.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1396.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1396.1.text#καὶ τοὺς σθένοντας γὰρ καθαιροῦσιν τύχαι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1397.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1397.1.text#φεῦ·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1397.2.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1397.2.text#αὐτοῦ γενοίμην πέτρος ἀμνήμων κακῶν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1398.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1398.1.text#παῦσαι· δίδου δὲ χεῖρ' ὑπηρέτῃ φίλῳ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1399.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1399.1.text#ἀλλ' αἷμα μὴ σοῖς ἐξομόρξωμαι πέπλοις.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1400.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1400.1.text#ἔκμασσε, φείδου μηδέν· οὐκ ἀναίνομαι.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1401.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1401.1.text#παίδων στερηθεὶς παῖδ' ὅπως ἔχω σ' ἐμόν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1402.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1402.1.text#δίδου δέρῃ σὴν χεῖρ', ὁδηγήσω δ' ἐγώ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1403.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1403.1.text#ζεῦγός γε φίλιον· ἅτερος δὲ δυστυχής.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1404.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1404.1.text#ὦ πρέσβυ, τοιόνδ' ἄνδρα χρὴ κτᾶσθαι φίλον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1405.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1405.1.text#ἡ γὰρ τεκοῦσα τόνδε πατρὶς εὔτεκνος.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1406.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1406.1.text#Θησεῦ, πάλιν με στρέψον, ὡς ἴδω τέκνα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1407.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1407.1.text#ὡς δὴ τί; φίλτρον τοῦτ' ἔχων ῥᾴων ἔσῃ;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1408.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1408.1.text#ποθῶ· πατρός τε στέρνα προσθέσθαι θέλω.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1409.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1409.1.text#ἰδοὺ τάδ', ὦ παῖ· τἀμὰ γὰρ σπεύδεις φίλα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1410.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1410.1.text#οὕτως πόνων σῶν οὐκέτι μνήμην ἔχεις;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1411.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1411.1.text#ἅπαντ' ἐλάσσω κεῖνα τῶνδ' ἔτλην κακά.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1412.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1412.1.text#εἴ σ' ὄψεταί τις θῆλυν ὄντ', οὐκ αἰνέσει.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1413.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1413.1.text#ζῶ σοι ταπεινός; ἀλλὰ πρόσθεν οὐ δοκῶ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1414.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1414.1.text#ἄγαν γ'· ὁ κλεινὸς Ἡρακλῆς οὐκ εἶ νοσῶν.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1415.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1415.1.text#σὺ ποῖος ἦσθα νέρθεν ἐν κακοῖσιν ὤν;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1416.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1416.1.text#ὡς ἐς τὸ λῆμα παντὸς ἦν ἥσσων ἀνήρ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1417.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1417.1.text#πῶς οὖν ἔτ' { εἴπης } ὅτι συνέσταλμαι κακοῖς;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1418.1.speaker#Θησεύς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1418.1.text# πρόβαινε.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1418.2.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1418.2.text#χαῖρ', ὦ πρέσβυ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1418.3.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1418.3.text#καὶ σύ μοι, τέκνον.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1419.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1419.1.text#θάφθ' ὥσπερ εἶπον παῖδας.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1419.2.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1419.2.text#ἐμὲ δὲ τίς, τέκνον;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1420.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1420.1.text#ἐγώ.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1420.2.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1420.2.text#πότ' ἐλθών;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1420.3.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1420.3.text#ἡνίκ' ἂν θάψῃς τέκνα.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1421.1.speaker#Ἀμφιτρύων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1421.1.text#πῶς;
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1421.2.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1421.2.text#εἰς Ἀθήνας πέμψομαι Θηβῶν ἄπο.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1422.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1422.1.text#ἀλλ' ἐσκόμιζε τέκνα δυσκόμιστα γῇ·
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1423.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1423.1.text#ἡμεῖς δ' ἀναλώσαντες αἰσχύναις δόμον,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1424.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1424.1.text#Θησεῖ πανώλεις ἑψόμεσθ' ἐφολκίδες.
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1425.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1425.1.text#ὅστις δὲ πλοῦτον ἢ σθένος μᾶλλον φίλων
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1426.1.speaker#Ἡρακλῆς
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1426.1.text#ἀγαθῶν πεπᾶσθαι βούλεται, κακῶς φρονεῖ.  [ … ]
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1427.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1427.1.text#στείχομεν οἰκτροὶ καὶ πολύκλαυτοι,
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1428.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg009.fu.sp:1428.1.text#τὰ μέγιστα φίλων ὀλέσαντες.  [ … ] [ … ]
