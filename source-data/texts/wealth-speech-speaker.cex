#!ctsdata
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21.1.text#ὡς ἀργαλέον πρᾶγμ' ἐστὶν ὦ Ζεῦ καὶ θεοὶ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc22.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc22.1.text#δοῦλον γενέσθαι παραφρονοῦντος δεσπότου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc23.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc23.1.text#ἢν γὰρ τὰ βέλτισθ' ὁ θεράπων λέξας τύχῃ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc24.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc24.1.text#δόξῃ δὲ μὴ δρᾶν ταῦτα τῷ κεκτημένῳ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc25.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc25.1.text#μετέχειν ἀνάγκη τὸν θεράποντα τῶν κακῶν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc26.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc26.1.text#τοῦ σώματος γὰρ οὐκ ἐᾷ τὸν κύριον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc27.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc27.1.text#κρατεῖν ὁ δαίμων, ἀλλὰ τὸν ἐωνημένον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc28.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc28.1.text#καὶ ταῦτα μὲν δὴ ταῦτα. τῷ δὲ Λοξίᾳ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc29.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc29.1.text#ὃς θεσπιῳδεῖ τρίποδος ἐκ χρυσηλάτου,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc210.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc210.1.text#μέμψιν δικαίαν μέμφομαι ταύτην, ὅτι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc211.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc211.1.text#ἰατρὸς ὢν καὶ μάντις, ὥς φασιν, σοφὸς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc212.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc212.1.text#μελαγχολῶντ' ἀπέπεμψέ μου τὸν δεσπότην,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc213.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc213.1.text#ὅστις ἀκολουθεῖ κατόπιν ἀνθρώπου τυφλοῦ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc214.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc214.1.text#τοὐναντίον δρῶν ἢ προσῆκ' αὐτῷ ποιεῖν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc215.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc215.1.text#οἱ γὰρ βλέποντες τοῖς τυφλοῖς ἡγούμεθα,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc216.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc216.1.text#οὗτος δ' ἀκολουθεῖ, κἀμὲ προσβιάζεται,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc217.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc217.1.text#καὶ ταῦτ' ἀποκρινομένῳ τὸ παράπαν οὐδὲ γρῦ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc218.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc218.1.text#ἐγὼ μὲν οὖν οὐκ ἔσθ' ὅπως σιγήσομαι,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc219.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc219.1.text#ἢν μὴ φράσῃς ὅ τι τῷδ' ἀκολουθοῦμέν ποτε
urn:cts:greekLit:tlg0019.tlg011.perseus-grc220.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc220.1.text#ὦ δέσποτ', ἀλλά σοι παρέξω πράγματα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc221.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc221.1.text#οὐ γάρ με τυπτήσεις στέφανον ἔχοντά γε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc222.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc222.1.text#μὰ Δί' ἀλλ' ἀφελὼν τὸν στέφανον, ἢν λυπῇς τί με,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc223.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc223.1.text#ἵνα μᾶλλον ἀλγῇς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc223.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc223.2.text#λῆρος· οὐ γὰρ παύσομαι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc224.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc224.1.text#πρὶν ἂν φράσῃς μοι τίς ποτ' ἐστὶν οὑτοσί·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc225.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc225.1.text#εὔνους γὰρ ὤν σοι πυνθάνομαι πάνυ σφόδρα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc226.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc226.1.text#ἀλλ' οὔ σε κρύψω· τῶν ἐμῶν γὰρ οἰκετῶν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc227.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc227.1.text#πιστότατον ἡγοῦμαί σε καὶ κλεπτίστατον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc228.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc228.1.text#ἐγὼ θεοσεβὴς καὶ δίκαιος ὢν ἀνὴρ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc229.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc229.1.text#κακῶς ἔπραττον καὶ πένης ἦν·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc229.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc229.2.text#οἶδά τοι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc230.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc230.1.text#ἕτεροι δ' ἐπλούτουν ἱερόσυλοι ῥήτορες
urn:cts:greekLit:tlg0019.tlg011.perseus-grc231.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc231.1.text#καὶ συκοφάνται καὶ πονηροί·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc231.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc231.2.text#πείθομαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc232.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc232.1.text#ἐπερησόμενος οὖν ᾠχόμην ὡς τὸν θεόν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc233.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc233.1.text#τὸν ἐμὸν μὲν αὐτοῦ τοῦ ταλαιπώρου σχεδὸν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc234.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc234.1.text#ἤδη νομίζων ἐκτετοξεῦσθαι βίον,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc235.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc235.1.text#τὸν δ' υἱόν, ὅσπερ ὢν μόνος μοι τυγχάνει,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc236.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc236.1.text#πευσόμενος εἰ χρὴ μεταβαλόντα τοὺς τρόπους
urn:cts:greekLit:tlg0019.tlg011.perseus-grc237.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc237.1.text#εἶναι πανοῦργον, ἄδικον, ὑγιὲς μηδὲ ἕν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc238.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc238.1.text#ὡς τῷ βίῳ τοῦτ' αὐτὸ νομίσας συμφέρειν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc239.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc239.1.text#τί δῆτα Φοῖβος ἔλακεν ἐκ τῶν στεμμάτων;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc240.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc240.1.text#πεύσει. σαφῶς γὰρ ὁ θεὸς εἶπέ μοι τοδί·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc241.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc241.1.text#ὅτῳ ξυναντήσαιμι πρῶτον ἐξιών,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc242.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc242.1.text#ἐκέλευε τούτου μὴ μεθίεσθαί μ' ἔτι,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc243.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc243.1.text#πείθειν δ' ἐμαυτῷ ξυνακολουθεῖν οἴκαδε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc244.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc244.1.text#καὶ τῷ ξυναντᾷς δῆτα πρώτῳ;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc244.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc244.2.text#τουτῳί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc245.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc245.1.text#εἶτ' οὐ ξυνίης τὴν ἐπίνοιαν τοῦ θεοῦ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc246.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc246.1.text#φράζουσαν ὦ σκαιότατέ σοι σαφέστατα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc247.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc247.1.text#ἀσκεῖν τὸν υἱὸν τὸν ἐπιχώριον τρόπον;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc248.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc248.1.text#τῷ τοῦτο κρίνεις;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc248.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc248.2.text#δῆλον ὁτιὴ καὶ τυφλῷ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc249.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc249.1.text#γνῶναι δοκεῖ τοῦθ', ὡς σφόδρ' ἐστὶ συμφέρον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc250.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc250.1.text#τὸ μηδὲν ἀσκεῖν ὑγιὲς ἐν τῷ νῦν χρόνῳ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc251.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc251.1.text#οὐκ ἔσθ' ὅπως ὁ χρησμὸς ἐς τοῦτο ῥέπει,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc252.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc252.1.text#ἀλλ' εἰς ἕτερόν τι μεῖζον. ἢν δ' ἡμῖν φράσῃ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc253.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc253.1.text#ὅστις ποτ' ἐστὶν οὑτοσὶ καὶ τοῦ χάριν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc254.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc254.1.text#καὶ τοῦ δεόμενος ἦλθε μετὰ νῷν ἐνθαδί,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc255.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc255.1.text#πυθοιμεθ' ἂν τὸν χρησμὸν ἡμῶν ὅ τι νοεῖ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc256.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc256.1.text#ἄγε δὴ σὺ πότερον σαυτὸν ὅστις εἶ φράσεις,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc257.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc257.1.text#ἢ τἀπὶ τούτοις δρῶ; λέγειν χρὴ ταχὺ πάνυ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc258.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc258.1.text#ἐγὼ μὲν οἰμώζειν λέγω σοι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc258.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc258.2.text#μαναθάνεις
urn:cts:greekLit:tlg0019.tlg011.perseus-grc259.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc259.1.text#ὅς φησιν εἶναι;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc259.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc259.2.text#σοὶ λέγει τοῦτ', οὐκ ἐμοί·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc260.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc260.1.text#σκαιῶς γὰρ αὐτοῦ καὶ χαλεπῶς ἐκπυνθάνει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc261.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc261.1.text#ἀλλ' εἴ τι χαίρεις ἀνδρὸς εὐόρκου τρόποις,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc262.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc262.1.text#ἐμοὶ φράσον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc262.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc262.2.text#κλάειν ἔγωγέ σοι λέγω.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc263.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc263.1.text#δέχου τὸν ἄνδρα καὶ τὸν ὄρνιν τοῦ θεοῦ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc264.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc264.1.text#οὔ τοι μὰ τὴν Δήμητρα χαιρήσεις ἔτι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc265.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc265.1.text#εἰ μὴ φράσεις γάρ—
urn:cts:greekLit:tlg0019.tlg011.perseus-grc265.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc265.2.text#ἀπό σ' ὀλῶ κακὸν κακῶς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc266.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc266.1.text#ὦ τᾶν—
urn:cts:greekLit:tlg0019.tlg011.perseus-grc266.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc266.2.text#ἀπαλλάχθητον ἀπ' ἐμοῦ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc266.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc266.3.text#πώμαλα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc267.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc267.1.text#καὶ μὴν ὃ λέγω βέλτιστόν ἐστ' ὦ δέσποτα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc268.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc268.1.text#ἀπολῶ τὸν ἄνθρωπον κάκιστα τουτονί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc269.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc269.1.text#ἀναθεὶς γὰρ ἐπὶ κρημνόν τιν' αὐτὸν καταλιπων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc270.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc270.1.text#ἄπειμ', ἵν' ἐκεῖθεν ἐκτραχηλισθῇ πεσών.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc271.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc271.1.text#ἀλλ' αἶρε ταχέως.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc271.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc271.2.text#μηδαμῶς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc271.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc271.3.text#οὔκουν ἐρεῖς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc272.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc272.1.text#ἀλλ' ἢν πύθησθέ μ' ὅστις εἴμ', εὖ οἶδ' ὅτι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc273.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc273.1.text#κακόν τί μ' ἐργάσεσθε κοὐκ ἀφήσετον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc274.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc274.1.text#νὴ τοὺς θεοὺς ἡμεῖς γ', ἐὰν βούλῃ γε σύ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc275.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc275.1.text#μέθεσθε νῦν μου πρῶτον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc275.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc275.2.text#ἤν, μεθίεμεν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc276.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc276.1.text#ἀκούετον δή· δεῖ γὰρ ὡς ἔοικέ με
urn:cts:greekLit:tlg0019.tlg011.perseus-grc277.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc277.1.text#λέγειν ἃ κρύπτειν ἦν παρεσκευασμένος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc278.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc278.1.text#ἐγὼ γάρ εἰμι Πλοῦτος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc278.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc278.2.text#ὦ μιαρώτατε
urn:cts:greekLit:tlg0019.tlg011.perseus-grc279.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc279.1.text#ἀνδρῶν ἁπάντων, εἶτ' ἐσίγας Πλοῦτος ὤν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc280.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc280.1.text#σὺ Πλοῦτος, οὕτως ἀθλίως διακείμενος;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc281.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc281.1.text#ὦ Φοῖβ' Ἄπολλον καὶ θεοὶ καὶ δαίμονες
urn:cts:greekLit:tlg0019.tlg011.perseus-grc282.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc282.1.text#καὶ Ζεῦ, τί φῄς; ἐκεῖνος ὄντως εἶ σύ;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc282.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc282.2.text#ναί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc283.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc283.1.text#ἐκεῖνος αὐτός;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc283.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc283.2.text#αὐτότατος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc283.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc283.3.text#πόθεν οὖν φράσον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc284.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc284.1.text#αὐχμῶν βαδίζεις;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc284.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc284.2.text#ἐκ Πατροκλέους ἔρχομαι,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc285.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc285.1.text#ὃς οὐκ ἐλούσατ' ἐξ ὅτουπερ ἐγένετο.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc286.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc286.1.text#τουτὶ δὲ τὸ κακὸν πῶς ἔπαθες; κάτειπέ μοι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc287.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc287.1.text#ὁ Ζεύς με ταῦτ' ἔδρασεν ἀνθρώποις φθονῶν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc288.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc288.1.text#ἐγὼ γὰρ ὢν μειράκιον ἠπείλησ' ὅτι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc289.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc289.1.text#ὡς τοὺς δικαίους καὶ σοφοὺς καὶ κοσμίους
urn:cts:greekLit:tlg0019.tlg011.perseus-grc290.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc290.1.text#μόνους βαδιοίμην· ὁ δέ μ' ἐποίησεν τυφλόν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc291.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc291.1.text#ἵνα μὴ διαγιγνώσκοιμι τούτων μηδένα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc292.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc292.1.text#οὕτως ἐκεῖνος τοῖσι χρηστοῖσι φθονεῖ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc293.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc293.1.text#καὶ μὴν διὰ τοὺς χρηστούς γε τιμᾶται μόνους
urn:cts:greekLit:tlg0019.tlg011.perseus-grc294.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc294.1.text#καὶ τοὺς δικαίους.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc294.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc294.2.text#ὁμολογῶ σοι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc294.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc294.3.text#φέρε τί οὖν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc295.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc295.1.text#εἰ πάλιν ἀναβλέψειας ὥσπερ καὶ πρὸ τοῦ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc296.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc296.1.text#φεύγοις ἂν ἤδη τοὺς πονηρούς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc296.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc296.2.text#φήμ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc297.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc297.1.text#ὡς τοὺς δικαίους δ' ἂν βαδίζοις;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc297.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc297.2.text#πάνυ μὲν οὖν·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc298.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc298.1.text#πολλοῦ γὰρ αὐτοὺς οὐχ ἑόρακά πω χρόνου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc299.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc299.1.text#καὶ θαῦμά γ' οὐδέν· οὐδ' ἐγὼ γὰρ ὁ βλέπων.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2100.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2100.1.text#ἄφετόν με νῦν. ἴστον γὰρ ἤδη τἀπ' ἐμοῦ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2101.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2101.1.text#μὰ Δί' ἀλλὰ πολλῷ μᾶλλον ἑξόμεσθά σου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2102.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2102.1.text#οὐκ ἠγόρευον ὅτι παρέξειν πράγματα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2103.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2103.1.text#ἐμέλλετόν μοι;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2103.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2103.2.text#καὶ σύ γ' ἀντιβολῶ πιθοῦ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2104.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2104.1.text#καὶ μή μ' ἀπολίπῃς· οὐ γὰρ εὑρήσεις ἐμοῦ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2105.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2105.1.text#ζητῶν ἔτ' ἄνδρα τοὺς τρόπους βελτίονα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2106.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2106.1.text#μὰ τὸν Δί' οὐ γὰρ ἔστιν ἄλλος πλὴν ἐγώ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2107.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2107.1.text#ταυτὶ λέγουσι πάντες· ἡνίκ' ἂν δέ μου
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2108.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2108.1.text#τύχωσ' ἀληθῶς καὶ γένωνται πλούσιοι,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2109.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2109.1.text#ἀτεχνῶς ὑπερβάλλουσι τῇ μοχθηρίᾳ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2110.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2110.1.text#ἔχει μὲν οὕτως, εἰσὶ δ' οὐ πάντες κακοί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2111.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2111.1.text#μὰ Δί' ἀλλ' ἁπαξάπαντες.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2111.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2111.2.text#οἰμώξει μακρά.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2112.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2112.1.text#σοὶ δ' ὡς ἂν εἰδῇς ὅσα παρ' ἡμῖν ἢν μένῃς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2113.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2113.1.text#γενήσετ' ἀγαθά, πρόσεχε τὸν νοῦν ἵνα πύθῃ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2114.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2114.1.text#οἶμαι γὰρ οἶμαι, σὺν θεῷ δ' εἰρήσεται,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2115.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2115.1.text#ταύτης ἀπαλλάξειν σε τῆς ὀφθαλμίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2116.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2116.1.text#βλέψαι ποιήσας.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2116.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2116.2.text#μηδαμῶς τοῦτ' ἐργάσῃ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2117.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2117.1.text#οὐ βούλομαι γὰρ πάλιν ἀναβλέψαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2117.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2117.2.text#τί φῄς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2118.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2118.1.text#ἅνθρωπος οὗτός ἐστιν ἄθλιος φύσει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2119.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2119.1.text#ὁ Ζεὺς † μὲν οὖν εἰδὼς τὰ τούτων μῶρ' ἔμ' εἰ†
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2120.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2120.1.text#πύθοιτ' ἂν ἐπιτρίψειε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2120.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2120.2.text#νῦν δ' οὐ τοῦτο δρᾷ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2121.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2121.1.text#ὅστις σε προσπταίοντα περινοστεῖν ἐᾷ;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2122.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2122.1.text#οὐκ οἶδ'· ἐγὼ δ' ἐκεῖνον ὀρρωδῶ πάνυ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2123.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2123.1.text#ἄληθες ὦ δειλότατε πάντων δαιμόνων;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2124.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2124.1.text#οἴει γὰρ εἶναι τὴν Διὸς τυραννίδα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2125.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2125.1.text#καὶ τοὺς κεραυνοὺς ἀξίους τριωβόλου,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2126.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2126.1.text#ἐὰν ἀναβλέψῃς σὺ κἂν σμικρὸν χρόνον;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2127.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2127.1.text#ἆ μὴ λέγ' ὦ πόνηρε ταῦτ'.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2127.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2127.2.text#ἔχ' ἥσυχος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2NaN.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2NaN.text#ἐγὼ γὰρ ἀποδείξω σε τοῦ Διὸς πολὺ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2129.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2129.1.text#μεῖζον δυνάμενον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2129.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2129.2.text#ἐμὲ σύ;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2129.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2129.3.text#νὴ τὸν οὐρανόν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2130.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2130.1.text#αὐτίκα γὰρ ἄρχει διὰ τίν' ὁ Ζεὺς τῶν θεῶν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2131.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2131.1.text#διὰ τἀργύριον· πλεῖστον γάρ ἐστ' αὐτῷ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2131.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2131.2.text#φέρε
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2132.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2132.1.text#τίς οὖν ὁ παρέχων ἐστὶν αὐτῷ τοῦθ';
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2132.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2132.2.text#ὁδί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2133.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2133.1.text#θύουσι δ' αὐτῷ διὰ τίν'; οὐ διὰ τουτονί;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2134.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2134.1.text#καὶ νὴ Δί' εὔχονταί γε πλουτεῖν ἄντικρυς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2135.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2135.1.text#οὔκουν ὅδ' ἐστὶν αἴτιος καὶ ῥᾳδίως
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2136.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2136.1.text#παύσειεν, εἰ βούλοιτο, ταῦτ' ἄν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2136.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2136.2.text#ὅτι τί δή;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2137.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2137.1.text#ὅτι οὐδ' ἂν εἷς θύσειεν ἀνθρώπων ἔτι,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2138.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2138.1.text#οὐ βοῦν ἄν, οὐχὶ ψαιστόν, οὐκ ἄλλ' οὐδὲ ἕν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2139.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2139.1.text#μὴ βουλομένου σοῦ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2139.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2139.2.text#πῶς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2139.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2139.3.text#ὅπως; οὐκ ἔσθ' ὅπως
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2140.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2140.1.text#ὠνήσεται δήπουθεν, ἢν σὺ μὴ παρὼν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2141.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2141.1.text#αὐτὸς διδῷς τἀργύριον· ὥστε τοῦ Διὸς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2142.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2142.1.text#τὴν δύνομιν, ἢν λυπῇ τι, καταλύσεις μόνος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2143.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2143.1.text#τί λέγεις; δι' ἐμὲ θύουσιν αὐτῷ;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2143.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2143.2.text#φήμ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2144.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2144.1.text#καὶ νὴ Δί' εἴ τί γ' ἔστι λαμπρὸν καὶ καλὸν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2145.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2145.1.text#ἢ χαρίεν ἀνθρώποισι, διὰ σὲ γίγνεται.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2146.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2146.1.text#ἅπαντα τῷ πλουτεῖν γάρ ἐσθ' ὑπήκοα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2147.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2147.1.text#ἔγωγέ τοι διὰ μικρὸν ἀργυρίδιον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2148.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2148.1.text#δοῦλος γεγένημαι, διὰ τὸ μὴ πλουτεῖν ἴσως.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2149.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2149.1.text#καὶ τάς γ' ἑταίρας φασὶ τὰς Κορινθίας,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2150.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2150.1.text#ὅταν μὲν αὐτάς τις πένης πειρῶν τύχῃ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2151.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2151.1.text#οὐδὲ προσέχειν τὸν νοῦν, ἐὰν δὲ πλούσιος,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2152.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2152.1.text#τὸν πρωκτὸν αὐτὰς εὐθὺς ὡς τοῦτον τρέπειν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2153.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2153.1.text#καὶ τούς γε παῖδάς φασι ταὐτὸ τοῦτο δρᾶν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2154.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2154.1.text#οὐ τῶν ἐραστῶν ἀλλὰ τἀργυρίου χάριν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2155.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2155.1.text#οὐ τούς γε χρηστούς, ἀλλὰ τοὺς πόρνους· ἐπεὶ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2156.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2156.1.text#αἰτοῦσιν οὐκ ἀργύριον οἱ χρηστοί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2156.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2156.2.text#τί δαί;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2157.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2157.1.text#ὁ μὲν ἵππον ἀγαθόν, ὁ δὲ κύνας θηρευτικάς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2158.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2158.1.text#αἰσχυνόμενοι γὰρ ἀργύριον αἰτεῖν ἴσως
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2159.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2159.1.text#ὀνόματι περιπέττουσι τὴν μοχθηρίαν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2160.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2160.1.text#τέχναι δὲ πᾶσαι διὰ σὲ καὶ σοφίσματα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2161.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2161.1.text#ἐν τοῖσιν ἀνθρώποισίν ἐσθ' ηὑρημένα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2162.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2162.1.text#ὁ μὲν γὰρ ἡμῶν σκυτοτομεῖ καθήμενος·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2163.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2163.1.text#ἕτερος δὲ χαλκεύει τις, ὁ δὲ τεκταίνεται·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2164.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2164.1.text#ὁ δὲ χρυσοχοεῖ γε χρυσίον παρὰ σοῦ λαβών·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2165.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2165.1.text#ὁ δὲ λωποδυτεῖ γε νὴ Δί', ὁ δὲ τοιχωρυχεῖ·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2166.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2166.1.text#ὁ δὲ γναφεύει γ'·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2166.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2166.2.text#ὁ δέ γε πλύνει κῴδια·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2167.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2167.1.text#ὁ δὲ βυρσοδεψεῖ γ'·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2167.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2167.2.text#ὁ δέ γε πωλεῖ κρόμμυα·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2168.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2168.1.text#ὁ δ' ἁλούς γε μοιχὸς διὰ σέ που παρατίλλεται.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2169.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2169.1.text#οἴμοι τάλας ταυτί μ' ἐλάνθανεν πάλαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2170.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2170.1.text#μέγας δὲ βασιλεὺς οὐχὶ διὰ τοῦτον κομᾷ;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2171.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2171.1.text#ἐκκλησία δ' οὐχὶ διὰ τοῦτον γίγνεται;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2172.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2172.1.text#τί δέ; τὰς τριήρεις οὐ σὺ πληροῖς; εἰπέ μοι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2173.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2173.1.text#τὸ δ' ἐν Κορίνθῳ ξενικὸν οὐχ οὗτος τρέφει;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2174.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2174.1.text#ὁ Πάμφιλος δ' οὐχι διὰ τοῦτον κλαύσεται;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2175.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2175.1.text#ὁ βελονοπώλης δ' οὐχὶ μετὰ τοῦ Παμφίλου;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2176.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2176.1.text#Ἀγύρριος δ' οὐχὶ διὰ τοῦτον πέρδεται;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2177.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2177.1.text#Φιλέψιος δ' οὐχ ἕνεκα σοῦ μύθους λέγει;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2178.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2178.1.text#ἡ ξυμμαχία δ' οὐ διὰ σὲ τοῖς Αἰγυπτίοις;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2179.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2179.1.text#ἐρᾷ δὲ Λαῒς οὐ διὰ σὲ Φιλωνίδου;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2180.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2180.1.text#ὁ Τιμοθέου δὲ πύργος—
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2180.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2180.2.text#ἐμπέσοι γέ σοι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2181.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2181.1.text#τὰ δὲ πράγματ' οὐχὶ διὰ σὲ πάντα πράττεται;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2182.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2182.1.text#μονώτατος γὰρ εἶ σὺ πάντων αἴτιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2183.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2183.1.text#καὶ τῶν κακῶν καὶ τῶν ἀγαθῶν, εὖ ἴσθ' ὅτι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2184.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2184.1.text#κρατοῦσι γοῦν κἀν τοῖς πολέμοις ἑκάστοτε,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2185.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2185.1.text#ἐφ' οἷς οὗτος ἐπικαθέζηται μόνον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2186.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2186.1.text#ἐγὼ τοσαῦτα δυνατός εἰμ' εἷς ὢν ποιεῖν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2187.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2187.1.text#καὶ ναὶ μὰ Δία τούτων γε πολλῷ πλείονα·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2188.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2188.1.text#ὥστ' οὐδὲ μεστὸς σοῦ γέγον' οὐδεὶς πώποτε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2189.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2189.1.text#τῶν μὲν γὰρ ἄλλων ἐστὶ πάντων πλησμονή,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2190.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2190.1.text#ἔρωτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2190.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2190.2.text#ἄρτων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2190.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2190.3.text#μουσικῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2190.4.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2190.4.text#τραγημάτων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2191.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2191.1.text#τιμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2191.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2191.2.text#πλακούντων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2191.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2191.3.text#ἀνδραγαθίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2191.4.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2191.4.text#ἰσχάδων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2192.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2192.1.text#φιλοτιμίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2192.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2192.2.text#μάζης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2192.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2192.3.text#στρατηγίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2192.4.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2192.4.text#φακῆς·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2193.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2193.1.text#σοῦ δ' ἐγένετ' οὐδεὶς μεστὸς οὐδεπώποτε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2194.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2194.1.text#ἀλλ' ἢν τάλαντά τις λάβῃ τριακαίδεκα,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2195.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2195.1.text#πολὺ μᾶλλον ἐπιθυμεῖ λαβεῖν ἑκκαίδεκα·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2196.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2196.1.text#κἂν ταῦτ' ἀνύσηται, τετταράκοντα βούλεται,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2197.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2197.1.text#ἤ φησιν εἶν ἀβίωτον αὑτῷ τὸν βίον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2198.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2198.1.text#εὖ τοι λέγειν ἔμοιγε φαίνεσθον πάνυ·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2199.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2199.1.text#πλὴν ἓν μόνον δέδοικα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2199.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2199.2.text#φράζε τοῦ πέρι;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2200.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2200.1.text#ὅπως ἐγὼ τὴν δύναμιν ἣν ὑμεῖς φατε
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2201.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2201.1.text#ἔχειν με, ταύτης δεσπότης γενήσομαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2202.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2202.1.text#νὴ τὸν Δί' ἀλλὰ καὶ λέγουσι πάντες ὡς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2203.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2203.1.text#δειλότατόν ἐσθ' ὁ Πλοῦτος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2203.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2203.2.text#ἥκιστ', ἀλλά με
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2204.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2204.1.text#τοιχωρύχος τις διέβαλ'. ἐσδὺς γάρ ποτε
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2205.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2205.1.text#οὐκ εἶχεν ἐς τὴν οἰκίαν οὐδὲν λαβεῖν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2206.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2206.1.text#εὑρὼν ἁπαξάπαντα κατακεκλῃμένα·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2207.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2207.1.text#εἶτ' ὠνόμασέ μου τὴν πρόνοιαν δειλίαν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2208.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2208.1.text#μή νυν μελέτω σοι μηδέν· ὡς ἐὰν γένῃ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2209.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2209.1.text#ἀνὴρ πρόθυμος αὐτὸς ἐς τὰ πράγματα,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2210.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2210.1.text#βλέποντ' ἀποδείξω σ' ὀξύτερον τοῦ Λυγκέως.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2211.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2211.1.text#πῶς οὖν δυνήσει τοῦτο δρᾶσαι θνητὸς ὤν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2212.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2212.1.text#ἔχω τιν' ἀγαθὴν ἐλπίδ' ἐξ ὧν εἶπέ μοι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2213.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2213.1.text#ὁ Φοῖβος αὐτὸς Πυθικὴν σείσας δάφνην.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2214.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2214.1.text#κἀκεῖνος οὖν σύνοιδε ταῦτα;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2214.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2214.2.text#φήμ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2215.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2215.1.text#ὁρᾶτε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2215.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2215.2.text#μὴ φρόντιζε μηδὲν ὦγαθέ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2216.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2216.1.text#ἐγὼ γάρ, εὖ τοῦτ' ἴσθι, κεἰ δεῖ μ' ἀποθανεῖν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2217.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2217.1.text#αὐτὸς διαπράξω ταῦτα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2217.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2217.2.text#κἂν βούλῃ γ', ἐγώ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2218.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2218.1.text#πολλοὶ δ' ἔσονται χἄτεροι νῷν ξύμμαχοι,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2219.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2219.1.text#ὅσοις δικαίοις οὖσιν οὐκ ἦν ἄλφιτα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2220.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2220.1.text#παπαῖ πονηρούς γ' εἶπας ἡμῖν συμμάχους.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2221.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2221.1.text#οὐκ ἤν γε πλουτήσωσιν ἐξ ἀρχῆς πάλιν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2222.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2222.1.text#ἀλλ' ἴθι σὺ μὲν ταχέως δραμών—
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2222.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2222.2.text#τί δρῶ; λέγε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2223.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2223.1.text#τοὺς ξυγγεώργους κάλεσον, εὑρήσεις δ' ἴσως
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2224.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2224.1.text#ἐν τοῖς ἀγροῖς αὐτοὺς ταλαιπωρουμένους,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2225.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2225.1.text#ὅπως ἂν ἴσον ἕκαστος ἐνταυθοῖ παρὼν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2226.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2226.1.text#ἡμῖν μετάσχῃ τοῦδε τοῦ Πλούτου μέρος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2227.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2227.1.text#καὶ δὴ βαδίζω· τουτοδὶ τὸ κρεᾴδιον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2228.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2228.1.text#τῶν ἔνδοθέν τις εἰσενεγκάτω λαβών.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2229.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2229.1.text#ἐμοὶ μελήσει τοῦτό γ'· ἀλλ' ἀνύσας τρέχε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2230.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2230.1.text#σὺ δ' ὦ κράτιστε Πλοῦτε πάντων δαιμόνων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2231.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2231.1.text#εἴσω μετ' ἐμοῦ δεῦρ' εἴσιθ'· ἡ γὰρ οἰκία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2232.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2232.1.text#αὕτη 'στὶν ἣν δεῖ χρημάτων σε τήμερον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2233.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2233.1.text#μεστὴν ποιῆσαι καὶ δικαίως κἀδίκως.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2234.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2234.1.text#ἀλλ' ἄχθομαι μὲν εἰσιὼν νὴ τοὺς θεοὺς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2235.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2235.1.text#εἰς οἰκίαν ἑκάστοτ' ἀλλοτρίαν πάνυ·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2236.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2236.1.text#ἀγαθὸν γὰρ ἀπέλαυσ' οὐδὲν αὐτοῦ πώποτε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2237.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2237.1.text#ἢν μὲν γὰρ ὡς φειδωλὸν εἰσελθὼν τύχω,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2238.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2238.1.text#εὐθὺς κατώρυξέν με κατὰ τῆς γῆς κάτω·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2239.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2239.1.text#κἄν τις προσέλθῃ χρηστὸς ἄνθρωπος φίλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2240.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2240.1.text#αἰτῶν λαβεῖν τι σμικρὸν ἀργυρίδιον,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2241.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2241.1.text#ἔξαρνός ἐστι μηδ' ἰδεῖν με πώποτε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2242.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2242.1.text#ἢν δ' ὡς παραπλῆγ' ἄνθρωπον εἰσελθὼν τύχω,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2243.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2243.1.text#πόρναισι καὶ κύβοισι παραβεβλημένος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2244.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2244.1.text#γυμνὸς θύραζ' ἐξέπεσον ἐν ἀκαρεῖ χρόνου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2245.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2245.1.text#μετρίου γὰρ ἀνδρὸς οὐκ ἐπέτυχες πώποτε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2246.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2246.1.text#ἐγὼ δὲ τούτου τοῦ τρόπου πώς εἰμ' ἀεί,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2247.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2247.1.text#χαίρω τε γὰρ φειδόμενος ὡς οὐδεὶς ἀνὴρ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2248.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2248.1.text#πάλιν τ' ἀναλῶν, ἡνίκ' ἂν τούτου δέῃ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2249.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2249.1.text#ἀλλ' εἰσίωμεν, ὡς ἰδεῖν σε βούλομαι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2250.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2250.1.text#καὶ τὴν γυναῖκα καὶ τὸν υἱὸν τὸν μόνον,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2251.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2251.1.text#ὃν ἑγὼ φιλῶ μάλιστα μετὰ σέ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2251.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2251.2.text#πείθομαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2252.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2252.1.text#τί γὰρ ἄν τις οὐχὶ πρὸς σὲ τἀληθῆ λέγοι;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2253.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2253.1.text#ὦ πολλὰ δὴ τῷ δεσπότῃ ταὐτὸν θύμον φαγόντες,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2254.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2254.1.text#ἄνδρες φίλοι καὶ δημόται καὶ τοῦ πονεῖν ἐρασταί,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2255.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2255.1.text#ἴτ' ἐγκονεῖτε σπεύδεθ', ὡς ὁ καιρὸς οὐχὶ μέλλειν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2256.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2256.1.text#ἀλλ' ἔστ' ἐπ' αὐτῆς τῆς ἀκμῆς, ᾗ δεῖ παρόντ' ἀμύνειν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2257.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2257.1.text#οὔκουν ὁρᾷς ὁρμωμένους ἡμᾶς πάλαι προθύμως,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2258.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2258.1.text#ὡς εἰκός ἐστιν ἀσθενεῖς γέροντας ἄνδρας ἤδη;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2259.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2259.1.text#σὺ δ' ἀξιοῖς ἴσως με θεῖν, πρὶν ταῦτα καὶ φράσαι μοι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2260.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2260.1.text#ὅτου χάριν μ' ὁ δεσπότης ὁ σὸς κέκληκε δῦρο.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2261.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2261.1.text#οὔκουν πάλαι δήπου λέγω; σὺ δ' αὐτὸς οὐκ ἀκούεις.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2262.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2262.1.text#ὁ δεσπότης γάρ φησιν ὑμᾶς ἡδέως ἅπαντας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2263.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2263.1.text#ψυχροῦ βίου καὶ δυσκόλου ζήσειν ἀπαλλαγέντας.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2264.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2264.1.text#ἔστιν δὲ δὴ τί καὶ πόθεν τὸ πρᾶγμα τοῦθ' ὅ φησιν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2265.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2265.1.text#ἔχων ἀφῖκται δεῦρο πρεσβύτην τιν' ὦ πόνηροι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2266.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2266.1.text#ῥυπῶντα κυφὸν ἄθλιον ῥυσὸν μαδῶντα νωδόν·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2267.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2267.1.text#οἶμαι δὲ νὴ τὸν οὐρανὸν καὶ ψωλὸν αὐτὸν εἶναι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2268.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2268.1.text#ὦ χρυσὸν ἀγγείλας ἐπῶν πῶς φῄς; πάλιν φράσον μοι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2269.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2269.1.text#δηλοῖς γὰρ αὐτὸν σωρὸν ἥκειν χρημάτων ἔχοντα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2270.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2270.1.text#πρεσβυτικῶν μὲν οὖν κακῶν ἔγωγ' ἔχοντα σωρόν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2271.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2271.1.text#μῶν ἀξιοῖς φενακίσας ἔπειτ' ἀπαλλαγῆναι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2272.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2272.1.text#ἀζήμιος, καὶ ταῦτ' ἐμοῦ βακτηρίαν ἔχοντος;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2273.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2273.1.text#πάντως γὰρ ἄνθρωπον φύσει τοιοῦτον ἐς τὰ πάντα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2274.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2274.1.text#ἡγεῖσθέ μ' εἶναι κοὐδὲν ἂν νομίζεθ' ὑγιὲς εἰπεῖν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2275.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2275.1.text#ὡς σεμνὸς οὑπίτριπτος· αἱ κνῆμαι δέ σου βοῶσιν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2276.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2276.1.text# "ἰοὺ ἰού," τὰς χοίνικας καὶ τὰς πέδας ποθοῦσαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2277.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2277.1.text#ἐν τῇ σορῷ νυνὶ λαχὸν τὸ γράμμα σου δικάζειν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2278.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2278.1.text#σὺ δ' οὐ βαδίζεις, ὁ δὲ Χάρων τὸ ξύμβολον δίδωσιν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2279.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2279.1.text#διαρραγείης, ὡς μόθων εἶ καὶ φύσει κόβαλος,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2280.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2280.1.text#ὅστις φενακίζεις, φράσαι δ' οὔπω τέτληκας ἡμῖν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2281.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2281.1.text#οἳ πολλὰ μοχθήσαντες οὐκ οὔσης σχολῆς προθύμως
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2282.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2282.1.text#δεῦρ' ἤλθομεν, πολλῶν θύμων ῥίζας διεκπερῶντες.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2283.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2283.1.text#ἀλλ' οὐκέτ' ἂν κρύψαιμι. τὸν Πλοῦτον γὰρ ὦνδρες ἥκει
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2285.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2285.1.text#ἄγων ὁ δεσπότης, ὃς ὑμᾶς πλουσίους ποιήσει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2286.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2286.1.text#ὄντως γὰρ ἔστι πλουσίοις ἡμῖν ἅπασιν εἶναι;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2287.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2287.1.text#νὴ τοὺς θεοὺς Μίδαις μὲν οὖν, ἢν ὦτ' ὄνου λάβητε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2288.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2288.1.text#ὡς ἥδομαι καὶ τέρπομαι καὶ βούλομαι χορεῦσαι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2289.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2289.1.text#ὑφ' ἡδονῆς, εἴπερ λέγεις ὄντως σὺ ταῦτ' ἀληθῆ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2290.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2290.1.text#καὶ μὴν ἐγὼ βουλήσομαι θρεττανελὸ τὸν Κύκλωπα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2291.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2291.1.text#μιμούμενος καὶ τοῖν ποδοῖν ὡδὶ παρενσαλεύων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2292.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2292.1.text#ὑμᾶς ἄγειν. ἀλλ' εἶα τέκεα θαμίν' ἐπαναβοῶντες
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2293.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2293.1.text#βληχώμενοί τε προβατίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2294.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2294.1.text#αἰγῶν τε κιναβρώντων μέλη
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2295.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2295.1.text#ἕπεσθ' ἀπεψωλημένοι· τράγοι δ' ἀκρατιεῖσθε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2296.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2296.1.text#ἡμεῖς δέ γ' αὖ ζητήσομεν θρεττανελὸ τὸν Κύκλωπα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2297.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2297.1.text#βληχώμενοι, σὲ τουτονὶ πεινῶντα καταλαβόντες,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2298.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2298.1.text#πήραν ἔχοντα λάχανά τ' ἄγρια δροσερά, κραιπαλῶντα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2299.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2299.1.text#ἡγούμενον τοῖς προβατίοις,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2300.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2300.1.text#εἰκῇ δὲ καταδαρθόντα που
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2301.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2301.1.text#μέγαν λαβόντες ἡμμένον σφηκίσκον ἐκτυφλῶσαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2302.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2302.1.text#ἐγὼ δὲ τὴν Κίρκην γε τὴν τὰ φάρμακ' ἀνακυκῶσαν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2303.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2303.1.text#ἣ τοὺς ἑταίρους τοῦ Φιλωνίδου ποτ' ἐν Κορίνθῳ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2304.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2304.1.text#ἔπεισεν ὡς ὄντας κάπρους
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2305.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2305.1.text#μεμαγμένον σκῶρ ἐσθίειν, αὐτὴ δ' ἔματτεν αὐτοῖς,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2306.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2306.1.text#μιμήσομαι πάντας τρόπους·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2307.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2307.1.text#ὑμεῖς δὲ γρυλίζοντες ὑπὸ φιληδίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2308.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2308.1.text#ἕπεσθε μητρὶ χοῖροι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2309.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2309.1.text#οὐκοῦν σε τὴν Κίρκην γε τὴν τὰ φάρμακ' ἀνακυκῶσαν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2310.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2310.1.text#καὶ μαγγανεύουσαν μολύνουσάν τε τοὺς ἑταίρους
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2311.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2311.1.text#λαβόντες ὑπὸ φιληδίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2312.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2312.1.text#τὸν Λαρτίου μιμούμενοι τῶν ὄρχεων κρεμῶμεν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2313.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2313.1.text#μινθώσομέν θ' ὥσπερ τράγου
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2314.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2314.1.text#τὴν ῥῖνα· σὺ δ' Ἀρίστυλλος ὑποχάσκων ἐρεῖς,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2315.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2315.1.text#ἕπεσθε μητρὶ χοῖροι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2316.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2316.1.text#ἀλλ' εἶα νῦν τῶν σκωμμάτων ἀπαλλαγέντες ἤδη
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2317.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2317.1.text#ὑμεῖς ἐπ' ἄλλ' εἶδος τρέπεσθ',
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2318.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2318.1.text#ἐγὼ δ' ἰὼν ἤδη λάθρᾳ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2319.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2319.1.text#βουλήσομαι τοῦ δεσπότου
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2320.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2320.1.text#λαβών τιν' ἄρτον καὶ κρέας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2321.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2321.1.text#μασώμενος τὸ λοιπὸν οὕτω τῷ κόπῳ ξυνεῖναι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2322.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2322.1.text#χαίρειν μὲν ὑμᾶς ἐστιν ὦνδρες δημόται
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2323.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2323.1.text#ἀρχαῖον ἤδη προσαγορεύειν καὶ σαπρόν·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2324.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2324.1.text#ἀσπάζομαι δ' ὁτιὴ προθύμως ἥκετε
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2325.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2325.1.text#καὶ συντεταμένως κοὐ κατεβλακευμένως.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2326.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2326.1.text#ὅπως δέ μοι καὶ τἄλλα συμπαραστάται
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2327.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2327.1.text#ἔσεσθε καὶ σωτῆρες ὄντως τοῦ θεοῦ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2328.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2328.1.text#θάρρει· βλέπειν γὰρ ἄντικρυς δόξεις μ' Ἄρη.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2329.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2329.1.text#δεινὸν γὰρ εἰ τριωβόλου μὲν οὕνεκα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2330.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2330.1.text#ὠστιζόμεσθ' ἑκάστοτ' ἐν τἠκκλησίᾳ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2331.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2331.1.text#αὐτὸν δὲ τὸν Πλοῦτον παρείην τῳ λαβεῖν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2332.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2332.1.text#καὶ μὴν ὁρῶ καὶ Βλεψίδημον τουτονὶ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2333.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2333.1.text#προσιόντα· δῆλος δ' ἐστὶν ὅτι τοῦ πράγματος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2334.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2334.1.text#ἀκήκοέν τι τῇ βαδίσει καὶ τῷ τάχει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2335.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2335.1.text#τί ἂν οὖν τὸ πρᾶγμ' εἴη; πόθεν καὶ τίνι τρόπῳ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2336.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2336.1.text#Χρεμύλος πεπλούτηκ' ἐξαπίνης; οὐ πείθομαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2337.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2337.1.text#καίτοι λόγος γ' ἦν νὴ τὸν Ἡρακλέα πολὺς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2338.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2338.1.text#ἐπὶ τοῖσι κουρείοισι τῶν καθημένων,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2339.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2339.1.text#ὡς ἐξαπίνης ἀνὴρ γεγένηται πλούσιος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2340.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2340.1.text#ἔστιν δέ μοι τοῦτ' αὐτὸ θαυμάσιον, ὅπως
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2341.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2341.1.text#χρηστόν τι πράττων τοὺς φίλους μεταπέμπεται.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2342.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2342.1.text#οὔκουν ἐπιχώριόν γε πρᾶγμ' ἐργάζεται.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2343.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2343.1.text#ἀλλ' οὐδὲν ἀποκρύψας ἐρῶ· νὴ τοὺς θεοὺς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2344.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2344.1.text#ὦ Βλεψίδημ' ἄμεινον ἢ χθὲς πράττομεν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2345.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2345.1.text#ὥστε μετέχειν ἔξεστιν· εἶ γὰρ τῶν φίλων.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2346.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2346.1.text#γέγονας δ' ἀληθῶς, ὡς λέγουσι, πλούσιος;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2347.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2347.1.text#ἔσομαι μὲν οὖν αὐτίκα μάλ', ἢν θεὸς θέλῃ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2348.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2348.1.text#ἔνι γάρ τις ἔνι κίνδυνος ἐν τῷ πράγματι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2349.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2349.1.text#ποῖός τις;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2349.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2349.2.text#οἷος;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2349.3.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2349.3.text#λέγ' ἀνύσας ὅ τι φῄς ποτε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2350.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2350.1.text#ἢν μὲν κατορθώσωμεν, εὖ πράττειν ἀεί·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2351.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2351.1.text#ἢν δὲ σφαλῶμεν, ἐπιτετρῖφθαι τὸ παράπαν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2352.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2352.1.text#τουτὶ πονηρὸν φαίνεται τὸ φορτίον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2353.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2353.1.text#καί μ' οὐκ ἀρέσκει. τό τε γὰρ ἐξαίφνης ἄγαν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2354.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2354.1.text#οὕτως ὑπερπλουτεῖν τό τ' αὖ δεδοικέναι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2355.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2355.1.text#πρὸς ἀνδρὸς οὐδὲν ὑγιές ἐστ' εἰργασμένου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2356.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2356.1.text#πῶς οὐδὲν ὑγιές;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2356.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2356.2.text#εἴ τι κεκλοφὼς νὴ Δία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2357.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2357.1.text#ἐκεῖθεν ἥκεις ἀργύριον ἢ χρυσίον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2358.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2358.1.text#παρὰ τοῦ θεοῦ, κἄπειτ' ἴσως σοι μεταμέλει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2359.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2359.1.text#Ἄπολλον ἀποτρόπαιε μὰ Δί' ἐγὼ μὲν οὔ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2360.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2360.1.text#παῦσαι φλυαρῶν ὦγάθ'· οῖδα γὰρ σαφῶς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2361.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2361.1.text#σὺ μηδὲν εἰς ἔμ' ὑπονόει τοιουτονί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2362.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2362.1.text#φεῦ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2362a.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2362a.1.text#ὡς οὐδὲν ἀτεχνῶς ὑγιές ἐστιν οὐδενός,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2363.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2363.1.text#ἀλλ' εἰσὶ τοῦ κέρδους ἅπαντες ἥττονες.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2364.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2364.1.text#οὔ τοι μὰ τὴν Δήμητρ' ὑγιαίνειν μοι δοκεῖς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2365.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2365.1.text#ὡς πολὺ μεθέστηχ' ὧν πρότερον εἶχεν τρόπων.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2366.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2366.1.text#μελαγχολᾷς ὦνθρωπε νὴ τὸν οὐρανόν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2367.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2367.1.text#ἀλλ' οὐδὲ τὸ βλέμμ' αὐτὸ κατὰ χώραν ἔχει,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2368.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2368.1.text#ἀλλ' ἐστὶν ἐπίδηλόν τι πεπανουργηκότι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2369.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2369.1.text#σὺ μὲν οἶδ' ὃ κρώζεις· ὡς ἐμοῦ τι κεκλοφότος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2370.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2370.1.text#ζητεῖς μεταλαβεῖν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2370.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2370.2.text#μεταλαβεῖν ζητῶ; τίνος;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2371.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2371.1.text#τὸ δ' ἐστὶν οὐ τοιοῦτον ἀλλ' ἑτέρως ἔχον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2372.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2372.1.text#μῶν οὐ κέκλοφας ἀλλ' ἥρπακας;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2372.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2372.2.text#κακοδαιμονᾷς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2373.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2373.1.text#ἀλλ' οὐδὲ μὴν ἀπεστέρηκάς γ' οὐδένα;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2374.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2374.1.text#ου' δῆτ' ἔγωγ'.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2374.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2374.2.text#ὦ Ἡράκλεις, φέρε ποῖ τις ἂν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2375.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2375.1.text#τράποιτο; τἀληθὲς γὰρ οὐκ ἐθέλει φράσαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2376.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2376.1.text#κατηγορεῖς γὰρ πρὶν μαθεῖν τὸ πρᾶγμά μου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2377.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2377.1.text#ὦ τᾶν ἐγώ τοι τοῦτ' ἀπὸ σμικροῦ πάνυ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2378.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2378.1.text#ἐθέλω διαπρᾶξαι πρὶν πυθέσθαι τὴν πόλιν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2379.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2379.1.text#τὸ στόμ' ἐπιβύσας κέρμασιν τῶν ῥητόρων.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2380.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2380.1.text#καὶ μὴν φίλως γ' ἄν μοι δοκεῖς νὴ τοὺς θεοὺς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2381.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2381.1.text#τρεῖς μνᾶς ἀναλώσας λογίσασθαι δώδεκα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2382.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2382.1.text#ὁρῶ τιν' ἐπὶ τοῦ βήματος καθεδούμενον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2383.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2383.1.text#ἱκετηρίαν ἔχοντα μετὰ τῶν παιδίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2384.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2384.1.text#καὶ τῆς γυναικός, κου' διοίσοντ' ἄντικρυς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2385.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2385.1.text#τῶν Ἡρακλειδῶν οὐδ' ὁτιοῦν τῶν Παμφίλου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2386.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2386.1.text#οὒκ ὦ κακόδαιμον, ἀλλὰ τοὺς χρηστοὺς μόνους
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2387.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2387.1.text#ἔγωγε καὶ τοὺς δεξιοὺς καὶ σώφρονας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2388.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2388.1.text#ἀπαρτὶ πλουτῆσαι ποιήσω.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2388.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2388.2.text#τί σὺ λέγεις;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2389.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2389.1.text#οὕτω πάνυ πολλὰ κέκλοφας;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2389.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2389.2.text#οἴμοι τῶν κακῶν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2390.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2390.1.text#ἀπολεῖς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2390.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2390.2.text#σὺ μὲν οὖν σεαυτόν, ὥς γ' ἐμοὶ δοκεῖς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2391.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2391.1.text#ου' δῆτ', ἐπεὶ τὸν Πλοῦτον ὦ μόχθηρε σὺ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2392.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2392.1.text#ἔχω.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2392.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2392.2.text#σὺ Πλοῦτον; ποῖον;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2392.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2392.3.text#αὐτὸν τὸν θεόν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2393.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2393.1.text#καὶ ποῦ 'στιν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2393.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2393.2.text#ἔνδον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2393.3.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2393.3.text#ποῦ;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2393.4.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2393.4.text#παρ' ἐμοί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2393.5.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2393.5.text#παρὰ σοί;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2393.6.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2393.6.text#πάνυ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2394.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2394.1.text#οὐκ ἐς κόρακας; Πλοῦτος παρὰ σοί;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2394.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2394.2.text#νὴ τοὺς θεούς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2395.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2395.1.text#λὲγεις ἀληθῆ;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2395.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2395.2.text#φημί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2395.3.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2395.3.text#πρὸς τῆς Ἑστίας;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2396.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2396.1.text#νὴ τὸν Ποσειδῶ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2396.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2396.2.text#τὸν θαλάττιον λέγεις;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2397.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2397.1.text#εἰ δ' ἔστιν ἕτερός τις Ποσειδῶν, τὸν ἕτερον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2398.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2398.1.text#εἶτ' οὐ διαπέμπεις καὶ πρὸς ἡμᾶς τοὺς φίλους;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2399.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2399.1.text#οὐκ ἔστι πω τὰ πράγματ' ἐν τούτῳ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2399.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2399.2.text#τί φῄς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2400.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2400.1.text#οὐ τῷ μεταδοῦναι;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2400.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2400.2.text#μὰ Δία. δεῖ γὰρ πρῶτα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2400.3.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2400.3.text#τί;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2401.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2401.1.text#βλέψαι ποιῆσαι νώ—
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2401.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2401.2.text#τίνα βλέψαι; φράσον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2402.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2402.1.text#τὸν Πλοῦτον ὥσπερ πρότερον ἑνί γέ τῳ τρόπῳ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2403.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2403.1.text#τυφλὸς γὰρ ὄντως ἐστί;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2403.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2403.2.text#νὴ τὸν οὐρανόν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2404.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2404.1.text#οὐκ ἐτὸς ἄρ' ὡς ἔμ' ἦλθεν οὐδεπώποτε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2405.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2405.1.text#ἀλλ' ἢν θεοὶ θέλωσι, νῦν ἀφίξεται.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2406.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2406.1.text#οὔκουν ἰατρὸν εἰσάγειν ἐχρῆν τινά;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2407.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2407.1.text#τίς δῆτ' ἰατρός ἐστι νῦν ἐν τῇ πόλει;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2408.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2408.1.text#οὔτε γὰρ ὁ μισθὸς οὐδὲν ἔστ' οὔθ' ἡ τέχνη.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2409.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2409.1.text#σκοπῶμεν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2409.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2409.2.text#ἀλλ' οὐκ ἔστιν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2409.3.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2409.3.text#οὐδ ἐμοὶ δοκεῖ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2410.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2410.1.text#μὰ Δί' ἀλλ' ὅπερ πάλαι παρεσκευαζόμην
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2411.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2411.1.text#ἐγώ, κατακλίνειν αὐτὸν εἰς Ἀσκληπιοῦ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2412.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2412.1.text#κράτιστόν ἐστι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2412.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2412.2.text#πολὺ μὲν οὖν νὴ τοὺς θεούς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2413.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2413.1.text#μή νυν διάτριβ' ἀλλ' ἄνυε πράττων ἕν γέ τι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2414.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2414.1.text#καὶ δὴ βαδίζω.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2414.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2414.2.text#σπεῦδέ νυν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2414.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2414.3.text#τοῦτ' αὐτὸ δρῶ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2415.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2415.1.text#ὦ θερμὸν ἔργον κἀνόσιον καὶ παράνομον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2416.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2416.1.text#τολμῶντε δρᾶν ἀνθρωπαρίω κακοδαίμονε—
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2417.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2417.1.text#ποῖ ποῖ; τί φεύγετον; οὐ μενεῖτον;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2417.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2417.2.text#Ἡράκλεις.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2418.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2418.1.text#ἐγὼ γὰρ ὑμᾶς ἐξολῶ κακοὺς κακῶς·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2419.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2419.1.text#τόλμημα γὰρ τολμᾶτον οὐκ ἀνασχετόν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2420.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2420.1.text#ἀλλ' οἷον οὐδεὶς ἄλλος οὐδεπώποτε
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2421.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2421.1.text#οὔτε θεὸς οὔτ' ἄνθρωπος· ὥστ' ἀπολώλατον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2422.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2422.1.text#σὺ δ' εἶ τίς; ὠχρὰ μὲν γὰρ εἶναί μοι δοκεῖς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2423.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2423.1.text#ἴσως Ἐρινύς ἐστιν ἐκ τραγῳδίας·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2424.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2424.1.text#βλέπει γέ τοι μανικόν τι καὶ τραγῳδικόν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2425.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2425.1.text#ἀλλ' οὐκ ἔχει γὰρ δᾷδας.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2425.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2425.2.text#οὐκοῦν κλαύσεται.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2426.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2426.1.text#ὄιεσθε δ' εἶναι τίνα με;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2426.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2426.2.text#πανδοκεύτριαν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2427.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2427.1.text#ἢ λεκιθόπωλιν. οὐ γὰρ ἂν τοσουτονὶ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2428.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2428.1.text#ἀνέκραγες ἡμῖν οὐδὲν ἠδικημένη.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2429.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2429.1.text#ἄληθες; οὐ γὰρ δεινότατα δεδράκατον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2430.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2430.1.text#ζητοῦντες ἐκ πάσης με χώρας ἐκβαλεῖν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2431.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2431.1.text#οὔκουν ὑπόλοιπον τὸ βάραθρόν σοι γίγνεται;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2432.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2432.1.text#ἀλλ' ἥτις εἶ λέγειν σ' ἐχρῆν αὐτίκα μάλα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2433.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2433.1.text#ἣ σφὼ ποιήσω τήμερον δοῦναι δίκην
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2434.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2434.1.text#ἀνθ' ὧν ἐμὲ ζητεῖτον ἐνθένδ' ἀφανίσαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2435.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2435.1.text#ἆρ' ἐστὶν ἡ καπηλὶς ἡκ τῶν γειτόνων,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2436.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2436.1.text#ἣ ταῖς κοτύλαις ἀεί με διαλυμαίνεται;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2437.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2437.1.text#Πενία μὲν οὖν, ἣ σφῷν ξυνοικῶ πόλλ' ἔτη.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2438.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2438.1.text#ἄναξ Ἄπολλον καὶ θεοί, ποῖ τις φύγῃ;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2439.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2439.1.text#οὗτος τί δρᾷς; ὦ δειλότατον σὺ θηρίον·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2440.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2440.1.text#οὐ παραμενεῖς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2440.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2440.2.text#ἥκιστα πάντων.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2440.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2440.3.text#οὐ μενεῖς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2441.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2441.1.text#ἀλλ' ἄνδρε δύο γυναῖκα φεύγομεν μίαν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2442.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2442.1.text#Πενία γάρ ἐστιν ὦ πόνηρ', ἧς οὐδαμοῦ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2443.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2443.1.text#οὐδὲν πέφυκε ζῷον ἐξωλέστερον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2444.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2444.1.text#στῆθ', ἀντιβολῶ σε, στῆθι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2444.2.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2444.2.text#μὰ Δί' ἐγὼ μὲν οὔ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2445.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2445.1.text#καὶ μὴν λέγω, δεινότατον ἔργον παρὰ πολὺ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2446.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2446.1.text#ἔργων ἁπάντων ἐργασόμεθ', εἰ τὸν θεὸν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2447.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2447.1.text#ἔρημον ἀπολιπόντε ποι φευξούμεθα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2448.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2448.1.text#τηνδὶ δεδιότε, μηδὲ διαμαχούμεθα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2449.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2449.1.text#ποίοις ὅπλοισιν ἢ δυνάμει πεποιθότες;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2450.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2450.1.text#ποῖον γὰρ οὐ θώρακα, ποίαν δ' ἀσπίδα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2451.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2451.1.text#οὐκ ἐνέχυρον τίθησιν ἡ μιαρωτάτη;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2452.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2452.1.text#θάρρει· μόνος γὰρ ὁ θεὸς οὗτος οἶδ' ὅτι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2453.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2453.1.text#τροπαῖον ἂν στήσαιτο τῶν ταύτης τρόπων.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2454.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2454.1.text#γρύζειν δὲ καὶ τολμᾶτον ὦ καθάρματε,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2455.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2455.1.text#ἐπ' αὐτοφώρῳ δεινὰ δρῶντ' εἰλημμένω;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2456.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2456.1.text#σὺ δ' ὦ κάκιστ' ἀπολουμένη τί λοιδορεῖ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2457.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2457.1.text#ἡμῖν προσελθοῦσ' οὐδ' ὁτιοῦν ἀδικουμένη;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2458.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2458.1.text#οὐδὲν γὰρ ὦ πρὸς τῶν θεῶν νομίζετε
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2459.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2459.1.text#ἀδικεῖν με τὸν Πλοῦτον ποιεῖν πειρωμένω
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2460.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2460.1.text#βλέψαι πάλιν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2460.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2460.2.text#τί οὖν ἀδικοῦμεν τοῦτό σε,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2461.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2461.1.text#εἰ πᾶσιν ἀνθρώποισιν ἐκπορίζομεν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2462.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2462.1.text#ἀγαθόν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2462.2.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2462.2.text#τί δ' ἂν ὑμεῖς ἀγαθὸν ἐξεύροιθ';
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2462.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2462.3.text#ὅ τι;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2463.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2463.1.text#σὲ πρῶτον ἐκβαλόντες ἐκ τῆς Ἑλλάδος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2464.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2464.1.text#ἔμ' ἐκβαλόντες; καὶ τί ἂν νομίζετον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2465.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2465.1.text#κακὸν ἐργάσασθαι μεῖζον ἀνθρώπους;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2465.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2465.2.text#ὅ τι;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2466.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2466.1.text#εἰ τοῦτο δρᾶν μέλλοντες ἐπιλαθοίμεθα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2467.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2467.1.text#καὶ μὴν περὶ τούτου σφῷν ἐθέλω δοῦναι λόγον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2468.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2468.1.text#τὸ πρῶτον αὐτοῦ· κἂν μὲν ἀποφήνω μόνην
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2469.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2469.1.text#ἀγαθῶν ἁπάντων οὖσαν αἰτίαν ἐμὲ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2470.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2470.1.text#ὑμῖν δι' ἐμέ τε ζῶντας ὑμᾶς· εἰ δὲ μή,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2471.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2471.1.text#ποιεῖτον ἤδη τοῦθ' ὅ τι ἂν ὑμῖν δοκῇ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2472.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2472.1.text#ταυτὶ σὺ τολμᾷς ὦ μιαρωτάτη λέγειν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2473.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2473.1.text#καὶ σύ γε διδάσκου· πάνυ γὰρ οἶμαι ῥᾳδίως
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2474.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2474.1.text#ἅπανθ' ἁμαρτάνοντά σ' ἀποδείξειν ἐγώ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2475.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2475.1.text#εἰ τοὺς δικαίους φῂς ποιήσειν πλουσίους.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2476.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2476.1.text#ὦ τύμπανα καὶ κύφωνες οὐκ ἀρήξετε;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2477.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2477.1.text#οὐ δεῖ σχετλιάζειν καὶ βοᾶν πρὶν ἂν μάθῃς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2478.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2478.1.text#καὶ τίς δύναιτ' ἂν μὴ βοᾶν "ἰοὺ ἰοὺ"
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2479.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2479.1.text#τοιαῦτ' ἀκούων;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2479.2.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2479.2.text#ὅστις ἐστὶν εὖ φρονῶν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2480.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2480.1.text#τί δῆτά σοι τίμημ' ἐπιγράψω τῇ δίκῃ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2481.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2481.1.text#ἐὰν ἁλῷς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2481.2.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2481.2.text#ὅ τι σοι δοκεῖ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2481.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2481.3.text#καλῶς λέγεις.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2482.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2482.1.text#τὸ γὰρ αὔτ', ἐὰν ἡττᾶσθε, καὶ σφὼ δεῖ παθεῖν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2483.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2483.1.text#ἱκανοὺς νομίζεις δῆτα θανάτους εἴκοσιν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2484.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2484.1.text#ταύτῃ γε· νῷν δὲ δὔ ἀποχρήσουσιν μόνω.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2485.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2485.1.text#οὐκ ἂν φθάνοιτον τοῦτο πράττοντ', ἢ τί γ' ἂν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2486.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2486.1.text#ἔχοι τις ἂν δίκαιον ἀντειπεῖν ἔτι;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2487.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2487.1.text#ἀλλ' ἤδη χρῆν τι λέγειν ὑμᾶς σοφὸν ᾧ νικήσετε τηνδὶ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2488.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2488.1.text#ἐν τοῖσι λόγοις ἀντιλέγοντες, μαλακὸν δ' ἐνδώσετε μηδέν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2489.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2489.1.text#φανερὸν μὲν ἔγωγ' οἶμαι γνῶναι τοῦτ' εἶναι πᾶσιν ὁμοίως,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2490.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2490.1.text#ὅτι τοὺς χρηστοὺς τῶν ἀνθρώπων εὖ πράττειν ἐστὶ δίκαιον,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2491.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2491.1.text#τοὺς δὲ πονηροὺς καὶ τοὺς ἀθέους τούτων τἀναντία δήπου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2492.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2492.1.text#τοῦτ' οὖν ἡμεῖς ἐπιθυμοῦντες μόλις ηὕρομεν, ὥστε γενέσθαι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2493.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2493.1.text#βούλευμα καλὸν καὶ γενναῖον καὶ χρήσιμον εἰς ἅπαν ἔργον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2494.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2494.1.text#ἢν γὰρ ὁ Πλοῦτος νυνὶ βλέψῃ καὶ μὴ τυφλὸς ὢν περινοστῇ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2495.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2495.1.text#ὡς τοὺς ἀγαθοὺς τῶν ἀνθρώπων βαδιεῖται κοὐκ ἀπολείψει,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2496.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2496.1.text#τοὺς δὲ πονηροὺς καὶ τοὺς ἀθέους φευξεῖται· κᾆτα ποιήσει
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2497.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2497.1.text#πάντας χρηστοὺς καὶ πλουτοῦντας δήπου τά τε θεῖα σέβοντας.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2498.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2498.1.text#καίτοι τούτου τοῖς ἀνθρώποις τίς ἂν ἐξεύροι ποτ' ἄμεινον;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2499.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2499.1.text#οὐδείς· τούτου μάρτυς ἐγώ σοι· μηδὲν ταύτην γ' ἀνερώτα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2500.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2500.1.text#ὡς μὲν γὰρ νῦν ἡμῖν ὁ βίος τοῖς ἀνθρώποις διάκειται,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2501.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2501.1.text#τίς ἂν οὐχ ἡγοῖτ' εἶναι μανίαν κακοδαιμονίαν τ' ἔτι μᾶλλον;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2502.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2502.1.text#πολλοὶ μὲν γὰρ τῶν ἀνθρώπων ὄντες πλουτοῦσι πονηροί,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2503.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2503.1.text#ἀδίκως αὐτὰ ξυλλεξάμενοι· πολλοὶ δ' ὄντες πάνυ χρηστοὶ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2504.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2504.1.text#πράττουσι κακῶς καὶ πεινῶσιν μετὰ σοῦ τε τὰ πλεῖστα σύνεισιν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2505.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2505.1.text#οὔκουν εἶναί φημ', εἰ παύσει ταύτην βλέψας ποθ' ὁ Πλοῦτος,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2506.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2506.1.text#ὁδὸν ἥντιν' ἰὼν τοῖς ἀνθρώποις ἀγάθ' ἄν μείζω πορίσειεν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2507.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2507.1.text#ἀλλ' ὦ πάντων ῥᾷστ' ἀνθρώπων ἀναπεισθέντ' οὐχ ὑγιαίνειν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2508.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2508.1.text#δύο πρεσβύτα, ξυνθιασώτα τοῦ ληρεῖν καὶ παραπαίειν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2509.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2509.1.text#εἰ τοῦτο γένοιθ' ὃ ποθεῖθ' ὑμεῖς, οὔ φημ' ἂν λυσιτελεῖν σφῷν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2510.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2510.1.text#εἰ γὰρ ὁ Πλοῦτος βλέψειε πάλιν διανείμειέν τ' ἴσον αὑτόν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2511.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2511.1.text#οὔτε τέχνην ἂν τῶν ἀνθρώπων οὔτ' ἂν σοφίαν μελετῴη
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2512.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2512.1.text#οὐδείς· ἀμφοῖν δ' ὑμῖν τούτοιν ἀφανισθέντοιν ἐθελήσει
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2513.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2513.1.text#τίς χαλκεύειν ἢ ναυπηγεῖν ἢ ῥάπτειν ἢ τροχοποιεῖν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2514.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2514.1.text#ἢ σκυτοτομεῖν ἢ πλινθουργεῖν ἢ πλύνειν ἢ σκυλοδεψεῖν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2515.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2515.1.text#ἢ γῆς ἀρότροις ῥήξας δάπεδον καρπὸν Δηοῦς θερίσασθαι,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2516.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2516.1.text#ἢν ἐξῇ ζῆν ἀργοῖς ὑμῖν πάντων ἀμελοῦσιν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2517.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2517.1.text#λῆρον ληρεῖς. ταῦτα γὰρ ἡμῖν πάνθ' ὅσα νῦν δὴ κατέλεξας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2518.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2518.1.text#οἱ θεράποντες μοχθήσουσιν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2518.2.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2518.2.text#πόθεν οὖν ἕξεις θεράποντας;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2519.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2519.1.text#ὠνησόμεθ' ἀργυρίου δήπου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2519.2.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2519.2.text#τίς δ' ἔσται πρῶτον ὁ πωλῶν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2520.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2520.1.text#ὅταν ἀργύριον κἀκεῖνος ἔχῃ;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2520.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2520.2.text#κερδαίνειν βουλόμενός τις
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2521.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2521.1.text#ἔμπορος ἥκων ἐκ Θετταλίας παρὰ πλείστων ἀνδραποδιστῶν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2522.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2522.1.text#ἀλλ' οὐδ' ἔσται πρῶτον ἁπάντων οὐδεὶς οὐδ' ἀνδραποδιστὴς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2523.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2523.1.text#κατὰ τὸν λόγον ὃν σὺ λέγεις δήπου. τίς γὰρ πλουτῶν ἐθελήσει
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2524.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2524.1.text#κινδυνεύων περὶ τῆς ψυχῆς τῆς αὑτοῦ τοῦτο ποιῆσαι;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2525.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2525.1.text#ὥστ' αὐτὸς ἀροῦν ἐπαναγκασθεὶς καὶ σκάπτειν τἄλλα τε μοχθεῖν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2526.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2526.1.text#ὀδυνηρότερον τρίψεις βίοτον πολὺ τοῦ νῦν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2526.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2526.2.text#ἐς κεφαλὴν σοί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2527.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2527.1.text#ἔτι δ' οὐχ ἕξεις οὔτ' ἐν κλίνῃ καταδαρθεῖν, οὐ γὰρ ἔσονται,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2528.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2528.1.text#οὔτ' ἐν δάπισιν· τίς γὰρ ὑφαίνειν ἐθελήσει χρυσίου ὄντος;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2529.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2529.1.text#οὔτε μύροισιν μυρίσαι στακτοῖς ὁπόταν νύμφην ἀγάγησθον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2530.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2530.1.text#οὔθ' ἱματίων βαπτῶν δαπάναις κοσμῆσαι ποικιλομόρφων.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2531.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2531.1.text#καίτοι τί πλέον πλουτεῖν ἐστιν τούτων πάντων ἀποροῦντας;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2532.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2532.1.text#παρ' ἐμοῦ δ' ἔστιν ταῦτ' εὔπορα πάνθ' ὑμῖν ὧν δείσθον· ἐγὼ γὰρ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2533.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2533.1.text#τὸν χειροτέχνην ὥσπερ δέσποιν' ἐπαναγκάζουσα κάθημαι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2534.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2534.1.text#διὰ τὴν χρείαν καὶ τὴν πενίαν ζητεῖν ὁπόθεν βίον ἕξει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2535.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2535.1.text#σὺ γὰρ ἂν πορίσαι τί δύναι' ἀγαθὸν φῴδων ἐκ βαλανείου
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2536.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2536.1.text#καὶ παιδαρίων ὑποπεινώντων καὶ γραι·δίων κολοσυρτόν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2537.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2537.1.text#φθειρῶν τ' ἀριθμὸν καὶ κωνώπων καὶ ψυλλῶν οὐδὲ λέγω σοι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2538.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2538.1.text#ὑπὸ τοῦ πλήθους, αἳ βομβοῦσαι περὶ τὴν κεφαλὴν ἀνιῶσιν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2539.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2539.1.text#ἐπεγείρουσαι καὶ φράζουσαι, "πεινήσεις, ἀλλ' ἐπανίστω."
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2540.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2540.1.text#πρὸς δέ γε τούτοις ἀνθ' ἱματίου μὲν ἔχειν ῥάκος· ἀντὶ δὲ κλίνης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2541.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2541.1.text#στιβάδα σχοίνων κόρεων μεστήν, ἣ τοὺς εὕδοντας ἐγείρει·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2542.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2542.1.text#καὶ φορμὸν ἔχειν ἀντὶ τάπητος σαπρόν· ἀντὶ δὲ προσκεφαλαίου
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2543.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2543.1.text#λίθον ἐυμεγέθη πρὸς τῇ κεφαλῇ· σιτεῖσθαι δ' ἀντὶ μὲν ἄρτων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2544.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2544.1.text#μαλάχης πτόρθους, ἀντὶ δὲ μάζης φυλλεῖ' ἰσχνῶν ῥαφανίδων,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2545.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2545.1.text#ἀντὶ δὲ θράνους στάμνου κεφαλὴν κατεαγότος, ἀντὶ δὲ μάκτρας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2546.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2546.1.text#φιδάκνης πλευρὰν ἐρρωγυῖαν καὶ ταύτην. ἆρά γε πολλῶν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2547.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2547.1.text#ἀγαθῶν πᾶσιν τοῖς ἀνθρὠποις ἀποφαίνω σ' αἴτιον οὖσαν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2548.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2548.1.text#σὺ μὲν οὐ τὸν ἐμὸν βίον εἴρηκας, τὸν τῶν πτωχῶν δ' ὑπεκρούσω.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2549.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2549.1.text#οὐκοῦν δήπου τῆς Πτωχείας Πενίαν φαμὲν εἶναι ἀδελφήν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2550.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2550.1.text#ὑμεῖς γ' οἵπερ καὶ Θρασυβούλῳ Διονύσιον εἶναι ὅμοιον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2551.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2551.1.text#ἀλλ' οὐχ οὑμὸς τοῦτο πέπονθεν βίος οὐ μὰ Δί', οὐδέ γε μέλλει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2552.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2552.1.text#πτωχοῦ μὲν γὰρ βίος, ὃν σὺ λέγεις, ζῆν ἐστιν μηδὲν ἔχοντα·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2553.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2553.1.text#τοῦ δὲ πένητος ζῆν φειδόμενον καὶ τοῖς ἔργοις προς έχοντα,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2554.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2554.1.text#περιγίγνεσθαι δ' αὐτῷ μηδέν, μὴ μέντοι μηδ' ἐπιλείπειν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2555.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2555.1.text#ὡς μακαρίτην ὦ Δάματερ τὸν βίον αὐτοῦ κατέλεξας,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2556.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2556.1.text#εἰ φεισάμενος καὶ μοχθήσας καταλείψει μηδὲ ταφῆναι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2557.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2557.1.text#σκώπτειν πειρᾷ καὶ κωμῳδεῖν τοῦ σπουδάζειν ἀμελήσας,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2558.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2558.1.text#οὐ γιγνώσκων ὅτι τοῦ Πλούτου παρέχω βελτίονας ἄνδρας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2559.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2559.1.text#καὶ τὴν γνώμην καὶ τὴν ἰδέαν. παρὰ τῷ μὲν γὰρ ποδαγρῶντες
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2560.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2560.1.text#καὶ γαστρώδεις καὶ παχύκνημοι καὶ πίονές εἰσιν ἀσελγῶς,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2561.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2561.1.text#παρ' ἐμοὶ δ' ἰσχνοὶ καὶ σφηκώδεις καὶ τοῖς ἐχθροῖς ἀνιαροί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2562.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2562.1.text#ἀπὸ τοῦ λιμοῦ γὰρ ἴσως αὐτοῖς τὸ σφηκῶδες σὺ πορίζεις.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2563.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2563.1.text#περὶ σωφροσύνης ἤδη τοίνυν περανῶ σφῷν κἀναδιδάξω
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2564.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2564.1.text#ὅτι κοσμιότης οἰκεῖ μετ' ἐμοῦ, τοῦ Πλούτου δ' ἐστὶι ὑβρίζειν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2565.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2565.1.text#πάνυ γοῦν κλέπτειν κόσμιόν ἐστιν καὶ τοὺς τοίχους διορύττειν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2566.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2566.1.text#†νὴ τὸν Δί', εἰ δεῖ λαθεῖν αὐτόν, πῶς οὐχὶ κόσμιόν ἐστι;†
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2567.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2567.1.text#σκέψαι τοίνυν ἐν ταῖς πόλεσιν τοὺς ῥήτορας, ὡς ὁπόταν μὲν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2568.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2568.1.text#ὦσι πένητες, περὶ τὸν δῆμον καὶ τὴν πόλιν εἰσὶ δίκαιοι,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2569.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2569.1.text#πλουτήσαντες δ' ἀπὸ τῶν κοινῶν παραχρῆμ' ἄδικοι γεγένηνται,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2570.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2570.1.text#ἐπιβουλεύουσί τε τῷ πλήθει καὶ τῷ δήμῳ πολεμοῦσιν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2571.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2571.1.text#ἀλλ' οὐ ψεύδει τούτων γ' οὐδέν, καίπερ σφόδρα βάσκανος οὖσα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2572.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2572.1.text#ἀτὰρ οὐχ ἧττόν γ' οὐδὲν κλαύσει, μηδὲν ταύτῃ γε κομήσῃς,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2573.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2573.1.text#ὁτιὴ ζητεῖς τοῦτ' ἀναπείθειν ἡμᾶς, ὡς ἔστιν ἄμεινον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2574.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2574.1.text#Πενία Πλούτου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2574.2.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2574.2.text#καὶ σύ γ' ἐλέγξαι μ' οὔπω δύνασαι περὶ τούτου,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2575.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2575.1.text#ἀλλὰ φλυαρεῖς καὶ πτερυγίζεις.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2575.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2575.2.text#καὶ πῶς φεύγουσί σ' ἅπαντες;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2576.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2576.1.text#ὅτι βελτίους αὐτοὺς ποιῶ. σκέψασθαι δ' ἔστι μάλιστα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2577.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2577.1.text#ἀπὸ τῶν παίδων· τοὺς γὰρ πατέρας φεύγουσι φρονοῦντας ἄριστα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2578.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2578.1.text#αὐτοῖς. οὕτω διαγιγνώσκειν χαλεπὸν πρᾶγμ' ἐστὶ δίκαιον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2579.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2579.1.text#τὸν Δία φήσεις ἆρ' οὐκ ὀρθῶς διαγιγνώσκειν τὸ κράτιστον·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2580.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2580.1.text#κἀκεῖνος γὰρ τὸν Πλοῦτον ἔχει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2581.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2581.1.text#ταύτην δ' ἡμῖν ἀποπέμπει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2581.2.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2581.2.text#ἀλλ' ὦ Κρονικαῖς λήμαις ὄντως λημῶντες τὰς φρένας ἄμφω,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2582.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2582.1.text#ὁ Ζεὺς δήπου πένεται, καὶ τοῦτ' ἤδη φανερῶς σε διδάξω.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2583.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2583.1.text#εἰ γὰρ ἐπλούτει, πῶς ἂν ποιῶν τὸν Ὀλυμπικὸν αὐτὸς ἀγῶνα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2584.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2584.1.text#ἵνα τοὺς Ἕλληνας ἅπαντας ἀεὶ δι' ἔτους πέμπτου ξυναγείρει,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2585.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2585.1.text#ἀνεκήρυττεν τῶν ἀσκητῶν τοὺς νικῶντας στεφανώσας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2586.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2586.1.text#κοτίνου στεφάνῳ; καίτοι χρυσῷ μᾶλλον ἐχρῆν, εἴπερ ἐπλούτει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2587.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2587.1.text#οὐκοῦν τούτῳ δήπου δηλοῖ τιμῶν τὸν Πλοῦτον ἐκεῖνος·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2588.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2588.1.text#φειδόμενος γὰρ καὶ βουλόμενος τούτου μηδὲν δαπανᾶσθαι,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2589.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2589.1.text#λήροις ἀναδῶν τοὺς νικῶντας τὸν Πλοῦτον ἐᾷ παρ' ἑαυτῷ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2590.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2590.1.text#πολὺ τῆς Πενίας πρᾶγμ' αἴσχιον ζητεῖς αὐτῷ περιάψαι,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2591.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2591.1.text#εἰ πλούσιος ὢν ἀνελεύθερός ἐσθ' οὑτωσὶ καὶ φιλοκερδής.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2592.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2592.1.text#ἀλλὰ σέ γ' ὁ Ζεὺς ἐξολέσειεν κοτίνου στεφάνῳ στεφανώσας.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2593.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2593.1.text#τὸ γὰρ ἀντιλέγειν τολμᾶν ὑμᾶς ὡς οὐ πάντ' ἔστ' ἀγάθ' ὑμῖν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2594.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2594.1.text#διὰ τὴν Πενίαν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2594.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2594.2.text#παρὰ τῆς Ἑκάτης ἔξεστιν τοῦτο πυθέσθαι,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2595.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2595.1.text#εἴτε τὸ πλουτεῖν εἴτε τὸ πεινῆν βέλτιον. φησὶ γὰρ αὕτη
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2596.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2596.1.text#τοὺς μὲν ἔχοντας καὶ πλουτοῦντας δεῖπνον κατὰ μῆν' ἀποπέμπειν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2597.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2597.1.text#τοὺς δὲ πένητας τῶν ἀνθρώπων ἁρπάζειν πρὶν καταθεῖναι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2598.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2598.1.text#ἀλλὰ φθείρου καὶ μὴ γρύξῃς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2599.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2599.1.text#ἔτι μηδ' ὁτιοῦν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2600.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2600.1.text#οὐ γὰρ πείσεις, οὐδ' ἢν πείσῃς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2601.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2601.1.text#ὦ πόλις Ἄργους, κλύεθ' οἷα λέγει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2602.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2602.1.text#Παύσωνα κάλει τὸν ξύσσιτον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2603.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2603.1.text#τί πάθω τλήμων;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2604.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2604.1.text#ἔρρ' ἐς κόρακας θᾶττον ἀφ' ἡμῶν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2605.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2605.1.text#εἶμι δὲ ποῖ γῆς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2606.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2606.1.text#ἐς τὸν κύφων'· ἀλλ' οὐ μέλλειν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2607.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2607.1.text#χρῆν σ', ἀλλ' ἀνύειν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2608.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2608.1.text#ἦ μὴν ὑμεῖς γ' ἔτι μ' ἐνταυθοῖ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2609.1.speaker#Πενία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2609.1.text#μεταπέμψεσθον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2610.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2610.1.text#τότε νοστήσεις· νῦν δὲ φθείρου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2611.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2611.1.text#κρεῖττον γάρ μοι πλουτεῖν ἐστίν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2612.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2612.1.text#σὲ δ' ἐᾶν κλάειν μακρὰ τὴν κεφαλήν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2613.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2613.1.text#νὴ Δί' ἐγὼ γοῦν ἐθέλω πλουτῶν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2614.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2614.1.text#εὐωχεῖσθαι μετὰ τῶν παίδων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2615.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2615.1.text#τῆς τε γυναικός, καὶ λουσάμενος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2616.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2616.1.text#λιπαρὸς χωρῶν ἐκ βαλανείου
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2617.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2617.1.text#τῶν χειροτεχνῶν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2618.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2618.1.text#καὶ τῆς Πενίας καταπαρδεῖν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2619.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2619.1.text#αὕτη μὲν ἡμῖν ἡπίτριπτος οἴχεται.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2620.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2620.1.text#ἐγὼ δὲ καὶ σύ γ' ὡς τάχιστα τὸν θεὸν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2621.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2621.1.text#ἐγκατακλινοῦντ' ἄγωμεν εἰς Ἀσκληπιοῦ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2622.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2622.1.text#καὶ μὴ διατρίβωμέν γε, μὴ πάλιν τις αὖ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2623.1.speaker#Βλεψίδημος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2623.1.text#ἐλθὼν διακωλύσῃ τι τῶν προὔργου ποιεῖν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2624.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2624.1.text#παῖ Καρίων τὰ στρώματ' ἐκφέρειν σ' ἐχρῆν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2625.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2625.1.text#αὐτόν τ' ἄγειν τὸν Πλοῦτον, ὡς νομίζεται,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2626.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2626.1.text#καὶ τἄλλ' ὅσ' ἐστὶν ἔνδον ηὐτρεπισμένα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2627.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2627.1.text#ὦ πλεῖστα Θησείοις μεμυστιλημένοι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2628.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2628.1.text#γέροντες ἄνδρες ἐπ' ὀλιγίστοις ἀλφίτοις,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2629.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2629.1.text#ὡς εὐτυχεῖθ', ὡς μακαρίως πεπράγατε,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2630.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2630.1.text#ἄλλοι θ' ὅσοις μέτεστι τοῦ χρηστοῦ τρόπου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2631.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2631.1.text#τί δ' ἔστιν ὦ βέλτιστε τῶν σαυτοῦ φίλων;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2632.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2632.1.text#φαίνει γὰρ ἥκειν ἄγγελος χρηστοῦ τινος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2633.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2633.1.text#ὁ δεσπότης πέπραγεν εὐτυχέστατα,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2634.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2634.1.text#μᾶλλον δ' ὁ Πλοῦτος αὐτός· ἀντὶ γὰρ τυφλοῦ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2635.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2635.1.text#ἐξωμμάτωται καὶ λελάμπρυνται κόρας,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2636.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2636.1.text#Ἀσκληπιοῦ παιῶνος εὐμενοῦς τυχών.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2637.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2637.1.text#λέγεις μοι χαράν, λέγεις μοι βοάν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2638.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2638.1.text#πάρεστι χαίρειν, ἤν τε βούλησθ' ἤν τε μή.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2639.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2639.1.text#ἀναβοάσομαι τὸν εὔπαιδα καὶ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2640.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2640.1.text#μέγα βροτοῖσι φέγγος Ἀσκληπιόν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2641.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2641.1.text#τίς ἡ βοή ποτ' ἐστίν; ἆρ' ἀγγέλλεται
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2642.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2642.1.text#χρηστόν τι; τοῦτο γὰρ ποθοῦσ' ἐγὼ πάλαι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2643.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2643.1.text#ἔνδον κάθημαι περιμένουσα τουτονί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2644.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2644.1.text#ταχέως ταχέως φέρ' οἶνον ὦ δέσποιν', ἵνα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2645.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2645.1.text#καὐτὴ πίῃς· φιλεῖς δὲ δρῶσ' αὐτὸ σφόδρα·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2646.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2646.1.text#ὡς ἀγαθὰ συλλήβδην ἅπαντά σοι φέρω.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2647.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2647.1.text#καὶ ποῦ στιν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2647.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2647.2.text#ἐν τοῖς λεγομένοις εἴσει τάχα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2648.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2648.1.text#πέραινε τοίνυν ὅ τι λέγεις ἀνύσας ποτέ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2649.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2649.1.text#ἄκουε τοίνυν, ὡς ἐγὼ τὰ πράγματα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2650.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2650.1.text#ἐκ τῶν ποδῶν ἐς τὴν κεφαλήν σοι πάντ' ἐρῶ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2651.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2651.1.text#μὴ δῆτ' ἔμοιγ' ἐς τὴν κεφαλήν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2651.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2651.2.text#μὴ τἀγαθὰ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2652.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2652.1.text#ἃ νῦν γεγένηται;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2652.2.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2652.2.text#μὴ μὲν οὖν τὰ πράγματα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2653.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2653.1.text#ὡς γὰρ τάχιστ' ἀφικόμεθα πρὸς τὸν θεὸν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2654.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2654.1.text#ἄγοντες ἄνδρα τότε μὲν ἀθλιώτατον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2655.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2655.1.text#νῦν δ' εἴ τιν' ἄλλον μακάριον κεὐδαίμονα,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2656.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2656.1.text#πρῶτον μὲν αὐτὸν ἐπὶ θάλατταν ἤγομεν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2657.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2657.1.text#ἔπειτ' ἐλοῦμεν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2657.2.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2657.2.text#νὴ Δί' εὐδαίμων ἄρ' ἦν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2658.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2658.1.text#ἀνὴρ γέρων ψυχρᾷ θαλάττῃ λούμενος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2659.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2659.1.text#ἔπειτα πρὸς τὸ τέμενος ᾖμεν τοῦ θεοῦ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2660.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2660.1.text#ἐπεὶ δὲ βωμῷ πόπανα καὶ προθύματα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2661.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2661.1.text#καθωσιώθη πέλανος Ἡφαίστου φλογί,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2662.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2662.1.text#κατεκλίναμεν τὸν Πλοῦτον, ὥσπερ εἰκὸς ἦν·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2663.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2663.1.text#ἡμῶν δ' ἕκαστος στιβάδα παρεκαττύετο.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2664.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2664.1.text#ἦσαν δέ τινες κἄλλοι δεόμενοι τοῦ θεοῦ;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2665.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2665.1.text#εἷς μέν γε Νεοκλείδης, ὅς ἐστι μὲν τυφλός,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2666.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2666.1.text#κλέπτων δὲ τοὺς βλέποντας ὑπερηκόντικεν·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2667.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2667.1.text#ἕτεροί τε πολλοὶ παντοδαπὰ νοσήματα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2668.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2668.1.text#ἔχοντες· ὡς δὲ τοὺς λύχνους ἀποσβέσας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2669.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2669.1.text#ἡμῖν παρήγγειλεν καθεύδειν τοῦ θεοῦ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2670.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2670.1.text#ὁ πρόπολος, εἰπών, ἤν τις αἴσθηται ψόφου
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2671.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2671.1.text#σιγᾶν, ἅπαντες κοσμίως κατεκείμεθα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2672.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2672.1.text#κἀγὼ καθεύδειν οὐκ ἐδυνάμην, ἀλλά με
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2673.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2673.1.text#ἀθάρης χύτρα τις ἐξέπληττε κειμένη
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2674.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2674.1.text#ὀλίγον ἄπωθεν τῆς κεφαλῆς του γρᾳδίου,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2675.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2675.1.text#ἐφ' ἣν ἐπεθύμουν δαιμονίως ἐφερπύσαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2676.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2676.1.text#ἔπειτ' ἀναβλέψας ὁρῶ τὸν ἱερέα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2677.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2677.1.text#τοὺς φθοῖς ἀφαρπάζοντα καὶ τὰς ἰσχάδας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2678.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2678.1.text#ἀπὸ τῆς τραπέζης τῆς ἱερᾶς· μετὰ τοῦτο δὲ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2679.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2679.1.text#περιῆλθε τοὺς βωμοὺς ἅπαντας ἐν κύκλῳ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2680.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2680.1.text#εἴ που πόπανον εἴη τι καταλελειμμένον·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2681.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2681.1.text#ἔπειτα ταῦθ' ἥγιζεν ἐς σάκταν τινά.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2682.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2682.1.text#κἀγὼ νομίσας πολλὴν ὁσίαν τοῦ πράγματος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2683.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2683.1.text#ἐπὶ τὴν χύτραν τῆς ἀθάρης ἀνίσταμαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2684.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2684.1.text#ταλάντατ' ἀνδρῶν οὐκ ἐδεδοίκεις τὸν θεόν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2685.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2685.1.text#νὴ τοὺς θεοὺς ἔγωγε μὴ φθάσειέ με
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2686.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2686.1.text#ἐπὶ τὴν χύτραν ἐλθὼν ἔχων τὰ στέμματα·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2687.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2687.1.text#ὁ γὰρ ἱερεὺς αὐτοῦ με προὐδιδάξατο.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2688.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2688.1.text#τὸ γρᾴδιον δ' ὡς ᾔσθετο δή μου τὸν ψόφον,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2689.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2689.1.text#ἄρασ' ὑφῄρει· κᾆτα συρίξας ἐγὼ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2690.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2690.1.text#ὀδὰξ ἐλαβόμην ὡς παρείας ὢν ὄφις.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2691.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2691.1.text#ἡ δ' εὐθέως τὴν χεῖρα πάλιν ἀνέσπασεν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2692.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2692.1.text#κατέκειτο δ' αὑτὴν ἐντυλίξασ' ἡσυχῇ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2693.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2693.1.text#ὑπὸ τοῦ δέους βδέουσα δριμύτερον γαλῆς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2694.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2694.1.text#κἀγὼ τότ' ἤδη τῆς ἀθάρης πολλὴν ἔφλων·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2695.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2695.1.text#ἔπειτ' ἐπειδὴ μεστὸς ἦν, ἀνεπαλλόμην.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2696.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2696.1.text#ὁ δὲ θεὸς ὑμῖν οὐ προσῄειν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2696.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2696.2.text#οὐδέπω.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2697.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2697.1.text#μετὰ τοῦτο δ' ἤδη καὶ γέλοιον δῆτά τι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2698.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2698.1.text#ἐποίησα. προσιόντος γὰρ αὐτοῦ μέγα πάνυ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2699.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2699.1.text#ἀπέπαρδον· ἡ γαστὴρ γὰρ ἐπεφύσητό μου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2700.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2700.1.text#ἦ πού σε διὰ τοῦτ' εὐθὺς ἐβδελύττετο.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2701.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2701.1.text#οὔκ, ἀλλ' Ἰασὼ μέν τις ἀκολουθοῦσ' ἅμα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2702.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2702.1.text#ὑπηρυθρίασε χἠ Πανάκει' ἀπεστράφη
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2703.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2703.1.text#τὴν ῥῖν' ἐπιλαβοῦσ'· οὐ λιβανωτὸν γὰρ βδέω.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2704.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2704.1.text#αὐτὸς δ' ἐκεῖνος;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2704.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2704.2.text#οὐ μὰ Δί' οὐδ' ἐφρόντισεν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2705.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2705.1.text#λέγεις ἄγροικον ἄρα σύ γ' εἶναι τὸν θεόν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2706.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2706.1.text#μὰ Δί' οὐκ ἔγωγ', ἀλλὰ σκατοφάγον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2706.2.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2706.2.text#αἲ τάλαν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2707.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2707.1.text#μετὰ ταῦτ' ἐγὼ μὲν εὐθὺς ἐνεκαλυψάμην
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2708.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2708.1.text#δείσας, ἐκεῖνος δ' ἐν κύκλῳ τὰ νοσήματα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2709.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2709.1.text#σκοπῶν περιῄει πάντα κοσμίως πάνυ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2710.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2710.1.text#ἔπειτα παῖς αὐτῷ λίθινον θυείδιον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2711.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2711.1.text#παρέθηκε καὶ δοίδυκα καὶ κιβώτιον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2712.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2712.1.text#λίθινον;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2712.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2712.2.text#μὰ Δί' οὐ δῆτ' οὐχὶ τό γε κιβώτιον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2713.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2713.1.text#σὺ δὲ πῶς ἑώρας ὦ κάκιστ' ἀπολούμενε,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2714.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2714.1.text#ὃς ἐγκεκαλύφθαι φῄς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2714.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2714.2.text#διὰ τοῦ τριβωνίου·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2715.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2715.1.text#ὀπὰς γὰρ εἶχεν οὐκ ὀλίγας μὰ τὸν Δία.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2716.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2716.1.text#πρῶτον δὲ πάντων τῷ Νεοκλείδῃ φάρμακον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2717.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2717.1.text#καταπλαστὸν ἐνεχείρησε τρίβειν, ἐμβαλὼν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2718.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2718.1.text#σκορόδων κεφαλὰς τρεῖς Τηνίων. ἔπειτ' ἔφλα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2719.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2719.1.text#ἐν τῇ θυείᾳ συμπαραμιγνύων ὀπὸν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2720.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2720.1.text#καὶ σχῖνον· εἶτ' ὄξει διέμενος Σφηττίῳ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2721.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2721.1.text#κατέπλασεν αὐτοῦ τὰ βλέφαρ' ἐκστρέψας, ἵνα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2722.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2722.1.text#ὀδυνῷτο μᾶλλον. ὁ δὲ κεκραγὼς καὶ βοῶν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2723.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2723.1.text#ἔφευγ' ἀνᾴξας· ὁ δὲ θεὸς γελάσας ἔφη·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2724.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2724.1.text#"ἐνταῦθα νῦν κάθησο καταπεπλασμένος,"
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2725.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2725.1.text#"ἵν' ὑπομνύμενον παύσω σε τὰς ἐκκλησίας."
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2726.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2726.1.text#ὡς φιλόπολίς τίς ἐσθ' ὁ δαίμων καὶ σοφός.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2727.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2727.1.text#μετὰ τοῦτο τῷ Πλούτωνι παρεκαθέζετο,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2728.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2728.1.text#καὶ πρῶτα μὲν δὴ τῆς κεφαλῆς ἐφήψατο,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2729.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2729.1.text#ἔπειτα καθαρὸν ἡμιτύβιον λαβὼν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2730.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2730.1.text#τὰ βλέφαρα περιέψησεν· ἡ Πανάκεια δὲ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2731.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2731.1.text#κατεπέτασ' αὐτοῦ τὴν κεφαλὴν φοινικίδι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2732.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2732.1.text#καὶ πᾶν τὸ πρόσωπον· εἶθ' ὁ θεὸς ἐπόππυσεν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2733.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2733.1.text#ἐξῃξάτην οὖν δύο δράκοντ' ἐκ τοῦ νεὼ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2734.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2734.1.text#ὑπερφυεῖς τὸ μέγεθος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2734.2.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2734.2.text#ὦ φίλοι θεοί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2735.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2735.1.text#τούτω δ' ὑπὸ τὴν φοινικίδ' ὑποδύνθ' ἡσυχῇ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2736.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2736.1.text#τὰ βλέφαρα περιέλειχον, ὥς γ' ἐμοὶ δοκεῖ·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2737.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2737.1.text#καὶ πρίν σε κοτύλας ἐκπιεῖν οἴνου δέκα,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2738.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2738.1.text#ὁ Πλοῦτος ὦ δέσποιν' ἀνειστήκει βλέπων·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2739.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2739.1.text#ἐγὼ δὲ τὼ χεῖρ' ἀνεκρότησ' ὑφ' ἡδονῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2740.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2740.1.text#τὸν δεσπότην τ' ἤγειρον. ὁ θεὸς δ' εὐθέως
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2741.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2741.1.text#ἠφάνισεν αὑτὸν οἵ τ' ὄφεις ἐς τὸν νεών.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2742.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2742.1.text#οἱ δ' ἐγκατακείμενοι παρ' αὐτῷ πῶς δοκεῖς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2743.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2743.1.text#τὸν Πλοῦτον ἠσπάζοντο καὶ τὴν νύχθ' ὅλην
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2744.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2744.1.text#ἐγρηγόρεσαν, ἕως διέλαμψεν ἡμέρα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2745.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2745.1.text#ἐγὼ δ' ἐπῄνουν τὸν θεὸν πάνυ σφόδρα,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2746.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2746.1.text#ὅτι βλέπειν ἐποίησε τὸν Πλοῦτον ταχύ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2747.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2747.1.text#τὸν δὲ Νεοκλείδην μᾶλλον ἐποίησεν τυφλόν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2748.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2748.1.text#ὅσην ἔχεις τὴν δύναμιν ὦναξ δέσποτα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2749.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2749.1.text#ἀτὰρ φράσον μοι, ποῦ' σθ' ὁ Πλοῦτος;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2749.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2749.2.text#ἔρχεται.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2750.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2750.1.text#ἀλλ' ἦν περὶ αὐτὸν ὄχλος ὑπερφυὴς ὅσος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2751.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2751.1.text#οἱ γὰρ δίκαιοι πρότερον ὄντες καὶ βίον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2752.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2752.1.text#ἔχοντες ὀλίγον αὐτὸν ἠσπάζοντο καὶ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2753.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2753.1.text#ἐδεξιοῦνθ' ἅπαντες ὑπὸ τῆς ἡδονῆς·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2754.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2754.1.text#ὅσοι δ' ἐπλούτουν οὐσίαν τ' εἶχον συχνὴν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2755.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2755.1.text#οὐκ ἐκ δικαίου τὸν βίον κεκτημένοι,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2756.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2756.1.text#ὀφρῦς ξυνῆγον ἐσκυθρώπαζόν θ' ἅμα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2757.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2757.1.text#οἱ δ' ἠκολούθουν κατόπιν ἐστεφανωμένοι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2758.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2758.1.text#γελῶντες εὐφημοῦντες· ἐκτυπεῖτο δὲ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2759.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2759.1.text#ἐμβὰς γερόντων εὐρύθμοις προβήμασιν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2760.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2760.1.text#ἀλλ' εἶ' ἁπαξάπαντες ἐξ ἑνὸς λόγου
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2761.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2761.1.text#ὀρχεῖσθε καὶ σκιρτᾶτε καὶ χορεύετε·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2762.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2762.1.text#οὐδεὶς γὰρ ὑμῖν εἰσιοῦσιν ἀγγελεῖ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2763.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2763.1.text#ὡς ἄλφιτ' οὐκ ἔνεστιν ἐν τῷ θυλάκῳ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2764.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2764.1.text#νὴ τὴν Ἑκάτην κἀγὼ δ' ἀναδῆσαι βούλομαι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2765.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2765.1.text#εὐαγγέλιά σε κριβανωτῶν ὁρμαθῷ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2766.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2766.1.text#τοιαῦτ' ἀπαγγείλαντα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2766.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2766.2.text#μή νυν μέλλ' ἔτι,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2767.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2767.1.text#ὡς ἅνδρες ἐγγύς εἰσιν ἤδη τῶν θυρῶν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2768.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2768.1.text#φέρε νυν ἰοῦσ' εἴσω κομίσω καταχύσματα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2769.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2769.1.text#ὥσπερ νεωνήτοισιν ὀφθαλμοῖς ἐγώ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2770.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2770.1.text#ἐγὼ δ' ἀπαντῆσαί γ' ἐκείνοις βούλομαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2771.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2771.1.text#καὶ προσκυνῶ γε πρῶτα μὲν τὸν ἥλιον,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2772.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2772.1.text#ἔπειτα σεμνῆς Παλλάδος κλεινὸν πέδον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2773.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2773.1.text#χώραν τε πᾶσαν Κέκροπος ἥ μ' ἐδέξατο.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2774.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2774.1.text#αἰσχύνομαι δὲ τὰς ἐμαυτοῦ συμφοράς,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2775.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2775.1.text#οἵοις ἄρ' ἀνθρώποις ξυνὼν ἐλάνθανον,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2776.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2776.1.text#τοὺς ἀξίους δὲ τῆς ἐμῆς ὁμιλίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2777.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2777.1.text#ἔφευγον, εἰδὼς οὐδέν· ὦ τλήμων ἐγώ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2778.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2778.1.text#ὡς οὔτ' ἐκεῖν' ἄρ' οὔτε ταῦτ' ὀρθῶς ἔδρων·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2779.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2779.1.text#ἀλλ' αὐτὰ πάντα πάλιν ἀναστρέψας ἐγὼ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2780.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2780.1.text#δείξω τὸ λοιπὸν πᾶσιν ἀνθρώποις ὅτι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2781.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2781.1.text#ἄκων ἐμαυτὸν τοῖς πονηροῖς ἐπεδίδουν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2782.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2782.1.text#βάλλ' ἐς κόρακας· ὡς χαλεπόν εἰσιν οἱ φίλοι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2783.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2783.1.text#οἱ φαινόμενοι παραχρῆμ' ὅταν πράττῃ τις εὖ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2784.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2784.1.text#νύττουσι γὰρ καὶ φλῶσι τἀντικνήμια,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2785.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2785.1.text#ἐνδεικνύμενος ἔκαστος εὔνοιάν τινα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2786.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2786.1.text#ἐμὲ γὰρ τίς οὐ προσεῖπε; ποῖος οὐκ ὄχλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2787.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2787.1.text#περιεστεφάνωσεν ἐν ἀγορᾷ πρεσβυτικός;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2788.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2788.1.text#ὦ φίλτατ' ἀνδρῶν καὶ σὺ καὶ σὺ χαίρετε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2789.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2789.1.text#φέρε νυν, νόμος γάρ ἐστι, τὰ καταχύσματα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2790.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2790.1.text#ταυτὶ καταχέω σου λαβοῦσα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2790.2.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2790.2.text#μηδαμῶς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2791.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2791.1.text#ἐμοῦ γὰρ εἰσιόντος ἐς τὴν οἰκίαν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2792.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2792.1.text#πρώτιστα καὶ βλέψαντος οὐδὲν ἐκφέρειν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2793.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2793.1.text#πρεπῶδές ἐστιν, ἀλλὰ μᾶλλον ἐσφέρειν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2794.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2794.1.text#εἶτ' οὐχὶ δέξει δῆτα τὰ καταχύσματα;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2795.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2795.1.text#ἔνδον γε παρὰ τὴν ἑστίαν, ὥσπερ νόμος·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2796.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2796.1.text#ἔπειτα καὶ τὸν φόρτον ἐκφύγοιμεν ἄν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2797.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2797.1.text#οὐ γὰρ πρεπῶδές ἐστι τῷ διδασκάλῳ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2798.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2798.1.text#ἰσχάδια καὶ τρωγάλια τοῖς θεωμένοις
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2799.1.speaker#Πλοῦτος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2799.1.text#προβαλόντ' ἐπὶ τούτοις εἶτ' ἀναγκάζειν γελᾶν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2800.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2800.1.text#εὖ πάνυ λέγεις· ὡς Δεξίνικός γ' οὑτοσὶ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2801.1.speaker#Γυνή
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2801.1.text#ἀνίσταθ' ὡς ἁρπασόμενος τὰς ἰσχάδας.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2802.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2802.1.text#ὡς ἡδὺ πράττειν ὦνδρές ἐστ' εὐδαιμόνως,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2803.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2803.1.text#καὶ ταῦτα μηδὲν ἐξενεγκόντ' οἴκοθεν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2804.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2804.1.text#ἡμῖν γὰρ ἀγαθῶν σωρὸς ἐς τὴν οἰκίαν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2805.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2805.1.text#ἐπεσπέπαικεν οὐδὲν ἠδικηκόσιν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2805a.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2805a.1.text#[ οὕτω τὸ πλουτεῖν ἐστιν ἡδὺ πρᾶγμα δή. ]
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2806.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2806.1.text#ἡ μὲν σιπύη μεστή 'στι λευκῶν ἀλφίτων,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2807.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2807.1.text#οἱ δ' ἀμφορῆς οἴνου μέλανος ἀνθοσμίου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2808.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2808.1.text#ἅπαντα δ' ἡμῖν ἀργυρίου καὶ χρυσίου
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2809.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2809.1.text#τὰ σκευάρια πλήρη 'στίν, ὥστε θαυμάσαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2810.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2810.1.text#τὸ φρέαρ δ' ἐλαίου μεστόν· αἱ δὲ λήκυθοι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2811.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2811.1.text#μύρου γέμουσι, τὸ δ' ὑπερῷον ἰσχάδων.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2812.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2812.1.text#ὀξὶς δὲ πᾶσα καὶ λοπάδιον καὶ χύτρα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2813.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2813.1.text#χαλκῆ γέγονε· τοὺς δὲ πινακίσκους τοὺς σαπροὺς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2814.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2814.1.text#τοὺς ἰχθυηροὺς ἀργυροῦς πάρεσθ' ὁρᾶν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2815.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2815.1.text#ὁ δ' ἰπνὸς γέγον' ἡμῖν ἐξαπίνης ἐλεφάντινος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2816.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2816.1.text#στατῆρσι δ' οἱ θεράποντες ἀρτιάζομεν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2817.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2817.1.text#χρυσοῖς· ἀποψώμεσθα δ' οὐ λίθοις ἔτι,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2818.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2818.1.text#ἀλλὰ σκοροδίοις ὑπὸ τρυφῆς ἑκάστοτε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2819.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2819.1.text#καὶ νῦν ὁ δεσπότης μὲν ἔνδον βουθυτεῖ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2820.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2820.1.text#ὗν καὶ τράγον καὶ κριὸν ἐστεφανωμένος·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2821.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2821.1.text#ἐμὲ δ' ἐξέπεμψεν ὁ καπνός. οὐχ οἷός τε γὰρ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2822.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2822.1.text#ἔνδον μένειν ἦν. ἔδακνε γὰρ τὰ βλέφαρά μου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2823.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2823.1.text#ἕπου μετ' ἐμοῦ παιδάριον, ἵνα πρὸς τὸν θεὸν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2824.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2824.1.text#ἴωμεν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2824.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2824.2.text#ἔα τίς ἔσθ' ὁ προσιὼν οὑτοσί;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2825.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2825.1.text#ἀνὴρ πρότερον μὲν ἄθλιος, νῦν δ' εὐτυχής.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2826.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2826.1.text#δῆλον ὅτι τῶν χρηστῶν τις, ὡς ἔοικας, εἶ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2827.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2827.1.text#μάλιστ'.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2827.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2827.2.text#ἔπειτα τοῦ δέει;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2827.3.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2827.3.text#πρὸς τὸν θεὸν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2828.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2828.1.text#ἥκω· μεγάλων γάρ μοὐστὶν ἀγαθῶν αἴτιος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2829.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2829.1.text#ἐγὼ γὰρ ἱκανὴν οὐσίαν παρὰ τοῦ πατρὸς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2830.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2830.1.text#λαβὼν ἐπήρκουν τοῖς δεομένοις τῶν φίλων,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2831.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2831.1.text#εἶναι νομίζων χρήσιμον πρὸς τὸν βίον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2832.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2832.1.text#ἦ πού σε ταχέως ἐπέλιπεν τὰ χρήματα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2833.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2833.1.text#κομιδῇ μὲν οὖν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2833.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2833.2.text#οὐκοῦν μετὰ ταῦτ' ἦσθ' ἄθλιος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2834.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2834.1.text#κομιδῇ μὲν οὖν. κἀγὼ μὲν ᾤμην οὓς τέως
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2835.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2835.1.text#εὐηργέτησα δεομένους ἕξειν φίλους
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2836.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2836.1.text#ὄντως βεβαίους, εἰ δεηθείην ποτέ·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2837.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2837.1.text#οἱ δ' ἐξετρέποντο κοὐκ ἐδόκουν ὁρᾶν μ' ἔτι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2838.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2838.1.text#καὶ κατεγέλων δ' εὖ οἶδ' ὅτι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2838.2.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2838.2.text#κομιδῇ μὲν οὖν·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2839.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2839.1.text#αὐχμὸς γὰρ ὢν τῶν σκευαρίων μ' ἀπώλεσεν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2840.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2840.1.text#ἀλλ' οὐχὶ νῦν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2840.2.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2840.2.text#ἀνθ' ὧν ἐγὼ πρὸς τὸν θεὸν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2841.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2841.1.text#προσευξόμενος ἥκω δικαίως ἐνθάδε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2842.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2842.1.text#τὸ τριβώνιον δὲ τί δύναται πρὸς τῶν θεῶν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2843.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2843.1.text#ὃ φέρει μετὰ σοῦ τὸ παιδάριον τουτί; φράσον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2844.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2844.1.text#καὶ τοῦτ' ἀναθήσων ἔρχομαι πρὸς τὸν θεόν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2845.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2845.1.text#μῶν οὖν ἐμυήθης δῆτ' ἐν αὐτῷ τὰ μεγάλα;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2846.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2846.1.text#οὐκ ἀλλ' ἐνερρίγωσ' ἔτη τριακαίδεκα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2847.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2847.1.text#τὰ δ' ἐμβάδια;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2847.2.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2847.2.text#καὶ ταῦτα συνεχειμάζετο.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2848.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2848.1.text#καὶ ταῦτ' ἀναθήσων ἔφερες οὖν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2848.2.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2848.2.text#νὴ τὸν Δία.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2849.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2849.1.text#χαρίεντά γ' ἥκεις δῶρα τῷ θεῷ φέρων.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2850.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2850.1.text#οἴμοι κακοδαίμων, ὡς ἀπόλωλα δείλαιος,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2851.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2851.1.text#καὶ κακοδαίμων καὶ τετράκις καὶ πεντάκις
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2852.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2852.1.text#καὶ δωδεκάκις καὶ μυριάκις· ἰοὺ ἰού.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2853.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2853.1.text#οὕτω πολυφόρῳ συγκέκραμαι δαίμονι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2854.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2854.1.text#Ἄπολλον ἀποτρόπαιε καὶ θεοὶ φίλοι,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2855.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2855.1.text#τί ποτ' ἐστὶν ὅ τι πέπονθεν ἅνθρωπος κακόν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2856.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2856.1.text#οὐ γὰρ σχέτλια πέπονθα νυνὶ πράγματα,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2857.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2857.1.text#ἀπολωλεκὼς ἅπαντα τἀκ τῆς οἰκίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2858.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2858.1.text#διὰ τὸν θεὸν τοῦτον, τὸν ἐσόμενον τυφλὸν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2859.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2859.1.text#πάλιν αὖθις, ἤνπερ μὴ 'λλίπωσιν αἱ δίκαι;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2860.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2860.1.text#ἐγὼ σχεδὸν τὸ πρᾶγμα γιγνώσκειν δοκῶ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2861.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2861.1.text#προσέρχεται γάρ τις κακῶς πράττων ἀνήρ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2862.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2862.1.text#ἔοικε δ' εἶναι τοῦ πονηροῦ κόμματος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2863.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2863.1.text#νὴ Δία καλῶς τοίνυν ποιῶν ἀπόλλυται.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2864.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2864.1.text#ποῦ ποῦ 'σθ' ὁ μόνος ἅπαντας ἡμᾶς πλουσίους
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2865.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2865.1.text#ὑποσχόμενος οὗτος ποιήσειν εὐθέως,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2866.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2866.1.text#εἰ πάλιν ἀναβλέψειεν ἐξ ἀρχῆς; ὁ δὲ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2867.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2867.1.text#πολὺ μᾶλλον ἐνίους ἐστὶν ἐξολωλεκώς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2868.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2868.1.text#καὶ τίνα δέδρακε δῆτα τοῦτ';
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2868.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2868.2.text#ἐμὲ τουτονί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2869.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2869.1.text#ἦ τῶν πονηρῶν ἦσθα καὶ τοιχωρύχων;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2870.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2870.1.text#μὰ Δί' οὐ μὲν οὖν ἔσθ' ὑγιὲς ὑμῶν οὐδενός,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2871.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2871.1.text#κοὐκ ἔσθ' ὅπως οὐκ ἔχετέ μου τὰ χρήματα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2872.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2872.1.text#ὡς σοβαρὸς ὦ Δάματερ εἰσελήλυθεν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2873.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2873.1.text#ὁ συκοφάντης. δῆλον ὅτι βουλιμιᾷ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2874.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2874.1.text#σὺ μὲν εἰς ἀγορὰν ἰὼν ταχέως οὐκ ἂν φθάνοις·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2875.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2875.1.text#ἐπὶ τοῦ τροχοῦ γὰρ δεῖ σ' ἐκεῖ στρεβλούμενον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2876.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2876.1.text#εἰπεῖν ἃ πεπανούργηκας.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2876.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2876.2.text#οἰμώξἄρα σύ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2877.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2877.1.text#νὴ τὸν Δία τὸν σωτῆρα πολλοῦ γ' ἄξιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2878.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2878.1.text#ἅπασι τοῖς Ἕλλησιν ὁ θεός ἐσθ' ὅτι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2879.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2879.1.text#τοὺς συκοφάντας ἐξολεῖ κακοὺς κακῶς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2880.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2880.1.text#οἴμοι τάλας· μῶν καὶ σὺ μετέχων καταγελᾷς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2881.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2881.1.text#ἐπεὶ πόθεν θοἰμάτιον εἴληφας τοδί;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2882.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2882.1.text#ἐχθὲς δ' ἔχοντ' εἶδόν σ' ἐγὼ τριβώνιον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2883.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2883.1.text#οὐδὲν προτιμῶ σου. φορῶ γὰρ πριάμενος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2884.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2884.1.text#τὸν δακτύλιον τονδὶ παρ' Εὐδάμου δραχμῆς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2885.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2885.1.text#† ἀλλ' οὐκ ἔνεστι συκοφάντου δήγματος.†
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2886.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2886.1.text#ἆρ' οὐχ ὕβρις ταῦτ' ἐστὶ πολλή; σκώπτετον,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2887.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2887.1.text#ὅ τι δὲ ποιεῖτον ἐνθάδ' οὐκ εἰρήκατον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2888.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2888.1.text#οὐκ ἐπ' ἀγαθῷ γὰρ ἐνθάδ' ἐστὸν οὐδενί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2889.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2889.1.text#μὰ τὸν Δί' οὔκουν τῷ γε σῷ, σάφ' ἴσθ' ὅτι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2890.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2890.1.text#ἀπὸ τῶν ἐμῶν γὰρ ναὶ μὰ Δία δειπνήσετον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2891.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2891.1.text#ὡς δὴ 'π' ἀληθείᾳ σὺ μετὰ τοῦ μάρτυρος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2892.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2892.1.text#διαρραγείης μηδενός γ' ἐμπλήμενος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2893.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2893.1.text#ἀρνεῖσθον; ἔνδον ἐστὶν ὦ μιαρωτάτω
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2894.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2894.1.text#πολὺ χρῆμα τεμαχῶν καὶ κρεῶν ὠπτημένων.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2895.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2895.1.text#ὓ ὗ ὓ ὗ ὓ ὗ ὓ ὗ ὓ ὗ ὓ ὗ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2896.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2896.1.text#κακόδαιμον ὀσφραίνει τι;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2896.2.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2896.2.text#τοῦ ψύχους γ' ἴσως
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2897.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2897.1.text#ἐπεὶ τοιοῦτόν γ' ἀμπέχεται τριβώνιον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2898.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2898.1.text#ταῦτ' οὖν ἀνασχέτ' ἐστὶν ὦ Ζεῦ καὶ θεοί,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2899.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2899.1.text#τούτους ὑβρίζειν εἰς ἔμ'; οἴμ' ὡς ἄχθομαι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2900.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2900.1.text#ὅτι χρηστὸς ὢν καὶ φιλόπολις πάσχω κακῶς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2901.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2901.1.text#σὺ φιλόπολις καὶ χρηστός;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2901.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2901.2.text#ὡς οὐδείς γ' ἀνήρ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2902.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2902.1.text#καὶ μὴν ἐπερωτηθεὶς ἀπόκριναί μοι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2902.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2902.2.text#τὸ τί;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2903.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2903.1.text#γεωργὸς εἶ;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2903.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2903.2.text#μελαγχολᾶν μ' οὕτως οἴει;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2904.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2904.1.text#ἀλλ' ἔμπορος;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2904.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2904.2.text#ναί, σκήπτομαί γ', ὅταν τύχω.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2905.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2905.1.text#τί δαί; τέχνην τιν' ἔμαθες;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2905.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2905.2.text#οὐ μὰ τὸν Δία.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2906.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2906.1.text#πῶς οὖν διέζης ἢ πόθεν μηδὲν ποιῶν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2907.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2907.1.text#τῶν τῆς πόλεώς εἰμ' ἐπιμελητὴς πραγμάτων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2908.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2908.1.text#καὶ τῶν ἰδίων πάντων.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2908.2.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2908.2.text#σύ; τί μαθών;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2908.3.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2908.3.text#βούλομαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2909.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2909.1.text#πῶς οὖν ἂν εἴης χρηστὸς ὦ τοιχωρύχε,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2910.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2910.1.text#εἴ σοι προσῆκον μηδὲν εἶτ' ἀπεχθάνει;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2911.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2911.1.text#οὐ γὰρ προσήκει τὴν ἐμαυτοῦ μοι πόλιν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2912.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2912.1.text#εὐεργετεῖν ὦ κέπφε καθ' ὅσον ἂν σθένω;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2913.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2913.1.text#εὐεργετεῖν οὖν ἐστι τὸ πολυπραγμονεῖν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2914.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2914.1.text#τὸ μὲν οὖν βοηθεῖν τοῖς νόμοις τοῖς κειμένοις
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2915.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2915.1.text#καὶ μὴ 'πιτρέπειν ἐάν τις ἐξαμαρτάνῃ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2916.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2916.1.text#οὔκουν δικαστὰς ἐξεπίτηδες ἡ πόλις
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2917.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2917.1.text#ἄρχειν καθίστησιν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2917.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2917.2.text#κατηγορεῖ δὲ τίς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2918.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2918.1.text#ὁ βουλόμενος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2918.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2918.2.text#οὐκοῦν ἐκεῖνός εἰμ' ἐγώ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2919.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2919.1.text#ὥστ' εἰς ἔμ' ἥκει τῆς πόλεως τὰ πράγματα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2920.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2920.1.text#νὴ Δία πονηρόν γ' ἆρα προστάτην ἔχει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2921.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2921.1.text#ἐκεῖνο δ' οὐ βούλοι' ἄν, ἡσυχίαν ἔχων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2922.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2922.1.text#ζῆν ἀργός;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2922.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2922.2.text#ἀλλὰ προβατίου βίον λέγεις,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2923.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2923.1.text#εἰ μὴ φανεῖται διατριβή τις τῷ βίῳ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2924.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2924.1.text#οὐδ' ἂν μεταμάθοις;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2924.2.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2924.2.text#οὐδ' ἂν εἰ δοίης γέ μοι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2925.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2925.1.text#τὸν Πλοῦτον αὐτὸν καὶ τὸ Βάττου σίλφιον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2926.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2926.1.text#κατάθου ταχέως θοἰμάτιον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2926.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2926.2.text#οὗτος, σοὶ λέγει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2927.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2927.1.text#ἔπειθ' ὑπόλυσαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2927.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2927.2.text#ταῦτα πάντα σοὶ λέγει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2928.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2928.1.text#καὶ μὴν προσελθέτω πρὸς ἔμ' ὑμῶν ἐνθαδὶ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2929.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2929.1.text#ὁ βουλόμενος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2929.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2929.2.text#οὐκοῦν ἐκεῖνός εἰμ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2930.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2930.1.text#οἴμοι τάλας ἀποδύομαι μεθ' ἡμέραν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2931.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2931.1.text#σὺ γὰρ ἀξιοῖς τἀλλότρια πράττων ἐσθίειν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2932.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2932.1.text#ὁρᾷς ἃ ποιεῖς; ταῦτ' ἐγὼ μαρτύρομαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2933.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2933.1.text#ἀλλ' οἴχεται φεύγων ὃν ἦγες μάρτυρα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2934.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2934.1.text#οἴμοι περιείλημμαι μόνος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2934.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2934.2.text#νυνὶ βοᾷς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2935.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2935.1.text#οἴμοι μάλ' αὖθις.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2935.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2935.2.text#δὸς σύ μοι τὸ τριβώνιον,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2936.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2936.1.text#ἵν' ἀμφιέσω τὸν συκοφάντην τουτονί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2937.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2937.1.text#μὴ δῆθ'· ἱερὸν γάρ ἐστι τοῦ Πλούτου πάλαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2938.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2938.1.text#ἔπειτα ποῦ κάλλιον ἀνατεθήσεται
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2939.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2939.1.text#ἢ περὶ πονηρὸν ἄνδρα καὶ τοιχωρύχον;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2940.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2940.1.text#Πλοῦτον δὲ κοσμεῖν ἱματίοις σεμνοῖς πρέπει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2941.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2941.1.text#τοῖς δ' ἐμβαδίοις τί χρήσεταί τις; εἰπέ μοι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2942.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2942.1.text#καὶ ταῦτα πρὸς τὸ μέτωπον αὐτίκα δὴ μάλα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2943.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2943.1.text#ὥσπερ κοτίνῳ προσπατταλεύσω τουτῳί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2944.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2944.1.text#ἄπειμι· γιγνώσκω γὰρ ἥττων ὢν πολὺ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2945.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2945.1.text#ὑμῶν· ἐὰν δὲ σύζυγον λάβω τινὰ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2946.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2946.1.text#καὶ σύκινον, τοῦτον τὸν ἰσχυρὸν θεὸν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2947.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2947.1.text#ἐγὼ ποιήσω τήμερον δοῦναι δίκην,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2948.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2948.1.text#ὁτιὴ καταλύει περιφανῶς εἶς ὢν μόνος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2949.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2949.1.text#τὴν δημοκρατίαν, οὔτε τὴν βουλὴν πιθὼν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2950.1.speaker#Συκοφάντης
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2950.1.text#τὴν τῶν πολιτῶν οὔτε τὴν ἐκκλησίαν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2951.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2951.1.text#καὶ μὴν ἐπειδὴ τὴν πανοπλίαν τὴν ἐμὴν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2952.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2952.1.text#ἔχων βαδίζεις, ἐς τὸ βαλανεῖον τρέχε·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2953.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2953.1.text#ἔπειτ' ἐκεῖ κορυφαῖος ἑστηκὼς θέρου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2954.1.speaker#Δίκαιος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2954.1.text#κἀγὼ γὰρ εἶχον τὴν στάσιν ταύτην ποτέ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2955.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2955.1.text#ἀλλ' ὁ βαλανεὺς ἕλξει θύραζ' αὐτὸν λαβὼν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2956.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2956.1.text#τῶν ὀρχιπέδων· ἰδὼν γὰρ αὐτὸν γνώσεται
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2957.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2957.1.text#ὅτι ἔστ' ἐκείνου τοῦ πονηροῦ κόμματος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2958.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2958.1.text#νὼ δ' εἰσίωμεν, ἵνα προσεύξῃ τὸν θεόν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2959.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2959.1.text#ἆρ' ὦ φίλοι γέροντες ἐπὶ τὴν οἰκίαν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2960.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2960.1.text#ἀφίγμεθ' ὄντως τοῦ νέου τούτου θεοῦ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2961.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2961.1.text#ἢ τῆς ὁδοῦ τὸ παράπαν ἡμαρτήκαμεν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2962.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2962.1.text#ἀλλ' ἴσθ' ἐπ' αὐτὰς τὰς θύρας ἀφιγμένη
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2963.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2963.1.text#ὦ μειρακίσκη· πυνθάνει γὰρ ὡρικῶς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2964.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2964.1.text#φέρε νυν ἐγὼ τῶν ἔνδοθεν καλέσω τινά.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2965.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2965.1.text#μὴ δῆτ'· ἐγὼ γὰρ αὐτὸς ἐξελήλυθα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2966.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2966.1.text#ἀλλ' ὅ τι μάλιστ' ἐλήλυθας λέγειν σ' ἐχρῆν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2967.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2967.1.text#πέπονθα δεινὰ καὶ παράνομ' ὦ φίλτατε·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2968.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2968.1.text#ἀφ' οὗ γὰρ ὁ θεὸς οὗτος ἤρξατο βλέπειν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2969.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2969.1.text#ἀβίωτον εἶναί μοι πεποίηκε τὸν βίον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2970.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2970.1.text#τί δ' ἔστιν; ἦ που καὶ σὺ συκοφάντρια
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2971.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2971.1.text#εν ταῖς γυναιξὶν ἦσθα;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2971.2.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2971.2.text#μὰ Δί' ἐγὼ μὲν οὔ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2972.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2972.1.text#ἀλλ' οὐ λαχοῦσ' ἔπινες ἐν τῷ γράμματι;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2973.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2973.1.text#σκώπτεις· ἐγὼ δὲ κατακέκνισμαι δειλάκρα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2974.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2974.1.text#οὔκουν ἐρεῖς ἀνύσασα τὸν κνισμὸν τίνα;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2975.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2975.1.text#ἄκουέ νυν. ἦν μοί τι μειράκιον φίλον,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2976.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2976.1.text#πενιχρὸν μέν, ἄλλως δ' εὐπρόσωπον καὶ καλὸν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2977.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2977.1.text#καὶ χρηστόν· εἰ γάρ του δεηθείην ἐγώ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2978.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2978.1.text#ἅπαντ' ἐποίει κοσμίως μοι καὶ καλῶς·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2979.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2979.1.text#ἐγὼ δ' ἐκείνῳ πάντα ταῦθ' ὑπηρέτουν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2980.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2980.1.text#τί δ' ἦν ὅ τι σου μάλιστ' ἐδεῖθ' ἑκάστοτε;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2981.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2981.1.text#οὐ πολλά· καὶ γὰρ ἐκνομίως μ' ᾐσχύνετο.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2982.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2982.1.text#ἀλλ' ἀργυρίου δραχμὰς ἂν ᾔτησ' εἴκοσιν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2983.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2983.1.text#εἰς ἱμάτιον, ὀκτὼ δ' ἂν εἰς ὑποδήματα·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2984.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2984.1.text#καὶ ταῖς ἀδελφαῖς ἀγοράσαι χιτώνιον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2985.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2985.1.text#ἐκέλευσεν ἂν τῇ μητρί θ' ἱματίδιον·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2986.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2986.1.text#πυρῶν τ' ἂν ἐδεήθη μεδίμνων τεττάρων.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2987.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2987.1.text#οὐ πολλὰ τοίνυν μὰ τὸν Ἀπόλλω ταῦτά γε
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2988.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2988.1.text#εἴρηκας, ἀλλὰ δῆλον ὅτι σ' ᾐσχύνετο.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2989.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2989.1.text#καὶ ταῦτα τοίνυν οὐχ ἕνεκα μισητίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2990.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2990.1.text#αἰτεῖν μ' ἔφασκεν, ἀλλὰ φιλίας οὕνεκα,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2991.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2991.1.text#ἵνα τοὐμὸν ἱμάτιον φορῶν μεμνῇτό μου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2992.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2992.1.text#λέγεις ἐρῶντ' ἄνθρωπον ἐκνομιώτατα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2993.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2993.1.text#ἀλλ' οὐχὶ νῦν ὁ βδελυρὸς ἔτι τὸν νοῦν ἔχει
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2994.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2994.1.text#τὸν αὐτόν, ἀλλὰ πολὺ μεθέστηκεν πάνυ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2995.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2995.1.text#ἐμοῦ γὰρ αὐτῷ τὸν πλακοῦντα τουτονὶ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2996.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2996.1.text#καὶ τἄλλα τἀπὶ τοῦ πίνακος τραγήματα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2997.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2997.1.text#ἐπόντα πεμψάσης ὑπειπούσης θ' ὅτι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2998.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2998.1.text#εἰς ἑσπέραν ἥξοιμι—
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2998.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2998.2.text#τί σ' ἔδρασ'; εἰπέ μοι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2999.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc2999.1.text#ἄμητα προσαπέπεμψεν ἡμῖν τουτονί,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21000.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21000.1.text#ἐφ' ᾧ τ' ἐκεῖσε μηδέποτέ μ' ἐλθεῖν ἔτι,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21001.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21001.1.text#καὶ πρὸς ἐπὶ τούτοις εἶπεν ἀποπέμπων ὅτι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21002.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21002.1.text# " πάλαι ποτ' ἦσαν ἄλκιμοι Μιλήσιοι."
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21003.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21003.1.text#δῆλον ὅτι τοὺς τρόπους τις οὐ μοχθηρὸς ἦν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21004.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21004.1.text#ἔπειτα πλουτῶν οὐκέθ' ἥδεται φακῇ·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21005.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21005.1.text#πρὸ τοῦ δ' ὑπὸ τῆς πενίας ἅπανθ' ὑπήσθιεν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21006.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21006.1.text#καὶ μὴν πρὸ τοῦ γ' ὁσημέραι νὴ τὼ θεὼ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21007.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21007.1.text#ἐπὶ τὴν θύραν ἐβάδιζεν ἀεὶ τὴν ἐμήν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21008.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21008.1.text#ἐπ' ἐκφοράν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21008.2.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21008.2.text#μὰ Δί' ἀλλὰ τῆς φωνῆς μόνον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21009.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21009.1.text#ἐρῶν ἀκοῦσαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21009.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21009.2.text#τοῦ λαβεῖν μὲν οὖν χάριν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21010.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21010.1.text#καὶ νὴ Δί' εἰ λυπουμένην γ' αἴσθοιτό με,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21011.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21011.1.text#νηττάριον ἂν καὶ φάττιον ὑπεκορίζετο.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21012.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21012.1.text#ἔπειτ' ἴσως ᾔτει σ' ἂν εἰς ὑποδήματα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21013.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21013.1.text#μυστηρίοις δὲ τοῖς μεγάλοις ὀχουμένην
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21014.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21014.1.text#ἐπὶ τῆς ἁμάξης ὅτι προσέβλεψέν μέ τις,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21015.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21015.1.text#ἐτυπτόμην διὰ τοῦθ' ὅλην τὴν ἡμέραν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21016.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21016.1.text#οὕτω σφόδρα ζηλότυπος ὁ νεανίσκος ἦν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21017.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21017.1.text#μόνος γὰρ ἥδεθ', ὡς ἔοικεν, ἐσθίων.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21018.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21018.1.text#καὶ τάς γε χεῖρας παγκάλας ἔχειν μ' ἔθη.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21019.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21019.1.text#ὁπότε προτείνοιέν γε δραχμὰς εἴκοσιν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21020.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21020.1.text#ὄζειν τε τῆς χρόας ἔφασκεν ἡδύ μου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21021.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21021.1.text#εἰ Θάσιον ἐνέχεις, εἰκότως γε νὴ Δία.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21022.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21022.1.text#τὸ βλέμμα θ' ὡς ἔχοιμι μαλακὸν καὶ καλόν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21023.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21023.1.text#οὐ σκαιὸς ἦν ἄνθρωπος, ἀλλ' ἠπίστατο
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21024.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21024.1.text#γραὸς καπρώσης τἀφόδια κατεσθίειν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21025.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21025.1.text#ταῦτ' οὖν ὁ θεὸς ὦ φίλ' ἄνερ οὐκ ὀρθῶς ποιεῖ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21026.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21026.1.text#φάσκων βοηθεῖν τοῖς ἀδικουμένοις ἀεί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21027.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21027.1.text#τί γὰρ ποιήσει; φράζε, καὶ πεπράξεται.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21028.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21028.1.text#ἀναγκάσαι δίκαιόν ἐστι νὴ Δία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21029.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21029.1.text#τὸν εὖ παθόνθ' ὑπ' ἐμοῦ πάλιν μ' ἀντευποιεῖν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21030.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21030.1.text#ἢ μηδ' ὁτιοῦν ἀγαθὸν δίκαιόν ἐστ' ἔχειν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21031.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21031.1.text#οὔκουν καθ' ἑκάστην ἀπεδίδου τὴν νύκτα σοι;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21032.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21032.1.text#ἀλλ' οὐδέποτέ με ζῶσαν ἀπολείψειν ἔφη.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21033.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21033.1.text#ὀρθῶς γε· νῦν δέ γ' οὐκέτι ζῆν σ' οἴεται.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21034.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21034.1.text#ὑπὸ τοῦ γὰρ ἄλγους κατατέτηκ' ὦ φίλτατε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21035.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21035.1.text#οὐκ ἀλλὰ κατασέσηπας, ὥς γ' ἐμοὶ δοκεῖς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21036.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21036.1.text#διὰ δακτυλίου μὲν οὖν ἔμεγ' ἂν διελκύσαις.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21037.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21037.1.text#εἰ τυγχάνοι γ' ὁ δακτύλιος ὢν τηλία.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21038.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21038.1.text#καὶ μὴν τὸ μειράκιον τοδὶ προσέρχεται,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21039.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21039.1.text#οὗπερ πάλαι κατηγοροῦσα τυγχάνω·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21040.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21040.1.text#ἔοικε δ' ἐπὶ κῶμον βαδίζειν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21040.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21040.2.text#φαίνεται.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21041.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21041.1.text#στέφανόν γέ τοι καὶ δᾷδ' ἔχων πορεύεται.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21042.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21042.1.text#ἀσπάζομαί σε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21042.2.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21042.2.text#τί φησιν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21042.3.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21042.3.text#ἀρχαία φίλη,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21043.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21043.1.text#πολιὰ γεγένησαι ταχύ γε νὴ τὸν οὐρανόν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21044.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21044.1.text#τάλαιν' ἐγὼ τῆς ὕβρεος ἧς ὑβρίζομαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21045.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21045.1.text#ἔοικε διὰ πολλοῦ χρόνου σ' ἑορακέναι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21046.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21046.1.text#ποίου χρόνου ταλάνταθ', ὃς παρ' ἐμοὶ χθὲς ἦν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21047.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21047.1.text#τοὐναντίον πέπονθε τοῖς πολλοῖς ἄρα·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21048.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21048.1.text#μεθύων γάρ, ὡς ἔικεν, ὀξύτερον βλέπει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21049.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21049.1.text#οὔκ, ἀλλ' ἀκόλαστός ἐστιν ἀεὶ τοὺς τρόπους.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21050.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21050.1.text#ὦ Ποντοπόσειδον καὶ θεοὶ πρεσβυτικοί,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21051.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21051.1.text#ἐν τῷ προσώπῳ τῶν ῥυτίδων ὅσας ἔχει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21052.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21052.1.text#ἆ ἆ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21052.2.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21052.2.text#τὴν δᾷδα μή μοι πρόσφερ'.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21052.3.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21052.3.text#εὖ μέντοι λέγει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21053.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21053.1.text#ἐὰν γὰρ αὐτὴν εἷς μόνος σπινθὴρ λάβῃ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21054.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21054.1.text#ὥσπερ παλαιὰν εἰρεσιώνην καύσεται.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21055.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21055.1.text#βούλει διὰ χρόνου πρός με παῖσαι;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21055.2.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21055.2.text#ποῖ τάλαν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21056.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21056.1.text#αὐτοῦ, λαβοῦσα κάρυα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21056.2.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21056.2.text#παιδιὰν τίνα;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21057.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21057.1.text#πόσους ἔχεις ὀδόντας.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21057.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21057.2.text#ἀλλὰ γνώσομαι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21058.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21058.1.text#κἄγωγ'· ἔχει γὰρ τρεῖς ἴσως ἢ τέτταρας.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21059.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21059.1.text#ἀπότεισον· ἕνα γὰρ γόμφιον μόνον φορεῖ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21060.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21060.1.text#ταλάντατ' ἀνδρῶν οὐχ ὑγιαίνειν μοι δοκεῖς,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21061.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21061.1.text#πλυνόν με ποιῶν ἐν τοσούτοις ἀνδράσιν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21062.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21062.1.text#ὄναιο μέντἄν, εἴ τις ἐκπλύνειέ σε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21063.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21063.1.text#οὐ δῆτ', ἐπεὶ νῦν μὲν καπηλικῶς ἔχει,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21064.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21064.1.text#εἰ δ' ἐκπλυνεῖται τοῦτο τὸ ψιμύθιον,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21065.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21065.1.text#ὄψει κατάδηλα τοῦ προσώπου τὰ ῥάκη.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21066.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21066.1.text#γέρων ἀνὴρ ὢν οὐχ ὑγιαίνειν μοι δοκεῖς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21067.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21067.1.text#πειρᾷ μὲν οὖν ἴσως σε καὶ τῶν τιτθίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21068.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21068.1.text#ἐφάπτεταί σου λανθάνειν δοκῶν ἐμέ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21069.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21069.1.text#μὰ τὴν Ἀφροδίτην οὐκ ἐμοῦ γ' ὦ βδελυρὲ σύ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21070.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21070.1.text#μὰ τὴν Ἑκάτην οὐ δῆτα· μαινοίμην γὰρ ἄν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21071.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21071.1.text#ἀλλ' ὦ νεανίσκ' οὐκ ἐῶ τὴν μείρακα
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21072.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21072.1.text#μισεῖν σε ταύτην.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21072.2.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21072.2.text#ἀλλ' ἔγωγ' ὑπερφιλῶ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21073.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21073.1.text#καὶ μὴν κατηγορεῖ γέ σου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21073.2.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21073.2.text#τί κατηγορεῖ;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21074.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21074.1.text#εἶναί σ' ὑβριστήν φησι καὶ λέγειν ὅτι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21075.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21075.1.text# " πάλαι ποτ' ἦσαν ἄλκιμοι Μιλήσιοι."
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21076.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21076.1.text#ἐγὼ περὶ ταύτης οὐ μαχοῦμαί σοι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21076.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21076.2.text#τὸ τί;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21077.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21077.1.text#αἰσχυνόμενος τὴν ἡλικίαν τὴν σήν, ἐπεὶ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21078.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21078.1.text#οὐκ ἄν ποτ' ἄλλῳ τοῦτ' ἐπέτρεψ' ἐγὼ ποιεῖν·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21079.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21079.1.text#νῦν δ' ἄπιθι χαίρων συλλαβὼν τὴν μείρακα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21080.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21080.1.text#οἶδ' οἶδα τὸν νοῦν· οὐκέτ' ἀξιοῖς ἴσως
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21081.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21081.1.text#εἶναι μετ' αὐτῆς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21081.2.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21081.2.text#ὁ δ' ἐπιτρέψων ἐστὶ τίς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21082.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21082.1.text#οὐκ ἂν διαλεχθείην διεσπλεκωμένῃ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21083.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21083.1.text#ὑπὸ μυρίων ἐτῶν γε καὶ τρισχιλίων.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21084.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21084.1.text#ὅμως δ' ἐπειδὴ καὶ τὸν οἶνον ἠξίους
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21085.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21085.1.text#πίνειν, συνεκποτέ' ἐστί σοι καὶ τὴν τρύγα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21086.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21086.1.text#ἀλλ' ἔστι κομιδῇ τρὺξ παλαιὰ καὶ σαπρά.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21087.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21087.1.text#οὐκοῦν τρύγοιπος ταῦτα πάντ' ἰάσεται.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21088.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21088.1.text#ἀλλ' εἴσιθ' εἴσω· τῷ θεῷ γὰρ βούλομαι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21089.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21089.1.text#ἐλθὼν ἀναθεῖναι τοὺς στεφάνους τούσδ' οὓς ἔχω.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21090.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21090.1.text#ἐγὼ δέ γ' αὐτῷ καὶ φράσαι τι βούλομαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21091.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21091.1.text#ἐγὼ δέ γ' οὐκ εἴσειμι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21091.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21091.2.text#θάρρει, μὴ φοβοῦ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21092.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21092.1.text#οὐ γὰρ βιάσεται.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21092.2.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21092.2.text#πάνυ καλῶς τοίνυν λέγεις.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21093.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21093.1.text#ἱκανὸν γὰρ αὐτὴν πρότερον ὑπεπίττουν χρόνον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21094.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21094.1.text#βάδιζ'· ἐγὼ δέ σου κατόπιν εἰσέρχομαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21095.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21095.1.text#ὡς εὐτόνως ὦ Ζεῦ βασιλεῦ τὸ γρᾴδιον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21096.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21096.1.text#ὥσπερ λεπὰς τῷ μειρακίῳ προσείχετο.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21097.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21097.1.text#τίς ἔσθ' ὁ κόπτων τὴν θύραν; τουτὶ τί ἦν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21098.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21098.1.text#οὐδεὶς ἔοικεν· ἀλλὰ δῆτα τὸ θύριον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21099.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21099.1.text#φθεγγόμενον ἄλλως κλαυσιᾷ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21099.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21099.2.text#σέ τοι λέγω,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21100.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21100.1.text#ὁ Καρίων, ἀνάμεινον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21100.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21100.2.text#οὗτος εἰπέ μοι,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21101.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21101.1.text#σὺ τὴν θύραν ἔκοπτες οὑτωσὶ σφόδρα;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21102.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21102.1.text#μὰ Δί' ἀλλ' ἔμελλον· εἶτ' ἀνέῳξάς με φθάσας.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21103.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21103.1.text#ἀλλ' ἐκκάλει τὸν δεσπότην τρέχων ταχύ,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21104.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21104.1.text#ἒπειτα τὴν γυναῖκα καὶ τὰ παιδία,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21105.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21105.1.text#ἔπειτα τοὺς θεράποντας, εἶτα τὴν κύνα,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21106.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21106.1.text#ἔπειτα σαυτόν, εἶτα τὴν ὗν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21106.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21106.2.text#εἰπέ μοι,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21107.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21107.1.text#τί δ' ἔστιν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21107.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21107.2.text#ὁ Ζεὺς ὦ πόνηρε βούλεται
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21108.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21108.1.text#ἐς ταὐτὸν ὑμᾶς συγκυκήσας τρύβλιον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21109.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21109.1.text#ἁπαξάπαντας ἐς τὸ βάραθρον ἐμβαλεῖν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21110.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21110.1.text#ἡ γλῶττα τῷ κήρυκι τούτων τέμνεται.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21111.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21111.1.text#ἀτὰρ διὰ τί δὴ ταῦτ' ἐπιβουλεύει ποιεῖν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21112.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21112.1.text#ἡμᾶς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21112.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21112.2.text#ὁτιὴ δεινότατα πάντων πραγμάτων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21113.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21113.1.text#εἴργασθ'. ἀφ' οὗ γὰρ ἤρξατ' ἐξ ἀρχῆς βλέπειν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21114.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21114.1.text#ὁ Πλοῦτος, οὐδεὶς οὐ λιβανωτόν, οὐ δάφνην,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21115.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21115.1.text#οὐ ψαιστόν, οὐχ ἱερεῖον, οὐκ ἄλλ' οὐδὲ ἓν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21116.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21116.1.text#ἡμῖν ἔτι θύει τοῖς θεοῖς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21116.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21116.2.text#μὰ Δί' οὐδέ γε
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21117.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21117.1.text#θύσει. κακῶς γὰρ ἐπεμελεῖσθ' ἡμῶν τότε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21118.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21118.1.text#καὶ τῶν μὲν ἄλλων μοι θεῶν ἧττον μέλει,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21119.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21119.1.text#ἐγὼ δ' ἀπόλωλα κἀπιτέτριμμαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21119.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21119.2.text#σωφρονεῖς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21120.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21120.1.text#πρότερον γὰρ εἶχον μὲν παρὰ ταῖς καπηλίσιν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21121.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21121.1.text#πάντ' ἀγάθ' ἕωθεν εὐθύς, οἰνοῦτταν μέλι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21122.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21122.1.text#ἰσχάδας, ὅσ' εἰκός ἐστιν Ἑρμῆν ἐσθίειν·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21123.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21123.1.text#νυνὶ δὲ πεινῶν ἀναβάδην ἀναπαύομαι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21124.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21124.1.text#οὔκουν δικαίως, ὅστις ἐποίεις ζημίαν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21125.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21125.1.text#ἐνίοτε τοιαῦτ' ἀγάθ' ἔχων;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21125.2.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21125.2.text#οἴμοι τάλας,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21126.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21126.1.text#οἴμοι πλακοῦντος τοῦ ν' τετράδι πεπεμμένου.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21127.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21127.1.text#ποθεῖς τὸν οὐ παρόντα καὶ μάτην καλεῖς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21128.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21128.1.text#οἴμοι δὲ κωλῆς ἣν ἐγὼ κατήσθιον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21129.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21129.1.text#ἀσκωλίαζ' ἐνταῦθα πρὸς τὴν αἰθρίαν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21130.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21130.1.text#σπλάγχνων τε θερμῶν ὧν ἐγὼ κατήσθιον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21131.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21131.1.text#ὀδύνη σε περὶ τὰ σπλάγχν' ἔοικέ τι στρέφειν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21132.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21132.1.text#οἴμοι δὲ κύλικος ἴσον ἴσῳ κεκραμένης.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21133.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21133.1.text#ταύτην ἐπιπιὼν ἀποτρέχων οὐκ ἂν φθάνοις.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21134.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21134.1.text#ἆρ' ὠφελήσαις ἄν τι τὸν σαυτοῦ φίλον;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21135.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21135.1.text#εἴ του δέει γ' ὧν δυνατός εἰμί σ' ὠφελεῖν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21136.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21136.1.text#εἴ μοι πορίσας ἄρτον τιν' εὖ πεπεμμένον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21137.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21137.1.text#δοίης καταφαγεῖν καὶ κρέας νεανικὸν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21138.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21138.1.text#ὧν θύεθ' ὑμεῖς ἔνδον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21138.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21138.2.text#ἀλλ' οὐκ ἐκφορά.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21139.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21139.1.text#καὶ μὴν ὁπότε τι σκευάριον τοῦ δεσπότου
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21140.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21140.1.text#ὑφέλοι', ἐγώ σε λανθάνειν ἐποίουν ἀεί.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21141.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21141.1.text#ἐφ' ᾧ τε μετέχειν καὐτὸς ὦ τοιχωρύχε.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21142.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21142.1.text#ἧκεν γὰρ ἄν σοι ναστὸς εὖ πεπεμμένος.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21143.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21143.1.text#ἔπειτα τοῦτόν γ' αὐτὸς ἂν κατήσθιες.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21144.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21144.1.text#οὐ γὰρ μετεῖχες τὰς ἴσας πληγὰς ἐμοί,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21145.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21145.1.text#ὁπότε τι ληφθείην πανουργήσας ἐγώ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21146.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21146.1.text#μὴ μνησικακήσῃς, εἰ σὺ Φυλὴν κατέλαβες.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21147.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21147.1.text#ἀλλὰ ξύνοικον πρὸς θεῶν δέξασθέ με.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21148.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21148.1.text#ἔπειτ' ἀπολιπὼν τοὺς θεοὺς ἐνθάδε μενεῖς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21149.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21149.1.text#τὰ γὰρ παρ' ὑμῖν ἐστι βελτίω πολύ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21150.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21150.1.text#τί δέ; ταὐτομολεῖν ἀστεῖον εἶναί σοι δοκεῖ;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21151.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21151.1.text#πατρὶς γάρ ἐστι πᾶσ' ἵν' ἂν πράττῃ τις εὖ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21152.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21152.1.text#τί δῆτ' ἂν εἴης ὄφελος ἡμῖν ἐνθάδ' ὤν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21153.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21153.1.text#παρὰ τὴν θύραν στροφαῖον ἱδρύσασθέ με.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21154.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21154.1.text#στροφαῖον; ἀλλ' οὐκ ἔργον ἔστ' οὐδὲν στροφῶν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21155.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21155.1.text#ἀλλ' ἐμπολαῖον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21155.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21155.2.text#ἀλλὰ πλουτοῦμεν· τί οὖν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21156.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21156.1.text#Ἑρμῆν παλιγκάπηλον ἡμᾶς δεῖ τρέφειν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21157.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21157.1.text#ἀλλὰ δόλιον τοίνυν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21157.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21157.2.text#δόλιον; ἥκιστά γε·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21158.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21158.1.text#οὐ γὰρ δόλου νῦν ἔργον, ἀλλ' ἁπλῶν τρόπων.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21159.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21159.1.text#ἀλλ' ἡγεμόνιον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21159.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21159.2.text#ἀλλ' ὁ θεὸς ἤδη βλέπει,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21160.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21160.1.text#ὥσθ' ἡγεμόνος οὐδὲν δεησόμεσθ' ἔτι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21161.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21161.1.text#ἐναγώνιος τοίνυν ἔσομαι. τί δῆτ' ἐρεῖς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21162.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21162.1.text#Πλούτῳ γάρ ἐστι τοῦτο συμφορώτατον
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21163.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21163.1.text#ποιεῖν ἀγῶνας μουσικοὺς καὶ γυμνικούς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21164.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21164.1.text#ὡς ἀγαθόν ἐστ' ἐπωνυμίας πολλὰς ἔχειν·
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21165.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21165.1.text#οὗτος γὰρ ἐξηύρηκεν αὑτῷ βιότιον.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21166.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21166.1.text#οὐκ ἐτὸς ἅπαντες οἱ δικάζοντες θαμὰ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21167.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21167.1.text#σπεύδουσιν ἐν πολλοῖς γεγράφθαι γράμμασιν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21168.1.speaker#Ἑρμῆς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21168.1.text#οὐκοῦν ἐπὶ τούτοις εἰσίω;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21168.2.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21168.2.text#καὶ πλῦνέ γε
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21169.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21169.1.text#αὐτὸς προσελθὼν πρὸς τὸ φρέαρ τὰς κοιλίας,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21170.1.speaker#Καρίων
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21170.1.text#ἵν' εὐθέως διακονικὸς εἶναι δοκῇς.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21171.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21171.1.text#τίς ἂν φράσειε ποῦ 'στι Χρεμύλος μοι σαφῶς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21172.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21172.1.text#τί δ' ἔστιν ὦ βέλτιστε;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21172.2.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21172.2.text#τί γὰρ ἀλλ' ἢ κακῶς;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21173.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21173.1.text#ἀφ' οὗ γὰρ ὁ Πλοῦτος οὗτος ἤρξατο βλέπειν,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21174.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21174.1.text#ἀπόλωλ' ὑπὸ λιμοῦ. καταφαγεῖν γὰρ οὐκ ἔχω,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21175.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21175.1.text#καὶ ταῦτα τοῦ σωτῆρος ἱερεὺς ὢν Διός.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21176.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21176.1.text#ἡ δ' αἰτία τίς ἐστιν ὦ πρὸς τῶν θεῶν;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21177.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21177.1.text#θύειν ἔτ' οὐδεὶς ἀξιοῖ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21177.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21177.2.text#τίνος οὕνεκα;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21178.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21178.1.text#ὅτι πάντες εἰσὶ πλούσιοι· καίτοι τότε,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21179.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21179.1.text#ὅτ' εἶχον οὐδέν, ὁ μὲν ἂν ἥκων ἔμπορος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21180.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21180.1.text#ἔθυσεν ἱερεῖόν τι σωθείς, ὁ δέ τις ἂν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21181.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21181.1.text#δίκην ἀποφυγών, ὁ δ' ἂν ἐκαλλιερεῖτό τις
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21182.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21182.1.text#κἀμέ γ' ἐκάλει τὸν ἱερέα· νῦν δ' οὐδὲ εἷς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21183.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21183.1.text#θύει τὸ παράπαν οὐδὲν οὐδ' εἰσέρχεται,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21184.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21184.1.text#πλὴν ἀποπατησόμενοί γε πλεῖν ἢ μύριοι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21185.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21185.1.text#οὔκουν τὰ νομιζόμενα σὺ τούτων λαμβάνεις;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21186.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21186.1.text#τὸν οὖν Δία τὸν σωτῆρα καὐτός μοι δοκῶ
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21187.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21187.1.text#χαίρειν ἐάσας ἐνθάδ' αὐτοῦ καταμένειν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21188.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21188.1.text#θάρρει· καλῶς ἔσται γάρ, ἢν θεὸς θέλῃ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21189.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21189.1.text#ὁ Ζεὺς ὁ σωτὴρ γὰρ πάρεστιν ἐνθάδε,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21190.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21190.1.text#αὐτόματος ἥκων.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21190.2.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21190.2.text#πάντ' ἀγαθὰ τοίνυν λέγεις.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21191.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21191.1.text#ἱδρυσόμεθ' οὖν αὐτίκα μάλ', ἀλλὰ περίμενε
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21192.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21192.1.text#τὸν Πλοῦτον, οὗπερ πρότερον ἦν ἱδρυμένος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21193.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21193.1.text#τὸν ὀπισθόδομον ἀεὶ φυλάττων τῆς θεοῦ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21194.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21194.1.text#ἀλλ' ἐκδότω τις δεῦρο δᾷδας ἡμμένας,
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21195.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21195.1.text#ἵν' ἔχων προηγῇ τῷ θεῷ σύ.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21195.2.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21195.2.text#πάνυ μὲν οὖν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21196.1.speaker#Ἱερεύς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21196.1.text#δρᾶν ταῦτα χρή.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21196.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21196.2.text#τὸν Πλοῦτον ἔξω τις κάλει.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21197.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21197.1.text#ἐγὼ δὲ τί ποιῶ;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21197.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21197.2.text#τὰς χύτρας, αἷς τὸν θεὸν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21198.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21198.1.text#ἱδρυσόμεθα, λαβοῦσ' ἐπὶ τῆς κεφαλῆς φέρε
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21199.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21199.1.text#σεμνῶς· ἔχουσα δ' ἦλθες αὐτὴ ποικίλα.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21200.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21200.1.text#ὧν δ' οὕνεκ' ἦλθον;
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21200.2.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21200.2.text#πάντα σοι πεπράξεται.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21201.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21201.1.text#ἥξει γὰρ ὁ νεανίσκος ὡς σ' εἰς ἑσπέραν.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21202.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21202.1.text#ἀλλ' εἴ γε μέντοι νὴ Δί' ἐγγυᾷ σύ μοι
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21203.1.speaker#Γραῦς
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21203.1.text#ἥξειν ἐκεῖνον ὡς ἔμ', οἴσω τὰς χύτρας.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21204.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21204.1.text#καὶ μὴν πολὺ τῶν ἄλλων χυτρῶν τἀναντία
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21205.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21205.1.text#αὗται ποιοῦσι· ταῖς μὲν ἄλλαις γὰρ χύτραις
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21206.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21206.1.text#ἡ γραῦς ἔπεστ' ἀνωτάτω, ταύτης δὲ νῦν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21207.1.speaker#Χρεμύλος
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21207.1.text#τῆς γραὸς ἐπιπολῆς ἔπεισιν αἱ χύτραι.
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21208.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21208.1.text#οὐκ ἔτι τοίνυν εἰκὸς μέλλειν οὐδ' ἡμᾶς, ἀλλ' ἀναχωρεῖν
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21209.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg011.perseus-grc21209.1.text#ἐς τοὔπισθεν· δεῖ γὰρ κατόπιν τούτων ᾄδοντας ἕπεσθαι.
