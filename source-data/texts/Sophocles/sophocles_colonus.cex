#!ctsdata
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1.1.text#τέκνον τυφλοῦ γέροντος Ἀντιγόνη, τίνας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:2.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:2.1.text#χώρους ἀφίγμεθ' ἢ τίνων ἀνδρῶν πόλιν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:3.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:3.1.text#τίς τὸν πλανήτην Οἰδίπουν καθ' ἡμέραν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:4.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:4.1.text#τὴν νῦν σπανιστοῖς δέξεται δωρήμασιν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:5.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:5.1.text#σμικρὸν μὲν ἐξαιτοῦντα, τοῦ σμικροῦ δ' ἔτι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:6.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:6.1.text#μεῖον φέροντα, καὶ τόδ' ἐξαρκοῦν ἐμοί·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:7.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:7.1.text#στέργειν γὰρ αἱ πάθαι με χὠ χρόνος ξυνὼν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:8.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:8.1.text#μακρὸς διδάσκει καὶ τὸ γενναῖον τρίτον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:9.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:9.1.text#ἀλλ', ὦ τέκνον, θάκησιν εἴ τινα βλέπεις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:10.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:10.1.text#ἢ πρὸς βεβήλοις ἢ πρὸς ἄλσεσιν θεῶν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:11.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:11.1.text#στῆσόν με κἀξίδρυσον, ὡς πυθώμεθα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:12.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:12.1.text#ὅπου ποτ' ἐσμέν·  μανθάνειν γὰρ ἥκομεν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:13.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:13.1.text#ξένοι πρὸς ἀστῶν, ἃν δ' ἀκούσωμεν τελεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:14.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:14.1.text#πάτερ ταλαίπωρ' Οἰδίπους, πύργοι μέν, οἳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:15.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:15.1.text#πόλιν στέγουσιν, ὡς ἀπ' ὀμμάτων, πρόσω·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:16.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:16.1.text#χῶρος δ' ὅδ' ἱερός, ὡς ἀπεικάσαι, βρύων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:17.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:17.1.text#δάφνης, ἐλαίας, ἀμπέλου·  πυκνόπτεροι δ'
urn:cts:greekLit:tlg0011.tlg007.fu.sp:18.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:18.1.text#εἴσω κατ' αὐτὸν εὐστομοῦσ' ἀηδόνες·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:19.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:19.1.text#οὗ κῶλα κάμψον τοῦδ' ἐπ' ἀξέστου πέτρου·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:20.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:20.1.text#μακρὰν γὰρ ὡς γέροντι προὐστάλης ὁδόν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:21.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:21.1.text#κάθιζέ νύν με καὶ φύλασσε τὸν τυφλόν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:22.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:22.1.text#χρόνου μὲν οὕνεκ' οὐ μαθεῖν με δεῖ τόδε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:23.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:23.1.text#ἔχεις διδάξαι δή μ' ὅποι καθέσταμεν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:24.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:24.1.text#τὰς γοῦν Ἀθήνας οἶδα, τὸν δὲ χῶρον οὔ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:25.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:25.1.text#πᾶς γάρ τις ηὔδα τοῦτό γ' ἡμὶν ἐμπόρων.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:26.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:26.1.text#ἀλλ' ὅστις ὁ τόπος ἦ μάθω μολοῦσά ποι;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:27.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:27.1.text#ναί, τέκνον, εἴπερ ἐστί γ' ἐξοικήσιμος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:28.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:28.1.text#ἀλλ' ἐστὶ μὴν οἰκητός· οἴομαι δὲ δεῖν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:29.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:29.1.text#οὐδέν·  πέλας γὰρ ἄνδρα τόνδε νῷν ὁρῶ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:30.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:30.1.text#ἦ δεῦρο προσστείχοντα κἀξορμώμενον;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:31.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:31.1.text#καὶ δὴ μὲν οὖν παρόντα·  χὤ τί σοι λέγειν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:32.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:32.1.text#εὔκαιρόν ἐστιν, ἔννεφ', ὡς ἀνὴρ ὅδε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:33.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:33.1.text#ὦ ξεῖν', ἀκούων τῆσδε τῆς ὑπέρ τ' ἐμοῦ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:34.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:34.1.text#αὑτῆς θ' ὁρώσης, οὕνεχ' ἡμὶν αἴσιος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:35.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:35.1.text#σκοπὸς προσήκεις ὧν ἀδηλοῦμεν φράσαι—
urn:cts:greekLit:tlg0011.tlg007.fu.sp:36.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:36.1.text#πρὶν νῦν τὰ πλείον' ἱστορεῖν, ἐκ τῆσδ' ἕδρας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:37.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:37.1.text#ἔξελθ'·  ἔχεις γὰρ χῶρον οὐχ ἁγνὸν πατεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:38.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:38.1.text#τίς δ' ἔσθ' ὁ χῶρος; τοῦ θεῶν νομίζεται;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:39.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:39.1.text#ἄθικτος οὐδ' οἰκητός·  αἱ γὰρ ἔμφοβοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:40.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:40.1.text#θεαί σφ' ἔχουσι, Γῆς τε καὶ Σκότου κόραι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:41.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:41.1.text#τίνων τὸ σεμνὸν ὄνομ' ἂν εὐξαίμην κλύων;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:42.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:42.1.text#τὰς πάνθ' ὁρώσας Εὐμενίδας ὅ γ' ἐνθάδ' ἂν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:43.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:43.1.text#εἴποι λεώς νιν·  ἄλλα δ' ἀλλαχοῦ καλά.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:44.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:44.1.text#ἀλλ' ἵλεῳ μὲν τὸν ἱκέτην δεξαίατο·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:45.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:45.1.text#ὡς οὐχ ἕδρας γῆς τῆσδ' ἂν ἐξέλθοιμ' ἔτι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:46.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:46.1.text#τί δ' ἐστὶ τοῦτο;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:46.2.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:46.2.text#ξυμφορᾶς ξύνθημ' ἐμῆς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:47.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:47.1.text#ἀλλ' οὐδ' ἐμοί τοι τοὐξανιστάναι πόλεως
urn:cts:greekLit:tlg0011.tlg007.fu.sp:48.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:48.1.text#δίχ' ἐστὶ θάρσος, πρίν γ' ἂν ἐνδείξω τί δρῶ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:49.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:49.1.text#πρός νυν θεῶν, ὦ ξεῖνε, μή μ' ἀτιμάσῃς,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:50.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:50.1.text#τοιόνδ' ἀλήτην, ὧν σε προστρέπω φράσαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:51.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:51.1.text#σήμαινε, κοὐκ' ἄτιμος ἔκ γ' ἐμοῦ φανεῖ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:52.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:52.1.text#τίς ἔσθ' ὁ χῶρος δῆτ', ἐν ᾧ βεβήκαμεν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:53.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:53.1.text#ὅσ' οἶδα κἀγὼ πάντ' ἐπιστήσει κλύων·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:54.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:54.1.text#χῶρος μὲν ἱερὸς πᾶς ὅδ' ἔστ'· ἔχει δέ νιν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:55.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:55.1.text#σεμνὸς Ποσειδῶν· ἐν δ' ὁ πυρφόρος θεὸς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:56.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:56.1.text#Τιτὰν Προμηθεύς· ὃν δ' ἐπιστείβεις τόπον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:57.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:57.1.text#χθονὸς καλεῖται τῆσδε χαλκόπους ὀδός,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:58.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:58.1.text#ἔρεισμ' Ἀθηνῶν·  οἱ δὲ πλησίοι γύαι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:59.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:59.1.text#τόνδ' ἱππότην Κολωνὸν εὔχονται σφίσιν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:60.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:60.1.text#ἀρχηγὸν εἶναι καὶ φέρουσι τοὔνομα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:61.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:61.1.text#τὸ τοῦδε κοινὸν πάντες ὠνομασμένοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:62.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:62.1.text#τοιαῦτά σοι ταῦτ'   ἐστίν, ὦ ξέν', οὐ λόγοις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:63.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:63.1.text#τιμώμεν', ἀλλὰ   τῇ ξυνουσίᾳ πλέον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:64.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:64.1.text#ἦ γάρ τινες ναίουσι τούσδε τοὺς τόπους;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:65.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:65.1.text#καὶ κάρτα, τοῦδε τοῦ θεοῦ γ' ἐπώνυμοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:66.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:66.1.text#ἄρχει τις αὐτῶν ἢ 'πὶ τῷ πλήθει λόγος;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:67.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:67.1.text#ἐκ τοῦ κατ' ἄστυ βασιλέως τάδ' ἄρχεται.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:68.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:68.1.text#οὗτος δὲ τίς λόγῳ τε καὶ σθένει κρατεῖ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:69.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:69.1.text#Θησεὺς καλεῖται, τοῦ πρὶν Αἰγέως τόκος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:70.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:70.1.text#ἆρ' ἄν τις αὐτῷ πομπὸς ἐξ ὑμῶν μόλοι;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:71.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:71.1.text#ὡς πρὸς τί λέξων ἢ καταρτύσων μολεῖν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:72.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:72.1.text#ὡς ἂν προσαρκῶν σμικρὰ κερδάνῃ μέγα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:73.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:73.1.text#καὶ τίς πρὸς ἀνδρὸς μὴ βλέποντος ἄρκεσις;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:74.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:74.1.text#ὅσ' ἂν λέγωμεν πάνθ' ὁρῶντα λέξομεν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:75.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:75.1.text#οἶσθ', ὦ ξέν', ὡς νῦν μὴ σφαλῇς; ἐπείπερ εἰ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:76.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:76.1.text#γενναῖος, ὡς ἰδόντι, πλὴν τοῦ δαίμονος,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:77.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:77.1.text#αὐτοῦ μέν' οὗπερ κἀφάνης, ἕως ἐγὼ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:78.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:78.1.text#τοῖς ἐνθάδ' αὐτοῦ μὴ κατ' ἄστυ δημόταις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:79.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:79.1.text#λέξω τάδ' ἐλθών·  οἵδε γὰρ κρινοῦσί σοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:80.1.speaker#Ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:80.1.text#εἰ χρή σε μίμνειν ἢ πορεύεσθαι πάλιν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:81.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:81.1.text#ὦ τέκνον, ἦ βέβηκεν ἡμὶν ὁ ξένος;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:82.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:82.1.text#βέβηκεν, ὥστε πᾶν ἐν ἡσύχῳ, πάτερ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:83.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:83.1.text#ἔξεστι φωνεῖν, ὡς ἐμοῦ μόνης πέλας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:84.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:84.1.text#ὦ πότνιαι δεινῶπες, εὖτε νῦν ἕδρας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:85.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:85.1.text#πρώτων ἐφ' ὑμῶν τῆσδε γῆς ἔκαμψ' ἐγώ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:86.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:86.1.text#Φοίβῳ τε κἀμοὶ μὴ γένησθ' ἀγνώμονες,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:87.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:87.1.text#ὅς μοι, τὰ πόλλ' ἐκεῖν' ὅτ' ἐξέχρη κακά,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:88.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:88.1.text#ταύτην ἔλεξε παῦλαν ἐν χρόνῳ μακρῷ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:89.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:89.1.text#ἐλθόντι χώραν τερμίαν, ὅπου θεῶν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:90.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:90.1.text#σεμνῶν ἕδραν λάβοιμι καὶ ξενόστασιν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:91.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:91.1.text#ἐνταῦθα κάμψειν τὸν ταλαίπωρον βίον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:92.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:92.1.text#κέρδη μὲν οἰκήσαντα τοῖς δεδεγμένοις,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:93.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:93.1.text#ἄτην δὲ τοῖς πέμψασιν, οἵ μ' ἀπήλασαν·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:94.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:94.1.text#σημεῖα δ' ἥξειν τῶνδέ μοι παρηγγύα,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:95.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:95.1.text#ἢ σεισμὸν ἢ βροντήν τιν' ἢ Διὸς σέλας,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:96.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:96.1.text#ἔγνωκα μέν νυν ὥς με τήνδε τὴν ὁδὸν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:97.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:97.1.text#οὐκ ἔσθ' ὅπως οὐ πιστὸν ἐξ ὑμῶν πτερὸν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:98.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:98.1.text#ἐξήγαγ' εἰς τόδ' ἄλσος·  οὐ γὰρ ἄν ποτε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:99.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:99.1.text#πρώταισιν ὑμῖν ἀντέκυρσ' ὁδοιπορῶν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:100.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:100.1.text#νήφων ἀοίνοις, κἀπὶ σεμνὸν ἑζόμην
urn:cts:greekLit:tlg0011.tlg007.fu.sp:101.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:101.1.text#βάθρον τόδ' ἀσκέπαρνον.  ἀλλά μοι, θεαί,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:102.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:102.1.text#βίου κατ' ὀμφὰς τὰς Ἀπόλλωνος δότε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:103.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:103.1.text#πέρασιν ἤδη καὶ καταστροφήν τινα,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:104.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:104.1.text#εἰ μὴ δοκῶ τι μειόνως ἔχειν, ἀεὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:105.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:105.1.text#μόχθοις λατρεύων τοῖς ὑπερτάτοις βροτῶν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:106.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:106.1.text#ἴτ', ὦ γλυκεῖαι παῖδες ἀρχαίου Σκότου,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:107.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:107.1.text#ἴτ', ὦ μεγίστης Παλλάδος καλούμεναι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:108.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:108.1.text#πασῶν Ἀθῆναι τιμιωτάτη πόλις,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:109.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:109.1.text#οἰκτίρατ' ἀνδρὸς Οἰδίπου τόδ' ἄθλιον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:110.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:110.1.text#εἴδωλον·  οὐ γὰρ δὴ τόδ' ἀρχαῖον δέμας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:111.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:111.1.text#σίγα·  πορεύονται γὰρ οἵδε δή τινες
urn:cts:greekLit:tlg0011.tlg007.fu.sp:112.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:112.1.text#χρόνῳ παλαιοί, σῆς ἕδρας ἐπίσκοποι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:113.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:113.1.text#σιγήσομαί τε καὶ σύ μ' ἐξ ὁδοῦ πόδα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:114.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:114.1.text#κρύψον κατ' ἄλσος, τῶνδ' ἕως ἂν ἐκμάθω
urn:cts:greekLit:tlg0011.tlg007.fu.sp:115.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:115.1.text#τίνας λόγους ἐροῦσιν·  ἐν γὰρ τῷ μαθεῖν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:116.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:116.1.text#ἔνεστιν ηὑλάβεια τῶν ποιουμένων.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:117.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:117.1.text#ὅρα.  τίς ἄρ' ἦν;  ποῦ ναίει;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:118.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:118.1.text#ποῦ κυρεῖ ἐκτόπιος συθεὶς ὁ πάντων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:120.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:120.1.text#ὁ πάντων ἀκορέστατος;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:121.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:121.1.text#προσδέρκου λεῦσσέ νιν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:122.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:122.1.text#προσπεύθου πανταχῇ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:123.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:123.1.text#πλανάτας πλανάτας τις ὁ πρέσβυς οὐδ'
urn:cts:greekLit:tlg0011.tlg007.fu.sp:125.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:125.1.text#ἔγχωρος·  προσέβα γὰρ οὐκ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:126.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:126.1.text#ἄν ποτ' ἀστιβὲς ἄλσος ἐς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:127.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:127.1.text#τᾶνδ' ἀμαιμακετᾶν κορᾶν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:128.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:128.1.text#ἃς τρέμομεν λέγειν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:130.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:130.1.text#καὶ παραμειβόμεσθ' ἀδέρκτως,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:131.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:131.1.text#ἀφώνως, ἀλόγως τὸ τᾶς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:132.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:132.1.text#εὐφάμου στόμα φροντίδος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:133.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:133.1.text#ἱέντες, τὰ δὲ νῦν τιν' ἥκειν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:134.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:134.1.text#λόγος οὐδὲν ἅζονθ',
urn:cts:greekLit:tlg0011.tlg007.fu.sp:135.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:135.1.text#ὃν ἐγὼ λεύσσων περὶ πᾶν οὔπω
urn:cts:greekLit:tlg0011.tlg007.fu.sp:136.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:136.1.text#δύναμαι τέμενος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:137.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:137.1.text#γνῶναι ποῦ μοί ποτε ναίει.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:138.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:138.1.text#ὅδ' ἐκεῖνος ἐγώ·  φωνῇ γὰρ ὁρῶ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:139.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:139.1.text#τὸ φατιζόμενον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:140.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:140.1.text#ἰὼ ἰώ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:141.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:141.1.text#δεινὸς μὲν ὁρᾶν, δεινὸς δὲ κλύειν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:142.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:142.1.text#μή μ', ἱκετεύω, προσίδητ' ἄνομον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:143.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:143.1.text#Ζεῦ ἀλεξῆτορ, τίς ποθ' ὁ πρέσβυς;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:144.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:144.1.text#οὐ πάνυ μοίρας εὐδαιμονίσαι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:145.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:145.1.text#πρώτης, ὦ τῆσδ' ἔφοροι χώρας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:146.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:146.1.text#δηλῶ δ'·  οὐ γὰρ ἂν ὧδ' ἀλλοτρίοις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:147.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:147.1.text#ὄμμασιν εἷρπον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:148.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:148.1.text#κἀπὶ σμικροῖς μέγας ὥρμουν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:149.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:149.1.text#ἐή, ἀλαῶν ὀμμάτων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:150.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:150.1.text#ἆρα καὶ ἦσθα φυτάλμιος; δυσαίων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:151.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:151.1.text#μακραίων γ', ὅσ' ἐπεικάσαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:152.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:152.1.text#ἀλλ' οὐ μὰν ἔν γ' ἐμοὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:153.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:153.1.text#προσθήσει  τάσδ' ἀράς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:155.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:155.1.text#περᾷς γάρ, περᾷς·  ἀλλ' ἵνα τῷδ' ἐν ἀ-
urn:cts:greekLit:tlg0011.tlg007.fu.sp:156.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:156.1.text#φθέγκτῳ μὴ προπέσῃς νάπει
urn:cts:greekLit:tlg0011.tlg007.fu.sp:157.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:157.1.text#ποιάεντι, κάθυδρος οὗ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:158.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:158.1.text#κρατὴρ μειλιχίων ποτῶν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:160.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:160.1.text#ῥεύματι συντρέχει,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:161.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:161.1.text#τόν, ξένε πάμμορ', εὖ φύλαξαι;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:162.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:162.1.text#μετάσταθ' ἀπόβαθι.  πολ-
urn:cts:greekLit:tlg0011.tlg007.fu.sp:163.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:163.1.text#λὰ κέλευθος ἐρατύει·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:165.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:165.1.text#κλύεις, ὦ πολύμοχθ' ἀλᾶτα;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:166.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:166.1.text#λόγον εἴ τιν' οἴσεις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:167.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:167.1.text#πρὸς ἐμὰν λέσχαν, ἀβάτων ἀποβάς,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:168.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:168.1.text#ἵνα πᾶσι νόμος,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:169.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:169.1.text#φώνει·  πρόσθεν δ' ἀπερύκου.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:170.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:170.1.text#θύγατερ, ποῖ τις φροντίδος ἔλθῃ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:171.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:171.1.text#ὦ πάτερ, ἀστοῖς ἴσα χρὴ μελετᾶν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:172.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:172.1.text#εἴκοντας ἃ δεῖ κἀκούοντας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:173.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:173.1.text#πρόσθιγέ νύν μου.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:173.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:173.2.text#ψαύω καὶ δή.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:174.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:174.1.text#ὦ ξένε, μὴ δῆτ' ἀδικηθῶ σοὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:175.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:175.1.text#πιστεύσας καὶ μεταναστάς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:176.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:176.1.text#οὔ τοι μήποτέ σ'  ἐκ τῶνδ' ἑδράνων,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:177.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:177.1.text#ὦ γέρον, ἄκοντά τις ἄξει.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:178.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:178.1.text#ἔτ' οὖν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:178.2.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:178.2.text#ἔτι βαῖνε πόρσω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:179.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:179.1.text#ἔτι;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:180.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:180.1.text#προβίβαζε,  κούρα,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:181.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:181.1.text#πόρσω·  σὺ γὰρ ἀΐεις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:181a.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:181a.text# { … }
urn:cts:greekLit:tlg0011.tlg007.fu.sp:181b.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:181b.text# { … }
urn:cts:greekLit:tlg0011.tlg007.fu.sp:181c.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:181c.text# { … }
urn:cts:greekLit:tlg0011.tlg007.fu.sp:182.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:182.1.text#ἕπεο μάν, ἕπε' ὧδ' ἀμαυρῷ κώλῳ, πάτερ, ᾇ σ' ἄγω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:183.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:183.1.text# { … }
urn:cts:greekLit:tlg0011.tlg007.fu.sp:184.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:184.1.text#τόλμα ξεῖνος ἐπὶ ξένης,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:185.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:185.1.text#ὦ τλάμων, ὅ τι καὶ πόλις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:186.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:186.1.text#τέτροφεν ἄφιλον ἀποστυγεῖν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:187.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:187.1.text#καὶ τὸ φίλον σέβεσθαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:188.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:188.1.text#ἄγε νυν σύ με, παῖ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:189.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:189.1.text#ἵν' ἂν εὐσεβίας ἐπιβαίνοντες
urn:cts:greekLit:tlg0011.tlg007.fu.sp:190.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:190.1.text#τὸ μὲν εἴποιμεν, τὸ δ'  ἀκούσαιμεν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:191.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:191.1.text#καὶ μὴ χρείᾳ πολεμῶμεν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:192.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:192.1.text#αὐτοῦ·  μηκέτι τοῦδ' αὐτοπέτρου βήματος ἔξω πόδα κλίνῃς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:193.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:193.1.text#οὕτως;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:193.2.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:193.2.text#ἅλις, ὡς ἀκούεις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:195.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:195.1.text#ἦ ἑσθῶ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:195.2.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:195.2.text#λέχριός γ' ἐπ' ἄκρου
urn:cts:greekLit:tlg0011.tlg007.fu.sp:196.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:196.1.text#λᾶος βραχὺς ὀκλάσας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:197.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:197.1.text#πάτερ, ἐμὸν τόδ'·  ἐν ἁσυχαίᾳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:198.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:198.1.text#ἰώ μοί μοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:199.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:199.1.text#βάσει βάσιν ἅρμοσαι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:200.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:200.1.text#γεραὸν ἐς χέρα σῶμα σὸν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:201.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:201.1.text#προκλίνας φιλίαν ἐμάν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:202.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:202.1.text#ὤμοι δύσφρονος ἄτας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:203.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:203.1.text#ὦ τλάμων, ὅτε νῦν χαλᾷς,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:204.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:204.1.text#αὔδασον, τίς ἔφυς βροτῶν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:205.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:205.1.text#τίς ὁ πολύπονος ἄγει; τίν' ἂν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:206.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:206.1.text#σοῦ πατρίδ' ἐκπυθοίμαν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:207.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:207.1.text#ὦ ξένοι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:208.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:208.1.text#ἀπόπτολις·  ἀλλὰ μὴ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:209.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:209.1.text#τί τόδ' ἀπεννέπεις, γέρον;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:210.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:210.1.text#μὴ μὴ μή μ' ἀνέρῃ τίς εἰμι, 
urn:cts:greekLit:tlg0011.tlg007.fu.sp:211.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:211.1.text#μηδ' ἐξετάσῃς πέρα ματεύων.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:212.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:212.1.text#τί τόδ';
urn:cts:greekLit:tlg0011.tlg007.fu.sp:212.2.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:212.2.text#αἰνὰ φύσις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:212.3.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:212.3.text#αὔδα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:213.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:213.1.text#τέκνον, ὤμοι, τί γεγώνω;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:214.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:214.1.text#τίνος εἶ σπέρματος, ὦ ξένε, φώνει, πατρόθεν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:215.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:215.1.text#ὤμοι ἐγώ, τί πάθω, τέκνον ἐμόν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:216.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:216.1.text#λέγ', ἐπείπερ ἐπ' ἔσχατα βαίνεις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:217.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:217.1.text#ἀλλ' ἐρῶ· οὐ γὰρ ἔχω κατακρυφάν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:218.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:218.1.text#μακρὰ μέλλετον, ἀλλὰ τάχυνε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:220.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:220.1.text#Λαΐου ἴστε τιν';
urn:cts:greekLit:tlg0011.tlg007.fu.sp:220.2.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:220.2.text#ὢ ἰοὺ ἰού.
 
urn:cts:greekLit:tlg0011.tlg007.fu.sp:221.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:221.1.text#τό τε Λαβδακιδᾶν γένος;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:221.2.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:221.2.text#ὦ Ζεῦ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:222.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:222.1.text#ἄθλιον Οἰδιπόδαν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:222.2.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:222.2.text#σὺ γὰρ ὅδ' εἶ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:223.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:223.1.text#δέος ἴσχετε μηδὲν ὅσ' αὐδῶ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:224.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:224.1.text#ἰὼ ὢ ὤ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:224.2.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:224.2.text#δύσμορος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:224.3.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:224.3.text#ὢ ὤ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:225.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:225.1.text#θύγατερ, τί ποτ'  αὐτίκα κύρσει;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:226.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:226.1.text#ἔξω πόρσω βαίνετε χώρας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:227.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:227.1.text#ἃ δ' ὑπέσχεο ποῖ καταθήσεις,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:228.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:228.1.text#οὐδενὶ μοιριδία τίσις ἔρχεται
urn:cts:greekLit:tlg0011.tlg007.fu.sp:230.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:230.1.text#ἃν προπάθῃ τὸ τίνειν·  ἀπάτα δ' ἀπά-
urn:cts:greekLit:tlg0011.tlg007.fu.sp:231.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:231.1.text#ταις ἑτέραις ἑτέρα παραβαλλομέ-
urn:cts:greekLit:tlg0011.tlg007.fu.sp:232.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:232.1.text#να πόνον, οὐ χάριν, ἀντιδίδωσιν ἔ-
urn:cts:greekLit:tlg0011.tlg007.fu.sp:233.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:233.1.text#χειν.  σὺ δὲ τῶνδ' ἑδράνων πάλιν ἔκτοπος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:234.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:234.1.text#αὖθις ἄφορμος ἐμᾶς χθονὸς ἔκθορε,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:235.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:235.1.text#μή τι πέρα χρέος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:236.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:236.1.text#ἐμᾷ πόλει προσάψῃς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:237.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:237.1.text#ὦ ξένοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:238.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:238.1.text#αἰδόφρονες, ἀλλ' ἐπεὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:239.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:239.1.text#γεραὸν πατέρα τόνδ' ἐμὸν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:240.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:240.1.text#οὐκ ἀνέτλατ', ἔργων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:241.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:241.1.text#ἀκόντων ἀΐοντες αὐδάν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:242.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:242.1.text#ἀλλ' ἐμὲ τὰν μελέαν, ἱκετεύομεν, ὦ ξένοι, οἰκτίραθ', ἃ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:243.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:243.1.text#πατρὸς ὑπὲρ τοὐμοῦ μόνου
urn:cts:greekLit:tlg0011.tlg007.fu.sp:244.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:244.1.text#ἄντομαι οὐκ ἀλαοῖς προσορωμένα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:245.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:245.1.text#ὄμμα σὸν ὄμμασιν, ὥς τις ἀφ' αἵματος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:246.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:246.1.text#ὑμετέρου προφανεῖσα, τὸν ἄθλιον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:247.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:247.1.text#αἰδοῦς κῦρσαι·  ἐν ὔμμι γὰρ ὡς θεῷ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:248.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:248.1.text#κείμεθα τλάμονες.  ἀλλ' ἴτε, νεύσατε τὰν ἀδόκητον χάριν·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:250.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:250.1.text#πρός σ' ὅ τι σοι φίλον ἐκ σέθεν ἄντομαι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:251.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:251.1.text#ἢ τέκνον ἢ λέχος ἢ χρέος ἢ θεός·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:252.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:252.1.text#οὐ γὰρ ἴδοις ἂν ἀθρῶν βροτὸν ὅστις ἄν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:253.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:253.1.text#εἰ θεὸς ἄγοι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:253b.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:253b.text#ἐκφυγεῖν δύναιτο.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:254.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:254.1.text#ἀλλ' ἴσθι, τέκνον Οἰδίπου, σέ τ' ἐξ ἴσου
urn:cts:greekLit:tlg0011.tlg007.fu.sp:255.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:255.1.text#οἰκτίρομεν καὶ τόνδε συμφορᾶς χάριν·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:256.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:256.1.text#τὰ δ' ἐκ θεῶν τρέμοντες οὐ σθένοιμεν ἂν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:257.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:257.1.text#φωνεῖν πέρα τῶν πρὸς σὲ νῦν εἰρημένων.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:258.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:258.1.text#τί δῆτα δόξης ἢ τί κληδόνος καλῆς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:259.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:259.1.text#μάτην ῥεούσης ὠφέλημα γίγνεται,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:260.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:260.1.text#εἰ τάς γ' Ἀθήνας φασὶ θεοσεβεστάτας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:261.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:261.1.text#εἶναι, μόνας δὲ τὸν κακούμενον ξένον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:262.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:262.1.text#σῴζειν οἵας τε καὶ μόνας ἀρκεῖν ἔχειν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:263.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:263.1.text#κἄμοιγε ποῦ τοῦτ' ἐστίν, οἵτινες βάθρων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:264.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:264.1.text#ἐκ τῶνδέ μ' ἐξάραντες εἶτ' ἐλαύνετε,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:265.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:265.1.text#ὄνομα μόνον δείσαντες; οὐ γὰρ δὴ τό γε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:266.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:266.1.text#σῶμ' οὐδὲ τἄργα τἄμ'·  ἐπεὶ τά γ' ἔργα μου
urn:cts:greekLit:tlg0011.tlg007.fu.sp:267.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:267.1.text#πεπονθότ' ἐστὶ μᾶλλον ἢ δεδρακότα,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:268.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:268.1.text#εἴ σοι τὰ μητρὸς καὶ πατρὸς χρείη λέγειν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:269.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:269.1.text#ὧν οὕνεκ' ἐκφοβεῖ με·  τοῦτ' ἐγὼ καλῶς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:270.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:270.1.text#ἔξοιδα.  καίτοι πῶς ἐγὼ κακὸς φύσιν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:271.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:271.1.text#ὅστις παθὼν μὲν ἀντέδρων, ὥστ' εἰ φρονῶν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:272.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:272.1.text#ἔπρασσον, οὐδ' ἂν ὧδ' ἐγιγνόμην κακός;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:273.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:273.1.text#νῦν δ' οὐδὲν εἰδὼς ἱκόμην ἵν' ἱκόμην,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:274.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:274.1.text#ὑφ' ὧν δ' ἔπασχον, εἰδότων ἀπωλλύμην.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:275.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:275.1.text#ἀνθ' ὧν ἱκνοῦμαι πρὸς θεῶν ὑμᾶς, ξένοι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:276.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:276.1.text#ὥσπερ με κἀνεστήσαθ', ὧδε σώσατε,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:277.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:277.1.text#καὶ μὴ θεοὺς τιμῶντες εἶτα τοὺς θεοὺς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:278.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:278.1.text#μοίρας  ποιεῖσθε μηδαμῶς·  ἡγεῖσθε δὲ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:279.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:279.1.text#βλέπειν μὲν αὐτοὺς πρὸς τὸν εὐσεβῆ βροτῶν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:280.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:280.1.text#βλέπειν δὲ πρὸς τοὺς δυσσεβεῖς, φυγὴν δέ του
urn:cts:greekLit:tlg0011.tlg007.fu.sp:281.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:281.1.text#μήπω γενέσθαι φωτὸς ἀνοσίου βροτῶν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:282.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:282.1.text#ξὺν οἷς σὺ μὴ κάλυπτε τὰς εὐδαίμονας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:283.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:283.1.text#ἔργοις Ἀθήνας ἀνοσίοις ὑπηρετῶν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:284.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:284.1.text#ἀλλ' ὥσπερ ἔλαβες τὸν ἱκέτην ἐχέγγυον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:285.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:285.1.text#ῥύου με κἀκφύλασσε·  μηδέ μου κάρα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:286.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:286.1.text#τὸ δυσπρόσοπτον εἰσορῶν ἀτιμάσῃς,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:287.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:287.1.text#ἥκω γὰρ ἱερὸς εὐσεβής τε καὶ φέρων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:288.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:288.1.text#ὄνησιν ἀστοῖς τοῖσδ'·  ὅταν δ' ὁ κύριος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:289.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:289.1.text#παρῇ τις, ὑμῶν ὅστις ἐστὶν ἡγεμών,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:290.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:290.1.text#τότ'  εἰσακούων πάντ'  ἐπιστήσει·  τὰ δὲ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:291.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:291.1.text#μεταξὺ τούτου μηδαμῶς γίγνου κακός.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:292.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:292.1.text#ταρβεῖν μέν, ὦ γεραιέ, τἀνθυμήματα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:293.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:293.1.text#πολλή 'στ' ἀνάγκη τἀπὸ σοῦ· λόγοισι γὰρ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:294.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:294.1.text#οὐκ ὠνόμασται βραχέσι·  τοὺς δὲ τῆσδε γῆς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:295.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:295.1.text#ἄνακτας ἀρκεῖ ταῦτά μοι διειδέναι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:296.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:296.1.text#καὶ ποῦ 'σθ' ὁ κραίνων τῆσδε τῆς χώρας, ξένοι;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:297.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:297.1.text#πατρῷον ἄστυ γῆς ἔχει·  σκοπὸς δέ νιν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:298.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:298.1.text#ὃς κἀμὲ δεῦρ' ἔπεμψεν, οἴχεται στελῶν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:299.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:299.1.text#ἦ καὶ δοκεῖτε τοῦ τυφλοῦ τιν' ἐντροπὴν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:300.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:300.1.text#ἢ φροντίδ', ἕξειν, αὐτὸν ὥστ'  ἐλθεῖν πέλας;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:301.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:301.1.text#καὶ κάρθ', ὅταν  περ τοὔνομ' αἴσθηται τὸ σόν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:302.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:302.1.text#τίς δ' ἔσθ' ὁ κείνῳ τοῦτο τοὔπος ἀγγελῶν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:303.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:303.1.text#μακρὰ κέλευθος·  πολλὰ δ' ἐμπόρων ἔπη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:304.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:304.1.text#φιλεῖ πλανᾶσθαι, τῶν ἐκεῖνος ἀΐων,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:305.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:305.1.text#θάρσει, παρέσται.  πολὺ γάρ, ὦ γέρον, τὸ σὸν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:306.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:306.1.text#ὄνομα διήκει πάντας, ὥστε κεἰ βραδὺς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:307.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:307.1.text#εὕδει, κλύων σοῦ δεῦρ' ἀφίξεται ταχύς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:308.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:308.1.text#ἀλλ' εὐτυχὴς ἵκοιτο τῇ θ' αὑτοῦ πόλει
urn:cts:greekLit:tlg0011.tlg007.fu.sp:309.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:309.1.text#ἐμοί τε·  τίς γὰρ ἐσθλὸς οὐχ αὑτῷ φίλος;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:310.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:310.1.text#ὦ Ζεῦ, τί λέξω;  ποῖ φρενῶν ἔλθω, πάτερ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:311.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:311.1.text#τί δ' ἔστι, τέκνον Ἀντιγόνη;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:311.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:311.2.text#γυναῖχ' ὁρῶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:312.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:312.1.text#στείχουσαν ἡμῶν ἆσσον, Αἰτναίας ἐπὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:313.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:313.1.text#πώλου βεβῶσαν·  κρατὶ δ' ἡλιοστεγὴς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:314.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:314.1.text#κυνῆ πρόσωπα Θεσσαλίς νιν ἀμπέχει.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:315.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:315.1.text#τί φῶ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:316.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:316.1.text#ἆρ' ἔστιν; ἆρ' οὐκ ἔστιν; ἢ γνώμη πλανᾷ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:317.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:317.1.text#καὶ φημὶ κἀπόφημι κοὐκ ἔχω τί φῶ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:318.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:318.1.text#τάλαινα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:319.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:319.1.text#οὐκ ἔστιν ἄλλη·  φαιδρὰ γοῦν ἀπ' ὀμμάτων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:320.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:320.1.text#σαίνει με προσστείχουσα·  σημαίνει δ' ὅτι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:321.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:321.1.text#μόνης τόδ' ἐστὶ δῆλον Ἰσμήνης κάρα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:322.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:322.1.text#πῶς εἶπας, ὦ παῖ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:322.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:322.2.text#παῖδα σήν, ἐμὴν δ' ὁρᾶν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:323.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:323.1.text#ὅμαιμον·  αὐδῇ δ' αὐτίκ' ἔξεστιν μαθεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:324.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:324.1.text#ὦ δισσὰ πατρὸς καὶ κασιγνήτης ἐμοὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:325.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:325.1.text#ἥδιστα προσφωνήμαθ', ὡς ὑμᾶς μόλις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:326.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:326.1.text#εὑροῦσα λύπῃ δεύτερον μόλις βλέπω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:327.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:327.1.text#ὦ τέκνον, ἥκεις;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:327.2.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:327.2.text#ὦ πάτερ δύσμοιρ' ὁρᾶν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:328.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:328.1.text#τέκνον, πέφηνας;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:328.2.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:328.2.text#οὐκ ἄνευ μόχθου γέ μοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:329.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:329.1.text#πρόσψαυσον, ὦ παῖ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:329.2.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:329.2.text#θιγγάνω δυοῖν ὁμοῦ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:330.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:330.1.text#ὦ σπέρμ' ὅμαιμον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:330.2.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:330.2.text#ὦ δυσάθλιαι τροφαί.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:331.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:331.1.text#ἦ τῆσδε κἀμοῦ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:331.2.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:331.2.text#δυσμόρου τ' ἐμοῦ τρίτης.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:332.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:332.1.text#τέκνον, τί δ' ἦλθες;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:332.2.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:332.2.text#σῇ, πάτερ, προμηθίᾳ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:333.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:333.1.text#πότερα πόθοισι;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:333.2.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:333.2.text#καὶ λόγων γ' αὐτάγγελος,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:334.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:334.1.text#ξὺν ᾧπερ εἶχον οἰκετῶν πιστῷ μόνῳ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:335.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:335.1.text#οἱ δ' αὐθόμαιμοι ποῦ νεανίαι πονεῖν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:336.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:336.1.text#εἴσ' οὗπέρ εἰσι·  δεινὰ τἀν κείνοις τανῦν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:337.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:337.1.text#ὦ πάντ' ἐκείνω τοῖς ἐν Αἰγύπτῳ νόμοις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:338.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:338.1.text#φύσιν κατεικασθέντε καὶ βίου τροφάς·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:339.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:339.1.text#ἐκεῖ γὰρ οἱ μὲν ἄρσενες κατὰ στέγας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:340.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:340.1.text#θακοῦσιν ἱστουργοῦντες, αἱ δὲ  σύννομοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:341.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:341.1.text#τἄξω βίου τροφεῖα πορσύνουσ' ἀεί.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:342.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:342.1.text#σφῷν δ', ὦ τέκν', οὓς μὲν εἰκὸς ἦν πονεῖν τάδε,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:343.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:343.1.text#κατ' οἶκον οἰκουροῦσιν ὥστε παρθένοι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:344.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:344.1.text#σφὼ δ' ἀντ' ἐκείνων τἀμὰ δυστήνου κακὰ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:345.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:345.1.text#ὑπερπονεῖτον.  ἡ μὲν ἐξ ὅτου νέας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:346.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:346.1.text#τροφῆς ἔληξε καὶ κατίσχυσεν δέμας,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:347.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:347.1.text#ἀεὶ μεθ' ἡμῶν δύσμορος πλανωμένη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:348.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:348.1.text#γερονταγωγεῖ, πολλὰ μὲν κατ' ἀγρίαν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:349.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:349.1.text#ὕλην ἄσιτος νηλίπους τ' ἀλωμένη,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:350.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:350.1.text#πολλοῖσι δ' ὄμβροις ἡλίου τε καύμασιν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:351.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:351.1.text#μοχθοῦσα τλήμων δεύτερ' ἡγεῖται τὰ τῆς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:352.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:352.1.text#οἴκοι διαίτης, εἰ πατὴρ τροφὴν ἔχοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:353.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:353.1.text#σὺ δ', ὦ τέκνον, πρόσθεν μὲν ἐξίκου πατρὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:354.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:354.1.text#μαντεῖ' ἄγουσα πάντα, Καδμείων λάθρᾳ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:355.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:355.1.text#ἃ τοῦδ' ἐχρήσθη σώματος, φύλαξ τέ μου
urn:cts:greekLit:tlg0011.tlg007.fu.sp:356.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:356.1.text#πιστὴ κατέστης, γῆς ὅτ' ἐξηλαυνόμην·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:357.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:357.1.text#νῦν δ' αὖ τίν' ἥκεις μῦθον, Ἰσμήνη, πατρὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:358.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:358.1.text#φέρουσα; τίς σ' ἐξῆρεν οἴκοθεν στόλος;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:359.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:359.1.text#ἥκεις γὰρ οὐ κενή γε, τοῦτ' ἐγὼ σαφῶς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:360.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:360.1.text#ἔξοιδα, μὴ οὐχὶ δεῖμ' ἐμοὶ φέρουσά τι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:361.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:361.1.text#ἐγὼ τὰ μὲν παθήμαθ' ἅπαθον, πάτερ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:362.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:362.1.text#ζητοῦσα τὴν σὴν ποῦ κατοικοίης τροφήν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:363.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:363.1.text#παρεῖσ' ἐάσω·  δὶς γὰρ οὐχὶ βούλομαι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:364.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:364.1.text#πονοῦσά τ' ἀλγεῖν καὶ λέγουσ' αὖθις πάλιν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:365.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:365.1.text#ἃ δ' ἀμφὶ τοῖν σοῖν δυσμόροιν παίδοιν κακὰ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:366.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:366.1.text#νῦν ἐστι, ταῦτα σημανοῦσ' ἐλήλυθα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:367.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:367.1.text#πρὶν μὲν γὰρ αὐτοῖς ἦν ἔρως  Κρέοντί τε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:368.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:368.1.text#θρόνους ἐᾶσθαι μηδὲ χραίνεσθαι πόλιν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:369.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:369.1.text#λόγῳ σκοποῦσι τὴν πάλαι γένους φθοράν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:370.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:370.1.text#οἵα κατέσχε τὸν σὸν ἄθλιον δόμον·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:371.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:371.1.text#νῦν δ' ἐκ θεῶν του κἀλιτηρίου  φρενὸς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:372.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:372.1.text#εἰσῆλθε τοῖν τρὶς ἀθλίοιν ἔρις κακή,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:373.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:373.1.text#ἀρχῆς λαβέσθαι καὶ κράτους τυραννικοῦ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:374.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:374.1.text#χὠ μὲν νεάζων καὶ χρόνῳ μείων γεγὼς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:375.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:375.1.text#τὸν πρόσθε γεννηθέντα Πολυνείκη θρόνων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:376.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:376.1.text#ἀποστερίσκει, κἀξελήλακεν πάτρας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:377.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:377.1.text#ὁ δ', ὡς καθ' ἡμᾶς ἔσθ' ὁ πληθύων λόγος,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:378.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:378.1.text#τὸ κοῖλον Ἄργος βὰς φυγὰς προσλαμβάνει
urn:cts:greekLit:tlg0011.tlg007.fu.sp:379.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:379.1.text#κῆδός τε καινὸν καὶ ξυνασπιστὰς φίλους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:380.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:380.1.text#ὡς αὐτίκ'  Ἄργος ἢ τὸ Καδμείων πέδον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:381.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:381.1.text#τιμῇ καθέξον ἢ πρὸς οὐρανὸν βιβῶν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:382.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:382.1.text#ταῦτ' οὐκ ἀριθμός ἐστιν, ὦ πάτερ, λόγων,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:383.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:383.1.text#ἀλλ' ἔργα δεινά·  τοὺς δὲ σοὺς ὅπου  θεοὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:384.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:384.1.text#πόνους κατοικτιοῦσιν οὐκ ἔχω μαθεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:385.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:385.1.text#ἤδη γὰρ ἔσχες ἐλπίδ' ὡς ἐμοῦ θεοὺς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:386.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:386.1.text#ὤραν τιν' ἕξειν, ὥστε σωθῆναί ποτε;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:387.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:387.1.text#ἔγωγε τοῖς νὺν γ', ὦ πάτερ, μαντεύμασιν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:388.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:388.1.text#ποίοισι τούτοις; τί δὲ τεθέσπισται, τέκνον;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:389.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:389.1.text#σὲ τοῖς ἐκεῖ ζητητὸν ἀνθρώποις ποτὲ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:390.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:390.1.text#θανόντ' ἔσεσθαι ζῶντά τ' εὐσοίας  χάριν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:391.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:391.1.text#τίς δ' ἂν τοιοῦδ' ὑπ' ἀνδρὸς εὖ πράξειεν ἄν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:392.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:392.1.text#ἐν σοὶ τὰ κείνων  φασὶ γίγνεσθαι κράτη.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:393.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:393.1.text#ὅτ' οὐκέτ' εἰμί, τηνικαῦτ' ἄρ' εἴμ' ἀνήρ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:394.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:394.1.text#νῦν γὰρ θεοί σ' ὀρθοῦσι, πρόσθε δ' ὤλλυσαν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:395.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:395.1.text#γέροντα δ' ὀρθοῦν φλαῦρον ὃς νέος πέσῃ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:396.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:396.1.text#καὶ μὴν Κρέοντά γ' ἴσθι σοι τούτων χάριν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:397.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:397.1.text#ἥξοντα βαιοῦ κοὐχὶ μυρίου χρόνου.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:398.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:398.1.text#ὅπως τί δράσῃ,  θύγατερ; ἑρμήνευέ μοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:399.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:399.1.text#ὥς σ' ἄγχι γῆς στήσωσι Καδμείας, ὅπως
urn:cts:greekLit:tlg0011.tlg007.fu.sp:400.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:400.1.text#κρατῶσι μὲν σοῦ, γῆς δὲ μὴ 'μβαίνῃς ὅρων.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:401.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:401.1.text#ἡ δ' ὠφέλησις τίς θύρασι κειμένου;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:402.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:402.1.text#κείνοις ὁ τύμβος δυστυχῶν ὁ σὸς βαρύς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:403.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:403.1.text#κἄνευ θεοῦ τις τοῦτό γ' ἂν γνώμῃ μάθοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:404.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:404.1.text#τούτου χάριν τοίνυν σε προσθέσθαι πέλας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:405.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:405.1.text#χώρας θέλουσι, μηδ' ἵν' ἂν σαυτοῦ κρατοῖς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:406.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:406.1.text#ἦ καὶ κατασκιῶσι Θηβαίᾳ κόνει;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:407.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:407.1.text#ἀλλ' οὐκ ἐᾷ τοὔμφυλον αἷμά σ', ὦ πάτερ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:408.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:408.1.text#οὐκ ἆρ' ἐμοῦ γε μὴ κρατήσωσίν ποτε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:409.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:409.1.text#ἔσται ποτ' ἆρα τοῦτο Καδμείοις βάρος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:410.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:410.1.text#ποίας φανείσης, ὦ τέκνον, συναλλαγῆς;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:411.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:411.1.text#τῆς σῆς ὑπ' ὀργῆς, σοῖς ὅταν στῶσιν τάφοις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:412.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:412.1.text#ἃ δ' ἐννέπεις, κλύουσα τοῦ λέγεις, τέκνον;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:413.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:413.1.text#ἀνδρῶν θεωρῶν Δελφικῆς ἀφ' ἑστίας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:414.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:414.1.text#καὶ ταῦτ' ἐφ' ἡμῖν Φοῖβος εἰρηκὼς κυρεῖ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:415.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:415.1.text#ὥς φασιν οἱ μολόντες εἰς Θήβης πέδον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:416.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:416.1.text#παίδων τις οὖν ἤκουσε τῶν ἐμῶν τάδε;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:417.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:417.1.text#ἄμφω γ' ὁμοίως, κἀξεπίστασθον καλῶς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:418.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:418.1.text#κᾆθ' οἱ κάκιστοι τῶνδ' ἀκούσαντες, πάρος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:419.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:419.1.text#τοὐμοῦ πόθου προύθεντο τὴν τυραννίδα;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:420.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:420.1.text#ἀλγῶ κλύουσα ταῦτ'  ἐγώ, φέρω δ'  ὅμως.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:421.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:421.1.text#ἀλλ' οἱ θεοί σφιν μήτε τὴν πεπρωμένην
urn:cts:greekLit:tlg0011.tlg007.fu.sp:422.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:422.1.text#ἔριν κατασβέσειαν, ἔν τ' ἐμοὶ τέλος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:423.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:423.1.text#αὐτοῖν γένοιτο τῆσδε τῆς μάχης πέρι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:424.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:424.1.text#ἧς νῦν ἔχονται κἀπαναίρονται δόρυ·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:425.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:425.1.text#ὡς οὔτ' ἂν ὃς νῦν σκῆπτρα καὶ θρόνους ἔχει
urn:cts:greekLit:tlg0011.tlg007.fu.sp:426.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:426.1.text#μείνειεν οὔτ' ἂν οὑξεληλυθὼς πάλιν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:427.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:427.1.text#ἔλθοι ποτ' αὖθις·  οἵ γε τὸν φύσαντ' ἐμὲ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:428.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:428.1.text#οὕτως ἀτίμως πατρίδος ἐξωθούμενον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:429.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:429.1.text#οὐκ ἔσχον οὐδ' ἤμυναν, ἀλλ' ἀνάστατος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:430.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:430.1.text#αὐτοῖς ἐπέμφθην κἀξεκηρύχθην φυγάς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:431.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:431.1.text#εἴποις ἂν ὡς θέλοντι τοῦτ' ἐμοὶ τότε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:432.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:432.1.text#πόλις τὸ δῶρον εἰκότως κατῄνεσεν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:433.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:433.1.text#οὐ δῆτ', ἐπεί τοι τὴν μὲν αὐτίχ' ἡμέραν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:434.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:434.1.text#ὁπηνίκ' ἔζει θυμός, ἥδιστον δέ μοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:435.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:435.1.text#τὸ κατθανεῖν ἦν καὶ τὸ λευσθῆναι πέτροις,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:436.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:436.1.text#οὐδεὶς ἔρωτ' ἐς τόνδ'  ἐφαίνετ' ὠφελῶν·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:437.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:437.1.text#χρόνῳ δ', ὅτ' ἤδη πᾶς ὁ μόχθος ἦν πέπων,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:438.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:438.1.text#κἀμάνθανον τὸν θυμὸν ἐκδραμόντα μοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:439.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:439.1.text#μείζω κολαστὴν τῶν πρὶν ἡμαρτημένων,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:440.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:440.1.text#τὸ τηνίκ'  ἤδη τοῦτο μὲν πόλις βίᾳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:441.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:441.1.text#ἤλαυνέ μ' ἐκ γῆς χρόνιον, οἱ δ' ἐπωφελεῖν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:442.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:442.1.text#οἱ τοῦ πατρός, τῷ πατρὶ δυνάμενοι, τὸ δρᾶν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:443.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:443.1.text#οὐκ ἠθέλησαν, ἀλλ' ἔπους σμικροῦ χάριν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:444.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:444.1.text#φυγάς σφιν ἔξω πτωχὸς ἠλώμην ἀεί.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:445.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:445.1.text#ἐκ ταῖνδε δ', οὔσαιν παρθένοιν, ὅσον φύσις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:446.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:446.1.text#δίδωσιν αὐταῖν, καὶ τροφὰς ἔχω βίου
urn:cts:greekLit:tlg0011.tlg007.fu.sp:447.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:447.1.text#καὶ  γῆς ἄδειαν καὶ γένους ἐπάρκεσιν·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:448.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:448.1.text#τὼ δ' ἀντὶ τοῦ φύσαντος εἱλέσθην θρόνους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:449.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:449.1.text#καὶ σκῆπτρα κραίνειν καὶ τυραννεύειν χθονός.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:450.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:450.1.text#ἀλλ' οὔ τι μὴ λάχωσι τοῦδε συμμάχου,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:451.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:451.1.text#οὐδέ σφιν ἀρχῆς τῆσδε Καδμείας ποτὲ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:452.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:452.1.text#ὄνησις ἥξει·  τοῦτ' ἐγῷδα, τῆσδέ τε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:453.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:453.1.text#μαντεῖ' ἀκούων συννοῶν τε τἀξ ἐμοῦ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:454.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:454.1.text#παλαίφαθ' ἁμοὶ Φοῖβος ἤνυσέν ποτε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:455.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:455.1.text#πρὸς ταῦτα καὶ Κρέοντα πεμπόντων ἐμοῦ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:456.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:456.1.text#μαστῆρα, κεἴ τις ἄλλος ἐν πόλει σθένει.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:457.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:457.1.text#ἐὰν γὰρ ὑμεῖς, ὦ ξένοι, θέληθ' ὁμοῦ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:458.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:458.1.text#προστάτισι ταῖς  σεμναῖσι δημούχοις θεαῖς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:459.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:459.1.text#ἀλκὴν ποεῖσθαι, τῇδε τῇ πόλει μέγαν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:460.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:460.1.text#σωτῆρ' ἀρεῖσθε, τοῖς δ' ἐμοῖς ἐχθροῖς πόνους.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:461.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:461.1.text#ἐπάξιος μέν, Οἰδίπους, κατοικτίσαι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:462.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:462.1.text#αὐτός τε παῖδές θ' αἵδ'·  ἐπεὶ δὲ τῆσδε γῆς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:463.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:463.1.text#σωτῆρα σαυτὸν τῷδ' ἐπεμβάλλεις λόγῳ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:464.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:464.1.text#παραινέσαι σοι βούλομαι τὰ σύμφορα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:465.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:465.1.text#ὦ φίλταθ', ὡς νῦν πᾶν τελοῦντι προξένει.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:466.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:466.1.text#θοῦ νῦν καθαρμὸν τῶνδε δαιμόνων, ἐφ' ἃς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:467.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:467.1.text#τὸ πρῶτον ἵκου καὶ κατέστειψας πέδον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:468.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:468.1.text#τρόποισι ποίοις; ὦ ξένοι, διδάσκετε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:469.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:469.1.text#πρῶτον μὲν ἱερὰς ἐξ ἀειρύτου χοὰς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:470.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:470.1.text#κρήνης ἐνεγκοῦ,  δι' ὁσίων χειρῶν θιγών.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:471.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:471.1.text#ὅταν δὲ τοῦτο χεῦμ' ἀκήρατον λάβω;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:472.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:472.1.text#κρατῆρές εἰσιν, ἀνδρὸς εὔχειρος τέχνη,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:473.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:473.1.text#ὧν κρᾶτ' ἔρεψον καὶ λαβὰς ἀμφιστόμους.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:474.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:474.1.text#θαλλοῖσιν ἢ κρόκαισιν, ἢ ποίῳ τρόπῳ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:475.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:475.1.text#οἰός  γε νεαρᾶς νεοπόκῳ μαλλῷ λαβών.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:476.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:476.1.text#εἶεν·  τὸ δ' ἔνθεν ποῖ τελευτῆσαί με χρή;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:477.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:477.1.text#χοὰς χέασθαι στάντα πρὸς πρώτην ἕω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:478.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:478.1.text#ἦ τοῖσδε κρωσσοῖς οἷς λέγεις χέω τάδε;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:479.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:479.1.text#τρισσάς γε πηγάς·  τὸν τελευταῖον δ' ὅλον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:480.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:480.1.text#τοῦ τόνδε πλήσας θῶ; δίδασκε καὶ τόδε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:481.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:481.1.text#ὕδατος, μελίσσης·  μηδὲ προσφέρειν μέθυ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:482.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:482.1.text#ὅταν δὲ τούτων γῆ μελάμφυλλος τύχῃ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:483.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:483.1.text#τρὶς ἐννέ' αὐτῇ κλῶνας ἐξ ἀμφοῖν χεροῖν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:484.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:484.1.text#τιθεὶς ἐλαίας τάσδ' ἐπεύχεσθαι λιτάς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:485.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:485.1.text#τούτων ἀκοῦσαι βούλομαι·  μέγιστα γάρ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:486.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:486.1.text#ὥς σφας καλοῦμεν Εὐμενίδας, ἐξ εὐμενῶν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:487.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:487.1.text#στέρνων δέχεσθαι τὸν ἱκέτην σωτήριον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:488.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:488.1.text#αἰτοῦ σύ τ' αὐτὸς κεἴ τις ἄλλος ἀντὶ σοῦ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:489.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:489.1.text#ἄπυστα φωνῶν μηδὲ μηκύνων βοήν·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:490.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:490.1.text#ἔπειτ'  ἀφέρπειν ἄστροφος.   καὶ ταῦτά σοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:491.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:491.1.text#δράσαντι θαρσῶν ἂν παρασταίην ἐγώ·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:492.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:492.1.text#ἄλλως δὲ δειμαίνοιμ' ἄν, ὦ ξέν', ἀμφὶ σοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:493.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:493.1.text#ὦ παῖδε, κλύετον τῶνδε προσχώρων ξένων;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:494.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:494.1.text#ἠκούσαμέν τε χὤ  τι δεῖ πρόστασσε δρᾶν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:495.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:495.1.text#ἐμοὶ μὲν οὐχ ὁδωτά·  λείπομαι γὰρ ἐν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:496.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:496.1.text#τῷ μὴ δύνασθαι μήδ' ὁρᾶν, δυοῖν κακοῖν·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:497.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:497.1.text#σφῷν δ' ἁτέρα μολοῦσα πραξάτω τάδε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:498.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:498.1.text#ἀρκεῖν γὰρ οἶμαι κἀντὶ μυρίων μίαν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:499.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:499.1.text#ψυχὴν τάδ' ἐκτίνουσαν, ἢν εὔνους παρῇ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:500.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:500.1.text#ἀλλ' ἐν τάχει τι πράσσετον·  μόνον δέ με
urn:cts:greekLit:tlg0011.tlg007.fu.sp:501.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:501.1.text#μὴ λείπετ'·  οὐ γὰρ ἂν σθένοι τοὐμὸν δέμας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:502.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:502.1.text#ἔρημον ἕρπειν οὐδ' ὑφηγητοῦ δίχα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:503.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:503.1.text#ἀλλ' εἶμ' ἐγὼ τελοῦσα·  τὸν τόπον δ' ἵνα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:504.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:504.1.text#χρῆσταί μ' ἐφευρεῖν, τοῦτο βούλομαι μαθεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:505.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:505.1.text#τοὐκεῖθεν ἄλσους, ὦ ξένη, τοῦδ'·  ἢν δέ του
urn:cts:greekLit:tlg0011.tlg007.fu.sp:506.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:506.1.text#σπάνιν τιν' ἴσχῃς, ἔστ' ἔποικος ὃς φράσει.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:507.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:507.1.text#χωροῖμ' ἂν ἐς τόδ'·  Ἀντιγόνη, σὺ δ' ἐνθάδε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:508.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:508.1.text#φύλασσε πατέρα τόνδε·  τοῖς τεκοῦσι γὰρ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:509.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:509.1.text#οὐδ' εἰ πονεῖ τις, δεῖ  πόνου μνήμην ἔχειν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:510.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:510.1.text#δεινὸν μὲν τὸ πάλαι κείμενον ἤδη κακόν, ὦ ξεῖν', ἐπεγείρειν·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:511.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:511.1.text#ὅμως δ' ἔραμαι πυθέσθαι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:512.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:512.1.text#τί τοῦτο;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:513.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:513.1.text#τᾶς δειλαίας ἀπόρου φανείσας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:514.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:514.1.text#ἀλγηδόνος, ᾇ ξυνέστας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:515.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:515.1.text#μὴ πρὸς ξενίας ἀνοίξῃς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:516.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:516.1.text#τᾶς σᾶς ἃ πέπονθ' ἀναιδῆ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:517.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:517.1.text#τό τοι πολὺ καὶ μηδαμὰ λῆγον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:518.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:518.1.text#χρῄζω,  ξεῖν', ὀρθὸν ἄκουσμ' ἀκοῦσαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:519.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:519.1.text#ὤμοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:519a.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:519a.text#στέρξον, ἱκετεύω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:519b.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:519b.text#φεῦ φεῦ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:520.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:520.1.text#πείθου·  κἀγὼ γὰρ ὅσον σὺ προσχρῄζεις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:521.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:521.1.text#ἤνεγκ' οὖν κακότατ', ὦ ξένοι, ἤνεγκ' ἀέκων μέν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:522.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:522.1.text#θεὸς ἴστω,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:523.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:523.1.text#τούτων δ' αὐθαίρετον οὐδέν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:524.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:524.1.text#ἀλλ'  ἐς τί;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:525.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:525.1.text#κακᾷ μ' εὐνᾷ πόλις οὐδὲν ἴδριν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:526.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:526.1.text#γάμων ἐνέδησεν ἄτᾳ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:527.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:527.1.text#ἦ ματρόθεν, ὡς ἀκούω,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:528.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:528.1.text#δυσώνυμα λέκτρ' ἐπλήσω;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:529.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:529.1.text#ὤμοι θάνατος μὲν τάδ' ἀκούειν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:530.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:530.1.text#ὦ ξεῖν'·  αὗται δὲ δύ' ἐξ ἐμοῦ μὲν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:531.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:531.1.text#πῶς φῄς;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:532.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:532.1.text#παῖδε, δύο δ' ἄτα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:533.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:533.1.text#ὦ Ζεῦ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:534.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:534.1.text#ματρὸς κοινᾶς ἀπέβλαστον ὠδῖνος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:535.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:535.1.text#σαί τ' εἴσ' ἄρ'  ἀπόγονοί τε καὶ 
urn:cts:greekLit:tlg0011.tlg007.fu.sp:536.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:536.1.text#κοιναί γε πατρὸς ἀδελφεαί.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:537.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:537.1.text#ἰώ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:537.2.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:537.2.text#ἰὼ δῆτα μυρίων γ' ἐπιστροφαὶ κακῶν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:538.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:538.1.text#ἔπαθες
urn:cts:greekLit:tlg0011.tlg007.fu.sp:538.2.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:538.2.text#ἔπαθον ἄλαστ' ἔχειν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:539.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:539.1.text#ἔρεξας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:539.2.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:539.2.text#οὐκ ἔρεξα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:539.3.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:539.3.text#τί γάρ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:539.4.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:539.4.text#ἐδεξάμην
urn:cts:greekLit:tlg0011.tlg007.fu.sp:540.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:540.1.text#δῶρον, ὃ μήποτ' ἐγὼ ταλακάρδιος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:541.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:541.1.text#ἐπωφέλησας  πόλεος ἐξελέσθαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:542.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:542.1.text#δύστανε, τί γάρ; ἔθου φόνον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:543.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:543.1.text#τί τοῦτο; τί δ' ἐθέλεις μαθεῖν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:544.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:544.1.text#πατρός;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:544.2.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:544.2.text#παπαῖ. δευτέραν ἔπαισας, ἐπὶ νόσῳ νόσον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:545.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:545.1.text#ἔκανες
urn:cts:greekLit:tlg0011.tlg007.fu.sp:545.2.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:545.2.text#ἔκανον.  ἔχει δέ μοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:546.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:546.1.text#τί τοῦτο;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:546.2.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:546.2.text#πρὸς δίκας τι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:546.3.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:546.3.text#τί γάρ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:546.4.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:546.4.text#ἐγὼ φράσω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:547.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:547.1.text#καὶ  γὰρ ἄν, οὓς ἐφόνευσ', ἔμ' ἀπώλεσαν·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:548.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:548.1.text#νόμῳ δὲ καθαρός,  ἄϊδρις εἰς τόδ' ἦλθον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:549.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:549.1.text#καὶ  μὴν ἄναξ ὅδ' ἡμὶν Αἰγέως γόνος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:550.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:550.1.text#Θησεὺς κατ'  ὀμφὴν σὴν ἐφ'  ἁστάλη    πάρα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:551.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:551.1.text#πολλῶν ἀκούων ἔν τε τῷ πάρος χρόνῳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:552.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:552.1.text#τὰς αἱματηρὰς ὀμμάτων διαφθορὰς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:553.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:553.1.text#ἔγνωκά σ', ὦ παῖ Λαΐου, τανῦν θ' ὁδοῖς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:554.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:554.1.text#ἐν ταῖσδ' ἀκούων μᾶλλον ἐξεπίσταμαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:555.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:555.1.text#σκευή τε γάρ σε καὶ τὸ δύστηνον κάρα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:556.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:556.1.text#δηλοῦτον ἡμῖν ὄνθ' ὃς εἶ, καί σ' οἰκτίσας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:557.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:557.1.text#θέλω 'περέσθαι, δύσμορ' Οἰδίπους, τίνα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:558.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:558.1.text#πόλεως ἐπέστης προστροπὴν ἐμοῦ τ'  ἔχων,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:559.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:559.1.text#αὐτός τε χἠ σὴ δύσμορος παραστάτις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:560.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:560.1.text#δίδασκε·  δεινὴν γάρ τιν' ἂν πρᾶξιν τύχοις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:561.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:561.1.text#λέξας ὁποίας ἐξαφισταίμην ἐγώ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:562.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:562.1.text#ὃς οἶδα καὐτὸς ὡς ἐπαιδεύθην ξένος,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:563.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:563.1.text#ὥσπερ σύ, χὢς εἷς πλεῖστ' ἀνὴρ ἐπὶ ξένης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:564.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:564.1.text#ἤθλησα κινδυνεύματ' ἐν τὠμῷ κάρᾳ·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:565.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:565.1.text#ὥστε ξένον γ' ἂν οὐδέν' ὄνθ', ὥσπερ σὺ νῦν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:566.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:566.1.text#ὑπεκτραποίμην μὴ οὐ συνεκσῴζειν·  ἐπεὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:567.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:567.1.text#ἔξοιδ' ἀνὴρ ὢν χὤτι τῆς εἰς αὔριον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:568.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:568.1.text#οὐδὲν πλέον μοι σοῦ μέτεστιν ἡμέρας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:569.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:569.1.text#Θησεῦ, τὸ σὸν γενναῖον ἐν σμικρῷ λόγῳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:570.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:570.1.text#παρῆκεν, ὥστε βραχέα μοι δεῖσθαι φράσαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:571.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:571.1.text#σὺ γάρ μ' ὅς εἰμι κἀφ' ὅτου πατρὸς γεγὼς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:572.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:572.1.text#καὶ γῆς ὁποίας ἦλθον, εἰρηκὼς κυρεῖς·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:573.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:573.1.text#ὥστ' ἐστί μοι τὸ λοιπὸν οὐδὲν ἄλλο πλὴν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:574.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:574.1.text#εἰπεῖν ἃ χρῄζω, χὠ λόγος διοίχεται.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:575.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:575.1.text#τοῦτ' αὐτὸ νῦν δίδασχ', ὅπως ἂν ἐκμάθω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:576.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:576.1.text#δώσων ἱκάνω τοὐμὸν ἄθλιον δέμας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:577.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:577.1.text#σοὶ δῶρον, οὐ σπουδαῖον εἰς ὄψιν· τὰ δὲ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:578.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:578.1.text#κέρδη παρ' αὐτοῦ κρείσσον' ἢ μορφὴ καλή.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:579.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:579.1.text#ποῖον δὲ κέρδος ἀξιοῖς ἥκειν φέρων;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:580.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:580.1.text#χρόνῳ μάθοις ἄν, οὐχὶ τῷ παρόντι που.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:581.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:581.1.text#ποίῳ γὰρ ἡ σὴ προσφορὰ δηλώσεται;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:582.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:582.1.text#ὅταν θάνω 'γὼ   καὶ σύ μου ταφεὺς γένῃ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:583.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:583.1.text#τὰ λοίσθι' αἰτεῖ τοῦ βίου, τὰ δ' ἐν μέσῳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:584.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:584.1.text#ἢ λῆστιν ἴσχεις ἢ δι' οὐδενὸς ποεῖ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:585.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:585.1.text#ἐνταῦθα γάρ μοι κεῖνα συγκομίζεται.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:586.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:586.1.text#ἀλλ' ἐν βραχεῖ δὴ τήνδε μ' ἐξαιτεῖ χάριν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:587.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:587.1.text#ὅρα γε μήν·  οὐ σμικρός, οὔχ, ἁγὼν ὅδε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:588.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:588.1.text#πότερα τὰ τῶν σῶν ἐκγόνων κἀμοῦ  λέγεις;—
urn:cts:greekLit:tlg0011.tlg007.fu.sp:589.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:589.1.text#κεῖνοι κομίζειν κεῖσ' ἄναξ, χρῄζουσί με.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:590.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:590.1.text#ἀλλ'  εἰ θέλοντά γ'  οὐδὲ σοὶ φεύγειν καλόν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:591.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:591.1.text#ἀλλ' οὐδ', ὅτ' αὐτὸς ἤθελον, παρίεσαν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:592.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:592.1.text#ὦ μῶρε, θυμὸς δ' ἐν κακοῖς οὐ ξύμφορον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:593.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:593.1.text#ὅταν μάθῃς μου, νουθέτει, τανῦν δ' ἔα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:594.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:594.1.text#δίδασκ'·  ἄνευ γνώμης γὰρ οὔ με χρὴ λέγειν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:595.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:595.1.text#πέπονθα, Θησεῦ, δεινὰ πρὸς κακοῖς κακά.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:596.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:596.1.text#ἦ τὴν παλαιὰν ξυμφορὰν γένους ἐρεῖς;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:597.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:597.1.text#οὐ δῆτ', ἐπεὶ πᾶς τοῦτό γ' Ἑλλήνων θροεῖ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:598.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:598.1.text#τί γὰρ τὸ μεῖζον ἢ κατ' ἄνθρωπον νοσεῖς;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:599.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:599.1.text#οὕτως ἔχει μοι.  γῆς ἐμῆς ἀπηλάθην
urn:cts:greekLit:tlg0011.tlg007.fu.sp:600.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:600.1.text#πρὸς τῶν ἐμαυτοῦ σπερμάτων·  ἔστιν δέ μοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:601.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:601.1.text#πάλιν κατελθεῖν μήποθ', ὡς πατροκτόνῳ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:602.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:602.1.text#πῶς δῆτα σ' ἂν πεμψαίαθ', ὥστ' οἰκεῖν δίχα;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:603.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:603.1.text#τὸ θεῖον αὐτοὺς ἐξαναγκάσει στόμα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:604.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:604.1.text#ποῖον πάθος δείσαντας ἐκ χρηστηρίων;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:605.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:605.1.text#ὅτι σφ' ἀνάγκη τῇδε πληγῆναι χθονί.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:606.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:606.1.text#καὶ πῶς γένοιτ' ἂν τἀμὰ κἀκείνων πικρά;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:607.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:607.1.text#ὦ φίλτατ' Αἰγέως παῖ, μόνοις οὐ γίγνεται
urn:cts:greekLit:tlg0011.tlg007.fu.sp:608.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:608.1.text#θεοῖσι γῆρας οὐδὲ κατθανεῖν ποτε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:609.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:609.1.text#τὰ δ' ἄλλα συγχεῖ πάνθ' ὁ παγκρατὴς χρόνος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:610.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:610.1.text#φθίνει μὲν ἰσχὺς γῆς, φθίνει δὲ σώματος,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:611.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:611.1.text#θνῄσκει δὲ πίστις, βλαστάνει δ' ἀπιστία,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:612.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:612.1.text#καὶ πνεῦμα ταὐτὸν οὔποτ' οὔτ' ἐν ἀνδράσιν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:613.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:613.1.text#φίλοις βέβηκεν οὔτε πρὸς πόλιν πόλει.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:614.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:614.1.text#τοῖς μὲν γὰρ ἤδη, τοῖς δ' ἐν ὑστέρῳ χρόνῳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:615.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:615.1.text#τὰ τερπνὰ πικρὰ γίγνεται καὖθις φίλα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:616.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:616.1.text#καὶ ταῖσι Θήβαις εἰ τανῦν εὐημερεῖ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:617.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:617.1.text#καλῶς τὰ πρὸς σέ, μυρίας ὁ μυρίος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:618.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:618.1.text#χρόνος τεκνοῦται νύκτας ἡμέρας τ' ἰών,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:619.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:619.1.text#ἐν αἷς τὰ νῦν ξύμφωνα δεξιώματα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:620.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:620.1.text#δόρει διασκεδῶσιν ἐκ σμικροῦ λόγου·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:621.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:621.1.text#ἵν' οὑμὸς εὕδων καὶ κεκρυμμένος νέκυς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:622.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:622.1.text#ψυχρός ποτ' αὐτῶν θερμὸν αἷμα πίεται,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:623.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:623.1.text#εἰ Ζεὺς ἔτι Ζεὺς χὠ Διὸς Φοῖβος σαφής.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:624.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:624.1.text#ἀλλ' οὐ γὰρ αὐδᾶν ἡδὺ τἀκίνητ' ἔπη,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:625.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:625.1.text#ἔα μ' ἐν οἷσιν ἠρξάμην, τὸ σὸν μόνον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:626.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:626.1.text#πιστὸν φυλάσσων, κοὔποτ' Οἰδίπουν ἐρεῖς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:627.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:627.1.text#ἀχρεῖον οἰκητῆρα δέξασθαι τόπων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:628.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:628.1.text#τῶν ἐνθάδ', εἴπερ μὴ θεοὶ ψεύσουσί με.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:629.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:629.1.text#ἄναξ, πάλαι καὶ ταῦτα καὶ τοιαῦτ' ἔπη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:630.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:630.1.text#γῇ τῇδ' ὅδ' ἁνὴρ ὡς τελῶν ἐφαίνετο.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:631.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:631.1.text#τίς δῆτ' ἂν ἀνδρὸς εὐμένειαν ἐκβάλοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:632.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:632.1.text#τοιοῦδ', ὅτῳ πρῶτον μὲν ἡ δορύξενος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:633.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:633.1.text#κοινή παρ' ἡμῖν αἰέν ἐστιν ἑστία;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:634.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:634.1.text#ἔπειτα δ' ἱκέτης δαιμόνων ἀφιγμένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:635.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:635.1.text#γῇ τῇδε κἀμοὶ δασμὸν οὐ σμικρὸν τίνει.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:636.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:636.1.text#ἁγὼ σεβισθεὶς οὔποτ' ἐκβαλῶ χάριν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:637.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:637.1.text#τὴν τοῦδε, χώρᾳ δ' ἔμπολιν  κατοικιῶ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:638.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:638.1.text#εἰ δ' ἐνθάδ' ἡδὺ τῷ ξένῳ μίμνειν, σέ νιν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:639.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:639.1.text#τάξω φυλάσσειν, εἴτ' ἐμοῦ στείχειν μέτα,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:640.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:640.1.text#τόδ'  ἡδύ, τούτων, Οἰδίπους, δίδωμί σοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:641.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:641.1.text#κρίναντι χρῆσθαι·  τῇδε γὰρ ξυνοίσομαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:642.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:642.1.text#ὦ Ζεῦ, διδοίης τοῖσι τοιούτοισιν εὖ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:643.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:643.1.text#τί δῆτα χρῄζεις; ἦ δόμους στείχειν ἐμούς;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:644.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:644.1.text#εἴ μοι θέμις γ' ἦν·  ἀλλ' ὁ χῶρός ἐσθ' ὅδε,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:645.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:645.1.text#ἐν ᾧ τί πράξεις; οὐ γὰρ ἀντιστήσομαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:646.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:646.1.text#ἐν ᾧ κρατήσω τῶν ἔμ' ἐκβεβληκότων.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:647.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:647.1.text#μέγ' ἂν λέγοις δώρημα τῆς συνουσίας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:648.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:648.1.text#εἰ σοί γ' ἅπερ φῂς ἐμμενεῖ τελοῦντί μοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:649.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:649.1.text#θάρσει τὸ τοῦδέ γ' ἀνδρός·  οὔ σε μὴ προδῶ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:650.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:650.1.text#οὔτοι σ' ὑφ' ὅρκου γ' ὡς κακὸν πιστώσομαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:651.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:651.1.text#οὔκουν πέρα γ' ἂν οὐδὲν ἢ λόγῳ φέροις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:652.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:652.1.text#πῶς οὖν ποήσεις;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:652.2.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:652.2.text#τοῦ μάλιστ' ὄκνος σ' ἔχει;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:653.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:653.1.text#ἥξουσιν ἄνδρες
urn:cts:greekLit:tlg0011.tlg007.fu.sp:653.2.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:653.2.text#ἀλλὰ τοῖσδ' ἔσται μέλον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:654.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:654.1.text#ὅρα με λείπων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:654.2.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:654.2.text#μὴ δίδασχ' ἃ χρή με δρᾶν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:655.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:655.1.text#ὀκνοῦντ' ἀνάγκη.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:655.2.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:655.2.text#τοὐμὸν οὐκ ὀκνεῖ κέαρ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:656.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:656.1.text#οὐκ οἶσθ' ἀπειλὰς
 
urn:cts:greekLit:tlg0011.tlg007.fu.sp:656.2.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:656.2.text#οἶδ' ἐγώ σε μή τινα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:657.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:657.1.text#ἐνθένδ' ἀπάξοντ' ἄνδρα πρὸς βίαν ἐμοῦ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:658.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:658.1.text#πολλαὶ δ' ἀπειλαὶ πολλὰ δὴ μάτην ἔπη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:659.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:659.1.text#θυμῷ κατηπείλησαν, ἀλλ' ὁ νοῦς ὅταν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:660.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:660.1.text#αὑτοῦ γένηται, φροῦδα τἀπειλήματα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:661.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:661.1.text#κείνοις δ' ἴσως κεἰ δείν' ἐπερρώσθη λέγειν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:662.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:662.1.text#τῆς σῆς ἀγωγῆς, οἶδ' ἐγώ, φανήσεται
urn:cts:greekLit:tlg0011.tlg007.fu.sp:663.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:663.1.text#μακρὸν τὸ δεῦρο πέλαγος οὐδὲ πλώσιμον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:664.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:664.1.text#θαρσεῖν μὲν οὖν ἔγωγε κἂν ἐμῆς ἄνευ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:665.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:665.1.text#γνώμης ἐπαινῶ,    Φοῖβος εἰ προὔπεμψέ σε·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:666.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:666.1.text#ὅμως δὲ κἀμοῦ μὴ παρόντος οἶδ' ὅτι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:667.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:667.1.text#τοὐμὸν φυλάξει σ' ὄνομα μὴ πάσχειν κακῶς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:668.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:668.1.text#εὐίππου, ξένε, τᾶσδε χώρας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:669.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:669.1.text#ἵκου τὰ κράτιστα γᾶς ἔπαυλα,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:670.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:670.1.text#τὸν ἀργῆτα Κολωνόν, ἔνθ'
urn:cts:greekLit:tlg0011.tlg007.fu.sp:671.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:671.1.text#ἁ λίγεια μινύρεται
urn:cts:greekLit:tlg0011.tlg007.fu.sp:672.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:672.1.text#θαμίζουσα μάλιστ' ἀηδὼν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:673.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:673.1.text#χλωραῖς ὑπὸ βάσσαις,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:674.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:674.1.text#τὸν οἰνωπὸν ἔχουσα κισσὸν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:675.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:675.1.text#καὶ τὰν ἄβατον θεοῦ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:676.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:676.1.text#φυλλάδα μυριόκαρπον ἀνήλιον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:677.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:677.1.text#ἀνήνεμόν τε πάντων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:678.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:678.1.text#χειμώνων· ἵν' ὁ βακχιώτας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:679.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:679.1.text#ἀεὶ Διόνυσος ἐμβατεύει
urn:cts:greekLit:tlg0011.tlg007.fu.sp:680.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:680.1.text#θεαῖς ἀμφιπολῶν τιθήναις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:681.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:681.1.text#θάλλει δ' οὐρανίας ὑπ'  ἄχνας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:682.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:682.1.text#ὁ καλλίβοτρυς κατ' ἦμαρ ἀεὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:683.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:683.1.text#νάρκισσος, μεγάλαιν θεαῖν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:684.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:684.1.text#ἀρχαῖον στεφάνωμ', ὅ τε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:685.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:685.1.text#χρυσαυγὴς κρόκος·  οὐδ' ἄϋπνοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:686.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:686.1.text#κρῆναι μινύθουσιν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:687.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:687.1.text#Κηφισοῦ  νομάδες ῥεέθρων,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:688.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:688.1.text#ἀλλ' αἰὲν ἐπ' ἤματι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:689.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:689.1.text#ὠκυτόκος πεδίων ἐπινίσσεται
urn:cts:greekLit:tlg0011.tlg007.fu.sp:690.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:690.1.text#ἀκηράτῳ σὺν ὄμβρῳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:691.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:691.1.text#στερνούχου χθονός·  οὐδὲ Μουσᾶν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:692.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:692.1.text#χοροί νιν ἀπεστύγησαν οὐδ' ἁ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:693.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:693.1.text#χρυσάνιος Ἀφροδίτα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:695.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:695.1.text#ἔστιν δ' οἷον ἐγὼ γᾶς Ἀσίας οὐκ ἐπακούω
urn:cts:greekLit:tlg0011.tlg007.fu.sp:696.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:696.1.text#οὐδ' ἐν τᾷ μεγάλᾳ Δωρίδι νάσῳ Πέλοπος πώποτε βλαστὸν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:697.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:697.1.text#φύτευμ' ἀχείρωτον αὐτόποιον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:698.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:698.1.text#ἐγχέων φόβημα δαΐων,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:700.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:700.1.text#ὃ τᾷδε θάλλει μέγιστα χώρᾳ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:701.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:701.1.text#γλαυκᾶς παιδοτρόφου φύλλον ἐλαίας·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:702.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:702.1.text#τὸ μέν τις οὐ νεαρὸς οὐδὲ  γήρᾳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:703.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:703.1.text#συνναίων  ἁλιώσει χερὶ πέρσας·  ὁ γὰρ αἰὲν ὁρῶν κύκλος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:705.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:705.1.text#λεύσσει νιν μορίου Διὸς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:706.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:706.1.text#χἀ γλαυκῶπις Ἀθάνα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:707.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:707.1.text#ἄλλον δ' αἶνον ἔχω ματροπόλει τᾷδε κράτιστον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:710.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:710.1.text#δῶρον τοῦ μεγάλου δαίμονος, εἰπεῖν, χθονὸς αὔχημα μέγιστον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:711.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:711.1.text#εὔιππον, εὔπωλον, εὐθάλασσον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:712.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:712.1.text#ὦ παῖ Κρόνου, σὺ γάρ νιν εἰς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:713.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:713.1.text#τόδ' εἷσας αὔχημ', ἄναξ Ποσειδάν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:715.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:715.1.text#ἵπποισιν τὸν ἀκεστῆρα χαλινὸν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:716.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:716.1.text#πρώταισι ταῖσδε κτίσας ἀγυιαῖς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:717.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:717.1.text#ἁ δ' εὐήρετμος ἔκπαγλ' ἁλία χερσὶ παραπτομένα πλάτα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:718.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:718.1.text#θρῴσκει, τῶν ἑκατομπόδων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:719.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:719.1.text#Νηρῄδων ἀκόλουθος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:720.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:720.1.text#ὦ πλεῖστ'  ἐπαίνοις εὐλογούμενον πέδον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:721.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:721.1.text#νῦν σὸν τὰ λαμπρὰ ταῦτα δὴ φαίνειν ἔπη.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:722.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:722.1.text#τί δ' ἔστιν, ὦ παῖ, καινόν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:722.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:722.2.text#ἆσσον ἔρχεται
urn:cts:greekLit:tlg0011.tlg007.fu.sp:723.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:723.1.text#Κρέων ὅδ' ἡμῖν οὐκ ἄνευ πομπῶν, πάτερ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:724.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:724.1.text#ὦ φίλτατοι γέροντες, ἐξ ὑμῶν ἐμοὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:725.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:725.1.text#φαίνοιτ' ἂν ἤδη τέρμα τῆς σωτηρίας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:726.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:726.1.text#θάρσει, παρέσται·  καὶ γὰρ εἰ γέρων ἐγώ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:727.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:727.1.text#τὸ τῆσδε χώρας οὐ γεγήρακεν σθένος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:728.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:728.1.text#ἄνδρες χθονὸς τῆσδ' εὐγενεῖς οἰκήτορες,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:729.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:729.1.text#ὁρῶ τιν' ὑμᾶς ὀμμάτων εἰληφότας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:730.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:730.1.text#φόβον νεώρη τῆς ἐμῆς ἐπεισόδου,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:731.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:731.1.text#ὃν μήτ' ὀκνεῖτε μήτ' ἀφῆτ' ἔπος κακόν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:732.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:732.1.text#ἥκω γὰρ οὐχ ὡς δρᾶν τι βουληθείς, ἐπεὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:733.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:733.1.text#γέρων μέν εἰμι, πρὸς πόλιν δ' ἐπίσταμαι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:734.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:734.1.text#σθένουσαν ἥκων, εἴ τιν' Ἑλλάδος, μέγα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:735.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:735.1.text#ἀλλ' ἄνδρα τόνδε τηλικόσδ' ἀπεστάλην
urn:cts:greekLit:tlg0011.tlg007.fu.sp:736.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:736.1.text#πείσων ἕπεσθαι πρὸς τὸ Καδμείων πέδον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:737.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:737.1.text#οὐκ ἐξ ἑνὸς στείλαντος, ἀλλ' ἀνδρῶν ὑπὸ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:738.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:738.1.text#πάντων κελευσθείς, οὕνεχ' ἧκέ μοι γένει
urn:cts:greekLit:tlg0011.tlg007.fu.sp:739.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:739.1.text#τὰ τοῦδε πενθεῖν πήματ' εἰς πλεῖστον πόλεως.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:740.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:740.1.text#ἀλλ' ὦ ταλαίπωρ' Οἰδίπους, κλύων ἐμοῦ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:741.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:741.1.text#ἱκοῦ πρὸς οἴκους.  πᾶς σε Καδμείων λεὼς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:742.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:742.1.text#καλεῖ δικαίως, ἐκ δὲ τῶν μάλιστ' ἐγώ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:743.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:743.1.text#ὅσῳπερ, εἰ μὴ πλεῖστον ἀνθρώπων ἔφυν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:744.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:744.1.text#κάκιστος, ἀλγῶ τοῖσι σοῖς κακοῖς, γέρον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:745.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:745.1.text#ὁρῶν σε τὸν δύστηνον ὄντα μὲν ξένον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:746.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:746.1.text#ἀεὶ δ' ἀλήτην κἀπὶ προσπόλου μιᾶς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:747.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:747.1.text#βιοστερῆ χωροῦντα·  τὴν ἐγὼ τάλας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:748.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:748.1.text#οὐκ ἄν ποτ' ἐς τοσοῦτον αἰκίας πεσεῖν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:749.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:749.1.text#ἔδοξ', ὅσον πέπτωκεν ἥδε δύσμορος,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:750.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:750.1.text#ἀεί σε κηδεύουσα καὶ  τὸ σὸν κάρα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:751.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:751.1.text#πτωχῷ διαίτῃ, τηλικοῦτος, οὐ γάμων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:752.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:752.1.text#ἔμπειρος, ἀλλὰ τοὐπιόντος ἁρπάσαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:753.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:753.1.text#ἆρ' ἄθλιον τοὔνειδος, ὦ τάλας ἐγώ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:754.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:754.1.text#ὠνείδισ' εἰς σὲ κἀμὲ καὶ τὸ πᾶν γένος;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:755.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:755.1.text#ἀλλ' οὐ γὰρ ἔστι τἀμφανῆ κρύπτειν, σύ νιν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:756.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:756.1.text#πρὸς θεῶν πατρῴων, Οἰδίπους, πεισθεὶς ἐμοὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:757.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:757.1.text#κρύψον, θελήσας ἄστυ καὶ δόμους μολεῖν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:758.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:758.1.text#τοὺς σοὺς πατρῴους, τήνδε τὴν πόλιν φίλως
urn:cts:greekLit:tlg0011.tlg007.fu.sp:759.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:759.1.text#εἰπών·  ἐπαξία γάρ·  ἡ δ' οἴκοι πλέον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:760.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:760.1.text#δίκῃ σέβοιτ' ἄν, οὖσα σὴ πάλαι τροφός.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:761.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:761.1.text#ὦ πάντα τολμῶν κἀπὸ παντὸς ἂν φέρων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:762.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:762.1.text#λόγου δικαίου μηχάνημα ποικίλον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:763.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:763.1.text#τί ταῦτα πειρᾷ κἀμὲ δεύτερον θέλεις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:764.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:764.1.text#ἑλεῖν ἐν οἷς μάλιστ' ἂν ἀλγοίην ἁλούς;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:765.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:765.1.text#πρόσθεν τε γάρ με τοῖσιν οἰκείοις κακοῖς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:766.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:766.1.text#νοσοῦνθ', ὅτ' ἦν μοι τέρψις ἐκπεσεῖν χθονός,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:767.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:767.1.text#οὐκ ἤθελες θέλοντι προσθέσθαι χάριν·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:768.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:768.1.text#ἀλλ' ἡνίκ' ἤδη μεστὸς ἦ θυμούμενος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:769.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:769.1.text#καὶ τοὐν δόμοισιν ἦν διαιτᾶσθαι γλυκύ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:770.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:770.1.text#τότ'  ἐξεώθεις κἀξέβαλλες, οὐδέ σοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:771.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:771.1.text#τὸ συγγενὲς τοῦτ' οὐδαμῶς τότ' ἦν φίλον·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:772.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:772.1.text#νῦν τ' αὖθις ἡνίκ' εἰσορᾷς πόλιν τέ μοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:773.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:773.1.text#ξυνοῦσαν εὔνουν τήνδε καὶ γένος τὸ πᾶν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:774.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:774.1.text#πειρᾷ μετασπᾶν, σκληρὰ μαλθακῶς λέγων.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:775.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:775.1.text#καίτοι τίς αὕτη τέρψις ἄκοντας φιλεῖν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:776.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:776.1.text#ὥσπερ τις εἴ σοι λιπαροῦντι μὲν τυχεῖν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:777.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:777.1.text#μηδὲν διδοίη μηδ' ἐπαρκέσαι θέλοι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:778.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:778.1.text#πλήρη δ' ἔχοντι θυμὸν ὧν χρῄζοις, τότε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:779.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:779.1.text#δωροῖθ', ὅτ' οὐδὲν ἡ χάρις χάριν φέροι·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:780.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:780.1.text#ἆρ' ἂν ματαίου τῆσδ' ἂν ἡδονῆς τύχοις;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:781.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:781.1.text#τοιαῦτα μέντοι καὶ σὺ προσφέρεις ἐμοί,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:782.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:782.1.text#λόγῳ μὲν ἐσθλά.  τοῖσι δ' ἔργοισιν κακά.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:783.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:783.1.text#φράσω δὲ καὶ τοῖσδ', ὥς σε δηλώσω κακόν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:784.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:784.1.text#ἥκεις ἔμ' ἄξων, οὐχ' ἵν' ἐς δόμους ἄγῃς,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:785.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:785.1.text#ἀλλ' ὡς πάραυλον οἰκίσῃς, πόλις δέ σοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:786.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:786.1.text#κακῶν ἄνατος τῆσδ' ἀπαλλαχθῇ χθονός.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:787.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:787.1.text#οὐκ ἔστι σοι ταῦτ', ἀλλά σοι τάδ' ἔστ', ἐκεῖ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:788.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:788.1.text#χώρας ἀλάστωρ οὑμὸς ἐνναίων ἀεί·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:789.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:789.1.text#ἔστιν δὲ παισὶ τοῖς ἐμοῖσι τῆς ἐμῆς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:790.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:790.1.text#χθονὸς λαχεῖν τοσοῦτον, ἐνθανεῖν μόνον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:791.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:791.1.text#ἆρ' οὐκ ἄμεινον ἢ σὺ τἀν Θήβαις φρονῶ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:792.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:792.1.text#πολλῷ γ', ὅσῳπερ κἀκ σαφεστέρων κλύω,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:793.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:793.1.text#Φοίβου τε καὐτοῦ Ζηνός, ὃς κείνου πατήρ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:794.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:794.1.text#τὸ σὸν δ' ἀφῖκται δεῦρ' ὑπόβλητον στόμα,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:795.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:795.1.text#πολλὴν ἔχον στόμωσιν·  ἐν δὲ τῷ λέγειν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:796.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:796.1.text#κάκ' ἂν λάβοις τὰ πλείον' ἢ σωτήρια.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:797.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:797.1.text#ἀλλ' οἶδα γάρ σε ταῦτα μὴ πείθων, ἴθι·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:798.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:798.1.text#ἡμᾶς δ' ἔα ζῆν ἐνθάδ'·  οὐ γὰρ ἂν κακῶς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:799.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:799.1.text#οὐδ' ὧδ' ἔχοντες ζῷμεν, εἰ τερποίμεθα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:800.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:800.1.text#πότερα νομίζεις δυστυχεῖν ἔμ' ἐς τὰ σά,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:801.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:801.1.text#ἤ σ' εἰς τὰ σαυτοῦ μᾶλλον, { ἐν } τῷ νῦν λόγῳ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:802.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:802.1.text#ἐμοὶ μέν ἐσθ' ἥδιστον, εἰ σὺ μήτ' ἐμὲ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:803.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:803.1.text#πείθειν οἷός τ' εἶ μήτε τούσδε τοὺς πέλας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:804.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:804.1.text#ὦ δύσμορ', οὐδὲ τῷ χρόνῳ φύσας φανεῖ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:805.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:805.1.text#φρένας ποτ' ἀλλὰ λῦμα τῷ γήρᾳ τρέφει;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:806.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:806.1.text#γλώσσῃ σὺ δεινός·  ἄνδρα δ' οὐδέν' οἶδ' ἐγὼ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:807.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:807.1.text#δίκαιον ὅστις ἐξ ἅπαντος εὖ λέγει.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:808.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:808.1.text#χωρὶς τό τ' εἰπεῖν πολλὰ καὶ τὰ καίρια.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:809.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:809.1.text#ὡς δὴ σὺ βραχέα, ταῦτα δ' ἐν καιρῷ λέγεις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:810.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:810.1.text#οὐ δῆθ'  ὅτῳ γε νοῦς ἴσος καὶ σοὶ πάρα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:811.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:811.1.text#ἄπελθ', ἐρῶ γὰρ καὶ πρὸ τῶνδε, μηδέ με
urn:cts:greekLit:tlg0011.tlg007.fu.sp:812.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:812.1.text#φύλασσ' ἐφορμῶν ἔνθα χρὴ ναίειν ἐμέ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:813.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:813.1.text#μαρτύρομαι τούσδ', οὐ σέ· πρὸς δὲ τοὺς φίλους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:814.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:814.1.text#οἷ' ἀνταμείβει ῥήματ', ἤν σ' ἕλω ποτέ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:815.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:815.1.text#τίς δ' ἄν με τῶνδε συμμάχων ἕλοι βίᾳ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:816.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:816.1.text#ἦ μὴν σὺ κἄνευ τοῦδε λυπηθεὶς ἔσει.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:817.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:817.1.text#ποίῳ σὺν ἔργῳ τοῦτ' ἀπειλήσας ἔχεις;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:818.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:818.1.text#παίδοιν δυοῖν σοι τὴν μὲν ἀρτίως ἐγὼ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:819.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:819.1.text#ξυναρπάσας ἔπεμψα, τὴν δ' ἄξω τάχα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:820.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:820.1.text#οἴμοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:820.2.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:820.2.text#τάχ'  ἕξεις μᾶλλον οἰμώζειν τάδε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:821.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:821.1.text#τὴν παῖδ' ἔχεις μου;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:821.2.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:821.2.text#τήνδε τ' οὐ μακροῦ χρόνου.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:822.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:822.1.text#ἰὼ ξένοι, τί δράσετ'; ἦ προδώσετε,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:823.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:823.1.text#κοὐκ ἐξελᾶτε τὸν ἀσεβῆ τῆσδε χθονός;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:824.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:824.1.text#χώρει, ξέν', ἔξω θᾶσσον.  οὔτε γὰρ τὰ νῦν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:825.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:825.1.text#δίκαια πράσσεις οὔθ' ἃ πρόσθεν εἴργασαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:826.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:826.1.text#ὑμῖν ἂν εἴη τήνδε καιρὸς ἐξάγειν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:827.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:827.1.text#ἄκουσαν, εἰ θέλουσα μὴ πορεύεται.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:828.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:828.1.text#οἴμοι τάλαινα, ποῖ φύγω; ποίαν λάβω 
urn:cts:greekLit:tlg0011.tlg007.fu.sp:829.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:829.1.text#θεῶν ἄρηξιν ἢ βροτῶν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:829.2.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:829.2.text#τί δρᾷς, ξένε;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:830.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:830.1.text#οὐχ ἅψομαι τοῦδ' ἀνδρός, ἀλλὰ τῆς ἐμῆς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:831.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:831.1.text#ὦ γῆς ἄνακτες.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:831.2.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:831.2.text#ὦ ξέν', οὐ δίκαια δρᾷς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:832.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:832.1.text#δίκαια.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:832.2.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:832.2.text#πῶς δίκαια;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:832.3.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:832.3.text#τοὺς ἐμοὺς ἄγω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:833.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:833.1.text#ἰὼ πόλις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:834.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:834.1.text#τί δρᾷς, ὦ ξέν'; οὐκ ἀφήσεις; τάχ' εἰς βάσανον εἶ χερῶν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:835.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:835.1.text#εἴργου.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:835.2.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:835.2.text#σοῦ μὲν οὔ, τάδε γε μωμένου.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:836.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:836.1.text#πόλει μαχεῖ γάρ, εἴ τι πημανεῖς ἐμέ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:837.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:837.1.text#οὐκ ἠγόρευον ταῦτ' ἐγώ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:837.2.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:837.2.text#μέθες χεροῖν 
urn:cts:greekLit:tlg0011.tlg007.fu.sp:838.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:838.1.text#τὴν παῖδα θᾶσσον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:838.2.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:838.2.text#μὴ 'πίτασσ' ἃ μὴ κρατεῖς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:840.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:840.1.text#χαλᾶν λέγω σοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:840.2.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:840.2.text#σοὶ  δ' ἔγωγ' ὁδοιπορεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:841.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:841.1.text#πρόβαθ' ὧδε, βᾶτε βᾶτ', ἔντοποι·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:842.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:842.1.text#πόλις ἐναίρεται, πόλις ἐμά, σθένει·  πρόβαθ' ὧδέ μοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:843.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:843.1.text#ἀφέλκομαι δύστηνος,  ὦ ξένοι ξένοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:844.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:844.1.text#ποῦ, τέκνον, εἴ μοι;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:844.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:844.2.text#πρὸς βίαν πορεύομαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:845.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:845.1.text#ὄρεξον, ὦ παῖ, χεῖρας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:845.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:845.2.text#ἀλλ' οὐδὲν σθένω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:846.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:846.1.text#οὐκ ἄξεθ' ὑμεῖς;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:846.2.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:846.2.text#ὦ τάλας ἐγώ, τάλας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:848.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:848.1.text#οὔκουν ποτ' ἐκ τούτοιν γε μὴ σκήπτροιν ἔτι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:849.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:849.1.text#ὁδοιπορήσῃς·  ἀλλ' ἐπεὶ νικᾶν θέλεις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:850.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:850.1.text#πατρίδα τε τὴν σὴν καὶ φίλους, ὑφ'  ὧν ἐγὼ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:851.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:851.1.text#ταχθεὶς τάδ' ἔρδω, καὶ τύραννος ὢν ὅμως,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:852.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:852.1.text#νίκα.  χρόνῳ γάρ, οἶδ' ἐγώ, γνώσει τάδε,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:853.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:853.1.text#ὁθούνεκ' αὐτὸς αὑτὸν οὔτε νῦν καλὰ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:854.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:854.1.text#δρᾷς οὔτε πρόσθεν εἰργάσω βίᾳ φίλων,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:855.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:855.1.text#ὀργῇ χάριν δούς, ἥ σ' ἀεὶ λυμαίνεται.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:856.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:856.1.text#ἐπίσχες αὐτοῦ,  ξεῖνε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:856.2.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:856.2.text#μὴ ψαύειν λέγω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:857.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:857.1.text#οὔτοι σ' ἀφήσω, τῶνδέ γ' ἐστερημένος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:858.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:858.1.text#καὶ μεῖζον ἆρα ῥύσιον πόλει τάχα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:859.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:859.1.text#θήσεις·  ἐφάψομαι γὰρ οὐ ταύταιν μόναιν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:860.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:860.1.text#ἀλλ' ἐς τί τρέψει;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:860.2.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:860.2.text#τόνδ'  ἀπάξομαι λαβών.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:861.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:861.1.text#δεινὸν λέγοις ἄν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:861.2.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:861.2.text#τοῦτο νῦν πεπράξεται.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:862.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:862.1.text#ἢν μή σ' ὁ κραίνων τῆσδε γῆς ἀπειργάθῃ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:863.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:863.1.text#ὦ φθέγμ' ἀναιδές, ἦ σὺ γὰρ ψαύσεις ἐμοῦ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:864.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:864.1.text#αὐδῶ σιωπᾶν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:864.2.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:864.2.text#μὴ γὰρ αἵδε δαίμονες
urn:cts:greekLit:tlg0011.tlg007.fu.sp:865.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:865.1.text#θεῖέν μ' ἄφωνον τῆσδε τῆς ἀρᾶς ἔτι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:866.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:866.1.text#ὅς μ', ὦ κάκιστε, ψιλὸν ὄμμ' ἀποσπάσας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:867.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:867.1.text#πρὸς ὄμμασιν τοῖς πρόσθεν ἐξοίχει βίᾳ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:868.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:868.1.text#τοιγὰρ σέ τ' αὐτὸν καὶ γένος τὸ σὸν θεῶν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:869.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:869.1.text#ὁ πάντα λεύσσων Ἥλιος δοίη βίον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:870.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:870.1.text#τοιοῦτον οἷον κἀμὲ γηρᾶναί ποτε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:871.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:871.1.text#ὁρᾶτε ταῦτα, τῆσδε γῆς ἐγχώριοι;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:872.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:872.1.text#ὁρῶσι κἀμὲ καὶ σέ, καὶ φρονοῦσ' ὅτι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:873.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:873.1.text#ἔργοις πεπονθὼς ῥήμασίν σ' ἀμύνομαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:874.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:874.1.text#οὔτοι καθέξω θυμόν, ἀλλ' ἄξω βίᾳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:875.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:875.1.text#κεἰ μοῦνός εἰμι τόνδε καὶ χρόνῳ βραδύς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:876.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:876.1.text#ἰὼ τάλας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:877.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:877.1.text#ὅσον λῆμ' ἔχων ἀφίκου, ξέν', εἰ τάδε δοκεῖς τελεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:878.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:878.1.text#δοκῶ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:879.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:879.1.text#τάνδ' ἄρ' οὐκέτι νεμῶ πόλιν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:880.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:880.1.text#τοῖς τοι δικαίοις χὠ βραχὺς νικᾷ μέγαν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:881.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:881.1.text#ἀκούεθ' οἷα φθέγγεται;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:881.2.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:881.2.text#τά γ' οὐ τελεῖ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:882.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:882.1.text#[ ἴστω μέγας Ζεύς. ]
urn:cts:greekLit:tlg0011.tlg007.fu.sp:883.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:883.1.text#Ζεύς γ' ἂν εἰδείη, σὺ δ' οὔ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:884.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:884.1.text#ἆρ' οὐχ ὕβρις τάδ';
urn:cts:greekLit:tlg0011.tlg007.fu.sp:884.2.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:884.2.text#ὕβρις, ἀλλ' ἀνεκτέα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:885.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:885.1.text#ἰὼ πᾶς λεώς, ἰὼ γᾶς πρόμοι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:886.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:886.1.text#μόλετε σὺν τάχει, μόλετ', ἐπεὶ πέραν περῶσ' οἵδε δή.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:887.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:887.1.text#τίς ποθ' ἡ βοή; τί τοὔργον; ἐκ τίνος φόβου ποτὲ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:888.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:888.1.text#βουθυτοῦντά μ' ἀμφὶ βωμὸν ἔσχετ' ἐναλίῳ θεῷ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:889.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:889.1.text#τοῦδ' ἐπιστάτῃ Κολωνοῦ; λέξαθ', ὡς εἰδῶ τὸ πᾶν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:890.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:890.1.text#οὗ χάριν δεῦρ' ᾖξα θᾶσσον ἢ καθ' ἡδονὴν ποδός.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:891.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:891.1.text#ὦ φίλτατ', ἔγνων γὰρ τὸ προσφώνημά σου,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:892.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:892.1.text#πέπονθα δεινὰ τοῦδ' ὑπ' ἀνδρὸς ἀρτίως.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:893.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:893.1.text#τὰ ποῖα ταῦτα, τίς δ' ὁ πημήνας; λέγε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:894.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:894.1.text#Κρέων ὅδ', ὃν δέδορκας, οἴχεται τέκνων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:895.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:895.1.text#ἀποσπάσας μου τὴν μόνην ξυνωρίδα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:896.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:896.1.text#πῶς εἶπας;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:896.2.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:896.2.text#οἷά περ πέπονθ' ἀκήκοας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:897.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:897.1.text#οὔκουν τις ὡς τάχιστα προσπόλων μολὼν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:898.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:898.1.text#πρὸς τούσδε βωμούς, πάντ' ἀναγκάσει λεὼν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:899.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:899.1.text#ἄνιππον ἱππότην τε θυμάτων ἄπο
urn:cts:greekLit:tlg0011.tlg007.fu.sp:900.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:900.1.text#σπεύδειν ἀπὸ ῥυτῆρος, ἔνθα δίστομοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:901.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:901.1.text#μάλιστα συμβάλλουσιν ἐμπόρων ὁδοί,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:902.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:902.1.text#ὡς μὴ παρέλθωσ' αἱ κόραι, γέλως δ' ἐγὼ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:903.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:903.1.text#ξένῳ γένωμαι τῷδε, χειρωθεὶς βίᾳ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:904.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:904.1.text#ἴθ', ὡς ἄνωγα, σὺν τάχει.  τοῦτον δ' ἐγώ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:905.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:905.1.text#εἰ μὲν δι' ὀργῆς ἧκον, ἧς ὅδ' ἄξιος,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:906.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:906.1.text#ἄτρωτον οὐ μεθῆκ' ἂν ἐξ ἐμῆς χερός.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:907.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:907.1.text#νῦν δ' οὕσπερ αὐτὸς τοὺς νόμους εἰσῆλθ' ἔχων,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:908.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:908.1.text#τούτοισι κοὐκ ἄλλοισιν ἁρμοσθήσεται.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:909.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:909.1.text#οὐ γάρ ποτ' ἔξει τῆσδε τῆς χώρας, πρὶν ἂν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:910.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:910.1.text#κείνας ἐναργεῖς δεῦρό μοι στήσῃς ἄγων·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:911.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:911.1.text#ἐπεὶ δέδρακας οὔτ' ἐμοῦ καταξίως
urn:cts:greekLit:tlg0011.tlg007.fu.sp:912.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:912.1.text#οὔθ' ὧν πέφυκας αὐτὸς οὔτε σῆς χθονός·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:913.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:913.1.text#ὅστις δίκαι' ἀσκοῦσαν εἰσελθὼν πόλιν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:914.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:914.1.text#κἄνευ νόμου κραίνουσαν οὐδέν, εἶτ' ἀφεὶς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:915.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:915.1.text#τὰ τῆσδε τῆς γῆς κύρι', ὧδ' ἐπεισπεσὼν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:916.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:916.1.text#ἄγεις θ' ἃ χρῄζεις καὶ παρίστασαι βίᾳ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:917.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:917.1.text#καί μοι πόλιν κένανδρον ἢ δούλην τινὰ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:918.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:918.1.text#ἔδοξας εἶναι κἄμ' ἴσον τῷ μηδενί.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:919.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:919.1.text#καίτοι σε Θῆβαί γ' οὐκ ἐπαίδευσαν κακόν·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:920.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:920.1.text#οὐ γὰρ φιλοῦσιν ἄνδρας ἐκδίκους τρέφειν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:921.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:921.1.text#οὐδ' ἄν σ' ἐπαινέσειαν, εἰ πυθοίατο
urn:cts:greekLit:tlg0011.tlg007.fu.sp:922.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:922.1.text#συλῶντα τἀμὰ καὶ τὰ τῶν θεῶν, βίᾳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:923.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:923.1.text#ἄγοντα φωτῶν ἀθλίων ἱκτήρια.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:924.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:924.1.text#οὔκουν ἔγωγ' ἂν σῆς ἐπεμβαίνων χθονός,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:925.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:925.1.text#οὐδ' εἰ τὰ πάντων εἶχον ἐνδικώτατα,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:926.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:926.1.text#ἄνευ γε τοῦ κραίνοντος, ὅστις ἦν, χθονὸς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:927.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:927.1.text#οὔθ' εἷλκον οὔτ' ἂν ἦγον, ἀλλ' ἠπιστάμην
urn:cts:greekLit:tlg0011.tlg007.fu.sp:928.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:928.1.text#ξένον παρ' ἀστοῖς ὡς διαιτᾶσθαι χρεών.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:929.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:929.1.text#σὺ δ' ἀξίαν οὐκ οὖσαν αἰσχύνεις πόλιν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:930.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:930.1.text#τὴν αὐτὸς αὑτοῦ, καί σ'  ὁ πληθύων χρόνος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:931.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:931.1.text#γέρονθ' ὁμοῦ τίθησι καὶ τοῦ νοῦ κενόν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:932.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:932.1.text#εἶπον μὲν οὖν καὶ πρόσθεν, ἐννέπω δὲ νῦν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:933.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:933.1.text#τὰς παῖδας ὡς τάχιστα δεῦρ' ἄγειν τινά,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:934.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:934.1.text#εἰ μὴ μέτοικος τῆσδε τῆς χώρας θέλεις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:935.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:935.1.text#εἶναι βίᾳ τε κοὐχ ἑκών·  καὶ ταῦτά σοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:936.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:936.1.text#τῷ νῷ θ' ὁμοίως κἀπὸ τῆς γλώσσης λέγω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:937.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:937.1.text#ὁρᾷς ἵν' ἥκεις, ὦ ξέν'; ὡς ἀφ' ὧν μὲν εἶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:938.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:938.1.text#φαίνει δίκαιος, δρῶν δ' ἐφευρίσκει κακά.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:939.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:939.1.text#ἐγὼ οὔτ' ἄνανδρον τήνδε τὴν πόλιν νέμων,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:940.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:940.1.text#ὦ τέκνον Αἰγέως, οὔτ' ἄβουλον, ὡς σὺ φῄς,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:941.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:941.1.text#τοὔργον τόδ' ἐξέπραξα, γιγνώσκων δ' ὅτι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:942.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:942.1.text#οὐδείς ποτ' αὐτοὺς τῶν ἐμῶν ἂν ἐμπέσοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:943.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:943.1.text#ζῆλος ξυναίμων, ὥστ' ἐμοῦ τρέφειν βίᾳ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:944.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:944.1.text#ᾔδη δ' ὁθούνεκ' ἄνδρα καὶ πατροκτόνον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:945.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:945.1.text#κἄναγνον οὐ δεξοίατ', οὐδ' ὅτῳ γάμοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:946.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:946.1.text#ξυνόντες ηὑρέθησαν ἀνόσιοι τέκνων.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:947.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:947.1.text#τοιοῦτον αὐτοῖς Ἄρεος εὔβουλον πάγον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:948.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:948.1.text#ἐγὼ ξυνῄδη χθόνιον ὄνθ', ὃς οὐκ ἐᾷ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:949.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:949.1.text#τοιούσδ' ἀλήτας τῇδ' ὁμοῦ ναίειν πόλει·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:950.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:950.1.text#ᾧ πίστιν ἴσχων τήνδ' ἐχειρούμην ἄγραν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:951.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:951.1.text#καὶ ταῦτ' ἂν οὐκ ἔπρασσον, εἰ μή μοι πικρὰς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:952.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:952.1.text#αὐτῷ τ' ἀρὰς ἠρᾶτο καὶ τὠμῷ γένει·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:953.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:953.1.text#ἀνθ' ὧν πεπονθὼς ἠξίουν τάδ' ἀντιδρᾶν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:954.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:954.1.text#θυμοῦ γὰρ οὐδὲν γῆράς ἐστιν ἄλλο πλὴν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:955.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:955.1.text#θανεῖν·  θανόντων δ' οὐδὲν ἄλγος ἅπτεται.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:956.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:956.1.text#πρὸς ταῦτα πράξεις οἷον ἂν θέλῃς·  ἐπεὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:957.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:957.1.text#ἐρημία με, κεἰ δίκαι', ὅμως λέγω,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:958.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:958.1.text#σμικρὸν τίθησι· πρὸς δὲ τὰς πράξεις ὅμως,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:959.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:959.1.text#καὶ τηλικόσδ' ὤν, ἀντιδρᾶν πειράσομαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:960.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:960.1.text#ὦ λῆμ'  ἀναιδές, τοῦ καθυβρίζειν δοκεῖς,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:961.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:961.1.text#πότερον ἐμοῦ γέροντος ἢ σαυτοῦ, τόδε;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:962.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:962.1.text#ὅστις φόνους μοι καὶ γάμους καὶ συμφορὰς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:963.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:963.1.text#τοῦ σοῦ διῆκας στόματος, ἃς ἐγὼ τάλας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:964.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:964.1.text#ἤνεγκον ἄκων·  θεοῖς γὰρ ἦν οὕτω φίλον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:965.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:965.1.text#τάχ' ἄν τι μηνίουσιν εἰς γένος πάλαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:966.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:966.1.text#ἐπεὶ καθ' αὑτόν γ' οὐκ ἂν ἐξεύροις ἐμοὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:967.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:967.1.text#ἁμαρτίας ὄνειδος οὐδέν, ἀνθ' ὅτου
urn:cts:greekLit:tlg0011.tlg007.fu.sp:968.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:968.1.text#τάδ' εἰς ἐμαυτὸν τοὺς ἐμούς θ' ἡμάρτανον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:969.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:969.1.text#ἐπεὶ δίδαξον, εἴ τι θέσφατον πατρὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:970.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:970.1.text#χρησμοῖσιν ἱκνεῖθ' ὥστε πρὸς παίδων θανεῖν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:971.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:971.1.text#πῶς ἂν δικαίως τοῦτ' ὀνειδίζοις ἐμοί,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:972.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:972.1.text#ὃς οὔτε βλάστας πω γενεθλίους πατρός,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:973.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:973.1.text#οὐ μητρὸς εἶχον, ἀλλ' ἀγέννητος τότ' ἦ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:974.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:974.1.text#εἰ δ' αὖ φανεὶς δύστηνος, ὡς ἐγὼ 'φάνην,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:975.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:975.1.text#ἐς χεῖρας ἦλθον πατρὶ καὶ κατέκτανον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:976.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:976.1.text#μηδὲν ξυνιεὶς ὧν ἔδρων εἰς οὕς τ' ἔδρων,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:977.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:977.1.text#πῶς ἂν τό γ' ἆκον πρᾶγμ' ἂν εἰκότως ψέγοις;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:978.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:978.1.text#μητρὸς δέ, τλῆμον, οὐκ ἐπαισχύνει γάμους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:979.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:979.1.text#οὔσης ὁμαίμου σῆς μ' ἀναγκάζων λέγειν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:979a.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:979a.text#οἵους ἐρῶ τάχ'·  οὐ γὰρ οὖν σιγήσομαι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:980.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:980.1.text#σοῦ γ' εἰς τόδ' ἐξελθόντος ἀνόσιον στόμα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:981.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:981.1.text#ἔτικτε γάρ μ' ἔτικτεν, ὤμοι μοι κακῶν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:982.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:982.1.text#οὐκ εἰδότ' οὐκ εἰδυῖα, καὶ τεκοῦσά με,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:983.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:983.1.text#αὑτῆς ὄνειδος παῖδας ἐξέφυσέ μοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:984.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:984.1.text#ἀλλ' ἓν γὰρ οὖν ἔξοιδα, σὲ μὲν ἑκόντ' ἐμὲ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:985.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:985.1.text#κείνην τε ταῦτα δυσστομεῖν·  ἐγὼ δέ νιν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:986.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:986.1.text#ἄκων ἔγημα φθέγγομαί τ' ἄκων τάδε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:987.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:987.1.text#ἀλλ' οὐ γὰρ οὔτ' ἐν τοῖσδ' ἁλώσομαι κακὸς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:988.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:988.1.text#γάμοισιν οὔθ' οὓς αἰὲν ἐμφορεῖς σύ μοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:990.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:990.1.text#φόνους πατρῴους ἐξονειδίζων πικρῶς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:991.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:991.1.text#ἓν γάρ μ' ἄμειψαι μοῦνον ὧν σ' ἀνιστορῶ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:992.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:992.1.text#εἴ τις σὲ τὸν δίκαιον αὐτίκ' ἐνθάδε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:993.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:993.1.text#κτείνοι παραστάς,   πότερα πυνθάνοι' ἂν εἰ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:994.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:994.1.text#πατήρ σ' ὁ καίνων ἢ τίνοι' ἂν εὐθέως;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:995.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:995.1.text#δοκῶ μέν, εἴπερ ζῆν φιλεῖς, τὸν αἴτιον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:996.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:996.1.text#τίνοι' ἂν οὐδὲ τοὔνδικον περιβλέποις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:997.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:997.1.text#τοιαῦτα μέντοι καὐτὸς εἰσέβην κακά,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:998.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:998.1.text#θεῶν ἀγόντων·  οἷς ἐγὼ οὐδὲ τὴν πατρὸς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:999.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:999.1.text#ψυχὴν ἂν οἶμαι ζῶσαν ἀντειπεῖν ἐμοί.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1000.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1000.1.text#σὺ δ', εἶ γὰρ οὐ δίκαιος, ἀλλ' ἅπαν καλὸν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1001.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1001.1.text#λέγειν νομίζων ῥητὸν ἄρρητόν τ' ἔπος,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1002.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1002.1.text#τοιαῦτ' ὀνειδίζεις με τῶνδ' ἐναντίον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1003.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1003.1.text#καί σοι τὸ Θησέως ὄνομα θωπεῦσαι καλόν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1004.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1004.1.text#καὶ τὰς Ἀθήνας, ὡς κατῴκηνται καλῶς·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1005.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1005.1.text#κᾆθ' ὧδ' ἐπαινῶν πολλὰ τοῦδ' ἐκλανθάνει,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1006.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1006.1.text#ὁθούνεκ' εἴ τις γῆ θεοὺς ἐπίσταται
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1007.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1007.1.text#τιμαῖς σεβίζειν, ἥδε τοῦθ' ὑπερφέρει·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1008.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1008.1.text#ἀφ' ἧς σὺ κλέψας τὸν ἱκέτην γέροντ' ἐμὲ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1009.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1009.1.text#αὐτόν τ' ἐχειροῦ τὰς κόρας τ' οἴχει λαβών.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1010.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1010.1.text#ἀνθ' ὧν ἐγὼ νῦν τάσδε τὰς θεὰς ἐμοὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1011.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1011.1.text#καλῶν ἱκνοῦμαι καὶ κατασκήπτω λιταῖς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1012.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1012.1.text#ἐλθεῖν ἀρωγοὺς ξυμμάχους θ', ἵν' ἐκμάθῃς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1013.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1013.1.text#οἵων ὑπ' ἀνδρῶν ἥδε φρουρεῖται πόλις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1014.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1014.1.text#ὁ ξεῖνος, ὦναξ, χρηστός·  αἱ δὲ συμφοραὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1015.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1015.1.text#αὐτοῦ πανώλεις, ἄξιαι δ' ἀμυναθεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1016.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1016.1.text#ἅλις λόγων, ὡς οἱ μὲν ἐξειργασμένοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1017.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1017.1.text#σπεύδουσιν, ἡμεῖς δ' οἱ παθόντες ἕσταμεν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1018.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1018.1.text#τί δῆτ' ἀμαυρῷ φωτὶ προστάσσεις ποεῖν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1019.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1019.1.text#ὁδοῦ κατάρχειν τῆς ἐκεῖ, πομπὸν δέ με
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1020.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1020.1.text#χωρεῖν, ἵν', εἰ μὲν ἐν τόποισι τοῖσδ' ἔχεις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1021.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1021.1.text#τὰς παῖδας ἡμῖν  αὐτὸς ἐκδείξῃς ἐμοί·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1022.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1022.1.text#εἰ δ' ἐγκρατεῖς φεύγουσιν, οὐδὲν δεῖ πονεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1023.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1023.1.text#ἄλλοι γὰρ οἱ σπεύδοντες, οὓς οὐ μή ποτε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1024.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1024.1.text#χώρας φυγόντες τῆσδ' ἐπεύξωνται θεοῖς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1025.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1025.1.text#ἀλλ' ἐξυφηγοῦ·  γνῶθι δ' ὡς ἔχων ἔχει
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1026.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1026.1.text#καί σ' εἷλε θηρῶνθ' ἡ τύχη·  τὰ γὰρ δόλῳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1027.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1027.1.text#τῷ μὴ δικαίῳ κτήματ' οὐχὶ σῴζεται.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1028.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1028.1.text#κοὐκ ἄλλον ἕξεις εἰς τάδ'·  ὡς ἔξοιδά σε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1029.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1029.1.text#οὐ ψιλὸν οὐδ' ἄσκευον ἐς τοσήνδ' ὕβριν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1030.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1030.1.text#ἥκοντα τόλμης τῆς παρεστώσης τανῦν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1031.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1031.1.text#ἀλλ' ἔσθ' ὅτῳ σὺ πιστὸς ὢν ἔδρας τάδε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1032.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1032.1.text#ἃ δεῖ μ' ἀθρῆσαι, μηδὲ τήνδε τὴν πόλιν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1033.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1033.1.text#ἑνὸς ποῆσαι φωτὸς ἀσθενεστέραν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1034.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1034.1.text#νοεῖς τι τούτων, ἢ μάτην τὰ νῦν τέ σοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1035.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1035.1.text#δοκεῖ λελέχθαι χὤτε ταῦτ' ἐμηχανῶ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1036.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1036.1.text#οὐδὲν σὺ μεμπτὸν ἐνθάδ' ὢν ἐρεῖς ἐμοί·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1037.1.speaker#Κρέων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1037.1.text#οἴκοι δὲ χἠμεῖς εἰσόμεσθ' ἃ χρὴ ποεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1038.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1038.1.text#χωρῶν ἀπείλει νῦν·  σὺ δ' ἡμίν, Οἰδίπους,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1039.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1039.1.text#ἕκηλος αὐτοῦ μίμνε, πιστωθεὶς ὅτι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1040.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1040.1.text#ἢν μὴ θάνω 'γὼ πρόσθεν, οὐχὶ παύσομαι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1041.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1041.1.text#πρὶν ἄν σε τῶν σῶν κύριον στήσω τέκνων.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1042.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1042.1.text#ὄναιο, Θησεῦ, τοῦ τε γενναίου χάριν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1043.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1043.1.text#καὶ τῆς πρὸς ἡμᾶς ἐνδίκου προμηθίας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1044.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1044.1.text#εἴην ὅθι δαΐων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1045.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1045.1.text#ἀνδρῶν τάχ' ἐπιστροφαὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1046.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1046.1.text#τὸν χαλκοβόαν Ἄρη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1047.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1047.1.text#μείξουσιν, ἢ πρὸς Πυθίαις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1048.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1048.1.text#ἢ λαμπάσιν ἀκταῖς,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1050.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1050.1.text#οὗ πότνιαι σεμνὰ τιθηνοῦνται τέλη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1051.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1051.1.text#θνατοῖσιν, ὧν καὶ χρυσέα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1052.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1052.1.text#κλῂς ἐπὶ γλώσσᾳ βέβακε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1053.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1053.1.text#προσπόλων Εὐμολπιδᾶν·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1054.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1054.1.text#ἔνθ' οἶμαι τὸν ἐγρεμάχαν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1055.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1055.1.text#Θησέα καὶ τὰς διστόλους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1056.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1056.1.text#ἀδμῆτας ἀδελφὰς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1057.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1057.1.text#αὐτάρκει τάχ' ἐμμίξειν βοᾷ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1058.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1058.1.text#τούσδ' ἀνὰ χώρους·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1059.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1059.1.text#ἤ που τὸν ἐφεσπέρου
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1060.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1060.1.text#πέτρας νιφάδος πελῶσ'
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1061.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1061.1.text#Οἰάτιδος εἰς νόμον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1062.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1062.1.text#πώλοισιν ἢ ῥιμφαρμάτοις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1063.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1063.1.text#φεύγοντες ἁμίλλαις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1065.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1065.1.text#ἁλώσεται·  δεινὸς ὁ προσχώρων Ἄρης,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1066.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1066.1.text#δεινὰ δὲ Θησειδᾶν ἀκμά.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1067.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1067.1.text#πᾶς γὰρ ἀστράπτει χαλινός,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1068.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1068.1.text#πᾶσα δ' ὁρμᾶται καθεῖσ'
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1069.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1069.1.text#ἀμπυκτήρια  στομίων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1070.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1070.1.text#ἄμβασις, οἳ τὰν ἱππίαν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1071.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1071.1.text#τιμῶσιν Ἀθάναν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1072.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1072.1.text#καὶ τὸν πόντιον γαιάοχον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1073.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1073.1.text#Ῥέας φίλον υἱόν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1074.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1074.1.text#ἔρδουσ' ἢ μέλλουσιν;  ὡς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1075.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1075.1.text#προμνᾶταί τί μοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1076.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1076.1.text#γνώμα τάχ' ἀντάσειν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1077.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1077.1.text#τᾶν δεινὰ τλασᾶν, δεινὰ δ' εὑρουσᾶν πρὸς αὐθαίμων πάθη.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1078.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1078.1.text#τελεῖ τελεῖ Ζεύς τι κατ' ἆμαρ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1079.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1079.1.text#μάντις εἴμ' ἐσθλῶν ἀγώνων.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1079a.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1079a.text#εἴθ' ἀελλαία ταχύρρωστος πελειὰς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1080.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1080.1.text#αἰθερίας νεφέλας κύρσαιμ'  ἄνωθ'  ἀγώνων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1081.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1081.1.text#αἰωρήσασα  τοὐμὸν ὄμμα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1085.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1085.1.text#ἰὼ θεῶν πάνταρχε, παντ-
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1086.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1086.1.text#όπτα Ζεῦ, πόροις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1087.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1087.1.text#γᾶς τᾶσδε δαμούχοις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1088.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1088.1.text#σθένει 'πινικείῳ τὸν εὔαγρον τελειῶσαι λόχον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1090.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1090.1.text#σεμνά τε παῖς Παλλὰς Ἀθάνα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1091.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1091.1.text#καὶ τὸν ἀγρευτὰν Ἀπόλλω
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1092.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1092.1.text#καὶ κασιγνήταν πυκνοστίκτων ὀπαδὸν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1093.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1093.1.text#ὠκυπόδων ἐλάφων στέργω διπλᾶς ἀρωγὰς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1094.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1094.1.text#μολεῖν γᾷ τᾷδε καὶ πολίταις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1095.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1095.1.text#ὦ ξεῖν' ἀλῆτα, τῷ σκοπῷ μὲν οὐκ ἐρεῖς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1096.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1096.1.text#ὡς ψευδόμαντις·  τὰς κόρας γὰρ εἰσορῶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1097.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1097.1.text#τάσδ' ἆσσον αὖθις ὧδε προσπολουμένας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1098.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1098.1.text#ποῦ ποῦ; τί φής; πῶς εἶπας;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1099.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1099.1.text#ὦ πάτερ πάτερ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1100.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1100.1.text#τίς ἂν θεῶν σοι τόνδ' ἄριστον ἄνδρ' ἰδεῖν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1101.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1101.1.text#δοίη, τὸν ἡμᾶς δεῦρο προσπέμψαντά σοι;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1102.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1102.1.text#ὦ τέκνον, ἦ πάρεστον;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1102.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1102.2.text#αἵδε γὰρ χέρες
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1103.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1103.1.text#Θησέως ἔσωσαν φιλτάτων τ' ὀπαόνων.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1104.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1104.1.text#προσέλθετ' ὦ παῖ, πατρὶ καὶ τὸ μηδαμὰ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1105.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1105.1.text#ἐλπισθὲν ἥξειν σῶμα βαστάσαι δότε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1106.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1106.1.text#αἰτεῖς ἃ τεύξει· σὺν πόθῳ γὰρ ἡ χάρις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1107.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1107.1.text#ποῦ δῆτα, ποῦ 'στόν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1107.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1107.2.text#αἵδ' ὁμοῦ πελάζομεν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1108.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1108.1.text#ὦ φίλτατ' ἔρνη.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1108.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1108.2.text#τῷ τεκόντι πᾶν φίλον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1109.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1109.1.text#ὦ σκῆπτρα φωτός.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1109.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1109.2.text#δυσμόρου γε δύσμορα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1110.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1110.1.text#ἔχω τὰ φίλτατ', οὐδ'  ἔτ'  ἂν πανάθλιος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1111.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1111.1.text#θανὼν ἂν εἴην σφῷν παρεστώσαιν ἐμοί.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1112.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1112.1.text#ἐρείσατ', ὦ παῖ, πλευρὸν ἀμφιδέξιον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1113.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1113.1.text#ἐμφύντε  τῷ φύσαντι, κἀναπαύσατον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1114.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1114.1.text#τοῦ πρόσθ' ἐρήμου τοῦδε δυστήνου πλάνου.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1115.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1115.1.text#καί μοι τὰ πραχθέντ' εἴπαθ' ὡς βράχιστ', ἐπεὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1116.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1116.1.text#ταῖς τηλικαῖσδε σμικρὸς ἐξαρκεῖ λόγος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1117.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1117.1.text#ὅδ' ἔσθ' ὁ σώσας·  τοῦδε χρὴ κλύειν, πάτερ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1118.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1118.1.text#οὗ κἄστι τοὔργον·  τοὐμὸν ὧδ' ἔσται βραχύ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1119.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1119.1.text#ὦ ξεῖνε, μὴ θαύμαζε, πρὸς τὸ λιπαρὲς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1120.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1120.1.text#τέκν'  εἰ φανέντ'  ἄελπτα μηκύνω λόγον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1121.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1121.1.text#ἐπίσταμαι γὰρ τήνδε τὴν ἐς τάσδε μοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1122.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1122.1.text#τέρψιν παρ' ἄλλου μηδενὸς πεφασμένην·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1123.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1123.1.text#σὺ  γάρ νιν ἐξέσωσας, οὐκ ἄλλος βροτῶν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1124.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1124.1.text#καί σοι θεοὶ πόροιεν ὡς ἐγὼ θέλω,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1125.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1125.1.text#αὐτῷ τε καὶ γῇ τῇδ', ἐπεὶ τό γ' εὐσεβὲς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1126.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1126.1.text#μόνοις παρ' ὑμῖν ηὗρον ἀνθρώπων ἐγὼ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1127.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1127.1.text#καὶ τοὐπιεικὲς καὶ τὸ μὴ ψευδοστομεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1128.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1128.1.text#εἰδὼς δ' ἀμύνω τοῖσδε τοῖς λόγοις τάδε·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1129.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1129.1.text#ἔχω γὰρ ἅχω διὰ σὲ κοὐκ ἄλλον βροτῶν·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1130.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1130.1.text#καί μοι χέρ', ὦναξ, δεξιὰν ὄρεξον, ὡς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1131.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1131.1.text#ψαύσω φιλήσω τ', εἰ θέμις, τὸ σὸν κάρα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1132.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1132.1.text#καίτοι τί φωνῶ; πῶς σ' ἂν ἄθλιος γεγὼς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1133.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1133.1.text#θιγεῖν θελήσαιμ' ἀνδρός, ᾧ τίς οὐκ ἔνι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1134.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1134.1.text#κηλὶς κακῶν ξύνοικος; οὐκ ἔγωγέ σε,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1135.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1135.1.text#οὐδ' οὖν ἐάσω·  τοῖς γὰρ ἐμπείροις βροτῶν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1136.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1136.1.text#μόνοις οἷόν τε συνταλαιπωρεῖν τάδε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1137.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1137.1.text#σὺ δ' αὐτόθεν μοι χαῖρε καὶ τὰ λοιπά μου
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1138.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1138.1.text#μέλου δικαίως, ὥσπερ ἐς τόδ' ἡμέρας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1139.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1139.1.text#οὔτ' εἴ τι μῆκος τῶν λόγων ἔθου πλέον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1140.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1140.1.text#τέκνοισι τερφθεὶς τοῖσδε, θαυμάσας ἔχω,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1141.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1141.1.text#οὔτ' εἰ πρὸ τοὐμοῦ προύλαβες τὰ τῶνδ' ἔπη.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1142.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1142.1.text#βάρος γὰρ ἡμᾶς οὐδὲν ἐκ τούτων ἔχει.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1143.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1143.1.text#οὐ γὰρ λόγοισι τὸν βίον σπουδάζομεν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1144.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1144.1.text#λαμπρὸν ποεῖσθαι μᾶλλον ἢ τοῖς δρωμένοις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1145.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1145.1.text#δείκνυμι δ'·  ὧν γὰρ ὤμοσ' οὐκ ἐψευσάμην
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1146.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1146.1.text#οὐδέν σε, πρέσβυ·  τάσδε γὰρ πάρειμ' ἄγων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1147.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1147.1.text#ζώσας, ἀκραιφνεῖς τῶν κατηπειλημένων.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1148.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1148.1.text#χὤπως μὲν ἁγὼν ᾑρέθη, τί δεῖ μάτην
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1149.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1149.1.text#κομπεῖν, ἅ γ' εἴσει καὐτὸς ἐκ ταύταιν ξυνών;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1150.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1150.1.text#λόγος δ'  ὃς ἐμπέπτωκεν ἀρτίως ἐμοὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1151.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1151.1.text#στείχοντι δεῦρο, συμβαλοῦ γνώμην, ἐπεὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1152.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1152.1.text#σμικρὸς μὲν εἰπεῖν, ἄξιος δὲ θαυμάσαι·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1153.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1153.1.text#πρᾶγος δ' ἀτίζειν οὐδὲν ἄνθρωπον χρεών.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1154.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1154.1.text#τί δ' ἔστι, τέκνον Αἰγέως; δίδασκέ με
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1155.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1155.1.text#ὡς μὴ εἰδότ' αὐτὸν μηδὲν ὧν σὺ πυνθάνει.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1156.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1156.1.text#φασίν τιν' ἡμῖν ἄνδρα, σοὶ μὲν ἔμπολιν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1157.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1157.1.text#οὐκ ὄντα, συγγενῆ δέ, προσπεσόντα πως
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1158.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1158.1.text#βωμῷ καθῆσθαι τῷ Ποσειδῶνος, παρ' ᾧ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1159.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1159.1.text#θύων ἔκυρον, ἡνίχ' ὡρμώμην ἐγώ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1160.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1160.1.text#ποδαπόν;  τί προσχρῄζοντα τῷ θακήματι·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1161.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1161.1.text#οὐκ οἶδα πλὴν ἕν·  σοῦ γάρ, ὡς λέγουσί μοι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1162.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1162.1.text#βραχύν τιν' αἰτεῖ μῦθον οὐκ ὄγκου πλέων.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1163.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1163.1.text#ποῖόν τιν'; οὐ γὰρ ἥδ' ἕδρα σμικροῦ λόγου.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1164.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1164.1.text#σοὶ φασὶν αὐτὸν ἐς λόγους ἐλθεῖν μόνον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1165.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1165.1.text#αἰτεῖν ἀπελθεῖν τ' ἀσφαλῶς τῆς δεῦρ' ὁδοῦ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1166.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1166.1.text#τίς δῆτ' ἂν εἴη τήνδ' ὁ προσθακῶν ἕδραν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1167.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1167.1.text#ὅρα κατ' Ἄργος εἴ τις ὑμὶν ἐγγενὴς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1168.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1168.1.text#ἔσθ', ὅστις ἄν σου τοῦτο προσχρῄζοι τυχεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1169.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1169.1.text#ὦ φίλτατε, σχὲς οὗπερ εἶ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1169.2.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1169.2.text#τί δ' ἔστι σοι;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1170.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1170.1.text#μή μου δεηθῇς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1170.2.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1170.2.text#πράγματος ποίου;  λέγε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1171.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1171.1.text#ἔξοιδ' ἀκούων τῶνδ' ὅς ἐσθ' ὁ προστάτης.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1172.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1172.1.text#καὶ τίς ποτ' ἐστὶν ὅν γ' ἐγὼ ψέξαιμί τι;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1173.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1173.1.text#παῖς οὑμός, ὦναξ, στυγνός, οὗ λόγων ἐγὼ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1174.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1174.1.text#ἄλγιστ' ἂν ἀνδρῶν ἐξανασχοίμην κλύων.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1175.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1175.1.text#τί δ'; οὐκ ἀκούειν ἔστι καὶ μὴ δρᾶν ἃ μὴ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1176.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1176.1.text#χρῄζεις; τί σοι τοῦτ' ἐστὶ λυπηρὸν κλύειν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1177.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1177.1.text#ἔχθιστον, ὦναξ, φθέγμα τοῦθ' ἥκει πατρί·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1178.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1178.1.text#καὶ μή μ' ἀνάγκῃ προσβάλῃς τάδ' εἰκαθεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1179.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1179.1.text#ἀλλ' εἰ τὸ θάκημ' ἐξαναγκάζει, σκόπει
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1180.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1180.1.text#μή σοι πρόνοι' ᾖ τοῦ θεοῦ φυλακτέα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1181.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1181.1.text#πάτερ, πιθοῦ μοι, κεἰ νέα παραινέσω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1182.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1182.1.text#τὸν ἄνδρ' ἔασον τόνδε τῇ θ' αὑτοῦ φρενὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1183.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1183.1.text#χάριν παρασχεῖν τῷ θεῷ θ' ἃ βούλεται,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1185.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1185.1.text#καὶ νῷν ὕπεικε τὸν κασίγνητον μολεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1186.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1186.1.text#οὐ γάρ σε, θάρσει, πρὸς βίαν παρασπάσει
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1187.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1187.1.text#γνώμης, ἃ μή σοι συμφέροντα λέξεται.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1188.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1188.1.text#λόγων δ' ἀκοῦσαι τίς βλάβη; τά τοι κακῶς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1189.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1189.1.text#ηὑρημέν' ἔργα τῷ λόγῳ μηνύεται.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1190.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1190.1.text#ἔφυσας αὐτόν·  ὥστε μηδὲ δρῶντά σε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1191.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1191.1.text#τὰ τῶν κακίστων δυσσεβέστατ', ὦ πάτερ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1192.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1192.1.text#θέμις σέ γ' εἶναι κεῖνον ἀντιδρᾶν κακῶς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1193.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1193.1.text#ἀλλ'  ἔασον·    εἰσὶ χἀτέροις γοναὶ κακαὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1194.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1194.1.text#καὶ θυμὸς ὀξύς, ἀλλὰ νουθετούμενοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1195.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1195.1.text#φίλων ἐπῳδαῖς ἐξεπᾴδονται φύσιν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1196.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1196.1.text#σὺ δ' εἰς ἐκεῖνα, μὴ τὰ νῦν, ἀποσκόπει
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1197.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1197.1.text#πατρῷα καὶ μητρῷα πήμαθ' ἅπαθες·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1198.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1198.1.text#κἂν κεῖνα λεύσσῃς, οἶδ' ἐγώ, γνώσει κακοῦ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1199.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1199.1.text#θυμοῦ τελευτὴν ὡς κακὴ προσγίγνεται.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1200.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1200.1.text#ἔχεις γὰρ οὐχὶ βαιὰ τἀνθυμήματα,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1201.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1201.1.text#τῶν σῶν ἀδέρκτων ὀμμάτων τητώμενος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1202.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1202.1.text#ἀλλ' ἡμὶν εἶκε·  λιπαρεῖν γὰρ οὐ καλὸν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1203.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1203.1.text#δίκαια προσχρῄζουσιν, οὐδ' αὐτὸν μὲν εὖ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1204.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1204.1.text#πάσχειν, παθόντα δ' οὐκ ἐπίστασθαι τίνειν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1205.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1205.1.text#τέκνον, βαρεῖαν ἡδονὴν νικᾶτέ με
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1206.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1206.1.text#λέγοντες·  ἔστω δ' οὖν ὅπως ὑμῖν φίλον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1207.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1207.1.text#μόνον, ξέν', εἴπερ κεῖνος ὧδ' ἐλεύσεται,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1208.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1208.1.text#μηδεὶς κρατείτω τῆς ἐμῆς ψυχῆς ποτε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1209.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1209.1.text#ἅπαξ τὰ τοιαῦτ', οὐχὶ δὶς χρῄζω κλύειν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1209a.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1209a.text#ὦ πρέσβυ.  κομπεῖν δ' οὐχὶ βούλομαι·  σὺ δ' ὢν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1210.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1210.1.text#σῶς ἴσθ', ἐάν περ κἀμέ τις σῴζῃ θεῶν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1211.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1211.1.text#ὅστις τοῦ πλέονος μέρους χρῄζει τοῦ μετρίου παρεὶς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1212.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1212.1.text#ζώειν, σκαιοσύναν φυλάσσων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1213.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1213.1.text#ἐν ἐμοὶ κατάδηλος ἔσται.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1215.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1215.1.text#ἐπεὶ πολλὰ μὲν αἱ μακραὶ ἁμέραι κατέθεντο δὴ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1216.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1216.1.text#λύπας ἐγγυτέρω, τὰ τέρποντα δ' οὐκ ἂν ἴδοις ὅπου,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1217.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1217.1.text#ὅταν τις ἐς πλέον πέσῃ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1220.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1220.1.text#τοῦ δέοντος·  ὁ δ' ἐπίκουρος ἰσοτέλεστος,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1221.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1221.1.text#Ἄϊδος ὅτε μοῖρ' ἀνυμέναιος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1222.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1222.1.text#ἄλυρος ἄχορος ἀναπέφηνε,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1223.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1223.1.text#θάνατος ἐς τελευτάν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1225.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1225.1.text#μὴ φῦναι τὸν ἅπαντα νικᾷ λόγον·  τὸ δ', ἐπεὶ φανῇ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1226.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1226.1.text#βῆναι κεῖθεν ὅθεν περ ἥκει,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1227.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1227.1.text#πολὺ δεύτερον, ὡς τάχιστα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1230.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1230.1.text#ὡς εὖτ' ἂν τὸ νέον παρῇ κούφας ἀφροσύνας φέρον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1231.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1231.1.text#τίς πλαγὰ  πολύμοχθος ἔξω; τίς οὐ καμάτων ἔνι;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1232.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1232.1.text#φθόνος, στάσεις, ἔρις, μάχαι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1235.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1235.1.text#καὶ φόνοι·  τό τε κατάμεμπτον ἐπιλέλογχε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1236.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1236.1.text#πύματον ἀκρατὲς ἀπροσόμιλον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1237.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1237.1.text#γῆρας ἄφιλον, ἵνα πρόπαντα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1238.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1238.1.text#κακὰ κακῶν ξυνοικεῖ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1239.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1239.1.text#ἐν ᾧ τλάμων ὅδ', οὐκ ἐγὼ μόνος,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1240.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1240.1.text#πάντοθεν βόρειος ὥς τις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1241.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1241.1.text#ἀκτὰ κυματοπλὴξ χειμερία κλονεῖται,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1242.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1242.1.text#ὣς καὶ τόνδε κατ' ἄκρας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1243.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1243.1.text#δειναὶ κυματοαγεῖς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1244.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1244.1.text#ἆται κλονέουσιν ἀεὶ ξυνοῦσαι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1245.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1245.1.text#αἱ μὲν ἀπ' ἀελίου δυσμᾶν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1246.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1246.1.text#αἱ δ' ἀνατέλλοντος·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1247.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1247.1.text#αἱ δ' ἀνὰ μέσσαν ἀκτῖν',
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1248.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1248.1.text#αἱ δ' ἐννυχιᾶν ἀπὸ Ῥιπᾶν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1249.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1249.1.text#καὶ μὴν ὅδ' ἡμῖν, ὡς ἔοικεν, ὁ ξένος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1250.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1250.1.text#ἀνδρῶν γε μοῦνος, ὦ πάτερ, δι'  ὄμματος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1251.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1251.1.text#ἀστακτὶ λείβων δάκρυον ὧδ' ὁδοιπορεῖ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1252.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1252.1.text#τίς οὗτος;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1252.2.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1252.2.text#ὅνπερ καὶ πάλαι κατείχομεν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1253.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1253.1.text#γνώμῃ, πάρεστι δεῦρο Πολυνείκης ὅδε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1254.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1254.1.text#οἴμοι, τί δράσω; πότερα τἀμαυτοῦ κακὰ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1255.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1255.1.text#πρόσθεν δακρύσω, παῖδες, ἢ τὰ τοῦδ' ὁρῶν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1256.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1256.1.text#πατρὸς γέροντος; ὃς ξένης ἐπὶ χθονὸς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1257.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1257.1.text#σὺν σφῷν ἐφηύρηκ' ἐνθάδ' ἐκβεβλημένον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1258.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1258.1.text#ἐσθῆτι σὺν τοιᾷδε, τῆς ὁ δυσφιλὴς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1259.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1259.1.text#γέρων γέροντι συγκατῴκηκεν πίνος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1260.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1260.1.text#πλευρὰν μαραίνων, κρατὶ δ' ὀμματοστερεῖ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1261.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1261.1.text#κόμη δι'  αὔρας ἀκτένιστος ᾄσσεται·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1262.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1262.1.text#ἀδελφὰ δ', ὡς ἔοικε, τούτοισιν φορεῖ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1263.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1263.1.text#τὰ τῆς ταλαίνης νηδύος θρεπτήρια.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1264.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1264.1.text#ἁγὼ πανώλης ὄψ' ἄγαν ἐκμανθάνω·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1265.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1265.1.text#καὶ μαρτυρῶ κάκιστος ἀνθρώπων τροφαῖς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1266.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1266.1.text#ταῖς σαῖσιν ἥκειν·  τἀμὰ μὴ 'ξ ἄλλων πύθῃ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1267.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1267.1.text#ἀλλ' ἔστι γὰρ καὶ Ζηνὶ σύνθακος θρόνων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1268.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1268.1.text#Αἰδὼς ἐπ' ἔργοις πᾶσι, καὶ πρὸς σοί, πάτερ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1269.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1269.1.text#παρασταθήτω·  τῶν γὰρ ἡμαρτημένων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1270.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1270.1.text#ἄκη μέν ἐστι, προσφορὰ δ'  οὐκ ἔστ'  ἔτι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1271.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1271.1.text#τί σιγᾷς;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1272.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1272.1.text#φώνησον, ὦ πάτερ, τι·  μή μ' ἀποστραφῇς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1273.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1273.1.text#οὐδ' ἀνταμείβει μ' οὐδέν, ἀλλ' ἀτιμάσας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1274.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1274.1.text#πέμψεις ἄναυδος, οὐδ' ἃ μηνίεις φράσας;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1275.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1275.1.text#ὦ σπέρματ' ἀνδρὸς τοῦδ', ἐμαὶ δ' ὁμαίμονες,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1276.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1276.1.text#πειράσατ' ἀλλ' ὑμεῖς γε κινῆσαι πατρὸς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1277.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1277.1.text#τὸ δυσπρόσοιστον κἀπροσήγορον στόμα,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1278.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1278.1.text#ὡς μή μ' ἄτιμον, τοῦ θεοῦ γε προστάτην,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1279.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1279.1.text#οὕτως ἀφῇ με μηδὲν ἀντειπὼν ἔπος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1280.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1280.1.text#λέγ', ὦ ταλαίπωρ', αὐτὸς ὧν χρείᾳ πάρει·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1281.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1281.1.text#τὰ πολλὰ γάρ τοι ῥήματ' ἢ τέρψαντά τι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1282.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1282.1.text#ἢ δυσχεράναντ' ἢ κατοικτίσαντά πως,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1283.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1283.1.text#παρέσχε φωνὴν τοῖς ἀφωνήτοις τινά.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1284.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1284.1.text#ἀλλ' ἐξερῶ·  καλῶς γὰρ ἐξηγεῖ σύ μοι·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1285.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1285.1.text#πρῶτον μὲν αὐτὸν τὸν θεὸν ποιούμενος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1286.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1286.1.text#ἀρωγόν, ἔνθεν μ' ὧδ' ἀνέστησεν μολεῖν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1287.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1287.1.text#ὁ τῆσδε τῆς γῆς κοίρανος, διδοὺς ἐμοὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1288.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1288.1.text#λέξαι τ' ἀκοῦσαί τ' ἀσφαλεῖ σὺν ἐξόδῳ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1289.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1289.1.text#καὶ ταῦτ' ἀφ' ὑμῶν, ὧ ξένοι, βουλήσομαι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1290.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1290.1.text#καὶ ταῖνδ' ἀδελφαῖν καὶ πατρὸς κυρεῖν ἐμοί.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1291.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1291.1.text#ἃ δ' ἦλθον, ἤδη σοι θέλω λέξαι, πάτερ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1292.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1292.1.text#γῆς ἐκ πατρῴας ἐξελήλαμαι φυγάς,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1293.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1293.1.text#τοῖς σοῖς πανάρχοις οὕνεκ' ἐνθακεῖν θρόνοις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1294.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1294.1.text#γονῇ πεφυκὼς ἠξίουν γεραίτερος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1295.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1295.1.text#ἀνθ' ὧν μ' Ἐτεοκλῆς, ὢν φύσει νεώτερος,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1296.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1296.1.text#γῆς ἐξέωσεν, οὔτε νικήσας λόγῳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1297.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1297.1.text#οὔτ' εἰς ἔλεγχον χειρὸς οὐδ' ἔργου μολών,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1298.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1298.1.text#πόλιν δὲ πείσας.  ὧν ἐγὼ μάλιστα μὲν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1299.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1299.1.text#τὴν σὴν ἐρινὺν αἰτίαν εἶναι λέγω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1300.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1300.1.text#ἔπειτα κἀπὸ μάντεων ταύτῃ κλύω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1301.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1301.1.text#ἐπεὶ γὰρ ἦλθον Ἄργος ἐς τὸ Δωρικόν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1302.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1302.1.text#λαβὼν Ἄδραστον πενθερόν, ξυνωμότας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1303.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1303.1.text#ἔστησ' ἐμαυτῷ γῆς ὅσοιπερ Ἀπίας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1304.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1304.1.text#πρῶτοι καλοῦνται καὶ τετίμηνται δόρει,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1305.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1305.1.text#ὅπως τὸν ἑπτάλογχον ἐς Θήβας στόλον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1306.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1306.1.text#ξὺν τοῖσδ' ἀγείρας ἢ θάνοιμι πανδίκως
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1307.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1307.1.text#ἢ τοὺς τάδ' ἐκπράξαντας ἐκβάλοιμι γῆς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1308.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1308.1.text#εἶεν·  τί δῆτα νῦν ἀφιγμένος κυρῶ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1309.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1309.1.text#σοὶ προστροπαίους, ὦ πάτερ, λιτὰς ἔχων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1310.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1310.1.text#αὐτός τ'  ἐμαυτοῦ ξυμμάχων τε τῶν ἐμῶν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1311.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1311.1.text#οἳ νῦν σὺν ἑπτὰ τάξεσιν σὺν ἑπτά τε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1312.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1312.1.text#λόγχαις τὸ Θήβης πέδιον ἀμφεστᾶσι πᾶν·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1313.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1313.1.text#οἷος δορυσσοῦς Ἀμφιάρεως, τὰ πρῶτα μὲν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1314.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1314.1.text#δόρει κρατύνων, πρῶτα δ' οἰωνῶν ὁδοῖς·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1315.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1315.1.text#ὁ δεύτερος δ' Αἰτωλὸς Οἰνέως τόκος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1316.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1316.1.text#Τυδεύς.  τρίτος δ' Ἐτέοκλος, Ἀργεῖος γεγώς·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1317.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1317.1.text#τέταρτον Ἱππομέδοντ' ἀπέστειλεν πατὴρ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1318.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1318.1.text#Ταλαός·  ὁ πέμπτος δ' εὔχεται κατασκαφῇ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1319.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1319.1.text#Καπανεὺς τὸ Θήβης ἄστυ δῃώσειν πυρί·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1320.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1320.1.text#ἕκτος δὲ Παρθενοπαῖος Ἀρκὰς ὄρνυται,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1321.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1321.1.text#ἐπώνυμος τῆς πρόσθεν ἀδμήτης χρόνῳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1322.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1322.1.text#μητρὸς λοχευθείς, πιστὸς Ἀταλάντης γόνος·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1323.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1323.1.text#ἐγὼ δὲ σός, κεἰ μὴ σός, ἀλλὰ τοῦ κακοῦ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1324.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1324.1.text#πότμου φυτευθείς, σός γέ τοι καλούμενος,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1325.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1325.1.text#ἄγω τὸν Ἄργους ἄφοβον ἐς Θήβας στρατόν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1326.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1326.1.text#οἵ σ' ἀντὶ παίδων τῶνδε καὶ ψυχῆς, πάτερ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1327.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1327.1.text#ἱκετεύομεν ξύμπαντες ἐξαιτούμενοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1328.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1328.1.text#μῆνιν βαρεῖαν εἰκαθεῖν ὁρμωμένῳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1329.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1329.1.text#τῷδ' ἀνδρὶ τοὐμοῦ πρὸς κασιγνήτου τίσιν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1330.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1330.1.text#ὅς μ' ἐξέωσε κἀπεσύλησεν πάτρας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1331.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1331.1.text#εἰ γάρ τι πιστόν ἐστιν ἐκ χρηστηρίων,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1332.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1332.1.text#οἷς ἂν σὺ προσθῇ, τοῖσδ' ἔφασκ' εἶναι κράτος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1333.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1333.1.text#πρὸς νῦν σε κρηνῶν καὶ θεῶν ὁμογνίων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1334.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1334.1.text#αἰτῶ πιθέσθαι καὶ παρεικαθεῖν, ἐπεὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1335.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1335.1.text#πτωχοὶ μὲν ἡμεῖς καὶ ξένοι, ξένος δὲ σύ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1336.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1336.1.text#ἄλλους δὲ θωπεύοντες οἰκοῦμεν σύ τε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1337.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1337.1.text#κἀγώ, τὸν αὐτὸν δαίμον' ἐξειληχότες.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1338.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1338.1.text#ὁ δ' ἐν δόμοις τύραννος, ὦ τάλας ἐγώ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1339.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1339.1.text#κοινῇ καθ' ἡμῶν ἐγγελῶν ἁβρύνεται·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1340.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1340.1.text#ὅν, εἰ σὺ τἠμῇ ξυμπαραστήσει φρενί,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1341.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1341.1.text#βραχεῖ σὺν ὄγκῳ καὶ χρόνῳ διασκεδῶ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1342.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1342.1.text#ὥστ' ἐν δόμοισι τοῖσι σοῖς στήσω σ' ἄγων.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1343.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1343.1.text#στήσω δ' ἐμαυτόν, κεῖνον ἐκβαλὼν βίᾳ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1344.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1344.1.text#καὶ ταῦτα σοῦ μὲν ξυνθέλοντος ἔστι μοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1345.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1345.1.text#κομπεῖν, ἄνευ σοῦ δ' οὐδὲ σωθῆναι σθένω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1346.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1346.1.text#τὸν ἄνδρα τοῦ πέμψαντος οὕνεκ', Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1347.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1347.1.text#εἰπὼν ὁποῖα ξύμφορ' ἔκπεμψαι πάλιν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1348.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1348.1.text#ἀλλ' εἰ μέν, ἄνδρες, τῆσδε δημοῦχοι χθονός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1349.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1349.1.text#μὴ 'τύγχαν' αὐτὸν δεῦρο προσπέμψας ἐμοὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1350.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1350.1.text#Θησεύς, δικαιῶν ὥστ' ἐμοῦ κλύειν λόγους,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1351.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1351.1.text#οὔ τἄν ποτ' ὀμφῆς τῆς ἐμῆς ἐπῄσθετο·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1352.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1352.1.text#νῦν δ' ἀξιωθεὶς εἶσι κἀκούσας γ' ἐμοῦ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1353.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1353.1.text#τοιαῦθ' ἃ τὸν τοῦδ' οὔ ποτ' εὐφρανεῖ βίον·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1354.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1354.1.text#ὅς γ', ὦ κάκιστε, σκῆπτρα καὶ θρόνους ἔχων,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1355.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1355.1.text#ἃ νῦν ὁ σὸς ξύναιμος ἐν Θήβαις ἔχει,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1356.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1356.1.text#τὸν αὐτὸς αὑτοῦ πατέρα τόνδ' ἀπήλασας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1357.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1357.1.text#κἄθηκας ἄπολιν καὶ στολὰς ταύτας φορεῖν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1358.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1358.1.text#ἃς νῦν δακρύεις εἰσορῶν, ὅτ' ἐν πόνῳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1359.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1359.1.text#ταὐτῷ βεβηκὼς τυγχάνεις κακῶν ἐμοί.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1360.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1360.1.text#οὐ κλαυστὰ δ' ἐστίν, ἀλλ' ἐμοὶ μὲν οἰστέα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1361.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1361.1.text#τάδ', ἕωσπερ ἂν ζῶ, σοῦ φονέως μεμνημένος·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1362.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1362.1.text#σὺ γάρ με μόχθῳ τῷδ' ἔθηκας ἔντροφον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1363.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1363.1.text#σύ μ' ἐξέωσας, ἐκ σέθεν δ' ἀλώμενος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1364.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1364.1.text#ἄλλους ἐπαιτῶ τὸν καθ' ἡμέραν βίον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1365.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1365.1.text#εἰ δ' ἐξέφυσα τάσδε μὴ 'μαυτῷ τροφοὺς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1366.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1366.1.text#τὰς παῖδας, ἦ τἂν οὐκ ἂν ἦ, τὸ σὸν μέρος·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1367.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1367.1.text#νῦν δ' αἵδε μ' ἐκσῴζουσιν, αἵδ' ἐμαὶ τροφοί,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1368.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1368.1.text#αἵδ' ἄνδρες, οὐ γυναῖκες, εἰς τὸ συμπονεῖν·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1369.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1369.1.text#ὑμεῖς δ' ἀπ' ἄλλου κοὐκ ἐμοῦ πεφύκατον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1370.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1370.1.text#τοιγάρ σ' ὁ δαίμων εἰσορᾷ μὲν οὔ τί πω
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1371.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1371.1.text#ὡς αὐτίκ', εἴπερ οἵδε κινοῦνται λόχοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1372.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1372.1.text#πρὸς ἄστυ Θήβης.  οὐ γὰρ ἔσθ' ὅπως πόλιν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1373.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1373.1.text#κείνην ἐρείψεις, ἀλλὰ πρόσθεν αἵματι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1374.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1374.1.text#πεσεῖ μιανθεὶς χὼ σύναιμος ἐξ ἴσου.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1375.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1375.1.text#τοιάσδ' ἀρὰς σφῷν πρόσθε τ' ἐξανῆκ' ἐγὼ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1376.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1376.1.text#νῦν τ' ἀνακαλοῦμαι ξυμμάχους ἐλθεῖν ἐμοί,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1377.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1377.1.text#ἵν' ἀξιῶτον τοὺς φυτεύσαντας σέβειν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1378.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1378.1.text#καὶ μὴ 'ξατιμάζητον, εἰ τυφλοῦ πατρὸς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1379.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1379.1.text#τοιώδ' ἐφύτην·  αἵδε γὰρ τάδ' οὐκ ἔδρων.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1380.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1380.1.text#τοιγὰρ τὸ σὸν θάκημα καὶ τοὺς σοὺς θρόνους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1381.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1381.1.text#κρατοῦσιν, εἴπερ ἐστὶν ἡ παλαίφατος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1382.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1382.1.text#Δίκη ξύνεδρος Ζηνὸς ἀρχαίοις νόμοις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1383.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1383.1.text#σὺ δ' ἔρρ' ἀπόπτυστός τε κἀπάτωρ ἐμοῦ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1384.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1384.1.text#κακῶν κάκιστε, τάσδε συλλαβὼν ἀράς,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1385.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1385.1.text#ἅς σοι καλοῦμαι, μήτε γῆς ἐμφυλίου
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1386.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1386.1.text#δόρει κρατῆσαι μήτε νοστῆσαί ποτε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1387.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1387.1.text#τὸ κοῖλον Ἄργος, ἀλλὰ συγγενεῖ χερὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1388.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1388.1.text#θανεῖν κτανεῖν θ' ὑφ' οὗπερ ἐξελήλασαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1389.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1389.1.text#τοιαῦτ' ἀρῶμαι καὶ καλῶ τὸ Ταρτάρου
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1390.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1390.1.text#στυγνὸν πατρῷον ἔρεβος, ὥς σ' ἀποικίσῃ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1391.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1391.1.text#καλῶ δὲ τάσδε δαίμονας, καλῶ δ' Ἄρη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1392.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1392.1.text#τὸν σφῷν τὸ δεινὸν μῖσος ἐμβεβληκότα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1393.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1393.1.text#καὶ ταῦτ' ἀκούσας στεῖχε, κἀξάγγελλ' ἰὼν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1394.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1394.1.text#καὶ πᾶσι Καδμείοισι τοῖς σαυτοῦ θ' ἅμα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1395.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1395.1.text#πιστοῖσι συμμάχοισιν, οὕνεκ' Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1396.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1396.1.text#τοιαῦτ' ἔνειμε παισὶ τοῖς αὑτοῦ γέρα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1397.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1397.1.text#Πολύνεικες, οὔτε ταῖς παρελθούσαις ὁδοῖς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1398.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1398.1.text#ξυνήδομαί σοι, νῦν τ' ἴθ' ὡς τάχος πάλιν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1399.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1399.1.text#οἴμοι κελεύθου τῆς τ' ἐμῆς δυσπραξίας,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1400.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1400.1.text#οἴμοι δ' ἑταίρων·  οἷον ἆρ' ὁδοῦ τέλος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1401.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1401.1.text#Ἄργους ἀφωρμήθημεν, ὦ τάλας ἐγώ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1402.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1402.1.text#τοιοῦτον οἷον οὐδὲ φωνῆσαί τινι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1403.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1403.1.text#ἔξεσθ' ἑταίρων, οὐδ' ἀποστρέψαι πάλιν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1404.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1404.1.text#ἀλλ' ὄντ' ἄναυδον τῇδε συγκῦρσαι τύχῃ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1405.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1405.1.text#ὦ τοῦδ' ὅμαιμοι παῖδες, ἀλλ' ὑμεῖς, ἐπεὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1406.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1406.1.text#τὰ σκληρὰ πατρὸς κλύετε ταῦτ' ἀρωμένου,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1407.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1407.1.text#μή τοί με πρὸς θεῶν σφώ γ', ἐὰν αἱ τοῦδ' ἀραὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1408.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1408.1.text#πατρὸς τελῶνται καί τις ὑμῖν ἐς δόμους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1409.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1409.1.text#νόστος γένηται, μή μ' ἀτιμάσητέ γε,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1410.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1410.1.text#ἀλλ' ἐν τάφοισι θέσθε κἀν κτερίσμασιν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1411.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1411.1.text#καὶ σφῷν ὁ νῦν ἔπαινος, ὃν κομίζετον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1412.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1412.1.text#τοῦδ', ἀνδρὸς οἷς πονεῖτον, οὐκ ἐλάσσονα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1413.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1413.1.text#ἔτ' ἄλλον οἴσει τῆς ἐμῆς ὑπουργίας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1414.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1414.1.text#Πολύνεικες, ἱκετεύω σε πεισθῆναί τί μοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1415.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1415.1.text#ὦ φιλτάτη, τὸ ποῖον, Ἀντιγόνη; λέγε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1416.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1416.1.text#στρέψαι στράτευμ' ἐς Ἄργος ὡς τάχιστά γε,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1417.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1417.1.text#καὶ μὴ σέ τ' αὐτὸν καὶ πόλιν διεργάσῃ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1418.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1418.1.text#ἀλλ' οὐχ οἷόν τε·  πῶς γὰρ αὖθις ἂν πάλιν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1419.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1419.1.text#στράτευμ' ἄγοιμι ταὐτόν. εἰσάπαξ τρέσας;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1420.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1420.1.text#τί δ' αὖθις, ὦ παῖ, δεῖ σε θυμοῦσθαι; τί σοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1421.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1421.1.text#πάτραν κατασκάψαντι κέρδος ἔρχεται;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1422.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1422.1.text#αἰσχρὸν τὸ φεύγειν καὶ τὸ πρεσβεύοντ' ἐμὲ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1423.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1423.1.text#οὕτω γελᾶσθαι τοῦ κασιγνήτου πάρα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1424.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1424.1.text#ὁρᾷς τὰ τοῦδ' οὖν ὡς ἐς ὀρθὸν ἐκφέρει
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1425.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1425.1.text#μαντεύμαθ', ὃς σφῷν θάνατον ἐξ ἀμφοῖν θροεῖ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1426.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1426.1.text#χρῄζει γάρ·  ἡμῖν δ' οὐχὶ συγχωρητέα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1427.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1427.1.text#οἴμοι τάλαινα· τίς δὲ τολμήσει κλύων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1428.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1428.1.text#τὰ τοῦδ' ἕπεσθαι τἀνδρός, οἷ' ἐθέσπισεν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1429.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1429.1.text#οὐκ ἀγγελοῦμεν φλαῦρ'·  ἐπεὶ στρατηλάτου
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1430.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1430.1.text#χρηστοῦ τὰ κρείσσω μηδὲ τἀνδεᾶ λέγειν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1431.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1431.1.text#οὕτως ἄρ', ὦ παῖ, ταῦτά σοι δεδογμένα;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1432.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1432.1.text#καὶ μή μ' ἐπίσχῃς γ'·  ἀλλ' ἐμοὶ μὲν ἥδ' ὁδὸς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1433.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1433.1.text#ἔσται μέλουσα δύσποτμός τε καὶ κακὴ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1434.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1434.1.text#πρὸς τοῦδε πατρὸς τῶν τε τοῦδ' ἐρινύων·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1435.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1435.1.text#σφῷν δ' εὖ διδοίη Ζεύς, τάδ' εἰ θανόντι μοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1436.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1436.1.text#τελεῖτ', ἐπεὶ οὔ μοι ζῶντί γ' αὖθις ἕξετον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1437.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1437.1.text#μέθεσθε δ' ἤδη χαίρετόν τ'·  οὐ γάρ μ' ἔτι 
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1438.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1438.1.text#βλέποντ' ἐσόψεσθ' αὖθις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1438.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1438.2.text#ὦ τάλαιν' ἐγώ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1439.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1439.1.text#μή τοί μ' ὀδύρου.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1439.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1439.2.text#καὶ τίς ἄν σ' ὁρμώμενον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1440.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1440.1.text#εἰς προὖπτον Ἅιδην οὐ καταστένοι, κάσι;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1441.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1441.1.text#εἰ χρή, θανοῦμαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1441.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1441.2.text#μὴ σύ γ', ἀλλ' ἐμοὶ πιθοῦ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1442.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1442.1.text#μὴ πεῖθ' ἃ μὴ δεῖ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1442.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1442.2.text#δυστάλαινά τἄρ' ἐγώ, εἴ σου στερηθῶ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1443.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1443.1.text#ταῦτα δ' ἐν τῷ δαίμονι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1443.2.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1443.2.text#καὶ τῇδε φῦναι χἀτέρᾳ.  σφὼ δ' οὖν ἐγὼ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1445.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1445.1.text#θεοῖς ἀρῶμαι μή ποτ' ἀντῆσαι κακῶν·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1446.1.speaker#Πολυνείκης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1446.1.text#ἀνάξιαι γὰρ πᾶσίν ἐστε δυστυχεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1447.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1447.1.text#νέα τάδε νεόθεν ἦλθέ μοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1448.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1448.1.text#κακὰ βαρύποτμὰ παρ' ἀλαοῦ ξένου,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1450.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1450.1.text#εἴ τι μοῖρα μὴ κιγχάνει.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1451.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1451.1.text#μάταν  γὰρ οὐδὲν ἀξίωμα δαιμόνων ἔχω φράσαι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1452.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1452.1.text#ὁρᾷ ὁρᾷ ταῦτ'   ἀεὶ χρόνος, τρέχων μὲν  ἕτερα,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1455.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1455.1.text#τὰ δὲ παρ'  ἦμαρ αὖθις αὔξων ἄνω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1456.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1456.1.text#ἔκτυπεν αἰθήρ, ὦ Ζεῦ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1457.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1457.1.text#ὦ τέκνα τέκνα, πῶς ἄν, εἴ τις ἔντοπος,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1458.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1458.1.text#τὸν πάντ' ἄριστον δεῦρο Θησέα πόροι;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1459.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1459.1.text#πάτερ, τί δ' ἐστὶ τἀξίωμ' ἐφ' ᾧ καλεῖς;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1460.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1460.1.text#Διὸς πτερωτὸς ἥδε μ'  αὐτίκ'  ἄξεται
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1461.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1461.1.text#βροντὴ πρὸς Ἅιδην·  ἀλλὰ πέμψαθ' ὡς τάχος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1462.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1462.1.text#μέγας, ἴδε, μάλ' ὅδ' ἐρείπεται
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1463.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1463.1.text#κτύπος ἄφατος διόβολος· ἐς δ' ἄκραν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1465.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1465.1.text#δεῖμ' ὑπῆλθε κρατὸς φόβαν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1466.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1466.1.text#ἔπτηξα θυμόν·  οὐρανία γὰρ ἀστραπὴ φλέγει πάλιν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1467.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1467.1.text#τί μὰν ἀφήσει τέλος; δέδοικα δ'·  οὐ γὰρ ἅλιον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1470.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1470.1.text#ἀφορμᾷ ποτ', οὐκ ἄνευ ξυμφορᾶς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1471.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1471.1.text#ὦ μέγας αἰθήρ, ὦ Ζεῦ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1472.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1472.1.text#ὦ παῖδες, ἥκει τῷδ' ἐπ' ἀνδρὶ θέσφατος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1473.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1473.1.text#βίου τελευτὴ κοὐκέτ' ἔστ' ἀποστροφή.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1474.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1474.1.text#πῶς οἶσθα; τῷ δὲ τοῦτο συμβαλὼν ἔχεις;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1475.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1475.1.text#καλῶς κάτοιδ'·  ἀλλ' ὡς τάχιστά μοι μολὼν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1476.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1476.1.text#ἄνακτα χώρας τῆσδέ τις πορευσάτω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1477.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1477.1.text#ἔα ἔα, ἰδοὺ μάλ'  αὖθις ἀμφίσταται διαπρύσιος ὄτοβος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1480.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1480.1.text#ἵλαος, ὦ δαίμων, ἵλαος  εἴ τι γᾷ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1481.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1481.1.text#ματέρι τυγχάνεις ἀφεγγὲς φέρων.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1482.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1482.1.text#ἐναισίου δὲ σοῦ τύχοιμι, μηδ' ἄλαστον ἄνδρ' ἰδὼν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1483.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1483.1.text#ἀκερδῆ χάριν μετάσχοιμί πως.  Ζεῦ ἄνα σοὶ φωνῶ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1486.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1486.1.text#ἆρ' ἐγγὺς ἁνήρ; ἆρ' ἔτ' ἐμψύχου, τέκνα,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1487.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1487.1.text#κιχήσεταί μου καὶ κατορθοῦντος φρένα;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1488.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1488.1.text#τί δ' ἂν θέλοις τὸ πιστὸν ἐμφῦναι φρενί;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1489.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1489.1.text#ἀνθ' ὧν ἔπασχον εὖ, τελεσφόρον χάριν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1490.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1490.1.text#δοῦναί σφιν, ἥνπερ τυγχάνων ὑπεσχόμην.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1491.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1491.1.text#ἰὼ ἰὼ παῖ, βᾶθι βᾶθ', εἴτ'  ἄκρα,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1492.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1492.1.text#περὶ γύαλ' ἐναλίῳ Ποσειδωνίῳ θεῷ, τυγχάνεις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1493.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1493.1.text#βούθυτον ἑστίαν ἁγίζων, ἱκοῦ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1494.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1494.1.text#ὁ γὰρ ξένος σε καὶ πόλισμα καὶ φίλους ἐπαξιοῖ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1495.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1495.1.text#δικαίαν χάριν παρασχεῖν παθών.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1496.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1496.1.text#[ σπεῦσον ] ἄϊσσ', ὦναξ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1500.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1500.1.text#τίς αὖ παρ'  ὑμῶν κοινὸς ἠχεῖται κτύπος,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1501.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1501.1.text#σαφὴς μὲν ἀστῶν, ἐμφανὴς δὲ τοῦ ξένου;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1502.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1502.1.text#μή τις Διὸς κεραυνὸς ἤ τις ὀμβρία
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1503.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1503.1.text#χάλαζ' ἐπιρράξασα; πάντα γὰρ θεοῦ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1504.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1504.1.text#τοιαῦτα χειμάζοντος εἰκάσαι πάρα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1505.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1505.1.text#ἄναξ, ποθοῦντι προυφάνης, καί σοι θεῶν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1506.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1506.1.text#τύχην τις ἐσθλὴν τῆσδ' ἔθηκε τῆς ὁδοῦ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1507.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1507.1.text#τί δ' ἐστίν, ὦ παῖ Λαΐου, νέορτον αὖ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1508.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1508.1.text#ῥοπὴ βίου μοι·  καί σ' ἅπερ ξυνῄνεσα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1509.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1509.1.text#θέλω πόλιν τε τήνδε μὴ ψεύσας θανεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1510.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1510.1.text#τῷ δ'  ἐκπέπεισαι τοῦ μόρου τεκμηρίῳ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1511.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1511.1.text#αὐτοὶ θεοὶ κήρυκες ἀγγέλλουσί μοι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1512.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1512.1.text#ψεύδοντες οὐδὲν σῆμα τῶν προκειμένων.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1513.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1513.1.text#πῶς εἶπας, ὦ γεραιέ, δηλοῦσθαι τάδε;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1514.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1514.1.text#αἱ πολλὰ βρονταὶ διατελεῖς τὰ πολλά τε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1515.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1515.1.text#στράψαντα χειρὸς τῆς ἀνικήτου βέλη.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1516.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1516.1.text#πείθεις με·  πολλὰ γάρ σε θεσπίζονθ' ὁρῶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1517.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1517.1.text#κοὐ ψευδόφημα·  χὤ τι χρὴ ποιεῖν λέγε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1518.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1518.1.text#ἐγὼ διδάξω, τέκνον Αἰγέως, ἅ σοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1519.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1519.1.text#γήρως ἄλυπα τῇδε κείσεται πόλει.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1520.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1520.1.text#χῶρον μὲν αὐτὸς αὐτίκ' ἐξηγήσομαι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1521.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1521.1.text#ἄθικτος ἡγητῆρος, οὗ με χρὴ θανεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1522.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1522.1.text#τοῦτον δὲ φράζε μή ποτ' ἀνθρώπων τινί,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1523.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1523.1.text#μήθ' οὗ κέκευθε μήτ' ἐν οἷς κεῖται τόποις·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1524.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1524.1.text#ὥς σοι πρὸ πολλῶν ἀσπίδων ἀλκὴν ὅδε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1525.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1525.1.text#δορός τ' ἐπακτοῦ γειτονῶν ἀεὶ τιθῇ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1526.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1526.1.text#ἃ δ' ἐξάγιστα μηδὲ κινεῖται λόγῳ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1527.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1527.1.text#αὐτὸς μαθήσει, κεῖσ' ὅταν μόλῃς μόνος·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1528.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1528.1.text#ὡς οὔτ' ἂν ἀστῶν τῶνδ' ἂν ἐξείποιμί τῳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1529.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1529.1.text#οὔτ' ἂν τέκνοισι τοῖς ἐμοῖς, στέργων ὅμως.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1530.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1530.1.text#ἀλλ'  αὐτὸς αἰεὶ σῷζε, χὤταν εἰς τέλος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1531.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1531.1.text#τοῦ ζῆν ἀφικνῇ, τῷ προφερτάτῳ μόνῳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1532.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1532.1.text#σήμαιν', ὁ δ' αἰεὶ τὠπιόντι δεικνύτω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1533.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1533.1.text#χοὔτως ἀδῇον τήνδ' ἐνοικήσεις πόλιν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1534.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1534.1.text#σπαρτῶν ἀπ' ἀνδρῶν·  αἱ δὲ μυρίαι πόλεις,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1535.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1535.1.text#κἂν εὖ τις οἰκῇ, ῥᾳδίως καθύβρισαν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1536.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1536.1.text#θεοὶ γὰρ εὖ μέν, ὀψὲ δ' εἰσορῶσ', ὅταν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1537.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1537.1.text#τὰ θεῖ' ἀφείς τις εἰς τὸ μαίνεσθαι τραπῇ·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1538.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1538.1.text#ὃ μὴ σύ, τέκνον Αἰγέως, βούλου παθεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1539.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1539.1.text#τὰ μὲν τοιαῦτ' οὖν εἰδότ' ἐκδιδάσκομεν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1540.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1540.1.text#χῶρον δ', ἐπείγει γάρ με τοὐκ θεοῦ παρόν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1541.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1541.1.text#στείχωμεν ἤδη μηδ' ἔτ' ἐντρεπώμεθα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1542.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1542.1.text#ὦ παῖδες, ὧδ' ἕπεσθ'·  ἐγὼ γὰρ ἡγεμὼν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1543.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1543.1.text#σφῷν αὖ πέφασμαι καινός, ὥσπερ σφὼ πατρί.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1544.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1544.1.text#χωρεῖτε καὶ μὴ ψαύετ', ἀλλ' ἐᾶτέ με
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1545.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1545.1.text#αὐτὸν τὸν ἱερὸν τύμβον ἐξευρεῖν, ἵνα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1546.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1546.1.text#μοῖρ' ἀνδρὶ τῷδε τῇδε κρυφθῆναι χθονί.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1547.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1547.1.text#τῇδ' ὧδε, τῇδε βᾶτε·  τῇδε γάρ μ' ἄγει
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1548.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1548.1.text#Ἑρμῆς ὁ πομπὸς ἥ τε νερτέρα θεός.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1549.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1549.1.text#ὦ φῶς ἀφεγγές, πρόσθε πού ποτ' ἦσθ' ἐμόν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1550.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1550.1.text#νῦν δ' ἔσχατόν σου τοὐμὸν ἅπτεται δέμας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1551.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1551.1.text#ἤδη γὰρ ἕρπω τὸν τελευταῖον βίον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1552.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1552.1.text#κρύψων παρ' Ἅιδην.  ἀλλά, φίλτατε ξένων,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1553.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1553.1.text#αὐτός τε χώρα θ' ἥδε πρόσπολοί τε σοὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1554.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1554.1.text#εὐδαίμονες γένοισθε, κἀπ' εὐπραξίᾳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1555.1.speaker#Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1555.1.text#μέμνησθέ μου θανόντος εὐτυχεῖς ἀεί.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1556.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1556.1.text#εἰ θέμις ἐστί μοι τὰν ἀφανῆ θεὸν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1557.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1557.1.text#καὶ σὲ λιταῖς σεβίζειν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1558.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1558.1.text#ἐννυχίων ἄναξ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1560.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1560.1.text#Αἰδωνεῦ Αἰδωνεῦ, λίσσωμαι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1561.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1561.1.text#ἄπονα μήτ' ἐπὶ  βαρυαχεῖ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1562.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1562.1.text#ξένον ἐξανύσαι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1563.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1563.1.text#μόρῳ τὰν παγκευθῆ κάτω
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1564.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1564.1.text#νεκρῶν πλάκα καὶ Στύγιον δόμον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1565.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1565.1.text#πολλῶν γὰρ ἂν καὶ μάταν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1566.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1566.1.text#πημάτων ἱκνουμένων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1567.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1567.1.text#πάλιν σφε δαίμων δίκαιος αὔξοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1568.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1568.1.text#ὦ χθόνιαι θεαὶ σῶμά τ' ἀνικάτου
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1569.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1569.1.text#θηρός, ὃν ἐν πύλαισι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1570.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1570.1.text#ταῖσι πολυξένοις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1571.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1571.1.text#εὐνᾶσθαι κνυζεῖσθαί τ' ἐξ ἄντρων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1572.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1572.1.text#ἀδάματον φύλακα παρ' Ἁίδᾳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1573.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1573.1.text#λόγος αἰὲν ἔχει·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1574.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1574.1.text#τόν, ὦ Γᾶς παῖ καὶ Ταρτάρου,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1575.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1575.1.text#κατεύχομαι ἐν καθαρῷ βῆναι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1576.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1576.1.text#ὁρμωμένῳ νερτέρας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1577.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1577.1.text#τῷ ξένῳ νεκρῶν πλάκας·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1578.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1578.1.text#σέ τοι κικλήσκω τὸν αἰένυπνον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1579.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1579.1.text#ἄνδρες πολῖται, ξυντομωτάτως, μὲν ἂν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1580.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1580.1.text#τύχοιμι λέξας Οἰδίπουν ὀλωλότα·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1581.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1581.1.text#ἃ δ' ἦν τὰ πραχθέντ', οὔθ' ὁ μῦθος ἐν βραχεῖ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1582.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1582.1.text#φράσαι πάρεστιν οὔτε τἄργ' ὅσ' ἦν ἐκεῖ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1583.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1583.1.text#ὄλωλε γὰρ δύστηνος;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1583.2.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1583.2.text#ὡς λελοιπότα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1584.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1584.1.text#κεῖνον τὸν ἀεὶ βίοτον ἐξεπίστασο.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1585.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1585.1.text#πῶς; ἆρα θείᾳ κἀπόνῳ τάλας τύχῃ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1586.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1586.1.text#ταῦτ' ἐστὶν ἤδη κἀποθαυμάσαι πρέπον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1587.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1587.1.text#ὡς μὲν γὰρ ἐνθένδ' εἷρπε, καὶ σύ που παρὼν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1588.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1588.1.text#ἔξοισθ', ὑφηγητῆρος οὐδενὸς φίλων,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1589.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1589.1.text#ἀλλ' αὐτὸς ἡμῖν πᾶσιν ἐξηγούμενος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1590.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1590.1.text#ἐπεὶ δ' ἀφῖκτο τὸν καταρράκτην ὀδὸν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1591.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1591.1.text#χαλκοῖς βάθροισι γῆθεν ἐρριζωμένον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1592.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1592.1.text#ἔστη κελεύθων ἐν πολυσχίστων μιᾷ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1593.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1593.1.text#κοίλου πέλας κρατῆρος, οὗ τὰ Θησέως
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1594.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1594.1.text#Περίθου τε κεῖται πίστ' ἀεὶ ξυνθήματα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1595.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1595.1.text#ἀφ' οὗ μέσος στὰς τοῦ τε Θορικίου πέτρου
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1596.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1596.1.text#κοίλης τ' ἀχέρδου κἀπὸ λαΐνου τάφου,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1597.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1597.1.text#καθέζετ'·  εἶτ' ἔλυσε δυσπινεῖς στολάς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1598.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1598.1.text#κἄπειτ' ἀΰσας παῖδας ἠνώγει ῥυτῶν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1599.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1599.1.text#ὑδάτων ἐνεγκεῖν λουτρὰ καὶ χοάς ποθεν·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1600.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1600.1.text#τὼ δ'  εὐχλόου Δήμητρος εἰς προσόψιον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1601.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1601.1.text#πάγον μολοῦσαι τάσδ' ἐπιστολὰς πατρὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1602.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1602.1.text#ταχεῖ 'πόρευσαν σῦν χρόνῳ, λουτροῖς τέ νιν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1603.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1603.1.text#ἐσθῆτί τ' ἐξήσκησαν ᾗ νομίζεται.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1604.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1604.1.text#ἐπεὶ δὲ παντὸς εἶχε δρῶντος ἡδονὴν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1605.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1605.1.text#κοὐκ ἦν ἔτ' οὐδὲν ἀργὸν ὧν ἐφίετο,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1606.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1606.1.text#κτύπησε μὲν Ζεὺς χθόνιος αἱ δὲ παρθένοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1607.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1607.1.text#ῥίγησαν, ὡς ἤκουσαν·  ἐς δὲ γούνατα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1608.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1608.1.text#πατρὸς πεσοῦσαι 'κλαιον οὐδ' ἀνίεσαν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1609.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1609.1.text#στέρνων ἀραγμοὺς οὐδὲ παμμήκεις γόους.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1610.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1610.1.text#ὁ δ'  ὡς ἀκούει φθόγγον ἐξαίφνης πικρόν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1611.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1611.1.text#πτύξας ἐπ' αὐταῖς χεῖρας εἶπεν·  ὦ τέκνα,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1612.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1612.1.text#οὐκ ἔστ' ἔθ' ὑμῖν τῇδ' ἐν ἡμέρᾳ πατήρ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1613.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1613.1.text#ὄλωλε γὰρ δὴ πάντα τἀμά, κοὐκέτι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1614.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1614.1.text#τὴν δυσπόνητον ἕξετ' ἀμφ' ἐμοὶ τροφήν·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1615.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1615.1.text#σκληρὰν μέν, οἶδα, παῖδες·  ἀλλ' ἓν γὰρ μόνον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1616.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1616.1.text#τὰ πάντα λύει ταῦτ' ἔπος μοχθήματα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1617.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1617.1.text#τὸ γὰρ φιλεῖν οὐκ ἔστιν ἐξ ὅτου πλέον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1618.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1618.1.text#ἢ τοῦδε τἀνδρὸς ἔσχεθ', οὗ τητώμεναι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1619.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1619.1.text#τὸ λοιπὸν ἤδη τὸν βίον διάζετον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1620.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1620.1.text#τοιαῦτ'  ἐπ'  ἀλλήλοισιν ἀμφικείμενοι
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1621.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1621.1.text#λύγδην ἔκλαιον πάντες.  ὡς δὲ πρὸς τέλος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1622.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1622.1.text#γόων ἀφίκοντ' οὐδ' ἔτ' ὠρώρει βοή,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1623.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1623.1.text#ἦν μὲν σιωπή· φθέγμα δ' ἐξαίφνης τινὸς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1624.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1624.1.text#θώϋξεν αὐτόν, ὥστε πάντας ὀρθίας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1625.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1625.1.text#στῆσαι φόβῳ δείσαντας ἐξαίφνης τρίχας,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1626.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1626.1.text#καλεῖ γὰρ αὐτὸν πολλὰ πολλαχῇ θεός·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1627.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1627.1.text#ὦ οὗτος οὗτος, Οἰδίπους, τί μέλλομεν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1628.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1628.1.text#χωρεῖν; πάλαι δὴ τἀπὸ σοῦ βραδύνεται.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1629.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1629.1.text#ὁ δ' ὡς ἐπῄσθετ' ἐκ θεοῦ καλούμενος,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1630.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1630.1.text#αὐδᾷ μολεῖν οἱ γῆς ἄνακτα Θησέα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1631.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1631.1.text#κἀπεὶ προσῆλθεν, εἶπεν·  ὦ φίλον κάρα,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1632.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1632.1.text#δός μοι χερὸς σῆς πίστιν ὁρκίαν τέκνοις,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1633.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1633.1.text#ὑμεῖς τε, παῖδες, τῷδε·  καὶ καταίνεσον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1634.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1634.1.text#μήποτε προδώσειν τάσδ' ἑκών, τελεῖν δ' ὅσ' ἂν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1635.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1635.1.text#μέλλῃς φρονῶν εὖ ξυμφέροντ' αὐτοῖς ἀεί.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1636.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1636.1.text#ὁ δ', ὡς ἀνὴρ γενναῖος, οὐκ οἴκτου μέτα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1637.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1637.1.text#κατῄνεσεν τάδ' ὅρκιος δράσειν ξένῳ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1638.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1638.1.text#ὅπως δὲ ταῦτ' ἔδρασεν, εὐθὺς Οἰδίπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1639.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1639.1.text#ψαύσας ἀμαυραῖς χερσὶν ὧν παίδων λέγει·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1640.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1640.1.text#ὦ παῖδε, τλάσας χρὴ τὸ γενναῖον φρενὶ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1641.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1641.1.text#χωρεῖν τόπων ἐκ τῶνδε, μηδ' ἃ μὴ θέμις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1642.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1642.1.text#λεύσσειν δικαιοῦν μηδὲ φωνούντων κλύειν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1643.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1643.1.text#ἀλλ' ἕρπεθ' ὡς τάχιστα·  πλὴν ὁ κύριος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1644.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1644.1.text#Θησεὺς παρέστω μανθάνων τὰ δρώμενα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1645.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1645.1.text#τοσαῦτα φωνήσαντος εἰσηκούσαμεν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1646.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1646.1.text#ξύμπαντες·  ἀστακτὶ δὲ σὺν ταῖς παρθένοις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1647.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1647.1.text#στένοντες ὡμαρτοῦμεν.  ὡς δ' ἀπήλθομεν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1648.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1648.1.text#χρόνῳ βραχεῖ στραφέντες ἐξαπείδομεν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1649.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1649.1.text#τὸν ἄνδρα τὸν μὲν οὐδαμοῦ παρόντ' ἔτι,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1650.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1650.1.text#ἄνακτα δ'  αὐτὸν ὀμμάτων ἐπίσκιον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1651.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1651.1.text#χεῖρ' ἀντέχοντα κρατός, ὡς δεινοῦ τινος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1652.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1652.1.text#φόβου φανέντος οὐδ' ἀνασχετοῦ βλέπειν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1653.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1653.1.text#ἔπειτα μέντοι βαιὸν οὐδὲ σὺν χρόνῳ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1654.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1654.1.text#ὁρῶμεν αὐτὸν γῆν τε προσκυνοῦνθ' ἅμα
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1655.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1655.1.text#καὶ τὸν θεῶν Ὄλυμπον ἐν ταὐτῷ λόγῳ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1656.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1656.1.text#μόρῳ δ' ὁποίῳ κεῖνος ὤλετ', οὐδ' ἂν εἷς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1657.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1657.1.text#θνητῶν φράσειε, πλὴν τὸ Θησέως κάρα.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1658.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1658.1.text#οὐ γάρ τις αὐτὸν οὔτε πυρφόρος θεοῦ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1659.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1659.1.text#κεραυνὸς ἐξέπραξεν οὔτε ποντία
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1660.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1660.1.text#θύελλα κινηθεῖσα τῷ τότ' ἐν χρόνῳ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1661.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1661.1.text#ἀλλ' ἤ τις ἐκ θεῶν πομπὸς ἢ τὸ νερτέρων
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1662.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1662.1.text#εὔνουν διαστὰν γῆς ἀλύπητον βάθρον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1663.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1663.1.text#ἁνὴρ γὰρ οὐ στενακτὸς οὐδὲ σὺν νόσοις
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1664.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1664.1.text#ἀλγεινὸς ἐξεπέμπετ', ἀλλ' εἴ τις βροτῶν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1665.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1665.1.text#θαυμαστός.  εἰ δὲ μὴ δοκῶ φρονῶν λέγειν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1666.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1666.1.text#οὐκ ἂν παρείμην οἷσι μὴ δοκῶ φρονεῖν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1667.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1667.1.text#ποῦ δ' αἵ τε παῖδες χοἰ προπέμψαντες φίλων;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1668.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1668.1.text#αἵδ' οὐχ ἑκάς·  γόων γὰρ οὐκ ἀσήμονες
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1669.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1669.1.text#φθόγγοι σφε σημαίνουσι δεῦρ' ὁρμωμένας.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1670.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1670.1.text#αἰαῖ, φεῦ, ἔστιν ἔστι νῷν δὴ        
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1671.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1671.1.text#οὐ τὸ μέν, ἄλλο δὲ μή, πατρὸς ἔμφυτον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1672.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1672.1.text#ἄλαστον αἷμα δυσμόροιν στενάζειν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1673.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1673.1.text#ᾧτινι τὸν πολὺν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1674.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1674.1.text#ἄλλοτε μὲν πόνον ἔμπεδον εἴχομεν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1675.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1675.1.text#ἐν πυμάτῳ δ' ἀλόγιστα παροίσομεν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1676.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1676.1.text#ἰδόντε καὶ παθόντε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1677.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1677.1.text#τί δ' ἔστιν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1677.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1677.2.text#ἔστιν μὲν εἰκάσαι, φίλοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1678.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1678.1.text#βέβηκεν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1678.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1678.2.text#ὡς μάλιστ' ἂν ἐν πόθῳ λάβοις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1679.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1679.1.text#τί γάρ, ὅτῳ μήτ' Ἄρης
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1680.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1680.1.text#μήτε πόντος ἀντέκυρσεν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1681.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1681.1.text#ἄσκοποι δὲ πλάκες ἔμαρψαν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1682.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1682.1.text#ἐν ἀφανεῖ τινι μόρῳ φερόμενον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1683.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1683.1.text#τάλαινα·  νῶν δ' ὀλεθρία
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1684.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1684.1.text#νὺξ ἐπ' ὄμμασιν βέβακε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1685.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1685.1.text#πῶς γὰρ ἤ τιν' ἀπίαν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1686.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1686.1.text#γᾶν  ἢ πόντιον κλύδων' ἀλώμεναι, βίου δύσοιστον ἕξομεν τροφάν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1687.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1687.1.text#οὐ κάτοιδα.  κατά με φόνιος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1688.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1688.1.text#Ἀΐδας ἕλοι πατρὶ ξυνθανεῖν γεραιῷ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1690.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1690.1.text#τάλαιναν, ὡς ἔμοιγ' ὁ μέλλων βίος οὐ βιωτός.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1691.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1691.1.text#ὦ διδύμα τέκνων ἀρίστα,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1692.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1692.1.text#τὸ φέρον ἐκ θεοῦ φέρειν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1695.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1695.1.text#μηδὲν ἄγαν φλέγεσθον·  οὔ τοι κατάμεμπτ' ἔβητον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1696.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1696.1.text#πόθος τοὶ  καὶ κακῶν ἄρ'  ἦν τις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1700.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1700.1.text#καὶ γὰρ ὃ μηδαμὰ δὴ φίλον ἦν φίλον,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1701.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1701.1.text#ὁπότε γε καὶ τὸν ἐν χεροῖν κατεῖχον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1702.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1702.1.text#ὦ πάτερ, ὦ φίλος,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1703.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1703.1.text#ὦ τὸν ἀεὶ κατὰ γᾶς σκότον εἱμένος·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1704.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1704.1.text#οὐδέ γ' ἔνερθ'  ἀφίλητος ἐμοί ποτε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1705.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1705.1.text#καὶ τᾷδε μὴ κυρήσῃς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1706.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1706.1.text#ἔπραξεν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1706.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1706.2.text#ἔπραξεν οἷον ἤθελεν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1707.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1707.1.text#τὸ ποῖον;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1707.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1707.2.text#ἇς ἔχρῃζε γᾶς ἐπὶ ξένας
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1708.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1708.1.text#ἔθανε·  κοίταν δ' ἔχει
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1708a.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1708a.text#νέρθεν εὐσκίαστον αἰέν,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1709.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1709.1.text#οὐδὲ πένθος ἔλιπ' ἄκλαυτον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1709a.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1709a.text#ἀνὰ γὰρ ὄμμα σε τόδ', ὦ πάτερ, ἐμὸν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1710.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1710.1.text#στένει δακρῦον, οὐδ'  ἔχω
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1711.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1711.1.text#πῶς με χρὴ τὸ σὸν τάλαιναν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1712.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1712.1.text#ἀφανίσαι τοσόνδ' ἄχος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1713.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1713.1.text#ὤμοι, γᾶς ἐπὶ ξένας θανεῖν ἔχρῃζες ἀλλ'
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1714.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1714.1.text#ἔρημος ἔθανες ὧδέ μοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1715.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1715.1.text#ὦ τάλαινα, τίς ἄρα με πότμος αὖθις ὧδ'
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1716.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1716.1.text#{ … }
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1717.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1717.1.text#{ … }
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1719.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1719.1.text#ἐπαμμένει σέ τ', ὦ φίλα, τὰς πατρὸς ὧδ' ἐρήμας;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1720.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1720.1.text#ἀλλ' ἐπεὶ ὀλβίως γ' ἔλυσεν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1721.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1721.1.text#τὸ τέλος, ὦ φίλαι, βίου,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1722.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1722.1.text#λήγετε τοῦδ' ἄχους·  κακῶν γὰρ δυσάλωτος οὐδείς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1723.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1723.1.text#πάλιν, φίλα, συθῶμεν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1723.2.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1723.2.text#ὡς τί ῥέξομεν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1724.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1724.1.text#ἵμερος ἔχει με.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1724.2.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1724.2.text#τίς;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1725.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1725.1.text#τὰν χθόνιον ἑστίαν ἰδεῖν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1726.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1726.1.text#τίνος;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1726.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1726.2.text#πατρός, τάλαιν' ἐγώ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1727.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1727.1.text#θέμις δὲ πῶς τάδ' ἐστί; μῶν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1728.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1728.1.text#οὐχ ὁρᾷς;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1730.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1730.1.text#τί τόδε  ἐπέπληξας;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1731.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1731.1.text#καὶ τόδ', ὡς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1731.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1731.2.text#τί τόδε μάλ' αὖθις;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1732.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1732.1.text#ἄταφος ἔπιτνε δίχα τε παντός.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1733.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1733.1.text#ἄγε με, καὶ  τότ' ἐπενάριξον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1734.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1734.1.text#αἰαῖ, δυστάλαινα, ποῦ δῆτ'
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1735.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1735.1.text#αὖθις ὧδ' ἔρημος ἄπορος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1736.1.speaker#Ἰσμήνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1736.1.text#αἰῶνα τλάμον' ἕξω;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1737.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1737.1.text#φίλαι, τρέσητε μηδέν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1737.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1737.2.text#ἀλλὰ ποῖ φύγω;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1738.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1738.1.text#καὶ πάρος ἀπέφυγε
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1738.2.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1738.2.text#τί;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1740.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1740.1.text#τὰ σφῷν τὸ  μὴ πίτνειν κακῶς.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1741.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1741.1.text#φρονῶ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1741.2.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1741.2.text#τί δῆθ' ὅπερ νοεῖς;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1742.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1742.1.text#ὅπως μολούμεθ' ἐς δόμους, 
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1743.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1743.1.text#οὐκ ἔχω.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1743.2.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1743.2.text#μηδέ γε μάτευε.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1744.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1744.1.text#μόγος ἔχει.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1744.2.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1744.2.text#καὶ πάρος ἐπεῖχε.
<l speaker="Ἀντιγόνη" n="1745.1" part="F">τοτὲ μὲν ἄπορα, τοτὲ δ' ὕπερθεν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1746.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1746.1.text#μέγ' ἄρα πέλαγος ἐλάχετόν τι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1747.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1747.1.text#ναὶ ναί.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1747.2.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1747.2.text#ξύμφημι καὐτός.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1748.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1748.1.text#αἰαῖ, ποῖ μόλωμεν, ὦ Ζεῦ;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1749.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1749.1.text#ἐλπίδων γὰρ ἐς τίν' ἔτι με
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1750.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1750.1.text#δαίμων τανῦν γ' ἐλαύνει;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1751.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1751.1.text#παύετε θρήνων, παῖδες·  ἐν οἷς γὰρ
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1752.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1752.1.text#χάρις ἡ χθονία ξύν' ἀπόκειται,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1753.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1753.1.text#πενθεῖν οὐ χρή·  νέμεσις γάρ.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1754.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1754.1.text#ὦ τέκνον Αἰγέως, προσπίτνομέν σοι.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1755.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1755.1.text#τίνος, ὦ παῖδες, χρείας ἀνύσαι;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1756.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1756.1.text#τύμβον θέλομεν προσιδεῖν αὐταὶ πατρὸς ἡμετέρου.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1757.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1757.1.text#ἀλλ' οὐ θεμιτόν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1758.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1758.1.text#πῶς εἶπας, ἄναξ,     κοίραν' Ἀθηνῶν;
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1760.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1760.1.text#ὦ παῖδες, ἀπεῖπεν ἐμοὶ κεῖνος
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1761.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1761.1.text#μήτε πελάζειν ἐς τούσδε τόπους
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1762.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1762.1.text#μήτ' ἐπιφωνεῖν μηδένα θνητῶν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1763.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1763.1.text#θήκην ἱεράν, ἣν κεῖνος ἔχει.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1764.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1764.1.text#καὶ ταῦτά μ' ἔφη πράσσοντα καλῶς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1765.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1765.1.text#χώραν ἕξειν αἰὲν ἄλυπον.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1766.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1766.1.text#ταῦτ' οὖν ἔκλυεν δαίμων ἡμῶν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1767.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1767.1.text#χὠ πάντ' ἀΐων Διὸς Ὅρκος.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1768.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1768.1.text#ἀλλ' εἰ τάδ' ἔχει κατὰ νοῦν κείνῳ,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1769.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1769.1.text#ταῦτ' ἂν ἀπαρκοῖ· Θήβας δ' ἡμᾶς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1770.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1770.1.text#τὰς ὠγυγίους πέμψον, ἐάν πως
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1771.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1771.1.text#διακωλύσωμεν ἰόντα φόνον
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1772.1.speaker#Ἀντιγόνη
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1772.1.text#τοῖσιν ὁμαίμοις.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1773.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1773.1.text#δράσω καὶ τάδε καὶ πάνθ' ὁπόσ' ἂν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1774.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1774.1.text#μέλλω πράσσειν πρόσφορά θ' ὑμῖν
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1775.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1775.1.text#καὶ τῷ κατὰ γῆς, ὃς νέον ἔρρει,
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1776.1.speaker#Θησεύς
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1776.1.text#πρὸς χάριν·  οὐ δεῖ μ' ἀποκάμνειν.
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1777.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1777.1.text#ἀλλ' ἀποπαύετε μηδ' ἐπὶ πλείω
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1778.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1778.1.text#θρῆνον ἐγείρετε·
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1779.1.speaker#Χορός
urn:cts:greekLit:tlg0011.tlg007.fu.sp:1779.1.text#πάντως γὰρ ἔχει τάδε κῦρος.
