#!ctsdata
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1.1.text#Ὦ λαμπρὸν ὄμμα τοῦ τροχηλάτου λύχνου
urn:cts:greekLit:tlg0019.tlg010.fu.sp:2.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:2.1.text#κάλλιστ' ἐν εὐστόχοισιν ἐζητημένον·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:3.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:3.1.text#γονάς τε γὰρ σὰς καὶ τύχας δηλώσομεν·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:4.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:4.1.text#τροχῷ γὰρ ἐλαθεὶς κεραμικῆς ῥύμης ὕπο
urn:cts:greekLit:tlg0019.tlg010.fu.sp:5.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:5.1.text#μυκτῆρσι λαμπρὰς ἡλίου τιμὰς ἔχεις·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:6.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:6.1.text#ὅρμα φλογὸς σημεῖα τὰ ξυγκείμενα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:7.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:7.1.text#σοὶ γὰρ μόνῳ δηλοῦμεν εἰκότως, ἐπεὶ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:8.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:8.1.text#κἀν τοῖσι δωματίοισιν Ἀφροδίτης τρόπων
urn:cts:greekLit:tlg0019.tlg010.fu.sp:9.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:9.1.text#πειρωμέναισι πλησίον παραστατεῖς,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:10.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:10.1.text#λορδουμένων τε σωμάτων ἐπιστάτην
urn:cts:greekLit:tlg0019.tlg010.fu.sp:11.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:11.1.text#ὀφθαλμὸν οὐδεὶς τὸν σὸν ἐξείργει δόμων.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:12.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:12.1.text#μόνος δὲ μηρῶν εἰς ἀπορρήτους μυχοὺς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:13.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:13.1.text#λάμπεις ἀφεύων τὴν ἐπανθοῦσαν τρίχα·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:14.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:14.1.text#στοάς τε καρποῦ Βακχίου τε νάματος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:15.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:15.1.text#πλήρεις ὑποιγνύσαισι συμπαραστατεῖς·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:16.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:16.1.text#καὶ ταῦτα συνδρῶν οὐ λαλεῖς τοῖς πλησίον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:17.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:17.1.text#ἀνθ' ὧν συνείσει καὶ τὰ νῦν βουλεύματα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:18.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:18.1.text#ὅσα Σκίροις ἔδοξε ταῖς ἐμαῖς φίλαις.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:19.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:19.1.text#ἀλλ' οὐδεμία πάρεστιν ἃς ἥκειν ἐχρῆν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:20.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:20.1.text#καίτοι πρὸς ὄρθρον γ' ἐστίν· ἡ δ' ἐκκλησία
urn:cts:greekLit:tlg0019.tlg010.fu.sp:21.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:21.1.text#αὐτίκα μάλ' ἔσται· καταλαβεῖν δ' ἡμᾶς ἕδρας,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:22.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:22.1.text#ἃς Φυρόμαχός ποτ' εἶπεν, εἰ μέμνησθ' ἔτι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:23.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:23.1.text#δεῖ τὰς ἑτέρας πως κἀγκαθεζομένας λαθεῖν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:24.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:24.1.text#τί δῆτ' ἂν εἴη; πότερον οὐκ ἐρραμμένους
urn:cts:greekLit:tlg0019.tlg010.fu.sp:25.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:25.1.text#ἔχουσι τοὺς πώγωνας, οὓς εἴρητ' ἔχειν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:26.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:26.1.text#ἢ θαἰμάτια τἀνδρεῖα κλεψάσαις λαθεῖν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:27.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:27.1.text#ἦν χαλεπὸν αὐταῖς; ἀλλ' ὁρῶ τονδὶ λύχνον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:28.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:28.1.text#προσιόντα. φέρε νυν ἐπαναχωρήσω πάλιν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:29.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:29.1.text#μὴ καί τις ὢν ἀνὴρ ὁ προσιὼν τυγχάνῃ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:30.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:30.1.text#ὥρα βαδίζειν, ὡς ὁ κῆρυξ ἀρτίως
urn:cts:greekLit:tlg0019.tlg010.fu.sp:31.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:31.1.text#ἡμῶν προσιουσῶν δεύτερον κεκόκκυκεν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:32.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:32.1.text#ἐγὼ δέ γ' ὑμᾶς προσδοκῶσ' ἠγρηγόρη
urn:cts:greekLit:tlg0019.tlg010.fu.sp:33.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:33.1.text#τὴν νύκτα πᾶσαν. ἀλλὰ φέρε τὴν γείτονα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:34.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:34.1.text#τήνδ' ἐκκαλέσωμαι θρυγονῶσα τὴν θύραν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:35.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:35.1.text#δεῖ γὰρ τὸν ἄνδρ' αὐτῆς λαθεῖν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:35.2.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:35.2.text#ἤκουσά τοι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:36.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:36.1.text#ὑποδουμένη τὸ κνῦμά σου τῶν δακτύλων,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:37.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:37.1.text#ἅτ' οὐ καταδαρθοῦσ'. ὁ γὰρ ἀνὴρ ὦ φιλτάτη,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:38.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:38.1.text#Σαλαμίνιος γάρ ἐστιν ᾧ ξύνειμ' ἐγώ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:39.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:39.1.text#τὴν νύχθ' ὅλην ἤλαυνέ μ' ἐν τοῖς στρώμασιν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:40.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:40.1.text#ὥστ' ἄρτι τουτὶ θοἰμάτιον αὐτοῦ 'λαβον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:41.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:41.1.text#καὶ μὴν ὁρῶ καὶ Κλειναρέτην καὶ Σωστράτην
urn:cts:greekLit:tlg0019.tlg010.fu.sp:42.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:42.1.text#προσιοῦσαν ἤδη τήνδε καὶ Φιλαινέτην.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:43.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:43.1.text#οὔκουν ἐπείξεσθ'; ὡς Γλύκη κατώμοσεν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:44.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:44.1.text#τὴν ὑστάτην ἥκουσαν οἴνου τρεῖς χοᾶς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:45.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:45.1.text#ἡμῶν ἀποτείσειν κἀρεβίνθων χοίνικα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:46.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:46.1.text#τὴν Σμικυθίωνος δ' οὐχ ὁρᾷς Μελιστίχην
urn:cts:greekLit:tlg0019.tlg010.fu.sp:47.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:47.1.text#σπεύδουσαν ἐν ταῖς ἐμβάσιν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:47.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:47.2.text#καίτοι δοκεῖ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:48.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:48.1.text#κατὰ σχολὴν παρὰ τἀνδρὸς ἐξελθεῖν μόνη.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:49.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:49.1.text#τὴν τοῦ καπήλου δ' οὐχ ὁρᾷς Γευσιστράτην
urn:cts:greekLit:tlg0019.tlg010.fu.sp:50.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:50.1.text#ἔχουσαν ἐν τῇ δεξιᾷ τὴν λαμπάδα;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:51.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:51.1.text#καὶ τὴν Φιλοδωρήτου τε καὶ Χαιρητάδου
urn:cts:greekLit:tlg0019.tlg010.fu.sp:52.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:52.1.text#ὁρῶ προσιούσας χἀτέρας πολλὰς πάνυ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:53.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:53.1.text#γυναῖκας, ὅ τι πέρ ἐστ' ὄφελος ἐν τῇ πόλει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:54.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:54.1.text#καὶ πάνυ ταλαιπώρως ἔγωγ' ὦ φιλτάτη
urn:cts:greekLit:tlg0019.tlg010.fu.sp:55.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:55.1.text#ἐκδρᾶσα παρέδυν. ὁ γὰρ ἀνὴρ τὴν νύχθ' ὅλην
urn:cts:greekLit:tlg0019.tlg010.fu.sp:56.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:56.1.text#ἔβηττε τριχίδων ἑσπέρας ἐμπλήμενος.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:57.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:57.1.text#κάθησθε τοίνυν, ὡς ἂν ἀνέρωμαι τάδε
urn:cts:greekLit:tlg0019.tlg010.fu.sp:58.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:58.1.text#ὑμᾶς, ἐπειδὴ συλλελεγμένας ὁρῶ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:59.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:59.1.text#ὅσα Σκίροις ἔδοξεν εἰ δεδράκατε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:60.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:60.1.text#ἔγωγε. πρῶτον μέν γ' ἔχω τὰς μασχάλας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:61.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:61.1.text#λόχμης δασυτέρας, καθάπερ ἦν ξυγκείμενον·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:62.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:62.1.text#ἔπειθ' ὁπόθ' ἁνὴρ εἰς ἀγορὰν οἴχοιτό μου,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:63.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:63.1.text#ἀλειψαμένη τὸ σῶμ' ὅλον δι' ἡμέρας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:64.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:64.1.text#ἐχραινόμην ἑστῶσα πρὸς τὸν ἥλιον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:65.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:65.1.text#κἄγωγε· τὸ ξυρὸν δέ γ' ἐκ τῆς οἰκίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:66.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:66.1.text#ἔρριψα πρῶτον, ἵνα δασυνθείην ὅλη
urn:cts:greekLit:tlg0019.tlg010.fu.sp:67.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:67.1.text#καὶ μηδὲν εἴην ἔτι γυναικὶ προσφερής.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:68.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:68.1.text#ἔχετε δὲ τοὺς πώγωνας, οὓς εἴρητ' ἔχειν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:69.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:69.1.text#πάσαισιν ἡμῖν, ὁπότε συλλεγοίμεθα;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:70.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:70.1.text#νὴ τὴν Ἑκάτην καλόν γ' ἔγωγε τουτονί.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:71.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:71.1.text#κἄγωγ' Ἑπικράτους οὐκ ὀλίγῳ καλλίονα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:72.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:72.1.text#ὑμεῖς δὲ τί φατε;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:72.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:72.2.text#φασί· κατανεύουσι γάρ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:73.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:73.1.text#καὶ μὴν τά γ' ἄλλ' ὑμῖν ὁρῶ πεπραγμένα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:74.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:74.1.text#Λακωνικὰς γὰρ ἔχετε καὶ βακτηρίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:75.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:75.1.text#καὶ θαἰμάτια τἀνδρεῖα, καθάπερ εἴπομεν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:76.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:76.1.text#ἔγωγέ τοι τὸ σκύταλον ἐξηνεγκάμην
urn:cts:greekLit:tlg0019.tlg010.fu.sp:77.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:77.1.text#τὸ τοῦ Λαμίου τουτὶ καθεύδοντος λάθρᾳ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:78.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:78.1.text#τοῦτ' ἔστ' ἐκείνων τῶν σκυτάλων ὧν πέρδεται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:79.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:79.1.text#νὴ τὸν Δία τὸν σωτῆρ' ἐπιτήδειός γ' ἂν ἦν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:80.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:80.1.text#τὴν τοῦ πανόπτου διφθέραν ἐνημμένος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:81.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:81.1.text#εἴπερ τις ἄλλος βουκολεῖν τὸ δήμιον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:82.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:82.1.text#ἀλλ' ἄγεθ' ὅπως καὶ τἀπὶ τούτοις δράσομεν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:83.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:83.1.text#ἕως ἔτ' ἐστὶν ἄστρα κατὰ τὸν οὐρανόν·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:84.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:84.1.text#ἡκκλησία δ', εἰς ἣν παρεσκευάσμεθα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:85.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:85.1.text#ἡμεῖς βαδίζειν, ἐξ ἕω γενήσεται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:86.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:86.1.text#νὴ τὸν Δί' ὥστε δεῖ σε καταλαβεῖν ἕδρας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:87.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:87.1.text#ὑπὸ τῷ λίθῳ τῶν πρυτάνεων καταντικρύ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:88.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:88.1.text#ταυτί γέ τοι νὴ τὸν Δί' ἐφερόμην, ἵνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:89.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:89.1.text#πληρουμένης ξαίνοιμι τῆς ἐκκλησίας.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:90.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:90.1.text#πληρουμένης τάλαινα;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:90.2.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:90.2.text#νὴ τὴν Ἄρτεμιν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:91.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:91.1.text#ἔγωγε. τί γὰρ ἂν χεῖρον ἀκροῴμην ἄρα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:92.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:92.1.text#ξαίνουσα; γυμνὰ δ' ἐστί μου τὰ παιδία.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:93.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:93.1.text#ἰδού γέ σε ξαίνουσαν, ἣν τοῦ σώματος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:94.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:94.1.text#οὐδὲν παραφῆναι τοῖς καθημένοις ἔδει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:95.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:95.1.text#οὐκοῦν καλά γ' ἂν πάθοιμεν, εἰ πλήρης τύχοι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:96.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:96.1.text#ὁ δῆμος ὢν κἄπειθ' ὑπερβαίνουσά τις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:97.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:97.1.text#ἀναβαλλομένη δείξειε τὸν Φορμίσιον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:98.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:98.1.text#ἢν δ' ἐγκαθεζώμεσθα πρότεραι, λήσομεν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:99.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:99.1.text#ξυστειλάμεναι θαἰμάτια· τὸν πώγωνά τε
urn:cts:greekLit:tlg0019.tlg010.fu.sp:100.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:100.1.text#ὅταν καθῶμεν ὃν περιδησόμεσθ' ἐκεῖ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:101.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:101.1.text#τίς οὐκ ἂν ἡμᾶς ἄνδρας ἡγήσαιθ' ὁρῶν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:102.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:102.1.text#Ἀγύρριος γοῦν τὸν Προνόμου πώγων' ἔχων
urn:cts:greekLit:tlg0019.tlg010.fu.sp:103.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:103.1.text#λέληθε· καίτοι πρότερον ἦν οὗτος γυνή·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:104.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:104.1.text#νυνὶ δ', ὁρᾷς, πράττει τὰ μέγιστ' ἐν τῇ πόλει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:105.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:105.1.text#τούτου γε τοίνυν τὴν ἐπιοῦσαν ἡμέραν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:106.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:106.1.text#τόλμημα τολμῶμεν τοσοῦτον οὕνεκα,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:107.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:107.1.text#ἤν πως παραλαβεῖν τῆς πόλεως τὰ πράγματα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:108.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:108.1.text#δυνώμεθ', ὥστ' ἀγαθόν τι πρᾶξαι τὴν πόλιν·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:109.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:109.1.text#νῦν μὲν γὰρ οὔτε θέομεν οὔτ' ἐλαύνομεν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:110.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:110.1.text#καὶ πῶς γυναικῶν θηλύφρων ξυνουσία
urn:cts:greekLit:tlg0019.tlg010.fu.sp:111.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:111.1.text#δημηγορήσει;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:111.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:111.2.text#πολὺ μὲν οὖν ἄριστά που.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:112.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:112.1.text#λέγουσι γὰρ καὶ τῶν νεανίσκων ὅσοι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:113.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:113.1.text#πλεῖστα σποδοῦνται, δεινοτάτους εἶναι λέγειν·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:114.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:114.1.text#ἡμῖν δ' ὑπάρχει τοῦτο κατὰ τύχην τινά.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:115.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:115.1.text#οὐκ οἶδα· δεινὸν δ' ἐστὶν ἡ μὴ 'μπειρία.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:116.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:116.1.text#οὐκοῦν ἐπίτηδες ξυνελέγημεν ἐνθάδε,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:117.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:117.1.text#ὅπως προμελετήσωμεν ἁκεῖ δεῖ λέγειν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:118.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:118.1.text#οὐκ ἂν φθάνοις τὸ γένειον ἂν περιδουμένη
urn:cts:greekLit:tlg0019.tlg010.fu.sp:119.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:119.1.text#ἄλλαι θ' ὅσαι λαλεῖν μεμελετήκασί που.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:120.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:120.1.text#τίς δ' ὦ μέλ' ἡμῶν οὐ λαλεῖν ἐπίσταται;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:121.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:121.1.text#ἴθι δὴ σὺ περιδοῦ καὶ ταχέως ἀνὴρ γενοῦ·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:122.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:122.1.text#ἐγὼ δὲ θεῖσα τοὺς στεφάνους περιδήσομαι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:123.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:123.1.text#καὐτὴ μεθ' ὑμῶν, ἤν τί μοι δόξῃ λέγειν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:124.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:124.1.text#δεῦρ' ὦ γλυκυτάτη Πραξαγόρα, σκέψαι τάλαν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:125.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:125.1.text#ὡς καὶ καταγέλαστον τὸ πρᾶγμα φαίνεται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:126.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:126.1.text#πῶς καταγέλαστον;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:126.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:126.2.text#ὥσπερ εἴ τις σηπίαις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:127.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:127.1.text#πώγωνα περιδήσειεν ἐσταθευμέναις.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:128.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:128.1.text#ὁ περιστίαρχος, περιφέρειν χρὴ τὴν γαλῆν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:129.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:129.1.text#πάριτ' ἐς τὸ πρόσθεν. Ἀρίφραδες παῦσαι λαλῶν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:130.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:130.1.text#κάθιζε παριών. τίς ἀγορεύειν βούλεται;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:131.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:131.1.text#ἐγώ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:131.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:131.2.text#περίθου δὴ τὸν στέφανον τύχἀγαθῇ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:132.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:132.1.text#ἰδού.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:132.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:132.2.text#λέγοις ἄν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:132.3.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:132.3.text#εἶτα πρὶν πιεῖν λέγω;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:133.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:133.1.text#ἰδοὺ πιεῖν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:133.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:133.2.text#τί γὰρ ὦ μέλ' ἐστεφανωσάμην;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:134.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:134.1.text#ἄπιθ' ἐκποδών· τοιαῦτ' ἂν ἡμᾶς ἠργάσω
urn:cts:greekLit:tlg0019.tlg010.fu.sp:135.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:135.1.text#κἀκεῖ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:135.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:135.2.text#τί δ'; οὐ πίνουσι κἀν τἠκκλησίᾳ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:136.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:136.1.text#ἰδού γε σοὶ πίνουσι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:136.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:136.2.text#νὴ τὴν Ἄρτεμιν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:137.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:137.1.text#καὶ ταῦτα γ' εὔζωρον. τὰ γοῦν βουλεύματα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:138.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:138.1.text#αὐτῶν ὅσ' ἂν πράξωσιν ἐνθυμουμένοις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:139.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:139.1.text#ὥσπερ μεθυόντων ἐστὶ παραπεπληγμένα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:140.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:140.1.text#καὶ νὴ Δία σπένδουσί γ'· ἢ τίνος χάριν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:141.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:141.1.text#τοσαῦτ' ἂν ηὔχοντ', εἴπερ οἶνος μὴ παρῆν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:142.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:142.1.text#καὶ λοιδοροῦνταί γ' ὥσπερ ἐμπεπωκότες,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:143.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:143.1.text#καὶ τὸν παροινοῦντ' ἐκφέρουσ' οἱ τοξόται,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:144.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:144.1.text#σὺ μὲν βάδιζε καὶ κάθησ'· οὐδὲν γὰρ εἶ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:145.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:145.1.text#νὴ τὸν Δί' ἦ μοι μὴ γενειᾶν κρεῖττον ἦν·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:146.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:146.1.text#δίψῃ γάρ, ὡς ἔοικ', ἀφαυανθήσομαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:147.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:147.1.text#ἔσθ' ἥτις ἑτέρα βούλεται λέγειν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:147.2.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:147.2.text#ἐγώ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:148.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:148.1.text#ἴθι δὴ στεφανοῦ· καὶ γὰρ τὸ χρῆμ' ἐργάζεται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:149.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:149.1.text#ἄγε νυν ὅπως ἀνδριστὶ καὶ καλῶς ἐρεῖς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:150.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:150.1.text#διερεισαμένη τὸ σχῆμα τῇ βακτηρίᾳ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:151.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:151.1.text#ἐβουλόμην μὲν ἂν ἕτερον τῶν ἠθάδων
urn:cts:greekLit:tlg0019.tlg010.fu.sp:152.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:152.1.text#λέγειν τὰ βέλτισθ', ἵν' ἐκαθήμην ἥσυχος·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:153.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:153.1.text#νῦν δ' οὐκ ἐάσω κατά γε τὴν ἐμὴν μίαν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:154.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:154.1.text#ἐν τοῖς καπηλείοισι λάκκους ἐμποιεῖν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:155.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:155.1.text#ὕδατος. ἐμοὶ μὲν οὐ δοκεῖ μὰ τὼ θεώ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:156.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:156.1.text#μὰ τὼ θεώ; τάλαινα ποῦ τὸν νοῦν ἔχεις;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:157.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:157.1.text#τί δ' ἔστιν; οὐ γὰρ δὴ πιεῖν γ' ᾔτησά σε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:158.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:158.1.text#μὰ Δί' ἀλλ' ἀνὴρ ὢν τὼ θεὼ κατώμοσας,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:159.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:159.1.text#καίτοι τά γ' ἄλλ' εἰποῦσα δεξιώτατα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:160.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:160.1.text#ὢ νὴ τὸν Ἀπόλλω.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:160.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:160.2.text#παῦε τοίνυν, ὡς ἐγὼ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:161.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:161.1.text#ἐκκλησιάσουσ' οὐκ ἂν προβαίην τὸν πόδα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:162.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:162.1.text#τὸν ἕτερον, εἰ μὴ ταῦτ' ἀκριβωθήσεται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:163.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:163.1.text#φέρε τὸν στέφανον· ἐγὼ γὰρ αὖ λέξω πάλιν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:164.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:164.1.text#οἶμαι γὰρ ἤδη μεμελετηκέναι καλῶς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:165.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:165.1.text#ἐμοὶ γὰρ ὦ γυναῖκες αἱ καθήμεναι—
urn:cts:greekLit:tlg0019.tlg010.fu.sp:166.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:166.1.text#γυναῖκας αὖ δύστηνε τοὺς ἄνδρας λέγεις;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:167.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:167.1.text#δι' Ἐπίγονόν γ' ἐκεῖνον· ἐπιβλέψασα γὰρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:168.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:168.1.text#ἐκεῖσε πρὸς γυναῖκας ᾠόμην λέγειν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:169.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:169.1.text#ἄπερρε καὶ σὺ καὶ κάθησ' ἐντευθενί·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:170.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:170.1.text#αὐτὴ γὰρ ὑμῶν γ' ἕνεκά μοι λέξειν δοκῶ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:171.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:171.1.text#τονδὶ λαβοῦσα. τοῖς θεοῖς μὲν εὔχομαι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:172.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:172.1.text#τυχεῖν κατορθώσασα τὰ βεβουλευμένα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:173.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:173.1.text#ἐμοὶ δ' ἴσον μὲν τῆσδε τῆς χώρας μέτα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:174.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:174.1.text#ὅσονπερ ὑμῖν· ἄχθομαι δὲ καὶ φέρω
urn:cts:greekLit:tlg0019.tlg010.fu.sp:175.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:175.1.text#τὰ τῆς πόλεως ἅπαντα βαρέως πράγματα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:176.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:176.1.text#ὁρῶ γὰρ αὐτὴν προστάταισι χρωμένην
urn:cts:greekLit:tlg0019.tlg010.fu.sp:177.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:177.1.text#ἀεὶ πονηροῖς· κἄν τις ἡμέραν μίαν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:178.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:178.1.text#χρηστὸς γένηται, δέκα πονηρὸς γίγνεται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:179.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:179.1.text#ἐπέτρεψας ἑτέρῳ· πλείον' ἔτι δράσει κακά.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:180.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:180.1.text#χαλεπὸν μὲν οὖν ἄνδρας δυσαρέστους νουθετεῖν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:181.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:181.1.text#οἳ τοὺς φιλεῖν μὲν βουλομένους δεδοίκατε,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:182.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:182.1.text#τοὺς δ' οὐκ ἐθέλοντας ἀντιβολεῖθ' ἑκάστοτε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:183.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:183.1.text#ἐκκλησίαισιν ἦν ὅτ' οὐκ ἐχρώμεθα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:184.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:184.1.text#οὐδὲν τὸ παράπαν· ἀλλὰ τόν γ' Ἀγύρριον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:185.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:185.1.text#πονηρὸν ἡγούμεσθα· νῦν δὲ χρωμένων
urn:cts:greekLit:tlg0019.tlg010.fu.sp:186.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:186.1.text#ὁ μὲν λαβὼν ἀργύριον ὑπερεπῄνεσεν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:187.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:187.1.text#ὁ δ' οὐ λαβὼν εἶναι θανάτου φήσ' ἀξίους
urn:cts:greekLit:tlg0019.tlg010.fu.sp:188.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:188.1.text#τοὺς μισθοφορεῖν ζητοῦντας ἐν τἠκκλησίᾳ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:189.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:189.1.text#νὴ τὴν Ἀφροδίτην εὖ γε ταυταγὶ λέγεις.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:190.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:190.1.text#τάλαιν' Ἀφροδίτην ὤμοσας; χαρίεντά γ' ἂν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:191.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:191.1.text#ἔδρασας, εἰ τοῦτ' εἶπας ἐν τἠκκλησίᾳ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:192.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:192.1.text#ἀλλ' οὐκ ἂν εἶπον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:192.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:192.2.text#μηδ' ἐθίζου νῦν λέγειν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:193.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:193.1.text#τὸ συμμαχικὸν αὖ τοῦθ', ὅτ' ἐσκοπούμεθα,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:194.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:194.1.text#εἰ μὴ γένοιτ', ἀπολεῖν ἔφασκον τὴν πόλιν·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:195.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:195.1.text#ὅτε δὴ δ' ἐγένετ', ἤχθοντο, τῶν δὲ ῥητόρων
urn:cts:greekLit:tlg0019.tlg010.fu.sp:196.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:196.1.text#ὁ τοῦτ' ἀναπείσας εὐθὺς ἀποδρὰς ᾤχετο.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:197.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:197.1.text#ναῦς δεῖ καθέλκειν· τῷ πένητι μὲν δοκεῖ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:198.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:198.1.text#τοῖς πλουσίοις δὲ καὶ γεωργοῖς οὐ δοκεῖ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:199.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:199.1.text#Κορινθίοις ἄχθεσθε, κἀκεῖνοί γέ σοι·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:200.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:200.1.text#νῦν εἰσὶ χρηστοί, καὶ σύ νυν χρηστὸς γενοῦ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:201.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:201.1.text#Ἀργεῖος ἀμαθής, ἀλλ' Ἱερώνυμος σοφός·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:202.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:202.1.text#σωτηρία παρέκυψεν, ἀλλ' ὡρᾴζεται
urn:cts:greekLit:tlg0019.tlg010.fu.sp:203.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:203.1.text#Θρασύβουλος αὐτὸς οὐχὶ παρακαλούμενος.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:204.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:204.1.text#ὡς ξυνετὸς ἁνήρ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:204.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:204.2.text#νῦν καλῶς ἐπῄνεσας.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:205.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:205.1.text#ὑμεῖς γάρ ἐστ' ὦ δῆμε τούτων αἴτιοι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:206.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:206.1.text#τὰ δημόσια γὰρ μισθοφοροῦντες χρήματα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:207.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:207.1.text#ἰδίᾳ σκοπεῖσθ' ἕκαστος ὅ τι τις κερδανεῖ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:208.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:208.1.text#τὸ δὲ κοινὸν ὥσπερ Αἴσιμος κυλίνδεται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:209.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:209.1.text#ἢν οὖν ἐμοὶ πίθησθε, σωθήσεσθ' ἔτι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:210.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:210.1.text#ταῖς γὰρ γυναιξὶ φημὶ χρῆναι τὴν πόλιν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:211.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:211.1.text#ἡμᾶς παραδοῦναι. καὶ γὰρ ἐν ταῖς οἰκίαις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:212.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:212.1.text#ταύταις ἐπιτρόποις καὶ ταμίαισι χρώμεθα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:213.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:213.1.text#εὖ γ' εὖ γε νὴ Δί' εὖ γε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:213.2.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:213.2.text#λέγε λέγ' ὦγαθέ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:214.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:214.1.text#ὡς δ' εἰσὶν ἡμῶν τοὺς τρόπους βελτίονες
urn:cts:greekLit:tlg0019.tlg010.fu.sp:215.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:215.1.text#ἐγὼ διδάξω. πρῶτα μὲν γὰρ τἄρια
urn:cts:greekLit:tlg0019.tlg010.fu.sp:216.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:216.1.text#βάπτουσι θερμῷ κατὰ τὸν ἀρχαῖον νόμον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:217.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:217.1.text#ἁπαξάπασαι, κοὐχὶ μεταπειρωμένας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:218.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:218.1.text#ἴδοις ἂν αὐτάς. ἡ δ' Ἀθηναίων πόλις,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:219.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:219.1.text#εἰ τοῦτο χρηστῶς εἶχεν, οὐκ ἂν ἐσῴζετο,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:220.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:220.1.text#εἰ μή τι καινὸν ἄλλο περιηργάζετο.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:221.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:221.1.text#καθήμεναι φρύγουσιν ὥσπερ καὶ πρὸ τοῦ·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:222.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:222.1.text#ἐπὶ τῆς κεφαλῆς φέρουσιν ὥσπερ καὶ πρὸ τοῦ·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:223.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:223.1.text#τὰ Θεσμοφόρι' ἄγουσιν ὥσπερ καὶ πρὸ τοῦ·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:224.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:224.1.text#πέττουσι τοὺς πλακοῦντας ὥσπερ καὶ πρὸ τοῦ·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:225.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:225.1.text#τοὺς ἄνδρας ἐπιτρίβουσιν ὥσπερ καὶ πρὸ τοῦ·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:225a.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:225a.1.text#μοιχοὺς ἔχουσιν ἔνδον ὥσπερ καὶ πρὸ τοῦ·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:226.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:226.1.text#αὑταῖς παροψωνοῦσιν ὥσπερ καὶ πρὸ τοῦ·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:227.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:227.1.text#οἶνον φιλοῦσ' εὔζωρον ὥσπερ καὶ πρὸ τοῦ·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:228.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:228.1.text#βινούμεναι χαίρουσιν ὥσπερ καὶ πρὸ τοῦ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:229.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:229.1.text#ταύταισιν οὖν ὦνδρες παραδόντες τὴν πόλιν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:230.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:230.1.text#μὴ περιλαλῶμεν, μηδὲ πυνθανώμεθα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:231.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:231.1.text#τί ποτ' ἄρα δρᾶν μέλλουσιν, ἀλλ' ἁπλῷ τρόπῳ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:232.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:232.1.text#ἐῶμεν ἄρχειν, σκεψάμενοι ταυτὶ μόνα,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:233.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:233.1.text#ὡς τοὺς στρατιώτας πρῶτον οὖσαι μητέρες
urn:cts:greekLit:tlg0019.tlg010.fu.sp:234.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:234.1.text#σῴζειν ἐπιθυμήσουσιν· εἶτα σιτία
urn:cts:greekLit:tlg0019.tlg010.fu.sp:235.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:235.1.text#τίς τῆς τεκούσης μᾶλλον ἐπιπέμψειεν ἄν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:236.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:236.1.text#χρήματα πορίζειν εὐπορώτατον γυνή,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:237.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:237.1.text#ἄρχουσά τ' οὐκ ἂν ἐξαπατηθείη ποτέ·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:238.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:238.1.text#αὐταὶ γάρ εἰσιν ἐξαπατᾶν εἰθισμέναι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:239.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:239.1.text#τὰ δ' ἄλλ' ἐάσω· ταῦτ' ἐὰν πίθησθέ μοι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:240.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:240.1.text#εὐδαιμονοῦντες τὸν βίον διάξετε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:241.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:241.1.text#εὖ γ' ὦ γλυκυτάτη Πραξαγόρα καὶ δεξιῶς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:242.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:242.1.text#πόθεν ὦ τάλαινα ταῦτ' ἔμαθες οὕτω καλῶς;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:243.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:243.1.text#ἐν ταῖς φυγαῖς μετὰ τἀνδρὸς ᾤκησ' ἐν πυκνί·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:244.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:244.1.text#ἔπειτ' ἀκούουσ' ἐξέμαθον τῶν ῥητόρων.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:245.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:245.1.text#οὐκ ἐτὸς ἄρ' ὦ μέλ' ἦσθα δεινὴ καὶ σοφή·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:246.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:246.1.text#καί σε στρατηγεῖν αἱ γυναῖκες αὐτόθεν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:247.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:247.1.text#αἱρούμεθ', ἢν ταῦθ' ἁπινοεῖς κατεργάσῃ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:248.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:248.1.text#ἀτὰρ ἢν Κέφαλός σοι λοιδορῆται προσφθαρείς,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:249.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:249.1.text#πῶς ἀντερεῖς πρὸς αὐτὸν ἐν τἠκκλησίᾳ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:250.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:250.1.text#φήσω παραφρονεῖν αὐτόν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:250.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:250.2.text#ἀλλὰ τοῦτό γε
urn:cts:greekLit:tlg0019.tlg010.fu.sp:251.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:251.1.text#ἴσασι πάντες.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:251.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:251.2.text#ἀλλὰ καὶ μελαγχολᾶν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:252.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:252.1.text#καὶ τοῦτ' ἴσασιν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:252.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:252.2.text#ἀλλὰ καὶ τὰ τρύβλια
urn:cts:greekLit:tlg0019.tlg010.fu.sp:253.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:253.1.text#κακῶς κεραμεύειν, τὴν δὲ πόλιν εὖ καὶ καλῶς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:254.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:254.1.text#τί δ' ἢν Νεοκλείδης ὁ γλάμων σε λοιδορῇ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:255.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:255.1.text#τούτῳ μὲν εἶπον ἐς κυνὸς πυγὴν ὁρᾶν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:256.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:256.1.text#τί δ' ἢν ὑποκρούωσίν σε;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:256.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:256.2.text#προσκινήσομαι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:257.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:257.1.text#ἅτ' οὐκ ἄπειρος οὖσα πολλῶν κρουμάτων.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:258.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:258.1.text#ἐκεῖνο μόνον ἄσκεπτον, ἤν σ' οἱ τοξόται
urn:cts:greekLit:tlg0019.tlg010.fu.sp:259.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:259.1.text#ἕλκωσιν, ὅ τι δράσεις ποτ'.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:259.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:259.2.text#ἐξαγκωνιῶ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:260b.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:260b.1.text#ὡδί· μέση γὰρ οὐδέποτε ληφθήσομαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:261.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:261.1.text#ἡμεῖς δέ γ', ἢν αἴρωσ', ἐᾶν κελεύσομεν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:262.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:262.1.text#ταυτὶ μὲν ἡμῖν ἐντεθύμηται καλῶς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:263.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:263.1.text#ἐκεῖνο δ' οὐ πεφροντίκαμεν, ὅτῳ τρόπῳ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:264.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:264.1.text#τὰς χεῖρας αἴρειν μνημονεύσομεν τότε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:265.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:265.1.text#εἰθισμέναι γάρ ἐσμεν αἴρειν τὼ σκέλει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:266.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:266.1.text#χαλεπὸν τὸ πρᾶγμ'· ὅμως δὲ χειροτονητέον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:267.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:267.1.text#ἐξωμισάσαις τὸν ἕτερον βραχίονα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:268.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:268.1.text#ἄγε νυν ἀναστέλλεσθ' ἄνω τὰ χιτώνια·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:269.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:269.1.text#ὑποδεῖσθε δ' ὡς τάχιστα τὰς Λακωνικάς,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:270.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:270.1.text#ὥσπερ τὸν ἄνδρ' ἐθεᾶσθ', ὅτ' εἰς ἐκκλησίαν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:271.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:271.1.text#μέλλοι βαδίζειν ἢ θύραζ' ἑκάστοτε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:272.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:272.1.text#ἔπειτ' ἐπειδὰν ταῦτα πάντ' ἔχῃ καλῶς,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:273.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:273.1.text#περιδεῖσθε τοὺς πώγωνας. ἡνίκ' ἂν δέ γε
urn:cts:greekLit:tlg0019.tlg010.fu.sp:274.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:274.1.text#τούτους ἀκριβώσητε περιηρμοσμέναι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:275.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:275.1.text#καὶ θαἰμάτια τἀνδρεῖά γ' ἅπερ ἐκλέψατε
urn:cts:greekLit:tlg0019.tlg010.fu.sp:276.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:276.1.text#ἐπαναβάλεσθε, κᾆτα ταῖς βακτηρίαις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:277.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:277.1.text#ἐπερειδόμεναι βαδίζετ' ᾄδουσαι μέλος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:278.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:278.1.text#πρεσβυτικόν τι, τὸν τρόπον μιμούμεναι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:279.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:279.1.text#τὸν τῶν ἀγροίκων.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:279.2.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:279.2.text#εὖ λέγεις· ἡμεῖς δέ γε
urn:cts:greekLit:tlg0019.tlg010.fu.sp:280.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:280.1.text#προΐωμεν αὐτῶν. καὶ γὰρ ἑτέρας οἴομαι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:281.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:281.1.text#ἐκ τῶν ἀγρῶν ἐς τὴν πύκν' ἥξειν ἄντικρυς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:282.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:282.1.text#γυναῖκας.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:282.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:282.2.text#ἀλλὰ σπεύσαθ' ὡς εἴωθ' ἐκεῖ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:283.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:283.1.text#τοῖς μὴ παροῦσιν ὀρθρίοις ἐς τὴν πύκνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:284.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:284.1.text#ὑπαποτρέχειν ἔχουσι μηδὲ πάτταλον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:285.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:285.1.text#ὥρα προβαίνειν ὦνδρες ἡμῖν ἐστι· τοῦτο γὰρ χρὴ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:286.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:286.1.text#μεμνημένας ἀεὶ λέγειν, ὡς μήποτ' ἐξολίσθῃ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:287.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:287.1.text#ἡμᾶς. ὁ κίνδυνος γὰρ οὐχὶ μικρός, ἢν ἁλῶμεν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:288.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:288.1.text#ἐνδυόμεναι κατὰ σκότον τόλμημα τηλικοῦτον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:289.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:289.1.text#χωρῶμεν εἰς ἐκκλησίαν ὦνδρες· ἠπείλησε γὰρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:290.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:290.1.text#ὁ θεσμοθέτης, ὃς ἂν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:290a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:290a.1.text#μὴ πρῲ πάνυ τοῦ κνέφους
urn:cts:greekLit:tlg0019.tlg010.fu.sp:291.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:291.1.text#ἥκῃ κεκονιμένος,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:291a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:291a.1.text#στέργων σκοροδάλμῃ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:292.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:292.1.text#βλέπων ὑπότριμμα, μὴ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:292a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:292a.1.text#δώσειν τὸ τριώβολον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:293.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:293.1.text#ἀλλ' ὦ Χαριτιμίδη
urn:cts:greekLit:tlg0019.tlg010.fu.sp:293a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:293a.1.text#καὶ Σμίκυθε καὶ Δράκης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:294.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:294.1.text#ἕπου κατεπείγων,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:294a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:294a.1.text#σαυτῷ προσέχων ὅπως
urn:cts:greekLit:tlg0019.tlg010.fu.sp:295.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:295.1.text#μηδὲν παραχορδιεῖς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:295a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:295a.1.text#ὧν δεῖ σ' ἀποδεῖξαι·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:296.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:296.1.text#ὅπως δὲ τὸ σύμβολον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:296a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:296a.1.text#λαβόντες ἔπειτα πλησίοι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:297.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:297.1.text#καθεδούμεθ', ὡς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:297a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:297a.1.text#ἂν χειροτονῶμεν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:298.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:298.1.text#ἅπανθ' ὁπόσ' ἂν δέῃ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:298a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:298a.1.text#τὰς ἡμετέρας φίλας.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:299.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:299.1.text#καίτοι τί λέγω; φίλους
urn:cts:greekLit:tlg0019.tlg010.fu.sp:299a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:299a.1.text#γὰρ χρῆν μ' ὀνομάζειν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:300.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:300.1.text#ὅρα δ' ὅπως ὠθήσομεν τούσδε τοὺς ἐξ ἄστεως
urn:cts:greekLit:tlg0019.tlg010.fu.sp:300a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:300a.1.text#ἥκοντας, ὅσοι πρὸ τοῦ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:301.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:301.1.text#μέν, ἡνίκ' ἔδει λαβεῖν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:301a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:301a.1.text#ἐλθόντ' ὀβολὸν μόνον,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:302.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:302.1.text#καθῆντο λαλοῦντες
urn:cts:greekLit:tlg0019.tlg010.fu.sp:302a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:302a.1.text#ἐν τοῖς στεφανώμασιν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:303.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:303.1.text#νυνὶ δ' ἐνοχλοῦσ' ἄγαν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:303a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:303a.1.text#ἀλλ' οὐχί, Μυρωνίδης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:304.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:304.1.text#ὅτ' ἦρχεν ὁ γεννάδας,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:304a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:304a.1.text#οὐδεὶς ἂν ἐτόλμα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:305.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:305.1.text#τὰ τῆς πόλεως διοικεῖν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:305a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:305a.1.text#ἀργύριον φέρων·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:306.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:306.1.text#ἀλλ' ἧκεν ἕκαστος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:306a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:306a.1.text#ἐν ἀσκιδίῳ φέρων
urn:cts:greekLit:tlg0019.tlg010.fu.sp:307.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:307.1.text#πιεῖν ἅμα τ' ἄρτον αὑτῷ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:307a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:307a.1.text#καὶ δύο κρομμύω
urn:cts:greekLit:tlg0019.tlg010.fu.sp:308.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:308.1.text#καὶ τρεῖς ἂν ἐλάας.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:308a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:308a.1.text#νυνὶ δὲ τριώβολον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:309.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:309.1.text#ζητοῦσι λαβεῖν, ὅταν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:309a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:309a.1.text#πράττωσί τι κοινὸν ὥσ-
urn:cts:greekLit:tlg0019.tlg010.fu.sp:310.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg010.fu.sp:310.1.text#περ πηλοφοροῦντες.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:311.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:311.1.text#τί τὸ πρᾶγμα; ποῖ ποθ' ἡ γυνὴ φρούδη 'στί μοι;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:312.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:312.1.text#ἐπεὶ πρὸς ἕω νῦν γ' ἔστιν, ἡ δ' οὐ φαίνεται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:313.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:313.1.text#ἐγὼ δὲ κατάκειμαι πάλαι χεζητιῶν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:314.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:314.1.text#τὰς ἐμβάδας ζητῶν λαβεῖν ἐν τῷ σκότῳ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:315.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:315.1.text#καὶ θοἰμάτιον· ὅτε δὴ δ' ἐκεῖνο ψηλαφῶν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:316.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:316.1.text#οὐκ ἐδυνάμην εὑρεῖν, ὁ δ' ἤδη τὴν θύραν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:317.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:317.1.text#ἐπεῖχε κρούων ὁ κοπρεαῖος, λαμβάνω
urn:cts:greekLit:tlg0019.tlg010.fu.sp:318.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:318.1.text#τουτὶ τὸ τῆς γυναικὸς ἡμιδιπλοίδιον,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:319.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:319.1.text#καὶ τὰς ἐκείνης Περσικὰς ὑφέλκομαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:320.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:320.1.text#ἀλλ' ἐν καθαρῷ ποῦ, ποῦ τις ἂν χέσας τύχοι;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:321.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:321.1.text#ἢ πανταχοῦ τοι νυκτός ἐστιν ἐν καλῷ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:322.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:322.1.text#οὐ γάρ με νῦν χέζοντά γ' οὐδεὶς ὄψεται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:323.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:323.1.text#οἴμοι κακοδαίμων, ὅτι γέρων ὢν ἠγόμην
urn:cts:greekLit:tlg0019.tlg010.fu.sp:324.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:324.1.text#γυναῖχ'· ὅσας εἴμ' ἄξιος πληγὰς λαβεῖν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:325.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:325.1.text#οὐ γάρ ποθ' ὑγιὲς οὐδὲν ἐξελήλυθεν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:326.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:326.1.text#δράσουσ'. ὅμως δ' οὖν ἐστιν ἀποπατητέον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:327.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:327.1.text#τίς ἔστιν; οὐ δήπου Βλέπυρος ὁ γειτνιῶν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:328.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:328.1.text#νὴ τὸν Δί' αὐτὸς δῆτ' ἐκεῖνος.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:328.2.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:328.2.text#εἰπέ μοι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:329.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:329.1.text#τί τοῦτό σοι τὸ πυρρόν ἐστιν; οὔτι που
urn:cts:greekLit:tlg0019.tlg010.fu.sp:330.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:330.1.text#Κινησίας σου κατατετίληκέν ποθεν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:331.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:331.1.text#οὔκ, ἀλλὰ τῆς γυναικὸς ἐξελήλυθα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:332.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:332.1.text#τὸ κροκωτίδιον ἀμπισχόμενος οὑνδύεται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:333.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:333.1.text#τὸ δ' ἱμάτιόν σου ποῦ 'στιν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:333.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:333.2.text#οὐκ ἔχω φράσαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:334.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:334.1.text#ζητῶν γὰρ αὔτ' οὐχ ηὗρον ἐν τοῖς στρώμασιν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:335.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:335.1.text#εἶτ' οὐδὲ τὴν γυναῖκ' ἐκέλευσάς σοι φράσαι;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:336.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:336.1.text#μὰ τὸν Δί' οὐ γὰρ ἔνδον οὖσα τυγχάνει,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:337.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:337.1.text#ἀλλ' ἐκτετρύπηκεν λαθοῦσά μ' ἔνδοθεν·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:338.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:338.1.text#ὃ καὶ δέδοικα μή τι δρᾷ νεώτερον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:339.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:339.1.text#νὴ τὸν Ποσειδῶ ταὐτὰ τοίνυν ἄντικρυς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:340.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:340.1.text#ἐμοὶ πέπονθας. καὶ γὰρ ᾗ ξύνειμ' ἐγὼ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:341.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:341.1.text#φρούδη 'στ' ἔχουσα θοἰμάτιον οὑγὼ 'φόρουν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:342.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:342.1.text#κοὐ τοῦτο λυπεῖ μ', ἀλλὰ καὶ τὰς ἐμβάδας.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:343.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:343.1.text#οὔκουν λαβεῖν γ' αὐτὰς ἐδυνάμην οὐδαμοῦ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:344.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:344.1.text#μὰ τὸν Διόνυσον οὐδ' ἐγὼ γὰρ τὰς ἐμὰς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:345.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:345.1.text#Λακωνικάς, ἀλλ' ὡς ἔτυχον χεζητιῶν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:346.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:346.1.text#ἐς τὼ κοθόρνω τὼ πόδ' ἐνθεὶς ἵεμαι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:347.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:347.1.text#ἵνα μὴ 'γχέσαιμ' ἐς τὴν σισύραν· φανὴ γὰρ ἦν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:348.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:348.1.text#τί δῆτ' ἂν εἴη; μῶν ἐπ' ἄριστον γυνὴ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:349.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:349.1.text#κέκληκεν αὐτὴν τῶν φίλων;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:349.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:349.2.text#γνώμην γ' ἐμήν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:350.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:350.1.text#οὔκουν πονηρά γ' ἐστὶν ὅ τι κἄμ' εἰδέναι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:351.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:351.1.text#ἀλλὰ σὺ μὲν ἱμονιάν τιν' ἀποπατεῖς, ἐμοὶ δ'
urn:cts:greekLit:tlg0019.tlg010.fu.sp:352.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:352.1.text#ὥρα βαδίζειν ἐστὶν εἰς ἐκκλησίαν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:353.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:353.1.text#ἤνπερ λάβω θοἰμάτιον, ὅπερ ἦν μοι μόνον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:354.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:354.1.text#κἄγωγ', ἐπειδὰν ἀποπατήσω· νῦν δέ μου
urn:cts:greekLit:tlg0019.tlg010.fu.sp:355.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:355.1.text#ἀχράς τις ἐγκλῄσασ' ἔχει τὰ σιτία.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:356.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:356.1.text#μῶν ἣν Θρασύβουλος εἶπε τοῖς Λακωνικοῖς;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:357.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:357.1.text#νὴ τὸν Διόνυσον ἐνέχεται γοῦν μοι σφόδρα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:358.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:358.1.text#ἀτὰρ τί δράσω; καὶ γὰρ οὐδὲ τοῦτό με
urn:cts:greekLit:tlg0019.tlg010.fu.sp:359.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:359.1.text#μόνον τὸ λυποῦν ἐστιν, ἀλλ' ὅταν φάγω,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:360.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:360.1.text#ὅποι βαδιεῖταί μοι τὸ λοιπὸν ἡ κόπρος.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:361.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:361.1.text#νῦν μὲν γὰρ οὗτος βεβαλάνωκε τὴν θύραν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:362.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:362.1.text#ὅστις ποτ' ἔσθ' ἅνθρωπος ἁχραδούσιος.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:363.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:363.1.text#τίς ἂν οὖν ἰατρόν μοι μετέλθοι καὶ τίνα;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:364.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:364.1.text#τίς τῶν κατὰ πρωκτὸν δεινός ἐστι τὴν τέχνην;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:365.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:365.1.text#ἀλλ' οἶδ', Ἀμύνων. ἀλλ' ἴσως ἀρνήσεται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:366.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:366.1.text#Ἀντισθένη τις καλεσάτω πάσῃ τέχνῃ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:367.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:367.1.text#οὗτος γὰρ ἁνὴρ ἕνεκά γε στεναγμάτων
urn:cts:greekLit:tlg0019.tlg010.fu.sp:368.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:368.1.text#οἶδεν τί πρωκτὸς βούλεται χεζητιῶν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:369.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:369.1.text#ὦ πότνι' Εἰλείθυια μή με περιίδῃς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:370.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:370.1.text#διαρραγέντα μηδὲ βεβαλανωμένον,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:371.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:371.1.text#ἵνα μὴ γένωμαι σκωραμὶς κωμῳδική.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:372.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:372.1.text#οὗτος τί ποιεῖς; οὔτι που χέζεις;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:372.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:372.2.text#ἐγώ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:373.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:373.1.text#οὐ δῆτ' ἔτι γε μὰ τὸν Δί', ἀλλ' ἀνίσταμαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:374.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:374.1.text#τὸ τῆς γυναικὸς δ' ἀμπέχει χιτώνιον;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:375.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:375.1.text#ἐν τῷ σκότῳ γὰρ τοῦτ' ἔτυχον ἔνδον λαβών.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:376.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:376.1.text#ἀτὰρ πόθεν ἥκεις ἐτεόν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:376.2.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:376.2.text#ἐξ ἐκκλησίας.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:377.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:377.1.text#ἤδη λέλυται γάρ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:377.2.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:377.2.text#νὴ Δί' ὄρθριον μὲν οὖν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:378.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:378.1.text#καὶ δῆτα πολὺν ἡ μίλτος ὦ Ζεῦ φίλτατε
urn:cts:greekLit:tlg0019.tlg010.fu.sp:379.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:379.1.text#γέλων παρέσχεν, ἣν προσέρραινον κύκλῳ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:380.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:380.1.text#τὸ τριώβολον δῆτ' ἔλαβες;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:380.2.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:380.2.text#εἰ γὰρ ὤφελον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:381.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:381.1.text#ἀλλ' ὕστερος νῦν ἦλθον, ὥστ' αἰσχύνομαι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:382.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:382.1.text#μὰ τὸν Δί' οὐδέν' ἄλλον ἢ τὸν θύλακον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:383.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:383.1.text#τὸ δ' αἴτιον τί;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:383.2.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:383.2.text#πλεῖστος ἀνθρώπων ὄχλος,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:384.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:384.1.text#ὅσος οὐδεπώποτ' ἦλθ' ἁθρόος ἐς τὴν πύκνα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:385.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:385.1.text#καὶ δῆτα πάντες σκυτοτόμοις ᾐκάζομεν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:386.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:386.1.text#ὁρῶντες αὐτούς. οὐ γὰρ ἀλλ' ὑπερφυῶς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:387.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:387.1.text#ὡς λευκοπληθὴς ἦν ἰδεῖν ἡκκλησία·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:388.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:388.1.text#ὥστ' οὐκ ἔλαβον οὔτ' αὐτὸς οὔτ' ἄλλοι συχνοί.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:389.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:389.1.text#οὐδ' ἄρ' ἂν ἐγὼ λάβοιμι νῦν ἐλθών;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:389.2.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:389.2.text#πόθεν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:390.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:390.1.text#οὐδ' εἰ μὰ Δία τότ' ἦλθες ὅτε τὸ δεύτερον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:391.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:391.1.text#ἁλεκτρυὼν ἐφθέγγετ'.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:391.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:391.2.text#οἴμοι δείλαιος.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:392.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:392.1.text#Ἀντίλοχ' ἀποίμωξόν με τοῦ τριωβόλου
urn:cts:greekLit:tlg0019.tlg010.fu.sp:393.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:393.1.text#τὸν ζῶντα μᾶλλον. τἀμὰ γὰρ διοίχεται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:394.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:394.1.text#ἀτὰρ τί τὸ πρᾶγμ' ἦν, ὅτι τοσοῦτον χρῆμ' ὄχλου
urn:cts:greekLit:tlg0019.tlg010.fu.sp:395.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:395.1.text#οὕτως ἐν ὥρᾳ ξυνελέγη;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:395.2.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:395.2.text#τί δ' ἄλλο γ' ἢ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:396.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:396.1.text#ἔδοξε τοῖς πρυτάνεσι περὶ σωτηρίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:397.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:397.1.text#γνώμας καθεῖναι τῆς πόλεως; κᾆτ' εὐθέως
urn:cts:greekLit:tlg0019.tlg010.fu.sp:398.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:398.1.text#πρῶτος Νεοκλείδης ὁ γλάμων παρείρπυσεν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:399.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:399.1.text#κἄπειθ' ὁ δῆμος ἀναβοᾷ πόσον δοκεῖς,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:400.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:400.1.text#"οὐ δεινὰ τολμᾶν τουτονὶ δημηγορεῖν,"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:401.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:401.1.text#"καὶ ταῦτα περὶ σωτηρίας προκειμένου,"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:402.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:402.1.text#"ὃς αὐτὸς αὑτῷ βλεφαρίδ' οὐκ ἐσώσατο;"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:403.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:403.1.text#ὁ δ' ἀναβοήσας καὶ περιβλέψας ἔφη,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:404.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:404.1.text#"τί δαί με χρῆν δρᾶν;"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:404.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:404.2.text#"σκόροδ' ὁμοῦ τρίψαντ' ὀπῷ"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:405.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:405.1.text#"τιθύμαλλον ἐμβαλόντα τοῦ Λακωνικοῦ"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:406.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:406.1.text#"σαυτοῦ παραλείφειν τὰ βλέφαρα τῆς ἑσπέρας,"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:407.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:407.1.text#ἔγωγ' ἂν εἶπον, εἰ παρὼν ἐτύγχανον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:408.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:408.1.text#μετὰ τοῦτον Εὐαίων ὁ δεξιώτατος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:409.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:409.1.text#παρῆλθε γυμνός, ὡς ἐδόκει τοῖς πλείοσιν·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:410.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:410.1.text#αὐτός γε μέντοὔφασκεν ἱμάτιον ἔχειν·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:411.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:411.1.text#κἄπειτ' ἔλεξε δημοτικωτάτους λόγους·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:412.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:412.1.text#"ὁρᾶτε μέν με δεόμενον σωτηρίας"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:413.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:413.1.text#"τετραστατήρου καὐτόν· ἀλλ' ὅμως ἐρῶ"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:414.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:414.1.text#"ὡς τὴν πόλιν καὶ τοὺς πολίτας σώσετε."
urn:cts:greekLit:tlg0019.tlg010.fu.sp:415.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:415.1.text#"ἢν γὰρ παρέχωσι τοῖς δεομένοις οἱ κναφῆς"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:416.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:416.1.text#"χλαίνας, ἐπειδὰν πρῶτον ἥλιος τραπῇ,"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:417.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:417.1.text#"πλευρῖτις ἡμῶν οὐδέν' ἂν λάβοι ποτέ."
urn:cts:greekLit:tlg0019.tlg010.fu.sp:418.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:418.1.text#"ὅσοις δὲ κλίνη μή 'στι μηδὲ στρώματα,"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:419.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:419.1.text#"ἰέναι καθευδήσοντας ἀπονενιμμένους"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:420.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:420.1.text#"ἐς τῶν σκυλοδεψῶν· ἢν δ' ἀποκλῄῃ θύρᾳ"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:421.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:421.1.text#"χειμῶνος ὄντος, τρεῖς σισύρας ὀφειλέτω."
urn:cts:greekLit:tlg0019.tlg010.fu.sp:422.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:422.1.text#νὴ τὸν Διόνυσον χρηστά γ'· εἰ δ' ἐκεῖνά γε
urn:cts:greekLit:tlg0019.tlg010.fu.sp:423.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:423.1.text#προσέθηκεν, οὐδεὶς ἀντεχειροτόνησεν ἄν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:424.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:424.1.text#τοὺς ἀλφιταμοιβοὺς τοῖς ἀπόροις τρεῖς χοίνικας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:425.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:425.1.text#δεῖπνον παρέχειν ἅπασιν ἢ κλάειν μακρά,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:426.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:426.1.text#ἵνα τοῦτ' ἀπέλαυσαν Ναυσικύδους τἀγαθόν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:427.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:427.1.text#μετὰ τοῦτο τοίνυν εὐπρεπὴς νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:428.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:428.1.text#λευκός τις ἀνεπήδησ' ὅμοιος Νικίᾳ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:429.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:429.1.text#δημηγορήσων, κἀπεχείρησεν λέγειν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:430.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:430.1.text#ὡς χρὴ παραδοῦναι ταῖς γυναιξὶ τὴν πόλιν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:431.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:431.1.text#εἶτ' ἐθορύβησαν κἀνέκραγον ὡς εὖ λέγοι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:432.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:432.1.text#τὸ σκυτοτομικὸν πλῆθος, οἱ δ' ἐκ τῶν ἀγρῶν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:433.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:433.1.text#ἀνεβορβόρυξαν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:433.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:433.2.text#νοῦν γὰρ εἶχον νὴ Δία.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:434.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:434.1.text#ἀλλ' ἦσαν ἥττους· ὁ δὲ κατεῖχε τῇ βοῇ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:435.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:435.1.text#τὰς μὲν γυναῖκας πόλλ' ἀγαθὰ λέγων, σὲ δὲ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:436.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:436.1.text#πολλὰ κακά.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:436.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:436.2.text#καὶ τί εἶπε;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:436.3.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:436.3.text#πρῶτον μέν σ' ἔφη
urn:cts:greekLit:tlg0019.tlg010.fu.sp:437.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:437.1.text#εἶναι πανοῦργον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:437.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:437.2.text#καὶ σέ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:437.3.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:437.3.text#μή πω τοῦτ' ἔρῃ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:438.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:438.1.text#κἄπειτα κλέπτην.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:438.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:438.2.text#ἐμὲ μόνον;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:438.3.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:438.3.text#καὶ νὴ Δία
urn:cts:greekLit:tlg0019.tlg010.fu.sp:439.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:439.1.text#καὶ συκοφάντην.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:439.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:439.2.text#ἐμὲ μόνον;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:439.3.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:439.3.text#καὶ νὴ Δία
urn:cts:greekLit:tlg0019.tlg010.fu.sp:440.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:440.1.text#τωνδὶ τὸ πλῆθος.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:440.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:440.2.text#τίς δὲ τοῦτ' ἄλλως λέγει;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:441.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:441.1.text#γυναῖκα δ' εἶναι πρᾶγμ' ἔφη νουβυστικὸν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:442.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:442.1.text#καὶ χρηματοποιόν· κοὔτε τἀπόρρητ' ἔφη
urn:cts:greekLit:tlg0019.tlg010.fu.sp:443.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:443.1.text#ἐκ Θεσμοφόροιν ἑκάστοτ' αὐτὰς ἐκφέρειν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:444.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:444.1.text#σὲ δὲ κἀμὲ βουλεύοντε τοῦτο δρᾶν ἀεί.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:445.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:445.1.text#καὶ νὴ τὸν Ἑρμῆν τοῦτό γ' οὐκ ἐψεύσατο.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:446.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:446.1.text#ἔπειτα συμβάλλειν πρὸς ἀλλήλας ἔφη
urn:cts:greekLit:tlg0019.tlg010.fu.sp:447.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:447.1.text#ἱμάτια χρυσί' ἀργύριον ἐκπώματα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:448.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:448.1.text#μόνας μόναις, οὐ μαρτύρων ἐναντίον,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:449.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:449.1.text#καὶ ταῦτ' ἀποφέρειν πάντα κοὐκ ἀποστερεῖν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:450.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:450.1.text#ἡμῶν δὲ τοὺς πολλοὺς ἔφασκε τοῦτο δρᾶν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:451.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:451.1.text#νὴ τὸν Ποσειδῶ μαρτύρων γ' ἐναντίον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:452.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:452.1.text#οὐ συκοφαντεῖν, οὐ διώκειν, οὐδὲ τὸν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:453.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:453.1.text#δῆμον καταλύειν, ἀλλὰ πολλὰ κἀγαθά,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:454.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:454.1.text#ἕτερά τε πλεῖστα τὰς γυναῖκας ηὐλόγει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:455.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:455.1.text#τί δῆτ' ἔδοξεν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:455.2.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:455.2.text#ἐπιτρέπειν γε τὴν πόλιν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:456.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:456.1.text#ταύταις. ἐδόκει γὰρ τοῦτο μόνον ἐν τῇ πόλει
urn:cts:greekLit:tlg0019.tlg010.fu.sp:457.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:457.1.text#οὔπω γεγενῆσθαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:457.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:457.2.text#καὶ δέδοκται;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:457.3.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:457.3.text#φήμ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:458.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:458.1.text#ἅπαντά τ' αὐταῖς ἐστι προστεταγμένα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:459.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:459.1.text#ἃ τοῖσιν ἀστοῖς ἔμελεν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:459.2.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:459.2.text#οὕτω ταῦτ' ἔχει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:460.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:460.1.text#οὐδ' ἐς δικαστήριον ἄρ' εἶμ' ἀλλ' ἡ γυνή;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:461.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:461.1.text#οὐδ' ἔτι σὺ θρέψεις οὓς ἔχεις ἀλλ' ἡ γυνή.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:462.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:462.1.text#οὐδὲ στένειν τὸν ὄρθρον ἔτι πρᾶγμ' ἆρά μοι;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:463.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:463.1.text#μὰ Δί' ἀλλὰ ταῖς γυναιξὶ ταῦτ' ἤδη μέλει·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:464.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:464.1.text#σὺ δ' ἀστενακτὶ περδόμενος οἴκοι μενεῖς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:465.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:465.1.text#ἐκεῖνο δεινὸν τοῖσιν ἡλίκοισι νῷν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:466.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:466.1.text#μὴ παραλαβοῦσαι τῆς πόλεως τὰς ἡνίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:467.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:467.1.text#ἔπειτ' ἀναγκάζωσι πρὸς βίαν—
urn:cts:greekLit:tlg0019.tlg010.fu.sp:467.2.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:467.2.text#τί δρᾶν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:468.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:468.1.text#κινεῖν ἑαυτάς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:468.2.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:468.2.text#ἢν δὲ μὴ δυνώμεθα;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:469.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:469.1.text#ἄριστον οὐ δώσουσι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:469.2.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:469.2.text#σὺ δέ γε νὴ Δία
urn:cts:greekLit:tlg0019.tlg010.fu.sp:470.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:470.1.text#δρᾶ ταῦθ', ἵν' ἀριστᾷς τε καὶ κινῇς ἅμα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:471.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:471.1.text#τὸ πρὸς βίαν δεινότατον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:471.2.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:471.2.text#ἀλλ' εἰ τῇ πόλει
urn:cts:greekLit:tlg0019.tlg010.fu.sp:472.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:472.1.text#τοῦτο ξυνοίσει, ταῦτα χρὴ πάντ' ἄνδρα δρᾶν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:473.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:473.1.text#λόγος γέ τοί τις ἔστι τῶν γεραιτέρων,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:474.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:474.1.text#ἀνόηθ' ὅσ' ἂν καὶ μῶρα βουλευσώμεθα,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:475.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:475.1.text#ἅπαντ' ἐπὶ τὸ βέλτιον ἡμῖν ξυμφέρειν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:476.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:476.1.text#καὶ ξυμφέροι γ' ὦ πότνια Παλλὰς καὶ θεοί.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:477.1.speaker#Χρέμης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:477.1.text#ἀλλ' εἶμι· σὺ δ' ὑγίαινε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:477.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:477.2.text#καὶ σύ γ' ὦ Χρέμης.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:478.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:478.1.text#ἔμβα χώρει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:479.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:479.1.text#ἆρ' ἔστι τῶν ἀνδρῶν τις ἡμῖν ὅστις ἐπακολουθεῖ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:480.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:480.1.text#στρέφου σκόπει,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:481.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:481.1.text#φύλαττε σαυτὴν ἀσφαλῶς, πολλοὶ γὰρ οἱ πανοῦργοι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:482.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:482.1.text#μή πού τις ἐκ τοὔπισθεν ὢν τὸ σχῆμα καταφυλάξῃ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:483.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:483.1.text#ἀλλ' ὡς μάλιστα τοῖν ποδοῖν ἐπικτυπῶν βάδιζε·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:484.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:484.1.text#ἡμῖν δ' ἂν αἰσχύνην φέροι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:485.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:485.1.text#πάσαισι παρὰ τοῖς ἀνδράσιν τὸ πρᾶγμα τοῦτ' ἐλεγχθέν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:486.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:486.1.text#πρὸς ταῦτα συστέλλου σεαυτὴν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:487.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:487.1.text#καὶ περισκοπουμένη
urn:cts:greekLit:tlg0019.tlg010.fu.sp:487a.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:487a.1.text# τἀνθένδε καὶ τἀκεῖσε καὶ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:488.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:488.1.text#τἀκ δεξιᾶς, μὴ ξυμφορὰ γενήσεται τὸ πρᾶγμα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:489.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:489.1.text#ἀλλ' ἐγκονῶμεν· τοῦ τόπου γὰρ ἐγγύς ἐσμεν ἤδη,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:490.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:490.1.text#ὅθενπερ εἰς ἐκκλησίαν ὡρμώμεθ' ἡνίκ' ᾖμεν·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:491.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:491.1.text#τὴν δ' οἰκίαν ἔξεσθ' ὁρᾶν, ὅθενπερ ἡ στρατηγὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:492.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:492.1.text#ἔσθ' ἡ τὸ πρᾶγμ' εὑροῦσ' ὃ νῦν ἔδοξε τοῖς πολίταις.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:493.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:493.1.text#ὥστ' εἰκὸς ἡμᾶς μὴ βραδύνειν ἔστ' ἐπαναμενούσας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:494.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:494.1.text#πώγωνας ἐξηρτημένας,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:495.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:495.1.text#μὴ καὶ τις †ὄψεθ' ἡμᾶσ† χἠμῶν ἴσως κατείπῃ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:496.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:496.1.text#ἀλλ' εἶα δεῦρ' ἐπὶ σκιᾶς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:497.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:497.1.text#ἐλθοῦσα πρὸς τὸ τειχίον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:498.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:498.1.text#παραβλέπουσα θατέρῳ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:499.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:499.1.text#πάλιν μετασκεύαζε σαυτὴν αὖθις ἥπερ ἦσθα,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:500.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:500.1.text#καὶ μὴ βράδυν'· ὡς τήνδε καὶ δὴ τὴν στρατηγὸν ἡμῶν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:501.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:501.1.text#χωροῦσαν ἐξ ἐκκλησίας ὁρῶμεν. ἀλλ' ἐπείγου
urn:cts:greekLit:tlg0019.tlg010.fu.sp:502.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:502.1.text#ἅπασα καὶ μίσει σάκον πρὸς τοῖν γνάθοιν ἔχουσα·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:503.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:503.1.text#χαὖται γὰρ ἥκουσιν πάλαι τὸ σχῆμα τοῦτ' ἔχουσαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:504.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:504.1.text#ταυτὶ μὲν ἡμῖν ὦ γυναῖκες εὐτυχῶς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:505.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:505.1.text#τὰ πράγματ' ἐκβέβηκεν ἁβουλεύσαμεν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:506.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:506.1.text#ἀλλ' ὡς τάχιστα πρίν τιν' ἀνθρώπων ἰδεῖν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:507.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:507.1.text#ῥιπτεῖτε χλαίνας, ἐμβὰς ἐκποδὼν ἴτω,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:508.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:508.1.text#χάλα συναπτοὺς ἡνίας Λακωνικάς,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:509.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:509.1.text#βακτηρίας ἄφεσθε. καὶ μέντοι σὺ μὲν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:510.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:510.1.text#ταύτας κατευτρέπιζ', ἐγὼ δὲ βούλομαι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:511.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:511.1.text#εἴσω παρερπύσασα πρὶν τὸν ἄνδρα με
urn:cts:greekLit:tlg0019.tlg010.fu.sp:512.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:512.1.text#ἰδεῖν, καταθέσθαι θοἰμάτιον αὐτοῦ πάλιν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:513.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:513.1.text#ὅθενπερ ἔλαβον τἄλλα θ' ἁξηνεγκάμην.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:514.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:514.1.text#κεῖται καὶ δὴ πάνθ' ἅπερ εἶπας, σὸν δ' ἔργον τἄλλα διδάσκειν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:515.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:515.1.text#ὅ τί σοι δρῶσαι ξύμφορον ἡμεῖς δόξομεν ὀρθῶς ὑπακούειν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:516.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:516.1.text#οὐδεμιᾷ γὰρ δεινοτέρᾳ σου ξυμμείξασ' οἶδα γυναικί.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:517.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:517.1.text#περιμείνατέ νυν, ἵνα τῆς ἀρχῆς ἣν ἄρτι κεχιεροτόνημαι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:518.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:518.1.text#ξυμβούλοισιν πάσαις ὑμῖν χρήσωμαι. καὶ γὰρ ἐκεῖ μοι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:519.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:519.1.text#ἐν τῷ θορύβῳ καὶ τοῖς δεινοῖς ἀνδρειόταται γεγένησθε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:520.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:520.1.text#αὕτη πόθεν ἥκεις Πραξαγόρα;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:520.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:520.2.text#τί δ' ὦ μέλε
urn:cts:greekLit:tlg0019.tlg010.fu.sp:521.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:521.1.text#σοὶ τοῦθ';
urn:cts:greekLit:tlg0019.tlg010.fu.sp:521.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:521.2.text#ὅ τί μοι τοῦτ' ἔστιν; ὡς εὐηθικῶς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:522.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:522.1.text#οὔτοι παρὰ τοῦ μοιχοῦ γε φήσεις.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:522.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:522.2.text#οὐκ ἴσως
urn:cts:greekLit:tlg0019.tlg010.fu.sp:523.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:523.1.text#ἑνός γε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:523.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:523.2.text#καὶ μὴν βασανίσαι τουτί γέ σοι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:524.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:524.1.text#ἔξεστι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:524.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:524.2.text#πῶς;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:524.3.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:524.3.text#εἰ τῆς κεφαλῆς ὄζω μύρου.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:525.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:525.1.text#τί δ'; οὐχὶ βινεῖται γυνὴ κἄνευ μύρου;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:526.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:526.1.text#οὐ δῆτα τάλαν ἔγωγε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:526.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:526.2.text#πῶς οὖν ὄρθριον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:527.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:527.1.text#ᾤχου σιωπῇ θοἰμάτιον λαβοῦσά μου;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:528.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:528.1.text#γυνή μέ τις νύκτωρ ἑταίρα καὶ φίλη
urn:cts:greekLit:tlg0019.tlg010.fu.sp:529.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:529.1.text#μετεπέμψατ' ὠδίνουσα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:529.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:529.2.text#κᾆτ' οὐκ ἦν ἐμοὶ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:530.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:530.1.text#φράσασαν ἰέναι;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:530.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:530.2.text#τῆς λεχοῦς δ' οὐ φροντίσαι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:531.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:531.1.text#οὕτως ἐχούσης ὦνερ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:531.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:531.2.text#εἰποῦσάν γέ μοι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:532.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:532.1.text#ἀλλ' ἔστιν ἐνταῦθά τι κακόν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:532.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:532.2.text#μὰ τὼ θεὼ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:533.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:533.1.text#ἀλλ' ὥσπερ εἶχον ᾠχόμην· ἐδεῖτο δὲ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:534.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:534.1.text#ἥπερ μεθῆκέ μ' ἐξιέναι πάσῃ τέχνῃ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:535.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:535.1.text#εἶτ' οὐ τὸ σαυτῆς ἱμάτιον ἐχρῆν σ' ἔχειν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:536.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:536.1.text#ἀλλ' ἔμ' ἀποδύσασ' ἐπιβαλοῦσα τοὔγκυκλον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:537.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:537.1.text#ᾤχου καταλιποῦσ' ὡσπερεὶ προκείμενον,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:538.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:538.1.text#μόνον οὐ στεφανώσασ' οὐδ' ἐπιθεῖσα λήκυθον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:539.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:539.1.text#ψῦχος γὰρ ἦν, ἐγὼ δὲ λεπτὴ κἀσθενής·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:540.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:540.1.text#ἔπειθ' ἵν' ἀλεαίνοιμι, τοῦτ' ἠμπεσχόμην·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:541.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:541.1.text#σὲ δ' ἐν ἀλέᾳ κατακείμενον καὶ στρώμασιν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:542.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:542.1.text#κατέλιπον ὦνερ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:542.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:542.2.text#αἱ δὲ δὴ Λακωνικαὶ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:543.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:543.1.text#ᾤχοντο μετὰ σοῦ κατὰ τί χἠ βακτηρία;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:544.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:544.1.text#ἵνα θοἰμάτιον σώσαιμι, μεθυπεδησάμην
urn:cts:greekLit:tlg0019.tlg010.fu.sp:545.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:545.1.text#μιμουμένη σε καὶ κτυποῦσα τοῖν ποδοῖν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:546.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:546.1.text#καὶ τοὺς λίθους παίουσα τῇ βακτηρίᾳ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:547.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:547.1.text#οἶσθ' οὖν ἀπολωλεκυῖα πυρῶν ἑκτέα,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:548.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:548.1.text#ὃν χρῆν ἔμ' ἐξ ἐκκλησίας εἰληφέναι;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:549.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:549.1.text#μὴ φροντίσῃς· ἄρρεν γὰρ ἔτεκε παιδίον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:550.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:550.1.text#ἡκκλησία;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:550.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:550.2.text#μὰ Δί' ἀλλ' ἐφ' ἣν ἐγᾠχόμην.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:551.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:551.1.text#ἀτὰρ γεγένηται;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:551.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:551.2.text#ναὶ μὰ Δί'. οὐκ ᾔδησθά με
urn:cts:greekLit:tlg0019.tlg010.fu.sp:552.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:552.1.text#φράσαντά σοι χθές;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:552.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:552.2.text#ἄρτι γ' ἀναμιμνῄσκομαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:553.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:553.1.text#οὐδ' ἄρα τὰ δόξαντ' οἶσθα;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:553.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:553.2.text#μὰ Δί ἐγὼ μὲν οὔ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:554.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:554.1.text#κάθησο τοίνυν σηπίας μασωμένη.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:555.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:555.1.text#ὑμῖν δέ φασι παραδεδόσθαι τὴν πόλιν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:556.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:556.1.text#τί δρᾶν; ὑφαίνειν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:556.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:556.2.text#οὐ μὰ Δί' ἀλλ' ἄρχειν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:556.3.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:556.3.text#τίνων;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:557.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:557.1.text#ἁπαξαπάντων τῶν κατὰ πόλιν πραγμάτων.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:558.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:558.1.text#νὴ τὴν Ἀφροδίτην μακαρία γ' ἄρ ἡ πόλις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:559.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:559.1.text#ἔσται τὸ λοιπόν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:559.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:559.2.text#κατὰ τί;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:559.3.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:559.3.text#πολλῶν οὕνεκα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:560.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:560.1.text#οὐ γὰρ ἔτι τοῖς τολμῶσιν αὐτὴν αἰσχρὰ δρᾶν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:561.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:561.1.text#ἔσται τὸ λοιπόν, οὐδαμοῦ δὲ μαρτυρεῖν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:562.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:562.1.text#οὐ συκοφαντεῖν—
urn:cts:greekLit:tlg0019.tlg010.fu.sp:562.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:562.2.text#μηδαμῶς πρὸς τῶν θεῶν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:563.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:563.1.text#τουτὶ ποιήσῃς μηδ' ἀφέλῃ μου τὸν βίον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:564.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:564.1.text#ὦ δαιμόνι' ἀνδρῶν τὴν γυναῖκ' ἔα λέγειν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:565.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:565.1.text#μὴ λωποδυτῆσαι, μὴ φθονεῖν τοῖς πλησίον,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:566.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:566.1.text#μὴ γυμνὸν εἶναι μὴ πένητα μηδένα,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:567.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:567.1.text#μὴ λοιδορεῖσθαι, μὴ 'νεχυραζόμενον φέρειν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:568.1.speaker#Ἀνήρ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:568.1.text#νὴ τὸν Ποσειδῶ μεγάλα γ', εἰ μὴ ψεύσεται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:569.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:569.1.text#ἀλλ' ἀποφανῶ τοῦθ', ὥστε σέ τέ μοι μαρτυρεῖν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:570.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:570.1.text#καὶ τοῦτον αὐτὸν μηδὲν ἀντειπεῖν ἐμοι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:571.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:571.1.text#νῦν δὴ δεῖ σε πυκνὴν φρένα καὶ φιλόσοφον ἐγείρειν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:571a.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:571a.1.text#φροντίδ' ἐπισταμένην
urn:cts:greekLit:tlg0019.tlg010.fu.sp:572.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:572.1.text#ταῖσι φίλαισιν ἀμύνειν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:573.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:573.1.text#καινὴ γὰρ ἐπ' εὐτυχίαισιν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:574.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:574.1.text#ἔρχεται γλώττης ἐπίνοια πολίτην
urn:cts:greekLit:tlg0019.tlg010.fu.sp:575.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:575.1.text#δῆμον ἐπαγλαϊοῦσα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:576.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:576.1.text#μυρίαισιν ὠφελίαισι βίου· δηλοῦν δ' ὅ τί περ δύνασαι καιρός.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:577.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:577.1.text#δεῖται γάρ τοι σοφοῦ τινος ἐξευρήματος ἡ πόλις ἡμῶν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:578.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:578.1.text#ἀλλὰ πέραινε μόνον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:579.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:579.1.text#μήτε δεδραμένα μήτ' εἰρημένα πω πρότερον·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:580.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:580.1.text#μισοῦσι γὰρ ἢν τὰ παλαιὰ πολλάκις θεῶνται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:581.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:581.1.text#ἀλλ' οὐ μέλλειν, ἀλλ' ἅπτεσθαι καὶ δὴ χρῆν ταῖς διανοίαις,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:582.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:582.1.text#ὡς τὸ ταχύνειν χαρίτων μετέχει πλεῖστον παρὰ τοῖσι θεαταῖς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:583.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:583.1.text#καὶ μὴν ὅτι μὲν χρηστὰ διδάξω πιστεύω· τοὺς δὲ θεατάς,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:584.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:584.1.text#εἰ καινοτομεῖν ἐθελήσουσιν καὶ μὴ τοῖς ἠθάσι λίαν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:585.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:585.1.text#τοῖς τ' ἀρχαίοις ἐνδιατρίβειν, τοῦτ' ἔσθ' ὃ μάλιστα δέδοικα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:586.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:586.1.text#περὶ μὲν τοίνυν τοῦ καινοτομεῖν μὴ δείσῃς· τοῦτο γὰρ ἡμῖν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:587.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:587.1.text#δρᾶν ἀντ' ἄλλης ἀρχῆς ἐστιν, τῶν δ' ἀρχαίων ἀμελῆσαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:588.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:588.1.text#μή νυν πρότερον μηδεὶς ὑμῶν ἀντείπῃ μηδ' ὑποκρούσῃ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:589.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:589.1.text#πρὶν ἐπίστασθαι τὴν ἐπίνοιαν καὶ τοῦ φράζοντος ἀκοῦσαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:590.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:590.1.text#κοινωνεῖν γὰρ πάντας φήσω χρῆναι πάντων μετέχοντας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:591.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:591.1.text#κἀκ ταὐτοῦ ζῆν, καὶ μὴ τὸν μὲν πλουτεῖν, τὸν δ' ἄθλιον εἶναι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:592.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:592.1.text#μηδὲ γεωργεῖν τὸν μὲν πολλήν, τῷ δ' εἶναι μηδὲ ταφῆναι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:593.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:593.1.text#μηδ' ἀνδραπόδοις τὸν μὲν χρῆσθαι πολλοῖς, τὸν δ' οὐδ' ἀκολούθῳ·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:594.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:594.1.text#ἀλλ' ἕνα ποιῶ κοινὸν πᾶσιν βίοτον καὶ τοῦτον ὅμοιον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:595.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:595.1.text#πῶς οὖν ἔσται κοινὸς ἅπασιν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:595.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:595.2.text#κατέδει πέλεθον πρότερός μου.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:596.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:596.1.text#καὶ τῶν πελέθων κοινωνοῦμεν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:596.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:596.2.text#μὰ Δί' ἀλλ' ἔφθης μ' ὑποκρούσας.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:597.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:597.1.text#τοῦτο γὰρ ἤμελλον ἐγὼ λέξειν· τὴν γῆν πρώτιστα ποιήσω
urn:cts:greekLit:tlg0019.tlg010.fu.sp:598.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:598.1.text#κοινὴν πάντων καὶ τἀργύριον καὶ τἄλλ' ὁπόσ' ἐστὶν ἑκάστῳ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:599.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:599.1.text#εἶτ' ἀπὸ τούτων κοινῶν ὄντων ἡμεῖς βοσκήσομεν ὑμᾶς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:600.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:600.1.text#ταμιευόμεναι καὶ φειδόμεναι καὶ τὴν γνώμην προσέχουσαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:601.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:601.1.text#πῶς οὖν ὅστις μὴ κέκτηται γῆν ἡμῶν, ἀργύριον δὲ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:602.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:602.1.text#καὶ Δαρεικοὺς ἀφανῆ πλοῦτον;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:602.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:602.2.text#τοῦτ' ἐς τὸ μέσον καταθήσει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:603.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:603.1.text#καὶ μὴ καταθεὶς ψευδορκήσει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:603.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:603.2.text#κἀκτήσατο γὰρ διὰ τοῦτο.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:604.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:604.1.text#ἀλλ' οὐδέν τοι χρήσιμον ἔσται πάντως αὐτῷ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:604.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:604.2.text#κατὰ δὴ τί;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:605.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:605.1.text#οὐδεὶς οὐδὲν πενίᾳ δράσει· πάντα γὰρ ἕξουσιν ἅπαντες,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:606.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:606.1.text#ἄρτους τεμάχη μάζας χλαίνας οἶνον στεφάνους ἐρεβίνθους.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:607.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:607.1.text#ὥστε τί κέρδος μὴ καταθεῖναι; σὺ γὰρ ἐξευρὼν ἀπόδειξον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:608.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:608.1.text#οὔκουν καὶ νῦν οὗτοι μᾶλλον κλέπτουσ' οἷς ταῦτα πάρεστιν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:609.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:609.1.text#πρότερόν γ' ὦταῖρ' ὅτε τοῖσι νόμοις διεχρώμεθα τοῖς προτέροισιν·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:610.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:610.1.text#νῦν δ' ἔσται γὰρ βίος ἐκ κοινοῦ, τί τὸ κέρδος μὴ καταθεῖναι;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:611.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:611.1.text#ἢν μείρακ' ἰδὼν ἐπιθυμήσῃ καὶ βούληται σκαλαθῦραι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:612.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:612.1.text#ἕξει τούτων ἀφελὼν δοῦναι, τῶν ἐκ κοινοῦ δὲ μεθέξει
urn:cts:greekLit:tlg0019.tlg010.fu.sp:613.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:613.1.text#ξυγκαταδαρθών.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:613.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:613.2.text#ἀλλ' ἐξέσται προῖκ' αὐτῷ ξυγκαταδαρθεῖν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:614.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:614.1.text#καὶ ταύτας γὰρ κοινὰς ποιῶ τοῖς ἀνδράσι συγκατακεῖσθαι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:615.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:615.1.text#καὶ παιδοποιεῖν τῷ βουλομένῳ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:615.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:615.2.text#πῶς οὖν οὐ πάντες ἴασιν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:616.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:616.1.text#ἐπὶ τὴν ὡραιοτάτην αὐτῶν καὶ ζητήσουσιν ἐρείδειν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:617.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:617.1.text#αἱ φαυλότεραι καὶ σιμότεραι παρὰ τὰς σεμνὰς καθεδοῦνται·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:618.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:618.1.text#κᾆτ' ἢν ταύτης ἐπιθυμήσῃ, τὴν αἰσχρὰν πρῶθ' ὑποκρούσει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:619.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:619.1.text#καὶ πῶς ἡμᾶς τοὺς πρεσβύτας, ἢν ταῖς αἰσχραῖσι συνῶμεν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:620.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:620.1.text#οὐκ ἐπιλείψει τὸ πέος πρότερον πρὶν ἐκεῖσ' οἷ φῂς ἀφικέσθαι;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:621.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:621.1.text#οὐχὶ μαχοῦνται· περὶ σοῦ θάρρει· μὴ δείσῃς· οὐχὶ μαχοῦνται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:622.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:622.1.text#περὶ τοῦ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:622.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:622.2.text#τοῦ μὴ ξυγκαταδαρθεῖν. καὶ σοὶ τοιοῦτον ὑπάρχει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:623.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:623.1.text#τὸ μὲν ὑμέτερον γνώμην τιν' ἔχει· προβεβούλευται γάρ, ὅπως ἂν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:624.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:624.1.text#μηδεμιᾶς ᾖ τρύπημα κενόν· τὸ δὲ τῶν ἀνδρῶν τί ποιήσει;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:625.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:625.1.text#φεύξονται γὰρ τοὺς αἰσχίους, ἐπὶ τοὺς δὲ καλοὺς βαδιοῦνται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:626.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:626.1.text#ἀλλὰ φυλάξουσ' οἱ φαυλότεροι τοὺς καλλίους ἀπιόντας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:627.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:627.1.text#ἀπὸ τοῦ δείπνου καὶ τηρήσουσ' ἐπὶ τοῖσιν δημοσίοισιν·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:628.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:628.1.text#κοὐκ ἐξέσται παρὰ τοῖσι καλοῖς καὶ τοῖς μεγάλοις καταδαρθεῖν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:629.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:629.1.text#ταῖσι γυναιξὶ πρὶν ἂν τοῖς αἰσχροῖς καὶ τοῖς μικροῖς χαρίσωνται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:630.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:630.1.text#ἡ Λυσικράτους ἄρα νυνὶ ῥὶς ἴσα τοῖσι καλοῖσι φρονήσει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:631.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:631.1.text#νὴ τὸν Ἀπόλλω καὶ δημοτική γ' ἡ γνώμη καὶ καταχήνη
urn:cts:greekLit:tlg0019.tlg010.fu.sp:632.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:632.1.text#τῶν σεμνοτέρων ἔσται πολλὴ καὶ τῶν σφραγῖδας ἐχόντων,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:633.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:633.1.text#ὅταν ἐμβάδ' ἔχων εἴπῃ πρότερος, "παραχώρει κᾆτ' ἐπιτήρει,"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:634.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:634.1.text#"ὅταν ἤδη 'γὼ διαπραξάμενος παραδῶ σοι δευτεριάζειν."
urn:cts:greekLit:tlg0019.tlg010.fu.sp:635.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:635.1.text#πῶς οὖν οὕτω ζώντων ἡμῶν τοὺς αὑτοῦ παῖδας ἕκαστος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:636.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:636.1.text#ἔσται δυνατὸς διαγιγνώσκειν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:636.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:636.2.text#τί δὲ δεῖ; πατέρας γὰρ ἅπαντας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:637.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:637.1.text#τοὺς πρεσβυτέρους αὑτῶν εἶναι τοῖσι χρόνοισιν νομιοῦσιν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:638.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:638.1.text#οὐκοῦν ἄγξουσ' εὖ καὶ χρηστῶς ἑξῆς τὸν πάντα γέροντα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:639.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:639.1.text#διὰ τὴν ἄγνοιαν, ἐπεὶ καὶ νῦν γιγνώσκοντες πατέρ' ὄντα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:640.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:640.1.text#ἄγχουσι. τί δῆθ' ὅταν ἀγνὼς ᾖ; πῶς οὐ τότε κἀπιχεσοῦνται;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:641.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:641.1.text#ἀλλ' ὁ παρεστὼς οὐκ ἐπιτρέψει· τότε δ' αὐτοῖς οὐκ ἔμελ' οὐδὲν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:642.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:642.1.text#τῶν ἀλλοτρίων ὅστις τύπτοι· νῦν δ' ἢν πληγέντος ἀκούσῃ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:643.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:643.1.text#μὴ αὐτὸν ἐκεῖνον τύπτῃ δεδιὼς τοῖς δρῶσιν τοῦτο μαχεῖται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:644.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:644.1.text#τὰ μὲν ἄλλα λέγεις οὐδὲν σκαιῶς· εἰ δὲ προσελθὼν Ἐπίκουρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:645.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:645.1.text#ἢ Λευκολόφας πάππαν με καλεῖ, τοῦτ' ἤδη δεινὸν ἀκοῦσαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:646.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:646.1.text#πολὺ μέντοι δεινότερον τούτου τοῦ πράγματός ἐστι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:646.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:646.2.text#τὸ ποῖον;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:647.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:647.1.text#εἴ σε φιλήσειεν Ἀρίστυλλος φάσκων αὑτοῦ πατέρ' εἶναι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:648.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:648.1.text#οἰμώζοι γ' ἂν καὶ κωκύοι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:648.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:648.2.text#σὺ δέ γ' ὄζοις ἂν καλαμίνθης,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:649.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:649.1.text#ἀλλ' οὗτος μὲν πρότερον γέγονεν πρὶν τὸ ψήφισμα γενέσθαι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:650.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:650.1.text#ὥστ' οὐχὶ δέος μή σε φιλήσῃ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:650.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:650.2.text#δεινὸν μέντἂν ἐπεπόνθη.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:651.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:651.1.text#τὴν γῆν δὲ τίς ἔσθ' ὁ γεωργήσων;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:651.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:651.2.text#οἱ δοῦλοι. σοὶ δὲ μελήσει,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:652.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:652.1.text#ὅταν ᾖ δεκάπουν τὸ στοιχεῖον, λιπαρὸν χωρεῖν ἐπὶ δεῖπνον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:653.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:653.1.text#περὶ δ' ἱματίων τίς πόρος ἔσται; καὶ γὰρ τοῦτ' ἔστιν ἐρέσθαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:654.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:654.1.text#τὰ μὲν ὄνθ' ὑμῖν πρῶτον ὑπάρξει, τὰ δὲ λοίφ' ἡμεῖς ὑφανοῦμεν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:655.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:655.1.text#ἓν ἔτι ζητῶ· πῶς ἤν τις ὄφλῃ παρὰ τοῖς ἄρχουσι δίκην τῳ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:656.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:656.1.text#πόθεν ἐκτείσει ταύτην; οὐ γὰρ τῶν κοινῶν γ' ἐστὶ δίκαιον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:657.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:657.1.text#ἀλλ' οὐδὲ δίκαι πρῶτον ἔσονται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:657.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:657.2.text#τουτὶ τοὔπος σ' ἐπιτρίψει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:658.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:658.1.text#κἀγὼ ταύτην γνώμην ἐθέμην· τοῦ γὰρ τάλαν οὕνεκ' ἔσονται;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:659.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:659.1.text#πολλῶν οὕνεκα νὴ τὸν Ἀπόλλω· πρῶτον δ' ἑνὸς οὕνεκα δήπου,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:660.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:660.1.text#ἤν τις ὀφείλων ἐξαρνῆται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:660.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:660.2.text#πόθεν οὖν ἐδάνεισ' ὁ δανείσας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:661.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:661.1.text#ἐν τῷ κοινῷ πάντων ὄντων; κλέπτων δήπου' στ' ἐπίδηλος.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:662.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:662.1.text#νὴ τὴν Δήμητρ' εὖ γε διδάσκεις. τουτὶ τοίνυν φρασάτω μοι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:663.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:663.1.text#τῆς αἰκείας οἱ τύπτοντες πόθεν ἐκτείσουσιν, ἐπειδὰν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:664.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:664.1.text#εὐωχηθέντες ὑβρίζωσιν; τοῦτο γὰρ οἶμαί σ' ἀπορήσειν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:665.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:665.1.text#ἀπὸ τῆς μάζης ἧς σιτεῖται· ταύτης γὰρ ὅταν τις ἀφαιρῇ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:666.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:666.1.text#οὐχ ὑβριεῖται φαύλως οὕτως αὖθις τῇ γαστρὶ κολασθείς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:667.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:667.1.text#οὐδ' αὖ κλέπτης οὐδεὶς ἔσται;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:667.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:667.2.text#πῶς γὰρ κλέψει μετὸν αὐτῷ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:668.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:668.1.text#οὐδ' ἀποδύσουσ' ἄρα τῶν νυκτῶν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:668.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:668.2.text#οὐκ ἢν οἴκοι γε καθεύδῃς,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:669.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:669.1.text#οὐδ' ἤν γε θύραζ' ὥσπερ πρότερον· βίοτος γὰρ πᾶσιν ὑπάρξει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:670.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:670.1.text#ἢν δ' ἀποδύῃ γ', αὐτὸς δώσει. τί γὰρ αὐτῷ πρᾶγμα μάχεσθαι;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:671.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:671.1.text#ἔτερον γὰρ ἰὼν ἐκ τοῦ κοινοῦ κρεῖττον ἐκείνου κομιεῖται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:672.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:672.1.text#οὐδὲ κυβεύσουσ' ἆρ' ἄνθρωποι;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:672.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:672.2.text#περὶ τοῦ γὰρ τοῦτο ποιήσει;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:673.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:673.1.text#τὴν δὲ δίαιταν τίνα ποιήσεις;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:673.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:673.2.text#κοινὴν πᾶσιν. τὸ γὰρ ἄστυ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:674.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:674.1.text#μίαν οἴκησίν φημι ποιήσειν συρρήξασ' εἰς ἓν ἅπαντα,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:675.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:675.1.text#ὥστε βαδίζειν ὡς ἀλλήλους.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:675.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:675.2.text#τὸ δὲ δεῖπνον ποῦ παραθήσεις;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:676.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:676.1.text#τὰ δικαστήρια καὶ τὰς στοιὰς ἀνδρῶνας πάντα ποιήσω.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:677.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:677.1.text#τὸ δὲ βῆμα τί σοι χρήσιμον ἔσται;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:677.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:677.2.text#τοὺς κρατῆρας καταθήσω
urn:cts:greekLit:tlg0019.tlg010.fu.sp:679.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:679.1.text#καὶ τὰς ὑδρίας, καὶ ῥαψῳδεῖν ἔσται τοῖς παιδαρίοισιν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:680.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:680.1.text#τοὺς ἀνδρείους ἐν τῷ πολέμῳ, κεἴ τις δειλὸς γεγένηται,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:681.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:681.1.text#ἵνα μὴ δειπνῶσ' αἰσχυνόμενοι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:681.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:681.2.text#νὴ τὸν Ἀπόλλω χάριέν γε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:682.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:682.1.text#τὰ δὲ κληρωτήρια ποῖ τρέψεις;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:682.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:682.2.text#εἰς τὴν ἀγορὰν καταθήσω·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:683.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:683.1.text#κᾆτα στήσασα παρ' Ἁρμοδίῳ κληρώσω πάντας, ἕως ἂν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:684.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:684.1.text#εἰδὼς ὁ λαχὼν ἀπίῃ χαίρων ἐν ὁποίῳ γράμματι δειπνεῖ·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:684a.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:684a.1.text#και κηρύξει τοὺς ἐκ τοῦ βῆτ' ἐπὶ τὴν στοιὰν ἀκολουθεῖν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:685.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:685.1.text#τὴν βασίλειον δειπνήσοντας· τὸ δὲ θῆτ' ἐς τὴν παρὰ b ταύτην,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:685a.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:685a.1.text#τοὺς δ' ἐκ τοῦ κάππ' ἐς τὴν στοιὰν χωρεῖν τὴν ἀλφιτόπωλιν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:686.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:686.1.text#ἵνα κάπτωσιν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:686.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:686.2.text#μὰ Δί' ἀλλ' ἵν' ἐκεῖ δειπνῶσιν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:687.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:687.1.text#ὅτῳ δὲ τὸ γράμμα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:688.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:688.1.text#μὴ 'ξελκυσθῇ καθ' ὃ δειπνήσει, τούτους ἀπελῶσιν ἅπαντες.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:689.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:689.1.text#ἀλλ' οὐκ ἔσται τοῦτο παρ' ἡμῖν·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:690.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:690.1.text#πᾶσι γὰρ ἄφθονα πάντα παρέξομεν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:691.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:691.1.text#ὥστε μεθυσθεὶς αὐτῷ στεφάνῳ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:692.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:692.1.text#πᾶς τις ἄπεισιν τὴν δᾷδα λαβών.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:693.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:693.1.text#αἱ δὲ γυναῖκες κατὰ τὰς διόδους
urn:cts:greekLit:tlg0019.tlg010.fu.sp:694.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:694.1.text#προσπίπτουσαι τοῖς ἀπὸ δείπνου
urn:cts:greekLit:tlg0019.tlg010.fu.sp:695.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:695.1.text#τάδε λέξουσιν· "δεῦρο παρ' ἡμᾶς·"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:696.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:696.1.text#"ἐνθάδε μεῖράξ ἐσθ' ὡραία."
urn:cts:greekLit:tlg0019.tlg010.fu.sp:697.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:697.1.text#"παρ' ἐμοὶ δ' ἑτέρα"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:698.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:698.1.text#φήσει τις ἄνωθ' ἐξ ὑπερῴου,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:699.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:699.1.text#"καὶ καλλίστη καὶ λευκοτάτη·"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:700.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:700.1.text#"πρότερον μέντοι δεῖ σε καθεύδειν"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:700a.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:700a.1.text#"αὐτῆς παρ' ἐμοί."
urn:cts:greekLit:tlg0019.tlg010.fu.sp:701.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:701.1.text#τοῖς εὐπρεπέσιν δ' ἀκολουθοῦντες
urn:cts:greekLit:tlg0019.tlg010.fu.sp:702.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:702.1.text#καὶ μειρακίοις οἱ φαυλότεροι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:703.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:703.1.text#τοιάδ' ἐροῦσιν· "ποῖ θεῖς οὗτος;"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:704.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:704.1.text#"πάντως οὐδὲν δράσεις ἐλθών·"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:705.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:705.1.text#"τοῖς γὰρ σιμοῖς καὶ τοῖς αἰσχροῖς"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:706.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:706.1.text#"ἐψήφισται προτέροις βινεῖν,"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:707.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:707.1.text#"ὑμᾶς δὲ τέως θρῖα λαβόντας"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:708.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:708.1.text#"διφόρου συκῆς"
urn:cts:greekLit:tlg0019.tlg010.fu.sp:709.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:709.1.text#"ἐν τοῖς προθύροισι δέφεσθαι."
urn:cts:greekLit:tlg0019.tlg010.fu.sp:710.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:710.1.text#φέρε νυν φράσον μοι, ταῦτ' ἀρέσκει σφῷν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:710.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:710.2.text#πάνυ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:711.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:711.1.text#βαδιστέον τἄρ' ἐστὶν εἰς ἀγορὰν ἐμοί,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:712.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:712.1.text#ἵν' ἀποδέχωμαι τὰ προσιόντα χρήματα,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:713.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:713.1.text#λαβοῦσα κηρύκαιναν εὔφωνόν τινα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:714.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:714.1.text#ἐμὲ γὰρ ἀνάγκη ταῦτα δρᾶν ᾑρημένην
urn:cts:greekLit:tlg0019.tlg010.fu.sp:715.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:715.1.text#ἄρχειν, καταστῆσαί τε τὰ ξυσσίτια,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:716.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:716.1.text#ὅπως ἂν εὐωχῆσθε πρῶτον τήμερον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:717.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:717.1.text#ἤδη γὰρ εὐωχησόμεσθα;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:717.2.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:717.2.text#φήμ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:718.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:718.1.text#ἔπειτα τὰς πόρνας καταπαῦσαι βούλομαι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:719.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:719.1.text#ἁπαξαπάσας.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:719.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:719.2.text#ἵνα τί;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:719.3.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:719.3.text#δῆλον τουτογί·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:720.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:720.1.text#ἵνα τῶν νέων ἔχωσιν αὗται τὰς ἀκμάς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:721.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:721.1.text#καὶ τάς γε δούλας οὐχὶ δεῖ κοσμουμένας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:722.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:722.1.text#τὴν τῶν ἐλευθέρων ὑφαρπάζειν Κύπριν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:723.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:723.1.text#ἀλλὰ παρὰ τοῖς δούλοισι κοιμᾶσθαι μόνον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:724.1.speaker#Πραξάγορα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:724.1.text#κατωνάκην τὸν χοῖρον ἀποτετιλμένας.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:725.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:725.1.text#φέρε νυν ἐγώ σοι παρακολουθῶ πλησίον,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:726.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:726.1.text#ἵν' ἀποβλέπωμαι καὶ λέγωσί μοι ταδί,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:727.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:727.1.text#τὸν τῆς στρατηγοῦ τοῦτον οὐ θαυμάζετε;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:728.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:728.1.text#ἐγὼ δ' ἵν' εἰς ἀγοράν γε τὰ σκεύη φέρω,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:729.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:729.1.text#προχειριοῦμαι κἀξετάσω τὴν οὐσίαν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:730.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:730.1.text#χώρει σὺ δεῦρο κιναχύρα καλὴ καλῶς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:731.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:731.1.text#τῶν χρημάτων θύραζε πρώτη τῶν ἐμῶν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:732.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:732.1.text#ὅπως ἂν ἐντετριμμένη κανηφορῇς,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:733.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:733.1.text#πολλοὺς κάτω δὴ θυλάκους στρέψασ' ἐμούς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:734.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:734.1.text#ποῦ' σθ' ἡ διφροφόρος; ἡ χύτρα δεῦρ' ἔξιθι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:735.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:735.1.text#νὴ Δία μέλαινά γ', οὐδ' ἂν εἰ τὸ φάρμακον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:736.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:736.1.text#ἕψουσ' ἔτυχες ᾧ Λυσικράτης μελαίνεται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:737.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:737.1.text#ἵστω παρ' αὐτήν, δεῦρ' ἴθ', ἡ κομμώτρια.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:738.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:738.1.text#φέρε δεῦρο ταύτην τὴν ὑδρίαν ὑδριαφόρε
urn:cts:greekLit:tlg0019.tlg010.fu.sp:739.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:739.1.text#ἐνταῦθα. σὺ δὲ δεῦρ' ἡ κιθαρῳδὸς ἔξιθι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:740.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:740.1.text#πολλάκις ἀναστήσασά μ' εἰς ἐκκλησίαν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:741.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:741.1.text#ἀωρὶ νυκτῶν διὰ τὸν ὄρθριον νόμον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:742.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:742.1.text#ὁ τὴν σκάφην λαβὼν προΐτω· τὰ κηρία
urn:cts:greekLit:tlg0019.tlg010.fu.sp:743.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:743.1.text#κόμιζε, τοὺς θαλλοὺς καθίστη πλησίον,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:744.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:744.1.text#καὶ τὼ τρίποδ' ἐξένεγκε καὶ τὴν λήκυθον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:745.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:745.1.text#τὰ χυτρίδι' ἤδη καὶ τὸν ὄχλον ἀφίετε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:746.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:746.1.text#ἐγὼ καταθήσω τἀμά; κακοδαίμων ἄρα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:747.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:747.1.text#ἀνὴρ ἔσομαι καὶ νοῦν ὀλίγον κεκτημένος.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:748.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:748.1.text#μὰ τὸν Ποσειδῶ γ' οὐδέποτ', ἀλλὰ βασανιῶ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:749.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:749.1.text#πρώτιστον αὐτὰ πολλάκις καὶ σκέψομαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:750.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:750.1.text#οὐ γὰρ τὸν ἐμὸν ἱδρῶτα καὶ φειδωλίαν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:751.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:751.1.text#οὐδὲν πρὸς ἔπος οὕτως ἀνοήτως ἐκβαλῶ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:752.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:752.1.text#πρὶν ἂν ἐκπύθωμαι πᾶν τὸ πρᾶγμ' ὅπως ἔχει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:753.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:753.1.text#οὗτος τί τὰ σκευάρια ταυτὶ βούλεται;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:754.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:754.1.text#πότερον μετοικιζόμενος ἐξενήνοχας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:755.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:755.1.text#αὔτ' ἢ φέρεις ἐνέχυρα θήσων;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:755.2.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:755.2.text#οὐδαμῶς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:756.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:756.1.text#τί δῆτ' ἐπὶ στοίχου 'στὶν οὕτως; οὔτι μὴ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:757.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:757.1.text#Ἱέρωνι τῷ κήρυκι πομπὴν πέμπετε;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:758.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:758.1.text#μὰ Δί' ἀλλ' ἀποφέρειν αὐτὰ μέλλω τῇ πόλει
urn:cts:greekLit:tlg0019.tlg010.fu.sp:759.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:759.1.text#ἐς τὴν ἀγορὰν κατὰ τοὺς δεδογμένους νόμους.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:760.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:760.1.text#μέλλεις ἀποφέρειν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:760.2.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:760.2.text#πάνυ γε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:760.3.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:760.3.text#κακοδαίμων ἄρ' εἶ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:761.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:761.1.text#νὴ τὸν Δία τὸν σωτῆρα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:761.2.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:761.2.text#πῶς;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:761.3.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:761.3.text#πῶς; ῥᾳδίως.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:762.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:762.1.text#τί δ'; οὐχὶ πειθαρχεῖν με τοῖς νόμοισι δεῖ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:763.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:763.1.text#ποίοισιν ὦ δύστηνε;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:763.2.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:763.2.text#τοῖς δεδογμένοις.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:764.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:764.1.text#δεδογμένοισιν; ὡς ἀνόητος ἦσθ' ἄρα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:765.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:765.1.text#ἀνόητος;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:765.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:765.2.text#οὐ γάρ; ἠλιθιώτατος μὲν οὖν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:766.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:766.1.text#ἁπαξαπάντων.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:766.2.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:766.2.text#ὅτι τὸ ταττόμενον ποιῶ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:767.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:767.1.text#τὸ ταττόμενον γὰρ δεῖ ποιεῖν τὸν σώφρονα;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:768.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:768.1.text#μάλιστα πάντων.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:768.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:768.2.text#τὸν μὲν οὖν ἀβέλτερον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:769.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:769.1.text#σὺ δ' οὐ καταθεῖναι διανοεῖ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:769.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:769.2.text#φυλάξομαι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:770.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:770.1.text#πρὶν ἄν γ' ἴδω τὸ πλῆθος ὅ τι βουλεύεται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:771.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:771.1.text#τί γὰρ ἄλλο γ' ἢ φέρειν παρεσκευασμένοι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:772.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:772.1.text#τὰ χρήματ' εἰσίν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:772.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:772.2.text#ἀλλ' ἰδὼν ἐπειθόμην.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:773.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:773.1.text#λέγουσι γοῦν ἐν ταῖς ὁδοῖς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:77.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:77.2.text#λέξουσι γάρ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:774.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:774.1.text#καί φασιν οἴσειν ἀράμενοι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:774.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:774.2.text#φήσουσι γάρ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:775.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:775.1.text#ἀπολεῖς ἀπιστῶν πάντ'.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:775.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:775.2.text#ἀπιστήσουσι γάρ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:776.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:776.1.text#ὁ Ζεύς σέ γ' ἐπιτρίψειεν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:776.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:776.2.text#ἐπιτρίψουσι γάρ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:777.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:777.1.text#οἴσειν δοκεῖς τιν' ὅστις αὐτῶν νοῦν ἔχει;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:778.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:778.1.text#οὐ γὰρ πάτριον τοῦτ' ἐστίν, ἀλλὰ λαμβάνειν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:779.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:779.1.text#ἡμᾶς μόνον δεῖ νὴ Δία· καὶ γὰρ οἱ θεοί·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:780.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:780.1.text#γνώσει δ' ἀπὸ τῶν χειρῶν γε τῶν ἀγαλμάτων·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:781.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:781.1.text#ὅταν γὰρ εὐχώμεσθα διδόναι τἀγαθά,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:782.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:782.1.text#ἕστηκεν ἐκτείνοντα τὴν χεῖρ' ὑπτίαν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:783.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:783.1.text#οὐχ ὥς τι δώσοντ' ἀλλ' ὅπως τι λήψεται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:784.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:784.1.text#ὦ δαιμόνι' ἀνδρῶν ἔα με τῶν προὔργου τι δρᾶν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:785.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:785.1.text#ταυτὶ γάρ ἐστι συνδετέα. ποῦ μοὔσθ' ἱμάς;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:786.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:786.1.text#ὄντως γὰρ οἴσεις;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:786.2.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:786.2.text#ναὶ μὰ Δία, καὶ δὴ μὲν οὖν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:787.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:787.1.text#τωδὶ ξυνάπτω τὼ τρίποδε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:787.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:787.2.text#τῆς μωρίας,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:788.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:788.1.text#τὸ μηδὲ περιμείναντα τοὺς ἄλλους ὅ τι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:789.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:789.1.text#δράσουσιν εἶτα τηνικαῦτ' ἤδη—
urn:cts:greekLit:tlg0019.tlg010.fu.sp:789.2.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:789.2.text#τί δρᾶν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:790.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:790.1.text#ἐπαναμένειν, ἔπειτα διατρίβειν ἔτι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:791.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:791.1.text#ἵνα δὴ τί;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:791.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:791.2.text#σεισμὸς εἰ γένοιτο πολλάκις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:792.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:792.1.text#ἢ πῦρ ἀπότροπον, ἢ διᾴξειεν γαλῆ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:793.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:793.1.text#παύσαιντ' ἂν ἐσφέροντες ὦμβρόντητε σύ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:794.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:794.1.text#χαρίεντα γοῦν πάθοιμ' ἄν, εἰ μὴ 'χοιμ' ὅποι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:795.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:795.1.text#ταῦτα καταθείμην.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:795.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:795.2.text#μὴ γὰρ οὐ λάβῃς ὅποι·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:796.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:796.1.text#θάρρει, καταθήσεις, κἂν ἔνης ἔλθῃς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:796.2.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:796.2.text#τιή;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:797.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:797.1.text#ἐγᾦδα τούτους χειροτονοῦντας μὲν ταχύ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:798.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:798.1.text#ἅττ' ἂν δὲ δόξῃ ταῦτα πάλιν ἀρνουμένους.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:799.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:799.1.text#οἴσουσιν ὦ τᾶν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:799.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:799.2.text#ἢν δὲ μὴ κομίσωσι, τί;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:800.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:800.1.text#ἀμέλει κομιοῦσιν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:800.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:800.2.text#ἢν δὲ μὴ κομίσωσι, τί;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:801.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:801.1.text#μαχούμεθ' αὐτοῖς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:801.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:801.2.text#ἢν δὲ κρείττους ὦσι, τί;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:802.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:802.1.text#ἄπειμ' ἐάσας.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:802.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:802.2.text#ἢν δὲ πωλῶσ' αὐτά, τί;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:803.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:803.1.text#διαρραγείης.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:803.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:803.2.text#ἢν διαρραγῶ δέ, τί;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:804.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:804.1.text#καλῶς ποιήσεις.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:804.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:804.2.text#σὺ δ' ἐπιθυμήσεις φέρειν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:805.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:805.1.text#ἔγωγε· καὶ γὰρ τοὺς ἐμαυτοῦ γείτονας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:806.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:806.1.text#ὁρῶ φέροντας.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:806.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:806.2.text#πάνυ γ' ἂν οὖν Ἀντισθένης
urn:cts:greekLit:tlg0019.tlg010.fu.sp:807.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:807.1.text#αὔτ' εἰσενέγκοι· πολὺ γὰρ ἐμμελέστερον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:808.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:808.1.text#πρότερον χέσαι πλεῖν ἢ τριάκονθ' ἡμέρας.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:809.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:809.1.text#οἴμωζε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:809.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:809.2.text#Καλλίμαχος δ' ὁ χοροδιδάσκαλος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:810.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:810.1.text#αὐτοῖσιν εἰσοίσει τι;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:810.2.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:810.2.text#πλείω Καλλίου.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:811.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:811.1.text#ἅνθρωπος οὗτος ἀποβαλεῖ τὴν οὐσίαν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:812.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:812.1.text#δεινά γε λέγεις.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:812.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:812.2.text#τί δεινόν; ὥσπερ οὐχ ὁρῶν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:813.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:813.1.text#ἀεὶ τοιαῦτα γιγνόμενα ψηφίσματα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:814.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:814.1.text#οὐκ οἶσθ' ἐκεῖν' οὕδοξε τὸ περὶ τῶν ἁλῶν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:815.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:815.1.text#ἔγωγε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:815.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:815.2.text#τοὺς χαλκοῦς δ' ἐκείνους ἡνίκα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:816.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:816.1.text#ἐψηφισάμεθ', οὐκ οἶσθα;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:816.2.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:816.2.text#καὶ κακόν γέ μοι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:817.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:817.1.text#τὸ κόμμ' ἐγένετ' ἐκεῖνο. πωλῶν γὰρ βότρυς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:818.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:818.1.text#μεστὴν ἀπῆρα τὴν γνάθον χαλκῶν ἔχων
urn:cts:greekLit:tlg0019.tlg010.fu.sp:819.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:819.1.text#κἄπειτ' ἐχώρουν εἰς ἀγορὰν ἐπ' ἄλφιτα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:820.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:820.1.text#ἔπειθ' ὑπέχοντος ἄρτι μου τὸν θύλακον,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:821.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:821.1.text#ἀνέκραγ' ὁ κῆρυξ μὴ δέχεσθαι μηδένα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:822.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:822.1.text#χαλκοῦν τὸ λοιπόν· "ἀργύρῳ γὰρ χρώμεθα."
urn:cts:greekLit:tlg0019.tlg010.fu.sp:823.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:823.1.text#τὸ δ' ἔναγχος οὐχ ἅπαντες ἡμεῖς ὤμνυμεν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:824.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:824.1.text#τάλαντ' ἔσεσθαι πεντακόσια τῇ πόλει
urn:cts:greekLit:tlg0019.tlg010.fu.sp:825.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:825.1.text#τῆς τετταρακοστῆς, ἣν ἐπόρισ' Εὐριπίδης;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:826.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:826.1.text#κεὐθὺς κατεχρύσου πᾶς ἀνὴρ Εὐριπίδην·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:827.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:827.1.text#ὅτε δὴ δ' ἀνασκοπουμένοις ἐφαίνετο
urn:cts:greekLit:tlg0019.tlg010.fu.sp:828.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:828.1.text#ὁ Διὸς Κόρινθος καὶ τὸ πρᾶγμ' οὐκ ἤρκεσεν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:829.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:829.1.text#πάλιν κατεπίττου πᾶς ἀνὴρ Εὐριπίδην.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:830.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:830.1.text#οὐ ταὐτὸν ὦ τᾶν. τότε μὲν ἡμεῖς ἤρχομεν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:831.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:831.1.text#νῦν δ' αἱ γυναῖκες.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:831.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:831.2.text#ἃς ἐγὼ φυλάξομαι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:832.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:832.1.text#νὴ τὸν Ποσειδῶ μὴ κατουρήσωσί μου.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:833.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:833.1.text#οὐκ οἶδ' ὅ τι ληρεῖς. φέρε σὺ τἀνάφορον ὁ παῖς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:834.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:834.1.text#ὦ πάντες ἀστοί, νῦν γὰρ οὕτω ταῦτ' ἔχει,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:835.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:835.1.text#χωρεῖτ' ἐπείγεσθ' εὐθὺ τῆς στρατηγίδος,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:836.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:836.1.text#ὅπως ἂν ὑμῖν ἡ τύχη κληρουμένοις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:837.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:837.1.text#φράσῃ καθ' ἕκαστον ἄνδρ' ὅποι δειπνήσετε·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:838.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:838.1.text#ὡς αἱ τράπεζαί γ' εἰσὶν ἐπινενησμέναι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:839.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:839.1.text#ἀγαθῶν ἁπάντων καὶ παρεσκευασμέναι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:840.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:840.1.text#κλῖναί τε σισυρῶν καὶ δαπίδων †νενασμέναι†,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:841.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:841.1.text#κρατῆρα συγκιρνᾶσιν, αἱ μυροπώλιδες
urn:cts:greekLit:tlg0019.tlg010.fu.sp:842.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:842.1.text#ἑστᾶσ' ἐφεξῆς, τὰ τεμάχη ῥιπίζεται,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:843.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:843.1.text#λαγῷ' ἀναπηγνύασι, πόπανα πέττεται,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:844.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:844.1.text#στέφανοι πλέκονται, φρύγεται τραγήματα,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:845.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:845.1.text#χύτρας ἔτνους ἕψουσιν αἱ νεώταται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:846.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:846.1.text#Σμοῖος δ' ἐν αὐταῖς ἱππικὴν στολὴν ἔχων
urn:cts:greekLit:tlg0019.tlg010.fu.sp:847.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:847.1.text#τὰ τῶν γυναικῶν διακαθαίρει τρύβλια.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:848.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:848.1.text#Γέρων δὲ χωρεῖ χλανίδα καὶ κονίποδε
urn:cts:greekLit:tlg0019.tlg010.fu.sp:849.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:849.1.text#ἔχων, καχάζων μεθ' ἑτέρου νεανίου·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:850.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:850.1.text#ἐμβὰς δὲ κεῖται καὶ τρίβων ἐρριμμένος.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:851.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:851.1.text#πρὸς ταῦτα χωρεῖθ', ὡς ὁ τὴν μᾶζαν φέρων
urn:cts:greekLit:tlg0019.tlg010.fu.sp:852.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:852.1.text#ἕστηκεν· ἀλλὰ τὰς γνάθους διοίγνυτε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:853.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:853.1.text#οὐκοῦν βαδιοῦμαι δῆτα. τί γὰρ ἕστηκ' ἔχων
urn:cts:greekLit:tlg0019.tlg010.fu.sp:854.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:854.1.text#ἐνταῦθ', ἐπειδὴ ταῦτα τῇ πόλει δοκεῖ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:855.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:855.1.text#καὶ ποῖ βαδιεῖ σὺ μὴ καταθεὶς τὴν οὐσίαν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:856.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:856.1.text#ἐπὶ δεῖπνον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:856.2.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:856.2.text#οὐ δῆτ', ἤν γ' ἐκείναις νοῦς ἐνῇ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:857.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:857.1.text#πρίν γ' ἂν ἀπενέγκῃς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:857.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:857.2.text#ἀλλ' ἀποίσω.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:857.3.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:857.3.text#πηνίκα;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:858.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:858.1.text#οὐ τοὐμὸν ὦ τᾶν ἐμποδὼν ἔσται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:858.2.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:858.2.text#τί δή;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:859.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:859.1.text#ἑτέρους ἀποίσειν φήμ' ἔθ' ὑστέρους ἐμοῦ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:860.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:860.1.text#βαδιεῖ δὲ δειπνήσων ὅμως;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:860.2.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:860.2.text#τί γὰρ πάθω;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:861.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:861.1.text#τὰ δυνατὰ γὰρ δεῖ τῇ πόλει ξυλλαμβάνειν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:862.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:862.1.text#τοὺς εὖ φρονοῦντας.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:862.2.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:862.2.text#ἢν δὲ κωλύσωσι, τί;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:863.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:863.1.text#ὁμόσ' εἶμι κύψας.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:863.2.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:863.2.text#ἢν δὲ μαστιγῶσι, τί;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:864.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:864.1.text#καλούμεθ' αὐτάς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:864.2.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:864.2.text#ἢν δὲ καταγελῶσι, τί;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:865.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:865.1.text#ἐπὶ ταῖς θύραις ἑστώς—
urn:cts:greekLit:tlg0019.tlg010.fu.sp:865.2.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:865.2.text#τί δράσεις; εἰπέ μοι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:866.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:866.1.text#τῶν ἐσφερόντων ἁρπάσομαι τὰ σιτία.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:867.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:867.1.text#βάδιζε τοίνυν ὕστερος· σὺ δ' ὦ Σίκων
urn:cts:greekLit:tlg0019.tlg010.fu.sp:868.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:868.1.text#καὶ Παρμένων αἴρεσθε τὴν παμπησίαν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:869.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:869.1.text#φέρε νυν ἐγώ σοι ξυμφέρω.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:869.2.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:869.2.text#μὴ μηδαμῶς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:870.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:870.1.text#δέδοικα γὰρ μὴ καὶ παρὰ τῇ στρατηγίδι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:871.1.speaker#Ἀνὴρ Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:871.1.text#ὅταν κατατιθῶ, προσποιῇ τῶν χρημάτων.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:872.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:872.1.text#νὴ τὸν Δία δεῖ γοῦν μηχανήματός τινος,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:873.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:873.1.text#ὅπως τὰ μὲν ὄντα χρήμαθ' ἕξω, τοισδεδὶ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:874.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:874.1.text#τῶν ματτομένων κοινῇ μεθέξω πως ἐγώ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:875.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:875.1.text#ὀρθῶς ἔμοιγε φαίνεται· βαδιστέον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:876.1.speaker#Ἀνὴρ Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:876.1.text#ὁμόσ' ἐστὶ δειπνήσοντα κοὐ μελλητέον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:877.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:877.1.text#τί ποθ' ἅνδρες οὐχ ἥκουσιν; ὥρα δ' ἦν πάλαι·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:878.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:878.1.text#ἐγὼ δὲ καταπεπλασμένη ψιμυθίῳ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:879.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:879.1.text#ἕστηκα καὶ κροκωτὸν ἠμφιεσμένη
urn:cts:greekLit:tlg0019.tlg010.fu.sp:880.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:880.1.text#ἀργός, μινυρομένη τι πρὸς ἐμαυτὴν μέλος,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:881.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:881.1.text#παίζουσα. πῶς ἂν περιλάβοιμ' αὐτῶν τινὰ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:882.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:882.1.text#παριόντα; Μοῦσαι δεῦρ' ἴτ' ἐπὶ τοὐμὸν στόμα,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:883.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:883.1.text#μελύδριον εὑροῦσαί τι τῶν Ἰωνικῶν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:884.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:884.1.text#νῦν μέν με παρακύψασα προὔφθης ὦ σαπρά.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:885.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:885.1.text#ᾤου δ' ἐρήμας οὐ παρούσης ἐνθάδε
urn:cts:greekLit:tlg0019.tlg010.fu.sp:886.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:886.1.text#ἐμοῦ τρυγήσειν καὶ προσάξεσθαί τινα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:887.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:887.1.text#ᾄδουσ'· ἐγὼ δ' ἢν τοῦτο δρᾷς ἀντᾴσομαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:888.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:888.1.text#κεἰ γὰρ δι' ὄχλου τοῦτ' ἐστὶ τοῖς θεωμένοις,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:889.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:889.1.text#ὅμως ἔχει τερπνόν τι καὶ κωμῳδικόν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:890.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:890.1.text#τούτῳ διαλέγου κἀποχώρησον· σὺ δὲ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:891.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:891.1.text#φιλοττάριον αὐλητὰ τοὺς αὐλοὺς λαβὼν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:892.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:892.1.text#ἄξιον ἐμοῦ καὶ σοῦ προσαύλησον μέλος.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:893.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:893.1.text#εἴ τις ἀγαθὸν βούλεται παθεῖν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:894.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:894.1.text#τι, παρ' ἐμοὶ χρὴ καθεύδειν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:895.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:895.1.text#οὐ γὰρ ἐν νέαις τὸ σοφὸν ἔνεστιν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:896.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:896.1.text#ἀλλ' ἐν ταῖς πεπείραις·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:897.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:897.1.text#οὐδέ τις στέργειν ἂν ἐθέλοι μᾶλλον ἢ 'γὼ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:898.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:898.1.text#τὸν φίλον ᾧπερ ξυνείην,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:899.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:899.1.text#ἀλλ' ἐφ' ἕτερον ἂν πέτοιτο.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:900.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:900.1.text#μὴ φθόνει ταῖσιν νέαισι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:901.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:901.1.text#τὸ τρυφερὸν γὰρ ἐμπέφυκε
urn:cts:greekLit:tlg0019.tlg010.fu.sp:902.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:902.1.text#τοῖς ἁπαλοῖσι μηροῖς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:903.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:903.1.text#κἀπὶ τοῖς μήλοις ἐπανθεῖ· σὺ δ' ὦ γραῦ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:904.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:904.1.text#παραλέλεξαι κἀντέτριψαι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:905.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:905.1.text#τῷ θανάτῳ μέλημα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:906.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:906.1.text#ἐκπέσοι σου τὸ τρῆμα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:907.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:907.1.text#τό τ' ἐπίκλιντρον ἀποβάλοιο
urn:cts:greekLit:tlg0019.tlg010.fu.sp:908.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:908.1.text#βουλομένη σποδεῖσθαι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:909.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:909.1.text#κἀπὶ τῆς κλίνης ὄφιν εὕροις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:910.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:910.1.text#καὶ προσελκύσαιο […]
urn:cts:greekLit:tlg0019.tlg010.fu.sp:910a.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:910a.1.text#βουλομένη φιλῆσαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:911.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:911.1.text#αἰαῖ τί ποτε πείσομαι;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:912.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:912.1.text#οὐχ ἥκει μοὐταῖρος·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:913.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:913.1.text#μόνη δ' αὐτοῦ λείπομ'· ἡ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:914.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:914.1.text#γὰρ μοι μήτηρ ἄλλῃ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:915.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:915.1.text#βέβηκε· †καὶ τἄλλ' οὐδὲν μετὰ ταῦτα δεῖ λέγειν†.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:915a.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:915a.1.text#ἀλλ' ὦ μαῖ' ἱκετεύομαι, κάλει
urn:cts:greekLit:tlg0019.tlg010.fu.sp:916.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:916.1.text#τὸν Ὀρθαγόραν, ὅπως
urn:cts:greekLit:tlg0019.tlg010.fu.sp:917.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:917.1.text#σαυτῆς κατόναι', ἀντιβολῶ σε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:918.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:918.1.text#ἤδη τὸν ἀπ' Ἰωνίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:919.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:919.1.text#τρόπον τάλαινα κνησιᾷς·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:919a.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:919a.1.text#[…]
urn:cts:greekLit:tlg0019.tlg010.fu.sp:919aa.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:919aa.1.text#[…]
urn:cts:greekLit:tlg0019.tlg010.fu.sp:920b.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:920b.1.text#δοκεῖς δέ μοι καὶ λάβδα κατὰ τοὺς Λεσβίους.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:921.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:921.1.text#ἀλλ' οὐκ ἄν ποθ' ὑφαρπάσαιο
urn:cts:greekLit:tlg0019.tlg010.fu.sp:922.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:922.1.text#τἀμὰ παίγνια· τὴν δ' ἐμὴν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:923.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:923.1.text#ὥραν οὐκ ἀπολεῖς οὐδ' ἀπολήψει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:924.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:924.1.text#ᾆδ' ὁπόσα βούλει καὶ παράκυφθ' ὥσπερ γαλῆ·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:925.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:925.1.text#οὐδεὶς γὰρ ὡς σὲ πρότερον εἴσεισ' ἀντ' ἐμοῦ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:926.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:926.1.text#οὔκουν ἐπ' ἐκφοράν γε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:926.2.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:926.2.text#καινόν γ' ὦ σαπρά.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:927.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:927.1.text#οὐ δῆτα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:927.2.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:927.2.text#τί γὰρ ἂν γραῒ καινά τις λέγοι;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:928.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:928.1.text#οὐ τοὐμὸν ὀδυνήσει σε γῆρας.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:928.2.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:928.2.text#ἀλλὰ τί;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:929.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:929.1.text#ἥγχουσα μᾶλλον καὶ τὸ σὸν ψιμύθιον;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:930.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:930.1.text#τί μοι διαλέγει;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:930.2.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:930.2.text#σὺ δὲ τί διακύπτεις;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:930.3.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:930.3.text#ἐγώ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:931.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:931.1.text#ᾄδω πρὸς ἐμαυτὴν Ἐπιγένει τὠμῷ φίλῳ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:932.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:932.1.text#σοὶ γὰρ φίλος τίς ἐστιν ἄλλος ἢ Γέρης;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:933.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:933.1.text#δείξει γε καὶ σοί. τάχα γὰρ εἶσιν ὡς ἐμέ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:934.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:934.1.text#ὁδὶ γὰρ αὐτός ἐστιν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:934.2.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:934.2.text#οὐ σοῦ γ' ὦλεθρε
urn:cts:greekLit:tlg0019.tlg010.fu.sp:935.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:935.1.text#δεόμενος οὐδέν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:935.2.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:935.2.text#νὴ Δί' ὦ φθίνυλλα σὺ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:936.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:936.1.text#δείξει τάχ' αὐτός, ὡς ἔγωγ' ἀπέρχομαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:937.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:937.1.text#κἄγωγ', ἵνα γνῷς ὡς πολύ σου μεῖζον φρονῶ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:938.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:938.1.text#εἴθ' ἐξῆν παρὰ τῇ νέᾳ καθεύδειν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:939.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:939.1.text#καὶ μὴ δ'ει πρότερον διασποδῆσαι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:940.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:940.1.text#ἀνάσιμον ἢ πρεσβυτέραν·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:941.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:941.1.text#οὐ γὰρ ἀνασχετὸν τοῦτό γ' ἐλευθέρῳ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:942.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:942.1.text#οἰμώζων ἄρα νὴ Δία σποδήσεις.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:943.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:943.1.text#οὐ γὰρ τἀπὶ Χαριξένης τάδ' ἐστίν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:944.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:944.1.text#κατὰ τὸν νόμον ταῦτα ποιεῖν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:945.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:945.1.text#ἔστι δίκαιον, εἰ δημοκρατούμεθα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:946.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:946.1.text#ἀλλ' εἶμι τηρήσουσ' ὅ τι καὶ δράσει ποτέ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:947.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:947.1.text#εἴθ' ὦ θεοὶ λάβοιμι τὴν καλὴν μόνην,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:948.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:948.1.text#ἐφ' ἣν πεπωκὼς ἔρχομαι πάλαι ποθῶν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:949.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:949.1.text#ἐξηπάτησα τὸ κατάρατον γρᾴδιον·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:950.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:950.1.text#φρούδη γάρ ἐστιν οἰομένη μ' ἔνδον μένειν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:951.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:951.1.text#ἀλλ' οὑτοσὶ γὰρ αὐτὸς οὗ 'μεμνήμεθα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:952.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:952.1.text#δεῦρο δὴ δεῦρο δή,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:952a.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:952a.1.text#φίλον ἐμόν, δεῦρό μοι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:953.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:953.1.text#πρόσελθε καὶ ξύνευνος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:953a.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:953a.1.text#τὴν εὐφρόνην ὅπως ἔσει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:954.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:954.1.text#πάνυ γάρ τις ἔρως με δονεῖ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:955.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:955.1.text#τῶνδε τῶν σῶν βοστρύχων.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:956.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:956.1.text#ἄτοπος δ' ἔγκειταί μοί τις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:957.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:957.1.text#πόθος, ὅς με διακναίσας ἔχει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:958.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:958.1.text#μέθες, ἱκνοῦμαί σ' Ἔρως,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:959.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:959.1.text#καὶ ποίησον τόνδ' ἐς εὐνὴν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:959a.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:959a.1.text#τὴν ἐμὴν ἱκέσθαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:960.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:960.1.text#δεῦρο δὴ δεῦρο δή,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:961.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:961.1.text#καὶ σύ μοι καταδραμοῦσα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:961a.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:961a.1.text#τὴν θύραν ἄνοιξον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:962.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:962.1.text#τήνδ'· εἰ δὲ μή, καταπεσὼν κείσομαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:963.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:963.1.text#φίλον, ἀλλ' ἐν τῷ σῷ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:964.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:964.1.text#βούλομαι κόλπῳ πληκτίζεσθαι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:965.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:965.1.text#μετὰ τῆς σῆς πυγῆς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:966.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:966.1.text#Κύπρι τί μ' ἐκμαίνεις ἐπὶ ταύτῃ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:967.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:967.1.text#μέθες, ἱκνοῦμαί σ' Ἔρως,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:968.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:968.1.text#καὶ ποίησον τήνδ' ἐς εὐνὴν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:968a.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:968a.1.text#τὴν ἐμὴν ἱκέσθαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:969.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:969.1.text#καὶ ταῦτα μέντοι μετρίως πρὸς τὴν ἐμὴν ἀνάγκην
urn:cts:greekLit:tlg0019.tlg010.fu.sp:970.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:970.1.text#εἰρημέν' ἐστίν. σὺ δέ μοι, φίλτατον, ὢ ἱκετεύω,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:971.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:971.1.text#ἄνοιξον ἀσπάζου με·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:971a.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:971a.1.text#διά τοι σὲ πόνους ἔχω.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:972.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:972.1.text#ὦ χρυσοδαίδαλτον ἐμὸν μέλημα, Κύπριδος ἔρνος,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:973.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:973.1.text#μέλιττα Μούσης, Χαρίτων θρέμμα, Τρυφῆς πρόσωπον,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:974.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:974.1.text#ἄνοιξον ἀσπάζου με·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:975.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:975.1.text#διά τοι σὲ πόνους ἔχω.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:976.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:976.1.text#οὗτος τί κόπτεις; μῶν ἐμὲ ζητεῖς;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:976.2.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:976.2.text#πόθεν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:977.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:977.1.text#καὶ τὴν θύραν γ' ἤραττες.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:977.2.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:977.2.text#ἀποθάνοιμ' ἄρα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:978.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:978.1.text#τοῦ δαὶ δεόμενος δᾷδ' ἔχων ἐλήλυθας;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:979.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:979.1.text#Ἀναφλύστιον ζητῶν τιν' ἄνθρωπον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:979.2.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:979.2.text#τίνα;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:980.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:980.1.text#οὐ τὸν Σεβῖνον, ὃν σὺ προσδοκᾷς ἴσως.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:981.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:981.1.text#νὴ τὴν Ἀφροδίτην, ἤν τε βούλῃ γ' ἤν τε μή.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:982.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:982.1.text#ἀλλ' οὐχὶ νυνὶ τὰς ὑπερεξηκοντέτεις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:983.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:983.1.text#εἰσάγομεν, ἀλλ' εἰσαῦθις ἀναβεβλήμεθα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:984.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:984.1.text#τὰς ἐντὸς εἴκοσιν γὰρ ἐκδικάζομεν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:985.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:985.1.text#ἐπὶ τῆς προτέρας ἀρχῆς γε ταῦτ' ἦν ὦ γλύκων·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:986.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:986.1.text#νυνὶ δὲ πρῶτον εἰσάγειν ἡμᾶς δοκεῖ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:987.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:987.1.text#τῷ βουλομένῳ γε κατὰ τὸν ἐν πεττοῖς νόμον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:988.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:988.1.text#ἀλλ' οὐδὲ δειπνεῖς κατὰ τὸν ἐν πεττοῖς νόμον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:989.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:989.1.text#οὐκ οἶδ' ὅ τι λέγεις· τηνδεδί μοι κρουστέον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:990.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:990.1.text#ὅταν γε κρούσῃς τὴν ἐμὴν πρῶτον θύραν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:991.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:991.1.text#ἀλλ' οὐχὶ νυνὶ κρησέραν αἰτούμεθα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:992.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:992.1.text#οἶδ' ὅτι φιλοῦμαι· νῦν δὲ θαυμάζεις ὅτι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:993.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:993.1.text#θύρασί μ' ηὗρες· ἀλλὰ πρόσαγε τὸ στόμα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:994.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:994.1.text#ἀλλ' ὦ μέλ' ὀρρωδῶ τὸν ἐραστήν σου.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:994.2.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:994.2.text#τίνα;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:995.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:995.1.text#τὸν τῶν γραφέων ἄριστον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:995.2.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:995.2.text#οὗτος δ' ἔστι τίς;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:996.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:996.1.text#ὃς τοῖς νεκροῖσι ζωγραφεῖ τὰς ληκύθους.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:997.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:997.1.text#ἀλλ' ἄπιθ', ὅπως μή σ' ἐπὶ θύραισιν ὄψεται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:998.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:998.1.text#οἶδ' οἶδ' ὅ τι βούλει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:998.2.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:998.2.text#καὶ γὰρ ἐγώ σε νὴ Δία.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:999.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:999.1.text#μὰ τὴν Ἀφροδίτην ἥ μ' ἔλαχε κληρουμένη,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1000.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1000.1.text#μὴ 'γώ σ' ἀφήσω.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1000.2.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1000.2.text#παραφρονεῖς ὦ γρᾴδιον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1001.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1001.1.text#ληρεῖς· ἐγὼ δ' ἄξω σ' ἐπὶ τἀμὰ στρώματα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1002.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1002.1.text#τί δῆτα κρεάγρας τοῖς κάδοις ὠνούμεθα,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1003.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1003.1.text#ἐξὸν καθέντα γρᾴδιον τοιουτονὶ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1004.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1004.1.text#ἐκ τῶν φρεάτων τοὺς κάδους ξυλλαμβάνειν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1005.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1005.1.text#μὴ σκῶπτέ μ' ὦ τάλαν ἀλλ' ἕπου δεῦρ' ὡς ἐμέ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1006.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1006.1.text#ἀλλ' οὐκ ἀνάγκη μοὐστίν, εἰ μὴ τῶν ἐμῶν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1007.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1007.1.text#τὴν πεντακοσιοστὴν κατέθηκας τῇ πόλει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1008.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1008.1.text#νὴ τὴν Ἀφροδίτην δεῖ γε μέντοι σ'. ὡς ἐγὼ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1009.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1009.1.text#τοῖς τηλικούτοις ξυγκαθεύδουσ' ἥδομαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1010.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1010.1.text#ἐγὼ δὲ ταῖς γε τηλικαύταις ἄχθομαι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1011.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1011.1.text#κοὐκ ἂν πιθοίμην οὐδέποτ'.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1011.2.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1011.2.text#ἀλλὰ νὴ Δία
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1012.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1012.1.text#ἀναγκάσει τουτί σε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1012.2.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1012.2.text#τοῦτο δ' ἔστι τί;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1013.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1013.1.text#ψήφισμα, καθ' ὅ σε δεῖ βαδίζειν ὡς ἐμέ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1014.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1014.1.text#λέγ' αὐτὸ τί ποτε κἄστι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1014.2.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1014.2.text#καὶ δή σοι λέγω.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1015.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1015.1.text#ἔδοξε ταῖς γυναιξίν, ἢν ἀνὴρ νέος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1016.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1016.1.text#νέας ἐπιθυμῇ, μὴ σποδεῖν αὐτὴν πρὶν ἂν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1017.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1017.1.text#τὴν γραῦν προκρούσῃ πρῶτον· ἢν δὲ μὴ 'θέλῃ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1018.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1018.1.text#πρότερον προκρούειν ἀλλ' ἐπιθυμῇ τῆς νέας,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1019.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1019.1.text#ταῖς πρεσβυτέραις γυναιξὶν ἔστω τὸν νέον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1020.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1020.1.text#ἕλκειν ἀνατεὶ λαβομένας τοῦ παττάλου.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1021.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1021.1.text#οἴμοι Προκρούστης τήμερον γενήσομαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1022.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1022.1.text#τοῖς γὰρ νόμοις τοῖς ἡμετέροισι πειστέον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1023.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1023.1.text#τί δ' ἢν ἀφαιρῆταί μ' ἀνὴρ τῶν δημοτῶν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1024.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1024.1.text#ἢ τῶν φίλων ἐλθών τις;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1024.2.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1024.2.text#ἀλλ' οὐ κύριος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1025.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1025.1.text#ὑπὲρ μέδιμνόν ἐστ' ἀνὴρ οὐδεὶς ἔτι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1026.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1026.1.text#ἐξωμοσία δ' οὐκ ἔστιν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1026.2.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1026.2.text#οὐ γὰρ δεῖ στροφῆς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1027.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1027.1.text#ἀλλ' ἔμπορος εἶναι σκήψομαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1027.2.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1027.2.text#κλάων γε σύ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1028.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1028.1.text#τί δῆτα χρὴ δρᾶν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1028.2.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1028.2.text#δεῦρ' ἀκολουθεῖν ὡς ἐμέ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1029.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1029.1.text#καὶ ταῦτ' ἀνάγκη μοὐστί;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1029.2.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1029.2.text#Διομήδειά γε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1030.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1030.1.text#ὑποστόρεσαί νυν πρῶτα τῆς ὀριγάνου
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1031.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1031.1.text#καὶ κλήμαθ' ὑπόθου συγκλάσασα τέτταρα,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1032.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1032.1.text#καὶ ταινίωσαι καὶ παράθου τὰς ληκύθους,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1033.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1033.1.text#ὕδατός τε κατάθου τοὔστρακον πρὸ τῆς θύρας.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1034.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1034.1.text#ἦ μὴν ἔτ' ὠνήσει σὺ καὶ στεφάνην ἐμοί.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1035.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1035.1.text#νὴ τὸν Δί' ἤνπερ ᾖ γέ που τῶν κηρίνων·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1036.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1036.1.text#οἶμαι γὰρ ἔνδον διαπεσεῖσθαί σ' αὐτίκα.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1037.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1037.1.text#ποῖ τοῦτον ἕλκεις;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1037.2.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1037.2.text#τὸν ἐμὸν αὐτῆς εἰσάγω.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1038.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1038.1.text#οὐ σωφρονοῦσά γ'· οὐ γὰρ ἡλικίαν ἔχει
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1039.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1039.1.text#παρὰ σοὶ καθεύδειν τηλικοῦτος ὤν, ἐπεὶ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1040.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1040.1.text#μήτηρ ἂν αὐτῷ μᾶλλον εἴης ἢ γυνή.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1041.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1041.1.text#ὥστ' εἰ καταστήσεσθε τοῦτον τὸν νόμον,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1042.1.speaker#Νεᾶνις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1042.1.text#τὴν γῆν ἅπασαν Οἰδιπόδων ἐμπλήσετε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1043.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1043.1.text#ὦ παμβδελυρὰ φθονοῦσα τόνδε τὸν λόγον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1044.1.speaker#Γραῦς Α
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1044.1.text#ἐξηῦρες· ἀλλ' ἐγώ σε τιμωρήσομαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1045.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1045.1.text#νὴ τὸν Δία τὸν σωτῆρα κεχάρισαί γέ μοι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1046.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1046.1.text#ὦ γλυκύτατον τὴν γραῦν ἀπαλλάξασά μου·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1047.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1047.1.text#ὥστ' ἀντὶ τούτων τῶν ἀγαθῶν εἰς ἑσπέραν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1048.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1048.1.text#μεγάλην ἀποδώσω καὶ παχεῖάν σοι χάριν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1049.1.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1049.1.text#αὕτη σὺ ποῖ τονδὶ παραβᾶσα τὸν νόμον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1050.1.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1050.1.text#ἕλκεις, παρ' ἐμοὶ τῶν γραμμάτων εἰρηκότων
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1051.1.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1051.1.text#πρότερον καθεύδειν αὐτόν;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1051.2.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1051.2.text#οἴμοι δείλαιος.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1052.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1052.1.text#πόθεν ἐξέκυψας ὦ κάκιστ' ἀπολουμένη;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1053.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1053.1.text#τοῦτο γὰρ ἐκείνου τὸ κακὸν ἐξωλέστερον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1054.1.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1054.1.text#βάδιζε δεῦρο.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1054.2.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1054.2.text#μηδαμῶς με περιίδῃς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1055.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1055.1.text#ἑλκόμενον ὑπὸ τῆσδ' ἀντιβολῶ σ'.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1055.2.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1055.2.text#ἀλλ' οὐκ ἐγώ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1056.1.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1056.1.text#ἀλλ' ὁ νόμος ἕλκει σ'.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1056.2.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1056.2.text#οὐκ ἐμέ γ', ἀλλ' ἔμπουσά τις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1057.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1057.1.text#ἐξ αἵματος φλύκταιναν ἠμφιεσμένη.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1058.1.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1058.1.text#ἕπου μαλακίων δεῦρ' ἀνύσας καὶ μὴ λάλει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1059.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1059.1.text#ἴθι νυν ἔασον εἰς ἄφοδον πρώτιστά με
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1060.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1060.1.text#ἐλθόντα θαρρῆσαι πρὸς ἐμαυτόν· εἰ δὲ μή,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1061.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1061.1.text#αὐτοῦ τι δρῶντα πυρρὸν ὄψει μ' αὐτίκα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1062.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1062.1.text#ὑπὸ τοῦ δέους.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1062.2.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1062.2.text#θάρρει, βάδιζ'· ἔνδον χεσεῖ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1063.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1063.1.text#δέδοικα κἀγὼ μὴ πλέον γ' ἢ βούλομαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1064.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1064.1.text#ἀλλ' ἐγγυητάς σοι καταστήσω δύο
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1065.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1065.1.text#ἀξιόχρεως.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1065.2.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1065.2.text#μή μοι καθίστη.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1065.3.speaker#Γραῦς Γ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1065.3.text#ποῖ σὺ ποῖ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1066.1.speaker#Γραῦς Γ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1066.1.text#χωρεῖς μετὰ ταύτης;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1066.2.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1066.2.text#οὐκ ἔγωγ', ἀλλ' ἕλκομαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1067.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1067.1.text#ἀτὰρ ἥτις εἶ γε, πόλλ' ἀγαθὰ γένοιτό σοι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1068.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1068.1.text#ὅτι μ' οὐπεριεῖδες ἐπιτριβέντ'. ὦ Ἡράκλεις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1069.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1069.1.text#ὦ Πᾶνες ὦ Κορύβαντες ὦ Διοσκόρω,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1070.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1070.1.text#τοῦτ' αὖ πολὺ τούτου τὸ κακὸν ἐξωλέστερον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1071.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1071.1.text#ἀτὰρ τί τὸ πρᾶγμ' ἔστ' ἀντιβολῶ τουτί ποτε;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1072.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1072.1.text#πότερον πίθηκος ἀνάπλεως ψιμυθίου,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1073.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1073.1.text#ἢ γραῦς ἀνεστηκυῖα παρὰ τῶν πλειόνων;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1074.1.speaker#Γραῦς Γ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1074.1.text#μὴ σκῶπτέ μ' ἀλλὰ δεῦρ' ἕπου.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1074.2.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1074.2.text#δευρὶ μὲν οὖν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1075.1.speaker#Γραῦς Γ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1075.1.text#ὡς οὐκ ἀφήσω σ' οὐδέποτ'.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1075.2.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1075.2.text#οὐδὲ μὴν ἐγώ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1076.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1076.1.text#διασπάσεσθέ μ' ὦ κακῶς ἀπολούμεναι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1077.1.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1077.1.text#ἐμοὶ γὰρ ἀκολουθεῖν σ' ἔδει κατὰ τὸν νόμον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1078.1.speaker#Γραῦς Γ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1078.1.text#οὐκ ἢν ἑτέρα γε γραῦς ἔτ' αἰσχίων φανῇ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1079.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1079.1.text#ἢν οὖν ὑφ' ὑμῶν πρῶτον ἀπόλωμαι κακῶς,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1080.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1080.1.text#φέρε πῶς ἐπ' ἐκείνην τὴν καλὴν ἀφίξομαι;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1081.1.speaker#Γραῦς Γ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1081.1.text#αὐτὸς σκόπει σύ· τάδε δέ σοι ποιητέον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1082.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1082.1.text#ποτέρας προτέρας οὖν κατελάσας ἀπαλλαγῶ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1083.1.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1083.1.text#οὐκ οἶσθα; βαδιεῖ δεῦρ'.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1083.2.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1083.2.text#ἀφέτω νύν μ' αὑτηί.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1084.1.speaker#Γραῦς Γ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1084.1.text#δευρὶ μὲν οὖν ἴθ' ὡς ἔμ'.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1084.2.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1084.2.text#ἢν ἡδί μ' ἀφῇ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1085.1.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1085.1.text#ἀλλ' οὐκ ἀφήσω μὰ Δία σ'.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1085.2.speaker#Γραῦς Γ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1085.2.text#οὐδὲ μὴν ἐγώ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1086.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1086.1.text#χαλεπαί γ' ἂν ἦστε γενόμεναι πορθμῆς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1086.2.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1086.2.text#τιή;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1087.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1087.1.text#ἕλκοντε τοὺς πλωτῆρας ἂν ἀπεκναίετε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1088.1.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1088.1.text#σιγῇ βάδιζε δεῦρο.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1088.2.speaker#Γραῦς Γ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1088.2.text#μὰ Δί' ἀλλ' ὡς ἐμέ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1089.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1089.1.text#τουτὶ τὸ πρᾶγμα κατὰ τὸ Καννωνοῦ σαφῶς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1090.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1090.1.text#ψήφισμα, βινεῖν δεῖ με διαλελημμένον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1091.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1091.1.text#πῶς οὖν δικωπεῖν ἀμφοτέρας δυνήσομαι;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1092.1.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1092.1.text#καλῶς, ἐπειδὰν καταφάγῃς βολβῶν χύτραν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1093.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1093.1.text#οἴμοι κακοδαίμων ἐγγὺς ἤδη τῆς θύρας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1094.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1094.1.text#ἑλκόμενός εἰμ'.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1094.2.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1094.2.text#ἀλλ' οὐδὲν ἔσται σοι πλέον.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1095.1.speaker#Γραῦς Β
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1095.1.text#ξυνεσπεσοῦμαι γὰρ μετὰ σοῦ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1095.2.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1095.2.text#μὴ πρὸς θεῶν·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1096.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1096.1.text#ἑνὶ γὰρ ξυνέχεσθαι κρεῖττον ἢ δυοῖν κακοῖν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1097.1.speaker#Γραῦς Γ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1097.1.text#νὴ τὴν Ἑκάτην ἐάν τε βούλῃ γ' ἤν τέ μή.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1098.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1098.1.text#ὦ τρισκακοδαίμων εἰ γυναῖκα δεῖ σαπρὰν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1099.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1099.1.text#βινεῖν ὅλην τὴν νύκτα καὶ τὴν ἡμέραν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1100.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1100.1.text#κἄπειτ' ἐπειδὰν τῆσδ' ἀπαλλαγῶ, πάλιν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1101.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1101.1.text#φρύνην ἔχουσαν λήκυθον πρὸς ταῖς γνάθοις.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1102.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1102.1.text#ἆρ' οὐ κακοδαίμων εἰμί; βαρυδαίμων μὲν οὖν
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1103.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1103.1.text#νὴ τὸν Δία τὸν σωτῆρ' ἀνὴρ καὶ δυστυχής,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1104.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1104.1.text#ὅστις τοιούτοις θηρίοις συνείρξομαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1105.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1105.1.text#ὅμως δ' ἐάν τι πολλὰ πολλάκις πάθω
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1106.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1106.1.text#ὑπὸ τοῖνδε τοῖν κασαλβάδοιν δεῦρ' ἐσπλέων,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1107.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1107.1.text#θάψαι μ' ἐπ' αὐτῷ τῷ στόματι τῆς ἐσβολῆς,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1108.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1108.1.text#καὶ τήνδ' ἄνωθεν ἐπιπολῆς τοῦ σήματος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1109.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1109.1.text#ζῶσαν καταπιττώσαντες εἶτα τὼ πόδε
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1110.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1110.1.text#μολυβδοχοήσαντες κύκλῳ περὶ τὰ σφυρὰ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1111.1.speaker#Νεανίας
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1111.1.text#ἄνω 'πιθεῖναι πρόφασιν ἀντὶ ληκύθου.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1112.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1112.1.text#ὦ μακάριος μὲν δῆμος, εὐδαίμων δ' ἐγώ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1113.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1113.1.text#αὐτή τέ μοι δέσποινα μακαριωτάτη,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1114.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1114.1.text#ὑμεῖς θ' ὅσαι παρέστατ' ἐπὶ ταῖσιν θύραις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1115.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1115.1.text#οἱ γείτονές τε πάντες οἵ τε δημόται,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1116.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1116.1.text#ἐγώ τε πρὸς τούτοισιν ἡ διάκονος,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1117.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1117.1.text#ἥτις μεμύρισμαι τὴν κεφαλὴν μυρώμασιν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1118.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1118.1.text#ἀγαθοῖσιν ὦ Ζεῦ· πολὺ δ' ὑπερπέπαικεν αὖ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1119.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1119.1.text#τούτων ἁπάντων τὰ Θάσι' ἀμφορείδια.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1120.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1120.1.text#ἐν τῇ κεφαλῇ γὰρ ἐμμένει πολὺν χρόνον·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1121.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1121.1.text#τὰ δ' ἄλλ' ἀπανθήσαντα πάντ' ἀπέπτετο·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1122.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1122.1.text#ὥστ' ἐστὶ πολὺ βέλτιστα, πολὺ δῆτ' ὦ θεοί.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1123.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1123.1.text#κέρασον ἄκρατον, εὐφρανεῖ τὴν νύχθ' ὅλην
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1124.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1124.1.text#ἐκλεγομένας ὅ τι ἂν μάλιστ' ὀσμὴν ἔχῃ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1125.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1125.1.text#ἀλλ' ὦ γυναῖκες φράσατέ μοι τὸν δεσπότην,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1126.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1126.1.text#τὸν ἄνδρ', ὅπου 'στί, τῆς ἐμῆς κεκτημένης.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1127.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1127.1.text#αὐτοῦ μένουσ' ἡμῖν γ' ἂν ἐξευρεῖν δοκεῖς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1128.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1128.1.text#μάλισθ'· ὁδὶ γὰρ ἐπὶ τὸ δεῖπνον ἔρχεται.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1129.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1129.1.text#ὦ δέσποτ' ὦ μακάριε καὶ τρισόλβιε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1130.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1130.1.text#ἐγώ;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1130.2.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1130.2.text#σὺ μέντοι νὴ Δί' ὥς γ' οὐδεὶς ἀνήρ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1131.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1131.1.text#τίς γὰρ γένοιτ' ἂν μᾶλλον ὀλβιώτερος,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1132.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1132.1.text#ὅστις πολιτῶν πλεῖον ἢ τρισμυρίων
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1133.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1133.1.text#ὄντων τὸ πλῆθος οὐ δεδείπνηκας μόνος;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1134.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1134.1.text#εὐδαιμονικόν γ' ἄνθρωπον εἴρηκας σαφῶς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1135.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1135.1.text#ποῖ ποῖ βαδίζεις;
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1135.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1135.2.text#ἐπὶ τὸ δεῖπνον ἔρχομαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1136.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1136.1.text#νὴ τὴν Ἀφροδίτην πολύ γ' ἁπάντων ὕστατος.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1137.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1137.1.text#ὅμως δ' ἐκέλευε συλλαβοῦσάν μ' ἡ γυνὴ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1138.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1138.1.text#ἄγειν σε καὶ τασδὶ μετὰ σοῦ τὰς μείρακας.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1139.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1139.1.text#οἶνος δὲ Χῖός ἐστι περιλελειμμένος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1140.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1140.1.text#καὶ τἄλλ' ἀγαθά. πρὸς ταῦτα μὴ βραδύνετε,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1141.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1141.1.text#καὶ τῶν θεατῶν εἴ τις εὔνους τυγχάνει,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1142.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1142.1.text#καὶ τῶν κριτῶν εἰ μή τις ἑτέρωσε βλέπει,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1143.1.speaker#Θεραπαίνα
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1143.1.text#ἴτω μεθ' ἡμῶν· πάντα γὰρ παρέξομεν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1144.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1144.1.text#οὔκουν ἅπασι δῆτα γενναίως ἐρεῖς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1145.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1145.1.text#καὶ μὴ παραλείψεις μηδέν', ἀλλ' ἐλευθέρως
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1146.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1146.1.text#καλεῖς γέροντα μειράκιον παιδίσκον; ὡς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1147.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1147.1.text#τὸ δεῖπνον αὐτοῖς ἐστ' ἐπεσκευασμένον
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1148.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1148.1.text#ἁπαξάπασιν, ἢν ἀπίωσιν οἴκαδε.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1149.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1149.1.text#ἐγὼ δὲ πρὸς τὸ δεῖπνον ἤδη 'πείξομαι·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1150.1.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1150.1.text#ἔχω δέ τοι καὶ δᾷδα ταυτηνὶ καλῶς.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1151.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1151.1.text#τί δῆτα διατρίβεις ἔχων, ἀλλ' οὐκ ἄγεις
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1152.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1152.1.text#τασδὶ λαβών; ἐν ὅσῳ δὲ καταβαίνεις, ἐγὼ
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1153.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1153.1.text#ἐπᾴσομαι μέλος τι μελλοδειπνικόν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1154.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1154.1.text#σμικρὸν δ' ὑποθέσθαι τοῖς κριταῖσι βούλομαι.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1155.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1155.1.text#τοῖς σοφοῖς μὲν τῶν σοφῶν μεμνημένοις κρίνειν ἐμέ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1156.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1156.1.text#τοῖς γελῶσι δ' ἡδέως διὰ τὸν γέλων κρίνειν ἐμέ·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1157.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1157.1.text#σχεδὸν ἅπαντας οὖν κελεύω δηλαδὴ κρίνειν ἐμέ,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1158.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1158.1.text#μηδὲ τὸν κλῆρον γενέσθαι μηδὲν ἡμῖν αἴτιον,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1159.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1159.1.text#ὅτι προείληχ'· ἀλλὰ πάντα ταῦτα χρὴ μεμνημένους
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1160.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1160.1.text#μὴ 'πιορκεῖν ἀλλὰ κρίνειν τοὺς χοροὺς ὀρθῶς ἀεί,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1161.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1161.1.text#μηδὲ ταῖς κακαῖς ἑταίραις τὸν τρόπον προσεικέναι,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1162.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1162.1.text#αἳ μόνον μνήμην ἔχουσι τῶν τελευταίων ἀεί.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1163.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1163.1.text#ὦ ὦ ὥρα δή,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1164.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1164.1.text# ὦ φίλαι γυναῖκες, εἴπερ μέλλομεν τὸ χρῆμα δρᾶν,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1165.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1165.1.text#ἐπὶ τὸ δεῖπνον ὑπαποκινεῖν. κρητικῶς οὖν τὼ πόδε
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1166.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1166.1.text#καὶ σὺ κίνει.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1166.2.speaker#Βλέπυρος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1166.2.text#τοῦτο δρῶ.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1166.3.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1166.3.text#καὶ τάσδε νῦν […]
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1167.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1167.1.text# […]λαγαρὰς τοῖν σκελίσκοιν τὸν ῥυθμόν.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1168.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1168.1.text#τάχα γὰρ ἔπεισι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1169.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1169.1.text#λοπαδοτεμαχοσελαχογαλεο-
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1170.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1170.1.text#κρανιολειψανοδριμυποτριμματο-
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1171.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1171.1.text#σιλφιοτυρομελιτοκατακεχυμενο-
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1172.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1172.1.text#κιχλεπικοσσυφοφαττοπεριστερα-
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1173.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1173.1.text#λεκτρυονοπτεκεφαλλιοκιγκλοπε-
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1174.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1174.1.text#λειολαγῳοσιραιοβαφητραγα-
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1175.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1175.1.text#νοπτερυγών· σὺ δὲ ταῦτ' ἀκροασάμενος
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1176.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1176.1.text#ταχὺ καὶ ταχέως λαβὲ τρύβλιον·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1177.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1177.1.text#εἶτα λαβὼν κόνισαι
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1178.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1178.1.text#λέκιθον, ἵν' ἐπιδειπνῇς·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1179.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1179.1.text#ἀλλὰ λαιμάττουσί που.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1180.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1180.1.text#αἴρεσθ' ἄνω, ἰαὶ εὐαί.
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1181.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1181.1.text#δειπνήσομεν, εὐοῖ εὐαί,
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1182.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1182.1.text#εὐαί, ὡς ἐπὶ νίκῃ·
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1183.1.speaker#Χορὸς
urn:cts:greekLit:tlg0019.tlg010.fu.sp:1183.1.text#εὐαί, εὐαί, εὐαί, εὐαί.
