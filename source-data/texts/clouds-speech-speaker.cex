urn:cts:greekLit:tlg0019.tlg003.fu.sp:7.1.text#ὅτ' οὐδὲ κολάσ' ἔξεστί μοι τοὺς οἰκέτας. 
urn:cts:greekLit:tlg0019.tlg003.fu.sp:8.1.speaker#Στρεψιάδης
urn:cts:greekLit:tlg0019.tlg003.fu.sp:8.1.text#ἀλλ' οὐδ' ὁ χρηστὸς οὑτοσὶ νεανίας 
