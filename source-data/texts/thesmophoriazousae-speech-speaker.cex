#!ctsdata
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1.1.text#ὦ Ζεῦ χελιδὼν ἆρά ποτε φανήσεται;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:2.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:2.1.text#ἀπολεῖ μ' ἀλοῶν ἅνθρωπος ἐξ ἑωθινοῦ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:3.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:3.1.text#οἷόν τε, πρὶν τὸν σπλῆνα κομιδῇ μ' ἐκβαλεῖν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:4.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:4.1.text#παρὰ σοῦ πυφέσθαι ποῖ μ' ἄγεις ωὖριπίδη;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:5.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:5.1.text#ἀλλ' οὐκ ἀκούειν δεῖ σε πάνθ' ὅσ' αὐτίκα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:6.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:6.1.text#ὄψει παρεστώς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:6.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:6.2.text#πῶς λέγεις; αὖθις φράσον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:7.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:7.1.text#οὐ δεῖ μ' ἀκούειν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:7.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:7.2.text#οὐχ ἅ γ' ἂν μέλλῃς ὁρᾶν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:8.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:8.1.text#οὐδ' ἆρ' ὁρᾶν δεῖ μ';
urn:cts:greekLit:tlg0019.tlg008.fu.sp:8.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:8.2.text#οὐχ ἅ γ' ἂν ἀκούειν δέῃ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:9.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:9.1.text#πῶς μοι παραινεῖς; δεξιῶς μέντοι λέγεις.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:10.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:10.1.text#οὐ φῂς σὺ χρῆναί μ' οὔτ' ἀκούειν οὔθ' ὁρᾶν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:11.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:11.1.text#χωρὶς γὰρ αὐτοῖν ἑκατέρου 'στὶν ἡ φύσις.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:12.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:12.1.text#τοῦ μήτ' ἀκούειν μήθ' ὁρᾶν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:12.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:12.2.text#εὖ ἴσθ' ὅτι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:13.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:13.1.text#πῶς χωρίς;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:13.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:13.2.text#οὕτω ταῦτα διεκρίθη τότε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:14.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:14.1.text#αἰθὴρ γὰρ ὅτε τὰ πρῶτα διεχωρίζετο
urn:cts:greekLit:tlg0019.tlg008.fu.sp:15.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:15.1.text#καὶ ζᾦ' ἐν αὑτῷ ξυνετέκνου κινούμενα,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:16.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:16.1.text#ᾧ μὲν βλέπειν χρὴ πρῶτ' ἐμηχανήσατο
urn:cts:greekLit:tlg0019.tlg008.fu.sp:17.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:17.1.text#ὀφθαλμὸν ἀντίμιμον ἡλίου τροχῷ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:18.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:18.1.text#ἀκοῇ δὲ χοάνην ὦτα διετετρήνατο.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:19.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:19.1.text#διὰ τὴν χοάνην οὖν μήτ' ἀκούω μήθ' ὁρῶ;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:20.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:20.1.text#νὴ τὸν Δί' ἥδομαί γε τουτὶ προσμαθών.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:21.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:21.1.text#οἷόν γέ που 'στιν αἱ σοφαὶ ξυνουσίαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:22.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:22.1.text#πόλλ' ἂν μάθοις τοιαῦτα παρ' ἐμοῦ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:22.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:22.2.text#πῶς ἂν οὖν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:23.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:23.1.text#πρὸς τοῖς ἀγαθοῖς τούτοισιν ἐξεύροιμ' ὅπως
urn:cts:greekLit:tlg0019.tlg008.fu.sp:24.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:24.1.text#ἔτι προσμάθοιμι χωλὸς εἶναι τὼ σκέλει;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:25.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:25.1.text#βάδιζε δευρὶ καὶ πρόσεχε τὸν νοῦν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:25.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:25.2.text#ἰδού.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:26.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:26.1.text#ὁρᾷς τὸ θύριον τοῦτο;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:26.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:26.2.text#νὴ τὸν Ἡρακλέα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:27.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:27.1.text#οἶμαί γε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:27.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:27.2.text#σίγα νυν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:27.3.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:27.3.text#σιωπῶ τὸ θύριον;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:28.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:28.1.text#ἄκου'.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:28.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:28.2.text#ἀκούω καὶ σιωπῶ τὸ θύριον;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:29.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:29.1.text#ἐνταῦθ' Ἀγάθων ὁ κλεινὸς οἰκῶν τυγχάνει
urn:cts:greekLit:tlg0019.tlg008.fu.sp:30.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:30.1.text#ὁ τραγῳδοποιός.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:30.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:30.2.text#ποῖος οὗτος Ἁγάθων;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:31.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:31.1.text#ἔστιν τις Ἀγάθων—
urn:cts:greekLit:tlg0019.tlg008.fu.sp:31.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:31.2.text#μῶν ὁ μέλας ὁ καρτερός;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:32.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:32.1.text#οὔκ, ἀλλ' ἕτερός τις· οὐχ ἑόρακας πώποτε;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:33.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:33.1.text#μῶν ὁ δασυπώγων;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:33.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:33.2.text#οὐχ ἑόρακας πώποτε;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:34.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:34.1.text#μὰ τὸν Δί' οὔτοι γ' ὥστε καί μέ γ' εἰδέναι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:35.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:35.1.text#καὶ μὴν βεβίνηκας σύ γ', ἀλλ' οὐκ οἶσθ' ἴσως.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:36.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:36.1.text#ἀλλ' ἐκποδὼν πτήξωμεν, ὡς ἐξέρχεται
urn:cts:greekLit:tlg0019.tlg008.fu.sp:37.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:37.1.text#θεράπων τις αὐτοῦ πῦρ ἔχων καὶ μυρρίνας·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:38.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:38.1.text#προθυσόμενος ἔοικε τῆς ποιήσεως.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:39.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:39.1.text#εὔφημος πᾶς ἔστω λαός,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:40.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:40.1.text#στόμα συγκλῄσας· ἐπιδημεῖ γὰρ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:41.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:41.1.text#θίασος Μουσῶν ἔνδον μελάθρων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:42.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:42.1.text#τῶν δεσποσύνων μελοποιῶν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:43.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:43.1.text#ἐχέτω δὲ πνοὰς νήνεμος αἰθήρ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:44.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:44.1.text#κῦμα δὲ πόντου μὴ κελαδείτω
urn:cts:greekLit:tlg0019.tlg008.fu.sp:45.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:45.1.text#γλαυκόν·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:45.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:45.2.text#βομβάξ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:45.3.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:45.3.text#σίγα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:45.4.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:45.4.text#τι λέγει;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:46.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:46.1.text#πτηνῶν τε γένη κατακοιμάσθω,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:47.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:47.1.text#θηρῶν τ' ἀγρίων πόδες ὑλοδρόμων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:48.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:48.1.text#μὴ λυέσθων.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:48.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:48.2.text#βομβαλοβομβάξ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:49.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:49.1.text#μέλλει γὰρ ὁ καλλιεπὴς Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:50.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:50.1.text#πρόμος ἡμέτερος—
urn:cts:greekLit:tlg0019.tlg008.fu.sp:50.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:50.2.text#μῶν βινεῖσθαι;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:51.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:51.1.text#τίς ὁ φωνήσας;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:51.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:51.2.text#νήνεμος αἰθήρ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:52.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:52.1.text#δρυόχους τιθέναι δράματος ἀρχάς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:53.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:53.1.text#κάμπτει δὲ νέας ἁψῖδας ἐπῶν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:54.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:54.1.text#τὰ δὲ τορνεύει, τὰ δὲ κολλομελεῖ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:55.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:55.1.text#καὶ γνωμοτυπεῖ κἀντονομάζει
urn:cts:greekLit:tlg0019.tlg008.fu.sp:56.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:56.1.text#καὶ κηροχυτεῖ καὶ γογγύλλει
urn:cts:greekLit:tlg0019.tlg008.fu.sp:57.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:57.1.text#καὶ χοανεύει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:57.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:57.2.text#καὶ λαικάζει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:58.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:58.1.text#τίς ἀγροιώτας πελάθει θριγκοῖς;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:59.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:59.1.text#ὃς ἕτοιμος σοῦ τοῦ τε ποιητοῦ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:60.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:60.1.text#τοῦ καλλιεποῦς κατὰ τοῦ θριγκοῦ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:61.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:61.1.text#συγγογγύλας καὶ συστρέψας
urn:cts:greekLit:tlg0019.tlg008.fu.sp:62.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:62.1.text#τουτὶ τὸ πέος χοανεῦσαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:63.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:63.1.text#ἦ που νέος γ' ὢν ἦσθ' ὑβριστὴς ὦ γέρον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:64.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:64.1.text#ὦ δαιμόνιε τοῦτον μὲν ἔα χαίρειν, σὺ δὲ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:65.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:65.1.text#Ἀγάθωνά μοι δεῦρ' ἐκκάλεσον πάσῃ τέχνῃ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:66.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:66.1.text#μηδὲν ἱκέτευ'· αὐτὸς γὰρ ἔξεισιν τάχα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:67.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:67.1.text#καὶ γὰρ μελοποιεῖν ἄρχεται· χειμῶνος οὖν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:68.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:68.1.text#ὄντος κατακάμπτειν τὰς στροφὰς οὐ ῥᾴδιον,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:69.1.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:69.1.text#ἢν μὴ προίῃ θύρασι πρὸς τὸν ἥλιον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:70.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:70.1.text#τί οὖν ἐγὼ δρῶ;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:70.2.speaker#Θεράπων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:70.2.text#περίμεν', ὡς ἐξερχεται.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:71.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:71.1.text#ὦ Ζεῦ τί δρᾶσαι διανοεῖ με τήμερον;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:72.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:72.1.text#νὴ τοὺς θεοὺς ἐγὼ πυθέσθαι βούλομαι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:73.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:73.1.text#τί τὸ πρᾶγμα τουτί. τί στένεις; τί δυσφορεῖς;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:74.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:74.1.text#οὐ χρῆν σε κρύπτειν ὄντα κηδεστὴν ἐμόν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:75.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:75.1.text#ἔστιν κακόν μοι μέγα τι προπεφυραμένον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:76.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:76.1.text#ποῖόν τι;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:76.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:76.2.text#τῇδε θἠμέρᾳ κριθήσεται
urn:cts:greekLit:tlg0019.tlg008.fu.sp:77.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:77.1.text#εἴτ' ἔστ' ἔτι ζῶν εἴτ' ἀπόλωλ' Εὐριπίδης.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:78.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:78.1.text#καὶ πῶς; ἐπεὶ νῦν γ' οὔτε τὰ δικαστήρια
urn:cts:greekLit:tlg0019.tlg008.fu.sp:79.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:79.1.text#μέλλει δικάζειν οὔτε βουλῆς ἐσθ' ἕδρα,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:80.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:80.1.text#ἐπεὶ τρίτη 'στὶ Θεσμοφορίων ἡ μέση.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:81.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:81.1.text#τοῦτ' αὐτὸ γὰρ τοι κἀπολεῖν με προσδοκῶ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:82.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:82.1.text#αἱ γὰρ γυναῖκες ἐπιβεβουλεύκασί μοι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:83.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:83.1.text#κἀν Θεσμοφόροιν μέλλουσι περί μου τήμερον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:84.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:84.1.text#ἐκκλησιάζειν ἐπ' ὀλέθρῳ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:84.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:84.2.text#τιὴ τί δή;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:85.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:85.1.text#ὁτιὴ τραγῳδῶ καὶ κακῶς αὐτὰς λέγω.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:86.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:86.1.text#νὴ τὸν Ποσειδῶ καὶ δίκαιά γ' ἂν πάθοις.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:87.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:87.1.text#ἀτὰρ τίν' ἐκ τούτων σὺ μηχανὴν ἔχεις;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:88.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:88.1.text#Ἀγάθωνα πεῖσαι τὸν τραγῳδοδιδάσκαλον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:89.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:89.1.text#ἐς Θεσμοφόροιν ἐλθεῖν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:89.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:89.2.text#τί δράσοντ'; εἰπέ μοι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:90.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:90.1.text#ἐκκλησιάσοντ' ἐν ταῖς γυναιξὶ κἂν δέῃ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:91.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:91.1.text#λέξονθ' ὑπὲρ ἐμοῦ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:91.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:91.2.text#πότερα φανερῶς ἢ λάθρᾳ;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:92.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:92.1.text#λάθρᾳ, στολὴν γυναικὸς ἠμφιεσμένον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:93.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:93.1.text#τὸ πρᾶγμα κομψὸν καὶ σφόδρ' ἐκ τοῦ σοῦ τρόπου·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:94.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:94.1.text#τοῦ γὰρ τεχνάζειν ἡμέτερος ὁ πυραμοῦς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:95.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:95.1.text#σίγα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:95.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:95.2.text#τί δ' ἔστιν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:95.3.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:95.3.text#Ἁγάθων ἐξέρχεται.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:96.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:96.1.text#καὶ ποῖός ἐστιν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:96.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:96.2.text#οὗτος οὑκκυκλούμενος.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:97.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:97.1.text#ἀλλ' ἢ τυφλὸς μέν εἰμ'· ἐγὼ γὰρ οὐχ ὁρῶ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:98.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:98.1.text#ἄνδρ' οὐδέν' ἐνθάδ' ὄντα, Κυρήνην δ' ὁρῶ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:99.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:99.1.text#σίγα· μελῳδεῖν γὰρ παρασκευάζεται.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:100.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:100.1.text#μύρμηκος ἀτραπούς, ἢ τί διαμινύρεται;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:101.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:101.1.text#ἱερὰν χθονίαις δεξάμεναι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:102.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:102.1.text#λαμπάδα κοῦραι ξὺν ἐλευθέρᾳ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:103.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:103.1.text#πατρίδι χορεύσασθε βοάν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:104.1.speaker#Χορὸς Ἀγάθωνος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:104.1.text#τίνι δαιμόνων ὁ κῶμος;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:105.1.speaker#Χορὸς Ἀγάθωνος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:105.1.text#λέγε νυν. εὐπίστως δὲ τοὐμὸν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:106.1.speaker#Χορὸς Ἀγάθωνος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:106.1.text#δαίμονας ἔχει σεβίσαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:107.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:107.1.text#ἄγε νυν ὄλβιζε Μοῦσα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:108.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:108.1.text#χρυσέων ῥύτορα τόξων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:109.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:109.1.text#Φοῖβον, ὃς ἱδρύσατο χώρας
urn:cts:greekLit:tlg0019.tlg008.fu.sp:110.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:110.1.text#γύαλα Σιμουντίδι γᾷ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:111.1.speaker#Χορὸς Ἀγάθωνος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:111.1.text#χαῖρε καλλίστας ἀοιδᾶς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:112.1.speaker#Χορὸς Ἀγάθωνος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:112.1.text#Φοῖβ' ἐν εὐμούσοισι τιμαῖς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:113.1.speaker#Χορὸς Ἀγάθωνος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:113.1.text#γέρας ἱερὸν προφέρων.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:114.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:114.1.text#τάν τ' ἐν ὄρεσι δρυογόνοισι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:115.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:115.1.text#κόραν ἀείσατ'
urn:cts:greekLit:tlg0019.tlg008.fu.sp:116.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:116.1.text#Ἄρτεμιν ἀγροτέραν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:117.1.speaker#Χορὸς Ἀγάθωνος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:117.1.text#ἕπομαι κλῄζουσα σεμνὸν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:118.1.speaker#Χορὸς Ἀγάθωνος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:118.1.text#γόνον ὀλβίζουσα Λατοῦς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:119.1.speaker#Χορὸς Ἀγάθωνος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:119.1.text#Ἄρτεμιν ἀπειρολεχῆ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:120.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:120.1.text#Λατώ τε κρούματά τ' Ἀσιάδος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:121.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:121.1.text#ποδὶ †παράρυθμ' εὔρυθμα Φρυγίων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:122.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:122.1.text#διανεύματα Χαρίτων†.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:123.1.speaker#Χορὸς Ἀγάθωνος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:123.1.text#σέβομαι Λατώ τ' ἄνασσαν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:124.1.speaker#Χορὸς Ἀγάθωνος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:124.1.text#κίθαρίν τε ματέρ' ὕμνων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:125.1.speaker#Χορὸς Ἀγάθωνος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:125.1.text#ἄρσενι βοᾷ δόκιμον,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:126.1.speaker#Χορὸς Ἀγάθωνος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:126.1.text#τᾷ φάος ἔσσυτο δαιμονίοις θεοῦ ὄμμασιν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:127.1.speaker#Χορὸς Ἀγάθωνος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:127.1.text#ἁμετέρας τε δι' αἰφνιδίου ὀπός. ὧν χάριν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:128.1.speaker#Χορὸς Ἀγάθωνος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:128.1.text#ἄνακτ' ἄγαλλε Φοῖβον τιμᾷ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:129.1.speaker#Χορὸς Ἀγάθωνος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:129.1.text#χαῖρ' ὄλβιε παῖ Λατοῦς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:130.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:130.1.text#ὡς ἡδὺ τὸ μέλος ὦ πότνιαι Γενετυλλίδες
urn:cts:greekLit:tlg0019.tlg008.fu.sp:131.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:131.1.text#καὶ θηλυδριῶδες καὶ κατεγλωττισμένον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:132.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:132.1.text#καὶ μανδαλωτόν, ὥστ' ἐμοῦ γ' ἀκροωμένου
urn:cts:greekLit:tlg0019.tlg008.fu.sp:133.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:133.1.text#ὑπὸ τὴν ἕδραν αὐτὴν ὑπῆλθε γάργαλος.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:134.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:134.1.text#καί σ' ὦ νεανίσχ' ὅστις εἶ, κατ' Αἰσχύλον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:135.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:135.1.text#ἐκ τῆς Λυκουργείας ἐρέσθαι βούλομαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:136.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:136.1.text#ποδαπὸς ὁ γύννις; τίς πάτρα; τίς ἡ στολή;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:137.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:137.1.text#τίς ἡ τάραξις τοῦ βίου; τί βάρβιτος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:138.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:138.1.text#λαλεῖ κροκωτῷ; τί δὲ λύρα κεκρυφάλῳ;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:139.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:139.1.text#τί λήκυθος καὶ στρόφιον; ὡς οὐ ξύμφορον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:140.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:140.1.text#τίς δαὶ κατόπτρου καὶ ξίφους κοινωνία;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:141.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:141.1.text#τίς δ' αὐτὸς ὦ παῖ; πότερον ὡς ἀνὴρ τρέφει;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:142.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:142.1.text#καὶ ποῦ πέος; ποῦ χλαῖνα; ποῦ Λακωνικαί;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:143.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:143.1.text#ἀλλ' ὡς γυνὴ δῆτ'· εἶτα ποῦ τὰ τιτθία;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:144.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:144.1.text#τί φῄς; τί σιγᾷς; ἀλλὰ δῆτ' ἐκ τοῦ μέλους
urn:cts:greekLit:tlg0019.tlg008.fu.sp:145.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:145.1.text#ζητῶ σ', ἐπειδή γ' αὐτὸς οὐ βούλει φράσαι;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:146.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:146.1.text#ὦ πρέσβυ πρέσβυ, τοῦ φθόνου μὲν τὸν ψόγον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:147.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:147.1.text#ἤκουσα, τὴν δ' ἄλγησιν οὐ παρεσχόμην·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:148.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:148.1.text#ἐγὼ δὲ τὴν ἐσθῆθ' ἅμα γνώμῃ φορῶ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:149.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:149.1.text#χρὴ γὰρ ποιητὴν ἄνδρα πρὸς τὰ δράματα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:150.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:150.1.text#ἃ δεῖ ποιεῖν πρὸς ταῦτα τοὺς τρόπους ἔχειν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:151.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:151.1.text#αὐτίκα γυναικεῖ' ἢν ποιῇ τις δράματα,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:152.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:152.1.text#μετουσίαν δεῖ τῶν τρόπων τὸ σῶμ' ἔχειν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:153.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:153.1.text#οὐκοῦν κελητίζεις, ὅταν Φαίδραν ποιῇς;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:154.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:154.1.text#ἀνδρεῖα δ' ἢν ποιῇ τις, ἐν τῷ σώματι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:155.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:155.1.text#ἔνεσθ' ὑπάρχον τοῦθ'. ἃ δ' οὐ κεκτήμεθα,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:156.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:156.1.text#μίμησις ἤδη ταῦτα συνθηρεύεται.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:157.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:157.1.text#ὅταν σατύρους τοίνυν ποιῇς, καλεῖν ἐμέ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:158.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:158.1.text#ἵνα συμποιῶ σοὔπισθεν ἐστυκὼς ἐγώ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:159.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:159.1.text#ἄλλως τ' ἄμουσόν ἐστι ποιητὴν ἰδεῖν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:160.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:160.1.text#ἀγρεῖον ὄντα καὶ δασύν· σκέψαι δ' ὅτι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:161.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:161.1.text#Ἴβυκος ἐκεῖνος κἀνακρέων ὁ Τήιος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:162.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:162.1.text#κἀλκαῖος, οἳ περὶ ἁρμονίαν ἐχύμισαν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:163.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:163.1.text#ἐμιτροφόρουν τε καὶ διεκλῶντ' Ἰωνικῶς,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:164.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:164.1.text#καὶ Φρύνιχος, τοῦτον γὰρ οὖν ἀκήκοας,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:165.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:165.1.text#αὐτός τε καλὸς ἦν καὶ καλῶς ἠμπέσχετο·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:166.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:166.1.text#διὰ τοῦτ' ἄρ' αὐτοῦ καὶ κάλ' ἦν τὰ δράματα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:167.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:167.1.text#ὅμοια γὰρ ποιεῖν ἀνάγκη τῇ φύσει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:168.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:168.1.text#ταῦτ' ἄρ' ὁ Φιλοκλέης αἰσχρὸς ὢν αἰσχρῶς ποιεῖ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:169.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:169.1.text#ὁ δ' αὖ Ξενοκλέης ὢν κακὸς κακῶς ποιεῖ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:170.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:170.1.text#ὁ δ' αὖ Θέογνις ψυχρὸς ὢν ψυχρῶς ποιεῖ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:171.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:171.1.text#ἅπασ' ἀνάγκη· ταῦτα γάρ τοι γνοὺς ἐγὼ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:172.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:172.1.text#ἐμαυτὸν ἐθεράπευσα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:172.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:172.2.text#πῶς πρὸς τῶν θεῶν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:173.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:173.1.text#παῦσαι βαΰζων· καὶ γὰρ ἐγὼ τοιοῦτος ἦν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:174.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:174.1.text#ὢν τηλικοῦτος, ἡνίκ' ἠρχόμην ποιεῖν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:175.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:175.1.text#μὰ τὸν Δί' οὐ ζηλῶ σε τῆς παιδεύσεως.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:176.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:176.1.text#ἀλλ' ὧνπερ οὕνεκ' ἦλθον, ἔα μ' εἰπεῖν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:176.2.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:176.2.text#λέγε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:177.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:177.1.text#Ἀγάθων, σοφοῦ πρὸς ἀνδρός, ὅστις ἐν βραχεῖ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:178.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:178.1.text#πολλοὺς καλῶς οἷός τε συντέμνειν λόγους.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:179.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:179.1.text#ἐγὼ δὲ καινῇ ξυμφορᾷ πεπληγμένος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:180.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:180.1.text#ἱκέτης ἀφῖγμαι πρὸς σέ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:180.2.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:180.2.text#τοῦ χρείαν ἔχων;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:181.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:181.1.text#μέλλουσί μ' αἱ γυναῖκες ἀπολεῖν τήμερον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:182.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:182.1.text#τοῖς Θεσμοφορίοις, ὅτι κακῶς αὐτὰς λέγω.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:183.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:183.1.text#τίς οὖν παρ' ἡμῶν ἐστιν ὠφέλειά σοι;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:184.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:184.1.text#ἡ πᾶσ'· ἐὰν γὰρ ἐγκαθεζόμενος λάθρᾳ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:185.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:185.1.text#ἐν ταῖς γυναιξίν, ὡς δοκῶν εἶναι γυνή,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:186.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:186.1.text#ὑπεραποκρίνῃ μου, σαφῶς σώσεις ἐμέ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:187.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:187.1.text#μόνος γὰρ ἂν λέξειας ἀξίως ἐμοῦ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:188.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:188.1.text#ἔπειτα πῶς οὐκ αὐτὸς ἀπολογεῖ παρών;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:189.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:189.1.text#ἐγὼ φράσω σοι. πρῶτα μὲν γιγνώσκομαι·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:190.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:190.1.text#ἔπειτα πολιός εἰμι καὶ πώγων' ἔχω,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:191.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:191.1.text#σὺ δ' εὐπρόσωπος λευκὸς ἐξυρημένος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:192.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:192.1.text#γυναικόφωνος ἁπαλὸς εὐπρεπὴς ἰδεῖν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:193.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:193.1.text#Εὐριπίδη—
urn:cts:greekLit:tlg0019.tlg008.fu.sp:193.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:193.2.text#τί ἔστιν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:193.3.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:193.3.text#ἐποίησάς ποτε,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:194.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:194.1.text# "χαίρεις ὁρῶν φῶς, πατέρα δ' οὐ χαίρειν δοκεῖς;"
urn:cts:greekLit:tlg0019.tlg008.fu.sp:195.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:195.1.text#ἔγωγε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:195.2.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:195.2.text#μή νυν ἐλπίσῃς τὸ σὸν κακὸν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:196.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:196.1.text#ἡμᾶς ὑφέξειν. καὶ γὰρ ἂν μαινοίμεθ' ἄν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:197.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:197.1.text#ἀλλ' αὐτὸς ὅ γε σόν ἐστιν οἰκείως φέρε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:198.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:198.1.text#τὰς συμφορὰς γὰρ οὐχὶ τοῖς τεχνάσμασιν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:199.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:199.1.text#φέρειν δίκαιον ἀλλὰ τοῖς παθήμασιν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:200.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:200.1.text#καὶ μὴν ού γ' ὦ κατάπυγον εὐρύπρωκτος εἶ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:201.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:201.1.text#οὐ τοῖς λόγοισιν ἀλλὰ τοῖς παθήμασιν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:202.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:202.1.text#τί δ' ἔστιν ὅτι δέδοικας ἐλθεῖν αὐτόσε;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:203.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:203.1.text#κάκιον ἀπολοίμην ἂν ἢ σύ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:203.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:203.2.text#πῶς;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:203.3.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:203.3.text#ὅπως;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:204.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:204.1.text#δοκῶν γυναικῶν ἔργα νυκτερείσια
urn:cts:greekLit:tlg0019.tlg008.fu.sp:205.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:205.1.text#κλέπτειν ὑφαρπάζειν τε θήλειαν Κύπριν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:206.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:206.1.text#ἰδού γε κλέπτειν· νὴ Δία βινεῖσθαι μὲν οὖν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:207.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:207.1.text#ἀτὰρ ἡ πρόφασίς γε νὴ Δί' εἰκότως ἔχει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:208.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:208.1.text#τί οὖν; ποιήσεις ταῦτα;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:208.2.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:208.2.text#μὴ δόκει γε σύ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:209.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:209.1.text#ὦ τρισκακοδαίμων ὡς ἀπόλωλ' Εὐριπίδης.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:210.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:210.1.text#ὦ φίλτατ' ὦ κηδεστὰ μὴ σαυτὸν προδῷς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:211.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:211.1.text#πῶς οὖν ποιήσω δῆτα;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:211.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:211.2.text#τοῦτον μὲν μακρὰ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:212.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:212.1.text#κλάειν κέλευ', ἐμοὶ δ' ὅ τι βούλει χρῶ λαβών.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:213.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:213.1.text#ἄγε νυν ἐπειδὴ σαυτὸν ἐπιδίδως ἐμοί,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:214.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:214.1.text#ἀπόδυθι τουτὶ θοἰμάτιον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:214.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:214.2.text#καὶ δὴ χαμαί.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:215.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:215.1.text#ἀτὰρ τί μέλλεις δρᾶν μ';
urn:cts:greekLit:tlg0019.tlg008.fu.sp:215.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:215.2.text#ἀποξυρεῖν ταδί,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:216.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:216.1.text#τὰ κάτω δ' ἀφεύειν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:216.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:216.2.text#ἀλλὰ πρᾶττ', εἴ σοι δοκεῖ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:217.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:217.1.text#ἢ μὴ' πιδοῦν' ἐμαυτὸν ὤφελόν ποτε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:218.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:218.1.text#Ἀγάθων σὺ μέντοι ξυροφορεῖς ἑκάστοτε,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:219.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:219.1.text#χρῆσόν τί νυν ἡμῖν ξυρόν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:219.2.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:219.2.text#αὐτὸς λάμβανε
urn:cts:greekLit:tlg0019.tlg008.fu.sp:220.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:220.1.text#ἐντεῦθεν ἐκ τῆς ξυροδόκης.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:220.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:220.2.text#γενναῖος εἶ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:221.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:221.1.text#κάθιξε· φύσα τὴν γνάθον τὴν δεξιάν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:222.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:222.1.text#ὤμοι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:222.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:222.2.text#τί κέκραγας; ἐμβαλῶ σοι πάτταλον,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:223.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:223.1.text#ἢν μὴ σιωπᾷς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:223.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:223.2.text#ἀτταταῖ ἰατταταῖ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:224.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:224.1.text#οὗτος σὺ ποῖ θεῖς;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:224.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:224.2.text#ἐς τὸ τῶν σεμνῶν θεῶν·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:225.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:225.1.text#οὐ γὰρ μὰ τὴν Δήμητρά γ' ἐνταυθοῖ μενῶ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:226.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:226.1.text#τεμνόμενος.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:226.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:226.2.text#οὔκουν καταγέλαστος δῆτ' ἔσει
urn:cts:greekLit:tlg0019.tlg008.fu.sp:227.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:227.1.text#τὴν ἡμίκραιραν τὴν ἑτέραν ψιλὴν ἔχων;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:228.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:228.1.text#ὀλίγον μέλει μοι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:228.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:228.2.text#μηδαμῶς πρὸς τῶν θεῶν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:229.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:229.1.text#προδῷς με· χώρει δεῦρο.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:229.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:229.2.text#κακοδαίμων ἐγώ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:230.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:230.1.text#ἔχ' ἀτρέμα σαυτὸν κἀνάκυπτε· ποῖ στρέφει;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:231.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:231.1.text#μυμῦ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:231.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:231.2.text#τί μύξεις; πάντα πεποίηται καλῶς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:232.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:232.1.text#οἴμοι κακοδαίμων, ψιλὸς αὖ στρατεύσομαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:233.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:233.1.text#μὴ φροντίσῃ· ὡς εὐπρεπὴς φανεῖ πάνυ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:234.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:234.1.text#βούλει θεᾶσθαι σαυτόν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:234.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:234.2.text#εἰ δοκεῖ, φέρε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:235.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:235.1.text#ὁρᾷς σεαυτόν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:235.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:235.2.text#οὐ μὰ Δί' ἀλλὰ Κλεισθένη.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:236.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:236.1.text#ἀνίστασ', ἵν' ἀφεύσω σε, κἀγκύψας ἔχε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:237.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:237.1.text#οἴμοι κακοδαίμων δελφάκιον γενήσομαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:238.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:238.1.text#ἐνεγκάτω τις ἔνδοθεν δᾷδ' ἢ λύχνον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:239.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:239.1.text#ἐπίκυπτε· τὴν κέρκον φυλάττου νυν ἄκραν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:240.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:240.1.text#ἐμοὶ μελήσει νὴ Δία, πλήν γ' ὅτι κάομαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:241.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:241.1.text#οἴμοι τάλας. ὕδωρ ὕδωρ ὦ γείτονες.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:242.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:242.1.text#πρὶν ἀντιλαβέσθαι †πρωκτὸν τῆς φλογός.†
urn:cts:greekLit:tlg0019.tlg008.fu.sp:243.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:243.1.text#θάρρει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:243.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:243.2.text#τί θαρρῶ καταπεπυρπολημένος;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:244.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:244.1.text#ἀλλ' οὐκ ἔτ' οἰδὲν πρᾶγμά σοι· τὰ πλεῖστα γὰρ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:245.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:245.1.text#ἀποπεπόνηκας.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:245.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:245.2.text#φῦ ἰοὺ τῆς ἀσβόλου.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:246.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:246.1.text#αἰθὸς γεγένημαι πάντα τὰ περὶ τὴν τράμιν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:247.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:247.1.text#μὴ φροντίσῃς· ἕτερος γὰρ αὐτὰ σφογγιεῖ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:248.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:248.1.text#οἰμώξετἄρ' εἴ τις τὸν ἐμὸν πρωκτὸν πλυνεῖ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:249.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:249.1.text#Ἀγάθων, ἐπειδὴ σαυτὸν ἐπιδοῦναι φθονεῖς,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:250.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:250.1.text#ἀλλ' ἱμάτιον γοῦν χρῆσον ἡμῖν τουτῳὶ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:251.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:251.1.text#καὶ στρόφιον· οὐ γὰρ ταῦτά γ' ὡς οὐκ ἔστ' ἐρεῖς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:252.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:252.1.text#λαμβάνετε καὶ χρῆσθ'· οὐ φθονῶ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:252.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:252.2.text#τί οὖν λάβω;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:253.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:253.1.text#ὅ τι; τὸν κροκωτὸν πρῶτον ἐνδύου λαβών.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:254.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:254.1.text#νὴ τὴν Ἀφροδίτην ἡδύ γ' ὄζει ποσθίου.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:255.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:255.1.text#σύζωσον ἀνύσας. αἶρε νῦν στρόφιον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:255.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:255.2.text#ἰδού.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:256.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:256.1.text#ἴθι νυν κατάστειλόν με τὰ περὶ τὼ σκέλει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:257.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:257.1.text#κεκρυφάλου δεῖ καὶ μίτρας.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:257.2.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:257.2.text#ἡδὶ μὲν οὖν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:258.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:258.1.text#κεφαλὴ περίθετος, ἣν ἐγὼ νύκτωρ φορῶ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:259.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:259.1.text#νὴ τὸν Δί' ἀλλὰ κἀπιτηδεία πάνυ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:260.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:260.1.text#ἆρ' ἁρμόσει μοι;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:260.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:260.2.text#νὴ Δί' ἀλλ' ἄριστ' ἔχει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:261.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:261.1.text#φέρ' ἔγκυκλον·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:261.2.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:261.2.text#τουτὶ λάβ' ἀπὸ τῆς κλινίδος.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:262.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:262.1.text#ὑποδημάτων δεῖ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:262.2.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:262.2.text#τἀμὰ ταυτὶ λάμβανε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:263.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:263.1.text#ἆρ' ἁρμόσει μοι;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:263.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:263.2.text#χαλαρὰ γοῦν χαίρεις φορῶν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:264.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:264.1.text#σὺ τοῦτο γίγνωσκ'· ἀλλ' ἔχεις γὰρ ὧν δέει,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:265.1.speaker#Ἀγάθων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:265.1.text#εἴσω τις ὡς τάχιστά μ' ἐσκυκλησάτω.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:266.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:266.1.text#ἁνὴρ μὲν ἡμῖν οὑτοσὶ καὶ δὴ γυνὴ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:267.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:267.1.text#τό γ' εἶδος· ἢν λαλῇς δ', ὅπως τῷ φθέγματι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:268.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:268.1.text#γυναικιεῖς εὖ καὶ πιθανῶς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:268.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:268.2.text#πειράσομαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:269.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:269.1.text#βάδιζε τοίνυν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:269.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:269.2.text#μὰ τὸν Ἀπόλλω οὔκ, ἤν γε μὴ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:270.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:270.1.text#ὀμόσῃς ἐμοί—
urn:cts:greekLit:tlg0019.tlg008.fu.sp:270.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:270.2.text#τί χρῆμα;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:270.3.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:270.3.text#συσσώσειν ἐμὲ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:271.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:271.1.text#πάσαις τέχναις, ἤν μοί τι περιπίπτῃ κακόν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:272.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:272.1.text#ὄμνυμι τοίνυν αἰθέρ' οἴκησιν Διός.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:273.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:273.1.text#τί μᾶλλον ἢ τὴν Ἱπποκράτους ξυνοικίαν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:274.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:274.1.text#ὄμνυμι τοίνυν πάντας ἄρδην τοὺς θεούς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:275.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:275.1.text#μέμνησο τοίνυν ταῦθ', ὅτι ἡ φρὴν ὤμοσεν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:276.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:276.1.text#ἡ γλῶττα δ' οὐκ ὀμώμοκ'· οὐδ' ὥρκωσ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:277.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:277.1.text#ἔκσπευδε ταχέως· ὡς τὸ τῆς ἐκκλησίας
urn:cts:greekLit:tlg0019.tlg008.fu.sp:278.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:278.1.text#σημεῖον ἐν τῷ Θεσμοφορείῳ φαίνεται.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:279.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:279.1.text#ἐγὼ δ' ἄπειμι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:279.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:279.2.text#δεῦρό νυν ὦ Θρᾷτθ' ἕπου.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:280.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:280.1.text#ὦ Θρᾷττα θέασαι, καομένων τῶν λαμπάδων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:281.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:281.1.text#ὅσον τὸ χρῆμ' ἀνέρχεθ' ὑπὸ τῆς λιγνύος.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:282.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:282.1.text#ἀλλ' ὦ περικαλλεῖ Θεσμοφόρω δέξασθέ με
urn:cts:greekLit:tlg0019.tlg008.fu.sp:283.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:283.1.text#ἀγαθῇ τύχῃ καὶ δεῦρο καὶ πάλιν οἴκαδε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:284.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:284.1.text#ὦ Θρᾷττα τὴν κίστην κάθελε, κᾆτ' ἔξελε
urn:cts:greekLit:tlg0019.tlg008.fu.sp:285.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:285.1.text#τὸ πόπανον, ὅπως λαβοῦσα θύσω τοῖν θεοῖν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:286.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:286.1.text#δέσποινα πολυτίμητε Δήμητερ φίλη
urn:cts:greekLit:tlg0019.tlg008.fu.sp:287.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:287.1.text#καὶ Φερρέφαττα, πολλὰ πολλάκις μέ σοι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:288.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:288.1.text#θύειν ἔχουσαν, εἰ δὲ μἀλλὰ νῦν λαθεῖν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:289.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:289.1.text#καὶ τοῦ θυγατρίου χοῖρον ἀνδρός μοι τυχεῖν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:290.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:290.1.text#πλουτοῦντος, ἄλλως δ' ἠλιθίου κἀβελτέρου,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:291.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:291.1.text#καὶ ποσθαλίσκον νοῦν ἔχειν μοι καὶ φρένας.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:292.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:292.1.text#ποῦ ποῦ καθίζωμ' ἐν καλῷ, τῶν ῥητόρων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:293.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:293.1.text#ἵν' ἐξακούω; σὺ δ' ἄπιθ' ὦ Θρᾷττ' ἐκποδών.
<l speaker="Μνησίλοχος" xml:base="urn:cts:greekLit:tlg0019.tlg008.fu.sp:" n="294.1">
urn:cts:greekLit:tlg0019.tlg008.fu.sp:295.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:295.1.text#εὐφημία 'στω, εὐφημία 'στω. εὔχεσθε τοῖν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:296.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:296.1.text#Θεσμοφόροιν τῇ Δήμητρι καὶ τῇ Κόρῃ καὶ τῷ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:297.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:297.1.text#Πλούτῳ καὶ τῇ Καλλιγενείᾳ καὶ τῇ Κουροτρόφῳ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:300.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:300.1.text#τῇ Γῇ καὶ τῷ Ἑρμῇ καὶ Χάρισιν ἐκκλησίαν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:301.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:301.1.text#τήνδε καὶ σύνοδον τὴν νῦν κάλλιστα καὶ ἄριστα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:302.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:302.1.text#ποιῆσαι, πολυωφελῶς μὲν πόλει τῇ Ἀθηναίων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:305.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:305.1.text#τυχηρῶς δ' ἡμῖν αὐταῖς. καὶ τὴν δρῶσαν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:306.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:306.1.text#τήν τ' ἀγορεύουσαν τὰ βέλτιστα περὶ τὸν δῆμον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:307.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:307.1.text#τὸν Ἀθηναίων καὶ τὸν τῶν γυναικῶν ταύτην
urn:cts:greekLit:tlg0019.tlg008.fu.sp:310.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:310.1.text#νικᾶν. ταῦτ' εὔχεσθε, καὶ ὑμῖν αὐταῖς τἀγαθά.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:311.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:311.1.text#ἰὴ παιὼν ἰὴ παιών. χαίρωμεν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:312.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:312.1.text#δεχόμεθα καὶ θεῶν γένος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:313.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:313.1.text#λιτόμεθα ταῖσδ' ἐπ' εὐχαῖς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:314.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:314.1.text#φανέντας ἐπιχαρῆναι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:315.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:315.1.text#Ζεῦ μεγαλώνυμε χρυσολύρα τε
urn:cts:greekLit:tlg0019.tlg008.fu.sp:316.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:316.1.text#Δῆλον ὃς ἔχεις ἱεράν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:317.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:317.1.text#καὶ σὺ παγκρατὲς κόρα γλαυκῶπι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:318.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:318.1.text#χρυσόλογχε πόλιν οἰκοῦσα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:319.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:319.1.text#περιμάχητον, ἐλθὲ δεῦρο.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:320.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:320.1.text#καὶ πολυώνυμε θηροφόνη παῖ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:321.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:321.1.text#Λατοῦς χρυσώπιδος ἔρνος,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:322.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:322.1.text#σύ τε πόντιε σεμνὲ Πόσειδον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:323.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:323.1.text#ἁλιμέδον προλιπὼν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:324.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:324.1.text#μυχὸν ἰχθυόεντ' οἰστροδόνητον,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:325.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:325.1.text#Νηρέος ἐναλίου τε κόραι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:326.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:326.1.text#Νύμφαι τ' ὀρείπλαγκτοι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:327.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:327.1.text#χρυσέα τε φόρμιγξ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:328.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:328.1.text#ἰαχήσειεν ἐπ' εὐχαῖς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:329.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:329.1.text#ἡμετέραις· τελέως δ'
urn:cts:greekLit:tlg0019.tlg008.fu.sp:330.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:330.1.text#ἐκκλησιάσαιμεν Ἀθηναίων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:330a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:330a.1.text#εὐγενεῖς γυναῖκες.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:331.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:331.1.text#εὔχεσθε τοῖς θεοῖσι τοῖς Ὀλυμπίοις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:332.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:332.1.text#καὶ ταῖς Ὀλυμπίαισι καὶ τοῖς Πυθίοις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:333.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:333.1.text#καὶ ταῖσι Πυθίαισι καὶ τοῖς Δηλίοις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:334.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:334.1.text#καὶ ταῖσι Δηλίαισι τοῖς τ' ἄλλοις θεοῖς,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:335.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:335.1.text#εἴ τις ἐπιβουλεύει τι τῷ δήμῳ κακὸν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:336.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:336.1.text#τῷ τῶν γυναικῶν ἢ 'πικηρυκεύεται
urn:cts:greekLit:tlg0019.tlg008.fu.sp:337.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:337.1.text#Εὐριπίδῃ Μήδοις τ' ἐπὶ βλάβῃ τινὶ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:338.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:338.1.text#τῇ τῶν γυναικῶν, ἢ τυραννεῖν ἐπινοεῖ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:339.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:339.1.text#ἢ τὸν τύραννον συγκατάγειν, ἢ παιδίον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:340.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:340.1.text#ὑποβαλλομένης κατεῖπεν, ἢ δούλη τινὸς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:341.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:341.1.text#προαγωγὸς οὖσ' ἐνετρύλλισεν τῷ δεσπότῃ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:342.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:342.1.text#ἢ πεμπομένη τις ἀγγελίας ψευδεῖς φέρει,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:343.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:343.1.text#ἢ μοιχὸς εἴ τις ἐξαπατᾷ ψευδῆ λέγων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:344.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:344.1.text#καὶ μὴ δίδωσιν ἃν ὑπόσχηταί ποτε,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:345.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:345.1.text#ἢ δῶρά τις δίδωσι μοιχῷ γραῦς γυνή,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:346.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:346.1.text#ἢ καὶ δέχεται προδιδοῦσ' ἑταίρα τὸν φίλον,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:347.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:347.1.text#κεἴ τις κάπηλος ἢ καπηλὶς τοῦ χοῶς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:348.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:348.1.text#ἢ τῶν κοτυλῶν τὸ νόμισμα διαλυμαίνεται,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:349.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:349.1.text#κακῶς ἀπολέσθαι τοῦτον αὐτὸν κᾠκίαν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:350.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:350.1.text#ἀρᾶσθε, ταῖς δ' ἄλλαισιν ὑμῖν τοὺς θεοὺς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:351.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:351.1.text#εὔχεσθε πάσαις πολλὰ δοῦναι κἀγαθά.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:352.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:352.1.text#ξυνευχόμεσθα τέλεα μὲν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:353.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:353.1.text#πόλει τέλεα δὲ δήμῳ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:354.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:354.1.text#τάδ' εὔγματα γενέσθαι,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:355.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:355.1.text#τὰ δ' ἄρισθ' ὅσαις προσήκει
urn:cts:greekLit:tlg0019.tlg008.fu.sp:356.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:356.1.text#νικᾶν λεγούσαις· ὁπόσαι δ'
urn:cts:greekLit:tlg0019.tlg008.fu.sp:357.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:357.1.text#ἐξαπατῶσιν παραβαίνουσί τε τοὺς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:358.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:358.1.text#ὅρκους τοὺς νενομισμένους
urn:cts:greekLit:tlg0019.tlg008.fu.sp:360.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:360.1.text#κερδῶν οὕνεκ' ἐπὶ βλάβῃ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:361.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:361.1.text#ἢ ψηφίσματα καὶ νόμον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:362.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:362.1.text#ζητοῦσ' ἀντιμεθιστάναι,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:363.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:363.1.text#τἀπόρρητά τε τοῖσιν ἐχθροῖς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:364.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:364.1.text#τοῖς ἡμετέροις λέγουσ',
urn:cts:greekLit:tlg0019.tlg008.fu.sp:365.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:365.1.text#ἢ Μήδους ἐπάγουσι γῇ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:366.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:366.1.text#κερδῶν οὕνεκ' ἐπὶ βλάβῃ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:367.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:367.1.text#ἀσεβοῦσιν ἀδικοῦσίν τε τὴν πόλιν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:368.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:368.1.text#ἀλλ' ὦ παγκρατὲς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:369.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:369.1.text#Ζεῦ ταῦτα κυρώσειας, ὥσθ'
urn:cts:greekLit:tlg0019.tlg008.fu.sp:370.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:370.1.text#ἡμῖν θεοὺς παραστατεῖν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:371.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:371.1.text#καίπερ γυναιξὶν οὔσαις.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:373.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:373.1.text#ἄκουε πᾶς. ἔδοξε τῇ βουλῇ τάδε
urn:cts:greekLit:tlg0019.tlg008.fu.sp:374.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:374.1.text#τῇ τῶν γυναικῶν· Τιμόκλει' ἐπεστάτει,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:375.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:375.1.text#Λύσιλλ' ἐγραμμάτευεν, εἶπε Ζωστράτη·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:376.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:376.1.text#ἐκκλησίαν ποιεῖν ἕωθεν τῇ μέσῃ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:377.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:377.1.text#τῶν Θεσμοφορίων, ᾗ μάλισθ' ἡμῖν σχολή,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:378.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:378.1.text#καὶ χρηματίζειν πρῶτα περὶ Εὐριπίδου,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:379.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:379.1.text#ὅ τι χρὴ παθεῖν ἐκεῖνον· ἀδικεῖν γὰρ δοκεῖ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:379b.1.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:379b.1.text#ἡμῖν ἁπάσαις. τίς ἀγορεύειν βούλεται;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:380.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:380.1.text#ἐγώ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:380.2.speaker#Κηρύκαινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:380.2.text#περίθου νυν τόνδε πρῶτον πρὶν λέγειν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:381.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:381.1.text#σίγα σιώπα, πρόσεχε τὸν νοῦν· χρέμπτεται γὰρ ἤδη
urn:cts:greekLit:tlg0019.tlg008.fu.sp:382.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:382.1.text#ὅπερ ποιοῦσ' οἱ ῥήτορες. μακρὰν ἔοικε λέξειν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:383.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:383.1.text#φιλοτιμίᾳ μὲν οὐδεμιᾷ μὰ τὼ θεὼ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:384.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:384.1.text#λέξουσ' ἀνέστην ὦ γυναῖκες· ἀλλὰ γὰρ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:385.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:385.1.text#βαρέως φέρω τάλαινα πολὺν ἤδη χρόνον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:386.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:386.1.text#προπηλακιζομένας ὁρῶς ἡμᾶς ὑπὸ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:387.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:387.1.text#Εὐριπίδου τοῦ τῆς λαχανοπωλητρίας
urn:cts:greekLit:tlg0019.tlg008.fu.sp:388.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:388.1.text#καὶ πολλὰ καὶ παντοῖ' ἀκουούσας κακά.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:389.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:389.1.text#τί γὰρ οὗτος ἡμᾶς οὐκ ἐπισμῇ τῶν κακῶν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:390.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:390.1.text#ποῦ δ' οὐχὶ διαβέβληχ', ὅπουπερ ἔμβραχυ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:391.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:391.1.text#εἰσὶν θεαταὶ καὶ τραγῳδοὶ καὶ χοροί,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:392.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:392.1.text#τὰς μοιχοτρόπους, τὰς ἀνδρεραστίας καλῶν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:393.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:393.1.text#τὰς οἰνοπότιδας, τὰς προδότιδας, τὰς λάλους,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:394.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:394.1.text#τὰς οὐδὲν ὑγιές, τὰς μέγ' ἀνδράσιν κακόν·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:395.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:395.1.text#ὥστ' εὐθὺς εἰσιόντες ἀπὸ τῶν ἰκρίων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:396.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:396.1.text#ὑποβλέπουσ' ἡμᾶς σκοποῦνταί τ' εὐθέως
urn:cts:greekLit:tlg0019.tlg008.fu.sp:397.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:397.1.text#μὴ μοιχὸς ἔνδον ᾖ τις ἀποκεκρυμμένος.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:398.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:398.1.text#δρᾶσαι δ' ἔθ' ἡμῖν οὐδὲν ὥσπερ καὶ πρὸ τοῦ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:399.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:399.1.text#ἔξεστι· τοιαῦθ' οὗτος ἐδίδαξεν κακὰ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:400.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:400.1.text#τοὺς ἄνδρας ἡμῶν· ὥστ' ἐάνπερ τις πλέκῃ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:401.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:401.1.text#γυνὴ στέφανον, ἐρᾶν δοκεῖ· κἂν ἐκβάλῃ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:402.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:402.1.text#σκεῦός τι κατὰ τὴν οἰκίαν πλανωμένη,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:403.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:403.1.text#ἁνὴρ ἐρωτᾷ, 'τῷ κατέαγεν ἡ χύτρα;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:404.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:404.1.text#οὐκ ἔσθ' ὅπως οὐ τῷ Κορινθίῳ ξένῳ.'
urn:cts:greekLit:tlg0019.tlg008.fu.sp:405.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:405.1.text#κάμνει κόρη τις, εὐθὺς ἁδελφὸς λέγει,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:406.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:406.1.text# "τὸ χρῶμα τοῦτό μ' οὐκ ἀρέσκει τῆς κόρης."
urn:cts:greekLit:tlg0019.tlg008.fu.sp:407.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:407.1.text#εἶεν, γυνή τις ὑποβαλέσθαι βούλεται
urn:cts:greekLit:tlg0019.tlg008.fu.sp:408.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:408.1.text#ἀποροῦσα παίδων, οὐδὲ τοῦτ' ἔστιν λαθεῖν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:409.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:409.1.text#ἅνδρες γὰρ ἤδη παρακάθηνται πλησίον·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:410.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:410.1.text#πρὸς τοὺς γέροντάς θ' οἳ πρὸ τοῦ τὰς μείρακας
urn:cts:greekLit:tlg0019.tlg008.fu.sp:411.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:411.1.text#ἤγοντο, διαβέβληκεν, ὥστ' οὐδεὶς γέρων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:412.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:412.1.text#γαμεῖν ἐθέλει γυναῖκα διὰ τοὔπος τοδὶ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:413.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:413.1.text# "δέσποινα γὰρ γέροντι νυμφίῳ γυνή."
urn:cts:greekLit:tlg0019.tlg008.fu.sp:414.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:414.1.text#εἶτα διὰ τοῦτον ταῖς γυναικωνίτισιν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:415.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:415.1.text#σφραγῖδας ἐπιβάλλουσιν ἤδη καὶ μοχλοὺς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:416.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:416.1.text#τηροῦντες ἡμᾶς, καὶ προσέτι Μολοττικοὺς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:417.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:417.1.text#τρέφουσι μορμολυκεῖα τοῖς μοιχοῖς κύνας.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:418.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:418.1.text#καὶ ταῦτα μὲν ξυγγνώσθ'. ἃ δ' ἦν ἡμῖν πρὸ τοῦ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:419.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:419.1.text#αὐταῖς ταμιεῦσαι καὶ προαιρούσαις λαθεῖν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:420.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:420.1.text#ἄλφιτον ἔλαιον οἶνον, οὐδὲ ταῦτ' ἔτι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:421.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:421.1.text#ἔξεστιν. οἱ γὰρ ἄνδρες ἤδη κλῄδια
urn:cts:greekLit:tlg0019.tlg008.fu.sp:422.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:422.1.text#αὐτοὶ φοροῦσι κρυπτὰ κακοηθέστατα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:423.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:423.1.text#Λακωνίκ' ἄττα, τρεῖς ἔχοντα γομφίους.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:424.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:424.1.text#πρὸ τοῦ μὲν οὖν ἦν ἀλλ' ὑποῖξαι τὴν θύραν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:425.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:425.1.text#ποιησαμέναισι δακτύλιον τριωβόλου,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:426.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:426.1.text#νῦν δ' οὗτος αὐτοὺς ᾡκότριψ Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:427.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:427.1.text#ἐδίδαξε θριπήδεστ' ἔχειν σφραγίδια
urn:cts:greekLit:tlg0019.tlg008.fu.sp:428.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:428.1.text#ἐξαψαμένους. νῦν οὖν ἐμοὶ τούτῳ δοκεῖ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:429.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:429.1.text#ὄλεθρόν τιν' ἡμᾶς κυρκανᾶν ἁμωσγέπως,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:430.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:430.1.text#ἢ φαρμάκοισιν ἢ μιᾷ γέ τῳ τέχνῃ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:431.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:431.1.text#ὅπως ἀπολεῖται. ταῦτ' ἐγὼ φανερῶς λέγω,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:432.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:432.1.text#τὰ δ' ἄλλα μετὰ τῆς γραμματέως συγγράψομαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:434.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:434.1.text#οὔπω ταύτης ἤκουσα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:435.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:435.1.text#πολυπλοκωτέρας γυναικὸς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:436.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:436.1.text#οὐδὲ δεινότερον λεγούσης.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:437.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:437.1.text#πάντα γὰρ λέγει δίκαια,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:438.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:438.1.text#†πάσας δ' ἰδέας ἐξήτασεν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:439.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:439.1.text#πάντα δ' ἐβάστασεν φρενὶ πυκνῶς τε†
urn:cts:greekLit:tlg0019.tlg008.fu.sp:439a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:439a.1.text#ποικίλους λόγους ἀνηῦρεν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:440.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:440.1.text#εὖ διεζητημένους·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:440a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:440a.1.text#ὥστ' ἂν εἰ λέγοι παρ' αὐτὴν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:441.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:441.1.text#Ξενοκλέης ὁ Καρκίνου, δοκεῖν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:441a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:441a.1.text#ἂν αὐτόν, ὡς ἐγᾦμαι,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:442.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:442.1.text#πᾶσιν ὑμῖν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:442a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:442a.1.text#ἄντικρυς μηδὲν λέγειν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:443.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg008.fu.sp:443.1.text#ὀλίγων ἕνεκα καὐτὴ παρῆλθον ῥημάτων.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:444.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg008.fu.sp:444.1.text#τὰ μὲν γὰρ ἄλλ' αὕτη κατηγόρηκεν εὖ·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:445.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg008.fu.sp:445.1.text#ἃ δ' ἐγὼ πέπονθα, ταῦτα λέξαι βούλομαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:446.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg008.fu.sp:446.1.text#ἐμοὶ γὰρ ἁνὴρ ἀπέθανεν μὲν ἐν Κύπρῳ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:447.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg008.fu.sp:447.1.text#παιδάρια πέντε καταλιπών, ἁγὼ μόλις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:448.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg008.fu.sp:448.1.text#στεφανηπλοκοῦσ' ἔβοσκον ἐν ταῖς μυρρίναις.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:449.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg008.fu.sp:449.1.text#τέως μὲν οὖν ἀλλ' ἡμικάκως ἐβοσκόμην·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:450.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg008.fu.sp:450.1.text#νῦν δ' οὗτος ἐν ταῖσιν τραγῳδίαις ποιῶν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:451.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg008.fu.sp:451.1.text#τοὺς ἄνδρας ἀναπέπεικεν οὐκ εἶναι θεούς·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:452.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg008.fu.sp:452.1.text#ὥστ' οὐκέτ' ἐμπολῶμεν οὐδ' εἰς ἥμισυ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:453.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg008.fu.sp:453.1.text#νῦν οὖν ἁπάσαισιν παραινῶ καὶ λέγω
urn:cts:greekLit:tlg0019.tlg008.fu.sp:454.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg008.fu.sp:454.1.text#τοῦτον κολάσαι τὸν ἄνδρα πολλῶν οὕνεκα·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:455.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg008.fu.sp:455.1.text#ἄγρια γὰρ ἡμᾶς ὦ γυναῖκες δρᾷ κακά,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:456.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg008.fu.sp:456.1.text#ἅτ' ἐν ἀγρίοισι τοῖς λαχάνοις αὐτὸς τραφείς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:457.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg008.fu.sp:457.1.text#ἀλλ' εἰς ἀγορὰν ἄπειμι· δεῖ γὰρ ἀνδράσιν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:458.1.speaker#Γυνὴ Β
urn:cts:greekLit:tlg0019.tlg008.fu.sp:458.1.text#πλέξαι στεφάνους συνθηματιαίους εἴκοσιν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:459.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:459.1.text#ἕτερον αὖ τι λῆμα τοῦτο
urn:cts:greekLit:tlg0019.tlg008.fu.sp:460.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:460.1.text#κομψότερον ἔτ' ἢ τὸ πρότερον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:460a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:460a.1.text#ἀναπέφηνεν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:461.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:461.1.text#οἷα κατεστωμύλατο
urn:cts:greekLit:tlg0019.tlg008.fu.sp:462.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:462.1.text#οὐκ ἄκαιρα, φρένας ἔχουσα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:463.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:463.1.text#καὶ πολύπλοκον νόημ', οὐδ'
urn:cts:greekLit:tlg0019.tlg008.fu.sp:464.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:464.1.text#ἀσύνετ' ἀλλὰ πιθανὰ πάντα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:465.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:465.1.text#δεῖ δὲ ταύτης τῆς ὕβρεως ἡμῖν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:465a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:465a.1.text#τὸν ἄνδρα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:465b.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:465b.1.text#περιφανῶς δοῦναι δίκην.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:466.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:466.1.text#τὸ μὲν ὦ γυναῖκες ὀξυθυμεῖσθαι σφόδρα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:467.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:467.1.text#Εὐριπίδῃ, τοιαῦτ' ἀκουούσας κακά,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:468.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:468.1.text#οὐ θαυμάσιόν ἐστ', οὐδ' ἐπιζεῖν τὴν χολήν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:469.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:469.1.text#καὐτὴ γὰρ ἔγωγ', οὕτως ὀναίμην τῶν τέκνων,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:470.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:470.1.text#μισῶ τὸν ἄνδρ' ἐκεῖνον, εἰ μὴ μαίνομαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:471.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:471.1.text#ὅμως δ' ἐν ἀλλήλαισι χρὴ δοῦναι λόγον·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:472.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:472.1.text#αὐταὶ γάρ ἐσμεν, κοὐδεμί' ἔκφορος λόγου.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:473.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:473.1.text#τί ταῦτ' ἔχουσαι 'κεῖνον αἰτιώμεθα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:474.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:474.1.text#βαρέως τε φέρομεν, εἰ δύ' ἡμῶν ἢ τρία
urn:cts:greekLit:tlg0019.tlg008.fu.sp:475.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:475.1.text#κακὰ ξυνειδὼς εἶπε δρώσας μυρία;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:476.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:476.1.text#ἐγὼ γὰρ αὐτὴ πρῶτον, ἵνα μἄλλην λέγω,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:477.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:477.1.text#ξύνοιδ' ἐμαυτῇ πολλὰ δείν'· ἐκεῖνο δ' οὖν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:478.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:478.1.text#δεινότατον, ὅτε νύμφη μὲν ἦν τρεῖς ἡμέρας,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:479.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:479.1.text#ὁ δ' ἀνὴρ παρ' ἐμοὶ καθηῦδεν· ἦν δέ μοι φίλος,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:480.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:480.1.text#ὅσπερ με διεκόρησεν οὖσαν ἑπτέτιν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:481.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:481.1.text#οὖτος πόθῳ μου 'κνυεν ἐλθὼν τὴν θύραν·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:482.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:482.1.text#κᾆτ' εὐφὺς ἔγνων· εἶτα καταβαίνω λάθρᾳ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:483.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:483.1.text#ὁ δ' ἀνὴρ ἐρωτᾷ "ποῖ σὺ καταβαίνεις"; "ὅποι;"
urn:cts:greekLit:tlg0019.tlg008.fu.sp:484.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:484.1.text#"στρόφος μ' ἔχει τὴν γαστέρ ὦνερ κὠδύνη·"
urn:cts:greekLit:tlg0019.tlg008.fu.sp:485.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:485.1.text#"ἐς τὸν κοπρῶν' οὖν ἔρχομαι." "βάδιζέ νυν·"
urn:cts:greekLit:tlg0019.tlg008.fu.sp:486.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:486.1.text#κᾆθ' ὁ μὲν ἔτριβε κεδρίδας ἄννηθον σφάκον·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:487.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:487.1.text#ἐγὼ δὲ καταχέασα τοῦ στροφέως ὕδωρ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:488.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:488.1.text#ἐξῆλθον ὡς τὸν μοιχόν· εἶτ' ἠρειδόμην
urn:cts:greekLit:tlg0019.tlg008.fu.sp:489.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:489.1.text#παρὰ τὸν Ἀγυιᾶ κύβδ' ἐχομένη τῆς δάφνης.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:490.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:490.1.text#ταῦτ' οὐδεπώποτ' εἶφ', ὁρᾶτ', Εὐριπίδης·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:491.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:491.1.text#οὐδ' ὡς ὑπὸ τῶν δούλων τε κὠρεωκόμων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:492.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:492.1.text#σποδούμεθ', ἢν μὴ 'χωμεν ἕτερον, οὐ λέγει·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:493.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:493.1.text#οὐδ' ὡς ὅταν μάλισθ' ὑπό του ληκώμεθα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:494.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:494.1.text#τὴν νύχθ', ἕωθεν σκόροδα διαμασώμεθα,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:495.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:495.1.text#ἵν' ὀσφρόμενος ἁνὴρ ἀπὸ τείχους εἰσιὼν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:496.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:496.1.text#μηδὲν κακὸν δρᾶν ὑποτοπῆται. ταῦθ', ὁρᾷς,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:497.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:497.1.text#οὐπώποτ' εἶπεν. εἰ δὲ Φαίδραν λοιδορεῖ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:498.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:498.1.text#ἡμῖν τί τοῦτ' ἔστ'; οὐδ' ἐκεῖν' εἴρηκέ πω,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:499.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:499.1.text#ὡς ἡ γυνὴ δεικνῦσα τἀνδρὶ τοὔγκυκλον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:500.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:500.1.text#†ὑπ' αὐγὰς † οἷόν ἐστιν, ἐγκεκαλυμμένον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:501.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:501.1.text#τὸν μοιχὸν ἐξέπεμψεν, οὐκ εἴρηκέ πω.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:502.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:502.1.text#ἑτέραν δ' ἐγᾦδ' ἣ 'φασκεν ὠδίνειν γυνὴ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:503.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:503.1.text#δέχ' ἡμέρας, ἔως ἐπρίατο παιδίον·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:504.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:504.1.text#ὁ δ' ἀνὴρ περιέτρεχ' ὠκυτόκι' ὠνούμενος·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:505.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:505.1.text#τὸ δ' εἰσέφερε γραῦς ἐν χύτρᾳ τὸ παιδίον,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:506.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:506.1.text#ἵνα μὴ βό η, κηρίῳ βεβυσμένον·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:507.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:507.1.text#εἶθ' ὡς ἔνευσεν ἡ φέρουσ', εὐθὺς βοᾷ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:508.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:508.1.text#"ἄπελθ' ἄπελθ', ἤδη γὰρ ὦνέρ μοι δοκῶ"
urn:cts:greekLit:tlg0019.tlg008.fu.sp:509.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:509.1.text#"τέξειν." τὸ γὰρ ἦτρον τῆς χύτρας ἐλάκτισεν·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:510.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:510.1.text#χὠ μὲν γεγηθὼς ἔτρεχεν, ἡ δ' ἐξέσπασεν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:511.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:511.1.text#ἐκ τοῦ στόματος τοῦ παιδίου, τὸ δ' ἀνέκραγεν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:512.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:512.1.text#εἶθ' ἡ μιαρὰ γραῦς, ἣ 'φερεν τὸ παιδίον,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:513.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:513.1.text#θεῖ μειδιῶσα πρὸς τὸν ἄνδρα καὶ λέγει,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:514.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:514.1.text#"λέων λέων σοι γέγονεν, αὔτ' ἔκμαγμα σόν,"
urn:cts:greekLit:tlg0019.tlg008.fu.sp:515.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:515.1.text#"τά τ' ἄλλ' ἁπαξάπαντα καὶ τὸ πόσθιον"
urn:cts:greekLit:tlg0019.tlg008.fu.sp:516.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:516.1.text#"τῷ σῷ προσόμοιον, στρεβλὸν ὥσπερ κύτταρον."
urn:cts:greekLit:tlg0019.tlg008.fu.sp:517.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:517.1.text#ταῦτ' οὐ ποιοῦμεν τὰ κακά; νὴ τὴν Ἄρτεμιν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:518.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:518.1.text#ἡμεῖς γε. κᾆτ' Εὐριπίδῃ θυμούμεθα,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:519.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:519.1.text#οὐδὲν παθοῦσαι μεῖζον ἢ δεδράκαμεν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:520.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:520.1.text#τουτὶ μέντοι θαυμαστόν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:521.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:521.1.text#ὁπόθεν ηὑρέθη τὸ χρῆμα,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:522.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:522.1.text#χἤτις ἐξέθρεψε χώρα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:523.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:523.1.text#τήνδε τὴν θρασεῖαν οὕτω.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:524.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:524.1.text#τάδε γὰρ εἰπεῖν τὴν πανοῦργον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:525.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:525.1.text#κατὰ τὸ φανερὸν ὧδ' ἀναιδῶς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:526.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:526.1.text#οὐκ ἂν ᾠόμην ἐν ἡμῖν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:527.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:527.1.text#οὐδὲ τολμῆσαί ποτ' ἄν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:528.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:528.1.text#ἀλλ' ἅπαν γένοιτ' ἂν ἤδη·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:529.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:529.1.text#τὴν παροιμίαν δ' ἐπαινῶ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:529a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:529a.1.text#τὴν παλαιάν· ὑπὸ λίθῳ γὰρ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:530.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:530.1.text#παντί νου χρὴ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:530a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:530a.1.text#μὴ δάκῃ ῥητωρ ἀθρεῖν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:531.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:531.1.text#ἀλλ' οὐ γάρ ἐστι τῶν ἀναισχύτων φύσει γυναικῶν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:532.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:532.1.text#οὐδὲν κάκιον εἰς ἄπαντα πλὴν ἄρ' εἰ γυναῖκες.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:533.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:533.1.text#οὔ τοι μὰ τὴν Ἄγλαυρον ὦ γυναῖκες εὖ φρονεῖτε,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:534.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:534.1.text#ἀλλ' ἢ πεφάρμαχθ' ἢ κακόν τι μέγα πεπόνθατ' ἄλλο,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:535.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:535.1.text#ταύτην ἐῶσαι τὴν φθόρον τοιαῦτα περιυβρίζειν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:536.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:536.1.text#ἡμᾶς ἁπάσας. εἰ μὲν οἶν τις ἔστιν· εἰ δὲ μή, ἡμεῖς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:537.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:537.1.text#αὐταί τε καὶ τὰ δουλάρια τέφραν ποθὲν λαβοῦσαι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:538.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:538.1.text#ταύτης ἀποψιλώσομεν τὸν χοῖρον, ἵνα διδαχθῇ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:539.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:539.1.text#γυνὴ γυναῖκας οὖσα μὴ κακῶς λέγειν τὸ λοιπόν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:540.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:540.1.text#μὴ δῆτα τόν γε χοῖρον ὦ γυναῖκες. εἰ γὰρ οὔσης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:541.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:541.1.text#παρρησίας κἀξὸν λέγειν ὅσαι πάρεσμεν ἀσταί,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:542.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:542.1.text#εἶτ' εἶπον ἁγίγνωσκον ὑπὲρ Εὐριπίδου δίκαια,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:543.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:543.1.text#διὰ τοῦτο τιλλομένην με δεῖ δοῦναι δίκην ὑφ' ὑμῶν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:544.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:544.1.text#οὐ γάρ σε δεῖ δοῦναι δίκην; ἥτις μόνη τέτληκας
urn:cts:greekLit:tlg0019.tlg008.fu.sp:545.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:545.1.text#ὑπὲρ ἀνδρὸς ἀντειπεῖν, ὃς ἡμᾶς πολλὰ κακὰ δέδρακεν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:546.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:546.1.text#ἐπίτηδες εὑρίσκων λόγους, ὅπου γυνὴ πονηρὰ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:547.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:547.1.text#ἐγένετο, Μελανίππας ποιῶν Φαίδρας τε· Πηνελόπην δὲ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:548.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:548.1.text#οὐπώποτ' ἐποίησ', ὅτι γυνὴ σώφρων ἔδοξεν εἶναι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:549.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:549.1.text#ἐγὼ γὰρ οἶδα ταἴτιον. Μίαν γὰρ οὐκ ἂν εἴποις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:550.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:550.1.text#τῶν νῦν γυναικῶν Πηνελόπην, Παίδρας δ' ἁπαξαπάσας.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:551.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:551.1.text#ἀκούετ' ὦ γυναῖκες οἷ' εἴρηκεν ἡ πανοῦργος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:552.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:552.1.text#ἡμᾶς ἁπάσας αὖθις αὖ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:552.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:552.2.text#καὶ νὴ Δί' οὐδέπω γε
urn:cts:greekLit:tlg0019.tlg008.fu.sp:553.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:553.1.text#εἴρηχ' ὅσα ξύνοιδ'· ἐπεὶ βούλεσθε πλείον' εἴπω;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:554.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:554.1.text#ἀλλ' οὐκ ἂν ἔτ' ἔχοις· ὅσα γὰρ ᾔδησθ' ἐξέχεας ἅπαντα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:555.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:555.1.text#μὰ Δί' οὐδέπω τὴν μυριοστὴν μοῖραν ὧν ποιοῦμεν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:556.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:556.1.text#ἐπεὶ τάδ' οὐκ εἴρηχ', ὁρᾷς, ὡς στλεγγίδας λαβοῦσαι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:557.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:557.1.text#ἔπειτα σιφωνίζομεν τὸν οἶνον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:557.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:557.2.text#ἐπιτριβείης.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:558.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:558.1.text#ὥς τ' αὖ τὰ κρέ' ἐξ Ἀπατουρίων ταῖς μαστροποῖς διδοῦσαι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:559.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:559.1.text#ἔπειτα τὴν γαλῆν φαμεν—
urn:cts:greekLit:tlg0019.tlg008.fu.sp:559.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:559.2.text#τάλαιν' ἐγώ· φλυαρεῖς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:560.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:560.1.text#οὐδ' ὡς τὸν ἄνδρα τῷ πελέκει γυνὴ κατεσπόδησεν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:561.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:561.1.text#οὐκ εἶπον· οὐδ' ὡς φαρμάκοις ἑτέρα τὸν ἄνδρ' ἔμηνεν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:562.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:562.1.text#οὐδ' ὡς ὑπὸ τῇ πυέλῳ κατώρυξέν ποτ'—
urn:cts:greekLit:tlg0019.tlg008.fu.sp:562.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:562.2.text#ἐξόλοιο.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:563.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:563.1.text#ἁχαρνικὴ τὸν πατέρα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:563.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:563.2.text#ταυτὶ δῆτ' ἀνέκτ' ἀκούειν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:564.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:564.1.text#οὐδ' ὡς σὺ τῆς δούλης τεκούσης ἄρρεν εἶτα σαυτῇ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:565.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:565.1.text#τοῦθ' ὑπεβάλου, τὸ σὸν δὲ θυγάτριον παρῆκας αὐτῇ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:566.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:566.1.text#οὔ τοι μὰ τὼ θεὼ σὺ καταπροίξει λέγουσα ταυτί,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:567.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:567.1.text#ἀλλ' ἐκποκιῶ σου τὰς ποκάδας.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:567.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:567.2.text#οὐ δὴ μὰ Δία σύ γ' ἅψει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:568.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:568.1.text#καὶ μὴν ἰδού.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:568.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:568.2.text#καὶ μὴν ἰδού.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:568.3.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:568.3.text#λαβὲ θοἰμάτιον Φιλίστη.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:569.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:569.1.text#πρόσθες μόνον, κἀγώ σε νὴ τὴν Ἄρτεμιν—
urn:cts:greekLit:tlg0019.tlg008.fu.sp:569.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:569.2.text#τί δράσεις;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:570.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:570.1.text#τὸν σησαμοῦνθ' ὃν κατέφαγες, τοῦτον χεσεῖν ποιήσω.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:571.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:571.1.text#παύσασθε λοιδορούμεναι· καὶ γὰρ γυνή τις ἡμῖν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:572.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:572.1.text#ἐσπουδακυῖα προστρέχει. πρὶν οὖν ὁμοῦ γενέσθαι,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:573.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:573.1.text#σιγᾶθ', ἵν' αὐτῆς κοσμίως πυθώμεθ' ἅττα λέξει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:574.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:574.1.text#φίλαι γυναῖκες ξυγγενεῖς τοὐμοῦ τρόπου·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:575.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:575.1.text#ὅτι μὲν φίλος εἴμ' ὑμῖν, ἐπίδηλος ταῖς γνάθοις·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:576.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:576.1.text#γυναικομανῶ γὰρ προξενῶ θ' ὑμῶν ἀεί.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:577.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:577.1.text#καὶ νῦν ἀκούσας πρᾶγμα περὶ ὑμῶν μέγα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:578.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:578.1.text#ὀλίγῳ τι πρότερον κατ' ἀγορὰν λαλούμενον,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:579.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:579.1.text#ἥκω φράσων τοῦτ' ἀγγελῶν θ' ὑμῖν, ἵνα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:580.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:580.1.text#σκοπῆτε καὶ τηρῆτε μὴ καὶ προσπέσῃ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:581.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:581.1.text#ὑμῖν ἀφάρκτοις πρᾶγμα δεινὸν καὶ μέγα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:582.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:582.1.text#τί δ' ἔστιν ὦ παῖ; παῖδα γάρ σ' εἰκὸς καλεῖν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:583.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:583.1.text#ἕως ἂν οὕτως τὰς γνάθους ψιλὰς ἔχῃς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:584.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:584.1.text#Εὐριπίδην φάσ' ἄνδρα κηδεστήν τινα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:585.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:585.1.text#αὑτοῦ γέροντα δεῦρ' ἀναπέμψαι τήμερον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:586.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:586.1.text#πρὸς ποῖον ἔργον ἢ τίνος γνώμης χάριν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:587.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:587.1.text#ἵν' ἅττα βουλεύοισθε καὶ μέλλοιτε δρᾶν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:588.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:588.1.text#ἐκεῖνος εἴη τῶν λόγων κατάσκοπος.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:589.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:589.1.text#καὶ πῶς λέληθεν ἐν γυναιξὶν ὢν ἀνήρ;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:590.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:590.1.text#ἀφηῦσεν αὐτὸν κἀπέτιλ' Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:591.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:591.1.text#καὶ τἄλλ' ἅπανθ' ὥσπερ γυναῖκ' ἐσκεύασεν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:592.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:592.1.text#πείθεσθε τούτῳ ταῦτα; τίς δ' οὕτως ἀνὴρ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:593.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:593.1.text#ἠλίθιος ὅστις τιλλόμενος ἠνείχετο;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:594.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:594.1.text#οὐκ οἴομαι 'γωγ' ὦ πολυτιμήτω θεώ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:595.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:595.1.text#ληρεῖς· ἐγὼ γὰρ οὐκ ἂν ἦλθον ἀγγελῶν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:596.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:596.1.text#εἰ μὴ 'πεπύσμην ταῦτα τῶν σάφ' εἰδότων.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:597.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:597.1.text#τὸ πρᾶγμα τουτὶ δεινὸν εἰσαγγέλλεται.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:598.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:598.1.text#ἀλλ' ὦ γυναῖκες οὐκ ἐλινύειν ἐχρῆν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:599.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:599.1.text#ἀλλὰ σκοπεῖν τὸν ἄνδρα καὶ ζητεῖν ὅπου
urn:cts:greekLit:tlg0019.tlg008.fu.sp:600.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:600.1.text#λέληθεν ἡμᾶς κρυπτὸς ἐγκαθήμενος.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:601.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:601.1.text#καὶ σὺ ξυνέξευρ' αὐτόν, ὡς ἂν τὴν χάριν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:602.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:602.1.text#ταύτην τε κἀκείνην ἔχῃς ὦ πρόξενε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:603.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:603.1.text#φέρ' ἴδω· τίς ἡ πρώτη σύ;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:603.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:603.2.text#ποῖ τις τρέψεται;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:604.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:604.1.text#ζητητέαι γάρ ἐστε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:604.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:604.2.text#κακοδαίμων ἐγώ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:605.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:605.1.text#ἔμ' ἥτις εἴμ' ἤρου; Κλεωνύμου γυνή.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:606.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:606.1.text#γιγνώσκεθ' ὑμεῖς ἥτις ἔσθ' ἥδ' ἡ γυνή;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:607.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:607.1.text#γιγνώσκομεν δῆτ'. ἀλλὰ τὰς ἄλλας ἄθρει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:608.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:608.1.text#ἡδὶ δὲ δὴ τίς ἐστιν ἡ τὸ παιδίον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:609.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:609.1.text#ἔχουσα;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:609.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:609.2.text#τίτθη νὴ Δί' ἐμή.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:609.3.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:609.3.text#διοίχομαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:610.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:610.1.text#αὕτη σὺ ποῖ στρέφει; μέν' αὐτοῦ. τί τὸ κακόν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:611.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:611.1.text#ἔασον οὐρῆσαί μ'.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:611.2.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:611.2.text#ἀναίσχυντός τις εἶ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:612.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:612.1.text#σὺ δ' οὖν ποίει τοῦτ'. ἀναμενῶ γὰρ ἐνθάδε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:613.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:613.1.text#ἀνάμενε δῆτα καὶ σκόπει γ' αὐτὴν σφόδρα·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:614.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:614.1.text#μόνην γὰρ αὐτὴν ὦνερ οὐ γιγνώσκομεν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:615.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:615.1.text#πολύν γε χρόνον οὐρεῖς σύ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:615.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:615.2.text#νὴ Δί' ὦ μέλε·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:616.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:616.1.text#στραγγουριῶ γάρ· ἐχθὲς ἔφαγον κάρδαμα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:617.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:617.1.text#τί καρδαμίζεις; οὐ βαδιεῖ δεῦρ' ὡς ἐμέ;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:618.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:618.1.text#τί δῆτά μ' ἕλκεις ἀσθενοῦσαν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:618.2.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:618.2.text#εἰπέ μοι,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:619.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:619.1.text#τίς ἔστ' ἀνήρ σοι;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:619.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:619.2.text#τὸν ἐμὸν ἄνδρα πυνθάνει;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:620.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:620.1.text#τὸν δεῖνα γιγνώσκεις, τὸν ἐκ Κοθωκιδῶν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:621.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:621.1.text#τὸν δεῖνα; ποῖον;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:621.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:621.2.text#ἔσθ' ὁ δεῖν', ὃς καί ποτε
urn:cts:greekLit:tlg0019.tlg008.fu.sp:622.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:622.1.text#τὸν δεῖνα τὸν τοῦ δεῖνα—
urn:cts:greekLit:tlg0019.tlg008.fu.sp:622.2.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:622.2.text#ληρεῖν μοι δοκεῖς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:623.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:623.1.text#ἀνῆλθες ἤδη δεῦρο πρότερον;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:623.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:623.2.text#νὴ Δία
urn:cts:greekLit:tlg0019.tlg008.fu.sp:624.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:624.1.text#ὁσέτη γε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:624.2.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:624.2.text#καὶ τίς σοὐστὶ συσκηνήτρια;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:625.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:625.1.text#ἡ δεῖν' ἔμοιγ'.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:625.2.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:625.2.text#οἴμοι τάλας, οὐδὲν λέγεις.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:626.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:626.1.text#ἄπελθ'. ἐγὼ γὰρ βασανιῶ ταύτην καλῶς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:627.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:627.1.text#ἐκ τῶν ἱερῶν τῶν πέρυσι· σὺ δ' ἀπόστηθί μοι,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:628.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:628.1.text#ἵνα μὴ 'πακούσῃς ὢν ἀνήρ. σὺ δ' εἰπέ μοι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:629.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:629.1.text#ὅ τι πρῶτον ἡμῖν τῶν ἱερῶν ἐδείκνυτο.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:630.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:630.1.text#φέρ' ἴδω, τί μέντοι πρῶτον ἦν; ἐπίνομεν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:631.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:631.1.text#τί δὲ μετὰ τοῦτο δεύτερον;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:631.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:631.2.text#προὐπίνομεν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:632.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:632.1.text#ταυτὶ μὲν ἤκουσάς τινος· τί δαὶ τρίτον;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:633.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:633.1.text#σκάφιον Ξένυλλ' ᾔτησεν· οὐ γὰρ ἦν ἀμίς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:634.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:634.1.text#οὐδὲν λέγεις. δεῦρ' ἐλθὲ δεῦρ' ὦ Κλείσθενες·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:635.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:635.1.text#ὅδ' ἐστὶν ἁνὴρ ὃν λέγεις.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:635.2.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:635.2.text#τί οὖν ποιῶ;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:636.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:636.1.text#ἀπόδυσον αὐτόν· οὐδὲν ὑγιὲς γὰρ λέγει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:637.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:637.1.text#κἄπειτ' ἀποδύσετ' ἐννέα παίδων μητέρα;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:638.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:638.1.text#χάλα ταχέως τὸ στρόφιον ὦναίσχυντε σύ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:639.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:639.1.text#ὡς καὶ στιβαρά τις φαίνεται καὶ καρτερά·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:640.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:640.1.text#καὶ νὴ Δία τιτθούς γ' ὥσπερ ἡμεῖς οὐκ ἔχει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:641.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:641.1.text#στερίφη γάρ εἰμι κοὐκ ἐκύησα πώποτε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:642.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:642.1.text#νῦν· τότε δὲ μήτηρ ἦσθα παίδων ἐννέα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:643.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:643.1.text#ἀνίστασ' ὀρθός. ποῖ τὸ πέος ὠθεῖς κάτω;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:644.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:644.1.text#τοδὶ διέκυψε καὶ μάλ' εὔχρων ὦ τάλαν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:645.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:645.1.text#καὶ ποῦ 'στιν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:645.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:645.2.text#αὖθις ἐς τὸ πρόσθεν οἴχεται.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:646.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:646.1.text#οὐκ ἐνγεταυθί.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:646.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:646.2.text#μἀλλὰ δεῦρ' ἥκει πάλιν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:647.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:647.1.text#ἰσθμόν τιν' ἔχεις ὦνθρωπ'· ἄνω τε καὶ κάτω
urn:cts:greekLit:tlg0019.tlg008.fu.sp:648.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:648.1.text#τὸ πέος διέλκεις πυκνότερον Κορινθίων.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:649.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:649.1.text#ὦ μιαρὸς οὗτος· ταῦτ' ἄρ' ὑπὲρ Εὐριπίδου
urn:cts:greekLit:tlg0019.tlg008.fu.sp:650.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:650.1.text#ἡμῖν ἐλοιδορεῖτο.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:650.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:650.2.text#κακοδαίμων ἐγώ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:651.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:651.1.text#εἰς οἷ' ἐμαυτὸν εἰσεκύλισα πράγματα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:652.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:652.1.text#ἄγε δὴ τί δρῶμεν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:652.2.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:652.2.text#τουτονὶ φυλάττετε
urn:cts:greekLit:tlg0019.tlg008.fu.sp:653.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:653.1.text#καλῶς, ὅπως μὴ διαφυγὼν οἰχήσεται·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:654.1.speaker#Κλεισθένης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:654.1.text#ἐγὼ δὲ ταῦτα τοῖς πρυτάνεσιν ἀγγελῶ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:655.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:655.1.text#ἡμᾶς τοίνυν μετὰ τοῦτ' ἤδη τὰς λαμπάδας ἁψαμένας χρὴ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:656.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:656.1.text#ξυζωσαμένας εὖ κἀνδρείως τῶν θ' ἱματίων ἀποδύσας
urn:cts:greekLit:tlg0019.tlg008.fu.sp:657.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:657.1.text#ζητεῖν, εἴ που κἄλλος τις ἀνὴρ ἀνελήλυθε, καὶ περιθρέξαι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:658.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:658.1.text#τὴν πύκνα πᾶσαν καὶ τὰς σκηνὰς καὶ τὰς διόδους διαθρῆσαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:659.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:659.1.text#εἶα δὴ πρώτιστα μὲν χρὴ κοῦφον ἐξορμᾶν πόδα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:660.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:660.1.text#καὶ διασκοπεῖν σιωπῇ πανταχῇ· μόνον δὲ χρὴ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:661.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:661.1.text#μὴ βραδύνειν, ὡς ὁ καιρός ἐστι μὴ μέλλειν ἔτι,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:662.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:662.1.text#ἀλλὰ τὴν πρώτην τρέχειν χρῆν ὡς τάχιστ' ἤδη κύκλῳ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:663.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:663.1.text#εἶά νυν ἴχνευε καὶ μάτευε ταχὺ πάντ',
urn:cts:greekLit:tlg0019.tlg008.fu.sp:664.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:664.1.text#εἴ τις ἐν τόποις ἑδραῖος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:664a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:664a.1.text#ἄλλος αὖ λέληθεν ὤν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:665.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:665.1.text#πανταχῇ δὲ ῥῖψον ὄμμα,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:666.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:666.1.text#καὶ τὰ τῇδε καὶ τὰ δεῦρο
urn:cts:greekLit:tlg0019.tlg008.fu.sp:667.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:667.1.text#πάντ' ἀνασκόπει καλῶς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:668.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:668.1.text#ἢν γάρ με λάθῃ δράσας ἀνόσια,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:668a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:668a.1.text#δώσει τε δίκην καὶ πρὸς τούτῳ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:669.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:669.1.text#τοῖς ἄλλοις ἀνδράσιν ἔσται
urn:cts:greekLit:tlg0019.tlg008.fu.sp:670.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:670.1.text#παράδειγμ' ὕβρεως ἀδίκων τ' ἔργων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:671.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:671.1.text#ἀθέων τε τρόπων·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:672.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:672.1.text#φήσει δ' εἶναί τε θεοὺς φανερῶς,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:673.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:673.1.text#δείξει τ' ἤδη
urn:cts:greekLit:tlg0019.tlg008.fu.sp:674.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:674.1.text#πᾶσιν ἀνθρώποις σεβίζειν δαίμονας […]
urn:cts:greekLit:tlg0019.tlg008.fu.sp:675.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:675.1.text#†δικαίως τ' ἐφέποντας † ὅσια καὶ νόμιμα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:676.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:676.1.text#μηδομένους ποιεῖν ὅ τι καλῶς ἔχει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:677.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:677.1.text#κἂν μὴ ποιῶσι ταῦτα τοιάδ' ἔσται·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:678.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:678.1.text#αὐτῶν ὅταν ληφθῇ τις ἀνόσιόν τι δρῶν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:680.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:680.1.text#†μανίαισ† φλέγων λύσσῃ παράκοπος,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:681.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:681.1.text#†εἴ τι δρῴη†
urn:cts:greekLit:tlg0019.tlg008.fu.sp:682.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:682.1.text#πᾶσιν ἐμφανὴς ὁρᾶν ἔσται γυναιξὶ καὶ βροτοῖσιν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:683.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:683.1.text#ὅτι τά τε παράνομα τά τ' ἀνόσια παρὼν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:685.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:685.1.text#θεὸς ἀποτίνεται.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:686.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:686.1.text#ἀλλ' ἔοιχ' ἡμῖν ἅπαντά τως διεσκέφθαι καλῶς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:687.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:687.1.text#οὐχ ὁρῶμεν γοῦν ἔτ' ἄλλον οὐδέν' ἐγκαθήμενον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:689.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:689.1.text#ἆ ποῖ σὺ φεύγεις; οὗτος οὗτος οὐ μενεῖς;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:690.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:690.1.text#τάλαιν' ἐγὼ τάλαινα, καὶ τὸ παιδίον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:691.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:691.1.text#ἐξαρπάσας μοι φροῦδος ἀπὸ τοῦ τιτθίου.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:692.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:692.1.text#κέκραχθι· τοῦτο δ' οὐδέποτε σὺ ψωμιεῖς,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:693.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:693.1.text#ἢν μή μ' ἀφῆτ'· ἀλλ' ἐνθάδ' ἐπὶ τῶν μηρίων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:694.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:694.1.text#πληγὲν μαχαίρᾳ τῇδε φοινίας φλέβας
urn:cts:greekLit:tlg0019.tlg008.fu.sp:695.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:695.1.text#καθαιματώσει βωμόν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:695.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:695.2.text#ὦ τάλαιν' ἐγώ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:696.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:696.1.text#γυναῖκες, οὐκ ἀρήξετ'; οὐ πολλὴν βοὴν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:697.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:697.1.text#στήσεσθε καὶ τροπαῖον, ἀλλὰ τοῦ μόνου
urn:cts:greekLit:tlg0019.tlg008.fu.sp:698.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:698.1.text#τέκνου με περιόψεσθ' ἀποστερουμένην;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:699.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:699.1.text#ἔα ἔα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:700.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:700.1.text#ὦ πότνιαι Μοῖραι τί τόδε δέρκομαι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:701.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:701.1.text#νεοχμὸν αὖ τέρας;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:702.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:702.1.text#ὡς ἅπαντ' ἄρ' ἐστὶ τόλμης μεστὰ κἀναισχυντίας.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:703.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:703.1.text#οἷον αὖ δέδρακεν ἔργον, οἷον αὖ φίλαι τόδε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:704.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:704.1.text#οἷον ὑμῶν ἐξαράξω τὴν ἄγαν αὐθαδίαν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:705.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:705.1.text#ταῦτα δῆτ' οὐ δεινὰ πράγματ' ἐστὶ καὶ περαιτέρω;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:706.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:706.1.text#δεινὰ δῆθ', ὅστις γ' ἔχει μου 'ξαρπάσας τὸ παιδίον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:707.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:707.1.text#τί ἂν οὖν εἴποι πρὸς ταῦτά τις, ὅτε
urn:cts:greekLit:tlg0019.tlg008.fu.sp:708.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:708.1.text#τοιαῦτα ποιῶν ὅδ' ἀναισχυντεῖ;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:709.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:709.1.text#κοὔπω μέντοι γε πέπαυμαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:710.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:710.1.text#ἀλλ' οὖν ἥκεις γ' ὅθεν οὐ φαύλως γ'
urn:cts:greekLit:tlg0019.tlg008.fu.sp:711.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:711.1.text#ἀποδρὰς λέξεις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:712.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:712.1.text#οἷον δράσας διέδυς ἔργον,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:713.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:713.1.text#λήψει δὲ κακόν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:714.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:714.1.text#τοῦτο μέντοι μὴ γένοιτο μηδαμῶς, ἀπεύχομαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:715.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:715.1.text#τίς οὖν σοι, τίς ἂν σύμμαχος ἐκ θεῶν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:716.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:716.1.text#ἀθανάτων ἔλθοι ξὺν ἀδίκοις ἔργοις;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:717.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:717.1.text#μάτην λαλεῖτε· τὴν δ' ἐγὼ οὐκ ἀφήσω.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:719.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:719.1.text#ἀλλ' οὐ μὰ τὼ θεὼ τάχ' οὐ χαίρων ἴσως
urn:cts:greekLit:tlg0019.tlg008.fu.sp:720.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:720.1.text#ἐνυβριεῖς λόγους λέξεις τ' ἀνοσίους
urn:cts:greekLit:tlg0019.tlg008.fu.sp:721.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:721.1.text# ἐπ' ἀθέοις ἔργοις·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:722.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:722.1.text# καὶ γὰρ ἀνταμειψόμεσθά σ' ὥσπερ εἰκὸς ἀντὶ τῶνδε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:723.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:723.1.text#τάχα δὲ μεταβαλοῦσ' ἐπὶ κακὸν ἑτερότροπον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:725.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:725.1.text#ἐπέχει τύχη.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:726.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:726.1.text#ἀλλὰ τάσδε μὲν λαβεῖν χρῆν σ' ἐκφέρειν τε τῶν ξύλων,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:727.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:727.1.text#καὶ καταίθειν τὸν πανοῦργον πυρπολεῖν θ' ὅσον τάχος.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:728.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:728.1.text#ἴωμεν ἐπὶ τὰς κληματίδας ὦ Μανία.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:729.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:729.1.text#κἀγώ σ' ἀποδείξω θυμάλωπα τήμερον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:730.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:730.1.text#ὕφαπτε καὶ κάταιθε· σὺ δὲ τὸ Κρητικὸν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:731.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:731.1.text#ἀπόδυθι ταχέως· τοῦ θανάτου δ' ὦ παιδίον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:732.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:732.1.text#μόνην γυναικῶν αἰτιῶ τὴν μητέρα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:733.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:733.1.text#τουτὶ τί ἔστιν; ἀσκὸς ἐγένεθ' ἡ κόρη
urn:cts:greekLit:tlg0019.tlg008.fu.sp:734.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:734.1.text#οἴνου πλέως καὶ ταῦτα Περσικὰς ἔχων.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:735.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:735.1.text#ὦ θερμόταται γυναῖκες, ὦ ποτίσταται
urn:cts:greekLit:tlg0019.tlg008.fu.sp:736.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:736.1.text#κἀκ παντὸς ὑμεῖς μηχανώμεναι πιεῖν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:737.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:737.1.text#ὦ μέγα καπήλοις ἀγαθὸν ἡμῖν δ' αὖ κακόν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:738.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:738.1.text#κακὸν δὲ καὶ τοῖς σκευαρίοις καὶ τῇ κρόκῃ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:739.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:739.1.text#παράβαλλε πολλὰς κληματίδας ὦ Μανία.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:740.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:740.1.text#παράβαλλε δῆτα· σὺ δ' ἀπόκριναί μοι τοδί,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:741.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:741.1.text#τουτὶ τεκεῖν φῄς;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:741.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:741.2.text# καὶ δέκα μῆνας αὔτ' ἐγὼ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:742.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:742.1.text#ἤνεγκον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:742.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:742.2.text#ἤνεγκας σύ;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:742.3.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:742.3.text#νὴ τὴν Ἄρτεμιν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:743.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:743.1.text#πρικότυλον ἢ πῶς; εἰπέ μοι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:743.2.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:743.2.text#τί μ' ἠργάσω;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:744.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:744.1.text#ἀπέδυσας ὦναίσχυντέ μου τὸ παιδίον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:745.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:745.1.text#τυννοῦτον ὄν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:745.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:745.2.text#τυννοῦτο;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:745.3.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:745.3.text#μικρὸν νὴ Δία.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:746.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:746.1.text#πόσ' ἔτη δὲ γέγονε; τρεῖς Χοᾶς ἢ τέτταρας;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:747.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:747.1.text#σχεδὸν τοσοῦτον χὤσον ἐκ Διονυσίων.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:748.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:748.1.text#ἀλλ' ἀπόδος αὐτό.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:748.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:748.2.text#μὰ τὸν Ἀπόλλω τουτονί.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:749.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:749.1.text#ἐμπρήσομεν τοίνυν σε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:749.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:749.2.text#πάνυ γ' ἐμπίμπρατε·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:750.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:750.1.text#αὕτη δ' ἀποσφαγήσεται μάλ' αὐτίκα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:751.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:751.1.text#μὴ δῆθ', ἱκετεύω σ'· ἀλλ' ἔμ' ὅ τι χρῄζεις ποίει
urn:cts:greekLit:tlg0019.tlg008.fu.sp:752.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:752.1.text#ὑπέρ γε τούτου.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:752.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:752.2.text#φιλότεκνός τις εἶ φύσει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:753.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:753.1.text#ἀλλ' οὐδὲν ἧττον ἥδ' ἀποσφαγήσεται
urn:cts:greekLit:tlg0019.tlg008.fu.sp:754.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:754.1.text#οἴμοι τέκνον. δός μοι σφαγεῖον Μανία,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:755.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:755.1.text#ἵν' οὖν τό γ' αἷμα τοῦ τέκνου τοὐμοῦ λάβω.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:756.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:756.1.text#ὕπεχ' αὐτό, χαριοῦμαι γὰρ ἕν γε τοῦτό σοι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:757.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:757.1.text#κακῶς ἀπόλοι', ὡς φθονερὸς εἶ καὶ δυσμενής.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:758.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:758.1.text#τουτὶ τὸ δέρμα τῆς ἱερείας γίγνεται.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:759.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:759.1.text#τί τῆς ἱερείας γίγνεται;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:759.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:759.2.text#τουτί. λαβέ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:760.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:760.1.text#ταλαντάτη Μίκκα τίς ἐξεκόρησέ σε;
<l speaker="Γυνὴ Γ" xml:base="urn:cts:greekLit:tlg0019.tlg008.fu.sp:" n="761.1">
urn:cts:greekLit:tlg0019.tlg008.fu.sp:762.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:762.1.text#ὁ πανοῦργος οὗτος. ἀλλ' ἐπειδήπερ πάρει,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:763.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:763.1.text#φύλαξον αὐτόν, ἵνα λαβοῦσα Κλεισθένη
urn:cts:greekLit:tlg0019.tlg008.fu.sp:764.1.speaker#Γυνὴ Α
urn:cts:greekLit:tlg0019.tlg008.fu.sp:764.1.text#τοῖσιν πρυτάνεσιν ἃ πεποίηχ' οὗτος φράσω.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:765.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:765.1.text#ἄγε δὴ τίς ἔσται μηχανὴ σωτηρίας;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:766.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:766.1.text#τίς πεῖρα, τίς ἐπίνοι'; ὁ μὲν γὰρ αἴτιος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:767.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:767.1.text#κἄμ' ἐσκυλίσας ἐς τοιαυτὶ πράγματα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:768.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:768.1.text#οὐ φαίνεταί πω. φέρε τίν' οὖν ἂν ἄγγελον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:769.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:769.1.text#πέμψαιμ' ἐπ' αὐτόν; οἶδ' ἐγὼ καὶ δὴ πόρον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:770.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:770.1.text#ἐκ τοῦ Παλαμήδους· ὡς ἐκεῖνος, τὰς πλάτας
urn:cts:greekLit:tlg0019.tlg008.fu.sp:771.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:771.1.text#ῥίψω γράφων. ἀλλ' οὐ πάρεισιν αἱ πλάται.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:772.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:772.1.text#πόθεν οὖν γένοιντ' ἄν μοι πλάται πόθεν; πόθεν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:773.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:773.1.text#τί δ' ἂν εἰ ταδὶ τἀγάλματ' ἀντὶ τῶν πλατῶν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:774.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:774.1.text#γράφων διαρρίπτοιμι; βέλτιον πολύ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:775.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:775.1.text#ξύλον γέ τοι καὶ ταῦτα κἀκεῖν' ἦν ξύλον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:776.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:776.1.text#ὦ χεῖρες ἐμαὶ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:777.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:777.1.text#ἐγχειρεῖν χρῆν ἔργῳ πορίμῳ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:778.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:778.1.text#ἄγε δὴ πινάκων ξεστῶν δέλτοι,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:779.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:779.1.text#δέξασθε σμίλης ὁλκοὺς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:780.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:780.1.text#κήρυκας ἐμῶν μόχθων· οἴμοι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:781.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:781.1.text#τουτὶ τὸ ῥῶ μοχθηρόν·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:782.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:782.1.text#χώρει χώρει. ποίαν αὔλακα;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:783.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:783.1.text#βάσκετ' ἐπείγετε πάσας καθ' ὁδοὺς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:784.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:784.1.text#κείνᾳ ταύτᾳ· ταχέως χρή.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:785.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:785.1.text#ἡμεῖς τοίνυν ἡμᾶς αὐτὰς εὖ λέξωμεν παραβᾶσαι,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:786.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:786.1.text#καίτοι πᾶς τις τὸ γυναικεῖον φῦλον κακὰ πόλλ' ἀγορεύει,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:787.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:787.1.text#ὡς πᾶν ἐσμὲν κακὸν ἀνθρώποις κἀξ ἡμῶν ἐστιν ἅπαντα,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:788.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:788.1.text#ἔριδες νείκη στάσις ἀργαλέα λύπη πόλεμος. φέρε δή νυν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:789.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:789.1.text#εἰ κακόν ἐσμεν, τί γαμεῖθ' ἡμᾶς, εἴπερ ἀληθῶς κακόν ἐσμεν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:790.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:790.1.text#κἀπαγορεύετε μήτ' ἐξελθεῖν μήτ' ἐκκύψασαν ἁλῶναι,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:791.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:791.1.text#ἀλλ' οὑτωσὶ πολλῇ σπουδῇ τὸ κακὸν βούλεσθε φυλάττειν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:792.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:792.1.text#κἂν ἐξέλθῃ τὸ γύναιόν ποι, κᾆθ' εὕρητ' αὐτὸ θύρασιν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:793.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:793.1.text#μανίας μαίνεσθ', οὓς χρῆν σπένδειν καὶ χαίρειν, εἴπερ ἀληθῶς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:794.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:794.1.text#ἔνδοθεν ηὕρετε φροῦδον τὸ κακὸν καὶ μὴ κατελαμβάνετ' ἔνδον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:795.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:795.1.text#κἂν καταδάρθωμεν ἐν ἀλλοτρίων παίζουσαι καὶ κοπιῶσαι,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:796.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:796.1.text#πᾶς τις τὸ κακὸν τοῦτο ζητεῖ περὶ τὰς κλίνας περινοστῶν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:797.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:797.1.text#κἂν ἐκ θυρίδος παρακύπτωμεν, τὸ κακὸν ζητεῖτε θεᾶσθαι·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:798.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:798.1.text#κἂν αἰσχυνθεῖσ' ἀναχωρήσῃ, πολὺ μᾶλλον πᾶς ἐπιθυμεῖ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:799.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:799.1.text#αὖθις τὸ κακὸν παρακύψαν ἰδεῖν. οὕτως ἡμεῖς ἐπιδήλως
urn:cts:greekLit:tlg0019.tlg008.fu.sp:800.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:800.1.text#ὑμῶν ἐσμεν πολὺ βελτίους, βάσανός τε πάρεστιν ἰδέσθαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:801.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:801.1.text#βάσανον δῶμεν πότεροι χείρους. ἡμεῖς μὲν γάρ φαμεν ὑμᾶς,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:802.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:802.1.text#ὑμεῖς δ' ἡμᾶς. σκεψώμεθα δὴ κἀντιτιθῶμεν πρὸς ἕκαστον,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:803.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:803.1.text#παραβάλλουσαι τῆς τε γυναικὸς καὶ τἀνδρὸς τοὔνομ' ἑκάστου.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:804.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:804.1.text#Ναυσιμάχης μέν γ' ἥττων ἐστὶν Χαρμῖνος· δῆλα δὲ τἄργα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:805.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:805.1.text#καὶ μὲν δὴ καὶ Κλεοφῶν χείρων πάντως δήπου Ξαλαβακχοῦς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:806.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:806.1.text#πρὸς Ἀριστομάχην δὲ χρόνου πολλοῦ, πρὸς ἐκείνην τὴν Μαραθῶνι,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:807.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:807.1.text#καὶ Ξτρατονίκην ὑμῶν οὐδεὶς οὐδ' ἐγχειρεῖ πολεμίζειν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:808.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:808.1.text#ἀλλ' Εὐβούλης τῶν πέρυσίν τις βουλευτής ἐστιν ἀμείνων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:809.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:809.1.text#παραδοὺς ἑτέρῳ τὴν βουλείαν; οὐδ' αὐτὸς τοῦτό γε φήσεις.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:810.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:810.1.text#οὕτως ἡμεῖς πολὺ βελτίους τῶν ἀνδρῶν εὐχόμεθ' εἶναι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:811.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:811.1.text#οὐδ' ἂν κλέψασα γυνὴ ζεύγει κατὰ πεντήκοντα τάλαντα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:812.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:812.1.text#ἐς πόλιν ἔλθοι τῶν δημοσίων· ἀλλ' ἢν τὰ μέγισθ' ὑφέληται
urn:cts:greekLit:tlg0019.tlg008.fu.sp:813.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:813.1.text#φορμὸν πυρῶν τἀνδρὸς κλέψασ', αὐθημερὸν αὔτ' ἀπέδωκεν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:814.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:814.1.text#ἀλλ' ἡμεῖς ἂν πολλοὺς τούτων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:815.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:815.1.text#ἀποδείξαιμεν ταῦτα ποιοῦντας.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:816.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:816.1.text#καὶ πρὸς τούτοις γάστριδας ἡμῶν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:817.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:817.1.text#ὄντας μᾶλλον καὶ λωποδύτας
urn:cts:greekLit:tlg0019.tlg008.fu.sp:818.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:818.1.text#καὶ βωμολόχους κἀνδραποδιστάς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:819.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:819.1.text#καὶ μὲν δήπου καὶ τὰ πατρῷά γε
urn:cts:greekLit:tlg0019.tlg008.fu.sp:820.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:820.1.text#χείρους ἡμῶν εἰσιν σῴζειν·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:821.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:821.1.text#ἡμῖν μὲν γὰρ σῶν ἔτι καὶ νῦν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:822.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:822.1.text#τἀντίον ὁ κανὼν οἱ καλαθίσκοι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:823.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:823.1.text#τὸ σκιάδειον·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:824.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:824.1.text#τοῖς δ' ἡμετέροις ἀνδράσι τούτοις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:825.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:825.1.text#ἀπόλωλεν μὲν πολλοῖς ὁ κανὼν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:826.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:826.1.text#ἐκ τῶν οἴκων αὐτῇ λόγχῃ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:827.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:827.1.text#πολλοῖς δ' ἑτέροις ἀπὸ τῶν ὤμων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:828.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:828.1.text#ἐν ταῖς στρατιαῖς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:829.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:829.1.text#ἔρριπται τὸ σκιάδειον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:830.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:830.1.text#πόλλ' ἂν αἱ γυναῖκες ἡμεῖς ἐν δίκῃ μεμψαίμεθ' ἂν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:831.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:831.1.text#τοῖσιν ἀνδράσιν δικαίως, ἓν δ' ὑπερφυέστατον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:832.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:832.1.text#χρῆν γάρ, ἡμῶν εἰ τέκοι τις ἄνδρα χρηστὸν τῇ πόλει,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:833.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:833.1.text#ταξίαρχον ἢ στρατηγόν, λαμβάνειν τιμήν τινα,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:834.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:834.1.text#προεδρίαν τ' αὐτῇ δίδοσθαι Στηνίοισι καὶ Σκίροις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:835.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:835.1.text#ἔν τε ταῖς ἄλλαις ἑορταῖς αἷσιν ἡμεῖς ἤγομεν·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:836.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:836.1.text#εἰ δὲ δειλὸν καὶ πονηρὸν ἄνδρα τις τέκοι γυνή,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:837.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:837.1.text#ἢ τριήραρχον πονηρὸν ἢ κυβερνήτην κακόν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:838.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:838.1.text#ὑστέραν αὐτὴν καθῆσθαι σκάφιον ἀποκεκαρμένην
urn:cts:greekLit:tlg0019.tlg008.fu.sp:839.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:839.1.text#τῆς τὸν ἀνδρεῖον τεκούσης. τῷ γὰρ εἰκὸς ὦ πόλις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:840.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:840.1.text#τὴν Ὑπερβόλου καθῆσθαι μητέρ' ἠμφιεσμένην
urn:cts:greekLit:tlg0019.tlg008.fu.sp:841.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:841.1.text#λευκὰ καὶ κόμας καθεῖσαν πλησίον τῆς Λαμάχου,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:842.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:842.1.text#καὶ δανείζειν χρήμαθ', ᾗ χρῆν, εἰ δανείσειέν τινι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:843.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:843.1.text#καὶ τόκον πράττοιτο, διδόναι μηδέν' ἀνθρώπων τόκον,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:844.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:844.1.text#ἀλλ' ἀφαιρεῖσθαι βίᾳ τὰ χρήματ' εἰπόντας τοδί,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:845.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:845.1.text# "ἀξία γοῦν εἶ τόκου τεκοῦσα τοιοῦτον τόκον."
urn:cts:greekLit:tlg0019.tlg008.fu.sp:846.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:846.1.text#ἰλλὸς γεγένημαι προσδοκῶν· ὁ δ' οὐδέπω.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:847.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:847.1.text#τί δῆτ' ἂν εἴη τοὐμποδών; οὐκ ἔσθ' ὅπως
urn:cts:greekLit:tlg0019.tlg008.fu.sp:848.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:848.1.text#οὐ τὸν Παλαμήδην ψυχρὸν ὄντ' αἰσχύνεται.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:849.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:849.1.text#τῷ δῆτ' ἂν αὐτὸν προσαγαγοίμην δράματι;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:850.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:850.1.text#ἐγᾦδα· τὴν καινὴν Ἑλένην μιμήσομαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:851.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:851.1.text#πάντως ὑπάρχει μοι γυναικεία στολή.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:852.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:852.1.text#τί αὖ σὺ κυρκανᾷς; τί κοικύλλεις ἔχων;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:853.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:853.1.text#πικρὰν Ἑλένην ὄψει τάχ', εἰ μὴ κοσμίως
urn:cts:greekLit:tlg0019.tlg008.fu.sp:854.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:854.1.text#ἕξεις, ἕως ἂν τῶν πρυτάνεών τις φανῇ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:855.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:855.1.text#Νείλου μὲν αἵδε καλλιπάρθενοι ῥοαί,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:856.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:856.1.text#ὃς ἀντὶ δίας ψακάδος Αἰγύπτου πέδον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:857.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:857.1.text#λευκῆς νοτίζει μελανοσυρμαῖον λεών.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:858.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:858.1.text#πανοῦργος εἶ νὴ τὴν Ἑκάτην τὴν φωσφόρον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:859.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:859.1.text#ἐμοὶ δὲ γῆ μὲν πατρὶς οὐκ ἀνώνυμος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:860.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:860.1.text#Σπάρτη, πατὴρ δὲ Τυνδάρεως.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:860.2.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:860.2.text#σοί γ' ὦλεθρε
urn:cts:greekLit:tlg0019.tlg008.fu.sp:861.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:861.1.text#πατὴρ ἐκεῖνός ἐστι; Φρυνώνδας μὲν οὖν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:862.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:862.1.text#Ἑλένη δ' ἐκλήθην.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:862.2.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:862.2.text#αὖθις αὖ γίγνει γυνή,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:863.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:863.1.text#πρὶν τῆς ἑτέρας δοῦναι γυναικίσεως δίκην;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:864.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:864.1.text#ψυχαὶ δὲ πολλαὶ δι' ἔμ' ἐπὶ Σκαμανδρίαις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:865.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:865.1.text#ῥοαῖσιν ἔθανον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:865.2.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:865.2.text#ὤφελες δὲ καὶ σύ γε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:866.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:866.1.text#κἀγὼ μὲν ἐνθάδ' εἴμ'· ὁ δ' ἄθλιος πόσις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:867.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:867.1.text#οὑμὸς Μενέλαος οὐδέπω προσέρχεται.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:868.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:868.1.text#τί οὖν ἔτι ζῶ;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:868.2.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:868.2.text#τῶν κοράκων πονηρίᾳ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:869.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:869.1.text#ἀλλ' ὥσπερ αἰκάλλει τι καρδίαν ἐμήν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:870.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:870.1.text#μὴ ψεῦσον ὦ Ζεῦ τῆς ἐπιούσης ἐλπίδος.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:871.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:871.1.text#τίς τῶνδ' ἐρυμνῶν δωμάτων ἔχει κράτος,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:872.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:872.1.text#ὅστις ξένους δέξαιτο ποντίῳ σάλῳ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:873.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:873.1.text#κάμνοντας ἐν χειμῶνι καὶ ναυαγίαις;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:874.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:874.1.text#Πρωτέως τάδ' ἐστὶ μέλαθρα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:874.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:874.2.text#ποίου Πρωτέως;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:875.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:875.1.text#ὦ τρισκακόδαιμον, ψεύδεται νὴ τὼ θεώ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:876.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:876.1.text#ἐπεὶ τέθνηκε Πρωτέας ἔτη δέκα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:877.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:877.1.text#ποίαν δὲ χώραν εἰσεκέλσαμεν σκάφει;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:878.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:878.1.text#Αἴγυπτον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:878.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:878.2.text#ὦ δύστηνος οἷ πεπλώκαμεν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:879.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:879.1.text#πείθει τι τούτῳ τῷ κακῶς ἀπολουμένῳ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:880.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:880.1.text#ληροῦντι λῆρον; Θεσμοφορεῖον τουτογί.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:881.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:881.1.text#αὐτὸς δὲ Πρωτεὺς ἔνδον ἔστ' ἢ 'ξώπιος;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:882.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:882.1.text#οὐκ ἔσθ' ὅπως οὐ ναυτιᾷς ἔτ' ὦ ξένε,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:883.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:883.1.text#ὅστις γ' ἀκούσας ὅτι τέθνηκε Πρωτέας
urn:cts:greekLit:tlg0019.tlg008.fu.sp:884.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:884.1.text#ἔπειτ' ἐρωτᾷς "ἔνδον ἔστ' ἢ 'ξώπιος;"
urn:cts:greekLit:tlg0019.tlg008.fu.sp:885.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:885.1.text#αἰαῖ τέθνηκε. ποῦ δ' ἐτυμβεύθη τάφῳ;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:886.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:886.1.text#τόδ' ἐστὶν αὐτοῦ σῆμ', ἐφ' ᾧ καθήμεθα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:887.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:887.1.text#κακῶς τ' ἄρ' ἐξόλοιο κἀξολεῖ γέ τοι,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:888.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:888.1.text#ὅστις γε τολμᾷς σῆμα τὸν βωμὸν καλεῖν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:889.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:889.1.text#τί δὴ σὺ θάσσεις τάσδε τυμβήρεις ἕδρας
urn:cts:greekLit:tlg0019.tlg008.fu.sp:890.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:890.1.text#φάρει καλυπτὸς ὦ ξένη;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:890.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:890.2.text#βιάζομαι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:891.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:891.1.text#γάμοισι Πρωτέως παιδὶ συμμεῖξαι λέχος.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:892.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:892.1.text#τί ὦ κακόδαιμον ἐξαπατᾷς αὖ τὸν ξένον;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:893.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:893.1.text#οὗτος πανουργῶν δεῦρ' ἀνῆλθεν ὦ ξένε
urn:cts:greekLit:tlg0019.tlg008.fu.sp:894.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:894.1.text#ὡς τὰς γυναῖκας ἐπὶ κλοπῇ τοῦ χρυσίου.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:895.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:895.1.text#βάυζε τοὐμὸν σῶμα βάλλουσα ψόγῳ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:896.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:896.1.text#ξένη τίς ἡ γραῦς ἡ κακορροθοῦσά σε;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:897.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:897.1.text#αὕτη Θεονόη Πρωτέως.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:897.2.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:897.2.text#μὰ τὼ θεὼ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:898.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:898.1.text#εἰ μὴ Κρίτυλλά γ' Ἀντιθέου Γαργηττόθεν·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:899.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:899.1.text#σὺ δ' εἶ πανοῦργος.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:899.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:899.2.text#ὁπόσα τοι βούλει λέγε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:900.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:900.1.text#οὐ γὰρ γαμοῦμαι σῷ κασιγνήτῳ ποτὲ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:901.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:901.1.text#προδοῦσα Μενέλεων τὸν ἐμὸν ἐν Τροίᾳ πόσιν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:902.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:902.1.text#γύναι τί εἶπας; στρέψον ἀνταυγεῖς κόρας.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:903.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:903.1.text#αἰσχύνομαί σε τὰς γνάθους ὑβρισμένη.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:904.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:904.1.text#τουτὶ τί ἔστιν; ἀφασία τίς τοί μ' ἔχει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:905.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:905.1.text#ὦ θεοὶ τίν' ὄψιν εἰσορῶ; τίς εἶ γύναι;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:906.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:906.1.text#σὺ δ' εἶ τίς; αὑτὸς γὰρ σὲ κἄμ' ἔχει λόγος.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:907.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:907.1.text#Ἑλληνὶς εἶ τις ἢ 'πιχωρία γυνή;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:908.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:908.1.text#Ἑλληνίς. ἀλλὰ καὶ τὸ σὸν θέλω μαθεῖν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:909.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:909.1.text#Ἑλένῃ σ' ὁμοίαν δὴ μάλιστ' εἶδον γύναι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:910.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:910.1.text#ἐγὼ δὲ Μενελάῳ σ' ὅσα γ' ἐκ τῶν ἰφύων.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:911.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:911.1.text#ἔγνως ἄρ' ὀρθῶς ἄνδρα δυστυχέστατον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:912.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:912.1.text#ὦ χρόνιος ἐλθὼν σῆς δάμαρτος ἐσχάρας
urn:cts:greekLit:tlg0019.tlg008.fu.sp:914.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:914.1.text#λαβέ με λαβέ με πόσι, περίβαλε δὲ χέρας.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:915.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:915.1.text#φέρε σὲ κύσω. ἄπαγέ μ' ἄπαγ' ἄπαγέ με
urn:cts:greekLit:tlg0019.tlg008.fu.sp:916.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:916.1.text#λαβὼν ταχὺ πάνυ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:916.2.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:916.2.text#κλαύσετ' ἄρα νὴ τὼ θεὼ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:917.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:917.1.text#ὅστις σ' ἀπάξει τυπτόμενος τῇ λαμπάδι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:918.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:918.1.text#σὺ τὴν ἐμὴν γυναῖκα κωλύεις ἐμέ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:919.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:919.1.text#τὴν Τυνδάρειον παῖδ', ἐπὶ Σπάρτην ἄγειν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:920.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:920.1.text#οἴμ' ὡς πανοῦργος καὐτὸς εἶναί μοι δοκεῖς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:921.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:921.1.text#καὶ τοῦδέ τις ξύμβουλος. οὐκ ἐτὸς πάλαι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:922.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:922.1.text#ᾐγυπτιάζετ'. ἀλλ' ὅδε μὲν δώσει δίκην.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:923.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:923.1.text#προσέρχεται γὰρ ὁ πρύτανις χὠ τοξότης.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:924.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:924.1.text#τουτὶ πονηρόν· ἀλλ' ὑπαποκινητέον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:925.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:925.1.text#ἐγὼ δ' ὁ κακοδαίμων τί δρῶ;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:925.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:925.2.text#μέν' ἥσυχος.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:926.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:926.1.text#οὐ γὰρ προδώσω σ' οὐδέποτ', ἤνπερ ἐμπνέω,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:927.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:927.1.text#ἢν μὴ προλίπωσ' αἱ μυρίαι με μηχαναί.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:928.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:928.1.text#αὕτη μὲν ἡ μήρινθος οὐδὲν ἔσπασεν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:929.1.speaker#Πρύτανις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:929.1.text#ὅδ' ἔσθ' ὁ πανοῦργος ὃν ἔλεγ' ἡμῖν Κλεισθένης;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:930.1.speaker#Πρύτανις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:930.1.text#οὗτος τί κύπτεις; δῆσον αὐτὸν εἰσάγων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:931.1.speaker#Πρύτανις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:931.1.text#ὦ τοξότ' ἐν τῇ σανίδι, κἄπειτ' ἐνθαδὶ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:932.1.speaker#Πρύτανις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:932.1.text#στήσας φύλαττε καὶ προσιέναι μηδένα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:933.1.speaker#Πρύτανις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:933.1.text#ἔα πρὸς αὐτόν, ἀλλὰ τὴν μάστιγ' ἔχων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:934.1.speaker#Πρύτανις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:934.1.text#παῖ' ἢν προσίῃ τις.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:934.2.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:934.2.text#νὴ Δί' ὡς νῦν δή γ' ἀνὴρ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:935.1.speaker#Γυνὴ Γ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:935.1.text#ὀλίγου μ' ἀφείλετ' αὐτὸν ἱστιορράφος.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:936.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:936.1.text#ὦ πρύτανι πρὸς τῆς δεξιᾶς, ἥνπερ φιλεῖς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:937.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:937.1.text#κοίλην προτείνειν ἀργύριον ἤν τις διδῷ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:938.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:938.1.text#χάρισαι βραχύ τί μοι καίπερ ἀποθανουμένῳ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:939.1.speaker#Πρύτανις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:939.1.text#τί σοι χαρίσωμαι;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:939.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:939.2.text#γυμνὸν ἀποδύσαντά με
urn:cts:greekLit:tlg0019.tlg008.fu.sp:940.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:940.1.text#κέλευε πρὸς τῇ σανίδι δεῖν τὸν τοξότην,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:941.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:941.1.text#ἵνα μὴ 'ν κροκωτοῖς καὶ μίτραις γέρων ἀνὴρ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:942.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:942.1.text#γέλωτα παρέχω τοῖς κόραξιν ἑστιῶν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:943.1.speaker#Πρύτανις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:943.1.text#ἔχοντα ταῦτ' ἔδοξε τῇ βουλῇ σε δεῖν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:944.1.speaker#Πρύτανις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:944.1.text#ἵνα τοῖς παριοῦσι δῆλος ᾖς πανοῦργος ὤν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:945.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:945.1.text#ἰαππαπαιάξ· ὦ κροκώθ' οἷ' εἴργασαι·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:946.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:946.1.text#κοὐκ ἔστ' ἔτ' ἐλπὶς οὐδεμία σωτηρίας.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:947.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:947.1.text#ἄγε νυν ἡμεῖς παίσωμεν ἅπερ νόμος ἐνθάδε ταῖσι γυναιξίν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:948.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:948.1.text#ὅταν ὄργια σεμνὰ θεοῖν ἱεραῖς ὥραις ἀνέχωμεν, ἅπερ καὶ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:949.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:949.1.text#Παύσων σέβεται καὶ νηστεύει,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:950.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:950.1.text#πολλάκις αὐτοῖν ἐκ τῶν ὡρῶν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:951.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:951.1.text#ἐς τὰς ὥρας ξυνεπευχόμενος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:952.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:952.1.text#τοιαῦτα μέλειν θάμ' ἑαυτῷ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:953.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:953.1.text#ὅρμα χώρει·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:954.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:954.1.text#κοῦφα ποσὶν ἄγ' ἐς κύκλον,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:955.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:955.1.text#χειρὶ σύναπτε χεῖρα,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:955a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:955a.1.text#ῥυθμὸν χορείας ὕπαγε πᾶσα·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:956.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:956.1.text#βαῖνε καρπαλίμοιν ποδοῖν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:957.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:957.1.text#ἐπισκοπεῖν δὲ πανταχῇ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:958.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:958.1.text#κυκλοῦσαν ὄμμα χρὴ χοροῦ κατάστασιν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:959.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:959.1.text#ἅμα δὲ καὶ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:960.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:960.1.text#γένος Ὀλυμπίων θεῶν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:961.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:961.1.text#μέλπε καὶ γέραιρε φωνῇ πᾶσα χορομανεῖ τρόπῳ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:962.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:962.1.text#εἰ δέ τις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:963.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:963.1.text#προσδοκᾷ κακῶς ἐρεῖν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:964.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:964.1.text#ἐν ἱερῷ γυναῖκά μ' οὖσαν ἄνδρας, οὐκ ὀρθῶς φρονεῖ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:966.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:966.1.text#ἀλλὰ χρῆν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:967.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:967.1.text#ὥσπερ ἔργον αὖ τι καινὸν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:968.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:968.1.text#πρῶτον εὐκύκλου χορείας εὐφυᾶ στῆσαι βάσιν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:969.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:969.1.text#πρόβαινε ποσὶ τὸν εὐλύραν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:970.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:970.1.text#μέλπουσα καὶ τὴν τοξοφόρον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:971.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:971.1.text#Ἄρτεμιν ἄνασσαν ἁγνήν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:972.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:972.1.text#χαῖρ' ὦ ἑκάεργε,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:973.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:973.1.text#ὄπαζε δὲ νίκην·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:974.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:974.1.text#Ἥραν δὲ τὴν τελείαν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:974a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:974a.1.text#μέλψωμεν ὥσπερ εἰκός,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:975.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:975.1.text#ἣ πᾶσι τοῖς χοροῖσιν ἐμπαίζει τε καὶ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:976.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:976.1.text#κλῇδας γάμου φυλάττει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:977.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:977.1.text#Ἑρμῆν τε νόμιον ἄντομαι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:978.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:978.1.text#καὶ Πᾶνα καὶ Νύμφας φίλας
urn:cts:greekLit:tlg0019.tlg008.fu.sp:979.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:979.1.text#ἐπιγελάσαι προθύμως
urn:cts:greekLit:tlg0019.tlg008.fu.sp:980.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:980.1.text#ταῖς ἡμετέραισι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:981.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:981.1.text#χαρέντα χορείαις.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:982.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:982.1.text#ἔξαιρε δὴ προθύμως
urn:cts:greekLit:tlg0019.tlg008.fu.sp:982a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:982a.1.text#διπλῆν χάριν χορείας.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:983.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:983.1.text#παίσωμεν ὦ γυναῖκες οἷάπερ νόμος,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:984.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:984.1.text#νηστεύωμεν δὲ πάντως.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:985.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:985.1.text#ἀλλ' εἶα πάλλ' ἀνάστρεφ' εὐρύθμῳ ποδί,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:986.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:986.1.text#τόρευε πᾶσαν ᾠδήν·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:986a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:986a.1.text#ἡγοῦ δέ γ' ὧδ' αὐτὸς σὺ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:987.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:987.1.text#κισσοφόρε Βάκχειε
urn:cts:greekLit:tlg0019.tlg008.fu.sp:988.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:988.1.text#δέσποτ'· ἐγὼ δὲ κώμοις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:989.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:989.1.text#σὲ φιλοχόροισι μέλψω.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:990.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:990.1.text#εὔιον ὦ Διόνυσε
urn:cts:greekLit:tlg0019.tlg008.fu.sp:991.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:991.1.text#Βρόμιε καὶ Σεμέλας παῖ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:992.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:992.1.text#χοροῖς τερπόμενος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:993.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:993.1.text#κατ' ὄρεα νυμφᾶν †ἐρατοῖσ† ἐν ὕμνοις,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:993a.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:993a.1.text#εὔιον εὔιον εὐοῖ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:994.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:994.1.text#[…] ἀναχορεύων.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:995.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:995.1.text#ἀμφὶ δὲ σοὶ κτυπεῖται
urn:cts:greekLit:tlg0019.tlg008.fu.sp:996.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:996.1.text#Κιθαιρώνιος ἠχώ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:997.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:997.1.text#μελάμφυλλά τ' ὄρη
urn:cts:greekLit:tlg0019.tlg008.fu.sp:998.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:998.1.text#δάσκια καὶ νάπαι πετρώδεις βρέμονται·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:999.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:999.1.text#κύκλῳ δὲ περὶ σὲ κισσὸς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1000.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1000.1.text#εὐπέταλος ἕλικι θάλλει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1001.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1001.1.text#ἐνταῦτα νῦν οἰμῶξι πρὸς τὴν αἰτρίαν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1002.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1002.1.text#ὦ τοξόθ' ἱκετεύω σε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1002.2.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1002.2.text#μή μ' ἰκετεῦσι σύ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1003.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1003.1.text#χάλασον τὸν ἧλον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1003.2.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1003.2.text#ἀλλὰ ταῦτα δρᾶσ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1004.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1004.1.text#οἴμοι κακοδαίμων, μᾶλλον ἐπικρούεις σύ γε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1005.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1005.1.text#ἔτι μᾶλλο βοῦλις;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1005.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1005.2.text#ἀτταταῖ ἰατταταῖ·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1006.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1006.1.text#κακῶς ἀπόλοιο.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1006.2.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1006.2.text#σῖγα κακοδαίμων γέρον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1007.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1007.1.text#πέρ' ἐγὼ 'ξινίγκι πορμός, ἴνα πυλάξι σοι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1008.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1008.1.text#ταυτὶ τὰ βέλτιστ' ἀπολέλαυκ' Εὐριπίδου.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1009.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1009.1.text#ἔα· θεοί, Ζεῦ σῶτερ, εἰσὶν ἐλπίδες.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1010.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1010.1.text#ἁνὴρ ἔοικεν οὐ προδώσειν, ἀλλά μοι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1011.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1011.1.text#σημεῖον ὑπεδήλωσε Περσεὺς ἐκδραμών,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1012.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1012.1.text#ὅτι δεῖ με γίγνεσθ' Ἀνδρομέδαν· πάντως δέ μοι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1013.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1013.1.text#τὰ δέσμ' ὑπάρχει. δῆλον οὖν τοῦτ' ἔσθ' ὅτι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1015.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1015.1.text#ἥξει με σώσων· οὐ γὰρ ἂν παρέπτετο.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1016.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1016.1.text#φίλαι παρθένοι φίλαι, πῶς ἂν οὖν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1017.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1017.1.text#ἐπέλθοιμι καὶ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1018.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1018.1.text#τὸν Σκύθην λάθοιμι;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1019.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1019.1.text#κλύεις; ὦ πρὸς αἰδοῦς σὲ τὰν ἐν ἄντροις,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1020.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1020.1.text#κατάνευσον, ἔασον ὡς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1021.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1021.1.text#τὴν γυναῖκά μ' ἐλθεῖν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1022.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1022.1.text#ἄνοικτος ὅς μ' ἔδησε τὸν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1023.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1023.1.text#πολυστονώτατον βροτῶν·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1024.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1024.1.text#μόλις δὲ γραῖαν ἀποφυγὼν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1025.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1025.1.text#σαπρὰν ἀπωλόμην ὅμως.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1026.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1026.1.text#ὅδε γὰρ ὁ Σκύθης πάλαι μοι φύλαξ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1027.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1027.1.text#ἐφεστὼς ὀλοὸν ἄφιλον ἐκρέμασεν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1028.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1028.1.text#κόραξι δεῖπνον. ὁρᾷς; οὐ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1030.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1030.1.text#χοροῖσιν οὐδ' ὑφ' ἡλίκων νεανίδων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1031.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1031.1.text#κημὸν ἕστηκ' ἔχουσ',
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1032.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1032.1.text#ἀλλ' ἐν πυκνοῖς δεσμοῖσιν ἐμπεπλεγμένη
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1033.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1033.1.text#κήτει βορὰ Γλαυκέτῃ πρόκειμαι,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1034.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1034.1.text#γαμηλίῳ μὲν οὐ ξὺν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1035.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1035.1.text#παιῶνι δεσμίῳ δὲ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1036.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1036.1.text#γοᾶσθέ μ' ὦ γυναῖκες, ὡς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1037.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1037.1.text#μέλεα μὲν πέπονθα μέλεος,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1038.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1038.1.text#ὦ τάλας ἐγὼ τάλας,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1039.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1039.1.text#ἀπὸ δὲ συγγόνων τάλαν' ἄνομα πάθεα,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1040.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1040.1.text#φῶτά τε λιτομέναν, πολυδάκρυτον Ἀίδα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1041.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1041.1.text#γόον †φεύγουσαν†
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1042.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1042.1.text#αἰαῖ αἰαῖ ἒ ἒ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1043.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1043.1.text#ὃς ἔμ' ἀπεξύρησε πρῶτον,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1044.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1044.1.text#ὃς ἐμὲ κροκόεντ' ἐνέδυσεν·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1045.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1045.1.text#ἐπὶ δὲ τοῖσδ' ἐς τόδ' ἀνέπεμψεν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1046.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1046.1.text#ἱερόν, ἔνθα γυναῖκες.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1047.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1047.1.text#ἰώ μοι μοίρας ἄτεγκτε δαίμων·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1048.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1048.1.text#ὦ κατάρατος ἐγώ·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1049.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1049.1.text#τίς ἐμὸν οὐκ ἐπόψεται
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1049a.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1049a.1.text#πάθος ἀμέγαρτον ἐπὶ κακῶν παρουσίᾳ;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1050.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1050.1.text#εἴθε με πυρφόρος αἰθέρος ἀστὴρ—
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1051.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1051.1.text#τὸν βάρβαρον ἐξολέσειεν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1052.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1052.1.text#οὐ γὰρ ἔτ' ἀθανάταν φλόγα λεύσσειν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1053.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1053.1.text#ἐστὶν ἐμοὶ φίλον, ὡς ἐκρεμάσθην,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1054.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1054.1.text#λαιμότμητ' ἄχη δαιμόνων αἰόλαν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1055.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1055.1.text#νέκυσιν ἐπὶ πορείαν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1056.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1056.1.text#χαῖρ' ὦ φίλη παῖ· τὸν δὲ πατέρα Κηφέα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1057.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1057.1.text#ὅς σ' ἐξέθηκεν ἀπολέσειαν οἱ θεοί.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1058.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1058.1.text#σὺ δ' εἶ τίς ἥτις τοὐμὸν ᾤκτιρας πάθος;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1059.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1059.1.text#Ἠχὼ λόγων ἀντῳδὸς ἐπικοκκάστρια,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1060.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1060.1.text#ἥπερ πέρυσιν ἐν τῷδε ταὐτῷ χωρίῳ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1061.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1061.1.text#Εὐριπίδῃ καὐτὴ ξυνηγωνιζόμην.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1062.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1062.1.text#ἀλλ' ὦ τέκνον σὲ μὲν τὸ σαυτῆς χρὴ ποιεῖν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1063.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1063.1.text#κλάειν ἐλεινῶς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1063.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1063.2.text#σὲ δ' ἐπικλάειν ὕστερον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1064.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1064.1.text#ἐμοὶ μελήσει ταῦτά γ'. ἀλλ' ἄρχου λόγων.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1065.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1065.1.text#ὦ νὺξ ἱερὰ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1066.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1066.1.text#ὡς μακρὸν ἵππευμα διώκεις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1067.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1067.1.text#ἀστεροειδέα νῶτα διφρεύουσ'
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1068.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1068.1.text#αἰθέρος ἱερᾶς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1068a.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1068a.1.text#τοῦ σεμνοτάτου δι' Ὀλύμπου;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1069.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1069.1.text#δι' Ὀλύμπου.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1070.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1070.1.text#τί ποτ' Ἀνδρομέδα περίαλλα κακῶν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1071.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1071.1.text#μέρος ἐξέλαχον—
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1071.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1071.2.text#μέρος ἐξέλαχον—
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1072.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1072.1.text#θανάτου τλήμων;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1072.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1072.2.text#θανάτου τλήμων;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1073.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1073.1.text#ἀπολεῖς μ' ὦ γραῦ στωμυλλομένη.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1074.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1074.1.text#στωμυλλομένη.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1075.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1075.1.text#νὴ Δί' ὀχληρά γ' εἰσήρρηκας
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1076.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1076.1.text#λίαν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1076.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1076.2.text#λίαν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1077.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1077.1.text#ὦγάθ' ἔασόν με μονῳδῆσαι,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1078.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1078.1.text#καὶ χαριεῖ μοι. παῦσαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1078.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1078.2.text#παῦσαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1079.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1079.1.text#βάλλ' ἐς κόρακας.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1079.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1079.2.text#βάλλ' ἐς κόρακας.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1080.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1080.1.text#τί κακόν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1080.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1080.2.text#τί κακόν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1080.3.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1080.3.text#ληρεῖς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1080.4.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1080.4.text#ληρεῖς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1081.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1081.1.text#οἴμωζ'.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1081.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1081.2.text#οἴμωζ'.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1081.3.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1081.3.text#ὀτότυζ'.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1081.4.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1081.4.text#ὀτότυζ'.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1082.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1082.1.text#οὖτος σί λαλῖς;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1082.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1082.2.text#οὖτος σί λαλῖς;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1083.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1083.1.text#πρυτάνεις καλέσω;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1083.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1083.2.text#πρυτάνεις καλέσω;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1085.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1085.1.text#σί κακόν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1085.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1085.2.text#σί κακόν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1086.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1086.1.text#πῶτε τὸ πωνή;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1086.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1086.2.text#πῶτε τὸ πωνή;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1087.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1087.1.text#σὺ λαλῖς;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1087.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1087.2.text#σὺ λαλῖς;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1087.3.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1087.3.text#κλαύσει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1087.4.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1087.4.text#κλαύσει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1088.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1088.1.text#κακκάσκι μοι;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1088.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1088.2.text#κακκάσκι μοι;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1090.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1090.1.text#μὰ Δί' ἀλλὰ γυνὴ πλησίον αὕτη.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1091.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1091.1.text#πλησίον αὕτη.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1092.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1092.1.text#ποῦ στ' η' μιαρά; καὶ δὴ πεύγει.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1093.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1093.1.text#ποῖ ποῖ πεύγεις;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1093.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1093.2.text# ποῖ ποῖ πεύγεις;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1094.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1094.1.text#οὐ καιρήσεις;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1094.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1094.2.text# οὐ καιρήσεις;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1095.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1095.1.text#ἔτι γὰρ γρύζεις;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1095.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1095.2.text#ἔτι γὰρ γρύζεις;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1096.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1096.1.text#λαβὲ τὴ μιαρά.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1096.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1096.2.text#λαβὲ τὴ μιαρά.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1097.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1097.1.text#λάλο καὶ κατάρατο γύναικο.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1098.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1098.1.text#ὦ θεοὶ τίν' ἐς γῆν βαρβάρων ἀφίγμεθα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1099.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1099.1.text#ταχεῖ πεδίλῳ; διὰ μέσου γὰρ αἰθέρος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1100.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1100.1.text#τέμνων κέλευθον πόδα τίθημ' ὑπόπτερον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1101.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1101.1.text#Περσεὺς πρὸς Ἄργος ναυστολῶν τὸ Γοργόνος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1102.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1102.1.text#κάρα κομίζων.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1102.2.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1102.2.text#τί λέγι; τὴ Γόργος πέρι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1103.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1103.1.text#τὸ γραμματέο σὺ τὴ κεπαλή;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1103.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1103.2.text#τὴν Γοργόνος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1104.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1104.1.text#ἔγωγε φημί.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1104.2.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1104.2.text#Γόργο τοι κἀγὼ λέγι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1105.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1105.1.text#ἔα· τίν' ὄχθον τόνδ' ὁρῶ καὶ παρθένον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1106.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1106.1.text#θεαῖς ὁμοίαν ναῦν ὅπως ὡρμισμένην;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1107.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1107.1.text#ὦ ξένε κατοίκτιρόν με τὴν παναθλίαν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1108.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1108.1.text#λῦσόν με δεσμῶν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1108.2.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1108.2.text#οὐκὶ μὶ λαλῆσι σύ;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1109.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1109.1.text#κατάρατο τολμᾷς ἀποτανουμένη λαλᾷς;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1110.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1110.1.text#ὦ παρθέν' οἰκτίρω σὲ κρεμαμένην ὁρῶν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1111.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1111.1.text#οὐ παρτέν' ἐστίν, ἀλλ' ἀμαρτωλὴ γέρων
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1112.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1112.1.text#καὶ κλέπτο καὶ πανοῦργο.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1112.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1112.2.text#ληρεῖς ὦ Σκύθα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1113.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1113.1.text#αὕτη γάρ ἐστιν Ἀνδρομέδα παῖς Κηφέως.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1114.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1114.1.text#σκέψαι τὸ κύστο· μή τι μικτὸν παίνεται;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1115.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1115.1.text#φέρε δεῦρό μοι τὴν χεῖρ', ἵν' ἅψωμαι κόρης·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1116.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1116.1.text#φέρε Σκύθ'· ἀνθρώποισι γὰρ νοσήματα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1117.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1117.1.text#ἅπασίν ἐστιν· ἐμὲ δὲ καὐτὸν τῆς κόρης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1118.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1118.1.text#ταύτης ἔρως εἴληφεν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1118.2.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1118.2.text#οὐ ζηλῶσί σε·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1119.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1119.1.text#ἀτὰρ εἰ τὸ πρωκτὸ δεῦρο περιεστραμμένον,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1120.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1120.1.text#οὐκ ἐπτόνησά σ' αὐτὸ πυγίζεις ἄγων.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1121.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1121.1.text#τί δ' οὐκ ἐᾷς λύσαντά μ' αὐτὴν ὦ Σκύθα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1122.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1122.1.text#πεσεῖν ἐς εὐνὴν καὶ γαμήλιον λέχος;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1123.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1123.1.text#εἰ σπόδρ' ἐπιτυμεῖς τὴ γέροντο πύγισο,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1124.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1124.1.text#τὴ σανίδο τρήσας ἐξόπιστο πρώκτισον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1125.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1125.1.text#μὰ Δί' ἀλλὰ λύσω δεσμά.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1125.2.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1125.2.text#μαστιγῶ σ' ἄρα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1126.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1126.1.text#καὶ μὴν ποιήσω τοῦτο.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1126.2.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1126.2.text#τὸ κεπαλή σ' ἄρα
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1127.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1127.1.text#τὸ ξιπομάκαιραν ἀποκεκόψι τουτοϊ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1128.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1128.1.text#αἰαῖ· τί δράσω; πρὸς τίνας στρεφθῶ λόγους;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1129.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1129.1.text#ἀλλ' οὐ γὰρ ἂν δέξαιτο βάρβαρος φύσις.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1130.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1130.1.text#σκαιοῖσι γάρ τοι καινὰ προσφέρων σοφὰ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1131.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1131.1.text#μάτην ἀναλίσκοις ἄν, ἀλλ' ἄλλην τινὰ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1132.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1132.1.text#τούτῳ πρέπουσαν μηχανὴν προσοιστέον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1133.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1133.1.text#μιαρὸς ἀλώπηξ, οἶον ἐπιτήκιζί μοι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1134.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1134.1.text#μέμνησο Περσεῦ μ' ὡς καταλείπεις ἀθλίαν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1135.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1135.1.text#ἔτι γὰρ σὺ τὴ μάστιγαν ἐπιτυμεῖς λαβεῖν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1136.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1136.1.text#Παλλάδα τὴν φιλόχορον ἐμοὶ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1137.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1137.1.text#δεῦρο καλεῖν νόμος ἐς χορόν,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1138.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1138.1.text#παρθένον ἄζυγα κούρην,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1140.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1140.1.text#ἣ πόλιν ἡμετέραν ἔχει
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1141.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1141.1.text#καὶ κράτος φανερὸν μόνη
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1142.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1142.1.text#κλῃδοῦχός τε καλεῖται.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1143.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1143.1.text#φάνηθ' ὦ τυράννους
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1144.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1144.1.text#στυγοῦσ' ὥσπερ εἰκός.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1145.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1145.1.text#δῆμός τοί σε καλεῖ γυναικῶν·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1146.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1146.1.text#ἔχουσα δέ μοι μόλοις
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1147.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1147.1.text#εἰρήνην φιλέορτον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1148.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1148.1.text#ἥκετ' εὔφρονες ἵλαοι,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1149.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1149.1.text#πότνιαι, ἄλσος ἐς ὑμέτερον,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1150.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1150.1.text#οὗ δὴ ἀνδράσιν οὐ θέμις εἰσορᾶν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1151.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1151.1.text#ὄργια σεμνὰ θεοῖν, ἵνα λαμπάσι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1152.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1152.1.text#φαίνετον ἄμβροτον ὄψιν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1153.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1153.1.text#μόλετον ἔλθετον, ἀντόμεθ' ὦ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1154.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1154.1.text#Θεσμοφόρω πολυποτνία,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1155.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1155.1.text#εἰ καὶ πρότερόν ποτ' ἐπηκόω
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1156.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1156.1.text#ἤλθετον, ἔλθετε νῦν, ἀφίκεσθ' ἱκετεύομεν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1157.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1157.1.text#ἐνθάδε χἠμῖν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1160.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1160.1.text#γυναῖκες εἰ βούλεσθε τὸν λοιπόν χρόνον
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1161.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1161.1.text#σπονδὰς ποιήσασθαι πρὸς ἐμέ, νυνὶ πάρα,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1162.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1162.1.text#ἐφ' ᾧτ' ἀκοῦσαι μηδὲν ὑπ' ἐμοῦ μηδαμὰ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1163.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1163.1.text#κακὸν τὸ λοιπόν. ταῦτ' ἐπικηρυκεύομαι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1164.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1164.1.text#χρείᾳ δὲ ποίᾳ τόνδ' ἐπεσφέρεις λόγον;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1165.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1165.1.text#ὅδ' ἐστὶν οὑν τῇ σανίδι κηδεστὴς ἐμός.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1166.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1166.1.text#ἢν οὖν κομίσωμαι τοῦτον, οὐδὲν μή ποτε
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1167.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1167.1.text#κακῶς ἀκούσητ'· ἢν δὲ μὴ πίθησθέ μοι,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1168.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1168.1.text#ἃ νῦν ὑποικουρεῖτε τοῖσιν ἀνδράσιν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1169.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1169.1.text#ἀπὸ τῆς στρατιᾶς παροῦσιν ὑμῶν διαβαλῶ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1170.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1170.1.text#τὰ μὲν παρ' ἡμῶν ἴσθι σοι πεπεισμένα·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1171.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1171.1.text#τὸν βάρβαρον δὲ τοῦτον αὐτὸς πεῖθε σύ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1172.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1172.1.text#ἐμὸν ἔργον ἐστίν· καὶ σὸν ὦλάφιον ἅ σοι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1173.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1173.1.text#καθ' ὁδὸν ἔφραζον ταῦτα μεμνῆσθαι ποιεῖν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1174.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1174.1.text#πρῶτον μὲν οὖν δίελθε κἀνακάλπασον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1175.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1175.1.text#σὺ δ' ὦ Τερηδὼν ἐπαναφύσα Περσικόν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1176.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1176.1.text#τί τὸ βόμβο τοῦτο; κῶμο τίς ἀνεγεῖρί μοι
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1177.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1177.1.text#ἡ παῖς ἔμελλε προμελετᾶν ὦ τοξότα.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1178.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1178.1.text#ὀρχησομένη γὰρ ἔρχεθ' ὡς ἄνδρας τινάς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1179.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1179.1.text#ὀρκῆσι καὶ μελετῆσι, οὐ κωλύσ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1180.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1180.1.text#ὡς ἐλαπρός, ὥσπερ ψύλλο κατὰ τὸ κῴδιο.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1181.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1181.1.text#φέρε θοἰμάτιον ἄνωθεν ὦ τέκνον τοδί·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1182.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1182.1.text#καθιζομένη δ' ἐπὶ τοῖσι γόνασι τοῦ Σκύθου
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1183.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1183.1.text#τὼ πόδε πρότεινον, ἵν' ὑπολύσω.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1183.2.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1183.2.text#ναῖκι ναὶ
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1184.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1184.1.text#κάτησο κάτησο, ναῖκι ναῖκι τυγάτριον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1185.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1185.1.text#οἴμ' ὠς στέριπο τὸ τιττἴ, ὤσπερ γογγύλη.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1186.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1186.1.text#αὔλει σὺ θᾶττον· ἔτι δέδοικας τὸν Σκύθην;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1187.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1187.1.text#καλό γε τὸ πυγή. κλαῦσί γ' ἂν μὴ 'νδον μένῃς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1187a.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1187a.1.text#ἀνακύπτι καὶ παρακύπτι ἀπεψωλημένος·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1188.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1188.1.text#εἶεν· καλὴ τὸ σκῆμα περὶ τὸ πόστιον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1189.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1189.1.text#καλῶς ἔχει. λαβὲ θοἰμάτιον· ὥρα 'στὶ νῷν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1190.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1190.1.text#ἤδη βαδίζειν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1190.2.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1190.2.text#οὐκὶ πιλῆσι πρῶτά με;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1191.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1191.1.text#πάνυ γε· φίλησον αὐτόν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1191.2.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1191.2.text#ὂ ὂ ὂ παπαπαπαῖ,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1192.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1192.1.text#ὠς γλυκερὸ τὸ γλῶσσ', ὤσπερ Ἀττικὸς μέλις.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1193.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1193.1.text#τί οὐ κατεύδει παρ' ἐμέ;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1193.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1193.2.text#χαῖρε τοξότα,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1194.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1194.1.text#οὐ γὰρ γένοιτ' ἂν τοῦτο.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1194.2.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1194.2.text#ναὶ ναὶ γρᾴδιο.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1195.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1195.1.text#ἐμοὶ κάρισο σὺ τοῦτο.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1195.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1195.2.text#δώσεις οὖν δραχμήν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1196.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1196.1.text#ναὶ ναῖκι δῶσι.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1196.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1196.2.text#τἀργύριον τοίνυν φέρε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1197.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1197.1.text#ἀλλ' οὐκ ἔκὠδέν· ἀλλὰ τὸ συβήνην λαβέ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1198.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1198.1.text#ἔπειτα † κομίζεις αὐτοῖς.†
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1198.2.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1198.2.text#ἀκολούτι τέκνον.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1199.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1199.1.text#σὺ δὲ τοῦτο τήρει τὴ γέροντο, γρᾴδιο.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1200.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1200.1.text#ὄνομα δέ σοι τί ἔστιν;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1200.2.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1200.2.text#Ἀρτεμισία.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1201.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1201.1.text#μεμνῆσι τοίνυν τοὔνομ'· Ἀρταμουξία.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1202.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1202.1.text#Ἑρμῆ δόλιε ταυτὶ μὲν ἔτι καλῶς ποιεῖς.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1203.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1203.1.text#σὺ μὲν οὖν ἀπότρεχε παιδάριον τουτὶ λαβών·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1204.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1204.1.text#ἐγὼ δὲ λύσω τόνδε. σὺ δ' ὅπως ἀνδρικῶς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1205.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1205.1.text#ὅταν λυθῇς τάχιστα θεύξει καὶ τενεῖς
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1206.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1206.1.text#ὡς τὴν γυναῖκα καὶ τὰ παιδἴ οἴκαδε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1207.1.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1207.1.text#ἐμοὶ μελήσει ταῦτά γ' ἢν ἅπαξ λυθῶ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1208.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1208.1.text#λέλυσο. σὸν ἔργον, φεῦγε πρὶν τὸν τοξότην
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1209.1.speaker#Εὐριπίδης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1209.1.text#ἥκοντα καταλαβεῖν.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1209.2.speaker#Μνησίλοχος
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1209.2.text#ἐγὼ δὴ τοῦτο δρῶ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1210.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1210.1.text#ὦ γρᾴδι' ὠς καρίεντό σοι τὸ τυγάτριον,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1211.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1211.1.text#κοὐ δύσκολ' ἀλλὰ πρᾶο. ποῦ τὸ γρᾴδιο;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1212.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1212.1.text#οἴμ' ὠς ἀπόλωλο· ποῦ τὸ γέροντ' ἐντευτενί;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1213.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1213.1.text#ὦ γρᾴδι', ὦ γρᾷ. οὐκ ἐπαινῶ γρᾴδιο.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1213a.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1213a.1.text#Ἀρταμουξία.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1214.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1214.1.text#διέβαλλέ μ' η' γραῦς. ἀπότρεκ' ὠς τάκιστα σύ·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1215.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1215.1.text#ὀρτῶς δὲ συβήνη 'στί· καταβηνῆσι γάρ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1215a.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1215a.1.text#οἴμοι,
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1216.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1216.1.text#τί δρᾶσι; ποῖ τὸ γρᾴδι'; Ἀρταμουξία.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1217.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1217.1.text#τὴν γραῦν ἐρωτᾷς, ἣ 'φερεν τὰς πηκτίδας;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1218.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1218.1.text#ναὶ ναῖκι. εἶδες αὐτό;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1218.2.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1218.2.text#ταύτῃ γ' οἴχεται
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1219.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1219.1.text#αὐτή τ' ἐκείνη καὶ γέρων τις εἵπετο.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1220.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1220.1.text#κροκῶτ' ἔκοντο τὴ γέροντο;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1220.2.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1220.2.text#φήμ' ἐγώ.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1221.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1221.1.text#ἔτ' ἂν καταλάβοις, εἰ διώκοις ταυτῃί.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1222.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1222.1.text#ὦ μιαρὸ γρᾶο· πότερα τρέξι τὴν ὀδό;
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1223.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1223.1.text#Ἀρταμουξία.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1223.2.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1223.2.text#ὀρθὴν ἄνω δίωκε. ποῖ θεῖς; οὐ πάλιν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1224.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1224.1.text#τῃδὶ διώξει; σ' τοὔμπαλιν τρέχεις σύ γε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1225.1.speaker#Τοξότης
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1225.1.text#κακόδαιμον, ἀλλὰ τρέξι. Ἀρταμουξία.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1226.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1226.1.text#τρέχε νυν κατὰ τοὺς κόρακας ἐπουρίσας, τρέχε.
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1227.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1227.1.text#ἀλλὰ πέπαισται μετρίως ἡμῖν·
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1228.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1228.1.text#ὥσθ' ὥρα δή 'στι βαδίζειν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1229.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1229.1.text#οἴκαδ' ἑκάστῃ. τὼ Θεσμοφόρω δ'
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1230.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1230.1.text#ἡμῖν ἀγαθὴν
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1231.1.speaker#Χορός
urn:cts:greekLit:tlg0019.tlg008.fu.sp:1231.1.text#τούτων χάριν ἀνταποδοίτην.
