#!ctsdata
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1.1.text#Ἀσιάτιδος γῆς σχῆμα, Θηβαία πόλι,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:2.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:2.1.text#ὅθεν ποθ' ἕδνων σὺν πολυχρύσῳ χλιδῇ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:3.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:3.1.text#Πριάμου τύραννον ἑστίαν ἀφικόμην
urn:cts:greekLit:tlg0006.tlg006.fu.sp:4.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:4.1.text#δάμαρ δοθεῖσα παιδοποιὸς Ἕκτορι,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:5.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:5.1.text#ζηλωτὸς ἔν γε τῷ πρὶν Ἀνδρομάχη χρόνῳ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:6.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:6.1.text#νῦν δ', εἴ τις ἄλλη, δυστυχεστάτη γυνή·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:7.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:7.1.text#[ ἐμοῦ πέφυκεν ἢ γενήσεταί ποτε ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:8.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:8.1.text#ἥτις πόσιν μὲν Ἕκτορ' ἐξ Ἀχιλλέως
urn:cts:greekLit:tlg0006.tlg006.fu.sp:9.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:9.1.text#θανόντ' ἐσεῖδον, παῖδά θ' ὃν τίκτω πόσει
urn:cts:greekLit:tlg0006.tlg006.fu.sp:10.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:10.1.text#ῥιφθέντα πύργων Ἀστυάνακτ' ἀπ' ὀρθίων,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:11.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:11.1.text#ἐπεὶ τὸ Τροίας εἷλον Ἕλληνες πέδον·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:12.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:12.1.text#αὐτὴ δὲ δούλη τῶν ἐλευθερωτάτων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:13.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:13.1.text#οἴκων νομισθεῖσ' Ἑλλάδ' εἰσαφικόμην
urn:cts:greekLit:tlg0006.tlg006.fu.sp:14.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:14.1.text#τῷ νησιώτῃ Νεοπτολέμῳ δορὸς γέρας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:15.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:15.1.text#δοθεῖσα λείας Τρωικῆς ἐξαίρετον.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:16.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:16.1.text#Φθίας δὲ τῆσδε καὶ πόλεως Φαρσαλίας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:17.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:17.1.text#σύγχορτα ναίω πεδί', ἵν' ἡ θαλασσία
urn:cts:greekLit:tlg0006.tlg006.fu.sp:18.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:18.1.text#Πηλεῖ ξυνῴκει χωρὶς ἀνθρώπων Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:19.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:19.1.text#φεύγουσ' ὅμιλον· Θεσσαλὸς δέ νιν λεὼς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:20.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:20.1.text#Θετίδειον αὐδᾷ θεᾶς χάριν νυμφευμάτων.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:21.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:21.1.text#ἔνθ' οἶκον ἔσχε τόνδε παῖς Ἀχιλλέως,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:22.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:22.1.text#Πηλέα δ' ἀνάσσειν γῆς ἐᾷ Φαρσαλίας,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:23.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:23.1.text#ζῶντος γέροντος σκῆπτρον οὐ θέλων λαβεῖν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:24.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:24.1.text#κἀγὼ δόμοις τοῖσδ' ἄρσεν' ἐντίκτω κόρον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:25.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:25.1.text#πλαθεῖσ' Ἀχιλλέως παιδί, δεσπότῃ γ' ἐμῷ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:26.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:26.1.text#καὶ πρὶν μὲν ἐν κακοῖσι κειμένην ὅμως
urn:cts:greekLit:tlg0006.tlg006.fu.sp:27.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:27.1.text#ἐλπίς μ' ἀεὶ προσῆγε σωθέντος τέκνου
urn:cts:greekLit:tlg0006.tlg006.fu.sp:28.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:28.1.text#ἀλκήν τιν' εὑρεῖν κἀπικούρησιν κακῶν·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:29.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:29.1.text#ἐπεὶ δὲ τὴν Λάκαιναν Ἑρμιόνην γαμεῖ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:30.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:30.1.text#τοὐμὸν παρώσας δεσπότης δοῦλον λέχος,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:31.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:31.1.text#κακοῖς πρὸς αὐτῆς σχετλίοις ἐλαύνομαι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:32.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:32.1.text#λέγει γὰρ ὥς νιν φαρμάκοις κεκρυμμένοις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:33.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:33.1.text#τίθημ' ἄπαιδα καὶ πόσει μισουμένην,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:34.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:34.1.text#αὐτὴ δὲ ναίειν οἶκον ἀντ' αὐτῆς θέλω
urn:cts:greekLit:tlg0006.tlg006.fu.sp:35.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:35.1.text#τόνδ', ἐκβαλοῦσα λέκτρα τἀκείνης βίᾳ·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:36.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:36.1.text#ἁγὼ τὸ πρῶτον οὐχ ἑκοῦσ' ἐδεξάμην,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:37.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:37.1.text#νῦν δ' ἐκλέλοιπα· Ζεὺς τάδ' εἰδείη μέγας,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:38.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:38.1.text#ὡς οὐχ ἑκοῦσα τῷδ' ἐκοινώθην λέχει.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:39.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:39.1.text#ἀλλ' οὔ σφε πείθω, βούλεται δέ με κτανεῖν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:40.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:40.1.text#πατήρ τε θυγατρὶ Μενέλεως συνδρᾷ τάδε.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:41.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:41.1.text#καὶ νῦν κατ' οἴκους ἔστ', ἀπὸ Σπάρτης μολὼν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:42.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:42.1.text#ἐπ' αὐτὸ τοῦτο· δειματουμένη δ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:43.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:43.1.text#δόμων πάροικον Θέτιδος εἰς ἀνάκτορον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:44.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:44.1.text#θάσσω τόδ' ἐλθοῦσ', ἤν με κωλύσῃ θανεῖν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:45.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:45.1.text#Πηλεύς τε γάρ νιν ἔκγονοί τε Πηλέως
urn:cts:greekLit:tlg0006.tlg006.fu.sp:46.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:46.1.text#σέβουσιν, ἑρμήνευμα Νηρῇδος γάμων.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:47.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:47.1.text#ὃς δ' ἔστι παῖς μοι μόνος, ὑπεκπέμπω λάθρᾳ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:48.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:48.1.text#ἄλλους ἐς οἴκους, μὴ θάνῃ φοβουμένη.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:49.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:49.1.text#ὁ γὰρ φυτεύσας αὐτὸν οὔτ' ἐμοὶ πάρα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:50.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:50.1.text#προσωφελῆσαι, παιδί τ' οὐδέν ἐστ', ἀπὼν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:51.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:51.1.text#Δελφῶν κατ' αἶαν, ἔνθα Λοξίᾳ δίκην
urn:cts:greekLit:tlg0006.tlg006.fu.sp:52.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:52.1.text#δίδωσι μανίας, ᾗ ποτ' εἰς Πυθὼ μολὼν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:53.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:53.1.text#ᾔτησε Φοῖβον πατρὸς οὗ κτείνει δίκην,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:54.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:54.1.text#εἴ πως τὰ πρόσθε σφάλματ' ἐξαιτούμενος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:55.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:55.1.text#θεὸν παράσχοιτ' εἰς τὸ λοιπὸν εὐμενῆ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:56.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:56.1.text#δέσποιν'—ἐγώ τοι τοὔνομ' οὐ φεύγω τόδε
urn:cts:greekLit:tlg0006.tlg006.fu.sp:57.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:57.1.text#καλεῖν σ', ἐπείπερ καὶ κατ' οἶκον ἠξίουν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:58.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:58.1.text#τὸν σόν, τὸ Τροίας ἡνίκ' ᾠκοῦμεν πέδον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:59.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:59.1.text#εὔνους δὲ καὶ σοὶ ζῶντί τ' ἦ τῷ σῷ πόσει,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:60.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:60.1.text#καὶ νῦν φέρουσά σοι νέους ἥκω λόγους,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:61.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:61.1.text#φόβῳ μέν, εἴ τις δεσποτῶν αἰσθήσεται,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:62.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:62.1.text#οἴκτῳ δὲ τῷ σῷ· δεινὰ γὰρ βουλεύεται
urn:cts:greekLit:tlg0006.tlg006.fu.sp:63.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:63.1.text#Μενέλαος εἰς σὲ παῖς θ', ἅ σοι φυλακτέα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:64.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:64.1.text#ὦ φιλτάτη σύνδουλε—σύνδουλος γὰρ εἶ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:65.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:65.1.text#τῇ πρόσθ' ἀνάσσῃ τῇδε, νῦν δὲ δυστυχεῖ—
urn:cts:greekLit:tlg0006.tlg006.fu.sp:66.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:66.1.text#τί δρῶσι; ποίας μηχανὰς πλέκουσιν αὖ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:67.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:67.1.text#κτεῖναι θέλοντες τὴν παναθλίαν ἐμέ;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:68.1.speaker#θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:68.1.text#τὸν παῖδά σου μέλλουσιν, ὦ δύστηνε σύ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:69.1.speaker#θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:69.1.text#κτείνειν, ὃν ἔξω δωμάτων ὑπεξέθου.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:70.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:70.1.text#οἴμοι· πέπυσται τὸν ἐμὸν ἔκθετον γόνον;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:71.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:71.1.text#πόθεν ποτ'; ὦ δύστηνος, ὡς ἀπωλόμην.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:72.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:72.1.text#οὐκ οἶδ', ἐκείνων δ' ᾐσθόμην ἐγὼ τάδε·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:73.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:73.1.text#φροῦδος δ' ἐπ' αὐτὸν Μενέλεως δόμων ἄπο.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:74.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:74.1.text#ἀπωλόμην ἄρ'. ὦ τέκνον, κτενοῦσί σε
urn:cts:greekLit:tlg0006.tlg006.fu.sp:75.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:75.1.text#δισσοὶ λαβόντες γῦπες· ὁ δὲ κεκλημένος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:76.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:76.1.text#πατὴρ ἔτ' ἐν Δελφοῖσι τυγχάνει μένων.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:77.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:77.1.text#δοκῶ γὰρ οὐκ ἂν ὧδέ σ' ἂν πράσσειν κακῶς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:78.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:78.1.text#κείνου παρόντος· νῦν δ' ἔρημος εἶ φίλων.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:79.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:79.1.text#οὐδ' ἀμφὶ Πηλέως ἦλθεν, ὡς ἥξοι, φάτις;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:80.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:80.1.text#γέρων ἐκεῖνος ὥστε σ' ὠφελεῖν παρών.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:81.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:81.1.text#καὶ μὴν ἔπεμψ' ἐπ' αὐτὸν οὐχ ἅπαξ μόνον.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:82.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:82.1.text#μῶν οὖν δοκεῖς σου φροντίσαι τιν' ἀγγέλων;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:83.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:83.1.text#πόθεν; θέλεις οὖν ἄγγελος σύ μοι μολεῖν;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:84.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:84.1.text#τί δῆτα φήσω χρόνιος οὖσ' ἐκ δωμάτων;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:85.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:85.1.text#πολλὰς ἂν εὕροις μηχανάς· γυνὴ γὰρ εἶ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:86.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:86.1.text#κίνδυνος· Ἑρμιόνη γὰρ οὐ σμικρὸν φύλαξ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:87.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:87.1.text#ὁρᾷς; ἀπαυδᾷς ἐν κακοῖς φίλοισι σοῖς.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:88.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:88.1.text#οὐ δῆτα· μηδὲν τοῦτ' ὀνειδίσῃς ἐμοί.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:89.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:89.1.text#ἀλλ' εἶμ', ἐπεί τοι κοὐ περίβλεπτος βίος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:90.1.speaker#Θεράπαινα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:90.1.text#δούλης γυναικός, ἤν τι καὶ πάθω κακόν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:91.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:91.1.text#χώρει νυν· ἡμεῖς δ', οἷσπερ ἐγκείμεσθ' ἀεὶ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:92.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:92.1.text#θρήνοισι καὶ γόοισι καὶ δακρύμασι,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:93.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:93.1.text#πρὸς αἰθέρ' ἐκτενοῦμεν· ἐμπέφυκε γὰρ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:94.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:94.1.text#γυναιξὶ τέρψις τῶν παρεστώτων κακῶν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:95.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:95.1.text#ἀνὰ στόμ' ἀεὶ καὶ διὰ γλώσσης ἔχειν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:96.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:96.1.text#πάρεστι δ' οὐχ ἓν ἀλλὰ πολλά μοι στένειν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:97.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:97.1.text#πόλιν πατρῴαν τὸν θανόντα θ' Ἕκτορα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:98.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:98.1.text#στερρόν τε τὸν ἐμὸν δαίμον' ᾧ συνεζύγην
urn:cts:greekLit:tlg0006.tlg006.fu.sp:99.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:99.1.text#δούλειον ἦμαρ εἰσπεσοῦσ' ἀναξίως.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:100.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:100.1.text#χρὴ δ' οὔποτ' εἰπεῖν οὐδέν' ὄλβιον βροτῶν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:101.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:101.1.text#πρὶν ἂν θανόντος τὴν τελευταίαν ἴδῃς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:102.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:102.1.text#ὅπως περάσας ἡμέραν ἥξει κάτω.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:103.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:103.1.text#Ἰλίῳ αἰπεινᾷ Πάρις οὐ γάμον ἀλλά τιν' ἄταν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:104.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:104.1.text#ἠγάγετ' εὐναίαν εἰς θαλάμους Ἑλέναν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:105.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:105.1.text#ἇς ἕνεκ', ὦ Τροία, δορὶ καὶ πυρὶ δηιάλωτον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:106.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:106.1.text#εἷλέ σ' ὁ χιλιόναυς Ἑλλάδος ὠκὺς Ἄρης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:107.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:107.1.text#καὶ τὸν ἐμὸν μελέας πόσιν Ἕκτορα, τὸν περὶ τείχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:108.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:108.1.text#εἵλκυσε διφρεύων παῖς ἁλίας Θέτιδος·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:109.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:109.1.text#αὐτὰ δ' ἐκ θαλάμων ἀγόμαν ἐπὶ θῖνα θαλάσσας,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:110.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:110.1.text#δουλοσύναν στυγερὰν ἀμφιβαλοῦσα κάρᾳ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:111.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:111.1.text#πολλὰ δὲ δάκρυά μοι κατέβα χροός, ἁνίκ' ἔλειπον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:112.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:112.1.text#ἄστυ τε καὶ θαλάμους καὶ πόσιν ἐν κονίαις.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:113.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:113.1.text#ὤμοι ἐγὼ μελέα, τί μ' ἐχρῆν ἔτι φέγγος ὁρᾶσθαι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:114.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:114.1.text#Ἑρμιόνας δούλαν; ἇς ὕπο τειρομένα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:115.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:115.1.text#πρὸς τόδ' ἄγαλμα θεᾶς ἱκέτις περὶ χεῖρε βαλοῦσα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:116.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:116.1.text#τάκομαι ὡς πετρίνα πιδακόεσσα λιβάς.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:117.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:117.1.text#ὦ γύναι, ἃ Θέτιδος δάπεδον καὶ ἀνάκτορα θάσσεις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:118.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:118.1.text#δαρὸν οὐδὲ λείπεις,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:119.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:119.1.text#Φθιὰς ὅμως ἔμολον ποτὶ σὰν Ἀσιήτιδα γένναν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:120.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:120.1.text#εἴ τί σοι δυναίμαν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:121.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:121.1.text#ἄκος τῶν δυσλύτων πόνων τεμεῖν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:122.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:122.1.text#οἳ σὲ καὶ Ἑρμιόναν ἔριδι στυγερᾷ συνέκλῃσαν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:123.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:123.1.text#τλάμον' { ἀμφὶ λέκτρων }
urn:cts:greekLit:tlg0006.tlg006.fu.sp:124.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:124.1.text#{ διδύμων ἐπίκοινον ἐοῦσαν }
urn:cts:greekLit:tlg0006.tlg006.fu.sp:125.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:125.1.text#{ ἀμφὶ } παῖδ' Ἀχιλλέως.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:126.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:126.1.text#γνῶθι τύχαν, λόγισαι τὸ παρὸν κακὸν εἰς ὅπερ ἥκεις.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:127.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:127.1.text#δεσπόταις ἁμιλλᾷ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:128.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:128.1.text#Ἰλιὰς οὖσα κόρα Λακεδαίμονος ἐγγενέτῃσιν;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:129.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:129.1.text#λεῖπε δεξίμηλον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:130.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:130.1.text#δόμον τᾶς ποντίας θεοῦ. τί σοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:131.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:131.1.text#καιρὸς ἀτυζομένᾳ δέμας αἰκέλιον καταλείβειν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:132.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:132.1.text#δεσποτῶν ἀνάγκαις;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:133.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:133.1.text#τὸ κρατοῦν δέ σ' ἔπεισι. τί μόχθον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:134.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:134.1.text#οὐδὲν οὖσα μοχθεῖς;[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:135.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:135.1.text#ἀλλ' ἴθι λεῖπε θεᾶς Νηρηίδος ἀγλαὸν ἕδραν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:136.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:136.1.text#γνῶθι δ' οὖσ' ἐπὶ ξένας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:137.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:137.1.text#δμωὶς ἐπ' ἀλλοτρίας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:138.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:138.1.text#πόλεος, ἔνθ' οὐ φίλων τιν' εἰσορᾷς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:139.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:139.1.text#σῶν, ὦ δυστυχεστάτα,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:140.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:140.1.text#παντάλαινα νύμφα.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:141.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:141.1.text#οἰκτροτάτα γὰρ ἔμοιγ' ἔμολες, γύναι Ἰλιάς, οἴκους
urn:cts:greekLit:tlg0006.tlg006.fu.sp:142.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:142.1.text#δεσποτῶν ἐμῶν· φόβῳ δ'
urn:cts:greekLit:tlg0006.tlg006.fu.sp:143.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:143.1.text#ἡσυχίαν ἄγομεν—
urn:cts:greekLit:tlg0006.tlg006.fu.sp:144.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:144.1.text#τὸ δὲ σὸν οἴκτῳ φέρουσα τυγχάνω—
urn:cts:greekLit:tlg0006.tlg006.fu.sp:145.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:145.1.text#μὴ παῖς τᾶς Διὸς κόρας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:146.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:146.1.text#σοί μ' εὖ φρονοῦσαν εἰδῇ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:146b.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:146b.1.text#[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:146c.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:146c.1.text#[ … ][ … ][ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:147.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:147.1.text#κόσμον μὲν ἀμφὶ κρατὶ χρυσέας χλιδῆς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:148.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:148.1.text#στολμόν τε χρωτὸς τόνδε ποικίλων πέπλων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:149.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:149.1.text#οὐ τῶν Ἀχιλλέως οὐδὲ Πηλέως ἄπο
urn:cts:greekLit:tlg0006.tlg006.fu.sp:150.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:150.1.text#δόμων ἀπαρχὰς δεῦρ' ἔχουσ' ἀφικόμην,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:151.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:151.1.text#ἀλλ' ἐκ Λακαίνης Σπαρτιάτιδος χθονὸς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:152.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:152.1.text#Μενέλαος ἡμῖν ταῦτα δωρεῖται πατὴρ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:153.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:153.1.text#πολλοῖς σὺν ἕδνοις, ὥστ' ἐλευθεροστομεῖν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:154.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:154.1.text#ὑμᾶς μὲν οὖν τοῖσδ' ἀνταμείβομαι λόγοις·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:155.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:155.1.text#σὺ δ' οὖσα δούλη καὶ δορίκτητος γυνὴ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:156.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:156.1.text#δόμους κατασχεῖν ἐκβαλοῦσ' ἡμᾶς θέλεις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:157.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:157.1.text#τούσδε, στυγοῦμαι δ' ἀνδρὶ φαρμάκοισι σοῖς,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:158.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:158.1.text#νηδὺς δ' ἀκύμων διὰ σέ μοι διόλλυται·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:159.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:159.1.text#δεινὴ γὰρ ἠπειρῶτις εἰς τὰ τοιάδε
urn:cts:greekLit:tlg0006.tlg006.fu.sp:160.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:160.1.text#ψυχὴ γυναικῶν· ὧν ἐπισχήσω σ' ἐγώ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:161.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:161.1.text#κοὐδέν σ' ὀνήσει δῶμα Νηρῇδος τόδε,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:162.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:162.1.text#οὐ βωμὸς οὐδὲ ναός, ἀλλὰ κατθανῇ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:163.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:163.1.text#ἢν δ' οὖν βροτῶν τίς σ' ἢ θεῶν σῷσαι θέλῃ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:164.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:164.1.text#δεῖ σ' ἀντὶ τῶν πρὶν ὀλβίων φρονημάτων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:165.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:165.1.text#πτῆξαι ταπεινὴν προσπεσεῖν τ' ἐμὸν γόνυ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:166.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:166.1.text#σαίρειν τε δῶμα τοὐμὸν ἐκ χρυσηλάτων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:167.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:167.1.text#τευχέων χερὶ σπείρουσαν Ἀχελῴου δρόσον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:168.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:168.1.text#γνῶναί θ' ἵν' εἶ γῆς. οὐ γάρ ἐσθ' Ἕκτωρ τάδε,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:169.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:169.1.text#οὐ Πρίαμος οὐδὲ χρυσός, ἀλλ' Ἑλλὰς πόλις.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:170.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:170.1.text#εἰς τοῦτο δ' ἥκεις ἀμαθίας, δύστηνε σύ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:171.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:171.1.text#ἣ παιδὶ πατρός, ὃς σὸν ὤλεσεν πόσιν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:172.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:172.1.text#τολμᾷς ξυνεύδειν καὶ τέκν' αὐθέντου πάρα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:173.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:173.1.text#τίκτειν. τοιοῦτον πᾶν τὸ βάρβαρον γένος·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:174.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:174.1.text#πατήρ τε θυγατρὶ παῖς τε μητρὶ μίγνυται
urn:cts:greekLit:tlg0006.tlg006.fu.sp:175.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:175.1.text#κόρη τ' ἀδελφῷ, διὰ φόνου δ' οἱ φίλτατοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:176.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:176.1.text#χωροῦσι, καὶ τῶνδ' οὐδὲν ἐξείργει νόμος.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:177.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:177.1.text#ἃ μὴ παρ' ἡμᾶς εἴσφερ'· οὐδὲ γὰρ καλὸν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:178.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:178.1.text#δυοῖν γυναικοῖν ἄνδρ' ἕν' ἡνίας ἔχειν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:179.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:179.1.text#ἀλλ' εἰς μίαν βλέποντες εὐναίαν Κύπριν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:180.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:180.1.text#στέργουσιν, ὅστις μὴ κακῶς οἰκεῖν θέλει.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:181.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:181.1.text#ἐπίφθονόν τοι χρῆμα θηλείας φρενὸς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:182.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:182.1.text#καὶ ξυγγάμοισι δυσμενὲς μάλιστ' ἀεί.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:183.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:183.1.text#φεῦ φεῦ·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:184.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:184.1.text#κακόν γε θνητοῖς τὸ νέον ἔν τε τῷ νέῳ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:185.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:185.1.text#τὸ μὴ δίκαιον ὅστις ἀνθρώπων ἔχει.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:186.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:186.1.text#ἐγὼ δὲ ταρβῶ μὴ τὸ δουλεύειν μέ σοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:187.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:187.1.text#λόγων ἀπώσῃ πόλλ' ἔχουσαν ἔνδικα,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:188.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:188.1.text#ἢν δ' αὖ κρατήσω, μὴ 'πὶ τῷδ' ὄφλω βλάβην·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:189.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:189.1.text#οἱ γὰρ πνέοντες μεγάλα τοὺς κρείσσους λόγους
urn:cts:greekLit:tlg0006.tlg006.fu.sp:190.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:190.1.text#πικρῶς φέρουσι τῶν ἐλασσόνων ὕπο·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:191.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:191.1.text#ὅμως δ' ἐμαυτὴν οὐ προδοῦσ' ἁλώσομαι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:192.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:192.1.text#εἴπ', ὦ νεᾶνι, τῷ σ' ἐχεγγύῳ λόγῳ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:193.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:193.1.text#πεισθεῖσ' ἀπωθῶ γνησίων νυμφευμάτων;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:194.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:194.1.text#ὡς ἡ Λάκαινα τῶν Φρυγῶν μείων πόλις,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:195.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:195.1.text#τύχῃ θ' ὑπερθεῖ, κἄμ' ἐλευθέραν ὁρᾷς;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:196.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:196.1.text#ἢ τῷ νέῳ τε καὶ σφριγῶντι σώματι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:197.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:197.1.text#πόλεως τε μεγέθει καὶ φίλοις ἐπηρμένη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:198.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:198.1.text#οἶκον κατασχεῖν τὸν σὸν ἀντὶ σοῦ θέλω;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:199.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:199.1.text#πότερον ἵν' αὐτὴ παῖδας ἀντὶ σοῦ τέκω
urn:cts:greekLit:tlg0006.tlg006.fu.sp:200.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:200.1.text#δούλους ἐμαυτῇ τ' ἀθλίαν ἐφολκίδα;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:201.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:201.1.text#ἢ τοὺς ἐμούς τις παῖδας ἐξανέξεται
urn:cts:greekLit:tlg0006.tlg006.fu.sp:202.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:202.1.text#Φθίας τυράννους ὄντας, ἢν σὺ μὴ τέκῃς;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:203.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:203.1.text#φιλοῦσι γάρ μ' Ἕλληνες Ἕκτορός τ' ἄπο;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:204.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:204.1.text#αὐτή τ' ἀμαυρὰ κοὐ τύραννος ἦ  Φρυγῶν;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:205.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:205.1.text#οὐκ ἐξ ἐμῶν σε φαρμάκων στυγεῖ πόσις,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:206.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:206.1.text#ἀλλ' εἰ ξυνεῖναι μὴ 'πιτηδεία κυρεῖς.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:207.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:207.1.text#φίλτρον δὲ καὶ τόδ'· οὐ τὸ κάλλος, ὦ γύναι,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:208.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:208.1.text#ἀλλ' ἁρεταὶ τέρπουσι τοὺς ξυνευνέτας.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:209.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:209.1.text#σὺ δ' ἤν τι κνισθῇς, ἡ Λάκαινα μὲν πόλις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:210.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:210.1.text#μέγ' ἐστί, τὴν δὲ Σκῦρον οὐδαμοῦ τίθης·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:211.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:211.1.text#πλουτεῖς δ' ἐν οὐ πλουτοῦσι· Μενέλεως δέ σοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:212.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:212.1.text#μείζων Ἀχιλλέως. ταῦτά τοί σ' ἔχθει πόσις.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:213.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:213.1.text#χρὴ γὰρ γυναῖκα, κἂν κακῷ πόσει δοθῇ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:214.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:214.1.text#στέργειν, ἅμιλλάν τ' οὐκ ἔχειν φρονήματος.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:215.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:215.1.text#εἰ δ' ἀμφὶ Θρῄκην χιόνι τὴν κατάρρυτον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:216.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:216.1.text#τύραννον ἔσχες ἄνδρ', ἵν' ἐν μέρει λέχος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:217.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:217.1.text#δίδωσι πολλαῖς εἷς ἀνὴρ κοινούμενος,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:218.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:218.1.text#ἔκτεινας ἂν τάσδ'; εἶτ' ἀπληστίαν λέχους
urn:cts:greekLit:tlg0006.tlg006.fu.sp:219.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:219.1.text#πάσαις γυναιξὶ προστιθεῖσ' ἂν ηὑρέθης.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:220.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:220.1.text#αἰσχρόν γε· καίτοι χείρον' ἀρσένων νόσον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:221.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:221.1.text#ταύτην νοσοῦμεν, ἀλλὰ προύστημεν καλῶς.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:222.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:222.1.text#ὦ φίλταθ' Ἕκτορ, ἀλλ' ἐγὼ τὴν σὴν χάριν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:223.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:223.1.text#σοὶ καὶ ξυνήρων, εἴ τί σε σφάλλοι Κύπρις,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:224.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:224.1.text#καὶ μαστὸν ἤδη πολλάκις νόθοισι σοῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:225.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:225.1.text#ἐπέσχον, ἵνα σοι μηδὲν ἐνδοίην πικρόν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:226.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:226.1.text#καὶ ταῦτα δρῶσα τῇ ἀρετῇ προσηγόμην
urn:cts:greekLit:tlg0006.tlg006.fu.sp:227.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:227.1.text#πόσιν· σὺ δ' οὐδὲ ῥανίδ' ὑπαιθρίας δρόσου
urn:cts:greekLit:tlg0006.tlg006.fu.sp:228.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:228.1.text#τῷ σῷ προσίζειν ἀνδρὶ δειμαίνουσ' ἐᾷς.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:229.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:229.1.text#μὴ τὴν τεκοῦσαν τῇ φιλανδρίᾳ, γύναι,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:230.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:230.1.text#ζήτει παρελθεῖν· τῶν κακῶν γὰρ μητέρων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:231.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:231.1.text#φεύγειν τρόπους χρὴ τέκν', { ὅς }οις ἔνεστι νοῦς.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:232.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:232.1.text#δέσποιν', ὅσον σοι ῥᾳδίως προσίσταται,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:233.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:233.1.text#τοσόνδε πείθου τῇδε συμβῆναι λόγοις.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:234.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:234.1.text#τί σεμνομυθεῖς κεἰς ἀγῶν' ἔρχῃ λόγων,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:235.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:235.1.text#ὡς δὴ σὺ σώφρων, τἀμὰ δ' οὐχὶ σώφρονα;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:236.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:236.1.text#οὔκουν ἐφ' οἷς γε νῦν καθέστηκας λόγοις.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:237.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:237.1.text#ὁ νοῦς ὁ σός μοι μὴ ξυνοικοίη, γύναι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:238.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:238.1.text#νέα πέφυκας καὶ λέγεις αἰσχρῶν πέρι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:239.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:239.1.text#σὺ δ' οὐ λέγεις γε, δρᾷς δέ μ' εἰς ὅσον δύνῃ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:240.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:240.1.text#οὐκ αὖ σιωπῇ Κύπριδος ἀλγήσεις πέρι;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:241.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:241.1.text#τί δ'; οὐ γυναιξὶ ταῦτα πρῶτα πανταχοῦ;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:242.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:242.1.text#[ ναί, ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:242.2.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:242.2.text#καλῶς γε χρωμέναισιν· εἰ δὲ μή, οὐ καλά.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:243.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:243.1.text#οὐ βαρβάρων νόμοισιν οἰκοῦμεν πόλιν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:244.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:244.1.text#κἀκεῖ τά γ' αἰσχρὰ κἀνθάδ' αἰσχύνην ἔχει.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:245.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:245.1.text#σοφὴ σοφὴ σύ· κατθανεῖν δ' ὅμως σε δεῖ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:246.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:246.1.text#ὁρᾷς ἄγαλμα Θέτιδος εἰς σ' ἀποβλέπον;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:247.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:247.1.text#μισοῦν γε πατρίδα σὴν Ἀχιλλέως φόνῳ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:248.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:248.1.text#Ἑλένη νιν ὤλεσ', οὐκ ἐγώ, μήτηρ δὲ σή.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:249.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:249.1.text#ἦ καὶ πρόσω γὰρ τῶν ἐμῶν ψαύσεις κακῶν;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:250.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:250.1.text#ἰδοὺ σιωπῶ κἀπιλάζυμαι στόμα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:251.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:251.1.text#ἐκεῖνο λέξον, οὗπερ εἵνεκ' ἐστάλην.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:252.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:252.1.text#λέγω σ' ἐγὼ νοῦν οὐκ ἔχειν ὅσον σε δεῖ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:253.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:253.1.text#λείψεις τόδ' ἁγνὸν τέμενος ἐναλίας θεοῦ;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:254.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:254.1.text#εἰ μὴ θανοῦμαί γ'· εἰ δὲ μή, οὐ λείψω ποτέ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:255.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:255.1.text#ὡς τοῦτ' ἄραρε, κοὐ μενῶ πόσιν μολεῖν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:256.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:256.1.text#ἀλλ' οὐδ' ἐγὼ μὴν πρόσθεν ἐκδώσω μέ σοι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:257.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:257.1.text#πῦρ σοι προσοίσω, κοὐ τὸ σὸν προσκέψομαι—
urn:cts:greekLit:tlg0006.tlg006.fu.sp:258.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:258.1.text#σὺ δ' οὖν κάταιθε· θεοὶ γὰρ εἴσονται τάδε.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:259.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:259.1.text#καὶ χρωτὶ δεινῶν τραυμάτων ἀλγηδόνας.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:260.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:260.1.text#σφάζ', αἱμάτου θεᾶς βωμόν, ἣ μέτεισί σε.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:261.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:261.1.text#ὦ βάρβαρον σὺ θρέμμα καὶ σκληρὸν θράσος,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:262.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:262.1.text#ἐγκαρτερεῖς δὴ θάνατον; ἀλλ' ἐγώ σ' ἕδρας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:263.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:263.1.text#ἐκ τῆσδ' ἑκοῦσαν ἐξαναστήσω τάχα·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:264.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:264.1.text#τοιόνδ' ἔχω σου δέλεαρ. ἀλλὰ γὰρ λόγους
urn:cts:greekLit:tlg0006.tlg006.fu.sp:265.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:265.1.text#κρύψω, τὸ δ' ἔργον αὐτὸ σημανεῖ τάχα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:266.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:266.1.text#κάθησ' ἑδραία· καὶ γὰρ εἰ πέριξ σ' ἔχοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:267.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:267.1.text#τηκτὸς μόλυβδος, ἐξαναστήσω σ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:268.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:268.1.text#πρὶν ᾧ πέποιθας παῖδ' Ἀχιλλέως μολεῖν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:269.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:269.1.text#πέποιθα. δεινὸν δ' ἑρπετῶν μὲν ἀγρίων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:270.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:270.1.text#ἄκη βροτοῖσι θεῶν καταστῆσαί τινα·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:271.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:271.1.text#ὃ δ' ἔστ' ἐχίδνης καὶ πυρὸς περαιτέρω,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:272.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:272.1.text#οὐδεὶς γυναικὸς φάρμακ' ἐξηύρηκέ πω
urn:cts:greekLit:tlg0006.tlg006.fu.sp:273.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:273.1.text#κακῆς· τοσοῦτόν ἐσμεν ἀνθρώποις κακόν.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:274.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:274.1.text#Ἦ μεγάλων ἀχέων ἄρ' ὑπῆρξεν, ὅτ' Ἰδαίαν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:275.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:275.1.text#ἐς νάπαν ἦλθ' ὁ Μαίας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:276.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:276.1.text#τε καὶ Διὸς τόκος,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:277.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:277.1.text#τρίπωλον ἅρμα δαιμόνων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:278.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:278.1.text#ἄγων τὸ καλλιζυγές,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:279.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:279.1.text#ἔριδι στυγερᾷ κεκορυθμένον εὐμορφίας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:280.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:280.1.text#σταθμοὺς ἐπὶ βούτα,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:281.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:281.1.text#βοτῆρά τ' ἀμφὶ μονότροπον νεανίαν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:282.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:282.1.text#ἔρημόν θ'
urn:cts:greekLit:tlg0006.tlg006.fu.sp:283.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:283.1.text#ἑστιοῦχον αὐλάν.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:284.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:284.1.text#ταὶ δ' ἐπεὶ ὑλόκομον νάπος ἤλυθον οὐρειᾶν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:285.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:285.1.text#πιδάκων νίψαν αἰγλᾶντα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:286.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:286.1.text#σώματα ῥοαῖς,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:287.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:287.1.text#ἔβαν δὲ Πριαμίδαν ὑπερβολαῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:288.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:288.1.text#λόγων δυσφρόνων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:289.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:289.1.text#παραβαλλόμεναι, δολίοις { δ' } ἕλε Κύπρις λόγοις,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:290.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:290.1.text#τερπνοῖς μὲν ἀκοῦσαι,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:291.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:291.1.text#πικρὰν δὲ σύγχυσιν βίου Φρυγῶν πόλει
urn:cts:greekLit:tlg0006.tlg006.fu.sp:292.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:292.1.text#ταλαίνᾳ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:292.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:292.2.text#περγάμοις τε Τροίας.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:293.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:293.1.text#ἀλλ' εἴθ' ὑπὲρ κεφαλὰν ἔβαλεν κακὸν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:294.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:294.1.text#ἁ τεκοῦσά νιν [ Πάριν ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:294.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:294.2.text#πρὶν Ἰδαῖον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:295.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:295.1.text#κατοικίσαι λέπας·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:296.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:296.1.text#ὅτε νιν παρὰ θεσπεσίῳ δάφνᾳ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:297.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:297.1.text#βόασε Κασάνδρα κτανεῖν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:298.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:298.1.text#μεγάλαν Πριάμου πόλεως λώβαν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:299.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:299.1.text#τίν' οὐκ ἐπῆλθε, ποῖον οὐκ ἐλίσσετο
urn:cts:greekLit:tlg0006.tlg006.fu.sp:299.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:299.2.text#δαμογερόντων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:300.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:300.1.text#βρέφος φονεύειν;[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:301.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:301.1.text#οὔτ' ἂν ἐπ' Ἰλιάσι ζυγὸν ἤλυθε
urn:cts:greekLit:tlg0006.tlg006.fu.sp:302.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:302.1.text#δούλιον, σύ τ' ἂν γύναι,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:303.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:303.1.text#τυράννων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:303.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:303.2.text#ἔσχες ἂν δόμων ἕδρας·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:304.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:304.1.text#παρέλυσε δ' ἂν Ἑλλάδος ἀλγεινοὺς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:305.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:305.1.text#{ μόχθους οὓς ἀμφὶ Τροίαν }
urn:cts:greekLit:tlg0006.tlg006.fu.sp:306.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:306.1.text#δεκέτεις ἀλάληντο νέοι λόγχαις.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:307.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:307.1.text#λέχη τ' ἔρημ' ἂν οὔποτ' ἐξελείπετο,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:308.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:308.1.text#καὶ τεκέων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:308.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:308.2.text#ὀρφανοὶ γέροντες.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:309.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:309.1.text#ἥκω λαβὼν σὸν παῖδ', ὃν εἰς ἄλλους δόμους
urn:cts:greekLit:tlg0006.tlg006.fu.sp:310.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:310.1.text#λάθρᾳ θυγατρὸς τῆς ἐμῆς ὑπεξέθου.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:311.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:311.1.text#σὲ μὲν γὰρ ηὔχεις θεᾶς βρέτας σῴσειν τόδε,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:312.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:312.1.text#τοῦτον δὲ τοὺς κρύψαντας· ἀλλ' ἐφηυρέθης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:313.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:313.1.text#ἧσσον φρονοῦσα τοῦδε Μενέλεω, γύναι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:314.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:314.1.text#κεἰ μὴ τόδ' ἐκλιποῦσ' ἐρημώσεις πέδον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:315.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:315.1.text#ὅδ' ἀντὶ τοῦ σοῦ σώματος σφαγήσεται.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:316.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:316.1.text#ταῦτ' οὖν λογίζου, πότερα κατθανεῖν θέλεις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:317.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:317.1.text#ἢ τόνδ' ὀλέσθαι σῆς ἁμαρτίας ὕπερ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:318.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:318.1.text#ἣν εἰς ἔμ' εἴς τε παῖδ' ἐμὴν ἁμαρτάνεις.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:319.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:319.1.text#ὦ δόξα δόξα, μυρίοισι δὴ βροτῶν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:320.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:320.1.text#οὐδὲν γεγῶσι βίοτον ὤγκωσας μέγαν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:321.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:321.1.text#εὔκλεια δ' οἷς μὲν ἔστ' ἀληθείας ὕπο,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:322.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:322.1.text#εὐδαιμονίζω· τοὺς δ' ὑπὸ ψευδῶν, ἔχειν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:323.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:323.1.text#οὐκ ἀξιώσω, πλὴν τύχῃ φρονεῖν δοκεῖν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:324.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:324.1.text#σὺ δὴ στρατηγῶν λογάσιν Ἑλλήνων ποτὲ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:325.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:325.1.text#Τροίαν ἀφείλου Πρίαμον, ὧδε φαῦλος ὤν;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:326.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:326.1.text#ὅστις θυγατρὸς ἀντίπαιδος ἐκ λόγων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:327.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:327.1.text#τοσόνδ' ἔπνευσας, καὶ γυναικὶ δυστυχεῖ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:328.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:328.1.text#δούλῃ κατέστης εἰς ἀγῶν'; οὐκ ἀξιῶ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:329.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:329.1.text#οὔτ' οὖν σὲ Τροίας οὔτε σοῦ Τροίαν ἔτι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:330.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:330.1.text#[ ἔξωθέν εἰσιν οἱ δοκοῦντες εὖ φρονεῖν ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:331.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:331.1.text#[ λαμπροί, τὰ δ' ἔνδον πᾶσιν ἀνθρώποις ἴσοι, ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:332.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:332.1.text#[ πλὴν εἴ τι πλούτῳ· τοῦτο δ' ἰσχύει μέγα. ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:333.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:333.1.text#Μενέλαε, φέρε δὴ διαπεράνωμεν λόγους·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:334.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:334.1.text#τέθνηκα τῇ σῇ θυγατρὶ καί μ' ἀπώλεσε·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:335.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:335.1.text#μιαιφόνον μὲν οὐκέτ' ἂν φύγοι μύσος.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:336.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:336.1.text#ἐν τοῖς δὲ πολλοῖς καὶ σὺ τόνδ' ἀγωνιῇ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:337.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:337.1.text#φόνον· τὸ συνδρῶν γάρ σ' ἀναγκάσει χρέος.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:338.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:338.1.text#ἢν δ' οὖν ἐγὼ μὲν μὴ θανεῖν ὑπεκδράμω,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:339.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:339.1.text#τὸν παῖδά μου κτενεῖτε; κᾆτα πῶς πατὴρ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:340.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:340.1.text#τέκνου θανόντος ῥᾳδίως ἀνέξεται;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:341.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:341.1.text#οὐχ ὧδ' ἄνανδρον αὐτὸν ἡ Τροία καλεῖ·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:342.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:342.1.text#ἀλλ' εἶσιν οἷ χρή—Πηλέως γὰρ ἄξια
urn:cts:greekLit:tlg0006.tlg006.fu.sp:343.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:343.1.text#πατρός τ' Ἀχιλλέως ἔργα δρῶν φανήσεται—
urn:cts:greekLit:tlg0006.tlg006.fu.sp:344.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:344.1.text#ὤσει δὲ σὴν παῖδ' ἐκ δόμων· σὺ δ' ἐκδιδοὺς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:345.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:345.1.text#ἄλλῳ τί λέξεις; πότερον ὡς κακὸν πόσιν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:346.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:346.1.text#φεύγει τὸ ταύτης σῶφρον; ἀλλὰ πεύσεται.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:347.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:347.1.text#γαμεῖ δὲ τίς νιν; ἤ σφ' ἄνανδρον ἐν δόμοις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:348.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:348.1.text#χήραν καθέξεις πολιόν; ὦ τλήμων ἀνήρ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:349.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:349.1.text#κακῶν τοσούτων οὐχ ὁρᾷς ἐπιρροάς;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:350.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:350.1.text#πόσας ἂν εὐνὰς θυγατέρ' ἠδικημένην
urn:cts:greekLit:tlg0006.tlg006.fu.sp:351.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:351.1.text#βούλοι' ἂν εὑρεῖν ἢ παθεῖν ἁγὼ λέγω;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:352.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:352.1.text#οὐ χρὴ 'πὶ μικροῖς μεγάλα πορσύνειν κακὰ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:353.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:353.1.text#οὐδ', εἰ γυναῖκές ἐσμεν ἀτηρὸν κακόν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:354.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:354.1.text#ἄνδρας γυναιξὶν ἐξομοιοῦσθαι φύσιν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:355.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:355.1.text#ἡμεῖς γὰρ εἰ σὴν παῖδα φαρμακεύομεν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:356.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:356.1.text#καὶ νηδὺν ἐξαμβλοῦμεν, ὡς αὐτὴ λέγει,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:357.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:357.1.text#ἑκόντες οὐκ ἄκοντες, οὐδὲ βώμιοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:358.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:358.1.text#πίτνοντες, αὐτοὶ τὴν δίκην ὑφέξομεν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:359.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:359.1.text#ἐν σοῖσι γαμβροῖς, οἷσιν οὐκ ἐλάσσονα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:360.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:360.1.text#βλάβην ὀφείλω προστιθεῖσ' ἀπαιδίαν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:361.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:361.1.text#ἡμεῖς μὲν οὖν τοιοίδε· τῆς δὲ σῆς φρενὸς—
urn:cts:greekLit:tlg0006.tlg006.fu.sp:362.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:362.1.text#ἕν σου δέδοικα· διὰ γυναικείαν ἔριν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:363.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:363.1.text#καὶ τὴν τάλαιναν ὤλεσας Φρυγῶν πόλιν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:364.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:364.1.text#ἄγαν ἔλεξας ὡς γυνὴ πρὸς ἄρσενας,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:365.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:365.1.text#καί σου τὸ σῶφρον ἐξετόξευσεν φρενός.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:366.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:366.1.text#γύναι, τάδ' ἐστὶ σμικρὰ καὶ μοναρχίας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:367.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:367.1.text#οὐκ ἄξι', ὡς φῄς, τῆς ἐμῆς οὐδ' Ἑλλάδος.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:368.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:368.1.text#εὖ δ' ἴσθ', ὅτου τις τυγχάνει χρείαν ἔχων,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:369.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:369.1.text#τοῦτ' ἔσθ' ἑκάστῳ μεῖζον ἢ Τροίαν ἑλεῖν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:370.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:370.1.text#κἀγὼ θυγατρί—μεγάλα γὰρ κρίνω τάδε,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:371.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:371.1.text#λέχους στέρεσθαι—σύμμαχος καθίσταμαι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:372.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:372.1.text#τὰ μὲν γὰρ ἄλλα δεύτερ' ἂν πάσχοι γυνή,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:373.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:373.1.text#ἀνδρὸς δ' ἁμαρτάνουσ' ἁμαρτάνει βίου.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:374.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:374.1.text#δούλων δ' ἐκεῖνον τῶν ἐμῶν ἄρχειν χρεὼν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:375.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:375.1.text#καὶ τῶν ἐκείνου τοὺς ἐμούς, ἡμᾶς τε πρός·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:376.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:376.1.text#φίλων γὰρ οὐδὲν ἴδιον, οἵτινες φίλοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:377.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:377.1.text#ὀρθῶς πεφύκασ', ἀλλὰ κοινὰ χρήματα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:378.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:378.1.text#μένων δὲ τοὺς ἀπόντας, εἰ μὴ θήσομαι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:379.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:379.1.text#τἄμ' ὡς ἄριστα, φαῦλός εἰμι κοὐ σοφός.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:380.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:380.1.text#ἀλλ' ἐξανίστω τῶνδ' ἀνακτόρων θεᾶς·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:381.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:381.1.text#ὡς, ἢν θάνῃς σύ, παῖς ὅδ' ἐκφεύγει μόρον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:382.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:382.1.text#σοῦ δ' οὐ θελούσης κατθανεῖν, τόνδε κτενῶ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:383.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:383.1.text#δυοῖν δ' ἀνάγκη θατέρῳ λιπεῖν βίον.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:384.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:384.1.text#οἴμοι, πικρὰν κλήρωσιν αἵρεσίν τέ μοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:385.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:385.1.text#βίου καθίστης· καὶ λαχοῦσά γ' ἀθλία
urn:cts:greekLit:tlg0006.tlg006.fu.sp:386.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:386.1.text#καὶ μὴ λαχοῦσα δυστυχὴς καθίσταμαι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:387.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:387.1.text#ὦ μεγάλα πράσσων αἰτίας μικρᾶς πέρι,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:388.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:388.1.text#πιθοῦ· τί καίνεις μ'; ἀντὶ τοῦ; ποίαν πόλιν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:389.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:389.1.text#προύδωκα; τίνα σῶν ἔκτανον παίδων ἐγώ;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:390.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:390.1.text#ποῖον δ' ἔπρησα δῶμ'; ἐκοιμήθην βίᾳ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:391.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:391.1.text#σὺν δεσπόταισι· κᾆτ' ἔμ', οὐ κεῖνον κτενεῖς,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:392.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:392.1.text#τὸν αἴτιον τῶνδ', ἀλλὰ τὴν ἀρχὴν ἀφεὶς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:393.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:393.1.text#πρὸς τὴν τελευτὴν ὑστέραν οὖσαν φέρῃ;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:394.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:394.1.text#οἴμοι κακῶν τῶνδ', ὦ τάλαιν' ἐμὴ πατρίς,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:395.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:395.1.text#ὡς δεινὰ πάσχω. τί δέ με καὶ τεκεῖν ἐχρῆν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:396.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:396.1.text#ἄχθος τ' ἐπ' ἄχθει τῷδε προσθέσθαι διπλοῦν;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:397.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:397.1.text#[ ἀτὰρ τί ταῦτα δύρομαι, τὰ δ' ἐν ποσὶν ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:398.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:398.1.text#[ οὐκ ἐξικμάζω καὶ λογίζομαι κακά; ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:399.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:399.1.text#ἥτις σφαγὰς μὲν Ἕκτορος τροχηλάτους
urn:cts:greekLit:tlg0006.tlg006.fu.sp:400.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:400.1.text#κατεῖδον οἰκτρῶς τ' Ἴλιον  πυρούμενον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:401.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:401.1.text#αὐτὴ δὲ δούλη ναῦς ἐπ' Ἀργείων ἔβην
urn:cts:greekLit:tlg0006.tlg006.fu.sp:402.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:402.1.text#κόμης ἐπισπασθεῖσ'· ἐπεὶ δ' ἀφικόμην
urn:cts:greekLit:tlg0006.tlg006.fu.sp:403.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:403.1.text#Φθίαν, φονεῦσιν Ἕκτορος νυμφεύομαι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:404.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:404.1.text#τί δῆτ' ἐμοὶ ζῆν ἡδύ; πρὸς τί χρὴ βλέπειν;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:405.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:405.1.text#πρὸς τὰς παρούσας ἢ παρελθούσας τύχας;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:406.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:406.1.text#εἷς παῖς ὅδ' ἦν μοι λοιπὸς ὀφθαλμὸς βίου·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:407.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:407.1.text#τοῦτον κτενεῖν μέλλουσιν οἷς δοκεῖ τάδε.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:408.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:408.1.text#οὐ δῆτα τοὐμοῦ γ' εἵνεκ' ἀθλίου βίου·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:409.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:409.1.text#ἐν τῷδε μὲν γὰρ ἐλπίς, εἰ σωθήσεται,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:410.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:410.1.text#ἐμοὶ δ' ὄνειδος μὴ θανεῖν ὑπὲρ τέκνου.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:411.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:411.1.text#ἰδοὺ προλείπω βωμὸν ἥδε χειρία
urn:cts:greekLit:tlg0006.tlg006.fu.sp:412.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:412.1.text#σφάζειν φονεύειν, δεῖν, ἀπαρτῆσαι δέρην.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:413.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:413.1.text#ὦ τέκνον, ἡ τεκοῦσά σ', ὡς σὺ μὴ θάνῃς,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:414.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:414.1.text#στείχω πρὸς Ἅιδην· ἢν δ' ὑπεκδράμῃς μόρον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:415.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:415.1.text#μέμνησο μητρός, οἷα τλᾶσ' ἀπωλόμην,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:416.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:416.1.text#καὶ πατρὶ τῷ σῷ διὰ φιλημάτων ἰὼν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:417.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:417.1.text#δάκρυά τε λείβων καὶ περιπτύσσων χέρας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:418.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:418.1.text#λέγ' οἷ' ἔπραξα. πᾶσι δ' ἀνθρώποις ἄρ' ἦν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:419.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:419.1.text#ψυχὴ τέκν'· ὅστις δ' αὔτ' ἄπειρος ὢν ψέγει,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:420.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:420.1.text#ἧσσον μὲν ἀλγεῖ, δυστυχῶν δ' εὐδαιμονεῖ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:421.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:421.1.text#ᾤκτιρ' ἀκούσασ'· οἰκτρὰ γὰρ τὰ δυστυχῆ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:422.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:422.1.text#βροτοῖς ἅπασι, κἂν θυραῖος ὢν κυρῇ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:423.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:423.1.text#εἰς ξύμβασιν δὲ χρῆν σε παῖδα σὴν ἄγειν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:424.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:424.1.text#Μενέλαε, καὶ τήνδ', ὡς ἀπαλλαχθῇ πόνων.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:425.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:425.1.text#λάβεσθέ μοι τῆσδ', ἀμφελίξαντες χέρας,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:426.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:426.1.text#δμῶες· λόγους γὰρ οὐ φίλους ἀκούσεται
urn:cts:greekLit:tlg0006.tlg006.fu.sp:427.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:427.1.text#ἐγώ σ', ἵν' ἁγνὸν βωμὸν ἐκλίποις θεᾶς,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:428.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:428.1.text#προύτεινα παιδὸς θάνατον, ᾧ σ' ὑπήγαγον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:429.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:429.1.text#εἰς χεῖρας ἐλθεῖν τὰς ἐμὰς ἐπὶ σφαγήν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:430.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:430.1.text#καὶ τἀμφὶ σοῦ μὲν ὧδ' ἔχοντ' ἐπίστασο·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:431.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:431.1.text#τὰ δ' ἀμφὶ παιδὸς τοῦδε παῖς ἐμὴ κρινεῖ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:432.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:432.1.text#ἤν τε κτανεῖν νιν ἤν τε μὴ κτανεῖν θέλῃ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:433.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:433.1.text#ἀλλ' ἕρπ' ἐς οἴκους τούσδ', ἵν' εἰς ἐλευθέρους
urn:cts:greekLit:tlg0006.tlg006.fu.sp:434.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:434.1.text#δούλη γεγῶσα μήποθ' ὑβρίζειν μάθῃς.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:435.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:435.1.text#οἴμοι· δόλῳ μ' ὑπῆλθες, ἠπατήμεθα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:436.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:436.1.text#κήρυσσ' ἅπασιν· οὐ γὰρ ἐξαρνούμεθα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:437.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:437.1.text#ἦ ταῦτ' ἐν ὑμῖν τοῖς παρ' Εὐρώτᾳ σοφά;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:438.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:438.1.text#καὶ τοῖς γε Τροίᾳ, τοὺς παθόντας ἀντιδρᾶν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:439.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:439.1.text#τὰ θεῖα δ' οὐ θεῖ' οὐδ' ἔχειν ἡγῇ δίκην;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:440.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:440.1.text#ὅταν τάδ' ᾖ, τότ' οἴσομεν· σὲ δὲ κτενῶ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:441.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:441.1.text#ἦ καὶ νεοσσὸν τόνδ', ὑπὸ πτερῶν σπάσας;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:442.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:442.1.text#οὐ δῆτα· θυγατρὶ δ', ἢν θέλῃ, δώσω κτανεῖν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:443.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:443.1.text#οἴμοι· τί δῆτά σ' οὐ καταστένω, τέκνον;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:444.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:444.1.text#οὔκουν θρασεῖά γ' αὐτὸν ἐλπὶς ἀναμένει.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:445.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:445.1.text#ὦ πᾶσιν ἀνθρώποισιν ἔχθιστοι βροτῶν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:446.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:446.1.text#Σπάρτης ἔνοικοι, δόλια βουλευτήρια,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:447.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:447.1.text#ψευδῶν ἄνακτες, μηχανορράφοι κακῶν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:448.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:448.1.text#ἑλικτὰ κοὐδὲν ὑγιές, ἀλλὰ πᾶν πέριξ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:449.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:449.1.text#φρονοῦντες, ἀδίκως εὐτυχεῖτ' ἀν' Ἑλλάδα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:450.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:450.1.text#τί δ' οὐκ ἐν ὑμῖν ἐστιν; οὐ πλεῖστοι φόνοι;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:451.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:451.1.text#οὐκ αἰσχροκερδεῖς; οὐ λέγοντες ἄλλα μὲν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:452.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:452.1.text#γλώσσῃ, φρονοῦντες δ' ἄλλ' ἐφευρίσκεσθ' ἀεί;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:453.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:453.1.text#ὄλοισθ'. ἐμοὶ μὲν θάνατος οὐχ οὕτω βαρὺς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:454.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:454.1.text#ὡς σοὶ δέδοκται· κεῖνα γάρ μ' ἀπώλεσεν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:455.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:455.1.text#ὅθ' ἡ τάλαινα πόλις ἀνηλώθη Φρυγῶν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:456.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:456.1.text#πόσις θ' ὁ κλεινός, ὅς σε πολλάκις δορὶ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:457.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:457.1.text#ναύτην ἔθηκεν ἀντὶ χερσαίου κακόν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:458.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:458.1.text#νῦν δ' εἰς γυναῖκα γοργὸς ὁπλίτης φανεὶς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:459.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:459.1.text#κτείνεις μ'. ἀπόκτειν'· ὡς ἀθώπευτόν γέ σε
urn:cts:greekLit:tlg0006.tlg006.fu.sp:460.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:460.1.text#γλώσσης ἀφήσω τῆς ἐμῆς καὶ παῖδα σήν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:461.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:461.1.text#ἐπεὶ σὺ μὲν πέφυκας ἐν Σπάρτῃ μέγας,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:462.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:462.1.text#ἡμεῖς δὲ Τροίᾳ γ'. εἰ δ' ἐγὼ πράσσω κακῶς,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:463.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:463.1.text#μηδὲν τόδ' αὔχει· καὶ σὺ γὰρ πράξειας ἄν.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:464.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:464.1.text#οὐδέποτε δίδυμα λέκτρ' ἐπαινέσω βροτῶν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:466.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:466.1.text#οὐδ' ἀμφιμάτορας κόρους,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:467.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:467.1.text#ἔριδας οἴκων δυσμενεῖς τε λύπας.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:468.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:468.1.text#μίαν μοι στεργέτω πόσις γάμοις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:469.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:469.1.text#ἀκοινώνητον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:470.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:470.1.text#ἀνδρὸς εὐνάν.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:471.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:471.1.text#οὐδέ γ' ἐνὶ πόλεσι δίπτυχοι τυραννίδες
urn:cts:greekLit:tlg0006.tlg006.fu.sp:472.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:472.1.text#μιᾶς ἀμείνονες φέρειν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:475.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:475.1.text#ἄχθος ἐπ' ἄχθει καὶ στάσις πολίταις·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:476.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:476.1.text#τεκόντοιν θ' ὕμνον ἐργάταιν δυοῖν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:477.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:477.1.text#ἔριν Mοῦσαι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:478.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:478.1.text#φιλοῦσι κραίνειν.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:479.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:479.1.text#πνοαὶ δ' ὅταν φέρωσι ναυτίλους θοαί,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:480.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:480.1.text#κατὰ πηδαλίων δίδυμαι πραπίδων γνῶμαι,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:481.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:481.1.text#σοφῶν τε πλῆθος ἀθρόον ἀσθενέστερον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:482.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:482.1.text#φαυλοτέρας φρενὸς αὐτοκρατοῦς.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:483.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:483.1.text#ἑνὸς ἁ δύνασις ἀνά τε μέλαθρα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:484.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:484.1.text#κατά τε πόλιας, ὁπόταν εὑρεῖν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:485.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:485.1.text#θέλωσι καιρόν.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:486.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:486.1.text#ἔδειξεν ἡ Λάκαινα τοῦ στρατηλάτα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:487.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:487.1.text#Μενέλα· διὰ γὰρ πυρὸς ἦλθ' ἑτέρῳ λέχεϊ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:489.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:489.1.text#κτείνει δὲ τὴν τάλαιναν Ἰλιάδα κόραν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:490.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:490.1.text#παῖδά τε δύσφρονος ἔριδος ὕπερ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:491.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:491.1.text#ἄθεος ἄνομος ἄχαρις ὁ φόνος·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:492.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:492.1.text#ἔτι σε, πότνια, μετατροπὰ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:493.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:493.1.text#τῶνδ' ἔπεισιν ἔργων.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:494.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:494.1.text#καὶ μὴν ἐσορῶ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:495.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:495.1.text#τόδε σύγκρατον ζεῦγος πρὸ δόμων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:496.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:496.1.text#ψήφῳ θανάτου [ κατακεκριμένον. ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:497.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:497.1.text#δύστηνε γύναι, τλῆμον δὲ σὺ παῖ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:498.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:498.1.text#μητρὸς λεχέων ὃς ὑπερθνῄσκεις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:499.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:499.1.text#οὐδὲν μετέχων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:500.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:500.1.text#οὐδ' αἴτιος ὢν βασιλεῦσιν.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:501.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:501.1.text#ἅδ' ἐγὼ χέρας αἱματηρὰς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:502.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:502.1.text#βρόχοισι κεκλῃμένα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:503.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:503.1.text#πέμπομαι κατὰ γαίας.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:504.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:504.1.text#μᾶτερ μᾶτερ, ἐγὼ δὲ σᾷ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:505.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:505.1.text#πτέρυγι συγκαταβαίνω.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:506.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:506.1.text#θῦμα δάιον, ὦ χθονὸς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:507.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:507.1.text#Φθίας κράντορες.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:507.2.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:507.2.text#ὦ πάτερ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:508.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:508.1.text#μόλε φίλοις ἐπίκουρος.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:510.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:510.1.text#κείσῃ δή, τέκνον ὦ φίλος,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:511.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:511.1.text#μαστοῖς ματέρος ἀμφὶ σᾶς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:512.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:512.1.text#νεκρὸς ὑπὸ χθονί, σὺν νεκρῷ { τ' } [ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:513.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:513.1.text#ὤμοι μοι, τί πάθω; τάλας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:514.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:514.1.text#δῆτ' ἐγὼ σύ τε, μᾶτερ.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:515.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:515.1.text#ἴθ' ὑποχθόνιοι· καὶ γὰρ ἀπ' ἐχθρῶν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:516.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:516.1.text#ἥκετε πύργων· δύο δ' ἐκ δισσαῖν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:517.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:517.1.text#θνῄσκετ' ἀνάγκαιν· σὲ μὲν ἡμετέρα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:518.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:518.1.text#ψῆφος ἀναιρεῖ, παῖδα δ' ἐμὴ παῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:519.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:519.1.text#τόνδ' Ἑρμιόνη· καὶ γὰρ ἀνοία
urn:cts:greekLit:tlg0006.tlg006.fu.sp:520.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:520.1.text#μεγάλη λείπειν ἐχθροὺς ἐχθρῶν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:521.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:521.1.text#ἐξὸν κτείνειν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:522.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:522.1.text#καὶ φόβον οἴκων ἀφελέσθαι.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:523.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:523.1.text#ὦ πόσις πόσις, εἴθε σὰν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:524.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:524.1.text#χεῖρα καὶ δόρυ σύμμαχον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:525.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:525.1.text#κτησαίμαν, Πριάμου παῖ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:526.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:526.1.text#δύστανος, τί δ' ἐγὼ μόρου
urn:cts:greekLit:tlg0006.tlg006.fu.sp:527.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:527.1.text#παράτροπον μέλος εὕρω;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:529.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:529.1.text#λίσσου, γούνασι δεσπότου
urn:cts:greekLit:tlg0006.tlg006.fu.sp:530.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:530.1.text#χρίμπτων, ὦ τέκνον.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:530.2.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:530.2.text#ὦ φίλος,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:531.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:531.1.text#φίλος, ἄνες θάνατόν μοι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:532.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:532.1.text#λείβομαι δάκρυσιν κόρας,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:533.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:533.1.text#στάζω λισσάδος ὡς πέτρας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:534.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:534.1.text#λιβὰς ἀνήλιος, ἁ τάλαιν'[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:535.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:535.1.text#ὤμοι μοι, τί δ' ἐγὼ κακῶν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:536.1.speaker#Παῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:536.1.text#μῆχος ἐξανύσωμαι;[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:537.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:537.1.text#τί με προσπίτνεις, ἁλίαν πέτραν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:538.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:538.1.text#ἢ κῦμα λιταῖς ὣς ἱκετεύων;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:539.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:539.1.text#τοῖς γὰρ ἐμοῖσιν γέγον' ὠφελία,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:540.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:540.1.text#σοὶ δ' οὐδὲν ἔχω φίλτρον, ἐπεί τοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:541.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:541.1.text#μέγ' ἀναλώσας ψυχῆς μόριον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:542.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:542.1.text#Τροίαν εἷλον καὶ μητέρα σήν·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:543.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:543.1.text#ἧς ἀπολαύων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:544.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:544.1.text#Ἅιδην χθόνιον καταβήσῃ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:545.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:545.1.text#καὶ μὴν δέδορκα τόνδε Πηλέα πέλας,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:546.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:546.1.text#σπουδῇ τιθέντα δεῦρο γηραιὸν πόδα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:547.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:547.1.text#ὑμᾶς ἐρωτῶ τόν τ' ἐφεστῶτα σφαγῇ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:548.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:548.1.text#τί ταῦτα; πῶς ταῦτ'; ἐκ τίνος λόγου νοσεῖ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:549.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:549.1.text#δόμος; τί πράσσετ' ἄκριτα μηχανώμενοι;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:550.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:550.1.text#Μενέλα', ἐπίσχες· μὴ τάχυν' ἄνευ δίκης [ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:551.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:551.1.text#ἡγοῦ σὺ θᾶσσον, οὐ γὰρ ὡς ἔοικέ μοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:552.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:552.1.text#σχολῆς τόδ' ἔργον· ἀλλ' ἀνηβητηρίαν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:553.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:553.1.text#ῥώμην μ' ἐπαινῶ λαμβάνειν, εἴπερ ποτέ [ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:554.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:554.1.text#πρῶτον μὲν οὖν κατ' οὖρον ὥσπερ ἱστίοις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:555.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:555.1.text#ἐμπνεύσομαι τῇδ'· εἰπέ, τίνι δίκῃ χέρας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:556.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:556.1.text#βρόχοισιν ἐκδήσαντες οἵδ' ἄγουσί σε
urn:cts:greekLit:tlg0006.tlg006.fu.sp:557.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:557.1.text#καὶ παῖδ'; ὕπαρνος γάρ τις οἶς ἀπόλλυσαι,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:558.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:558.1.text#ἡμῶν ἀπόντων τοῦ τε κυρίου σέθεν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:559.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:559.1.text#οἵδ', ὦ γεραιέ, σὺν τέκνῳ θανουμένην
urn:cts:greekLit:tlg0006.tlg006.fu.sp:560.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:560.1.text#ἄγουσί μ' οὕτως ὡς ὁρᾷς. τί σοι λέγω;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:561.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:561.1.text#οὐ γὰρ μιᾶς σε κληδόνος προθυμίᾳ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:562.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:562.1.text#μετῆλθον, ἀλλὰ μυρίων ὑπ' ἀγγέλων.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:563.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:563.1.text#ἔριν δὲ τὴν κατ' οἶκον οἶσθά που κλύων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:564.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:564.1.text#τῆς τοῦδε θυγατρός, ὧν τ' ἀπόλλυμαι χάριν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:565.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:565.1.text#καὶ νῦν με βωμοῦ Θέτιδος, ἣ τὸν εὐγενῆ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:566.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:566.1.text#ἔτικτέ σοι παῖδ', ἣν σὺ θαυμαστὴν σέβεις,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:567.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:567.1.text#ἄγουσ' ἀποσπάσαντες, οὔτε τῳ δίκῃ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:568.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:568.1.text#κρίναντες οὔτε τοὺς ἀπόντας ἐκ δόμων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:569.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:569.1.text#μείναντες, ἀλλὰ τὴν ἐμὴν ἐρημίαν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:570.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:570.1.text#γνόντες τέκνου τε τοῦδ', ὃν οὐδὲν αἴτιον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:571.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:571.1.text#μέλλουσι σὺν ἐμοὶ τῇ ταλαιπώρῳ κτενεῖν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:572.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:572.1.text#ἀλλ' ἀντιάζω σ', ὦ γέρον, τῶν σῶν πάρος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:573.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:573.1.text#πίτνουσα γονάτων—χειρὶ δ' οὐκ ἔξεστί μοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:574.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:574.1.text#τῆς σῆς λαβέσθαι φιλτάτης γενειάδος—
urn:cts:greekLit:tlg0006.tlg006.fu.sp:575.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:575.1.text#ῥῦσαί με πρὸς θεῶν· εἰ δὲ μή, θανούμεθα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:576.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:576.1.text#αἰσχρῶς μὲν ὑμῖν, δυστυχῶς δ' ἐμοί, γέρον.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:577.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:577.1.text#χαλᾶν κελεύω δεσμὰ πρὶν κλαίειν τινά,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:578.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:578.1.text#καὶ τῆσδε χεῖρας διπτύχους ἀνιέναι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:579.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:579.1.text#ἐγὼ δ' ἀπαυδῶ γ' ἄλλος οὐχ ἥσσων σέθεν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:580.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:580.1.text#καὶ τῆσδε πολλῷ κυριώτερος γεγώς.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:581.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:581.1.text#πῶς; ἦ τὸν ἀμὸν οἶκον οἰκήσεις μολὼν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:582.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:582.1.text#δεῦρ'; οὐχ ἅλις σοι τῶν κατὰ Σπάρτην κρατεῖν;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:583.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:583.1.text#εἷλόν νιν αἰχμάλωτον ἐκ Τροίας ἐγώ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:584.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:584.1.text#οὑμὸς δέ γ' αὐτὴν ἔλαβε παῖς παιδὸς γέρας.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:585.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:585.1.text#οὔκουν ἐκείνου τἀμὰ τἀκείνου τ' ἐμά;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:586.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:586.1.text#[ ναί, ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:586.2.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:586.2.text#δρᾶν εὖ, κακῶς δ' οὔ, μηδ' ἀποκτείνειν βίᾳ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:587.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:587.1.text#ὡς τήνδ' ἀπάξεις οὔποτ' ἐξ ἐμῆς χερός.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:588.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:588.1.text#σκήπτρῳ δὲ τῷδε σὸν καθαιμάξω κάρα;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:589.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:589.1.text#ψαῦσόν γ', ἵν' εἰδῇς, καὶ πέλας πρόσελθέ μου.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:590.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:590.1.text#σὺ γὰρ μετ' ἀνδρῶν, ὦ κάκιστε κἀκ κακῶν;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:591.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:591.1.text#σοὶ ποῦ μέτεστιν ὡς ἐν ἀνδράσιν λόγου;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:592.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:592.1.text#ὅστις πρὸς ἀνδρὸς Φρυγὸς ἀπηλλάγης λέχος,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:593.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:593.1.text#ἄκλῃστ' ἄδουλα δώμαθ' ἑστίας λιπών,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:594.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:594.1.text#ὡς δὴ γυναῖκα σώφρον' ἐν δόμοις ἔχων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:595.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:595.1.text#πασῶν κακίστην. οὐδ' ἂν εἰ βούλοιτό τις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:596.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:596.1.text#σώφρων γένοιτο Σπαρτιατίδων κόρη,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:597.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:597.1.text#αἳ ξὺν νέοισιν ἐξερημοῦσαι δόμους
urn:cts:greekLit:tlg0006.tlg006.fu.sp:598.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:598.1.text#γυμνοῖσι μηροῖς καὶ πέπλοις ἀνειμένοις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:599.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:599.1.text#δρόμους παλαίστρας τ' οὐκ ἀνασχετοὺς ἐμοὶ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:600.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:600.1.text#κοινὰς ἔχουσι. κᾆτα θαυμάζειν χρεὼν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:601.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:601.1.text#εἰ μὴ γυναῖκας σώφρονας παιδεύετε;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:602.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:602.1.text#Ἑλένην ἐρέσθαι χρῆν τάδ', ἥτις ἐκ δόμων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:603.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:603.1.text#τὸν σὸν λιποῦσα  Φίλιον ἐξεκώμασε
urn:cts:greekLit:tlg0006.tlg006.fu.sp:604.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:604.1.text#νεανίου μετ' ἀνδρὸς εἰς ἄλλην χθόνα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:605.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:605.1.text#κἄπειτ' ἐκείνης οὕνεχ' Ἑλλήνων ὄχλον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:606.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:606.1.text#τοσόνδ' ἀθροίσας ἤγαγες πρὸς  Ἴλιον;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:607.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:607.1.text#ἣν χρῆν σ' ἀποπτύσαντα μὴ κινεῖν δόρυ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:608.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:608.1.text#κακὴν ἐφευρόντ', ἀλλ' ἐᾶν αὐτοῦ μένειν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:609.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:609.1.text#μισθόν τε δόντα μήποτ' εἰς οἴκους λαβεῖν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:610.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:610.1.text#ἀλλ' οὔτι ταύτῃ σὸν φρόνημ' ἐπούρισας,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:611.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:611.1.text#ψυχὰς δὲ πολλὰς κἀγαθὰς ἀπώλεσας,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:612.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:612.1.text#παίδων τ' ἄπαιδας γραῦς ἔθηκας ἐν δόμοις,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:613.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:613.1.text#πολιούς τ' ἀφείλου πατέρας εὐγενῆ τέκνα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:614.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:614.1.text#ὧν εἷς ἐγὼ δύστηνος· αὐθέντην δὲ σὲ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:615.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:615.1.text#μιάστορ' ὥς τιν' εἰσδέδορκ' Ἀχιλλέως.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:616.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:616.1.text#ὃς οὐδὲ τρωθεὶς ἦλθες ἐκ Τροίας μόνος,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:617.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:617.1.text#κάλλιστα τεύχη δ' ἐν καλοῖσι σάγμασιν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:618.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:618.1.text#ὅμοι' ἐκεῖσε δεῦρό τ' ἤγαγες πάλιν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:619.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:619.1.text#κἀγὼ μὲν ηὔδων τῷ γαμοῦντι μήτε σοὶ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:620.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:620.1.text#κῆδος ξυνάψαι μήτε δώμασιν λαβεῖν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:621.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:621.1.text#κακῆς γυναικὸς πῶλον· ἐκφέρουσι γὰρ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:622.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:622.1.text#μητρῷ' ὀνείδη. τοῦτο καὶ σκοπεῖτέ μοι,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:623.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:623.1.text#μνηστῆρες, ἐσθλῆς θυγατέρ' ἐκ μητρὸς λαβεῖν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:624.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:624.1.text#πρὸς τοῖσδε δ' εἰς ἀδελφὸν οἷ' ἐφύβρισας,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:625.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:625.1.text#σφάξαι κελεύσας θυγατέρ' εὐηθέστατα;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:626.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:626.1.text#οὕτως ἔδεισας μὴ οὐ κακὴν δάμαρτ' ἔχῃς.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:627.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:627.1.text#ἑλὼν δὲ Τροίαν—εἶμι γὰρ κἀνταῦθά σοι—
urn:cts:greekLit:tlg0006.tlg006.fu.sp:628.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:628.1.text#οὐκ ἔκτανες γυναῖκα χειρίαν λαβών,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:629.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:629.1.text#ἀλλ', ὡς ἐσεῖδες μαστόν, ἐκβαλὼν ξίφος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:630.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:630.1.text#φίλημ' ἐδέξω, προδότιν αἰκάλλων κύνα,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:631.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:631.1.text#ἥσσων πεφυκὼς Κύπριδος, ὦ κάκιστε σύ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:632.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:632.1.text#κἄπειτ' ἐς οἴκους τῶν ἐμῶν ἐλθὼν τέκνων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:633.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:633.1.text#πορθεῖς ἀπόντων, καὶ γυναῖκα δυστυχῆ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:634.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:634.1.text#κτείνεις ἀτίμως παῖδά θ', ὃς κλαίοντά σε
urn:cts:greekLit:tlg0006.tlg006.fu.sp:635.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:635.1.text#καὶ τὴν ἐν οἴκοις σὴν καταστήσει κόρην,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:636.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:636.1.text#κεἰ τρὶς νόθος πέφυκε. πολλάκις δέ τοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:637.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:637.1.text#ξηρὰ βαθεῖαν γῆν ἐνίκησε σπορᾷ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:638.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:638.1.text#νόθοι τε πολλοὶ γνησίων ἀμείνονες.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:639.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:639.1.text#ἀλλ' ἐκκομίζου παῖδα. κύδιον βροτοῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:640.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:640.1.text#πένητα χρηστὸν ἢ κακὸν καὶ πλούσιον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:641.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:641.1.text#γαμβρὸν πεπᾶσθαι καὶ φίλον· σὺ δ' οὐδὲν εἶ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:642.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:642.1.text#σμικρᾶς ἀπ' ἀρχῆς νεῖκος ἀνθρώποις μέγα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:643.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:643.1.text#γλῶσσ' ἐκπορίζει· τοῦτο δ' οἱ σοφοὶ βροτῶν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:644.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:644.1.text#ἐξευλαβοῦνται, μὴ φίλοις τεύχειν ἔριν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:645.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:645.1.text#τί δῆτ' ἂν εἴποις τοὺς γέροντας, ὡς σοφοί,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:646.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:646.1.text#καὶ τοὺς φρονεῖν δοκοῦντας Ἕλλησίν ποτε;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:647.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:647.1.text#ὅτ' ὢν σὺ Πηλεὺς καὶ πατρὸς κλεινοῦ γεγώς,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:648.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:648.1.text#κῆδος συνάψας, αἰσχρὰ μὲν σαυτῷ λέγεις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:649.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:649.1.text#ἡμῖν δ' ὀνείδη διὰ γυναῖκα βάρβαρον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:650.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:650.1.text#ἣν χρῆν σ' ἐλαύνειν τήνδ' ὑπὲρ Νείλου ῥοὰς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:651.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:651.1.text#ὑπέρ τε Φᾶσιν, κἀμὲ παρακαλεῖν ἀεί
urn:cts:greekLit:tlg0006.tlg006.fu.sp:652.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:652.1.text#οὖσαν μὲν ἠπειρῶτιν, οὗ πεσήματα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:653.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:653.1.text#πλεῖσθ' Ἑλλάδος πέπτωκε δοριπετῆ νεκρῶν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:654.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:654.1.text#τοῦ σοῦ δὲ παιδὸς αἵματος κοινουμένην.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:655.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:655.1.text#Πάρις γάρ, ὃς σὸν παῖδ' ἔπεφν' Ἀχιλλέα,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:656.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:656.1.text#Ἕκτορος ἀδελφὸς ἦν, δάμαρ δ' ἥδ' Ἕκτορος.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:657.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:657.1.text#καὶ τῇδέ γ' εἰσέρχῃ σὺ ταὐτὸν εἰς στέγος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:658.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:658.1.text#καὶ ξυντράπεζον ἀξιοῖς ἔχειν βίον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:659.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:659.1.text#τίκτειν δ' ἐν οἴκοις παῖδας ἐχθίστους ἐᾷς.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:660.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:660.1.text#ἁγὼ προνοίᾳ τῇ τε σῇ κἀμῇ, γέρον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:661.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:661.1.text#κτανεῖν θέλων τήνδ' ἐκ χερῶν ἁρπάζομαι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:662.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:662.1.text#καίτοι φέρ'· ἅψασθαι γὰρ οὐκ αἰσχρὸν λόγου·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:663.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:663.1.text#ἢν παῖς μὲν ἡμὴ μὴ τέκῃ, ταύτης δ' ἄπο
urn:cts:greekLit:tlg0006.tlg006.fu.sp:664.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:664.1.text#βλάστωσι παῖδες, τῆσδε γῆς Φθιώτιδος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:665.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:665.1.text#στήσεις τυράννους, βάρβαροι δ' ὄντες γένος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:666.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:666.1.text#Ἕλλησιν ἄρξουσ'; εἶτ' ἐγὼ μὲν οὐ φρονῶ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:667.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:667.1.text#μισῶν τὰ μὴ δίκαια, σοὶ δ' ἔνεστι νοῦς;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:668.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:668.1.text#[ κἀκεῖνο νῦν ἄθρησον· εἰ σὺ παῖδα σὴν ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:669.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:669.1.text#[ δούς τῳ πολιτῶν, εἶτ' ἔπασχε τοιάδε, ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:670.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:670.1.text#[ σιγῇ καθῆσ' ἄν; οὐ δοκῶ· ξένης δ' ὕπερ ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:671.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:671.1.text#[ τοιαῦτα λάσκεις τοὺς ἀναγκαίους φίλους; ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:672.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:672.1.text#[ καὶ μὴν ἴσον γ' ἀνήρ τε καὶ γυνὴ στένει ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:673.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:673.1.text#[ ἀδικουμένη πρὸς ἀνδρός· ὡς δ' αὔτως ἀνὴρ ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:674.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:674.1.text#[ γυναῖκα μωραίνουσαν ἐν δόμοις ἔχων. ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:675.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:675.1.text#[ καὶ τῷ μὲν ἔστιν ἐν χεροῖν μέγα σθένος, ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:676.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:676.1.text#[ τῇ δ' ἐν γονεῦσι καὶ φίλοις τὰ πράγματα. ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:677.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:677.1.text#[ οὔκουν δίκαιον τοῖς γ' ἐμοῖς ἐπωφελεῖν; ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:678.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:678.1.text#γέρων γέρων εἶ. τὴν δ' ἐμὴν στρατηγίαν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:679.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:679.1.text#λέγων ἔμ' ὠφελοῖς ἂν ἢ σιγῶν πλέον.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:680.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:680.1.text#Ἑλένη δ' ἐμόχθησ' οὐχ ἑκοῦσ', ἀλλ' ἐκ θεῶν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:681.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:681.1.text#καὶ τοῦτο πλεῖστον ὠφέλησεν Ἑλλάδα·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:682.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:682.1.text#ὅπλων γὰρ ὄντες καὶ μάχης ἀίστορες
urn:cts:greekLit:tlg0006.tlg006.fu.sp:683.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:683.1.text#ἔβησαν εἰς τἀνδρεῖον· ἡ δ' ὁμιλία
urn:cts:greekLit:tlg0006.tlg006.fu.sp:684.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:684.1.text#πάντων βροτοῖσι γίγνεται διδάσκαλος.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:685.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:685.1.text#εἰ δ' εἰς πρόσοψιν τῆς ἐμῆς ἐλθὼν ἐγὼ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:686.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:686.1.text#γυναικὸς ἔσχον μὴ κτανεῖν, ἐσωφρόνουν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:687.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:687.1.text#οὐδ' ἂν σὲ Φῶκον ἤθελον κατακτανεῖν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:688.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:688.1.text#ταῦτ' εὖ φρονῶν σ' ἐπῆλθον, οὐκ ὀργῆς χάριν·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:689.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:689.1.text#ἢν δ' ὀξυθυμῇς, σοὶ μὲν ἡ γλωσσαλγία
urn:cts:greekLit:tlg0006.tlg006.fu.sp:690.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:690.1.text#μείζων, ἐμοὶ δὲ κέρδος ἡ προμηθία.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:691.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:691.1.text#παύσασθον ἤδη· λῷστα γὰρ μακρῷ τάδε·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:692.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:692.1.text#λόγων ματαίων, μὴ δύο σφαλῆθ' ἅμα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:693.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:693.1.text#οἴμοι, καθ' Ἑλλάδ' ὡς κακῶς νομίζεται·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:694.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:694.1.text#ὅταν τροπαῖα πολεμίων στήσῃ στρατός,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:695.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:695.1.text#οὐ τῶν πονούντων τοὔργον ἡγοῦνται τόδε,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:696.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:696.1.text#ἀλλ' ὁ στρατηγὸς τὴν δόκησιν ἄρνυται,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:697.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:697.1.text#ὃς εἷς μετ' ἄλλων μυρίων πάλλων δόρυ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:698.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:698.1.text#οὐδὲν πλέον δρῶν ἑνὸς ἔχει πλείω λόγον.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:699.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:699.1.text#σεμνοὶ δ' ἐν ἀρχαῖς ἥμενοι κατὰ πτόλιν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:700.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:700.1.text#φρονοῦσι δήμου μεῖζον, ὄντες οὐδένες·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:701.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:701.1.text#οἱ δ' εἰσὶν αὐτῶν μυρίῳ σοφώτεροι,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:702.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:702.1.text#εἰ τόλμα προσγένοιτο βούλησίς θ' ἅμα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:703.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:703.1.text#ὡς καὶ σὺ σός τ' ἀδελφὸς ἐξωγκωμένοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:704.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:704.1.text#Τροίᾳ κάθησθε τῇ τ' ἐκεῖ στρατηγίᾳ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:705.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:705.1.text#μόχθοισιν ἄλλων καὶ πόνοις ἐπηρμένοι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:706.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:706.1.text#δείξω δ' ἐγώ σοι μὴ τὸν Ἰδαῖον Πάριν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:707.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:707.1.text#ἥσσω νομίζειν Πηλέως ἐχθρόν ποτε,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:708.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:708.1.text#εἰ μὴ φθερῇ τῆσδ' ὡς τάχιστ' ἀπὸ στέγης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:709.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:709.1.text#καὶ παῖς ἄτεκνος, ἣν ὅ γ' ἐξ ἡμῶν γεγὼς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:710.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:710.1.text#ἐλᾷ δι' οἴκων τῶνδ' ἐπισπάσας κόμης·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:711.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:711.1.text#ἣ στερρὸς οὖσα μόσχος οὐκ ἀνέξεται
urn:cts:greekLit:tlg0006.tlg006.fu.sp:712.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:712.1.text#τίκτοντας ἄλλους, οὐκ ἔχουσ' αὐτὴ τέκνα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:713.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:713.1.text#ἀλλ', εἰ τὸ κείνης δυστυχεῖ παίδων πέρι,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:714.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:714.1.text#ἄπαιδας ἡμᾶς δεῖ καταστῆναι τέκνων;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:715.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:715.1.text#φθείρεσθε τῆσδε, δμῶες, ὡς ἂν ἐκμάθω
urn:cts:greekLit:tlg0006.tlg006.fu.sp:716.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:716.1.text#εἴ τίς με λύειν τῆσδε κωλύσει χέρας.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:717.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:717.1.text#ἔπαιρε σαυτήν· ὡς ἐγὼ καίπερ τρέμων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:718.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:718.1.text#πλεκτὰς ἱμάντων στροφίδας ἐξανήσομαι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:719.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:719.1.text#ὧδ', ὦ κάκιστε, τῆσδ' ἐλυμήνω χέρας;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:720.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:720.1.text#βοῦν ἢ λέοντ' ἤλπιζες ἐντείνειν βρόχοις;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:721.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:721.1.text#ἢ μὴ ξίφος λαβοῦσ' ἀμυνάθοιτό σε
urn:cts:greekLit:tlg0006.tlg006.fu.sp:722.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:722.1.text#ἔδεισας; ἕρπε δεῦρ' ὑπ' ἀγκάλας, βρέφος,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:723.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:723.1.text#ξύλλυε μητρὸς δεσμόν· ἐν Φθίᾳ σ' ἐγὼ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:724.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:724.1.text#θρέψω μέγαν τοῖσδ' ἐχθρόν. εἰ δ' ἀπῆν δορὸς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:725.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:725.1.text#τοῖς Σπαρτιάταις δόξα καὶ μάχης ἀγών,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:726.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:726.1.text#τἄλλ' ὄντες ἴστε μηδενὸς βελτίονες.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:727.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:727.1.text#ἀνειμένον τι χρῆμα πρεσβυτῶν γένος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:728.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:728.1.text#καὶ δυσφύλακτον ὀξυθυμίας ὕπο.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:729.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:729.1.text#ἄγαν προνωπὴς εἰς τὸ λοιδορεῖν φέρῃ·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:730.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:730.1.text#ἐγὼ δὲ πρὸς βίαν μὲν εἰς Φθίαν μολὼν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:731.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:731.1.text#οὔτ' οὖν τι δράσω φλαῦρον οὔτε πείσομαι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:732.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:732.1.text#καὶ νῦν μέν—οὐ γὰρ ἄφθονον σχολὴν ἔχω—
urn:cts:greekLit:tlg0006.tlg006.fu.sp:733.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:733.1.text#ἄπειμ' ἐς οἴκους· ἔστι γάρ τις οὐ πρόσω
urn:cts:greekLit:tlg0006.tlg006.fu.sp:734.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:734.1.text#Σπάρτης [ … ] πόλις τις,  ἣ πρὸ τοῦ μὲν ἦν φίλη,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:735.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:735.1.text#νῦν δ' ἐχθρὰ ποιεῖ· τήνδ' ἐπεξελθεῖν θέλω
urn:cts:greekLit:tlg0006.tlg006.fu.sp:736.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:736.1.text#στρατηλατήσας χὑποχείριον λαβεῖν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:737.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:737.1.text#ὅταν δὲ τἀκεῖ θῶ κατὰ γνώμην ἐμήν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:738.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:738.1.text#ἥξω· παρὼν δὲ πρὸς παρόντας ἐμφανῶς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:739.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:739.1.text#γαμβροὺς διδάξω καὶ διδάξομαι λόγους.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:740.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:740.1.text#κἂν μὲν κολάζῃ τήνδε καὶ τὸ λοιπὸν ᾖ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:741.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:741.1.text#σώφρων καθ' ἡμᾶς, σώφρον' ἀντιλήψεται·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:742.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:742.1.text#θυμούμενος δὲ τεύξεται θυμουμένων,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:743.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:743.1.text#ἔργοισι δ' ἔργα διάδοχ' ἀντιλήψεται.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:744.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:744.1.text#τοὺς σοὺς δὲ μύθους ῥᾳδίως ἐγὼ φέρω·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:745.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:745.1.text#σκιὰ γὰρ ἀντίστοιχος ὣς φωνὴν ἔχεις,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:746.1.speaker#Μενέλαος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:746.1.text#ἀδύνατος, οὐδὲν ἄλλο πλὴν λέγειν μόνον.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:747.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:747.1.text#ἡγοῦ, τέκνον μοι, δεῦρ' ὑπ' ἀγκάλαις σταθείς,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:748.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:748.1.text#σύ τ', ὦ τάλαινα· χείματος γὰρ ἀγρίου
urn:cts:greekLit:tlg0006.tlg006.fu.sp:749.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:749.1.text#τυχοῦσα λιμένας ἦλθες εἰς εὐηνέμους.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:750.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:750.1.text#ὦ πρέσβυ, θεοί σοι δοῖεν εὖ καὶ τοῖσι σοῖς,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:751.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:751.1.text#σῴσαντι παῖδα κἀμὲ τὴν δυσδαίμονα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:752.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:752.1.text#ὅρα δὲ μὴ νῷν εἰς ἐρημίαν ὁδοῦ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:753.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:753.1.text#πτήξαντες οἵδε πρὸς βίαν ἄγωσί με,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:754.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:754.1.text#γέροντα μὲν σ' ὁρῶντες, ἀσθενῆ δ' ἐμὲ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:755.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:755.1.text#καὶ παῖδα τόνδε νήπιον· σκόπει τάδε,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:756.1.speaker#Ἀνδρομάχη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:756.1.text#μὴ νῦν φυγόντες εἶθ' ἁλῶμεν ὕστερον.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:757.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:757.1.text#οὐ μὴ γυναικῶν δειλὸν εἰσοίσεις λόγον·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:758.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:758.1.text#χώρει· τίς ὑμῶν ἅψεται; κλαίων ἄρα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:759.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:759.1.text#ψαύσει. θεῶν γὰρ οὕνεχ' ἱππικοῦ τ' ὄχλου
urn:cts:greekLit:tlg0006.tlg006.fu.sp:760.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:760.1.text#πολλῶν θ' ὁπλιτῶν ἄρχομεν Φθίαν κάτα·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:761.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:761.1.text#ἡμεῖς δ' ἔτ' ὀρθοὶ κοὐ γέροντες, ὡς δοκεῖς,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:762.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:762.1.text#ἀλλ' εἴς γε τοιόνδ' ἄνδρ' ἀποβλέψας μόνον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:763.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:763.1.text#τροπαῖον αὐτοῦ στήσομαι, πρέσβυς περ ὤν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:764.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:764.1.text#πολλῶν νέων γὰρ κἂν γέρων εὔψυχος ᾖ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:765.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:765.1.text#κρείσσων· τί γὰρ δεῖ δειλὸν ὄντ' εὐσωματεῖν;[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:766.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:766.1.text#μὴ γενοίμαν ἢ πατέρων ἀγαθῶν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:767.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:767.1.text#εἴην πολυκτήτων τε δόμων μέτοχος.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:770.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:770.1.text#εἴ τι γὰρ πάσχοι τις ἀμήχανον, ἀλκᾶς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:771.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:771.1.text#οὐ σπάνις εὐγενέταις,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:772.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:772.1.text#κηρυσσομένοισι δ' ἀπ' ἐσθλῶν δωμάτων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:773.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:773.1.text#τιμὰ καὶ κλέος· οὔτοι λείψανα  τῶν ἀγαθῶν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:775.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:775.1.text#ἀνδρῶν ἀφαιρεῖται χρόνος· ἁ δ' ἀρετὰ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:776.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:776.1.text#καὶ θανοῦσι λάμπει.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:778.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:778.1.text#κρεῖσσον δὲ νίκαν μὴ κακόδοξον ἔχειν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:780.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:780.1.text#ἢ ξὺν φθόνῳ σφάλλειν δυνάμει τε δίκαν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:781.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:781.1.text#ἡδὺ μὲν γὰρ αὐτίκα τοῦτο βροτοῖσιν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:782.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:782.1.text#ἐν δὲ χρόνῳ τελέθει
urn:cts:greekLit:tlg0006.tlg006.fu.sp:784.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:784.1.text#ξηρὸν καὶ ὀνείδεσιν ἔγκειται δόμων.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:785.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:785.1.text#ταύταν ᾔνεσα ταύταν καὶ φέρομαι βιοτάν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:787.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:787.1.text#μηδὲν δίκας ἔξω κράτος ἐν θαλάμοις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:788.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:788.1.text#καὶ πόλει δύνασθαι.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:789.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:789.1.text#ὦ γέρον Αἰακίδα,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:790.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:790.1.text#πείθομαι καὶ σὺν Λαπίθαισί σε Κενταύρων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:791.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:791.1.text#ὁμιλῆσαι δορὶ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:792.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:792.1.text#κλεινοτάτῳ· καὶ ἐπ' Ἀργῴου δορὸς ἄξενον ὑγρὰν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:794.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:794.1.text#ἐκπερᾶσαι ποντιᾶν Ξυμπληγάδων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:795.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:795.1.text#κλεινὰν ἐπὶ ναυστολίαν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:796.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:796.1.text#Ἰλιάδα τε πόλιν ὅτε πάρος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:798.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:798.1.text#εὐδόκιμον ὁ Διὸς ἶνις ἀμφέβαλε φόνῳ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:800.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:800.1.text#κοινὰν τὰν εὔκλειαν ἔχοντ'
urn:cts:greekLit:tlg0006.tlg006.fu.sp:801.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:801.1.text#Εὐρώπαν ἀφικέσθαι.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:802.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:802.1.text#ὦ φίλταται γυναῖκες, ὡς κακὸν κακῷ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:803.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:803.1.text#διάδοχον ἐν τῇδ' ἡμέρᾳ πορσύνεται.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:804.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:804.1.text#δέσποινα γὰρ κατ' οἶκον, Ἑρμιόνην λέγω,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:805.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:805.1.text#πατρός τ' ἐρημωθεῖσα συννοίᾳ θ' ἅμα,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:806.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:806.1.text#οἷον δέδρακεν ἔργον Ἀνδρομάχην κτανεῖν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:807.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:807.1.text#καὶ παῖδα βουλεύσασα, κατθανεῖν θέλει,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:808.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:808.1.text#πόσιν τρέμουσα, μὴ ἀντὶ τῶν δεδραμένων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:809.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:809.1.text#ἐκ τῶνδ' ἀτίμως δωμάτων ἀποσταλῇ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:810.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:810.1.text#ἢ κατθάνῃ κτείνουσα τοὺς οὐ χρὴ κτανεῖν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:811.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:811.1.text#μόλις δέ νιν θέλουσαν ἀρτῆσαι δέρην
urn:cts:greekLit:tlg0006.tlg006.fu.sp:812.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:812.1.text#εἴργουσι φύλακες δμῶες ἔκ τε δεξιᾶς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:813.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:813.1.text#ξίφη καθαρπάζουσιν ἐξαιρούμενοι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:814.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:814.1.text#οὕτω μεταλγεῖ καὶ τὰ πρὶν δεδραμένα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:815.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:815.1.text#ἔγνωκε πράξασ' οὐ καλῶς. ἐγὼ μὲν οὖν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:816.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:816.1.text#δέσποιναν εἴργουσ' ἀγχόνης κάμνω, φίλαι·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:817.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:817.1.text#ὑμεῖς δὲ βᾶσαι τῶνδε δωμάτων ἔσω
urn:cts:greekLit:tlg0006.tlg006.fu.sp:818.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:818.1.text#θανάτου νιν ἐκλύσασθε· τῶν γὰρ ἠθάδων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:819.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:819.1.text#φίλων νέοι μολόντες εὐπιθέστεροι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:820.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:820.1.text#καὶ μὴν ἐν οἴκοις προσπόλων ἀκούομεν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:821.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:821.1.text#βοὴν ἐφ' οἷσιν ἦλθες ἀγγέλλουσα σύ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:822.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:822.1.text#δείξειν δ' ἔοικεν ἡ τάλαιν' ὅσον στένει
urn:cts:greekLit:tlg0006.tlg006.fu.sp:823.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:823.1.text#πράξασα δεινά· δωμάτων γὰρ ἐκπερᾷ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:824.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:824.1.text#φεύγουσα χεῖρας προσπόλων πόθῳ θανεῖν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:825.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:825.1.text#ἰώ μοί μοι·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:826.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:826.1.text#σπάραγμα κόμας ὀνύχων τε δάι' ἀμύγματα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:827.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:827.1.text#θήσομαι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:828.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:828.1.text#ὦ παῖ, τί δράσεις; σῶμα σὸν καταικιῇ;[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:829.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:829.1.text#αἰαῖ αἰαῖ·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:830.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:830.1.text#ἔρρ' αἰθέριον πλοκάμων ἐμῶν ἄπο,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:831.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:831.1.text#λεπτόμιτον φάρος.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:832.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:832.1.text#τέκνον, κάλυπτε στέρνα, σύνδησαι πέπλους.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:833.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:833.1.text#τί δέ με δεῖ στέρνα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:834.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:834.1.text#καλύπτειν πέπλοις; δῆλα καὶ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:835.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:835.1.text#ἀμφιφανῆ καὶ ἄκρυπτα δεδράκαμεν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:835.2.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:835.2.text#πόσιν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:836.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:836.1.text#ἀλγεῖς, φόνον ῥάψασα συγγάμῳ σέθεν;[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:837.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:837.1.text#κατὰ μὲν οὖν στένω
urn:cts:greekLit:tlg0006.tlg006.fu.sp:838.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:838.1.text#δαΐας τόλμας, ἂν ἔρεξ'·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:839.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:839.1.text#ὦ κατάρατος ἐγὼ κατάρατος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:839.2.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:839.2.text#ἀνθρώποις.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:840.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:840.1.text#συγγνώσεταί σοι τήνδ' ἁμαρτίαν πόσις.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:841.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:841.1.text#τί μοι ξίφος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:842.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:842.1.text#ἐκ χερὸς ἠγρεύσω;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:843.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:843.1.text#ἀπόδος, ὦ φίλα, 'πόδος, ἵν' ἀνταίαν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:844.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:844.1.text#ἐρείσω πλαγάν· τί με βρόχων εἴργεις;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:845.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:845.1.text#ἀλλ' εἴ σ' ἀφείην μὴ φρονοῦσαν, ὡς θάνῃς;[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:846.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:846.1.text#οἴμοι πότμου.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:847.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:847.1.text#ποῦ μοι πυρὸς φίλα φλόξ;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:848.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:848.1.text#ποῦ δ' εἰς πέτρας ἀερθῶ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:849.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:849.1.text#{ ἢ } κατὰ πόντον ἢ καθ' ὕλαν ὀρέων,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:850.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:850.1.text#ἵνα θανοῦσα νερτέροισιν μέλω;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:851.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:851.1.text#τί ταῦτα μοχθεῖς; συμφοραὶ θεήλατοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:852.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:852.1.text#πᾶσιν βροτοῖσιν ἢ τότ' ἦλθον ἢ τότε.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:854.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:854.1.text#ἔλιπες ἔλιπες, ὦ πάτερ, ἐπακτίαν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:855.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:855.1.text#[ ὡσεὶ ] μονάδ' ἔρημον οὖσαν ἐνάλου κώπας.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:856.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:856.1.text#—ὀλεῖ ὀλεῖ με· τᾷδ' οὐκέτ' ἐνοικήσω
urn:cts:greekLit:tlg0006.tlg006.fu.sp:858.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:858.1.text#νυμφιδίῳ στέγᾳ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:859.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:859.1.text#τίνος ἀγαλμάτων ἱκέτις ὁρμαθῶ;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:860.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:860.1.text#ἢ δούλα δούλας γόνασι προσπέσω;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:861.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:861.1.text#Φθιάδος ἐκ γᾶς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:862.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:862.1.text#κυανόπτερος ὄρνις εἴθ' εἴην,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:863.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:863.1.text#ἢ πευκᾶεν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:864.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:864.1.text#σκάφος, ἃ διὰ Κυανέας ἐπέρασεν ἀκτὰς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:865.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:865.1.text#πρωτόπλοος πλάτα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:866.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:866.1.text#ὦ παῖ, τὸ λίαν οὔτ' ἐκεῖν' ἐπῄνεσα,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:867.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:867.1.text#ὅτ' εἰς γυναῖκα Τρῳάδ' ἐξημάρτανες,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:868.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:868.1.text#οὔτ' αὖ τὸ νῦν σου δεῖμ' ὃ δειμαίνεις ἄγαν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:869.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:869.1.text#οὐχ ὧδε κῆδος σὸν διώσεται πόσις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:870.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:870.1.text#φαύλοις γυναικὸς βαρβάρου πεισθεὶς λόγοις.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:871.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:871.1.text#οὐ γάρ τί σ' αἰχμάλωτον ἐκ Τροίας ἔχει,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:872.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:872.1.text#ἀλλ' ἀνδρὸς ἐσθλοῦ παῖδα σὺν πολλοῖς λαβὼν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:873.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:873.1.text#ἕδνοισι, πόλεώς τ' οὐ μέσως εὐδαίμονος.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:874.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:874.1.text#πατὴρ δέ σ' οὐχ ὧδ' ὡς σὺ δειμαίνεις, τέκνον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:875.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:875.1.text#προδοὺς ἐάσει δωμάτων τῶνδ' ἐκπεσεῖν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:876.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:876.1.text#ἀλλ' εἴσιθ' εἴσω μηδὲ φαντάζου δόμων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:877.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:877.1.text#πάροιθε τῶνδε, μή τιν' αἰσχύνην λάβῃς,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:878.1.speaker#Τροφός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:878.1.text#πρόσθεν μελάθρων τῶνδ' ὁρωμένη, τέκνον.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:879.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:879.1.text#καὶ μὴν ὅδ' ἀλλόχρως τις ἔκδημος ξένος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:880.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:880.1.text#σπουδῇ πρὸς ἡμᾶς βημάτων πορεύεται.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:881.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:881.1.text#ξέναι γυναῖκες, ἦ τάδ' ἔστ' Ἀχιλλέως
urn:cts:greekLit:tlg0006.tlg006.fu.sp:882.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:882.1.text#παιδὸς μέλαθρα καὶ τυραννικαὶ στέγαι;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:883.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:883.1.text#ἔγνως· ἀτὰρ δὴ τίς { σὺ } πυνθάνῃ τάδε;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:884.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:884.1.text#Ἀγαμέμνονός τε καὶ Κλυταιμήστρας τόκος,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:885.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:885.1.text#ὄνομα δ' Ὀρέστης· ἔρχομαι δὲ πρὸς Διὸς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:886.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:886.1.text#μαντεῖα Δωδωναῖ'. ἐπεὶ δ' ἀφικόμην
urn:cts:greekLit:tlg0006.tlg006.fu.sp:887.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:887.1.text#Φθίαν, δοκεῖ μοι ξυγγενοῦς μαθεῖν πέρι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:888.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:888.1.text#γυναικός, εἰ ζῇ κεὐτυχοῦσα τυγχάνει
urn:cts:greekLit:tlg0006.tlg006.fu.sp:889.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:889.1.text#ἡ Σπαρτιᾶτις Ἑρμιόνη· τηλουρὰ γὰρ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:890.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:890.1.text#ναίουσ' ἀφ' ἡμῶν πεδί' ὅμως ἐστὶν φίλη.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:891.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:891.1.text#ὦ ναυτίλοισι χείματος λιμὴν φανεὶς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:892.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:892.1.text#Ἀγαμέμνονος παῖ, πρός σε τῶνδε γουνάτων,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:893.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:893.1.text#οἴκτιρον ἡμᾶς ὧν ἐπισκοπεῖς τύχας,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:894.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:894.1.text#πράσσοντας οὐκ εὖ. στεμμάτων δ' οὐχ ἥσσονας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:895.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:895.1.text#σοῖς προστίθημι γόνασιν ὠλένας ἐμάς.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:896.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:896.1.text#ἔα·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:896.2.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:896.2.text#τί χρῆμα; μῶν ἐσφάλμεθ' ἢ σαφῶς ὁρῶ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:897.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:897.1.text#δόμων ἄνασσαν τήνδε Μενέλεω κόρην;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:898.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:898.1.text#ἥνπερ μόνην γε Τυνδαρὶς τίκτει γυνὴ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:899.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:899.1.text#Ἑλένη κατ' οἴκους πατρί· μηδὲν ἀγνόει.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:900.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:900.1.text#ὦ Φοῖβ' ἀκέστορ, πημάτων δοίης λύσιν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:901.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:901.1.text#τί χρῆμα; πρὸς θεῶν ἢ βροτῶν πάσχεις κακά;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:902.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:902.1.text#τὰ μὲν πρὸς ἡμῶν, τὰ δὲ πρὸς ἀνδρὸς ὅς μ' ἔχει,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:903.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:903.1.text#τὰ δ' ἐκ θεῶν του· πανταχῇ δ' ὀλώλαμεν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:904.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:904.1.text#τίς οὖν ἂν εἴη μὴ πεφυκότων γέ πω
urn:cts:greekLit:tlg0006.tlg006.fu.sp:905.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:905.1.text#παίδων γυναικὶ συμφορὰ πλὴν εἰς λέχος;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:906.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:906.1.text#τοῦτ' αὐτὸ καὶ νοσοῦμεν· εὖ μ' ὑπηγάγου.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:907.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:907.1.text#ἄλλην τιν' εὐνὴν ἀντὶ σοῦ στέργει πόσις;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:908.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:908.1.text#τὴν αἰχμάλωτον Ἕκτορος ξυνευνέτιν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:909.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:909.1.text#κακόν γ' ἔλεξας, ἄνδρα δίσσ' ἔχειν λέχη.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:910.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:910.1.text#τοιαῦτα ταῦτα. κᾆτ' ἔγωγ' ἠμυνάμην.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:911.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:911.1.text#μῶν εἰς γυναῖκ' ἔρραψας οἷα δὴ γυνή;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:912.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:912.1.text#φόνον γ' ἐκείνῃ καὶ τέκνῳ νοθαγενεῖ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:913.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:913.1.text#κἄκτεινας, ἤ τις συμφορά σ' ἀφείλετο;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:914.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:914.1.text#γέρων γε Πηλεύς, τοὺς κακίονας σέβων.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:915.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:915.1.text#σοὶ δ' ἦν τις ὅστις τοῦδ' ἐκοινώνει φόνου;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:916.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:916.1.text#πατήρ γ' ἐπ' αὐτὸ τοῦτ' ἀπὸ Σπάρτης μολών.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:917.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:917.1.text#κἄπειτα τοῦ γέροντος ἡσσήθη χερί;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:918.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:918.1.text#αἰδοῖ γε· καί μ' ἔρημον οἴχεται λιπών.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:919.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:919.1.text#συνῆκα· ταρβεῖς τοῖς δεδραμένοις πόσιν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:920.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:920.1.text#ἔγνως· ὀλεῖ γάρ μ' ἐνδίκως. τί δεῖ λέγειν;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:921.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:921.1.text#ἀλλ' ἄντομαί σε Δία καλοῦσ' ὁμόγνιον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:922.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:922.1.text#πέμψον με χώρας τῆσδ' ὅποι προσωτάτω
urn:cts:greekLit:tlg0006.tlg006.fu.sp:923.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:923.1.text#ἢ πρὸς πατρῷον μέλαθρον· ὡς δοκοῦσί γε
urn:cts:greekLit:tlg0006.tlg006.fu.sp:924.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:924.1.text#δόμοι τ' ἐλαύνειν φθέγμ' ἔχοντες οἵδε με,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:925.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:925.1.text#μισεῖ τε γαῖα Φθιάς. εἰ δ' ἥξει πάρος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:926.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:926.1.text#Φοίβου λιπὼν μαντεῖον εἰς δόμους πόσις,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:927.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:927.1.text#κτενεῖ μ' ἐπ' αἰσχίστοισιν· ἢ δουλεύσομεν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:928.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:928.1.text#νόθοισι λέκτροις ὧν ἐδέσποζον πρὸ τοῦ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:929.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:929.1.text#πῶς οὖν τάδ', ὡς εἴποι τις, ἐξημάρτανες;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:930.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:930.1.text#κακῶν γυναικῶν εἴσοδοί μ' ἀπώλεσαν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:931.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:931.1.text#αἵ μοι λέγουσαι τούσδ' ἐχαύνωσαν λόγους·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:932.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:932.1.text#Σὺ τὴν κακίστην αἰχμάλωτον ἐν δόμοις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:933.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:933.1.text#δούλην ἀνέξῃ σοὶ λέχους κοινουμένην;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:934.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:934.1.text#μὰ τὴν ἄνασσαν, οὐκ ἂν ἔν γ' ἐμοῖς δόμοις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:935.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:935.1.text#βλέπουσ' ἂν αὐγὰς τἄμ' ἐκαρποῦτ' ἂν λέχη.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:936.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:936.1.text#κἀγὼ κλύουσα τούσδε Σειρήνων λόγους,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:937.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:937.1.text#[ σοφῶν πανούργων ποικίλων λαλημάτων, ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:938.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:938.1.text#ἐξηνεμώθην μωρίᾳ. τί γάρ μ' ἐχρῆν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:939.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:939.1.text#πόσιν φυλάσσειν, ᾗ παρῆν ὅσων ἔδει;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:940.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:940.1.text#πολὺς μὲν ὄλβος· δωμάτων δ' ἠνάσσομεν·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:941.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:941.1.text#παῖδας δ' ἐγὼ μὲν γνησίους ἔτικτον ἄν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:942.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:942.1.text#ἡ δ' ἡμιδούλους τοῖς ἐμοῖς νοθαγενεῖς.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:943.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:943.1.text#ἀλλ' οὔποτ' οὔποτ'—οὐ γὰρ εἰσάπαξ ἐρῶ—
urn:cts:greekLit:tlg0006.tlg006.fu.sp:944.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:944.1.text#χρὴ τούς γε νοῦν ἔχοντας, οἷς ἔστιν γυνή,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:945.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:945.1.text#πρὸς τὴν ἐν οἴκοις ἄλοχον ἐσφοιτᾶν ἐᾶν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:946.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:946.1.text#γυναῖκας· αὗται γὰρ διδάσκαλοι κακῶν·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:947.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:947.1.text#ἣ μέν τι κερδαίνουσα συμφθείρει λέχος,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:948.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:948.1.text#ἣ δ' ἀμπλακοῦσα συννοσεῖν αὑτῇ θέλει,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:949.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:949.1.text#πολλαὶ δὲ μαργότητι [ … ] κἀντεῦθεν δόμοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:950.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:950.1.text#νοσοῦσιν ἀνδρῶν. πρὸς τάδ' εὖ φυλάσσετε
urn:cts:greekLit:tlg0006.tlg006.fu.sp:951.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:951.1.text#κλῄθροισι καὶ μοχλοῖσι δωμάτων πύλας·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:952.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:952.1.text#ὑγιὲς γὰρ οὐδὲν αἱ θύραθεν εἴσοδοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:953.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:953.1.text#δρῶσιν γυναικῶν, ἀλλὰ πολλὰ καὶ κακά.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:954.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:954.1.text#ἄγαν ἐφῆκας γλῶσσαν εἰς τὸ σύμφυτον.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:955.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:955.1.text#συγγνωστὰ μέν νυν σοὶ τάδ', ἀλλ' ὅμως χρεὼν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:956.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:956.1.text#κοσμεῖν γυναῖκας τὰς γυναικείας νόσους.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:957.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:957.1.text#σοφόν τι χρῆμα τοῦ διδάξαντος βροτοὺς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:958.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:958.1.text#λόγους ἀκούειν τῶν ἐναντίων πάρα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:959.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:959.1.text#ἐγὼ γὰρ εἰδὼς τῶνδε σύγχυσιν δόμων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:960.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:960.1.text#ἔριν τε τὴν σὴν καὶ γυναικὸς Ἕκτορος,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:961.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:961.1.text#φυλακὰς ἔχων ἔμιμνον, εἴτ' αὐτοῦ μενεῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:962.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:962.1.text#εἴτ' ἐκφοβηθεῖσ' αἰχμαλωτίδος φόνῳ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:963.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:963.1.text#γυναικὸς οἴκων τῶνδ' ἀπηλλάχθαι θέλεις.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:964.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:964.1.text#ἦλθον δὲ σὰς μὲν οὐ σέβων ἐπιστολάς,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:965.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:965.1.text#εἰ δ' ἐνδιδοίης, ὥσπερ ἐνδίδως, λόγον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:966.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:966.1.text#πέμψων σ' ἀπ' οἴκων τῶνδ'. ἐμὴ γὰρ οὖσα πρὶν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:967.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:967.1.text#σὺν τῷδε ναίεις ἀνδρὶ σοῦ πατρὸς κάκῃ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:968.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:968.1.text#ὃς πρὶν τὰ Τροίας εἰσβαλεῖν ὁρίσματα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:969.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:969.1.text#γυναῖκ' ἐμοί σε δοὺς ὑπέσχεθ' ὕστερον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:970.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:970.1.text#τῷ νῦν σ' ἔχοντι, Τρῳάδ' εἰ πέρσοι πόλιν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:971.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:971.1.text#ἐπεὶ δ' Ἀχιλλέως δεῦρ' ἐνόστησεν γόνος,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:972.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:972.1.text#σῷ μὲν συνέγνων πατρί, τὸν δ' ἐλισσόμην
urn:cts:greekLit:tlg0006.tlg006.fu.sp:973.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:973.1.text#γάμους ἀφεῖναι σούς, ἐμὰς λέγων τύχας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:974.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:974.1.text#καὶ τὸν παρόντα δαίμον', ὡς φίλων μὲν ἂν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:975.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:975.1.text#γήμαιμ' ἀπ' ἀνδρῶν, ἔκτοθεν δ' οὐ ῥᾳδίως,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:976.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:976.1.text#φεύγων ἀπ' οἴκων ἃς ἐγὼ φεύγω φυγάς.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:977.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:977.1.text#ὃ δ' ἦν ὑβριστὴς εἴς τ' ἐμῆς μητρὸς φόνον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:978.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:978.1.text#τάς θ' αἱματωποὺς θεὰς ὀνειδίζων ἐμοί.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:979.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:979.1.text#κἀγὼ ταπεινὸς ὢν τύχαις ταῖς οἴκοθεν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:980.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:980.1.text#ἤλγουν μὲν ἤλγουν, συμφοραῖς δ' ἠνειχόμην,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:981.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:981.1.text#σῶν δὲ στερηθεὶς ᾠχόμην ἄκων γάμων.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:982.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:982.1.text#νῦν οὖν, ἐπειδὴ περιπετεῖς ἔχεις τύχας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:983.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:983.1.text#καὶ ξυμφορὰν τήνδ' εἰσπεσοῦσ' ἀμηχανεῖς,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:984.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:984.1.text#ἄξω σ' ἀπ' οἴκων καὶ πατρὸς δώσω χερί.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:985.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:985.1.text#τὸ συγγενὲς γὰρ δεινόν, ἔν τε τοῖς κακοῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:986.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:986.1.text#οὐκ ἔστιν οὐδὲν κρεῖσσον οἰκείου φίλου.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:987.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:987.1.text#νυμφευμάτων μὲν τῶν ἐμῶν πατὴρ ἐμὸς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:988.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:988.1.text#μέριμναν ἕξει, κοὐκ ἐμὸν κρίνειν τόδε.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:989.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:989.1.text#ἀλλ' ὡς τάχιστα τῶνδέ μ' ἔκπεμψον δόμων,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:990.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:990.1.text#μὴ φθῇ με προσβὰς δῶμα καὶ μολὼν πόσις,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:991.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:991.1.text#ἢ πρέσβυς οἴκους μ' ἐξερημοῦσαν μαθὼν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:992.1.speaker#Ἑρμιόνη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:992.1.text#Πηλεὺς μετέλθῃ πωλικοῖς διώγμασιν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:993.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:993.1.text#θάρσει γέροντος χεῖρα· τὸν δ' Ἀχιλλέως
urn:cts:greekLit:tlg0006.tlg006.fu.sp:994.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:994.1.text#μηδὲν φοβηθῇς παῖδ', ὅσ' εἰς ἔμ' ὕβρισε.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:995.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:995.1.text#τοία γὰρ αὐτῷ μηχανὴ πεπλεγμένη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:996.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:996.1.text#βρόχοις ἀκινήτοισιν ἕστηκεν φόνου
urn:cts:greekLit:tlg0006.tlg006.fu.sp:997.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:997.1.text#πρὸς τῆσδε χειρός· ἣν πάρος μὲν οὐκ ἐρῶ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:998.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:998.1.text#τελουμένων δὲ Δελφὶς εἴσεται πέτρα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:999.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:999.1.text#ὁ μητροφόντης δ', ἢν δορυξένων ἐμῶν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1000.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1000.1.text#μείνωσιν ὅρκοι Πυθικὴν ἀνὰ χθόνα,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1001.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1001.1.text#δείξει γαμεῖν σφε μηδέν' ὧν ἐχρῆν ἐμέ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1002.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1002.1.text#πικρῶς δὲ πατρὸς φόνιον αἰτήσει δίκην
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1003.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1003.1.text#ἄνακτα Φοῖβον· οὐδέ νιν μετάστασις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1004.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1004.1.text#γνώμης ὀνήσει θεῷ διδόντα νῦν δίκας,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1005.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1005.1.text#ἀλλ' ἔκ τ' ἐκείνου διαβολαῖς τε ταῖς ἐμαῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1006.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1006.1.text#κακῶς ὀλεῖται· γνώσεται δ' ἔχθραν ἐμήν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1007.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1007.1.text#ἐχθρῶν γὰρ ἀνδρῶν μοῖραν εἰς ἀναστροφὴν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1008.1.speaker#Ὀρέστης
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1008.1.text#δαίμων δίδωσι κοὐκ ἐᾷ φρονεῖν μέγα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1009.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1009.1.text#ὦ Φοῖβε πυργώσας τὸν ἐν Ἰλίῳ εὐτειχῆ πάγον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1010.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1010.1.text#καὶ πόντιε κυανέαις ἵπποις διφρεύων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1011.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1011.1.text#ἅλιον πέλαγος,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1012.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1012.1.text#τίνος οὕνεκ' ἄτιμον ὀργᾶς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1015.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1015.1.text#ἃν χέρα τεκτοσύνας Ἐνυαλίῳ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1016.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1016.1.text#δοριμήστορι προσθέντες
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1017.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1017.1.text#τάλαιναν τάλαιναν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1018.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1018.1.text#μεθεῖτε Τροίαν;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1019.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1019.1.text#πλείστους δ' ἐπ' ἀκταῖσιν Σιμοεντίσιν εὐίππους
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1019.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1019.2.text#ὄχους
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1020.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1020.1.text#ἐζεύξατε καὶ φονίους ἀνδρῶν ἁμίλλας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1021.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1021.1.text#ἔθετ' ἀστεφάνους·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1022.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1022.1.text#ἀπὸ δὲ φθίμενοι βεβᾶσιν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1023.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1023.1.text#Ἰλιάδαι βασιλῆες,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1024.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1024.1.text#οὐδ' ἔτι πῦρ ἐπιβώμιον ἐν Τροίᾳ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1025.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1025.1.text#θεοῖσιν λέλαμπεν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1026.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1026.1.text#καπνῷ θυώδει.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1027.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1027.1.text#βέβακε δ' Ἀτρείδας ἀλόχου παλάμαις,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1028.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1028.1.text#αὐτά τ' ἐναλλάξασα φόνον θανάτῳ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1030.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1030.1.text#πρὸς τέκνων ἀπηύρα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1031.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1031.1.text#θεοῦ. θεοῦ νιν κέλευμ' ἐπεστράφη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1032.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1032.1.text#μαντόσυνον, ὅτε νιν Ἀργόθεν πορευθεὶς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1033.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1033.1.text#Ἀγαμεμνόνιος κέλωρ, ἀδύτων ἐπιβὰς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1035.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1035.1.text#κτεάνων, ματρὸς φονεὺς [ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1036.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1036.1.text#ὦ δαῖμον, ὦ Φοῖβε, πῶς πείθομαι;[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1037.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1037.1.text#πολλαὶ δ' ἀν' Ἑλλάνων ἀγόρους στοναχὰς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1039.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.f`u.sp:1039.1.text#μέλποντο δυστάνων τεκέων, ἄλοχοι δ'
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1040.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1040.1.text#ἐξέλειπον οἴκους
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1041.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1041.1.text#πρὸς ἄλλον εὐνάτορ'. οὐχὶ σοὶ μόνᾳ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1042.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1042.1.text#δύσφρονες ἐπέπεσον, οὐ φίλοισι, λῦπαι·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1044.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1044.1.text#νόσον Ἑλλὰς ἔτλα, νόσον· διέβα δὲ Φρυγῶν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1045.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1045.1.text#καὶ πρὸς εὐκάρπους γύας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1046.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1046.1.text#σκηπτὸς σταλάσσων { τὸν } Ἅιδα φόνον.[ … ][ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1047.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1047.1.text#Φθιώτιδες γυναῖκες, ἱστοροῦντί μοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1048.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1048.1.text#σημήνατ'· ᾐσθόμην γὰρ οὐ σαφῆ λόγον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1049.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1049.1.text#ὡς δώματ' ἐκλιποῦσα Μενέλεω κόρη
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1050.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1050.1.text#φρούδη τάδ'· ἥκω δ' ἐκμαθεῖν σπουδὴν ἔχων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1051.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1051.1.text#εἰ ταῦτ' ἀληθῆ· τῶν γὰρ ἐκδήμων φίλων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1052.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1052.1.text#δεῖ τοὺς κατ' οἶκον ὄντας ἐκπονεῖν τύχας.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1053.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1053.1.text#Πηλεῦ, σαφῶς ἤκουσας· οὐδ' ἐμοὶ καλὸν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1054.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1054.1.text#κρύπτειν ἐν οἷς παροῦσα τυγχάνω κακοῖς·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1055.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1055.1.text#βασίλεια γὰρ τῶνδ' οἴχεται φυγὰς δόμων.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1056.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1056.1.text#τίνος φόβου τυχοῦσα; διαπέραινέ μοι.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1057.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1057.1.text#πόσιν τρέμουσα, μὴ δόμων νιν ἐκβάλῃ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1058.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1058.1.text#μῶν ἀντὶ παιδὸς θανασίμων βουλευμάτων;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1059.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1059.1.text#ναί, καὶ γυναικὸς αἰχμαλωτίδος φόβῳ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1060.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1060.1.text#σὺν πατρὶ δ' οἴκους ἢ τίνος λείπει μέτα;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1061.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1061.1.text#Ἀγαμέμνονός νιν παῖς βέβηκ' ἄγων χθονός.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1062.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1062.1.text#ποίαν περαίνων ἐλπίδ'; ἦ γῆμαι θέλων;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1063.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1063.1.text#καὶ σῷ γε παιδὸς παιδὶ πορσύνων μόρον.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1064.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1064.1.text#κρυπτὸς καταστὰς ἢ κατ' ὄμμ' ἐλθὼν μάχῃ;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1065.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1065.1.text#ἁγνοῖς ἐν ἱεροῖς Λοξίου Δελφῶν μέτα.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1066.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1066.1.text#οἴμοι· τόδ' ἤδη δεινόν. οὐχ ὅσον τάχος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1067.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1067.1.text#χωρήσεταί τις Πυθικὴν πρὸς ἑστίαν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1068.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1068.1.text#καὶ τἀνθάδ' ὄντα τοῖς ἐκεῖ λέξει φίλοις,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1069.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1069.1.text#πρὶν παῖδ' Ἀχιλλέως κατθανεῖν ἐχθρῶν ὕπο;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1070.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1070.1.text#ὤμοι μοι·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1070.2.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1070.2.text#οἵας ὁ τλήμων ἀγγελῶν ἥκω τύχας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1071.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1071.1.text#σοί τ', ὦ γεραιέ, καὶ φίλοισι δεσπότου.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1072.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1072.1.text#αἰαῖ· πρόμαντις θυμὸς ὥς τι προσδοκᾷ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1073.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1073.1.text#οὐκ ἔστι σοι παῖς παιδός, ὡς μάθῃς, γέρον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1074.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1074.1.text#Πηλεῦ· τοιάσδε φασγάνων πληγὰς ἔχει
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1075.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1075.1.text#Δελφῶν ὑπ' ἀνδρῶν καὶ Μυκηναίου ξένου.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1076.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1076.1.text#ἆ ἆ, τί δράσεις, ὦ γεραιέ; μὴ πέσῃς·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1077.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1077.1.text#ἔπαιρε σαυτόν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1077.2.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1077.2.text#οὐδέν εἰμ'· ἀπωλόμην.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1078.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1078.1.text#φρούδη μὲν αὐδή, φροῦδα δ' ἄρθρα μου κάτω.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1079.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1079.1.text#ἄκουσον, εἰ καὶ σοῖς φίλοις ἀμυναθεῖν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1080.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1080.1.text#χρῄζεις, τὸ πραχθέν, σὸν κατορθώσας δέμας.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1081.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1081.1.text#ὦ μοῖρα, γήρως ἐσχάτοις πρὸς τέρμασιν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1082.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1082.1.text#οἵα με τὸν δύστηνον ἀμφιβᾶσ' ἔχεις.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1083.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1083.1.text#πῶς δ' οἴχεταί μοι παῖς μόνου παιδὸς μόνος;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1084.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1084.1.text#σήμαιν'· ἀκοῦσαι δ' οὐκ ἀκούσθ' ὅμως θέλω.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1085.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1085.1.text#ἐπεὶ τὸ κλεινὸν ἤλθομεν Φοίβου πέδον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1086.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1086.1.text#τρεῖς μὲν φαεννὰς ἡλίου διεξόδους
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1087.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1087.1.text#θέᾳ διδόντες ὄμματ' ἐξεπίμπλαμεν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1088.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1088.1.text#καὶ τοῦθ' ὕποπτον ἦν ἄρ'· εἰς δὲ συστάσεις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1089.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1089.1.text#κύκλους τ' ἐχώρει λαὸς οἰκήτωρ θεοῦ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1090.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1090.1.text#Ἀγαμέμνονος δὲ παῖς διαστείχων πόλιν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1091.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1091.1.text#ἐς οὖς ἑκάστῳ δυσμενεῖς ηὔδα λόγους·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1092.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1092.1.text#Ὁρᾶτε τοῦτον, ὃς διαστείχει θεοῦ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1093.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1093.1.text#χρυσοῦ γέμοντα γύαλα, θησαυροὺς βροτῶν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1094.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1094.1.text#τὸ δεύτερον παρόντ' ἐφ' οἷσι καὶ πάρος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1095.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1095.1.text#δεῦρ' ἦλθε, Φοίβου ναὸν ἐκπέρσαι θέλων;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1096.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1096.1.text#κἀκ τοῦδ' ἐχώρει ῥόθιον ἐν πόλει κακόν·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1097.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1097.1.text#ἀρχαί τε, πληροῦντές τε βουλευτήρια,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1098.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1098.1.text#ἰδίᾳ θ' ὅσοι θεοῦ χρημάτων ἐφέστασαν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1099.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1099.1.text#φρουρὰν ἐτάξαντ' ἐν περιστύλοις δόμοις.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1100.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1100.1.text#ἡμεῖς δὲ μῆλα, φυλλάδος Παρνασίας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1101.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1101.1.text#παιδεύματ', οὐδὲν τῶνδέ πω πεπυσμένοι,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1102.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1102.1.text#λαβόντες ᾖμεν ἐσχάραις τ' ἐφέσταμεν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1103.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1103.1.text#σὺν προξένοισι μάντεσίν τε Πυθικοῖς.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1104.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1104.1.text#καί τις τόδ' εἶπεν· Ὦ νεανία, τί σοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1105.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1105.1.text#θεῷ κατευξώμεσθα; τίνος ἥκεις χάριν;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1106.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1106.1.text#ὃ δ' εἶπε· Φοίβῳ τῆς πάροιθ' ἁμαρτίας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1107.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1107.1.text#δίκας παρασχεῖν βουλόμεσθ'· ᾔτησα γὰρ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1108.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1108.1.text#πατρός ποτ' αὐτὸν αἵματος δοῦναι δίκην.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1109.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1109.1.text#κἀνταῦθ' Ὀρέστου μῦθος ἰσχύων μέγα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1110.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1110.1.text#ἐφαίνεθ', ὡς ψεύδοιτο δεσπότης ἐμός,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1111.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1111.1.text#ἥκων ἐπ' αἰσχροῖς. ἔρχεται δ' ἀνακτόρων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1112.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1112.1.text#κρηπῖδος ἐντός, ὡς πάρος χρηστηρίων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1113.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1113.1.text#εὔξαιτο Φοίβῳ· τυγχάνει δ' ἐν ἐμπύροις·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1114.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1114.1.text#τῷ δὲ { ξιφήρης ἆρ' } ὑφειστήκει λόχος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1115.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1115.1.text#δάφνῃ σκιασθείς· ὧν Κλυταιμήστρας τόκος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1116.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1116.1.text#εἷς ἦν ἁπάντων τῶνδε μηχανορράφος.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1117.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1117.1.text#χὣ μὲν κατ' ὄμμα στὰς προσεύχεται θεῷ·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1118.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1118.1.text#οἳ δ' ὀξυθήκτοις φασγάνοις ὡπλισμένοι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1119.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1119.1.text#κεντοῦσ' ἀτευχῆ παῖδ' Ἀχιλλέως λάθρᾳ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1120.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1120.1.text#χωρεῖ δὲ πρύμναν· οὐ γὰρ εἰς καιρὸν τυπεὶς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1121.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1121.1.text#ἐτύγχαν'· ἐξέλκει δὲ καὶ παραστάδος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1122.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1122.1.text#κρεμαστὰ τεύχη πασσάλων καθαρπάσας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1123.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1123.1.text#ἔστη 'πὶ βωμοῦ γοργὸς ὁπλίτης ἰδεῖν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1124.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1124.1.text#βοᾷ δὲ Δελφῶν παῖδας ἱστορῶν τάδε·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1125.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1125.1.text#Τίνος μ' ἕκατι κτείνετ' εὐσεβεῖς ὁδοὺς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1126.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1126.1.text#ἥκοντα; ποίας ὄλλυμαι πρὸς αἰτίας;—
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1127.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1127.1.text#τῶν δ' οὐδὲν οὐδεὶς μυρίων ὄντων πέλας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1128.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1128.1.text#ἐφθέγξατ', ἀλλ' ἔβαλλον ἐκ χερῶν πέτροις.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1129.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1129.1.text#πυκνῇ δὲ νιφάδι πάντοθεν σποδούμενος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1130.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1130.1.text#προὔτεινε τεύχη κἀφυλάσσετ' ἐμβολὰς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1131.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1131.1.text#ἐκεῖσε κἀκεῖσ' ἀσπίδ' ἐκτείνων χερί.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1132.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1132.1.text#ἀλλ' οὐδὲν ἦνεν· ἀλλὰ πόλλ' ὁμοῦ βέλη,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1133.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1133.1.text#οἰστοί, μεσάγκυλ' ἔκλυτοί τ' ἀμφώβολοι,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1134.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1134.1.text#σφαγῆς ἐχώρουν βουπόροι ποδῶν πάρος.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1135.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1135.1.text#δεινὰς δ' ἂν εἶδες πυρρίχας φρουρουμένου
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1136.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1136.1.text#βέλεμνα παιδός. ὡς δέ νιν περισταδὸν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1137.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1137.1.text#κύκλῳ κατεῖχον οὐ διδόντες ἀμπνοάς,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1138.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1138.1.text#βωμοῦ κενώσας δεξίμηλον ἐσχάραν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1139.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1139.1.text#τὸ Τρωικὸν πήδημα πηδήσας ποδοῖν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1140.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1140.1.text#χωρεῖ πρὸς αὐτούς· οἳ δ' ὅπως πελειάδες
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1141.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1141.1.text#ἱέρακ' ἰδοῦσαι πρὸς φυγὴν ἐνώτισαν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1142.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1142.1.text#πολλοὶ δ' ἔπιπτον μιγάδες ἔκ τε τραυμάτων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1143.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1143.1.text#αὐτοί θ' ὑπ' αὐτῶν στενοπόρους κατ' ἐξόδους,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1144.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1144.1.text#κραυγὴ δ' ἐν εὐφήμοισι δύσφημος δόμοις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1145.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1145.1.text#πέτραισιν ἀντέκλαγξ'· ἐν εὐδίᾳ δέ πως
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1146.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1146.1.text#ἔστη φαεννοῖς δεσπότης στίλβων ὅπλοις·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1147.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1147.1.text#πρὶν δή τις ἀδύτων ἐκ μέσων ἐφθέγξατο
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1148.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1148.1.text#δεινόν τι καὶ φρικῶδες, ὦρσε δὲ στρατὸν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1149.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1149.1.text#στρέψας πρὸς ἀλκήν. ἔνθ' Ἀχιλλέως πίτνει
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1150.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1150.1.text#παῖς ὀξυθήκτῳ πλευρὰ φασγάνῳ τυπεὶς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1151.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1151.1.text#Δελφοῦ πρὸς ἀνδρός, ὅσπερ αὐτὸν ὤλεσε,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1152.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1152.1.text#πολλῶν μετ' ἄλλων· ὡς δὲ πρὸς γαῖαν πίτνει,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1153.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1153.1.text#τίς οὐ σίδηρον προσφέρει, τίς οὐ πέτρον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1154.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1154.1.text#βάλλων ἀράσσων; πᾶν δ' ἀνήλωται δέμας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1155.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1155.1.text#τὸ καλλίμορφον τραυμάτων ὑπ' ἀγρίων.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1156.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1156.1.text#νεκρὸν δὲ δή νιν κείμενον βωμοῦ πέλας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1157.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1157.1.text#ἐξέβαλον ἐκτὸς θυοδόκων ἀνακτόρων.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1158.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1158.1.text#ἡμεῖς δ' ἀναρπάσαντες ὡς τάχος χεροῖν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1159.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1159.1.text#κομίζομέν νιν σοὶ κατοιμῶξαι γόοις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1160.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1160.1.text#κλαῦσαί τε, πρέσβυ, γῆς τε κοσμῆσαι τάφῳ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1161.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1161.1.text#τοιαῦθ' ὁ τοῖς ἄλλοισι θεσπίζων ἄναξ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1162.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1162.1.text#ὁ τῶν δικαίων πᾶσιν ἀνθρώποις κριτής,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1163.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1163.1.text#δίκας διδόντα παῖδ' ἔδρασ' Ἀχιλλέως.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1164.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1164.1.text#ἐμνημόνευσε δ', ὥσπερ ἄνθρωπος κακός,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1165.1.speaker#Ἄγγελος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1165.1.text#παλαιὰ νείκη· πῶς ἂν οὖν εἴη σοφός;[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1166.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1166.1.text#καὶ μὴν ὅδ' ἄναξ ἤδη φοράδην
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1167.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1167.1.text#Δελφίδος ἐκ γῆς δῶμα πελάζει.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1168.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1168.1.text#τλήμων ὁ παθών, τλήμων δέ, γέρον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1169.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1169.1.text#καὶ σύ· δέχῃ γὰρ τὸν Ἀχίλλειον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1170.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1170.1.text#σκύμνον ἐς οἴκους οὐχ ὡς σὺ θέλεις·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1171.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1171.1.text#αὐτός τε κακοῖς [ πήμασι κύρσας ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1172.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1172.1.text#εἰς ἓν μοίρας συνέκυρσας.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1173.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1173.1.text#ὤμοι ἐγώ, κακὸν οἷον ὁρῶ τόδε
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1174.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1174.1.text#καὶ δέχομαι χερὶ δώμασί τ' ἀμοῖς.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1175.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1175.1.text#ἰώ μοί μοι, αἰαῖ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1176.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1176.1.text#ὦ πόλι Θεσσαλία, διολώλαμεν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1177.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1177.1.text#οἰχόμεθ'· οὐκέτι μοι γένος, οὐκέτι [ μοι τέκνα ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1178.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1178.1.text#λείπεται οἴκοις·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1179.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1179.1.text#ὦ σχέτλιος παθέων ἐγώ· εἰς τίνα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1180.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1180.1.text#δὴ φίλον αὐγὰς βάλλων τέρψομαι;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1181.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1181.1.text#ὦ φίλιον στόμα καὶ γένυ καὶ χέρες,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1182.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1182.1.text#εἴθε σ' ὑπ' Ἰλίῳ ἤναρε δαίμων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1183.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1183.1.text#Σιμοεντίδα παρ' ἀκτάν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1184.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1184.1.text#οὗτός τ' ἂν ὡς ἐκ τῶνδ' ἐτιμᾶτ' ἄν, γέρον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1185.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1185.1.text#θανών, τὸ σὸν δ' ἦν ὧδ' ἂν εὐτυχέστερον.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1186.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1186.1.text#ὦ γάμος, ὦ γάμος, ὃς τάδε δώματα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1187.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1187.1.text#καὶ πόλιν ἀμὰν ὤλεσας· αἰαῖ,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1188.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1188.1.text#{ ἒ ἔ· ὦ παῖ, }
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1189.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1189.1.text#{ μήποτε σῶν λεχέων τὸ δυσώνυμον }
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1190.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1190.1.text#{ ὤφελ' ἐμὸν γένος εἰς τέκνα καὶ δόμον }
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1191.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1191.1.text#{ ἀμφιβαλέσθαι }
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1192.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1192.1.text#{ Ἑρμιόνας Ἀίδαν ἐπὶ σοί, τέκνον, }
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1193.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1193.1.text#ἀλλὰ κεραυνῷ πρόσθεν ὀλέσθαι·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1194.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1194.1.text#μηδ' ἐπὶ τοξοσύνᾳ φονίῳ πατρὸς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1195.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1195.1.text#{ αἷμα τὸ διογενές ποτε Φοίβου }
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1196.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1196.1.text#{ βροτὸς εἰς θεὸν ἀνάψαι. }[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1197.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1197.1.text#ὀττοτοτοτοῖ, θανόντα δεσπόταν γόοις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1198.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1198.1.text#νόμῳ τῷ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1199.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1199.1.text#νερτέρων κατάρξω.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1200.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1200.1.text#ὀττοτοτοτοῖ, διάδοχα δ' ὦ τάλας ἐγὼ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1201.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1201.1.text#γέρων καὶ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1202.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1202.1.text#δυστυχὴς δακρύω.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1203.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1203.1.text#θεοῦ γὰρ αἶσα, θεὸς ἔκρανε συμφοράν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1204.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1204.1.text#ὦ φίλος,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1205.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1205.1.text#δόμον ἔλιπες ἔρημον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1206.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1206.1.text#ὤμοι μοι, ταλαίπωρον ἐμὲ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1207.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1207.1.text#γέροντ' ἄπαιδα νοσφίσας.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1208.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1208.1.text#θανεῖν θανεῖν σε, πρέσβυ, χρῆν πάρος τέκνων.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1209.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1209.1.text#οὐ σπαράξομαι κόμαν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1210.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1210.1.text#οὐκ ἐμῷ 'πιθήσομαι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1211.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1211.1.text#κάρᾳ κτύπημα χειρὸς ὀλοόν; ὦ πόλις,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1212.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1212.1.text#διπλῶν τέκνων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1213.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1213.1.text#μ' ἐστέρησ' ὁ Φοῖβος.[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1214.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1214.1.text#ὦ κακὰ παθὼν ἰδών τε δυστυχὴς γέρον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1214.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1214.2.text#τίν' αἰῶν'
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1215.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1215.1.text#εἰς τὸ λοιπὸν ἕξεις;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1216.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1216.1.text#ἄτεκνος ἔρημος, οὐκ ἔχων πέρας κακῶν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1216.2.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1216.2.text#διαντλήσω
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1217.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1217.1.text#πόνους ἐς Ἅιδαν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1218.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1218.1.text#μάτην δέ σ' ἐν γάμοισιν ὤλβισαν θεοί.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1219.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1219.1.text#ἀμπτάμενα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1219.2.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1219.2.text#φροῦδα πάντα, κεῖται
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1219.3.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1219.3.text#[ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1220.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1220.1.text#κόμπων μεταρσίων πρόσω.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1221.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1221.1.text#μόνος μόνοισιν ἐν δόμοις ἀναστρέφῃ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1222.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1222.1.text#οὐκέτ' εἶ, πόλις, πόλις,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1223.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1223.1.text#σκῆπτρά τ' ἐρρέτω τάδε [ ἐπὶ γαῖαν, ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1224.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1224.1.text#σύ τ', ὦ κατ' ἄντρα νύχια Νηρέως κόρη,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1224.2.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1224.2.text#πανώλεθρόν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1225.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1225.1.text#μ' ὄψεαι πίτνοντα [ πρὸς γᾶν. ][ … ][ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1226.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1226.1.text#ἰὼ ἰώ·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1226.2.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1226.2.text#τί κεκίνηται; τίνος αἰσθάνομαι
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1227.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1227.1.text#θείου; κοῦραι, λεύσσετ' ἀθρήσατε·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1228.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1228.1.text#δαίμων ὅδε τις λευκὴν αἰθέρα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1229.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1229.1.text#πορθμευόμενος τῶν ἱπποβότων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1230.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1230.1.text#Φθίας πεδίων ἐπιβαίνει.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1231.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1231.1.text#Πηλεῦ, χάριν σοι τῶν πάρος νυμφευμάτων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1232.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1232.1.text#ἥκω Θέτις λιποῦσα Νηρέως δόμους.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1233.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1233.1.text#καὶ πρῶτα μέν δὴ τοῖς παρεστῶσιν κακοῖς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1234.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1234.1.text#μηδέν τι λίαν δυσφορεῖν παρῄνεσα·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1235.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1235.1.text#κἀγὼ γάρ, ἣν ἄκλαυτα χρῆν τίκτειν τέκνα,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1236.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1236.1.text#ἀπώλεσ' ἐκ σοῦ παῖδα τὸν ταχὺν πόδας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1237.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1237.1.text#Ἀχιλλέα τεκοῦσα πρῶτον Ἑλλάδος.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1238.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1238.1.text#ὧν δ' οὕνεκ' ἦλθον σημανῶ, σὺ δ' ἐνδέχου.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1239.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1239.1.text#τὸν μὲν θανόντα τόνδ' Ἀχιλλέως γόνον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1240.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1240.1.text#θάψον πορεύσας Πυθικὴν πρὸς ἐσχάραν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1241.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1241.1.text#Δελφοῖς ὄνειδος, ὡς ἀπαγγέλλῃ τάφος
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1242.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1242.1.text#φόνον βίαιον τῆς Ὀρεστείας χερός·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1243.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1243.1.text#γυναῖκα δ' αἰχμάλωτον, Ἀνδρομάχην λέγω,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1244.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1244.1.text#Μολοσσίαν γῆν χρὴ κατοικῆσαι, γέρον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1245.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1245.1.text#Ἑλένῳ συναλλαχθεῖσαν εὐναίοις γάμοις,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1246.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1246.1.text#καὶ παῖδα τόνδε, τῶν ἀπ' Αἰακοῦ μόνον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1247.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1247.1.text#λελειμμένον δή. βασιλέα δ' ἐκ τοῦδε χρὴ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1248.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1248.1.text#ἄλλον δι' ἄλλου διαπερᾶν Μολοσσίας
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1249.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1249.1.text#εὐδαιμονοῦντας· οὐ γὰρ ὧδ' ἀνάστατον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1250.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1250.1.text#γένος γενέσθαι δεῖ τὸ σὸν κἀμόν, γέρον,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1251.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1251.1.text#Τροίας τε· καὶ γὰρ θεοῖσι κἀκείνης μέλει,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1252.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1252.1.text#καίπερ πεσούσης Παλλάδος προθυμίᾳ.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1253.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1253.1.text#σὲ δ', ὡς ἂν εἰδῇς τῆς ἐμῆς εὐνῆς χάριν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1254.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1254.1.text#[ θεὰ γεγῶσα καὶ θεοῦ πατρὸς τέκος, ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1255.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1255.1.text#κακῶν ἀπαλλάξασα τῶν βροτησίων
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1256.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1256.1.text#ἀθάνατον ἄφθιτόν τε ποιήσω θεόν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1257.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1257.1.text#κἄπειτα Νηρέως ἐν δόμοις ἐμοῦ μέτα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1258.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1258.1.text#τὸ λοιπὸν ἤδη θεὸς συνοικήσεις θεᾷ·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1259.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1259.1.text#ἔνθεν κομίζων ξηρὸν ἐκ πόντου πόδα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1260.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1260.1.text#τὸν φίλτατον σοὶ παῖδ' ἐμοί τ' Ἀχιλλέα
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1261.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1261.1.text#ὄψῃ δόμους ναίοντα νησιωτικοὺς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1262.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1262.1.text#Λευκὴν κατ' ἀκτὴν ἐντὸς Εὐξείνου πόρου.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1263.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1263.1.text#ἀλλ' ἕρπε Δελφῶν εἰς θεόδμητον πόλιν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1264.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1264.1.text#νεκρὸν κομίζων τόνδε, καὶ κρύψας χθονὶ
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1265.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1265.1.text#ἐλθὼν παλαιᾶς χοιράδος κοῖλον μυχὸν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1266.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1266.1.text#Σηπιάδος ἵζου· μίμνε δ', ἔστ' ἂν ἐξ ἁλὸς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1267.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1267.1.text#λαβοῦσα πεντήκοντα Νηρῄδων χορὸν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1268.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1268.1.text#ἔλθω κομιστήν σου· τὸ γὰρ πεπρωμένον
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1269.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1269.1.text#δεῖ σ' ἐκκομίζειν· Ζηνὶ γὰρ δοκεῖ τάδε.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1270.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1270.1.text#παῦσαι δὲ λύπης τῶν τεθνηκότων ὕπερ·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1271.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1271.1.text#πᾶσιν γὰρ ἀνθρώποισιν ἥδε πρὸς θεῶν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1272.1.speaker#Θέτις
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1272.1.text#ψῆφος κέκρανται κατθανεῖν τ' ὀφείλεται.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1273.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1273.1.text#ὦ πότνι', ὦ γενναῖα συγκοιμήματα,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1274.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1274.1.text#Νηρέως γένεθλον, χαῖρε· ταῦτα δ' ἀξίως
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1275.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1275.1.text#σαυτῆς τε ποιεῖς καὶ τέκνων τῶν ἐκ σέθεν.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1276.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1276.1.text#παύω δὲ λύπην σοῦ κελευούσης, θεά,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1277.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1277.1.text#καὶ τόνδε θάψας εἶμι Πηλίου πτυχάς,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1278.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1278.1.text#οὗπερ σὸν εἷλον χερσὶ κάλλιστον δέμας.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1279.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1279.1.text#κᾆτ' οὐ γαμεῖν δῆτ' ἔκ τε γενναίων χρεὼν
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1280.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1280.1.text#δοῦναί τ' ἐς ἐσθλούς, ὅστις εὖ βουλεύεται,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1281.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1281.1.text#κακῶν δὲ λέκτρων μὴ 'πιθυμίαν ἔχειν,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1282.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1282.1.text#μηδ' εἰ ζαπλούτους οἴσεται φερνὰς δόμοις;
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1283.1.speaker#Πηλεύς
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1283.1.text#[ οὐ γάρ ποτ' ἂν πράξειαν ἐκ θεῶν κακῶς. ][ … ]
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1284.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1284.1.text#πολλαὶ μορφαὶ τῶν δαιμονίων,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1285.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1285.1.text#πολλὰ δ' ἀέλπτως κραίνουσι θεοί·
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1286.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1286.1.text#καὶ τὰ δοκηθέντ' οὐκ ἐτελέσθη,
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1287.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1287.1.text#τῶν δ' ἀδοκήτων πόρον ηὗρε θεός.
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1288.1.speaker#Χορός
urn:cts:greekLit:tlg0006.tlg006.fu.sp:1288.1.text#τοιόνδ' ἀπέβη τόδε πρᾶγμα.[ … ][ … ]
